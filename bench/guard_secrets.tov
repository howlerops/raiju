// Secrets scan benchmark: the Gitleaks rule set over 20 KB of text. Two inputs:
// "code": ordinary code lines with the generic credential words (key, token, password...),
//         the keyword-dense case the 35 ms budget is set for;
// "all keywords": every rule keyword in turn, so every rule's keyword prefilter passes; the
//         stress case, held to the same 35 ms budget.
// Usage: tov run bench/guard_secrets.tov [iterations]
import { compileSecrets, gitleaksRules } from "../src/guard_secrets"
import { applyRegex } from "../src/guard_regex"

const iterations = parseInt(process.argv[2] ?? "10") ?? 10

// 20 KB of code lines, a generic credential word on every fourth line
function codeText(): string {
  const words = ["config", "value", "function", "return", "const", "user", "request", "model", "response", "data"]
  const generic = ["key", "token", "password", "secret", "api_key", "auth", "credential"]
  let text = ""
  let i = 0
  while (text.byteLength < 20480) {
    const w = i % 4 === 0 ? generic[i % generic.length]! : words[i % words.length]!
    text += w + " = v" + i + ";\n"
    i += 1
  }
  return text
}

// 20 KB of every rule keyword in turn
function allKeywordsText(): string {
  const words: string[] = []
  for (const g of try gitleaksRules()) {
    for (const k of g.keywords) words.push(k)
  }
  let text = ""
  let i = 0
  while (text.byteLength < 20480) {
    text += words[i % words.length]! + "=value" + i + " "
    if (i % 16 === 15) text += "\n"
    i += 1
  }
  return text
}

const rules = try compileSecrets([], "redact")
const inputs: { name: string, text: string }[] = [
  { name: "code", text: try codeText() },
  { name: "all keywords", text: try allKeywordsText() },
]
for (const input of inputs) {
  const text = input.text
  const name = input.name
  let total = 0.0
  let best = 1e9
  let findings = 0
  for (let n = 0; n < iterations; n++) {
    const t0 = performance.now()
    const r = applyRegex(text, rules)
    const dt = performance.now() - t0
    total += dt
    if (dt < best) best = dt
    findings = r.findings.length
  }
  console.log(`${name}: bytes=${text.byteLength} rules=${rules.length} findings=${findings} best_ms=${best.toFixed(2)} mean_ms=${(total / iterations).toFixed(2)}`)
}
