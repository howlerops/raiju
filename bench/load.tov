// Load generator. Closed loop: C concurrent clients for D seconds.
// Open loop (a fixed request rate, as Bifrost's benchmarks run): pass a rate.
// Usage: load <url> <concurrency> <seconds> [requests-per-second]
const args = process.argv.slice(2)
const url = args[0] ?? "http://127.0.0.1:18098/v1/chat/completions"
const concurrency = parseInt(args[1] ?? "32") ?? 32
const seconds = parseFloat(args[2] ?? "5") ?? 5.0
const body = `{"model":"openai/gpt-4o-mini","messages":[{"role":"user","content":"Say hello in one short sentence."}],"max_tokens":16}`

const latencies: f64[] = []
let errors = 0

async function worker(deadline: f64): Promise<void> {
  while (performance.now() < deadline) {
    const t0 = performance.now()
    try {
      const res = await fetch(url, { method: "POST", headers: { "content-type": "application/json", "x-bf-cache-no-store": "true" }, body: body })
      await res.text()
      if (res.status !== 200) errors += 1
    } catch (e) {
      errors += 1
    }
    latencies.push(performance.now() - t0)
  }
}

async function one(): Promise<void> {
  const t0 = performance.now()
  try {
    const res = await fetch(url, { method: "POST", headers: { "content-type": "application/json", "x-bf-cache-no-store": "true" }, body: body })
    await res.text()
    if (res.status !== 200) errors += 1
  } catch (e) {
    errors += 1
  }
  latencies.push(performance.now() - t0)
}

const rate = parseFloat(args[3] ?? "0") ?? 0.0
const start = performance.now()
const deadline = start + seconds * 1000
if (rate > 0.0) {
  // every millisecond, start however many requests the schedule says are due
  const total = Math.floor(rate * seconds)
  const inflight: Promise<void>[] = []
  await new Promise<void>((resolve) => {
    let sent = 0
    let done = false
    let timer = 0
    timer = setInterval(() => {
      if (done) return
      const due = Math.min(total, Math.floor((performance.now() - start) * rate / 1000))
      while (sent < due) {
        inflight.push(one())
        sent += 1
      }
      if (sent >= total) {
        done = true
        clearInterval(timer)
        resolve()
      }
    }, 1)
  })
  await Promise.all(inflight)
} else {
  const ws: Promise<void>[] = []
  for (let i = 0; i < concurrency; i++) ws.push(worker(deadline))
  await Promise.all(ws)
}
const elapsed = (performance.now() - start) / 1000
latencies.sort((a, b) => a - b)
const pct = (p: f64) => latencies[Math.min(latencies.length - 1, Math.floor(latencies.length * p))] ?? 0.0
const mean = latencies.reduce((a, b) => a + b, 0.0) / Math.max(1, latencies.length)
console.log(JSON.stringify({ mean_ms: mean, requests: latencies.length, errors: errors, rps: Math.round(latencies.length / elapsed), p50_ms: pct(0.5), p90_ms: pct(0.9), p99_ms: pct(0.99) }))
