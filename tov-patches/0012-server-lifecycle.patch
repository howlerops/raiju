+    tv_http_server *sv = &tv_http_servers[id];
+    sv->header_ms = header_ms > 0 ? header_ms : 0;
+    sv->idle_ms = idle_ms > 0 ? idle_ms : 0;
+    sv->body_ms = body_ms > 0 ? body_ms : 0;
+    sv->max_conns = max_conns > 0 ? max_conns : 0;
+    if (sv->header_ms || sv->idle_ms || sv->body_ms) tv_http_timeouts = true;
+}
+
+/* The server's open connections in this process (upgraded ones excepted). */
+tv_int tv_native_httpOpen(tv_int id) {
+    tv_int n = 0;
+    if (id < 0 || id >= tv_http_nservers) return 0;
+    for (tv_http_conn *c = tv_http_conns; c; c = c->next)
+        if (c->srv == &tv_http_servers[id]) n++;
+    return n;
+}
+
+/* The process's soft limit on open descriptors (RLIMIT_NOFILE), or 0 when unknown. */
+tv_int tv_native_httpFdLimit(void) {
+    struct rlimit rl;
+    if (getrlimit(RLIMIT_NOFILE, &rl) != 0 || rl.rlim_cur == RLIM_INFINITY) return 0;
+    return (tv_int)rl.rlim_cur;
+}
