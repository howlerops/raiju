diff --git a/runtime/tov.c b/runtime/tov.c
--- a/runtime/tov.c
+++ b/runtime/tov.c
@@ -4486,6 +4486,7 @@ static inline size_t tv_unit_to_byte(tv_str s, int64_t u, bool *mid) {
-/* Unit index of byte offset b (a character boundary). (A string whose length isn't known yet
- * just counts up to b, which costs no more than finding b did.) */
+/* Classify before caching UTF-16 offsets. Non-ASCII heap strings must carry TV_STR_WIDE
+ * so their release drops the pointer-keyed view; otherwise an allocator-reused address
+ * can inherit offsets from a freed string. ASCII offsets need no view. */
 static inline int64_t tv_byte_to_unit(tv_str s, size_t b) {
-    if (s.p->rc & TV_STR_ASCII) return (int64_t)b;
+    if (tv_str_is_ascii(s)) return (int64_t)b;
     return tv_str_byte_unit(s.p, b);
 }
