@@ -4731,6 +4735,34 @@ void tv_native_httpBodyOptions(tv_int id, tv_int stream, tv_int max) {
 /* The stream of the request being handled (0: its body came whole). */
 tv_int tv_native_httpBodyStream(void) { return tv_http_cur_bs ? tv_http_cur_bs->id : 0; }
 
+/* httpPeer(which): the address (0) or port (1) of the client whose request is being handled, as
+ * Bun's server.requestIP gives them; "" outside a handler or for a socket with no IP address. */
+tv_str tv_native_httpPeer(tv_int which) {
+    tv_http_conn *c = tv_http_cur;
+    if (!c) return TV_EMPTY_STR;
+    if (!c->peer_known) {
+        c->peer_known = true;
+        struct sockaddr_storage ss;
+        socklen_t len = sizeof ss;
+        if (getpeername(c->fd, (struct sockaddr *)&ss, &len) == 0) {
+            if (ss.ss_family == AF_INET) {
+                struct sockaddr_in *v4 = (struct sockaddr_in *)&ss;
+                if (inet_ntop(AF_INET, &v4->sin_addr, c->peer, sizeof c->peer)) c->peer_port = ntohs(v4->sin_port);
+            } else if (ss.ss_family == AF_INET6) {
+                struct sockaddr_in6 *v6 = (struct sockaddr_in6 *)&ss;
+                if (inet_ntop(AF_INET6, &v6->sin6_addr, c->peer, sizeof c->peer)) c->peer_port = ntohs(v6->sin6_port);
+            }
+        }
+    }
+    if (!c->peer[0]) return TV_EMPTY_STR;
+    if (which == 1) {
+        char buf[8];
+        int n = snprintf(buf, sizeof buf, "%d", c->peer_port);
+        return tv_str_from(buf, (size_t)n);
+    }
+    return tv_str_from(c->peer, strlen(c->peer));
+}
