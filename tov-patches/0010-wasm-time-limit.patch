+/* Tov's wall-clock bound on a call (runtime/wasm.c): every 65536 instructions the clock is
+ * compared with the deadline of the call in progress (0: none). */
+extern int64_t tv_wasm_deadline_ns;
+extern uint32_t tv_wasm_ticks;
+extern int64_t tv_wasm_now_ns(void);
+#define CHECK_INSTRUCTION_LIMIT()                                     \
+    if (instructions_left == 0) {                                     \
+        wasm_set_exception(module, "instruction limit exceeded");     \
