+    tv_sb_push(&h, lines, len);
+    tv_sb_push(&h, "\r\n", 2);
+    bool ok = tv_fr_head(r, h.data, h.len);
+    tv_sb_free(&h);
+    if (!ok) { tv_fr_fail(r, "Malformed_HTTP_Response", "Malformed_HTTP_Response fetching \"%s\". %s", r->url.p->data, TV_FETCH_VERBOSE); return; }
+    r->got_any = true;
+    if (!r->discard) tv_fr_head_ready(r);
+}
+
+/* Body bytes of r's stream. They are given back to the stream's window once the reader has room
+ * for them: a reader that is behind holds the stream (not the connection's other streams). */
+static void tv_h2_on_data(void *user, const uint8_t *p, size_t n) {
+    tv_fr *r = user;
+    tv_fc *c = r->h2c;
+    if (r->result != 1 || !c) return;
+    if (tv_fetch_on_bytes) tv_fetch_on_bytes(n);
+    r->got_any = true;
+    if (r->state == TV_FR_FIXED) r->remaining -= (int64_t)n;
+    bool full = false;
+    if (!r->discard) {
+        tv_sb *sink = tv_fr_sink(r);
+        tv_sb_push(sink, (const char *)p, n);
+        if (!tv_fr_decoding(r)) tv_fr_check_utf8(r);
+        full = tv_fr_data(r);
+        if (r->result != 1) return; /* the body couldn't be decoded */
+        if (tv_fr_sink(r)->len > INT32_MAX) { tv_fr_fail(r, "Malformed_HTTP_Response", "Malformed_HTTP_Response fetching \"%s\". %s", r->url.p->data, TV_FETCH_VERBOSE); return; }
+    }
+    if (full || r->paused) { r->paused = true; r->h2_held += n; }
+    else tv_h2_impl->consume(c->h2, r->h2s, n);
+}
+
+/* r's stream ended: with the response complete, or without. */
+static void tv_h2_on_closed(void *user, uint32_t err) {
+    tv_fr *r = user;
+    if (!r->h2c) return;
+    tv_fr_h2_detach(r, false);
+    if (r->result != 1) return;
+    if (err != 0) {
+        if (err == 7 && !r->got_any && !r->retried) { /* REFUSED_STREAM: nothing was processed */
+            r->retried = true;
+            tv_fr_reset_response(r);
+            tv_fr_step(r);
+            return;
+        }
+        tv_fr_fail(r, "ECONNRESET", "The HTTP/2 stream was closed by the server (error %u). %s", (unsigned)err, TV_FETCH_VERBOSE);
+        return;
+    }
+    if (r->state == TV_FR_HEAD || (r->state == TV_FR_FIXED && r->remaining > 0)) {
+        tv_fr_fail(r, "ECONNRESET", "The socket connection was closed unexpectedly. %s", TV_FETCH_VERBOSE);
+        return;
+    }
+    r->state = TV_FR_DONE;
+    tv_fr_complete(r);
+}
+
+static void tv_h2_on_goaway(void *conn, int32_t last, uint32_t err) {
+    (void)last; (void)err;
+    ((tv_fc *)conn)->goaway = true;
+}
+
+static void tv_h2_on_frame(void *conn) { ((tv_fc *)conn)->last_rx = tv_loop_now(); }
+static void tv_h2_on_ping_ack(void *conn) { ((tv_fc *)conn)->ping_at = 0; }
+
+/* Writes what the session has to send. */
+static void tv_fc_h2_flush(tv_fc *c) {
+    if (c->dead || !c->h2 || c->in_feed) return; /* (after feed(), tv_fc_h2_ready writes what the events queued) */
+    for (;;) {
+        size_t n;
+        const uint8_t *p = tv_h2_impl->pending(c->h2, &n);
+        if (!n) { tv_fc_interest(c, true, false); return; }
+        long w;
+        if (c->tls) {
+            w = tv_tls_impl->write(c->tls, p, n);
+            if (w == -1) { tv_fc_interest(c, true, false); return; }
+            if (w == -2) { tv_fc_interest(c, true, true); return; }
+        } else {
+            ssize_t sw;
+            do {
+#ifdef MSG_NOSIGNAL
+                sw = send(c->fd, p, n, MSG_NOSIGNAL);
+#else
+                sw = send(c->fd, p, n, 0);
+#endif
+            } while (sw < 0 && errno == EINTR);
+            if (sw < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) { tv_fc_interest(c, true, true); return; }
+            w = (long)sw;
+        }
+        if (w <= 0) { tv_fc_h2_down(c, false); return; }
+        tv_h2_impl->sent(c->h2, (size_t)w);
+    }
+}
+
+/* The connection is gone: its requests are retried on another if nothing of theirs was answered
+ * and the connection had been used before (it was a pooled one the server closed), else they fail. */
+static void tv_fc_h2_down(tv_fc *c, bool eof) {
+    (void)eof;
+    if (c->dead) return;
+    tv_fr *list = c->streams;
+    c->streams = NULL;
+    c->nstreams = 0;
+    tv_fc_close(c);
+    for (tv_fr *r = list, *next; r; r = next) {
+        next = r->h2_next;
+        r->h2_next = r->h2_prev = NULL;
+        r->h2c = NULL;
+        r->h2s = NULL;
+        r->h2_held = 0;
+        if (r->result != 1) continue;
+        if (r->h2_reused && !r->got_any && !r->retried) {
+            r->retried = true;
+            tv_fr_reset_response(r);
+            tv_fr_step(r);
+        } else {
+            tv_fr_fail(r, "ECONNRESET", "The socket connection was closed unexpectedly. %s", TV_FETCH_VERBOSE);
+        }
+    }
+}
+
+/* The connection has no streams left. */
+static void tv_fc_h2_idle(tv_fc *c) {
+    c->idle_at = tv_loop_now();
+    if (c->goaway) { tv_fc_close(c); return; }
+    if (c->origin->ka_ms > 0) tv_fetch_arm(c->idle_at + (uint64_t)c->origin->ka_ms);
+}
+
+/* r's stream is over (it ended, or r lets go of it: then the server is told to stop). */
+static void tv_fr_h2_detach(tv_fr *r, bool cancel) {
+    tv_fc *c = r->h2c;
+    if (!c) return;
+    if (cancel && !c->dead && c->h2) tv_h2_impl->cancel(c->h2, r->h2s);
+    if (r->h2_prev) r->h2_prev->h2_next = r->h2_next; else c->streams = r->h2_next;
+    if (r->h2_next) r->h2_next->h2_prev = r->h2_prev;
+    r->h2_next = r->h2_prev = NULL;
+    c->nstreams--;
+    if (r->h2_held && !c->dead && c->h2) tv_h2_impl->consume(c->h2, NULL, r->h2_held);
+    r->h2_held = 0;
+    r->h2c = NULL;
+    r->h2s = NULL;
+    if (c->dead) return;
+    tv_fc_h2_flush(c);
+    if (c->nstreams == 0) tv_fc_h2_idle(c);
+}
+
+/* The reader of r's body has caught up: the window the held bytes took is given back. */
+static void tv_fr_h2_resume(tv_fr *r) {
+    tv_fc *c = r->h2c;
+    r->paused = false;
+    size_t held = r->h2_held;
+    r->h2_held = 0;
+    if (held && !c->dead && c->h2) {
+        tv_h2_impl->consume(c->h2, r->h2s, held);
+        tv_fc_h2_flush(c);
+    }
+}
+
+/* Starts r's request as a stream on c. False if the connection takes no more. */
+static bool tv_fr_h2_start(tv_fr *r, tv_fc *c) {
+    size_t hl = r->head.len - (r->merged ? (size_t)r->body.p->len : 0);
+    int32_t sid = 0;
+    void *st = tv_h2_impl->submit(c->h2, r, r->head.data, hl, r->https, (const uint8_t *)r->body.p->data, (size_t)r->body.p->len, &sid);
+    if (!st) return false;
+    r->h2c = c;
+    r->h2s = st;
+    r->h2_prev = NULL;
+    r->h2_next = c->streams;
+    if (c->streams) c->streams->h2_prev = r;
+    c->streams = r;
+    c->nstreams++;
+    r->h2_reused = c->nstarted++ > 0;
+    r->state = TV_FR_HEAD;
+    r->got_any = false;
+    r->sent = 0;
+    tv_fc_h2_flush(c);
+    return true;
+}
+
+/* The server chose h2: the connection's first request (c->r) becomes its first stream. */
+static void tv_fc_become_h2(tv_fc *c) {
+    tv_fr *r = c->r;
+    tv_origin *o = c->origin;
+    if (!tv_fc_h2_ev.head) {
+        tv_fc_h2_ev.head = tv_h2_on_head;
+        tv_fc_h2_ev.data = tv_h2_on_data;
+        tv_fc_h2_ev.closed = tv_h2_on_closed;
+        tv_fc_h2_ev.goaway = tv_h2_on_goaway;
+        tv_fc_h2_ev.ping_ack = tv_h2_on_ping_ack;
+        tv_fc_h2_ev.frame = tv_h2_on_frame;
+    }
+    c->h2 = tv_h2_impl->open(c, &tv_fc_h2_ev);
+    c->r = NULL;
+    r->c = NULL;
+    if (!c->h2) {
+        tv_fc_close(c);
+        tv_fr_fail(r, "ERR_HTTP2", "HTTP/2 setup failed");
+        return;
+    }
+    o->h2_state = 1;
+    c->h2_next = o->h2list;
+    o->h2list = c;
+    c->last_rx = tv_loop_now();
+    if (o->ping_ms > 0) tv_fetch_arm(c->last_rx + (uint64_t)o->ping_ms);
+    if (!tv_fr_h2_start(r, c)) {
+        tv_fc_close(c);
+        tv_fr_fail(r, "ERR_HTTP2", "HTTP/2 request could not start");
+        return;
+    }
+    /* (the server's first frames may already be decrypted and waiting) */
+    tv_fc_h2_ready(c, true, false, false);
+}
+
+static void tv_fc_h2_ready(tv_fc *c, bool readable, bool writable, bool broken) {
+    if (writable) tv_fc_h2_flush(c);
+    if (c->dead) return;
+    if (readable || broken) {
+        char buf[16384];
+        for (;;) {
+            long n = tv_fc_recv(c, buf, sizeof buf);
+            if (n > 0) {
+                c->last_rx = tv_loop_now();
+                c->in_feed++;
+                long rc = tv_h2_impl->feed(c->h2, (const uint8_t *)buf, (size_t)n);
+                c->in_feed--;
+                if (c->dead) return;
+                if (rc < 0) { tv_fc_h2_down(c, false); return; }
+                continue;
+            }
+            if (n == 0 || n == -3) { tv_fc_h2_down(c, true); return; }
+            if (n == -2) tv_fc_interest(c, true, true);
+            break;
+        }
+    }
+    tv_fc_h2_flush(c);
+    if (c->dead) return;
+    if (c->goaway && c->nstreams == 0) { tv_fc_close(c); return; }
+    tv_origin_pump(c->origin);
+}
