diff --git a/runtime/h2.c b/runtime/h2.c
new file mode 100644
index 0000000..9bb7556
--- /dev/null
+++ b/runtime/h2.c
@@ -0,0 +1,340 @@
+/* HTTP/2 for fetch(): a thin client-side layer over the vendored nghttp2 (vendor/nghttp2). It is
+ * compiled into the same archive as runtime/tls.c, and tv_tls_install() points the runtime's
+ * tv_h2_impl at it, so only programs that fetch link it. The fetch client (runtime/tov.c) owns
+ * the sockets, TLS and request objects; this file turns its request heads into streams and the
+ * frames it reads into response heads, body bytes and stream ends. Nothing here does I/O. */
+
+#include "tov.h"
+#include <nghttp2/nghttp2.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+typedef struct tv_h2_stream tv_h2_stream;
+struct tv_h2_stream {
+    tv_h2_stream *next, *prev;
+    tv_h2 *h;
+    void *user;                  /* the request (NULL once it let go of the stream) */
+    int32_t id;
+    int status;
+    bool head_done;
+    char *lines;                 /* the response head's header lines, "name: value\r\n" */
+    size_t lines_len, lines_cap;
+    uint8_t *body;               /* the request body, copied */
+    size_t body_len, body_off;
+};
+
+struct tv_h2 {
+    nghttp2_session *session;
+    void *conn;
+    const tv_h2_events *ev;
+    uint8_t *out;                /* frames nghttp2 produced and the caller hasn't written yet */
+    size_t out_len, out_cap, out_off;
+    tv_h2_stream *streams;
+    int nstreams;
+    bool goaway;
+};
+
+static void lines_push(tv_h2_stream *st, const char *p, size_t n) {
+    if (st->lines_len + n > st->lines_cap) {
+        size_t cap = st->lines_cap ? st->lines_cap * 2 : 512;
+        while (cap < st->lines_len + n) cap *= 2;
+        st->lines = realloc(st->lines, cap);
+        st->lines_cap = cap;
+    }
+    memcpy(st->lines + st->lines_len, p, n);
+    st->lines_len += n;
+}
+
+static void stream_free(tv_h2_stream *st) {
+    tv_h2 *h = st->h;
+    if (st->prev) st->prev->next = st->next; else h->streams = st->next;
+    if (st->next) st->next->prev = st->prev;
+    h->nstreams--;
+    free(st->lines);
+    free(st->body);
+    free(st);
+}
+
+/* ---- nghttp2 callbacks */
+
+static tv_h2_stream *stream_of(nghttp2_session *s, int32_t id) {
+    return id > 0 ? (tv_h2_stream *)nghttp2_session_get_stream_user_data(s, id) : NULL;
+}
+
+static int on_header(nghttp2_session *s, const nghttp2_frame *frame, const uint8_t *name, size_t nlen, const uint8_t *value, size_t vlen, uint8_t flags, void *ud) {
+    (void)ud; (void)flags;
+    if (frame->hd.type != NGHTTP2_HEADERS) return 0;
+    tv_h2_stream *st = stream_of(s, frame->hd.stream_id);
+    if (!st || st->head_done) return 0; /* (trailers aren't kept) */
+    if (nlen == 7 && memcmp(name, ":status", 7) == 0) {
+        int code = 0;
+        for (size_t i = 0; i < vlen && i < 3; i++) code = code * 10 + (value[i] - '0');
+        st->status = code;
+        st->lines_len = 0;   /* a final response after an interim one starts over */
+        return 0;
+    }
+    if (nlen && name[0] == ':') return 0;
+    lines_push(st, (const char *)name, nlen);
+    lines_push(st, ": ", 2);
+    lines_push(st, (const char *)value, vlen);
+    lines_push(st, "\r\n", 2);
+    return 0;
+}
+
+static int on_frame_recv(nghttp2_session *s, const nghttp2_frame *frame, void *ud) {
+    tv_h2 *h = ud;
+    if (h->ev->frame) h->ev->frame(h->conn);
+    switch (frame->hd.type) {
+    case NGHTTP2_HEADERS: {
+        tv_h2_stream *st = stream_of(s, frame->hd.stream_id);
+        if (!st || st->head_done || !(frame->hd.flags & NGHTTP2_FLAG_END_HEADERS)) break;
+        if (st->status >= 200) {
+            st->head_done = true;
+            if (st->user) h->ev->head(st->user, st->status, st->lines ? st->lines : "", st->lines_len);
+        } else {
+            st->status = 0;   /* 1xx: the real head follows */
+            st->lines_len = 0;
+        }
+        break;
+    }
+    case NGHTTP2_PING:
+        if ((frame->hd.flags & NGHTTP2_FLAG_ACK) && h->ev->ping_ack) h->ev->ping_ack(h->conn);
+        break;
+    case NGHTTP2_SETTINGS:
+        if (!(frame->hd.flags & NGHTTP2_FLAG_ACK) && h->ev->settings) h->ev->settings(h->conn);
+        break;
+    case NGHTTP2_GOAWAY:
+        h->goaway = true;
+        if (h->ev->goaway) h->ev->goaway(h->conn, frame->goaway.last_stream_id, frame->goaway.error_code);
+        break;
+    default:
+        break;
+    }
+    return 0;
+}
+
+static int on_data(nghttp2_session *s, uint8_t flags, int32_t id, const uint8_t *data, size_t len, void *ud) {
+    (void)flags;
+    tv_h2 *h = ud;
+    tv_h2_stream *st = stream_of(s, id);
+    if (!st || !st->user) {   /* nobody wants it: the window it took is given back */
+        nghttp2_session_consume_connection(s, len);
+        return 0;
+    }
+    h->ev->data(st->user, data, len);
+    return 0;
+}
+
+static int on_close(nghttp2_session *s, int32_t id, uint32_t code, void *ud) {
+    tv_h2 *h = ud;
+    tv_h2_stream *st = stream_of(s, id);
+    if (!st) return 0;
+    void *user = st->user;
+    nghttp2_session_set_stream_user_data(s, id, NULL);
+    stream_free(st);
+    if (user) h->ev->closed(user, code);
+    return 0;
+}
+
+static nghttp2_ssize read_body(nghttp2_session *s, int32_t id, uint8_t *buf, size_t length, uint32_t *flags, nghttp2_data_source *src, void *ud) {
+    (void)s; (void)id; (void)ud;
+    tv_h2_stream *st = src->ptr;
+    size_t n = st->body_len - st->body_off;
+    if (n > length) n = length;
+    memcpy(buf, st->body + st->body_off, n);
+    st->body_off += n;
+    if (st->body_off == st->body_len) *flags |= NGHTTP2_DATA_FLAG_EOF;
+    return (nghttp2_ssize)n;
+}
+
+/* ---- the ops */
+
+static tv_h2 *h2_open(void *conn, const tv_h2_events *ev) {
+    tv_h2 *h = calloc(1, sizeof *h);
+    h->conn = conn;
+    h->ev = ev;
+    nghttp2_session_callbacks *cb;
+    nghttp2_session_callbacks_new(&cb);
+    nghttp2_session_callbacks_set_on_header_callback(cb, on_header);
+    nghttp2_session_callbacks_set_on_frame_recv_callback(cb, on_frame_recv);
+    nghttp2_session_callbacks_set_on_data_chunk_recv_callback(cb, on_data);
+    nghttp2_session_callbacks_set_on_stream_close_callback(cb, on_close);
+    nghttp2_option *opt;
+    nghttp2_option_new(&opt);
+    nghttp2_option_set_no_auto_window_update(opt, 1);   /* the reader's pace sets the windows */
+    nghttp2_option_set_peer_max_concurrent_streams(opt, 100);
+    int rc = nghttp2_session_client_new2(&h->session, cb, h, opt);
+    nghttp2_option_del(opt);
+    nghttp2_session_callbacks_del(cb);
+    if (rc != 0) { free(h); return NULL; }
+    nghttp2_settings_entry iv[2] = {
+        { NGHTTP2_SETTINGS_ENABLE_PUSH, 0 },
+        { NGHTTP2_SETTINGS_INITIAL_WINDOW_SIZE, 1 << 20 },
+    };
+    nghttp2_submit_settings(h->session, NGHTTP2_FLAG_NONE, iv, 2);
+    nghttp2_session_set_local_window_size(h->session, NGHTTP2_FLAG_NONE, 0, 16 << 20);
+    return h;
+}
+
+static void h2_destroy(tv_h2 *h) {
+    if (!h) return;
+    while (h->streams) {
+        tv_h2_stream *st = h->streams;
+        nghttp2_session_set_stream_user_data(h->session, st->id, NULL);
+        stream_free(st);
+    }
+    nghttp2_session_del(h->session);
+    free(h->out);
+    free(h);
+}
+
+/* A header the HTTP/1.1 head has that HTTP/2 doesn't carry. */
+static bool hop_by_hop(const char *n, size_t len) {
+    static const char *const names[] = { "connection", "keep-alive", "proxy-connection", "transfer-encoding", "upgrade", "te", "host" };
+    for (size_t i = 0; i < sizeof names / sizeof *names; i++)
+        if (strlen(names[i]) == len && strncasecmp(names[i], n, len) == 0) return true;
+    return false;
+}
+
+/* Starts a request from its HTTP/1.1 head ("GET /x HTTP/1.1\r\nName: v\r\n...\r\n\r\n") and body.
+ * The head's Host becomes :authority; hop-by-hop headers are dropped. The stream's handle, or NULL
+ * if it couldn't start. */
+static void *h2_submit(tv_h2 *h, void *user, const char *head, size_t head_len, bool https, const uint8_t *body, size_t blen, int32_t *sid) {
+    const char *end = head + head_len, *eol = memchr(head, '\n', head_len);
+    if (!eol) return NULL;
+    const char *sp1 = memchr(head, ' ', (size_t)(eol - head));
+    if (!sp1) return NULL;
+    const char *tgt = sp1 + 1, *sp2 = memchr(tgt, ' ', (size_t)(eol - tgt));
+    if (!sp2) return NULL;
+    size_t cap = 8;
+    for (const char *l = eol + 1; l < end; ) { const char *e = memchr(l, '\n', (size_t)(end - l)); if (!e) break; cap++; l = e + 1; }
+    nghttp2_nv *nv = calloc(cap, sizeof *nv);
+    char *scratch = malloc(head_len + 16);   /* lowercased header names */
+    size_t sc = 0, n = 0;
+    const char *authority = NULL;
+    size_t authority_len = 0;
+    for (const char *l = eol + 1; l < end; ) {
+        const char *e = memchr(l, '\n', (size_t)(end - l));
+        if (!e) break;
+        const char *le = e > l && e[-1] == '\r' ? e - 1 : e;
+        if (le == l) break;
+        const char *colon = memchr(l, ':', (size_t)(le - l));
+        if (colon && colon > l) {
+            size_t nl = (size_t)(colon - l);
+            const char *v = colon + 1;
+            while (v < le && (*v == ' ' || *v == '\t')) v++;
+            const char *ve = le;
+            while (ve > v && (ve[-1] == ' ' || ve[-1] == '\t')) ve--;
+            if (nl == 4 && strncasecmp(l, "host", 4) == 0) { authority = v; authority_len = (size_t)(ve - v); }
+            if (!hop_by_hop(l, nl)) {
+                for (size_t i = 0; i < nl; i++) scratch[sc + i] = (char)(l[i] >= 'A' && l[i] <= 'Z' ? l[i] + 32 : l[i]);
+                nv[4 + n].name = (uint8_t *)(scratch + sc);
+                nv[4 + n].namelen = nl;
+                nv[4 + n].value = (uint8_t *)v;
+                nv[4 + n].valuelen = (size_t)(ve - v);
+                nv[4 + n].flags = NGHTTP2_NV_FLAG_NONE;
+                sc += nl;
+                n++;
+            }
+        }
+        l = e + 1;
+    }
+    nv[0] = (nghttp2_nv){ (uint8_t *)":method", (uint8_t *)head, 7, (size_t)(sp1 - head), NGHTTP2_NV_FLAG_NONE };
+    nv[1] = (nghttp2_nv){ (uint8_t *)":scheme", (uint8_t *)(https ? "https" : "http"), 7, https ? 5u : 4u, NGHTTP2_NV_FLAG_NONE };
+    nv[2] = (nghttp2_nv){ (uint8_t *)":authority", (uint8_t *)(authority ? authority : ""), 10, authority_len, NGHTTP2_NV_FLAG_NONE };
+    nv[3] = (nghttp2_nv){ (uint8_t *)":path", (uint8_t *)tgt, 5, (size_t)(sp2 - tgt), NGHTTP2_NV_FLAG_NONE };
+    tv_h2_stream *st = calloc(1, sizeof *st);
+    st->h = h;
+    st->user = user;
+    nghttp2_data_provider2 prd;
+    nghttp2_data_provider2 *pp = NULL;
+    if (blen) {
+        st->body = malloc(blen);
+        memcpy(st->body, body, blen);
+        st->body_len = blen;
+        prd.source.ptr = st;
+        prd.read_callback = read_body;
+        pp = &prd;
+    }
+    int32_t id = nghttp2_submit_request2(h->session, NULL, nv, 4 + n, pp, st);
+    free(nv);
+    free(scratch);
+    if (id < 0) { free(st->body); free(st); return NULL; }
+    st->id = id;
+    st->next = h->streams;
+    if (h->streams) h->streams->prev = st;
+    h->streams = st;
+    h->nstreams++;
+    if (sid) *sid = id;
+    return st;
+}
+
+/* The request lets go of its stream: no more events for it, and the server is told to stop. */
+static void h2_cancel(tv_h2 *h, void *stream) {
+    tv_h2_stream *st = stream;
+    st->user = NULL;
+    nghttp2_submit_rst_stream(h->session, NGHTTP2_FLAG_NONE, st->id, NGHTTP2_CANCEL);
+}
+
+static long h2_feed(tv_h2 *h, const uint8_t *in, size_t n) {
+    nghttp2_ssize rc = nghttp2_session_mem_recv2(h->session, in, n);
+    return (long)rc;
+}
+
+/* Moves what nghttp2 has to send into the output buffer. */
+static void h2_fill(tv_h2 *h) {
+    for (;;) {
+        const uint8_t *data;
+        nghttp2_ssize n = nghttp2_session_mem_send2(h->session, &data);
+        if (n <= 0) break;
+        if (h->out_off == h->out_len) h->out_off = h->out_len = 0;
+        if (h->out_len + (size_t)n > h->out_cap) {
+            size_t cap = h->out_cap ? h->out_cap * 2 : 4096;
+            while (cap < h->out_len + (size_t)n) cap *= 2;
+            h->out = realloc(h->out, cap);
+            h->out_cap = cap;
+        }
+        memcpy(h->out + h->out_len, data, (size_t)n);
+        h->out_len += (size_t)n;
+    }
+}
+
+static const uint8_t *h2_pending(tv_h2 *h, size_t *n) {
+    h2_fill(h);
+    *n = h->out_len - h->out_off;
+    return *n ? h->out + h->out_off : NULL;
+}
+
+static void h2_sent(tv_h2 *h, size_t n) {
+    h->out_off += n;
+    if (h->out_off >= h->out_len) h->out_off = h->out_len = 0;
+}
+
+static void h2_consume(tv_h2 *h, void *stream, size_t n) {
+    tv_h2_stream *st = stream;
+    if (st) nghttp2_session_consume(h->session, st->id, n);
+    else nghttp2_session_consume_connection(h->session, n);
+}
+
+static bool h2_ping(tv_h2 *h) { return nghttp2_submit_ping(h->session, NGHTTP2_FLAG_NONE, NULL) == 0; }
+
+/* Streams that can still start on this connection (the server's limit, 100 until it says). */
+static int h2_capacity(tv_h2 *h) {
+    if (h->goaway) return 0;
+    uint32_t max = nghttp2_session_get_remote_settings(h->session, NGHTTP2_SETTINGS_MAX_CONCURRENT_STREAMS);
+    if (max > 1000) max = 1000;
+    return (int)max > h->nstreams ? (int)max - h->nstreams : 0;
+}
+
+static int h2_streams(tv_h2 *h) { return h->nstreams; }
+
+static bool h2_alive(tv_h2 *h) {
+    return !h->goaway && (nghttp2_session_want_read(h->session) || nghttp2_session_want_write(h->session));
+}
