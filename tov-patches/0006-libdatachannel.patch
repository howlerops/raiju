+void RtcpRemb::setSsrc(int num, SSRC newSsrc) {
+    if (num < 0 || num >= getSSRCCount())
+		throw std::out_of_range("SSRC num out of range");
+    _ssrcs[num] = htonl(newSsrc);
+}
