diff --git a/crates/tov/src/build/rtc.rs b/crates/tov/src/build/rtc.rs
new file mode 100644
index 0000000..092b7ac
--- /dev/null
+++ b/crates/tov/src/build/rtc.rs
@@ -0,0 +1,149 @@
+//! The WebRTC archive: runtime/rtc.c with libdatachannel, libjuice (ICE), usrsctp (SCTP) and libsrtp
+//! (vendor/rtc), on the vendored BoringSSL that the TLS archive carries. Only programs that use
+//! `std/rtc` link it. Their generated code calls `tv_rtc_install()` (see codegen), and build.rs links
+//! this archive in front of the TLS ones.
+//!
+//! The sources are embedded in the compiler (see ../../build.rs) and compiled here the first time a
+//! program needs them (a few minutes on four cores), then cached in the cache directory by a key made of
+//! the sources, the runtime header, the C compiler and the flags.
+
+use super::{cached, hash_hex, tls_files, BuildError, TlsArchive};
+use crate::codegen;
+use crate::tls_flags;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+mod rtc_files {
+    include!(concat!(env!("OUT_DIR"), "/rtc_files.rs"));
+}
+
+/// Include directories, relative to the repository.
+const INCLUDES: &[&str] = &[
+    "vendor/boringssl/include",
+    "vendor/rtc/datachannel/include",
+    "vendor/rtc/datachannel/include/rtc",
+    "vendor/rtc/datachannel/src",
+    "vendor/rtc/juice/include",
+    "vendor/rtc/juice/include/juice",
+    "vendor/rtc/plog/include",
+    "vendor/rtc/usrsctp/usrsctplib",
+    "vendor/rtc/srtp",
+    "vendor/rtc/srtp/include",
+    "vendor/rtc/srtp/crypto/include",
+    "runtime",
+];
+
+/// A source file's language flags (`None`: not one of the archive's sources).
+fn lang(path: &str) -> Option<Vec<&'static str>> {
+    let apple = cfg!(target_vendor = "apple");
+    if path.starts_with("vendor/rtc/datachannel/src/") && path.ends_with(".cpp") {
+        // (libdatachannel throws and catches; its media support is on, its WebSocket support off)
+        Some(vec!["-std=c++17", "-fexceptions", "-frtti", "-DRTC_STATIC", "-DRTC_ENABLE_MEDIA=1", "-DRTC_ENABLE_WEBSOCKET=0", "-DRTC_SYSTEM_SRTP=0", "-DRTC_SYSTEM_JUICE=0", "-DUSE_GNUTLS=0", "-DUSE_NICE=0", "-DJUICE_STATIC"])
+    } else if path.starts_with("vendor/rtc/juice/src/") && path.ends_with(".c") {
+        Some(vec!["-std=gnu11", "-DJUICE_STATIC", "-DRELEASE=1", "-DUSE_NETTLE=0"])
+    } else if path.starts_with("vendor/rtc/srtp/") && path.ends_with(".c") {
+        Some(vec!["-std=gnu99", "-DHAVE_CONFIG_H"])
+    } else if path.starts_with("vendor/rtc/usrsctp/") && path.ends_with(".c") {
+        let mut f = vec!["-std=c99", "-D__Userspace__", "-DSCTP_SIMPLE_ALLOCATOR", "-DSCTP_PROCESS_LEVEL_LOCKS", "-DHAVE_STDATOMIC_H", "-DHAVE_SYS_QUEUE_H", "-DHAVE_NETINET_IP_ICMP_H", "-DHAVE_NET_ROUTE_H"];
+        if apple {
+            f.extend(["-D__APPLE_USE_RFC_2292", "-DHAVE_SA_LEN", "-DHAVE_SIN_LEN", "-DHAVE_SIN6_LEN"]);
+        } else {
+            f.extend(["-D_GNU_SOURCE", "-DHAVE_LINUX_IF_ADDR_H", "-DHAVE_LINUX_RTNETLINK_H"]);
+        }
+        Some(f)
+    } else if path == "runtime/rtc.c" {
+        Some(vec!["-std=gnu11", "-DRTC_STATIC"])
+    } else {
+        None
+    }
+}
+
+pub struct RtcArchive {
+    key: String,
+    /// flags for C and C++ alike
+    flags: Vec<String>,
+}
+
+impl RtcArchive {
+    pub fn new(cc: &str, sysroot: Option<&str>, extra: &str) -> RtcArchive {
+        let sanitizers: Vec<&str> = if extra.contains("-fsanitize") { extra.split_whitespace().collect() } else { Vec::new() };
+        let mut flags: Vec<String> = tls_flags::FLAGS.iter().map(|f| f.to_string()).collect();
+        // (the TLS library's flags, with a lighter optimization: this is a lot of C++)
+        flags.push("-O2".into());
+        if let Some(sdk) = sysroot {
+            flags.push("-isysroot".into());
+            flags.push(sdk.into());
+        }
+        flags.extend(sanitizers.iter().map(|f| f.to_string()));
+        let key = hash_hex(&[rtc_files::RTC_KEY.as_bytes(), tls_files::VENDOR_KEY.as_bytes(), codegen::RUNTIME_H.as_bytes(), cc.as_bytes(), flags.join(" ").as_bytes()]);
+        RtcArchive { key, flags }
+    }
+
+    pub fn key(&self) -> &str {
+        &self.key
+    }
+
+    /// The archive to link, compiled first if it isn't cached.
+    pub fn build(&self, cc: &str, c_dir: &Path) -> Result<PathBuf, BuildError> {
+        let archive = c_dir.join(format!("rtc-{}.a", self.key));
+        if cached(&archive) {
+            return Ok(archive);
+        }
+        eprintln!("tov: compiling the WebRTC library (libdatachannel, libjuice, usrsctp, libsrtp); this happens once");
+        self.compile(cc, c_dir, &archive)?;
+        Ok(archive)
+    }
+
+    fn compile(&self, cc: &str, c_dir: &Path, archive: &Path) -> Result<(), BuildError> {
+        let fail = |what: String| BuildError::Message(format!("can't build the WebRTC library: {what}"));
+        let name = archive.file_stem().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+        let dir = c_dir.join(format!("{name}.tmp{}", std::process::id()));
+        // BoringSSL's headers (they ship with the TLS library's files), the runtime header, and ours
+        let headers = tls_files::TLS_FILES.iter().copied().filter(|f| f.0.starts_with("vendor/boringssl/include/"));
+        for (rel, bytes) in headers.chain(rtc_files::RTC_FILES.iter().copied()).chain([("runtime/tov.h", codegen::RUNTIME_H.as_bytes())]) {
+            let path = dir.join(rel);
+            std::fs::create_dir_all(path.parent().unwrap()).map_err(|e| fail(format!("{e}")))?;
+            std::fs::write(&path, bytes).map_err(|e| fail(format!("{e}")))?;
+        }
+        let sources: Vec<(&str, Vec<&str>)> = rtc_files::RTC_FILES.iter().filter_map(|f| lang(f.0).map(|l| (f.0, l))).collect();
+        let cxx = TlsArchive::cxx(cc);
+        let include: Vec<String> = INCLUDES.iter().map(|p| format!("-I{}", dir.join(p).display())).collect();
+        let threads = std::thread::available_parallelism().map_or(4, |n| n.get()).min(sources.len().max(1));
+        let next = std::sync::atomic::AtomicUsize::new(0);
+        let errors = std::sync::Mutex::new(Vec::new());
+        std::thread::scope(|s| {
+            for _ in 0..threads {
+                s.spawn(|| loop {
+                    let i = next.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+                    let Some((src, lang)) = sources.get(i) else { break };
+                    let compiler: &str = if src.ends_with(".cpp") { &cxx } else { cc };
+                    let out = Command::new(compiler).args(&self.flags).args(lang).args(&include).arg("-c").arg(dir.join(src)).arg("-o").arg(dir.join(format!("{i}.o"))).output();
+                    match out {
+                        Ok(o) if o.status.success() => {}
+                        Ok(o) => errors.lock().unwrap().push(format!("{src}: {}", String::from_utf8_lossy(&o.stderr).lines().take(5).collect::<Vec<_>>().join("\n"))),
+                        Err(e) => errors.lock().unwrap().push(format!("{src}: can't run `{compiler}`: {e}")),
+                    }
+                });
+            }
+        });
+        if let Some(e) = errors.into_inner().unwrap().first() {
+            let _ = std::fs::remove_dir_all(&dir);
+            return Err(fail(e.clone()));
+        }
+        // the toolchain's own archiver (next to the compiler we picked), else the one on PATH
+        let ar = Path::new(cc).parent().map(|d| d.join("ar")).filter(|p| p.is_file()).map_or("ar".to_string(), |p| p.to_string_lossy().into_owned());
+        let tmp = c_dir.join(format!("{name}.tmp{}.a", std::process::id()));
+        let objs: Vec<PathBuf> = (0..sources.len()).map(|i| dir.join(format!("{i}.o"))).collect();
+        let out = Command::new(&ar).arg("rcs").arg(&tmp).args(&objs).output().map_err(|e| fail(format!("can't run `{ar}`: {e}")))?;
+        let _ = std::fs::remove_dir_all(&dir);
+        if !out.status.success() {
+            let _ = std::fs::remove_file(&tmp);
+            return Err(fail(format!("`{ar}` failed: {}", String::from_utf8_lossy(&out.stderr))));
+        }
+        std::fs::rename(&tmp, archive).map_err(|e| {
+            let _ = std::fs::remove_file(&tmp);
+            fail(format!("can't move it into the cache: {e}"))
+        })?;
+        Ok(())
+    }
+}
