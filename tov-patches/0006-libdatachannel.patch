+std::ostream &operator<<(std::ostream &out, LogLevel level) {
+	switch (level) {
+	case LogLevel::Fatal:
+		out << "fatal";
+		break;
+	case LogLevel::Error:
+		out << "error";
+		break;
+	case LogLevel::Warning:
+		out << "warning";
+		break;
+	case LogLevel::Info:
+		out << "info";
+		break;
+	case LogLevel::Debug:
+		out << "debug";
+		break;
+	case LogLevel::Verbose:
+		out << "verbose";
+		break;
+	default:
+		out << "none";
+		break;
+	}
+	return out;
+}
