+const RtcpSdesItem *RtcpSdesChunk::getItem(int num) const {
+	auto base = &_items;
+	while (num-- > 0) {
+		auto itemSize = RtcpSdesItem::Size(base->length());
+		base = reinterpret_cast<const RtcpSdesItem *>(reinterpret_cast<const uint8_t *>(base) +
+		                                              itemSize);
+	}
