+
+namespace rtc::gnutls {
+
+// Return false on non-fatal error
+bool check(int ret, const string &message) {
+	if (ret < 0) {
+		if (!gnutls_error_is_fatal(ret)) {
+			return false;
+		}
+		throw std::runtime_error(message + ": " + gnutls_strerror(ret));
+	}
