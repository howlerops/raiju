+/* rtc.c — WebRTC for Tov programs, on libdatachannel (vendor/rtc).
+ *
+ * The build compiles this file with libdatachannel, libjuice (ICE), usrsctp (SCTP data channels),
+ * libsrtp (SRTP) and the vendored BoringSSL (DTLS) into an archive that only programs using
+ * RTCPeerConnection (std/rtc) link: their generated code calls tv_rtc_install(), which points the
+ * runtime's `tv_rtc_impl` at the operations below. The runtime never names anything here directly.
+ *
+ * libdatachannel runs its own threads and calls back from them. Nothing here touches the Tov
+ * runtime from those threads: each callback appends an event to a queue under a mutex and writes
+ * a byte to the wake pipe the runtime watches on its event loop (runtime/net.c, "WebRTC"). The
+ * loop then pops the events and runs the program's callbacks on its own thread.
+ *
+ * Ids are libdatachannel's: one number space for peer connections, data channels and tracks. A
+ * channel or track made by the remote side gets its callbacks installed here, before libdatachannel
+ * returns from announcing it, so no event of it is missed. */
+
+#include "tov.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <rtc/rtc.h>
+
+/* event kinds (see tov.h) */
+enum {
+    EV_STATE = 1, EV_ICE, EV_GATHERING, EV_SIGNALING, EV_DESCRIPTION, EV_CANDIDATE, EV_CHANNEL,
+    EV_TRACK, EV_OPEN, EV_CLOSED, EV_ERROR, EV_MESSAGE, EV_PACKET, EV_LOW
+};
+
+/* RTP packets are dropped (not queued) beyond this many waiting events, so a stalled loop can't
+ * grow the queue without bound; the other events are few and always kept. */
+#define TV_RTC_MAX_PACKETS 4096
+
+typedef struct node {
+    struct node *next;
+    tv_rtc_event ev;
+} node;
+
+static pthread_mutex_t mu = PTHREAD_MUTEX_INITIALIZER;
+static node *head, *tail;
+static int queued;
+static int wake_fd = -1;
+
+/* the peer connections made here, closed at exit */
+#define MAX_PCS 4096
+static int pcs[MAX_PCS];
+static int npcs;
+static bool exit_hook;
+
+static void push(int kind, int id, int n, const char *a, size_t alen, const char *b) {
+    node *x = calloc(1, sizeof *x);
+    if (!x) return;
+    x->ev.kind = kind;
+    x->ev.id = id;
+    x->ev.n = n;
+    if (alen) {
+        x->ev.a = malloc(alen);
+        if (!x->ev.a) {
+            free(x);
+            return;
+        }
+        memcpy(x->ev.a, a, alen);
+        x->ev.alen = alen;
+    }
+    if (b) x->ev.b = strdup(b);
+    pthread_mutex_lock(&mu);
+    if (kind == EV_PACKET && queued >= TV_RTC_MAX_PACKETS) {
+        pthread_mutex_unlock(&mu);
+        free(x->ev.a);
+        free(x->ev.b);
+        free(x);
+        return;
+    }
+    if (tail) tail->next = x;
+    else head = x;
+    tail = x;
+    queued++;
+    pthread_mutex_unlock(&mu);
+    if (wake_fd >= 0) {
+        char c = 1;
+        ssize_t w = write(wake_fd, &c, 1);   /* (a full pipe already holds a wake-up) */
+        (void)w;
+    }
+}
+
+static bool next_event(tv_rtc_event *out) {
+    pthread_mutex_lock(&mu);
+    node *x = head;
+    if (x) {
+        head = x->next;
+        if (!head) tail = NULL;
+        queued--;
+    }
+    pthread_mutex_unlock(&mu);
+    if (!x) return false;
+    *out = x->ev;
+    free(x);
+    return true;
+}
+
+static void release_event(tv_rtc_event *ev) {
+    free(ev->a);
+    free(ev->b);
+    ev->a = NULL;
+    ev->b = NULL;
+}
+
+/* ---- callbacks (libdatachannel's threads) */
+
+static void cb_state(int pc, rtcState s, void *p) { (void)p; push(EV_STATE, pc, (int)s, NULL, 0, NULL); }
+static void cb_ice(int pc, rtcIceState s, void *p) { (void)p; push(EV_ICE, pc, (int)s, NULL, 0, NULL); }
+static void cb_gathering(int pc, rtcGatheringState s, void *p) { (void)p; push(EV_GATHERING, pc, (int)s, NULL, 0, NULL); }
+static void cb_signaling(int pc, rtcSignalingState s, void *p) { (void)p; push(EV_SIGNALING, pc, (int)s, NULL, 0, NULL); }
+static void cb_description(int pc, const char *sdp, const char *type, void *p) {
+    (void)p;
+    push(EV_DESCRIPTION, pc, 0, sdp, strlen(sdp), type);
+}
+static void cb_candidate(int pc, const char *cand, const char *mid, void *p) {
+    (void)p;
+    push(EV_CANDIDATE, pc, 0, cand, strlen(cand), mid);
+}
+static void cb_open(int id, void *p) { (void)p; push(EV_OPEN, id, 0, NULL, 0, NULL); }
+static void cb_closed(int id, void *p) { (void)p; push(EV_CLOSED, id, 0, NULL, 0, NULL); }
+static void cb_error(int id, const char *e, void *p) { (void)p; push(EV_ERROR, id, 0, e, e ? strlen(e) : 0, NULL); }
+static void cb_low(int id, void *p) { (void)p; push(EV_LOW, id, 0, NULL, 0, NULL); }
+static void cb_message(int id, const char *m, int size, void *p) {
+    (void)p;
+    if (size < 0) push(EV_MESSAGE, id, 1, m, strlen(m), NULL);   /* text */
+    else push(EV_MESSAGE, id, 0, m, (size_t)size, NULL);          /* binary */
+}
+static void cb_packet(int id, const char *m, int size, void *p) {
+    (void)p;
+    if (size > 0) push(EV_PACKET, id, 0, m, (size_t)size, NULL);
+}
+
+static void watch_channel(int id) {
+    rtcSetOpenCallback(id, cb_open);
+    rtcSetClosedCallback(id, cb_closed);
+    rtcSetErrorCallback(id, cb_error);
+    rtcSetMessageCallback(id, cb_message);
+    rtcSetBufferedAmountLowCallback(id, cb_low);
+}
+
+static void watch_track(int id) {
+    rtcSetOpenCallback(id, cb_open);
+    rtcSetClosedCallback(id, cb_closed);
+    rtcSetErrorCallback(id, cb_error);
+    rtcSetMessageCallback(id, cb_packet);
+}
+
+static void cb_channel(int pc, int dc, void *p) {
+    (void)p;
+    char label[256] = "";
+    watch_channel(dc);
+    rtcGetDataChannelLabel(dc, label, sizeof label);
+    push(EV_CHANNEL, pc, dc, NULL, 0, label);
+}
+
+static void cb_track(int pc, int tr, void *p) {
+    (void)p;
+    char mid[64] = "";
+    watch_track(tr);
+    rtcChainRtcpReceivingSession(tr);
+    rtcGetTrackMid(tr, mid, sizeof mid);
+    push(EV_TRACK, pc, tr, NULL, 0, mid);
+}
+
+static void cb_log(rtcLogLevel level, const char *message) {
+    static const char *names[] = {"none", "fatal", "error", "warning", "info", "debug", "verbose"};
+    fprintf(stderr, "rtc %s: %s\n", names[level < 0 || level > 6 ? 0 : level], message);
+}
+
+/* ---- the operations (the loop's thread) */
+
+static void close_all(void) {
+    pthread_mutex_lock(&mu);
+    int n = npcs;
+    int ids[MAX_PCS];
+    memcpy(ids, pcs, (size_t)n * sizeof *ids);
+    npcs = 0;
+    pthread_mutex_unlock(&mu);
+    for (int i = 0; i < n; i++) {
+        rtcClosePeerConnection(ids[i]);
+        rtcDeletePeerConnection(ids[i]);
+    }
+    if (n) rtcCleanup();
+}
+
+static int start(int fd) {
+    wake_fd = fd;
+    if (!exit_hook) {
+        exit_hook = true;
+        const char *lv = getenv("TOV_RTC_LOG");
+        rtcLogLevel level = RTC_LOG_ERROR;
+        if (lv && *lv) {
+            level = strcmp(lv, "debug") == 0 ? RTC_LOG_DEBUG : strcmp(lv, "info") == 0 ? RTC_LOG_INFO : strcmp(lv, "warning") == 0 ? RTC_LOG_WARNING : strcmp(lv, "none") == 0 ? RTC_LOG_NONE : RTC_LOG_ERROR;
+        }
+        rtcInitLogger(level, cb_log);
+        atexit(close_all);
+    }
+    return 0;
+}
+
+/* servers: ICE server URLs, one per line. */
+static int peer(const char *servers, const char *bind, int max_message, int port_begin, int port_end, int mtu) {
+    const char *urls[64];
+    char *copy = strdup(servers ? servers : "");
+    int n = 0;
+    if (!copy) return RTC_ERR_FAILURE;
+    for (char *s = copy; *s && n < 64;) {
+        char *e = strchr(s, '\n');
+        if (e) *e = 0;
+        if (*s) urls[n++] = s;
+        if (!e) break;
+        s = e + 1;
+    }
+    rtcConfiguration c;
+    memset(&c, 0, sizeof c);
+    c.iceServers = n ? urls : NULL;
+    c.iceServersCount = n;
+    c.bindAddress = bind && *bind ? bind : NULL;
+    c.maxMessageSize = max_message > 0 ? max_message : 0;
+    c.portRangeBegin = (uint16_t)port_begin;
+    c.portRangeEnd = (uint16_t)port_end;
+    c.mtu = mtu > 0 ? mtu : 0;
+    int pc = rtcCreatePeerConnection(&c);
+    free(copy);
+    if (pc < 0) return pc;
+    rtcSetStateChangeCallback(pc, cb_state);
+    rtcSetIceStateChangeCallback(pc, cb_ice);
+    rtcSetGatheringStateChangeCallback(pc, cb_gathering);
+    rtcSetSignalingStateChangeCallback(pc, cb_signaling);
+    rtcSetLocalDescriptionCallback(pc, cb_description);
+    rtcSetLocalCandidateCallback(pc, cb_candidate);
+    rtcSetDataChannelCallback(pc, cb_channel);
+    rtcSetTrackCallback(pc, cb_track);
+    pthread_mutex_lock(&mu);
+    if (npcs < MAX_PCS) pcs[npcs++] = pc;
+    pthread_mutex_unlock(&mu);
+    return pc;
+}
+
+static int set_remote(int pc, const char *sdp, const char *type) { return rtcSetRemoteDescription(pc, sdp, type && *type ? type : NULL); }
+static int set_local(int pc, const char *type) { return rtcSetLocalDescription(pc, type && *type ? type : NULL); }
+static int add_candidate(int pc, const char *cand, const char *mid) { return rtcAddRemoteCandidate(pc, cand, mid && *mid ? mid : NULL); }
+
+/* flags: 1 unordered, 2 negotiated (then stream is the id) */
+static int channel(int pc, const char *label, const char *protocol, int flags, int stream) {
+    rtcDataChannelInit init;
+    memset(&init, 0, sizeof init);
+    init.reliability.unordered = (flags & 1) != 0;
+    init.protocol = protocol && *protocol ? protocol : NULL;
+    init.negotiated = (flags & 2) != 0;
+    init.manualStream = init.negotiated;
+    init.stream = (uint16_t)stream;
+    int dc = rtcCreateDataChannelEx(pc, label, &init);
+    if (dc >= 0) watch_channel(dc);
+    return dc;
+}
+
+/* codec: 0 opus, 1 pcmu, 2 pcma. direction: rtcDirection. */
+static int track(int pc, int direction, int codec, int pt, unsigned ssrc, const char *mid, const char *name, const char *profile) {
+    rtcTrackInit t;
+    memset(&t, 0, sizeof t);
+    t.direction = (rtcDirection)direction;
+    t.codec = codec == 1 ? RTC_CODEC_PCMU : codec == 2 ? RTC_CODEC_PCMA : RTC_CODEC_OPUS;
+    t.payloadType = pt;
+    t.ssrc = ssrc;
+    t.mid = mid && *mid ? mid : NULL;
+    t.name = name && *name ? name : NULL;
+    t.profile = profile && *profile ? profile : NULL;
+    int tr = rtcAddTrackEx(pc, &t);
+    if (tr >= 0) {
+        watch_track(tr);
+        rtcChainRtcpReceivingSession(tr);
+    }
+    return tr;
+}
+
+static int send_message(int id, const uint8_t *p, int n, int text) {
+    if (text) {
+        char *s = malloc((size_t)n + 1);
+        if (!s) return RTC_ERR_FAILURE;
+        memcpy(s, p, (size_t)n);
+        s[n] = 0;
+        int r = rtcSendMessage(id, s, -1);
+        free(s);
+        return r;
+    }
+    return rtcSendMessage(id, (const char *)p, n);
+}
+
+/* Sends an RTP packet on a track, with its SSRC and payload type rewritten when ssrc / pt are
+ * not negative (a relay forwards one leg's packets on the other leg's stream). */
+static int send_rtp(int id, const uint8_t *p, int n, long ssrc, int pt) {
+    if (n < 12) return RTC_ERR_INVALID;
+    uint8_t stack[2048];
+    uint8_t *b = n <= (int)sizeof stack ? stack : malloc((size_t)n);
+    if (!b) return RTC_ERR_FAILURE;
+    memcpy(b, p, (size_t)n);
+    if (pt >= 0) b[1] = (uint8_t)((b[1] & 0x80) | (pt & 0x7f));
+    if (ssrc >= 0) {
+        b[8] = (uint8_t)(ssrc >> 24);
+        b[9] = (uint8_t)(ssrc >> 16);
+        b[10] = (uint8_t)(ssrc >> 8);
+        b[11] = (uint8_t)ssrc;
+    }
+    int r = rtcSendMessage(id, (const char *)b, n);
+    if (b != stack) free(b);
+    return r;
+}
+
+/* Closes and frees a peer connection, channel or track. Its callbacks stop; whatever it already
+ * queued here is still delivered (the program ignores events of ids it has dropped). */
+static void close_id(int id, int kind) {
+    if (kind == 0) {
+        pthread_mutex_lock(&mu);
+        for (int i = 0; i < npcs; i++) {
+            if (pcs[i] == id) {
+                pcs[i] = pcs[--npcs];
+                break;
+            }
+        }
+        pthread_mutex_unlock(&mu);
+        rtcClosePeerConnection(id);
+        rtcDeletePeerConnection(id);
+    } else if (kind == 1) {
+        rtcClose(id);
+        rtcDeleteDataChannel(id);
+    } else {
+        rtcClose(id);
+        rtcDeleteTrack(id);
+    }
+}
+
+static int buffered(int id) { return rtcGetBufferedAmount(id); }
+static int set_low(int id, int amount) { return rtcSetBufferedAmountLowThreshold(id, amount); }
+
+/* A text property of an id, malloc'd (NULL: none). which: 0 local description, 1 its type, 2 remote
+ * description, 3 channel label, 4 channel protocol, 5 track mid, 6 the selected candidate pair as
+ * "local\nremote", 7 the track's opus payload type, 8 a track's direction, 9 the remote max message
+ * size of a peer connection. */
+static int text_of(int id, int which, char *buf, int cap) {
+    switch (which) {
+    case 0: return rtcGetLocalDescription(id, buf, cap);
+    case 1: return rtcGetLocalDescriptionType(id, buf, cap);
+    case 2: return rtcGetRemoteDescription(id, buf, cap);
+    case 3: return rtcGetDataChannelLabel(id, buf, cap);
+    case 4: return rtcGetDataChannelProtocol(id, buf, cap);
+    case 5: return rtcGetTrackMid(id, buf, cap);
+    }
+    return RTC_ERR_INVALID;
+}
+
+static char *info(int id, int which) {
+    if (which <= 5) {
+        int n = text_of(id, which, NULL, 0);   /* the size it needs, with the NUL */
+        if (n <= 0) return NULL;
+        char *buf = malloc((size_t)n);
+        if (!buf) return NULL;
+        if (text_of(id, which, buf, n) < 0) {
+            free(buf);
+            return NULL;
+        }
+        return buf;
+    }
+    char buf[1200];
+    buf[0] = 0;
+    switch (which) {
+    case 6: {
+        char local[512], remote[512];
+        if (rtcGetSelectedCandidatePair(id, local, sizeof local, remote, sizeof remote) < 0) return NULL;
+        snprintf(buf, sizeof buf, "%s\n%s", local, remote);
+        break;
+    }
+    case 7: {
+        int pts[8];
+        if (rtcGetTrackPayloadTypesForCodec(id, "opus", pts, 8) <= 0) return NULL;
+        snprintf(buf, sizeof buf, "%d", pts[0]);
+        break;
+    }
+    case 8: {
+        static const char *names[] = {"unknown", "sendonly", "recvonly", "sendrecv", "inactive"};
+        rtcDirection d = RTC_DIRECTION_UNKNOWN;
+        if (rtcGetTrackDirection(id, &d) < 0) return NULL;
+        snprintf(buf, sizeof buf, "%s", names[(int)d < 0 || (int)d > 4 ? 0 : (int)d]);
+        break;
+    }
+    case 9: {
+        int n = rtcGetRemoteMaxMessageSize(id);
+        if (n < 0) return NULL;
+        snprintf(buf, sizeof buf, "%d", n);
+        break;
+    }
+    default:
+        return NULL;
+    }
+    return strdup(buf);
+}
+
+static void release_text(char *s) { free(s); }
+
+static const tv_rtc_ops table = {
+    start, peer, set_remote, set_local, add_candidate, channel, track, send_message, send_rtp, close_id, buffered, set_low, info, release_text, next_event, release_event,
+};
+
+void tv_rtc_install(void) {
+    tv_rtc_impl = &table;
+}
diff --git a/runtime/tov.h b/runtime/tov.h
index df5b2ce..cd2b2e3 100644
--- a/runtime/tov.h
+++ b/runtime/tov.h
@@ -919,6 +919,51 @@ tv_int tv_native_wasmMemSize(tv_int h);
 tv_str tv_native_wasmOutput(tv_int h);
 void tv_native_wasmFree(tv_int h);
 tv_str tv_native_wasmError(void);
+/* WebRTC (runtime/rtc.c, in an archive of its own with libdatachannel: programs using std/rtc call
+ * tv_rtc_install, which sets tv_rtc_impl). The library runs threads and calls back from them; they
+ * queue events and wake the loop through a pipe (rtcStart), and the loop (runtime/net.c) pops them
+ * and runs the program's closure with (kind, id, n, bytes, text). One id space covers peer
+ * connections, data channels and tracks. Natives return an id or 0, or a negative error. Event kinds:
+ * 1 state (id: pc, n: 0 new .. 5 closed), 2 ICE state, 3 gathering state (2 = complete), 4 signaling
+ * state, 5 local description (bytes: SDP, text: type), 6 local candidate (bytes, text: mid),
+ * 7 data channel from the remote (id: pc, n: its id, text: label), 8 track from the remote (id: pc,
+ * n: its id, text: mid), 9 open, 10 closed, 11 error (bytes: message), 12 data channel message (n: 1
+ * for text), 13 RTP packet of a track, 14 buffered amount low. */
+typedef struct tv_rtc_event { int kind, id, n; char *a; size_t alen; char *b; } tv_rtc_event;
+typedef struct tv_rtc_ops {
+    int (*start)(int wake_fd);
+    int (*peer)(const char *servers, const char *bind, int max_message, int port_begin, int port_end, int mtu);
+    int (*set_remote)(int pc, const char *sdp, const char *type);
+    int (*set_local)(int pc, const char *type);
+    int (*add_candidate)(int pc, const char *cand, const char *mid);
+    int (*channel)(int pc, const char *label, const char *protocol, int flags, int stream);
+    int (*track)(int pc, int direction, int codec, int pt, unsigned ssrc, const char *mid, const char *name, const char *profile);
+    int (*send)(int id, const uint8_t *p, int n, int text);
+    int (*send_rtp)(int id, const uint8_t *p, int n, long ssrc, int pt);
+    void (*close)(int id, int kind);
+    int (*buffered)(int id);
+    int (*set_low)(int id, int amount);
+    char *(*info)(int id, int which);
+    void (*release_text)(char *s);
+    bool (*next)(tv_rtc_event *ev);
+    void (*release)(tv_rtc_event *ev);
+} tv_rtc_ops;
+extern const tv_rtc_ops *tv_rtc_impl;
+void tv_rtc_install(void);
+tv_int tv_native_rtcStart(tv_fn events);
+tv_int tv_native_rtcPeer(tv_str servers, tv_str bind, tv_int max_message, tv_int port_begin, tv_int port_end, tv_int mtu);
+tv_int tv_native_rtcSetRemote(tv_int pc, tv_str sdp, tv_str type);
+tv_int tv_native_rtcSetLocal(tv_int pc, tv_str type);
+tv_int tv_native_rtcCandidate(tv_int pc, tv_str cand, tv_str mid);
+tv_int tv_native_rtcChannel(tv_int pc, tv_str label, tv_str protocol, tv_int flags, tv_int stream);
+tv_int tv_native_rtcTrack(tv_int pc, tv_int direction, tv_int codec, tv_int pt, tv_int ssrc, tv_str mid, tv_str name, tv_str profile);
+tv_int tv_native_rtcSend(tv_int id, tv_arr bytes, bool text);
+tv_int tv_native_rtcSendText(tv_int id, tv_str text);
+tv_int tv_native_rtcSendRtp(tv_int id, tv_arr packet, tv_int ssrc, tv_int pt);
+void tv_native_rtcClose(tv_int id, tv_int kind);
+tv_int tv_native_rtcBuffered(tv_int id);
+tv_int tv_native_rtcSetLow(tv_int id, tv_int amount);
+tv_str tv_native_rtcInfo(tv_int id, tv_int which);
 /* WebSockets (runtime/ws.c): Bun.serve's websocket and the WebSocket client */
 tv_int tv_native_wsUpgrade(tv_str key, tv_str headers, tv_int max_payload);
 tv_int tv_native_wsConnect(tv_str host, tv_int port, tv_str path, bool tls, bool verify, tv_str ca, tv_str headers, tv_str protocols, tv_int max_payload);
