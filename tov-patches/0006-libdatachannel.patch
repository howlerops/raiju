diff --git a/crates/tov/src/std/rtc.tov b/crates/tov/src/std/rtc.tov
new file mode 100644
index 0000000..49950d5
--- /dev/null
+++ b/crates/tov/src/std/rtc.tov
@@ -0,0 +1,519 @@
+// std/rtc: WebRTC peer connections (libdatachannel, linked into programs that use this module).
+//
+//   import { RTCPeerConnection } from "std/rtc"
+//
+//   const pc = new RTCPeerConnection({ iceServers: ["stun:stun.example.test:3478"] })
+//   pc.ondatachannel = (ch) => { ch.onmessage = (m) => ch.send(m) }
+//   pc.ontrack = (t) => { t.onpacket = (rtp) => other.sendRtp(rtp) }
+//   pc.setRemoteDescription(offerSdp, "offer")      // the answer is made on its own
+//   pc.onlocaldescription = (sdp, type) => ...       // the SDP; candidates follow as they are found
+//   pc.ongatheringchange = (s) => { if (s === "complete") reply(pc.localDescription) }
+//
+// The library runs threads of its own; its events reach the program's event loop and the callbacks
+// below run there, one at a time. Audio is RTP packets in and out (u8[], no decoding). A peer
+// connection, channel or track is freed by close(), which also drops its callbacks (that is what
+// breaks the cycle between an object and the closures that name it); nothing fires after close().
+
+export type RTCConfig = {
+  // "stun:host:port", "turn:user:pass@host:port" ...
+  iceServers?: string[]
+  // bind the ICE sockets to this local address only (default: every interface)
+  bindAddress?: string
+  // the largest message a data channel accepts (default 262144)
+  maxMessageSize?: int
+  portRangeBegin?: int
+  portRangeEnd?: int
+  mtu?: int
+}
+
+export type RTCTrackOptions = {
+  mid?: string
+  // "sendrecv" (default), "sendonly" or "recvonly"
+  direction?: string
+  // "opus" (default), "pcmu" or "pcma"
+  codec?: string
+  payloadType?: int
+  // the stream's SSRC (default: the library picks)
+  ssrc?: int
+  name?: string
+  // the codec's fmtp line, e.g. "minptime=10;useinbandfec=1"
+  profile?: string
+}
+
+export type RTCChannelOptions = {
+  unordered?: bool
+  protocol?: string
+  // a channel both sides create, under this stream id
+  negotiated?: bool
+  stream?: int
+}
+
+const STATES: string[] = ["new", "connecting", "connected", "disconnected", "failed", "closed"]
+const GATHERING: string[] = ["new", "gathering", "complete"]
+const ICE_STATES: string[] = ["new", "checking", "connected", "completed", "failed", "disconnected", "closed"]
+
+export class RTCDataChannel {
+  readonly label: string
+  // "connecting", "open" or "closed"
+  readyState: string
+  onopen: (() => void) | undefined
+  onclose: (() => void) | undefined
+  onerror: ((message: string) => void) | undefined
+  onmessage: ((data: string | u8[]) => void) | undefined
+  onbufferedamountlow: (() => void) | undefined
+  private id: int
+  private freed: bool
+
+  constructor(id: int, label: string, state: string) {
+    this.id = id
+    this.freed = false
+    this.label = label
+    this.readyState = state
+    this.onopen = undefined
+    this.onclose = undefined
+    this.onerror = undefined
+    this.onmessage = undefined
+    this.onbufferedamountlow = undefined
+  }
+
+  get channelId(): int {
+    return this.id
+  }
+
+  // Sends text or bytes. False when it didn't go (the channel is not open, or the message is too big).
+  send(data: string | u8[]): bool {
+    if (this.readyState !== "open") {
+      return false
+    }
+    if (typeof data === "string") {
+      return __native.rtcSendText(this.id, data) >= 0
+    }
+    return __native.rtcSend(this.id, data, false) >= 0
+  }
+
+  // Bytes queued to send, not yet written to the network.
+  get bufferedAmount(): int {
+    const n = __native.rtcBuffered(this.id)
+    return n < 0 ? 0 : n
+  }
+
+  // onbufferedamountlow runs when the queue falls to this many bytes or less.
+  setBufferedAmountLowThreshold(bytes: int): void {
+    __native.rtcSetLow(this.id, bytes)
+  }
+
+  // Closes and frees the channel. Its callbacks are dropped and not called.
+  close(): void {
+    if (this.freed) {
+      return
+    }
+    this.freed = true
+    this.readyState = "closed"
+    this.drop()
+    RTC_HUB.channels.delete(this.id)
+    __native.rtcClose(this.id, 1)
+  }
+
+  // Internal: forgets the callbacks.
+  drop(): void {
+    this.onopen = undefined
+    this.onclose = undefined
+    this.onerror = undefined
+    this.onmessage = undefined
+    this.onbufferedamountlow = undefined
+  }
+}
+
+export class RTCTrack {
+  readonly mid: string
+  // "connecting", "open" or "closed"
+  readyState: string
+  onopen: (() => void) | undefined
+  onclose: (() => void) | undefined
+  // an RTP packet arrived (RTCP is handled by the library)
+  onpacket: ((packet: u8[]) => void) | undefined
+  private id: int
+  private freed: bool
+
+  constructor(id: int, mid: string) {
+    this.id = id
+    this.freed = false
+    this.mid = mid
+    this.readyState = "connecting"
+    this.onopen = undefined
+    this.onclose = undefined
+    this.onpacket = undefined
+  }
+
+  get trackId(): int {
+    return this.id
+  }
+
+  // "sendrecv", "sendonly", "recvonly" or "inactive" as negotiated.
+  get direction(): string {
+    return __native.rtcInfo(this.id, 8)
+  }
+
+  // The payload type negotiated for Opus on this track, or -1.
+  get payloadType(): int {
+    const s = __native.rtcInfo(this.id, 7)
+    return parseInt(s) ?? -1
+  }
+
+  // Sends an RTP packet. A negative ssrc or payloadType keeps the packet's own; otherwise the header
+  // is rewritten, which is how a relay puts one leg's packets on the other leg's stream. False when it
+  // didn't go (the track is not open).
+  sendRtp(packet: u8[], ssrc?: int, payloadType?: int): bool {
+    if (this.readyState !== "open") {
+      return false
+    }
+    return __native.rtcSendRtp(this.id, packet, ssrc ?? -1, payloadType ?? -1) >= 0
+  }
+
+  close(): void {
+    if (this.freed) {
+      return
+    }
+    this.freed = true
+    this.readyState = "closed"
+    this.drop()
+    RTC_HUB.tracks.delete(this.id)
+    __native.rtcClose(this.id, 2)
+  }
+
+  drop(): void {
+    this.onopen = undefined
+    this.onclose = undefined
+    this.onpacket = undefined
+  }
+}
+
+export class RTCPeerConnection {
+  // "new", "connecting", "connected", "disconnected", "failed" or "closed"
+  state: string
+  // "new", "gathering" or "complete"
+  gatheringState: string
+  // "new", "checking", "connected", "completed", "failed", "disconnected" or "closed"
+  iceState: string
+  onstatechange: ((state: string) => void) | undefined
+  ongatheringchange: ((state: string) => void) | undefined
+  oniceconnectionchange: ((state: string) => void) | undefined
+  // the local description is ready: SDP and its type ("offer" or "answer")
+  onlocaldescription: ((sdp: string, type: string) => void) | undefined
+  // a local ICE candidate (trickle); the SDP of a complete gathering holds them all
+  onicecandidate: ((candidate: string, mid: string) => void) | undefined
+  // the remote side opened a data channel / a media track
+  ondatachannel: ((channel: RTCDataChannel) => void) | undefined
+  ontrack: ((track: RTCTrack) => void) | undefined
+  private id: int
+  private done: bool
+  private channels: RTCDataChannel[]
+  private tracks: RTCTrack[]
+
+  // Throws an Error when the library can't make the connection.
+  constructor(config?: RTCConfig) throws Error {
+    RTC_HUB.start()
+    const c = config ?? {}
+    const servers = (c.iceServers ?? []).join("\n")
+    const id = __native.rtcPeer(servers, c.bindAddress ?? "", c.maxMessageSize ?? 0, c.portRangeBegin ?? 0, c.portRangeEnd ?? 0, c.mtu ?? 0)
+    if (id <= 0) {
+      throw new Error(`can't create a peer connection (error ${id})`)
+    }
+    this.id = id
+    this.done = false
+    this.state = "new"
+    this.gatheringState = "new"
+    this.iceState = "new"
+    this.channels = []
+    this.tracks = []
+    this.onstatechange = undefined
+    this.ongatheringchange = undefined
+    this.oniceconnectionchange = undefined
+    this.onlocaldescription = undefined
+    this.onicecandidate = undefined
+    this.ondatachannel = undefined
+    this.ontrack = undefined
+    RTC_HUB.peers.set(id, this)
+  }
+
+  // Sets the remote description ("offer", "answer"). With an offer, the answer is made and the
+  // local description follows (onlocaldescription). Returns "" or the error.
+  setRemoteDescription(sdp: string, type: string): string {
+    const r = __native.rtcSetRemote(this.id, sdp, type)
+    return r < 0 ? `the remote description was refused (error ${r})` : ""
+  }
+
+  // Makes the local description (an offer, once channels or tracks exist; "answer" after a remote
+  // offer). The empty type picks by state.
+  setLocalDescription(type?: string): string {
+    const r = __native.rtcSetLocal(this.id, type ?? "")
+    return r < 0 ? `the local description failed (error ${r})` : ""
+  }
+
+  // The local description as it stands: with every candidate once gathering is complete. "" until set.
+  get localDescription(): string {
+    return __native.rtcInfo(this.id, 0)
+  }
+
+  get localDescriptionType(): string {
+    return __native.rtcInfo(this.id, 1)
+  }
+
+  get remoteDescription(): string {
+    return __native.rtcInfo(this.id, 2)
+  }
+
+  // The largest message the remote side takes, or 0 when unknown.
+  get remoteMaxMessageSize(): int {
+    return parseInt(__native.rtcInfo(this.id, 9)) ?? 0
+  }
+
+  // The pair ICE settled on, "local\nremote" (candidate lines), or "".
+  get selectedCandidatePair(): string {
+    return __native.rtcInfo(this.id, 6)
+  }
+
+  addIceCandidate(candidate: string, mid?: string): string {
+    const r = __native.rtcCandidate(this.id, candidate, mid ?? "")
+    return r < 0 ? `the candidate was refused (error ${r})` : ""
+  }
+
+  // Makes a data channel on this connection.
+  createDataChannel(label: string, options?: RTCChannelOptions): RTCDataChannel {
+    const o = options ?? {}
+    const flags = (o.unordered === true ? 1 : 0) + (o.negotiated === true ? 2 : 0)
+    const id = __native.rtcChannel(this.id, label, o.protocol ?? "", flags, o.stream ?? 0)
+    const ch = new RTCDataChannel(id < 0 ? 0 : id, label, id < 0 ? "closed" : "connecting")
+    if (id > 0) {
+      RTC_HUB.channels.set(id, ch)
+      this.channels.push(ch)
+    }
+    return ch
+  }
+
+  // Adds an audio track. Throws an Error when the library refuses it.
+  addTrack(options?: RTCTrackOptions): RTCTrack throws Error {
+    const o = options ?? {}
+    const dir = o.direction ?? "sendrecv"
+    const direction = dir === "sendonly" ? 1 : dir === "recvonly" ? 2 : dir === "inactive" ? 4 : 3
+    const codec = o.codec ?? "opus"
+    const kind = codec === "pcmu" ? 1 : codec === "pcma" ? 2 : 0
+    const pt = o.payloadType ?? (kind === 0 ? 111 : kind === 1 ? 0 : 8)
+    const mid = o.mid ?? ""
+    const id = __native.rtcTrack(this.id, direction, kind, pt, o.ssrc ?? 0, mid, o.name ?? "audio", o.profile ?? "")
+    if (id <= 0) {
+      throw new Error(`can't add a track (error ${id})`)
+    }
+    const t = new RTCTrack(id, mid)
+    RTC_HUB.tracks.set(id, t)
+    this.tracks.push(t)
+    return t
+  }
+
+  // Closes the connection and frees it with its channels and tracks, and drops the callbacks.
+  close(): void {
+    if (this.done) {
+      return
+    }
+    this.done = true
+    this.state = "closed"
+    for (const ch of this.channels) {
+      ch.close()
+    }
+    for (const t of this.tracks) {
+      t.close()
+    }
+    this.channels = []
+    this.tracks = []
+    this.onstatechange = undefined
+    this.ongatheringchange = undefined
+    this.oniceconnectionchange = undefined
+    this.onlocaldescription = undefined
+    this.onicecandidate = undefined
+    this.ondatachannel = undefined
+    this.ontrack = undefined
+    RTC_HUB.peers.delete(this.id)
+    __native.rtcClose(this.id, 0)
+  }
+
+  get closed(): bool {
+    return this.done
+  }
+
+  // Internal: an event for this connection (the hub's).
+  event(kind: int, n: int, bytes: u8[], text: string): void {
+    if (this.done) {
+      return
+    }
+    switch (kind) {
+      case 1: {
+        this.state = STATES[n] ?? "new"
+        const f = this.onstatechange
+        if (f !== undefined) {
+          f(this.state)
+        }
+        return
+      }
+      case 2: {
+        this.iceState = ICE_STATES[n] ?? "new"
+        const f = this.oniceconnectionchange
+        if (f !== undefined) {
+          f(this.iceState)
+        }
+        return
+      }
+      case 3: {
+        this.gatheringState = GATHERING[n] ?? "new"
+        const f = this.ongatheringchange
+        if (f !== undefined) {
+          f(this.gatheringState)
+        }
+        return
+      }
+      case 5: {
+        const f = this.onlocaldescription
+        if (f !== undefined) {
+          f(__native.bytesToString(bytes), text)
+        }
+        return
+      }
+      case 6: {
+        const f = this.onicecandidate
+        if (f !== undefined) {
+          f(__native.bytesToString(bytes), text)
+        }
+        return
+      }
+      case 7: {
+        const ch = new RTCDataChannel(n, text, "connecting")
+        RTC_HUB.channels.set(n, ch)
+        this.channels.push(ch)
+        const f = this.ondatachannel
+        if (f !== undefined) {
+          f(ch)
+        }
+        return
+      }
+      case 8: {
+        const t = new RTCTrack(n, text)
+        RTC_HUB.tracks.set(n, t)
+        this.tracks.push(t)
+        const f = this.ontrack
+        if (f !== undefined) {
+          f(t)
+        }
+        return
+      }
+      default:
+        return
+    }
+  }
+}
+
+// The objects by id, and the one closure the natives deliver every event to.
+class RTCHub {
+  peers: Map<int, RTCPeerConnection> = new Map<int, RTCPeerConnection>()
+  channels: Map<int, RTCDataChannel> = new Map<int, RTCDataChannel>()
+  tracks: Map<int, RTCTrack> = new Map<int, RTCTrack>()
+  started: bool = false
+
+  start(): void {
+    if (this.started) {
+      return
+    }
+    this.started = true
+    const hub = this
+    __native.rtcStart((kind: int, id: int, n: int, bytes: u8[], text: string): void => hub.event(kind, id, n, bytes, text))
+  }
+
+  event(kind: int, id: int, n: int, bytes: u8[], text: string): void {
+    if (kind <= 8) {
+      const pc = this.peers.get(id)
+      if (pc !== undefined) {
+        pc.event(kind, n, bytes, text)
+      }
+      return
+    }
+    // events of a channel or track: open, closed, error, message, packet, buffered amount low
+    const ch = this.channels.get(id)
+    if (ch !== undefined) {
+      switch (kind) {
+        case 9: {
+          ch.readyState = "open"
+          const f = ch.onopen
+          if (f !== undefined) {
+            f()
+          }
+          return
+        }
+        case 10: {
+          ch.readyState = "closed"
+          const f = ch.onclose
+          if (f !== undefined) {
+            f()
+          }
+          return
+        }
+        case 11: {
+          const f = ch.onerror
+          if (f !== undefined) {
+            f(__native.bytesToString(bytes))
+          }
+          return
+        }
+        case 12: {
+          const f = ch.onmessage
+          if (f !== undefined) {
+            if (n === 1) {
+              f(__native.bytesToString(bytes))
+            } else {
+              f(bytes)
+            }
+          }
+          return
+        }
+        case 14: {
+          const f = ch.onbufferedamountlow
+          if (f !== undefined) {
+            f()
+          }
+          return
+        }
+        default:
+          return
+      }
+    }
+    const t = this.tracks.get(id)
+    if (t !== undefined) {
+      switch (kind) {
+        case 9: {
+          t.readyState = "open"
+          const f = t.onopen
+          if (f !== undefined) {
+            f()
+          }
+          return
+        }
+        case 10: {
+          t.readyState = "closed"
+          const f = t.onclose
+          if (f !== undefined) {
+            f()
+          }
+          return
+        }
+        case 13: {
+          const f = t.onpacket
+          if (f !== undefined) {
+            f(bytes)
+          }
+          return
+        }
+        default:
+          return
+      }
+    }
+  }
+}
+
+const RTC_HUB = new RTCHub()
