+		PPID_CONTROL = 50,
+		PPID_STRING = 51,
+		PPID_BINARY_PARTIAL = 52,
+		PPID_BINARY = 53,
+		PPID_STRING_PARTIAL = 54,
+		PPID_STRING_EMPTY = 56,
+		PPID_BINARY_EMPTY = 57
