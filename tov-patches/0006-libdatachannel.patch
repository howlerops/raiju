+    if (tv_rtc_lp.rd < 0) {
+        int fds[2];
+        if (pipe(fds) != 0) return -errno;
+        for (int i = 0; i < 2; i++) {
+            fcntl(fds[i], F_SETFL, fcntl(fds[i], F_GETFL) | O_NONBLOCK);
+            fcntl(fds[i], F_SETFD, FD_CLOEXEC);
+        }
+        tv_rtc_lp.rd = fds[0];
+        tv_rtc_lp.wr = fds[1];
+        tv_rtc_lp.io.ready = tv_rtc_ready;
+        tv_io_add(tv_rtc_lp.rd, &tv_rtc_lp.io, true, false);
+        tv_rtc_impl->start(tv_rtc_lp.wr);
+    }
+    if (tv_rtc_lp.has_cb) tv_env_release(tv_rtc_lp.cb.env);
+    tv_env_retain(events.env);
+    tv_rtc_lp.cb = events;
+    tv_rtc_lp.has_cb = true;
+    return 0;
+}
