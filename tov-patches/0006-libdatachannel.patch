+/* ---- WebRTC: std/rtc's natives. The operations are runtime/rtc.c's (tv_rtc_impl, set by
+ * tv_rtc_install in programs that use them). libdatachannel calls back on its own threads, which
+ * queue events and write a byte to the wake pipe; the pipe is watched on the loop, and its handler
+ * pops the events and runs the program's closure for each: (kind, id, n, bytes, text). A live
+ * peer connection keeps the program running (tv_io_refs). */
+
+const tv_rtc_ops *tv_rtc_impl;
+
+typedef struct tv_rtc_loop {
+    tv_io io;
+    int rd, wr;
+    tv_fn cb;
+    bool has_cb;
+    int busy;
+} tv_rtc_loop;
+
+static tv_rtc_loop tv_rtc_lp = {{NULL}, -1, -1, {NULL, NULL}, false, 0};
+static int tv_rtc_peers;
+
+static void tv_rtc_deliver(const tv_rtc_event *ev) {
+    tv_arr bytes = TV_EMPTY_ARR;
+    if (ev->alen) {
+        bytes = tv_arr_with_capacity(&tv_type_u8, (tv_int)ev->alen);
+        memcpy(tv_arr_data(bytes), ev->a, ev->alen);
+        bytes.len = (tv_int)ev->alen;
+    }
+    tv_str text = ev->b ? tv_str_from(ev->b, strlen(ev->b)) : TV_EMPTY_STR;
+    ((void (*)(void *, tv_int, tv_int, tv_int, tv_arr, tv_str))tv_rtc_lp.cb.fn)(tv_rtc_lp.cb.env, ev->kind, ev->id, ev->n, bytes, text);
+    tv_arr_release(bytes, &tv_type_u8);
+    tv_str_release(text);
+}
+
+static void tv_rtc_ready(tv_io *h, bool readable, bool writable, bool broken) {
+    (void)h; (void)writable; (void)broken;
+    if (!readable || !tv_rtc_impl || !tv_rtc_lp.has_cb) return;
+    char drain[256];
+    while (read(tv_rtc_lp.rd, drain, sizeof drain) > 0) {}
+    tv_rtc_lp.busy++;
+    tv_rtc_event ev;
+    while (tv_rtc_impl->next(&ev)) {
+        tv_rtc_deliver(&ev);
+        tv_rtc_impl->release(&ev);
+    }
+    tv_rtc_lp.busy--;
+}
+
+/* rtcStart(events) -> 0, or a negative error: sets the closure for events and opens the wake pipe. */
+tv_int tv_native_rtcStart(tv_fn events) {
