--- a/crates/tov/build.rs
+++ b/crates/tov/build.rs
@@ -30,6 +30,41 @@ fn files(dir: &Path, out: &mut Vec<PathBuf>) {
     }
 }
 
+/// The WebRTC library's sources and headers (vendor/rtc): C, C++ and their headers.
+fn rtc_walk(dir: &Path, out: &mut Vec<PathBuf>) {
+    let mut entries: Vec<PathBuf> = std::fs::read_dir(dir).unwrap().flatten().map(|e| e.path()).collect();
+    entries.sort();
+    for p in entries {
+        if p.is_dir() {
+            rtc_walk(&p, out);
+        } else if p.extension().is_some_and(|e| matches!(e.to_str(), Some("c" | "cpp" | "h" | "hpp" | "inc"))) {
+            out.push(p);
+        }
+    }
+}
+
+/// Embeds the WebRTC sources (runtime/rtc.c and vendor/rtc) the way the TLS ones are, in rtc_files.rs,
+/// with a hash of them for the cache key of the archive `tov build` compiles from them (src/build/rtc.rs).
+fn rtc_files(root: &Path, out_dir: &Path) {
+    let mut list = Vec::new();
+    rtc_walk(&root.join("vendor/rtc"), &mut list);
+    list.push(root.join("runtime/rtc.c"));
+    let mut parts: Vec<Vec<u8>> = Vec::new();
+    let mut code = String::from("/// (path relative to the repository, contents)\npub static RTC_FILES: &[(&str, &[u8])] = &[\n");
+    for p in &list {
+        let rel = p.strip_prefix(root).unwrap().to_string_lossy().replace('\\', "/");
+        let _ = writeln!(code, "    ({rel:?}, include_bytes!({:?})),", p.to_string_lossy());
+        parts.push(rel.into_bytes());
+        parts.push(std::fs::read(p).unwrap());
+        println!("cargo:rerun-if-changed={}", p.display());
+    }
+    code.push_str("];\n");
+    let key = tls_flags::hash_hex(&parts.iter().map(|p| p.as_slice()).collect::<Vec<_>>());
+    let _ = writeln!(code, "/// A hash of RTC_FILES.\npub const RTC_KEY: &str = \"{key}\";");
+    std::fs::write(out_dir.join("rtc_files.rs"), code).unwrap();
+    println!("cargo:rerun-if-changed={}", root.join("vendor/rtc").display());
+}
+
 fn main() {
     let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..").canonicalize().unwrap();
     let vendor = root.join("vendor");
@@ -78,6 +113,7 @@ fn main() {
     for p in &list {
         println!("cargo:rerun-if-changed={}", p.display());
     }
+    rtc_files(&root, &out_dir);
     node_shims(&root);
 }
 
