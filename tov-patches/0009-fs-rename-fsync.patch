+/* openSync's flags as Node spells them; -1 for an unknown string. */
+static int tv_open_flags(const char *f) {
+    if (!strcmp(f, "r")) return O_RDONLY;
+    if (!strcmp(f, "r+") || !strcmp(f, "rs+")) return O_RDWR;
+    if (!strcmp(f, "w")) return O_WRONLY | O_CREAT | O_TRUNC;
+    if (!strcmp(f, "wx") || !strcmp(f, "xw")) return O_WRONLY | O_CREAT | O_TRUNC | O_EXCL;
+    if (!strcmp(f, "w+")) return O_RDWR | O_CREAT | O_TRUNC;
+    if (!strcmp(f, "wx+") || !strcmp(f, "xw+")) return O_RDWR | O_CREAT | O_TRUNC | O_EXCL;
+    if (!strcmp(f, "a")) return O_WRONLY | O_CREAT | O_APPEND;
+    if (!strcmp(f, "ax") || !strcmp(f, "xa")) return O_WRONLY | O_CREAT | O_APPEND | O_EXCL;
+    if (!strcmp(f, "a+")) return O_RDWR | O_CREAT | O_APPEND;
+    if (!strcmp(f, "ax+") || !strcmp(f, "xa+")) return O_RDWR | O_CREAT | O_APPEND | O_EXCL;
+    return -1;
+}
+
+/* A descriptor (closed on exec), or -1 with the error set. "r" also opens a directory, for fsyncSync on it. */
+tv_int tv_native_open(tv_str path, tv_str flags, tv_int mode) {
+    int fl = tv_open_flags(flags.p->data);
+    if (fl < 0) { tv_native_fail(EINVAL, "open", path); return -1; }
+    int fd;
+    do fd = open(path.p->data, fl | O_CLOEXEC, (mode_t)mode); while (fd < 0 && errno == EINTR);
+    if (fd < 0) { tv_native_fail(errno, "open", path); return -1; }
+    return (tv_int)fd;
+}
+
+/* Writes all of `data` (retrying short writes); the bytes written. */
+tv_int tv_native_writeFd(tv_int fd, tv_str data) {
+    size_t off = 0, len = (size_t)data.p->len;
+    while (off < len) {
+        ssize_t n = write((int)fd, data.p->data + off, len - off);
+        if (n < 0) {
+            if (errno == EINTR) continue;
+            tv_native_fail_fd(errno, "write");
+            return (tv_int)off;
+        }
+        off += (size_t)n;
+    }
+    return (tv_int)off;
+}
+
+void tv_native_fsync(tv_int fd, bool dataOnly) {
+    int r;
+#if defined(__APPLE__)
+    (void)dataOnly;
+    /* fsync on macOS stops at the drive's cache; F_FULLFSYNC reaches the medium (Node uses fsync; this is stricter). */
+    r = fcntl((int)fd, F_FULLFSYNC);
+    if (r != 0) r = fsync((int)fd);
+#else
+    r = dataOnly ? fdatasync((int)fd) : fsync((int)fd);
+#endif
+    if (r != 0) tv_native_fail_fd(errno, dataOnly ? "fdatasync" : "fsync");
+}
+
+void tv_native_close(tv_int fd) {
+    if (close((int)fd) != 0 && errno != EINTR) tv_native_fail_fd(errno, "close");
+}
