+        uint32_t lengths[2] = { (uint32_t)v->name.p->len, (uint32_t)v->value.p->len };
+        tv_http_boot_write(fd, lengths, sizeof lengths);
+        tv_http_boot_write(fd, v->name.p->data, lengths[0]);
+        tv_http_boot_write(fd, v->value.p->data, lengths[1]);
