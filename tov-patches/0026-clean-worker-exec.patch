+static int tv_http_private_file(void) {
+    char path[] = "/tmp/tov-worker-XXXXXX";
+#ifdef __linux__
+    int fd = mkostemp(path, O_CLOEXEC);
+#else
+    /* macOS has mkstemp, not mkostemp; secure it before any bootstrap content is written. */
+    int fd = mkstemp(path);
+#endif
+    if (fd < 0) tv_trap("can't create clean worker bootstrap", NULL);
+    if (unlink(path) || fcntl(fd, F_SETFD, FD_CLOEXEC))
+        tv_trap("can't secure clean worker bootstrap", NULL);
+    return fd;
+}
+
+static void tv_http_boot_write(int fd, const void *data, size_t n) {
+    const char *p = data;
+    while (n) {
+        ssize_t r = write(fd, p, n);
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) tv_trap("can't write clean worker bootstrap", NULL);
+        p += r; n -= (size_t)r;
+    }
+}
+
+static void tv_http_boot_read(int fd, void *data, size_t n) {
+    char *p = data;
+    while (n) {
+        ssize_t r = read(fd, p, n);
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) tv_trap("invalid clean worker bootstrap", NULL);
+        p += r; n -= (size_t)r;
+    }
+}
+
+static void tv_http_boot_import_fd(int fd) {
+    if (fd < 3 || fcntl(fd, F_SETFD, FD_CLOEXEC))
+        tv_trap("invalid clean worker descriptor", NULL);
