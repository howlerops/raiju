+        tv_http_worker_state *value = tv_alloc(sizeof *value);
+        value->name = (tv_str){tv_strbuf_new(lengths[0])};
+        value->value = (tv_str){tv_strbuf_new(lengths[1])};
+        tv_http_boot_read(fd, value->name.p->data, lengths[0]);
+        tv_http_boot_read(fd, value->value.p->data, lengths[1]);
+        value->next = tv_http_worker_values;
+        tv_http_worker_values = value;
+    }
