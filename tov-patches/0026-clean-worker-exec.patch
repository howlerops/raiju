+tv_str tv_native_httpWorkerState(tv_str name, tv_str text) {
+    tv_http_worker_bootstrap();
+    if (!tv_http_exec_worker && text.p->len && tv_http_boot_complete)
+        tv_trap("clean worker shared state registered after workersReady", NULL);
+    if (text.p->len && (!name.p->len || name.p->len > 128 || text.p->len > 1024 * 1024))
+        tv_trap("invalid clean worker shared state", NULL);
+    for (tv_http_worker_state *v = tv_http_worker_values; v; v = v->next) {
+        if (!tv_str_eq(v->name, name)) continue;
+        if (!tv_http_exec_worker && text.p->len) {
+            tv_str_retain(text);
+            tv_str_release(v->value);
+            v->value = text;
+        }
+        tv_str_retain(v->value);
+        return v->value;
+    }
+    if (tv_http_exec_worker) {
+        if (text.p->len) tv_trap("clean worker shared state was not registered by its supervisor", NULL);
