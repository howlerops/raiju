+    tv_http_worker_state *v = tv_alloc(sizeof *v);
+    tv_str_retain(name);
+    tv_str_retain(text);
+    v->name = name;
+    v->value = text;
+    v->next = tv_http_worker_values;
+    tv_http_worker_values = v;
+    tv_str_retain(text);
