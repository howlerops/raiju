+    if (!error) error = posix_spawnp(&pid, executable, &actions, &attr, tv_argv, env);
+    posix_spawnattr_destroy(&attr);
+    posix_spawn_file_actions_destroy(&actions);
+    close(fd);
+    free(env);
+    if (error) tv_trap("can't spawn clean worker executable", NULL);
+    return pid;
