+
+static void tv_http_worker_bootstrap(void) {
+    if (tv_http_boot_checked) return;
+    tv_http_boot_checked = true;
+    const char *raw = getenv("TOV_CLEAN_WORKER_FD");
+    if (!raw) return;
+    char *end;
+    errno = 0;
+    long parsed = strtol(raw, &end, 10);
+    if (errno || *end || parsed < 3 || parsed > INT_MAX)
+        tv_trap("invalid clean worker bootstrap descriptor", NULL);
+    int fd = (int)parsed;
