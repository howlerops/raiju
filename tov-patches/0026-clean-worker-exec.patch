+    if (read(fd, &extra, 1) != 0) tv_trap("trailing clean worker bootstrap data", NULL);
+    close(fd);
+#ifdef __linux__
+    if (prctl(PR_SET_PDEATHSIG, SIGTERM) || getppid() != tv_http_parent) _exit(1);
+#endif
+    /* Keep patch 0021's reproducible per-slot streams when TOV_SEED is fixed. */
+    tv_random_after_fork(tv_http_worker);
+}
