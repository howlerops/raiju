+    tv_http_boot_read(fd, tv_http_inherited, (size_t)tv_http_ninherited * sizeof *tv_http_inherited);
+    for (int i = 0; i < tv_http_ninherited; i++) tv_http_boot_import_fd(tv_http_inherited[i]);
+    size_t bytes = (size_t)tv_http_nworkers * sizeof(int64_t);
+    if (fstat(tv_http_load_fd, &st) || st.st_size != (off_t)bytes)
+        tv_trap("invalid clean worker load mapping", NULL);
