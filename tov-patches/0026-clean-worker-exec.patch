+    if (!error) error = posix_spawnattr_setsigmask(&attr, &mask);
+    if (!error) error = posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK);
