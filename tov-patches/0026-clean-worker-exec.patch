+    unsetenv("TOV_CLEAN_WORKER_FD");
+    struct stat st;
+    if (fstat(fd, &st) || !S_ISREG(st.st_mode) || st.st_uid != geteuid()
+        || (st.st_mode & 077) || st.st_nlink || st.st_size < 48 || st.st_size > 8 * 1024 * 1024)
