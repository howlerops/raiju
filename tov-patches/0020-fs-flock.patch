diff --git a/crates/tov/src/std/fs.tov b/crates/tov/src/std/fs.tov
--- a/crates/tov/src/std/fs.tov
+++ b/crates/tov/src/std/fs.tov
@@ -135,6 +135,17 @@
   try check()
 }
 
+// flockSync — flock(2) on a descriptor (Bun and Node have none; this is the POSIX call): "ex" an exclusive lock,
+// "sh" a shared one, "un" gives it back. waitMs 0 (the default) tries once, waitMs > 0 retries for that long
+// (sleeping between tries), waitMs < 0 waits until it is free. Returns false when another descriptor held the lock
+// all that time. The kernel gives a lock back when the descriptor closes or its process dies.
+export function flockSync(fd: int, op: string, waitMs?: int): bool throws Error {
+  const code = op === "sh" ? 1 : (op === "ex" ? 2 : (op === "un" ? 8 : 0))
+  const got = __native.flock(fd, code, waitMs ?? 0)
+  try check()
+  return got
+}
