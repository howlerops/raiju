diff --git a/runtime/tov.c b/runtime/tov.c
--- a/runtime/tov.c
+++ b/runtime/tov.c
@@ -2922,6 +2922,42 @@
     if (close((int)fd) != 0 && errno != EINTR) tv_native_fail_fd(errno, "close");
 }
 
+#include <sys/file.h>
+
+static uint64_t tv_flock_now_ns(void) {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)t.tv_sec * 1000000000u + (uint64_t)t.tv_nsec;
+}
+
+/* flock(2) on a descriptor: op 1 shared, 2 exclusive, 8 unlock (LOCK_SH, LOCK_EX, LOCK_UN). waitMs 0 tries once,
+ * waitMs > 0 retries for that long (sleeping 1 ms, doubling to 16 ms, between tries), waitMs < 0 waits until the
+ * lock is free. true when the lock was taken (or given back); false when another descriptor held it all the time.
+ * The kernel gives a lock back when its last descriptor closes, so a holder that dies leaves nothing behind. */
+bool tv_native_flock(tv_int fd, tv_int op, tv_int waitMs) {
+    int how = op == 1 ? LOCK_SH : op == 2 ? LOCK_EX : op == 8 ? LOCK_UN : -1;
+    if (how < 0) { tv_native_fail_fd(EINVAL, "flock"); return false; }
+    if (how == LOCK_UN || waitMs < 0) {
+        int r;
+        do r = flock((int)fd, how); while (r != 0 && errno == EINTR);
+        if (r != 0) { tv_native_fail_fd(errno, "flock"); return false; }
+        return true;
+    }
+    uint64_t until = tv_flock_now_ns() + (uint64_t)waitMs * 1000000u;
+    long nap = 1000000L;
+    for (;;) {
+        if (flock((int)fd, how | LOCK_NB) == 0) return true;
+        if (errno == EINTR) continue;
+        if (errno != EWOULDBLOCK && errno != EAGAIN) { tv_native_fail_fd(errno, "flock"); return false; }
+        uint64_t now = tv_flock_now_ns();
+        if (waitMs == 0 || now >= until) return false;
+        uint64_t left = until - now;
+        struct timespec ts = {0, (long)((uint64_t)nap < left ? (uint64_t)nap : left)};
+        while (nanosleep(&ts, &ts) != 0 && errno == EINTR) {}
+        if (nap < 16000000L) nap *= 2;
+    }
+}
+
 _Noreturn void tv_process_exit(tv_int code) {
     tv_out_flush();
     exit((int)code);
