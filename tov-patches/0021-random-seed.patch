-/* Seeded on first use (TOV_SEED: a number, or any other value for a random seed), so programs
- * that never draw a random number don't link getenv, time and clock. */
+/* 64 bits from the system's random source (getrandom(2); arc4random on macOS), or from the
+ * clock, the pid and an address when it gives none. */
+#if defined(__linux__)
+#include <sys/random.h>
+#endif
+static uint64_t tv_random_os(void) {
+    uint64_t v = 0;
+#if defined(__APPLE__)
+    arc4random_buf(&v, sizeof v);
+#elif defined(__linux__)
+    uint8_t *b = (uint8_t *)&v;
+    size_t n = sizeof v;
+    while (n) {
+        ssize_t r = getrandom(b, n, 0);
+        if (r <= 0) {
+            if (r < 0 && errno == EINTR) continue;
+            break;
+        }
+        b += r;
+        n -= (size_t)r;
+    }
+#endif
+    if (!v) {
+        v = (uint64_t)time(NULL) ^ ((uint64_t)clock() << 32) ^ (uint64_t)(uintptr_t)&v;
+#if defined(__unix__) || defined(__APPLE__)
+        v ^= (uint64_t)getpid() << 16;
+#endif
+    }
+    return v;
+}
+
+/* TOV_SEED as a number (a fixed seed, for reproducible runs), or false. */
+static bool tv_random_fixed(uint64_t *out) {
+    const char *seed = getenv("TOV_SEED");
+    if (!seed) return false;
+    char *end;
+    unsigned long long v = strtoull(seed, &end, 0);
+    if (end == seed || *end != 0) return false;
+    *out = v;
+    return true;
+}
+
+/* Seeded on first use, so programs that never draw a random number don't link getenv and
+ * getrandom: from the system's random source, so every process (and every node) draws its own
+ * numbers; TOV_SEED=<n> fixes the seed instead (any other value: the system's source). */
 static bool tv_rng_ready;
 static __attribute__((noinline, cold)) void tv_random_init(void) {
     tv_rng_ready = true;
-    const char *seed = getenv("TOV_SEED");
-    if (seed) {
-        char *end;
-        unsigned long long v = strtoull(seed, &end, 0);
-        if (end != seed && *end == 0) tv_random_seed(v);
-        else tv_random_seed((uint64_t)time(NULL) ^ ((uint64_t)clock() << 32) ^ (uint64_t)(uintptr_t)&seed);
-    } else {
-        tv_random_seed(0);
-    }
+    uint64_t v;
+    if (tv_random_fixed(&v)) tv_random_seed(v);
+    else tv_random_seed(tv_random_os());
+}
+
+/* In a forked worker: a state of its own, not the copy of its parent's (worker `child` of a
+ * fixed TOV_SEED gets a seed derived from it and its index, so a run stays reproducible). */
+void tv_random_after_fork(tv_int child) {
+    tv_rng_ready = true;
+    uint64_t v;
+    if (tv_random_fixed(&v)) tv_random_seed(v + TV_RNG_DEFAULT * (uint64_t)(child + 1));
+    else tv_random_seed(tv_random_os());
 }
 
