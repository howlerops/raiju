diff --git a/crates/tov/src/build.rs b/crates/tov/src/build.rs
--- a/crates/tov/src/build.rs
+++ b/crates/tov/src/build.rs
@@ -180,6 +180,21 @@ fn c_compiler() -> (String, Option<String>) {
     ("cc".into(), None)
 }
 
+/// Whether the C compiler is GCC: asked of the compiler itself ( is GCC on most Linux systems and clang on
+/// others), once per build.
+fn is_gcc(cc: &str) -> bool {
+    if cfg!(target_vendor = "apple") {
+        return false;
+    }
+    match Command::new(cc).arg("--version").output() {
+        Ok(out) => {
+            let text = String::from_utf8_lossy(&out.stdout).to_lowercase();
+            !text.contains("clang") && (text.contains("gcc") || text.contains("free software foundation"))
+        }
+        Err(_) => false,
+    }
+}
+
 /// Xcode's clang and the macOS SDK, found with xcrun once and remembered in the cache.
 fn apple_toolchain() -> Option<(String, String)> {
     let file = cache_dir().join("toolchain");
@@ -318,6 +333,14 @@ pub fn build(paths: &[PathBuf], base: &Path, opts: &Options) -> Result<Built, Bu
     // Tov code is bounds-checked, so C's stack canaries and fortified memcpy only add checks
     // (and imports: each costs about 50 bytes of binary).
     flags.extend(["-fno-stack-protector", "-U_FORTIFY_SOURCE", "-D_FORTIFY_SOURCE=0"]);
+    // GCC: no scalar replacement of aggregates. The pass (on from -O1) miscompiles the copies the generated code
+    // makes of large records of tagged unions: where a function returned such a record, the retain of some of its
+    // string fields was dropped while their release stayed, so a field was freed while the caller still held it
+    // (GCC 13.3 at -O2 and -O3; valgrind and a watchpoint on the count show it, and it is gone with the pass off).
+    // Clang has no such pass or flag and refuses the option, so it is given to GCC alone.
+    if is_gcc(&cc) {
+        flags.push("-fno-tree-sra");
+    }
     if opts.unchecked {
         flags.push("-DTOV_UNCHECKED=1");
     }
