// UDP (patch 0004): Bun.udpSocket sends and receives datagrams with the sender's address and port,
// and joins multicast groups. Run by tov-patches/tests/run.sh; prints "ok" or "FAIL" lines.
async function pause(ms: int): Promise<void, Error> {
  const p = new Promise<void, Error>((resolve, reject) => {
    setTimeout(() => resolve(), ms)
  })
  try await p
}

function text(bytes: u8[]): string {
  try {
    return new TextDecoder().decode(bytes)
  } catch (e) {
    return ""
  }
}

async function main(): Promise<int> {
  let aGot = ""
  let aFrom = ""
  let aSeen = 0
  let bGot = ""
  let mcGot = ""
  try {
    const a = try await Bun.udpSocket({
      hostname: "127.0.0.1",
      port: 0,
      socket: {
        data(s, bytes, port, address) {
          aGot = text(bytes)
          aFrom = `${address}:${port}`
          aSeen += 1
        },
      },
    })
    const b = try await Bun.udpSocket({
      hostname: "127.0.0.1",
      port: 0,
      socket: {
        data(s, bytes, port, address) {
          bGot = text(bytes)
        },
      },
    })
    const sent = b.send("hello", a.port, "127.0.0.1")
    await pause(100)
    console.log(sent && aGot === "hello" ? "ok datagram arrives intact" : `FAIL got ${JSON.stringify(aGot)} sent=${sent}`)
    console.log(aFrom === `127.0.0.1:${b.port}` ? "ok sender's address and port come with it" : `FAIL from ${aFrom}`)
    console.log(b.port > 0 && a.hostname === "127.0.0.1" ? "ok bound port and hostname" : `FAIL names ${a.hostname}:${a.port}`)

    // bytes both ways
    a.send(new TextEncoder().encode("back"), b.port, "127.0.0.1")
    await pause(100)
    console.log(bGot === "back" ? "ok bytes reply" : `FAIL reply ${JSON.stringify(bGot)}`)

    console.log(a.setBroadcast(true) && a.setTTL(8) && a.setMulticastTTL(1) ? "ok broadcast and TTL options accepted" : "FAIL options")

    // multicast: a group joined on one socket receives what another sends to it
    const group = "239.255.42.99"
    const m = try await Bun.udpSocket({
      hostname: "0.0.0.0",
      port: 0,
      reusePort: true,
      socket: {
        data(s, bytes, port, address) {
          mcGot = text(bytes)
        },
      },
    })
    const joined = m.addMembership(group)
    // (sent from a wildcard-bound socket: a loopback source can't reach a group on the LAN route)
    const wild = try await Bun.udpSocket({ hostname: "0.0.0.0", port: 0, socket: {} })
    wild.send("group", m.port, group)
    wild.close()
    await pause(100)
    console.log(joined && mcGot === "group" ? "ok multicast membership receives the group's datagrams" : `FAIL multicast joined=${joined} got=${JSON.stringify(mcGot)}`)
    console.log(m.dropMembership(group) ? "ok multicast membership dropped" : "FAIL drop membership")

    // closed sockets send nothing and report it
    b.close()
    console.log(b.closed && !b.send("late", a.port, "127.0.0.1") ? "ok a closed socket doesn't send" : "FAIL closed socket sent")
    a.close()
    m.close()
  } catch (e) {
    console.log("FAIL " + e.message)
  }
  return 0
}
