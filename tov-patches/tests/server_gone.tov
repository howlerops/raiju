// Request.signal on Bun.serve (patch 0015): aborted when the client goes away before the answer.
// Driven by server_gone_client.py. /wait waits up to 3 s for its signal; /late reads its signal
// only after 600 ms; /normal answers after 100 ms; /status tells what each saw since the last report.
class Seen {
  wait = ""
  late = ""
  normal = ""
}
const seen = new Seen()

function pause(ms: int): Promise<void> {
  return new Promise<void>((resolve) => {
    setTimeout(() => resolve(), ms)
  })
}

const server = Bun.serve({
  port: 0,
  async fetch(req) {
    const u = URL.parse(req.url)!
    if (u.pathname === "/wait") {
      const signal = req.signal
      const started = Date.now()
      while (!signal.aborted && Date.now() - started < 3000) {
        await pause(20)
      }
      const why = signal.reason
      seen.wait = signal.aborted ? `aborted ${why !== undefined && why instanceof DOMException ? why.name : ""}` : "not aborted"
      return new Response("waited\n")
    }
    if (u.pathname === "/late") {
      await pause(600)
      seen.late = req.signal.aborted ? "aborted" : "not aborted"
      return new Response("late\n")
    }
    if (u.pathname === "/normal") {
      const signal = req.signal
      await pause(100)
      seen.normal = signal.aborted ? "aborted" : "not aborted"
      return new Response("normal\n")
    }
    if (u.pathname === "/status") {
      // (each report starts the next check afresh)
      const text = `wait=${seen.wait};late=${seen.late};normal=${seen.normal}`
      seen.wait = ""
      seen.late = ""
      seen.normal = ""
      return new Response(text)
    }
    return new Response("ok\n")
  },
})
console.log(`listening ${server.port}`)
