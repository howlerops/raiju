// node:fs flockSync: flock(2) on a descriptor (patch 0020).
// Run: flock <file> [held|free] (prints "ok" and "FAIL" lines). With no mode it checks two descriptors of this
// process; "held" expects another process to hold the lock, "free" expects it free (the holder was killed).
import { openSync, closeSync, flockSync, rmSync } from "node:fs"

function check(name: string, ok: bool, detail: string): void {
  console.log(ok ? `ok ${name}` : `FAIL ${name}: ${detail}`)
}

function main(): void {
  const file = process.argv[2] ?? `/tmp/tov-flock-${process.pid}`
  const mode = process.argv[3] ?? ""
  try {
    if (mode === "held") {
      const fd = openSync(file, "a", 384)
      check("another process's lock is not taken by a try", !flockSync(fd, "ex"), "taken")
      const t0 = Date.now()
      const got = flockSync(fd, "ex", 120)
      const waited = Date.now() - t0
      check("a timed wait gives up after waitMs, sleeping", !got && waited >= 120.0 && waited < 1000.0, `${got} ${waited}`)
      closeSync(fd)
      return
    }
    if (mode === "free") {
      const fd = openSync(file, "a", 384)
      check("a dead holder's lock is free at once", flockSync(fd, "ex"), "held")
      closeSync(fd)
      return
    }
    const a = openSync(file, "a", 384)
    const b = openSync(file, "a", 384)
    check("an exclusive lock is taken", flockSync(a, "ex"), "not taken")
    check("a second descriptor cannot take it", !flockSync(b, "ex") && !flockSync(b, "sh"), "taken twice")
    check("unlock gives it back", flockSync(a, "un") && flockSync(b, "ex", 50), "still held")
    closeSync(b)
    check("closing the descriptor gives it back", flockSync(a, "ex"), "still held")
    const sa = flockSync(a, "sh")
    const c = openSync(file, "a", 384)
    const sc = flockSync(c, "sh")
    closeSync(c)
    check("shared locks share", sa && sc, `${sa} ${sc}`)
    closeSync(a)
    let bad = ""
    try {
      flockSync(a, "ex")
    } catch (e) {
      bad = e.message
    }
    check("a closed descriptor throws EBADF", bad.startsWith("EBADF"), bad)
    rmSync(file, { force: true })
  } catch (e) {
    console.log(`FAIL ${e.message}`)
  }
}

main()
