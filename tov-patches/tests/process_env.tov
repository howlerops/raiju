// Patch 0024: dynamic process.env reads use the native environment API.
function main(): int {
  const name = process.argv[2] ?? ""
  if (process.env[name] !== "fixture") { console.log("FAIL inherited env"); return 1 }
  if (process.env[name + "_EMPTY"] !== "") { console.log("FAIL empty env"); return 1 }
  if (process.env[name + "_UNSET"] !== undefined) { console.log("FAIL missing env"); return 1 }
  if (process.env["PA" + "TH"] !== process.env.PATH) { console.log("FAIL literal parity"); return 1 }
  // Construct the byte at runtime: the pinned compiler truncates NUL literals.
  try {
    const nul = try JSON.parse(`"\\u0000"`) as string
    if (nul.byteLength !== 1) { console.log("FAIL NUL fixture"); return 1 }
    if (process.env[name + nul + "suffix"] !== undefined) { console.log("FAIL NUL suffix"); return 1 }
    if (process.env[name + nul] !== undefined) { console.log("FAIL NUL terminator"); return 1 }
    if (process.env[nul + name] !== undefined) { console.log("FAIL NUL prefix"); return 1 }
  } catch (e) { console.log("FAIL NUL decode"); return 1 }
  console.log("ok dynamic process.env: inherited, empty, missing and literal parity")
  return 0
}
