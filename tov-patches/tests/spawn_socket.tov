// Bun.spawnSocket runs a program with its stdin and stdout on a Socket (patch 0002).
// Run: tov run tov-patches/tests/spawn_socket.tov (prints "ok" or "FAIL")
async function main(): Promise<int> {
  let got = ""
  let closed = false
  try {
    const s = await Bun.spawnSocket({
      cmd: ["sh", "-c", "while read l; do echo \"$GREETING:$l\"; done"],
      env: { GREETING: "hi" },
      socket: {
        data(sock, bytes) {
          try {
            got += new TextDecoder().decode(bytes)
          } catch (e) {}
          if (got.includes("hi:two")) sock.end()
        },
        close(sock) {
          closed = true
          console.log(got === "hi:one\nhi:two\n" ? "ok spawnSocket echo, env and close" : `FAIL got ${JSON.stringify(got)}`)
        },
      },
    })
    s.write("one\n")
    s.write("two\n")
  } catch (e) {
    console.log("FAIL " + e.message)
  }
  return 0
}
