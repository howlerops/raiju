// The write-stall limit of upgraded sockets (patch 0022): with idleTimeout set, output a WebSocket's client does not
// take for that long closes the socket, as for the server's HTTP connections. Driven by ws_stall_client.py over raw
// sockets: each socket is sent 8 MB at once, more than the kernel's buffers hold, and the server prints when and how
// it closed.
const started = Date.now()

const server = Bun.serve<string>({
  port: 0,
  hostname: "127.0.0.1",
  idleTimeout: 1,
  fetch(req, srv) {
    const u = URL.parse(req.url)!
    if (srv.upgrade(req, { data: u.searchParams.get("name") ?? "?" })) return
    return new Response("no")
  },
  websocket: {
    open(ws) {
      const chunk = "x".repeat(65536)
      for (let i = 0; i < 128; i++) ws.send(chunk)
      console.log(`open ${ws.data ?? "?"}`)
    },
    close(ws, code, reason) {
      console.log(`closed ${ws.data ?? "?"} ${code} after ${Date.now() - started}`)
    },
  },
})
console.log(`listening ${server.port}`)
