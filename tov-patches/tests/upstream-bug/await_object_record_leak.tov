// Awaiting a promise of a record that is an object (changed in place and shared) leaked the
// default object made for the result.
type Outcome = { ok: bool, status: int, body: string }

const kept: Outcome[] = []

class Engine {
  async attempt(n: int): Promise<Outcome> {
    await new Promise<void>((r) => setTimeout(() => r(), 0))
    const o: Outcome = { ok: true, status: 200, body: "body-" + n }
    if (kept.length < 1) kept.push(o)
    o.status += n
    return o
  }
  async serve(n: int): Promise<int> {
    const r = await this.attempt(n)
    return r.status + r.body.byteLength
  }
}

async function main() {
  const e = new Engine()
  let total = 0
  for (let i = 0; i < 20; i++) total += await e.serve(i)
  console.log(total, kept[0]!.status)
}
main()
