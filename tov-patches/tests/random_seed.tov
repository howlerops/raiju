// Patch 0021: Math.random is seeded from getrandom(2), and again in each forked worker; TOV_SEED=<n> fixes the
// seed (each worker deriving its own from it and its index). Driven by random_seed_client.py. ONCE=1 prints one draw
// and exits; otherwise 4 workers answer "<pid> <the worker's next draw>".
if (process.env.ONCE === "1") {
  console.log(`draw ${Math.floor(Math.random() * 1.0e15)}`)
  process.exit(0)
}
const server = Bun.serve({
  port: 0,
  workers: 4,
  fetch(req) {
    return new Response(`${process.pid} ${Math.floor(Math.random() * 1.0e15)}\n`)
  },
})
console.log(`listening ${server.port}`)
