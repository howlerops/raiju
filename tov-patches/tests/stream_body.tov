// Bun.serve sends a ReadableStream body chunk by chunk (patch 0001), in every worker.
// Run: tov run tov-patches/tests/stream_body.tov (prints "ok" lines, exits 1 on failure)
const workers = parseInt(process.env.W ?? "2") ?? 2
const server = Bun.serve({
  port: 0,
  workers: workers,
  fetch(req) {
    if (req.url.endsWith("/fail")) {
      // fails after the head is out: the client must see a cut-off body
      const failing = new ReadableStream({
        start(c) {
          c.enqueue("partial\n")
          setTimeout(() => {
            c.error(new Error("upstream broke"))
          }, 50)
        },
      })
      return new Response(failing)
    }
    let n = 0
    const body = new ReadableStream({
      start(c) {
        let tick: () => void = () => {}
        tick = () => {
          n += 1
          c.enqueue(`chunk ${n}\n`)
          if (n < 3) setTimeout(tick, 100)
          else c.close()
        }
        tick()
      },
    })
    return new Response(body, { headers: { "content-type": "text/plain" } })
  },
})
console.log(`listening ${server.port}`)
