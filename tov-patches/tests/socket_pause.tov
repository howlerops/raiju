// Socket.pause() and resume() (patch 0008): a paused socket is not read, so a fast sender has to wait.
// One program: a Bun.listen server that pauses at its first data, and a Bun.connect client that sends
// 64 MiB. Prints "ok" or "FAIL" lines.
const TOTAL = 64 * 1048576
let received = 0
let pausedAt = 0
let held: Socket<undefined> | undefined = undefined
let done: () => void = () => {}

async function pause(ms: int): Promise<void> {
  await new Promise<void>((resolve) => {
    setTimeout(() => resolve(), ms)
  })
}

const server = Bun.listen<undefined>({
  hostname: "127.0.0.1",
  port: 0,
  socket: {
    data(socket, bytes) {
      received += bytes.length
      if (pausedAt === 0) {
        pausedAt = received
        held = socket
        socket.pause()
      }
      if (received >= TOTAL) done()
    },
  },
})

async function main(): Promise<int, Error> {
  const finished = new Promise<void>((resolve) => {
    done = () => resolve()
  })
  const chunk: u8[] = []
  for (let i = 0; i < 1048576; i++) chunk.push(u8(i % 251))
  const client = try await Bun.connect<undefined>({
    hostname: "127.0.0.1",
    port: server.port,
    socket: {
      data(socket, bytes) {},
    },
  })
  for (let i = 0; i < 64; i++) client.write(chunk)
  await pause(600)
  const got = received
  console.log(got < TOTAL / 2 ? `ok a paused socket was not read (${got / 1048576} of 64 MiB arrived)` : `FAIL ${got} bytes arrived while the socket was paused`)
  resumeAll()
  await finished
  console.log(received === TOTAL ? "ok resume() reads on: all 64 MiB arrived" : `FAIL ${received} bytes arrived`)
  client.end()
  server.stop()
  return 0
}

function resumeAll(): void {
  const s = held
  if (s !== undefined) s.resume()
}

try {
  await main()
} catch (e) {
  console.log(`FAIL ${e.message}`)
}
