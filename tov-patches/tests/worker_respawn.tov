// Patch 0019: a worker killed alone (SIGKILL, as the OOM killer does) is replaced, with a growing pause for
// one that keeps dying soon after it starts; Bun.plainAlloc(). Driven by worker_respawn_client.py: 2 workers,
// each request answers the worker's process id. PLAIN_ONLY=1 prints Bun.plainAlloc() and exits.
console.log(`plain ${Bun.plainAlloc()}`)
if (process.env.PLAIN_ONLY === "1") process.exit(0)
const server = Bun.serve({
  port: 0,
  workers: 2,
  fetch(req) {
    return new Response(`${process.pid}\n`)
  },
})
console.log(`listening ${server.port}`)
