// A fetch connection's input buffer starts at 16 KB and grows as an answer needs (patch 0016): a 40 KB response
// head, a 100 KB chunk and a chunk size line split across reads arrive whole, and so do 2,000 small events read
// as a stream. Run by tov-patches/tests/run.sh with FB_PORT (fetch_buffer_server.py). Prints "ok" or "FAIL" lines.
async function main(): Promise<int> {
  const base = `http://127.0.0.1:${process.env.FB_PORT ?? "0"}`
  try {
    const res = try await fetch(base + "/bighead")
    const filler = res.headers.get("x-filler") ?? ""
    const body = try await res.text()
    const want = "b".repeat(100000) + "c".repeat(16)
    console.log(filler.byteLength === 40000 ? "ok a 40 KB response head" : `FAIL the head's filler is ${filler.byteLength} bytes`)
    console.log(body === want ? "ok a 100 KB chunk and a split chunk size line" : `FAIL the body is ${body.byteLength} bytes`)
    const ev = try await fetch(base + "/events")
    const s = ev.body
    let text = ""
    let reads = 0
    if (s !== undefined) {
      const reader = try s.getReader()
      while (true) {
        const c = try await reader.read()
        if (c.done) break
        const v = c.value
        if (v !== undefined) {
          text = text + (try new TextDecoder().decode(v))
          reads += 1
        }
      }
    }
    let whole = true
    for (let i = 0; i < 2000; i++) {
      if (!text.includes(`data: event ${i}\n\n`)) whole = false
    }
    console.log(whole && reads > 0 ? "ok 2,000 small events read as a stream" : `FAIL ${reads} reads, ${text.byteLength} bytes`)
  } catch (e) {
    console.log(`FAIL ${e.message}`)
  }
  return 0
}
