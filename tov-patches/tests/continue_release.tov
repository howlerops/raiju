// Patch 0023: `continue` releases the loop body's locals. Without it every `continue` taken after a string, array,
// map or record local of the body was declared kept one reference to it for good (Raiju: one virtual key header
// string per request, re-audit 7 P0-1). Each loop kind takes `continue` 64 times holding a fresh 1 MB string; the
// process RSS must not grow by them. Kept values must survive too (no release too many).
import { readFileSync } from "node:fs"

function rssMb(): int {
  let s = ""
  try {
    s = try readFileSync("/proc/self/status", "utf8")
  } catch (e) {}
  const at = s.indexOf("VmRSS:")
  if (at < 0) return 0
  const line = s.slice(at + 6)
  const rest = line.slice(0, line.indexOf("\n")).trim()
  const kb = parseInt(rest.slice(0, rest.indexOf(" "))) ?? 0
  return Math.floor(kb / 1024)
}

const MB = "x".repeat(1048576)
const N = 64

function big(i: int): string {
  return MB + i
}

function forOf(xs: int[]): int {
  let n = 0
  for (const i of xs) {
    const v = big(i)
    if (v.byteLength > 0) continue
    n += 1
  }
  return n
}

function forLoop(): int {
  let n = 0
  for (let i = 0; i < N; i++) {
    const v = big(i)
    if (i >= 0) {
      const w = v + "!"
      if (w.byteLength > 0) continue
    }
    n += 1
  }
  return n
}

function whileLoop(): int {
  let i = 0
  let n = 0
  while (i < N) {
    i += 1
    const v = big(i)
    const parts: string[] = [v]
    if (parts.length === 1) continue
    n += 1
  }
  return n
}

function doWhile(): int {
  let i = 0
  let n = 0
  do {
    i += 1
    const m: Map<string, string> = new Map()
    m.set("k", big(i))
    if (m.size === 1) continue
    n += 1
  } while (i < N)
  return n
}

async function asyncLoop(): Promise<int> {
  let n = 0
  for (let i = 0; i < N; i++) {
    const v = big(i)
    await Promise.resolve(0)
    if (v.byteLength > 0) continue
    n += 1
  }
  return n
}

function check(name: string, run: () => int): void {
  const before = rssMb()
  const n = run()
  const grew = rssMb() - before
  console.log(n === 0 && grew < 16 ? `ok continue in ${name} releases the body's locals (+${grew} MB)` : `FAIL ${name}: ${n} fell through, RSS +${grew} MB`)
}

const xs: int[] = []
for (let i = 0; i < N; i++) xs.push(i)
check("for-of", () => forOf(xs))
check("for", () => forLoop())
check("while", () => whileLoop())
check("do-while", () => doWhile())

// kept values outlive the continue that follows them
const kept: string[] = []
for (let i = 0; i < 6; i++) {
  const v = "kept-" + i + "-" + Date.now()
  if (i % 2 === 0) {
    kept.push(v)
    continue
  }
}
let good = kept.length === 3
for (let i = 0; i < kept.length; i++) good = good && kept[i]!.startsWith("kept-" + (i * 2) + "-")
console.log(good ? "ok values kept before a continue are intact" : `FAIL kept ${kept.join(",")}`)

const before = rssMb()
const an = await asyncLoop()
const grew = rssMb() - before
console.log(an === 0 && grew < 16 ? `ok continue in an async function releases the body's locals (+${grew} MB)` : `FAIL async: ${an} fell through, RSS +${grew} MB`)
