// Patch 0012: Bun.serve's timeouts and connection cap, Bun.onStopSignal and server.openConnections, Bun.fdLimit.
// Driven by server_lifecycle_client.py: W workers (default 1); /slow answers after 1.5 s.
const server = Bun.serve({
  port: 0,
  headerTimeout: 1,
  idleTimeout: 2,
  bodyTimeout: 1,
  maxConnections: parseInt(process.env.MAX_CONNS ?? "3") ?? 3,
  workers: parseInt(process.env.W ?? "1") ?? 1,
  async fetch(req) {
    const u = URL.parse(req.url)!
    if (u.pathname === "/slow") {
      await new Promise<void>((resolve) => {
        setTimeout(() => resolve(), 1500)
      })
      return new Response("slow done\n")
    }
    return new Response("ok\n")
  },
})
console.log(`listening ${server.port}`)
console.log(Bun.fdLimit() > 0 ? "ok fdLimit" : "FAIL fdLimit")
// the stop: stop accepting, wait for the connections in hand, exit 0
Bun.onStopSignal((sig: string) => {
  console.log(`stop ${sig} ${server.openConnections}`)
  server.stop()
  setInterval(() => {
    if (server.openConnections === 0) process.exit(0)
  }, 50)
})
