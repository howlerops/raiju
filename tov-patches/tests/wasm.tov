// WebAssembly (patches 0005 and 0010): std/wasm instantiates a module on WAMR, calls exports with i32 and i64
// values, reads and writes linear memory, and enforces its limits (a time limit per call too). The module is wasm_mod.wasm
// (source: wasm_mod.c). Run by tov-patches/tests/run.sh from this directory; prints "ok" or
// "FAIL" lines.
import { instantiate } from "std/wasm"
import { readFileBytesSync } from "node:fs"

function ok(name: string, cond: bool): void {
  console.log((cond ? "ok " : "FAIL ") + name)
}

// the message a call throws, "" when it returns
function failure(f: () => void throws Error): string {
  try {
    f()
  } catch (e) {
    return e.message
  }
  return ""
}

function main(): int {
  try {
    const bytes = readFileBytesSync("wasm_mod.wasm")
    const m = instantiate(bytes, { fuel: 5000000, stackBytes: 65536, maxPages: 4 })
    ok("an export is called with i32 arguments", m.call("add", [40, 2]) === 42)
    ok("an i32 result is sign-extended", m.call("add", [-5, 2]) === -3)
    ok("i64 arguments and results", m.call("mul64", [3000000000, 3]) === 9000000000)
    ok("has and arity", m.has("add") && !m.has("nope") && m.arity("add") === 2 && m.arity("say") === 0 && m.arity("nope") === -1)
    ok("linear memory has its declared size", m.memorySize() === 131072)

    m.write(1000, [1, 2, 3, 4])
    ok("memory written by the host is read by the module", m.call("sum", [1000, 4]) === 10)
    m.call("fill", [2000, 8, 7])
    const got = m.read(2000, 8)
    ok("memory written by the module is read by the host", got.length === 8 && int(got[0]!) === 7 && int(got[7]!) === 7)

    ok("a trap throws and the instance lives on", failure(() => { try m.call("boom", []) }) !== "" && m.call("add", [1, 1]) === 2)
    ok("an integer division by zero traps", failure(() => { try m.call("divide", [1, 0]) }).toLowerCase().includes("divide by zero"))
    ok("an unknown export throws", failure(() => { try m.call("nope", []) }).includes("no export named"))
    ok("an import the host does not provide traps when it is called, not when the module loads", failure(() => { try m.call("call_nope", [1]) }) !== "" && m.call("add", [3, 4]) === 7)
    ok("a wrong argument count throws", failure(() => { try m.call("add", [1]) }).includes("takes 2 arguments"))
    ok("memory outside the module throws", failure(() => { try m.read(131000, 1000) }).includes("out of bounds") && failure(() => { try m.write(-1, [1]) }).includes("out of bounds"))

    ok("an instruction budget stops a loop", failure(() => { try m.call("spin", []) }).toLowerCase().includes("instruction"))
    ok("and the instance runs again after it", m.call("add", [2, 2]) === 4)
    // (a trap leaves the module's own stack pointer where it was, so the recursion runs on an instance of its own)
    const n = instantiate(bytes, { fuel: 50000000, stackBytes: 65536 })
    ok("a runaway recursion traps", failure(() => { try n.call("deep", [1000000]) }) !== "")
    n.close()
    ok("memory grows up to the page limit", m.call("grow", [1]) === 2 && m.memorySize() === 196608)
    ok("and not past it", m.call("grow", [2]) === -1)

    m.call("say", [])
    ok("standard output is captured", m.output() === "hello from wasm\n" && m.output() === "")

    m.close()
    ok("a closed instance throws", failure(() => { try m.call("add", [1, 1]) }) !== "")

    // a wall-clock bound per call (patch 0010): a loop with no instruction budget ends once its time is up
    const t = instantiate(bytes, { stackBytes: 65536, timeMs: 150 })
    const t0 = Date.now()
    const slow = failure(() => { try t.call("spin", []) })
    const took = Date.now() - t0
    ok("a time limit stops a loop that has no instruction budget", slow.includes("time limit exceeded") && took >= 140.0 && took < 5000.0)
    t.setTimeLimit(0)
    ok("and the instance runs again after it", t.call("add", [2, 3]) === 5)
    t.close()

    ok("bytes that are not a module are refused", failure(() => { try instantiate([1, 2, 3, 4]) }) !== "")
    ok("a module whose initial memory exceeds the limit is refused", failure(() => { try instantiate(bytes, { maxPages: 1 }) }) !== "")
  } catch (e) {
    console.log("FAIL threw: " + e.message)
    return 1
  }
  return 0
}

main()
