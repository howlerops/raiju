// Patch 0026: initialize real node:dns/JSC before two workers adopt two port-0 listeners.
import * as dns from "node:dns"

async function main(): Promise<int> {
  if (process.env.CLEAN_WORKERS !== "0") Bun.cleanWorkers()
  const supervisor = Bun.workerSupervisor()
  const saved = Bun.workerState("fixture-identity", "")
  const identity = saved === "" ? Bun.workerState("fixture-identity", `${supervisor}`) : saved
  const draw = Math.floor(Math.random() * 1.0e15)
  if (process.env.DNS_BEFORE_LISTENERS === "1") {
    try {
      try await dns.promises.lookup("localhost", { all: true, family: 4 })
    } catch (e) {
      console.error("FAIL early localhost DNS initialization")
      return 1
    }
  }
  const gateway = Bun.serve({
    hostname: "127.0.0.1", port: 0, workers: 2,
    fetch(req) {
      return new Response(`${process.pid} ${supervisor} ${identity} ${draw}\n`)
    },
  })
  const cluster = Bun.serve({
    hostname: "127.0.0.1", port: 0,
    fetch(req) {
      return new Response(`${process.pid} ${supervisor} ${identity} ${draw}\n`)
    },
  })
  Bun.onStopSignal((signal: string) => {
    gateway.stop()
    cluster.stop()
    process.exit(0)
  })
  if (process.pid === supervisor) console.log(`listening ${gateway.port} ${cluster.port}`)
  else console.log(`worker ${process.pid}`)
  Bun.workersReady()
  try {
    try await dns.promises.lookup("localhost", { all: true, family: 4 })
  } catch (e) {
    console.error("FAIL localhost DNS initialization")
    return 1
  }
  return 0
}
