// node:fs rename, open/write/fsync/close, chmod and writeFileSync's mode and flush (patch 0009).
// Run: tov run tov-patches/tests/fs_atomic.tov (prints "ok" and "FAIL" lines)
import {
  readFileSync, writeFileSync, existsSync, mkdirSync, rmSync, statSync,
  renameSync, rename, chmodSync, openSync, writeSync, fsyncSync, fdatasyncSync, closeSync,
} from "node:fs"

function check(name: string, ok: bool, detail: string): void {
  console.log(ok ? `ok ${name}` : `FAIL ${name}: ${detail}`)
}

function errorOf(f: () => void throws Error): string {
  try {
    f()
  } catch (e) {
    return e.message
  }
  return ""
}

async function main(): Promise<int> {
  const dir = `/tmp/tov-fs-atomic-${process.pid}`
  try {
    rmSync(dir, { recursive: true, force: true })
    mkdirSync(dir, { recursive: true })

    // renameSync replaces an existing file
    writeFileSync(`${dir}/a`, "old")
    writeFileSync(`${dir}/a.tmp`, "new")
    renameSync(`${dir}/a.tmp`, `${dir}/a`)
    check("renameSync replaces the target", readFileSync(`${dir}/a`) === "new" && !existsSync(`${dir}/a.tmp`), readFileSync(`${dir}/a`))

    // a missing source: Node's message with both paths
    const msg = errorOf(() => { try renameSync(`${dir}/none`, `${dir}/b`) })
    check("renameSync error names both paths", msg === `ENOENT: no such file or directory, rename '${dir}/none' -> '${dir}/b'`, msg)

    // a file onto a directory fails and leaves both alone
    mkdirSync(`${dir}/d`)
    const dmsg = errorOf(() => { try renameSync(`${dir}/a`, `${dir}/d`) })
    check("renameSync onto a directory fails", dmsg.startsWith("EISDIR") && readFileSync(`${dir}/a`) === "new", dmsg)

    // open, write, fsync, close
    const fd = openSync(`${dir}/c`, "w", 384)
    const n = writeSync(fd, "hello ")
    writeSync(fd, new TextEncoder().encode("world"))
    fsyncSync(fd)
    fdatasyncSync(fd)
    closeSync(fd)
    check("openSync/writeSync/fsyncSync/closeSync", n === 6 && readFileSync(`${dir}/c`) === "hello world", readFileSync(`${dir}/c`))
    check("openSync mode", (statSync(`${dir}/c`).mode & 511) === 384, `${statSync(`${dir}/c`).mode & 511}`)

    // "wx" refuses an existing file; "a" appends
    const xmsg = errorOf(() => { try openSync(`${dir}/c`, "wx") })
    check("openSync wx on an existing file", xmsg.startsWith("EEXIST: file already exists, open"), xmsg)
    const afd = openSync(`${dir}/c`, "a")
    writeSync(afd, "!")
    closeSync(afd)
    check("openSync a appends", readFileSync(`${dir}/c`) === "hello world!", readFileSync(`${dir}/c`))
    const fmsg = errorOf(() => { try openSync(`${dir}/c`, "q") })
    check("openSync unknown flags", fmsg.startsWith("EINVAL"), fmsg)

    // a directory opens read-only and fsyncs (how a rename is made durable)
    const dfd = openSync(dir, "r")
    fsyncSync(dfd)
    closeSync(dfd)
    check("fsyncSync on a directory", true, "")

    // a closed descriptor
    const bmsg = errorOf(() => { try fsyncSync(dfd) })
    check("fsyncSync on a closed descriptor", bmsg === "EBADF: bad file descriptor, fsync", bmsg)
    const cmsg = errorOf(() => { try closeSync(dfd) })
    check("closeSync twice", cmsg === "EBADF: bad file descriptor, close", cmsg)

    // writeFileSync with mode and flush; chmodSync; Stats.mode
    writeFileSync(`${dir}/e`, "secret", { mode: 384, flush: true })
    check("writeFileSync mode and flush", readFileSync(`${dir}/e`) === "secret" && (statSync(`${dir}/e`).mode & 511) === 384, `${statSync(`${dir}/e`).mode & 511}`)
    chmodSync(`${dir}/e`, 420)
    check("chmodSync", (statSync(`${dir}/e`).mode & 511) === 420, `${statSync(`${dir}/e`).mode & 511}`)
    writeFileSync(`${dir}/e`, "plain")
    check("writeFileSync without options keeps the mode", readFileSync(`${dir}/e`) === "plain" && (statSync(`${dir}/e`).mode & 511) === 420, "")
    const wmsg = errorOf(() => { try writeFileSync(`${dir}/nodir/f`, "x", { flush: true }) })
    check("writeFileSync flush error", wmsg.startsWith("ENOENT: no such file or directory, open"), wmsg)

    // rename's callback form
    writeFileSync(`${dir}/g`, "g")
    let first = ""
    let second = ""
    let calls = 0
    await new Promise<void>((resolve) => {
      rename(`${dir}/g`, `${dir}/h`, (err) => {
        calls += 1
        first = err === undefined ? "none" : err.message
        rename(`${dir}/g`, `${dir}/h`, (err2) => {
          calls += 1
          second = err2 === undefined ? "none" : err2.message
          resolve()
        })
      })
    })
    check("rename callback", calls === 2 && first === "none" && readFileSync(`${dir}/h`) === "g", first)
    check("rename callback error", second.startsWith("ENOENT: no such file or directory, rename"), second)
  } catch (e) {
    console.log("FAIL " + e.message)
  }
  try {
    rmSync(dir, { recursive: true, force: true })
  } catch (e) {}
  return 0
}
