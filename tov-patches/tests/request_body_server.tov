// Bun.serve reads a big request body as a stream (patch 0008): req.body, bodyStreamThreshold and
// maxRequestBodySize. Started by tov-patches/tests/run.sh, which drives it with request_body_client.py.
// Prints "listening PORT".
//   POST /sum     the body's length and a checksum, read from req.body chunk by chunk
//   POST /text    the same through req.text() (a streamed body is read whole)
//   POST /slow    waits 600 ms before it reads the body (backpressure: the sender must wait for it)
//   POST /ignore  answers without touching the body (it is dropped; the connection stays usable)
//   POST /early   answers 413 at once, before the body is in
//   POST /relay   passes req.body to a fetch() to /sum on this server (a request body stream both ways)
//   POST /cancel  reads one chunk, waits until the rest is in, then cancels the reader (the stream is freed as it is cancelled)

function checksum(h: int, b: u8[]): int {
  let v = h
  for (const x of b) v = (v * 31 + int(x)) % 1000000007
  return v
}

async function sum(req: Request): Promise<Response> {
  const st = req.body
  if (st === undefined) return new Response(`0 0 none\n`)
  let n = 0
  let h = 7
  let chunks = 0
  try {
    for await (const v of st) {
      n += v.length
      h = checksum(h, v)
      chunks += 1
    }
  } catch (e) {
    return new Response(`error ${e.message}\n`, { status: 400 })
  }
  return new Response(`${n} ${h} ${chunks > 1 ? "chunks" : "one"}\n`)
}

async function pause(ms: int): Promise<void> {
  await new Promise<void>((resolve) => {
    setTimeout(() => resolve(), ms)
  })
}

const server = Bun.serve({
  port: 0,
  bodyStreamThreshold: 65536,
  maxRequestBodySize: 32 * 1048576,
  async fetch(req) {
    let path = "/"
    try {
      path = new URL(req.url).pathname
    } catch (e) {
      return new Response("bad url", { status: 400 })
    }
    if (path === "/sum") return await sum(req)
    if (path === "/text") {
      const t = await req.text()
      let h = 7
      h = checksum(h, __bytes(t))
      return new Response(`${t.byteLength} ${h}\n`)
    }
    if (path === "/slow") {
      await pause(600)
      return await sum(req)
    }
    if (path === "/ignore") return new Response("ignored\n")
    if (path === "/early") return new Response("too big\n", { status: 413 })
    if (path === "/cancel") {
      const b = req.body
      if (b === undefined) return new Response("no body", { status: 400 })
      try {
        const reader = b.getReader()
        const first = await reader.read()
        await pause(300)
        await reader.cancel()
        return new Response(first.done ? "empty\n" : "cancelled\n")
      } catch (e) {
        return new Response(`error ${e.message}\n`, { status: 400 })
      }
    }
    if (path === "/relay") {
      const b = req.body
      if (b === undefined) return new Response("no body", { status: 400 })
      try {
        const up = await fetch(`http://127.0.0.1:${server.port}/sum`, { method: "POST", body: b })
        return new Response(await up.text())
      } catch (e) {
        return new Response(`relay failed: ${e.message}\n`, { status: 502 })
      }
    }
    return new Response("not found", { status: 404 })
  },
})

function __bytes(s: string): u8[] {
  return new TextEncoder().encode(s)
}

console.log(`listening ${server.port}`)
