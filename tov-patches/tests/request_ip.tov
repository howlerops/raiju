// Patch 0017: server.requestIP(req), the client's address on Bun.serve (fetch and routes handlers, read after an await).
const server = Bun.serve({
  port: 0,
  hostname: "127.0.0.1",
  routes: {
    "/route/:id": (req, srv) => {
      const a = srv.requestIP(req)
      return new Response(a === undefined ? "none" : a.address)
    },
  },
  async fetch(req, srv) {
    await new Promise<void>((resolve) => {
      setTimeout(() => resolve(), 10)
    })
    const a = srv.requestIP(req)
    if (a === undefined) return new Response("none")
    // a request the program builds has no client
    const made = srv.requestIP(new Request("http://example.com/"))
    return new Response(`${a.address} ${a.family} ${a.port} ${made === undefined ? "made-none" : "made-some"}`)
  },
})

async function main(): Promise<void> {
  try {
    const r = try await fetch(`http://127.0.0.1:${server.port}/x`)
    const t = try await r.text()
    const parts = t.split(" ")
    const port = parseInt(parts[2] ?? "") ?? 0
    console.log(parts[0] === "127.0.0.1" && parts[1] === "IPv4" ? "ok the fetch handler sees the client's address" : `FAIL ${t}`)
    console.log(port > 0 && port !== server.port ? "ok and the client's port" : `FAIL port ${t}`)
    console.log(parts[3] === "made-none" ? "ok a request made in the program has no address" : `FAIL ${t}`)
    const r2 = try await fetch(`http://127.0.0.1:${server.port}/route/7`)
    const t2 = try await r2.text()
    console.log(t2 === "127.0.0.1" ? "ok a routes handler sees it too" : `FAIL route ${t2}`)
  } catch (e) {
    console.log(`FAIL ${e.message}`)
  }
  process.exit(0)
}

main()
