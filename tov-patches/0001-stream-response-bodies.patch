+/* A streamed response for deferred request id: httpStreamStart writes the head (chunked
+ * transfer encoding, the date, connection: close when the request asked for it), then each
+ * httpStreamWrite one chunk; last writes the terminating chunk and finishes the response. */
+void tv_native_httpStreamStart(tv_int id, tv_int status, tv_str headers) {
+    if (id <= 0 || id > tv_http_ndeferred) return;
+    tv_http_req *r = tv_http_deferred[id];
+    if (!r || (uintptr_t)r <= (uintptr_t)tv_http_ndeferred) return;
+    if (status < 100 || status > 999) status = 500;
+    tv_http_refresh_date();
+    tv_sb sb = {0};
+    char line[64];
+    int n = snprintf(line, sizeof line, "HTTP/1.1 %d %s\r\n", (int)status, tv_http_reason(status));
+    tv_sb_push(&sb, line, (size_t)n);
+    tv_sb_push(&sb, "transfer-encoding: chunked\r\n", 28);
+    tv_sb_push(&sb, tv_http_date, strlen(tv_http_date));
+    if (!r->keep) tv_sb_push(&sb, "connection: close\r\n", 19);
+    tv_sb_push(&sb, headers.p->data, (size_t)headers.p->len);
+    tv_sb_push(&sb, "\r\n", 2);
+    tv_native_httpWriteRaw(id, sb.data, sb.len, 0);
+    tv_sb_free(&sb);
+}
+
+void tv_native_httpStreamWrite(tv_int id, tv_str data, bool last) {
+    size_t len = (size_t)data.p->len;
+    if (len) {
+        tv_sb sb = {0};
+        char size[24];
+        int n = snprintf(size, sizeof size, "%zx\r\n", len);
+        tv_sb_push(&sb, size, (size_t)n);
+        tv_sb_push(&sb, data.p->data, len);
+        tv_sb_push(&sb, "\r\n", 2);
+        tv_native_httpWriteRaw(id, sb.data, sb.len, 0);
+        tv_sb_free(&sb);
+    }
+    if (last) tv_native_httpWriteRaw(id, "0\r\n\r\n", 5, 1);
+}
