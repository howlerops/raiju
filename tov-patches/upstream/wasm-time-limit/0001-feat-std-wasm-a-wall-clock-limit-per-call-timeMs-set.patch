@@ -1,5 +1,5 @@
 // std/wasm: a module instantiated on WAMR, exports called with i32 and i64 values, linear memory
-// read and written by both sides, and the limits (instruction budget, operand stack, pages).
+// read and written by both sides, and the limits (instruction budget, operand stack, pages, wall-clock time per call).
 // MODULE is native_wasm_module.c, built with:
 //   clang --target=wasm32 -O1 -nostdlib -fno-builtin -Wl,--no-entry -Wl,--export-dynamic \
 //     -Wl,-z,stack-size=8192 -Wl,--initial-memory=131072 -Wl,--max-memory=1048576 -o m.wasm native_wasm_module.c
@@ -107,6 +107,16 @@ function main(): int {
     m.close()
     ok("a closed instance throws", failure(() => { try m.call("add", [1, 1]) }) !== "")
 
+    // a wall-clock bound per call: a loop with no instruction budget ends once its time is up
+    const t = instantiate(bytes, { stackBytes: 65536, timeMs: 150 })
+    const t0 = Date.now()
+    const slow = failure(() => { try t.call("spin", []) })
+    const took = Date.now() - t0
+    ok("a time limit stops a loop that has no instruction budget", slow.includes("time limit exceeded") && took >= 140.0 && took < 5000.0)
+    t.setTimeLimit(0)
+    ok("and the instance runs again after it", t.call("add", [2, 3]) === 5)
+    t.close()
+
     ok("bytes that are not a module are refused", failure(() => { try instantiate([1, 2, 3, 4]) }) !== "")
     ok("a module whose initial memory exceeds the limit is refused", failure(() => { try instantiate(bytes, { maxPages: 1 }) }) !== "")
   } catch (e) {
