diff --git a/crates/tov/src/std/wasm.tov b/crates/tov/src/std/wasm.tov
index 6bdd929..18c9e3c 100644
--- a/crates/tov/src/std/wasm.tov
+++ b/crates/tov/src/std/wasm.tov
@@ -14,13 +14,15 @@ function check(): void throws Error {
 }
 
 // Limits for one instance. A field left out takes the default: 64 KiB of operand stack, 256 pages
-// (16 MiB) of linear memory, no instruction budget. `fuel` is the most instructions one call may
-// execute (about 2 billion at most); a call that runs past it traps, so a loop cannot hang the
-// process.
+// (16 MiB) of linear memory, no instruction budget, no time limit. `fuel` is the most instructions
+// one call may execute (about 2 billion at most); a call that runs past it traps, so a loop cannot
+// hang the process. `timeMs` is the most wall-clock milliseconds one call may take (checked every
+// 65536 instructions); a call that runs past it traps with "time limit exceeded".
 export type WasmLimits = {
   stackBytes?: int
   maxPages?: int
   fuel?: int
+  timeMs?: int
 }
 
 export class WasmInstance {
@@ -67,6 +69,11 @@ export class WasmInstance {
     return __native.wasmOutput(this.handle)
   }
 
+  // Sets the wall-clock milliseconds one call may take (0: no limit).
+  setTimeLimit(ms: int): void {
+    __native.wasmTimeLimit(this.handle, ms)
+  }
+
   // Releases the instance. Using it afterwards throws.
   close(): void {
     __native.wasmFree(this.handle)
@@ -81,5 +88,7 @@ export function instantiate(bytes: u8[], limits?: WasmLimits): WasmInstance thro
     try check()
     throw new Error("WebAssembly module failed to load")
   }
+  const ms = limits?.timeMs ?? 0
+  if (ms > 0) __native.wasmTimeLimit(h, ms)
   return new WasmInstance(h)
 }
diff --git a/docs/spec.md b/docs/spec.md
index 783d5fb..8434550 100644
--- a/docs/spec.md
+++ b/docs/spec.md
@@ -157,7 +157,7 @@ try {
 ## 7a. Standard library **[M3]**
 Node's names, so existing habits work:
 - `import { readFileSync, readFileBytesSync, writeFileSync, appendFileSync, existsSync, readdirSync, mkdirSync, rmSync, unlinkSync, statSync, accessSync } from "node:fs"` (also `"fs"`, `"std/fs"`): the synchronous API; failures throw `Error` with Node's messages (`ENOENT: no such file or directory, open 'x'`). `readdirSync` returns sorted names. `readFileBytesSync` returns the file's `u8[]` (what Node's `readFileSync` gives as a Buffer), and `writeFileSync`/`appendFileSync` take `string | u8[]`. `statSync` returns a `Stats` (`size`, `mtimeMs`, `isFile()`, `isDirectory()`); `accessSync(path, mode?)` takes Node's mode flags (0 exists, 4 read, 2 write, 1 execute).
-- `import { instantiate } from "std/wasm"` (Tov): WebAssembly modules on an interpreter (WAMR, vendored; Linux on x86-64 and AArch64, elsewhere `instantiate` throws). `instantiate(bytes, { fuel?, stackBytes?, maxPages? })` returns a `WasmInstance`: `call(name, args)` (i32 and i64 values as `int`; the first result), `has(name)`, `arity(name)`, `read(offset, length)` and `write(offset, bytes)` on linear memory, `memorySize()`, `output()` (what the module wrote to fd 1 and 2) and `close()`. `fuel` is the most instructions one call may run, `stackBytes` the operand stack, `maxPages` the most 64 KiB memory pages. A trap, a missing export, a wrong argument count or an offset outside memory throws an `Error`. A module sees its own memory, a WASI subset (clock, random, captured stdout and stderr, empty environment, no files or sockets) and `env.abort`; calling any other import traps.
+- `import { instantiate } from "std/wasm"` (Tov): WebAssembly modules on an interpreter (WAMR, vendored; Linux on x86-64 and AArch64, elsewhere `instantiate` throws). `instantiate(bytes, { fuel?, stackBytes?, maxPages?, timeMs? })` returns a `WasmInstance`: `call(name, args)` (i32 and i64 values as `int`; the first result), `has(name)`, `arity(name)`, `read(offset, length)` and `write(offset, bytes)` on linear memory, `memorySize()`, `output()` (what the module wrote to fd 1 and 2), `setTimeLimit(ms)` and `close()`. `fuel` is the most instructions one call may run, `stackBytes` the operand stack, `maxPages` the most 64 KiB memory pages, `timeMs` the most wall-clock milliseconds one call may take (checked every 65536 instructions; past it the call throws `time limit exceeded`). A trap, a missing export, a wrong argument count or an offset outside memory throws an `Error`. A module sees its own memory, a WASI subset (clock, random, captured stdout and stderr, empty environment, no files or sockets) and `env.abort`; calling any other import traps.
 - `import * as path from "node:path"`: `join`, `resolve`, `normalize`, `basename`, `dirname`, `extname`, `isAbsolute`, `sep` (POSIX).
 - `process.argv` (`[binary, binary, ...args]`, so `process.argv.slice(2)` are the arguments), `process.env.NAME` (`string | undefined`), `process.exit(code?)`, `process.cwd()`, `process.platform`, `process.arch`, `process.pid`, `process.stdout.write(s)`, `process.stderr.write(s)`; `console.error` / `console.warn` write to stderr.
 - `Date.now()` and `performance.now()` (milliseconds).
