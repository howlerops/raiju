 `WAMR-2.4.5` (commit `25bd7eb6`), Apache-2.0 WITH LLVM-exception (see `LICENSE`). `runtime/wasm.c` drives it for
 `std/wasm`.
 
-The files come from that tag, unmodified: `core/config.h`, `core/version.h`, and the parts of
+The files come from that tag, unmodified except for one change (below): `core/config.h`, `core/version.h`, and the parts of
 `core/iwasm` and `core/shared` that the fast interpreter needs: `iwasm/include`, `iwasm/interpreter`,
 `iwasm/common` (with `common/arch` for x86-64 and AArch64, and the headers `common/gc` and `aot`/`compilation`
 that the interpreter's sources include), `shared/utils`, `shared/mem-alloc` (the `ems` allocator),
@@ -19,5 +19,9 @@ no 8 GiB reservation per memory), and no AOT, multi-module, shared memory, libc
 programs that call the `wasm*` natives link it. On platforms other than Linux on x86-64 and AArch64 the files
 are left out and `runtime/wasm.c` is compiled as stubs.
 
+One change of Tov's: `CHECK_INSTRUCTION_LIMIT` in `core/iwasm/interpreter/wasm_interp_fast.c` also counts a
+tick and, every 65536 instructions while a call has a deadline, compares the monotonic clock with it
+(`tv_wasm_deadline_ns`, set by `runtime/wasm.c`) and raises "time limit exceeded". Reapply it on an update.
+
 To update: take the same directories from a new WAMR release, keep the flags in step with its
 `build-scripts/config_common.cmake`, and run `cargo test --release --test run` (`tests/run/native_wasm.tov`).
diff --git a/vendor/wamr/core/iwasm/interpreter/wasm_interp_fast.c b/vendor/wamr/core/iwasm/interpreter/wasm_interp_fast.c
index 1c744f9..1fdf9c3 100644
--- a/vendor/wamr/core/iwasm/interpreter/wasm_interp_fast.c
+++ b/vendor/wamr/core/iwasm/interpreter/wasm_interp_fast.c
@@ -90,13 +90,23 @@ typedef float64 CellType_F64;
     } while (0)
 
 #if WASM_ENABLE_INSTRUCTION_METERING != 0
-#define CHECK_INSTRUCTION_LIMIT()                                 \
-    if (instructions_left == 0) {                                 \
-        wasm_set_exception(module, "instruction limit exceeded"); \
-        goto got_exception;                                       \
-    }                                                             \
-    else if (instructions_left > 0)                               \
-        instructions_left--;
+/* Tov's wall-clock bound on a call (runtime/wasm.c): every 65536 instructions the clock is
+ * compared with the deadline of the call in progress (0: none). */
+extern int64_t tv_wasm_deadline_ns;
+extern uint32_t tv_wasm_ticks;
+extern int64_t tv_wasm_now_ns(void);
+#define CHECK_INSTRUCTION_LIMIT()                                     \
+    if (instructions_left == 0) {                                     \
+        wasm_set_exception(module, "instruction limit exceeded");     \
+        goto got_exception;                                           \
+    }                                                                 \
+    else if (instructions_left > 0)                                   \
+        instructions_left--;                                          \
+    if (tv_wasm_deadline_ns != 0 && ((++tv_wasm_ticks) & 0xFFFF) == 0 \
+        && tv_wasm_now_ns() > tv_wasm_deadline_ns) {                  \
+        wasm_set_exception(module, "time limit exceeded");            \
+        goto got_exception;                                           \
+    }
 
 #else
 #define CHECK_INSTRUCTION_LIMIT() (void)0
