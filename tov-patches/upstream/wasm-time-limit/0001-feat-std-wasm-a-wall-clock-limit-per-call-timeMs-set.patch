diff --git a/runtime/wasm.c b/runtime/wasm.c
index 77de6de..cec5a98 100644
--- a/runtime/wasm.c
+++ b/runtime/wasm.c
@@ -5,8 +5,9 @@
  * A module is loaded and instantiated in one step and named by an integer handle, like the
  * sockets of net.c. The host reads and writes the instance's linear memory and calls exported
  * functions with i32/i64 arguments. Limits per instance: the linear memory (pages), the operand
- * stack, and a budget of instructions per call (WAMR's instruction metering), so a runaway loop
- * ends with a trap instead of hanging the process.
+ * stack, a budget of instructions per call (WAMR's instruction metering), so a runaway loop
+ * ends with a trap instead of hanging the process, and a wall-clock time per call (checked by the
+ * interpreter every 65536 instructions, so a call that is slow for any reason ends too).
  *
  * The instance sees no host but a small WASI subset (clock, random, standard output and error
  * captured into a buffer, empty environment and arguments, no files and no sockets) and the
@@ -38,6 +39,7 @@ bool tv_native_wasmWrite(tv_int h, tv_int ptr, tv_arr bytes) { (void)h; (void)pt
 tv_int tv_native_wasmMemSize(tv_int h) { (void)h; return 0; }
 tv_str tv_native_wasmOutput(tv_int h) { (void)h; return TV_EMPTY_STR; }
 void tv_native_wasmFree(tv_int h) { (void)h; }
+void tv_native_wasmTimeLimit(tv_int h, tv_int ms) { (void)h; (void)ms; }
 tv_str tv_native_wasmError(void) { tv_str s = tv_str_from(tv_wasm_err, strlen(tv_wasm_err)); tv_wasm_err[0] = 0; return s; }
 
 #else
@@ -59,10 +61,24 @@ typedef struct {
     uint8_t *code;   /* the module's bytes: the loader keeps pointers into them */
     uint32_t stack;
     int fuel;        /* instructions per call; <= 0 is unlimited */
+    int64_t time_ms; /* wall-clock milliseconds per call; <= 0 is unlimited */
     char *out;       /* captured standard output and error */
     size_t out_len;
 } tv_wasm;
 
+/* The deadline of the call in progress (CLOCK_MONOTONIC nanoseconds; 0: none) and an instruction
+ * tick, read by WAMR's interpreter (vendor/wamr/core/iwasm/interpreter/wasm_interp_fast.c): every
+ * 65536 instructions it compares the clock with the deadline and traps with "time limit exceeded"
+ * once it has passed. Calls run one at a time on the thread that makes them. */
+int64_t tv_wasm_deadline_ns = 0;
+uint32_t tv_wasm_ticks = 0;
+
+int64_t tv_wasm_now_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000000000ll + (int64_t)ts.tv_nsec;
+}
+
 static tv_wasm *tv_wasm_table[TV_WASM_MAX_INSTANCES];
 static bool tv_wasm_ready;
 static bool tv_wasm_init_failed;
@@ -410,7 +426,15 @@ tv_int tv_native_wasmCall(tv_int h, tv_str name, tv_arr args) {
     }
     wasm_runtime_clear_exception(w->inst);
     wasm_runtime_set_instruction_count_limit(w->env, w->fuel);
-    if (!wasm_runtime_call_wasm_a(w->env, fn, nr, rv, np, av)) {
+    int64_t outer = tv_wasm_deadline_ns;
+    if (w->time_ms > 0) {
+        int64_t mine = tv_wasm_now_ns() + w->time_ms * 1000000ll;
+        /* a call made while another is in progress keeps the earlier deadline */
+        tv_wasm_deadline_ns = outer != 0 && outer < mine ? outer : mine;
+    }
+    bool ok = wasm_runtime_call_wasm_a(w->env, fn, nr, rv, np, av);
+    tv_wasm_deadline_ns = outer;
+    if (!ok) {
         const char *ex = wasm_runtime_get_exception(w->inst);
         tv_wasm_fail("%s", ex && *ex ? ex : "WebAssembly call failed");
         wasm_runtime_clear_exception(w->inst);
@@ -470,6 +494,13 @@ tv_str tv_native_wasmOutput(tv_int h) {
     return s;
 }
 
+/* Sets the wall-clock time one call of the instance may take (milliseconds; 0 or less: no limit). */
+void tv_native_wasmTimeLimit(tv_int h, tv_int ms) {
+    tv_wasm *w = tv_wasm_get(h);
+    if (!w) return;
+    w->time_ms = ms > 0 ? (ms > 86400000ll ? 86400000ll : (int64_t)ms) : 0;
+}
+
 void tv_native_wasmFree(tv_int h) {
     if (h <= 0 || h > TV_WASM_MAX_INSTANCES) return;
     tv_wasm_release(tv_wasm_table[h - 1]);
