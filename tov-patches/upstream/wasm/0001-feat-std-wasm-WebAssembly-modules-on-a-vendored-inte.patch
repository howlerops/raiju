+                if (!cond) {
+                    if (addr_ret != addr1)
+                        frame_lp[addr_ret] = frame_lp[addr1];
+                }
+                else {
+                    if (addr_ret != addr2)
+                        frame_lp[addr_ret] = frame_lp[addr2];
+                }
+                HANDLE_OP_END();
+            }
+
+            HANDLE_OP(WASM_OP_SELECT_64)
