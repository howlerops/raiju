+                        pb_read_leb_uint32(p, p_end, type_idx);
+#if WASM_ENABLE_FAST_INTERP != 0
+                        emit_uint32(loader_ctx, type_idx);
+#endif
+                        if (opcode1 == WASM_OP_ARRAY_NEW_FIXED
+                            || opcode1 == WASM_OP_ARRAY_NEW_DATA
+                            || opcode1 == WASM_OP_ARRAY_NEW_ELEM) {
