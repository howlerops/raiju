+static float
+local_copysignf(float x, float y)
+{
+    union {
+        float f;
+        uint32 i;
+    } ux = { x }, uy = { y };
+    ux.i &= 0x7fffffff;
+    ux.i |= uy.i & 0x80000000;
+    return ux.f;
+}
+
+static double
+local_copysign(double x, double y)
+{
+    union {
+        double f;
+        uint64 i;
+    } ux = { x }, uy = { y };
+    ux.i &= UINT64_MAX / 2;
+    ux.i |= uy.i & 1ULL << 63;
+    return ux.f;
