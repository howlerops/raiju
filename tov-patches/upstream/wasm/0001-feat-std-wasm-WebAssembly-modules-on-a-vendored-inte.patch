+
+static inline uint32
+rotl32(uint32 n, uint32 c)
+{
+    const uint32 mask = (31);
+    c = c % 32;
+    c &= mask;
+    return (n << c) | (n >> ((0 - c) & mask));
+}
+
+static inline uint32
+rotr32(uint32 n, uint32 c)
+{
+    const uint32 mask = (31);
+    c = c % 32;
+    c &= mask;
+    return (n >> c) | (n << ((0 - c) & mask));
+}
+
+static inline uint64
+rotl64(uint64 n, uint64 c)
+{
+    const uint64 mask = (63);
+    c = c % 64;
+    c &= mask;
+    return (n << c) | (n >> ((0 - c) & mask));
+}
+
+static inline uint64
+rotr64(uint64 n, uint64 c)
+{
+    const uint64 mask = (63);
+    c = c % 64;
+    c &= mask;
+    return (n >> c) | (n << ((0 - c) & mask));
+}
