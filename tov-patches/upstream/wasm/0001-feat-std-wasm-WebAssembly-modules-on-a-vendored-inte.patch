+#endif /* end of BH_ENABLE_GC_VERIFY */
+
+#if WASM_ENABLE_GC != 0
+/**
+ * Add gc object ref to the rootset of a gc heap.
+ *
+ * @param heap the heap to add the gc object to its rootset
+ * @param obj pointer to a valid WASM object managed by the gc heap.
