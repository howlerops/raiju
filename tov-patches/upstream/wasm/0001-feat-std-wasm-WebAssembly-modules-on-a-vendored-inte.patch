+/* wasm.c — WebAssembly modules on the vendored WAMR (vendor/wamr, interpreter only), for the
+ * `std/wasm` module. Compiled into the same archive as tls.c, so only programs that call the
+ * wasm natives link it (and WAMR with them). Plain C: no JavaScriptCore here.
+ *
+ * A module is loaded and instantiated in one step and named by an integer handle, like the
+ * sockets of net.c. The host reads and writes the instance's linear memory and calls exported
+ * functions with i32/i64 arguments. Limits per instance: the linear memory (pages), the operand
+ * stack, and a budget of instructions per call (WAMR's instruction metering), so a runaway loop
+ * ends with a trap instead of hanging the process.
+ *
+ * The instance sees no host but a small WASI subset (clock, random, standard output and error
+ * captured into a buffer, empty environment and arguments, no files and no sockets) and the
+ * AssemblyScript `env.abort`. Failures set a message that wasmError() returns; the natives
+ * themselves return 0, false or empty values. */
+
+#include "tov.h"
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#if defined(TV_NO_WASM)
+
+/* a platform WAMR is not vendored for */
+static const char *tv_wasm_unsupported = "WebAssembly is not supported on this platform";
+static char tv_wasm_err[256];
+static void tv_wasm_fail(const char *m) { snprintf(tv_wasm_err, sizeof tv_wasm_err, "%s", m); }
+tv_int tv_native_wasmLoad(tv_arr bytes, tv_int stack, tv_int pages, tv_int fuel) { (void)bytes; (void)stack; (void)pages; (void)fuel; tv_wasm_fail(tv_wasm_unsupported); return 0; }
+tv_int tv_native_wasmArity(tv_int h, tv_str name) { (void)h; (void)name; return -1; }
+tv_int tv_native_wasmCall(tv_int h, tv_str name, tv_arr args) { (void)h; (void)name; (void)args; tv_wasm_fail(tv_wasm_unsupported); return 0; }
+bool tv_native_wasmHas(tv_int h, tv_str name) { (void)h; (void)name; return false; }
+tv_arr tv_native_wasmRead(tv_int h, tv_int ptr, tv_int len) { (void)h; (void)ptr; (void)len; tv_wasm_fail(tv_wasm_unsupported); return TV_EMPTY_ARR; }
+bool tv_native_wasmWrite(tv_int h, tv_int ptr, tv_arr bytes) { (void)h; (void)ptr; (void)bytes; tv_wasm_fail(tv_wasm_unsupported); return false; }
+tv_int tv_native_wasmMemSize(tv_int h) { (void)h; return 0; }
+tv_str tv_native_wasmOutput(tv_int h) { (void)h; return TV_EMPTY_STR; }
+void tv_native_wasmFree(tv_int h) { (void)h; }
+tv_str tv_native_wasmError(void) { tv_str s = tv_str_from(tv_wasm_err, strlen(tv_wasm_err)); tv_wasm_err[0] = 0; return s; }
+
+#else
+
+#include <unistd.h>
+#include <sys/types.h>
+
+#include "wasm_export.h"
+
+#define TV_WASM_MAX_INSTANCES 1024
+#define TV_WASM_OUT_CAP (64 * 1024)
+#define TV_WASM_DEFAULT_STACK (64 * 1024)
+#define TV_WASM_DEFAULT_PAGES 256 /* 16 MiB of linear memory */
+
+typedef struct {
+    wasm_module_t mod;
+    wasm_module_inst_t inst;
+    wasm_exec_env_t env;
+    uint8_t *code;   /* the module's bytes: the loader keeps pointers into them */
+    uint32_t stack;
+    int fuel;        /* instructions per call; <= 0 is unlimited */
+    char *out;       /* captured standard output and error */
+    size_t out_len;
+} tv_wasm;
+
+static tv_wasm *tv_wasm_table[TV_WASM_MAX_INSTANCES];
+static bool tv_wasm_ready;
+static bool tv_wasm_init_failed;
+static char tv_wasm_err[512];
+
+static void tv_wasm_fail(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void tv_wasm_fail(const char *fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(tv_wasm_err, sizeof tv_wasm_err, fmt, ap);
+    va_end(ap);
+}
+
+/* ---- the WASI subset ---- */
+
+#define WASI_ESUCCESS 0
+#define WASI_EBADF 8
+#define WASI_EINVAL 28
+#define WASI_ENOSYS 52
+
+static tv_wasm *tv_wasm_of(wasm_exec_env_t env) {
+    return (tv_wasm *)wasm_runtime_get_custom_data(wasm_runtime_get_module_inst(env));
+}
+
+static int32_t wasi_fd_write(wasm_exec_env_t env, int32_t fd, uint32_t iovs, uint32_t n, uint32_t nwritten) {
+    wasm_module_inst_t inst = wasm_runtime_get_module_inst(env);
+    if (fd != 1 && fd != 2) return WASI_EBADF;
+    if (!wasm_runtime_validate_app_addr(inst, nwritten, 4)) return WASI_EINVAL;
+    if (n > 0 && !wasm_runtime_validate_app_addr(inst, iovs, (uint64_t)n * 8)) return WASI_EINVAL;
+    tv_wasm *w = tv_wasm_of(env);
+    uint64_t total = 0;
+    for (uint32_t i = 0; i < n; i++) {
+        uint32_t iov[2];
+        memcpy(iov, wasm_runtime_addr_app_to_native(inst, iovs + i * 8), 8);
+        if (iov[1] == 0) continue;
+        if (!wasm_runtime_validate_app_addr(inst, iov[0], iov[1])) return WASI_EINVAL;
+        if (w) {
+            size_t room = w->out_len < TV_WASM_OUT_CAP ? TV_WASM_OUT_CAP - w->out_len : 0;
+            size_t take = iov[1] < room ? iov[1] : room;
+            if (take) {
+                if (!w->out) w->out = malloc(TV_WASM_OUT_CAP);
+                if (w->out) {
+                    memcpy(w->out + w->out_len, wasm_runtime_addr_app_to_native(inst, iov[0]), take);
+                    w->out_len += take;
+                }
+            }
+        }
+        total += iov[1];
+    }
+    uint32_t t = (uint32_t)total;
+    memcpy(wasm_runtime_addr_app_to_native(inst, nwritten), &t, 4);
+    return WASI_ESUCCESS;
+}
+
+static int32_t wasi_fd_read(wasm_exec_env_t env, int32_t fd, uint32_t iovs, uint32_t n, uint32_t nread) {
+    (void)iovs; (void)n;
+    wasm_module_inst_t inst = wasm_runtime_get_module_inst(env);
+    if (fd != 0) return WASI_EBADF;
+    if (!wasm_runtime_validate_app_addr(inst, nread, 4)) return WASI_EINVAL;
+    uint32_t zero = 0; /* standard input is empty */
+    memcpy(wasm_runtime_addr_app_to_native(inst, nread), &zero, 4);
+    return WASI_ESUCCESS;
+}
+
+static int32_t wasi_fd_close(wasm_exec_env_t env, int32_t fd) { (void)env; (void)fd; return WASI_EBADF; }
+static int32_t wasi_fd_seek(wasm_exec_env_t env, int32_t fd, int64_t off, int32_t whence, uint32_t out) { (void)env; (void)fd; (void)off; (void)whence; (void)out; return WASI_EBADF; }
+static int32_t wasi_fd_prestat_get(wasm_exec_env_t env, int32_t fd, uint32_t out) { (void)env; (void)fd; (void)out; return WASI_EBADF; }
+static int32_t wasi_fd_prestat_dir_name(wasm_exec_env_t env, int32_t fd, uint32_t p, uint32_t n) { (void)env; (void)fd; (void)p; (void)n; return WASI_EBADF; }
+static int32_t wasi_path_open(wasm_exec_env_t env, int32_t a, int32_t b, uint32_t c, uint32_t d, int32_t e, int64_t f, int64_t g, int32_t h, uint32_t i) {
+    (void)env; (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i;
+    return WASI_EBADF;
+}
+
+/* fdstat: a character device for the three standard streams */
+static int32_t wasi_fd_fdstat_get(wasm_exec_env_t env, int32_t fd, uint32_t out) {
+    wasm_module_inst_t inst = wasm_runtime_get_module_inst(env);
+    if (fd < 0 || fd > 2) return WASI_EBADF;
+    if (!wasm_runtime_validate_app_addr(inst, out, 24)) return WASI_EINVAL;
+    uint8_t st[24];
+    memset(st, 0, sizeof st);
+    st[0] = 2; /* filetype: character device */
+    st[8] = fd == 0 ? 0x02 : 0x40; /* rights_base: fd_read for 0, fd_write for 1 and 2 */
+    memcpy(wasm_runtime_addr_app_to_native(inst, out), st, sizeof st);
+    return WASI_ESUCCESS;
+}
+
+static int32_t wasi_environ_sizes_get(wasm_exec_env_t env, uint32_t count, uint32_t size) {
+    wasm_module_inst_t inst = wasm_runtime_get_module_inst(env);
+    if (!wasm_runtime_validate_app_addr(inst, count, 4) || !wasm_runtime_validate_app_addr(inst, size, 4)) return WASI_EINVAL;
+    uint32_t zero = 0;
+    memcpy(wasm_runtime_addr_app_to_native(inst, count), &zero, 4);
+    memcpy(wasm_runtime_addr_app_to_native(inst, size), &zero, 4);
+    return WASI_ESUCCESS;
+}
+
+static int32_t wasi_environ_get(wasm_exec_env_t env, uint32_t a, uint32_t b) { (void)env; (void)a; (void)b; return WASI_ESUCCESS; }
+
+static int32_t wasi_clock_time_get(wasm_exec_env_t env, uint32_t id, uint64_t precision, uint32_t out) {
+    (void)precision;
+    wasm_module_inst_t inst = wasm_runtime_get_module_inst(env);
+    if (!wasm_runtime_validate_app_addr(inst, out, 8)) return WASI_EINVAL;
+    clockid_t clk = id == 0 ? CLOCK_REALTIME : id == 1 ? CLOCK_MONOTONIC : id == 2 ? CLOCK_PROCESS_CPUTIME_ID : CLOCK_THREAD_CPUTIME_ID;
+    struct timespec ts;
+    if (clock_gettime(clk, &ts) != 0) return WASI_EINVAL;
+    uint64_t ns = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+    memcpy(wasm_runtime_addr_app_to_native(inst, out), &ns, 8);
+    return WASI_ESUCCESS;
+}
+
+static int32_t wasi_clock_res_get(wasm_exec_env_t env, uint32_t id, uint32_t out) {
+    (void)id;
+    wasm_module_inst_t inst = wasm_runtime_get_module_inst(env);
+    if (!wasm_runtime_validate_app_addr(inst, out, 8)) return WASI_EINVAL;
+    uint64_t ns = 1;
+    memcpy(wasm_runtime_addr_app_to_native(inst, out), &ns, 8);
+    return WASI_ESUCCESS;
+}
+
+static int32_t wasi_random_get(wasm_exec_env_t env, uint32_t buf, uint32_t len) {
+    wasm_module_inst_t inst = wasm_runtime_get_module_inst(env);
+    if (len == 0) return WASI_ESUCCESS;
+    if (!wasm_runtime_validate_app_addr(inst, buf, len)) return WASI_EINVAL;
+    uint8_t *p = wasm_runtime_addr_app_to_native(inst, buf);
+    FILE *f = fopen("/dev/urandom", "rb");
+    size_t got = f ? fread(p, 1, len, f) : 0;
+    if (f) fclose(f);
+    if (got != len) return WASI_ENOSYS;
+    return WASI_ESUCCESS;
+}
+
+static int32_t wasi_sched_yield(wasm_exec_env_t env) { (void)env; return WASI_ESUCCESS; }
+static void wasi_proc_exit(wasm_exec_env_t env, int32_t code) {
+    char msg[64];
+    snprintf(msg, sizeof msg, "proc_exit(%d)", (int)code);
+    wasm_runtime_set_exception(wasm_runtime_get_module_inst(env), msg);
+}
+static int32_t wasi_poll_oneoff(wasm_exec_env_t env, uint32_t a, uint32_t b, uint32_t c, uint32_t d) { (void)env; (void)a; (void)b; (void)c; (void)d; return WASI_ENOSYS; }
+
+/* AssemblyScript's abort(message, file, line, column) */
+static void env_abort(wasm_exec_env_t env, uint32_t msg, uint32_t file, uint32_t line, uint32_t col) {
+    (void)msg; (void)file;
+    char buf[96];
+    snprintf(buf, sizeof buf, "abort at line %u, column %u", (unsigned)line, (unsigned)col);
+    wasm_runtime_set_exception(wasm_runtime_get_module_inst(env), buf);
+}
+
+#define NS(name, sig) {#name, (void *)wasi_##name, sig, NULL}
+static NativeSymbol tv_wasi_symbols[] = {
+    NS(fd_write, "(iiii)i"),
+    NS(fd_read, "(iiii)i"),
+    NS(fd_close, "(i)i"),
+    NS(fd_seek, "(iIii)i"),
+    NS(fd_fdstat_get, "(ii)i"),
+    NS(fd_prestat_get, "(ii)i"),
+    NS(fd_prestat_dir_name, "(iii)i"),
+    NS(path_open, "(iiiiiIIii)i"),
+    NS(environ_sizes_get, "(ii)i"),
+    NS(environ_get, "(ii)i"),
+    NS(clock_time_get, "(iIi)i"),
+    NS(clock_res_get, "(ii)i"),
+    NS(random_get, "(ii)i"),
+    NS(sched_yield, "()i"),
+    NS(proc_exit, "(i)"),
+    NS(poll_oneoff, "(iiii)i"),
+};
+/* args_sizes_get and args_get are the same shapes as environ_*: no arguments */
+static int32_t wasi_args_sizes_get(wasm_exec_env_t env, uint32_t count, uint32_t size) { return wasi_environ_sizes_get(env, count, size); }
+static int32_t wasi_args_get(wasm_exec_env_t env, uint32_t a, uint32_t b) { return wasi_environ_get(env, a, b); }
+static NativeSymbol tv_wasi_args_symbols[] = {
+    NS(args_sizes_get, "(ii)i"),
+    NS(args_get, "(ii)i"),
+};
+static NativeSymbol tv_env_symbols[] = {
+    {"abort", (void *)env_abort, "(iiii)", NULL},
+};
+
+static bool tv_wasm_init(void) {
+    if (tv_wasm_ready) return true;
+    if (tv_wasm_init_failed) {
+        tv_wasm_fail("the WebAssembly runtime did not start");
+        return false;
+    }
+    RuntimeInitArgs a;
+    memset(&a, 0, sizeof a);
+    a.mem_alloc_type = Alloc_With_Allocator;
+    a.mem_alloc_option.allocator.malloc_func = (void *)malloc;
+    a.mem_alloc_option.allocator.realloc_func = (void *)realloc;
+    a.mem_alloc_option.allocator.free_func = (void *)free;
+    if (!wasm_runtime_full_init(&a)) {
+        tv_wasm_init_failed = true;
+        tv_wasm_fail("the WebAssembly runtime did not start");
+        return false;
+    }
+    wasm_runtime_register_natives("wasi_snapshot_preview1", tv_wasi_symbols, sizeof tv_wasi_symbols / sizeof tv_wasi_symbols[0]);
+    wasm_runtime_register_natives("wasi_snapshot_preview1", tv_wasi_args_symbols, sizeof tv_wasi_args_symbols / sizeof tv_wasi_args_symbols[0]);
+    wasm_runtime_register_natives("env", tv_env_symbols, sizeof tv_env_symbols / sizeof tv_env_symbols[0]);
+    wasm_runtime_set_log_level(WASM_LOG_LEVEL_FATAL); /* failures come back as messages; WAMR's own warnings stay out of the log */
+    tv_wasm_ready = true;
+    return true;
+}
+
+static tv_wasm *tv_wasm_get(tv_int h) {
+    if (h <= 0 || h > TV_WASM_MAX_INSTANCES || !tv_wasm_table[h - 1]) {
+        tv_wasm_fail("no such WebAssembly instance");
+        return NULL;
+    }
+    return tv_wasm_table[h - 1];
+}
+
+static void tv_wasm_release(tv_wasm *w) {
+    if (!w) return;
+    if (w->env) wasm_runtime_destroy_exec_env(w->env);
+    if (w->inst) wasm_runtime_deinstantiate(w->inst);
+    if (w->mod) wasm_runtime_unload(w->mod);
+    free(w->code);
+    free(w->out);
+    free(w);
+}
+
+/* Loads and instantiates `bytes`. stack: operand stack bytes (0: 64 KiB); pages: the most 64 KiB
+ * pages of linear memory (0: 256); fuel: instructions per call (0: unlimited). The handle, or 0
+ * with the reason in wasmError(). */
+tv_int tv_native_wasmLoad(tv_arr bytes, tv_int stack, tv_int pages, tv_int fuel) {
+    if (!tv_wasm_init()) return 0;
+    if (bytes.len <= 0) {
+        tv_wasm_fail("empty WebAssembly module");
+        return 0;
+    }
+    tv_int slot = -1;
+    for (tv_int i = 0; i < TV_WASM_MAX_INSTANCES; i++) {
+        if (!tv_wasm_table[i]) { slot = i; break; }
+    }
+    if (slot < 0) {
+        tv_wasm_fail("too many WebAssembly instances");
+        return 0;
+    }
+    tv_wasm *w = calloc(1, sizeof *w);
+    if (!w) {
+        tv_wasm_fail("out of memory");
+        return 0;
+    }
+    char err[256] = "";
+    w->code = malloc((size_t)bytes.len);
+    if (!w->code) {
+        tv_wasm_release(w);
+        tv_wasm_fail("out of memory");
+        return 0;
+    }
+    memcpy(w->code, tv_arr_data(bytes), (size_t)bytes.len);
+    w->stack = stack > 0 && stack < (1 << 24) ? (uint32_t)stack : TV_WASM_DEFAULT_STACK;
+    w->fuel = fuel > 0 ? (fuel > INT_MAX ? INT_MAX : (int)fuel) : -1;
+    w->mod = wasm_runtime_load(w->code, (uint32_t)bytes.len, err, sizeof err);
+    if (!w->mod) {
+        tv_wasm_release(w);
+        tv_wasm_fail("%s", err);
+        return 0;
+    }
+    struct InstantiationArgs2 *ia = NULL;
+    if (!wasm_runtime_instantiation_args_create(&ia)) {
+        tv_wasm_release(w);
+        tv_wasm_fail("out of memory");
+        return 0;
+    }
+    wasm_runtime_instantiation_args_set_default_stack_size(ia, w->stack);
+    wasm_runtime_instantiation_args_set_host_managed_heap_size(ia, 0);
+    uint32_t max_pages = pages > 0 && pages <= 65536 ? (uint32_t)pages : TV_WASM_DEFAULT_PAGES;
+    wasm_runtime_instantiation_args_set_max_memory_pages(ia, max_pages);
+    w->inst = wasm_runtime_instantiate_ex2(w->mod, ia, err, sizeof err);
+    wasm_runtime_instantiation_args_destroy(ia);
+    if (!w->inst) {
+        tv_wasm_release(w);
+        tv_wasm_fail("%s", err);
+        return 0;
+    }
+    /* the limit caps growth; a module that starts above it is refused too */
+    wasm_memory_inst_t mem0 = wasm_runtime_get_default_memory(w->inst);
+    if (mem0 && wasm_memory_get_cur_page_count(mem0) > max_pages) {
+        uint32_t have = (uint32_t)wasm_memory_get_cur_page_count(mem0);
+        tv_wasm_release(w);
+        tv_wasm_fail("the module's memory (%u pages) is above the limit of %u pages", (unsigned)have, (unsigned)max_pages);
+        return 0;
+    }
+    wasm_runtime_set_custom_data(w->inst, w);
+    w->env = wasm_runtime_create_exec_env(w->inst, w->stack);
+    if (!w->env) {
+        tv_wasm_release(w);
+        tv_wasm_fail("out of memory");
+        return 0;
+    }
+    tv_wasm_table[slot] = w;
+    return slot + 1;
+}
+
+bool tv_native_wasmHas(tv_int h, tv_str name) {
+    tv_wasm *w = tv_wasm_get(h);
+    return w && wasm_runtime_lookup_function(w->inst, name.p->data) != NULL;
+}
+
+/* The number of parameters of an exported function, or -1 when there is no such export. */
+tv_int tv_native_wasmArity(tv_int h, tv_str name) {
+    tv_wasm *w = tv_wasm_get(h);
+    if (!w) return -1;
+    wasm_function_inst_t fn = wasm_runtime_lookup_function(w->inst, name.p->data);
+    return fn ? (tv_int)wasm_func_get_param_count(fn, w->inst) : -1;
+}
+
+/* Calls an exported function. Each argument is an int for an i32 or i64 parameter; the result is
+ * the first result as an int (an i32 result is sign-extended), 0 when there is none. A trap, an
+ * unknown export or a wrong argument count sets wasmError() and returns 0. */
+tv_int tv_native_wasmCall(tv_int h, tv_str name, tv_arr args) {
+    tv_wasm *w = tv_wasm_get(h);
+    if (!w) return 0;
+    wasm_function_inst_t fn = wasm_runtime_lookup_function(w->inst, name.p->data);
+    if (!fn) {
+        tv_wasm_fail("no export named \"%s\"", name.p->data);
+        return 0;
+    }
+    uint32_t np = wasm_func_get_param_count(fn, w->inst);
+    uint32_t nr = wasm_func_get_result_count(fn, w->inst);
+    if (np > 16 || nr > 4) {
+        tv_wasm_fail("export \"%s\" has too many parameters or results", name.p->data);
+        return 0;
+    }
+    if ((tv_int)np != args.len) {
+        tv_wasm_fail("export \"%s\" takes %u arguments, got %lld", name.p->data, (unsigned)np, (long long)args.len);
+        return 0;
+    }
+    wasm_valkind_t pk[16], rk[4];
+    wasm_func_get_param_types(fn, w->inst, pk);
+    wasm_func_get_result_types(fn, w->inst, rk);
+    wasm_val_t av[16], rv[4];
+    const tv_int *src = (const tv_int *)tv_arr_data(args);
+    for (uint32_t i = 0; i < np; i++) {
+        memset(&av[i], 0, sizeof av[i]);
+        if (pk[i] == WASM_I32) { av[i].kind = WASM_I32; av[i].of.i32 = (int32_t)src[i]; }
+        else if (pk[i] == WASM_I64) { av[i].kind = WASM_I64; av[i].of.i64 = (int64_t)src[i]; }
+        else {
+            tv_wasm_fail("export \"%s\" takes a parameter that is not an i32 or i64", name.p->data);
+            return 0;
+        }
+    }
+    for (uint32_t i = 0; i < nr; i++) {
+        memset(&rv[i], 0, sizeof rv[i]);
+        rv[i].kind = rk[i];
+    }
+    wasm_runtime_clear_exception(w->inst);
+    wasm_runtime_set_instruction_count_limit(w->env, w->fuel);
+    if (!wasm_runtime_call_wasm_a(w->env, fn, nr, rv, np, av)) {
+        const char *ex = wasm_runtime_get_exception(w->inst);
+        tv_wasm_fail("%s", ex && *ex ? ex : "WebAssembly call failed");
+        wasm_runtime_clear_exception(w->inst);
+        return 0;
+    }
+    if (nr == 0) return 0;
+    if (rv[0].kind == WASM_I32) return (tv_int)rv[0].of.i32;
+    if (rv[0].kind == WASM_I64) return (tv_int)rv[0].of.i64;
+    return 0;
+}
+
+static uint8_t *tv_wasm_span(tv_wasm *w, tv_int ptr, tv_int len) {
+    if (ptr < 0 || len < 0 || ptr > 0xFFFFFFFFll || len > 0xFFFFFFFFll || !wasm_runtime_validate_app_addr(w->inst, (uint64_t)ptr, (uint64_t)len)) {
+        tv_wasm_fail("memory access out of bounds (offset %lld, length %lld)", (long long)ptr, (long long)len);
+        return NULL;
+    }
+    return wasm_runtime_addr_app_to_native(w->inst, (uint64_t)ptr);
+}
+
+tv_arr tv_native_wasmRead(tv_int h, tv_int ptr, tv_int len) {
+    tv_wasm *w = tv_wasm_get(h);
+    if (!w) return TV_EMPTY_ARR;
+    if (len == 0) return TV_EMPTY_ARR;
+    uint8_t *p = tv_wasm_span(w, ptr, len);
+    if (!p) return TV_EMPTY_ARR;
+    tv_arr a = tv_arr_with_capacity(&tv_type_u8, len);
+    memcpy(tv_arr_data(a), p, (size_t)len);
+    a.len = len;
+    return a;
+}
+
+bool tv_native_wasmWrite(tv_int h, tv_int ptr, tv_arr bytes) {
+    tv_wasm *w = tv_wasm_get(h);
+    if (!w) return false;
+    if (bytes.len == 0) return true;
+    uint8_t *p = tv_wasm_span(w, ptr, bytes.len);
+    if (!p) return false;
+    memcpy(p, tv_arr_data(bytes), (size_t)bytes.len);
+    return true;
+}
+
+/* The size of linear memory 0 in bytes (0 when the module has none). */
+tv_int tv_native_wasmMemSize(tv_int h) {
+    tv_wasm *w = tv_wasm_get(h);
+    if (!w) return 0;
+    wasm_memory_inst_t m = wasm_runtime_get_default_memory(w->inst);
+    if (!m) return 0;
+    return (tv_int)wasm_memory_get_cur_page_count(m) * (tv_int)wasm_memory_get_bytes_per_page(m);
+}
+
+/* What the instance wrote to standard output and error since the last call (cut at 64 KiB). */
+tv_str tv_native_wasmOutput(tv_int h) {
+    tv_wasm *w = tv_wasm_get(h);
+    if (!w || !w->out_len) return TV_EMPTY_STR;
+    tv_str s = tv_str_from(w->out, w->out_len);
+    w->out_len = 0;
+    return s;
+}
+
+void tv_native_wasmFree(tv_int h) {
+    if (h <= 0 || h > TV_WASM_MAX_INSTANCES) return;
+    tv_wasm_release(tv_wasm_table[h - 1]);
+    tv_wasm_table[h - 1] = NULL;
+}
+
+tv_str tv_native_wasmError(void) {
+    if (!tv_wasm_err[0]) return TV_EMPTY_STR;
+    tv_str s = tv_str_from(tv_wasm_err, strlen(tv_wasm_err));
+    tv_wasm_err[0] = 0;
+    return s;
+}
+
+#endif
