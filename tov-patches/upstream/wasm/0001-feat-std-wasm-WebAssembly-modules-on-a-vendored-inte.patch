+                            goto fail;
+                        }
+
+                        elem_type = array_type->elem_type;
+                        if (is_packed_type(elem_type)) {
+                            if (opcode1 != WASM_OP_ARRAY_GET_S
+                                && opcode1 != WASM_OP_ARRAY_GET_U
+                                && opcode1 != WASM_OP_ARRAY_SET) {
+                                set_error_buf(error_buf, error_buf_size,
+                                              "type mismatch");
+                                goto fail;
+                            }
+                            else {
