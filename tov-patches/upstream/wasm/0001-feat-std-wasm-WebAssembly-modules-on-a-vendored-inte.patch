+
+                    case WASM_OP_ARRAY_NEW:
+                    case WASM_OP_ARRAY_NEW_DEFAULT:
+                    case WASM_OP_ARRAY_NEW_FIXED:
+                    case WASM_OP_ARRAY_NEW_DATA:
+                    case WASM_OP_ARRAY_NEW_ELEM:
+                    {
+                        WASMArrayType *array_type;
+                        uint8 elem_type;
+                        uint32 u32 = 0;
