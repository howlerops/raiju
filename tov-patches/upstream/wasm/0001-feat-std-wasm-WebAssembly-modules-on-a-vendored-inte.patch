+bool
+wasm_table_grow(wasm_table_t *table, wasm_table_size_t delta,
+                own wasm_ref_t *init)
+{
+    (void)table;
+    (void)delta;
+    (void)init;
+    LOG_WARNING("Calling wasm_table_grow() by host is not supported."
+                "Only allow growing a table via the opcode table.grow");
+    return false;
+}
