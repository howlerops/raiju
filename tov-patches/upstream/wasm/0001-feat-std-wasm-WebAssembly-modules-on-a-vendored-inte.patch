+                            if (u32 >= module->data_seg_count) {
+                                set_error_buf(error_buf, error_buf_size,
+                                              "unknown data segment");
+                                goto fail;
+                            }
+
+                            if (wasm_is_type_reftype(elem_type)) {
+                                set_error_buf(error_buf, error_buf_size,
+                                              "array elem type mismatch");
+                                goto fail;
+                            }
+                        }
