+    uint64 flags[8];
+
+    /* required by JIT */
+    LLVMOrcLLLazyJITRef orc_jit;
+    LLVMOrcThreadSafeContextRef orc_thread_safe_context;
+
+    LLVMModuleRef module;
+
+    bool is_jit_mode;
+
