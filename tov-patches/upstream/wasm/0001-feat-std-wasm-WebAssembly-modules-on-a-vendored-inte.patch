+                    br_item_size += sizeof(uint32);
+                    /* cells, src offsets and dst offsets */
+                    br_item_size +=
+                        (CELL_SIZE + sizeof(int16) + sizeof(uint16)) * arity;
+                }
+                /* target address */
+                br_item_size += sizeof(uint8 *);
