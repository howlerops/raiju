+                                            elem_type)) {
+                                        bh_memcpy_s(
+                                            &wasm_ref_type, sizeof(WASMRefType),
+                                            array_type->elem_ref_type,
+                                            wasm_reftype_struct_size(
+                                                array_type->elem_ref_type));
+                                    }
+                                    POP_REF(elem_type);
+                                }
+                            }
+                            else
