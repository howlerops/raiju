+wasm_table_t *
+wasm_table_copy(const wasm_table_t *src)
+{
+    wasm_table_t *table;
+
+    if (!(table = wasm_table_new_basic(src->store, src->type))) {
+        return NULL;
+    }
+
+    table->table_idx_rt = src->table_idx_rt;
+    table->inst_comm_rt = src->inst_comm_rt;
+    return table;
+}
