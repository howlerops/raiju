+static inline float32
+f32_min(float32 a, float32 b)
+{
+    if (isnan(a) || isnan(b))
+        return NAN;
+    else if (a == 0 && a == b)
+        return signbit(a) ? a : b;
+    else
+        return a > b ? b : a;
+}
+
+static inline float32
+f32_max(float32 a, float32 b)
+{
+    if (isnan(a) || isnan(b))
