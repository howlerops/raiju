+static wasm_frame_t *
+wasm_frame_new(wasm_instance_t *instance, size_t module_offset,
+               uint32 func_index, size_t func_offset)
+{
+    wasm_frame_t *frame;
+
+    if (!(frame = malloc_internal(sizeof(wasm_frame_t)))) {
+        return NULL;
