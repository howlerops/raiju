+/**
+ * Return export function count in module export section.
+ */
+static uint32
+get_export_count(const WASMModule *module, uint8 kind)
+{
+    WASMExport *export = module->exports;
+    uint32 count = 0, i;
+
+    for (i = 0; i < module->export_count; i++, export ++)
+        if (export->kind == kind)
+            count++;
+
+    return count;
+}
