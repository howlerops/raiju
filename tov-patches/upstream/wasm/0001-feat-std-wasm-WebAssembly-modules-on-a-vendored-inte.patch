new file mode 100644
index 0000000..6bdd929
--- /dev/null
+++ b/crates/tov/src/std/wasm.tov
@@ -0,0 +1,85 @@
+// std/wasm — WebAssembly modules, run by an interpreter (WAMR) with limits. Import it as
+// `import { instantiate } from "std/wasm"`.
+//
+// A module is instantiated from its bytes with no imports but a small WASI subset (clock,
+// random, standard output and error captured in a buffer, an empty environment, no files) and
+// AssemblyScript's `env.abort`. Calls pass i32 and i64 values as `int`; memory is read and
+// written by offset. A trap, a missing export or a bad offset throws an Error.
+
+function check(): void throws Error {
+  const err = __native.wasmError()
+  if (err !== "") {
+    throw new Error(err)
+  }
+}
+
+// Limits for one instance. A field left out takes the default: 64 KiB of operand stack, 256 pages
+// (16 MiB) of linear memory, no instruction budget. `fuel` is the most instructions one call may
+// execute (about 2 billion at most); a call that runs past it traps, so a loop cannot hang the
+// process.
+export type WasmLimits = {
+  stackBytes?: int
+  maxPages?: int
+  fuel?: int
+}
+
+export class WasmInstance {
+  constructor(readonly handle: int) {}
+
+  // Whether the module exports a function of that name.
+  has(name: string): bool {
+    return __native.wasmHas(this.handle, name)
+  }
+
+  // The number of parameters of an exported function, or -1 when there is no such export.
+  arity(name: string): int {
+    return __native.wasmArity(this.handle, name)
+  }
+
+  // Calls an exported function. `args` holds one int per i32 or i64 parameter. The result is the
+  // function's first result as an int (an i32 is sign-extended), or 0 for a function with none.
+  call(name: string, args: int[]): int throws Error {
+    const r = __native.wasmCall(this.handle, name, args)
+    try check()
+    return r
+  }
+
+  // `len` bytes of linear memory from `ptr`.
+  read(ptr: int, len: int): u8[] throws Error {
+    const b = __native.wasmRead(this.handle, ptr, len)
+    try check()
+    return b
+  }
+
+  // Writes bytes into linear memory at `ptr`.
+  write(ptr: int, bytes: u8[]): void throws Error {
+    __native.wasmWrite(this.handle, ptr, bytes)
+    try check()
+  }
+
+  // The size of linear memory in bytes.
+  memorySize(): int {
+    return __native.wasmMemSize(this.handle)
+  }
+
+  // What the module wrote to standard output and error since the last call (at most 64 KiB).
+  output(): string {
+    return __native.wasmOutput(this.handle)
+  }
+
+  // Releases the instance. Using it afterwards throws.
+  close(): void {
+    __native.wasmFree(this.handle)
+  }
+}
+
+// Loads and instantiates a module. Throws when the bytes are not a valid module, an import is
+// missing, or the limits do not fit.
+export function instantiate(bytes: u8[], limits?: WasmLimits): WasmInstance throws Error {
+  const h = __native.wasmLoad(bytes, limits?.stackBytes ?? 0, limits?.maxPages ?? 0, limits?.fuel ?? 0)
+  if (h === 0) {
+    try check()
+    throw new Error("WebAssembly module failed to load")
+  }
+  return new WasmInstance(h)
+}
