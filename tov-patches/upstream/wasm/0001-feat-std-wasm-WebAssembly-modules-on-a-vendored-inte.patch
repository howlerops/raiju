+        && ((WASMModuleInstance *)module_inst)->module->import_wasi_api)
+        return true;
+#endif
+#if WASM_ENABLE_AOT != 0
+    if (module_inst->module_type == Wasm_Module_AoT
+        && ((AOTModule *)((AOTModuleInstance *)module_inst)->module)
+               ->import_wasi_api)
+        return true;
+#endif
+    return false;
+}
