+                cond = frame_lp[GET_OFFSET()];
+                addr1 = GET_OFFSET();
+                addr2 = GET_OFFSET();
+                addr_ret = GET_OFFSET();
+
+                if (!cond) {
+                    if (addr_ret != addr1)
+                        PUT_REF_TO_ADDR(frame_lp + addr_ret,
+                                        GET_REF_FROM_ADDR(frame_lp + addr1));
+                }
+                else {
