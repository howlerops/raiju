+#if WASM_ENABLE_THREAD_MGR != 0
+                CHECK_SUSPEND_FLAGS();
+#endif
+                count = read_uint32(frame_ip);
+                didx = GET_OPERAND(uint32, I32, 0);
+                frame_ip += 2;
