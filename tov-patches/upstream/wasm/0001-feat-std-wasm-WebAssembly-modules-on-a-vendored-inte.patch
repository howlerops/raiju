+                WASMTableInstance *tbl_inst;
+                uint32 tbl_idx;
+
+#if WASM_ENABLE_TAIL_CALL != 0
+                GET_OPCODE();
+#endif
+#if WASM_ENABLE_THREAD_MGR != 0
+                CHECK_SUSPEND_FLAGS();
+#endif
+
+                tidx = read_uint32(frame_ip);
+                cur_type = (WASMFuncType *)module->module->types[tidx];
+
