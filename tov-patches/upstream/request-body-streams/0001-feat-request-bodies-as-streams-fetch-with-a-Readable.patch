+/// Runs tests/http/body_stream.tov (a server that reads big request bodies as streams) against
+/// tests/http/body_stream_client.py, which prints "ok" and "FAIL" lines.
+fn body_streams(root: &Path, failed: &mut Vec<String>) {
+    const CHECKS: usize = 19;
+    if !Command::new("python3").arg("--version").output().is_ok_and(|o| o.status.success()) {
+        println!("http: request body streams skipped (no python3)");
+        return;
+    }
+    let opts = tov::build::Options { mode: tov::codegen::Mode::Run, unchecked: false, opt: "-O2".into(), emit_c: None, symbols: false };
+    let built = match tov::build::build(&[root.join("tests/http/body_stream.tov")], root, &opts) {
+        Ok(b) => b,
+        Err(tov::build::BuildError::Diagnostics(sm, d)) => {
+            failed.push(format!("body_stream: build failed\n{}", tov::diag::render_text(&d, &sm)));
+            return;
+        }
+        Err(tov::build::BuildError::Message(m)) => {
+            failed.push(format!("body_stream: {m}"));
+            return;
+        }
+    };
+    let mut child = Command::new(&built.binary).stdout(std::process::Stdio::piped()).stderr(std::process::Stdio::null()).spawn().expect("start body_stream");
+    let mut line = String::new();
+    let _ = std::io::BufRead::read_line(&mut std::io::BufReader::new(child.stdout.take().unwrap()), &mut line);
+    let port = line.trim().strip_prefix("listening ").unwrap_or("").to_string();
+    let out = Command::new("python3").arg(root.join("tests/http/body_stream_client.py")).arg(&port).arg(child.id().to_string()).output().expect("run body_stream_client.py");
+    let _ = child.kill();
+    let _ = child.wait();
+    let text = String::from_utf8_lossy(&out.stdout);
+    let oks = text.lines().filter(|l| l.starts_with("ok ")).count();
+    if text.lines().any(|l| l.starts_with("FAIL")) || oks != CHECKS {
+        failed.push(format!("request body streams: {oks} of {CHECKS} checks passed\n{text}"));
+    }
+}
