+/* What has arrived and was not taken. */
+tv_arr tv_native_httpBodyTake(tv_int id) {
+    tv_http_bs *b = tv_http_bs_get(id);
+    if (!b || !b->buf.len) return TV_EMPTY_ARR;
+    tv_arr a = tv_arr_with_capacity(&tv_type_u8, (tv_int)b->buf.len);
+    memcpy(tv_arr_data(a), b->buf.data, b->buf.len);
+    a.len = (tv_int)b->buf.len;
+    b->buf.len = 0;
+    if (b->buf.cap > ((size_t)1 << 20)) tv_sb_free(&b->buf);
