+    const v = c.value
+    if (c.done || v === undefined) {
+      break
+    }
+    const rc = await __native.fetchWrite(id, v)
+    if (rc < 0) {
+      await st.cancel()
+      return
+    }
+  }
+  __native.fetchEnd(id)
+}
