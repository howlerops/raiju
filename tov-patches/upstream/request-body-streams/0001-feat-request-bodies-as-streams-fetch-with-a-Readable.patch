+        tv_http_bs_table = tv_realloc(tv_http_bs_table, (size_t)cap * sizeof *tv_http_bs_table);
+        tv_http_bs_free = tv_realloc(tv_http_bs_free, (size_t)cap * sizeof *tv_http_bs_free);
+        for (tv_int i = cap - 1; i >= tv_http_bs_cap; i--) { tv_http_bs_table[i] = NULL; tv_http_bs_free[tv_http_bs_nfree++] = i; }
