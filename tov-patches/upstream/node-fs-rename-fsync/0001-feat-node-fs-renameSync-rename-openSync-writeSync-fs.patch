+// Options as in Node: `mode` for a file it creates (0o666 by default, less the umask),
+// `flush: true` to fsync the data before returning.
+export function writeFileSync(path: string, data: string | u8[], options?: { mode?: int, flush?: bool }): void throws Error {
+  const text = typeof data === "string" ? data : __native.bytesToString(data)
+  const flush = options?.flush ?? false
+  const mode = options?.mode ?? -1
+  if (!flush && mode < 0) {
+    __native.writeFile(path, text, false)
+    try check()
+    return
+  }
+  const fd = __native.open(path, "w", mode < 0 ? 438 : mode)
+  try check()
+  __native.writeFd(fd, text)
+  if (flush) {
+    __native.fsync(fd, false)
+  }
+  const err = __native.takeError()
+  __native.close(fd)
+  if (err !== "") {
+    throw new Error(err)
   }
   try check()
 }
@@ -62,6 +78,63 @@ export function unlinkSync(path: string): void throws Error {
   try check()
 }
 
+// fs.renameSync — POSIX rename(2): an existing `newPath` is replaced in one step, so a
+// reader sees either the old file or the new one. Both paths must be on one file system
+// (EXDEV otherwise).
+export function renameSync(oldPath: string, newPath: string): void throws Error {
+  __native.rename(oldPath, newPath)
+  try check()
+}
+
+// fs.rename — the callback form. The rename is done now; the callback runs as a microtask
+// with the error, or undefined.
+export function rename(oldPath: string, newPath: string, callback: (err: Error | undefined) => void): void {
+  __native.rename(oldPath, newPath)
+  const err = __native.takeError()
+  queueMicrotask(() => {
+    callback(err === "" ? undefined : new Error(err))
+  })
+}
+
+export function chmodSync(path: string, mode: int): void throws Error {
+  __native.chmod(path, mode)
+  try check()
+}
+
+// fs.openSync — a file descriptor. Flags as in Node: "r" (the default), "r+", "w", "wx",
+// "w+", "a", "ax", "a+"; `mode` (default 0o666, less the umask) applies to a created file.
+// "r" also opens a directory, so fsyncSync can make a rename in it durable.
+export function openSync(path: string, flags?: string, mode?: int): int throws Error {
+  const fd = __native.open(path, flags ?? "r", mode ?? 438)
+  try check()
+  return fd
+}
+
+// fs.writeSync — writes all of `data` at the descriptor's position; the bytes written.
+export function writeSync(fd: int, data: string | u8[]): int throws Error {
+  const text = typeof data === "string" ? data : __native.bytesToString(data)
+  const n = __native.writeFd(fd, text)
+  try check()
+  return n
+}
+
+// fs.fsyncSync / fs.fdatasyncSync — flush the descriptor's data (and, for fsync, its
+// metadata) to the storage device.
+export function fsyncSync(fd: int): void throws Error {
+  __native.fsync(fd, false)
+  try check()
+}
+
+export function fdatasyncSync(fd: int): void throws Error {
+  __native.fsync(fd, true)
+  try check()
+}
+
+export function closeSync(fd: int): void throws Error {
+  __native.close(fd)
+  try check()
+}
+
 export function rmSync(path: string, options?: { recursive?: bool, force?: bool }): void throws Error {
   const recursive = options?.recursive ?? false
   const force = options?.force ?? false
