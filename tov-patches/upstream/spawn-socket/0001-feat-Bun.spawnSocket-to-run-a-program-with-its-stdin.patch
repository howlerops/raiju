diff --git a/tests/run/native_spawn.tov b/tests/run/native_spawn.tov
new file mode 100644
index 0000000..600d902
--- /dev/null
+++ b/tests/run/native_spawn.tov
@@ -0,0 +1,74 @@
+// Bun.spawnSocket: a child process whose stdin and stdout are a Socket (the child is a shell loop
+// that echoes each line with the env var X in front).
+async function echo() {
+  const dec = try new TextDecoder()
+  let got = ""
+  const done = new Promise<int>((resolve) => {
+    Bun.spawnSocket({
+      cmd: ["sh", "-c", 'while read l; do echo "$X:$l"; done'],
+      env: { X: "tag" },
+      socket: {
+        open(socket) {
+          socket.write("one\ntwo\n")
+        },
+        data(socket, data) {
+          got += try dec.decode(data)
+          if (got.endsWith("tag:two\n")) {
+            socket.end()
+          }
+        },
+        close(socket) {
+          resolve(0)
+        },
+      },
+    })
+  })
+  await done
+  for (const line of got.split("\n")) {
+    if (line !== "") {
+      console.log(line)
+    }
+  }
+  console.log("closed")
+}
+
+async function inDirectory() {
+  const dec = try new TextDecoder()
+  let got = ""
+  const done = new Promise<int>((resolve) => {
+    Bun.spawnSocket({
+      cmd: ["pwd"],
+      cwd: "/",
+      socket: {
+        data(socket, data) {
+          got += try dec.decode(data)
+        },
+        close(socket) {
+          resolve(0)
+        },
+      },
+    })
+  })
+  await done
+  console.log(`cwd: ${got.trimEnd()}`)
+}
+
+async function missing() {
+  const done = new Promise<int>((resolve) => {
+    Bun.spawnSocket({
+      cmd: ["no-such-program-for-tov-test"],
+      socket: {
+        data(socket, data) {},
+        close(socket) {
+          resolve(0)
+        },
+      },
+    })
+  })
+  await done
+  console.log("missing executable: closed")
+}
+
+try await echo()
+try await inDirectory()
+try await missing()
