+// Bun.udpSocket (Tov): a UDP socket. `data` gets each datagram, with the sender's port and address.
+export type UDPSocketHandler<T> = {
+  data?: (socket: UDPSocket<T>, data: u8[], port: int, address: string) => void throws Error
+  error?: (socket: UDPSocket<T>, error: Error) => void
+}
+
+export type UDPSocketOptions<T> = {
+  hostname?: string
+  port?: number
+  broadcast?: bool
+  reusePort?: bool
+  data?: T
+  socket: UDPSocketHandler<T>
+}
+
+export class UDPSocket<T = undefined> {
+  data: T | undefined
+  private id: int
+  private handlers: UDPSocketHandler<T>
+  private done: bool
+
+  constructor(id: int, handlers: UDPSocketHandler<T>, data: T | undefined) {
+    this.id = id
+    this.handlers = handlers
+    this.data = data
+    this.done = false
+  }
+
+  // Internal: a datagram arrived (the native's message event).
+  event(bytes: u8[], address: string, port: int): void {
+    try {
+      this.handle(bytes, address, port)
+    } catch (e) {
+      const f = this.handlers.error
+      if (f !== undefined) {
+        f(this, e)
+      } else {
+        console.error(`error: ${e.message}`)
+      }
+    }
+  }
+
+  private handle(bytes: u8[], address: string, port: int): void throws Error {
+    const f = this.handlers.data
+    if (f !== undefined) {
+      try f(this, bytes, port, address)
+    }
+  }
+
+  // Sends text (as UTF-8) or bytes to address:port. False if it didn't go (the socket is closed,
+  // or the kernel's send buffer is full: a datagram is not retried).
+  send(data: string | u8[], port: number, address: string): bool {
+    if (this.done) {
+      return false
+    }
+    const bytes = typeof data === "string" ? __native.stringToBytes(data) : data
+    return __native.udpSend(this.id, bytes, address, Math.trunc(port)) >= 0
+  }
+
+  // Closes now; datagrams not yet delivered are dropped.
+  close(): void {
+    this.done = true
+    __native.udpClose(this.id)
+  }
+
+  // The program can exit while the socket is open.
+  unref(): void {
+    __native.udpRef(this.id, false)
+  }
+
+  ref(): void {
+    __native.udpRef(this.id, true)
+  }
+
+  get closed(): bool {
+    return this.done
+  }
+
+  setBroadcast(on: bool): bool {
+    return __native.udpOption(this.id, "broadcast", on ? 1 : 0) === 0
+  }
+
+  setTTL(ttl: int): bool {
+    return __native.udpOption(this.id, "ttl", ttl) === 0
+  }
+
+  setMulticastTTL(ttl: int): bool {
+    return __native.udpOption(this.id, "multicastTTL", ttl) === 0
+  }
+
+  setMulticastLoopback(on: bool): bool {
+    return __native.udpOption(this.id, "multicastLoopback", on ? 1 : 0) === 0
+  }
+
+  // The interface (an address of this host) multicast packets are sent from.
+  setMulticastInterface(address: string): bool {
+    return __native.udpMulticastIf(this.id, address) === 0
+  }
+
+  // Joins or leaves a multicast group, on the interface at `iface` (default: the system's choice).
+  addMembership(group: string, iface?: string): bool {
+    return __native.udpMembership(this.id, group, iface ?? "", true) === 0
+  }
+
+  dropMembership(group: string, iface?: string): bool {
+    return __native.udpMembership(this.id, group, iface ?? "", false) === 0
+  }
+
+  get hostname(): string {
+    return __native.udpAddress(this.id, 2)
+  }
+
+  get port(): int {
+    return parseInt(__native.udpAddress(this.id, 3)) ?? 0
+  }
+}
+
+// Opens a UDP socket bound to hostname:port (IPv6 if the name has a colon). Resolves with the socket;
+// rejects with a SocketError when it can't be bound.
+function udpSocket<T>(options: UDPSocketOptions<T>): Promise<UDPSocket<T>, Error> {
+  const host = options.hostname ?? "0.0.0.0"
+  const port = Math.trunc(options.port ?? 0)
+  const family = host.includes(":") ? 6 : 4
+  const id = __native.udpOpen(family)
+  if (id < 0) {
+    return Promise.reject(new SocketError(`udp socket failed (errno ${-id})`, "ERR_SOCKET"))
+  }
+  const bound = __native.udpBind(id, host, port, options.reusePort ?? false)
+  if (bound < 0) {
+    __native.udpClose(id)
+    return Promise.reject(new SocketError(`bind ${host}:${port} failed (errno ${-bound})`, "ERR_SOCKET_BIND"))
+  }
+  if (options.broadcast ?? false) {
+    __native.udpOption(id, "broadcast", 1)
+  }
+  const s = new UDPSocket<T>(id, options.socket, options.data)
+  __native.udpEvents(id, (kind: int, bytes: u8[], text: string, code: int): void => s.event(bytes, text, code))
+  __native.udpRecv(id, true)
+  return Promise.resolve(s)
+}
+
 export class TCPSocketListener<T = undefined> {
   readonly hostname: string
   data: T | undefined
@@ -2564,4 +2705,8 @@ export class Bun {
   static listen<T = undefined>(options: ListenOptions<T>): TCPSocketListener<T> {
     return listenSockets(options)
   }
+
+  static udpSocket<T = undefined>(options: UDPSocketOptions<T>): Promise<UDPSocket<T>, Error> {
+    return udpSocket(options)
+  }
 }
