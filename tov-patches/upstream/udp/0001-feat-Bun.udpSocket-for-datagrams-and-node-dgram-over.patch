diff --git a/runtime/net.c b/runtime/net.c
index 7968b23..19bfb3d 100644
--- a/runtime/net.c
+++ b/runtime/net.c
@@ -857,6 +857,348 @@ void tv_native_netListenRef(tv_int id, bool ref) {
     tv_io_refs += ref ? 1 : -1;
 }
 
+/* ---- UDP: datagram sockets on the loop (node:dgram's udp_wrap, Bun.udpSocket). A socket is a table
+ * entry named by id. Each datagram that arrives while it reads is one message event: kind 1, the
+ * bytes, the sender's address (text) and port. Events go to the Tov closure given to udpEvents, or
+ * to a C sink a host sets with tv_udp_set_sink (node.c's JS callbacks). A closed socket is freed
+ * once no event of its is being delivered, as the TCP sockets are. */
+
+enum { TV_UDP_MESSAGE = 1 };
+
+typedef struct tv_udp {
+    tv_io io;
+    int fd;
+    tv_int id;
+    int family;              /* 4 or 6 */
+    bool reading, registered, watch_read, refd, counted, closed, has_cb;
+    int busy;                /* events being delivered: free afterwards, not now */
+    tv_fn cb;                /* the Tov closure: (kind, bytes, address, port) */
+    tv_udp_sink sink;        /* or a host's sink, which takes precedence */
+    void *udata;
+} tv_udp;
+
+static tv_udp **tv_udp_tab;
+static tv_int tv_udp_cap, tv_udp_next = 1;
+static uint8_t tv_udp_buf[65536];
+
+static tv_udp *tv_udp_get(tv_int id) {
+    tv_udp *u = id > 0 && id < tv_udp_cap ? tv_udp_tab[id] : NULL;
+    return u && !u->closed ? u : NULL;
+}
+
+/* Watches the fd for reads while the socket reads, and keeps the program running (tv_io_refs)
+ * while it does and isn't unref'd. */
+static void tv_udp_update(tv_udp *u) {
+    if (u->closed || u->fd < 0) return;
+    if (!u->registered) {
+        u->registered = true;
+        u->watch_read = u->reading;
+        tv_io_add(u->fd, &u->io, u->reading, false);
+    } else if (u->watch_read != u->reading) {
+        u->watch_read = u->reading;
+        tv_io_set(u->fd, &u->io, u->reading, false);
+    }
+    bool active = u->refd && u->reading;
+    if (active != u->counted) {
+        tv_io_refs += active ? 1 : -1;
+        u->counted = active;
+    }
+}
+
+static void tv_udp_settle(tv_udp *u) {
+    if (!u->closed || u->busy) return;
+    tv_udp_tab[u->id] = NULL;
+    if (u->has_cb) tv_env_release(u->cb.env);
+    free(u);
+}
+
+static void tv_udp_emit(tv_udp *u, const uint8_t *data, size_t n, const char *addr, int port) {
+    if (u->sink) {
+        u->sink(u->udata, data, n, addr, port);
+        return;
+    }
+    if (!u->has_cb) return;
+    tv_arr bytes = TV_EMPTY_ARR;
+    if (n) {
+        bytes = tv_arr_with_capacity(&tv_type_u8, (tv_int)n);
+        memcpy(tv_arr_data(bytes), data, n);
+        bytes.len = (tv_int)n;
+    }
+    tv_str t = tv_str_from(addr, strlen(addr));
+    u->busy++;
+    ((void (*)(void *, tv_int, tv_arr, tv_str, tv_int))u->cb.fn)(u->cb.env, TV_UDP_MESSAGE, bytes, t, port);
+    u->busy--;
+    tv_arr_release(bytes, &tv_type_u8);
+    tv_str_release(t);
+}
+
+static void tv_udp_ready(tv_io *h, bool readable, bool writable, bool broken) {
+    (void)writable;
+    tv_udp *u = (tv_udp *)h;
+    if (u->closed || !u->reading || !(readable || broken)) return;
+    u->busy++;
+    for (int i = 0; i < 64 && u->reading && !u->closed; i++) {
+        struct sockaddr_storage ss;
+        socklen_t sl = sizeof ss;
+        ssize_t r = recvfrom(u->fd, tv_udp_buf, sizeof tv_udp_buf, 0, (struct sockaddr *)&ss, &sl);
+        if (r < 0) {
+            if (errno == EINTR) continue;
+            break;           /* drained (EAGAIN); an error that isn't a datagram isn't reported */
+        }
+        char addr[INET6_ADDRSTRLEN + 1] = "";
+        int port = 0;
+        if (ss.ss_family == AF_INET) {
+            struct sockaddr_in *v4 = (struct sockaddr_in *)&ss;
+            inet_ntop(AF_INET, &v4->sin_addr, addr, sizeof addr);
+            port = ntohs(v4->sin_port);
+        } else if (ss.ss_family == AF_INET6) {
+            struct sockaddr_in6 *v6 = (struct sockaddr_in6 *)&ss;
+            inet_ntop(AF_INET6, &v6->sin6_addr, addr, sizeof addr);
+            port = ntohs(v6->sin6_port);
+        }
+        tv_udp_emit(u, tv_udp_buf, (size_t)r, addr, port);
+    }
+    u->busy--;
+    tv_udp_settle(u);
+}
+
+/* The socket address of host (numeric, or a name looked up now; "" is the wildcard) and port, for
+ * a socket of family 4 or 6. 0, or -errno. */
+static int tv_udp_addr(const char *host, int port, int family, struct sockaddr_storage *ss, socklen_t *len) {
+    memset(ss, 0, sizeof *ss);
+    if (!*host) {
+        if (family == 6) {
+            struct sockaddr_in6 *v6 = (struct sockaddr_in6 *)ss;
+            v6->sin6_family = AF_INET6;
+            v6->sin6_addr = in6addr_any;
+            v6->sin6_port = htons((uint16_t)port);
+            *len = sizeof *v6;
+        } else {
+            struct sockaddr_in *v4 = (struct sockaddr_in *)ss;
+            v4->sin_family = AF_INET;
+            v4->sin_addr.s_addr = htonl(INADDR_ANY);
+            v4->sin_port = htons((uint16_t)port);
+            *len = sizeof *v4;
+        }
+        return 0;
+    }
+    struct addrinfo hints, *res = NULL;
+    memset(&hints, 0, sizeof hints);
+    hints.ai_family = family == 6 ? AF_INET6 : AF_INET;
+    hints.ai_socktype = SOCK_DGRAM;
+    if (getaddrinfo(host, NULL, &hints, &res) != 0 || !res) return -EADDRNOTAVAIL;
+    memcpy(ss, res->ai_addr, res->ai_addrlen);
+    *len = res->ai_addrlen;
+    freeaddrinfo(res);
+    if (ss->ss_family == AF_INET) ((struct sockaddr_in *)ss)->sin_port = htons((uint16_t)port);
+    else ((struct sockaddr_in6 *)ss)->sin6_port = htons((uint16_t)port);
+    return 0;
+}
+
+/* udpOpen(family) -> socket id (family 4 or 6), or -errno. */
+tv_int tv_native_udpOpen(tv_int family) {
+    int f = family == 6 ? AF_INET6 : AF_INET;
+    int fd = socket(f, SOCK_DGRAM, 0);
+    if (fd < 0) return -errno;
+    fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+    fcntl(fd, F_SETFD, FD_CLOEXEC);
+#ifdef SO_NOSIGPIPE
+    int one = 1;
+    setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
+#endif
+    tv_udp *u = tv_alloc(sizeof *u);
+    memset(u, 0, sizeof *u);
+    u->io.ready = tv_udp_ready;
+    u->fd = fd;
+    u->family = family == 6 ? 6 : 4;
+    u->refd = true;
+    if (tv_udp_next >= tv_udp_cap) {
+        tv_int cap = tv_udp_cap ? tv_udp_cap * 2 : 16;
+        tv_udp_tab = tv_realloc(tv_udp_tab, (size_t)cap * sizeof *tv_udp_tab);
+        memset(tv_udp_tab + tv_udp_cap, 0, (size_t)(cap - tv_udp_cap) * sizeof *tv_udp_tab);
+        tv_udp_cap = cap;
+    }
+    u->id = tv_udp_next++;
+    tv_udp_tab[u->id] = u;
+    return u->id;
+}
+
+/* udpBind(id, host, port, reuse) -> 0, or -errno. reuse: SO_REUSEADDR and SO_REUSEPORT (several
+ * sockets may share the port, as multicast listeners do). */
+tv_int tv_native_udpBind(tv_int id, tv_str host, tv_int port, bool reuse) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return -EBADF;
+    struct sockaddr_storage ss;
+    socklen_t len;
+    int r = tv_udp_addr(host.p->data, (int)port, u->family, &ss, &len);
+    if (r) return r;
+    int one = 1;
+    if (reuse) {
+        setsockopt(u->fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+#ifdef SO_REUSEPORT
+        setsockopt(u->fd, SOL_SOCKET, SO_REUSEPORT, &one, sizeof one);
+#endif
+    }
+    if (bind(u->fd, (struct sockaddr *)&ss, len) != 0) return -errno;
+    return 0;
+}
+
+/* udpEvents(id, events): the Tov closure for the socket's messages, events(kind, bytes, address,
+ * port). */
+void tv_native_udpEvents(tv_int id, tv_fn events) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    if (u->has_cb) tv_env_release(u->cb.env);
+    tv_env_retain(events.env);
+    u->cb = events;
+    u->has_cb = true;
+}
+
+/* udpRecv(id, on): starts or stops reading messages. */
+void tv_native_udpRecv(tv_int id, bool on) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    u->reading = on;
+    tv_udp_update(u);
+}
+
+/* For a host (node.c): messages go to sink(udata, bytes, n, address, port) instead of the closure. */
+void tv_udp_set_sink(tv_int id, tv_udp_sink sink, void *udata) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    u->sink = sink;
+    u->udata = udata;
+}
+
+/* udpSend(id, bytes, host, port) -> the bytes sent, or -errno (no waiting: a datagram the kernel
+ * can't take now fails with EAGAIN). */
+tv_int tv_udp_send_bytes(tv_int id, const uint8_t *data, size_t n, tv_str host, tv_int port) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return -EBADF;
+    struct sockaddr_storage ss;
+    socklen_t len;
+    int r = tv_udp_addr(host.p->data, (int)port, u->family, &ss, &len);
+    if (r) return r;
+    int flags = 0;
+#ifdef MSG_NOSIGNAL
+    flags = MSG_NOSIGNAL;
+#endif
+    ssize_t w;
+    do w = sendto(u->fd, data, n, flags, (struct sockaddr *)&ss, len); while (w < 0 && errno == EINTR);
+    return w < 0 ? -errno : (tv_int)w;
+}
+
+tv_int tv_native_udpSend(tv_int id, tv_arr bytes, tv_str host, tv_int port) {
+    return tv_udp_send_bytes(id, tv_arr_data(bytes), (size_t)bytes.len, host, port);
+}
+
