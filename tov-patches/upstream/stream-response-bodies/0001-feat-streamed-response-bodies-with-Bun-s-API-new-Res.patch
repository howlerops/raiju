 // A body as a stream of byte chunks: `res.body`. Read it with `getReader()` (`read()` until
 // `done`) or `for await (const chunk of res.body)`. A fetch() body streams as it arrives.
+// What a ReadableStream made in the program reads from: `start` gets a controller to
+// enqueue chunks to, `cancel` runs when the reader stops (for a response: the client left).
+export type UnderlyingSource = {
+  start?: (controller: ReadableStreamDefaultController) => void
+  cancel?: () => void
+}
+
+export class ReadableStreamDefaultController {
+  private stream: ReadableStream
+
+  constructor(stream: ReadableStream) {
+    this.stream = stream
+  }
+
+  // Adds a chunk (bytes, or a string as UTF-8).
+  enqueue(chunk: u8[] | string): void {
+    this.stream.push(typeof chunk === "string" ? __native.stringToBytes(chunk) : chunk)
+  }
+
+  close(): void {
+    this.stream.end("")
+  }
+
+  error(e: Error): void {
+    this.stream.end(e.message === "" ? "stream error" : e.message)
+  }
+
+  // Bytes queued and not yet read.
+  get desiredSize(): int {
+    return 0 - this.stream.queued()
+  }
+}
+
 export class ReadableStream {
   // a fetch() request's body (0: the chunks below)
   private id: int
+  // made in the program with an underlying source: chunks arrive through its controller
+  readonly pushed: bool
+  private waiter: ((n: int) => void) | undefined
+  private failure: string
+  private onCancel: (() => void) | undefined
+  private queuedBytes: int
   private handle: Promise<int> | undefined
   private signal: AbortSignal | undefined
   private chunks: u8[][]
