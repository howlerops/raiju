+// `/stream` answers with a pushed ReadableStream: three chunks 100 ms apart, then the end.
+// `/endless` never ends (a chunk every 50 ms): when the client leaves, `cancel` runs.
+function streamed(endless: boolean): Response {
+  let n = 0
+  const body = new ReadableStream({
+    start(c) {
+      let tick: () => void = () => {}
+      tick = () => {
+        n += 1
+        c.enqueue(`chunk ${n}\n`)
+        if (endless) {
+          setTimeout(tick, 50)
+        } else if (n < 3) {
+          setTimeout(tick, 100)
+        } else {
+          c.close()
+        }
+      }
+      tick()
+    },
+    cancel() {
+      console.log("stream cancelled")
+    },
+  })
+  return new Response(body, { headers: { "content-type": "text/plain" } })
+}
