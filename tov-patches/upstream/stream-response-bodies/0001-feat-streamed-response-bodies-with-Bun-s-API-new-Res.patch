+// Sends a stream body with chunked transfer encoding, each chunk as it is enqueued. Works in
+// every worker process (the bytes go out on the worker's own connection). A client that went
+// away cancels the stream.
+async function pump(id: int, r: Response, st: ReadableStream) {
+  __native.httpStreamStart(id, r.status, r.wireHeaders())
+  while (true) {
+    let c: ReadableStreamReadResult = { done: true, value: undefined }
+    try {
+      c = await st.pull()
+    } catch (e) {
+      // the head is out: close the connection without the last chunk, so the client
+      // sees the body cut off (as Bun does) rather than a complete answer
+      __native.httpStreamAbort(id)
+      return
+    }
+    const v = c.value
+    if (c.done || v === undefined) {
+      break
+    }
+    if (__native.httpBuffered(id) < 0) {
+      await st.cancel()
+      __native.httpStreamWrite(id, "", true)
+      return
+    }
+    __native.httpStreamWrite(id, __native.bytesToString(v), false)
+  }
+  __native.httpStreamWrite(id, "", true)
+}
