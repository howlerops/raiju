+// A pushed ReadableStream as a Response body: text() and bytes() drain it, and a stream that
+// errors makes the read reject with its error.
+function pushed(parts: string[], fail: string): ReadableStream {
+  return new ReadableStream({
+    start(c) {
+      for (const part of parts) {
+        c.enqueue(part)
+      }
+      if (fail === "") {
+        c.close()
+      } else {
+        c.error(new Error(fail))
+      }
+    },
+  })
+}
+
+async function drain() {
+  const text = try await new Response(pushed(["hello", ", ", "stream\n"], "")).text()
+  console.log(text)
+  const bytes = try await new Response(pushed(["ab", "cd"], "")).bytes()
+  console.log(bytes.length)
+  const empty = try await new Response(pushed([], "")).text()
+  console.log(`empty: "${empty}"`)
+  try {
+    await new Response(pushed(["partial"], "broken")).text()
+    console.log("no error")
+  } catch (e) {
+    console.log("failed:", e.message)
+  }
+}
+
