+/// Reads a chunked response's head and up to `max` chunks, each with the time (since `start`)
+/// its bytes were read. Returns after the last chunk, or once `max` chunks have arrived.
+fn read_chunked(c: &mut TcpStream, start: Instant, max: usize) -> (String, Vec<(Duration, Vec<u8>)>) {
+    let mut buf = Vec::new();
+    let mut chunks = Vec::new();
+    let mut head_end = None;
+    let mut pos = 0;
+    while chunks.len() < max {
+        let mut tmp = [0u8; 4096];
+        let n = c.read(&mut tmp).expect("read");
+        assert!(n > 0, "connection closed early; have {:?}", String::from_utf8_lossy(&buf));
+        buf.extend_from_slice(&tmp[..n]);
+        let at = start.elapsed();
+        if head_end.is_none() {
+            match buf.windows(4).position(|w| w == b"\r\n\r\n") {
+                Some(i) => {
+                    head_end = Some(i);
+                    pos = i + 4;
+                }
+                None => continue,
+            }
+        }
+        // a chunk is complete once its data and the CRLF after it have arrived
+        while let Some(line) = buf[pos..].windows(2).position(|w| w == b"\r\n") {
+            let size = usize::from_str_radix(&String::from_utf8_lossy(&buf[pos..pos + line]), 16).unwrap();
+            let data = pos + line + 2;
+            if buf.len() < data + size + 2 {
+                break;
+            }
+            pos = data + size + 2;
+            if size == 0 {
+                return (String::from_utf8_lossy(&buf[..head_end.unwrap()]).into_owned(), chunks);
+            }
+            chunks.push((at, buf[data..data + size].to_vec()));
+            if chunks.len() == max {
+                break;
+            }
+        }
+    }
+    (String::from_utf8_lossy(&buf[..head_end.unwrap_or(buf.len())]).into_owned(), chunks)
+}
