     this.isLocked = false
     this.started = false
     this.finished = false
+    this.pushed = source !== undefined
+    this.waiter = undefined
+    this.failure = ""
+    this.onCancel = source?.cancel
+    this.queuedBytes = 0
+    const start = source?.start
+    if (start !== undefined) {
+      start(new ReadableStreamDefaultController(this))
+    }
+  }
+
+  // Internal (the controller): a chunk for the reader.
+  push(bytes: u8[]): void {
+    if (this.finished) {
+      return
+    }
+    if (bytes.length > 0) {
+      this.chunks.push(bytes)
+      this.queuedBytes += bytes.length
