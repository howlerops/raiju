--- a/runtime/tls.c
+++ b/runtime/tls.c
@@ -347,7 +347,26 @@ static tv_tls_conf *tv_tls_conf_for(bool verify, const char *ca, size_t ca_len)
 
 /* ---- operations */
 
-static tv_tls *tv_tls_open(int fd, const char *host, const char *key, bool verify, const char *ca, size_t ca_len) {
+/* The ALPN protocols as a ClientHello list: NUL-separated names in, length-prefixed out (RFC 7301).
+ * Returns the list's length, 0 when there are none or one is unusable. */
+static size_t tv_tls_alpn_wire(const char *alpn, size_t alpn_len, uint8_t *wire, size_t cap) {
+    size_t wl = 0;
+    for (size_t i = 0; i < alpn_len;) {
+        size_t j = i;
+        while (j < alpn_len && alpn[j]) j++;
+        size_t l = j - i;
+        if (l == 0 || l > 255 || wl + 1 + l > cap) return 0;
+        wire[wl++] = (uint8_t)l;
+        memcpy(wire + wl, alpn + i, l);
+        wl += l;
+        i = j + 1;
+    }
+    return wl;
+}
+
+/* alpn: the protocols this connection offers (NUL-separated, "" for none); the context's default
+ * (http/1.1) is kept when none are given. */
+static tv_tls *tv_tls_open(int fd, const char *host, const char *key, bool verify, const char *ca, size_t ca_len, const char *alpn, size_t alpn_len) {
     tv_tls_init();
     const char *off = getenv("NODE_TLS_REJECT_UNAUTHORIZED");
     if (off && strcmp(off, "0") == 0) verify = false;
@@ -358,9 +377,15 @@ static tv_tls *tv_tls_open(int fd, const char *host, const char *key, bool verif
     tv_tls *t = calloc(1, sizeof *t);
     t->ssl = ssl;
     t->conf = conf;
-    snprintf(t->key, sizeof t->key, "%s|%d|%p", key, verify, (void *)conf);
+    /* sessions resume only for the same protocols offered (a hash of the list) */
+    unsigned long ah = 0;
+    for (size_t i = 0; i < alpn_len; i++) ah = ah * 131 + (unsigned char)alpn[i];
+    snprintf(t->key, sizeof t->key, "%s|%d|%p|%lx", key, verify, (void *)conf, ah);
     SSL_set_ex_data(ssl, tv_tls_index, t);
     tv_tls_attach(t, fd);
+    uint8_t wire[512];
+    size_t wl = tv_tls_alpn_wire(alpn, alpn_len, wire, sizeof wire);
+    if (wl) SSL_set_alpn_protos(ssl, wire, wl); /* (returns 0 on success, as BoringSSL's does) */
     SSL_set_connect_state(ssl);
     /* the name the certificate must match; SNI unless it's an IP address */
     char name[256];
@@ -526,9 +551,20 @@ static tv_tls *tv_tls_accept(int fd, void *server) {
 
 static bool tv_tls_verified(tv_tls *t) { return SSL_get_verify_result(t->ssl) == X509_V_OK; }
 
+/* The protocol the server picked (SSL_get0_alpn_selected), copied to out: its length, 0 for none. */
+static size_t tv_tls_alpn(tv_tls *t, char *out, size_t n) {
+    const uint8_t *p = NULL;
+    unsigned len = 0;
+    SSL_get0_alpn_selected(t->ssl, &p, &len);
+    if (!p || !len || n == 0) return 0;
+    if (len > n) len = (unsigned)n;
+    memcpy(out, p, len);
+    return len;
+}
+
 static const tv_tls_ops tv_tls_table = {
     tv_tls_open, tv_tls_handshake, tv_tls_read, tv_tls_write, tv_tls_pending, tv_tls_why, tv_tls_close,
-    tv_tls_server, tv_tls_accept, tv_tls_verified,
+    tv_tls_server, tv_tls_accept, tv_tls_verified, tv_tls_alpn,
 };
 
