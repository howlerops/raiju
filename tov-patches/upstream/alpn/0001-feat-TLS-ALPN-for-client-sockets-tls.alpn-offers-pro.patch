+// Socket ALPN (tls.alpn): a client offers protocols, and socket.alpnProtocol reads the one the
+// server picked, or "" when none. Bun.listen has no ALPN, so the server here picks none: the
+// offer must not break the handshake, and the property reads "" with or without an offer.
+// (A TLS server that picks a protocol is not in this change.)
+// a self-signed certificate for localhost (valid until 2126)
+const CERT =
+  "-----BEGIN CERTIFICATE-----\n" +
+  "MIIBmzCCAUGgAwIBAgIUZjNqwvmDx0AFEZs3WzHRZLdKZHcwCgYIKoZIzj0EAwIw\n" +
+  "FDESMBAGA1UEAwwJbG9jYWxob3N0MCAXDTI2MTAxMzE1NTMxMVoYDzIxMjYwOTE5\n" +
+  "MTU1MzExWjAUMRIwEAYDVQQDDAlsb2NhbGhvc3QwWTATBgcqhkjOPQIBBggqhkjO\n" +
+  "PQMBBwNCAAT/DfwMLFYj9PLIyg1PC81HMZU/6n+3fByOfxg4IQkY54dwjhBV/fT4\n" +
+  "DbCdoA4csLhOq+DIgrZkoZ1aqdf6w8D9o28wbTAdBgNVHQ4EFgQU/TlQgBrrt581\n" +
+  "MZU2lYeoX9hLUncwHwYDVR0jBBgwFoAU/TlQgBrrt581MZU2lYeoX9hLUncwDwYD\n" +
+  "VR0TAQH/BAUwAwEB/zAaBgNVHREEEzARgglsb2NhbGhvc3SHBH8AAAEwCgYIKoZI\n" +
+  "zj0EAwIDSAAwRQIgZb9ivhJBJ/12nmZIUhILt1WneywedKruJRYEeEnxyooCIQD1\n" +
+  "umOuIMt9FIL0Q5RZXoJNr/KfZFotEBSI6g0K/Lz7fQ==\n" +
+  "-----END CERTIFICATE-----\n"
+const KEY =
+  "-----BEGIN PRIVATE KEY-----\n" +
+  "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgHqb65r9XoBrDM6Gg\n" +
+  "1cpLM5oKkJPrQWKkMRiflxO9uTyhRANCAAT/DfwMLFYj9PLIyg1PC81HMZU/6n+3\n" +
+  "fByOfxg4IQkY54dwjhBV/fT4DbCdoA4csLhOq+DIgrZkoZ1aqdf6w8D9\n" +
+  "-----END PRIVATE KEY-----\n"
+
+// connects over TLS, offering the protocols (or none), and reads what the server picked
+async function offer(port: int, alpn: string[] | undefined): Promise<string, Error> {
+  const s = try await Bun.connect({
+    hostname: "127.0.0.1",
+    port: port,
+    tls: alpn === undefined ? { rejectUnauthorized: false } : { rejectUnauthorized: false, alpn: alpn },
+    socket: {},
+  })
+  const picked = s.alpnProtocol
+  s.terminate()
+  return picked
+}
+
+const server = Bun.listen({
+  hostname: "127.0.0.1",
+  port: 0,
+  tls: { cert: CERT, key: KEY },
+  socket: {
+    data(socket, data) {
+      socket.write(data)
+    },
+  },
+})
+const offered = try await offer(server.port, ["h2", "http/1.1"])
+console.log(offered === "" ? "alpn: the server picked none" : `alpn: picked ${offered}`)
+const none = try await offer(server.port, undefined)
+console.log(none === "" ? "no alpn offered: none picked" : `FAIL picked ${none}`)
+server.stop()
