diff --git a/runtime/js.c b/runtime/js.c
--- a/runtime/js.c
+++ b/runtime/js.c
@@ -802,6 +802,11 @@
 #include <glib.h>
 
 static GMainContext *tv_js_glib;
+/* JSGlobalContextCreate initializes JSC, not WTF's main thread/run loop. Full GC constructs
+ * MemoryPressureHandler, whose timer needs RunLoop::mainSingleton even in a C API embedder.
+ * This exported WebKitGTK initializer also registers the current thread as WTF's main thread.
+ * It is required, not an optional optimization: fail to link against an incompatible engine. */
+extern void tv_jsc_initialize_main_thread(void) __asm__("_ZN3WTF20initializeMainThreadEv");
 
 static uint64_t tv_js_host_due(uint64_t now_ms) {
     GMainContext *c = tv_js_glib;
@@ -947,6 +952,9 @@
 #if !defined(__APPLE__) && !defined(TV_JSC_OWN)
     tv_js_glib = g_main_context_new();
     g_main_context_push_thread_default(tv_js_glib);
+    /* Bind WTF's main run loop to the context Tov pumps, on the program's actual loop thread
+     * (Linux runs it on a large-stack pthread), before the first VM or GC timer can exist. */
+    tv_jsc_initialize_main_thread();
 #endif
 #ifdef TV_JSC_OWN
     TVInitialize();
