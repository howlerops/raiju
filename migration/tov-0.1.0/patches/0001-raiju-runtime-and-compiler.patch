new file mode 100644
index 0000000..6c6eae0
--- /dev/null
+++ b/tests/async/param_reassigned.tov
@@ -0,0 +1,20 @@
+// An async function that reassigns a string parameter after an await releases the new value twice.
+type R = { text?: string }
+
+async function make(s: string): Promise<R> {
+  return { text: "made-" + s.toUpperCase() + "-" + s.repeat(3) }
+}
+
+async function f(cur: string): Promise<string> {
+  const v = await make(cur)
+  if (v.text !== undefined) cur = v.text
+  return JSON.stringify(cur)
+}
+
+async function main() {
+  for (let i = 0; i < 3; i++) {
+    const p = f("abc" + i)
+    console.log(await p)
+  }
+}
+main()
