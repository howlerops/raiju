@@ -0,0 +1,11 @@
+function* g(s: string, n: int) {
+  for (let i = 0; i < n; i++) {
+    s = s + "-" + s.toUpperCase().slice(0, 2) + i
+    yield s
+  }
+}
+const all: string[] = []
+for (const x of g("ab" + all.length, 3)) all.push(x)
+const it = g("cd" + all.length, 5)
+const first = it.next()
+console.log(all.join(","), first.done)
