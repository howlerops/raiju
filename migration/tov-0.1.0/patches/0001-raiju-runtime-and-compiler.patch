+/* The socket address of host (numeric, or a name looked up now; "" is the wildcard) and port, for
+ * a socket of family 4 or 6. 0, or -errno. */
+static int tv_udp_addr(const char *host, int port, int family, struct sockaddr_storage *ss, socklen_t *len) {
+    memset(ss, 0, sizeof *ss);
+    if (!*host) {
+        if (family == 6) {
+            struct sockaddr_in6 *v6 = (struct sockaddr_in6 *)ss;
+            v6->sin6_family = AF_INET6;
+            v6->sin6_addr = in6addr_any;
+            v6->sin6_port = htons((uint16_t)port);
+            *len = sizeof *v6;
+        } else {
+            struct sockaddr_in *v4 = (struct sockaddr_in *)ss;
+            v4->sin_family = AF_INET;
+            v4->sin_addr.s_addr = htonl(INADDR_ANY);
+            v4->sin_port = htons((uint16_t)port);
+            *len = sizeof *v4;
+        }
+        return 0;
+    }
+    struct addrinfo hints, *res = NULL;
+    memset(&hints, 0, sizeof hints);
+    hints.ai_family = family == 6 ? AF_INET6 : AF_INET;
+    hints.ai_socktype = SOCK_DGRAM;
+    if (getaddrinfo(host, NULL, &hints, &res) != 0 || !res) return -EADDRNOTAVAIL;
+    memcpy(ss, res->ai_addr, res->ai_addrlen);
+    *len = res->ai_addrlen;
+    freeaddrinfo(res);
+    if (ss->ss_family == AF_INET) ((struct sockaddr_in *)ss)->sin_port = htons((uint16_t)port);
+    else ((struct sockaddr_in6 *)ss)->sin6_port = htons((uint16_t)port);
+    return 0;
+}
+
+/* udpOpen(family) -> socket id (family 4 or 6), or -errno. */
+tv_int tv_native_udpOpen(tv_int family) {
+    int f = family == 6 ? AF_INET6 : AF_INET;
+    int fd = socket(f, SOCK_DGRAM, 0);
+    if (fd < 0) return -errno;
+    fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+    fcntl(fd, F_SETFD, FD_CLOEXEC);
+#ifdef SO_NOSIGPIPE
+    int one = 1;
+    setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof one);
+#endif
+    tv_udp *u = tv_alloc(sizeof *u);
+    memset(u, 0, sizeof *u);
+    u->io.ready = tv_udp_ready;
+    u->fd = fd;
+    u->family = family == 6 ? 6 : 4;
+    u->refd = true;
+    if (tv_udp_next >= tv_udp_cap) {
+        tv_int cap = tv_udp_cap ? tv_udp_cap * 2 : 16;
+        tv_udp_tab = tv_realloc(tv_udp_tab, (size_t)cap * sizeof *tv_udp_tab);
+        memset(tv_udp_tab + tv_udp_cap, 0, (size_t)(cap - tv_udp_cap) * sizeof *tv_udp_tab);
+        tv_udp_cap = cap;
+    }
+    u->id = tv_udp_next++;
+    tv_udp_tab[u->id] = u;
+    return u->id;
+}
+
+/* udpBind(id, host, port, reuse) -> 0, or -errno. reuse: SO_REUSEADDR and SO_REUSEPORT (several
+ * sockets may share the port, as multicast listeners do). */
+tv_int tv_native_udpBind(tv_int id, tv_str host, tv_int port, bool reuse) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return -EBADF;
+    struct sockaddr_storage ss;
+    socklen_t len;
+    int r = tv_udp_addr(host.p->data, (int)port, u->family, &ss, &len);
+    if (r) return r;
+    int one = 1;
+    if (reuse) {
+        setsockopt(u->fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof one);
+#ifdef SO_REUSEPORT
+        setsockopt(u->fd, SOL_SOCKET, SO_REUSEPORT, &one, sizeof one);
+#endif
+    }
+    if (bind(u->fd, (struct sockaddr *)&ss, len) != 0) return -errno;
+    return 0;
+}
+
+/* udpEvents(id, events): the Tov closure for the socket's messages, events(kind, bytes, address,
+ * port). */
+void tv_native_udpEvents(tv_int id, tv_fn events) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    if (u->has_cb) tv_env_release(u->cb.env);
+    tv_env_retain(events.env);
+    u->cb = events;
+    u->has_cb = true;
+}
+
+/* udpRecv(id, on): starts or stops reading messages. */
+void tv_native_udpRecv(tv_int id, bool on) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    u->reading = on;
+    tv_udp_update(u);
+}
+
+/* For a host (node.c): messages go to sink(udata, bytes, n, address, port) instead of the closure. */
+void tv_udp_set_sink(tv_int id, tv_udp_sink sink, void *udata) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    u->sink = sink;
+    u->udata = udata;
+}
+
+/* udpSend(id, bytes, host, port) -> the bytes sent, or -errno (no waiting: a datagram the kernel
+ * can't take now fails with EAGAIN). */
+tv_int tv_udp_send_bytes(tv_int id, const uint8_t *data, size_t n, tv_str host, tv_int port) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return -EBADF;
+    struct sockaddr_storage ss;
+    socklen_t len;
+    int r = tv_udp_addr(host.p->data, (int)port, u->family, &ss, &len);
+    if (r) return r;
+    int flags = 0;
+#ifdef MSG_NOSIGNAL
+    flags = MSG_NOSIGNAL;
+#endif
+    ssize_t w;
+    do w = sendto(u->fd, data, n, flags, (struct sockaddr *)&ss, len); while (w < 0 && errno == EINTR);
+    return w < 0 ? -errno : (tv_int)w;
+}
+
+tv_int tv_native_udpSend(tv_int id, tv_arr bytes, tv_str host, tv_int port) {
+    return tv_udp_send_bytes(id, tv_arr_data(bytes), (size_t)bytes.p->len, host, port);
+}
+
+/* udpOption(id, name, value): broadcast (0/1), ttl, multicastTTL, multicastLoopback (0/1),
+ * recvBuffer and sendBuffer (a size; 0 reads it). Returns 0, the buffer size, or -errno. */
+tv_int tv_native_udpOption(tv_int id, tv_str name, tv_int value) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return -EBADF;
+    const char *k = name.p->data;
+    int fd = u->fd, v = (int)value, v6 = u->family == 6;
+    int lvl = v6 ? IPPROTO_IPV6 : IPPROTO_IP;
+    if (strcmp(k, "broadcast") == 0)
+        return setsockopt(fd, SOL_SOCKET, SO_BROADCAST, &v, sizeof v) == 0 ? 0 : -errno;
+    if (strcmp(k, "ttl") == 0)
+        return setsockopt(fd, lvl, v6 ? IPV6_UNICAST_HOPS : IP_TTL, &v, sizeof v) == 0 ? 0 : -errno;
+    if (strcmp(k, "multicastTTL") == 0)
+        return setsockopt(fd, lvl, v6 ? IPV6_MULTICAST_HOPS : IP_MULTICAST_TTL, &v, sizeof v) == 0 ? 0 : -errno;
+    if (strcmp(k, "multicastLoopback") == 0)
+        return setsockopt(fd, lvl, v6 ? IPV6_MULTICAST_LOOP : IP_MULTICAST_LOOP, &v, sizeof v) == 0 ? 0 : -errno;
+    if (strcmp(k, "recvBuffer") == 0 || strcmp(k, "sendBuffer") == 0) {
+        int opt = k[0] == 'r' ? SO_RCVBUF : SO_SNDBUF;
+        if (v > 0 && setsockopt(fd, SOL_SOCKET, opt, &v, sizeof v) != 0) return -errno;
+        socklen_t sl = sizeof v;
+        if (getsockopt(fd, SOL_SOCKET, opt, &v, &sl) != 0) return -errno;
+        return v;
+    }
+    return -EINVAL;
+}
+
+/* udpMembership(id, group, iface, join): joins (or leaves) a multicast group on the interface at
+ * address iface ("" for the default). 0, or -errno. */
+tv_int tv_native_udpMembership(tv_int id, tv_str group, tv_str iface, bool join) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return -EBADF;
+    if (u->family == 6) {
+        struct ipv6_mreq m;
+        memset(&m, 0, sizeof m);
+        if (inet_pton(AF_INET6, group.p->data, &m.ipv6mr_multiaddr) != 1) return -EINVAL;
+        return setsockopt(u->fd, IPPROTO_IPV6, join ? IPV6_JOIN_GROUP : IPV6_LEAVE_GROUP, &m, sizeof m) == 0 ? 0 : -errno;
+    }
+    struct ip_mreq m;
+    memset(&m, 0, sizeof m);
+    if (inet_pton(AF_INET, group.p->data, &m.imr_multiaddr) != 1) return -EINVAL;
+    m.imr_interface.s_addr = htonl(INADDR_ANY);
+    if (iface.p->len && inet_pton(AF_INET, iface.p->data, &m.imr_interface) != 1) return -EINVAL;
+    return setsockopt(u->fd, IPPROTO_IP, join ? IP_ADD_MEMBERSHIP : IP_DROP_MEMBERSHIP, &m, sizeof m) == 0 ? 0 : -errno;
+}
+
+/* udpMulticastIf(id, iface): the interface multicast packets are sent from (an address of this
+ * host; for IPv6, its interface index). 0, or -errno. */
+tv_int tv_native_udpMulticastIf(tv_int id, tv_str iface) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return -EBADF;
+    if (u->family == 6) {
+        unsigned idx = (unsigned)atoi(iface.p->data);
+        return setsockopt(u->fd, IPPROTO_IPV6, IPV6_MULTICAST_IF, &idx, sizeof idx) == 0 ? 0 : -errno;
+    }
+    struct in_addr a;
+    a.s_addr = htonl(INADDR_ANY);
+    if (iface.p->len && inet_pton(AF_INET, iface.p->data, &a) != 1) return -EINVAL;
+    return setsockopt(u->fd, IPPROTO_IP, IP_MULTICAST_IF, &a, sizeof a) == 0 ? 0 : -errno;
+}
+
+/* udpAddress(id, which): 2 the local address, 3 the local port, as text ("" if there is none). */
+tv_str tv_native_udpAddress(tv_int id, tv_int which) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return TV_EMPTY_STR;
+    struct sockaddr_storage ss;
+    socklen_t len = sizeof ss;
+    if (getsockname(u->fd, (struct sockaddr *)&ss, &len) != 0) return TV_EMPTY_STR;
+    char buf[INET6_ADDRSTRLEN + 8];
+    if (ss.ss_family == AF_INET) {
+        struct sockaddr_in *v4 = (struct sockaddr_in *)&ss;
+        if (which == 3) snprintf(buf, sizeof buf, "%d", ntohs(v4->sin_port));
+        else inet_ntop(AF_INET, &v4->sin_addr, buf, sizeof buf);
+    } else if (ss.ss_family == AF_INET6) {
+        struct sockaddr_in6 *v6 = (struct sockaddr_in6 *)&ss;
+        if (which == 3) snprintf(buf, sizeof buf, "%d", ntohs(v6->sin6_port));
+        else inet_ntop(AF_INET6, &v6->sin6_addr, buf, sizeof buf);
+    } else {
+        return TV_EMPTY_STR;
+    }
+    return tv_str_from(buf, strlen(buf));
+}
+
+/* udpRef(id, on): whether an open, reading socket keeps the program running. */
+void tv_native_udpRef(tv_int id, bool on) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    u->refd = on;
+    tv_udp_update(u);
+}
+
+/* udpClose(id): closes now; a datagram not yet delivered is dropped. */
+void tv_native_udpClose(tv_int id) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    u->closed = true;
+    u->reading = false;
+    if (u->fd >= 0) {
+        close(u->fd);   /* (removes it from the loop) */
+        u->fd = -1;
+    }
+    if (u->counted) {
+        tv_io_refs--;
+        u->counted = false;
+    }
+    tv_udp_settle(u);
+}
