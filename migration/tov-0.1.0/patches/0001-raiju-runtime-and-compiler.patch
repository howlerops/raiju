+/// Flags that depend on which C compiler it is, added after `base_flags` to every program and runtime
+/// compile. GCC: no scalar replacement of aggregates. The pass (on from -O1) miscompiles the copies the
+/// generated code makes of large records of tagged unions: where a function returned such a record, the
+/// retain of some of its string fields was dropped while their release stayed, so a field was freed while
+/// the caller still held it (GCC 13.3 at -O2 and -O3; valgrind and a watchpoint on the count show it, and
+/// it is gone with the pass off). Clang has no such pass and refuses the option, so GCC alone gets it.
+pub fn compiler_flags(cc: &str) -> Vec<String> {
+    if is_gcc(cc) { vec!["-fno-tree-sra".into()] } else { Vec::new() }
+}
+
+/// Whether the C compiler is GCC: asked of the compiler itself (`cc` is GCC on most Linux systems and
+/// clang on others).
+pub fn is_gcc(cc: &str) -> bool {
+    if cfg!(target_vendor = "apple") {
+        return false;
+    }
+    match Command::new(cc).arg("--version").output() {
+        Ok(out) => {
+            let text = String::from_utf8_lossy(&out.stdout).to_lowercase();
+            !text.contains("clang") && (text.contains("gcc") || text.contains("free software foundation"))
+        }
+        Err(_) => false,
+    }
+}
+
 /// What every generated C file starts with.
 pub const C_PREFIX: &str = "/* Generated by tov. */\n#define _GNU_SOURCE 1\n";
 
