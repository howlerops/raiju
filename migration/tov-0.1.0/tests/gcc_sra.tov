// Patch 0027: GCC's scalar replacement of aggregates dropped retains of a returned record's string fields
// (Raiju's parseQuery). The same shape: a record of fifteen optional fields filled from a URLSearchParams
// and returned by value; every field must still read correctly after the params are dropped and the heap
// is reused. Build with CC=gcc and run under valgrind for the full check (run-s3.sh does).
type Scope = { all: bool, teams: string[] }
type Q = {
  provider?: string,
  model?: string,
  status?: "success" | "error",
  virtual_key?: string,
  team_id?: string,
  customer_id?: string,
  business_unit_id?: string,
  project_id?: string,
  scope?: Scope,
  since?: f64,
  until?: f64,
  text?: string,
  limit?: int,
  offset?: int,
  kind?: string,
}

function parseQuery(params: URLSearchParams): Q {
  const q: Q = {}
  const provider = params.get("provider")
  if (provider !== undefined && provider !== "") q.provider = provider
  const model = params.get("model")
  if (model !== undefined && model !== "") q.model = model
  const status = params.get("status")
  if (status === "success") q.status = "success"
  if (status === "error") q.status = "error"
  const vk = params.get("virtual_key")
  if (vk !== undefined && vk !== "") q.virtual_key = vk
  const since = params.get("since")
  if (since !== undefined) q.since = parseFloat(since)
  const until = params.get("until")
  if (until !== undefined) q.until = parseFloat(until)
  const text = params.get("text")
  if (text !== undefined && text !== "") q.text = text
  const limit = params.get("limit")
  if (limit !== undefined) q.limit = Math.trunc(parseInt(limit) || 0)
  const offset = params.get("offset")
  if (offset !== undefined) q.offset = Math.trunc(parseInt(offset) || 0)
  return q
}

function one(i: int): Q {
  return parseQuery(new URLSearchParams(`provider=openai-${i}&status=error&limit=20&offset=5&virtual_key=vk-${i}-0123456789abcdef&since=100&until=900&text=gpt-${i}`))
}

function main(): int {
  let bad = 0
  const kept: Q[] = []
  for (let i = 0; i < 200; i++) {
    const q = one(i)
    // (allocations that reuse a block freed too early)
    const junk: string[] = []
    for (let j = 0; j < 8; j++) junk.push(`junkjunkjunk-${i}-${j}-0123456789abcdef`)
    if (q.virtual_key !== `vk-${i}-0123456789abcdef` || q.provider !== `openai-${i}` || q.text !== `gpt-${i}` || q.status !== "error" || q.limit !== 20 || q.offset !== 5 || q.model !== undefined || junk.length !== 8) bad += 1
    if (i % 50 === 0) kept.push(q)
  }
  for (let k = 0; k < kept.length; k++) {
    if (kept[k]!.virtual_key !== `vk-${k * 50}-0123456789abcdef`) bad += 1
  }
  console.log(bad === 0 ? "ok a returned record of optional fields keeps its strings" : `FAIL ${bad} records lost a field`)
  return 0
}
