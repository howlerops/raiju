// Replaces src/text.tov when the build moves to Tov v0.1.0, where string positions are UTF-16 units.
//
// The length of a string in the unit its positions are counted in: what `indexOf` returns and what
// `slice` takes. Positions are bytes on the pinned compiler and UTF-16 units on Tov v0.1.0, so code
// that walks or cuts a string measures it with strLen, and keeps `byteLength` for sizes in bytes
// (limits, Content-Length, buffers).

export function strLen(s: string): int {
  return s.length
}

// Where each byte offset of s's UTF-8 lies in s, for code that works on the bytes (a `u8[]` scanner) and
// then cuts the string: at[i] is the position of the character that holds byte i, and at[s.byteLength] is
// strLen(s). undefined when every byte offset is already its position (always on the pinned compiler; an
// ASCII text on Tov v0.1.0), so the caller uses its offsets as they are and nothing is built.
export function bytePositions(s: string): int[] | undefined {
  if (strLen(s) === s.byteLength) return undefined
  const at: int[] = []
  let p = 0
  for (const c of s.chars()) {
    for (let k = 0; k < c.byteLength; k++) at.push(p)
    p += strLen(c)
  }
  at.push(p)
  return at
}

// The position in s of byte offset i, with at = bytePositions(s).
export function posOfByte(at: int[] | undefined, i: int): int {
  if (at === undefined) return i
  return at[i < at.length ? i : at.length - 1]!
}

// s cut to at most max bytes of UTF-8, on a character boundary: a cap in bytes is not a position to
// slice at (and a slice at a byte offset could split a character on the pinned compiler).
export function clipBytes(s: string, max: int): string {
  if (s.byteLength <= max) return s
  const bytes = new TextEncoder().encode(s)
  let end = max > 0 ? max : 0
  while (end > 0 && (int(bytes[end]!) & 0xc0) === 0x80) end -= 1
  try {
    return new TextDecoder().decode(bytes.slice(0, end))
  } catch (err) {
    return ""
  }
}

// Whether s is ASCII only. A parser of a fixed layout (a timestamp, a hex id, a file name) asks this before
// it cuts at fixed positions: a cut inside a character traps on the pinned compiler.
export function isAscii(s: string): bool {
  return s.byteLength === s.length
}

test("strLen is the end position of the string", () => {
  expect(strLen("")).toBe(0)
  expect(strLen("abc")).toBe(3)
  const s = "é日🙂x"
  expect(s.slice(strLen(s) - 1)).toBe("x")
  expect(s.slice(0, strLen(s))).toBe(s)
  expect(s.indexOf("x")).toBe(strLen(s) - 1)
  expect(s.slice(strLen(s))).toBe("")
})

test("bytePositions turns a byte offset into a position of the string", () => {
  expect(bytePositions("plain ascii")).toBe(undefined)
  expect(posOfByte(undefined, 7)).toBe(7)
  const s = "aé日🙂x"
  const b = new TextEncoder().encode(s)
  const at = bytePositions(s)
  // every character start: the string cut there is the text of the bytes before it
  let i = 0
  for (const c of s.chars()) {
    expect(s.slice(0, posOfByte(at, i)).byteLength).toBe(i)
    expect(s.slice(posOfByte(at, i)).startsWith(c)).toBe(true)
    i += c.byteLength
  }
  expect(i).toBe(b.length)
  expect(posOfByte(at, b.length)).toBe(strLen(s))
  expect(s.slice(posOfByte(at, 10), posOfByte(at, 11))).toBe("x")
  // a byte inside a character is at the character's start
  if (at !== undefined) expect(at[8]!).toBe(at[6]!)
})

test("clipBytes cuts to a byte cap without splitting a character", () => {
  expect(clipBytes("abc", 3)).toBe("abc")
  expect(clipBytes("abcd", 3)).toBe("abc")
  const s = "aé日🙂x"
  const want = ["", "a", "a", "aé", "aé", "aé", "aé日", "aé日", "aé日", "aé日", "aé日🙂", "aé日🙂x", "aé日🙂x"]
  for (let n = 0; n < want.length; n++) expect(clipBytes(s, n)).toBe(want[n]!)
  expect(clipBytes(s, -1)).toBe("")
})

test("isAscii is true for ASCII text only", () => {
  expect(isAscii("")).toBe(true)
  expect(isAscii("plain ~ text\n")).toBe(true)
  expect(isAscii("é")).toBe(false)
  expect(isAscii("a日")).toBe(false)
  expect(isAscii("ab🙂")).toBe(false)
})

// How many string positions the UTF-8 bytes b[from, to) take in the string they encode, for from and to on
// character boundaries. This is how an offset found in a string's bytes (`new TextEncoder().encode(s)`)
// becomes a position in that string: posSpan(b, 0, offset). Walk forward from the last offset converted
// rather than from 0 each time.
// On Tov v0.1.0 positions are UTF-16 units: one for a character of up to three bytes, two for one of four.
export function posSpan(b: u8[], from: int, to: int): int {
  const end = to > b.length ? b.length : to
  let n = 0
  for (let i = from; i < end; i++) {
    const c = int(b[i]!)
    if (c < 128 || c >= 192) n += c >= 240 ? 2 : 1
  }
  return n
}

// s with every non-ASCII character replaced by U+007F, once per position the character takes, so that the
// result has a character at every position of s and the same positions as s. A scanner that walks one
// position at a time (`a.slice(i, i + 1)`, `i++`) walks this instead of s, where such a step would stop
// inside a character: it reads the ASCII it is looking for from the result and cuts its pieces from s, at
// the positions of ASCII characters it found.
export function asciiShape(s: string): string {
  const cs = s.chars()
  if (cs.length === s.byteLength) return s
  let out = ""
  let from = 0
  let pos = 0
  for (const c of cs) {
    const w = strLen(c)
    if (c.byteLength > 1) {
      out += s.slice(from, pos) + "\u{7F}".repeat(w)
      from = pos + w
    }
    pos += w
  }
  return out + s.slice(from)
}

// The longest prefix of s, in whole characters, that is at most max bytes of UTF-8: how a text is cut to a
// limit in bytes. (A slice at a byte count is not that: it is not a position on every compiler, and it can
// fall inside a character.)
export function bytePrefix(s: string, max: int): string {
  if (s.byteLength <= max) return s
  let bytes = 0
  let pos = 0
  for (const c of s.chars()) {
    if (bytes + c.byteLength > max) break
    bytes += c.byteLength
    pos += strLen(c)
  }
  return s.slice(0, pos)
}


test("posSpan turns offsets in a string's bytes into positions in the string", () => {
  const s = "aéb日c🙂dé日🙂"
  const b = new TextEncoder().encode(s)
  expect(posSpan(b, 0, 0)).toBe(0)
  expect(posSpan(b, 0, b.length)).toBe(strLen(s))
  expect(posSpan(b, 0, b.length + 5)).toBe(strLen(s))
  // every character boundary: the bytes before it are the prefix it cuts
  let at = 0
  let pos = 0
  let pre = ""
  for (const ch of s.chars()) {
    expect(s.slice(0, posSpan(b, 0, at))).toBe(pre)
    expect(s.slice(posSpan(b, 0, at)).startsWith(ch)).toBe(true)
    const next = at + ch.byteLength
    pos += posSpan(b, at, next)
    expect(posSpan(b, at, next)).toBe(strLen(ch))
    expect(pos).toBe(posSpan(b, 0, next))
    at = next
    pre += ch
  }
  expect(at).toBe(b.length)
  const plain = new TextEncoder().encode("plain ascii")
  expect(posSpan(plain, 2, 9)).toBe(7)
})

test("asciiShape keeps every position and every ASCII character", () => {
  expect(asciiShape("")).toBe("")
  expect(asciiShape("plain: [a, b] # c")).toBe("plain: [a, b] # c")
  for (const s of ["é", "aé", "éa", "k: é日🙂 # 🙂", "🙂🙂[日,é]🙂", "x\u{7F}é"]) {
    const a = asciiShape(s)
    expect(strLen(a)).toBe(strLen(s))
    expect(a.byteLength).toBe(strLen(a))
    // each position holds one character, and an ASCII character of s is where it was
    let pos = 0
    for (const c of s.chars()) {
      if (c.byteLength === 1) expect(a.slice(pos, pos + 1)).toBe(c)
      else expect(a.slice(pos, pos + strLen(c))).toBe("\u{7F}".repeat(strLen(c)))
      expect(s.slice(pos).startsWith(c)).toBe(true)
      pos += strLen(c)
    }
    expect(pos).toBe(strLen(s))
  }
  const s = "kéy🙂: v日 # c"
  const a = asciiShape(s)
  expect(s.slice(0, a.indexOf(":"))).toBe("kéy🙂")
  expect(s.slice(a.indexOf(":") + 2, a.indexOf(" #"))).toBe("v日")
})

test("bytePrefix cuts to a byte limit between characters", () => {
  expect(bytePrefix("", 4)).toBe("")
  expect(bytePrefix("abcdef", 4)).toBe("abcd")
  expect(bytePrefix("abcd", 4)).toBe("abcd")
  const s = "aé日🙂b"
  const want = ["", "a", "a", "aé", "aé", "aé", "aé日", "aé日", "aé日", "aé日", "aé日🙂", s, s]
  for (let max = 0; max < want.length; max++) {
    expect(bytePrefix(s, max)).toBe(want[max]!)
    expect(bytePrefix(s, max).byteLength <= max).toBe(true)
  }
  expect(bytePrefix("🙂🙂", 7)).toBe("🙂")
  expect(bytePrefix(s, -1)).toBe("")
})
