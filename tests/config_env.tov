// Focused native regression: env.NAME config references work without /proc.
// Build once, then run with a supplied name/value and its _EMPTY companion set.
// The assertions never print environment values (including on failure).
import { getEnv, resolveEnv, parseConfig } from "../src/config"

function main(): int {
  const name = process.argv[2] ?? ""
  const expected = process.argv[3] ?? ""
  if (name === "" || expected === "") return 2
  if (getEnv(name) !== expected) { console.log("FAIL inherited variable"); return 1 }
  if (getEnv(name + "_EMPTY") !== "") { console.log("FAIL empty variable"); return 1 }
  if (getEnv(name + "_UNSET") !== undefined) { console.log("FAIL missing variable"); return 1 }
  if (getEnv(name + "\u0000suffix") !== undefined) { console.log("FAIL embedded NUL variable"); return 1 }
  if (resolveEnv("env." + name + "\u0000suffix") !== "") { console.log("FAIL embedded NUL reference"); return 1 }
  if (resolveEnv("env." + name) !== expected) { console.log("FAIL dynamic reference"); return 1 }
  if (resolveEnv("env." + name + "_UNSET") !== "") { console.log("FAIL missing reference"); return 1 }
  if (resolveEnv("literal") !== "literal") { console.log("FAIL literal value"); return 1 }
  try {
    const cfg = try parseConfig(`{"providers":{"openai":{"keys":[{"value":"env.${name}"},{"value":"env.${name}_EMPTY"},{"value":"env.${name}_UNSET"}]}}}`)
    const keys = cfg.providers!.get("openai")!.keys!
    if (keys[0]!.value !== expected || keys[1]!.value !== "" || keys[2]!.value !== "") {
      console.log("FAIL provider config references")
      return 1
    }
    const invalid = try parseConfig(`{"providers":{"openai":{"keys":[{"value":"env.${name}\\u0000suffix"}]}}}`)
    if (invalid.providers!.get("openai")!.keys![0]!.value !== "") {
      console.log("FAIL embedded NUL provider reference")
      return 1
    }
  } catch (e) {
    console.log("FAIL provider config parse")
    return 1
  }
  console.log("ok dynamic env references: inherited, empty, unset and provider config")
  return 0
}
