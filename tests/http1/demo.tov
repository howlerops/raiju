// Streams three SSE events, 50 ms apart, on port 18310. Each event should reach
// `curl -N http://127.0.0.1:18310/` as it is written, not all at the end.
import { listen } from "../../src/http1"

function main(): int {
  const headers: Map<string, string> = new Map()
  headers.set("content-type", "text/event-stream")
  headers.set("cache-control", "no-cache")
  listen({ hostname: "127.0.0.1", port: 18310 }, (req, res) => {
    res.writeHead(200, headers)
    res.write("data: one\n\n")
    setTimeout(() => res.write("data: two\n\n"), 50)
    setTimeout(() => {
      res.write("data: three\n\n")
      res.end()
    }, 100)
  })
  console.log("listening on 127.0.0.1:18310")
  return 0
}
