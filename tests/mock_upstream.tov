        record(req, "/v1beta/cachedContents", body)
        return Response.json({ name: "cachedContents/c-1", model: "models/gemini-2.5-flash", displayName: "cache" })
      },
      GET: (req) => {
        record(req, "/v1beta/cachedContents", "")
        return new Response(`{"cachedContents":[]}`, { headers: { "content-type": "application/json" } })
