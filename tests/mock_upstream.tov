        return Response.json({ text: "transcribed by " + model })
      },
    },
    "/v1/audio/speech": {
      POST: async (req) => {
        const body = await req.text()
        record(req, "/v1/audio/speech", body)
        // real binary (not valid UTF-8), so a text round trip would corrupt it
        const audio: u8[] = [u8(0x49), u8(0x44), u8(0x33), u8(0xff), u8(0xfb), u8(0x90), u8(0x00), u8(0x80), u8(0xc3), u8(0x28)]
        return new Response(new Blob([audio], { type: "audio/mpeg" }), { headers: { "content-type": "audio/mpeg" } })
      },
    },
