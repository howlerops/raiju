    "/v1beta/models/:model/operations/:op": {
      GET: (req) => {
        record(req, "/v1beta/models/" + req.params.model + "/operations/" + req.params.op, "")
        return Response.json({ name: "models/" + req.params.model + "/operations/" + req.params.op, done: false })
      },
