        const body = await req.text()
        record(req, "/or/alpha/decisions", body)
        if ((req.headers.get("authorization") ?? "") !== "Bearer or-key") return Response.json({ error: { message: "invalid api key", code: 401 } }, { status: 401 })
        const orAnswers = try systemoneAnswers(body)
        return new Response(`{"id":"gen-or-1","model":"openai/gpt-4o-mini","answers":{${orAnswers}},"usage":{"input_tokens":12,"output_tokens":3,"cost":0.00002}}`, { headers: { "content-type": "application/json" } })
      },
    },
    // L163: the native decision routes of OpenAI (/oa163, key sk-oa163), Azure's Foundry systemone (/az163, api-key
    // az-key163), Cloudflare's Clef (/cf163, account acc163, in Workers AI's envelope), Perplexity (/pplx163, with
    // its x-request-id) and Ollama (/ol163)
    "/oa163/v1/decisions": {
