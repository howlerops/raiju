      },
    },
    // Anthropic's legacy text completion (L163): the completion names the model; a bad key is refused
    "/v1/complete": {
      POST: async (req) => {
        const body = await req.text()
        record(req, "/v1/complete", body)
        const m = try JSON.parse(body) as Model
        const f = failure(m.model ?? "", req.headers.get("x-api-key") ?? "")
        if (f !== undefined) return f
        return Response.json({ id: "compl_e2e", type: "completion", completion: "Hi from legacy " + (m.model ?? ""), stop_reason: "stop_sequence", model: m.model ?? "", usage: { input_tokens: 6, output_tokens: 4 } })
      },
    },
    // Bedrock's control plane listings (SigV4 GET): foundation models and inference profiles
    "/foundation-models": {
      GET: (req) => {
        record(req, "/foundation-models", "")
        return Response.json({ modelSummaries: [{ modelId: "anthropic.claude-3-haiku-20240307-v1:0", modelName: "Claude 3 Haiku", providerName: "Anthropic" }, { modelId: "amazon.titan-embed-text-v2:0", modelName: "Titan" }] })
      },
    },
    "/inference-profiles": {
