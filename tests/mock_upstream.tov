      },
    },
    // Bedrock InvokeModel (Titan embeddings)
    "/model/:modelId/invoke": {
      POST: async (req) => {
        const body = await req.text()
        record(req, "/model/" + req.params.modelId + "/invoke", body)
        // image models (Titan and Nova Canvas: imageGenerationConfig; Stability: prompt) answer with one image
        if (body.includes("imageGenerationConfig") || body.includes(`"prompt"`)) return new Response(`{"images":["iVBORw0KGgo="]}`, { headers: { "content-type": "application/json" } })
        return new Response(`{"embedding":[0.5,0.25],"inputTextTokenCount":3}`, { headers: { "content-type": "application/json" } })
      },
    },
    // guardrail providers, one endpoint each (not recorded). Presidio's analyzer: an email
    // gets one EMAIL_ADDRESS entity. The request body starts with {"text":" (9 bytes).
    "/guard/presidio/analyze": {
      POST: async (req) => {
        const body = await req.text()
        const at = body.indexOf("a@b.co")
        if (at < 0) return new Response("[]", { headers: { "content-type": "application/json" } })
        return new Response(`[{"entity_type":"EMAIL_ADDRESS","start":${at - 9},"end":${at - 9 + 6},"score":0.95}]`, { headers: { "content-type": "application/json" } })
      },
    },
    // Azure AI Language PII: a US SSN is an entity; the service returns the redacted text.
    "/guard/azure/language/:action": {
      POST: async (req) => {
        const body = await req.text()
        if (!body.includes("123-45-6789")) return new Response(`{"kind":"PiiEntityRecognitionResults","results":{"documents":[{"id":"1","redactedText":"","entities":[]}],"errors":[]}}`, { headers: { "content-type": "application/json" } })
        return new Response(`{"kind":"PiiEntityRecognitionResults","results":{"documents":[{"id":"1","redactedText":"ssn ***********","entities":[{"text":"123-45-6789","category":"USSocialSecurityNumber","offset":4,"length":11,"confidenceScore":0.9}]}],"errors":[]}}`, { headers: { "content-type": "application/json" } })
      },
    },
    // Model Armor: the token must be the one configured; a prompt injection matches the template
    "/guard/armor/v1/projects/:project/locations/:location/templates/:tmpl": {
      POST: async (req) => {
        if (req.headers.get("authorization") !== "Bearer tok-armor") return new Response(`{"error":"unauthenticated"}`, { status: 401, headers: { "content-type": "application/json" } })
        const body = await req.text()
        const hit = req.params.tmpl.endsWith(":sanitizeUserPrompt") && body.includes("ignore previous instructions")
        return Response.json({ sanitizationResult: { filterMatchState: hit ? "MATCH_FOUND" : "NO_MATCH_FOUND" } })
      },
    },
    // CrowdStrike AIDR guard_chat_completions: the collector token is checked; "aidr-block" is blocked
    "/guard/aidr/v1/guard_chat_completions": {
      POST: async (req) => {
        if (req.headers.get("authorization") !== "Bearer tk-aidr") return new Response(`{"error":"unauthenticated"}`, { status: 401, headers: { "content-type": "application/json" } })
        const body = await req.text()
        if (body.includes("aidr-block")) return Response.json({ result: { blocked: true, display_message: "Malicious prompt detected" } })
        return Response.json({ result: { blocked: false, transformed: false } })
      },
    },
    // an external guardrail (webhook kind): blocks "forbidden", redacts "secret-word"
    "/guard-hook": {
      POST: async (req) => {
        // not recorded: it sees every chat, and tests read the last upstream request
        const body = await req.text()
        if (body.includes("forbidden")) return new Response(`{"allowed":false,"reason":"forbidden topic"}`, { headers: { "content-type": "application/json" } })
        if (body.includes("secret-word")) return new Response(`{"allowed":true,"reason":"redacted","text":"my [REDACTED]"}`, { headers: { "content-type": "application/json" } })
        return new Response(`{"allowed":true}`, { headers: { "content-type": "application/json" } })
      },
    },
    // log exporter receivers: a generic HTTP endpoint and Elasticsearch's bulk API
    "/export-hook": {
      POST: async (req) => {
        record(req, "/export-hook", await req.text())
        return Response.json({ ok: true })
      },
    },
    "/_bulk": {
      POST: async (req) => {
        record(req, "/_bulk", await req.text())
        return new Response(`{"errors":false,"items":[]}`, { headers: { "content-type": "application/json" } })
      },
    },
    // an alert webhook receiver
    "/alert-hook": {
      POST: async (req) => {
        record(req, "/alert-hook", await req.text())
        return Response.json({ ok: true })
      },
    },
    // webhook receivers (webhooks.tov): one that answers 200, one that always fails with 503
    "/webhook-receiver": {
      POST: async (req) => {
        const body = await req.text()
        hooks.push({ path: "/webhook-receiver", id: req.headers.get("webhook-id") ?? "", timestamp: req.headers.get("webhook-timestamp") ?? "", signature: req.headers.get("webhook-signature") ?? "", event: req.headers.get("x-bifrost-event") ?? "", body: body })
        return Response.json({ ok: true })
      },
    },
    "/webhook-fail": {
      POST: async (req) => {
        const body = await req.text()
        hooks.push({ path: "/webhook-fail", id: req.headers.get("webhook-id") ?? "", timestamp: req.headers.get("webhook-timestamp") ?? "", signature: req.headers.get("webhook-signature") ?? "", event: req.headers.get("x-bifrost-event") ?? "", body: body })
        return Response.json({ error: { message: "receiver is down" } }, { status: 503 })
      },
    },
    // a receiver that refuses the payload for good: a 400 is not retried
    "/webhook-400": {
      POST: async (req) => {
        const body = await req.text()
        hooks.push({ path: "/webhook-400", id: req.headers.get("webhook-id") ?? "", timestamp: req.headers.get("webhook-timestamp") ?? "", signature: req.headers.get("webhook-signature") ?? "", event: req.headers.get("x-bifrost-event") ?? "", body: body })
        return Response.json({ error: { message: "payload refused" } }, { status: 400 })
      },
    },
    "/_hooks": () => Response.json(hooks),
    // HashiCorp Vault KV v2
    "/v1/secret/data/raiju": {
      GET: (req) => {
        record(req, "/v1/secret/data/raiju", req.headers.get("x-vault-token") ?? "")
        return Response.json({ data: { data: { key: "sk-from-vault" }, metadata: { version: 1 } } })
      },
    },
    "/_seen": () => Response.json(seen),
  },
  async fetch(req, server) {
    // the compat tests' model parameters datasheet
    const cu = URL.parse(req.url)
    if (cu !== undefined && cu.pathname === "/cdatasheet/model-parameters") return new Response(COMPAT_ROWS, { headers: { "content-type": "application/json" } })
    // S3-compatible object storage, for log exports
    if (req.method === "PUT") {
      const u = URL.parse(req.url)
      // Parquet is binary: its bytes are kept as hex, so the test can read them back
      const raw = await req.bytes()
      let put = ""
      if ((req.headers.get("content-type") ?? "") === "application/vnd.apache.parquet") {
        const hx = "0123456789abcdef"
        for (let i = 0; i < raw.length; i++) {
          const v = int(raw[i]!)
          put += hx.slice(v >> 4, (v >> 4) + 1) + hx.slice(v & 15, (v & 15) + 1)
        }
      } else {
        put = try try new TextDecoder().decode(raw)
      }
      record(req, u === undefined ? req.url : u.pathname, put)
      if (u !== undefined) putObject(u.pathname.slice(1), put)
      return new Response("", { status: 200 })
    }
    // the Responses lifecycle and realtime REST: answer with what was asked
    const lu = URL.parse(req.url)
    const lp = lu === undefined ? "" : lu.pathname
    // Azure-style deployments: the call is recorded as sent, then answered by the /v1 route of its operation
    if (lp.startsWith("/openai/deployments/") && lu !== undefined) {
      const rest = lp.slice(20)
      record(req, lp + lu.search, "")
      const hs: Record<string, string> = new Map()
      req.headers.forEach((v, k) => {
        // hop-by-hop headers are the connection's own, not the request's
        if (k !== "host" && k !== "connection" && k !== "content-length" && k !== "accept-encoding" && k !== "transfer-encoding") hs.set(k, v)
      })
      const bytes = await req.bytes()
      const up = try await fetch(lu.origin + "/v1" + rest.slice(rest.indexOf("/")) + lu.search, { method: req.method, headers: hs, body: bytes })
      const out = try await up.bytes()
      const oh: Record<string, string> = new Map()
      oh.set("content-type", up.headers.get("content-type") ?? "application/json")
      return new Response(out, { status: up.status, headers: oh })
    }
    if (lp.startsWith("/v1/responses/") || lp === "/v1/realtime/client_secrets" || lp === "/v1/realtime/sessions" || lp === "/v1/realtime/calls") {
      const body = req.method === "GET" || req.method === "DELETE" ? "" : await req.text()
      record(req, lp, req.method + " " + body)
      if (lp === "/v1/realtime/calls") return new Response("v=0\r\no=- answer\r\n", { status: 201, headers: { "content-type": "application/sdp" } })
      return Response.json({ object: "ok", method: req.method, path: lp })
    }
    // realtime: echo each event back, tagged with the credentials and URL the gateway used
    if (req.url.includes("/v1/realtime")) {
      const tag = (req.headers.get("authorization") ?? "") + " " + req.url
      if (server.upgrade(req, { data: tag })) return
    }
    // passthrough echo: records the request (as the other routes do) and answers with its method,
    // path, query and body; /pt/sse answers an event stream instead
    if (lp.startsWith("/pt/") || lp.startsWith("/knowledgebases/")) {
      const body = req.method === "GET" || req.method === "HEAD" ? "" : await req.text()
      record(req, lp + (lu === undefined ? "" : lu.search), body)
      if (lp === "/pt/sse") return new Response("data: one\n\ndata: two\n\n", { headers: { "content-type": "text/event-stream", "x-upstream-tag": "sse" } })
      if (lp === "/pt/gzip") return new Response("plain", { headers: { "content-type": "text/plain", "content-encoding": "identity", "x-bf-internal": "no" } })
      const hv: string[] = []
      req.headers.forEach((v, k) => {
        hv.push(k + "=" + v)
      })
      return Response.json({ method: req.method, path: lp, query: lu === undefined ? "" : lu.search, body: body, headers: hv })
    }
    // Cloud Storage's upload, and its JSON API for objects (the name's slashes come as %2F)
    if (lp.startsWith("/upload/storage/v1/b/") && lu !== undefined && req.method === "POST") {
      const bucket = lp.split("/")[5] ?? ""
      const name = new URLSearchParams(lu.search).get("name") ?? ""
      const body = await req.text()
      record(req, lp + lu.search, body)
      putObject(bucket + "/" + name, body)
      return jsonBody(`{"name":"${name}","bucket":"${bucket}","size":"${body.byteLength}","timeCreated":"${JOB_TIME}"}`, 200)
    }
    if (lp.startsWith("/storage/v1/b/") && lu !== undefined) {
      const parts = lp.split("/")
      const bucket = parts[4] ?? ""
      record(req, lp + lu.search, "")
      if (parts.length === 6 && req.method === "GET") return new Response(gcsList(bucket, new URLSearchParams(lu.search).get("prefix") ?? ""), { headers: { "content-type": "application/json" } })
      const name = parts.slice(6).join("/").replaceAll("%2F", "/")
      const k = bucket + "/" + name
      if (req.method === "DELETE") {
        cloudObjects.delete(k)
        return new Response(undefined, { status: 204 })
      }
      const obj = cloudObjects.get(k)
      if (obj === undefined) return jsonBody(`{"error":{"code":404,"message":"No such object"}}`, 404)
      if (new URLSearchParams(lu.search).get("alt") === "media") return new Response(obj, { headers: { "content-type": "application/octet-stream" } })
      return jsonBody(`{"name":"${name}","bucket":"${bucket}","size":"${obj.byteLength}","timeCreated":"${JOB_TIME}"}`, 200)
    }
    // Vertex's Batch Prediction jobs
    if (lp.includes("/batchPredictionJobs") && lu !== undefined) {
      const tail = lp.slice(lp.indexOf("/batchPredictionJobs") + 20)
      const body = req.method === "GET" ? "" : await req.text()
      record(req, lp, body)
      if (req.method === "POST" && tail === "") return try vertexCreate(body)
      if (req.method === "GET" && tail === "") {
        const jobs: string[] = []
        for (const id of vertexIds) jobs.push(vertexJobs.get(id) ?? "")
        return jsonBody(`{"batchPredictionJobs":[${jobs.join(",")}]}`, 200)
      }
      if (req.method === "POST" && tail.endsWith(":cancel")) {
        const id = tail.slice(1, tail.byteLength - 7)
        vertexJobs.set(id, (vertexJobs.get(id) ?? "").replace("JOB_STATE_SUCCEEDED", "JOB_STATE_CANCELLED"))
        return jsonBody("{}", 200)
      }
      const got = vertexJobs.get(tail.slice(1))
      if (got === undefined) return jsonBody(`{"error":{"code":404,"message":"no such job"}}`, 404)
      return jsonBody(got, 200)
    }
    // Bedrock's model invocation jobs
    if (lp === "/model-invocation-job" && req.method === "POST") {
      const body = await req.text()
      record(req, lp, body)
      return try bedrockCreate(body)
    }
    if (lp === "/model-invocation-jobs" && req.method === "GET") {
      record(req, lp, "")
      const jobs: string[] = []
      for (const id of bedrockIds) jobs.push(bedrockJobs.get(id) ?? "")
      return jsonBody(`{"invocationJobSummaries":[${jobs.join(",")}]}`, 200)
    }
    if (lp.startsWith("/model-invocation-job/")) {
      const rest = lp.slice(22)
      const body = req.method === "POST" ? await req.text() : ""
      record(req, lp, body)
      if (rest.endsWith("/stop")) {
        const id = rest.slice(0, rest.byteLength - 5)
        bedrockJobs.set(id, (bedrockJobs.get(id) ?? "").replace(`"status":"Completed"`, `"status":"Stopped"`))
        return jsonBody("{}", 200)
      }
      const got = bedrockJobs.get(rest)
      if (got === undefined) return jsonBody(`{"message":"not found"}`, 404)
      return jsonBody(got, 200)
    }
    // the log sinks, with base_url pointing here: BigQuery insertAll, Pub/Sub publish, Maxim's log endpoint
    if (req.method === "POST" && (lp.endsWith("/insertAll") || lp.endsWith(":publish") || lp === "/api/sdk/v3/log")) {
      const sb = await req.text()
      record(req, lp + (lu === undefined ? "" : lu.search), sb)
      if (lp.endsWith(":publish")) return Response.json({ messageIds: ["1"] })
      if (lp === "/api/sdk/v3/log") return Response.json({ success: true })
      return Response.json({ kind: "bigquery#tableDataInsertAllResponse" })
    }
    // the parquet export bucket of the sink gateway: listings, gets and deletes (the retention sweep)
    if (lp.startsWith("/logs-pq/") && lu !== undefined) {
      const bucket = "logs-pq"
      record(req, lp + lu.search, "")
      if (req.method === "GET" && lu.search.includes("list-type")) {
        return new Response(s3List(bucket, new URLSearchParams(lu.search).get("prefix") ?? ""), { headers: { "content-type": "application/xml" } })
      }
      const k = bucket + "/" + lp.slice(bucket.byteLength + 2)
      if (req.method === "DELETE") {
        cloudObjects.delete(k)
        return new Response(undefined, { status: 204 })
      }
      const obj = cloudObjects.get(k)
      if (obj === undefined) return new Response("NoSuchKey", { status: 404 })
      return new Response(obj, { headers: { "content-type": "application/octet-stream" } })
    }
    // S3 objects of the test bucket, path style as the endpoint is set: listings, gets and deletes
    if (lp === "/e2e-files" || lp.startsWith("/e2e-files/")) {
      const bucket = "e2e-files"
      record(req, lp + (lu === undefined ? "" : lu.search), "")
      if (req.method === "GET" && lu !== undefined && lu.search.includes("list-type")) {
        return new Response(s3List(bucket, new URLSearchParams(lu.search).get("prefix") ?? ""), { headers: { "content-type": "application/xml" } })
      }
      const k = bucket + "/" + lp.slice(bucket.byteLength + 2)
      if (req.method === "DELETE") {
        cloudObjects.delete(k)
        return new Response(undefined, { status: 204 })
      }
      const obj = cloudObjects.get(k)
      if (obj === undefined) return new Response("NoSuchKey", { status: 404 })
      return new Response(obj, { headers: { "content-type": "application/octet-stream" } })
    }
    return new Response("not found", { status: 404 })
  },
  websocket: {
    message(ws, m) {
      ws.send(JSON.stringify({ type: "echo", auth: ws.data ?? "", event: typeof m === "string" ? m : "binary" }))
    },
  },
})
// A second upstream that streams slowly (one SSE event every 150 ms) on raw
// sockets, to check that the gateway forwards chunks as they arrive.
const slowPort = parseInt(process.env.MOCK_SLOW_PORT ?? "18100") ?? 18100
listen({ hostname: "127.0.0.1", port: slowPort }, (req, res) => {
  const h: Map<string, string> = new Map()
  h.set("content-type", "text/event-stream")
  res.writeHead(200, h)
  const words = ["one", "two", "three", "four"]
  let i = 0
  let tick: () => void = () => {}
  tick = () => {
    if (i < words.length) {
      res.write(`data: {"id":"s1","object":"chat.completion.chunk","created":1,"model":"slow","choices":[{"index":0,"delta":{"content":"${words[i]!} "},"finish_reason":null}]}\n\n`)
      i += 1
      setTimeout(tick, 150)
      return
    }
    res.write(`data: {"id":"s1","object":"chat.completion.chunk","created":1,"model":"slow","choices":[],"usage":{"prompt_tokens":2,"completion_tokens":4,"total_tokens":6}}\n\ndata: [DONE]\n\n`)
    res.end()
  }
  tick()
})
console.log(`mock upstream on ${port}`)
