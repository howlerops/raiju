        if ((req.headers.get("authorization") ?? "") !== "Bearer sk-oa163") return Response.json({ error: { message: "invalid api key", type: "invalid_request_error" } }, { status: 401 })
        const answers = try openaiDecisionAnswers(body)
        return new Response(`{"model":"gpt-6-luna-2026-09","answers":[${answers}],"usage":{"input_tokens":21,"output_tokens":5,"total_tokens":26}}`, { headers: { "content-type": "application/json" } })
      },
    },
    "/az163/providers/microsoft/v1/systemone": {
