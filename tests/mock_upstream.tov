        record(req, `/v1/projects/${req.params.project}/locations/${req.params.location}/publishers/${req.params.publisher}/models/${req.params.modelAction}`, body)
        // Imagen's :predict and a Gemini image model's generateContent answer with inline images
        if (req.params.modelAction.endsWith(":predict")) return Response.json({ predictions: [{ bytesBase64Encoded: "iVBORw0KGgo=" }] })
        if (body.includes(`"IMAGE"`)) return Response.json({ candidates: [{ content: { role: "model", parts: [{ inlineData: { mimeType: "image/png", data: "iVBORw0KGgo=" } }] }, finishReason: "STOP" }] })
        return Response.json({ candidates: [{ content: { role: "model", parts: [{ text: "Hi from vertex" }] }, finishReason: "STOP" }], usageMetadata: { promptTokenCount: 4, candidatesTokenCount: 3, totalTokenCount: 7 } })
