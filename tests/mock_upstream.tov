        return new Response(`{"model":"pplx-decider-v1.1-27b","answers":{${answers}},"usage":{"input_tokens":11,"output_tokens":0}}`, { headers: { "content-type": "application/json", "x-request-id": "pplx-req-163" } })
      },
    },
    "/ol163/v1/systemone": {
