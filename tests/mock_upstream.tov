    // an OAuth token endpoint (client credentials) for the secured MCP server
    "/oauth/token": {
      POST: async (req) => {
        const body = await req.text()
        record(req, "/oauth/token", body)
        // client_secret_basic: raiju:s3cret
        if ((req.headers.get("authorization") ?? "") !== "Basic cmFpanU6czNjcmV0" || !body.includes("grant_type=client_credentials")) return Response.json({ error: "invalid_client" }, { status: 401 })
        return Response.json({ access_token: "mcp-token", token_type: "Bearer", expires_in: 3600 })
      },
    },
    // the same MCP server, behind OAuth
    "/mcp-secure": {
      POST: async (req) => {
        if ((req.headers.get("authorization") ?? "") !== "Bearer mcp-token") return new Response("unauthorized", { status: 401, headers: { "www-authenticate": "Bearer" } })
        return try await mcpServer(req)
