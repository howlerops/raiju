        return Response.json({ name: "command-r-plus", is_deprecated: false, endpoints: ["chat"], finetuned: false, context_length: 128000, tokenizer_url: "https://tokenizer.example/command-r-plus.json", default_endpoints: ["chat"], features: ["tools"] })
      },
    },
    "/or/alpha/decisions": {
