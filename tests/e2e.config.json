{
  "client": {
    "enable_logging": false,
    "allowed_origins": [
      "http://localhost:3000"
    ]
  },
  "providers": {
    "openai": {
      "keys": [
        {
          "name": "primary",
          "value": "env.E2E_OPENAI_KEY",
          "models": [],
          "weight": 1.0
        },
        {
          "name": "broken",
          "value": "bad-key",
          "models": [
            "rotate-me"
          ],
          "weight": 1.0
        },
        {
          "name": "spare",
          "value": "sk-spare",
          "models": [
            "rotate-me"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18099",
        "max_retries": 2,
        "retry_backoff_initial": 10,
        "retry_backoff_max": 50
      }
    },
    "anthropic": {
      "keys": [
        {
          "value": "sk-ant",
          "models": [],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    },
    "gemini": {
      "keys": [
        {
          "value": "g-key",
          "models": [],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    },
    "bedrock": {
      "keys": [
        {
          "models": [],
          "weight": 1.0,
          "bedrock_key_config": {
            "access_key": "AKIDEXAMPLE",
            "secret_key": "secret",
            "region": "us-west-2",
            "deployments": {
              "claude": "anthropic.claude-3-haiku-20240307-v1:0"
            }
          }
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    },
    "local": {
      "keys": [],
      "custom_provider_config": {
        "base_provider_type": "openai",
        "is_key_less": true
      },
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    }
  },
  "governance": {
    "budgets": [
      {
        "id": "tiny",
        "max_limit": 1e-05,
        "reset_duration": "1d"
      }
    ],
    "rate_limits": [
      {
        "id": "two-per-minute",
        "request_max_limit": 2,
        "request_reset_duration": "1m"
      }
    ],
    "virtual_keys": [
      {
        "id": "vk-limited",
        "value": "sk-bf-limited",
        "rate_limit_id": "two-per-minute"
      },
      {
        "id": "vk-budget",
        "value": "sk-bf-budget",
        "budget_id": "tiny"
      },
      {
        "id": "vk-openai-only",
        "value": "sk-bf-openai",
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": [
              "gpt-4o-mini"
            ]
          }
        ]
      }
    ],
    "routing_rules": [
      {
        "id": "premium-to-claude",
        "cel_expression": "headers[\"x-tier\"] == \"premium\"",
        "targets": [
          {
            "provider": "anthropic",
            "model": "claude-routed",
            "weight": 1.0
          }
        ],
        "scope": "global",
        "priority": 1
      }
    ]
  },
  "pricing": {
    "openai/gpt-4o-mini": {
      "input_cost_per_token": 0.001,
      "output_cost_per_token": 0.001
    }
  },
  "cache": {
    "enabled": true,
    "ttl_seconds": 60
  },
  "guardrails": {
    "enabled": true,
    "mode": "redact",
    "detect": [
      "email",
      "ssn",
      "credit_card"
    ],
    "apply_to": "both"
  },
  "otel": {
    "endpoint": "http://127.0.0.1:18099/v1/traces",
    "service_name": "raiju-e2e",
    "batch_size": 1,
    "flush_ms": 100
  },
  "logs_store": {
    "enabled": true,
    "dir": "build/e2e-logs",
    "retention_days": 1,
    "content_logging": true
  }
}