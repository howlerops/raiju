{
  "client": {
    "enable_logging": false,
    "allowed_origins": [
      "http://localhost:3000"
    ],
    "mcp_auto_execute": [
      "weather-get_weather"
    ],
    "mcp_agent_depth": 3
  },
  "providers": {
    "openai": {
      "keys": [
        {
          "name": "primary",
          "value": "env.E2E_OPENAI_KEY",
          "models": [],
          "weight": 1.0
        },
        {
          "name": "broken",
          "value": "bad-key",
          "models": [
            "rotate-me"
          ],
          "weight": 1.0
        },
        {
          "name": "spare",
          "value": "sk-spare",
          "models": [
            "rotate-me"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18099",
        "max_retries": 2,
        "retry_backoff_initial": 10,
        "retry_backoff_max": 50
      }
    },
    "anthropic": {
      "keys": [
        {
          "value": "sk-ant",
          "models": [],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    },
    "gemini": {
      "keys": [
        {
          "value": "g-key",
          "models": [],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    },
    "bedrock": {
      "keys": [
        {
          "models": [],
          "weight": 1.0,
          "bedrock_key_config": {
            "access_key": "AKIDEXAMPLE",
            "secret_key": "secret",
            "region": "us-west-2",
            "deployments": {
              "claude": "anthropic.claude-3-haiku-20240307-v1:0"
            }
          }
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    },
    "local": {
      "keys": [],
      "custom_provider_config": {
        "base_provider_type": "openai",
        "is_key_less": true
      },
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    },
    "slowai": {
      "keys": [
        {
          "value": "sk-slow",
          "models": [],
          "weight": 1.0
        }
      ],
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "http://127.0.0.1:18100"
      }
    },
    "vaulted": {
      "keys": [
        {
          "name": "v",
          "value": "vault.raiju#key",
          "models": [],
          "weight": 1.0
        }
      ],
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    },
    "proxied": {
      "keys": [
        {
          "name": "p",
          "value": "sk-proxied",
          "models": [],
          "weight": 1.0
        }
      ],
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "http://upstream.example:8000"
      },
      "proxy_config": {
        "type": "http",
        "url": "http://127.0.0.1:18095",
        "username": "proxy-user",
        "password": "pa:ss"
      }
    },
    "watsonx": {
      "keys": [
        {
          "name": "wx",
          "models": [],
          "weight": 1.0,
          "watsonx_key_config": {
            "api_key": "ibm-key",
            "project_id": "proj-1",
            "url": "http://127.0.0.1:18099",
            "iam_url": "http://127.0.0.1:18099/identity/token"
          }
        }
      ]
    },
    "nvidia": {
      "keys": [
        {
          "name": "nv",
          "value": "nv-key",
          "models": [],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18099"
      }
    }
  },
  "governance": {
    "budgets": [
      {
        "id": "tiny",
        "max_limit": 1e-05,
        "reset_duration": "1d"
      }
    ],
    "rate_limits": [
      {
        "id": "two-per-minute",
        "request_max_limit": 2,
        "request_reset_duration": "1m"
      },
      {
        "id": "cluster-rl",
        "request_max_limit": 3,
        "request_reset_duration": "1h"
      }
    ],
    "virtual_keys": [
      {
        "id": "vk-limited",
        "value": "sk-bf-limited",
        "rate_limit_id": "two-per-minute"
      },
      {
        "id": "vk-budget",
        "value": "sk-bf-budget",
        "budget_id": "tiny"
      },
      {
        "id": "vk-openai-only",
        "value": "sk-bf-openai",
        "provider_configs": [
          {
            "provider": "openai",
            "allowed_models": [
              "gpt-4o-mini"
            ]
          }
        ]
      },
      {
        "id": "vk-cluster",
        "value": "sk-bf-cluster",
        "rate_limit_id": "cluster-rl"
      }
    ],
    "routing_rules": [
      {
        "id": "premium-to-claude",
        "cel_expression": "headers[\"x-tier\"] == \"premium\"",
        "targets": [
          {
            "provider": "anthropic",
            "model": "claude-routed",
            "weight": 1.0
          }
        ],
        "scope": "global",
        "priority": 1
      }
    ],
    "auth_config": {
      "token": "env.E2E_ADMIN_TOKEN"
    }
  },
  "pricing": {
    "openai/gpt-4o-mini": {
      "input_cost_per_token": 0.001,
      "output_cost_per_token": 0.001
    }
  },
  "cache": {
    "enabled": true,
    "ttl_seconds": 60
  },
  "guardrails": {
    "enabled": true,
    "mode": "redact",
    "detect": [
      "email",
      "ssn",
      "credit_card"
    ],
    "apply_to": "both"
  },
  "otel": {
    "endpoint": "http://127.0.0.1:18099/v1/traces",
    "service_name": "raiju-e2e",
    "batch_size": 1,
    "flush_ms": 100
  },
  "logs_store": {
    "enabled": true,
    "dir": "build/e2e-logs",
    "retention_days": 1,
    "content_logging": true
  },
  "mcp": {
    "client_configs": [
      {
        "name": "weather",
        "connection_type": "http",
        "connection_string": "http://127.0.0.1:18099/mcp"
      },
      {
        "name": "secure",
        "connection_type": "http",
        "connection_string": "http://127.0.0.1:18099/mcp-secure",
        "auth": {
          "type": "oauth_client_credentials",
          "token_url": "http://127.0.0.1:18099/oauth/token",
          "client_id": "raiju",
          "client_secret": "s3cret"
        }
      }
    ]
  },
  "plugins": [
    {
      "name": "mocker",
      "enabled": true,
      "config": {
        "rules": [
          {
            "model": "openai/mock-me",
            "content": "mocked!"
          }
        ]
      }
    },
    {
      "name": "header",
      "enabled": true,
      "config": {
        "set_request_headers": {
          "x-team": "e2e"
        }
      }
    },
    {
      "name": "maxtokens",
      "enabled": true,
      "config": {
        "default_max_tokens": 777
      }
    }
  ],
  "semantic_cache": {
    "enabled": true,
    "provider": "openai",
    "embedding_model": "text-embedding-3-small",
    "threshold": 0.95,
    "ttl": 60
  },
  "secrets": {
    "vault": {
      "address": "http://127.0.0.1:18099",
      "token": "root-token"
    }
  },
  "audit": {
    "enabled": true,
    "dir": "build/e2e-audit"
  },
  "alerts": {
    "enabled": true,
    "interval_seconds": 1,
    "rules": [
      {
        "id": "any-traffic",
        "metric": "requests",
        "op": ">",
        "threshold": 0,
        "window_seconds": 60,
        "channels": [
          "hook"
        ]
      }
    ],
    "channels": [
      {
        "id": "hook",
        "type": "webhook",
        "url": "http://127.0.0.1:18099/alert-hook"
      }
    ]
  },
  "session_affinity": {
    "enabled": true
  },
  "complexity_router": {
    "enabled": true,
    "tiers": {
      "simple": "openai/gpt-4o-mini",
      "complex": "anthropic/claude-sonnet-4"
    }
  },
  "log_exports": {
    "enabled": true,
    "kind": "s3",
    "bucket": "logs",
    "endpoint": "http://127.0.0.1:18099",
    "region": "us-east-1",
    "access_key_id": "AKIDEXAMPLE",
    "secret_access_key": "secret",
    "interval_seconds": 1
  },
  "cluster": {
    "enabled": true,
    "node_id": "a",
    "peers": [
      "http://127.0.0.1:18097"
    ],
    "secret": "cluster-secret",
    "interval_ms": 200
  },
  "oidc": {
    "enabled": true,
    "issuer": "http://127.0.0.1:18096",
    "client_id": "raiju",
    "redirect_uri": "http://127.0.0.1:18098/api/oidc/callback",
    "role_map": {
      "raiju-editors": "editor"
    }
  },
  "virtual_mcps": [
    {
      "name": "weather-desk",
      "description": "Forecasts only",
      "tools": [
        {
          "source": "weather-get_weather",
          "as": "forecast",
          "description": "Forecast for a city",
          "defaults": "{\"units\":\"metric\"}"
        }
      ]
    }
  ]
}
