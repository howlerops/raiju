// Native async entry point: test callbacks themselves are synchronous in Tov.
import { statSync, writeFileSync, rmSync } from "node:fs"
import { SharedTable } from "../src/sharedtable"
import { writeFileAtomic, PRIVATE_FILE } from "../src/atomicfile"

async function fixedMtime(file: string): Promise<void> {
  let output = ""
  let done: () => void = () => {}
  let failed: (e: Error) => void = (e) => {}
  const completed = new Promise<void>((resolve, reject) => { done = resolve; failed = reject })
  const timer = setTimeout(() => failed(new Error("timestamp fixture timed out")), 10000)
  let end: () => void = () => {}
  try {
    const child = try await Bun.spawnSocket({
      cmd: ["sh", "-c", "touch -t 202001010000.00 \"$1\" && printf ok", "raiju-cache-fixture", file],
      socket: {
        data(sock, bytes) {
          try { output += new TextDecoder().decode(bytes) }
          catch (e) { failed(new Error(e.message)) }
        },
        close(sock) {
          if (output === "ok") done()
          else failed(new Error("timestamp fixture failed"))
        },
      },
    })
    end = () => child.end()
    await completed
  } finally {
    clearTimeout(timer)
    end()
  }
}

async function main(): Promise<int> {
  const file = "/tmp/raiju-metadata-test-" + process.pid + ".json"
  const now = 1000000.0
  try {
    try writeFileAtomic(file, `{"rows":[{"k":"old","v":"live","exp":1005000}]}`, { mode: PRIVATE_FILE, exact: true })
    await fixedMtime(file)
    const stamp = try statSync(file)
    const table = new SharedTable(file, 100)
    if (table.get("old", now) !== "live") throw new Error("initial row missing")
    try writeFileSync(file, `{"rows":[{"k":"new","v":"live","exp":1005000}]}`)
    await fixedMtime(file)
    const same = try statSync(file)
    if (same.dev !== stamp.dev || same.ino !== stamp.ino || same.size !== stamp.size || same.mtimeMs !== stamp.mtimeMs) {
      throw new Error("fixture did not preserve file metadata")
    }
    // Earlier freshness is allowed; repeated reads must not extend the deadline.
    table.get("old", now + 999.0)
    if (table.get("old", now + 1000.0) !== undefined) throw new Error("revoked row survived the one-second deadline")
    if (table.get("new", now + 1000.0) !== "live") throw new Error("replacement row not visible at deadline")
    console.log("ok shared table metadata collision: revocation observed within one second")
    return 0
  } catch (e) {
    console.error(e.message)
    return 1
  } finally {
    try rmSync(file, { force: true })
  }
}
