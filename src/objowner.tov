// Provider objects bound to the virtual key that created them (Bifrost's client.enforce_vk_object_ownership,
// plugins/governance/providerjobs.go).
//
// Files and batches are created through the operator's provider key, which every virtual key allowed on the
// provider shares, and are then addressed by the provider's id alone. The create answer records the key that made
// the object; a read, download, cancel, results or delete call by another key is refused as not found (so the other
// tenant's object is not confirmed to exist), a batch may not run on another key's input file, and a list page
// keeps only what the key may see. A request with no virtual key is unrestricted, and an object with no record
// (created outside the gateway, or before this) stays reachable, as in Bifrost. Creators are recorded while the
// option is off too, so turning it on binds objects created meanwhile. A batch's output and error files are bound
// to the batch's creator when a retrieve names them.
//
// Gemini's cached contents are bound the same way, and the objects an inference request names (a file by file_id or
// Gemini fileUri in a chat, Responses, Messages or GenAI body, a cached content it runs on, a batch's input file), a
// passthrough call's path (files/<id>, batches/<id>, cachedContents/<id>) and its body are checked like a direct
// reference (objectRefs, pathRefs); a passthrough list of a collection is narrowed like a native one.
//
// Records live in memory and, with a directory (the logs_store folder), as one small file each, so the workers of a
// node share them and they survive a restart. Bifrost keeps them in its config database. A record is found by kind
// and id and carries the provider it was made through: it holds for that provider and for every provider name that
// reaches the same upstream (the caller decides which, see owner), as Bifrost checks across equivalent providers. A
// record from before providers were kept holds for every provider.
import { readFileSync, existsSync, unlinkSync, readdirSync } from "node:fs"
import { writeFileAtomic, mkdirPrivate } from "./atomicfile"
import { sha256, toHex, utf8 } from "./crypto"
import { Field, fields, elements, find, rawStr, quote, build, setField, decodeString } from "./json"

// The noun a kind goes by in messages.
export function objectLabel(kind: string): string {
  return kind === "batch" ? "batch" : kind === "file" ? "file" : kind === "cached" ? "cached content" : "object"
}

// The kind of object a batch or file operation (pluginroute.tov storageOp) addresses, or "".
export function ownerKind(op: string): string {
  if (op.startsWith("file_")) return "file"
  if (op.startsWith("batch_")) return "batch"
  if (op.startsWith("cached_content_")) return "cached"
  return ""
}

// Whether an operation addresses one existing object by id (the ones a foreign key is refused on).
export function addressesObject(op: string): bool {
  return op === "file_retrieve" || op === "file_content" || op === "file_delete" || op === "batch_retrieve" || op === "batch_cancel" || op === "batch_results" || op === "batch_delete" || op === "cached_content_retrieve" || op === "cached_content_update" || op === "cached_content_delete"
}

// Whether an operation creates an object whose answer names it (its creator is recorded).
export function createsObject(op: string): bool {
  return op === "file_upload" || op === "batch_create" || op === "cached_content_create"
}

// The trailing id of an ARN (a Bedrock job: arn:aws:bedrock:...:model-invocation-job/<id>), or "".
function arnTail(id: string): string {
  if (!id.startsWith("arn:")) return ""
  const parts = id.split("/")
  return parts.length > 1 ? parts[parts.length - 1]! : ""
}

// The forms an id is recorded under: as created, and an ARN's trailing job id.
export function recordForms(id: string): string[] {
  if (id === "") return []
  const out = [id]
  const t = arnTail(id)
  if (t !== "" && t !== id) out.push(t)
  return out
}

// The forms an addressed id may be recorded under: as written, a Google resource name with and without its
// collection ("files/abc" and "abc"), and an ARN's trailing job id.
export function lookupForms(kind: string, id: string): string[] {
  if (id === "") return []
  const out = recordForms(id)
  const coll = kind === "file" ? "files/" : kind === "batch" ? "batches/" : kind === "cached" ? "cachedContents/" : ""
  if (coll !== "" && !id.startsWith("arn:") && !id.startsWith("projects/")) {
    const bare = id.startsWith(coll) ? id.slice(coll.byteLength) : id
    for (const f of [bare, coll + bare]) {
      if (f !== "" && !out.includes(f)) out.push(f)
    }
  }
  return out
}

// What a record holds: the creating virtual key and the provider it was made through ("" for a record from before
// providers were kept).
export type OwnerRecord = { vk: string, provider: string }

export class ObjectOwners {
  // by kind and id: the virtual key and the provider, joined by a newline
  mem: Map<string, string> = new Map()
  dir = ""
  // whether any record exists, as last looked (hasRecords), and when
  private anyAt = -1.0
  private anySeen = false

  // Keeps the records in dir as well (made with the first record).
  useDir(dir: string): void {
    this.dir = dir
  }

  private key(kind: string, id: string): string {
    return kind + "\u0000" + id
  }

  private file(kind: string, id: string): string {
    return this.dir + "/" + toHex(sha256(utf8(this.key(kind, id)))) + ".json"
  }

  // The record of one exact form, or undefined.
  private read(kind: string, id: string): OwnerRecord | undefined {
    const k = this.key(kind, id)
    const m = this.mem.get(k)
    const fromMem: OwnerRecord | undefined = m === undefined ? undefined : { vk: m.split("\n")[0] ?? "", provider: m.split("\n")[1] ?? "" }
    if (this.dir === "") return fromMem
    const p = this.file(kind, id)
    if (!existsSync(p)) return undefined
    try {
      const f = try fields(try readFileSync(p, "utf8"))
      const vk = rawStr(f, "virtual_key_id") ?? ""
      if (vk === "") return undefined
      return { vk: vk, provider: rawStr(f, "provider") ?? "" }
    } catch (e) {
      return fromMem
    }
  }

  // The virtual key that created the object an id addresses, or "" when none is recorded. With a provider, a record
  // made through another provider counts only when same says the two reach the same upstream.
  owner(kind: string, id: string, provider?: string, same?: (a: string, b: string) => bool): string {
    for (const f of lookupForms(kind, id)) {
      const r = this.read(kind, f)
      if (r === undefined) continue
      if (provider !== undefined && provider !== "" && r.provider !== "" && r.provider !== provider) {
        if (same === undefined || !same(r.provider, provider)) continue
      }
      return r.vk
    }
    return ""
  }

  // Records the creating key and the provider; an object already recorded keeps its first creator.
  record(kind: string, id: string, vk: string, now: int, provider?: string): void {
    if (vk === "") return
    const pv = provider ?? ""
    for (const f of recordForms(id)) {
      if (this.read(kind, f) !== undefined) continue
      this.mem.set(this.key(kind, f), vk + "\n" + pv)
      this.anySeen = true
      if (this.dir === "") continue
      try {
        if (!existsSync(this.dir)) mkdirPrivate(this.dir)
        const prov = pv === "" ? "" : `,"provider":${quote(pv)}`
        writeFileAtomic(this.file(kind, f), `{"kind":${quote(kind)},"id":${quote(f)},"virtual_key_id":${quote(vk)}${prov},"created_at":${now}}`)
      } catch (e) {
        console.error(`raiju: could not record the creating virtual key of ${objectLabel(kind)} ${f}: ${e.message}`)
      }
    }
  }

  // Whether any object is recorded at all, so a request that names none skips the body check. With a directory the
  // answer is looked up at most once a second (another worker may have recorded one).
  hasRecords(): bool {
    if (this.anySeen || this.mem.size > 0) return true
    if (this.dir === "") return false
    const now = Date.now()
    if (now - this.anyAt < 1000.0) return this.anySeen
    this.anyAt = now
    try {
      this.anySeen = readdirSync(this.dir).length > 0
    } catch (e) {
      this.anySeen = false
    }
    return this.anySeen
  }

  // Forgets an object a delete confirmed gone, under every form.
  forget(kind: string, id: string): void {
    for (const f of lookupForms(kind, id)) {
      this.mem.delete(this.key(kind, f))
      if (this.dir === "") continue
      try {
        const p = this.file(kind, f)
        if (existsSync(p)) unlinkSync(p)
      } catch (e) {
        continue
      }
    }
  }
}

let ownersInstance: ObjectOwners | undefined = undefined

// The process's owner records (made on first use: top-level statements in imported modules do not run).
export function objectOwners(): ObjectOwners {
  let o = ownersInstance
  if (o === undefined) {
    o = new ObjectOwners()
    ownersInstance = o
  }
  return o
}

// The id of an object one item of an answer describes: id (OpenAI, Anthropic), name (Gemini), jobArn (Bedrock),
// or a nested file's name (a Gemini upload answers {file: {name}}).
export function itemId(raw: string): string {
  try {
    const f = try fields(raw)
    const id = rawStr(f, "id") ?? rawStr(f, "name") ?? rawStr(f, "jobArn") ?? ""
    if (id !== "") return id
    const file = find(f, "file")
    if (file !== undefined && file.startsWith("{")) return rawStr(try fields(file), "name") ?? ""
  } catch (e) {
    return ""
  }
  return ""
}

// The input file a batch create names (OpenAI's input_file_id, Gemini's src.file_name or input_config.file_name),
// or "".
export function batchInputFile(body: string): string {
  try {
    const f = try fields(body)
    const direct = rawStr(f, "input_file_id") ?? ""
    if (direct !== "") return direct
    for (const outer of ["batch", "src", "input_config", "inputConfig"]) {
      const o = find(f, outer)
      if (o === undefined || !o.startsWith("{")) continue
      const of = try fields(o)
      const n = rawStr(of, "file_name") ?? rawStr(of, "fileName") ?? ""
      if (n !== "") return n
      const src = find(of, "src") ?? find(of, "input_config") ?? find(of, "inputConfig")
      if (src !== undefined && src.startsWith("{")) {
        const sf = try fields(src)
        const m = rawStr(sf, "file_name") ?? rawStr(sf, "fileName") ?? ""
        if (m !== "") return m
      }
    }
  } catch (e) {
    return ""
  }
  return ""
}

// The output and error files a batch answer names (OpenAI's output_file_id and error_file_id).
export function batchFiles(body: string): string[] {
  const out: string[] = []
  try {
    const f = try fields(body)
    for (const k of ["output_file_id", "error_file_id"]) {
      const v = rawStr(f, k) ?? ""
      if (v !== "") out.push(v)
    }
  } catch (e) {
    return out
  }
  return out
}

// A list answer with the items another key created left out, or undefined when nothing is left out. The list is
// data (OpenAI, Anthropic), files or batches (Gemini) or invocationJobSummaries (Bedrock); pagination cursors are
// the provider's and stay as they are.
export function filterList(body: string, kind: string, hidden: (id: string) => bool): string | undefined {
  try {
    let f: Field[] = try fields(body)
    for (const k of ["data", "files", "batches", "operations", "invocationJobSummaries", "cachedContents"]) {
      const arr = find(f, k)
      if (arr === undefined || !arr.startsWith("[")) continue
      const kept: string[] = []
      let dropped = false
      for (const el of try elements(arr)) {
        const id = el.startsWith("{") ? itemId(el) : ""
        if (id !== "" && hidden(id)) dropped = true
        else kept.push(el)
      }
      if (!dropped) return undefined
      setField(&f, k, "[" + kept.join(",") + "]")
      return build(f)
    }
  } catch (e) {
    return undefined
  }
  return undefined
}

// One object a request names: its kind ("file", "batch", "cached") and id.
export type ObjectRef = { kind: string, id: string }

// The keys a JSON body names a provider object under, and the Gemini file host of a file URI given as any URL; a body
// without any of them (or a \u escape, which could spell one) names nothing and is not parsed.
const REF_MARKERS = [`"file_id`, `"fileUri"`, `"file_uri"`, `"cached_content"`, `"cachedContent"`, `"input_file_id"`, `"training_file"`, `"validation_file"`, `"fileName"`, `"file_ids"`, `generativelanguage.googleapis.com`, `\\u`]

export function mayNameObjects(body: string): bool {
  for (const m of REF_MARKERS) {
    if (body.includes(m)) return true
  }
  return false
}

// The name a Gemini file URI's file is recorded under ("files/<id>"), or "" when the URL is not one
// (https://generativelanguage.googleapis.com/<version>/files/<id>).
export function geminiFileName(url: string): string {
  const u = url.trim()
  const host = "generativelanguage.googleapis.com"
  let rest = ""
  if (u.startsWith("https://" + host + "/")) rest = u.slice(("https://" + host + "/").byteLength)
  else if (u.startsWith("http://" + host + "/")) rest = u.slice(("http://" + host + "/").byteLength)
  else return ""
  const q = rest.indexOf("?")
  if (q >= 0) rest = rest.slice(0, q)
  const segs = rest.split("/")
  for (let i = 0; i + 1 < segs.length; i++) {
    if (segs[i] === "files" && segs[i + 1] !== "") return "files/" + (segs[i + 1]!.split(":")[0] ?? "")
  }
  return ""
}

function addRef(inout out: ObjectRef[], kind: string, id: string): void {
  const t = id.trim()
  if (t === "") return
  for (const r of out) {
    if (r.kind === kind && r.id === t) return
  }
  out.push({ kind: kind, id: t })
}

function walkRefs(raw: string, inout out: ObjectRef[], depth: int): void {
  if (depth > 64 || raw === "") return
  const c = raw.slice(0, 1)
  try {
    if (c === "[") {
      for (const el of try elements(raw)) walkRefs(el, &out, depth + 1)
      return
    }
    if (c !== "{") return
    for (const f of try fields(raw)) {
      const k = f.key
      const v = f.raw
      const str = v.startsWith("\"") ? (try decodeString(v)) : ""
      if (k === "file_id" || k === "input_file_id" || k === "training_file" || k === "validation_file") addRef(&out, "file", str)
      else if (k === "fileName" && str.startsWith("files/")) addRef(&out, "file", str)
      else if (k === "file_ids" && v.startsWith("[")) {
        for (const el of try elements(v)) {
          if (el.startsWith("\"")) addRef(&out, "file", try decodeString(el))
        }
      } else if (k === "fileUri" || k === "file_uri" || k === "url" || k === "file_url" || k === "image_url") {
        const name = geminiFileName(str)
        if (name !== "") addRef(&out, "file", name)
      } else if (k === "cached_content" || k === "cachedContent") addRef(&out, "cached", str)
      walkRefs(v, &out, depth + 1)
    }
  } catch (e) {
    return
  }
}

// The provider objects a JSON request body names anywhere in it (Bifrost's jsonObjectRefs and inferenceFileIDs): a
// file by file_id, file_ids, input_file_id, training_file, validation_file, a Gemini batch's fileName or a Gemini file
// URI (fileUri, a file or image URL), and a cached content (cached_content or cachedContent).
export function objectRefs(body: string): ObjectRef[] {
  const out: ObjectRef[] = []
  if (!mayNameObjects(body)) return out
  let refs: ObjectRef[] = []
  walkRefs(body.trim(), &refs, 0)
  return refs
}

// The objects a passthrough path addresses (Bifrost's passthroughObjectRefs): a collection segment followed by an id
// (files/<id>, batches/<id>, cachedContents/<id>; Gemini's names carry their collection). The path is taken as it
// will be sent, with . and .. resolved.
export function pathRefs(rest: string, gemini: bool): ObjectRef[] {
  const segs = cleanSegments(rest)
  let out: ObjectRef[] = []
  for (let i = 0; i + 1 < segs.length; i++) {
    const id = segs[i + 1]!.split(":")[0] ?? ""
    if (id === "") continue
    const s = segs[i]!
    if (s === "files") addRef(&out, "file", gemini ? "files/" + id : id)
    else if (s === "batches") addRef(&out, "batch", gemini ? "batches/" + id : id)
    else if (s === "cachedContents") addRef(&out, "cached", "cachedContents/" + id)
  }
  return out
}

// The kind of collection a passthrough GET lists (its last segment is files, batches or cachedContents), or "".
export function listKind(method: string, rest: string): string {
  if (method.toUpperCase() !== "GET") return ""
  const segs = cleanSegments(rest)
  const last = segs[segs.length - 1] ?? ""
  return last === "files" ? "file" : last === "batches" ? "batch" : last === "cachedContents" ? "cached" : ""
}

// A path's segments as a client would send them: no empty ones, . dropped and .. taking the one before.
function cleanSegments(path: string): string[] {
  const q = path.indexOf("?")
  const p = q >= 0 ? path.slice(0, q) : path
  const out: string[] = []
  for (const s of p.split("/")) {
    if (s === "" || s === ".") continue
    if (s === "..") {
      if (out.length > 0) out.pop()
      continue
    }
    out.push(s)
  }
  return out
}

// The refusal of a foreign object: Bifrost's 404 access_blocked, so the object is not confirmed to exist.
export function notFoundMessage(kind: string, id: string): string {
  return `${objectLabel(kind)} '${id}' not found`
}

// ---- tests ----

test("forms: Gemini resource names, ARNs and plain ids", () => {
  expect(lookupForms("file", "files/abc").join(",")).toBe("files/abc,abc")
  expect(lookupForms("file", "abc").join(",")).toBe("abc,files/abc")
  expect(lookupForms("batch", "batch_1").join(",")).toBe("batch_1,batches/batch_1")
  expect(recordForms("arn:aws:bedrock:us-east-1:1:model-invocation-job/j9").join(",")).toBe("arn:aws:bedrock:us-east-1:1:model-invocation-job/j9,j9")
  expect(lookupForms("batch", "arn:aws:bedrock:us-east-1:1:model-invocation-job/j9").length).toBe(2)
  expect(lookupForms("file", "").length).toBe(0)
})

test("owners: first creator kept, short forms found, delete forgets", () => {
  const o = new ObjectOwners()
  o.record("file", "files/abc", "vk-a", 1)
  o.record("file", "files/abc", "vk-b", 2)
  expect(o.owner("file", "abc")).toBe("vk-a")
  expect(o.owner("file", "files/abc")).toBe("vk-a")
  expect(o.owner("batch", "abc")).toBe("")
  o.record("batch", "arn:aws:bedrock:r:1:model-invocation-job/j1", "vk-b", 3)
  expect(o.owner("batch", "j1")).toBe("vk-b")
  o.forget("file", "abc")
  expect(o.owner("file", "files/abc")).toBe("")
  o.record("file", "x", "", 4)
  expect(o.owner("file", "x")).toBe("")
})

test("owners in a directory are shared by two processes", () => {
  const dir = "/tmp/raiju-objowner-test-" + toHex(sha256(utf8("" + Date.now())))
  const a = new ObjectOwners()
  a.useDir(dir)
  const b = new ObjectOwners()
  b.useDir(dir)
  a.record("file", "file-1", "vk-a", 1)
  expect(b.owner("file", "file-1")).toBe("vk-a")
  b.forget("file", "file-1")
  expect(a.owner("file", "file-1")).toBe("")
})

test("the objects a body and a passthrough path name", () => {
  const chat = `{"model":"m","messages":[{"role":"user","content":[{"type":"file","file":{"file_id":"file-a"}},{"type":"image_url","image_url":{"url":"https://generativelanguage.googleapis.com/v1beta/files/g1"}}]}],"cached_content":"cachedContents/c9"}`
  expect(objectRefs(chat).map((r) => r.kind + ":" + r.id).join(",")).toBe("file:file-a,file:files/g1,cached:cachedContents/c9")
  const resp = `{"model":"m","input":[{"role":"user","content":[{"type":"input_file","file_id":"file-b"}]}],"tools":[{"type":"code_interpreter","container":{"file_ids":["file-c"]}}]}`
  expect(objectRefs(resp).map((r) => r.id).join(",")).toBe("file-b,file-c")
  expect(objectRefs(`{"contents":[{"parts":[{"fileData":{"fileUri":"https://generativelanguage.googleapis.com/v1beta/files/abc:download"}}]}]}`).map((r) => r.id).join(",")).toBe("files/abc")
  expect(objectRefs(`{"model":"m","messages":[{"role":"user","content":"hi"}]}`).length).toBe(0)
  expect(objectRefs(`{"a":"file\\u005fid"}`).length).toBe(0)
  expect(geminiFileName("https://example.com/files/x")).toBe("")
  expect(pathRefs("/v1/files/file-1/content", false).map((r) => r.kind + ":" + r.id).join(",")).toBe("file:file-1")
  expect(pathRefs("/v1beta/files/abc", true)[0]!.id).toBe("files/abc")
  expect(pathRefs("/v1beta/cachedContents/c1", true)[0]!.id).toBe("cachedContents/c1")
  expect(pathRefs("/v1/files/x/../file-2", false)[0]!.id).toBe("file-2")
  expect(listKind("GET", "/v1/files")).toBe("file")
  expect(listKind("GET", "/v1beta/cachedContents?pageSize=5")).toBe("cached")
  expect(listKind("POST", "/v1/files")).toBe("")
  expect(listKind("GET", "/v1/files/file-1")).toBe("")
})

test("a record holds for its provider and the providers that reach the same upstream", () => {
  const o = new ObjectOwners()
  o.record("file", "file-p", "vk-a", 1, "openai")
  expect(o.owner("file", "file-p", "openai")).toBe("vk-a")
  expect(o.owner("file", "file-p", "other")).toBe("")
  expect(o.owner("file", "file-p", "other", (a: string, b: string): bool => a === "openai" && b === "other")).toBe("vk-a")
  expect(o.owner("file", "file-p")).toBe("vk-a")
  // a record without a provider holds for every provider
  o.record("file", "file-q", "vk-b", 2)
  expect(o.owner("file", "file-q", "anything")).toBe("vk-b")
  o.record("cached", "cachedContents/c1", "vk-a", 3, "gemini")
  expect(o.owner("cached", "c1", "gemini")).toBe("vk-a")
  expect(o.hasRecords()).toBe(true)
  expect(new ObjectOwners().hasRecords()).toBe(false)
  expect(objectLabel("cached")).toBe("cached content")
  expect(ownerKind("cached_content_delete")).toBe("cached")
  expect(addressesObject("cached_content_update")).toBe(true)
})

test("ids of answers and batch inputs", () => {
  expect(itemId(`{"id":"file-1","object":"file"}`)).toBe("file-1")
  expect(itemId(`{"file":{"name":"files/g1"}}`)).toBe("files/g1")
  expect(itemId(`{"name":"batches/b2"}`)).toBe("batches/b2")
  expect(itemId(`{"jobArn":"arn:x/j"}`)).toBe("arn:x/j")
  expect(batchInputFile(`{"input_file_id":"file-9","endpoint":"/v1/chat/completions"}`)).toBe("file-9")
  expect(batchInputFile(`{"batch":{"input_config":{"file_name":"files/g7"}}}`)).toBe("files/g7")
  expect(batchInputFile(`{"src":{"file_name":"files/g8"}}`)).toBe("files/g8")
  expect(batchInputFile(`{"requests":[]}`)).toBe("")
  expect(batchFiles(`{"id":"b","output_file_id":"file-o","error_file_id":null}`).join(",")).toBe("file-o")
})

test("a list page keeps only the visible items", () => {
  const body = `{"object":"list","data":[{"id":"file-a"},{"id":"file-b"},{"id":"file-c"}],"has_more":false}`
  const out = filterList(body, "file", (id: string): bool => id === "file-b")
  expect(out).toBe(`{"object":"list","data":[{"id":"file-a"},{"id":"file-c"}],"has_more":false}`)
  expect(filterList(body, "file", (id: string): bool => false)).toBe(undefined)
  const g = filterList(`{"files":[{"name":"files/x"},{"name":"files/y"}],"nextPageToken":"t"}`, "file", (id: string): bool => id === "files/x")
  expect(g).toBe(`{"files":[{"name":"files/y"}],"nextPageToken":"t"}`)
  expect(notFoundMessage("batch", "b1")).toBe("batch 'b1' not found")
})
