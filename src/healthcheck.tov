// raiju -healthcheck: probe a running gateway on this host and exit 0 when it answers 200, 1 otherwise. The
// image has no curl, so its Docker HEALTHCHECK runs the binary itself (Dockerfile). It reads the same -host and
// -port (or PORT) as the gateway; a wildcard bind is probed on the loopback address.

// How long the probe waits for an answer. Docker's own timeout (HEALTHCHECK --timeout) is longer.
export const HEALTHCHECK_TIMEOUT_MS = 3000

// The URL the probe asks: the loopback address for a wildcard or empty host, IPv6 literals in brackets, and the path
// with a leading slash (/health unless one is given).
export function healthcheckUrl(host: string, port: int, path: string): string {
  let h = host
  if (h === "" || h === "0.0.0.0") h = "127.0.0.1"
  else if (h === "::" || h === "[::]") h = "[::1]"
  else if (h.indexOf(":") >= 0 && !h.startsWith("[")) h = `[${h}]`
  let p = path === "" ? "/health" : path
  if (!p.startsWith("/")) p = "/" + p
  return `http://${h}:${port}${p}`
}

// The exit code for an answer: 0 for a 2xx, 1 for anything else.
export function healthcheckCode(status: int): int {
  return status >= 200 && status < 300 ? 0 : 1
}

// Probes the URL once and returns the exit code. A refused connection or a timeout is 1, with one line on stderr.
export async function runHealthcheck(url: string): Promise<int> {
  try {
    const r = await fetch(url, { signal: AbortSignal.timeout(HEALTHCHECK_TIMEOUT_MS) })
    await r.text()
    const code = healthcheckCode(r.status)
    if (code !== 0) console.error(`raiju: healthcheck: ${url} answered HTTP ${r.status}`)
    return code
  } catch (e) {
    console.error(`raiju: healthcheck: ${url}: ${e.message}`)
    return 1
  }
}

test("the probe URL follows the bind address", () => {
  expect(healthcheckUrl("0.0.0.0", 8080, "")).toBe("http://127.0.0.1:8080/health")
  expect(healthcheckUrl("", 9000, "/ready")).toBe("http://127.0.0.1:9000/ready")
  expect(healthcheckUrl("10.0.0.5", 8080, "ready")).toBe("http://10.0.0.5:8080/ready")
  expect(healthcheckUrl("::", 8080, "")).toBe("http://[::1]:8080/health")
  expect(healthcheckUrl("fd00::1", 8080, "")).toBe("http://[fd00::1]:8080/health")
  expect(healthcheckUrl("[fd00::1]", 8080, "")).toBe("http://[fd00::1]:8080/health")
})

test("only a 2xx answer is healthy", () => {
  expect(healthcheckCode(200)).toBe(0)
  expect(healthcheckCode(204)).toBe(0)
  expect(healthcheckCode(503)).toBe(1)
  expect(healthcheckCode(404)).toBe(1)
})
