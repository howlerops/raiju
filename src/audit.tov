// Tamper-evident audit log of admin actions. Each event carries the hash of
// the event before it, and an HMAC of its own hash under a server key. Editing,
// deleting or reordering lines is caught by verify(); rewriting the whole chain
// needs the key. Events go to one JSON-lines file; the newest are also kept in
// memory for queries. Tov has no database driver, so the file is the store.
import { readFileSync, appendFileSync, writeFileSync, existsSync, mkdirSync, rmSync, unlinkSync } from "node:fs"
import { writeFileAtomic } from "./atomicfile"
import { join } from "node:path"
import { sha256, hmacSha256, toHex, utf8, secureHex } from "./crypto"
import { Field, fields, elements, build, quote } from "./json"
import { isoMs } from "./exports"
import { timeOf } from "./logapi"

export type AuditEvent = {
  seq: int,
  ts: f64, // ms since the epoch
  actor: string,
  action: string, // e.g. "virtual_key.create"
  target: string, // the object acted on, e.g. a provider name or a virtual key id
  method: string,
  path: string,
  status: int,
  ip?: string,
  detail?: string, // JSON text, secrets already masked by the caller
  prev: string, // hash of the previous event; 64 zeros for the first
  hash: string,
  sig: string,
}

export type AuditQuery = {
  actor?: string,
  action?: string,
  since?: f64,
  until?: f64,
  limit?: int,
  offset?: int,
  // Bifrost's list filters (any value of one filter, every filter given): CADF actions (Raiju's own action
  // names work too), outcomes, event types, initiator and target ids and types, request methods, path
  // prefixes, client addresses and tags; free text; the order by time ("asc" or "desc", the default); and a
  // cursor, the id of the last event of the page before
  actions?: string[],
  outcomes?: string[],
  eventTypes?: string[],
  initiatorIds?: string[],
  initiatorTypes?: string[],
  targetIds?: string[],
  targetTypes?: string[],
  methods?: string[],
  paths?: string[],
  ips?: string[],
  tags?: string[],
  search?: string,
  order?: string,
  cursor?: int,
  // audit.omit_ip_addresses: addresses are not matched (search and the ip filters skip them)
  omitIps?: bool,
}

// A page of events, with the total that match and whether more follow it.
export type AuditPage = { events: AuditEvent[], total: int, hasMore: bool }

export type VerifyResult = { ok: bool, checked: int, firstBad?: int, reason?: string }

const KEY_FILE = "audit.key"
const LOG_FILE = "audit.jsonl"
// Written by a retention prune: the last event it removed, so the chain verifies from the first event kept.
const ANCHOR_FILE = "audit-anchor.json"
// The object-storage archive's progress (archiveMark).
const MARK_FILE = "audit-archive.json"

type Anchor = { seq: int, hash: string }

// How far the archive copy has got: the last sequence number copied, and the end of its window (epoch ms).
export type ArchiveMark = { seq: int, until: f64 }

function readOptional(p: string): string | undefined {
  if (!existsSync(p)) return undefined
  try {
    return readFileSync(p, "utf8")
  } catch (e) {
    return undefined
  }
}

function readAnchor(dir: string): Anchor | undefined {
  const t = readOptional(join(dir, ANCHOR_FILE))
  if (t === undefined) return undefined
  try {
    return JSON.parse(t) as Anchor
  } catch (e) {
    return undefined
  }
}

function readMark(dir: string): ArchiveMark | undefined {
  const t = readOptional(join(dir, MARK_FILE))
  if (t === undefined) return undefined
  try {
    return JSON.parse(t) as ArchiveMark
  } catch (e) {
    return undefined
  }
}
const SECRET_FIELDS = ["value", "secret_key", "session_token", "auth_credentials", "password", "token", "subject_token"]

// Whether a log folder can be written: it is created when missing, then a probe file is written and removed. Returns
// "" or the problem. The request log store and the audit log check it at the start, so a folder they cannot write
// fails the start (or readiness) instead of every later write.
export function dirProblem(dir: string): string {
  const probe = join(dir, `.write-check-${process.pid}`)
  try {
    mkdirSync(dir, { recursive: true })
    writeFileSync(probe, "")
    unlinkSync(probe)
    return ""
  } catch (e) {
    return `${dir}: ${e.message}`
  }
}

function genesis(): string {
  let s = ""
  for (let i = 0; i < 64; i++) s += "0"
  return s
}

// The fixed-order JSON that the hash covers: every field except hash and sig.
// Optional fields are left out when absent, as JSON.stringify leaves them out.
function canonical(e: AuditEvent): string {
  const parts: string[] = []
  parts.push(quote("seq") + ":" + JSON.stringify(e.seq))
  parts.push(quote("ts") + ":" + JSON.stringify(e.ts))
  parts.push(quote("actor") + ":" + quote(e.actor))
  parts.push(quote("action") + ":" + quote(e.action))
  parts.push(quote("target") + ":" + quote(e.target))
  parts.push(quote("method") + ":" + quote(e.method))
  parts.push(quote("path") + ":" + quote(e.path))
  parts.push(quote("status") + ":" + JSON.stringify(e.status))
  const ip = e.ip
  if (ip !== undefined) parts.push(quote("ip") + ":" + quote(ip))
  const detail = e.detail
  if (detail !== undefined) parts.push(quote("detail") + ":" + quote(detail))
  parts.push(quote("prev") + ":" + quote(e.prev))
  return "{" + parts.join(",") + "}"
}

function digest(e: AuditEvent): string {
  return toHex(sha256(utf8(canonical(e))))
}

function sign(key: u8[], hash: string): string {
  return toHex(hmacSha256(key, utf8(hash)))
}

// A line that is not a complete event (a torn write, or a foreign line) is undefined.
function parseLine(line: string): AuditEvent | undefined {
  try {
    return JSON.parse(line) as AuditEvent
  } catch (err) {
    return undefined
  }
}

// With no key configured, the key is kept in <dir>/audit.key so signatures still
// verify after a restart. A new file is made readable by the service user only (0600).
function loadOrCreateKey(dir: string): string throws Error {
  const file = join(dir, KEY_FILE)
  if (existsSync(file)) {
    const stored = (try readFileSync(file, "utf8")).trim()
    if (stored !== "") return stored
  }
  const key = try secureHex(64)
  try writeFileAtomic(file, key + "\n", { mode: 384 })
  return key
}

// ---- Bifrost's CADF view of an event ----

export const CADF_TYPE_URI = "https://getbifrost.ai/schemas/auditlog.json"

// The CADF action of an event: create, update or delete for the writes, authenticate for a login, else access.
export function cadfAction(e: AuditEvent): string {
  const a = e.action
  const verb = a.includes(".") ? a.slice(a.indexOf(".") + 1) : a
  if (e.path.endsWith("/login")) return "authenticate"
  if (verb === "create" || verb === "post") return "create"
  if (verb === "update" || verb === "upsert" || verb === "put" || verb === "patch") return "update"
  if (verb === "delete") return "delete"
  return "access"
}

// success for an answer below 400, else failure.
export function outcomeOf(e: AuditEvent): string {
  return e.status < 400 ? "success" : "failure"
}

// The resource type of the caller: api_key for an API key, session for a temporary token, system for an
// unauthenticated or anonymous caller, else user.
export function initiatorTypeOf(actor: string): string {
  if (actor.startsWith("key:")) return "api_key"
  if (actor === "temp-token") return "session"
  if (actor === "anonymous" || actor === "unauthenticated" || actor === "") return "system"
  return "user"
}

// The resource type of the object acted on, from the action or the route.
export function targetTypeOf(e: AuditEvent): string {
  const a = e.action
  const prefix = a.includes(".") ? a.slice(0, a.indexOf(".")) : a
  if (prefix === "key" || prefix === "provider") return "provider"
  if (prefix !== "api") return prefix
  const segs = e.path.split("?")[0]!.split("/").filter((x) => x !== "")
  const first = segs.length > 1 ? segs[1]! : ""
  const second = segs.length > 2 ? segs[2]! : ""
  if (first === "providers" || first === "keys") return "provider"
  if (first === "governance") {
    if (second === "virtual-keys") return "virtual_key"
    if (second === "teams") return "team"
    if (second === "customers") return "customer"
    if (second === "roles") return "role"
    return "config"
  }
  if (first === "plugins") return "plugin"
  if (first === "guardrails") return "guardrail"
  if (first === "mcp") return second === "tool-groups" ? "mcp_tool_group" : "mcp_client"
  if (first === "session") return "session"
  if (first === "users") return "user"
  if (first === "roles" || first === "rbac") return "role"
  return "config"
}

// The id of the object acted on: the event's target, else its path.
function targetIdOf(e: AuditEvent): string {
  return e.target !== "" ? e.target : e.path.split("?")[0]!
}

// One event as Bifrost's CADF AuditEvent: the event id is its sequence number. The IP is left out with
// omitIps (audit.omit_ip_addresses hides the addresses older rows kept).
export function cadfJson(e: AuditEvent, omitIps: bool): string {
  const ip = omitIps ? undefined : e.ip
  const parts: string[] = [
    quote("id") + ":" + quote("" + e.seq),
    quote("typeURI") + ":" + quote(CADF_TYPE_URI),
    quote("eventType") + ":" + quote("activity"),
    quote("eventTime") + ":" + quote(isoMs(e.ts)),
    quote("action") + ":" + quote(cadfAction(e)),
    quote("outcome") + ":" + quote(outcomeOf(e)),
  ]
  const init: string[] = [quote("id") + ":" + quote(e.actor), quote("typeURI") + ":" + quote("bifrost/" + initiatorTypeOf(e.actor)), quote("name") + ":" + quote(e.actor)]
  if (ip !== undefined && ip !== "") init.push(quote("host") + ":" + quote(ip))
  parts.push(quote("initiator") + ":{" + init.join(",") + "}")
  parts.push(quote("target") + ":{" + quote("id") + ":" + quote(targetIdOf(e)) + "," + quote("typeURI") + ":" + quote("bifrost/" + targetTypeOf(e)) + "}")
  if (e.status >= 400) parts.push(quote("reason") + ":{" + quote("reasonCode") + ":" + quote("" + e.status) + "," + quote("reasonType") + ":" + quote("HTTP") + "}")
  const detail = e.detail
  if (detail !== undefined && detail !== "") parts.push(quote("attachments") + ":[{" + quote("name") + ":" + quote("request_body") + "," + quote("contentType") + ":" + quote("application/json") + "," + quote("content") + ":" + quote(detail) + "}]")
  parts.push(quote("tags") + ":[]")
  parts.push(quote("requestMethod") + ":" + quote(e.method))
  parts.push(quote("requestPath") + ":" + quote(e.path))
  if (ip !== undefined && ip !== "") parts.push(quote("requestIP") + ":" + quote(ip))
  parts.push(quote("raiju_action") + ":" + quote(e.action))
  parts.push(quote("status") + ":" + JSON.stringify(e.status))
  return "{" + parts.join(",") + "}"
}

function anyOf(want: string[] | undefined, v: string): bool {
  return want === undefined || want.length === 0 || want.includes(v)
}

function matches(e: AuditEvent, q: AuditQuery): bool {
  if (q.actor !== undefined && e.actor !== q.actor) return false
  if (q.action !== undefined && e.action !== q.action && cadfAction(e) !== q.action) return false
  if (q.since !== undefined && e.ts < q.since) return false
  if (q.until !== undefined && e.ts > q.until) return false
  const acts = q.actions
  if (acts !== undefined && acts.length > 0 && !acts.includes(e.action) && !acts.includes(cadfAction(e))) return false
  if (!anyOf(q.outcomes, outcomeOf(e))) return false
  if (!anyOf(q.eventTypes, "activity")) return false
  if (!anyOf(q.initiatorIds, e.actor)) return false
  if (!anyOf(q.initiatorTypes, initiatorTypeOf(e.actor))) return false
  if (!anyOf(q.targetIds, targetIdOf(e))) return false
  if (!anyOf(q.targetTypes, targetTypeOf(e))) return false
  if (!anyOf(q.methods, e.method)) return false
  const ps = q.paths
  if (ps !== undefined && ps.length > 0 && !ps.some((x) => e.path.startsWith(x))) return false
  if (q.omitIps !== true && !anyOf(q.ips, e.ip ?? "")) return false
  // Raiju's events carry no tags, so a tag filter matches none
  const tags = q.tags
  if (tags !== undefined && tags.length > 0) return false
  const text = (q.search ?? "").trim().toLowerCase()
  if (text !== "") {
    const hay = [e.actor, e.action, cadfAction(e), targetIdOf(e), e.path, e.method, outcomeOf(e)]
    if (q.omitIps !== true) hay.push(e.ip ?? "")
    if (!hay.some((x) => x.toLowerCase().includes(text))) return false
  }
  return true
}

export class AuditLog {
  private file: string
  private keyBytes: u8[]
  private cap: int
  private mem: AuditEvent[] = []
  private lastSeq: int = 0
  private lastHash: string = genesis()

  // The chain continues from the newest parseable event already in the file.
  constructor(readonly dir: string, key: string, maxMemory: int) throws Error {
    this.file = join(dir, LOG_FILE)
    this.cap = Math.max(1, maxMemory)
    try mkdirSync(dir, { recursive: true })
    const problem = dirProblem(dir)
    if (problem !== "") throw new Error(problem)
    const k = key === "" ? try loadOrCreateKey(dir) : key
    this.keyBytes = utf8(k)
    // after a prune the file may start past sequence 1: the anchor says where the chain stands
    const a = readAnchor(dir)
    if (a !== undefined) {
      this.lastSeq = a.seq
      this.lastHash = a.hash
    }
    if (existsSync(this.file)) {
      for (const line of try readFileSync(this.file, "utf8").split("\n")) {
        const e = parseLine(line)
        if (e === undefined) continue
        this.lastSeq = e.seq
        this.lastHash = e.hash
        this.remember(e)
      }
    }
  }

  // Appends one event. If the write fails it throws and the chain does not
  // advance, so no later event links to one that is not on disk.
  record(actor: string, action: string, target: string, method: string, path: string, status: int, ip: string | undefined, detail: string | undefined, nowMs: f64): AuditEvent throws Error {
    const e: AuditEvent = {
      seq: this.lastSeq + 1,
      ts: nowMs,
      actor: actor,
      action: action,
      target: target,
      method: method,
      path: path,
      status: status,
      ip: ip,
      detail: detail,
      prev: this.lastHash,
      hash: "",
      sig: "",
    }
    e.hash = digest(e)
    e.sig = sign(this.keyBytes, e.hash)
    try appendFileSync(this.file, JSON.stringify(e) + "\n")
    this.lastSeq = e.seq
    this.lastHash = e.hash
    this.remember(e)
    return e
  }

  // The sequence number of the newest event (0 when there are none), which a prune does not lower.
  lastSequence(): int {
    return this.lastSeq
  }

  // Deletes the events older than cutoffMs, from the file and from memory, as a retention prune does. The
  // last one removed goes into the anchor file, so verify starts from the first event kept. Returns how
  // many were removed.
  pruneBefore(cutoffMs: f64): int throws Error {
    if (!existsSync(this.file)) return 0
    const keep: string[] = []
    let removed: int = 0
    let last: Anchor = { seq: 0, hash: "" }
    for (const line of try readFileSync(this.file, "utf8").split("\n")) {
      if (line === "") continue
      const e = parseLine(line)
      if (keep.length === 0 && e !== undefined && e.ts < cutoffMs) {
        removed += 1
        last = { seq: e.seq, hash: e.hash }
        continue
      }
      keep.push(line)
    }
    if (removed === 0) return 0
    // the anchor is written before the file shrinks, so a crash between the two leaves a longer file
    try writeFileAtomic(join(this.dir, ANCHOR_FILE), JSON.stringify(last))
    try writeFileAtomic(this.file, keep.length === 0 ? "" : keep.join("\n") + "\n")
    this.mem = this.mem.filter((e) => e.seq > last.seq)
    return removed
  }

  // The events after sequence afterSeq and before beforeMs, as JSONL, with the last sequence number they
  // reach (afterSeq when none). The archive copies these.
  exportWindow(afterSeq: int, beforeMs: f64): { body: string, count: int, last: int } throws Error {
    let body = ""
    let count: int = 0
    let last: int = afterSeq
    if (!existsSync(this.file)) return { body: body, count: count, last: last }
    for (const line of try readFileSync(this.file, "utf8").split("\n")) {
      const e = parseLine(line)
      if (e === undefined || e.seq <= afterSeq || e.ts >= beforeMs) continue
      body += line + "\n"
      count += 1
      last = e.seq
    }
    return { body: body, count: count, last: last }
  }

  // The archive copy's progress, or undefined before it has run.
  archiveMark(): ArchiveMark | undefined {
    return readMark(this.dir)
  }

  setArchiveMark(m: ArchiveMark): void throws Error {
    try writeFileAtomic(join(this.dir, MARK_FILE), JSON.stringify(m))
  }

  // Re-reads the whole file and checks each event in order: seq runs 1, 2, 3 ...;
  // prev is the hash before it; hash is the digest of its content; sig is the
  // HMAC of the hash under this log's key. Stops at the first failure.
  // Removing the newest lines is not visible here: that needs an external anchor.
  verify(): VerifyResult throws Error {
    if (!existsSync(this.file)) return { ok: true, checked: 0 }
    let checked: int = 0
    let seq: int = 0
    let prev = genesis()
    const start = readAnchor(this.dir)
    if (start !== undefined) {
      seq = start.seq
      prev = start.hash
    }
    for (const line of try readFileSync(this.file, "utf8").split("\n")) {
      if (line === "") continue
      const want = seq + 1
      const e = parseLine(line)
      if (e === undefined) return { ok: false, checked: checked, firstBad: want, reason: "line is not a complete event" }
      if (e.seq !== want) return { ok: false, checked: checked, firstBad: want, reason: "seq is " + e.seq + ", expected " + want }
      if (e.prev !== prev) return { ok: false, checked: checked, firstBad: want, reason: "prev does not match the previous event's hash" }
      const hash = digest(e)
      if (e.hash !== hash) return { ok: false, checked: checked, firstBad: want, reason: "hash does not match the event content" }
      if (e.sig !== sign(this.keyBytes, hash)) return { ok: false, checked: checked, firstBad: want, reason: "signature does not verify with this key" }
      seq = want
      prev = hash
      checked += 1
    }
    return { ok: true, checked: checked }
  }

  // Events in memory, newest first (oldest first with order "asc"). Limit is clamped to 1000 and defaults
  // to 50. total counts every match; a cursor starts the page after that event, offset skips past it.
  query(q: AuditQuery): AuditPage {
    const limit = Math.min(1000, Math.max(0, q.limit ?? 50))
    const offset = Math.max(0, q.offset ?? 0)
    const asc = q.order === "asc"
    const cursor = q.cursor
    const events: AuditEvent[] = []
    let total = 0
    let skipped = 0
    let more = false
    const n = this.mem.length
    for (let k = 0; k < n; k++) {
      const e = this.mem[asc ? k : n - 1 - k]!
      if (!matches(e, q)) continue
      total += 1
      if (cursor !== undefined && (asc ? e.seq <= cursor : e.seq >= cursor)) continue
      if (skipped < offset) {
        skipped += 1
        continue
      }
      if (events.length < limit) events.push(e)
      else more = true
    }
    return { events: events, total: total, hasMore: more }
  }

  // The event with this id from memory, else from the file (an older event the memory window dropped).
  findAny(seq: int): AuditEvent | undefined throws Error {
    const m = this.find(seq)
    if (m !== undefined) return m
    if (!existsSync(this.file)) return undefined
    for (const line of try readFileSync(this.file, "utf8").split("\n")) {
      const e = parseLine(line)
      if (e !== undefined && e.seq === seq) return e
    }
    return undefined
  }

  // Bifrost's per-event check: the signature computed again from the event's stored fields, compared in
  // constant time with the one stored. computed covers the content as it stands, so an edited field shows.
  verifyOne(e: AuditEvent): { valid: bool, computed: string, stored: string } {
    const computed = sign(this.keyBytes, digest(e))
    return { valid: sameText(computed, e.sig), computed: computed, stored: e.sig }
  }

  // The event with this id (its sequence number), from memory.
  find(seq: int): AuditEvent | undefined {
    for (const e of this.mem) {
      if (e.seq === seq) return e
    }
    return undefined
  }

  // The distinct values the audit filters offer, from the events in memory, sorted: Bifrost's dimensions
  // (actions, outcomes, event_types, initiator_types, target_types, request_methods, initiators, targets,
  // request_paths, request_ips, tags) and Raiju's own (actors, methods, paths, ips). actions holds the CADF
  // actions and Raiju's action names, since the action filter takes both. dims limits the Bifrost dimensions
  // (all when empty; unknown names are ignored), q keeps the values that hold it (ignoring case), and omitIps
  // leaves the addresses out.
  filterData(dims: string[], q: string, omitIps: bool): string {
    let actors: string[] = []
    let actions: string[] = []
    let outcomes: string[] = []
    let initTypes: string[] = []
    let targetTypes: string[] = []
    let methods: string[] = []
    let paths: string[] = []
    let ips: string[] = []
    let targets: string[] = []
    for (const e of this.mem) {
      addUnique(&actors, e.actor)
      addUnique(&actions, e.action)
      addUnique(&actions, cadfAction(e))
      addUnique(&outcomes, outcomeOf(e))
      addUnique(&initTypes, initiatorTypeOf(e.actor))
      addUnique(&targetTypes, targetTypeOf(e))
      addUnique(&methods, e.method)
      addUnique(&paths, e.path)
      addUnique(&targets, targetIdOf(e))
      if (!omitIps) addUnique(&ips, e.ip ?? "")
    }
    const needle = q.trim().toLowerCase()
    const keep = (xs: string[]): string[] => {
      const out = xs.filter((x) => needle === "" || x.toLowerCase().includes(needle))
      return out.sort((a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0))
    }
    const strs = (xs: string[]): string => "[" + keep(xs).map((x) => quote(x)).join(",") + "]"
    const pairs = (xs: string[]): string => "[" + keep(xs).map((x) => "{" + quote("id") + ":" + quote(x) + "," + quote("name") + ":" + quote(x) + "}").join(",") + "]"
    const want = (d: string): bool => dims.length === 0 || dims.includes(d)
    const out: string[] = []
    if (want("actions")) out.push(quote("actions") + ":" + strs(actions))
    if (want("outcomes")) out.push(quote("outcomes") + ":" + strs(outcomes))
    if (want("event_types")) out.push(quote("event_types") + ":" + strs(this.mem.length > 0 ? ["activity"] : []))
    if (want("initiator_types")) out.push(quote("initiator_types") + ":" + strs(initTypes))
    if (want("target_types")) out.push(quote("target_types") + ":" + strs(targetTypes))
    if (want("request_methods")) out.push(quote("request_methods") + ":" + strs(methods))
    if (want("initiators")) out.push(quote("initiators") + ":" + pairs(actors))
    if (want("targets")) out.push(quote("targets") + ":" + pairs(targets))
    if (want("request_paths")) out.push(quote("request_paths") + ":" + strs(paths))
    if (want("request_ips")) out.push(quote("request_ips") + ":" + strs(ips))
    if (want("tags")) out.push(quote("tags") + ":[]")
    out.push(quote("actors") + ":" + strs(actors))
    out.push(quote("methods") + ":" + strs(methods))
    out.push(quote("paths") + ":" + strs(paths))
    out.push(quote("ips") + ":" + strs(ips))
    return "{" + out.join(",") + "}"
  }

  // The file's lines, unchanged, so each one still verifies on its own. With a
  // range, lines that cannot be read are left out, since they have no time.
  exportJsonl(since?: f64, until?: f64): string throws Error {
    if (!existsSync(this.file)) return ""
    const ranged = since !== undefined || until !== undefined
    const out: string[] = []
    for (const line of try readFileSync(this.file, "utf8").split("\n")) {
      if (line === "") continue
      const e = parseLine(line)
      if (e === undefined) {
        if (!ranged) out.push(line)
        continue
      }
      if (since !== undefined && e.ts < since) continue
      if (until !== undefined && e.ts > until) continue
      out.push(line)
    }
    return out.length === 0 ? "" : out.join("\n") + "\n"
  }

  private remember(e: AuditEvent): void {
    this.mem.push(e)
    if (this.mem.length > this.cap) this.mem = this.mem.slice(this.mem.length - this.cap)
  }
}

// ---- Bifrost's list query (GET /api/audit-logs) ----

// A filter given as a single value (action) or a JSON array (actions); the array wins. An array that is not
// JSON is read as a comma-separated list.
function multi(sp: URLSearchParams, one: string, many: string): string[] | undefined {
  const raw = (sp.get(many) ?? "").trim()
  if (raw !== "") {
    let vs: string[] = []
    try {
      vs = JSON.parse(raw) as string[]
    } catch (e) {
      vs = raw.split(",")
    }
    const out: string[] = []
    for (const v of vs) {
      const t = v.trim()
      if (t !== "") out.push(t)
    }
    return out
  }
  const single = (sp.get(one) ?? "").trim()
  return single === "" ? undefined : [single]
}

// 2026-10-14 or RFC 3339 as epoch ms; a bare date is the start of that day, or its end with endOfDay.
function dateMs(raw: string, endOfDay: bool): f64 | undefined {
  const t = raw.trim()
  if (t === "") return undefined
  if (t.byteLength === 10 && !t.includes("T")) {
    const d = timeOf(t + "T00:00:00Z")
    if (d === undefined) return undefined
    return endOfDay ? d + 86399999.0 : d
  }
  return timeOf(t)
}

// A relative window such as 30m, 24h or 7d in ms; undefined when it is not one.
function periodMs(raw: string): f64 | undefined {
  const t = raw.trim()
  if (t.byteLength < 2) return undefined
  const unit = t.endsWith("d") ? 86400000.0 : t.endsWith("h") ? 3600000.0 : t.endsWith("m") ? 60000.0 : t.endsWith("s") ? 1000.0 : 0.0
  const n = parseFloat(t.slice(0, t.byteLength - 1)) ?? 0.0
  return unit > 0.0 && n > 0.0 ? n * unit : undefined
}

export type AuditListQuery = { q: AuditQuery, page: int, limit: int, error: string }

function badQuery(m: string): AuditListQuery {
  return { q: {}, page: 1, limit: 100, error: m }
}

// The query of GET /api/audit-logs: Bifrost's page, limit (default 100, at most 1000), cursor, search,
// filters, start_date, end_date, period and sort_order, and Raiju's actor, since, until and offset.
export function auditQueryOf(sp: URLSearchParams, now: f64, omitIps: bool): AuditListQuery {
  const q: AuditQuery = {}
  let limit = 100
  const lr = (sp.get("limit") ?? "").trim()
  if (lr !== "") {
    const l = parseInt(lr)
    if (l === undefined || l < 1) return badQuery("limit must be a positive integer")
    limit = Math.min(1000, l)
  }
  let page = 1
  const pr = (sp.get("page") ?? "").trim()
  if (pr !== "") {
    const pg = parseInt(pr)
    if (pg === undefined || pg < 1) return badQuery("page must be a positive integer")
    page = pg
  }
  q.limit = limit
  const off = parseInt((sp.get("offset") ?? "").trim())
  q.offset = pr === "" && off !== undefined && off > 0 ? off : (page - 1) * limit
  const cr = (sp.get("cursor") ?? "").trim()
  if (cr !== "") {
    const c = parseInt(cr)
    if (c === undefined || c < 0) return badQuery("invalid cursor")
    q.cursor = c
    q.offset = 0
  }
  const actor = (sp.get("actor") ?? "").trim()
  if (actor !== "") q.actor = actor
  q.actions = multi(sp, "action", "actions")
  q.outcomes = multi(sp, "outcome", "outcomes")
  q.eventTypes = multi(sp, "event_type", "event_types")
  q.initiatorIds = multi(sp, "initiator_id", "initiator_ids")
  q.initiatorTypes = multi(sp, "initiator_type", "initiator_types")
  q.targetIds = multi(sp, "target_id", "target_ids")
  q.targetTypes = multi(sp, "target_type", "target_types")
  q.methods = multi(sp, "request_method", "request_methods")
  q.paths = multi(sp, "request_path", "request_paths")
  q.ips = multi(sp, "request_ip", "request_ips")
  q.tags = multi(sp, "tags", "tags")
  const search = (sp.get("search") ?? "").trim()
  if (search !== "") q.search = search
  q.omitIps = omitIps
  const order = (sp.get("sort_order") ?? sp.get("order") ?? "desc").trim().toLowerCase()
  if (order !== "asc" && order !== "desc") return badQuery("sort_order must be asc or desc")
  q.order = order
  // a period overrides start_date and end_date; since and until (epoch ms) are Raiju's own bounds
  const per = (sp.get("period") ?? "").trim()
  if (per !== "") {
    const span = periodMs(per)
    if (span === undefined) return badQuery(`invalid period "${per}"`)
    q.since = now - span
  } else {
    const sd = sp.get("start_date") ?? ""
    const ed = sp.get("end_date") ?? ""
    if (sd !== "") {
      const v = dateMs(sd, false)
      if (v === undefined) return badQuery("invalid start_date")
      q.since = v
    }
    if (ed !== "") {
      const v = dateMs(ed, true)
      if (v === undefined) return badQuery("invalid end_date")
      q.until = v
    }
  }
  const since = parseFloat((sp.get("since") ?? "").trim())
  if (since !== undefined) q.since = since
  const until = parseFloat((sp.get("until") ?? "").trim())
  if (until !== undefined) q.until = until
  return { q: q, page: page, limit: limit, error: "" }
}

// The list answer: Bifrost's audit_logs (CADF events), total, page, limit, total_pages, has_more and
// next_cursor, with Raiju's own events alongside. IPs are left out of both with omitIps.
export function auditListJson(r: AuditPage, page: int, limit: int, omitIps: bool): string {
  const cadf: string[] = []
  const own: string[] = []
  for (const e of r.events) {
    cadf.push(cadfJson(e, omitIps))
    const shown: AuditEvent = e
    if (omitIps) shown.ip = undefined
    own.push(JSON.stringify(shown))
  }
  const pages = limit <= 0 ? 0 : Math.floor((r.total + limit - 1) / limit)
  const last = r.events.length > 0 ? r.events[r.events.length - 1]! : undefined
  const parts: string[] = [
    quote("audit_logs") + ":[" + cadf.join(",") + "]",
    quote("total") + ":" + JSON.stringify(r.total),
    quote("page") + ":" + JSON.stringify(page),
    quote("limit") + ":" + JSON.stringify(limit),
    quote("total_pages") + ":" + JSON.stringify(pages),
    quote("has_more") + ":" + (r.hasMore ? "true" : "false"),
  ]
  if (r.hasMore && last !== undefined) parts.push(quote("next_cursor") + ":" + quote("" + last.seq))
  parts.push(quote("events") + ":[" + own.join(",") + "]")
  return "{" + parts.join(",") + "}"
}

function addUnique(inout xs: string[], v: string): void {
  if (v !== "" && !xs.includes(v)) xs.push(v)
}

// Equal strings, compared without stopping at the first difference.
function sameText(a: string, b: string): bool {
  const x = utf8(a)
  const y = utf8(b)
  let diff = x.length === y.length ? 0 : 1
  const n = Math.min(x.length, y.length)
  for (let i = 0; i < n; i++) diff = diff | (int(x[i]!) ^ int(y[i]!))
  return diff === 0
}

// The singular object name of a governance collection, or undefined.
function singular(collection: string): string | undefined {
  if (collection === "virtual-keys") return "virtual_key"
  if (collection === "budgets") return "budget"
  if (collection === "rate-limits") return "rate_limit"
  if (collection === "teams") return "team"
  if (collection === "customers") return "customer"
  return undefined
}

// The admin action a management API request performs, and the object it acts on.
// Routes not listed here are recorded as api.<method> with the path as target.
export function actionFor(method: string, path: string): { action: string, target: string } {
  const m = method.toUpperCase()
  const q = path.indexOf("?")
  const p = q < 0 ? path : path.slice(0, q)
  const segs = p.split("/").filter((s) => s !== "")
  const generic = { action: "api." + m.toLowerCase(), target: p }
  if (segs[0] === "api" && segs[1] === "providers" && segs.length >= 3) {
    const name = segs[2]!
    if (segs.length === 3) {
      if (m === "PUT") return { action: "provider.upsert", target: name }
      if (m === "DELETE") return { action: "provider.delete", target: name }
    }
    if (segs.length === 4 && segs[3] === "keys" && m === "POST") return { action: "key.create", target: name }
    if (segs.length === 5 && segs[3] === "keys") {
      const target = name + "/" + segs[4]!
      if (m === "PUT") return { action: "key.update", target: target }
      if (m === "DELETE") return { action: "key.delete", target: target }
    }
    return generic
  }
  if (segs[0] === "api" && segs[1] === "governance" && segs.length >= 3) {
    const sing = singular(segs[2]!)
    if (sing !== undefined) {
      if (segs.length === 3 && m === "POST") return { action: sing + ".create", target: "" }
      if (segs.length === 4) {
        const id = segs[3]!
        if (m === "PUT") return { action: sing + ".update", target: id }
        if (m === "DELETE") return { action: sing + ".delete", target: id }
      }
    }
  }
  return generic
}

// The access-profile change an audit event records (Bifrost's per-profile audit actions: create, update, delete,
// propagate, attach_role, detach_role, clone, activate, deactivate), with the profile it concerns; undefined for any
// other event, or a change that was refused. A create names its profile by the body's id, else its name.
export function profileChange(e: AuditEvent): { profile: string, action: string } | undefined {
  if (e.status >= 300) return undefined
  const q = e.path.indexOf("?")
  const p = q < 0 ? e.path : e.path.slice(0, q)
  const segs = p.split("/").filter((s) => s !== "")
  if (segs[0] !== "api" || segs[1] !== "governance" || segs[2] !== "access-profiles") return undefined
  const m = e.method.toUpperCase()
  if (segs.length === 3) {
    if (m !== "POST") return undefined
    let id = ""
    try {
      const fs = fields(e.detail ?? "{}")
      for (const f of fs) {
        if (f.key === "id" && f.raw.startsWith("\"")) id = f.raw.slice(1, f.raw.byteLength - 1)
      }
      if (id === "") {
        for (const f of fs) {
          if (f.key === "name" && f.raw.startsWith("\"")) id = f.raw.slice(1, f.raw.byteLength - 1)
        }
      }
    } catch (err) {
      id = ""
    }
    return { profile: id, action: "create" }
  }
  const id = segs[3]!
  if (id === "audit-logs") return undefined
  if (segs.length === 4) {
    if (m === "PUT" || m === "PATCH") return { profile: id, action: "update" }
    if (m === "DELETE") return { profile: id, action: "delete" }
    return undefined
  }
  const sub = segs[4]!
  if (segs.length === 5 && m === "POST") {
    if (sub === "propagate" || sub === "clone" || sub === "activate" || sub === "deactivate") return { profile: id, action: sub }
    if (sub === "roles") return { profile: id, action: "attach_role" }
  }
  if (segs.length === 6 && sub === "roles" && m === "DELETE") return { profile: id, action: "detach_role" }
  return undefined
}

// GET /api/governance/access-profiles/audit-logs and .../{profile_id}/audit-logs in Bifrost's AuditLogListResponse:
// the access-profile changes of the trail (events newest first), for one profile or all, filtered by action and by
// user_id (the user who made the change), then paged (limit, default 50, and offset).
export function profileAuditJson(events: AuditEvent[], profile: string | undefined, action: string, user: string, limit: int, offset: int): string {
  const rows: string[] = []
  let total = 0
  for (const e of events) {
    const c = profileChange(e)
    if (c === undefined) continue
    if (profile !== undefined && c.profile !== profile) continue
    if (action !== "" && c.action !== action) continue
    const uid = initiatorTypeOf(e.actor) === "user" ? e.actor : ""
    if (user !== "" && uid !== user) continue
    total += 1
    if (total <= offset || rows.length >= limit) continue
    const parts: string[] = [
      quote("id") + ":" + `${e.seq}`,
      quote("access_profile_id") + ":" + (c.profile === "" ? "null" : quote(c.profile)),
      quote("user_id") + ":" + (uid === "" ? "null" : quote(uid)),
      quote("actor") + ":" + quote(e.actor),
      quote("action") + ":" + quote(c.action),
      quote("previous_values") + ":null",
      quote("new_values") + ":" + (e.detail === undefined || e.detail === "" ? "null" : quote(e.detail)),
      quote("metadata") + ":" + quote(`{"method":${quote(e.method)},"path":${quote(e.path)}}`),
      quote("created_at") + ":" + quote(isoMs(e.ts)),
    ]
    rows.push("{" + parts.join(",") + "}")
  }
  return `{"audit_logs":[${rows.join(",")}],"total_count":${total}}`
}

// The JSON body with the value of every secret field replaced by "****", at any
// depth inside objects and arrays. A body that is not a JSON object or array
// becomes "" rather than being logged raw.
export function maskDetail(body: string): string {
  const t = body.trim()
  if (!t.startsWith("{") && !t.startsWith("[")) return ""
  try {
    return maskRaw(t)
  } catch (err) {
    return ""
  }
}

function maskRaw(raw: string): string throws SyntaxError {
  if (raw.startsWith("[")) {
    const parts: string[] = []
    for (const el of try elements(raw)) {
      const masked = try maskRaw(el)
      parts.push(masked)
    }
    return "[" + parts.join(",") + "]"
  }
  if (raw.startsWith("{")) {
    const out: Field[] = []
    for (const f of try fields(raw)) {
      const isSecret = SECRET_FIELDS.includes(f.key.toLowerCase()) && f.raw !== "null"
      if (isSecret) {
        out.push({ key: f.key, raw: quote("****") })
      } else {
        const masked = try maskRaw(f.raw)
        out.push({ key: f.key, raw: masked })
      }
    }
    return build(out)
  }
  return raw
}

function tmpDir(): string {
  const r = try secureHex(12)
  return "/tmp/raiju-audit-test-" + r
}

function expectAction(method: string, path: string, action: string, target: string): void {
  const r = actionFor(method, path)
  expect(r.action).toBe(action)
  expect(r.target).toBe(target)
}

const TEST_KEY = "test-key-0123456789"

test("a retention prune keeps the chain verifiable from the first event kept, across a reload", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    try log.record("alice", "provider.upsert", "openai", "PUT", "/api/providers/openai", 200, undefined, undefined, 1000.0)
    try log.record("alice", "provider.upsert", "openai", "PUT", "/api/providers/openai", 200, undefined, undefined, 2000.0)
    try log.record("alice", "provider.upsert", "openai", "PUT", "/api/providers/openai", 200, undefined, undefined, 3000.0)
    expect(try log.pruneBefore(2500.0)).toBe(2)
    expect(try log.verify().ok).toBe(true)
    expect(try log.verify().checked).toBe(1)
    expect(log.query({}).total).toBe(1)
    // a reload reads the anchor, so numbering and the chain go on
    const again = try new AuditLog(dir, TEST_KEY, 100)
    expect(again.lastSequence()).toBe(3)
    const e4 = try again.record("alice", "provider.upsert", "openai", "PUT", "/api/providers/openai", 200, undefined, undefined, 4000.0)
    expect(e4.seq).toBe(4)
    expect(try again.verify().checked).toBe(2)
    // the archive copy takes what is after its mark and before its window's end
    expect(again.archiveMark()).toBeUndefined()
    try again.setArchiveMark({ seq: 3, until: 3500.0 })
    expect(again.archiveMark()!.seq).toBe(3)
    const w = try again.exportWindow(3, 9000.0)
    expect(w.count).toBe(1)
    expect(w.last).toBe(4)
    expect(w.body.includes(`"seq":4`)).toBe(true)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("dirProblem accepts a folder it can write and names one it cannot", () => {
  const dir = "/tmp/raiju-audit-dircheck-" + process.pid
  expect(dirProblem(dir + "/nested")).toBe("")
  expect(existsSync(dir + "/nested")).toBe(true)
  // a file where the folder should be cannot hold the log
  try writeFileSync(dir + "/plain", "x")
  expect(dirProblem(dir + "/plain/sub") !== "").toBe(true)
  let threw = false
  try {
    const a = try new AuditLog(dir + "/plain/sub", "k", 10)
    expect(a.dir).toBe("unreachable")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  try rmSync(dir, { recursive: true, force: true })
})

test("records chain: each event links to the hash before it", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    const a = try log.record("alice", "virtual_key.create", "", "POST", "/api/governance/virtual-keys", 201, "10.0.0.1", "{}", 1000.0)
    const b = try log.record("alice", "provider.upsert", "openai", "PUT", "/api/providers/openai", 200, undefined, undefined, 2000.0)
    const c = try log.record("ops-é", "provider.delete", "openai", "DELETE", "/api/providers/openai", 200, undefined, undefined, 3000.0)
    expect(a.seq).toBe(1)
    expect(b.seq).toBe(2)
    expect(c.seq).toBe(3)
    expect(a.prev).toBe(genesis())
    expect(b.prev).toBe(a.hash)
    expect(c.prev).toBe(b.hash)
    expect(a.hash.byteLength).toBe(64)
    expect(a.sig.byteLength).toBe(64)
    expect(a.hash === b.hash).toBe(false)
    expect(a.ip).toBe("10.0.0.1")
    expect(b.ip).toBeUndefined()
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("verify accepts an intact log and reports how many it checked", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    try log.record("alice", "a.one", "", "PUT", "/api/providers/x", 200, undefined, "{\"keys\":[]}", 1.0)
    try log.record("alice", "a.two", "", "PUT", "/api/providers/y", 200, undefined, undefined, 2.0)
    try log.record("bob", "a.three", "", "DELETE", "/api/providers/y", 200, undefined, undefined, 3.0)
    const r = try log.verify()
    expect(r.ok).toBe(true)
    expect(r.checked).toBe(3)
    expect(r.firstBad).toBeUndefined()
    expect((try new AuditLog(dir + "-empty", TEST_KEY, 5).verify()).ok).toBe(true)
    try rmSync(dir + "-empty", { recursive: true, force: true })
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("editing a line is detected at that line's seq", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    try log.record("alice", "a.one", "", "PUT", "/api/providers/x", 200, undefined, undefined, 1.0)
    try log.record("alice", "a.two", "", "PUT", "/api/providers/y", 200, undefined, undefined, 2.0)
    try log.record("alice", "a.three", "", "PUT", "/api/providers/z", 200, undefined, undefined, 3.0)
    const path = join(dir, "audit.jsonl")
    const lines = try readFileSync(path, "utf8").split("\n")
    lines[1] = lines[1]!.replaceAll("\"alice\"", "\"mallory\"")
    try writeFileSync(path, lines.join("\n"))
    const r = try log.verify()
    expect(r.ok).toBe(false)
    expect(r.checked).toBe(1)
    expect(r.firstBad).toBe(2)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("deleting a line is detected as a seq gap", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    try log.record("alice", "a.one", "", "PUT", "/api/providers/x", 200, undefined, undefined, 1.0)
    try log.record("alice", "a.two", "", "PUT", "/api/providers/y", 200, undefined, undefined, 2.0)
    try log.record("alice", "a.three", "", "PUT", "/api/providers/z", 200, undefined, undefined, 3.0)
    const path = join(dir, "audit.jsonl")
    const lines = try readFileSync(path, "utf8").split("\n").filter((l) => l !== "")
    const kept = lines.filter((_l, i) => i !== 1)
    try writeFileSync(path, kept.join("\n") + "\n")
    const r = try new AuditLog(dir, TEST_KEY, 100).verify()
    expect(r.ok).toBe(false)
    expect(r.checked).toBe(1)
    expect(r.firstBad).toBe(2)
    expect(r.reason!.includes("seq is 3")).toBe(true)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("a new log on the same dir continues the chain after a restart", () => {
  const dir = try tmpDir()
  try {
    const a = try new AuditLog(dir, TEST_KEY, 100)
    try a.record("alice", "a.one", "", "PUT", "/api/providers/x", 200, undefined, undefined, 1.0)
    const last = try a.record("alice", "a.two", "", "PUT", "/api/providers/y", 200, undefined, undefined, 2.0)
    const b = try new AuditLog(dir, TEST_KEY, 100)
    expect(b.query({}).total).toBe(2)
    const next = try b.record("bob", "a.three", "", "DELETE", "/api/providers/y", 200, undefined, undefined, 3.0)
    expect(next.seq).toBe(3)
    expect(next.prev).toBe(last.hash)
    const r = try b.verify()
    expect(r.ok).toBe(true)
    expect(r.checked).toBe(3)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("a signature made with another key fails verification", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    try log.record("alice", "a.one", "", "PUT", "/api/providers/x", 200, undefined, undefined, 1.0)
    const other = try new AuditLog(dir, "some-other-key", 100)
    const r = try other.verify()
    expect(r.ok).toBe(false)
    expect(r.firstBad).toBe(1)
    expect(r.reason!.includes("signature")).toBe(true)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("an empty key generates one that is persisted and reused", () => {
  const dir = try tmpDir()
  try {
    const a = try new AuditLog(dir, "", 100)
    try a.record("alice", "a.one", "", "PUT", "/api/providers/x", 200, undefined, undefined, 1.0)
    const stored = try readFileSync(join(dir, "audit.key"), "utf8")
    expect(stored.trim().byteLength).toBe(64)
    const b = try new AuditLog(dir, "", 100)
    expect((try b.verify()).ok).toBe(true)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("actionFor maps management routes to actions and targets", () => {
  expectAction("PUT", "/api/providers/openai", "provider.upsert", "openai")
  expectAction("DELETE", "/api/providers/openai", "provider.delete", "openai")
  expectAction("POST", "/api/providers/openai/keys", "key.create", "openai")
  expectAction("DELETE", "/api/providers/openai/keys/k1", "key.delete", "openai/k1")
  expectAction("POST", "/api/governance/virtual-keys", "virtual_key.create", "")
  expectAction("PUT", "/api/governance/virtual-keys/vk1?x=1", "virtual_key.update", "vk1")
  expectAction("DELETE", "/api/governance/virtual-keys/vk1", "virtual_key.delete", "vk1")
  expectAction("POST", "/api/governance/budgets", "budget.create", "")
  expectAction("PUT", "/api/governance/rate-limits/rl", "rate_limit.update", "rl")
  expectAction("DELETE", "/api/governance/teams/t1", "team.delete", "t1")
  expectAction("POST", "/api/governance/customers", "customer.create", "")
  expectAction("GET", "/api/config", "api.get", "/api/config")
  expectAction("POST", "/api/unknown/x", "api.post", "/api/unknown/x")
})

test("maskDetail masks secret fields at any depth and keeps the rest", () => {
  const body = "{\"keys\":[{\"value\":\"sk-abc\",\"id\":\"1\"}],\"meta\":{\"token\":\"t\",\"name\":\"n\"},\"list\":[1,\"a\",{\"password\":\"p\"}],\"x\":null,\"auth_credentials\":{\"a\":1}}"
  const want = "{\"keys\":[{\"value\":\"****\",\"id\":\"1\"}],\"meta\":{\"token\":\"****\",\"name\":\"n\"},\"list\":[1,\"a\",{\"password\":\"****\"}],\"x\":null,\"auth_credentials\":\"****\"}"
  expect(maskDetail(body)).toBe(want)
  expect(maskDetail("{\"name\":\"gpt\"}")).toBe("{\"name\":\"gpt\"}")
  expect(maskDetail("[{\"session_token\":\"s\"}]")).toBe("[{\"session_token\":\"****\"}]")
  expect(maskDetail("not json")).toBe("")
  expect(maskDetail("{\"value\":")).toBe("")
})

test("query filters by actor, action and time, newest first, with paging", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    try log.record("alice", "provider.upsert", "openai", "PUT", "/api/providers/openai", 200, undefined, undefined, 1000.0)
    try log.record("bob", "virtual_key.create", "", "POST", "/api/governance/virtual-keys", 201, undefined, undefined, 2000.0)
    try log.record("alice", "virtual_key.delete", "vk1", "DELETE", "/api/governance/virtual-keys/vk1", 200, undefined, undefined, 3000.0)
    try log.record("carol", "provider.delete", "openai", "DELETE", "/api/providers/openai", 200, undefined, undefined, 4000.0)

    const all = log.query({})
    expect(all.total).toBe(4)
    expect(all.events[0]!.seq).toBe(4)
    expect(all.events[3]!.seq).toBe(1)
    expect(log.query({ actor: "alice" }).total).toBe(2)
    expect(log.query({ action: "provider.delete" }).total).toBe(1)
    expect(log.query({ actor: "alice", action: "virtual_key.delete" }).events[0]!.target).toBe("vk1")
    expect(log.query({ since: 2000.0, until: 3000.0 }).total).toBe(2)
    expect(log.query({ actor: "nobody" }).total).toBe(0)

    const page = log.query({ limit: 2, offset: 1 })
    expect(page.total).toBe(4)
    expect(page.events.map((e) => e.seq).join(",")).toBe("3,2")
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("Bifrost's list filters: CADF action, outcome, initiator, target, path, search, order and cursor", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    try log.record("alice", "provider.upsert", "openai", "PUT", "/api/providers/openai", 200, "10.0.0.1", undefined, 1000.0)
    try log.record("key:k1", "virtual_key.create", "", "POST", "/api/governance/virtual-keys", 201, "10.0.0.2", undefined, 2000.0)
    try log.record("alice", "virtual_key.delete", "vk1", "DELETE", "/api/governance/virtual-keys/vk1", 403, undefined, undefined, 3000.0)
    try log.record("anonymous", "api.post", "/api/session/login", "POST", "/api/session/login", 401, undefined, undefined, 4000.0)
    const ids = (q: AuditQuery): string => log.query(q).events.map((e) => "" + e.seq).join(",")
    expect(ids({ actions: ["delete"] })).toBe("3")
    expect(ids({ action: "update" })).toBe("1")
    expect(ids({ actions: ["create", "virtual_key.delete"] })).toBe("3,2")
    expect(ids({ actions: ["authenticate"] })).toBe("4")
    expect(ids({ outcomes: ["failure"] })).toBe("4,3")
    expect(ids({ initiatorIds: ["alice"] })).toBe("3,1")
    expect(ids({ initiatorTypes: ["api_key"] })).toBe("2")
    expect(ids({ initiatorTypes: ["system"] })).toBe("4")
    expect(ids({ targetIds: ["openai", "vk1"] })).toBe("3,1")
    expect(ids({ targetTypes: ["virtual_key"] })).toBe("3,2")
    expect(ids({ targetTypes: ["session"] })).toBe("4")
    expect(ids({ methods: ["DELETE"] })).toBe("3")
    expect(ids({ paths: ["/api/governance"] })).toBe("3,2")
    expect(ids({ ips: ["10.0.0.2"] })).toBe("2")
    expect(ids({ ips: ["10.0.0.2"], omitIps: true })).toBe("4,3,2,1")
    expect(ids({ search: "VK1" })).toBe("3")
    expect(ids({ search: "10.0.0.1" })).toBe("1")
    expect(ids({ search: "10.0.0.1", omitIps: true })).toBe("")
    expect(ids({ eventTypes: ["activity"] })).toBe("4,3,2,1")
    expect(ids({ eventTypes: ["control"] })).toBe("")
    expect(ids({ tags: ["security"] })).toBe("")
    expect(ids({ order: "asc" })).toBe("1,2,3,4")
    // a cursor pages after the last event of the page before, in either order
    const first = log.query({ limit: 2 })
    expect(first.hasMore).toBe(true)
    expect(first.total).toBe(4)
    expect(ids({ limit: 2, cursor: 3 })).toBe("2,1")
    expect(log.query({ limit: 2, cursor: 3 }).hasMore).toBe(false)
    expect(ids({ limit: 2, cursor: 2, order: "asc" })).toBe("3,4")
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("the list query parses Bifrost's parameters, and the answer carries both shapes", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    try log.record("alice", "provider.upsert", "openai", "PUT", "/api/providers/openai", 200, "10.0.0.1", `{"name":"openai"}`, 86400000.0 * 3.0)
    try log.record("bob", "provider.delete", "openai", "DELETE", "/api/providers/openai", 500, undefined, undefined, 86400000.0 * 4.0 + 5.0)
    const parse = (qs: string): AuditListQuery => auditQueryOf(new URLSearchParams(qs), 86400000.0 * 5.0, false)
    const a = parse(`actions=["update","delete"]&outcome=success&page=2&limit=5&sort_order=asc`)
    expect(a.error).toBe("")
    expect((a.q.actions ?? []).join(",")).toBe("update,delete")
    expect((a.q.outcomes ?? []).join(",")).toBe("success")
    expect(a.q.offset ?? -1).toBe(5)
    expect(a.q.order ?? "").toBe("asc")
    expect(parse("").limit).toBe(100)
    expect(parse("limit=5000").limit).toBe(1000)
    expect(parse("limit=0").error).toBe("limit must be a positive integer")
    expect(parse("page=0").error).toBe("page must be a positive integer")
    expect(parse("cursor=x").error).toBe("invalid cursor")
    expect(parse("sort_order=up").error).toBe("sort_order must be asc or desc")
    // a bare end date is the end of that day; a period overrides the dates
    const d = parse("start_date=1970-01-04&end_date=1970-01-04")
    expect(d.q.since ?? 0.0).toBe(86400000.0 * 3.0)
    expect(d.q.until ?? 0.0).toBe(86400000.0 * 4.0 - 1.0)
    expect(log.query(d.q).total).toBe(1)
    expect(parse("period=1d&start_date=1970-01-01").q.since ?? 0.0).toBe(86400000.0 * 4.0)
    expect(parse("period=soon").error).toBe(`invalid period "soon"`)
    const body = auditListJson(log.query(parse("limit=1").q), 1, 1, false)
    expect(body.includes(`"total":2,"page":1,"limit":1,"total_pages":2,"has_more":true,"next_cursor":"2"`)).toBe(true)
    expect(body.includes(`"id":"2","typeURI":"https://getbifrost.ai/schemas/auditlog.json","eventType":"activity"`)).toBe(true)
    expect(body.includes(`"action":"delete","outcome":"failure","initiator":{"id":"bob","typeURI":"bifrost/user","name":"bob"},"target":{"id":"openai","typeURI":"bifrost/provider"},"reason":{"reasonCode":"500","reasonType":"HTTP"}`)).toBe(true)
    expect(body.includes(`"events":[{"seq":2`)).toBe(true)
    const one = auditListJson(log.query(parse("order=asc&limit=1").q), 1, 1, false)
    expect(one.includes(`"host":"10.0.0.1"`) && one.includes(`"requestIP":"10.0.0.1"`) && one.includes(`"ip":"10.0.0.1"`)).toBe(true)
    expect(one.includes(`"attachments":[{"name":"request_body","contentType":"application/json","content":"{\\"name\\":\\"openai\\"}"}]`)).toBe(true)
    const hidden = auditListJson(log.query(parse("order=asc&limit=1").q), 1, 1, true)
    expect(hidden.includes("10.0.0.1")).toBe(false)
    // filter data: Bifrost's dimensions and Raiju's, narrowed by dimensions and q
    const fd = log.filterData([], "", false)
    expect(fd.includes(`"actions":["delete","provider.delete","provider.upsert","update"]`)).toBe(true)
    expect(fd.includes(`"outcomes":["failure","success"]`)).toBe(true)
    expect(fd.includes(`"initiators":[{"id":"alice","name":"alice"},{"id":"bob","name":"bob"}]`)).toBe(true)
    expect(fd.includes(`"request_ips":["10.0.0.1"]`)).toBe(true)
    expect(fd.includes(`"actors":["alice","bob"]`)).toBe(true)
    const narrow = log.filterData(["outcomes", "nonsense"], "fail", true)
    expect(narrow.includes(`"outcomes":["failure"]`) && !narrow.includes(`"request_methods"`) && !narrow.includes("10.0.0.1")).toBe(true)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("one event's signature verifies; an edited field does not", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 1)
    const e1 = try log.record("alice", "provider.upsert", "openai", "PUT", "/api/providers/openai", 200, undefined, undefined, 1000.0)
    try log.record("bob", "provider.delete", "openai", "DELETE", "/api/providers/openai", 200, undefined, undefined, 2000.0)
    const ok = log.verifyOne(e1)
    expect(ok.valid).toBe(true)
    expect(ok.computed).toBe(e1.sig)
    const sig = e1.sig
    let edited: AuditEvent = e1
    edited.actor = "mallory"
    const bad = log.verifyOne(edited)
    expect(bad.valid).toBe(false)
    expect(bad.stored).toBe(sig)
    // the first event left memory (maxMemory 1) and is read from the file
    expect(log.find(1)).toBeUndefined()
    expect((try log.findAny(1))?.actor ?? "").toBe("alice")
    expect(try log.findAny(9)).toBeUndefined()
    expect(sameText("abc", "abc")).toBe(true)
    expect(sameText("abc", "abd")).toBe(false)
    expect(sameText("abc", "ab")).toBe(false)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("exportJsonl returns file lines in range, unchanged and still verifiable", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 100)
    try log.record("alice", "a.one", "", "PUT", "/api/providers/x", 200, undefined, undefined, 1000.0)
    try log.record("alice", "a.two", "", "PUT", "/api/providers/y", 200, undefined, undefined, 2000.0)
    try log.record("alice", "a.three", "", "PUT", "/api/providers/z", 200, undefined, undefined, 3000.0)
    const all = (try log.exportJsonl()).split("\n").filter((l) => l !== "")
    expect(all.length).toBe(3)
    const mid = (try log.exportJsonl(2000.0, 3000.0)).split("\n").filter((l) => l !== "")
    expect(mid.length).toBe(2)
    expect((try parseLine(mid[0]!))!.seq).toBe(2)
    expect((try parseLine(mid[1]!))!.seq).toBe(3)
    expect(try log.exportJsonl(5000.0)).toBe("")
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("the in-memory window keeps only the newest maxMemory events", () => {
  const dir = try tmpDir()
  try {
    const log = try new AuditLog(dir, TEST_KEY, 2)
    for (let i = 1; i <= 4; i++) try log.record("a", "x", "", "PUT", "/p", 200, undefined, undefined, i * 1.0)
    const r = log.query({})
    expect(r.total).toBe(2)
    expect(r.events[0]!.seq).toBe(4)
    expect(r.events[1]!.seq).toBe(3)
    expect((try log.verify()).checked).toBe(4)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

function ev(seq: int, actor: string, method: string, path: string, status: int, detail: string | undefined): AuditEvent {
  return { seq: seq, ts: 1760000000000.0 + seq, actor: actor, action: "api." + method.toLowerCase(), target: path, method: method, path: path, status: status, detail: detail, prev: "", hash: "", sig: "" }
}

test("access-profile changes read from the trail: Bifrost's per-profile actions and its list shape", () => {
  const base = "/api/governance/access-profiles"
  expect(profileChange(ev(1, "root", "POST", base, 201, `{"id":"p1","name":"P"}`))?.action).toBe("create")
  expect(profileChange(ev(1, "root", "POST", base, 201, `{"name":"Named"}`))?.profile).toBe("Named")
  expect(profileChange(ev(1, "root", "PUT", base + "/p1", 200, undefined))?.action).toBe("update")
  expect(profileChange(ev(1, "root", "POST", base + "/p1/propagate", 200, undefined))?.action).toBe("propagate")
  expect(profileChange(ev(1, "root", "POST", base + "/p1/roles", 200, undefined))?.action).toBe("attach_role")
  expect(profileChange(ev(1, "root", "DELETE", base + "/p1/roles/9003", 200, undefined))?.action).toBe("detach_role")
  expect(profileChange(ev(1, "root", "POST", base + "/p1/deactivate", 200, undefined))?.action).toBe("deactivate")
  expect(profileChange(ev(1, "root", "PUT", base + "/p1", 400, undefined))).toBeUndefined()
  expect(profileChange(ev(1, "root", "PUT", "/api/governance/teams/t1", 200, undefined))).toBeUndefined()
  // newest first, as the trail is read
  const es = [ev(4, "key:ci", "DELETE", base + "/p2", 200, undefined), ev(3, "ann", "PUT", base + "/p1", 200, `{"name":"Q"}`), ev(2, "root", "PUT", "/api/providers/openai", 200, undefined), ev(1, "root", "POST", base, 201, `{"id":"p1"}`)]
  const all = profileAuditJson(es, undefined, "", "", 50, 0)
  expect(all.endsWith(`"total_count":3}`)).toBe(true)
  expect(all.startsWith(`{"audit_logs":[{"id":4,"access_profile_id":"p2","user_id":null,"actor":"key:ci","action":"delete","previous_values":null,"new_values":null`)).toBe(true)
  const one = profileAuditJson(es, "p1", "", "", 50, 0)
  expect(one.includes(`"id":3,"access_profile_id":"p1","user_id":"ann","actor":"ann","action":"update","previous_values":null,"new_values":"{\\"name\\":\\"Q\\"}"`)).toBe(true)
  expect(one.endsWith(`"total_count":2}`)).toBe(true)
  expect(profileAuditJson(es, "p1", "create", "", 50, 0).endsWith(`"total_count":1}`)).toBe(true)
  expect(profileAuditJson(es, undefined, "", "ann", 50, 0).endsWith(`"total_count":1}`)).toBe(true)
  expect(profileAuditJson(es, undefined, "", "", 1, 1).startsWith(`{"audit_logs":[{"id":3,`)).toBe(true)
})
