// Lazy JSON. Request and response bodies pass through the gateway mostly
// untouched, so instead of building a tree we scan for value boundaries and
// keep each value as its raw text. Only the fields the gateway reads are decoded.
//
// The scan runs over the encoded bytes, so its offsets are byte offsets. They are
// not positions in the string (those are bytes on one compiler and UTF-16 units on
// another): the text is only ever cut through Scanner.cut, which converts.

import { strToFloat } from "./num"
import { strLen, posSpan } from "./text"
import { elemAt } from "./arrays"

export type Field = { key: string, raw: string }

const enc = new TextEncoder()

class Scanner {
  pos = 0
  // a byte offset already converted, and the position in text it is
  private seenByte = 0
  private seenPos = 0
  private directOffsets: bool
  constructor(readonly b: u8[], readonly text: string) {
    this.directOffsets = strLen(text) === b.length
  }

  // The position in text of a byte offset (on a character boundary). Offsets mostly come in rising order,
  // so the walk goes on from the last one.
  private posOf(byte: int): int {
    if (this.directOffsets) return byte > this.b.length ? this.b.length : byte
    if (byte < this.seenByte) {
      this.seenByte = 0
      this.seenPos = 0
    }
    this.seenPos += posSpan(this.b, this.seenByte, byte)
    this.seenByte = byte > this.b.length ? this.b.length : byte
    return this.seenPos
  }

  // The text between two byte offsets.
  cut(from: int, to: int): string {
    const a = this.posOf(from)
    return this.text.slice(a, this.posOf(to))
  }

  ws(): void {
    while (this.pos < this.b.length) {
      const c = this.b[this.pos]!
      if (c === u8(32) || c === u8(10) || c === u8(13) || c === u8(9)) this.pos += 1
      else return
    }
  }

  peek(): int {
    const c = elemAt(this.b, this.pos)
    if (c === undefined) return -1
    return int(c)
  }

  expect(ch: int): void throws SyntaxError {
    this.ws()
    if (this.peek() !== ch) throw new SyntaxError(`invalid JSON at byte ${this.pos}`)
    this.pos += 1
  }

  // Skips a string starting at the opening quote; returns the end offset (after the closing quote).
  skipString(): void throws SyntaxError {
    this.pos += 1
    while (this.pos < this.b.length) {
      const c = int(this.b[this.pos]!)
      if (c === 92) this.pos += 2
      else if (c === 34) {
        this.pos += 1
        return
      } else this.pos += 1
    }
    throw new SyntaxError("unterminated JSON string")
  }

  // Skips any value; leaves pos after it.
  skipValue(): void throws SyntaxError {
    this.ws()
    const c = this.peek()
    if (c === 34) {
      try this.skipString()
      return
    }
    if (c === 123 || c === 91) {
      let depth = 0
      while (this.pos < this.b.length) {
        const d = int(this.b[this.pos]!)
        if (d === 34) {
          try this.skipString()
          continue
        }
        if (d === 123 || d === 91) depth += 1
        else if (d === 125 || d === 93) {
          depth -= 1
          if (depth === 0) {
            this.pos += 1
            return
          }
        }
        this.pos += 1
      }
      throw new SyntaxError("unterminated JSON container")
    }
    // number, true, false, null
    const start = this.pos
    while (this.pos < this.b.length) {
      const d = int(this.b[this.pos]!)
      if (d === 44 || d === 125 || d === 93 || d === 32 || d === 10 || d === 13 || d === 9) break
      this.pos += 1
    }
    if (this.pos === start) throw new SyntaxError(`invalid JSON at byte ${start}`)
  }
}

function scannerFor(text: string): Scanner {
  return new Scanner(enc.encode(text), text)
}

// The members of a JSON object, in order, each value as raw text.
export function fields(text: string): Field[] throws SyntaxError {
  const s = scannerFor(text)
  const out: Field[] = []
  try s.expect(123)
  s.ws()
  if (s.peek() === 125) return out
  while (true) {
    s.ws()
    if (s.peek() !== 34) throw new SyntaxError(`expected a key at byte ${s.pos}`)
    const ks = s.pos
    try s.skipString()
    const key = try decodeString(s.cut(ks, s.pos))
    try s.expect(58)
    s.ws()
    const vs = s.pos
    try s.skipValue()
    out.push({ key: key, raw: s.cut(vs, s.pos) })
    s.ws()
    const c = s.peek()
    s.pos += 1
    if (c === 125) return out
    if (c !== 44) throw new SyntaxError(`expected , or } at byte ${s.pos - 1}`)
  }
}

// rawBool(fields(text), key) without keeping the members: the same walk over the whole object, so it
// throws on the texts fields throws on, and the first member named key decides as find would have it.
export function topLevelBool(text: string, key: string): bool | undefined throws SyntaxError {
  const s = scannerFor(text)
  let seen = false
  let out: bool | undefined = undefined
  try s.expect(123)
  s.ws()
  if (s.peek() === 125) return out
  while (true) {
    s.ws()
    if (s.peek() !== 34) throw new SyntaxError(`expected a key at byte ${s.pos}`)
    const ks = s.pos
    try s.skipString()
    const k = try decodeString(s.cut(ks, s.pos))
    try s.expect(58)
    s.ws()
    const vs = s.pos
    try s.skipValue()
    if (!seen && k === key) {
      seen = true
      const raw = s.cut(vs, s.pos)
      if (raw === "true") out = true
      else if (raw === "false") out = false
    }
    s.ws()
    const c = s.peek()
    s.pos += 1
    if (c === 125) return out
    if (c !== 44) throw new SyntaxError(`expected , or } at byte ${s.pos - 1}`)
  }
}

// The elements of a JSON array, each as raw text.
export function elements(text: string): string[] throws SyntaxError {
  const s = scannerFor(text)
  const out: string[] = []
  try s.expect(91)
  s.ws()
  if (s.peek() === 93) return out
  while (true) {
    s.ws()
    const vs = s.pos
    try s.skipValue()
    out.push(s.cut(vs, s.pos))
    s.ws()
    const c = s.peek()
    s.pos += 1
    if (c === 93) return out
    if (c !== 44) throw new SyntaxError(`expected , or ] at byte ${s.pos - 1}`)
  }
}

export function find(fs: Field[], key: string): string | undefined {
  for (const f of fs) {
    if (f.key === key) return f.raw
  }
  return undefined
}

// Decodes a raw JSON string literal (quotes included).
export function decodeString(raw: string): string throws SyntaxError {
  if (raw.indexOf("\\") < 0) return raw.slice(1, strLen(raw) - 1)
  const s: string = try JSON.parse(raw)
  return s
}

export function quote(s: string): string {
  return JSON.stringify(s)
}

export function rawStr(fs: Field[], key: string): string | undefined {
  const r = find(fs, key)
  if (r === undefined || !r.startsWith("\"")) return undefined
  try {
    return decodeString(r)
  } catch (e) {
    return undefined
  }
}

export function rawBool(fs: Field[], key: string): bool | undefined {
  const r = find(fs, key)
  if (r === "true") return true
  if (r === "false") return false
  return undefined
}

export function rawNum(fs: Field[], key: string): f64 | undefined {
  const r = find(fs, key)
  if (r === undefined) return undefined
  return strToFloat(r)
}

// Converts a float to an int by truncation, or undefined when it is NaN or out of range
// (a float-to-int conversion out of range traps, so check before Math.trunc / Math.floor).
export function toInt(x: f64): int | undefined {
  if (!(x >= -1e15 && x <= 1e15)) return undefined
  return Math.trunc(x)
}

// As toInt, rounding down.
export function floorInt(x: f64): int | undefined {
  if (!(x >= -1e15 && x <= 1e15)) return undefined
  return Math.floor(x)
}

// The int a float is, or undefined when it is not a whole number in range.
export function wholeInt(x: f64): int | undefined {
  const n = floorInt(x)
  if (n === undefined || x !== n) return undefined
  return n
}

// A numeric field rounded down to an int; undefined when absent, not a number or out of range.
export function rawInt(fs: Field[], key: string): int | undefined {
  const n = rawNum(fs, key)
  if (n === undefined) return undefined
  return floorInt(n)
}

export function isNull(raw: string | undefined): bool {
  return raw === undefined || raw === "null"
}

// Builds an object from fields, in order.
export function build(fs: Field[]): string {
  const parts: string[] = []
  for (const f of fs) parts.push(quote(f.key) + ":" + f.raw)
  return "{" + parts.join(",") + "}"
}

export function setField(inout fs: Field[], key: string, raw: string): void {
  for (let i = 0; i < fs.length; i++) {
    if (fs[i]!.key === key) {
      fs[i] = { key: key, raw: raw }
      return
    }
  }
  fs.push({ key: key, raw: raw })
}

export function without(fs: Field[], keys: string[]): Field[] {
  return fs.filter((f) => !keys.includes(f.key))
}

test("fields and elements", () => {
  const fs = try fields(' { "model" : "gpt-4o", "n": 2, "msgs": [{"a":"}]"}, [1,2]], "s": "é\\"x", "t": true, "z": null } ')
  expect(fs.length).toBe(6)
  expect(rawStr(fs, "model")).toBe("gpt-4o")
  expect(rawNum(fs, "n")).toBe(2.0)
  expect(find(fs, "msgs")).toBe('[{"a":"}]"}, [1,2]]')
  expect(rawStr(fs, "s")).toBe('é"x')
  expect(rawBool(fs, "t")).toBe(true)
  expect(isNull(find(fs, "z"))).toBe(true)
  const els = try elements(find(fs, "msgs")!)
  expect(els.length).toBe(2)
  expect(elemAt(els, 1)).toBe("[1,2]")
})

test("build round trip", () => {
  let fs = try fields('{"model":"a","stream":true,"fallbacks":["x"]}')
  setField(&fs, "model", quote("b"))
  expect(build(without(fs, ["fallbacks"]))).toBe('{"model":"b","stream":true}')
  expect(try elements("[]")).toEqual([])
  expect((try fields("{}")).length).toBe(0)
})

test("toInt, floorInt and rawInt refuse what does not fit an int", () => {
  expect(toInt(-1.5)).toBe(-1)
  expect(floorInt(-1.5)).toBe(-2)
  expect(toInt(1e15)).toBe(1000000000000000)
  expect(wholeInt(512.0)).toBe(512)
  expect(wholeInt(1.5)).toBe(undefined)
  expect(wholeInt(1e300)).toBe(undefined)
  expect(wholeInt(-1e300)).toBe(undefined)
  expect(toInt(1e300)).toBe(undefined)
  expect(toInt(-1e300)).toBe(undefined)
  expect(floorInt(1e300)).toBe(undefined)
  expect(floorInt(-1e300)).toBe(undefined)
  for (const word of ["NaN", "Infinity", "-Infinity", "1e999"]) {
    const x = strToFloat(word)
    if (x !== undefined) expect(toInt(x)).toBe(undefined)
  }
  const fs = try fields(`{"a":7.9,"b":1e300,"c":-1e300,"d":"7","e":-32603}`)
  expect(rawInt(fs, "a")).toBe(7)
  expect(rawInt(fs, "b")).toBe(undefined)
  expect(rawInt(fs, "c")).toBe(undefined)
  expect(rawInt(fs, "d")).toBe(undefined)
  expect(rawInt(fs, "e")).toBe(-32603)
  expect(rawInt(fs, "zz")).toBe(undefined)
})

test("topLevelBool is rawBool over fields, also for what fields refuses", () => {
  const texts = [
    `{"model":"m","stream":true}`,
    `{"model":"m","stream":false}`,
    `{"model":"m"}`,
    `{}`,
    ` { "stream" : true , "messages" : [ { "content" : "\\"stream\\":false }" } ] } `,
    `{"messages":[{"stream":true}],"stream":false}`,
    `{"a":{"stream":true}}`,
    `{"stream":true,"stream":false}`,
    `{"stream":"true","stream":true}`,
    `{"stream":null}`,
    `{"stream":1}`,
    `{"stream":True}`,
    `{"stream":true }`,
    `{"stream":\ttrue\n}`,
    `{"stream":truex}`,
    `{"stream":true,}`,
    `{"stream":true,"a"}`,
    `{"stream":true,"a":}`,
    `{"stream":true,"a":1`,
    `{"stream":true,"a":[1,2}`,
    `{"stream":true,"a":"x}`,
    `{"stream":true "a":1}`,
    `{"stream":true} trailing`,
    `{"stream":true}{"stream":false}`,
    `{"str\\u0065am":true}`,
    `{"stream\\q":true,"stream":true}`,
    `{"a\\q":1,"stream":true}`,
    `{"stream":true,"a\\q":1}`,
    `{"a\\":1,"stream":true}`,
    `{'stream':true}`,
    `{stream:true}`,
    `[{"stream":true}]`,
    `"stream"`,
    `{"stream"`,
    `{"stream":`,
    `{`,
    ``,
    `  `,
    `{"stream" true}`,
    `{"stream"::true}`,
    `{,"stream":true}`,
    `{"stream":true,,"a":1}`,
    `{"stream":{"x":1]}`,
    `{"a":[}],"stream":true}`,
    `{"a":1 2,"stream":true}`,
    `{"é":"ü","stream":true}`,
  ]
  let yes = 0
  let no = 0
  let bad = 0
  for (const t of texts) {
    for (const key of ["stream", "a"]) {
      let want = "throws"
      try {
        want = `${rawBool(fields(t), key)}`
      } catch (e) {}
      let got = "throws"
      try {
        got = `${topLevelBool(t, key)}`
      } catch (e) {}
      if (got !== want) expect(`${t} [${key}] ${got}`).toBe(want)
      if (key !== "stream") continue
      if (want === "true") yes += 1
      else if (want === "throws") bad += 1
      else no += 1
    }
  }
  expect(yes > 5).toBe(true)
  expect(no > 5).toBe(true)
  expect(bad > 5).toBe(true)
})

test("fields, elements and topLevelBool cut after non-ASCII text of every width", () => {
  // 2-, 3- and 4-byte characters before a key, in keys, in values with escapes, in nested values and between members
  const text = '{"é":"ü\\"x","日本":["語",{"k🙂":"v🙂\\\\"},"🙂🙂"],"🙂k":"a\\u00e9🙂b\\n","n":-1.5e3,"s🙂":"","t":true, "après":{"日":"é}"} ,"z":null}'
  const fs = try fields(text)
  expect(fs.map((f) => f.key)).toEqual(["é", "日本", "🙂k", "n", "s🙂", "t", "après", "z"])
  expect(find(fs, "é")).toBe('"ü\\"x"')
  expect(rawStr(fs, "é")).toBe('ü"x')
  expect(find(fs, "日本")).toBe('["語",{"k🙂":"v🙂\\\\"},"🙂🙂"]')
  expect(rawStr(fs, "🙂k")).toBe("aé🙂b\n")
  expect(rawNum(fs, "n")).toBe(-1500.0)
  expect(rawStr(fs, "s🙂")).toBe("")
  expect(rawBool(fs, "t")).toBe(true)
  expect(find(fs, "après")).toBe('{"日":"é}"}')
  expect(isNull(find(fs, "z"))).toBe(true)
  expect(build(fs)).toBe('{"é":"ü\\"x","日本":["語",{"k🙂":"v🙂\\\\"},"🙂🙂"],"🙂k":"a\\u00e9🙂b\\n","n":-1.5e3,"s🙂":"","t":true,"après":{"日":"é}"},"z":null}')
  const els = try elements(find(fs, "日本")!)
  expect(els).toEqual(['"語"', '{"k🙂":"v🙂\\\\"}', '"🙂🙂"'])
  expect(try decodeString(els[0]!)).toBe("語")
  expect(try decodeString(els[2]!)).toBe("🙂🙂")
  const inner = try fields(els[1]!)
  expect(inner[0]!.key).toBe("k🙂")
  expect(rawStr(inner, "k🙂")).toBe("v🙂\\")
  expect(rawStr(try fields(find(fs, "après")!), "日")).toBe("é}")
  expect(try elements(' [ "é" , 1 ,"日", true,"🙂",null , ["🙂",2] ] ')).toEqual(['"é"', "1", '"日"', "true", '"🙂"', "null", '["🙂",2]'])
  // a member after each width, alone
  for (const ch of ["é", "日", "🙂", "é日🙂", "🙂🙂🙂"]) {
    const t = `{"${ch}":"${ch}","k${ch}":["${ch}"],"stream":true,"last":"${ch}x"}`
    const m = try fields(t)
    expect(m.length).toBe(4)
    expect(m[0]!.key).toBe(ch)
    expect(rawStr(m, ch)).toBe(ch)
    expect(find(m, "k" + ch)).toBe(`["${ch}"]`)
    expect(rawBool(m, "stream")).toBe(true)
    expect(rawStr(m, "last")).toBe(ch + "x")
    expect(try topLevelBool(t, "stream")).toBe(true)
    expect(try topLevelBool(`{"${ch}":false,"stream":true}`, ch)).toBe(false)
    expect(build(m)).toBe(t)
  }
})
