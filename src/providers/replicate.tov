// Replicate chat, as one prediction. The conversation is folded into the model's input
// (prompt, system_prompt, image_input); the answer is the prediction's output joined. The
// request asks for a synchronous answer (Prefer: wait). A chat prediction still running when
// that wait ends is an error: the chat translate is synchronous, so it cannot poll. Image
// predictions are polled by media.tov (replicateSettle). Replicate's wire format is not
// OpenAI's, so this translates both ways.
import { Field, fields, find, rawStr, rawNum, decodeString, elements, quote } from "../json"
import { Target, Upstream, Translated, headers, addExtraHeaders, trimSlash } from "./types"
import { ChatRequest, ContentPart, textOf, nowSeconds } from "../schemas"
import { parseIsoUtcMs, pctEncode } from "../cloud_auth"

const DEFAULT_BASE = "https://api.replicate.com"
const HEX = "0123456789abcdef"
const DEEPSEEK = "deepseek-ai/deepseek"

// A 64-character lower-case hex id is a model version: its predictions are at /v1/predictions.
export function isVersion(s: string): bool {
  if (s.byteLength !== 64) return false
  for (let i = 0; i < 64; i++) {
    if (!HEX.includes(s.slice(i, i + 1))) return false
  }
  return true
}

// owner/name uses /v1/models/<owner>/<name>/predictions; a version id uses /v1/predictions.
export function predictionPath(model: string): string {
  if (isVersion(model)) return "/v1/predictions"
  return "/v1/models/" + model + "/predictions"
}

// The text pieces of a conversation: system text, and user and assistant text in order, and
// image URLs. DeepSeek models take no system_prompt, so their system text is put first in the prompt.
type Pieces = { system: string, prompt: string, images: string[] }

function pieces(req: ChatRequest): Pieces {
  const sys: string[] = []
  const parts: string[] = []
  const images: string[] = []
  for (const m of req.messages) {
    const c = m.content
    if (c !== undefined && typeof c !== "string") {
      for (const p of c as ContentPart[]) {
        if (p.type === "image_url" && p.image_url !== undefined) images.push(p.image_url.url)
      }
    }
    const text = textOf(c)
    if (text === "") continue
    if (m.role === "system") sys.push(text)
    else if (m.role === "user" || m.role === "assistant") parts.push(text)
  }
  return { system: sys.join("\n"), prompt: parts.join("\n\n"), images: images }
}

// The POST body: {"input": {...}}. Sampling and the output limit carry over.
export function chatBody(model: string, version: bool, req: ChatRequest): string {
  const pc = pieces(req)
  const deepseek = model.toLowerCase().startsWith(DEEPSEEK)
  let prompt = pc.prompt
  let system = pc.system
  if (deepseek && system !== "") {
    prompt = prompt === "" ? system : system + "\n\n" + prompt
    system = ""
  }
  const input: string[] = []
  if (prompt !== "") input.push(`"prompt":${quote(prompt)}`)
  if (system !== "") input.push(`"system_prompt":${quote(system)}`)
  if (pc.images.length > 0) input.push(`"image_input":[${pc.images.map((u) => quote(u)).join(",")}]`)
  const maxTokens = req.max_completion_tokens ?? req.max_tokens
  if (maxTokens !== undefined) input.push(`"max_tokens":${maxTokens}`)
  if (req.temperature !== undefined) input.push(`"temperature":${req.temperature}`)
  if (req.top_p !== undefined) input.push(`"top_p":${req.top_p}`)
  const head = version ? `"version":${quote(model)},` : ""
  return "{" + head + `"input":{${input.join(",")}}}`
}

// The create-prediction POST. The key value is the API token.
export function chatRequest(t: Target, req: ChatRequest): Upstream throws SyntaxError {
  const key = t.key.value ?? ""
  if (key === "") throw new SyntaxError("replicate: the key needs a value: an API token")
  const b = t.cfg.network_config?.base_url ?? ""
  const root = b === "" ? DEFAULT_BASE : trimSlash(b)
  let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + key], ["prefer", "wait"]])
  addExtraHeaders(&h, t.cfg)
  const version = isVersion(t.model)
  return { url: root + predictionPath(t.model), headers: h, body: chatBody(t.model, version, req) }
}

// The number after a log label such as "Input token count: 12", or 0.
function countAfter(logs: string, label: string): int {
  const i = logs.indexOf(label)
  if (i < 0) return 0
  const rest = logs.slice(i + label.byteLength).trimStart()
  let n: int = 0
  for (let k = 0; k < rest.byteLength; k++) {
    const d = "0123456789".indexOf(rest.slice(k, k + 1))
    if (d < 0) break
    n = n * 10 + d
  }
  return n
}

// The output as text: a string, an array of strings (joined), or an object with "text".
function outputText(raw: string | undefined): string throws SyntaxError {
  if (raw === undefined || raw === "null") return ""
  if (raw.startsWith("\"")) return try decodeString(raw)
  if (raw.startsWith("[")) {
    const out: string[] = []
    for (const el of try elements(raw)) {
      if (el.startsWith("\"")) out.push(try decodeString(el))
    }
    return out.join("")
  }
  if (raw.startsWith("{")) {
    const ofs = try fields(raw)
    return rawStr(ofs, "text") ?? ""
  }
  return ""
}

// The answer as an OpenAI chat completion, with the requested model name and token counts
// from the logs when Replicate reports them.
export function chatResponse(text: string, requestedModel: string): Translated throws SyntaxError {
  const fs = try fields(text)
  const status = rawStr(fs, "status") ?? ""
  if (status === "failed" || status === "canceled") {
    throw new SyntaxError(`replicate: prediction ${status}: ${rawStr(fs, "error") ?? "no error given"}`)
  }
  if (status !== "succeeded") {
    throw new SyntaxError(`replicate: prediction is ${status === "" ? "unknown" : status}; the wait for a synchronous answer ended first`)
  }
  const content = try outputText(find(fs, "output"))
  const created = parseIsoUtcMs(rawStr(fs, "created_at") ?? "")
  const createdSec = created === undefined ? nowSeconds() : Math.floor(created / 1000.0)
  const logs = rawStr(fs, "logs") ?? ""
  const pt = countAfter(logs, "Input token count:")
  const ct = countAfter(logs, "Output token count:")
  const body = `{"id":${quote(rawStr(fs, "id") ?? "")},"object":"chat.completion","created":${createdSec},"model":${quote(requestedModel)},"choices":[{"index":0,"message":{"role":"assistant","content":${quote(content)}},"finish_reason":"stop"}],"usage":{"prompt_tokens":${pt},"completion_tokens":${ct},"total_tokens":${pt + ct}}}`
  return { body: body, promptTokens: pt, completionTokens: ct }
}

// Image generation as one prediction: the prompt, the count as num_outputs, and the negative prompt
// and seed when set, in the model's input. The answer is the prediction's output URLs.
export function imageRequest(t: Target, body: Field[]): Upstream throws SyntaxError {
  const key = t.key.value ?? ""
  if (key === "") throw new SyntaxError("replicate: the key needs a value: an API token")
  const prompt = rawStr(body, "prompt") ?? ""
  if (prompt === "") throw new SyntaxError("prompt is required")
  const input: string[] = [`"prompt":${quote(prompt)}`]
  const n = rawNum(body, "n")
  if (n !== undefined) input.push(`"num_outputs":${n}`)
  const neg = rawStr(body, "negative_prompt") ?? ""
  if (neg !== "") input.push(`"negative_prompt":${quote(neg)}`)
  const seed = rawNum(body, "seed")
  if (seed !== undefined) input.push(`"seed":${seed}`)
  const b = t.cfg.network_config?.base_url ?? ""
  const root = b === "" ? DEFAULT_BASE : trimSlash(b)
  let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + key], ["prefer", "wait"]])
  addExtraHeaders(&h, t.cfg)
  const head = isVersion(t.model) ? `"version":${quote(t.model)},` : ""
  return { url: root + predictionPath(t.model), headers: h, body: "{" + head + `"input":{${input.join(",")}}}` }
}

// The images answer: the output URLs (one string or an array) as OpenAI's data list. A prediction
// that has not succeeded by the end of the wait is an error here, as for chat.
export function imageResponse(text: string): string throws SyntaxError {
  const fs = try fields(text)
  const status = rawStr(fs, "status") ?? ""
  if (status === "failed" || status === "canceled") {
    throw new SyntaxError(`replicate: prediction ${status}: ${rawStr(fs, "error") ?? "no error given"}`)
  }
  if (status !== "succeeded") {
    throw new SyntaxError(`replicate: prediction is ${status === "" ? "unknown" : status}; the wait for a synchronous answer ended first`)
  }
  const items: string[] = []
  const out = find(fs, "output") ?? "null"
  if (out.startsWith("[")) {
    for (const el of try elements(out)) {
      if (el.startsWith("\"")) {
        const u = try decodeString(el)
        items.push(`{"url":${quote(u)}}`)
      }
    }
  } else if (out.startsWith("\"")) {
    const u = try decodeString(out)
    items.push(`{"url":${quote(u)}}`)
  }
  if (items.length === 0) throw new SyntaxError("replicate: the prediction has no output")
  const created = parseIsoUtcMs(rawStr(fs, "created_at") ?? "")
  const at = created === undefined ? nowSeconds() : Math.floor(created / 1000.0)
  return `{"created":${at},"data":[${items.join(",")}]}`
}

// A file upload's answer as OpenAI's file object. Replicate keeps no purpose; the caller's is echoed,
// or "batch" (Bifrost's default). A file with bytes is processed.
export function fileToOpenAI(text: string, purpose: string): string throws SyntaxError {
  const fs = try fields(text)
  const size = rawNum(fs, "size") ?? 0
  const status = rawStr(fs, "id") !== undefined && size > 0 ? "processed" : "uploaded"
  const created = parseIsoUtcMs(rawStr(fs, "created_at") ?? "")
  const at = created === undefined ? nowSeconds() : Math.floor(created / 1000.0)
  const expires = parseIsoUtcMs(rawStr(fs, "expires_at") ?? "")
  const exp = expires === undefined ? "" : `,"expires_at":${Math.floor(expires / 1000.0)}`
  const pur = purpose === "" ? "batch" : purpose
  return `{"id":${quote(rawStr(fs, "id") ?? "")},"object":"file","bytes":${size},"created_at":${at},"filename":${quote(rawStr(fs, "name") ?? "")},"purpose":${quote(pur)},"status":${quote(status)}${exp}}`
}

// One page of the deployments listing: the owner/name ids, and the URL of the next page ("" when none).
export function deploymentsPage(text: string): { ids: string[], next: string } throws SyntaxError {
  const fs = try fields(text)
  const ids: string[] = []
  for (const el of try elements(find(fs, "results") ?? "[]")) {
    const ef = try fields(el)
    const owner = rawStr(ef, "owner") ?? ""
    const name = rawStr(ef, "name") ?? ""
    if (owner !== "" && name !== "") ids.push(owner + "/" + name)
  }
  return { ids: ids, next: rawStr(fs, "next") ?? "" }
}

// The API root: the provider's base_url, or Replicate's.
export function rootOf(t: Target): string {
  const b = t.cfg.network_config?.base_url ?? ""
  return b === "" ? DEFAULT_BASE : trimSlash(b)
}

// The deployments listing of a key's account: the first page (later pages come from each "next").
export function deploymentsRequest(t: Target): Upstream {
  let h = headers([["authorization", "Bearer " + (t.key.value ?? "")]])
  addExtraHeaders(&h, t.cfg)
  return { url: rootOf(t) + "/v1/deployments", headers: h, body: "" }
}

// ---- polling, edits and files ----

// A prediction is settled once it has a terminal status, or has no status to wait for.
export function isSettled(text: string): bool throws SyntaxError {
  const status = rawStr(try fields(text), "status") ?? ""
  return status === "succeeded" || status === "failed" || status === "canceled" || status === ""
}

// The URL a running prediction is read from (its urls.get), or "" when the answer has none.
export function getUrlOf(text: string): string throws SyntaxError {
  const u = find(try fields(text), "urls")
  if (u === undefined || !u.startsWith("{")) return ""
  return rawStr(try fields(u), "get") ?? ""
}

// The model's input field for its image(s), as Bifrost maps them: one image in a named field for
// the models listed here, and an array of images in input_images for every other model.
function imageFieldOf(model: string): string {
  const colon = model.indexOf(":")
  const id = (colon < 0 ? model : model.slice(0, colon)).toLowerCase()
  const table = new Map<string, string>()
  table.set("black-forest-labs/flux-1.1-pro", "image_prompt")
  table.set("black-forest-labs/flux-1.1-pro-ultra", "image_prompt")
  table.set("black-forest-labs/flux-pro", "image_prompt")
  table.set("black-forest-labs/flux-1.1-pro-ultra-finetuned", "image_prompt")
  table.set("black-forest-labs/flux-kontext-pro", "input_image")
  table.set("black-forest-labs/flux-kontext-max", "input_image")
  table.set("black-forest-labs/flux-kontext-dev", "input_image")
  table.set("black-forest-labs/flux-dev", "image")
  table.set("black-forest-labs/flux-fill-pro", "image")
  table.set("black-forest-labs/flux-dev-lora", "image")
  table.set("black-forest-labs/flux-krea-dev", "image")
  return table.get(id) ?? "input_images"
}

// An image edit as one prediction: the prompt, the images as data URLs in the model's input field,
// and the count, negative prompt and seed as in generation. The answer is read as generation's.
export function imageEditRequest(t: Target, body: Field[], images: string[]): Upstream throws SyntaxError {
  const key = t.key.value ?? ""
  if (key === "") throw new SyntaxError("replicate: the key needs a value: an API token")
  const prompt = rawStr(body, "prompt") ?? ""
  if (prompt === "") throw new SyntaxError("prompt is required")
  if (images.length === 0) throw new SyntaxError("an image is required")
  const input: string[] = [`"prompt":${quote(prompt)}`]
  const field = imageFieldOf(t.model)
  const urls = images.map((u) => quote(u))
  if (field === "input_images") input.push(`"input_images":[${urls.join(",")}]`)
  else input.push(`${quote(field)}:${urls[0]!}`)
  const n = rawNum(body, "n")
  if (n !== undefined) input.push(`"num_outputs":${n}`)
  const neg = rawStr(body, "negative_prompt") ?? ""
  if (neg !== "") input.push(`"negative_prompt":${quote(neg)}`)
  const seed = rawNum(body, "seed")
  if (seed !== undefined) input.push(`"seed":${seed}`)
  const b = t.cfg.network_config?.base_url ?? ""
  const root = b === "" ? DEFAULT_BASE : trimSlash(b)
  let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + key], ["prefer", "wait"]])
  addExtraHeaders(&h, t.cfg)
  const head = isVersion(t.model) ? `"version":${quote(t.model)},` : ""
  return { url: root + predictionPath(t.model), headers: h, body: "{" + head + `"input":{${input.join(",")}}}` }
}

// The file API under the account's root: the list (one page, from its cursor) and one file.
export function fileListUrl(t: Target, cursor: string): string {
  return rootOf(t) + "/v1/files" + (cursor === "" ? "" : "?cursor=" + pctEncode(cursor))
}

export function fileUrl(t: Target, id: string): string {
  return rootOf(t) + "/v1/files/" + pctEncode(id)
}

// The headers of a file call: the bearer token and the configured extra headers.
export function fileHeaders(t: Target): Map<string, string> {
  let h = headers([["authorization", "Bearer " + (t.key.value ?? "")]])
  addExtraHeaders(&h, t.cfg)
  return h
}

// A file list page as OpenAI's list. Files are listed with the batch purpose, as Bifrost does. after is
// the cursor of the next page, from the next link; has_more says whether there is one.
export function fileListToOpenAI(text: string): string throws SyntaxError {
  const fs = try fields(text)
  const items: string[] = []
  for (const el of try elements(find(fs, "results") ?? "[]")) items.push(try fileToOpenAI(el, ""))
  const next = rawStr(fs, "next") ?? ""
  const at = next.indexOf("cursor=")
  let after = ""
  if (at >= 0) after = new URLSearchParams("c=" + (next.slice(at + 7).split("&")[0] ?? "")).get("c") ?? ""
  const first = items.length > 0 ? rawStr(try fields(items[0]!), "id") ?? "" : ""
  const last = items.length > 0 ? rawStr(try fields(items[items.length - 1]!), "id") ?? "" : ""
  const cursor = after === "" ? "" : `,"after":${quote(after)}`
  return `{"object":"list","data":[${items.join(",")}],"has_more":${next !== ""},"first_id":${quote(first)},"last_id":${quote(last)}${cursor}}`
}

// The OpenAI delete object for a file the DELETE call removed (Replicate answers 204).
export function fileDeletedToOpenAI(id: string): string {
  return `{"id":${quote(id)},"object":"file","deleted":true}`
}

// ---- tests ----

test("a running prediction is polled at its get URL until it settles", () => {
  const running = `{"id":"p9","status":"starting","urls":{"get":"https://api.replicate.com/v1/predictions/p9"}}`
  expect(try isSettled(running)).toBe(false)
  expect(try getUrlOf(running)).toBe("https://api.replicate.com/v1/predictions/p9")
  expect(try isSettled(`{"status":"processing"}`)).toBe(false)
  expect(try getUrlOf(`{"status":"processing"}`)).toBe("")
  expect(try isSettled(`{"status":"succeeded","output":["x"]}`)).toBe(true)
  expect(try isSettled(`{"status":"failed","error":"boom"}`)).toBe(true)
  expect(try isSettled(`{"status":"canceled"}`)).toBe(true)
})

test("an image edit posts the images to the model's input field", () => {
  const t: Target = { provider: "replicate", kind: "replicate", model: "black-forest-labs/flux-kontext-pro", key: { value: "r8_x" }, cfg: {} }
  const body = try fields(`{"prompt":"a red fox","n":1,"seed":3}`)
  const up = try imageEditRequest(t, body, ["data:image/png;base64,AAAA"])
  expect(up.url).toBe("https://api.replicate.com/v1/models/black-forest-labs/flux-kontext-pro/predictions")
  expect(up.headers.get("prefer")).toBe("wait")
  expect(up.body).toBe(`{"input":{"prompt":"a red fox","input_image":"data:image/png;base64,AAAA","num_outputs":1,"seed":3}}`)
  const other: Target = { provider: "replicate", kind: "replicate", model: "acme/model-a", key: { value: "r8_x" }, cfg: {} }
  expect((try imageEditRequest(other, try fields(`{"prompt":"p"}`), ["u1", "u2"])).body).toBe(`{"input":{"prompt":"p","input_images":["u1","u2"]}}`)
  let none = false
  try {
    imageEditRequest(other, try fields(`{"prompt":"p"}`), [])
  } catch (e) {
    none = true
  }
  expect(none).toBe(true)
})

test("file list, retrieve and delete: the URLs, the list page and the delete object", () => {
  const dt: Target = { provider: "replicate", kind: "replicate", model: "", key: { value: "r8_x" }, cfg: {} }
  expect(fileListUrl(dt, "")).toBe("https://api.replicate.com/v1/files")
  expect(fileListUrl(dt, "c 2")).toBe("https://api.replicate.com/v1/files?cursor=c%202")
  expect(fileUrl(dt, "file-1")).toBe("https://api.replicate.com/v1/files/file-1")
  expect(fileHeaders(dt).get("authorization")).toBe("Bearer r8_x")
  const page = try fileListToOpenAI(`{"next":"https://api.replicate.com/v1/files?cursor=abc%2B1&x=2","previous":null,"results":[{"id":"file-1","name":"a.png","content_type":"image/png","size":9,"created_at":"2026-10-14T13:00:00.123Z"},{"id":"file-2","size":0,"created_at":"2026-10-14T13:00:00.123Z"}]}`)
  expect(page.includes(`"object":"list","data":[{"id":"file-1","object":"file","bytes":9,"created_at":1791982800,"filename":"a.png","purpose":"batch","status":"processed"},{"id":"file-2","object":"file","bytes":0,"created_at":1791982800,"filename":"","purpose":"batch","status":"uploaded"}]`)).toBe(true)
  expect(page.includes(`"has_more":true,"first_id":"file-1","last_id":"file-2","after":"abc+1"}`)).toBe(true)
  expect(try fileListToOpenAI(`{"next":null,"results":[]}`)).toBe(`{"object":"list","data":[],"has_more":false,"first_id":"","last_id":""}`)
  expect(fileDeletedToOpenAI("file-1")).toBe(`{"id":"file-1","object":"file","deleted":true}`)
})

test("prediction path for a model name and for a version", () => {
  expect(predictionPath("meta/llama-3-8b-instruct")).toBe("/v1/models/meta/llama-3-8b-instruct/predictions")
  const v = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  expect(predictionPath(v)).toBe("/v1/predictions")
})

test("chat becomes one prediction with the system text apart", () => {
  const t: Target = { provider: "replicate", kind: "replicate", model: "meta/llama-3-8b-instruct", key: { value: "r8_x" }, cfg: {} }
  const req: ChatRequest = { model: "replicate/meta/llama-3-8b-instruct", messages: [{ role: "system", content: "be brief" }, { role: "user", content: "hi" }], max_tokens: 5 }
  const up = try chatRequest(t, req)
  expect(up.url).toBe("https://api.replicate.com/v1/models/meta/llama-3-8b-instruct/predictions")
  expect(up.headers.get("prefer")).toBe("wait")
  expect(up.headers.get("authorization")).toBe("Bearer r8_x")
  expect(up.body).toBe(`{"input":{"prompt":"hi","system_prompt":"be brief","max_tokens":5}}`)
})

test("DeepSeek takes the system text in the prompt, and a version id uses /v1/predictions", () => {
  const req: ChatRequest = { model: "x", messages: [{ role: "system", content: "S" }, { role: "user", content: "U" }] }
  expect(chatBody("deepseek-ai/deepseek-r1", false, req)).toBe(`{"input":{"prompt":"S\\n\\nU"}}`)
  const v = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
  expect(chatBody(v, true, req)).toBe(`{"version":"${v}","input":{"prompt":"U","system_prompt":"S"}}`)
})

test("a succeeded prediction becomes a chat completion with joined output and log tokens", () => {
  const text = `{"id":"p1","status":"succeeded","created_at":"2026-10-14T13:00:00.123Z","output":["Hel","lo"],"logs":"Input token count: 12\\nOutput token count: 3"}`
  const r = try chatResponse(text, "replicate/meta/llama")
  expect(r.body.includes(`"content":"Hello"`)).toBe(true)
  expect(r.body.includes(`"model":"replicate/meta/llama"`)).toBe(true)
  expect(r.promptTokens).toBe(12)
  expect(r.completionTokens).toBe(3)
  expect(r.body.includes(`"created":1791982800`)).toBe(true)
})

test("a string output and a failed prediction", () => {
  const r = try chatResponse(`{"id":"p2","status":"succeeded","output":"ok"}`, "m")
  expect(r.body.includes(`"content":"ok"`)).toBe(true)
  let threw = false
  try {
    chatResponse(`{"status":"failed","error":"boom"}`, "m")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    chatResponse(`{"status":"processing"}`, "m")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("an image prediction posts the prompt as input and reads the output URLs", () => {
  const t: Target = { provider: "replicate", kind: "replicate", model: "black-forest-labs/flux-schnell", key: { value: "r8_x" }, cfg: {} }
  const body = try fields(`{"prompt":"a fox","n":2,"seed":4}`)
  const up = try imageRequest(t, body)
  expect(up.url).toBe("https://api.replicate.com/v1/models/black-forest-labs/flux-schnell/predictions")
  expect(up.headers.get("prefer")).toBe("wait")
  expect(up.body).toBe(`{"input":{"prompt":"a fox","num_outputs":2,"seed":4}}`)
  const v = "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
  const vt: Target = { provider: "replicate", kind: "replicate", model: v, key: { value: "r8_x" }, cfg: {} }
  expect((try imageRequest(vt, try fields(`{"prompt":"p"}`))).body).toBe(`{"version":"${v}","input":{"prompt":"p"}}`)
  let missing = false
  try {
    imageRequest(t, try fields(`{"n":1}`))
  } catch (e) {
    missing = true
  }
  expect(missing).toBe(true)
  const out = try imageResponse(`{"id":"p3","status":"succeeded","created_at":"2026-10-14T13:00:00.123Z","output":["https://r.example/a.png","https://r.example/b.png"]}`)
  expect(out).toBe(`{"created":1791982800,"data":[{"url":"https://r.example/a.png"},{"url":"https://r.example/b.png"}]}`)
  expect(try imageResponse(`{"status":"succeeded","output":"https://r.example/c.png"}`).includes(`{"url":"https://r.example/c.png"}`)).toBe(true)
  let failed = false
  try {
    imageResponse(`{"status":"failed","error":"nsfw"}`)
  } catch (e) {
    failed = true
  }
  expect(failed).toBe(true)
})

test("a file upload answer is an OpenAI file; deployments give owner/name ids and the next page", () => {
  const f = try fileToOpenAI(`{"id":"file-1","name":"a.png","content_type":"image/png","size":9,"created_at":"2026-10-14T13:00:00.123Z","urls":{"get":"https://x"}}`, "")
  expect(f).toBe(`{"id":"file-1","object":"file","bytes":9,"created_at":1791982800,"filename":"a.png","purpose":"batch","status":"processed"}`)
  expect(try fileToOpenAI(`{"id":"file-2","size":0}`, "vision").includes(`"purpose":"vision","status":"uploaded"`)).toBe(true)
  const page = try deploymentsPage(`{"next":"https://api.replicate.com/v1/deployments?cursor=2","results":[{"owner":"acme","name":"model-a"},{"owner":"acme","name":"model-b"}]}`)
  expect(page.ids.join(",")).toBe("acme/model-a,acme/model-b")
  expect(page.next).toBe("https://api.replicate.com/v1/deployments?cursor=2")
  expect(try deploymentsPage(`{"next":null,"results":[]}`).next).toBe("")
  const dt: Target = { provider: "replicate", kind: "replicate", model: "", key: { value: "r8_x" }, cfg: {} }
  expect(deploymentsRequest(dt).url).toBe("https://api.replicate.com/v1/deployments")
})
