// Google Vertex AI: service-account OAuth, regional endpoints, and the Gemini
// and Claude request paths. The key's service account signs a JWT, which the
// token endpoint exchanges for a bearer token that lasts an hour.
import { Field, fields, find, quote, rawStr, rawNum, build, without, setField } from "../json"
import { Target, Upstream, Translated, headers, addExtraHeaders, trimSlash } from "./types"
import { ChatRequest } from "../schemas"
import { serviceAccountJwt } from "../jwt"
import * as anthropic from "./anthropic"
import * as gemini from "./gemini"
import { pctEncode } from "../cloud_auth"

const SCOPE = "https://www.googleapis.com/auth/cloud-platform"
const DEFAULT_TOKEN_URI = "https://oauth2.googleapis.com/token"
const ANTHROPIC_VERSION = "vertex-2023-10-16"
const GRANT_PREFIX = "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Ajwt-bearer&assertion="

// The service-account JSON from a key's auth_credentials.
export type ServiceAccount = { client_email: string, private_key: string, token_uri?: string }

export function parseServiceAccount(text: string | undefined): ServiceAccount throws SyntaxError {
  if (text === undefined || text === "") throw new SyntaxError("vertex: auth_credentials is required")
  const sa = try JSON.parse(text) as ServiceAccount
  if (sa.client_email === "" || sa.private_key === "") throw new SyntaxError("vertex: auth_credentials needs client_email and private_key")
  return sa
}

type CachedToken = { token: string, expiresAt: int }

// Bearer tokens by client_email. A token is reused until less than 60 seconds
// of its life is left.
export class TokenCache {
  tokens: Map<string, CachedToken> = new Map()

  // The POST that exchanges a fresh JWT for an access token.
  tokenRequest(sa: ServiceAccount, nowSeconds: int): Upstream throws SyntaxError {
    const uri = sa.token_uri ?? DEFAULT_TOKEN_URI
    const jwt = try serviceAccountJwt(sa.client_email, sa.private_key, SCOPE, uri, nowSeconds)
    return {
      url: uri,
      headers: headers([["content-type", "application/x-www-form-urlencoded"]]),
      body: GRANT_PREFIX + jwt,
    }
  }

  // Keeps the access token from a token endpoint response.
  store(email: string, responseJson: string, nowSeconds: int): void throws SyntaxError {
    const fs = try fields(responseJson)
    const token = rawStr(fs, "access_token")
    if (token === undefined || token === "") {
      throw new SyntaxError(`vertex: token request failed: ${rawStr(fs, "error") ?? "no access_token"}`)
    }
    const expires = rawNum(fs, "expires_in")
    const ttl = expires === undefined ? 3600 : Math.floor(expires)
    this.tokens.set(email, { token: token, expiresAt: nowSeconds + ttl })
  }

  // The cached token, or undefined when none is stored or it is about to expire.
  get(email: string, nowSeconds: int): string | undefined {
    const c = this.tokens.get(email)
    if (c === undefined) return undefined
    if (c.expiresAt - nowSeconds <= 60) return undefined
    return c.token
  }
}

// The API host of a location (Bifrost's getVertexAPIHost): "global" has no region prefix, and the multi-region
// locations "us" and "eu" are served only by their rep.googleapis.com hosts.
export function vertexHost(region: string): string {
  if (region === "global") return "aiplatform.googleapis.com"
  if (region === "us" || region === "eu") return `aiplatform.${region}.rep.googleapis.com`
  return `${region}-aiplatform.googleapis.com`
}

function host(region: string): string {
  return vertexHost(region)
}

// Whether a model id names a tuned model's endpoint: all digits (Bifrost's IsAllDigitsASCII).
export function isEndpointModel(model: string): bool {
  if (model === "") return false
  for (const c of model.chars()) {
    if (c < "0" || c > "9") return false
  }
  return true
}

export function isClaude(model: string): bool {
  return model.startsWith("claude")
}

// The partner models Google serves only from a multi-region pool: the datasheet's vertex_multi_region_only entries
// (Bifrost's IsVertexMultiRegionOnlyModel), as of the 2026-10-19 datasheet.
const MULTI_REGION_ONLY = ["claude-opus-4-7", "claude-opus-4-8", "claude-opus-5"]

// Whether a model is served only from a multi-region pool. A version ("@20260101", "@default") is not part of the name.
export function isMultiRegionOnly(model: string): bool {
  let m = model.startsWith("vertex_ai/") ? model.slice(10) : model
  const at = m.indexOf("@")
  if (at >= 0) m = m.slice(0, at)
  return MULTI_REGION_ONLY.includes(m)
}

// The multi-region pool of a single region (Bifrost's vertexRegionToPool): "us" for us-*, "eu" for europe-*, "" for
// a region with no pool.
export function regionPool(region: string): string {
  if (region.startsWith("us-")) return "us"
  if (region.startsWith("europe-")) return "eu"
  return ""
}

// The location a partner model is called in (Bifrost's getVertexEffectiveRegion): a multi-region-only model in a
// single region that belongs to a pool is promoted to the pool (its rep.googleapis.com host and location), unless
// force_single_region keeps the configured region (provisioned throughput).
export function effectiveRegion(region: string, model: string, forceSingle: bool): string {
  if (region === "global" || region === "us" || region === "eu") return region
  if (forceSingle || !isMultiRegionOnly(model)) return region
  const pool = regionPool(region)
  return pool === "" ? region : pool
}

// A model's URL under a publisher ("google" or "anthropic") and method, for the named model. A tuned Gemini model (an
// all-digit id) is an endpoint of the project, addressed by its project_number under v1beta1, as Bifrost addresses it.
// A partner model (not Google's) is called in its effective region (effectiveRegion, for the request's model, which
// regionModel names when the URL's model is another, as count-tokens is).
function vertexModelUrl(t: Target, publisher: string, model: string, method: string, regionModel?: string): string throws SyntaxError {
  const vk = t.key.vertex_key_config
  if (vk === undefined) throw new SyntaxError("vertex: key has no vertex_key_config")
  const reg = publisher === "google" ? vk.region : effectiveRegion(vk.region, regionModel ?? model, vk.force_single_region === true)
  const b = t.cfg.network_config?.base_url
  const origin = b === undefined || b === "" ? `https://${host(reg)}` : trimSlash(b)
  if (publisher === "google" && isEndpointModel(model)) {
    const num = vk.project_number ?? ""
    if (num === "") throw new SyntaxError("project number is not set for fine-tuned models")
    return `${origin}/v1beta1/projects/${num}/locations/${reg}/endpoints/${model}:${method}`
  }
  return `${origin}/v1/projects/${vk.project_id}/locations/${reg}/publishers/${publisher}/models/${model}:${method}`
}

// The model's URL under a publisher ("google" or "anthropic") and method.
function vertexUrl(t: Target, publisher: string, method: string): string throws SyntaxError {
  return try vertexModelUrl(t, publisher, t.model, method)
}

// A publisher's Model Garden listing, one page (publishers.models.list under v1beta1).
export function publisherListUrl(t: Target, publisher: string, pageToken: string): string throws SyntaxError {
  const vk = t.key.vertex_key_config
  if (vk === undefined) throw new SyntaxError("vertex: key has no vertex_key_config")
  const b = t.cfg.network_config?.base_url
  // (the multi-region hosts refuse publishers.models.list: the listing stays on the standard host)
  const lh = vk.region === "us" || vk.region === "eu" ? "aiplatform.googleapis.com" : host(vk.region)
  const origin = b === undefined || b === "" ? `https://${lh}` : trimSlash(b)
  const more = pageToken === "" ? "" : "&pageToken=" + pctEncode(pageToken)
  return `${origin}/v1beta1/publishers/${publisher}/models?pageSize=1000${more}`
}

// Count tokens on Vertex: Claude's count-tokens:rawPredict with the Messages body, or Gemini's
// :countTokens with the contents of the generateContent body. The bearer token is t.key.value.
export function countRequest(t: Target, generateBody: string, messagesBody: string): Upstream throws SyntaxError {
  let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + (t.key.value ?? "")]])
  addExtraHeaders(&h, t.cfg)
  if (isClaude(t.model)) {
    let fs = without(try fields(messagesBody), ["model"])
    setField(&fs, "anthropic_version", quote(ANTHROPIC_VERSION))
    return { url: try vertexModelUrl(t, "anthropic", "count-tokens", "rawPredict", t.model), headers: h, body: build(fs) }
  }
  const contents = find(try fields(generateBody), "contents")
  if (contents === undefined) throw new SyntaxError("generateContent body has no contents")
  return { url: try vertexUrl(t, "google", "countTokens"), headers: h, body: `{"contents":${contents}}` }
}

// The request for a chat completion. Claude models take the Anthropic Messages
// body, without model, and the Vertex version; other models take Gemini's body.
export function chatRequest(t: Target, req: ChatRequest, body: Field[], accessToken: string, autoCache?: bool): Upstream throws SyntaxError {
  let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + accessToken]])
  addExtraHeaders(&h, t.cfg)
  if (isClaude(t.model)) {
    // the provider's prompt_cache: its injection points mark messages and auto_inject places the breakpoints, as on
    // Anthropic (Gemini models have no per-block marker, so neither applies to them, as in Bifrost)
    const raw = try anthropic.messagesBody(req, body, t.model, false, autoCache === true, t.cfg.prompt_cache)
    let fs = without(try fields(raw), ["model"])
    setField(&fs, "anthropic_version", quote(ANTHROPIC_VERSION))
    return { url: try vertexUrl(t, "anthropic", "rawPredict"), headers: h, body: build(fs) }
  }
  if (isEndpointModel(t.model)) return { url: try vertexModelUrl(t, "google", t.model, "generateContent"), headers: h, body: try gemini.generateBody(req, body, t.model) }
  return { url: try vertexUrl(t, "google", "generateContent"), headers: h, body: try gemini.generateBody(req, body, t.model) }
}

// The streaming request: streamRawPredict (Anthropic events) for Claude models,
// streamGenerateContent as SSE (Gemini chunks) for the rest.
export function streamRequest(t: Target, req: ChatRequest, body: Field[], accessToken: string, autoCache?: bool): Upstream throws SyntaxError {
  let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + accessToken]])
  addExtraHeaders(&h, t.cfg)
  if (isClaude(t.model)) {
    const raw = try anthropic.messagesBody(req, body, t.model, true, autoCache === true, t.cfg.prompt_cache)
    let fs = without(try fields(raw), ["model"])
    setField(&fs, "anthropic_version", quote(ANTHROPIC_VERSION))
    return { url: try vertexUrl(t, "anthropic", "streamRawPredict"), headers: h, body: build(fs) }
  }
  if (isEndpointModel(t.model)) return { url: (try vertexModelUrl(t, "google", t.model, "streamGenerateContent")) + "?alt=sse", headers: h, body: try gemini.generateBody(req, body, t.model) }
  return { url: (try vertexUrl(t, "google", "streamGenerateContent")) + "?alt=sse", headers: h, body: try gemini.generateBody(req, body, t.model) }
}

// The request of a body that is converted while it streams in (streamconv.tov): the URL and headers, and no body.
// Claude takes the Messages body at rawPredict (streamRawPredict for a stream), the others generateContent.
export function largeRequest(t: Target, accessToken: string, stream: bool): Upstream throws SyntaxError {
  let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + accessToken]])
  addExtraHeaders(&h, t.cfg)
  if (isClaude(t.model)) return { url: try vertexUrl(t, "anthropic", stream ? "streamRawPredict" : "rawPredict"), headers: h, body: "" }
  if (stream) return { url: (try vertexUrl(t, "google", "streamGenerateContent")) + "?alt=sse", headers: h, body: "" }
  return { url: try vertexUrl(t, "google", "generateContent"), headers: h, body: "" }
}

// The anthropic_version a Vertex Claude body carries.
export const CLAUDE_VERSION = ANTHROPIC_VERSION

// The OpenAI-shaped answer for a Vertex response, by the model's family.
export function chatResponse(model: string, text: string, requestedModel: string): Translated throws SyntaxError {
  if (isClaude(model)) return try anthropic.chatResponse(text, requestedModel)
  return try gemini.chatResponse(text, requestedModel)
}

