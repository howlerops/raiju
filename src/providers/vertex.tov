// Google Vertex AI: service-account OAuth, regional endpoints, and the Gemini
// and Claude request paths. The key's service account signs a JWT, which the
// token endpoint exchanges for a bearer token that lasts an hour.
import { Field, fields, find, quote, rawStr, rawNum, build, without, setField } from "../json"
import { Target, Upstream, Translated, headers, addExtraHeaders, trimSlash } from "./types"
import { ChatRequest } from "../schemas"
import { serviceAccountJwt } from "../jwt"
import * as anthropic from "./anthropic"
import * as gemini from "./gemini"

const SCOPE = "https://www.googleapis.com/auth/cloud-platform"
const DEFAULT_TOKEN_URI = "https://oauth2.googleapis.com/token"
const ANTHROPIC_VERSION = "vertex-2023-10-16"
const GRANT_PREFIX = "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Ajwt-bearer&assertion="

// The service-account JSON from a key's auth_credentials.
export type ServiceAccount = { client_email: string, private_key: string, token_uri?: string }

export function parseServiceAccount(text: string | undefined): ServiceAccount throws SyntaxError {
  if (text === undefined || text === "") throw new SyntaxError("vertex: auth_credentials is required")
  const sa = try JSON.parse(text) as ServiceAccount
  if (sa.client_email === "" || sa.private_key === "") throw new SyntaxError("vertex: auth_credentials needs client_email and private_key")
  return sa
}

type CachedToken = { token: string, expiresAt: int }

// Bearer tokens by client_email. A token is reused until less than 60 seconds
// of its life is left.
export class TokenCache {
  tokens: Map<string, CachedToken> = new Map()

  // The POST that exchanges a fresh JWT for an access token.
  tokenRequest(sa: ServiceAccount, nowSeconds: int): Upstream throws SyntaxError {
    const uri = sa.token_uri ?? DEFAULT_TOKEN_URI
    const jwt = try serviceAccountJwt(sa.client_email, sa.private_key, SCOPE, uri, nowSeconds)
    return {
      url: uri,
      headers: headers([["content-type", "application/x-www-form-urlencoded"]]),
      body: GRANT_PREFIX + jwt,
    }
  }

  // Keeps the access token from a token endpoint response.
  store(email: string, responseJson: string, nowSeconds: int): void throws SyntaxError {
    const fs = try fields(responseJson)
    const token = rawStr(fs, "access_token")
    if (token === undefined || token === "") {
      throw new SyntaxError(`vertex: token request failed: ${rawStr(fs, "error") ?? "no access_token"}`)
    }
    const expires = rawNum(fs, "expires_in")
    const ttl = expires === undefined ? 3600 : Math.floor(expires)
    this.tokens.set(email, { token: token, expiresAt: nowSeconds + ttl })
  }

  // The cached token, or undefined when none is stored or it is about to expire.
  get(email: string, nowSeconds: int): string | undefined {
    const c = this.tokens.get(email)
    if (c === undefined) return undefined
    if (c.expiresAt - nowSeconds <= 60) return undefined
    return c.token
  }
}

// Gemini and Claude share the regional host; "global" has no region prefix.
function host(region: string): string {
  return region === "global" ? "aiplatform.googleapis.com" : `${region}-aiplatform.googleapis.com`
}

function isClaude(model: string): bool {
  return model.startsWith("claude")
}

// The model's URL under a publisher ("google" or "anthropic") and method.
function vertexUrl(t: Target, publisher: string, method: string): string throws SyntaxError {
  const vk = t.key.vertex_key_config
  if (vk === undefined) throw new SyntaxError("vertex: key has no vertex_key_config")
  const b = t.cfg.network_config?.base_url
  const origin = b === undefined || b === "" ? `https://${host(vk.region)}` : trimSlash(b)
  return `${origin}/v1/projects/${vk.project_id}/locations/${vk.region}/publishers/${publisher}/models/${t.model}:${method}`
}

// The request for a chat completion. Claude models take the Anthropic Messages
// body, without model, and the Vertex version; other models take Gemini's body.
export function chatRequest(t: Target, req: ChatRequest, body: Field[], accessToken: string): Upstream throws SyntaxError {
  let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + accessToken]])
  addExtraHeaders(&h, t.cfg)
  if (isClaude(t.model)) {
    const raw = try anthropic.messagesBody(req, body, t.model, false, false)
    let fs = without(try fields(raw), ["model"])
    setField(&fs, "anthropic_version", quote(ANTHROPIC_VERSION))
    return { url: try vertexUrl(t, "anthropic", "rawPredict"), headers: h, body: build(fs) }
  }
  return { url: try vertexUrl(t, "google", "generateContent"), headers: h, body: try gemini.generateBody(req, body) }
}

// The OpenAI-shaped answer for a Vertex response, by the model's family.
export function chatResponse(model: string, text: string, requestedModel: string): Translated throws SyntaxError {
  if (isClaude(model)) return try anthropic.chatResponse(text, requestedModel)
  return try gemini.chatResponse(text, requestedModel)
}

