function target(model: string, region: string): Target {
  return { provider: "vertex", kind: "vertex", model: model, key: { vertex_key_config: { project_id: "my-proj", region: region } }, cfg: {} }
}

test("regional and global Vertex URLs", () => {
  expect(try vertexUrl(target("gemini-2.5-flash", "us-central1"), "google", "generateContent")).toBe(
    "https://us-central1-aiplatform.googleapis.com/v1/projects/my-proj/locations/us-central1/publishers/google/models/gemini-2.5-flash:generateContent")
  expect(try vertexUrl(target("gemini-2.5-flash", "global"), "google", "generateContent")).toBe(
    "https://aiplatform.googleapis.com/v1/projects/my-proj/locations/global/publishers/google/models/gemini-2.5-flash:generateContent")
  expect(try vertexUrl(target("claude-sonnet-4@20250514", "us-east5"), "anthropic", "rawPredict")).toBe(
    "https://us-east5-aiplatform.googleapis.com/v1/projects/my-proj/locations/us-east5/publishers/anthropic/models/claude-sonnet-4@20250514:rawPredict")
})

test("token request posts a signed JWT", () => {
  const sa: ServiceAccount = { client_email: "test-sa@example.iam.gserviceaccount.com", private_key: TEST_PKCS8 }
  const up = try new TokenCache().tokenRequest(sa, 1700000000)
  expect(up.url).toBe("https://oauth2.googleapis.com/token")
  expect(up.headers.get("content-type")).toBe("application/x-www-form-urlencoded")
  expect(up.body.startsWith(GRANT_PREFIX)).toBe(true)
  const jwt = up.body.slice(GRANT_PREFIX.byteLength)
  expect(jwt.startsWith("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.")).toBe(true)
  expect(jwt.split(".").length).toBe(3)
  const custom = try new TokenCache().tokenRequest({ client_email: "a@b", private_key: TEST_PKCS8, token_uri: "https://sts.test/token" }, 1)
  expect(custom.url).toBe("https://sts.test/token")
})

test("token cache reuses a token until 60 seconds are left", () => {
  const c = new TokenCache()
  try c.store("a@x", `{"access_token":"tok1","expires_in":3600,"token_type":"Bearer"}`, 1000)
  expect(c.get("a@x", 1000)).toBe("tok1")
  expect(c.get("a@x", 1000 + 3539)).toBe("tok1")
  expect(c.get("a@x", 1000 + 3540)).toBe(undefined)
  expect(c.get("b@x", 1000)).toBe(undefined)
  let threw = false
  try {
    c.store("a@x", `{"error":"invalid_grant"}`, 0)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("Anthropic body has the Vertex version and no model", () => {
  const raw = `{"model":"claude-sonnet-4@20250514","messages":[{"role":"user","content":"hi"}],"max_tokens":64}`
  const up = try chatRequest(target("claude-sonnet-4@20250514", "us-east5"), try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  expect(up.url).toBe("https://us-east5-aiplatform.googleapis.com/v1/projects/my-proj/locations/us-east5/publishers/anthropic/models/claude-sonnet-4@20250514:rawPredict")
  expect(up.body).toBe(`{"messages":[{"role":"user","content":[{"type":"text","text":"hi"}]}],"max_tokens":64,"anthropic_version":"vertex-2023-10-16"}`)
  expect(up.headers.get("authorization")).toBe("Bearer tok")
})

test("Gemini body goes to generateContent", () => {
  const raw = `{"model":"gemini-2.5-flash","messages":[{"role":"user","content":"hi"}]}`
  const up = try chatRequest(target("gemini-2.5-flash", "global"), try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  expect(up.url).toBe("https://aiplatform.googleapis.com/v1/projects/my-proj/locations/global/publishers/google/models/gemini-2.5-flash:generateContent")
  expect(up.body).toBe(`{"contents":[{"role":"user","parts":[{"text":"hi"}]}]}`)
})

test("responses translate by model family", () => {
  const a = try chatResponse("claude-sonnet-4", `{"id":"msg_1","type":"message","role":"assistant","content":[{"type":"text","text":"Hi"}],"stop_reason":"end_turn","usage":{"input_tokens":2,"output_tokens":1}}`, "vertex/claude-sonnet-4")
  expect(a.body.includes(`"content":"Hi"`)).toBe(true)
  const g = try chatResponse("gemini-2.5-flash", `{"candidates":[{"content":{"role":"model","parts":[{"text":"Yo"}]},"finishReason":"STOP"}]}`, "vertex/gemini-2.5-flash")
  expect(g.body.includes(`"content":"Yo"`)).toBe(true)
})

test("service account and key errors", () => {
  const sa = try parseServiceAccount(`{"client_email":"a@b","private_key":"k","token_uri":"https://t"}`)
  expect(sa.token_uri).toBe("https://t")
  let threw = false
  try {
    parseServiceAccount(undefined)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    chatRequest({ provider: "vertex", kind: "vertex", model: "gemini-2.5-flash", key: {}, cfg: {} }, { model: "x", messages: [] }, [], "tok")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})
