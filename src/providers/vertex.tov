function target(model: string, region: string): Target {
  return { provider: "vertex", kind: "vertex", model: model, key: { vertex_key_config: { project_id: "my-proj", region: region } }, cfg: {} }
}

test("regional and global Vertex URLs", () => {
  expect(try vertexUrl(target("gemini-2.5-flash", "us-central1"), "google", "generateContent")).toBe(
    "https://us-central1-aiplatform.googleapis.com/v1/projects/my-proj/locations/us-central1/publishers/google/models/gemini-2.5-flash:generateContent")
  expect(try vertexUrl(target("gemini-2.5-flash", "global"), "google", "generateContent")).toBe(
    "https://aiplatform.googleapis.com/v1/projects/my-proj/locations/global/publishers/google/models/gemini-2.5-flash:generateContent")
  expect(try vertexUrl(target("claude-sonnet-4@20250514", "us-east5"), "anthropic", "rawPredict")).toBe(
    "https://us-east5-aiplatform.googleapis.com/v1/projects/my-proj/locations/us-east5/publishers/anthropic/models/claude-sonnet-4@20250514:rawPredict")
})

test("token request posts a signed JWT", () => {
  const sa: ServiceAccount = { client_email: "test-sa@example.iam.gserviceaccount.com", private_key: TEST_PKCS8 }
  const up = try new TokenCache().tokenRequest(sa, 1700000000)
  expect(up.url).toBe("https://oauth2.googleapis.com/token")
  expect(up.headers.get("content-type")).toBe("application/x-www-form-urlencoded")
  expect(up.body.startsWith(GRANT_PREFIX)).toBe(true)
  const jwt = up.body.slice(GRANT_PREFIX.byteLength)
  expect(jwt.startsWith("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.")).toBe(true)
  expect(jwt.split(".").length).toBe(3)
  const custom = try new TokenCache().tokenRequest({ client_email: "a@b", private_key: TEST_PKCS8, token_uri: "https://sts.test/token" }, 1)
  expect(custom.url).toBe("https://sts.test/token")
})

test("token cache reuses a token until 60 seconds are left", () => {
  const c = new TokenCache()
  try c.store("a@x", `{"access_token":"tok1","expires_in":3600,"token_type":"Bearer"}`, 1000)
  expect(c.get("a@x", 1000)).toBe("tok1")
  expect(c.get("a@x", 1000 + 3539)).toBe("tok1")
  expect(c.get("a@x", 1000 + 3540)).toBe(undefined)
  expect(c.get("b@x", 1000)).toBe(undefined)
  let threw = false
  try {
    c.store("a@x", `{"error":"invalid_grant"}`, 0)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("Anthropic body has the Vertex version and no model", () => {
  const raw = `{"model":"claude-sonnet-4@20250514","messages":[{"role":"user","content":"hi"}],"max_tokens":64}`
  const up = try chatRequest(target("claude-sonnet-4@20250514", "us-east5"), try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  expect(up.url).toBe("https://us-east5-aiplatform.googleapis.com/v1/projects/my-proj/locations/us-east5/publishers/anthropic/models/claude-sonnet-4@20250514:rawPredict")
  expect(up.body).toBe(`{"messages":[{"role":"user","content":[{"type":"text","text":"hi"}]}],"max_tokens":64,"anthropic_version":"vertex-2023-10-16"}`)
  expect(up.headers.get("authorization")).toBe("Bearer tok")
})

test("Gemini body goes to generateContent", () => {
  const raw = `{"model":"gemini-2.5-flash","messages":[{"role":"user","content":"hi"}]}`
  const up = try chatRequest(target("gemini-2.5-flash", "global"), try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  expect(up.url).toBe("https://aiplatform.googleapis.com/v1/projects/my-proj/locations/global/publishers/google/models/gemini-2.5-flash:generateContent")
  expect(up.body).toBe(`{"contents":[{"role":"user","parts":[{"text":"hi"}]}]}`)
})

test("responses translate by model family", () => {
  const a = try chatResponse("claude-sonnet-4", `{"id":"msg_1","type":"message","role":"assistant","content":[{"type":"text","text":"Hi"}],"stop_reason":"end_turn","usage":{"input_tokens":2,"output_tokens":1}}`, "vertex/claude-sonnet-4")
  expect(a.body.includes(`"content":"Hi"`)).toBe(true)
  const g = try chatResponse("gemini-2.5-flash", `{"candidates":[{"content":{"role":"model","parts":[{"text":"Yo"}]},"finishReason":"STOP"}]}`, "vertex/gemini-2.5-flash")
  expect(g.body.includes(`"content":"Yo"`)).toBe(true)
})

test("service account and key errors", () => {
  const sa = try parseServiceAccount(`{"client_email":"a@b","private_key":"k","token_uri":"https://t"}`)
  expect(sa.token_uri).toBe("https://t")
  let threw = false
  try {
    parseServiceAccount(undefined)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    chatRequest({ provider: "vertex", kind: "vertex", model: "gemini-2.5-flash", key: {}, cfg: {} }, { model: "x", messages: [] }, [], "tok")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("auto_inject marks Claude on Vertex, and leaves Gemini alone", () => {
  const raw = `{"model":"m","messages":[{"role":"system","content":"rules"},{"role":"user","content":"hi"}]}`
  const up = try chatRequest(target("claude-sonnet-4-5", "us-east5"), try JSON.parse(raw) as ChatRequest, try fields(raw), "tok", true)
  expect(up.body.includes(`"system":[{"type":"text","text":"rules","cache_control":{"type":"ephemeral"}}]`)).toBe(true)
  const g = try chatRequest(target("gemini-2.5-flash", "us-east5"), try JSON.parse(raw) as ChatRequest, try fields(raw), "tok", true)
  expect(g.body.includes("cache_control")).toBe(false)
})

test("a tuned model (an endpoint id) is called under the project number", () => {
  const raw = `{"model":"m","messages":[{"role":"user","content":"hi"}]}`
  expect(isEndpointModel("1234567890")).toBe(true)
  expect(isEndpointModel("gemini-2.5-flash")).toBe(false)
  let t = target("1234567890", "us-central1")
  t.key.vertex_key_config!.project_number = "987"
  const up = try chatRequest(t, try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  expect(up.url).toBe("https://us-central1-aiplatform.googleapis.com/v1beta1/projects/987/locations/us-central1/endpoints/1234567890:generateContent")
  expect(up.body).toBe(`{"contents":[{"role":"user","parts":[{"text":"hi"}]}]}`)
  const st = try streamRequest(t, try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  expect(st.url.endsWith("/endpoints/1234567890:streamGenerateContent?alt=sse")).toBe(true)
  let msg = ""
  try {
    chatRequest(target("1234567890", "us-central1"), try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  } catch (e) {
    msg = e.message
  }
  expect(msg).toBe("project number is not set for fine-tuned models")
})

test("Claude on Vertex applies the provider's cache_control_injection_points", () => {
  const raw = `{"model":"m","messages":[{"role":"system","content":"rules"},{"role":"user","content":"one"},{"role":"assistant","content":"two"},{"role":"user","content":"three"}]}`
  let t = target("claude-sonnet-4-5", "us-east5")
  t.cfg = { prompt_cache: { cache_control_injection_points: [{ location: "message", role: "system" }, { location: "message", index: -1 }] } }
  const up = try chatRequest(t, try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  expect(up.body.includes(`"system":[{"type":"text","text":"rules","cache_control":{"type":"ephemeral"}}]`)).toBe(true)
  expect(up.body.includes(`{"type":"text","text":"three","cache_control":{"type":"ephemeral"}}`)).toBe(true)
  expect(up.body.includes(`{"type":"text","text":"one"}`)).toBe(true)
  const st = try streamRequest(t, try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  expect(st.body.includes(`"text":"three","cache_control"`)).toBe(true)
  // no points: no markers
  const plain = try chatRequest(target("claude-sonnet-4-5", "us-east5"), try JSON.parse(raw) as ChatRequest, try fields(raw), "tok")
  expect(plain.body.includes("cache_control")).toBe(false)
})

test("the multi-region locations use their rep hosts, and listing stays on the standard host", () => {
  expect(try vertexUrl(target("claude-sonnet-4@20250514", "us"), "anthropic", "rawPredict")).toBe(
    "https://aiplatform.us.rep.googleapis.com/v1/projects/my-proj/locations/us/publishers/anthropic/models/claude-sonnet-4@20250514:rawPredict")
  expect(vertexHost("eu")).toBe("aiplatform.eu.rep.googleapis.com")
  // a multi-region-only model is promoted to its region's pool, unless force_single_region keeps the region
  expect(try vertexUrl(target("claude-opus-4-7@20260416", "us-east5"), "anthropic", "rawPredict")).toBe(
    "https://aiplatform.us.rep.googleapis.com/v1/projects/my-proj/locations/us/publishers/anthropic/models/claude-opus-4-7@20260416:rawPredict")
  expect(try vertexUrl(target("claude-opus-5", "europe-west1"), "anthropic", "streamRawPredict")).toBe(
    "https://aiplatform.eu.rep.googleapis.com/v1/projects/my-proj/locations/eu/publishers/anthropic/models/claude-opus-5:streamRawPredict")
  expect((try vertexUrl(target("claude-opus-4-7", "asia-east1"), "anthropic", "rawPredict")).startsWith("https://asia-east1-aiplatform.googleapis.com/v1/projects/my-proj/locations/asia-east1/")).toBe(true)
  expect((try vertexUrl(target("claude-sonnet-4", "us-east5"), "anthropic", "rawPredict")).startsWith("https://us-east5-aiplatform.googleapis.com/")).toBe(true)
  let forced = target("claude-opus-4-7", "us-east5")
  forced.key.vertex_key_config!.force_single_region = true
  expect((try vertexUrl(forced, "anthropic", "rawPredict")).startsWith("https://us-east5-aiplatform.googleapis.com/v1/projects/my-proj/locations/us-east5/")).toBe(true)
  // count-tokens goes where the model is served
  const ct = try countRequest(target("claude-opus-4-8", "us-east5"), "{}", `{"model":"m","messages":[]}`)
  expect(ct.url).toBe("https://aiplatform.us.rep.googleapis.com/v1/projects/my-proj/locations/us/publishers/anthropic/models/count-tokens:rawPredict")
  expect(effectiveRegion("global", "claude-opus-4-7", false)).toBe("global")
  expect(isMultiRegionOnly("vertex_ai/claude-opus-4-7@default")).toBe(true)
  expect((try publisherListUrl(target("m", "us"), "google", "")).startsWith("https://aiplatform.googleapis.com/v1beta1/")).toBe(true)
})

test("a tuned model is the project's endpoint, addressed by project_number", () => {
  const t: Target = { provider: "vertex", kind: "vertex", model: "1234567890", key: { vertex_key_config: { project_id: "my-proj", region: "us-central1", project_number: "998877" } }, cfg: {} }
  expect(try vertexUrl(t, "google", "generateContent")).toBe("https://us-central1-aiplatform.googleapis.com/v1beta1/projects/998877/locations/us-central1/endpoints/1234567890:generateContent")
  let refused = ""
  try {
    vertexUrl(target("1234567890", "us-central1"), "google", "generateContent")
  } catch (e) {
    refused = e.message
  }
  expect(refused).toBe("project number is not set for fine-tuned models")
  expect(isEndpointModel("gemini-2.5-flash")).toBe(false)
})
