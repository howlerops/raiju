// Google Gemini (generativelanguage API): translates OpenAI chat requests and responses.
import { Field, fields, elements, find, quote, rawStr, isNull, build } from "../json"
import { fromChat, geminiThinkingConfig, geminiReasoning } from "../reasoning"
import { Target, Upstream, Translated, headers, addExtraHeaders, trimSlash } from "./types"
import { ChatRequest, ContentPart, newId, nowSeconds } from "../schemas"

function partsOf(c: string | ContentPart[] | undefined): string[] {
  if (c === undefined) return []
  if (typeof c === "string") return c === "" ? [] : [`{"text":${quote(c)}}`]
  const out: string[] = []
  for (const p of c) {
    if (p.type === "text" && p.text !== undefined) out.push(`{"text":${quote(p.text)}}`)
    else if (p.type === "image_url" && p.image_url !== undefined) {
      const url = p.image_url.url
      if (url.startsWith("data:")) {
        const semi = url.indexOf(";")
        const comma = url.indexOf(",")
        out.push(`{"inline_data":{"mime_type":${quote(url.slice(5, semi > 0 ? semi : comma))},"data":${quote(url.slice(comma + 1))}}}`)
      } else {
        out.push(`{"file_data":{"file_uri":${quote(url)}}}`)
      }
    }
  }
  return out
}

function argsObject(args: string): string {
  try {
    return build(fields(args))
  } catch (e) {
    return "{}"
  }
}

type Turn = { role: string, parts: string[] }

function pushTurn(inout turns: Turn[], role: string, parts: string[]): void {
  if (parts.length === 0) return
  const last = turns.length - 1
  if (last >= 0 && turns[last]!.role === role) {
    turns[last] = { role: role, parts: turns[last]!.parts.concat(parts) }
    return
  }
  turns.push({ role: role, parts: parts })
}

function declarations(raw: string): string throws SyntaxError {
  const out: string[] = []
  for (const el of try elements(raw)) {
    const fnRaw = find(try fields(el), "function")
    if (fnRaw === undefined) continue
    const fn = try fields(fnRaw)
    const parts = [`"name":${quote(rawStr(fn, "name") ?? "")}`]
    const desc = find(fn, "description")
    if (desc !== undefined && !isNull(desc)) parts.push(`"description":${desc}`)
    const params = find(fn, "parameters")
    if (params !== undefined && !isNull(params)) parts.push(`"parameters":${params}`)
    out.push("{" + parts.join(",") + "}")
  }
  return `[{"functionDeclarations":[${out.join(",")}]}]`
}

export function generateBody(req: ChatRequest, body: Field[], model?: string): string throws SyntaxError {
  let turns: Turn[] = []
  const system: string[] = []
  // Gemini names function responses by function, not by call id.
  const callNames: Map<string, string> = new Map()
  for (const m of req.messages) {
    if (m.role === "system" || m.role === "developer") {
      for (const p of partsOf(m.content)) system.push(p)
      continue
    }
    if (m.role === "tool") {
      const name = callNames.get(m.tool_call_id ?? "") ?? "tool"
      const text = typeof m.content === "string" ? m.content : (m.content ?? []).map((p) => p.text ?? "").join("")
      pushTurn(&turns, "user", [`{"functionResponse":{"name":${quote(name)},"response":{"content":${quote(text)}}}}`])
      continue
    }
    const role = m.role === "assistant" ? "model" : "user"
    const parts = partsOf(m.content)
    const calls = m.tool_calls
    if (calls !== undefined) {
      for (const c of calls) {
        callNames.set(c.id, c.function.name)
        parts.push(`{"functionCall":{"name":${quote(c.function.name)},"args":${argsObject(c.function.arguments)}}}`)
      }
    }
    pushTurn(&turns, role, parts)
  }
  const out: string[] = [`"contents":[${turns.map((t) => `{"role":"${t.role}","parts":[${t.parts.join(",")}]}`).join(",")}]`]
  if (system.length > 0) out.push(`"systemInstruction":{"parts":[${system.join(",")}]}`)
  const gen: string[] = []
  if (req.temperature !== undefined) gen.push(`"temperature":${req.temperature}`)
  if (req.top_p !== undefined) gen.push(`"topP":${req.top_p}`)
  const max = req.max_completion_tokens ?? req.max_tokens
  if (max !== undefined) gen.push(`"maxOutputTokens":${max}`)
  const stop = req.stop
  if (stop !== undefined) gen.push(`"stopSequences":${typeof stop === "string" ? `[${quote(stop)}]` : JSON.stringify(stop)}`)
  const rf = find(body, "response_format")
  if (rf !== undefined && rf.includes(`"json_object"`)) gen.push(`"responseMimeType":"application/json"`)
  const tc = geminiThinkingConfig(fromChat(body), model ?? "", max)
  if (tc !== undefined) gen.push(`"thinkingConfig":${tc}`)
  if (gen.length > 0) out.push(`"generationConfig":{${gen.join(",")}}`)
  const tools = find(body, "tools")
  if (tools !== undefined && !isNull(tools)) out.push(`"tools":${try declarations(tools)}`)
  return "{" + out.join(",") + "}"
}

function apiBase(t: Target): string {
  const b = t.cfg.network_config?.base_url
  if (b === undefined || b === "") return "https://generativelanguage.googleapis.com"
  return trimSlash(b)
}

export function upstreamHeaders(t: Target): Map<string, string> {
  let h = headers([["content-type", "application/json"], ["x-goog-api-key", t.key.value ?? ""]])
  addExtraHeaders(&h, t.cfg)
  return h
}

export function chatRequest(t: Target, req: ChatRequest, body: Field[]): Upstream throws SyntaxError {
  return { url: `${apiBase(t)}/v1beta/models/${t.model}:generateContent`, headers: upstreamHeaders(t), body: try generateBody(req, body, t.model) }
}

export function streamRequest(t: Target, req: ChatRequest, body: Field[]): Upstream throws SyntaxError {
  return { url: `${apiBase(t)}/v1beta/models/${t.model}:streamGenerateContent?alt=sse`, headers: upstreamHeaders(t), body: try generateBody(req, body, t.model) }
}

// Native passthrough for /genai routes.
export function nativeRequest(t: Target, method: string, body: string): Upstream {
  return { url: `${apiBase(t)}/v1beta/models/${t.model}:${method}`, headers: upstreamHeaders(t), body: body }
}

type GeminiUsage = { promptTokenCount?: int, candidatesTokenCount?: int, totalTokenCount?: int, thoughtsTokenCount?: int }

function finishReason(r: string | undefined, hasCalls: bool): string {
  if (hasCalls) return "tool_calls"
  if (r === "MAX_TOKENS") return "length"
  if (r === "SAFETY" || r === "RECITATION" || r === "BLOCKLIST" || r === "PROHIBITED_CONTENT") return "content_filter"
  return "stop"
}

export function chatResponse(text: string, requestedModel: string): Translated throws SyntaxError {
  const fs = try fields(text)
  const textParts: string[] = []
  const calls: string[] = []
  let finish: string | undefined = undefined
  let reasoning = ""
  const cands = find(fs, "candidates")
  if (cands !== undefined && !isNull(cands)) {
    const first = (try elements(cands))[0]
    if (first !== undefined) {
      const c = try fields(first)
      finish = rawStr(c, "finishReason")
      const content = find(c, "content")
      if (content !== undefined && !isNull(content)) {
        const parts = find(try fields(content), "parts")
        if (parts !== undefined) {
          reasoning = geminiReasoning(parts)
          for (const p of try elements(parts)) {
            const pf = try fields(p)
            if (find(pf, "thought") === "true") continue
            const t = rawStr(pf, "text")
            if (t !== undefined) textParts.push(t)
            const fc = find(pf, "functionCall")
            if (fc !== undefined) {
              const f = try fields(fc)
              const args = find(f, "args") ?? "{}"
              calls.push(`{"id":${quote(newId("call_"))},"type":"function","function":{"name":${quote(rawStr(f, "name") ?? "")},"arguments":${quote(args)}}}`)
            }
          }
        }
      }
    }
  }
  let pt = 0
  let ct = 0
  const u = find(fs, "usageMetadata")
  if (u !== undefined && !isNull(u)) {
    const usage = try JSON.parse(u) as GeminiUsage
    pt = usage.promptTokenCount ?? 0
    ct = (usage.candidatesTokenCount ?? 0) + (usage.thoughtsTokenCount ?? 0)
  }
  const joined = textParts.join("")
  const msg: string[] = [`"role":"assistant"`, `"content":${joined === "" && calls.length > 0 ? "null" : quote(joined)}`]
  if (reasoning !== "") msg.push(`"reasoning":${quote(reasoning)},"reasoning_content":${quote(reasoning)}`)
  if (calls.length > 0) msg.push(`"tool_calls":[${calls.join(",")}]`)
  const body = `{"id":${quote(newId("chatcmpl-"))},"object":"chat.completion","created":${nowSeconds()},"model":${quote(requestedModel)},` +
    `"choices":[{"index":0,"message":{${msg.join(",")}},"finish_reason":"${finishReason(finish, calls.length > 0)}"}],` +
    `"usage":{"prompt_tokens":${pt},"completion_tokens":${ct},"total_tokens":${pt + ct}}}`
  return { body: body, promptTokens: pt, completionTokens: ct }
}

test("translates a chat request to generateContent", () => {
  const raw = `{"model":"gemini/gemini-2.5-flash","messages":[{"role":"system","content":"terse"},{"role":"user","content":"hi"},
    {"role":"assistant","tool_calls":[{"id":"c1","type":"function","function":{"name":"weather","arguments":"{\\"city\\":\\"Oslo\\"}"}}]},
    {"role":"tool","tool_call_id":"c1","content":"rain"}],"max_tokens":50,
    "tools":[{"type":"function","function":{"name":"weather","parameters":{"type":"object"}}}]}`
  const out = try generateBody(try JSON.parse(raw) as ChatRequest, try fields(raw))
  expect(out.includes(`"systemInstruction":{"parts":[{"text":"terse"}]}`)).toBe(true)
  expect(out.includes(`{"role":"model","parts":[{"functionCall":{"name":"weather","args":{"city":"Oslo"}}}]}`)).toBe(true)
  expect(out.includes(`{"functionResponse":{"name":"weather","response":{"content":"rain"}}}`)).toBe(true)
  expect(out.includes(`"generationConfig":{"maxOutputTokens":50}`)).toBe(true)
  expect(out.includes(`"tools":[{"functionDeclarations":[{"name":"weather","parameters":{"type":"object"}}]}]`)).toBe(true)
})

test("translates a generateContent response", () => {
  const r = try chatResponse(`{"candidates":[{"content":{"role":"model","parts":[{"text":"Hello"},{"text":" there"}]},"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":3,"candidatesTokenCount":2,"totalTokenCount":5}}`, "gemini/gemini-2.5-flash")
  expect(r.body.includes(`"content":"Hello there"`)).toBe(true)
  expect(r.completionTokens).toBe(2)
  expect(r.body.includes(`"finish_reason":"stop"`)).toBe(true)
})

test("reasoning_effort becomes a thinking config; thoughts come back as reasoning", () => {
  const raw = `{"model":"m","messages":[{"role":"user","content":"hi"}],"reasoning_effort":"low","max_tokens":2000}`
  const out = try generateBody(try JSON.parse(raw) as ChatRequest, try fields(raw), "gemini-2.5-flash")
  expect(out.includes(`"thinkingConfig":{"thinkingBudget":`)).toBe(true)
  const r = try chatResponse(`{"candidates":[{"content":{"parts":[{"text":"plan","thought":true},{"text":"ok"}]},"finishReason":"STOP"}]}`, "m")
  expect(r.body.includes(`"content":"ok"`)).toBe(true)
  expect(r.body.includes(`"reasoning":"plan","reasoning_content":"plan"`)).toBe(true)
})
