// Bedrock Mantle: Bedrock's endpoint on bedrock-mantle.<region>.api.aws. gpt-*, Gemma and Grok
// models use its OpenAI-compatible surface (the reply is openai.tov's). Anthropic-family models
// use the native Messages surface on the same host, /anthropic/v1/messages with an
// anthropic-version header (the reply is anthropic.tov's).
import { Field, build, fields, quote, setField, without } from "../json"
import { Target, Upstream, Translated, headers, addExtraHeaders } from "./types"
import * as openai from "./openai"
import * as anthropic from "./anthropic"
import { AwsCreds, signV4 } from "../cloud_auth"
import { signRequest } from "./bedrock"
import { BedrockKeyConfig, ProviderPromptCacheConfig } from "../config"
import { ChatRequest } from "../schemas"

const DEFAULT_REGION = "us-east-1"
const SIGNING_SERVICE = "bedrock-mantle"
const ANTHROPIC_VERSION = "2023-06-01"

// A region name such as "us-west-2": lower-case letters and digits, hyphens, ending in a digit.
function isRegion(s: string): bool {
  if (s.indexOf("-") < 0) return false
  if (!"0123456789".includes(s.slice(s.byteLength - 1))) return false
  for (const c of s.chars()) {
    if (!"abcdefghijklmnopqrstuvwxyz0123456789-".includes(c)) return false
  }
  return true
}

// Splits Bifrost's per-request "region/model" form. The region is undefined when the
// model has no such prefix.
export function splitRegion(model: string): { region: string | undefined, model: string } {
  const slash = model.indexOf("/")
  if (slash > 0 && isRegion(model.slice(0, slash))) {
    return { region: model.slice(0, slash), model: model.slice(slash + 1) }
  }
  return { region: undefined, model: model }
}

// The OpenAI-compatible base path. gpt-5/6, Gemma 4 and Grok are served under
// /openai/v1, the rest under /v1 (as Bifrost's fallback routing does).
export function basePath(model: string): string {
  const m = model.toLowerCase()
  if (m.includes("gpt-5") || m.includes("gpt-6") || m.includes("gemma-4") || m.includes("grok")) return "openai/v1"
  return "v1"
}

export function isAnthropicFamily(model: string): bool {
  const m = model.toLowerCase()
  return m.startsWith("anthropic.") || m.includes("claude")
}

// The scheme and host for a region: the key's base_url when set (a proxy, or the mock in
// tests), else the public Mantle host.
function origin(t: Target, region: string): { sch: string, host: string } {
  const b = t.cfg.network_config?.base_url
  if (b !== undefined && b !== "") {
    const u = URL.parse(b)
    if (u !== undefined) return { sch: b.startsWith("http://") ? "http://" : "https://", host: u.host }
  }
  return { sch: "https://", host: `bedrock-mantle.${region}.api.aws` }
}

// The OpenAI body with gateway-only fields dropped and the model set to the name
// Mantle knows (sent verbatim, with no regional prefix).
function withModel(body: Field[], model: string): string {
  let fs = without(body, openai.GATEWAY_FIELDS)
  setField(&fs, "model", quote(model))
  return build(fs)
}

// The OpenAI body as an Anthropic Messages body for an Anthropic-family model. The provider's prompt_cache injection
// points mark messages, and auto_inject places the breakpoints, as on Anthropic.
function messagesText(body: Field[], model: string, cache?: ProviderPromptCacheConfig, autoCache?: bool): string throws SyntaxError {
  const req = try JSON.parse(build(body)) as ChatRequest
  return try anthropic.messagesBody(req, body, model, false, autoCache === true, cache)
}

// The chat POST at a given time. Bearer auth when the key has a value; otherwise SigV4
// with the key's access keys, signed for service "bedrock-mantle".
export function chatRequestAt(t: Target, body: Field[], nowMs: f64, autoCache?: bool): Upstream throws SyntaxError {
  const sel = splitRegion(t.model)
  const anth = isAnthropicFamily(sel.model)
  const path = anth ? "/anthropic/v1/messages" : `/${basePath(sel.model)}/chat/completions`
  let text = ""
  if (anth) text = try messagesText(body, sel.model, t.cfg.prompt_cache, autoCache)
  else text = withModel(body, sel.model)
  return try postAt(t, sel.region, path, text, anth, nowMs)
}

// Whether a Responses request goes to Mantle's own Responses endpoint: the OpenAI-compatible models (gpt-*, Gemma,
// Grok) are served there, as Bifrost's Responses sends them (its datasheet check falls back to yes); Claude models
// are answered through the Messages surface (the chat bridge).
export function servesResponses(model: string): bool {
  return !isAnthropicFamily(splitRegion(model).model)
}

// The Responses POST: the caller's Responses body with the bare model, on the model's base path.
export function responsesRequestAt(t: Target, body: Field[], nowMs: f64): Upstream throws SyntaxError {
  const sel = splitRegion(t.model)
  return try postAt(t, sel.region, `/${basePath(sel.model)}/responses`, withModel(body, sel.model), false, nowMs)
}

export function responsesRequest(t: Target, body: Field[]): Upstream throws SyntaxError {
  return try responsesRequestAt(t, body, Date.now())
}

// The Bedrock project the key (or an alias's override, put on the key) scopes the call to, or "" for the account's
// default project.
function projectOf(t: Target): string {
  return t.key.bedrock_key_config?.project_id ?? ""
}

// The project header: OpenAI-Project on the OpenAI-compatible surface, anthropic-workspace-id on the Messages
// surface (Bifrost's MantleOpenAIProjectHeader and MantleAnthropicProjectHeader). It is a plain header, outside the
// signature.
function setProject(inout h: Map<string, string>, t: Target, anth: bool): void {
  const p = projectOf(t)
  if (p !== "") h.set(anth ? "anthropic-workspace-id" : "OpenAI-Project", p)
}

// A POST to the Mantle host of the request's region (the model's prefix, else the key's, else us-east-1).
function postAt(t: Target, modelRegion: string | undefined, path: string, text: string, anth: bool, nowMs: f64): Upstream throws SyntaxError {
  const bk = t.key.bedrock_key_config
  const region = modelRegion ?? bk?.region ?? DEFAULT_REGION
  const at = origin(t, region)
  const extra = t.cfg.network_config?.extra_headers
  const bearer = t.key.value ?? ""
  if (bearer !== "") {
    let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + bearer]])
    if (anth) h.set("anthropic-version", ANTHROPIC_VERSION)
    setProject(&h, t, anth)
    addExtraHeaders(&h, t.cfg)
    return { url: at.sch + at.host + path, headers: h, body: text }
  }
  const ak = bk?.access_key ?? ""
  if (ak === "") throw new SyntaxError("bedrock_mantle: the key needs a value (API key) or access_key and secret_key")
  // x-amz-* extra headers are part of the signature; the rest are added after signing
  const signedExtra: string[][] = [["accept", "application/json"]]
  if (extra !== undefined) {
    for (const k of extra.keys()) {
      const lk = k.toLowerCase()
      if (lk.startsWith("x-amz-")) signedExtra.push([lk, extra.get(k)!])
    }
  }
  const creds: AwsCreds = { accessKey: ak, secretKey: bk?.secret_key ?? "", sessionToken: bk?.session_token ?? "" }
  let h = signV4(creds, region, SIGNING_SERVICE, at.host, path, "application/json", text, nowMs, signedExtra)
  if (anth) h.set("anthropic-version", ANTHROPIC_VERSION)
  setProject(&h, t, anth)
  if (extra !== undefined) {
    for (const k of extra.keys()) {
      if (!k.toLowerCase().startsWith("x-amz-")) h.set(k, extra.get(k)!)
    }
  }
  return { url: at.sch + at.host + path, headers: h, body: text }
}

// The model listing: GET /v1/models on the key's regional host (OpenAI's list shape), as Bifrost's
// listModelsByKey sends it: a bearer token for an API key, else the GET signed for bedrock-mantle.
export function modelsRequestAt(t: Target, nowMs: f64): Upstream {
  const bk = t.key.bedrock_key_config
  const region = bk?.region ?? DEFAULT_REGION
  const at = origin(t, region)
  const path = "/v1/models"
  const bearer = t.key.value ?? ""
  let h: Map<string, string> = new Map()
  if (bearer !== "" || (bk?.access_key ?? "") === "") h = headers([["authorization", "Bearer " + bearer]])
  else h = signRequest("GET", { accessKey: bk?.access_key ?? "", secretKey: bk?.secret_key ?? "", sessionToken: bk?.session_token, region: region }, SIGNING_SERVICE, at.host, path, "", "", nowMs)
  // the catalog is scoped to the key's project, as Bifrost's listing sends it
  setProject(&h, t, false)
  addExtraHeaders(&h, t.cfg)
  return { url: at.sch + at.host + path, headers: h, body: "" }
}

export function modelsRequest(t: Target): Upstream {
  return modelsRequestAt(t, Date.now())
}

// Bifrost counts tokens on Mantle for Anthropic-family models only, through the native count_tokens path on the same
// host (bedrockmantle/counttokens.go); the OpenAI-compatible surface has no count path.
export function countsTokens(model: string): bool {
  return isAnthropicFamily(splitRegion(model).model)
}

// The count POST: a Messages body (built by the caller) with the bare model, without the fields count_tokens refuses.
export function countRequestAt(t: Target, messagesBody: string, nowMs: f64): Upstream throws SyntaxError {
  const sel = splitRegion(t.model)
  let fs = without(try fields(messagesBody), ["max_tokens", "stream", "temperature"])
  setField(&fs, "model", quote(sel.model))
  return try postAt(t, sel.region, "/anthropic/v1/messages/count_tokens", build(fs), true, nowMs)
}

export function countRequest(t: Target, messagesBody: string): Upstream throws SyntaxError {
  return try countRequestAt(t, messagesBody, Date.now())
}

export function chatRequest(t: Target, body: Field[], autoCache?: bool): Upstream throws SyntaxError {
  return try chatRequestAt(t, body, Date.now(), autoCache)
}

// Mantle answers an OpenAI-family model in the OpenAI shape and a Claude model in the
// Messages shape; the requested model tells them apart.
export function chatResponse(text: string, requestedModel: string): Translated throws SyntaxError {
  if (isAnthropicFamily(requestedModel)) return try anthropic.chatResponse(text, requestedModel)
  return try openai.chatResponse(text, requestedModel)
}

function mantleTarget(model: string, value: string, region: string | undefined): Target {
  const bk: BedrockKeyConfig | undefined = region === undefined ? undefined : { access_key: "AKIDEXAMPLE", secret_key: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY", region: region }
  return { provider: "bedrock_mantle", kind: "bedrock_mantle", model: model, key: { value: value, bedrock_key_config: bk }, cfg: {} }
}

test("base path follows the model family", () => {
  expect(basePath("openai.gpt-5.5")).toBe("openai/v1")
  expect(basePath("openai.gpt-6-luna")).toBe("openai/v1")
  expect(basePath("google.gemma-4-31b")).toBe("openai/v1")
  expect(basePath("openai.gpt-oss-120b")).toBe("v1")
  expect(basePath("deepseek.v3.2")).toBe("v1")
})

test("a region prefix on the model selects the region", () => {
  const a = splitRegion("us-west-2/openai.gpt-5.5")
  expect(a.region).toBe("us-west-2")
  expect(a.model).toBe("openai.gpt-5.5")
  const b = splitRegion("openai.gpt-5.5")
  expect(b.region).toBeUndefined()
  expect(b.model).toBe("openai.gpt-5.5")
  expect(splitRegion("zai/glm").region).toBeUndefined()
})

test("bearer request goes to the regional OpenAI-compatible path", () => {
  const body = try fields(`{"model":"gpt","messages":[{"role":"user","content":"hi"}],"max_tokens":5,"fallbacks":["x"],"provider":"p"}`)
  const up = try chatRequestAt(mantleTarget("openai.gpt-5.5", "mk-123", undefined), body, 1440938160000.0)
  expect(up.url).toBe("https://bedrock-mantle.us-east-1.api.aws/openai/v1/chat/completions")
  expect(up.headers.get("authorization")).toBe("Bearer mk-123")
  expect(up.headers.get("content-type")).toBe("application/json")
  expect(up.body).toBe(`{"model":"openai.gpt-5.5","messages":[{"role":"user","content":"hi"}],"max_tokens":5}`)
})

test("sigv4 request is signed for bedrock-mantle in the key's region", () => {
  const body = try fields(`{"model":"gpt","messages":[{"role":"user","content":"hi"}],"max_tokens":5}`)
  const up = try chatRequestAt(mantleTarget("us-west-2/openai.gpt-oss-120b", "", "us-west-2"), body, 1440938160000.0)
  expect(up.url).toBe("https://bedrock-mantle.us-west-2.api.aws/v1/chat/completions")
  expect(up.headers.get("x-amz-date")).toBe("20150830T123600Z")
  expect(up.headers.has("host")).toBe(false)
  expect(up.headers.has("authorization")).toBe(true)
  const auth = up.headers.get("authorization")!
  expect(auth.startsWith("AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-west-2/bedrock-mantle/aws4_request, SignedHeaders=accept;content-type;host;x-amz-date, Signature=")).toBe(true)
  // reference from a Python hmac/hashlib implementation (scratch script, not in the repo)
  expect(auth.endsWith("Signature=f66fd317c719543a2834ca8cbe1b1c415802039f809c5dec4f4c45b47fecc151")).toBe(true)
})

test("claude-family requests go to the native Messages path with anthropic-version", () => {
  const body = try fields(`{"model":"gpt","messages":[{"role":"system","content":"be brief"},{"role":"user","content":"hi"}],"max_tokens":9,"fallbacks":["x"]}`)
  const up = try chatRequestAt(mantleTarget("anthropic.claude-haiku-4-5", "mk", undefined), body, 0.0)
  expect(up.url).toBe("https://bedrock-mantle.us-east-1.api.aws/anthropic/v1/messages")
  expect(up.headers.get("anthropic-version")).toBe("2023-06-01")
  expect(up.headers.get("authorization")).toBe("Bearer mk")
  expect(up.body.includes(`"model":"anthropic.claude-haiku-4-5"`)).toBe(true)
  expect(up.body.includes(`"system":"be brief"`)).toBe(true)
  expect(up.body.includes(`"max_tokens":9`)).toBe(true)
  expect(up.body.includes(`"fallbacks"`)).toBe(false)
  // SigV4 signs the same path for Claude
  const sg = try chatRequestAt(mantleTarget("us-west-2/anthropic.claude-haiku-4-5", "", "us-west-2"), body, 1440938160000.0)
  expect(sg.url).toBe("https://bedrock-mantle.us-west-2.api.aws/anthropic/v1/messages")
  expect(sg.headers.get("anthropic-version")).toBe("2023-06-01")
  expect(sg.headers.get("authorization")!.includes("/us-west-2/bedrock-mantle/aws4_request")).toBe(true)
})

test("keyless requests are refused", () => {
  const body = try fields(`{"model":"gpt","messages":[]}`)
  let msg = ""
  try {
    chatRequestAt(mantleTarget("openai.gpt-5.5", "", undefined), body, 0.0)
  } catch (e) {
    msg = e.message
  }
  expect(msg.includes("needs a value")).toBe(true)
})

test("the key's base_url replaces the Mantle host", () => {
  const body = try fields(`{"model":"gpt","messages":[{"role":"user","content":"hi"}]}`)
  const t: Target = { provider: "bedrock_mantle", kind: "bedrock_mantle", model: "openai.gpt-5.5", key: { value: "mk" }, cfg: { network_config: { base_url: "http://127.0.0.1:18099" } } }
  const up = try chatRequestAt(t, body, 0.0)
  expect(up.url).toBe("http://127.0.0.1:18099/openai/v1/chat/completions")
})

test("mantle chat reply is read as an OpenAI reply", () => {
  const r = try chatResponse(`{"id":"x","object":"chat.completion","choices":[],"usage":{"prompt_tokens":3,"completion_tokens":4,"total_tokens":7}}`, "bedrock_mantle/openai.gpt-5.5")
  expect(r.promptTokens).toBe(3)
  expect(r.completionTokens).toBe(4)
  expect(r.body.includes(`"model":"bedrock_mantle/openai.gpt-5.5"`)).toBe(true)
})

test("mantle Messages reply is read as an Anthropic reply", () => {
  const r = try chatResponse(`{"id":"msg_1","type":"message","role":"assistant","model":"anthropic.claude-haiku-4-5","content":[{"type":"text","text":"hey"}],"stop_reason":"end_turn","usage":{"input_tokens":5,"output_tokens":6}}`, "bedrock_mantle/anthropic.claude-haiku-4-5")
  expect(r.promptTokens).toBe(5)
  expect(r.completionTokens).toBe(6)
  expect(r.body.includes(`"content":"hey"`)).toBe(true)
})

test("the model listing is a GET on the key's regional host", () => {
  const up = modelsRequestAt(mantleTarget("", "mk", undefined), 0.0)
  expect(up.url).toBe("https://bedrock-mantle.us-east-1.api.aws/v1/models")
  expect(up.headers.get("authorization")).toBe("Bearer mk")
  expect(up.body).toBe("")
  const sg = modelsRequestAt(mantleTarget("", "", "us-west-2"), 1440938160000.0)
  expect(sg.url).toBe("https://bedrock-mantle.us-west-2.api.aws/v1/models")
  expect(sg.headers.get("authorization")!.startsWith("AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-west-2/bedrock-mantle/aws4_request")).toBe(true)
})

test("count tokens goes to the native count path for Claude models only", () => {
  expect(countsTokens("anthropic.claude-haiku-4-5")).toBe(true)
  expect(countsTokens("us-west-2/anthropic.claude-haiku-4-5")).toBe(true)
  expect(countsTokens("openai.gpt-5.5")).toBe(false)
  const up = try countRequestAt(mantleTarget("us-west-2/anthropic.claude-haiku-4-5", "mk", undefined), `{"model":"x","max_tokens":10,"temperature":0.2,"messages":[{"role":"user","content":[{"type":"text","text":"hi"}]}]}`, 0.0)
  expect(up.url).toBe("https://bedrock-mantle.us-west-2.api.aws/anthropic/v1/messages/count_tokens")
  expect(up.headers.get("anthropic-version")).toBe("2023-06-01")
  expect(up.body).toBe(`{"model":"anthropic.claude-haiku-4-5","messages":[{"role":"user","content":[{"type":"text","text":"hi"}]}]}`)
})

test("project_id scopes calls and the listing: OpenAI-Project, or anthropic-workspace-id for Claude", () => {
  const body = try fields(`{"model":"m","messages":[{"role":"user","content":"hi"}]}`)
  let t = mantleTarget("openai.gpt-oss-120b", "mk", undefined)
  t.key.bedrock_key_config = { project_id: "proj-1" }
  expect((try chatRequestAt(t, body, 0.0)).headers.get("OpenAI-Project")).toBe("proj-1")
  expect(modelsRequestAt(t, 0.0).headers.get("OpenAI-Project")).toBe("proj-1")
  t.model = "anthropic.claude-haiku-4-5"
  const anth = try chatRequestAt(t, body, 0.0)
  expect(anth.headers.get("anthropic-workspace-id")).toBe("proj-1")
  expect(anth.headers.has("OpenAI-Project")).toBe(false)
  // signed calls carry it too, outside the signature
  const sg = mantleTarget("openai.gpt-oss-120b", "", "us-west-2")
  sg.key.bedrock_key_config!.project_id = "proj-2"
  const up = try chatRequestAt(sg, body, 1440938160000.0)
  expect(up.headers.get("OpenAI-Project")).toBe("proj-2")
  expect(up.headers.get("authorization")!.includes("openai-project")).toBe(false)
  // none set: no header
  expect((try chatRequestAt(mantleTarget("openai.gpt-oss-120b", "mk", undefined), body, 0.0)).headers.has("OpenAI-Project")).toBe(false)
})

test("Responses go to Mantle's own endpoint for the OpenAI-compatible models", () => {
  expect(servesResponses("openai.gpt-oss-120b")).toBe(true)
  expect(servesResponses("us-west-2/anthropic.claude-haiku-4-5")).toBe(false)
  const up = try responsesRequestAt(mantleTarget("us-west-2/openai.gpt-5.5", "mk", undefined), try fields(`{"model":"bedrock_mantle/x","input":"hi","fallbacks":["a"]}`), 0.0)
  expect(up.url).toBe("https://bedrock-mantle.us-west-2.api.aws/openai/v1/responses")
  expect(up.body).toBe(`{"model":"openai.gpt-5.5","input":"hi"}`)
  expect(up.headers.get("authorization")).toBe("Bearer mk")
})

test("auto_inject marks Claude's prompt on Mantle", () => {
  const body = try fields(`{"model":"m","messages":[{"role":"system","content":"rules"},{"role":"user","content":"hi"}]}`)
  const up = try chatRequestAt(mantleTarget("anthropic.claude-haiku-4-5", "mk", undefined), body, 0.0, true)
  expect(up.body.includes(`"system":[{"type":"text","text":"rules","cache_control":{"type":"ephemeral"}}]`)).toBe(true)
  const off = try chatRequestAt(mantleTarget("anthropic.claude-haiku-4-5", "mk", undefined), body, 0.0)
  expect(off.body.includes("cache_control")).toBe(false)
})

test("Claude on Mantle applies the provider's cache_control_injection_points", () => {
  const body = try fields(`{"model":"m","messages":[{"role":"user","content":"one"},{"role":"assistant","content":"two"},{"role":"user","content":"three"}]}`)
  let t = mantleTarget("anthropic.claude-haiku-4-5", "mk", undefined)
  t.cfg = { prompt_cache: { cache_control_injection_points: [{ location: "message", index: -1 }] } }
  const up = try chatRequestAt(t, body, 0.0)
  expect(up.body.includes(`{"type":"text","text":"three","cache_control":{"type":"ephemeral"}}`)).toBe(true)
  expect(up.body.includes(`{"type":"text","text":"one"}`)).toBe(true)
})
