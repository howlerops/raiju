// OpenAI and every provider that speaks its wire format. Requests pass through
// with only the model rewritten and gateway-only fields removed.
import { Field, build, quote, setField, without, fields, find, elements, isNull } from "../json"
import { Target, Upstream, Translated, headers, addExtraHeaders, trimSlash } from "./types"
import { UsageOnly } from "../schemas"
import { longtailTable } from "./longtail"

// Default base URL and path prefix per OpenAI-compatible provider. As in
// Bifrost, network_config.base_url replaces the base and the path is appended.
type Endpoint = { base: string, prefix: string }

function makeEndpoints(): Map<string, Endpoint> {
  const m: Map<string, Endpoint> = new Map()
  m.set("openai", { base: "https://api.openai.com", prefix: "/v1" })
  m.set("groq", { base: "https://api.groq.com/openai", prefix: "/v1" })
  m.set("mistral", { base: "https://api.mistral.ai", prefix: "/v1" })
  m.set("xai", { base: "https://api.x.ai", prefix: "/v1" })
  m.set("deepseek", { base: "https://api.deepseek.com", prefix: "/v1" })
  m.set("cerebras", { base: "https://api.cerebras.ai", prefix: "/v1" })
  m.set("fireworks", { base: "https://api.fireworks.ai/inference", prefix: "/v1" })
  m.set("together", { base: "https://api.together.xyz", prefix: "/v1" })
  m.set("nebius", { base: "https://api.studio.nebius.ai", prefix: "/v1" })
  m.set("parasail", { base: "https://api.parasail.io", prefix: "/v1" })
  m.set("openrouter", { base: "https://openrouter.ai/api", prefix: "/v1" })
  m.set("perplexity", { base: "https://api.perplexity.ai", prefix: "" })
  m.set("ollama", { base: "http://localhost:11434", prefix: "/v1" })
  m.set("vllm", { base: "http://localhost:8000", prefix: "/v1" })
  m.set("sgl", { base: "http://localhost:30000", prefix: "/v1" })
  m.set("lmstudio", { base: "http://localhost:1234", prefix: "/v1" })
  const extra = longtailTable()
  for (const k of extra.keys()) m.set(k, extra.get(k)!)
  return m
}

const ENDPOINTS: Map<string, Endpoint> = makeEndpoints()

export function isOpenAICompatible(kind: string): bool {
  return ENDPOINTS.has(kind)
}

export function knownOpenAIKinds(): string[] {
  return ENDPOINTS.keys()
}

// Fields only the gateway reads; providers reject unknown fields.
export const GATEWAY_FIELDS = ["fallbacks", "provider", "bifrost", "raiju"]

function endpoint(t: Target): string {
  const e = ENDPOINTS.get(t.kind) ?? { base: "https://api.openai.com", prefix: "/v1" }
  const base = t.cfg.network_config?.base_url
  if (base === undefined || base === "") return e.base + e.prefix
  const b = trimSlash(base)
  // A base_url given with its version path (".../v1") is used as is.
  if (e.prefix !== "" && b.endsWith(e.prefix)) return b
  return b + e.prefix
}

function authHeaders(t: Target): Map<string, string> {
  let h = headers([["content-type", "application/json"]])
  const v = t.key.value ?? ""
  if (v !== "") h.set("authorization", "Bearer " + v)
  addExtraHeaders(&h, t.cfg)
  return h
}

// vLLM's rerank API (Cohere's request and response shape) at <base>/v1/rerank.
export function rerankRequest(t: Target, body: Field[]): Upstream {
  const out: string[] = [`"model":${quote(t.model)}`]
  for (const k of ["query", "documents", "top_n", "return_documents"]) {
    const v = find(body, k)
    if (v !== undefined && !isNull(v)) out.push(`${quote(k)}:${v}`)
  }
  return { url: endpoint(t) + "/rerank", headers: authHeaders(t), body: "{" + out.join(",") + "}" }
}

function modelFields(body: Field[], model: string): Field[] {
  let fs = without(body, GATEWAY_FIELDS)
  setField(&fs, "model", quote(model))
  return fs
}

function withModel(body: Field[], model: string): string {
  return build(modelFields(body, model))
}

// Bifrost's custom_provider_config.request_path_overrides: the path that replaces the default
// for one request type, from the provider's config. An absolute URL is used as it is.
function pathOverride(t: Target, requestType: string): string | undefined {
  const overrides = t.cfg.custom_provider_config?.request_path_overrides
  if (overrides === undefined) return undefined
  const raw = overrides.get(requestType)
  if (raw === undefined) return undefined
  const path = raw.trim()
  if (path === "") return undefined
  if (path.startsWith("http://") || path.startsWith("https://")) return path
  const dflt: string = ENDPOINTS.get(t.kind)?.base ?? "https://api.openai.com"
  const base: string = trimSlash(t.cfg.network_config?.base_url ?? dflt)
  return base + (path.startsWith("/") ? path : "/" + path)
}

// The upstream URL for a request type: the override when one is configured, else the default.
function urlFor(t: Target, requestType: string, dflt: string): string {
  const o = pathOverride(t, requestType)
  if (o === undefined) return dflt
  return o
}

// Bifrost's openai_config.disable_store: stored responses are turned off, so store is forced to false.
function disablesStore(t: Target): bool {
  const v: bool = t.cfg.openai_config?.disable_store ?? false
  return v
}

function storeOff(body: Field[], t: Target): Field[] {
  if (!disablesStore(t)) return body
  let fs = body
  setField(&fs, "store", "false")
  return fs
}

function azureUrl(t: Target, op: string): string {
  const az = t.key.azure_key_config
  const endpointUrl = trimSlash(az?.endpoint ?? t.cfg.network_config?.base_url ?? "")
  let deployment = t.model
  const deps = az?.deployments
  if (deps !== undefined) deployment = deps.get(t.model) ?? t.model
  const version = az?.api_version ?? "2024-10-21"
  return `${endpointUrl}/openai/deployments/${deployment}/${op}?api-version=${version}`
}

function azureHeaders(t: Target): Map<string, string> {
  // an Entra ID token goes in authorization; an API key in api-key
  const entra = t.key.azure_key_config?.tenant_id !== undefined
  let h = entra ? headers([["content-type", "application/json"], ["authorization", "Bearer " + (t.key.value ?? "")]]) : headers([["content-type", "application/json"], ["api-key", t.key.value ?? ""]])
  addExtraHeaders(&h, t.cfg)
  return h
}

export function chatRequest(t: Target, body: Field[]): Upstream {
  if (t.kind === "azure") return { url: azureUrl(t, "chat/completions"), headers: azureHeaders(t), body: withModel(body, t.model) }
  return { url: urlFor(t, "chat_completion", endpoint(t) + "/chat/completions"), headers: authHeaders(t), body: build(storeOff(modelFields(body, t.model), t)) }
}

export function embeddingsRequest(t: Target, body: Field[]): Upstream {
  if (t.kind === "azure") return { url: azureUrl(t, "embeddings"), headers: azureHeaders(t), body: withModel(body, t.model) }
  return { url: urlFor(t, "embedding", endpoint(t) + "/embeddings"), headers: authHeaders(t), body: withModel(body, t.model) }
}

export function completionsRequest(t: Target, body: Field[]): Upstream {
  if (t.kind === "azure") return { url: azureUrl(t, "completions"), headers: azureHeaders(t), body: withModel(body, t.model) }
  return { url: urlFor(t, "text_completion", endpoint(t) + "/completions"), headers: authHeaders(t), body: withModel(body, t.model) }
}

export function responsesRequest(t: Target, body: Field[]): Upstream {
  return { url: urlFor(t, "responses", endpoint(t) + "/responses"), headers: authHeaders(t), body: build(storeOff(modelFields(body, t.model), t)) }
}

export function modelsRequest(t: Target): Upstream {
  return { url: urlFor(t, "list_models", endpoint(t) + "/models"), headers: authHeaders(t), body: "" }
}

// Reports the model as the caller asked for it ("openai/gpt-4o") and reads usage.
export function chatResponse(text: string, requestedModel: string): Translated throws SyntaxError {
  let fs = try fields(text)
  setField(&fs, "model", quote(requestedModel))
  const u = find(fs, "usage")
  let pt = 0
  let ct = 0
  let billed: f64 | undefined = undefined
  if (u !== undefined && u !== "null") {
    const usage = try JSON.parse(`{"usage":${u}}`) as UsageOnly
    pt = usage.usage?.prompt_tokens ?? 0
    ct = usage.usage?.completion_tokens ?? 0
    // OpenRouter reports the billed cost here; Bifrost takes it as the request's cost
    const c = usage.usage?.cost
    if (c !== undefined && c > 0) billed = c
  }
  return { body: build(fs), promptTokens: pt, completionTokens: ct, billed: billed }
}

// For a buffered SSE body: rewrites each chunk's model and sums the usage the
// last chunk reports (when stream_options.include_usage is set).
export function streamResponse(text: string, requestedModel: string): Translated {
  const out: string[] = []
  let pt = 0
  let ct = 0
  let billed: f64 | undefined = undefined
  for (const line of text.split("\n")) {
    if (!line.startsWith("data: ") || line === "data: [DONE]") {
      out.push(line)
      continue
    }
    const payload = line.slice(6)
    try {
      let fs = fields(payload)
      setField(&fs, "model", quote(requestedModel))
      const u = find(fs, "usage")
      if (u !== undefined && u !== "null") {
        const usage = JSON.parse(`{"usage":${u}}`) as UsageOnly
        pt = usage.usage?.prompt_tokens ?? pt
        ct = usage.usage?.completion_tokens ?? ct
        const c = usage.usage?.cost
        if (c !== undefined && c > 0) billed = c
      }
      out.push("data: " + build(fs))
    } catch (e) {
      out.push(line)
    }
  }
  return { body: out.join("\n"), promptTokens: pt, completionTokens: ct, billed: billed }
}

export function embeddingsResponse(text: string, requestedModel: string): Translated throws SyntaxError {
  return try chatResponse(text, requestedModel)
}

// Model ids from a /models response, prefixed with the provider name.
export function modelIds(text: string, provider: string): string[] throws SyntaxError {
  const fs = try fields(text)
  const data = find(fs, "data") ?? find(fs, "models")
  if (data === undefined) return []
  const out: string[] = []
  for (const el of try elements(data)) {
    const m = try fields(el)
    const id = find(m, "id") ?? find(m, "name")
    if (id !== undefined && id.startsWith("\"")) out.push(provider + "/" + (try JSON.parse(id) as string))
  }
  return out
}

test("rewrites model and strips gateway fields", () => {
  const t: Target = { provider: "groq", kind: "groq", model: "llama-3.3-70b", key: { value: "gk" }, cfg: {} }
  const up = chatRequest(t, try fields('{"model":"groq/llama-3.3-70b","messages":[],"fallbacks":["openai/gpt-4o"]}'))
  expect(up.url).toBe("https://api.groq.com/openai/v1/chat/completions")
  expect(up.body).toBe('{"model":"llama-3.3-70b","messages":[]}')
  expect(up.headers.get("authorization")).toBe("Bearer gk")
})

test("path overrides and disable_store", () => {
  const cp: Map<string, string> = new Map()
  cp.set("chat_completion", "/custom/chat")
  cp.set("embedding", "https://emb.example/v9/embed")
  const t: Target = { provider: "gw", kind: "openai", model: "m", key: { value: "k" }, cfg: { network_config: { base_url: "http://up:9000/" }, custom_provider_config: { base_provider_type: "openai", request_path_overrides: cp } } }
  expect(chatRequest(t, []).url).toBe("http://up:9000/custom/chat")
  expect(embeddingsRequest(t, []).url).toBe("https://emb.example/v9/embed")
  expect(completionsRequest(t, []).url).toBe("http://up:9000/v1/completions")
  const off: Target = { provider: "openai", kind: "openai", model: "gpt-4o", key: { value: "k" }, cfg: { openai_config: { disable_store: true } } }
  expect(chatRequest(off, try fields(`{"model":"x","store":true,"messages":[]}`)).body).toBe(`{"model":"gpt-4o","store":false,"messages":[]}`)
  expect(chatRequest({ provider: "openai", kind: "openai", model: "gpt-4o", key: { value: "k" }, cfg: {} }, try fields(`{"store":true}`)).body).toBe(`{"store":true,"model":"gpt-4o"}`)
})

test("base_url override and azure deployments", () => {
  const t: Target = { provider: "ollama", kind: "ollama", model: "llama3", key: { value: "" }, cfg: { network_config: { base_url: "http://gpu:11434/" } } }
  expect(chatRequest(t, []).url).toBe("http://gpu:11434/v1/chat/completions")
  expect(chatRequest(t, []).headers.has("authorization")).toBe(false)
  const deps: Map<string, string> = new Map()
  deps.set("gpt-4o", "prod-4o")
  const az: Target = { provider: "azure", kind: "azure", model: "gpt-4o", key: { value: "ak", azure_key_config: { endpoint: "https://x.openai.azure.com", deployments: deps, api_version: "2024-10-21" } }, cfg: {} }
  const up = chatRequest(az, [])
  expect(up.url).toBe("https://x.openai.azure.com/openai/deployments/prod-4o/chat/completions?api-version=2024-10-21")
  expect(up.headers.get("api-key")).toBe("ak")
  // with a service principal, the Entra token goes in authorization instead
  const en: Target = { provider: "azure", kind: "azure", model: "gpt-4o", key: { value: "tok", azure_key_config: { endpoint: "https://x.openai.azure.com", tenant_id: "t", client_id: "c", client_secret: "s" } }, cfg: {} }
  const eu = chatRequest(en, [])
  expect(eu.headers.get("authorization")).toBe("Bearer tok")
  expect(eu.headers.has("api-key")).toBe(false)
})

test("response usage and model", () => {
  const r = try chatResponse('{"id":"c1","model":"gpt-4o-2024","choices":[],"usage":{"prompt_tokens":5,"completion_tokens":7,"total_tokens":12}}', "openai/gpt-4o")
  expect(r.promptTokens).toBe(5)
  expect(r.completionTokens).toBe(7)
  expect(r.body.includes('"model":"openai/gpt-4o"')).toBe(true)
  expect(r.billed).toBeUndefined()
  const priced = try chatResponse('{"model":"m","choices":[],"usage":{"prompt_tokens":5,"completion_tokens":7,"total_tokens":12,"cost":0.00042}}', "openrouter/m")
  expect(priced.billed).toBe(0.00042)
  const s = streamResponse('data: {"model":"x","choices":[]}\n\ndata: {"model":"x","choices":[],"usage":{"prompt_tokens":1,"completion_tokens":2,"total_tokens":3}}\n\ndata: [DONE]\n\n', "openai/gpt-4o")
  expect(s.completionTokens).toBe(2)
  expect(s.body.includes('data: {"model":"openai/gpt-4o","choices":[]}')).toBe(true)
  expect(s.billed).toBeUndefined()
  const sc = streamResponse('data: {"model":"x","choices":[]}\n\ndata: {"model":"x","choices":[],"usage":{"prompt_tokens":1,"completion_tokens":2,"total_tokens":3,"cost":0.00077}}\n\ndata: [DONE]\n\n', "openrouter/m")
  expect(sc.billed).toBe(0.00077)
})
