// More providers that speak the OpenAI wire format, beyond the core table in
// openai.tov. Each entry is the default base URL and path prefix, as in openai.tov.
// The lead merges this table into that file's lookup; the entries here must not
// repeat its keys.

export type LongtailEndpoint = { base: string, prefix: string }

export function longtailTable(): Map<string, LongtailEndpoint> {
  const m: Map<string, LongtailEndpoint> = new Map()
  m.set("huggingface", { base: "https://router.huggingface.co", prefix: "/v1" })
  m.set("nvidia", { base: "https://integrate.api.nvidia.com", prefix: "/v1" })
  m.set("sambanova", { base: "https://api.sambanova.ai", prefix: "/v1" })
  m.set("deepinfra", { base: "https://api.deepinfra.com", prefix: "/v1/openai" })
  m.set("novita", { base: "https://api.novita.ai", prefix: "/v3/openai" })
  m.set("hyperbolic", { base: "https://api.hyperbolic.xyz", prefix: "/v1" })
  m.set("lambda", { base: "https://api.lambda.ai", prefix: "/v1" })
  m.set("moonshot", { base: "https://api.moonshot.ai", prefix: "/v1" })
  m.set("zhipu", { base: "https://open.bigmodel.cn", prefix: "/api/paas/v4" })
  m.set("dashscope", { base: "https://dashscope-intl.aliyuncs.com", prefix: "/compatible-mode/v1" })
  m.set("ai21", { base: "https://api.ai21.com", prefix: "/studio/v1" })
  m.set("upstage", { base: "https://api.upstage.ai", prefix: "/v1/solar" })
  m.set("baseten", { base: "https://inference.baseten.co", prefix: "/v1" })
  m.set("featherless", { base: "https://api.featherless.ai", prefix: "/v1" })
  m.set("inception", { base: "https://api.inceptionlabs.ai", prefix: "/v1" })
  m.set("friendli", { base: "https://api.friendli.ai", prefix: "/serverless/v1" })
  m.set("siliconflow", { base: "https://api.siliconflow.com", prefix: "/v1" })
  m.set("github", { base: "https://models.github.ai", prefix: "/inference" })
  return m
}

test("every longtail base is https and every prefix is a path", () => {
  const m = longtailTable()
  for (const k of m.keys()) {
    const e = m.get(k)!
    expect(e.base.startsWith("https://")).toBe(true)
    expect(e.base.endsWith("/")).toBe(false)
    expect(e.prefix.startsWith("/")).toBe(true)
    expect(e.prefix.endsWith("/")).toBe(false)
  }
})

test("longtail table covers the documented providers", () => {
  const m = longtailTable()
  expect(m.size).toBe(18)
  expect(m.get("zhipu")!.prefix).toBe("/api/paas/v4")
  expect(m.get("dashscope")!.base).toBe("https://dashscope-intl.aliyuncs.com")
  expect(m.get("github")!.prefix).toBe("/inference")
  expect(m.has("anyscale")).toBe(false)
})
