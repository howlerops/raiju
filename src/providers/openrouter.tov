// OpenRouter's native decisions. The body is TypeSafe's systemone body with the safety
// identifier as "user", posted to /alpha/decisions under the provider's root (not its /v1
// chat root). The answer is TypeSafe's shape, read by typesafe.tov's translateDecision.
import { fields, setField, build, quote } from "../json"
import { Target, Upstream, trimSlash } from "./types"
import { DecisionReq } from "../decisions"
import * as typesafe from "./typesafe"

// Bifrost's default root; the chat API sits under /v1 beneath it.
const DEFAULT_ROOT = "https://openrouter.ai/api"

// The provider's root without a trailing /v1, so both base forms reach /alpha/decisions.
export function rootOf(t: Target): string {
  const b = t.cfg.network_config?.base_url ?? ""
  let root = b === "" ? DEFAULT_ROOT : trimSlash(b)
  if (root.endsWith("/v1")) root = root.slice(0, root.byteLength - 3)
  return root
}

// The decision call. user is the request's safety_identifier, when it has one.
export function decisionUpstream(t: Target, d: DecisionReq, user: string | undefined): Upstream throws SyntaxError {
  let fs = try fields(try typesafe.systemoneBody(d, t.model))
  if (user !== undefined && user !== "") setField(&fs, "user", quote(user))
  return { url: rootOf(t) + "/alpha/decisions", headers: typesafe.authHeaders(t), body: build(fs) }
}

test("an OpenRouter decision posts to the native path with the safety identifier as user", () => {
  const t: Target = { provider: "openrouter", kind: "openrouter", model: "openai/gpt-4o-mini", key: { value: "or-key" }, cfg: {} }
  const d: DecisionReq = { model: "openrouter/openai/gpt-4o-mini", state: `"hello"`, questions: [] }
  const up = try decisionUpstream(t, d, "end-user-7")
  expect(up.url).toBe("https://openrouter.ai/api/alpha/decisions")
  expect(up.headers.get("authorization")).toBe("Bearer or-key")
  expect(up.body).toBe(`{"state":"hello","model":"openai/gpt-4o-mini","questions":{},"user":"end-user-7"}`)
  const v1: Target = { provider: "openrouter", kind: "openrouter", model: "m", key: { value: "k" }, cfg: { network_config: { base_url: "https://proxy.example.com/api/v1/" } } }
  expect(rootOf(v1)).toBe("https://proxy.example.com/api")
  const none = try decisionUpstream(t, d, undefined)
  expect(none.body.includes("user")).toBe(false)
})
