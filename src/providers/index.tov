// Routes each provider kind to its translator.
import { Field } from "../json"
import { ChatRequest } from "../schemas"
import { Target, Upstream, Translated } from "./types"
import * as openai from "./openai"
import * as anthropic from "./anthropic"
import * as gemini from "./gemini"
import * as bedrock from "./bedrock"
import * as vertex from "./vertex"
import * as cohere from "./cohere"

// OpenAI-format providers stream natively; the rest are called without
// streaming and their answer is replayed as SSE chunks.
export function streamsNatively(kind: string): bool {
  return kind === "azure" || openai.isOpenAICompatible(kind)
}

export function supportsChat(kind: string): bool {
  return streamsNatively(kind) || kind === "anthropic" || kind === "gemini" || kind === "bedrock" || kind === "vertex" || kind === "cohere"
}

export function supportsEmbeddings(kind: string): bool {
  return streamsNatively(kind) || kind === "cohere"
}

export function embeddingsUpstream(t: Target, body: Field[]): Upstream throws SyntaxError {
  if (t.kind === "cohere") return try cohere.embeddingsRequest(t, body)
  return openai.embeddingsRequest(t, body)
}

export function embeddingsTranslate(kind: string, text: string, requestedModel: string): Translated throws SyntaxError {
  if (kind === "cohere") return try cohere.embeddingsResponse(text, requestedModel)
  return try openai.embeddingsResponse(text, requestedModel)
}

export function chatUpstream(t: Target, req: ChatRequest, body: Field[], autoCache: bool): Upstream throws SyntaxError {
  if (t.kind === "anthropic") return try anthropic.chatRequest(t, req, body, autoCache)
  if (t.kind === "gemini") return try gemini.chatRequest(t, req, body)
  if (t.kind === "bedrock") return try bedrock.chatRequest(t, req, body, autoCache)
  // the gateway puts the cached OAuth access token in key.value before building
  if (t.kind === "cohere") return try cohere.chatRequest(t, req, body)
  if (t.kind === "vertex") return try vertex.chatRequest(t, req, body, t.key.value ?? "")
  return openai.chatRequest(t, body)
}

// Streaming requests for providers whose streams the gateway converts as they arrive.
export function streamUpstream(t: Target, req: ChatRequest, body: Field[], autoCache: bool): Upstream | undefined throws SyntaxError {
  if (t.kind === "anthropic") return try anthropic.streamRequest(t, req, body, autoCache)
  if (t.kind === "gemini") return try gemini.streamRequest(t, req, body)
  if (t.kind === "bedrock") return try bedrock.streamRequest(t, req, body, autoCache)
  return undefined
}

export function chatTranslate(kind: string, model: string, text: string, requestedModel: string, streamed: bool): Translated throws SyntaxError {
  if (kind === "anthropic") return try anthropic.chatResponse(text, requestedModel)
  if (kind === "gemini") return try gemini.chatResponse(text, requestedModel)
  if (kind === "bedrock") return try bedrock.chatResponse(text, requestedModel)
  if (kind === "cohere") return try cohere.chatResponse(text, requestedModel)
  if (kind === "vertex") return try vertex.chatResponse(model, text, requestedModel)
  if (streamed) return openai.streamResponse(text, requestedModel)
  return try openai.chatResponse(text, requestedModel)
}
