// Anthropic Messages API: translates OpenAI chat requests and responses.
import { Field, fields, elements, find, quote, rawStr, rawNum, isNull, build, decodeString } from "../json"
import { Target, Upstream, Translated, headers, addExtraHeaders, trimSlash } from "./types"
import { ChatRequest, Message, ContentPart, newId, nowSeconds } from "../schemas"
import { ProviderPromptCacheConfig } from "../config"
import { fromChat, anthropicThinking, anthropicReasoning } from "../reasoning"

const DEFAULT_MAX_TOKENS = 4096

function imageBlock(url: string): string {
  if (url.startsWith("data:")) {
    // data:<media type>;base64,<data>
    const semi = url.indexOf(";")
    const comma = url.indexOf(",")
    const media = url.slice(5, semi > 0 ? semi : comma)
    const data = url.slice(comma + 1)
    return `{"type":"image","source":{"type":"base64","media_type":${quote(media)},"data":${quote(data)}}}`
  }
  return `{"type":"image","source":{"type":"url","url":${quote(url)}}}`
}

function contentBlocks(c: string | ContentPart[] | undefined): string[] {
  if (c === undefined) return []
  if (typeof c === "string") {
    if (c === "") return []
    return [`{"type":"text","text":${quote(c)}}`]
  }
  const out: string[] = []
  for (const p of c) {
    if (p.type === "text" && p.text !== undefined) out.push(`{"type":"text","text":${quote(p.text)}}`)
    else if (p.type === "image_url" && p.image_url !== undefined) out.push(imageBlock(p.image_url.url))
  }
  return out
}

// A tool call's arguments are a JSON string; Anthropic wants the object itself.
export function argumentsObject(args: string): string {
  try {
    const fs = fields(args)
    return build(fs)
  } catch (e) {
    return "{}"
  }
}

type Turn = { role: string, blocks: string[] }

function pushTurn(inout turns: Turn[], role: string, blocks: string[]): void {
  if (blocks.length === 0) return
  const last = turns.length - 1
  if (last >= 0 && turns[last]!.role === role) {
    // Anthropic wants alternating roles: merge consecutive turns of one role.
    const merged = turns[last]!.blocks.concat(blocks)
    turns[last] = { role: role, blocks: merged }
    return
  }
  turns.push({ role: role, blocks: blocks })
}

function systemText(messages: Message[]): string {
  const parts: string[] = []
  for (const m of messages) {
    if (m.role === "system" || m.role === "developer") {
      const c = m.content
      if (typeof c === "string") parts.push(c)
      else if (c !== undefined) {
        for (const p of c) if (p.text !== undefined) parts.push(p.text)
      }
    }
  }
  return parts.join("\n\n")
}

function toolsJson(raw: string): string throws SyntaxError {
  const out: string[] = []
  for (const el of try elements(raw)) {
    const t = try fields(el)
    const fnRaw = find(t, "function")
    if (fnRaw === undefined) continue
    const fn = try fields(fnRaw)
    const name = rawStr(fn, "name") ?? ""
    const desc = find(fn, "description")
    const params = find(fn, "parameters")
    const parts = [`"name":${quote(name)}`]
    if (desc !== undefined && !isNull(desc)) parts.push(`"description":${desc}`)
    parts.push(`"input_schema":${isNull(params) ? `{"type":"object","properties":{}}` : params!}`)
    out.push("{" + parts.join(",") + "}")
  }
  return "[" + out.join(",") + "]"
}

function toolChoiceJson(raw: string): string | undefined throws SyntaxError {
  if (raw === `"auto"`) return `{"type":"auto"}`
  if (raw === `"required"`) return `{"type":"any"}`
  if (raw === `"none"`) return `{"type":"none"}`
  if (raw.startsWith("{")) {
    const fs = try fields(raw)
    const fnRaw = find(fs, "function")
    if (fnRaw !== undefined) {
      const name = rawStr(try fields(fnRaw), "name") ?? ""
      return `{"type":"tool","name":${quote(name)}}`
    }
  }
  return undefined
}

// The cache_control value of a breakpoint: Anthropic's default lifetime (5 minutes), or 1 hour
// when the provider's prompt_cache.ttl says "1h".
export function cacheMarker(ttl: string | undefined): string {
  return ttl === "1h" ? `{"type":"ephemeral","ttl":"1h"}` : `{"type":"ephemeral"}`
}

// Adds cache_control to a raw content block.
function cached(block: string, marker: string): string {
  return block.slice(0, block.byteLength - 1) + `,"cache_control":${marker}}`
}

// The message positions a prompt_cache.cache_control_injection_points entry names (Bifrost):
// a "message" point matches by role, by index (negative counts from the end), or both.
// Nothing is injected into a request that already carries cache_control of its own.
export function injectedIndexes(messages: Message[], points: { location?: string, role?: string, index?: int }[], on: bool): Set<int> {
  const out: Set<int> = new Set()
  if (!on) return out
  const n = messages.length
  for (const pt of points) {
    if (pt.location !== undefined && pt.location !== "message") continue
    const hasRole = pt.role !== undefined && pt.role !== ""
    const hasIdx = pt.index !== undefined
    if (!hasRole && !hasIdx) continue
    const want = pt.index === undefined ? -1 : (pt.index < 0 ? n + pt.index : pt.index)
    for (let i = 0; i < n; i++) {
      if (hasRole && messages[i]!.role !== pt.role) continue
      if (hasIdx && i !== want) continue
      out.add(i)
    }
  }
  return out
}

// autoCache marks the system prompt and the newest turn as cache breakpoints,
// so repeated prefixes (agents, long chats) are billed at cache-read rates. cache (the
// provider's prompt_cache) sets the lifetime and adds the injection points.
export function messagesBody(req: ChatRequest, body: Field[], model: string, stream: bool, autoCache: bool, cache?: ProviderPromptCacheConfig): string throws SyntaxError {
  const marker = cacheMarker(cache?.ttl)
  const selfCached = (find(body, "messages") ?? "").includes("cache_control")
  const marked = injectedIndexes(req.messages, cache?.cache_control_injection_points ?? [], !selfCached)
  let sysMarked = false
  let turns: Turn[] = []
  let idx = -1
  for (const m of req.messages) {
    idx += 1
    if (m.role === "system" || m.role === "developer") {
      if (marked.has(idx)) sysMarked = true
      continue
    }
    if (m.role === "tool") {
      const text = m.content === undefined ? "" : (typeof m.content === "string" ? m.content : m.content.map((p) => p.text ?? "").join(""))
      let tr = `{"type":"tool_result","tool_use_id":${quote(m.tool_call_id ?? "")},"content":${quote(text)}}`
      if (marked.has(idx)) tr = cached(tr, marker)
      pushTurn(&turns, "user", [tr])
      continue
    }
    const role = m.role === "assistant" ? "assistant" : "user"
    const blocks = contentBlocks(m.content)
    const calls = m.tool_calls
    if (calls !== undefined) {
      for (const c of calls) {
        blocks.push(`{"type":"tool_use","id":${quote(c.id)},"name":${quote(c.function.name)},"input":${argumentsObject(c.function.arguments)}}`)
      }
    }
    if (marked.has(idx) && blocks.length > 0) blocks[blocks.length - 1] = cached(blocks[blocks.length - 1]!, marker)
    pushTurn(&turns, role, blocks)
  }
  if (autoCache && turns.length > 0) {
    const last = turns[turns.length - 1]!
    const blocks = last.blocks.slice()
    blocks[blocks.length - 1] = cached(blocks[blocks.length - 1]!, marker)
    turns[turns.length - 1] = { role: last.role, blocks: blocks }
  }
  const parts: string[] = [`"model":${quote(model)}`]
  const sys = systemText(req.messages)
  if (sys !== "") {
    if (autoCache || sysMarked) parts.push(`"system":[${cached(`{"type":"text","text":${quote(sys)}}`, marker)}]`)
    else parts.push(`"system":${quote(sys)}`)
  }
  parts.push(`"messages":[${turns.map((t) => `{"role":"${t.role}","content":[${t.blocks.join(",")}]}`).join(",")}]`)
  for (const p of try messagesTail(req, body, stream)) parts.push(p)
  return "{" + parts.join(",") + "}"
}

// The request fields that come after the messages (max_tokens, thinking, sampling, stop sequences, tools,
// tool_choice, metadata, stream). They do not depend on the messages, so a streaming conversion
// (streamconv.tov) writes them when the body ends.
export function messagesTail(req: ChatRequest, body: Field[], stream: bool): string[] throws SyntaxError {
  const parts: string[] = []
  // reasoning_effort / reasoning.max_tokens become an extended-thinking budget, as Bifrost
  const plan = anthropicThinking(fromChat(body), req.max_completion_tokens ?? req.max_tokens)
  if (plan.error !== undefined) throw new SyntaxError(plan.error)
  const thinking = plan.thinking !== undefined
  parts.push(`"max_tokens":${plan.maxTokens}`)
  if (plan.thinking !== undefined) parts.push(`"thinking":${plan.thinking}`)
  // Anthropic takes only default sampling with thinking on
  if (req.temperature !== undefined && !thinking) parts.push(`"temperature":${req.temperature}`)
  if (req.top_p !== undefined && !thinking) parts.push(`"top_p":${req.top_p}`)
  const stop = req.stop
  if (stop !== undefined) parts.push(`"stop_sequences":${typeof stop === "string" ? `[${quote(stop)}]` : JSON.stringify(stop)}`)
  const tools = find(body, "tools")
  if (tools !== undefined && !isNull(tools)) parts.push(`"tools":${try toolsJson(tools)}`)
  const choice = find(body, "tool_choice")
  if (choice !== undefined) {
    const c = try toolChoiceJson(choice)
    // with thinking on, Anthropic accepts only auto or none
    if (c !== undefined) parts.push(`"tool_choice":${thinking && c !== `{"type":"none"}` ? `{"type":"auto"}` : c}`)
  }
  const user = req.user
  if (user !== undefined) parts.push(`"metadata":{"user_id":${quote(user)}}`)
  if (stream) parts.push(`"stream":true`)
  return parts
}

function apiBase(t: Target): string {
  const b = t.cfg.network_config?.base_url
  if (b === undefined || b === "") return "https://api.anthropic.com"
  return trimSlash(b)
}

export function upstreamHeaders(t: Target): Map<string, string> {
  let h = headers([["content-type", "application/json"], ["anthropic-version", "2023-06-01"]])
  const v = t.key.value ?? ""
  if (v !== "") h.set("x-api-key", v)
  addExtraHeaders(&h, t.cfg)
  return h
}

export function chatRequest(t: Target, req: ChatRequest, body: Field[], autoCache: bool): Upstream throws SyntaxError {
  return { url: apiBase(t) + "/v1/messages", headers: upstreamHeaders(t), body: try messagesBody(req, body, t.model, false, autoCache, t.cfg.prompt_cache) }
}

export function streamRequest(t: Target, req: ChatRequest, body: Field[], autoCache: bool): Upstream throws SyntaxError {
  return { url: apiBase(t) + "/v1/messages", headers: upstreamHeaders(t), body: try messagesBody(req, body, t.model, true, autoCache, t.cfg.prompt_cache) }
}

// The request of a chat body that is converted while it streams in (streamconv.tov): the URL and headers,
// and no body.
export function largeRequest(t: Target): Upstream {
  return { url: apiBase(t) + "/v1/messages", headers: upstreamHeaders(t), body: "" }
}

// ---- prompt cache breakpoints on a Messages body as the caller sent it (the /anthropic/v1/messages route) ----

const MAX_INJECTED = 4

// Whether a marker on a content block means anything upstream: text, images and documents carry prompt content.
function cacheableBlock(raw: string): bool throws SyntaxError {
  const t = rawStr(try fields(raw), "type") ?? ""
  return t === "text" || t === "image" || t === "document"
}

// A content value (a string, or an array of blocks) with one block marked: the last cacheable block (an injection
// point names a message cached to its end) or the first (auto_inject marks the start of the stable prefix). A string
// becomes one text block. undefined when nothing in it can be marked.
function markContent(raw: string, marker: string, last: bool): string | undefined throws SyntaxError {
  if (raw.startsWith("\"")) {
    if (raw === `""`) return undefined
    return `[${cached(`{"type":"text","text":${raw}}`, marker)}]`
  }
  if (!raw.startsWith("[")) return undefined
  let blocks = try elements(raw)
  let at = -1
  for (let i = 0; i < blocks.length; i++) {
    if (!(try cacheableBlock(blocks[i]!))) continue
    at = i
    if (!last) break
  }
  if (at < 0) return undefined
  blocks[at] = cached(blocks[at]!, marker)
  return "[" + blocks.join(",") + "]"
}

// The provider's prompt cache on a Messages body sent as it came, as Bifrost injects on every route: the injection
// points (a message by role and/or index, the system prompt counted as the first message with role "system"; at most
// four) replace auto_inject, which marks the first cacheable block. A body that carries cache_control of its own is
// left alone.
export function injectMessagesCache(body: Field[], autoCache: bool, cache?: ProviderPromptCacheConfig): Field[] throws SyntaxError {
  const points = cache?.cache_control_injection_points ?? []
  if (points.length === 0 && !autoCache) return body
  const sys = find(body, "system")
  const msgsRaw = find(body, "messages") ?? "[]"
  if ((sys ?? "").includes("cache_control") || msgsRaw.includes("cache_control")) return body
  const hasSys = sys !== undefined && !isNull(sys)
  const msgs: string[] = msgsRaw.startsWith("[") ? try elements(msgsRaw) : []
  const roles: string[] = hasSys ? ["system"] : []
  const contents: string[] = hasSys ? [sys!] : []
  for (const m of msgs) {
    const mf = try fields(m)
    roles.push(rawStr(mf, "role") ?? "")
    contents.push(find(mf, "content") ?? "null")
  }
  const n = roles.length
  const marker = cacheMarker(cache?.ttl)
  const marked: Map<int, string> = new Map()
  if (points.length > 0) {
    for (const pt of points) {
      if (pt.location !== undefined && pt.location !== "" && pt.location !== "message") continue
      const hasRole = pt.role !== undefined && pt.role !== ""
      const idxs: int[] = []
      if (pt.index !== undefined) {
        const i = pt.index < 0 ? n + pt.index : pt.index
        if (i >= 0 && i < n && (!hasRole || roles[i] === pt.role)) idxs.push(i)
      } else if (hasRole) {
        for (let i = 0; i < n; i++) {
          if (roles[i] === pt.role) idxs.push(i)
        }
      }
      for (const i of idxs) {
        if (marked.has(i) || marked.size >= MAX_INJECTED) continue
        const c = try markContent(contents[i]!, marker, true)
        if (c !== undefined) marked.set(i, c)
      }
    }
  } else {
    for (let i = 0; i < n; i++) {
      const c = try markContent(contents[i]!, marker, false)
      if (c === undefined) continue
      marked.set(i, c)
      break
    }
  }
  if (marked.size === 0) return body
  const off = hasSys ? 1 : 0
  const out: string[] = []
  for (let j = 0; j < msgs.length; j++) {
    const c = marked.get(j + off)
    if (c === undefined) {
      out.push(msgs[j]!)
      continue
    }
    out.push(build((try fields(msgs[j]!)).map((f) => f.key === "content" ? { key: "content", raw: c } : f)))
  }
  const sysMarked = hasSys ? marked.get(0) : undefined
  return body.map((f) => {
    if (f.key === "messages") return { key: "messages", raw: "[" + out.join(",") + "]" }
    if (f.key === "system" && sysMarked !== undefined) return { key: "system", raw: sysMarked }
    return f
  })
}

// Native passthrough for /anthropic/v1/messages: only the model changes.
export function nativeRequest(t: Target, body: Field[]): Upstream {
  const fs = body.map((f) => f.key === "model" ? { key: "model", raw: quote(t.model) } : f)
  return { url: apiBase(t) + "/v1/messages", headers: upstreamHeaders(t), body: build(fs) }
}

export function finishReason(stop: string | undefined): string {
  if (stop === "max_tokens") return "length"
  if (stop === "tool_use") return "tool_calls"
  return "stop"
}

type AnthropicUsage = { input_tokens?: int, output_tokens?: int, cache_read_input_tokens?: int, cache_creation_input_tokens?: int }

// The text, tool calls and finish reason of a Messages response, as OpenAI parts.
// served is the model a server-side fallback answered with (usage.iterations, type "fallback_message"), or "".
export type Assistant = { text: string, toolCalls: string[], finish: string, promptTokens: int, completionTokens: int, id: string, reasoning: string, served: string }

// The model of the last fallback_message iteration in a Messages usage object, or "".
function servedFallback(usageRaw: string): string throws SyntaxError {
  const fs = try fields(usageRaw)
  const its = find(fs, "iterations")
  if (its === undefined || isNull(its)) return ""
  let served = ""
  for (const el of try elements(its)) {
    const it = try fields(el)
    if (rawStr(it, "type") !== "fallback_message") continue
    const m = rawStr(it, "model") ?? ""
    if (m !== "") served = m
  }
  return served
}

export function readAssistant(text: string): Assistant throws SyntaxError {
  const fs = try fields(text)
  const textParts: string[] = []
  const calls: string[] = []
  const content = find(fs, "content")
  if (content !== undefined && !isNull(content)) {
    for (const el of try elements(content)) {
      const b = try fields(el)
      const type = rawStr(b, "type")
      if (type === "text") textParts.push(rawStr(b, "text") ?? "")
      else if (type === "tool_use") {
        const input = find(b, "input") ?? "{}"
        calls.push(`{"id":${quote(rawStr(b, "id") ?? "")},"type":"function","function":{"name":${quote(rawStr(b, "name") ?? "")},"arguments":${quote(input)}}}`)
      }
    }
  }
  const usageRaw = find(fs, "usage")
  let pt = 0
  let ct = 0
  let served = ""
  if (usageRaw !== undefined && !isNull(usageRaw)) {
    const u = try JSON.parse(usageRaw) as AnthropicUsage
    pt = (u.input_tokens ?? 0) + (u.cache_read_input_tokens ?? 0) + (u.cache_creation_input_tokens ?? 0)
    ct = u.output_tokens ?? 0
    served = try servedFallback(usageRaw)
  }
  const reasoning = content === undefined || isNull(content) ? "" : anthropicReasoning(content)
  return { text: textParts.join(""), toolCalls: calls, finish: finishReason(rawStr(fs, "stop_reason")), promptTokens: pt, completionTokens: ct, id: rawStr(fs, "id") ?? newId("chatcmpl-"), reasoning: reasoning, served: served }
}

export function completionJson(a: Assistant, model: string): string {
  const msg: string[] = [`"role":"assistant"`, `"content":${a.text === "" && a.toolCalls.length > 0 ? "null" : quote(a.text)}`]
  if (a.toolCalls.length > 0) msg.push(`"tool_calls":[${a.toolCalls.join(",")}]`)
  // both spellings, as Bifrost
  if (a.reasoning !== "") msg.push(`"reasoning":${quote(a.reasoning)},"reasoning_content":${quote(a.reasoning)}`)
  return `{"id":${quote(a.id)},"object":"chat.completion","created":${nowSeconds()},"model":${quote(model)},` +
    `"choices":[{"index":0,"message":{${msg.join(",")}},"finish_reason":"${a.finish}"}],` +
    `"usage":{"prompt_tokens":${a.promptTokens},"completion_tokens":${a.completionTokens},"total_tokens":${a.promptTokens + a.completionTokens}}}`
}

export function chatResponse(text: string, requestedModel: string): Translated throws SyntaxError {
  const a = try readAssistant(text)
  return { body: completionJson(a, requestedModel), promptTokens: a.promptTokens, completionTokens: a.completionTokens, served: a.served }
}

// ---- legacy text completions (POST /v1/complete) ----

const HUMAN_TURN = "\n\nHuman:"
const ASSISTANT_TURN = "\n\nAssistant:"

// The prompt of a text completion: a string, or an array of strings joined by blank lines, as Bifrost reads it.
export function textPrompt(body: Field[]): string throws SyntaxError {
  const raw = find(body, "prompt")
  if (raw === undefined || raw === "null") return ""
  if (raw.startsWith("\"")) return try decodeString(raw)
  if (!raw.startsWith("[")) throw new SyntaxError("prompt must be a string or an array of strings")
  const parts: string[] = []
  for (const el of try elements(raw)) {
    if (!el.startsWith("\"")) throw new SyntaxError("prompt must be a string or an array of strings")
    parts.push(try decodeString(el))
  }
  return parts.join("\n\n")
}

// The prompt in the "\n\nHuman: ...\n\nAssistant:" frame the legacy API requires. A prompt that already opens with
// a Human turn is kept, gaining the closing Assistant turn if it lacks one; any other prompt is wrapped.
export function framePrompt(prompt: string): string {
  if (!prompt.startsWith(HUMAN_TURN)) return HUMAN_TURN + " " + prompt + ASSISTANT_TURN
  let end = prompt.byteLength
  while (end > 0 && prompt.slice(end - 1, end) === " ") end--
  if (prompt.slice(0, end).endsWith(ASSISTANT_TURN)) return prompt
  return prompt + ASSISTANT_TURN
}

// A text completion's stop as a list of sequences: a string becomes a one-item list. undefined when absent.
export function stopList(body: Field[]): string | undefined {
  const raw = find(body, "stop")
  if (raw === undefined || raw === "null") return undefined
  if (raw.startsWith("\"")) return "[" + raw + "]"
  if (raw.startsWith("[")) return raw
  return undefined
}

// A sampling field of the body as sent, or undefined when absent or null.
export function sampling(body: Field[], key: string): string | undefined {
  const v = find(body, key)
  if (v === undefined || v === "null") return undefined
  return v
}

// The legacy body for an OpenAI text completion: the framed prompt, max_tokens as max_tokens_to_sample (4096 when
// unset), temperature, top_p, top_k and stop as stop_sequences.
export function textBody(model: string, body: Field[]): string throws SyntaxError {
  const parts: string[] = [`"model":${quote(model)}`, `"prompt":${quote(framePrompt(try textPrompt(body)))}`, `"max_tokens_to_sample":${sampling(body, "max_tokens") ?? `${DEFAULT_MAX_TOKENS}`}`]
  for (const k of ["temperature", "top_p", "top_k"]) {
    const v = sampling(body, k)
    if (v !== undefined) parts.push(`${quote(k)}:${v}`)
  }
  const stop = stopList(body)
  if (stop !== undefined) parts.push(`"stop_sequences":${stop}`)
  return "{" + parts.join(",") + "}"
}

// Anthropic's legacy text completion call, for a POST /v1/completions request.
export function textRequest(t: Target, body: Field[]): Upstream throws SyntaxError {
  return { url: apiBase(t) + "/v1/complete", headers: upstreamHeaders(t), body: try textBody(t.model, body) }
}

// A legacy stop reason as an OpenAI finish reason; null when there is none.
export function textFinish(stop: string | undefined): string {
  if (stop === undefined || stop === "") return "null"
  if (stop === "max_tokens") return quote("length")
  return quote("stop")
}

// One text completion answer in OpenAI's shape.
export function textCompletionJson(id: string, model: string, choices: string[], pt: int, ct: int): string {
  return `{"id":${quote(id)},"object":"text_completion","created":${nowSeconds()},"model":${quote(model)},"choices":[${choices.join(",")}],` +
    `"usage":{"prompt_tokens":${pt},"completion_tokens":${ct},"total_tokens":${pt + ct}}}`
}

// A legacy completion as an OpenAI text completion, with the model as the caller asked for it.
export function textResponse(text: string, requestedModel: string): Translated throws SyntaxError {
  const fs = try fields(text)
  let pt = 0
  let ct = 0
  const u = find(fs, "usage")
  if (u !== undefined && u.startsWith("{")) {
    const uf = try fields(u)
    pt = Math.floor(rawNum(uf, "input_tokens") ?? 0)
    ct = Math.floor(rawNum(uf, "output_tokens") ?? 0)
  }
  const choice = `{"index":0,"text":${quote(rawStr(fs, "completion") ?? "")},"logprobs":null,"finish_reason":${textFinish(rawStr(fs, "stop_reason"))}}`
  return { body: textCompletionJson(rawStr(fs, "id") ?? newId("cmpl-"), requestedModel, [choice], pt, ct), promptTokens: pt, completionTokens: ct }
}

test("a text completion becomes a legacy complete call, and its answer an OpenAI text completion", () => {
  const t: Target = { provider: "anthropic", kind: "anthropic", model: "claude-2.1", key: { value: "sk-ant-test" }, cfg: {} }
  const up = try textRequest(t, try fields(`{"model":"anthropic/claude-2.1","prompt":["Say hi","twice"],"temperature":0.2,"top_k":5,"stop":"END"}`))
  expect(up.url).toBe("https://api.anthropic.com/v1/complete")
  expect(up.headers.get("x-api-key")).toBe("sk-ant-test")
  expect(up.body).toBe(`{"model":"claude-2.1","prompt":"\\n\\nHuman: Say hi\\n\\ntwice\\n\\nAssistant:","max_tokens_to_sample":4096,"temperature":0.2,"top_k":5,"stop_sequences":["END"]}`)
  const kept = try textBody("m", try fields(`{"prompt":"\\n\\nHuman: hi\\n\\nAssistant: ","max_tokens":12}`))
  expect(kept.includes(`"prompt":"\\n\\nHuman: hi\\n\\nAssistant: "`)).toBe(true)
  expect(kept.includes(`"max_tokens_to_sample":12`)).toBe(true)
  expect(framePrompt("\n\nHuman: hi")).toBe("\n\nHuman: hi\n\nAssistant:")
  const r = try textResponse(`{"id":"compl_1","type":"completion","completion":" Hello!","stop_reason":"max_tokens","model":"claude-2.1","usage":{"input_tokens":7,"output_tokens":3}}`, "anthropic/claude-2.1")
  expect(r.promptTokens).toBe(7)
  expect(r.body.includes(`"id":"compl_1","object":"text_completion"`)).toBe(true)
  expect(r.body.includes(`"model":"anthropic/claude-2.1","choices":[{"index":0,"text":" Hello!","logprobs":null,"finish_reason":"length"}],"usage":{"prompt_tokens":7,"completion_tokens":3,"total_tokens":10}`)).toBe(true)
  let bad = ""
  try {
    try textPrompt(try fields(`{"prompt":[1,2]}`))
  } catch (e) {
    bad = e.message
  }
  expect(bad.includes("array of strings")).toBe(true)
})

test("reasoning_effort becomes an extended-thinking budget", () => {
  const raw = `{"model":"m","messages":[{"role":"user","content":"hi"}],"reasoning_effort":"high","max_tokens":4096,"temperature":0.5,"tool_choice":"required","tools":[{"type":"function","function":{"name":"f","parameters":{}}}]}`
  const out = try messagesBody(try JSON.parse(raw) as ChatRequest, try fields(raw), "m", false, false)
  expect(out.includes(`"thinking":{"type":"enabled","budget_tokens":`)).toBe(true)
  expect(out.includes(`"max_tokens":4096`)).toBe(true)
  expect(out.includes(`"temperature"`)).toBe(false)
  expect(out.includes(`"tool_choice":{"type":"auto"}`)).toBe(true)
  const a = try readAssistant(`{"id":"x","content":[{"type":"thinking","thinking":"hmm","signature":"s"},{"type":"text","text":"ok"}],"stop_reason":"end_turn"}`)
  expect(a.reasoning).toBe("hmm")
  expect(completionJson(a, "m").includes(`"reasoning":"hmm","reasoning_content":"hmm"`)).toBe(true)
})

test("translates an OpenAI chat request", () => {
  const raw = `{"model":"anthropic/claude-sonnet-4","messages":[
    {"role":"system","content":"be brief"},
    {"role":"user","content":[{"type":"text","text":"what is in this"},{"type":"image_url","image_url":{"url":"data:image/png;base64,AAAA"}}]},
    {"role":"assistant","content":null,"tool_calls":[{"id":"t1","type":"function","function":{"name":"look","arguments":"{\\"q\\":1}"}}]},
    {"role":"tool","tool_call_id":"t1","content":"a cat"},
    {"role":"user","content":"thanks"}],
    "tools":[{"type":"function","function":{"name":"look","description":"look","parameters":{"type":"object","properties":{"q":{"type":"integer"}}}}}],
    "tool_choice":"required","temperature":0.2,"stop":"END"}`
  const body = try fields(raw)
  const req = try JSON.parse(raw) as ChatRequest
  const out = try messagesBody(req, body, "claude-sonnet-4", false, false)
  expect(out.includes(`"system":"be brief"`)).toBe(true)
  expect(out.includes(`{"type":"image","source":{"type":"base64","media_type":"image/png","data":"AAAA"}}`)).toBe(true)
  expect(out.includes(`{"type":"tool_use","id":"t1","name":"look","input":{"q":1}}`)).toBe(true)
  // the tool result and the next user message merge into one user turn
  expect(out.includes(`{"role":"user","content":[{"type":"tool_result","tool_use_id":"t1","content":"a cat"},{"type":"text","text":"thanks"}]}`)).toBe(true)
  expect(out.includes(`"input_schema":{"type":"object","properties":{"q":{"type":"integer"}}}`)).toBe(true)
  expect(out.includes(`"tool_choice":{"type":"any"}`)).toBe(true)
  expect(out.includes(`"max_tokens":4096`)).toBe(true)
  expect(out.includes(`"stop_sequences":["END"]`)).toBe(true)
})

test("prompt cache injection points mark messages, with the 1h lifetime", () => {
  const raw = `{"model":"m","messages":[{"role":"system","content":"rules"},{"role":"user","content":"a"},{"role":"assistant","content":"b"},{"role":"user","content":"c"}]}`
  const cache: ProviderPromptCacheConfig = { ttl: "1h", cache_control_injection_points: [{ location: "message", role: "assistant" }, { location: "message", index: -1 }] }
  const out = try messagesBody(try JSON.parse(raw) as ChatRequest, try fields(raw), "m", false, false, cache)
  expect(out.includes(`{"type":"text","text":"b","cache_control":{"type":"ephemeral","ttl":"1h"}}`)).toBe(true)
  expect(out.includes(`{"type":"text","text":"c","cache_control":{"type":"ephemeral","ttl":"1h"}}`)).toBe(true)
  expect(out.includes(`"text":"a","cache_control"`)).toBe(false)
  expect(out.includes(`"system":"rules"`)).toBe(true)
  const sys = try messagesBody(try JSON.parse(raw) as ChatRequest, try fields(raw), "m", false, false, { cache_control_injection_points: [{ role: "system" }] })
  expect(sys.includes(`"system":[{"type":"text","text":"rules","cache_control":{"type":"ephemeral"}}]`)).toBe(true)
  // a request that carries its own cache_control gets no injected marker (its own blocks are not carried over here)
  const own = `{"model":"m","messages":[{"role":"user","content":[{"type":"text","text":"x","cache_control":{"type":"ephemeral"}}]}]}`
  const kept = try messagesBody(try JSON.parse(own) as ChatRequest, try fields(own), "m", false, false, { cache_control_injection_points: [{ role: "user" }] })
  expect(kept.includes(`"content":[{"type":"text","text":"x"}]}]`)).toBe(true)
})

test("auto prompt caching marks system and the newest turn", () => {
  const raw = `{"model":"m","messages":[{"role":"system","content":"long rules"},{"role":"user","content":"a"},{"role":"assistant","content":"b"},{"role":"user","content":"c"}]}`
  const out = try messagesBody(try JSON.parse(raw) as ChatRequest, try fields(raw), "m", false, true)
  expect(out.includes(`"system":[{"type":"text","text":"long rules","cache_control":{"type":"ephemeral"}}]`)).toBe(true)
  expect(out.includes(`{"role":"user","content":[{"type":"text","text":"c","cache_control":{"type":"ephemeral"}}]}`)).toBe(true)
  expect(out.includes(`{"type":"text","text":"a"}`)).toBe(true)
})

test("a Messages body as sent gets the provider's injection points, or auto_inject's first block", () => {
  const body = try fields(`{"model":"m","system":"rules","messages":[{"role":"user","content":"one"},{"role":"assistant","content":[{"type":"text","text":"a"},{"type":"text","text":"b"}]},{"role":"user","content":"three"}],"max_tokens":5}`)
  const pts = try injectMessagesCache(body, false, { cache_control_injection_points: [{ location: "message", role: "system" }, { index: -1 }, { role: "assistant" }] })
  const out = build(pts)
  expect(out).toBe(`{"model":"m","system":[{"type":"text","text":"rules","cache_control":{"type":"ephemeral"}}],"messages":[{"role":"user","content":"one"},{"role":"assistant","content":[{"type":"text","text":"a"},{"type":"text","text":"b","cache_control":{"type":"ephemeral"}}]},{"role":"user","content":[{"type":"text","text":"three","cache_control":{"type":"ephemeral"}}]}],"max_tokens":5}`)
  // auto_inject: the first cacheable block (the system prompt here), with the provider's ttl
  const auto = build(try injectMessagesCache(body, true, { ttl: "1h" }))
  expect(auto.includes(`"system":[{"type":"text","text":"rules","cache_control":{"type":"ephemeral","ttl":"1h"}}]`)).toBe(true)
  expect(auto.includes(`{"role":"user","content":"one"}`)).toBe(true)
  // nothing configured, or a caller that marked its own blocks: unchanged
  expect(build(try injectMessagesCache(body, false, {}))).toBe(build(body))
  const own = try fields(`{"messages":[{"role":"user","content":[{"type":"text","text":"x","cache_control":{"type":"ephemeral"}}]}]}`)
  expect(build(try injectMessagesCache(own, true, {}))).toBe(build(own))
  // an index out of range marks nothing
  expect(build(try injectMessagesCache(body, false, { cache_control_injection_points: [{ index: 9 }] }))).toBe(build(body))
})

test("translates a Messages response", () => {
  const r = try chatResponse(`{"id":"msg_1","type":"message","role":"assistant","content":[{"type":"text","text":"Let me check."},{"type":"tool_use","id":"tu1","name":"look","input":{"q":2}}],"stop_reason":"tool_use","usage":{"input_tokens":10,"output_tokens":4}}`, "anthropic/claude-sonnet-4")
  expect(r.promptTokens).toBe(10)
  expect(r.body.includes(`"finish_reason":"tool_calls"`)).toBe(true)
  expect(r.body.includes(`"arguments":"{\\"q\\":2}"`)).toBe(true)
  expect(r.body.includes(`"content":"Let me check."`)).toBe(true)
  expect(r.served).toBe("")
})

test("a server-side fallback reports the model that answered it", () => {
  const r = try chatResponse(`{"id":"msg_2","type":"message","role":"assistant","content":[{"type":"text","text":"ok"}],"stop_reason":"end_turn","usage":{"input_tokens":3,"output_tokens":1,"iterations":[{"type":"message","model":"claude-opus-4"},{"type":"fallback_message","model":"claude-sonnet-4"}]}}`, "anthropic/claude-opus-4")
  expect(r.served).toBe("claude-sonnet-4")
  expect(r.promptTokens).toBe(3)
})
