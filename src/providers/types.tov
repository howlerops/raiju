import { KeyConfig, ProviderConfig, GlobalProxyConfig } from "../config"

// One attempt's destination: a provider, the model name it knows, and the key to use.
export type Target = {
  provider: string, // the configured name, e.g. "openai" or a custom provider's name
  kind: string, // the wire format: "openai", "azure", "anthropic", "gemini", ...
  model: string,
  key: KeyConfig,
  cfg: ProviderConfig,
}

// `extra`: more calls whose bodies are joined to this one's with RS (U+001E), for APIs that
// take one input per call (Bedrock Titan embeddings).
export type Upstream = { url: string, headers: Map<string, string>, body: string, extra?: Upstream[] }

export const RS = "\u001e"

// What a translator hands back: an OpenAI-shaped body plus token counts for
// accounting.
// served: the model a provider's server-side fallback answered with, when it reports one ("" or absent: none).
// billed: the cost the provider reports for the call in USD (OpenRouter's usage.cost); absent: the datasheet price is used.
export type Translated = { body: string, promptTokens: int, completionTokens: int, served?: string, billed?: f64 }

export function headers(pairs: string[][]): Map<string, string> {
  const m: Map<string, string> = new Map()
  for (const p of pairs) m.set(p[0]!, p[1]!)
  return m
}

export function addExtraHeaders(inout h: Map<string, string>, cfg: ProviderConfig): void {
  const extra = cfg.network_config?.extra_headers
  if (extra === undefined) return
  for (const k of extra.keys()) h.set(k, extra.get(k)!)
}

// The provider's outbound HTTP proxy for fetch ("http://user:pass@host:port"), from
// Bifrost's proxy_config. "environment" and unset use HTTP_PROXY/HTTPS_PROXY, as fetch
// does by default; Tov's fetch has no SOCKS5, so that type is ignored.
// TLS options for fetch from network_config (insecure_skip_verify, ca_cert_pem) and
// proxy_config.ca_cert_pem, or undefined for the defaults.
export function tlsOf(p: ProviderConfig): { rejectUnauthorized?: bool, ca?: string } | undefined {
  const nc = p.network_config
  const skip = nc?.insecure_skip_verify === true
  const pems: string[] = []
  const a = nc?.ca_cert_pem ?? ""
  if (a !== "") pems.push(a)
  const b = p.proxy_config?.ca_cert_pem ?? ""
  if (b !== "") pems.push(b)
  if (!skip && pems.length === 0) return undefined
  return { rejectUnauthorized: !skip, ca: pems.length === 0 ? undefined : pems.join("\n") }
}

// The default idle keep-alive and connections per host (Bifrost's schemas.DefaultKeepAliveTimeoutInSeconds and
// DefaultMaxConnsPerHost), and the bounds its schema gives each key.
export const DEFAULT_KEEP_ALIVE_SECONDS = 30
export const DEFAULT_MAX_CONNS_PER_HOST = 5000

export type PoolOpts = { keepAliveTimeout?: int, maxConnections?: int, http2?: "off" | "prefer" | "require", http2PingInterval?: int }

// fetch's pool options for a provider, from network_config: keep_alive_timeout_in_seconds (1 to 3600, default 30),
// max_conns_per_host (1 to 10000, default 5000), enforce_http2 (offer h2 in ALPN; a server that does not pick it gets
// HTTP/1.1, as Go's ForceAttemptHTTP2 does for Bifrost) and http2_ping_interval_in_seconds (0 to 3600, only with
// enforce_http2). Values outside a range are clamped to it; 0 or absent takes the default.
export function poolOf(p: ProviderConfig): PoolOpts {
  const nc = p.network_config
  let ka = nc?.keep_alive_timeout_in_seconds ?? 0
  if (ka <= 0) ka = DEFAULT_KEEP_ALIVE_SECONDS
  if (ka > 3600) ka = 3600
  let mc = nc?.max_conns_per_host ?? 0
  if (mc <= 0) mc = DEFAULT_MAX_CONNS_PER_HOST
  if (mc > 10000) mc = 10000
  const h2 = nc?.enforce_http2 === true
  let ping = h2 ? (nc?.http2_ping_interval_in_seconds ?? 0) : 0
  if (ping < 0) ping = 0
  if (ping > 3600) ping = 3600
  return { keepAliveTimeout: ka, maxConnections: mc, http2: h2 ? "prefer" : "off", http2PingInterval: ping }
}

// The global proxy (Bifrost's top-level proxy_config), set from the config by store.tov. A
// provider without a proxy_config of its own uses it when it is enabled for inference.
let globalProxy: GlobalProxyConfig | undefined = undefined

export function setGlobalProxy(px: GlobalProxyConfig | undefined): void {
  globalProxy = px
}

export function proxyOf(p: ProviderConfig): string | undefined {
  const px = p.proxy_config
  if (px === undefined) return globalProxyUrl()
  return proxyUrl(px.type, px.url, px.username, px.password)
}

function globalProxyUrl(): string | undefined {
  const g = globalProxy
  if (g === undefined || g.enabled !== true || g.enable_for_inference !== true) return undefined
  return proxyUrl(g.type, g.url, g.username, g.password)
}

function proxyUrl(type: string | undefined, url0: string | undefined, username: string | undefined, password: string | undefined): string | undefined {
  const kind = (type ?? "http").toLowerCase()
  const url = url0 ?? ""
  if (kind !== "http" || url === "") return undefined
  const user = username ?? ""
  if (user === "") return url
  const cut = url.indexOf("://")
  const scheme = cut < 0 ? "http://" : url.slice(0, cut + 3)
  const rest = cut < 0 ? url : url.slice(cut + 3)
  return `${scheme}${pct(user)}:${pct(password ?? "")}@${rest}`
}

// Percent-encodes everything but RFC 3986 unreserved characters (for URL userinfo).
function pct(s: string): string {
  const keep = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~"
  const hexd = "0123456789ABCDEF"
  const bytes = new TextEncoder().encode(s)
  let out = ""
  for (let i = 0; i < bytes.length; i++) {
    const b = int(bytes[i]!)
    if (b < 128 && keep.includes(s.slice(i, i + 1))) out += s.slice(i, i + 1)
    else out += "%" + hexd.slice(b >> 4, (b >> 4) + 1) + hexd.slice(b & 15, (b & 15) + 1)
  }
  return out
}

test("proxy URL from proxy_config", () => {
  expect(proxyOf({})).toBeUndefined()
  expect(proxyOf({ proxy_config: { type: "http", url: "http://proxy:3128" } })).toBe("http://proxy:3128")
  expect(proxyOf({ proxy_config: { type: "http", url: "http://proxy:3128", username: "u", password: "p@ss:w" } })).toBe("http://u:p%40ss%3Aw@proxy:3128")
  expect(proxyOf({ proxy_config: { type: "socks5", url: "socks5://p:1080" } })).toBeUndefined()
  expect(proxyOf({ proxy_config: { type: "environment" } })).toBeUndefined()
})

test("a provider without proxy_config uses the global proxy when enabled for inference", () => {
  setGlobalProxy({ enabled: true, type: "http", url: "http://egress:8080", enable_for_inference: true })
  expect(proxyOf({})).toBe("http://egress:8080")
  // a provider's own proxy_config wins, and "environment" stays with the environment
  expect(proxyOf({ proxy_config: { type: "http", url: "http://own:1" } })).toBe("http://own:1")
  expect(proxyOf({ proxy_config: { type: "environment" } })).toBeUndefined()
  setGlobalProxy({ enabled: true, type: "http", url: "http://egress:8080", username: "u", password: "p w", enable_for_inference: true })
  expect(proxyOf({})).toBe("http://u:p%20w@egress:8080")
  setGlobalProxy({ enabled: true, type: "http", url: "http://egress:8080", enable_for_inference: false })
  expect(proxyOf({})).toBeUndefined()
  setGlobalProxy({ enabled: false, type: "http", url: "http://egress:8080", enable_for_inference: true })
  expect(proxyOf({})).toBeUndefined()
  setGlobalProxy(undefined)
  expect(proxyOf({})).toBeUndefined()
})

test("poolOf maps network_config onto fetch's pool options with Bifrost's defaults and ranges", () => {
  const d = poolOf({})
  expect(d.keepAliveTimeout).toBe(30)
  expect(d.maxConnections).toBe(5000)
  expect(d.http2).toBe("off")
  expect(d.http2PingInterval).toBe(0)
  const c = poolOf({ network_config: { keep_alive_timeout_in_seconds: 7, max_conns_per_host: 3, enforce_http2: true, http2_ping_interval_in_seconds: 20 } })
  expect(c.keepAliveTimeout).toBe(7)
  expect(c.maxConnections).toBe(3)
  expect(c.http2).toBe("prefer")
  expect(c.http2PingInterval).toBe(20)
  // out of range: clamped; zero or negative: the default
  const hi = poolOf({ network_config: { keep_alive_timeout_in_seconds: 99999, max_conns_per_host: 99999, enforce_http2: true, http2_ping_interval_in_seconds: 99999 } })
  expect(hi.keepAliveTimeout).toBe(3600)
  expect(hi.maxConnections).toBe(10000)
  expect(hi.http2PingInterval).toBe(3600)
  const lo = poolOf({ network_config: { keep_alive_timeout_in_seconds: 0, max_conns_per_host: -4, enforce_http2: true, http2_ping_interval_in_seconds: -1 } })
  expect(lo.keepAliveTimeout).toBe(30)
  expect(lo.maxConnections).toBe(5000)
  expect(lo.http2PingInterval).toBe(0)
  // the ping interval means nothing without enforce_http2
  expect(poolOf({ network_config: { http2_ping_interval_in_seconds: 20 } }).http2PingInterval).toBe(0)
})

export function trimSlash(s: string): string {
  let out = s
  while (out.endsWith("/")) out = out.slice(0, out.byteLength - 1)
  return out
}
