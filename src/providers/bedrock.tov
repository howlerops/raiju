// AWS Bedrock Converse API with SigV4 signing (or a Bedrock API key as a bearer token).
import { Field, fields, elements, find, quote, rawStr, isNull, build, setField, without } from "../json"
import { fromChat, bedrockReasoning } from "../reasoning"
import { Target, Upstream, Translated, headers, addExtraHeaders, trimSlash } from "./types"
import { ChatRequest, ContentPart, newId, nowSeconds } from "../schemas"
import { sha256, hmacSha256, toHex, utf8 } from "../crypto"
import * as openai from "./openai"
import { BedrockKeyConfig, ProviderConfig } from "../config"

// ---- SigV4 ----

function pad2(n: int): string {
  return n < 10 ? "0" + n : "" + n
}

// UTC "YYYYMMDDTHHMMSSZ" for a Unix time in milliseconds.
export function amzDate(ms: f64): string {
  const secs = Math.floor(ms / 1000)
  const days = Math.floor(secs / 86400)
  const rem = secs - days * 86400
  // civil-from-days (Howard Hinnant)
  const z = days + 719468
  const era = Math.floor(z / 146097)
  const doe = z - era * 146097
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365)
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100))
  const mp = Math.floor((5 * doy + 2) / 153)
  const d = doy - Math.floor((153 * mp + 2) / 5) + 1
  const m = mp < 10 ? mp + 3 : mp - 9
  const y = yoe + era * 400 + (m <= 2 ? 1 : 0)
  return `${y}${pad2(m)}${pad2(d)}T${pad2(Math.floor(rem / 3600))}${pad2(Math.floor((rem % 3600) / 60))}${pad2(rem % 60)}Z`
}

const UNRESERVED = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.~"
const HEXU = "0123456789ABCDEF"

// RFC 3986 percent-encoding of one path segment.
export function encodeSegment(s: string): string {
  const out: string[] = []
  const bytes = utf8(s)
  for (let i = 0; i < bytes.length; i++) {
    const v = int(bytes[i]!)
    // an ASCII byte is one character of s at the same byte offset
    const ch = v < 128 ? s.slice(i, i + 1) : ""
    if (v < 128 && UNRESERVED.includes(ch)) out.push(ch)
    else out.push("%" + HEXU.slice(v >> 4, (v >> 4) + 1) + HEXU.slice(v & 15, (v & 15) + 1))
  }
  return out.join("")
}

export type Credentials = { accessKey: string, secretKey: string, sessionToken?: string, region: string }

// Signs a POST. `path` is already percent-encoded once; SigV4 for non-S3
// services encodes each segment again in the canonical request.
export function sign(creds: Credentials, service: string, host: string, path: string, body: string, nowMs: f64): Map<string, string> {
  const date = amzDate(nowMs)
  const day = date.slice(0, 8)
  const canonicalPath = path.split("/").map((seg) => encodeSegment(seg)).join("/")
  const payloadHash = toHex(sha256(utf8(body)))
  const hs: string[][] = [["content-type", "application/json"], ["host", host], ["x-amz-date", date]]
  const token = creds.sessionToken
  if (token !== undefined && token !== "") hs.push(["x-amz-security-token", token])
  const canonicalHeaders = hs.map((h) => `${h[0]!}:${h[1]!}\n`).join("")
  const signed = hs.map((h) => h[0]!).join(";")
  const canonical = `POST\n${canonicalPath}\n\n${canonicalHeaders}\n${signed}\n${payloadHash}`
  const scope = `${day}/${creds.region}/${service}/aws4_request`
  const toSign = `AWS4-HMAC-SHA256\n${date}\n${scope}\n${toHex(sha256(utf8(canonical)))}`
  const kDate = hmacSha256(utf8("AWS4" + creds.secretKey), utf8(day))
  const kRegion = hmacSha256(kDate, utf8(creds.region))
  const kService = hmacSha256(kRegion, utf8(service))
  const kSigning = hmacSha256(kService, utf8("aws4_request"))
  const signature = toHex(hmacSha256(kSigning, utf8(toSign)))
  const out = headers(hs)
  out.delete("host")
  out.set("authorization", `AWS4-HMAC-SHA256 Credential=${creds.accessKey}/${scope}, SignedHeaders=${signed}, Signature=${signature}`)
  return out
}

// ---- Converse translation ----

function contentOf(c: string | ContentPart[] | undefined): string[] {
  if (c === undefined) return []
  if (typeof c === "string") return c === "" ? [] : [`{"text":${quote(c)}}`]
  const out: string[] = []
  for (const p of c) {
    if (p.type === "text" && p.text !== undefined) out.push(`{"text":${quote(p.text)}}`)
    else if (p.type === "image_url" && p.image_url !== undefined && p.image_url.url.startsWith("data:image/")) {
      const url = p.image_url.url
      const semi = url.indexOf(";")
      const comma = url.indexOf(",")
      const format = url.slice(11, semi > 0 ? semi : comma)
      out.push(`{"image":{"format":${quote(format === "jpg" ? "jpeg" : format)},"source":{"bytes":${quote(url.slice(comma + 1))}}}}`)
    }
  }
  return out
}

function argsObject(args: string): string {
  try {
    return build(fields(args))
  } catch (e) {
    return "{}"
  }
}

type Turn = { role: string, content: string[] }

function pushTurn(inout turns: Turn[], role: string, content: string[]): void {
  if (content.length === 0) return
  const last = turns.length - 1
  if (last >= 0 && turns[last]!.role === role) {
    turns[last] = { role: role, content: turns[last]!.content.concat(content) }
    return
  }
  turns.push({ role: role, content: content })
}

function toolConfig(tools: string, choice: string | undefined): string throws SyntaxError {
  const specs: string[] = []
  for (const el of try elements(tools)) {
    const fnRaw = find(try fields(el), "function")
    if (fnRaw === undefined) continue
    const fn = try fields(fnRaw)
    const parts = [`"name":${quote(rawStr(fn, "name") ?? "")}`]
    const desc = find(fn, "description")
    if (desc !== undefined && !isNull(desc)) parts.push(`"description":${desc}`)
    const params = find(fn, "parameters")
    parts.push(`"inputSchema":{"json":${isNull(params) ? `{"type":"object","properties":{}}` : params!}}`)
    specs.push(`{"toolSpec":{${parts.join(",")}}}`)
  }
  let tc = ""
  if (choice === `"auto"`) tc = `,"toolChoice":{"auto":{}}`
  else if (choice === `"required"`) tc = `,"toolChoice":{"any":{}}`
  else if (choice !== undefined && choice.startsWith("{")) {
    const fnRaw = find(try fields(choice), "function")
    if (fnRaw !== undefined) tc = `,"toolChoice":{"tool":{"name":${quote(rawStr(try fields(fnRaw), "name") ?? "")}}}`
  }
  return `{"tools":[${specs.join(",")}]${tc}}`
}

export function converseBody(req: ChatRequest, body: Field[], autoCache: bool, modelId?: string): string throws SyntaxError {
  let turns: Turn[] = []
  const system: string[] = []
  for (const m of req.messages) {
    if (m.role === "system" || m.role === "developer") {
      for (const c of contentOf(m.content)) system.push(c)
      continue
    }
    if (m.role === "tool") {
      const text = typeof m.content === "string" ? m.content : (m.content ?? []).map((p) => p.text ?? "").join("")
      pushTurn(&turns, "user", [`{"toolResult":{"toolUseId":${quote(m.tool_call_id ?? "")},"content":[{"text":${quote(text)}}]}}`])
      continue
    }
    const role = m.role === "assistant" ? "assistant" : "user"
    const content = contentOf(m.content)
    for (const c of m.tool_calls ?? []) {
      content.push(`{"toolUse":{"toolUseId":${quote(c.id)},"name":${quote(c.function.name)},"input":${argsObject(c.function.arguments)}}}`)
    }
    pushTurn(&turns, role, content)
  }
  if (autoCache) {
    // cache points after the system prompt and the newest turn
    if (turns.length > 0) {
      const last = turns[turns.length - 1]!
      turns[turns.length - 1] = { role: last.role, content: last.content.concat([`{"cachePoint":{"type":"default"}}`]) }
    }
    if (system.length > 0) system.push(`{"cachePoint":{"type":"default"}}`)
  }
  const out: string[] = [`"messages":[${turns.map((t) => `{"role":"${t.role}","content":[${t.content.join(",")}]}`).join(",")}]`]
  if (system.length > 0) out.push(`"system":[${system.join(",")}]`)
  const inf: string[] = []
  const max0 = req.max_completion_tokens ?? req.max_tokens
  // Claude thinking or Nova reasoning, from reasoning_effort / reasoning.max_tokens
  const plan = bedrockReasoning(fromChat(body), modelId ?? "", max0)
  if (plan.error !== undefined) throw new SyntaxError(plan.error)
  const max = plan.maxTokens ?? max0
  const sampling = !plan.clearSampling && plan.fields?.includes(`"thinking"`) !== true
  if (max !== undefined && !plan.clearSampling) inf.push(`"maxTokens":${max}`)
  if (req.temperature !== undefined && sampling) inf.push(`"temperature":${req.temperature}`)
  if (req.top_p !== undefined && sampling) inf.push(`"topP":${req.top_p}`)
  const stop = req.stop
  if (stop !== undefined) inf.push(`"stopSequences":${typeof stop === "string" ? `[${quote(stop)}]` : JSON.stringify(stop)}`)
  if (inf.length > 0) out.push(`"inferenceConfig":{${inf.join(",")}}`)
  if (plan.fields !== undefined) out.push(`"additionalModelRequestFields":${plan.fields}`)
  const tools = find(body, "tools")
  if (tools !== undefined && !isNull(tools)) out.push(`"toolConfig":${try toolConfig(tools, find(body, "tool_choice"))}`)
  return "{" + out.join(",") + "}"
}

type BedrockUsage = { inputTokens?: int, outputTokens?: int, cacheReadInputTokens?: int, cacheWriteInputTokens?: int }

function finishReason(r: string | undefined): string {
  if (r === "tool_use") return "tool_calls"
  if (r === "max_tokens") return "length"
  if (r === "guardrail_intervened" || r === "content_filtered") return "content_filter"
  return "stop"
}

export function chatResponse(text: string, requestedModel: string): Translated throws SyntaxError {
  const fs = try fields(text)
  // the OpenAI-compatible endpoint answers in the OpenAI shape
  if (find(fs, "choices") !== undefined) return try openai.chatResponse(text, requestedModel)
  const textParts: string[] = []
  const reasoning: string[] = []
  const calls: string[] = []
  const output = find(fs, "output")
  if (output !== undefined && !isNull(output)) {
    const msg = find(try fields(output), "message")
    if (msg !== undefined && !isNull(msg)) {
      const content = find(try fields(msg), "content")
      if (content !== undefined) {
        for (const el of try elements(content)) {
          const b = try fields(el)
          const t = rawStr(b, "text")
          if (t !== undefined) textParts.push(t)
          const rc = find(b, "reasoningContent")
          if (rc !== undefined && !isNull(rc)) {
            const rt = find(try fields(rc), "reasoningText")
            if (rt !== undefined && !isNull(rt)) reasoning.push(rawStr(try fields(rt), "text") ?? "")
          }
          const tu = find(b, "toolUse")
          if (tu !== undefined) {
            const u = try fields(tu)
            calls.push(`{"id":${quote(rawStr(u, "toolUseId") ?? "")},"type":"function","function":{"name":${quote(rawStr(u, "name") ?? "")},"arguments":${quote(find(u, "input") ?? "{}")}}}`)
          }
        }
      }
    }
  }
  let pt = 0
  let ct = 0
  const u = find(fs, "usage")
  if (u !== undefined && !isNull(u)) {
    const usage = try JSON.parse(u) as BedrockUsage
    pt = (usage.inputTokens ?? 0) + (usage.cacheReadInputTokens ?? 0) + (usage.cacheWriteInputTokens ?? 0)
    ct = usage.outputTokens ?? 0
  }
  const joined = textParts.join("")
  const msg: string[] = [`"role":"assistant"`, `"content":${joined === "" && calls.length > 0 ? "null" : quote(joined)}`]
  if (calls.length > 0) msg.push(`"tool_calls":[${calls.join(",")}]`)
  const rs = reasoning.join("")
  if (rs !== "") msg.push(`"reasoning":${quote(rs)},"reasoning_content":${quote(rs)}`)
  const out = `{"id":${quote(newId("chatcmpl-"))},"object":"chat.completion","created":${nowSeconds()},"model":${quote(requestedModel)},` +
    `"choices":[{"index":0,"message":{${msg.join(",")}},"finish_reason":"${finishReason(rawStr(fs, "stopReason"))}"}],` +
    `"usage":{"prompt_tokens":${pt},"completion_tokens":${ct},"total_tokens":${pt + ct}}}`
  return { body: out, promptTokens: pt, completionTokens: ct }
}

// ---- requests ----

function region(t: Target): string {
  return t.key.bedrock_key_config?.region ?? "us-east-1"
}

function modelId(t: Target): string {
  let id = t.model
  const deps = t.key.bedrock_key_config?.deployments
  if (deps !== undefined) id = deps.get(t.model) ?? t.model
  return id
}

// The host for an AWS service in a region. The key's base_url, when set, serves every
// service (a proxy, or the mock in tests).
function host(t: Target, service: string, reg: string): string {
  const b = t.cfg.network_config?.base_url
  if (b !== undefined && b !== "") {
    const u = URL.parse(b)
    if (u !== undefined) return u.host
  }
  return `${service}.${reg}.amazonaws.com`
}

function scheme(t: Target): string {
  const b = t.cfg.network_config?.base_url
  if (b !== undefined && b.startsWith("http://")) return "http://"
  return "https://"
}

// The model's segment of a URL path. A key with an ARN (an inference profile) gets the
// ARN joined to the model id, percent-encoded as one segment, as Bifrost builds it.
function modelPath(t: Target): string {
  const arn = t.key.bedrock_key_config?.arn ?? ""
  return encodeSegment(arn === "" ? modelId(t) : `${arn}/${modelId(t)}`)
}

// A POST to a path on an AWS host, signed with the key's credentials for service bedrock
// in reg, or sent with its Bedrock API key as a bearer token.
function callTo(t: Target, reg: string, h: string, sch: string, path: string, body: string): Upstream {
  const bk = t.key.bedrock_key_config
  const ak = bk?.access_key ?? ""
  let hs: Map<string, string> = new Map()
  if (ak !== "") {
    hs = sign({ accessKey: ak, secretKey: bk?.secret_key ?? "", sessionToken: bk?.session_token, region: reg }, "bedrock", h, path, body, Date.now())
  } else {
    hs = headers([["content-type", "application/json"], ["authorization", "Bearer " + (t.key.value ?? "")]])
  }
  addExtraHeaders(&hs, t.cfg)
  return { url: sch + h + path, headers: hs, body: body }
}

// A GET on Bedrock's control plane (the "bedrock" service, not bedrock-runtime) for a model listing
// (/foundation-models, /inference-profiles). Signed as callTo signs, or sent with the Bedrock API key.
export function listRequest(t: Target, path: string): Upstream {
  const reg = region(t)
  const h = host(t, "bedrock", reg)
  const bk = t.key.bedrock_key_config
  const ak = bk?.access_key ?? ""
  let hs: Map<string, string> = new Map()
  if (ak !== "") {
    hs = sign({ accessKey: ak, secretKey: bk?.secret_key ?? "", sessionToken: bk?.session_token, region: reg }, "bedrock", h, path, "", Date.now())
  } else {
    hs = headers([["authorization", "Bearer " + (t.key.value ?? "")]])
  }
  addExtraHeaders(&hs, t.cfg)
  return { url: scheme(t) + h + path, headers: hs, body: "" }
}

// A request to /model/{id}/{action} on bedrock-runtime.
export function signedRequest(t: Target, action: string, body: string): Upstream {
  return callTo(t, region(t), host(t, "bedrock-runtime", region(t)), scheme(t), `/model/${modelPath(t)}/${action}`, body)
}

// "us-west-2/model" names the region for one call; the model is the rest.
function regionPrefix(model: string): { region: string | undefined, model: string } {
  const slash = model.indexOf("/")
  if (slash > 0 && isRegionName(model.slice(0, slash))) return { region: model.slice(0, slash), model: model.slice(slash + 1) }
  return { region: undefined, model: model }
}

// A region name such as "us-west-2": lower-case letters and digits, hyphens, ending in a digit.
function isRegionName(s: string): bool {
  if (s.indexOf("-") < 0) return false
  if (!"0123456789".includes(s.slice(s.byteLength - 1))) return false
  for (const c of s.chars()) {
    if (!"abcdefghijklmnopqrstuvwxyz0123456789-".includes(c)) return false
  }
  return true
}

// Bedrock's OpenAI-compatible endpoint serves the OpenAI and xAI families. gpt-oss is
// served by Mantle, not here, so it stays on Converse.
function openAIFamily(model: string): bool {
  const m = model.toLowerCase()
  if (m.includes("gpt-oss")) return false
  return m.startsWith("openai.") || m.startsWith("xai.") || m.includes("grok")
}

// The chat call goes to the OpenAI-compatible endpoint when the key opts in
// (use_openai_endpoints) and the model is in that family. Streaming stays on Converse.
function usesOpenAIEndpoints(t: Target): bool {
  if (t.key.bedrock_key_config?.use_openai_endpoints !== true) return false
  return openAIFamily(regionPrefix(modelId(t)).model)
}

// The OpenAI body with gateway fields dropped and the bare model id, POSTed to
// bedrock-runtime's /openai/v1/chat/completions.
function openAIChatRequest(t: Target, body: Field[]): Upstream throws SyntaxError {
  const sel = regionPrefix(modelId(t))
  const reg = sel.region ?? region(t)
  let fs = without(body, openai.GATEWAY_FIELDS)
  setField(&fs, "model", quote(sel.model))
  return callTo(t, reg, host(t, "bedrock-runtime", reg), scheme(t), "/openai/v1/chat/completions", build(fs))
}

// The foundation-model ARN a rerank body names, built from the region unless the model is
// an ARN already.
function rerankARN(model: string, reg: string): string {
  if (model.startsWith("arn:")) return model
  const part = reg.startsWith("us-gov-") ? "aws-us-gov" : (reg.startsWith("cn-") ? "aws-cn" : "aws")
  return `arn:${part}:bedrock:${reg}::foundation-model/${model}`
}

// A Cohere-style rerank request (query, documents, top_n) as Bedrock Agent Runtime's
// /rerank body, posted to bedrock-agent-runtime in the model's region. Rerank addresses
// its model by ARN, as Bifrost does.
export function rerankUpstream(t: Target, query: string, docs: string[], topN: int): Upstream throws SyntaxError {
  if (docs.length === 0) throw new SyntaxError("documents are required for rerank")
  if (topN < 1) throw new SyntaxError("top_n must be at least 1")
  const sel = regionPrefix(modelId(t))
  const reg = sel.region ?? region(t)
  const srcs: string[] = docs.map((d) => `{"type":"INLINE","inlineDocumentSource":{"type":"TEXT","textDocument":{"text":${quote(d)}}}}`)
  const text = `{"queries":[{"type":"TEXT","textQuery":{"text":${quote(query)}}}],"sources":[${srcs.join(",")}],` +
    `"rerankingConfiguration":{"type":"BEDROCK_RERANKING_MODEL","bedrockRerankingConfiguration":{"modelConfiguration":{"modelArn":${quote(rerankARN(sel.model, reg))}},"numberOfResults":${topN}}}}`
  return callTo(t, reg, host(t, "bedrock-agent-runtime", reg), scheme(t), "/rerank", text)
}

type WireRerank = {
  queries?: { textQuery?: { text?: string } }[],
  sources?: { inlineDocumentSource?: { textDocument?: { text?: string } } }[],
  rerankingConfiguration?: { bedrockRerankingConfiguration?: { modelConfiguration?: { modelArn?: string }, numberOfResults?: int } },
}

// A Bedrock rerank body (the /bedrock/rerank wire) as the Cohere-style body the gateway
// ranks. The model becomes "bedrock/<arn>", which reads back as a Bedrock model.
export function rerankFromWire(text: string): string throws SyntaxError {
  const w = try JSON.parse(text) as WireRerank
  const arn = w.rerankingConfiguration?.bedrockRerankingConfiguration?.modelConfiguration?.modelArn ?? ""
  if (arn === "") throw new SyntaxError("rerank needs rerankingConfiguration.bedrockRerankingConfiguration.modelConfiguration.modelArn")
  const qs = w.queries ?? []
  if (qs.length === 0) throw new SyntaxError("rerank needs a query")
  const docs: string[] = []
  for (const s of w.sources ?? []) {
    const d = s.inlineDocumentSource?.textDocument?.text
    if (d === undefined) throw new SyntaxError("rerank takes text sources only")
    docs.push(quote(d))
  }
  const n = w.rerankingConfiguration?.bedrockRerankingConfiguration?.numberOfResults
  const top = n === undefined ? "" : `,"top_n":${n}`
  return `{"model":${quote("bedrock/" + arn)},"query":${quote(qs[0]!.textQuery?.text ?? "")},"documents":[${docs.join(",")}]${top}}`
}

type WireRerankReply = { results?: { index: int, relevanceScore: f64 }[] }

// The scored results of Bedrock's rerank answer. The caller builds the reply.
export function rerankResults(text: string): { index: int, score: f64 }[] throws SyntaxError {
  const w = try JSON.parse(text) as WireRerankReply
  return (w.results ?? []).map((r) => ({ index: r.index, score: r.relevanceScore }))
}

type GatewayRerankReply = { results?: { index: int, relevance_score: f64 }[] }

// The gateway's rerank reply (relevance_score) as Bedrock's answer (relevanceScore).
export function rerankWire(text: string): string throws SyntaxError {
  const w = try JSON.parse(text) as GatewayRerankReply
  const out = (w.results ?? []).map((r) => `{"index":${r.index},"relevanceScore":${JSON.stringify(r.relevance_score)}}`)
  return `{"results":[${out.join(",")}]}`
}

export function streamRequest(t: Target, req: ChatRequest, body: Field[], autoCache: bool): Upstream throws SyntaxError {
  return signedRequest(t, "converse-stream", try converseBody(req, body, autoCache, t.model))
}

export function chatRequest(t: Target, req: ChatRequest, body: Field[], autoCache: bool): Upstream throws SyntaxError {
  if (usesOpenAIEndpoints(t)) return try openAIChatRequest(t, body)
  return signedRequest(t, "converse", try converseBody(req, body, autoCache, t.model))
}

test("amz dates", () => {
  expect(amzDate(0.0)).toBe("19700101T000000Z")
  expect(amzDate(1440938160000.0)).toBe("20150830T123600Z")
  expect(amzDate(1709251199000.0)).toBe("20240229T235959Z")
})

test("sigv4 matches the AWS reference signature", () => {
  // Reference signature computed independently with Python's hmac/hashlib for this input.
  const creds: Credentials = { accessKey: "AKIDEXAMPLE", secretKey: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY", region: "us-east-1" }
  const h = sign(creds, "bedrock", "bedrock-runtime.us-east-1.amazonaws.com", "/model/anthropic.claude-3-haiku-20240307-v1%3A0/converse", "{}", 1440938160000.0)
  expect(h.get("x-amz-date")).toBe("20150830T123600Z")
  const auth = h.get("authorization")!
  expect(auth.startsWith("AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/bedrock/aws4_request, SignedHeaders=content-type;host;x-amz-date, Signature=")).toBe(true)
  expect(auth.endsWith("Signature=1e3e5ff96e9eaa6f374cc3e88308f4dd8c58e317eb37fe847a49419ac9af2387")).toBe(true)
})

test("segment encoding", () => {
  expect(encodeSegment("anthropic.claude-3-haiku-20240307-v1:0")).toBe("anthropic.claude-3-haiku-20240307-v1%3A0")
  expect(encodeSegment("a b/é")).toBe("a%20b%2F%C3%A9")
})

test("converse translation", () => {
  const raw = `{"model":"bedrock/claude","messages":[{"role":"system","content":"s"},{"role":"user","content":"hi"}],"max_tokens":10,"tools":[{"type":"function","function":{"name":"f","parameters":{"type":"object"}}}],"tool_choice":"auto"}`
  const out = try converseBody(try JSON.parse(raw) as ChatRequest, try fields(raw), false)
  expect(out).toBe(`{"messages":[{"role":"user","content":[{"text":"hi"}]}],"system":[{"text":"s"}],"inferenceConfig":{"maxTokens":10},"toolConfig":{"tools":[{"toolSpec":{"name":"f","inputSchema":{"json":{"type":"object"}}}}],"toolChoice":{"auto":{}}}}`)
  const r = try chatResponse(`{"output":{"message":{"role":"assistant","content":[{"text":"yo"},{"toolUse":{"toolUseId":"t9","name":"f","input":{"a":1}}}]}},"stopReason":"tool_use","usage":{"inputTokens":4,"outputTokens":6,"totalTokens":10}}`, "bedrock/claude")
  expect(r.body.includes(`"finish_reason":"tool_calls"`)).toBe(true)
  expect(r.body.includes(`"arguments":"{\\"a\\":1}"`)).toBe(true)
  expect(r.completionTokens).toBe(6)
})

test("reasoning_effort becomes Claude thinking fields; reasoning text comes back", () => {
  const raw = `{"model":"m","messages":[{"role":"user","content":"hi"}],"reasoning_effort":"medium","max_tokens":4096,"temperature":0.3}`
  const out = try converseBody(try JSON.parse(raw) as ChatRequest, try fields(raw), false, "anthropic.claude-sonnet-4")
  expect(out.includes(`"additionalModelRequestFields":{"thinking":{"type":"enabled","budget_tokens":`)).toBe(true)
  expect(out.includes(`"temperature"`)).toBe(false)
  const r = try chatResponse(`{"output":{"message":{"content":[{"reasoningContent":{"reasoningText":{"text":"why","signature":"s"}}},{"text":"ok"}]}},"stopReason":"end_turn"}`, "m")
  expect(r.body.includes(`"reasoning":"why","reasoning_content":"why"`)).toBe(true)
})

function keyed(model: string, bk: BedrockKeyConfig, base: string): Target {
  const cfg: ProviderConfig = base === "" ? {} : { network_config: { base_url: base } }
  return { provider: "bedrock", kind: "bedrock", model: model, key: { value: "", bedrock_key_config: bk }, cfg: cfg }
}

test("an ARN on the key joins the model in the path", () => {
  const bk: BedrockKeyConfig = { access_key: "AKIDEXAMPLE", secret_key: "s", region: "us-east-1", arn: "arn:aws:bedrock:us-east-1:123456789012:inference-profile/us.anthropic.claude" }
  const up = signedRequest(keyed("anthropic.claude-3-haiku-20240307-v1:0", bk, ""), "converse", "{}")
  expect(up.url).toBe("https://bedrock-runtime.us-east-1.amazonaws.com/model/arn%3Aaws%3Abedrock%3Aus-east-1%3A123456789012%3Ainference-profile%2Fus.anthropic.claude%2Fanthropic.claude-3-haiku-20240307-v1%3A0/converse")
  const plain = signedRequest(keyed("anthropic.claude-3-haiku-20240307-v1:0", { access_key: "AKIDEXAMPLE", secret_key: "s", region: "us-east-1" }, ""), "converse", "{}")
  expect(plain.url.endsWith("/model/anthropic.claude-3-haiku-20240307-v1%3A0/converse")).toBe(true)
})

test("count-tokens is a signed bedrock-runtime call on the model", () => {
  const bk: BedrockKeyConfig = { access_key: "AKIDEXAMPLE", secret_key: "s", region: "eu-west-1" }
  const up = signedRequest(keyed("anthropic.claude-3-haiku-20240307-v1:0", bk, ""), "count-tokens", `{"input":{}}`)
  expect(up.url).toBe("https://bedrock-runtime.eu-west-1.amazonaws.com/model/anthropic.claude-3-haiku-20240307-v1%3A0/count-tokens")
  expect(up.headers.get("authorization")!.includes("/eu-west-1/bedrock/aws4_request")).toBe(true)
})

test("rerank gets a foundation-model ARN in the key's region and posts to agent-runtime", () => {
  const bk: BedrockKeyConfig = { access_key: "AKIDEXAMPLE", secret_key: "s", region: "us-west-2" }
  const up = try rerankUpstream(keyed("cohere.rerank-v3-5:0", bk, ""), "q", ["a", "b"], 1)
  expect(up.url).toBe("https://bedrock-agent-runtime.us-west-2.amazonaws.com/rerank")
  expect(up.body.includes(`"modelArn":"arn:aws:bedrock:us-west-2::foundation-model/cohere.rerank-v3-5:0"`)).toBe(true)
  expect(up.body.includes(`"numberOfResults":1`)).toBe(true)
  expect(up.body.includes(`"sources":[{"type":"INLINE","inlineDocumentSource":{"type":"TEXT","textDocument":{"text":"a"}}},`)).toBe(true)
  expect(up.headers.get("authorization")!.includes("/us-west-2/bedrock/aws4_request")).toBe(true)
})

test("rerank ARNs follow the partition, and an ARN passes through", () => {
  expect(rerankARN("x.y", "us-gov-west-1")).toBe("arn:aws-us-gov:bedrock:us-gov-west-1::foundation-model/x.y")
  expect(rerankARN("x.y", "cn-north-1")).toBe("arn:aws-cn:bedrock:cn-north-1::foundation-model/x.y")
  expect(rerankARN("arn:aws:bedrock:us-east-1::foundation-model/z", "us-west-2")).toBe("arn:aws:bedrock:us-east-1::foundation-model/z")
  const bk: BedrockKeyConfig = { access_key: "AKIDEXAMPLE", secret_key: "s", region: "us-west-2" }
  const up = try rerankUpstream(keyed("eu-central-1/cohere.rerank-v3-5:0", bk, ""), "q", ["a"], 1)
  expect(up.url).toBe("https://bedrock-agent-runtime.eu-central-1.amazonaws.com/rerank")
  expect(up.body.includes(`"modelArn":"arn:aws:bedrock:eu-central-1::foundation-model/cohere.rerank-v3-5:0"`)).toBe(true)
})

test("a Bedrock rerank body becomes the gateway's body, and the reply goes back in Bedrock's shape", () => {
  const wire = `{"queries":[{"type":"TEXT","textQuery":{"text":"capital"}}],"sources":[{"type":"INLINE","inlineDocumentSource":{"type":"TEXT","textDocument":{"text":"Oslo"}}},{"type":"INLINE","inlineDocumentSource":{"type":"TEXT","textDocument":{"text":"Paris"}}}],"rerankingConfiguration":{"type":"BEDROCK_RERANKING_MODEL","bedrockRerankingConfiguration":{"modelConfiguration":{"modelArn":"arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0"},"numberOfResults":1}}}`
  const cohere = try rerankFromWire(wire)
  expect(cohere).toBe(`{"model":"bedrock/arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0","query":"capital","documents":["Oslo","Paris"],"top_n":1}`)
  const back = try rerankWire(`{"results":[{"index":1,"relevance_score":0.75},{"index":0,"relevance_score":0.5}],"model":"m","usage":{"search_units":1}}`)
  expect(back).toBe(`{"results":[{"index":1,"relevanceScore":0.75},{"index":0,"relevanceScore":0.5}]}`)
  const results = try rerankResults(`{"results":[{"index":0,"relevanceScore":0.1},{"index":1,"relevanceScore":0.9}]}`)
  expect(results[1]!.index).toBe(1)
  expect(results[1]!.score).toBe(0.9)
})

test("use_openai_endpoints sends OpenAI families to bedrock-runtime's OpenAI route", () => {
  const raw = `{"model":"openai/gpt-5.5","messages":[{"role":"user","content":"hi"}],"max_tokens":5,"fallbacks":["x"]}`
  const req = try JSON.parse(raw) as ChatRequest
  const body = try fields(raw)
  const bearer = keyed("openai.gpt-5.5", { region: "us-east-1", use_openai_endpoints: true }, "")
  bearer.key.value = "bk-1"
  const up = try chatRequest(bearer, req, body, false)
  expect(up.url).toBe("https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1/chat/completions")
  expect(up.headers.get("authorization")).toBe("Bearer bk-1")
  expect(up.body).toBe(`{"model":"openai.gpt-5.5","messages":[{"role":"user","content":"hi"}],"max_tokens":5}`)
  const off = try chatRequest(keyed("openai.gpt-5.5", { region: "us-east-1" }, ""), req, body, false)
  expect(off.url.endsWith("/model/openai.gpt-5.5/converse")).toBe(true)
  const oss = try chatRequest(keyed("openai.gpt-oss-120b", { region: "us-east-1", use_openai_endpoints: true }, ""), req, body, false)
  expect(oss.url.endsWith("/converse")).toBe(true)
  const claude = try chatRequest(keyed("anthropic.claude-3-haiku-20240307-v1:0", { region: "us-east-1", use_openai_endpoints: true }, ""), req, body, false)
  expect(claude.url.endsWith("/converse")).toBe(true)
})

test("an OpenAI-shaped reply from the OpenAI route reads as a chat completion", () => {
  const r = try chatResponse(`{"id":"c1","object":"chat.completion","choices":[{"index":0,"message":{"role":"assistant","content":"yo"},"finish_reason":"stop"}],"usage":{"prompt_tokens":6,"completion_tokens":2,"total_tokens":8}}`, "bedrock/openai.gpt-5.5")
  expect(r.promptTokens).toBe(6)
  expect(r.completionTokens).toBe(2)
  expect(r.body.includes(`"content":"yo"`)).toBe(true)
})
