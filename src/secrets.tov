// Secret references in config values: "vault.<path>#<field>" reads a field of a
// HashiCorp Vault KV v2 secret, "aws-sm.<secret-id>[#<field>]" reads an AWS
// Secrets Manager secret (the whole SecretString without a field). The gateway
// resolves them before it parses the config, so the rest of the code sees plain values.
import { fields, elements, find, decodeString, quote } from "./json"
import { resolveEnv, getEnv, SecretsConfig } from "./config"
import { deadline } from "./deadline"
import { Upstream, trimSlash } from "./providers/types"
import { amzDate, encodeSegment, Credentials } from "./providers/bedrock"
import { sha256, hmacSha256, toHex, utf8 } from "./crypto"

export type SecretRef = { kind: "vault", path: string, field: string } | { kind: "aws", id: string, field?: string }

// Accepts "vault.<path>#<field>" (the field is required) and "aws-sm.<id>" or
// "aws-sm.<id>#<field>". Anything else, including a plain "env.NAME", is not a reference.
export function parseRef(v: string): SecretRef | undefined {
  if (v.startsWith("vault.")) {
    const body = v.slice(6)
    const i = body.indexOf("#")
    if (i < 0) return undefined
    const path = body.slice(0, i)
    const field = body.slice(i + 1)
    if (!validPath(path) || field === "") return undefined
    return { kind: "vault", path: path, field: field }
  }
  if (v.startsWith("aws-sm.")) {
    const body = v.slice(7)
    const i = body.indexOf("#")
    if (i < 0) return body === "" ? undefined : { kind: "aws", id: body }
    const id = body.slice(0, i)
    const field = body.slice(i + 1)
    if (id === "" || field === "") return undefined
    return { kind: "aws", id: id, field: field }
  }
  return undefined
}

// A Vault path must not climb out of the mount: no empty, "." or ".." segments.
function validPath(path: string): bool {
  if (path === "") return false
  for (const seg of path.split("/")) {
    if (seg === "" || seg === "." || seg === "..") return false
  }
  return true
}

// ---- Vault ----

export function vaultRequest(cfg: SecretsConfig, path: string): Upstream throws Error {
  const v = cfg.vault
  if (v === undefined) throw new Error("vault is not configured")
  const mount = v.mount ?? "secret"
  const segs = path.split("/").map((s) => encodeSegment(s)).join("/")
  const h: Map<string, string> = new Map()
  const token = v.token === undefined ? "" : resolveEnv(v.token)
  if (token !== "") h.set("X-Vault-Token", token)
  const ns = v.namespace ?? ""
  if (ns !== "") h.set("X-Vault-Namespace", ns)
  return { url: `${trimSlash(v.address)}/v1/${trimSlash(mount)}/data/${segs}`, headers: h, body: "" }
}

// The value of data.data.<field> in a Vault KV v2 read response.
export function vaultField(body: string, field: string): string throws SyntaxError {
  const outer = try fields(body)
  const dataRaw = find(outer, "data")
  if (dataRaw === undefined) throw new SyntaxError("vault response has no data")
  const inner = try fields(dataRaw)
  const dataRaw2 = find(inner, "data")
  if (dataRaw2 === undefined) throw new SyntaxError("vault response has no secret data")
  const secret = try fields(dataRaw2)
  return try scalarOf(find(secret, field), `vault field ${field}`)
}

// ---- AWS Secrets Manager ----

export function awsRequest(cfg: SecretsConfig, secretId: string): Upstream throws Error {
  return try awsRequestAt(cfg, secretId, Date.now())
}

function awsRequestAt(cfg: SecretsConfig, secretId: string, nowMs: f64): Upstream throws Error {
  const a = cfg.aws
  if (a === undefined) throw new Error("aws secrets manager is not configured")
  const creds = try awsCredentials(a)
  const region = resolveEnv(a.region)
  const host = `secretsmanager.${region}.amazonaws.com`
  const body = `{"SecretId":${quote(secretId)}}`
  const h = sigv4(
    { accessKey: creds.accessKey, secretKey: creds.secretKey, sessionToken: creds.sessionToken, region: region },
    "secretsmanager", host, body, nowMs,
  )
  return { url: `https://${host}/`, headers: h, body: body }
}

// Config keys first (env.NAME allowed), then the standard AWS variables.
function awsCredentials(a: { region: string, access_key?: string, secret_key?: string, session_token?: string }): { accessKey: string, secretKey: string, sessionToken: string | undefined } {
  const accessKey = a.access_key === undefined ? (getEnv("AWS_ACCESS_KEY_ID") ?? "") : resolveEnv(a.access_key)
  const secretKey = a.secret_key === undefined ? (getEnv("AWS_SECRET_ACCESS_KEY") ?? "") : resolveEnv(a.secret_key)
  const tok = a.session_token === undefined ? (getEnv("AWS_SESSION_TOKEN") ?? "") : resolveEnv(a.session_token)
  if (accessKey === "" || secretKey === "") throw new Error("aws credentials are not set")
  return { accessKey: accessKey, secretKey: secretKey, sessionToken: tok === "" ? undefined : tok }
}

// The whole SecretString, or the field of it when one is given.
export function awsField(body: string, field?: string): string throws SyntaxError {
  const top = try fields(body)
  const raw = find(top, "SecretString")
  if (raw === undefined) throw new SyntaxError("secret has no SecretString")
  const secret = try decodeString(raw)
  if (field === undefined) return secret
  const inner = try fields(secret)
  return try scalarOf(find(inner, field), `secret field ${field}`)
}

// A string's decoded value; numbers and bools as their JSON text.
function scalarOf(raw: string | undefined, what: string): string throws SyntaxError {
  if (raw === undefined) throw new SyntaxError(`no ${what}`)
  if (raw.startsWith("\"")) return try decodeString(raw)
  if (raw.startsWith("{") || raw.startsWith("[") || raw === "null") throw new SyntaxError(`${what} is not a string, number or bool`)
  return raw
}

// SigV4 for a POST with a JSON body. bedrock's sign hard-codes its content-type,
// and Secrets Manager needs its own, plus the x-amz-target header signed.
function sigv4(creds: Credentials, service: string, host: string, body: string, nowMs: f64): Map<string, string> {
  const date = amzDate(nowMs)
  const day = date.slice(0, 8)
  const hs: string[][] = [["content-type", "application/x-amz-json-1.1"], ["host", host], ["x-amz-date", date]]
  const token = creds.sessionToken
  if (token !== undefined && token !== "") hs.push(["x-amz-security-token", token])
  hs.push(["x-amz-target", "secretsmanager.GetSecretValue"])
  // canonical headers are sorted by name
  hs.sort((x, y) => (x[0]! < y[0]! ? -1 : x[0]! > y[0]! ? 1 : 0))
  const canonicalHeaders = hs.map((p) => `${p[0]!}:${p[1]!}\n`).join("")
  const signed = hs.map((p) => p[0]!).join(";")
  const payloadHash = toHex(sha256(utf8(body)))
  const canonical = `POST\n/\n\n${canonicalHeaders}\n${signed}\n${payloadHash}`
  const scope = `${day}/${creds.region}/${service}/aws4_request`
  const toSign = `AWS4-HMAC-SHA256\n${date}\n${scope}\n${toHex(sha256(utf8(canonical)))}`
  const kDate = hmacSha256(utf8("AWS4" + creds.secretKey), utf8(day))
  const kRegion = hmacSha256(kDate, utf8(creds.region))
  const kService = hmacSha256(kRegion, utf8(service))
  const kSigning = hmacSha256(kService, utf8("aws4_request"))
  const signature = toHex(hmacSha256(kSigning, utf8(toSign)))
  const out: Map<string, string> = new Map()
  for (const p of hs) {
    if (p[0] !== "host") out.set(p[0]!, p[1]!)
  }
  out.set("authorization", `AWS4-HMAC-SHA256 Credential=${creds.accessKey}/${scope}, SignedHeaders=${signed}, Signature=${signature}`)
  return out
}

// ---- config scanning ----

// Every distinct reference string among the config's values (not keys).
export function collectRefs(configJson: string): string[] throws SyntaxError {
  let found: string[] = []
  try walkRefs(configJson, &found)
  return found
}

function walkRefs(raw: string, inout out: string[]): void throws SyntaxError {
  const t = raw.trim()
  if (t.startsWith("\"")) {
    const s = try decodeString(t)
    if (parseRef(s) !== undefined && !out.includes(s)) out.push(s)
    return
  }
  if (t.startsWith("{")) {
    for (const f of try fields(t)) {
      try walkRefs(f.raw, &out)
    }
    return
  }
  if (t.startsWith("[")) {
    for (const el of try elements(t)) {
      try walkRefs(el, &out)
    }
  }
}

// Replaces each string value that equals a key of `values` with its resolved
// value. Everything else, including whitespace and key order, is copied as is.
export function substitute(configJson: string, values: Map<string, string>): string throws SyntaxError {
  if (values.size === 0) return configJson
  const bytes = utf8(configJson)
  const out: string[] = []
  let copied = 0
  let i = 0
  while (i < bytes.length) {
    if (int(bytes[i]!) !== 34) {
      i += 1
      continue
    }
    const start = i
    let j = i + 1
    while (j < bytes.length && int(bytes[j]!) !== 34) {
      // skip the byte after a backslash so an escaped quote doesn't end the string
      if (int(bytes[j]!) === 92) j += 1
      j += 1
    }
    if (j >= bytes.length) throw new SyntaxError("unterminated string in config")
    const end = j + 1
    i = end
    // an object key is followed by ":"; keys are never references
    let k = end
    while (k < bytes.length && isSpace(int(bytes[k]!))) k += 1
    if (k < bytes.length && int(bytes[k]!) === 58) continue
    const decoded = try decodeString(configJson.slice(start, end))
    const v = values.get(decoded)
    if (v !== undefined) {
      out.push(configJson.slice(copied, start))
      out.push(quote(v))
      copied = end
    }
  }
  out.push(configJson.slice(copied))
  return out.join("")
}

function isSpace(b: int): bool {
  return b === 32 || b === 9 || b === 10 || b === 13
}

// ---- resolution ----

const FETCH_TIMEOUT_MS = 10000
// Resolved values are reused for five minutes, so reloads don't refetch them.
const TTL_MS = 300000

type CacheEntry = { value: string, at: f64 }
const cache: Map<string, CacheEntry> = new Map()

function cacheFresh(at: f64, now: f64): bool {
  return now - at < TTL_MS
}

function cacheGet(key: string, now: f64): string | undefined {
  const e = cache.get(key)
  if (e === undefined) return undefined
  if (!cacheFresh(e.at, now)) {
    cache.delete(key)
    return undefined
  }
  return e.value
}

function cachePut(key: string, value: string, now: f64): void {
  cache.set(key, { value: value, at: now })
}

type Outcome = { ref: string, ok: bool, value: string, error: string }

function failed(ref: string, error: string): Outcome {
  return { ref: ref, ok: false, value: "", error: error }
}

// Fetches every distinct reference once, substitutes the values and reports the
// failures. A reference that fails stays as written in the returned JSON.
export async function resolveAll(configJson: string, cfg: SecretsConfig): Promise<{ json: string, errors: string[] }> {
  let refs: string[] = []
  try {
    refs = collectRefs(configJson)
  } catch (e) {
    return { json: configJson, errors: [`config is not valid JSON: ${e.message}`] }
  }
  if (refs.length === 0) return { json: configJson, errors: [] }
  const outcomes = await Promise.all(refs.map((r) => fetchOne(r, cfg)))
  const values: Map<string, string> = new Map()
  const errors: string[] = []
  for (const o of outcomes) {
    if (o.ok) values.set(o.ref, o.value)
    else errors.push(`${o.ref}: ${o.error}`)
  }
  try {
    return { json: substitute(configJson, values), errors: errors }
  } catch (e) {
    return { json: configJson, errors: errors.concat([`config is not valid JSON: ${e.message}`]) }
  }
}

async function fetchOne(text: string, cfg: SecretsConfig): Promise<Outcome> {
  const ref = parseRef(text)
  if (ref === undefined) return failed(text, "not a secret reference")
  try {
    const up = requestFor(ref, cfg)
    const ns = cfg.vault === undefined ? "" : (cfg.vault.namespace ?? "")
    const key = `${up.url}\n${up.body}\n${ns}`
    const hit = cacheGet(key, Date.now())
    if (hit !== undefined) return { ref: text, ok: true, value: hit, error: "" }
    const hs: Record<string, string> = up.headers
    const dl = deadline(FETCH_TIMEOUT_MS)
    const res = up.body === "" ? await fetch(up.url, { method: "GET", headers: hs, signal: dl.controller.signal }) : await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal })
    const resBody = try await res.text()
    dl.finish()
    // the status is reported, never the body: it can echo secret material
    if (!res.ok) return failed(text, `HTTP ${res.status}`)
    const value = extract(ref, resBody)
    cachePut(key, value, Date.now())
    return { ref: text, ok: true, value: value, error: "" }
  } catch (e) {
    return failed(text, e.message)
  }
}

function requestFor(ref: SecretRef, cfg: SecretsConfig): Upstream throws Error {
  if (ref.kind === "vault") return try vaultRequest(cfg, ref.path)
  return try awsRequest(cfg, ref.id)
}

function extract(ref: SecretRef, body: string): string throws SyntaxError {
  if (ref.kind === "vault") return try vaultField(body, ref.field)
  return try awsField(body, ref.field)
}

test("parseRef reads vault and aws references", () => {
  const v = parseRef("vault.app/db#password")!
  expect(v.kind).toBe("vault")
  if (v.kind === "vault") {
    expect(v.path).toBe("app/db")
    expect(v.field).toBe("password")
  }
  const a = parseRef("aws-sm.prod/app/db#password")!
  expect(a.kind).toBe("aws")
  if (a.kind === "aws") {
    expect(a.id).toBe("prod/app/db")
    expect(a.field).toBe("password")
  }
  const w = parseRef("aws-sm.prod/app/db")!
  expect(w.kind).toBe("aws")
  if (w.kind === "aws") {
    expect(w.id).toBe("prod/app/db")
    expect(w.field === undefined).toBe(true)
  }
  expect(parseRef("vault.app/db") === undefined).toBe(true)
  expect(parseRef("vault.app/db#") === undefined).toBe(true)
  expect(parseRef("vault.#password") === undefined).toBe(true)
  expect(parseRef("vault.app/../sys#x") === undefined).toBe(true)
  expect(parseRef("vault.app//db#x") === undefined).toBe(true)
  expect(parseRef("aws-sm.#x") === undefined).toBe(true)
  expect(parseRef("aws-sm.") === undefined).toBe(true)
  expect(parseRef("aws-sm.id#") === undefined).toBe(true)
  expect(parseRef("env.API_KEY") === undefined).toBe(true)
  expect(parseRef("https://vault.example.com") === undefined).toBe(true)
})

test("vault request url, headers and namespace", () => {
  const cfg: SecretsConfig = { vault: { address: "https://vault.example.com:8200/", token: "s.tok" } }
  const up = try vaultRequest(cfg, "app/db")
  expect(up.url).toBe("https://vault.example.com:8200/v1/secret/data/app/db")
  expect(up.body).toBe("")
  expect(up.headers.get("X-Vault-Token")!).toBe("s.tok")
  expect(up.headers.has("X-Vault-Namespace")).toBe(false)

  const ns: SecretsConfig = { vault: { address: "https://v.internal", token: "t", namespace: "team/a", mount: "kv" } }
  const up2 = try vaultRequest(ns, "svc/key")
  expect(up2.url).toBe("https://v.internal/v1/kv/data/svc/key")
  expect(up2.headers.get("X-Vault-Namespace")!).toBe("team/a")
  expect(up2.headers.get("X-Vault-Token")!).toBe("t")
})

test("vault field values", () => {
  const body = `{"request_id":"r1","data":{"data":{"password":"p@ss\\"w","port":5432,"tls":true,"opt":null,"nested":{"a":1}},"metadata":{"version":3}}}`
  expect(try vaultField(body, "password")).toBe(`p@ss"w`)
  expect(try vaultField(body, "port")).toBe("5432")
  expect(try vaultField(body, "tls")).toBe("true")
  let threw = false
  try {
    vaultField(body, "missing")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    vaultField(body, "opt")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    vaultField(body, "nested")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("aws request headers and sigv4 signature", () => {
  // The reference signatures were computed with Python's hmac/hashlib for this input.
  const cfg: SecretsConfig = { aws: { region: "us-east-1", access_key: "AKIDEXAMPLE", secret_key: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY" } }
  const up = try awsRequestAt(cfg, "prod/app/db", 1440938160000.0)
  expect(up.url).toBe("https://secretsmanager.us-east-1.amazonaws.com/")
  expect(up.body).toBe(`{"SecretId":"prod/app/db"}`)
  expect(up.headers.get("x-amz-target")!).toBe("secretsmanager.GetSecretValue")
  expect(up.headers.get("content-type")!).toBe("application/x-amz-json-1.1")
  expect(up.headers.get("x-amz-date")!).toBe("20150830T123600Z")
  expect(up.headers.has("host")).toBe(false)
  expect(up.headers.get("authorization")!).toBe("AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/secretsmanager/aws4_request, SignedHeaders=content-type;host;x-amz-date;x-amz-target, Signature=cd62a923040ad20fa45467945e8d8a4d774372932a1cd3b167ff6ebf18dc762d")

  const tok: SecretsConfig = { aws: { region: "us-east-1", access_key: "AKIDEXAMPLE", secret_key: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY", session_token: "FwoGZXIvYXdzEXAMPLE" } }
  const up2 = try awsRequestAt(tok, "prod/app/db", 1440938160000.0)
  expect(up2.headers.get("x-amz-security-token")!).toBe("FwoGZXIvYXdzEXAMPLE")
  expect(up2.headers.get("authorization")!).toBe("AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/us-east-1/secretsmanager/aws4_request, SignedHeaders=content-type;host;x-amz-date;x-amz-security-token;x-amz-target, Signature=e7e285747f3928e762a3aed61a8311279d64166cb6a180abf399ec4304355419")
})

test("aws field values", () => {
  const body = `{"ARN":"arn:aws:secretsmanager:us-east-1:1:secret:x","Name":"x","SecretString":"{\\"password\\":\\"hunter2\\",\\"port\\":5432}"}`
  expect(try awsField(body, "password")).toBe("hunter2")
  expect(try awsField(body, "port")).toBe("5432")
  expect(try awsField(`{"SecretString":"plain-value"}`)).toBe("plain-value")
  expect(try awsField(`{"SecretString":"plain-value"}`, undefined)).toBe("plain-value")
  let threw = false
  try {
    awsField(`{"Name":"binary-only"}`)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    awsField(body, "absent")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("collectRefs walks nested objects and arrays", () => {
  const cfg = `{
    "providers": {"openai": {"keys": [{"value": "vault.ai/openai#key"}, {"value": "env.OPENAI_KEY"}]}},
    "governance": {"auth_config": {"password": "aws-sm.gw/auth#pw", "token": "aws-sm.gw/auth#pw"}},
    "plugins": [["vault.x/y#z", {"deep": {"n": 1, "b": true, "s": "plain"}}]],
    "vault.not/a#value-used-as-key": "ok"
  }`
  const refs = try collectRefs(cfg)
  expect(refs.length).toBe(3)
  expect(refs.includes("vault.ai/openai#key")).toBe(true)
  expect(refs.includes("aws-sm.gw/auth#pw")).toBe(true)
  expect(refs.includes("vault.x/y#z")).toBe(true)
  expect(try collectRefs(`{"a": "vault.noexpand"}`).length).toBe(0)
  expect(try collectRefs(`{"k": "vault.a/b#c"}`)[0]!).toBe("vault.a/b#c")
})

test("substitute keeps every other byte", () => {
  const cfg = `{ "a" : "vault.s/x#pw" ,\n  "list": ["aws-sm.id", "keep", 3],\n  "vault.s/x#pw": "key-not-replaced",\n  "esc": "say \\"hi\\"", "u": "héllo" }`
  const values: Map<string, string> = new Map()
  values.set("vault.s/x#pw", `p"w\\n`)
  values.set("aws-sm.id", "secret-value")
  const out = try substitute(cfg, values)
  expect(out).toBe(`{ "a" : "p\\"w\\\\n" ,\n  "list": ["secret-value", "keep", 3],\n  "vault.s/x#pw": "key-not-replaced",\n  "esc": "say \\"hi\\"", "u": "héllo" }`)
  expect(try substitute(cfg, new Map())).toBe(cfg)
})

test("cache entries expire after five minutes", () => {
  cachePut("k-test", "v1", 1000.0)
  expect(cacheGet("k-test", 1000.0 + 299999.0)).toBe("v1")
  expect(cacheGet("k-test", 1000.0 + 300000.0) === undefined).toBe(true)
  expect(cacheFresh(0.0, 299999.0)).toBe(true)
  expect(cacheFresh(0.0, 300000.0)).toBe(false)
})
