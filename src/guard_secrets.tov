// The same providers with the prefix or length broken, and ordinary words.
const NEGATIVE: string[][] = [
  ["aws-access-token", "AKIA" + "short"],
  ["github-pat", "ghp_" + "abcdefghij"],
  ["gitlab-pat", "glpat-" + "short"],
  ["slack-bot-token", "xoxb-" + "12"],
  ["stripe-access-token", "sk_" + "test_" + "x"],
  ["openai-api-key", "sk-" + "abc"],
  ["anthropic-api-key", "sk-ant-" + "api03-" + "short"],
  ["gcp-api-key", "AIza" + "short"],
  ["sendgrid-api-token", "SG." + "short"],
  ["twilio-api-key", "SK" + "xyz"],
  ["npm-access-token", "npm_" + "short"],
  ["pypi-upload-token", "pypi-" + "AgEIcHlwaS5vcmc" + "short"],
  ["huggingface-access-token", "hf_" + "short"],
  ["digitalocean-pat", "dop_v1_" + "abc"],
  ["shopify-access-token", "shpat_" + "xyz"],
  ["postman-api-token", "PMAK-" + "short"],
  ["linear-api-key", "lin_api_" + "short"],
  ["perplexity-api-key", "pplx-" + "short"],
  ["sentry-user-token", "sntryu_" + "abc"],
  ["doppler-api-token", "dp.pt." + "short"],
  ["vault-service-token", "hvs." + "short"],
  ["notion-api-token", "ntn_" + "short"],
  ["databricks-api-token", "dapi" + "xyz"],
  ["grafana-cloud-api-token", "glc_" + "short"],
  ["hashicorp-tf-api-token", "abcdefghijklmn" + ".terraform."],
]

test("common providers: a positive fixture is found by its rule", () => {
  const rules = try compileSecrets([], "block")
  const missed: string[] = []
  for (const c of POSITIVE) {
    if (!hits(c[0]!, c[1]!, rules)) missed.push(c[0]!)
  }
  expect(missed).toEqual([])
})

test("common providers: a negative fixture is not found by its rule", () => {
  const rules = try compileSecrets([], "block")
  for (const c of NEGATIVE) {
    expect(hits(c[0]!, c[1]!, rules)).toBe(false)
  }
})

test("ordinary prose is not a secret", () => {
  const rules = try compileSecrets([], "block")
  expect(applyRegex("ghp_short and sk-live and the glpat- prefix", rules).findings.length).toBe(0)
  expect(applyRegex("Please review the Stripe docs and the pull request", rules).findings.length).toBe(0)
})

test("ignored keywords suppress matches that contain them", () => {
  const rules = try compileSecrets(["example"], "block")
  const fake = "ghp_example0123456789abcdefghijklmnopqrs"
  expect(applyRegex(fake, rules).findings.length).toBe(0)
  expect(applyRegex("ghp_qmzkpaxrtnbcwdhsyuvgjfleio0123456789", rules).blocked).toBe(true)
})

// A high-entropy value under a generic key name. It is built from parts.
const GENERIC_SECRET = "k3Jd9xQ2" + "mL7vP0sWz8Rt"

test("generic-api-key: a plain word after a password or auth key is not a finding", () => {
  const rules = try compileSecrets([], "block")
  // below the entropy floor (3.5) and matched by the rule's allowlist of plain words
  expect(hits("generic-api-key", "password = correcthorsebatterystaple", rules)).toBe(false)
  expect(hits("generic-api-key", "auth_header = request_headers_value", rules)).toBe(false)
  expect(hits("generic-api-key", "secret = \"correcthorsebatterystaple\"", rules)).toBe(false)
})

test("generic-api-key: a high-entropy value is found, and only the value is redacted", () => {
  const rules = try compileSecrets([], "redact")
  expect(hits("generic-api-key", "api_key = \"" + GENERIC_SECRET + "\"", rules)).toBe(true)
  const r = applyRegex("api_key = \"" + GENERIC_SECRET + "\" done", rules)
  expect(r.body).toBe("api_key = \"[REDACTED:GENERIC-API-KEY]\" done")
  expect(r.findings[0]!.text).toBe(GENERIC_SECRET)
})

test("a token followed by more token characters is not cut down to a prefix", () => {
  const rules = try compileSecrets([], "block")
  expect(hits("gcp-api-key", "AIza" + "SyA1234567890abcdefghijklmnopqrstuv", rules)).toBe(true)
  // one more character: the boundary after the secret fails, as in gitleaks
  expect(hits("gcp-api-key", "AIza" + "SyA1234567890abcdefghijklmnopqrstuv" + "Q", rules)).toBe(false)
})

test("the global stopword and the AWS EXAMPLE allowlist drop their matches", () => {
  const rules = try compileSecrets([], "block")
  // the global stopword "abcdefghijklmnopqrstuvwxyz" (in any case) allows the secret
  expect(hits("github-pat", "ghp_" + "abcdefghijklmnopqrstuvwxyz0123456789", rules)).toBe(false)
  expect(hits("aws-access-token", "AKIA" + "IOSFODNN7EXAMPLE", rules)).toBe(false)
})

// Fixtures for the allow comment, built from parts like the others above.
const ALLOW_TOKEN = "ghp_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789"
const ALLOW_OTHER = "npm_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789"

test("gitleaks:allow: a line with the comment produces no finding", () => {
  const rules = try compileSecrets([], "block")
  const r = applyRegex("const a = \"" + ALLOW_TOKEN + "\" // gitleaks:allow", rules)
  expect(r.findings.length).toBe(0)
  expect(r.blocked).toBe(false)
})

test("gitleaks:allow: the neighbouring line is still found", () => {
  const rules = try compileSecrets([], "redact")
  const text = "const a = \"" + ALLOW_TOKEN + "\" // gitleaks:allow\nconst b = \"" + ALLOW_OTHER + "\""
  const r = applyRegex(text, rules)
  expect(r.findings.length).toBe(1)
  expect(r.findings[0]!.text).toBe(ALLOW_OTHER)
  expect(r.body).toBe("const a = \"" + ALLOW_TOKEN + "\" // gitleaks:allow\nconst b = \"[REDACTED:NPM-ACCESS-TOKEN]\"")
})

test("gitleaks:allow: the marker inside a string on the same line still allows", () => {
  // as Gitleaks checks the whole line for the text, a marker in a string counts
  const rules = try compileSecrets([], "block")
  expect(applyRegex("log(\"gitleaks:allow\", \"" + ALLOW_TOKEN + "\")", rules).findings.length).toBe(0)
  // on another line it does not reach the secret
  expect(applyRegex("note = \"gitleaks:allow\"\nconst t = \"" + ALLOW_TOKEN + "\"", rules).findings.length).toBe(1)
})

test("gitleaks:allow: the marker is case-sensitive and matched as text, as Gitleaks does", () => {
  const rules = try compileSecrets([], "block")
  expect(applyRegex("const t = \"" + ALLOW_TOKEN + "\" // Gitleaks:allow", rules).findings.length).toBe(1)
  expect(applyRegex("const t = \"" + ALLOW_TOKEN + "\" // gitleaks:allowed", rules).findings.length).toBe(0)
})

// Findings before and after the engine changes, on a fixture corpus. Each line is
// blocked, the body and the findings with their byte spans.
const CORPUS: string[] = [
  "use ghp_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789 now",
  "aws_access_key_id = AKIA" + "Q7MZKP2XRT4NBC3W\nregion = eu-west-1",
  "config: api_key = \"" + "k3Jd9xQ2" + "mL7vP0sWz8Rt\" end",
  "hook https://hooks." + "slack.com/services/" + "T0123ABCD/B0123ABCD/" + "abcdefghijklmnopqrstuvwx",
  "first ghp_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789\nsecond line with nothing",
  "two " + "npm_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789 and " + "glpat-" + "abcdefghij0123456789",
  "password = correcthorsebatterystaple and token = plainwords",
  "ticket PROJ-12 and the usual prose with no keys at all",
  "gcp AIza" + "SyA1234567890abcdefghijklmnopqrstuv trailing",
  "x" + "\n\n" + "ghp_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789" + "\n",
]

const CORPUS_FINDINGS: string[] = [
  "false | use [REDACTED:GITHUB-PAT] now | GITHUB-PAT=ghp_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789@4-44",
  "false | aws_access_key_id = [REDACTED:AWS-ACCESS-TOKEN]\nregion = eu-west-1 | AWS-ACCESS-TOKEN=AKIA" + "Q7MZKP2XRT4NBC3W@20-40",
  "false | config: api_key = \"[REDACTED:GENERIC-API-KEY]\" end | GENERIC-API-KEY=k3Jd9xQ2mL7vP0sWz8Rt@19-39",
  "false | hook [REDACTED:SLACK-WEBHOOK-URL] | SLACK-WEBHOOK-URL=https://hooks." + "slack.com/services/" + "T0123ABCD/B0123ABCD/" + "abcdefghijklmnopqrstuvwx@5-82",
  "false | first [REDACTED:GITHUB-PAT]\nsecond line with nothing | GITHUB-PAT=ghp_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789@6-46",
  "false | two [REDACTED:NPM-ACCESS-TOKEN] and [REDACTED:GITLAB-PAT] | GITLAB-PAT=glpat-abcdefghij0123456789@49-75 ; NPM-ACCESS-TOKEN=npm_qmzkpaxrtnbcwdhsyuvgjfleio0123456789@4-44",
  "false | password = correcthorsebatterystaple and token = plainwords | ",
  "false | ticket PROJ-12 and the usual prose with no keys at all | ",
  "false | gcp [REDACTED:GCP-API-KEY] trailing | GCP-API-KEY=AIzaSyA1234567890abcdefghijklmnopqrstuv@4-43",
  "false | x\n\n[REDACTED:GITHUB-PAT]\n | GITHUB-PAT=ghp_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789@3-43",
]

test("fixture corpus: the findings are the same as before the engine changes", () => {
  const rules = try compileSecrets([], "redact")
  const out: string[] = []
  for (const t of CORPUS) {
    const r = applyRegex(t, rules)
    const parts: string[] = []
    for (const f of r.findings) parts.push(f.kind + "=" + f.text + "@" + f.start + "-" + f.end)
    out.push(r.blocked + " | " + r.body + " | " + parts.join(" ; "))
  }
  expect(out).toEqual(CORPUS_FINDINGS)
})

test("a secret at any offset around the window seams is found once, whole", () => {
  const rules = try compileSecrets([], "block")
  const tok = "ghp_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789"
  for (let off = 0; off < 1200; off += 29) {
    const text = "x".repeat(off) + " " + tok + " tail"
    const r = applyRegex(text, rules)
    expect(r.findings.length).toBe(1)
    expect(r.findings[0]!.text).toBe(tok)
    expect(r.findings[0]!.start).toBe(off + 1)
  }
})

test("the generic rule's match allowlist runs from its branch literals' starts only, with the answers of a full search", () => {
  const rules = try compileSecrets([], "block")
  const g = rules.find((r) => r.kind === "GENERIC-API-KEY")!
  const al = g.allow.find((a) => a.target === "match")!
  // the alternation has too many branches for the narrow literal set, so the automaton stands in for it
  expect(al.regexes[0]!.literals().length).toBe(0)
  expect(al.matchers[0] !== undefined).toBe(true)
  const pieces = ["accessibility", "random_access", "api_version", "capital", "author", "credentialsId", "public_key", "key_alias", "keyVaultName", "Monkey", "MONKEY", "monkey", "secret_name", "csrf-token", "api_endpoint", "token_file", "issuerkeyhash", "turkey", "KEY=\\nVALUE=\\n", "key=\\nother=\\z"]
  const fills = ["", "x", "my", "API_KEY = \"", "token: ", "é", "\"abc123", " = 'Zx9QwLm3Kp7RtVb'"]
  let tried = 0
  for (const p of pieces) {
    for (const a of fills) {
      for (const b of fills) {
        const target = a + p + b
        let full = false
        for (const re of al.regexes) {
          if (re.test(target)) full = true
        }
        expect(allowRegexMatches(al, target)).toBe(full)
        tried += 1
      }
    }
  }
  // targets with no branch literal at all
  for (const t of ["password = \"Zx9QwLm3Kp7RtVb\"", "secret_1 = \"Zx9Qw1Lm3Kp7RtVb\"", "", "é"]) {
    let full = false
    for (const re of al.regexes) {
      if (re.test(t)) full = true
    }
    expect(allowRegexMatches(al, t)).toBe(full)
  }
  expect(tried).toBe(pieces.length * fills.length * fills.length)
})
