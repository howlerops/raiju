// Secrets detection with the upstream Gitleaks rule set (Bifrost's secrets provider).
// Bifrost embeds Gitleaks v8.30.1. The rules are generated into guard_gitleaks_data.tov
// by scripts/gen_gitleaks.py, which skips rules the RE2 engine cannot compile. Each rule
// runs as a regex guardrail rule (regex.tov) with its keywords as a prefilter.
// Not applied: Gitleaks' entropy filter, per-rule and global allowlists, and the
// secret group. A finding is the whole regex match. The trailing boundary group of
// the upstream patterns is dropped (see unbounded()), so a match may be a prefix of
// a longer token.

import { RegexRule, CompiledRule, compileRules, applyRegex } from "./guard_regex"
import { GITLEAKS_DATA } from "./guard_gitleaks_data"

// entropy and secretGroup are kept from the upstream rule but not used by the engine.
export type SecretRule = { id: string, description: string, pattern: string, entropy?: number, secretGroup: int, keywords: string[] }

// Parses the generated table: one rule per line, tab-separated (see the header of
// guard_gitleaks_data.tov). Called once per compiled config, not at match time.
export function gitleaksRules(): SecretRule[] throws SyntaxError {
  const out: SecretRule[] = []
  for (const line of GITLEAKS_DATA.split("\n")) {
    if (line.byteLength === 0) continue
    const f = line.split("\t")
    // generic-api-key relies on gitleaks' entropy filter on the secret group, which the
    // engine can't apply yet (whole matches only); without it, plain assignments match
    if (f[0]! === "generic-api-key") continue
    const keywords = try JSON.parse(f[3]!) as string[]
    const ent = parseFloat(f[1]!)
    const sg = parseInt(f[2]!)
    out.push({
      id: f[0]!,
      description: f[4]!,
      pattern: f[5]!,
      entropy: ent,
      secretGroup: sg === undefined ? 0 : sg,
      keywords: keywords,
    })
  }
  return out
}

// Gitleaks ends most patterns with a group that needs a boundary after the secret. The
// engine reports whole matches and has no lookahead, so that group would also take the
// character after the secret into a redaction. It is dropped here; a secret followed by
// more token characters is still found, as a prefix.
const BOUNDARY_END = "(?:[\\x60'\"\\s;]|\\\\[nr]|$|\\b)"
const BOUNDARY_NEXT = "(?:[\\x60'\"\\s;]|\\\\[nr]|$)"

function unbounded(p: string): string {
  return p.split(BOUNDARY_END).join("").split(BOUNDARY_NEXT).join("")
}

// Rules as regex guardrail rules. Each finding is labelled with the rule id.
export function secretRules(ignoredKeywords: string[], action: string): RegexRule[] throws SyntaxError {
  const out: RegexRule[] = []
  for (const g of try gitleaksRules()) {
    out.push({ pattern: unbounded(g.pattern), description: g.id, entity_type: g.id, action: action, skip_containing: ignoredKeywords, keywords: g.keywords })
  }
  return out
}

// Compiles the whole set once; callers keep the result for the life of the config.
export function compileSecrets(ignoredKeywords: string[], action: string): CompiledRule[] throws SyntaxError {
  return try compileRules(try secretRules(ignoredKeywords, action))
}

// ---- tests ----

// True when the rule with this id (its kind is the id in upper case) finds text.
function hits(id: string, text: string, rules: CompiledRule[]): bool {
  for (const f of applyRegex(text, rules).findings) {
    if (f.kind === id.toUpperCase()) return true
  }
  return false
}

test("every generated rule compiles", () => {
  const table = try gitleaksRules()
  expect(table.length > 200).toBe(true)
  for (const g of table) {
    expect(g.pattern.byteLength > 0).toBe(true)
  }
  const rules = try compileSecrets([], "block")
  expect(rules.length).toBe(table.length)
})

test("known credential shapes are found", () => {
  const rules = try compileSecrets([], "redact")
  const r = applyRegex("use ghp_abcdefghijklmnopqrstuvwxyz0123456789 and glpat-abcdefghij0123456789 now", rules)
  expect(r.body).toBe("use [REDACTED:GITHUB-PAT] and [REDACTED:GITLAB-PAT] now")
  expect(applyRegex("key AIzaSyA1234567890abcdefghijklmnopqrstuv", rules).body).toBe("key [REDACTED:GCP-API-KEY]")
  // built from parts so the fixture isn't itself a webhook-shaped literal in the repository
  const hook = "hook https://hooks." + "slack.com/services/" + "T0123ABCD/B0123ABCD/" + "abcdefghijklmnopqrstuvwx"
  expect(applyRegex(hook, rules).blocked).toBe(false)
  expect(applyRegex(hook, rules).findings[0]!.kind).toBe("SLACK-WEBHOOK-URL")
})

test("redaction leaves the character after a secret", () => {
  const rules = try compileSecrets([], "redact")
  expect(applyRegex("key " + "npm_" + "abcdefghijklmnopqrstuvwxyz0123456789" + " next", rules).body).toBe("key [REDACTED:NPM-ACCESS-TOKEN] next")
  expect(applyRegex("key " + "npm_" + "abcdefghijklmnopqrstuvwxyz0123456789" + "\nnext", rules).body).toBe("key [REDACTED:NPM-ACCESS-TOKEN]\nnext")
})

// Positive and negative fixtures for 24 providers. Each is assembled from parts so the
// repository holds no string that looks like a live credential.
const POSITIVE: string[][] = [
  ["aws-access-token", "AKIA" + "IOSFODNN7EXAMPLE"],
  ["github-pat", "ghp_" + "abcdefghijklmnopqrstuvwxyz0123456789"],
  ["gitlab-pat", "glpat-" + "abcdefghij0123456789"],
  ["slack-bot-token", "xoxb-" + "1234567890-" + "1234567890123-" + "abcdefABCDEF"],
  ["stripe-access-token", "sk_" + "test_" + "abcdef0123456789ABCDEF"],
  ["openai-api-key", "sk-" + "abcdefghij0123456789" + "T3BlbkFJ" + "abcdefghij0123456789"],
  ["anthropic-api-key", "sk-ant-" + "api03-" + "abcdefghij".repeat(9) + "abc" + "AA"],
  ["gcp-api-key", "AIza" + "SyA1234567890abcdefghijklmnopqrstuv"],
  ["sendgrid-api-token", "SG." + "a".repeat(22) + "." + "b".repeat(43)],
  ["twilio-api-key", "SK" + "0123456789abcdef0123456789abcdef"],
  ["npm-access-token", "npm_" + "abcdefghijklmnopqrstuvwxyz0123456789"],
  ["pypi-upload-token", "pypi-" + "AgEIcHlwaS5vcmc" + "x".repeat(50)],
  ["huggingface-access-token", "hf_" + "abcdefghijklmnopqrstuvwxyzABCDEFGH"],
  ["digitalocean-pat", "dop_v1_" + "0123456789abcdef".repeat(4)],
  ["shopify-access-token", "shpat_" + "0123456789abcdef0123456789abcdef"],
  ["postman-api-token", "PMAK-" + "0123456789abcdef01234567" + "-" + "0123456789abcdef0123456789abcdef01"],
  ["linear-api-key", "lin_api_" + "abcdefghijklmnopqrstuvwxyz0123456789ABCD"],
  ["perplexity-api-key", "pplx-" + "abcdefghijklmnopqrstuvwxyz" + "ABCDEFGHIJKLMNOPQRSTUV"],
  ["sentry-user-token", "sntryu_" + "0123456789abcdef".repeat(4)],
  ["doppler-api-token", "dp.pt." + "abcdefghijklmnopqrstuvwxyz" + "ABCDEFGHIJKLMNOPQ"],
  ["vault-service-token", "hvs." + "a".repeat(95)],
  ["notion-api-token", "ntn_" + "01234567890" + "abcdefghijklmnopqrstuvwxyzABCDEFGHI"],
  ["databricks-api-token", "dapi" + "0123456789abcdef".repeat(2)],
  ["grafana-cloud-api-token", "glc_" + "a".repeat(40)],
  ["hashicorp-tf-api-token", "abcdefghijklmn" + ".atlasv1." + "a".repeat(67)],
]

// The same providers with the prefix or length broken, and ordinary words.
const NEGATIVE: string[][] = [
  ["aws-access-token", "AKIA" + "short"],
  ["github-pat", "ghp_" + "abcdefghij"],
  ["gitlab-pat", "glpat-" + "short"],
  ["slack-bot-token", "xoxb-" + "12"],
  ["stripe-access-token", "sk_" + "test_" + "x"],
  ["openai-api-key", "sk-" + "abc"],
  ["anthropic-api-key", "sk-ant-" + "api03-" + "short"],
  ["gcp-api-key", "AIza" + "short"],
  ["sendgrid-api-token", "SG." + "short"],
  ["twilio-api-key", "SK" + "xyz"],
  ["npm-access-token", "npm_" + "short"],
  ["pypi-upload-token", "pypi-" + "AgEIcHlwaS5vcmc" + "short"],
  ["huggingface-access-token", "hf_" + "short"],
  ["digitalocean-pat", "dop_v1_" + "abc"],
  ["shopify-access-token", "shpat_" + "xyz"],
  ["postman-api-token", "PMAK-" + "short"],
  ["linear-api-key", "lin_api_" + "short"],
  ["perplexity-api-key", "pplx-" + "short"],
  ["sentry-user-token", "sntryu_" + "abc"],
  ["doppler-api-token", "dp.pt." + "short"],
  ["vault-service-token", "hvs." + "short"],
  ["notion-api-token", "ntn_" + "short"],
  ["databricks-api-token", "dapi" + "xyz"],
  ["grafana-cloud-api-token", "glc_" + "short"],
  ["hashicorp-tf-api-token", "abcdefghijklmn" + ".terraform."],
]

test("common providers: a positive fixture is found by its rule", () => {
  const rules = try compileSecrets([], "block")
  for (const c of POSITIVE) {
    expect(hits(c[0]!, c[1]!, rules)).toBe(true)
  }
})

test("common providers: a negative fixture is not found by its rule", () => {
  const rules = try compileSecrets([], "block")
  for (const c of NEGATIVE) {
    expect(hits(c[0]!, c[1]!, rules)).toBe(false)
  }
})

test("ordinary prose is not a secret", () => {
  const rules = try compileSecrets([], "block")
  expect(applyRegex("ghp_short and sk-live and the glpat- prefix", rules).findings.length).toBe(0)
  expect(applyRegex("Please review the Stripe docs and the pull request", rules).findings.length).toBe(0)
})

test("ignored keywords suppress matches that contain them", () => {
  const rules = try compileSecrets(["example"], "block")
  const fake = "ghp_example0123456789abcdefghijklmnopqrs"
  expect(applyRegex(fake, rules).findings.length).toBe(0)
  expect(applyRegex("ghp_abcdefghijklmnopqrstuvwxyz0123456789", rules).blocked).toBe(true)
})
