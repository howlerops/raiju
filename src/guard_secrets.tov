// Secrets detection with the upstream Gitleaks rule set (Bifrost's secrets provider).
// Bifrost embeds Gitleaks v8.30.1. The rules and their allowlists are generated into
// guard_gitleaks_data.tov by scripts/gen_gitleaks.py, which skips rules the RE2 engine
// cannot compile. Each rule runs as a regex guardrail rule (guard_regex.tov) with its
// keywords as a prefilter. The engine applies the rule's secret group (the reported and
// redacted span), its entropy floor, and the global and rule allowlists (regexes,
// stopwords, regexTarget). Path and commit allowlists do not apply to prompts.

import { AllowRule, RegexRule, CompiledRule, compileRules, applyRegex, allowRegexMatches } from "./guard_regex"
import { GITLEAKS_DATA, GITLEAKS_ALLOWLIST } from "./guard_gitleaks_data"

// The allowlist as the generator writes it (see guard_gitleaks_data.tov).
type AllowSpec = { target?: string, all?: bool, regexes?: string[], stopwords?: string[] }

export type SecretRule = { id: string, description: string, pattern: string, entropy: number, secretGroup: int, keywords: string[], allow: AllowRule[] }

function allowOf(s: AllowSpec): AllowRule {
  return { target: s.target ?? "", all: s.all ?? false, regexes: s.regexes ?? [], stopwords: s.stopwords ?? [] }
}

// The global allowlist, which applies to every rule.
function globalAllowlist(): AllowRule[] throws SyntaxError {
  const spec = try JSON.parse(GITLEAKS_ALLOWLIST) as AllowSpec
  if ((spec.regexes ?? []).length === 0 && (spec.stopwords ?? []).length === 0) return []
  return [allowOf(spec)]
}

// Parses the generated table: one rule per line, tab-separated (see the header of
// guard_gitleaks_data.tov). Called once per compiled config, not at match time.
export function gitleaksRules(): SecretRule[] throws SyntaxError {
  const out: SecretRule[] = []
  for (const line of GITLEAKS_DATA.split("\n")) {
    if (line.byteLength === 0) continue
    const f = line.split("\t")
    const keywords = try JSON.parse(f[3]!) as string[]
    const allows = try JSON.parse(f[6]!) as AllowSpec[]
    const ent = parseFloat(f[1]!)
    const sg = parseInt(f[2]!)
    const allow: AllowRule[] = []
    for (const a of allows) allow.push(allowOf(a))
    out.push({
      id: f[0]!,
      description: f[4]!,
      pattern: f[5]!,
      entropy: ent === undefined ? 0 : ent,
      secretGroup: sg === undefined ? 0 : sg,
      keywords: keywords,
      allow: allow,
    })
  }
  return out
}

// Rules as regex guardrail rules. Each finding is labelled with the rule id. The global
// allowlist comes first, as gitleaks checks it before a rule's own.
export function secretRules(ignoredKeywords: string[], action: string): RegexRule[] throws SyntaxError {
  const out: RegexRule[] = []
  const global = try globalAllowlist()
  for (const g of try gitleaksRules()) {
    const allow: AllowRule[] = []
    for (const a of global) allow.push(a)
    for (const a of g.allow) allow.push(a)
    out.push({
      pattern: g.pattern,
      description: g.id,
      entity_type: g.id,
      action: action,
      skip_containing: ignoredKeywords,
      keywords: g.keywords,
      secret_group: g.secretGroup,
      entropy: g.entropy,
      // Gitleaks drops a finding whose line carries its allow comment
      skip_line_containing: ["gitleaks:allow"],
      allow: allow,
    })
  }
  return out
}

// Compiles the whole set once; callers keep the result for the life of the config.
export function compileSecrets(ignoredKeywords: string[], action: string): CompiledRule[] throws SyntaxError {
  return try compileRules(try secretRules(ignoredKeywords, action))
}

// ---- tests ----

// True when the rule with this id (its kind is the id in upper case) finds text.
function hits(id: string, text: string, rules: CompiledRule[]): bool {
  for (const f of applyRegex(text, rules).findings) {
    if (f.kind === id.toUpperCase()) return true
  }
  return false
}

test("every generated rule compiles", () => {
  const table = try gitleaksRules()
  expect(table.length > 200).toBe(true)
  for (const g of table) {
    expect(g.pattern.byteLength > 0).toBe(true)
  }
  const rules = try compileSecrets([], "block")
  expect(rules.length).toBe(table.length)
})

test("known credential shapes are found", () => {
  const rules = try compileSecrets([], "redact")
  const r = applyRegex("use ghp_qmzkpaxrtnbcwdhsyuvgjfleio0123456789 and glpat-abcdefghij0123456789 now", rules)
  expect(r.body).toBe("use [REDACTED:GITHUB-PAT] and [REDACTED:GITLAB-PAT] now")
  expect(applyRegex("key AIzaSyA1234567890abcdefghijklmnopqrstuv", rules).body).toBe("key [REDACTED:GCP-API-KEY]")
  // built from parts so the fixture isn't itself a webhook-shaped literal in the repository
  const hook = "hook https://hooks." + "slack.com/services/" + "T0123ABCD/B0123ABCD/" + "abcdefghijklmnopqrstuvwx"
  expect(applyRegex(hook, rules).blocked).toBe(false)
  expect(applyRegex(hook, rules).findings[0]!.kind).toBe("SLACK-WEBHOOK-URL")
})

test("redaction leaves the character after a secret", () => {
  const rules = try compileSecrets([], "redact")
  expect(applyRegex("key " + "npm_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789" + " next", rules).body).toBe("key [REDACTED:NPM-ACCESS-TOKEN] next")
  expect(applyRegex("key " + "npm_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789" + "\nnext", rules).body).toBe("key [REDACTED:NPM-ACCESS-TOKEN]\nnext")
})

// Positive and negative fixtures for 24 providers. Each is assembled from parts so the
// repository holds no string that looks like a live credential.
