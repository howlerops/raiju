// Secrets detection with a Gitleaks rule set (Bifrost's secrets provider).
// Bifrost embeds Gitleaks v8.30.1 (222 rules). This is a curated subset of the
// common, distinctive-prefix rules, written from the Gitleaks rule definitions.
// Gitleaks' entropy filters and per-rule path allowlists are not ported, so
// these rules match on the pattern alone. Every pattern is RE2, so regex.tov runs it.

import { RegexRule, CompiledRule, compileRules, applyRegex } from "./guard_regex"

export type SecretRule = { id: string, pattern: string }

export const GITLEAKS_RULES: SecretRule[] = [
  { id: "aws-access-token", pattern: "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\b" },
  { id: "github-pat", pattern: "ghp_[0-9a-zA-Z]{36}" },
  { id: "github-fine-grained-pat", pattern: "github_pat_\\w{82}" },
  { id: "github-oauth", pattern: "gho_[0-9a-zA-Z]{36}" },
  { id: "github-app-token", pattern: "(?:ghu|ghs)_[0-9a-zA-Z]{36}" },
  { id: "github-refresh-token", pattern: "ghr_[0-9a-zA-Z]{36}" },
  { id: "gitlab-pat", pattern: "glpat-[\\w-]{20}" },
  { id: "slack-bot-token", pattern: "xoxb-[0-9]{10,13}-[0-9]{10,13}[a-zA-Z0-9-]*" },
  { id: "slack-user-token", pattern: "xox[pe](?:-[0-9]{10,13}){3}-[a-zA-Z0-9-]{28,34}" },
  { id: "slack-webhook-url", pattern: "https://hooks\\.slack\\.com/services/T[a-zA-Z0-9_]{8,12}/B[a-zA-Z0-9_]{8,12}/[a-zA-Z0-9_]{24}" },
  { id: "stripe-access-token", pattern: "(?:sk|rk)_(?:test|live|prod)_[a-zA-Z0-9]{10,99}" },
  { id: "openai-api-key", pattern: "\\b(sk-(?:proj|svcacct|admin)-(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})T3BlbkFJ(?:[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58})\\b|sk-[a-zA-Z0-9]{20}T3BlbkFJ[a-zA-Z0-9]{20})" },
  { id: "anthropic-api-key", pattern: "sk-ant-api03-[a-zA-Z0-9_-]{93}AA" },
  { id: "anthropic-admin-api-key", pattern: "sk-ant-admin01-[a-zA-Z0-9_-]{93}AA" },
  { id: "gcp-api-key", pattern: "AIza[\\w-]{35}" },
  { id: "sendgrid-api-token", pattern: "SG\\.[a-zA-Z0-9=_.-]{66}" },
  { id: "twilio-api-key", pattern: "SK[0-9a-fA-F]{32}" },
  { id: "npm-access-token", pattern: "\\b(npm_[a-zA-Z0-9]{36})" },
  { id: "pypi-upload-token", pattern: "pypi-AgEIcHlwaS5vcmc[\\w-]{50,150}" },
  { id: "huggingface-access-token", pattern: "\\b(hf_[a-zA-Z]{34})\\b" },
  { id: "digitalocean-pat", pattern: "\\b(dop_v1_[a-f0-9]{64})\\b" },
  { id: "shopify-access-token", pattern: "shpat_[a-fA-F0-9]{32}" },
  { id: "hashicorp-tf-api-token", pattern: "[a-zA-Z0-9]{14}\\.atlasv1\\.[a-zA-Z0-9=_-]{60,70}" },
  { id: "databricks-api-token", pattern: "\\b(dapi[a-f0-9]{32}(?:-\\d)?)" },
  { id: "postman-api-token", pattern: "PMAK-[a-fA-F0-9]{24}-[a-fA-F0-9]{34}" },
  { id: "new-relic-user-api-key", pattern: "NRAK-[a-z0-9]{27}" },
  { id: "linear-api-key", pattern: "lin_api_[a-zA-Z0-9]{40}" },
  { id: "notion-api-token", pattern: "\\b(ntn_[0-9]{11}[A-Za-z0-9]{35})" },
  { id: "perplexity-api-key", pattern: "pplx-[a-zA-Z0-9]{48}" },
  { id: "vault-service-token", pattern: "\\b(hvs\\.[\\w-]{90,120})\\b" },
  { id: "doppler-api-token", pattern: "dp\\.pt\\.[a-zA-Z0-9]{43}" },
  { id: "sentry-user-token", pattern: "sntryu_[a-f0-9]{64}" },
  { id: "grafana-cloud-api-token", pattern: "glc_[A-Za-z0-9+/]{32,400}={0,2}" },
]

// Rules as regex guardrail rules. Each finding is labelled with the rule id.
export function secretRules(ignoredKeywords: string[], action: string): RegexRule[] {
  const out: RegexRule[] = []
  for (const g of GITLEAKS_RULES) {
    out.push({ pattern: g.pattern, description: g.id, entity_type: g.id, action: action, skip_containing: ignoredKeywords })
  }
  return out
}

// Compiles the whole set once; callers keep the result for the life of the config.
export function compileSecrets(ignoredKeywords: string[], action: string): CompiledRule[] throws SyntaxError {
  return try compileRules(secretRules(ignoredKeywords, action))
}

// ---- tests ----


test("every curated rule compiles", () => {
  const rules = try compileSecrets([], "block")
  expect(rules.length).toBe(GITLEAKS_RULES.length)
})

test("known credential shapes are found", () => {
  const rules = try compileSecrets([], "redact")
  const r = applyRegex("use ghp_abcdefghijklmnopqrstuvwxyz0123456789 and glpat-abcdefghij0123456789 now", rules)
  expect(r.body).toBe("use [REDACTED:GITHUB-PAT] and [REDACTED:GITLAB-PAT] now")
  expect(applyRegex("key AIzaSyA1234567890abcdefghijklmnopqrstuv", rules).body).toBe("key [REDACTED:GCP-API-KEY]")
  // built from parts so the fixture isn't itself a webhook-shaped literal in the repository
  const hook = "hook https://hooks." + "slack.com/services/" + "T0123ABCD/B0123ABCD/" + "abcdefghijklmnopqrstuvwx"
  expect(applyRegex(hook, rules).blocked).toBe(false)
  expect(applyRegex(hook, rules).findings[0]!.kind).toBe("SLACK-WEBHOOK-URL")
})

test("ordinary prose is not a secret", () => {
  const rules = try compileSecrets([], "block")
  expect(applyRegex("ghp_short and sk-live and the glpat- prefix", rules).findings.length).toBe(0)
  expect(applyRegex("Please review the Stripe docs and the pull request", rules).findings.length).toBe(0)
})

test("ignored keywords suppress matches that contain them", () => {
  const rules = try compileSecrets(["example"], "block")
  const fake = "ghp_example0123456789abcdefghijklmnopqrs"
  expect(applyRegex(fake, rules).findings.length).toBe(0)
  expect(applyRegex("ghp_abcdefghijklmnopqrstuvwxyz0123456789", rules).blocked).toBe(true)
})
