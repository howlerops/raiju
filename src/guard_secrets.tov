  ["npm-access-token", "npm_" + "qmzkpaxrtnbcwdhsyuvgjfleio0123456789"],
  ["pypi-upload-token", "pypi-" + "AgEIcHlwaS5vcmc" + "Qk3mZ9pL2xR7tN4bW8cV1dH6sF0gJ5yA3eU9iO2rT6wK8nM1Pz"],
