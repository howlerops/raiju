// Role-based access to the management API (/api/*): several admin users, each
// with a role, in place of one shared token. Credentials are kept as hashes;
// a token is shown once, when its user is created, and never stored.
import { sha256, toHex, utf8, secureHex } from "./crypto"
import { decode, encode } from "./base64"
import { rfc3339Ms } from "./vkexpiry"
import { AdminAuthConfig, AdminUserConfig, ApiKeyConfig, PermissionPair, RoleConfig } from "./config"

// A built-in role (admin, editor, viewer, auditor) or the name of a custom role under governance.roles.
export type Role = string

export type UserConfig = AdminUserConfig

export type RbacConfig = { users: UserConfig[], roles?: RoleConfig[], api_keys?: ApiKeyConfig[] }

export type Identity = { kind: "user", name: string, role: Role } | { kind: "anonymous" } | { kind: "denied", reason: string }

export type Permission = "read" | "write" | "manage_users" | "audit"

export type Verdict = { kind: "ok", actor: string } | { kind: "error", status: int, message: string }

export type UsersReply = { status: int, body: string, cfg: RbacConfig }

const EDITOR_COLLECTIONS = ["virtual-keys", "budgets", "rate-limits", "teams", "customers", "access-profiles"]
const SECRET_SEGMENTS = ["secrets", "reveal"]
const LAST_ADMIN = "cannot remove or disable the last enabled admin"

export function hashToken(token: string): string {
  return toHex(sha256(utf8(token)))
}

export function hashPassword(salt: string, password: string): string {
  return toHex(sha256(utf8(salt + ":" + password)))
}

// Compares without stopping at the first difference.
export function safeEq(a: string, b: string): bool {
  const x = utf8(a)
  const y = utf8(b)
  const n = x.length > y.length ? x.length : y.length
  let d = x.length === y.length ? 0 : 1
  for (let i = 0; i < n; i++) {
    const p = i < x.length ? int(x[i]!) : 0
    const q = i < y.length ? int(y[i]!) : 0
    d = d | (p ^ q)
  }
  return d === 0
}

// The decoded "user:password" of a Basic credential, or undefined if it is not base64 text.
function basicCreds(v: string): string | undefined {
  try {
    return new TextDecoder().decode(decode(v.trim()))
  } catch (e) {
    return undefined
  }
}

function live(u: UserConfig): Identity {
  if (u.disabled === true) return { kind: "denied", reason: "user is disabled" }
  return { kind: "user", name: u.name, role: u.role }
}

// Every user is compared, so the time taken does not show which one matched.
function bearerUser(cfg: RbacConfig, token: string): Identity {
  if (token === "") return { kind: "denied", reason: "empty bearer token" }
  const want = hashToken(token)
  let hit: UserConfig | undefined = undefined
  for (const u of cfg.users) {
    const h = u.token_sha256
    if (h !== undefined && safeEq(want, h)) hit = u
  }
  if (hit === undefined) return { kind: "denied", reason: "invalid credentials" }
  return live(hit)
}

function basicUser(cfg: RbacConfig, v: string): Identity {
  const creds = basicCreds(v)
  if (creds === undefined) return { kind: "denied", reason: "malformed basic credentials" }
  const i = creds.indexOf(":")
  if (i < 0) return { kind: "denied", reason: "malformed basic credentials" }
  const name = creds.slice(0, i)
  const pw = creds.slice(i + 1)
  let hit: UserConfig | undefined = undefined
  for (const u of cfg.users) {
    if (u.name === name) hit = u
  }
  if (hit === undefined) return { kind: "denied", reason: "invalid credentials" }
  const salt = hit.salt
  const stored = hit.password_sha256
  if (salt === undefined || stored === undefined) return { kind: "denied", reason: "invalid credentials" }
  if (!safeEq(hashPassword(salt, pw), stored)) return { kind: "denied", reason: "invalid credentials" }
  return live(hit)
}

// Who the request's Authorization header names. No header is anonymous; a
// wrong, unknown or disabled credential is denied.
export function authenticate(cfg: RbacConfig, headers: Map<string, string>): Identity {
  const h = headers.get("authorization") ?? ""
  if (h === "") return { kind: "anonymous" }
  if (h.startsWith("Bearer ") || h.startsWith("bearer ")) return bearerUser(cfg, h.slice(7))
  if (h.startsWith("Basic ") || h.startsWith("basic ")) return basicUser(cfg, h.slice(6))
  return { kind: "denied", reason: "unsupported authorization scheme" }
}

function segmentsOf(path: string): string[] {
  const q = path.indexOf("?")
  const p = q < 0 ? path : path.slice(0, q)
  return p.split("/").filter((s) => s !== "")
}

// Only /api/... is the management API; anything else is admin-only.
function isApi(segs: string[]): bool {
  return (segs[0] ?? "") === "api"
}

// The audit trail, at /api/audit-logs and its alias /api/governance/audit-logs, and the request logs.
function isAudit(segs: string[]): bool {
  const a = segs[1] ?? ""
  return a === "audit-logs" || a === "logs" || auditAlias(segs)
}

function auditAlias(segs: string[]): bool {
  return (segs[1] ?? "") === "governance" && (segs[2] ?? "") === "audit-logs"
}

function isSecret(segs: string[]): bool {
  for (const s of segs) {
    if (SECRET_SEGMENTS.includes(s)) return true
  }
  return false
}

function editorWrites(segs: string[]): bool {
  const area = segs[1] ?? ""
  if (area === "providers") return true
  if (area === "governance") return EDITOR_COLLECTIONS.includes(segs[2] ?? "")
  return false
}

// Bifrost's /api/governance/users/... routes, the users' newer home.
function governanceUsers(segs: string[]): bool {
  return (segs[1] ?? "") === "governance" && (segs[2] ?? "") === "users"
}

// The routes every signed-in caller reads about itself: its permissions (both paths) and its key-creation policy.
export function selfRoute(method: string, path: string): bool {
  if (method.toUpperCase() !== "GET") return false
  return path === "/api/users/me/permissions" || path === "/api/governance/users/me/permissions" || path === "/api/users/me/vk-creation-policy" || path === "/api/governance/users/me/vk-creation-policy"
}

// What a request needs: user management, audit logs, a write, or a read.
export function required(method: string, path: string): Permission {
  const segs = segmentsOf(path)
  if (isApi(segs) && ((segs[1] ?? "") === "users" || governanceUsers(segs))) return "manage_users"
  const m = method.toUpperCase()
  if (m === "GET" || m === "HEAD") return isAudit(segs) ? "audit" : "read"
  return "write"
}

// admin: everything. editor: read everything, write providers and governance
// records, no user management. viewer: GET except secrets and audit logs. auditor: audit logs only.
export function allowed(role: Role, perm: Permission, path: string): bool {
  if (role === "admin") return true
  const segs = segmentsOf(path)
  if (!isApi(segs)) return false
  // management API keys are granted by a custom role's APIKeys permissions, or by the admin
  if ((segs[1] ?? "") === "api-keys") return false
  if (perm === "manage_users") return false
  if (perm === "audit" && !isAudit(segs)) return false
  // the audit trail is for admins and auditors only
  if (perm === "audit" && ((segs[1] ?? "") === "audit-logs" || auditAlias(segs)) && role !== "auditor") return false
  if (role === "auditor") return perm === "audit"
  if (perm === "write") return role === "editor" && editorWrites(segs)
  if (role === "editor") return true
  return !isSecret(segs)
}

// The Bifrost resource a management route is about, and the operation the method implies. Custom
// roles hold (resource, operation) pairs; secret routes need Reveal, which only a custom role can hold.
export function resourceOf(method: string, path: string): { resource: string, op: string } {
  const segs = segmentsOf(path)
  const m = method.toUpperCase()
  let op = "View"
  if (m === "POST") op = "Create"
  else if (m === "PUT" || m === "PATCH") op = "Update"
  else if (m === "DELETE") op = "Delete"
  if (isSecret(segs)) op = "Reveal"
  const area = segs[1] ?? ""
  const coll = segs[2] ?? ""
  let resource = "Settings"
  if (area === "users") resource = "Users"
  else if (area === "audit-logs") resource = "AuditLogs"
  else if (area === "logs") resource = "Logs"
  else if (area === "mcp-logs") resource = "MCPLogs"
  else if (area === "providers" || area === "keys" || area === "models") resource = "ModelProvider"
  else if (area === "mcp" || area === "oauth2") resource = "MCPGateway"
  else if (area === "cluster") resource = "Cluster"
  else if (area === "alerting" || area === "alerts") resource = "Observability"
  else if (area === "roles") resource = "RBAC"
  else if (area === "api-keys") resource = "APIKeys"
  else if (area === "crews") resource = "Crews"
  else if (area === "access-profiles") resource = "AccessProfiles"
  else if (area === "governance") {
    if (coll === "virtual-keys") resource = "VirtualKeys"
    else if (coll === "users") resource = "Users"
    else if (coll === "teams") resource = "Teams"
    else if (coll === "customers") resource = "Customers"
    else if (coll === "business-units") resource = "BusinessUnits"
    else if (coll === "projects") resource = "Projects"
    else if (coll === "access-profiles") resource = "AccessProfiles"
    else if (coll === "routing-rules") resource = "RoutingRules"
    else if (coll === "audit-logs") resource = "AuditLogs"
    else if (coll === "rbac") resource = "RBAC"
    else resource = "Governance"
  }
  return { resource: resource, op: op }
}

// Whether a role may make this request. A built-in role keeps its fixed rules; a custom role needs its
// (resource, operation) pair and only reaches the management API. Unknown roles are refused.
// A built-in role whose permissions were edited (an entry under governance.roles with its name) is judged by its
// pairs like a custom role, except that the admin keeps the routes outside /api.
export function roleAllows(roles: RoleConfig[] | undefined, role: string, method: string, path: string): bool {
  const r = customRole(roles, role)
  if (r === undefined) {
    if (!isBuiltinRole(role)) return false
    return allowed(role, required(method, path), path)
  }
  if (!isApi(segmentsOf(path))) return role === "admin"
  const need = resourceOf(method, path)
  for (const p of r.permissions ?? []) {
    if (p.resource === need.resource && p.operation === need.op) return true
  }
  return false
}

// The management API key a Bearer value names, or undefined when it names none (the user credentials
// are tried next). Every key is compared, as the users are.
export function keyOf(cfg: RbacConfig, headers: Map<string, string>): ApiKeyConfig | undefined {
  const h = headers.get("authorization") ?? ""
  if (!(h.startsWith("Bearer ") || h.startsWith("bearer "))) return undefined
  const token = h.slice(7)
  if (token === "") return undefined
  const want = hashToken(token)
  let hit: ApiKeyConfig | undefined = undefined
  for (const k of cfg.api_keys ?? []) {
    if (safeEq(want, k.key_sha256)) hit = k
  }
  return hit
}

// Whether a key may make this request: the route's (resource, operation) pair must be among its
// permissions. Keys reach only /api routes, and the caller's own permission and policy reads.
export function keyAllows(k: ApiKeyConfig, method: string, path: string): bool {
  if (!isApi(segmentsOf(path))) return false
  if (selfRoute(method, path)) return true
  const need = resourceOf(method, path)
  for (const p of k.permissions) {
    if (p.resource === need.resource && p.operation === need.op) return true
  }
  return false
}

// The access decision for one request. 401 when the caller is not
// authenticated, 403 when the role does not cover the request. An API key is checked by its
// permissions alone (it never inherits the role of whoever created it), and an expired one is refused.
export function authorize(cfg: RbacConfig, headers: Map<string, string>, method: string, path: string): Verdict {
  const key = keyOf(cfg, headers)
  if (key !== undefined) {
    const exp = key.expires_at === undefined ? undefined : rfc3339Ms(key.expires_at)
    if (exp !== undefined && exp <= Date.now()) return { kind: "error", status: 401, message: "the API key has expired" }
    if (!keyAllows(key, method, path)) {
      const need = resourceOf(method, path)
      return { kind: "error", status: 403, message: `API key ${key.name} may not ${need.resource}:${need.op} on this route` }
    }
    return { kind: "ok", actor: "key:" + key.name }
  }
  const who = authenticate(cfg, headers)
  if (who.kind === "anonymous") return { kind: "error", status: 401, message: "authentication required" }
  if (who.kind === "denied") return { kind: "error", status: 401, message: who.reason }
  // every signed-in user reads their own permissions (Bifrost's /users/me/permissions)
  if (selfRoute(method, path)) return { kind: "ok", actor: who.name }
  if (!roleAllows(cfg.roles, who.role, method, path))return { kind: "error", status: 403, message: `role ${who.role} may not ${required(method, path)} this route` }
  return { kind: "ok", actor: who.name }
}

// ---- user management ----

type UserBody = { name?: string, email?: string, role?: string, role_id?: int, disabled?: bool }

type UserView = { name: string, email?: string, role: Role, disabled: bool }

const BUILT_IN_ROLES = ["admin", "editor", "viewer", "auditor"]

export function isBuiltinRole(s: string): bool {
  return BUILT_IN_ROLES.includes(s)
}

// The name of the custom role with this id, or undefined.
export function roleNameById(roles: RoleConfig[] | undefined, id: int): string | undefined {
  for (const r of withRoleIds(roles ?? [])) {
    if (r.id === id) return r.name
  }
  return undefined
}

// The custom role with this name, if one is defined.
export function customRole(roles: RoleConfig[] | undefined, name: string): RoleConfig | undefined {
  for (const r of roles ?? []) {
    if (r.name === name) return r
  }
  return undefined
}

// The built-in roles' ids (Bifrost's system roles carry ids too). They sit in a block of their own, so the
// custom roles keep the ids they were saved with, from 1 up; a custom role never takes one of these.
const BUILT_IN_ROLE_IDS: int[] = [9001, 9002, 9003, 9004]

function reservedRoleId(id: int): bool {
  return BUILT_IN_ROLE_IDS.includes(id)
}

// The id of a built-in role, or undefined for any other name.
export function builtinRoleId(name: string): int | undefined {
  for (let i = 0; i < BUILT_IN_ROLES.length; i++) {
    if (BUILT_IN_ROLES[i] === name) return BUILT_IN_ROLE_IDS[i]
  }
  return undefined
}

// The built-in role with this id, or undefined.
export function builtinRoleName(id: int): string | undefined {
  for (let i = 0; i < BUILT_IN_ROLE_IDS.length; i++) {
    if (BUILT_IN_ROLE_IDS[i] === id) return BUILT_IN_ROLES[i]
  }
  return undefined
}

// The id of any role a user may hold: a built-in role's fixed id or a custom role's id.
export function anyRoleId(roles: RoleConfig[] | undefined, name: string): int | undefined {
  return builtinRoleId(name) ?? roleIdOf(roles, name)
}

// The name of the role, built-in or custom, with this id.
export function anyRoleName(roles: RoleConfig[] | undefined, id: int): string | undefined {
  return builtinRoleName(id) ?? roleNameById(roles, id)
}

// A route each resource's fixed rules are read from: a built-in role holds a (resource, operation) pair when
// its rules allow the operation's method on that route. RunInference and Reveal name no management route
// (no route reveals a secret), so only the admin holds them.
function sampleRoute(resource: string): string {
  if (resource === "Logs") return "/api/logs"
  if (resource === "MCPLogs") return "/api/mcp-logs"
  if (resource === "AuditLogs") return "/api/audit-logs"
  if (resource === "ModelProvider") return "/api/providers"
  if (resource === "Observability") return "/api/alerting/rules"
  if (resource === "VirtualKeys") return "/api/governance/virtual-keys"
  if (resource === "Users") return "/api/users"
  if (resource === "MCPGateway") return "/api/mcp/clients"
  if (resource === "Teams") return "/api/governance/teams"
  if (resource === "Customers") return "/api/governance/customers"
  if (resource === "BusinessUnits") return "/api/governance/business-units"
  if (resource === "Projects") return "/api/governance/projects"
  if (resource === "RBAC") return "/api/roles"
  if (resource === "AccessProfiles") return "/api/governance/access-profiles"
  if (resource === "RoutingRules") return "/api/governance/routing-rules"
  if (resource === "Governance") return "/api/governance/budgets"
  if (resource === "Cluster") return "/api/cluster"
  if (resource === "APIKeys") return "/api/api-keys"
  if (resource === "Crews") return "/api/crews"
  return "/api/config"
}

function opRequest(op: string, route: string): { method: string, path: string } | undefined {
  if (op === "View" || op === "Download") return { method: "GET", path: route }
  if (op === "Create") return { method: "POST", path: route }
  if (op === "Update") return { method: "PUT", path: route + "/x" }
  if (op === "Delete") return { method: "DELETE", path: route + "/x" }
  return undefined
}

// A built-in role's fixed rules as (resource, operation) pairs over the catalog: the admin holds every pair.
// The pairs describe the rules; requests are still judged by the rules themselves (allowed).
export function builtinPairs(role: string, resources: string[], operations: string[]): PermissionPair[] {
  const out: PermissionPair[] = []
  if (!isBuiltinRole(role)) return out
  for (const r of resources) {
    for (const op of operations) {
      let ok = role === "admin"
      const rq = opRequest(op, sampleRoute(r))
      if (!ok && rq !== undefined) ok = allowed(role, required(rq.method, rq.path), rq.path)
      if (ok) out.push({ resource: r, operation: op })
    }
  }
  return out
}

function builtinText(role: string): string {
  if (role === "admin") return "Full access to every resource and operation"
  if (role === "editor") return "Reads everything but users, API keys and the audit trail; writes providers and governance records"
  if (role === "viewer") return "Reads everything but users, API keys, secrets and the audit trail; changes nothing"
  return "Reads the request logs and the audit trail only"
}

// The built-in roles as role records: their fixed ids, all-data scope, and their rules as pairs.
export function builtinRoles(resources: string[], operations: string[]): RoleConfig[] {
  const out: RoleConfig[] = []
  for (const name of BUILT_IN_ROLES) {
    out.push({ id: builtinRoleId(name), name: name, description: builtinText(name), dac: "all-data", permissions: builtinPairs(name, resources, operations), entity_dac: [] })
  }
  return out
}

// A built-in role as it stands: its edited entry under governance.roles when it has one (description, dac and
// pairs as saved), else its defaults.
export function systemRole(roles: RoleConfig[] | undefined, name: string, resources: string[], operations: string[]): RoleConfig | undefined {
  const id = builtinRoleId(name)
  if (id === undefined) return undefined
  const e = customRole(roles, name)
  if (e !== undefined) return { id: id, name: name, description: e.description ?? builtinText(name), dac: e.dac ?? "all-data", permissions: e.permissions ?? [], entity_dac: e.entity_dac ?? [] }
  for (const r of builtinRoles(resources, operations)) {
    if (r.name === name) return r
  }
  return undefined
}

// The custom roles only: entries that edit a built-in role are left out.
export function customRoles(roles: RoleConfig[] | undefined): RoleConfig[] {
  return withRoleIds(roles ?? []).filter((r) => !isBuiltinRole(r.name))
}

// The roles with their ids. A role keeps its id; one saved without one (or with a built-in role's id) takes
// the next id after the largest in use, in list order, so ids stay put as roles are added and removed.
export function withRoleIds(roles: RoleConfig[]): RoleConfig[] {
  let top: int = 0
  for (const r of roles) {
    if (isBuiltinRole(r.name)) continue
    const id: int = r.id ?? 0
    if (id > top && !reservedRoleId(id)) top = id
  }
  const out: RoleConfig[] = []
  for (const r of roles) {
    // an edited built-in role keeps its fixed id
    const fixed = builtinRoleId(r.name)
    if (fixed !== undefined) {
      out.push({ id: fixed, name: r.name, description: r.description, dac: r.dac, permissions: r.permissions, entity_dac: r.entity_dac })
      continue
    }
    if (r.id !== undefined && !reservedRoleId(r.id ?? 0)) {
      out.push(r)
      continue
    }
    top += 1
    while (reservedRoleId(top)) top += 1
    out.push({ id: top, name: r.name, description: r.description, dac: r.dac, permissions: r.permissions, entity_dac: r.entity_dac })
  }
  return out
}

// The id of the custom role with this name, or undefined.
export function roleIdOf(roles: RoleConfig[] | undefined, name: string): int | undefined {
  for (const r of withRoleIds(roles ?? [])) {
    if (r.name === name) return r.id
  }
  return undefined
}

// A role a user may hold: built-in, or defined under governance.roles.
export function knownRole(roles: RoleConfig[] | undefined, s: string): bool {
  return isBuiltinRole(s) || customRole(roles, s) !== undefined
}

// Names are Basic auth user names and path segments: lower-case letters, digits, "_", "-", and
// "@", "." and "+" so that a sign-in identity (an email, for an identity-aware proxy) can be a user.
export function validName(name: string): bool {
  const n = name.byteLength
  if (n < 1 || n > 64) return false
  for (const b of utf8(name)) {
    const c = int(b)
    const ok = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c === 95 || c === 45 || c === 64 || c === 46 || c === 43
    if (!ok) return false
  }
  return true
}

// The enabled user an identity-aware proxy names (its identity claim, lower-cased), or undefined.
export function provisioned(cfg: RbacConfig, identity: string): UserConfig | undefined {
  const who = identity.toLowerCase()
  for (const u of cfg.users) {
    if (u.name === who && u.disabled !== true) return u
  }
  return undefined
}

// Whether governance lists a disabled user under one of the names (a sign-in's email or subject). A name no
// user holds is not disabled, so its sign-in is unchanged.
export function disabledNamed(cfg: RbacConfig, names: string[]): bool {
  for (const u of cfg.users) {
    if (u.disabled === true && names.includes(u.name)) return true
  }
  return false
}

function view(u: UserConfig): UserView {
  return { name: u.name, email: u.email, role: u.role, disabled: u.disabled === true }
}

// An email address as Bifrost checks one (^[^\s@]+@[^\s@]+\.[^\s@]+$): one "@", no blanks, and a dot in
// the domain with text on both sides of it.
export function validEmail(s: string): bool {
  if (s.byteLength < 5 || s.byteLength > 254) return false
  const at = s.indexOf("@")
  if (at < 1) return false
  const domain = s.slice(at + 1)
  if (domain.indexOf("@") >= 0) return false
  for (const b of utf8(s)) {
    const c = int(b)
    if (c === 32 || (c >= 9 && c <= 13)) return false
  }
  // a dot inside the domain, with text before and after it
  const inner = domain.slice(1, domain.byteLength - 1)
  return domain.byteLength >= 3 && inner.indexOf(".") >= 0
}

// The user with this email address (compared without case). A user with no email whose name is the address
// (a sign-in identity) is found by it too.
export function userByEmail(users: UserConfig[], email: string): UserConfig | undefined {
  const want = email.trim().toLowerCase()
  if (want === "") return undefined
  for (const u of users) {
    if ((u.email ?? "").toLowerCase() === want) return u
  }
  for (const u of users) {
    if (u.email === undefined && u.name === want) return u
  }
  return undefined
}

// Whether another user than `except` already has this email address.
function emailTaken(users: UserConfig[], email: string, except: string): bool {
  const want = email.toLowerCase()
  for (const u of users) {
    if (u.name !== except && (u.email ?? "").toLowerCase() === want) return true
  }
  return false
}

function parseUserBody(b: string): UserBody | undefined {
  try {
    const v = JSON.parse(b) as UserBody
    return v
  } catch (e) {
    return undefined
  }
}

// A fresh bearer token, "sk-admin-" then 40 hex characters from the kernel CSPRNG.
function newToken(): string | undefined {
  try {
    return "sk-admin-" + secureHex(40)
  } catch (e) {
    return undefined
  }
}

function findUser(users: UserConfig[], name: string): UserConfig | undefined {
  for (const u of users) {
    if (u.name === name) return u
  }
  return undefined
}

function isActiveAdmin(u: UserConfig): bool {
  return u.role === "admin" && u.disabled !== true
}

// Enabled admins other than `except`.
function otherActiveAdmins(users: UserConfig[], except: string): int {
  let n = 0
  for (const u of users) {
    if (u.name !== except && isActiveAdmin(u)) n += 1
  }
  return n
}

function ureply(status: int, body: string, cfg: RbacConfig): UsersReply {
  return { status: status, body: body, cfg: cfg }
}

function uerror(status: int, message: string, cfg: RbacConfig): UsersReply {
  return ureply(status, JSON.stringify({ error: { message: message } }), cfg)
}

function createUser(cfg: RbacConfig, body: string): UsersReply {
  const b = parseUserBody(body)
  if (b === undefined) return uerror(400, "body must be a JSON object with name and role", cfg)
  const name = b.name ?? ""
  if (!validName(name)) return uerror(400, "name must be 1 to 64 lower-case letters, digits, _, -, @, . or +", cfg)
  const role = b.role ?? ""
  if (!knownRole(cfg.roles, role)) return uerror(400, "role must be admin, editor, viewer, auditor or a custom role", cfg)
  if (findUser(cfg.users, name) !== undefined) return uerror(409, `user ${name} already exists`, cfg)
  const email = (b.email ?? "").trim()
  if (email !== "" && !validEmail(email)) return uerror(400, "email must be an email address", cfg)
  if (email !== "" && emailTaken(cfg.users, email, "")) return uerror(409, `a user with email ${email} already exists`, cfg)
  const token = newToken()
  if (token === undefined) return uerror(500, "no secure random source; the user was not created", cfg)
  const users: UserConfig[] = []
  for (const u of cfg.users) users.push(u)
  users.push({ name: name, email: email === "" ? undefined : email, role: role, token_sha256: hashToken(token), disabled: false })
  // the token is returned here and never again
  const out = { name: name, email: email === "" ? undefined : email, role: role, disabled: false, token: token }
  return ureply(201, JSON.stringify(out), { users: users })
}

function updateUser(cfg: RbacConfig, name: string, body: string): UsersReply {
  const old = findUser(cfg.users, name)
  if (old === undefined) return uerror(404, `no user ${name}`, cfg)
  const b = parseUserBody(body)
  if (b === undefined) return uerror(400, "body must be a JSON object with role, role_id or disabled", cfg)
  let role: Role = old.role
  if (b.role !== undefined) {
    if (!knownRole(cfg.roles, b.role)) return uerror(400, "role must be admin, editor, viewer, auditor or a custom role", cfg)
    role = b.role
  } else if (b.role_id !== undefined) {
    // Bifrost's AssignUserRoleRequest: the role by its id, built-in or custom
    const named = anyRoleName(cfg.roles, b.role_id)
    if (named === undefined) return uerror(400, `role_id ${b.role_id} names no role`, cfg)
    role = named
  }
  const disabled = b.disabled === undefined ? old.disabled : b.disabled
  // an email of "" clears it
  let email: string | undefined = old.email
  if (b.email !== undefined) {
    const e = b.email.trim()
    if (e !== "" && !validEmail(e)) return uerror(400, "email must be an email address", cfg)
    if (e !== "" && emailTaken(cfg.users, e, name)) return uerror(409, `a user with email ${e} already exists`, cfg)
    email = e === "" ? undefined : e
  }
  // the record keeps what it holds beyond the role: its teams, business units, projects and access profiles
  const next: UserConfig = {
    name: old.name,
    email: email,
    role: role,
    token_sha256: old.token_sha256,
    password_sha256: old.password_sha256,
    salt: old.salt,
    disabled: disabled,
    teams: old.teams,
    business_units: old.business_units,
    projects: old.projects,
    access_profile_ids: old.access_profile_ids,
    budget_overrides: old.budget_overrides,
  }
  if (isActiveAdmin(old) && !isActiveAdmin(next) && otherActiveAdmins(cfg.users, name) === 0) {
    return uerror(409, LAST_ADMIN, cfg)
  }
  const users: UserConfig[] = []
  for (const u of cfg.users) users.push(u.name === name ? next : u)
  return ureply(200, JSON.stringify(view(next)), { users: users })
}

function deleteUser(cfg: RbacConfig, name: string): UsersReply {
  const old = findUser(cfg.users, name)
  if (old === undefined) return uerror(404, `no user ${name}`, cfg)
  if (isActiveAdmin(old) && otherActiveAdmins(cfg.users, name) === 0) return uerror(409, LAST_ADMIN, cfg)
  const users: UserConfig[] = []
  for (const u of cfg.users) {
    if (u.name !== name) users.push(u)
  }
  return ureply(200, JSON.stringify({ deleted: name }), { users: users })
}

// GET /api/users (never with hashes), POST /api/users, PUT and DELETE
// /api/users/{name}. Pure: the caller stores the returned cfg. Access is
// checked by authorize() first (manage_users).
export function handleUsers(cfg: RbacConfig, method: string, path: string, body: string): UsersReply {
  const segs = segmentsOf(path)
  if (!isApi(segs) || (segs[1] ?? "") !== "users" || segs.length > 4 || segs.length === 4 && segs[3] !== "role") return uerror(404, "no route for this path", cfg)
  const m = method.toUpperCase()
  const name = segs[2]
  // /api/users/{name}/role: the role alone (Bifrost's role endpoint); PUT takes {"role": ...}
  if (segs.length === 4 && name !== undefined) {
    const u = findUser(cfg.users, name)
    if (m === "GET") return u === undefined ? uerror(404, `no user ${name}`, cfg) : ureply(200, JSON.stringify({ name: u.name, role: u.role }), cfg)
    if (m === "PUT") return updateUser(cfg, name, body)
    return uerror(405, `method ${m} is not allowed on this route`, cfg)
  }
  if (name === undefined) {
    if (m === "GET") return ureply(200, JSON.stringify({ users: cfg.users.map((u) => view(u)) }), cfg)
    if (m === "POST") return createUser(cfg, body)
    return uerror(405, `method ${m} is not allowed on this route`, cfg)
  }
  if (m === "PUT") return updateUser(cfg, name, body)
  if (m === "DELETE") return deleteUser(cfg, name)
  return uerror(405, `method ${m} is not allowed on this route`, cfg)
}

// The single credential of the old governance.auth_config, as admin users. The
// password gets a random salt, so this throws if the kernel random source fails.
export function fromLegacy(auth: AdminAuthConfig | undefined): RbacConfig throws Error {
  const users: UserConfig[] = []
  if (auth === undefined) return { users: users }
  const t = auth.token
  if (t !== undefined && t !== "") users.push({ name: "legacy-token", role: "admin", token_sha256: hashToken(t) })
  const u = auth.username
  const p = auth.password
  if (u !== undefined && u !== "" && p !== undefined && p !== "") {
    const salt = try secureHex(16)
    users.push({ name: u, role: "admin", salt: salt, password_sha256: hashPassword(salt, p) })
  }
  return { users: users }
}

// ---- tests ----

function hdr(v: string): Map<string, string> {
  const m = new Map<string, string>()
  m.set("authorization", v)
  return m
}

function basic(name: string, pw: string): Map<string, string> {
  return hdr("Basic " + encode(utf8(name + ":" + pw)))
}

function who(i: Identity): string {
  if (i.kind === "user") return "user " + i.name + " " + i.role
  if (i.kind === "anonymous") return "anonymous"
  return "denied"
}

function statusOf(v: Verdict): int {
  return v.kind === "error" ? v.status : 200
}

function actorOf(v: Verdict): string {
  return v.kind === "ok" ? v.actor : ""
}

function fixture(): RbacConfig {
  return {
    users: [
      { name: "root", role: "admin", token_sha256: hashToken("sk-root-token") },
      { name: "ed", role: "editor", salt: "salt1", password_sha256: hashPassword("salt1", "ed-pass") },
      { name: "vi", role: "viewer", token_sha256: hashToken("sk-view-token") },
      { name: "au", role: "auditor", salt: "salt2", password_sha256: hashPassword("salt2", "au-pass") },
      { name: "gone", role: "editor", token_sha256: hashToken("sk-gone"), disabled: true },
    ],
  }
}

type Made = { name: string, role: string, disabled: bool, token: string }

test("bearer tokens authenticate and wrong ones are denied", () => {
  const cfg = fixture()
  expect(who(authenticate(cfg, hdr("Bearer sk-root-token")))).toBe("user root admin")
  expect(who(authenticate(cfg, hdr("bearer sk-view-token")))).toBe("user vi viewer")
  expect(who(authenticate(cfg, hdr("Bearer sk-root-toke")))).toBe("denied")
  expect(who(authenticate(cfg, hdr("Bearer sk-root-tokenX")))).toBe("denied")
  expect(who(authenticate(cfg, hdr("Bearer ")))).toBe("denied")
  expect(who(authenticate(cfg, hdr("Basic !!!")))).toBe("denied")
  expect(who(authenticate(cfg, hdr("Token sk-root-token")))).toBe("denied")
})

test("basic credentials check the salted password", () => {
  const cfg = fixture()
  expect(who(authenticate(cfg, basic("ed", "ed-pass")))).toBe("user ed editor")
  expect(who(authenticate(cfg, basic("au", "au-pass")))).toBe("user au auditor")
  expect(who(authenticate(cfg, basic("ed", "wrong")))).toBe("denied")
  expect(who(authenticate(cfg, basic("ed", "")))).toBe("denied")
  expect(who(authenticate(cfg, basic("nobody", "ed-pass")))).toBe("denied")
  expect(who(authenticate(cfg, basic("root", "sk-root-token")))).toBe("denied")
  expect(who(authenticate(cfg, hdr("Basic " + encode(utf8("ed")))))).toBe("denied")
})

test("no credentials is anonymous", () => {
  expect(who(authenticate(fixture(), new Map<string, string>()))).toBe("anonymous")
})

test("disabled users are denied by bearer and by basic", () => {
  const cfg = fixture()
  expect(who(authenticate(cfg, hdr("Bearer sk-gone")))).toBe("denied")
  const off: RbacConfig = { users: [{ name: "ed", role: "editor", salt: "s", password_sha256: hashPassword("s", "pw"), disabled: true }] }
  expect(who(authenticate(off, basic("ed", "pw")))).toBe("denied")
  const r = authenticate(off, basic("ed", "pw"))
  expect(r.kind === "denied" ? r.reason : "").toBe("user is disabled")
})

test("required maps methods and paths to permissions", () => {
  expect(required("GET", "/api/providers")).toBe("read")
  expect(required("head", "/api/config")).toBe("read")
  expect(required("GET", "/api/logs?limit=5")).toBe("audit")
  expect(required("GET", "/api/audit-logs/export")).toBe("audit")
  expect(required("POST", "/api/logs")).toBe("write")
  expect(required("POST", "/api/providers/openai/keys")).toBe("write")
  expect(required("DELETE", "/api/governance/budgets/b1")).toBe("write")
  expect(required("GET", "/api/users")).toBe("manage_users")
  expect(required("POST", "/api/users")).toBe("manage_users")
  expect(required("DELETE", "/api/users/bob")).toBe("manage_users")
})

test("allowed matrix for every role", () => {
  // admin
  expect(allowed("admin", "manage_users", "/api/users")).toBe(true)
  expect(allowed("admin", "write", "/api/config")).toBe(true)
  expect(allowed("admin", "read", "/api/secrets/x")).toBe(true)
  // editor
  expect(allowed("editor", "read", "/api/providers")).toBe(true)
  expect(allowed("editor", "read", "/api/config")).toBe(true)
  expect(allowed("editor", "audit", "/api/logs")).toBe(true)
  expect(allowed("editor", "write", "/api/providers/openai/keys")).toBe(true)
  expect(allowed("editor", "write", "/api/governance/virtual-keys/vk1")).toBe(true)
  expect(allowed("editor", "write", "/api/governance/budgets")).toBe(true)
  expect(allowed("editor", "write", "/api/governance/rate-limits")).toBe(true)
  expect(allowed("editor", "write", "/api/governance/teams")).toBe(true)
  expect(allowed("editor", "write", "/api/governance/customers/c1")).toBe(true)
  expect(allowed("editor", "write", "/api/governance/usage")).toBe(false)
  expect(allowed("editor", "write", "/api/config")).toBe(false)
  expect(allowed("editor", "write", "/api/logs")).toBe(false)
  expect(allowed("editor", "manage_users", "/api/users")).toBe(false)
  // viewer
  expect(allowed("viewer", "read", "/api/providers")).toBe(true)
  expect(allowed("viewer", "read", "/api/config")).toBe(true)
  expect(allowed("viewer", "read", "/api/governance/virtual-keys")).toBe(true)
  expect(allowed("viewer", "audit", "/api/logs")).toBe(true)
  expect(allowed("viewer", "read", "/api/providers/openai/reveal")).toBe(false)
  expect(allowed("viewer", "read", "/api/secrets")).toBe(false)
  expect(allowed("viewer", "write", "/api/providers/openai")).toBe(false)
  expect(allowed("viewer", "write", "/api/config")).toBe(false)
  expect(allowed("viewer", "manage_users", "/api/users")).toBe(false)
  // auditor
  expect(allowed("auditor", "audit", "/api/logs")).toBe(true)
  expect(allowed("auditor", "audit", "/api/audit-logs")).toBe(true)
  expect(allowed("auditor", "read", "/api/providers")).toBe(false)
  expect(allowed("auditor", "read", "/api/config")).toBe(false)
  expect(allowed("auditor", "audit", "/api/providers")).toBe(false)
  expect(allowed("auditor", "write", "/api/logs")).toBe(false)
  expect(allowed("auditor", "manage_users", "/api/users")).toBe(false)
  // not under /api: admin only
  expect(allowed("viewer", "read", "/v1/models")).toBe(false)
  expect(allowed("admin", "read", "/v1/models")).toBe(true)
})

test("authorize returns 401 for missing or bad credentials and 403 for a role", () => {
  const cfg = fixture()
  const none = new Map<string, string>()
  expect(statusOf(authorize(cfg, none, "GET", "/api/providers"))).toBe(401)
  expect(statusOf(authorize(cfg, hdr("Bearer nope"), "GET", "/api/providers"))).toBe(401)
  expect(statusOf(authorize(cfg, hdr("Bearer sk-gone"), "GET", "/api/providers"))).toBe(401)
  expect(statusOf(authorize(cfg, hdr("Bearer sk-view-token"), "POST", "/api/providers"))).toBe(403)
  expect(statusOf(authorize(cfg, hdr("Bearer sk-view-token"), "GET", "/api/providers"))).toBe(200)
  expect(actorOf(authorize(cfg, hdr("Bearer sk-view-token"), "GET", "/api/providers"))).toBe("vi")
  expect(statusOf(authorize(cfg, basic("ed", "ed-pass"), "PUT", "/api/users/au"))).toBe(403)
  expect(statusOf(authorize(cfg, basic("ed", "ed-pass"), "PUT", "/api/providers/openai"))).toBe(200)
  expect(statusOf(authorize(cfg, basic("au", "au-pass"), "GET", "/api/providers"))).toBe(403)
  expect(statusOf(authorize(cfg, basic("au", "au-pass"), "GET", "/api/logs"))).toBe(200)
  expect(statusOf(authorize(cfg, hdr("Bearer sk-root-token"), "DELETE", "/api/users/au"))).toBe(200)
})

test("handleUsers lists without hashes and creates a token shown once", () => {
  const cfg: RbacConfig = { users: [{ name: "root", role: "admin", token_sha256: hashToken("sk-root-token") }] }
  const list = handleUsers(cfg, "GET", "/api/users", "")
  expect(list.status).toBe(200)
  expect(list.body.includes("root")).toBe(true)
  expect(list.body.includes("token_sha256")).toBe(false)
  expect(list.body.includes(hashToken("sk-root-token"))).toBe(false)

  const made = handleUsers(cfg, "POST", "/api/users", "{\"name\":\"bob\",\"role\":\"viewer\"}")
  expect(made.status).toBe(201)
  const body = try JSON.parse(made.body) as Made
  expect(body.token.startsWith("sk-admin-")).toBe(true)
  expect(body.token.byteLength).toBe(9 + 40)
  expect(JSON.stringify(made.cfg).includes(body.token)).toBe(false)
  expect(who(authenticate(made.cfg, hdr("Bearer " + body.token)))).toBe("user bob viewer")
  expect(statusOf(authorize(made.cfg, hdr("Bearer " + body.token), "GET", "/api/providers"))).toBe(200)
  expect(statusOf(authorize(made.cfg, hdr("Bearer " + body.token), "POST", "/api/providers"))).toBe(403)
  const after = handleUsers(made.cfg, "GET", "/api/users", "")
  expect(after.body.includes(body.token)).toBe(false)
  expect(after.body.includes("bob")).toBe(true)

  expect(handleUsers(made.cfg, "POST", "/api/users", "{\"name\":\"bob\",\"role\":\"editor\"}").status).toBe(409)
  expect(handleUsers(made.cfg, "POST", "/api/users", "{\"name\":\"x\",\"role\":\"root\"}").status).toBe(400)
  expect(handleUsers(made.cfg, "POST", "/api/users", "{\"name\":\"Bad Name\",\"role\":\"viewer\"}").status).toBe(400)
  expect(handleUsers(made.cfg, "POST", "/api/users", "not json").status).toBe(400)
  expect(handleUsers(made.cfg, "PATCH", "/api/users", "{}").status).toBe(405)
  expect(handleUsers(made.cfg, "GET", "/api/users/a/b", "").status).toBe(404)
})

test("handleUsers updates role and disabled, then deletes", () => {
  const cfg: RbacConfig = {
    users: [
      { name: "root", role: "admin", token_sha256: hashToken("sk-root-token") },
      { name: "bob", role: "viewer", token_sha256: hashToken("sk-bob") },
    ],
  }
  const up = handleUsers(cfg, "PUT", "/api/users/bob", "{\"role\":\"editor\"}")
  expect(up.status).toBe(200)
  expect(who(authenticate(up.cfg, hdr("Bearer sk-bob")))).toBe("user bob editor")
  expect(up.body.includes("token_sha256")).toBe(false)
  const off = handleUsers(up.cfg, "PUT", "/api/users/bob", "{\"disabled\":true}")
  expect(off.status).toBe(200)
  expect(who(authenticate(off.cfg, hdr("Bearer sk-bob")))).toBe("denied")
  expect(handleUsers(off.cfg, "PUT", "/api/users/bob", "{\"role\":\"superuser\"}").status).toBe(400)
  expect(handleUsers(off.cfg, "PUT", "/api/users/nobody", "{}").status).toBe(404)
  expect(handleUsers(off.cfg, "PUT", "/api/users/bob", "nope").status).toBe(400)
  const gone = handleUsers(off.cfg, "DELETE", "/api/users/bob", "")
  expect(gone.status).toBe(200)
  expect(handleUsers(gone.cfg, "DELETE", "/api/users/bob", "").status).toBe(404)
  expect(gone.cfg.users.length).toBe(1)
})

test("the last enabled admin cannot be deleted, demoted or disabled", () => {
  const only: RbacConfig = { users: [{ name: "root", role: "admin", token_sha256: hashToken("sk-root") }] }
  expect(handleUsers(only, "DELETE", "/api/users/root", "").status).toBe(409)
  expect(handleUsers(only, "PUT", "/api/users/root", "{\"role\":\"editor\"}").status).toBe(409)
  expect(handleUsers(only, "PUT", "/api/users/root", "{\"disabled\":true}").status).toBe(409)
  expect(handleUsers(only, "PUT", "/api/users/root", "{\"role\":\"admin\"}").status).toBe(200)

  // a disabled admin does not count as a remaining admin
  const withOff: RbacConfig = {
    users: [
      { name: "root", role: "admin", token_sha256: hashToken("sk-root") },
      { name: "old", role: "admin", token_sha256: hashToken("sk-old"), disabled: true },
    ],
  }
  expect(handleUsers(withOff, "DELETE", "/api/users/root", "").status).toBe(409)
  expect(handleUsers(withOff, "DELETE", "/api/users/old", "").status).toBe(200)

  // with a second enabled admin, either one can go
  const two = handleUsers(only, "POST", "/api/users", "{\"name\":\"root2\",\"role\":\"admin\"}")
  expect(two.status).toBe(201)
  const first = handleUsers(two.cfg, "DELETE", "/api/users/root", "")
  expect(first.status).toBe(200)
  expect(handleUsers(first.cfg, "DELETE", "/api/users/root2", "").status).toBe(409)
})

test("fromLegacy turns the old token or user and password into admin users", () => {
  expect(try fromLegacy(undefined).users.length).toBe(0)
  expect(try fromLegacy({}).users.length).toBe(0)
  expect(try fromLegacy({ username: "admin" }).users.length).toBe(0)

  const tok = try fromLegacy({ token: "tok-legacy" })
  expect(tok.users.length).toBe(1)
  expect(tok.users[0]!.role).toBe("admin")
  expect(tok.users[0]!.password_sha256 === undefined).toBe(true)
  expect(who(authenticate(tok, hdr("Bearer tok-legacy")))).toBe("user legacy-token admin")
  expect(who(authenticate(tok, hdr("Bearer tok-legacy2")))).toBe("denied")

  const pw = try fromLegacy({ username: "admin", password: "secret" })
  expect(who(authenticate(pw, basic("admin", "secret")))).toBe("user admin admin")
  expect(who(authenticate(pw, basic("admin", "wrong")))).toBe("denied")
  expect(who(authenticate(pw, hdr("Bearer secret")))).toBe("denied")

  const both = try fromLegacy({ username: "admin", password: "secret", token: "tok" })
  expect(both.users.length).toBe(2)
  expect(who(authenticate(both, hdr("Bearer tok")))).toBe("user legacy-token admin")
  expect(who(authenticate(both, basic("admin", "secret")))).toBe("user admin admin")
})

test("sign-in identities can be users, and provisioned ones are found", () => {
  const made = try handleUsers({ users: [] }, "POST", "/api/users", "{\"name\":\"alice@example.com\",\"role\":\"editor\"}")
  expect(made.status).toBe(201)
  const cfg = made.cfg
  const u = provisioned(cfg, "Alice@Example.com")
  expect(u === undefined ? "" : u.role).toBe("editor")
  expect(provisioned(cfg, "bob@example.com") === undefined).toBe(true)
  // a disabled user is named by its email; a sign-in no user holds is not disabled
  const off: RbacConfig = { users: [{ name: "alice@example.com", role: "editor", disabled: true }, { name: "bob@example.com", role: "viewer" }], roles: [] }
  expect(disabledNamed(off, ["sub-1", "alice@example.com"])).toBe(true)
  expect(disabledNamed(off, ["sub-1", "bob@example.com"])).toBe(false)
  expect(disabledNamed(off, ["carol@example.com", "sub-3"])).toBe(false)
  const none: RbacConfig = { users: [], roles: [] }
  expect(disabledNamed(none, ["alice@example.com"])).toBe(false)
  expect(handleUsers(cfg, "POST", "/api/users", "{\"name\":\"a b@x\",\"role\":\"viewer\"}").status).toBe(400)
})

test("a user's role can be set by role id, and a role change keeps the rest of the user's record", () => {
  const roles: RoleConfig[] = [{ id: 4, name: "ops", permissions: [] }]
  const cfg: RbacConfig = { users: [{ name: "root", role: "admin", token_sha256: hashToken("sk-root") }, { name: "bob", role: "viewer", teams: ["t1"], access_profile_ids: ["p-one"] }], roles: roles }
  const byId = handleUsers(cfg, "PUT", "/api/users/bob/role", `{"role_id":4}`)
  expect(byId.status).toBe(200)
  const bob = findUser(byId.cfg.users, "bob")!
  expect(bob.role).toBe("ops")
  expect((bob.access_profile_ids ?? []).join(",")).toBe("p-one")
  expect((bob.teams ?? []).join(",")).toBe("t1")
  expect(handleUsers(cfg, "PUT", "/api/users/bob/role", `{"role_id":9}`).status).toBe(400)
  expect(handleUsers(cfg, "PUT", "/api/users/bob/role", `{"role":"nope"}`).status).toBe(400)
})

test("custom roles hold resource and operation pairs and reach only the management API", () => {
  const roles: RoleConfig[] = [{ name: "ops", permissions: [{ resource: "VirtualKeys", operation: "View" }, { resource: "Logs", operation: "View" }, { resource: "Teams", operation: "Update" }] }]
  expect(roleAllows(roles, "ops", "GET", "/api/governance/virtual-keys")).toBe(true)
  expect(roleAllows(roles, "ops", "POST", "/api/governance/virtual-keys")).toBe(false)
  expect(roleAllows(roles, "ops", "PUT", "/api/governance/teams/t1")).toBe(true)
  expect(roleAllows(roles, "ops", "DELETE", "/api/governance/teams/t1")).toBe(false)
  expect(roleAllows(roles, "ops", "GET", "/api/users")).toBe(false)
  expect(roleAllows(roles, "ops", "GET", "/api/logs/histogram")).toBe(true)
  expect(roleAllows(roles, "ops", "GET", "/api/roles")).toBe(false)
  expect(roleAllows(roles, "ops", "GET", "/v1/chat/completions")).toBe(false)
  expect(roleAllows(roles, "ghost", "GET", "/api/governance/teams")).toBe(false)
  // built-in roles keep their fixed rules
  expect(roleAllows(roles, "viewer", "GET", "/api/governance/teams")).toBe(true)
  expect(roleAllows(roles, "viewer", "POST", "/api/governance/teams")).toBe(false)
  expect(roleAllows(roles, "admin", "DELETE", "/api/governance/teams/t1")).toBe(true)
})

test("resourceOf names the Bifrost resource and the operation for a route", () => {
  expect(resourceOf("GET", "/api/governance/projects").resource).toBe("Projects")
  expect(resourceOf("POST", "/api/governance/projects").op).toBe("Create")
  expect(resourceOf("PUT", "/api/governance/business-units/bu1").resource).toBe("BusinessUnits")
  expect(resourceOf("DELETE", "/api/roles/ops").resource).toBe("RBAC")
  expect(resourceOf("GET", "/api/governance/budgets").resource).toBe("Governance")
  // the governance-scoped role routes are RBAC, as /api/roles is: Governance rights do not edit roles
  expect(resourceOf("PUT", "/api/governance/rbac/roles/r1").resource).toBe("RBAC")
  expect(resourceOf("GET", "/api/governance/rbac/roles/r1/permissions").resource).toBe("RBAC")
  expect(resourceOf("GET", "/api/providers/openai/keys/k1/secrets").op).toBe("Reveal")
  // the crew routing screens: reads need Crews View, the assign, outcome and next calls Crews Create
  expect(resourceOf("GET", "/api/crews").resource).toBe("Crews")
  expect(resourceOf("GET", "/api/crews/tasks/t1?pool=p").op).toBe("View")
  expect(resourceOf("POST", "/api/crews/p/assign").op).toBe("Create")
  expect(resourceOf("POST", "/api/crews/tasks/t1/next?pool=p").resource).toBe("Crews")
})

test("a custom role can be assigned to a user, and an unknown role cannot", () => {
  const roles: RoleConfig[] = [{ name: "ops", permissions: [{ resource: "Teams", operation: "View" }] }]
  const cfg: RbacConfig = { users: [], roles: roles }
  expect(handleUsers(cfg, "POST", "/api/users", `{"name":"ann","role":"ops"}`).status).toBe(201)
  expect(handleUsers(cfg, "POST", "/api/users", `{"name":"bob","role":"ghost"}`).status).toBe(400)
})

test("a management API key is checked by its own permissions, and an expired one is refused", () => {
  const value = "bfst-" + "0123456789abcdef0123456789abcdef01234567"
  const cfg: RbacConfig = {
    users: fixture().users,
    api_keys: [
      { id: 1, name: "reader", key_sha256: hashToken(value), key_prefix: "bfst-01234567...", permissions: [{ resource: "Logs", operation: "View" }], created_at: "2030-01-01T00:00:00Z", updated_at: "2030-01-01T00:00:00Z" },
      { id: 2, name: "old", key_sha256: hashToken("bfst-expired"), key_prefix: "bfst-expired...", permissions: [{ resource: "Logs", operation: "View" }], expires_at: "2001-01-01T00:00:00Z", created_at: "2030-01-01T00:00:00Z", updated_at: "2030-01-01T00:00:00Z" },
    ],
  }
  expect(statusOf(authorize(cfg, hdr("Bearer " + value), "GET", "/api/logs"))).toBe(200)
  expect(actorOf(authorize(cfg, hdr("Bearer " + value), "GET", "/api/logs"))).toBe("key:reader")
  // the key holds Logs:View only: no write, no other resource
  expect(statusOf(authorize(cfg, hdr("Bearer " + value), "DELETE", "/api/logs"))).toBe(403)
  expect(statusOf(authorize(cfg, hdr("Bearer " + value), "GET", "/api/providers"))).toBe(403)
  expect(statusOf(authorize(cfg, hdr("Bearer " + value), "GET", "/api/users/me/permissions"))).toBe(200)
  // a route outside /api is never a key's
  expect(statusOf(authorize(cfg, hdr("Bearer " + value), "GET", "/v1/models"))).toBe(403)
  // an expired key is refused as unauthenticated
  expect(statusOf(authorize(cfg, hdr("Bearer bfst-expired"), "GET", "/api/logs"))).toBe(401)
  // a value that names no key falls through to the users
  expect(statusOf(authorize(cfg, hdr("Bearer sk-root-token"), "GET", "/api/providers"))).toBe(200)
  expect(statusOf(authorize(cfg, hdr("Bearer bfst-nope"), "GET", "/api/logs"))).toBe(401)
})

test("the management API keys are for the admin and a custom role, not the editor, viewer or auditor", () => {
  expect(allowed("editor", "read", "/api/api-keys")).toBe(false)
  expect(allowed("viewer", "read", "/api/api-keys")).toBe(false)
  expect(allowed("admin", "read", "/api/api-keys")).toBe(true)
  expect(resourceOf("POST", "/api/api-keys").resource).toBe("APIKeys")
  expect(resourceOf("POST", "/api/api-keys").op).toBe("Create")
  expect(resourceOf("DELETE", "/api/api-keys/3").op).toBe("Delete")
})

function holds(pairs: PermissionPair[], resource: string, op: string): bool {
  return pairs.some((p) => p.resource === resource && p.operation === op)
}

test("built-in roles have fixed ids, and their rules read as pairs", () => {
  expect(builtinRoleId("admin")).toBe(9001)
  expect(builtinRoleId("auditor")).toBe(9004)
  expect(builtinRoleId("ops")).toBeUndefined()
  expect(builtinRoleName(9003)).toBe("viewer")
  expect(builtinRoleName(1)).toBeUndefined()
  expect(anyRoleId([{ id: 1, name: "ops" }], "ops")).toBe(1)
  expect(anyRoleName([{ id: 1, name: "ops" }], 9002)).toBe("editor")
  const rs = ["Logs", "AuditLogs", "VirtualKeys", "Users", "APIKeys", "ModelProvider"]
  const ops = ["View", "Create", "Update", "Delete", "Reveal", "RunInference"]
  expect(builtinPairs("admin", rs, ops).length).toBe(36)
  const ed = builtinPairs("editor", rs, ops)
  expect(holds(ed, "VirtualKeys", "Create")).toBe(true)
  expect(holds(ed, "ModelProvider", "Reveal")).toBe(false)
  expect(holds(ed, "Users", "View")).toBe(false)
  expect(holds(ed, "AuditLogs", "View")).toBe(false)
  expect(holds(ed, "Logs", "Delete")).toBe(false)
  expect(holds(ed, "VirtualKeys", "RunInference")).toBe(false)
  const vi = builtinPairs("viewer", rs, ops)
  expect(holds(vi, "Logs", "View")).toBe(true)
  expect(holds(vi, "ModelProvider", "Reveal")).toBe(false)
  expect(vi.some((p) => p.operation !== "View")).toBe(false)
  const au = builtinPairs("auditor", rs, ops)
  expect(au.map((p) => p.resource + ":" + p.operation).join(",")).toBe("Logs:View,AuditLogs:View")
  expect(builtinPairs("ops", rs, ops).length).toBe(0)
  expect(builtinRoles(rs, ops).map((r) => `${r.id ?? 0}`).join(",")).toBe("9001,9002,9003,9004")
})

test("custom role ids never take a built-in role's id", () => {
  const out = withRoleIds([{ id: 9000, name: "a" }, { name: "b" }, { id: 9002, name: "c" }])
  expect(out[0]!.id).toBe(9000)
  expect(out[1]!.id).toBe(9005)
  expect(out[2]!.id).toBe(9006)
})

test("a built-in role can be set by its id", () => {
  const cfg: RbacConfig = { users: fixture().users, roles: [{ id: 1, name: "ops" }] }
  const r = handleUsers(cfg, "PUT", "/api/users/ed/role", `{"role_id":9003}`)
  expect(r.status).toBe(200)
  expect(r.body.includes(`"role":"viewer"`)).toBe(true)
  expect(handleUsers(cfg, "PUT", "/api/users/ed/role", `{"role_id":9100}`).status).toBe(400)
})

test("users carry an email address, unique and checked, and are found by it", () => {
  expect(validEmail("ann@example.com")).toBe(true)
  expect(validEmail("ann@example")).toBe(false)
  expect(validEmail("ann example@x.io")).toBe(false)
  expect(validEmail("@x.io")).toBe(false)
  expect(validEmail("a@b@c.io")).toBe(false)
  expect(validEmail("a@.io")).toBe(false)
  const cfg0: RbacConfig = { users: fixture().users }
  const made = handleUsers(cfg0, "POST", "/api/users", `{"name":"ann","role":"viewer","email":"Ann@Example.com"}`)
  expect(made.status).toBe(201)
  expect(made.body.includes(`"email":"Ann@Example.com"`)).toBe(true)
  const cfg = made.cfg
  expect(handleUsers(cfg, "POST", "/api/users", `{"name":"bob","role":"viewer","email":"ann@example.com"}`).status).toBe(409)
  expect(handleUsers(cfg, "POST", "/api/users", `{"name":"bob","role":"viewer","email":"nope"}`).status).toBe(400)
  expect(userByEmail(cfg.users, "ANN@example.com")?.name).toBe("ann")
  expect(userByEmail(cfg.users, "zed@example.com")).toBeUndefined()
  // a role change keeps the email; "" clears it
  const kept = handleUsers(cfg, "PUT", "/api/users/ann", `{"role":"editor"}`)
  expect(kept.body.includes(`"email":"Ann@Example.com"`)).toBe(true)
  expect(handleUsers(kept.cfg, "PUT", "/api/users/vi", `{"email":"ann@example.com"}`).status).toBe(409)
  const cleared = handleUsers(kept.cfg, "PUT", "/api/users/ann", `{"email":""}`)
  expect(cleared.body.includes("email")).toBe(false)
  // a sign-in identity named by its address is found by it
  const id: RbacConfig = { users: [{ name: "zoe@example.com", role: "viewer" }] }
  expect(userByEmail(id.users, "Zoe@example.com")?.name).toBe("zoe@example.com")
})

test("the governance users routes need user management, and the self routes are open to every caller", () => {
  expect(required("GET", "/api/governance/users/email/a%40b.io")).toBe("manage_users")
  expect(resourceOf("GET", "/api/governance/users/email/a%40b.io").resource).toBe("Users")
  expect(statusOf(authorize(fixture(), hdr("Bearer sk-view-token"), "GET", "/api/governance/users/me/permissions"))).toBe(200)
  expect(statusOf(authorize(fixture(), hdr("Bearer sk-view-token"), "GET", "/api/governance/users/email/a%40b.io"))).toBe(403)
  expect(statusOf(authorize(fixture(), hdr("Bearer sk-root-token"), "GET", "/api/governance/users/email/a%40b.io"))).toBe(200)
})

test("an edited built-in role keeps its id and is judged by its saved pairs", () => {
  const roles: RoleConfig[] = [{ name: "ops" }, { name: "viewer", permissions: [{ resource: "Logs", operation: "View" }] }, { id: 3, name: "admin", permissions: [] }]
  const ids = withRoleIds(roles)
  expect(ids[0]!.id).toBe(1)
  expect(ids[1]!.id).toBe(9003)
  expect(ids[2]!.id).toBe(9001)
  expect(customRoles(roles).map((r) => r.name).join(",")).toBe("ops")
  expect(roleAllows(roles, "viewer", "GET", "/api/logs")).toBe(true)
  expect(roleAllows(roles, "viewer", "GET", "/api/providers")).toBe(false)
  // the unedited editor keeps its rules; the admin keeps the routes outside /api
  expect(roleAllows(roles, "editor", "GET", "/api/providers")).toBe(true)
  expect(roleAllows(roles, "admin", "GET", "/api/providers")).toBe(false)
  expect(roleAllows(roles, "admin", "GET", "/v1/models")).toBe(true)
  const rs = ["Logs", "ModelProvider"]
  const ops = ["View", "Update"]
  const vi = systemRole(roles, "viewer", rs, ops)
  expect(vi?.id).toBe(9003)
  expect(vi?.dac).toBe("all-data")
  expect((vi?.permissions ?? []).length).toBe(1)
  expect((systemRole(roles, "editor", rs, ops)?.permissions ?? []).length).toBe(3)
  expect(systemRole(roles, "ops", rs, ops)).toBeUndefined()
})
