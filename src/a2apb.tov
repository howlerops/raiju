// The A2A v1 messages of the gRPC binding, as protobuf and as the JSON the gateway handles.
//
// The messages are the lf.a2a.v1 service of a2a-go v2.5.0 (a2apb/v1, from the descriptor of
// a2av1.proto): every message the eleven methods take or answer, the types they reference, and the
// well-known Struct, Value, ListValue, Timestamp and Empty. SCHEMA_TEXT has a block per message: its
// name, then a line per field with its number, proto name, type, and a flag. The flag is "p" for
// presence (a proto3 optional field) or "o:<group>" for a oneof member. Types are string, bytes,
// bool, int32, enum:<Name>, msg:<Name>, struct, value, listvalue, timestamp and empty, with rep: in
// front of a repeated one and map: in front of a map (followed by the value type). The text is the
// descriptor, generated, not typed by hand; tests/fixtures/a2apb_golden.json holds bytes and JSON
// that protobuf-go and protojson write for realistic messages of every type here.
//
// The JSON side follows protojson. Field names are lowerCamelCase (the proto names are read too),
// enums are their names (numbers are read too), int32 is a number, bytes are base64, a Timestamp is
// RFC 3339 in UTC with 0, 3, 6 or 9 fraction digits, a Struct is a plain object, a Value is any JSON
// value, and a proto3 default is left out of the output unless the field has presence. Encoding
// writes the fields outside a oneof in number order, then the oneof member, and map entries and
// Struct keys in key order: the bytes are protobuf-go's deterministic encoding.
//
// Where Raiju's A2A JSON differs from protojson, the adapters here are: a v0.3 enum spelling is read
// as the v1 name ("user", "agent", "completed", "input-required", ...); a v0.3 file part
// ({kind, file: {bytes, uri, mimeType, name}}) is read as the v1 part (raw, url, mediaType, filename);
// the v0.3 "kind" discriminator is ignored. Unknown JSON keys are ignored on encode (protojson rejects
// them), so an extra field from an agent does not fail a call. Not mapped: the v0.3 envelopes, such as
// a task answered without its {task} wrapper; the caller brings a message to the v1 shape before it encodes.
//
// Not handled: repeated occurrences of a singular message field merge in protobuf but keep the last
// one here; unknown fields are skipped on decode and not kept; groups are an error; float fields are
// not in this schema, so the float helpers in protobuf.tov have no JSON mapping.
import { Field, fields, elements, find, decodeString, quote, build, setField } from "./json"
import { PbWriter, PbReader, packedVarints, int32Of, bitsToDouble, utf8Strict, decimal, toHex, hexBytes } from "./protobuf"
import { readFileSync } from "node:fs"
import { camelOf } from "./a2a"

type FieldDef = { num: int, name: string, json: string, type: string, presence: bool, oneof: string }
type MsgDef = { name: string, fields: FieldDef[] }
type EnumDef = { name: string, prefix: string, names: string[] }

// Nesting limit for messages, Structs and Values: deeper input is an error, not a stack overflow.
const MAX_DEPTH: int = 100

// One block per message: the name, then the fields (number, proto name, type, flag).
function schemaText(): string {
  return `
SendMessageConfiguration
1 accepted_output_modes rep:string
2 task_push_notification_config msg:TaskPushNotificationConfig
3 history_length int32 p
4 return_immediately bool

Task
1 id string
2 context_id string
3 status msg:TaskStatus
4 artifacts rep:msg:Artifact
5 history rep:msg:Message
6 metadata struct

TaskStatus
1 state enum:TaskState
2 message msg:Message
3 timestamp timestamp

Part
1 text string o:content
2 raw bytes o:content
3 url string o:content
4 data value o:content
5 metadata struct
6 filename string
7 media_type string

Message
1 message_id string
2 context_id string
3 task_id string
4 role enum:Role
5 parts rep:msg:Part
6 metadata struct
7 extensions rep:string
8 reference_task_ids rep:string

Artifact
1 artifact_id string
2 name string
3 description string
4 parts rep:msg:Part
5 metadata struct
6 extensions rep:string

TaskStatusUpdateEvent
1 task_id string
2 context_id string
3 status msg:TaskStatus
4 metadata struct

TaskArtifactUpdateEvent
1 task_id string
2 context_id string
3 artifact msg:Artifact
4 append bool
5 last_chunk bool
6 metadata struct

AuthenticationInfo
1 scheme string
2 credentials string

AgentInterface
1 url string
2 protocol_binding string
3 tenant string
4 protocol_version string

AgentCard
1 name string
2 description string
3 supported_interfaces rep:msg:AgentInterface
4 provider msg:AgentProvider
5 version string
6 documentation_url string p
7 capabilities msg:AgentCapabilities
8 security_schemes map:msg:SecurityScheme
9 security_requirements rep:msg:SecurityRequirement
10 default_input_modes rep:string
11 default_output_modes rep:string
12 skills rep:msg:AgentSkill
13 signatures rep:msg:AgentCardSignature
14 icon_url string p

AgentProvider
1 url string
2 organization string

AgentCapabilities
1 streaming bool p
2 push_notifications bool p
3 extensions rep:msg:AgentExtension
4 extended_agent_card bool p

AgentExtension
1 uri string
2 description string
3 required bool
4 params struct

AgentSkill
1 id string
2 name string
3 description string
4 tags rep:string
5 examples rep:string
6 input_modes rep:string
7 output_modes rep:string
8 security_requirements rep:msg:SecurityRequirement

AgentCardSignature
1 protected string
2 signature string
3 header struct

TaskPushNotificationConfig
1 tenant string
2 id string
3 task_id string
4 url string
5 token string
6 authentication msg:AuthenticationInfo

StringList
1 list rep:string

SecurityRequirement
1 schemes map:msg:StringList

SecurityScheme
1 api_key_security_scheme msg:APIKeySecurityScheme o:scheme
2 http_auth_security_scheme msg:HTTPAuthSecurityScheme o:scheme
3 oauth2_security_scheme msg:OAuth2SecurityScheme o:scheme
4 open_id_connect_security_scheme msg:OpenIdConnectSecurityScheme o:scheme
5 mtls_security_scheme msg:MutualTlsSecurityScheme o:scheme

APIKeySecurityScheme
1 description string
2 location string
3 name string

HTTPAuthSecurityScheme
1 description string
2 scheme string
3 bearer_format string

OAuth2SecurityScheme
1 description string
2 flows msg:OAuthFlows
3 oauth2_metadata_url string

OpenIdConnectSecurityScheme
1 description string
2 open_id_connect_url string

MutualTlsSecurityScheme
1 description string

OAuthFlows
1 authorization_code msg:AuthorizationCodeOAuthFlow o:flow
2 client_credentials msg:ClientCredentialsOAuthFlow o:flow
3 implicit msg:ImplicitOAuthFlow o:flow
4 password msg:PasswordOAuthFlow o:flow
5 device_code msg:DeviceCodeOAuthFlow o:flow

AuthorizationCodeOAuthFlow
1 authorization_url string
2 token_url string
3 refresh_url string
4 scopes map:string
5 pkce_required bool

ClientCredentialsOAuthFlow
1 token_url string
2 refresh_url string
3 scopes map:string

ImplicitOAuthFlow
1 authorization_url string
2 refresh_url string
3 scopes map:string

PasswordOAuthFlow
1 token_url string
2 refresh_url string
3 scopes map:string

DeviceCodeOAuthFlow
1 device_authorization_url string
2 token_url string
3 refresh_url string
4 scopes map:string

SendMessageRequest
1 tenant string
2 message msg:Message
3 configuration msg:SendMessageConfiguration
4 metadata struct

GetTaskRequest
1 tenant string
2 id string
3 history_length int32 p

ListTasksRequest
1 tenant string
2 context_id string
3 status enum:TaskState
4 page_size int32 p
5 page_token string
6 history_length int32 p
7 status_timestamp_after timestamp
8 include_artifacts bool p

ListTasksResponse
1 tasks rep:msg:Task
2 next_page_token string
3 page_size int32
4 total_size int32

CancelTaskRequest
1 tenant string
2 id string
3 metadata struct

GetTaskPushNotificationConfigRequest
1 tenant string
2 task_id string
3 id string

DeleteTaskPushNotificationConfigRequest
1 tenant string
2 task_id string
3 id string

SubscribeToTaskRequest
1 tenant string
2 id string

ListTaskPushNotificationConfigsRequest
4 tenant string
1 task_id string
2 page_size int32
3 page_token string

GetExtendedAgentCardRequest
1 tenant string

SendMessageResponse
1 task msg:Task o:payload
2 message msg:Message o:payload

StreamResponse
1 task msg:Task o:payload
2 message msg:Message o:payload
3 status_update msg:TaskStatusUpdateEvent o:payload
4 artifact_update msg:TaskArtifactUpdateEvent o:payload

ListTaskPushNotificationConfigsResponse
1 configs rep:msg:TaskPushNotificationConfig
2 next_page_token string
`
}

// The enums: the name, the prefix of the value names, then the names in number order.
function enumText(): string {
  return `TaskState TASK_STATE TASK_STATE_UNSPECIFIED TASK_STATE_SUBMITTED TASK_STATE_WORKING TASK_STATE_COMPLETED TASK_STATE_FAILED TASK_STATE_CANCELED TASK_STATE_INPUT_REQUIRED TASK_STATE_REJECTED TASK_STATE_AUTH_REQUIRED
Role ROLE ROLE_UNSPECIFIED ROLE_USER ROLE_AGENT`
}

function buildMessages(): Map<string, MsgDef> {
  const out = new Map<string, MsgDef>()
  for (const block of schemaText().split("\n\n")) {
    const lines: string[] = []
    for (const raw of block.split("\n")) {
      const t = raw.trim()
      if (t !== "") lines.push(t)
    }
    if (lines.length === 0) continue
    const defs: FieldDef[] = []
    for (let i = 1; i < lines.length; i++) {
      const p = lines[i]!.split(" ")
      const flag = p.length > 3 ? p[3]! : ""
      const oneof = flag.startsWith("o:") ? flag.slice(2) : ""
      defs.push({ num: decimal(p[0]!), name: p[1]!, json: camelOf(p[1]!), type: p[2]!, presence: flag === "p" || oneof !== "", oneof: oneof })
    }
    defs.sort((a, b) => a.num - b.num)
    out.set(lines[0]!, { name: lines[0]!, fields: defs })
  }
  return out
}

function buildEnums(): Map<string, EnumDef> {
  const out = new Map<string, EnumDef>()
  for (const line of enumText().split("\n")) {
    const p = line.trim().split(" ")
    if (p.length < 3) continue
    out.set(p[0]!, { name: p[0]!, prefix: p[1]!, names: p.slice(2) })
  }
  return out
}

const MESSAGES: Map<string, MsgDef> = buildMessages()
const ENUMS: Map<string, EnumDef> = buildEnums()

// The type spec of a top-level message name ("Task", "lf.a2a.v1.Task", "google.protobuf.Struct").
function specOf(message: string): string throws Error {
  let n = message
  if (n.startsWith("lf.a2a.v1.")) n = n.slice(10)
  if (n.startsWith("google.protobuf.")) n = n.slice(16)
  if (n === "Struct") return "struct"
  if (n === "Value") return "value"
  if (n === "ListValue") return "listvalue"
  if (n === "Timestamp") return "timestamp"
  if (n === "Empty") return "empty"
  if (MESSAGES.has(n)) return "msg:" + n
  throw new Error("protobuf: unknown A2A message " + message)
}

// The request and response messages of each A2A v1 method (the service in a2av1.proto).
export function requestOf(op: string): string {
  if (op === "SendMessage" || op === "SendStreamingMessage") return "SendMessageRequest"
  if (op === "GetTask") return "GetTaskRequest"
  if (op === "ListTasks") return "ListTasksRequest"
  if (op === "CancelTask") return "CancelTaskRequest"
  if (op === "SubscribeToTask") return "SubscribeToTaskRequest"
  if (op === "CreateTaskPushNotificationConfig") return "TaskPushNotificationConfig"
  if (op === "GetTaskPushNotificationConfig") return "GetTaskPushNotificationConfigRequest"
  if (op === "ListTaskPushNotificationConfigs") return "ListTaskPushNotificationConfigsRequest"
  if (op === "DeleteTaskPushNotificationConfig") return "DeleteTaskPushNotificationConfigRequest"
  if (op === "GetExtendedAgentCard") return "GetExtendedAgentCardRequest"
  return ""
}

export function responseOf(op: string): string {
  if (op === "SendMessage") return "SendMessageResponse"
  if (op === "SendStreamingMessage" || op === "SubscribeToTask") return "StreamResponse"
  if (op === "GetTask" || op === "CancelTask") return "Task"
  if (op === "ListTasks") return "ListTasksResponse"
  if (op === "CreateTaskPushNotificationConfig" || op === "GetTaskPushNotificationConfig") return "TaskPushNotificationConfig"
  if (op === "ListTaskPushNotificationConfigs") return "ListTaskPushNotificationConfigsResponse"
  if (op === "DeleteTaskPushNotificationConfig") return "Empty"
  if (op === "GetExtendedAgentCard") return "AgentCard"
  return ""
}

// ---- scalars ----

// The number a JSON value holds: a number, or a numeric string (protojson reads both for int32).
function numberOf(raw: string): f64 throws Error {
  let t = raw
  if (raw.startsWith("\"")) t = try decodeString(raw)
  const x = parseFloat(t)
  if (x === undefined || t.trim() === "" || x !== x) throw new Error("protobuf: expected a number")
  return x
}

function int32Value(raw: string): int throws Error {
  const x = try numberOf(raw)
  if (x !== Math.trunc(x) || x < -2147483648 || x > 2147483647) throw new Error("protobuf: int32 out of range")
  return Math.trunc(x)
}

function strValue(raw: string): string throws Error {
  if (!raw.startsWith("\"")) throw new Error("protobuf: expected a string")
  return try decodeString(raw)
}

function boolValue(raw: string): bool throws Error {
  if (raw === "true") return true
  if (raw === "false") return false
  throw new Error("protobuf: expected a boolean")
}

// An enum from its JSON value: the name, a v0.3 spelling of it (user, input-required), or a number.
function enumValue(en: string, raw: string): int throws Error {
  if (!raw.startsWith("\"")) return try int32Value(raw)
  const name = try decodeString(raw)
  const def = ENUMS.get(en)
  if (def === undefined) throw new Error("protobuf: unknown enum " + en)
  const names = def.names
  for (let i = 0; i < names.length; i++) {
    if (names[i]! === name) return i
  }
  const alias = def.prefix + "_" + name.toUpperCase().replaceAll("-", "_")
  for (let i = 0; i < names.length; i++) {
    if (names[i]! === alias) return i
  }
  throw new Error("protobuf: not a " + en + " name")
}

// The name of an enum number, or undefined for a number the schema does not name.
function enumName(en: string, n: int): string | undefined {
  const def = ENUMS.get(en)
  if (def === undefined || n < 0 || n >= def.names.length) return undefined
  return def.names[n]!
}

// A number or enum as the integer it encodes (the int32 value, or the enum number).
function scalarInt(t: string, raw: string): int throws Error {
  if (t === "int32") return try int32Value(raw)
  return try enumValue(t.slice(5), raw)
}

// ---- base64 (bytes fields) ----

const B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

function b64Encode(b: u8[]): string {
  let out = ""
  let i = 0
  while (i < b.length) {
    const b0 = int(b[i]!)
    const b1 = i + 1 < b.length ? int(b[i + 1]!) : 0
    const b2 = i + 2 < b.length ? int(b[i + 2]!) : 0
    const v = (b0 << 16) | (b1 << 8) | b2
    out += B64.slice((v >> 18) & 63, ((v >> 18) & 63) + 1)
    out += B64.slice((v >> 12) & 63, ((v >> 12) & 63) + 1)
    out += i + 1 < b.length ? B64.slice((v >> 6) & 63, ((v >> 6) & 63) + 1) : "="
    out += i + 2 < b.length ? B64.slice(v & 63, (v & 63) + 1) : "="
    i += 3
  }
  return out
}

function b64Value(c: int): int {
  if (c >= 65 && c <= 90) return c - 65
  if (c >= 97 && c <= 122) return c - 71
  if (c >= 48 && c <= 57) return c + 4
  if (c === 43 || c === 45) return 62
  if (c === 47 || c === 95) return 63
  return -1
}

// Standard or URL-safe base64, padded or not (protojson reads both).
function b64Decode(s: string): u8[] throws Error {
  const out: u8[] = []
  let acc = 0
  let bits = 0
  let n = 0
  for (const c0 of new TextEncoder().encode(s)) {
    const c = int(c0)
    if (c === 61) break
    const v = b64Value(c)
    if (v < 0) throw new Error("protobuf: bytes are not base64")
    acc = ((acc << 6) | v) & 16777215
    bits += 6
    n += 1
    if (bits >= 8) {
      bits -= 8
      out.push(u8((acc >> bits) & 255))
    }
  }
  if (n % 4 === 1) throw new Error("protobuf: bytes are not base64")
  return out
}

// ---- timestamps (RFC 3339, UTC) ----

function daysIn(y: int, m: int): int {
  if (m === 2) return (y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0)) ? 29 : 28
  return m === 4 || m === 6 || m === 9 || m === 11 ? 30 : 31
}

// Days since 1970-01-01 of a civil date (Howard Hinnant's algorithm).
function daysFromCivil(y0: int, m: int, d: int): int {
  const y = m <= 2 ? y0 - 1 : y0
  const era = Math.floor(y / 400)
  const yoe = y - era * 400
  const mp = m > 2 ? m - 3 : m + 9
  const doy = Math.floor((153 * mp + 2) / 5) + d - 1
  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy
  return era * 146097 + doe - 719468
}

function civilFromDays(z0: int): { y: int, m: int, d: int } {
  const z = z0 + 719468
  const era = Math.floor(z / 146097)
  const doe = z - era * 146097
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365)
  const y = yoe + era * 400
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100))
  const mp = Math.floor((5 * doy + 2) / 153)
  const d = doy - Math.floor((153 * mp + 2) / 5) + 1
  const m = mp < 10 ? mp + 3 : mp - 9
  return { y: m <= 2 ? y + 1 : y, m: m, d: d }
}

// n digits at byte i, as a number.
function digitsAt(b: u8[], i: int, n: int): int throws Error {
  if (i + n > b.length) throw new Error("protobuf: bad timestamp")
  let v = 0
  for (let k = i; k < i + n; k++) {
    const c = int(b[k]!)
    if (c < 48 || c > 57) throw new Error("protobuf: bad timestamp")
    v = v * 10 + (c - 48)
  }
  return v
}

// RFC 3339 text to Unix seconds and nanoseconds. Offsets are allowed; the result is UTC.
function parseTimestamp(s: string): { sec: int, nanos: int } throws Error {
  const b = new TextEncoder().encode(s)
  const at = (i: int): int => (i < b.length ? int(b[i]!) : 0)
  if (b.length < 20) throw new Error("protobuf: bad timestamp")
  const y = try digitsAt(b, 0, 4)
  const mo = try digitsAt(b, 5, 2)
  const d = try digitsAt(b, 8, 2)
  const h = try digitsAt(b, 11, 2)
  const mi = try digitsAt(b, 14, 2)
  const se = try digitsAt(b, 17, 2)
  if (at(4) !== 45 || at(7) !== 45 || (at(10) !== 84 && at(10) !== 116) || at(13) !== 58 || at(16) !== 58) throw new Error("protobuf: bad timestamp")
  if (y < 1 || mo < 1 || mo > 12 || d < 1 || d > daysIn(y, mo) || h > 23 || mi > 59 || se > 59) throw new Error("protobuf: timestamp out of range")
  let i = 19
  let nanos = 0
  if (at(i) === 46) {
    i += 1
    let digits = 0
    while (at(i) >= 48 && at(i) <= 57) {
      if (digits === 9) throw new Error("protobuf: timestamp has more than 9 fraction digits")
      nanos = nanos * 10 + (at(i) - 48)
      digits += 1
      i += 1
    }
    if (digits === 0) throw new Error("protobuf: bad timestamp")
    for (let k = digits; k < 9; k++) nanos = nanos * 10
  }
  let off = 0
  const z = at(i)
  if (z === 90 || z === 122) {
    i += 1
  } else if (z === 43 || z === 45) {
    const oh = try digitsAt(b, i + 1, 2)
    const om = try digitsAt(b, i + 4, 2)
    if (at(i + 3) !== 58 || oh > 23 || om > 59) throw new Error("protobuf: bad timestamp offset")
    off = (oh * 3600 + om * 60) * (z === 43 ? 1 : -1)
    i += 6
  } else {
    throw new Error("protobuf: bad timestamp")
  }
  if (i !== b.length) throw new Error("protobuf: bad timestamp")
  const sec = daysFromCivil(y, mo, d) * 86400 + h * 3600 + mi * 60 + se - off
  return { sec: sec, nanos: nanos }
}

function pad(n: int, width: int): string {
  let s = `${n}`
  while (s.byteLength < width) s = "0" + s
  return s
}

// Unix seconds and nanoseconds to RFC 3339 text in UTC, with the fraction in 0, 3, 6 or 9 digits.
function formatTimestamp(sec: int, nanos: int): string throws Error {
  const days = Math.floor(sec / 86400)
  const sod = sec - days * 86400
  const c = civilFromDays(days)
  if (c.y < 1 || c.y > 9999) throw new Error("protobuf: timestamp out of range")
  let s = pad(c.y, 4) + "-" + pad(c.m, 2) + "-" + pad(c.d, 2) + "T" + pad(Math.floor(sod / 3600), 2) + ":" + pad(Math.floor((sod % 3600) / 60), 2) + ":" + pad(sod % 60, 2)
  if (nanos !== 0) {
    if (nanos % 1000000 === 0) s += "." + pad(Math.floor(nanos / 1000000), 3)
    else if (nanos % 1000 === 0) s += "." + pad(Math.floor(nanos / 1000), 6)
    else s += "." + pad(nanos, 9)
  }
  return s + "Z"
}

// ---- JSON to protobuf ----

function objectFields(raw: string): Field[] throws Error {
  if (!raw.trim().startsWith("{")) throw new Error("protobuf: expected a JSON object")
  return try fields(raw.trim())
}

function arrayItems(raw: string): string[] throws Error {
  if (!raw.trim().startsWith("[")) throw new Error("protobuf: expected a JSON array")
  return try elements(raw.trim())
}

// Map entries and Struct keys in key order, as protobuf-go's deterministic encoding writes them.
function sortedByKey(es: Field[]): Field[] {
  const out = es.slice()
  out.sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0))
  return out
}

// The v0.3 file part as a v1 part: {kind, file: {bytes|uri, mimeType, name}} becomes raw or url,
// mediaType and filename. Other parts pass as they are.
function partOfV03(fs: Field[]): Field[] {
  const file = find(fs, "file")
  if (file === undefined || !file.startsWith("{")) return fs
  const ff = try fields(file)
  const out: Field[] = []
  for (const f of fs) {
    if (f.key !== "file" && f.key !== "kind") out.push(f)
  }
  for (const g of ff) {
    if (g.key === "bytes") out.push({ key: "raw", raw: g.raw })
    else if (g.key === "uri") out.push({ key: "url", raw: g.raw })
    else if (g.key === "mimeType") out.push({ key: "mediaType", raw: g.raw })
    else if (g.key === "name") out.push({ key: "filename", raw: g.raw })
  }
  return out
}

// Writes one value of a type under its field number. keep writes a default too (a field with
// presence, a repeated element, a map value).
function putValue(t: string, raw: string, num: int, w: PbWriter, depth: int, keep: bool): void throws Error {
  if (t === "string") {
    const s = try strValue(raw)
    if (s !== "" || keep) w.str(num, s)
    return
  }
  if (t === "bytes") {
    const b = try b64Decode(try strValue(raw))
    if (b.length > 0 || keep) w.bytes(num, b)
    return
  }
  if (t === "bool") {
    const v = try boolValue(raw)
    if (v || keep) w.bool(num, v)
    return
  }
  if (t === "int32" || t.startsWith("enum:")) {
    const n = try scalarInt(t, raw)
    if (n !== 0 || keep) w.u(num, n)
    return
  }
  const inner = new PbWriter()
  try encodeBody(t, raw, inner, depth + 1)
  w.bytes(num, inner.buf)
}

function putField(num: int, t: string, presence: bool, raw: string, w: PbWriter, depth: int): void throws Error {
  if (t.startsWith("map:")) {
    const vt = t.slice(4)
    for (const e of sortedByKey(try objectFields(raw))) {
      const inner = new PbWriter()
      inner.str(1, e.key)
      try putValue(vt, e.raw, 2, inner, depth, true)
      w.bytes(num, inner.buf)
    }
    return
  }
  if (t.startsWith("rep:")) {
    const el = t.slice(4)
    const items = try arrayItems(raw)
    if (el === "int32" || el === "bool" || el.startsWith("enum:")) {
      const inner = new PbWriter()
      for (const it of items) {
        if (el === "bool") {
          const bv = try boolValue(it)
          inner.varint(bv ? 1 : 0)
        } else {
          inner.varint(try scalarInt(el, it))
        }
      }
      if (items.length > 0) w.bytes(num, inner.buf)
      return
    }
    for (const it of items) {
      try putValue(el, it, num, w, depth, true)
    }
    return
  }
  try putValue(t, raw, num, w, depth, presence)
}

// Writes a Value's body: the JSON value in the one field its kind takes.
function encodeValue(raw: string, w: PbWriter, depth: int): void throws Error {
  const t = raw.trim()
  if (t === "null") {
    w.u(1, 0)
  } else if (t === "true" || t === "false") {
    w.bool(4, t === "true")
  } else if (t.startsWith("\"")) {
    w.str(3, try decodeString(t))
  } else if (t.startsWith("{")) {
    const inner = new PbWriter()
    try encodeBody("struct", t, inner, depth + 1)
    w.bytes(5, inner.buf)
  } else if (t.startsWith("[")) {
    const inner = new PbWriter()
    try encodeBody("listvalue", t, inner, depth + 1)
    w.bytes(6, inner.buf)
  } else {
    w.double(2, try numberOf(t))
  }
}

// Writes the body of a message-typed value (a message, or a well-known type) from its JSON.
function encodeBody(t: string, raw: string, w: PbWriter, depth: int): void throws Error {
  if (depth > MAX_DEPTH) throw new Error("protobuf: message nested too deeply")
  if (t.startsWith("msg:")) {
    try encodeMessage(t.slice(4), raw, w, depth)
    return
  }
  if (t === "struct") {
    for (const e of sortedByKey(try objectFields(raw))) {
      const inner = new PbWriter()
      inner.str(1, e.key)
      const vi = new PbWriter()
      try encodeBody("value", e.raw, vi, depth + 1)
      inner.bytes(2, vi.buf)
      w.bytes(1, inner.buf)
    }
    return
  }
  if (t === "value") {
    try encodeValue(raw, w, depth)
    return
  }
  if (t === "listvalue") {
    for (const it of try arrayItems(raw)) {
      const vi = new PbWriter()
      try encodeBody("value", it, vi, depth + 1)
      w.bytes(1, vi.buf)
    }
    return
  }
  if (t === "timestamp") {
    const ts = try parseTimestamp(try strValue(raw))
    if (ts.sec !== 0) w.u(1, ts.sec)
    if (ts.nanos !== 0) w.u(2, ts.nanos)
    return
  }
  if (t === "empty") {
    const ef = try objectFields(raw)
    if (ef.length > 0) throw new Error("protobuf: Empty takes no fields")
    return
  }
  throw new Error("protobuf: unknown type " + t)
}

function encodeMessage(name: string, raw: string, w: PbWriter, depth: int): void throws Error {
  const def = MESSAGES.get(name)
  if (def === undefined) throw new Error("protobuf: unknown A2A message " + name)
  let fs = try objectFields(raw)
  if (name === "Part") fs = try partOfV03(fs)
  const seen = new Set<string>()
  // protobuf-go writes the fields outside a oneof first (by number), then the oneof members (by
  // number). Every message here has at most one oneof, so that is one pass of each.
  for (let pass = 0; pass < 2; pass++) {
    for (const fd of def.fields) {
      if ((fd.oneof !== "") !== (pass === 1)) continue
      const v: string | undefined = find(fs, fd.json) ?? find(fs, fd.name)
      if (v === undefined || v === "null") continue
      if (fd.oneof !== "") {
        if (seen.has(fd.oneof)) throw new Error("protobuf: more than one " + fd.oneof + " member is set")
        seen.add(fd.oneof)
      }
      try putField(fd.num, fd.type, fd.presence, v, w, depth)
    }
  }
}

// ---- protobuf to JSON ----

function low32Text(t: string, v: int): string {
  if (t.startsWith("enum:")) {
    const n = int32Of(v)
    const name = enumName(t.slice(5), n)
    return name === undefined ? `${n}` : quote(name)
  }
  return `${int32Of(v)}`
}

// The JSON of a number field's value text, with protojson's words for the non-finite values.
function numberText(x: f64): string {
  if (x !== x) return "\"NaN\""
  if (x - x !== 0) return x > 0 ? "\"Infinity\"" : "\"-Infinity\""
  return `${x}`
}

// The JSON text of a value one occurrence of a field holds, read from the reader.
function decodeOne(t: string, r: PbReader, wire: int, depth: int): string throws Error {
  if (t === "string") {
    if (wire !== 2) throw new Error("protobuf: wrong wire type for a string")
    return quote(try utf8Strict(try r.bytes()))
  }
  if (t === "bytes") {
    if (wire !== 2) throw new Error("protobuf: wrong wire type for bytes")
    return quote(b64Encode(try r.bytes()))
  }
  if (t === "bool") {
    if (wire !== 0) throw new Error("protobuf: wrong wire type for a bool")
    return (try r.varint()) !== 0 ? "true" : "false"
  }
  if (t === "int32" || t.startsWith("enum:")) {
    if (wire !== 0) throw new Error("protobuf: wrong wire type for an int32 or enum")
    return low32Text(t, try r.varint())
  }
  if (wire !== 2) throw new Error("protobuf: wrong wire type for a message")
  return try decodeBody(t, try r.bytes(), depth + 1)
}

function isScalar(t: string): bool {
  return t === "string" || t === "bytes" || t === "bool" || t === "int32" || t.startsWith("enum:")
}

// The JSON text a type takes when the message does not set it.
function defaultText(t: string, depth: int): string throws Error {
  if (t === "string" || t === "bytes") return "\"\""
  if (t === "bool") return "false"
  if (t === "int32") return "0"
  if (t.startsWith("enum:")) {
    const name = enumName(t.slice(5), 0)
    return name === undefined ? "0" : quote(name)
  }
  return try decodeBody(t, [], depth + 1)
}

// One entry of a map (key 1, value 2), or of a Struct: its key and the JSON value.
function decodeEntry(vt: string, data: u8[], depth: int): Field throws Error {
  const r = new PbReader(data)
  let key = ""
  let val: string | undefined = undefined
  while (r.more()) {
    const k = try r.key()
    if (k.field === 1) {
      if (k.wire !== 2) throw new Error("protobuf: wrong wire type for a map key")
      key = try utf8Strict(try r.bytes())
    } else if (k.field === 2) {
      val = try decodeOne(vt, r, k.wire, depth)
    } else {
      try r.skip(k.wire)
    }
  }
  if (val !== undefined) return { key: key, raw: val }
  return { key: key, raw: try defaultText(vt, depth) }
}

// A Value's JSON: the value of the one field its kind takes (the last one, if several are set).
function decodeValue(data: u8[], depth: int): string throws Error {
  const r = new PbReader(data)
  let out = "null"
  while (r.more()) {
    const k = try r.key()
    if (k.field === 1 && k.wire === 0) {
      const _n = try r.varint()
      out = "null"
    } else if (k.field === 2 && k.wire === 1) {
      out = numberText(bitsToDouble(try r.fixed64()))
    } else if (k.field === 3 && k.wire === 2) {
      out = quote(try utf8Strict(try r.bytes()))
    } else if (k.field === 4 && k.wire === 0) {
      out = (try r.varint()) !== 0 ? "true" : "false"
    } else if (k.field === 5 && k.wire === 2) {
      out = try decodeBody("struct", try r.bytes(), depth + 1)
    } else if (k.field === 6 && k.wire === 2) {
      out = try decodeBody("listvalue", try r.bytes(), depth + 1)
    } else {
      try r.skip(k.wire)
    }
  }
  return out
}

function decodeMessage(name: string, data: u8[], depth: int): string throws Error {
  const def = MESSAGES.get(name)
  if (def === undefined) throw new Error("protobuf: unknown A2A message " + name)
  const r = new PbReader(data)
  const acc: Field[][] = []
  for (let i = 0; i < def.fields.length; i++) acc.push([])
  while (r.more()) {
    const k = try r.key()
    let idx = -1
    for (let i = 0; i < def.fields.length; i++) {
      if (def.fields[i]!.num === k.field) idx = i
    }
    if (idx < 0) {
      try r.skip(k.wire)
      continue
    }
    const fd = def.fields[idx]!
    if (fd.oneof !== "") {
      for (let j = 0; j < def.fields.length; j++) {
        if (j !== idx && def.fields[j]!.oneof === fd.oneof) acc[j] = []
      }
    }
    if (fd.type.startsWith("map:")) {
      if (k.wire !== 2) throw new Error("protobuf: wrong wire type for a map")
      acc[idx]!.push(try decodeEntry(fd.type.slice(4), try r.bytes(), depth))
    } else if (fd.type.startsWith("rep:")) {
      const el = fd.type.slice(4)
      if (k.wire === 2 && (el === "int32" || el === "bool" || el.startsWith("enum:"))) {
        for (const v of try packedVarints(try r.bytes())) {
          acc[idx]!.push({ key: "", raw: el === "bool" ? (v !== 0 ? "true" : "false") : low32Text(el, v) })
        }
      } else {
        acc[idx]!.push({ key: "", raw: try decodeOne(el, r, k.wire, depth) })
      }
    } else {
      acc[idx]!.push({ key: "", raw: try decodeOne(fd.type, r, k.wire, depth) })
    }
  }
  let out: Field[] = []
  for (let i = 0; i < def.fields.length; i++) {
    const fd = def.fields[i]!
    const occ = acc[i]!
    if (occ.length === 0) continue
    if (fd.type.startsWith("map:")) {
      let m: Field[] = []
      for (const o of occ) setField(&m, o.key, o.raw)
      out.push({ key: fd.json, raw: build(m) })
    } else if (fd.type.startsWith("rep:")) {
      const parts: string[] = []
      for (const o of occ) parts.push(o.raw)
      out.push({ key: fd.json, raw: "[" + parts.join(",") + "]" })
    } else {
      const last = occ[occ.length - 1]!.raw
      if (isScalar(fd.type) && !fd.presence) {
        const dflt = try defaultText(fd.type, depth)
        if (last === dflt) continue
      }
      out.push({ key: fd.json, raw: last })
    }
  }
  return build(out)
}

// The JSON of the body of a message-typed value.
function decodeBody(t: string, data: u8[], depth: int): string throws Error {
  if (depth > MAX_DEPTH) throw new Error("protobuf: message nested too deeply")
  if (t.startsWith("msg:")) return try decodeMessage(t.slice(4), data, depth)
  if (t === "struct") {
    const r = new PbReader(data)
    let out: Field[] = []
    while (r.more()) {
      const k = try r.key()
      if (k.field === 1 && k.wire === 2) {
        const e = try decodeEntry("value", try r.bytes(), depth + 1)
        setField(&out, e.key, e.raw)
      } else {
        try r.skip(k.wire)
      }
    }
    return build(out)
  }
  if (t === "value") return try decodeValue(data, depth)
  if (t === "listvalue") {
    const r = new PbReader(data)
    const parts: string[] = []
    while (r.more()) {
      const k = try r.key()
      if (k.field === 1 && k.wire === 2) {
        parts.push(try decodeBody("value", try r.bytes(), depth + 1))
      } else {
        try r.skip(k.wire)
      }
    }
    return "[" + parts.join(",") + "]"
  }
  if (t === "timestamp") {
    const r = new PbReader(data)
    let sec = 0
    let nanos = 0
    while (r.more()) {
      const k = try r.key()
      if (k.field === 1 && k.wire === 0) sec = try r.varint()
      else if (k.field === 2 && k.wire === 0) nanos = int32Of(try r.varint())
      else try r.skip(k.wire)
    }
    return quote(try formatTimestamp(sec, nanos))
  }
  if (t === "empty") return "{}"
  throw new Error("protobuf: unknown type " + t)
}

// The protobuf bytes of a JSON value of an A2A v1 message (name as "Task" or "lf.a2a.v1.Task"). The
// JSON is protojson's shape with lowerCamelCase or proto names; an unknown key is skipped.
export function encode(json: string, message: string): u8[] throws Error {
  const w = new PbWriter()
  try encodeBody(try specOf(message), json, w, 0)
  return w.buf
}

// The JSON of protobuf bytes of an A2A v1 message, as protojson writes it (proto3 defaults left out).
export function decode(bytes: u8[], message: string): string throws Error {
  return try decodeBody(try specOf(message), bytes, 0)
}

// ---- tests ----

// The JSON with keys sorted and numbers in their shortest form, so two texts compare as values.
function canonJson(text: string): string throws Error {
  const t = text.trim()
  if (t.startsWith("{")) {
    const parts: string[] = []
    for (const f of sortedByKey(try fields(t))) {
      const c = try canonJson(f.raw)
      parts.push(quote(f.key) + ":" + c)
    }
    return "{" + parts.join(",") + "}"
  }
  if (t.startsWith("[")) {
    const parts: string[] = []
    for (const e of try elements(t)) {
      const c = try canonJson(e)
      parts.push(c)
    }
    return "[" + parts.join(",") + "]"
  }
  if (t.startsWith("\"")) return quote(try decodeString(t))
  if (t === "true" || t === "false" || t === "null") return t
  const x = parseFloat(t)
  if (x === undefined) throw new Error("not a number")
  return `${x}`
}

type GoldenCase = { name: string, message: string, hex: string, json: string }

// The golden vectors: tests/fixtures/a2apb_golden.json, written by the Go program beside it.
function goldenCases(): GoldenCase[] throws Error {
  const text = try readFileSync("tests/fixtures/a2apb_golden.json", "utf8")
  return try JSON.parse(text) as GoldenCase[]
}

function failsDecode(hex: string, message: string): bool {
  try {
    const _s = try decode(hexBytes(hex), message)
    return false
  } catch (e) {
    return true
  }
}

function failsEncode(json: string, message: string): bool {
  try {
    const _b = try encode(json, message)
    return false
  } catch (e) {
    return true
  }
}

test("golden vectors: each message encodes to protobuf-go's bytes and decodes to protojson's JSON", () => {
  const cases = try goldenCases()
  expect(cases.length > 0).toBe(true)
  for (const c of cases) {
    const got = try decode(hexBytes(c.hex), c.message)
    expect(try canonJson(got)).toBe(try canonJson(c.json))
    expect(toHex(try encode(c.json, c.message))).toBe(c.hex)
  }
})

test("golden vectors cover every message of the schema", () => {
  const cases = try goldenCases()
  const seen = new Set<string>()
  for (const c of cases) seen.add(c.message)
  for (const name of MESSAGES.keys()) {
    expect(seen.has(name)).toBe(true)
  }
})

test("each A2A method names its request and response messages", () => {
  for (const op of ["SendMessage", "SendStreamingMessage", "GetTask", "ListTasks", "CancelTask", "SubscribeToTask", "CreateTaskPushNotificationConfig", "GetTaskPushNotificationConfig", "ListTaskPushNotificationConfigs", "DeleteTaskPushNotificationConfig", "GetExtendedAgentCard"]) {
    expect(requestOf(op) !== "").toBe(true)
    expect(responseOf(op) !== "").toBe(true)
    const _q = try specOf(requestOf(op))
    const _r = try specOf(responseOf(op))
  }
  expect(requestOf("NoSuchOp")).toBe("")
})

test("proto field names and the lf.a2a.v1 prefix are read", () => {
  expect(toHex(try encode(`{"context_id":"c"}`, "lf.a2a.v1.Task"))).toBe("120163")
  expect(toHex(try encode(`{"contextId":"c"}`, "Task"))).toBe("120163")
})

test("unknown keys are skipped on encode, and a default is left out", () => {
  expect(toHex(try encode(`{"kind":"task","id":"t","contextId":""}`, "Task"))).toBe("0a0174")
  expect(toHex(try encode(`{}`, "Task"))).toBe("")
})

test("enums encode as their numbers and read the v0.3 spellings", () => {
  expect(toHex(try encode(`{"role":"ROLE_USER"}`, "Message"))).toBe("2001")
  expect(toHex(try encode(`{"role":"user"}`, "Message"))).toBe("2001")
  expect(toHex(try encode(`{"role":2}`, "Message"))).toBe("2002")
  expect(toHex(try encode(`{"status":{"state":"completed"}}`, "Task"))).toBe("1a020803")
  expect(toHex(try encode(`{"status":{"state":"TASK_STATE_COMPLETED"}}`, "Task"))).toBe("1a020803")
  const back = try decode(hexBytes("1a020807"), "Task")
  expect(back).toBe(`{"status":{"state":"TASK_STATE_REJECTED"}}`)
})

test("a presence field is written even when it is the default, and read back", () => {
  expect(toHex(try encode(`{"historyLength":0}`, "GetTaskRequest"))).toBe("1800")
  expect(toHex(try encode(`{}`, "GetTaskRequest"))).toBe("")
  expect(try decode(hexBytes("1800"), "GetTaskRequest")).toBe(`{"historyLength":0}`)
  expect(toHex(try encode(`{"historyLength":-1}`, "GetTaskRequest"))).toBe("18ffffffffffffffffff01")
  expect(try decode(hexBytes("18ffffffffffffffffff01"), "GetTaskRequest")).toBe(`{"historyLength":-1}`)
})

test("timestamps are RFC 3339 in UTC, with 0, 3, 6 or 9 fraction digits", () => {
  expect(toHex(try encode(`{"timestamp":"1970-01-01T00:00:00Z"}`, "TaskStatus"))).toBe("1a00")
  expect(try decode(hexBytes("1a00"), "TaskStatus")).toBe(`{"timestamp":"1970-01-01T00:00:00Z"}`)
  const ts = try encode(`{"timestamp":"2026-10-19T12:00:00.5+02:00"}`, "TaskStatus")
  expect(try decode(ts, "TaskStatus")).toBe(`{"timestamp":"2026-10-19T10:00:00.500Z"}`)
  const neg = try encode(`{"timestamp":"1969-12-31T23:59:59.000001Z"}`, "TaskStatus")
  expect(try decode(neg, "TaskStatus")).toBe(`{"timestamp":"1969-12-31T23:59:59.000001Z"}`)
  const leap = try encode(`{"timestamp":"2024-02-29T00:00:00.123456789Z"}`, "TaskStatus")
  expect(try decode(leap, "TaskStatus")).toBe(`{"timestamp":"2024-02-29T00:00:00.123456789Z"}`)
})

test("bytes are base64 in both directions, URL-safe and unpadded input included", () => {
  expect(toHex(try encode(`{"raw":"AQID"}`, "Part"))).toBe("120301020" + "3")
  expect(toHex(try encode(`{"raw":"AQI"}`, "Part"))).toBe("1202" + "0102")
  expect(toHex(try encode(`{"raw":"-_8"}`, "Part"))).toBe("1202" + "fbff")
  expect(try decode(hexBytes("120301020" + "3"), "Part")).toBe(`{"raw":"AQID"}`)
})

test("a v0.3 file part reads as the v1 part", () => {
  const json = `{"role":"user","parts":[{"kind":"file","file":{"name":"a.txt","mimeType":"text/plain","uri":"https://example.test/a.txt"}}]}`
  const back = try decode(try encode(json, "Message"), "Message")
  expect(try canonJson(back)).toBe(try canonJson(`{"role":"ROLE_USER","parts":[{"url":"https://example.test/a.txt","mediaType":"text/plain","filename":"a.txt"}]}`))
})

test("a Struct, a Value and a ListValue round-trip, with keys sorted on encode", () => {
  const json = `{"b":[1,"x",null,true,{"n":-2.5}],"a":{"k":"v"}}`
  expect(toHex(try encode(json, "Struct"))).toBe(toHex(try encode(`{"a":{"k":"v"},"b":[1,"x",null,true,{"n":-2.5}]}`, "Struct")))
  const sback = try decode(try encode(json, "Struct"), "Struct")
  expect(try canonJson(sback)).toBe(try canonJson(json))
  const lback = try decode(try encode(`[1,"a"]`, "ListValue"), "ListValue")
  expect(try canonJson(lback)).toBe(`[1,"a"]`)
  expect(try decode(try encode(`null`, "Value"), "Value")).toBe("null")
  expect(try decode(hexBytes(""), "Empty")).toBe("{}")
})

test("malformed input is an error, not a read past the end", () => {
  expect(failsDecode("0a05616263", "Task")).toBe(true)
  expect(failsDecode("0a02c3", "Task")).toBe(true)
  expect(failsDecode("0b", "Task")).toBe(true)
  expect(failsDecode("0a0161", "Message")).toBe(false)
  expect(failsDecode("", "Task")).toBe(false)
  expect(failsDecode("0a01", "NoSuchMessage")).toBe(true)
})

test("values out of the schema's range or shape are errors on encode", () => {
  expect(failsEncode(`{"state":"TASK_STATE_BOGUS"}`, "TaskStatus")).toBe(true)
  expect(failsEncode(`{"historyLength":1.5}`, "GetTaskRequest")).toBe(true)
  expect(failsEncode(`{"historyLength":3000000000}`, "GetTaskRequest")).toBe(true)
  expect(failsEncode(`{"raw":"!!!"}`, "Part")).toBe(true)
  expect(failsEncode(`{"timestamp":"2026-02-30T00:00:00Z"}`, "TaskStatus")).toBe(true)
  expect(failsEncode(`{"timestamp":"2026-10-19 12:00:00Z"}`, "TaskStatus")).toBe(true)
  expect(failsEncode(`{"text":"a","raw":"AA=="}`, "Part")).toBe(true)
  expect(failsEncode(`{"id":"x"}`, "NoSuchMessage")).toBe(true)
  expect(failsEncode(`{"historyLength":1}`, "GetTaskRequest")).toBe(false)
  let deep = "1"
  for (let i = 0; i < 150; i++) deep = "[" + deep + "]"
  expect(failsEncode(deep, "Value")).toBe(true)
})
