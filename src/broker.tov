// Broker mode (Bifrost's cluster_config.type "broker"): a relay for nodes that cannot reach each other.
// Every node makes one outbound request per round to the broker. It posts its usage state, and the broker
// merges it into the joined state of all nodes and answers with that state and the roster of nodes heard
// from lately. The broker keeps no usage of its own: it only joins what the nodes send. A node merges the
// answer with Counters.relay, so the other nodes' usage reaches it in two rounds at most.
import { Counters, ClusterConfig, LEADER_WINDOW_MS, verify, nodeOf, clusterBodyCap, wellFormedSig, headRefusal, requestRefusal, signRequest, peerHeaders, sign, HEAD_SIG_HEADER, TS_HEADER } from "./cluster"
import { ServerSectionConfig } from "./config"
import { peerBudget, bodyRate, readCharged, BodyHold, UNREAD_ABOVE } from "./bodybudget"
import { ClusterState } from "./clusterstate"
import { HoldBook, HoldWire } from "./holds"
import { ServerLimits, lifecycle, readyReport, readyInput } from "./lifecycle"
import { FeedRing, FeedItem, FeedPull, FeedAnswer, FEED_RING_SIZE, FEED_RING_SECONDS, FEED_BATCH_MAX, checkItems, parseAnswer, feedId } from "./feed"

export const BROKER_ROUTE = "/api/cluster/broker"
// the live feed's relay: a node posts its events and pulls the other nodes' (feed.tov)
export const BROKER_FEED_ROUTE = "/api/cluster/broker/feed"
export const BROKER_PORT: int = 50051
const BROKER_ID = "broker"

// The broker's joined state. A node whose payload is bad is refused with nothing merged.
export class Relay {
  private state: Counters = new Counters(BROKER_ID)
  // the replicated state entries (clusterstate.tov) the nodes have sent, joined as the nodes join them
  private relayed: ClusterState = new ClusterState(BROKER_ID)
  // the key holds the nodes have sent (holds.tov), joined as at a peer
  private holds: HoldBook = new HoldBook(BROKER_ID)
  // the nodes' live-feed events in the order the broker took them; each gets a position (bseq) that a node keeps as its cursor
  private feed: FeedRing = new FeedRing(FEED_RING_SIZE, FEED_RING_SECONDS * 1000.0)
  private pos: int = 0

  // A node's state in; the joined state and the roster out. Nodes silent for a window are dropped.
  exchange(body: string, nowMs: f64): string throws SyntaxError {
    try this.state.merge(body, nowMs)
    this.state.forget(nowMs - LEADER_WINDOW_MS)
    // the state entries join here and go back out with the counters
    this.relayed.merge(this.state.takeState(), nowMs)
    this.state.setState(this.relayed.wire(nowMs))
    // the key holds join the same way as at a peer: what the broker takes is drained each time (it never grows), and
    // only the holds of nodes in the roster go back out, so a node that left takes its holds with it
    const roster = this.roster()
    const live: string[] = roster.map((id) => nodeOf(id))
    this.holds.merge(this.state.takeHolds(), nowMs)
    this.state.setHolds(this.holds.wire(nowMs).filter((h) => live.includes(nodeOf(h.owner))))
    return this.state.encode(roster)
  }

  // A node's feed pull: its own events in, and the other nodes' events after its cursor out (a FeedAnswer as JSON).
  // The broker keeps each event once, so a node that retries sends nothing twice.
  feedExchange(body: string, nowMs: f64): string throws SyntaxError {
    const pull = try JSON.parse(body) as FeedPull
    const xs: FeedItem[] = pull.items ?? []
    try checkItems(xs)
    const node = pull.node ?? ""
    if (node.byteLength === 0 || node.includes(",")) throw new SyntaxError("feed pull has no usable node id")
    const after: int = pull.after ?? 0
    if (after < 0) throw new SyntaxError("feed pull has a negative cursor")
    for (const it of xs) {
      const stored: FeedItem = { node: it.node, seq: it.seq, ts: it.ts, team: it.team, bu: it.bu, customer: it.customer, project: it.project, data: it.data, bseq: this.pos + 1 }
      if (this.feed.add(stored, nowMs)) this.pos += 1
    }
    return JSON.stringify(this.feed.since(after, nodeOf(node), FEED_BATCH_MAX, this.pos))
  }

  // The node ids heard from in the last window, sorted.
  roster(): string[] {
    const out: string[] = []
    for (const p of this.state.peers()) out.push(p.id)
    return out
  }
}

function reply(status: int, body: string): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", "application/json")
  return new Response(body, { status: status, headers: h })
}

// A POST's head check, before its body is read (re-audit 4 P2-H, as the gateway's peerHeadRefusal): the body's
// signature header must be well formed and the head signature (cluster.HEAD_SIG_HEADER over the method, route, time
// and Content-Length) must match and be fresh. "" when it passes, otherwise why it is refused.
export function brokerHeadRefusal(cc: ClusterConfig, req: Request, p: string, nowMs: f64): string {
  if (!wellFormedSig(req.headers.get("x-raiju-cluster-sig") ?? "")) return "bad cluster signature"
  const length = req.headers.get("content-length") ?? "chunked"
  return headRefusal(cc.secret, req.method, p, req.headers.get(TS_HEADER) ?? "", length, req.headers.get(HEAD_SIG_HEADER) ?? "", nowMs)
}

// A node's body, read only after its head passed: charged to the peers' budget (bodybudget.tov peerBudget, cap
// cluster.max_body_mb) as it arrives, at server.body_min_kb_per_second and within server.body_max_seconds. The text,
// or the answer that refuses it; hold is given back by the caller.
async function brokerBody(cc: ClusterConfig, srv: ServerSectionConfig | undefined, req: Request, hold: BodyHold): Promise<string | Response> {
  const b = peerBudget()
  const cap = clusterBodyCap(cc)
  hold.peer = true
  const declared = req.headers.get("content-length")
  let max = cap
  if (declared !== undefined) {
    const n = parseInt(declared) ?? 0
    if (n > cap) return reply(413, `{"error":"request body too large (cluster.max_body_mb)"}`)
    if (n <= UNREAD_ABOVE) {
      // read by the server already
      b.hold(n)
      hold.held = n
      hold.cls = "small"
      return await req.text()
    }
    if (!b.fits(n, cap, "checked", 0)) return reply(503, `{"error":"the broker is reading too many bodies at once (cluster.max_body_mb)"}`)
    max = n
  }
  const st = req.body
  if (st === undefined) return ""
  hold.cls = "checked"
  const got = await readCharged(st, b, hold, { max: max, cap: cap, cls: "checked", share: 0, who: "", whoShare: 0, reserve: 0, deadlineMs: 0, rate: bodyRate(srv) })
  if (got.stop === "large") return reply(413, `{"error":"request body too large (cluster.max_body_mb)"}`)
  if (got.stop === "busy") return reply(503, `{"error":"the broker is reading too many bodies at once (cluster.max_body_mb)"}`)
  if (got.stop !== "") return reply(408, `{"error":"the request body arrived too slowly"}`)
  try {
    return new TextDecoder().decode(got.body)
  } catch (e) {
    return reply(400, `{"error":"the body is not UTF-8"}`)
  }
}

// The broker's routes. POST carries a node's state and GET lists the roster, as on a node's peer routes: a POST's
// head is signed (method, route, time, Content-Length) and checked before its body is read, then the body's HMAC; a
// GET is signed over its method, path and time (x-raiju-cluster-ts), so a captured one stops working after a minute.
// GET /health is for liveness probes, GET /ready for readiness.
export async function brokerRoute(relay: Relay, cc: ClusterConfig, req: Request, srv?: ServerSectionConfig): Promise<Response> {
  const u = URL.parse(req.url)
  const p = u === undefined ? "" : u.pathname
  if (p === "/health") return reply(200, `{"status":"ok"}`)
  // readiness: 503 while a graceful stop drains, so a load balancer takes the broker out first
  if (p === "/ready") {
    const r = readyReport(readyInput(lifecycle().draining, "", false, false, false, false))
    return reply(r.status, r.body)
  }
  if (p !== BROKER_ROUTE && p !== BROKER_FEED_ROUTE) return reply(404, `{"error":"not found"}`)
  if (req.method !== "POST" && req.method !== "GET") return reply(405, `{"error":"method not allowed"}`)
  if (p === BROKER_FEED_ROUTE && req.method !== "POST") return reply(405, `{"error":"method not allowed"}`)
  if (req.method === "GET") {
    const why = requestRefusal(cc.secret, "GET", p, req.headers.get(TS_HEADER) ?? "", req.headers.get("x-raiju-cluster-sig") ?? "", Date.now())
    if (why !== "") return reply(401, JSON.stringify({ error: why }))
    return reply(200, JSON.stringify({ roster: relay.roster() }))
  }
  const unsigned = brokerHeadRefusal(cc, req, p, Date.now())
  if (unsigned !== "") return reply(401, JSON.stringify({ error: unsigned }))
  const hold = new BodyHold()
  try {
    const read = await brokerBody(cc, srv, req, hold)
    if (read instanceof Response) return read
    const body = read
    if (!verify(cc.secret, body, req.headers.get("x-raiju-cluster-sig") ?? "")) return reply(401, `{"error":"bad cluster signature"}`)
    try {
      if (p === BROKER_FEED_ROUTE) return reply(200, try relay.feedExchange(body, Date.now()))
      return reply(200, try relay.exchange(body, Date.now()))
    } catch (e) {
      return reply(400, JSON.stringify({ error: e.message }))
    }
  } finally {
    hold.release()
  }
}

// The broker's server: where it listens, and what a graceful stop needs (lifecycle.tov).
export type BrokerServed = { url: string, stopListener: () => void, open: () => int }

// Serves the relay on cluster_config.broker.listen_port (default 50051), with the gateway's header, idle and body
// timeouts and connection cap (server.*). Bodies over UNREAD_ABOVE reach brokerRoute unread, so a head a node did not
// sign is refused before the body is read.
export function startBroker(cc: ClusterConfig, hostname: string, lim: ServerLimits, srv?: ServerSectionConfig): BrokerServed {
  const b = cc.broker
  const port: int = b === undefined ? BROKER_PORT : (b.listen_port ?? BROKER_PORT)
  const relay = new Relay()
  const server = Bun.serve({
    port: port,
    hostname: hostname,
    headerTimeout: lim.headerSeconds,
    idleTimeout: lim.idleSeconds,
    bodyTimeout: lim.bodySeconds,
    maxConnections: lim.maxConnections,
    // the nodes' sync and feed bodies, bounded like the cluster listener's (cluster.max_body_mb)
    maxRequestBodySize: clusterBodyCap(cc),
    bodyStreamThreshold: UNREAD_ABOVE,
    async fetch(req) {
      return await brokerRoute(relay, cc, req, srv)
    },
  })
  return {
    url: server.url.href,
    stopListener: () => {
      server.stop()
    },
    open: (): int => server.openConnections,
  }
}

test("the relay joins what the nodes send and lists them as the roster", () => {
  const relay = new Relay()
  const a = new Counters("a")
  const b = new Counters("b")
  a.add("budget:monthly", "2026-10", 1.5)
  b.add("budget:monthly", "2026-10", 2)
  b.add("rl:key:requests", "00:00", 3)
  try relay.exchange(a.encode(), 1000)
  const answer = try relay.exchange(b.encode(), 1000)
  expect(relay.roster()).toEqual(["a", "b"])
  // b's answer has the join of both nodes' state
  const got = new Counters("b")
  try got.relay(answer, 1000)
  expect(got.total("budget:monthly", "2026-10")).toBe(3.5)
  expect(got.total("rl:key:requests", "00:00")).toBe(3)
  // the broker's own id is never a peer of the nodes
  expect(got.peers().map((p) => p.id)).toEqual(["a"])
})

test("a node silent for a window leaves the roster and its usage", () => {
  const relay = new Relay()
  const a = new Counters("a")
  const b = new Counters("b")
  a.add("c", "w", 4)
  b.add("c", "w", 1)
  try relay.exchange(a.encode(), 1000)
  const late = 1000 + LEADER_WINDOW_MS + 1
  const answer = try relay.exchange(b.encode(), late)
  expect(relay.roster()).toEqual(["b"])
  const got = new Counters("b")
  try got.relay(answer, late)
  expect(got.total("c", "w")).toBe(1)
})

test("a bad payload is refused and the roster does not change", () => {
  const relay = new Relay()
  const a = new Counters("a")
  a.add("c", "w", 2)
  try relay.exchange(a.encode(), 1000)
  let refused = 0
  for (const text of ["not json", `{"node":"","ts":1,"counters":[]}`, `{"node":"x","ts":1,"counters":[{"name":"c","window":"w","slots":{"x":-1}}]}`]) {
    try {
      relay.exchange(text, 2000)
    } catch (e) {
      if (e instanceof SyntaxError) refused += 1
    }
  }
  expect(refused).toBe(3)
  expect(relay.roster()).toEqual(["a"])
})

// The answer of a feed pull as the tests read it: last is -1 when the broker refuses the body.
function answerOf(relay: Relay, body: string, now: f64): FeedAnswer {
  try {
    return parseAnswer(try relay.feedExchange(body, now))
  } catch (e) {
    return { items: [], next: 0, missed: 0, last: -1 }
  }
}

function pullOf(node: string, after: int, items: FeedItem[]): string {
  return JSON.stringify({ node: node, after: after, items: items })
}

function feedEvent(node: string, seq: int): FeedItem {
  return { node: node, seq: seq, ts: 1000.0, team: "", bu: "", customer: "", project: "", data: `{"id":"e${seq}"}` }
}

test("the broker keeps the nodes' feed events and answers each node with the others'", () => {
  const relay = new Relay()
  const r1 = answerOf(relay, pullOf("a", 0, [feedEvent("a", 1)]), 1000.0)
  expect(r1.last).toBe(1)
  expect(r1.items.length).toBe(0)
  const r2 = answerOf(relay, pullOf("b", 0, [feedEvent("b/7", 3), feedEvent("b/7", 4)]), 1000.0)
  expect(r2.items.map((it) => feedId(it))).toEqual(["a:1"])
  expect(r2.last).toBe(3)
  // a's next pull starts after its cursor and gets the other node's events it has not seen
  const r3 = answerOf(relay, pullOf("a", r1.next, []), 1000.0)
  expect(r3.items.map((it) => feedId(it))).toEqual(["b/7:3", "b/7:4"])
  // a retry of a pull keeps nothing twice
  const again = answerOf(relay, pullOf("b", 0, [feedEvent("b/7", 4)]), 1000.0)
  expect(again.last).toBe(3)
  // a body with a bad node id, or no JSON, is refused
  expect(answerOf(relay, pullOf("", 0, []), 1000.0).last).toBe(-1)
  expect(answerOf(relay, pullOf("c,d", 0, []), 1000.0).last).toBe(-1)
  expect(answerOf(relay, "not json", 1000.0).last).toBe(-1)
})

test("the broker relays replicated state between nodes that have no link, last writer wins", () => {
  const relay = new Relay()
  const a = new Counters("a")
  const b = new Counters("b")
  const sa = new ClusterState("a")
  sa.put("mcp.exchange_admin", "jira", `{"n":1}`, 1000.0)
  a.setState(sa.wire(1000.0))
  try relay.exchange(a.encode(), 1000.0)
  // b has never heard from a: its answer to the broker carries a's entry
  const answer = try relay.exchange(b.encode(), 1000.0)
  const got = new Counters("b")
  try got.relay(answer, 1000.0)
  const received = got.takeState()
  expect(received.length).toBe(1)
  expect(received[0]!.value).toBe(`{"n":1}`)
  // a later write from a replaces it at the broker and at b
  sa.put("mcp.exchange_admin", "jira", `{"n":2}`, 2000.0)
  a.setState(sa.wire(2000.0))
  try relay.exchange(a.encode(), 2000.0)
  const again = try relay.exchange(b.encode(), 2000.0)
  const got2 = new Counters("b")
  try got2.relay(again, 2000.0)
  expect(got2.takeState()[0]!.value).toBe(`{"n":2}`)
})

test("the broker relays key holds between nodes, and stops relaying the holds of a node that left", () => {
  const relay = new Relay()
  const a = new Counters("a")
  const b = new Counters("b")
  const h: HoldWire = { target: "p#k", provider: "p", keyId: "k", model: "", cls: "credential", reason: "bad", heldAt: 1000.0, rung: 0, waitMs: 30000.0, nextCheck: 31000.0, owner: "a", claimBy: "", claimAt: 0.0, ver: 1, by: "a", released: false, at: 1000.0 }
  a.setHolds([h])
  try relay.exchange(a.encode(), 1000.0)
  const answer = try relay.exchange(b.encode(), 1000.0)
  const got = new Counters("b")
  try got.relay(answer, 1000.0)
  const held = got.takeHolds()
  expect(held.length).toBe(1)
  expect(held[0]!.target).toBe("p#k")
  // a's holds are not relayed once a has left the roster (a silent for a window)
  const late = 1000.0 + LEADER_WINDOW_MS + 1.0
  const again = try relay.exchange(b.encode(), late)
  const got2 = new Counters("b")
  try got2.relay(again, late)
  expect(got2.takeHolds().length).toBe(0)
})

test("a broker POST's head is checked before its body is read (re-audit 4 P2-H)", () => {
  const secret = "broker-test-" + "secret-0123456789abcdef0123456789"
  const cc: ClusterConfig = { enabled: true, secret: secret, peers: [] }
  const now = 1800000000000.0
  const body = `{"node":"a","ts":1,"counters":[]}`
  const at = (h: Map<string, string>, length: string): Request => {
    const hs: Map<string, string> = new Map()
    for (const k of h.keys()) hs.set(k, h.get(k)!)
    if (length !== "") hs.set("content-length", length)
    return new Request("http://b" + BROKER_ROUTE, { method: "POST", headers: hs })
  }
  const good = peerHeaders(secret, BROKER_ROUTE, body, now)
  expect(brokerHeadRefusal(cc, at(good, `${body.byteLength}`), BROKER_ROUTE, now)).toBe("")
  // a head signed for the gateway's sync route, another length, no length, another route, a stale head
  expect(brokerHeadRefusal(cc, at(peerHeaders(secret, "/api/cluster/sync", body, now), `${body.byteLength}`), BROKER_ROUTE, now)).toBe("bad cluster signature")
  expect(brokerHeadRefusal(cc, at(good, "15000000"), BROKER_ROUTE, now)).toBe("bad cluster signature")
  expect(brokerHeadRefusal(cc, at(good, ""), BROKER_ROUTE, now)).toBe("bad cluster signature")
  expect(brokerHeadRefusal(cc, at(good, `${body.byteLength}`), BROKER_FEED_ROUTE, now)).toBe("bad cluster signature")
  expect(brokerHeadRefusal(cc, at(good, `${body.byteLength}`), BROKER_ROUTE, now + 120000.0)).toBe("stale cluster request")
  // the re-audit's request: a well-formed body signature and no head
  const fake: Map<string, string> = new Map()
  fake.set("x-raiju-cluster-sig", "ab".repeat(32))
  expect(brokerHeadRefusal(cc, at(fake, "15000000"), BROKER_ROUTE, now)).toBe("bad cluster signature")
  const odd: Map<string, string> = new Map()
  odd.set("x-raiju-cluster-sig", "zz")
  expect(brokerHeadRefusal(cc, at(odd, "2"), BROKER_ROUTE, now)).toBe("bad cluster signature")
})

test("the broker's GET roster signature covers the method, path and time", () => {
  const secret = "broker-test-" + "secret-0123456789abcdef0123456789"
  const now = 1800000000000.0
  const ts = "1800000000000"
  expect(requestRefusal(secret, "GET", BROKER_ROUTE, ts, signRequest(secret, "GET", BROKER_ROUTE, ts), now)).toBe("")
  // the old constant signature over an empty body no longer passes, nor a captured one after a minute
  expect(requestRefusal(secret, "GET", BROKER_ROUTE, ts, sign(secret, ""), now)).toBe("bad cluster signature")
  expect(requestRefusal(secret, "GET", BROKER_ROUTE, "", sign(secret, ""), now)).toBe("bad cluster signature")
  expect(requestRefusal(secret, "GET", BROKER_ROUTE, ts, signRequest(secret, "GET", BROKER_ROUTE, ts), now + 60001.0)).toBe("stale cluster request")
})
