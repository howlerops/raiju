// A2A agents (Bifrost's agents section, /api/agents and the agent gateway at /agents/a2a/{name}).
//
// A registered agent is a remote A2A agent. Its card is fetched when it is registered (and again on demand and
// on a timer) and kept in the registration, and the card names the agent's endpoints. The gateway serves the
// card with its endpoints rewritten to its own JSON-RPC and REST routes, and sends the A2A calls on to the
// agent once the caller's virtual key passes the agent's grants and the key's budgets and rate limits
// (ops.tov a2aRoute). Each call is logged as an "a2a" entry with the agent's name. Its context id is the
// session, so the agent_names log filter selects the LLM requests made in those conversations.
//
// How a call is shaped and mapped between the bindings is a2a.tov; the push relay is a2apush.tov; the
// credentials the gateway sends to the agent (headers, an OAuth token) are agentauth.tov.
//
// Not built: the gRPC binding, extension URIs, and client certificates for the agent's TLS.
import { Field, fields, elements, find, rawStr, rawBool, decodeString, quote, build, setField, isNull } from "./json"
import { AgentConfig, AgentAuth, AgentOAuth, AgentTls } from "./config"
import { urlProblem } from "./webhooks"
import { deadline } from "./deadline"
import { errorJson } from "./schemas"
import { upstreamHeaders, tlsOf } from "./agentauth"
import { interfacesOf, interfaceUrl, cardPushes } from "./a2a"

export const CARD_PATH = "/.well-known/agent-card.json"
export const JSON_RPC_SUFFIX = "/json-rpc"
export const REST_PREFIX = "/rest"
// what a read answers for a secret header value
const MASK = "********"
const CARD_TIMEOUT_MS = 10000

export type AgentReply = { status: int, body: string, next?: AgentConfig[] }
export type CardResult = { card: string, error: string }

function reply(status: int, body: string, next?: AgentConfig[]): AgentReply {
  return { status: status, body: body, next: next }
}

function fail(status: int, message: string): AgentReply {
  return { status: status, body: errorJson(message, status === 404 ? "not_found_error" : "invalid_request_error", undefined) }
}

// A registration name: lowercase letters and digits in single hyphen-separated runs, at most 255 bytes.
export function validName(name: string): bool {
  if (name === "" || name.byteLength > 255 || name.startsWith("-") || name.endsWith("-") || name.includes("--")) return false
  for (let i = 0; i < name.byteLength; i++) {
    const c = name.slice(i, i + 1)
    if (!(("a" <= c && c <= "z") || ("0" <= c && c <= "9") || c === "-")) return false
  }
  return true
}

function objectFields(text: string): Field[] | undefined {
  if (!text.startsWith("{")) return undefined
  try {
    return fields(text)
  } catch (e) {
    return undefined
  }
}

function headerMap(raw: string): Map<string, string> | undefined {
  if (!raw.startsWith("{")) return undefined
  const out: Map<string, string> = new Map()
  try {
    for (const f of fields(raw)) {
      if (!f.raw.startsWith("\"")) return undefined
      out.set(f.key, decodeString(f.raw))
    }
  } catch (e) {
    return undefined
  }
  return out
}

function strOf(raw: string | undefined): string | undefined {
  if (raw === undefined || !raw.startsWith("\"")) return undefined
  try {
    return decodeString(raw)
  } catch (e) {
    return undefined
  }
}

// An array of strings, undefined when the raw JSON is not one.
function strList(raw: string): string[] | undefined {
  if (!raw.startsWith("[")) return undefined
  const out: string[] = []
  try {
    for (const el of elements(raw)) {
      if (!el.startsWith("\"")) return undefined
      out.push(decodeString(el))
    }
  } catch (e) {
    return undefined
  }
  return out
}

// Headers an auth may not set: they belong to the connection, not to the gateway's credentials.
function blockedHeader(name: string): bool {
  const k = name.toLowerCase()
  return k === "" || k === "cookie" || k === "proxy-authorization" || k === "connection" || k === "keep-alive" || k === "proxy-authenticate" || k === "proxy-connection" || k === "te" || k === "trailer" || k === "transfer-encoding" || k === "upgrade" || k === "host" || k === "content-length"
}

type AuthRead = { auth: AgentAuth | undefined, bad: string }

function oauthFrom(af: Field[], key: string, allowPrivate: bool): { oauth: AgentOAuth | undefined, bad: string } {
  const raw = find(af, "oauth")
  const none = (msg: string): { oauth: AgentOAuth | undefined, bad: string } => ({ oauth: undefined, bad: msg })
  if (raw === undefined || isNull(raw)) return none(`${key}: oauth auth needs an oauth object`)
  const of = objectFields(raw)
  if (of === undefined) return none(`${key}.oauth must be an object`)
  const id = rawStr(of, "client_id") ?? ""
  const secret = rawStr(of, "client_secret") ?? ""
  if (id === "" || secret === "") return none(`${key}: OAuth auth requires inline client_id and client_secret`)
  const pu = rawStr(of, "provider_url") ?? ""
  const du = rawStr(of, "discovery_url") ?? ""
  const tu = rawStr(of, "token_url") ?? ""
  if (pu === "" && du === "" && tu === "") return none(`${key}: OAuth auth requires token_url, discovery_url or provider_url`)
  const urls: string[][] = [["provider_url", pu], ["discovery_url", du], ["token_url", tu]]
  for (const pair of urls) {
    if (pair[1]! === "") continue
    const p = urlProblem(pair[1]!, allowPrivate)
    if (p !== "") return none(`${key}.oauth.${pair[0]!}: ${p}`)
  }
  let scopes: string[] | undefined = undefined
  const sraw = find(of, "scopes")
  if (sraw !== undefined && !isNull(sraw)) {
    scopes = strList(sraw)
    if (scopes === undefined) return none(`${key}.oauth.scopes must be an array of strings`)
  }
  const resource = rawStr(of, "resource")
  return { oauth: { provider_url: pu === "" ? undefined : pu, discovery_url: du === "" ? undefined : du, token_url: tu === "" ? undefined : tu, client_id: id, client_secret: secret, scopes: scopes, resource: resource === "" ? undefined : resource }, bad: "" }
}

function tlsFrom(af: Field[], key: string): { tls: AgentTls | undefined, bad: string } {
  const raw = find(af, "tls")
  if (raw === undefined || isNull(raw)) return { tls: undefined, bad: "" }
  const tf = objectFields(raw)
  if (tf === undefined) return { tls: undefined, bad: `${key}.tls must be an object` }
  for (const k of ["ca_cert_pem", "client_cert_pem", "client_key_pem"]) {
    const r = find(tf, k)
    if (r !== undefined && !isNull(r) && !r.startsWith("\"")) return { tls: undefined, bad: `${key}.tls.${k} must be a string` }
  }
  const cert = rawStr(tf, "client_cert_pem") ?? ""
  const keyPem = rawStr(tf, "client_key_pem") ?? ""
  if ((cert === "") !== (keyPem === "")) return { tls: undefined, bad: `${key}.tls: a client certificate needs both client_cert_pem and client_key_pem` }
  return { tls: { insecure_skip_verify: rawBool(tf, "insecure_skip_verify"), ca_cert_pem: rawStr(tf, "ca_cert_pem"), client_cert_pem: rawStr(tf, "client_cert_pem"), client_key_pem: rawStr(tf, "client_key_pem") }, bad: "" }
}

// An agent's auth object: type none, headers or oauth. bad names the first problem.
function authFrom(fs: Field[], key: string, allowPrivate: bool): AuthRead {
  const raw = find(fs, key)
  if (raw === undefined || isNull(raw)) return { auth: undefined, bad: "" }
  const af = objectFields(raw)
  if (af === undefined) return { auth: undefined, bad: `${key} must be an object` }
  const type = rawStr(af, "type") ?? "none"
  if (type !== "none" && type !== "headers" && type !== "oauth") return { auth: undefined, bad: `${key}.type must be none, headers or oauth` }
  const hraw = find(af, "headers")
  let headers: Map<string, string> | undefined = undefined
  if (hraw !== undefined && !isNull(hraw)) {
    headers = headerMap(hraw)
    if (headers === undefined) return { auth: undefined, bad: `${key}.headers must be an object of string values` }
    for (const k of headers.keys()) {
      if (blockedHeader(k) || (headers.get(k) ?? "") === "") return { auth: undefined, bad: `${key}.headers need a non-empty, forwardable name and value` }
    }
  }
  if (type === "headers" && (headers === undefined || headers.keys().length === 0)) return { auth: undefined, bad: `${key}: header auth needs at least one header` }
  let oauth: AgentOAuth | undefined = undefined
  if (type === "oauth") {
    const o = oauthFrom(af, key, allowPrivate)
    if (o.bad !== "") return { auth: undefined, bad: o.bad }
    oauth = o.oauth
  }
  let schemes: string[] | undefined = undefined
  const sraw = find(af, "security_schemes")
  if (sraw !== undefined && !isNull(sraw)) {
    schemes = strList(sraw)
    if (schemes === undefined) return { auth: undefined, bad: `${key}.security_schemes must be an array of strings` }
    for (let i = 0; i < schemes.length; i++) {
      if (schemes[i]!.trim() === "") return { auth: undefined, bad: `${key}.security_schemes cannot contain an empty name` }
      if (schemes.indexOf(schemes[i]!) !== i) return { auth: undefined, bad: `duplicate ${key} security scheme "${schemes[i]!}"` }
    }
  }
  const t = tlsFrom(af, key)
  if (t.bad !== "") return { auth: undefined, bad: t.bad }
  return { auth: { type: type, headers: headers, oauth: oauth, security_schemes: schemes, advanced: rawBool(af, "advanced"), tls: t.tls }, bad: "" }
}

// A secret as a read shows it: env references are shown, stored values are masked, empty stays empty.
function shown(v: string): string {
  if (v === "") return ""
  return v.startsWith("env.") ? v : MASK
}

function opt(v: string | undefined): string {
  return v === undefined ? "null" : quote(v)
}

// The auth as a read shows it (secret values masked).
function authView(a: AgentAuth | undefined): string {
  if (a === undefined) return "null"
  const hs = a.headers
  let hv = "null"
  if (hs !== undefined) {
    const pairs: string[] = []
    for (const k of hs.keys()) pairs.push(quote(k) + ":" + quote(shown(hs.get(k) ?? "")))
    hv = "{" + pairs.join(",") + "}"
  }
  let ov = "null"
  const o = a.oauth
  if (o !== undefined) ov = `{"provider_url":${opt(o.provider_url)},"discovery_url":${opt(o.discovery_url)},"token_url":${opt(o.token_url)},"client_id":${quote(shown(o.client_id))},"client_secret":${quote(shown(o.client_secret))},"scopes":${JSON.stringify(o.scopes ?? [])},"resource":${opt(o.resource)}}`
  let tv = "null"
  const t = a.tls
  if (t !== undefined) tv = `{"insecure_skip_verify":${t.insecure_skip_verify === true ? "true" : "false"},"ca_cert_pem":${quote(shown(t.ca_cert_pem ?? ""))},"client_cert_pem":${quote(shown(t.client_cert_pem ?? ""))},"client_key_pem":${quote(shown(t.client_key_pem ?? ""))}}`
  return `{"type":${quote(a.type)},"headers":${hv},"oauth":${ov},"security_schemes":${JSON.stringify(a.security_schemes ?? [])},"advanced":${a.advanced === true ? "true" : "false"},"tls":${tv}}`
}

// The identity of an auth with its values, for telling whether a replace changed it.
function authKey(a: AgentAuth | undefined): string {
  if (a === undefined) return ""
  const parts: string[] = [a.type]
  const hs = a.headers
  if (hs !== undefined) {
    for (const k of hs.keys()) parts.push(k + "=" + (hs.get(k) ?? ""))
  }
  const o = a.oauth
  if (o !== undefined) parts.push(JSON.stringify(o))
  const t = a.tls
  if (t !== undefined) parts.push(JSON.stringify(t))
  return parts.join("|")
}

// The card's JSON-RPC endpoint: its url (A2A v0.3), else the first JSON-RPC interface (v1). "" when there is none.
export function endpointOf(card: string): string {
  return interfaceUrl(card, "JSONRPC")
}

// The card's REST (HTTP+JSON) endpoint, "" when there is none.
export function restEndpointOf(card: string): string {
  return interfaceUrl(card, "HTTP+JSON")
}

// The card the gateway serves: the cached card with its endpoints rewritten to the gateway's JSON-RPC and REST
// routes, push notifications advertised only when the gateway relays them and the agent can push, the agent's
// signatures dropped (the document changed), and the caller authenticating with x-bf-vk. base is the public
// base URL the gateway is reached at.
export function gatewayCard(card: string, base: string, name: string, pushOn: bool): string {
  let cf: Field[] = objectFields(card) ?? []
  const root = base + "/agents/a2a/" + name
  const rpc = root + JSON_RPC_SUFFIX
  const rest = root + REST_PREFIX
  const v1 = find(cf, "supportedInterfaces") !== undefined
  setField(&cf, "url", quote(rpc))
  setField(&cf, "preferredTransport", quote("JSONRPC"))
  if (v1) setField(&cf, "supportedInterfaces", `[{"url":${quote(rpc)},"protocolBinding":"JSONRPC","protocolVersion":"1.0"},{"url":${quote(rest)},"protocolBinding":"HTTP+JSON","protocolVersion":"1.0"}]`)
  if (!v1 || find(cf, "additionalInterfaces") !== undefined) setField(&cf, "additionalInterfaces", `[{"url":${quote(rpc)},"transport":"JSONRPC"},{"url":${quote(rest)},"transport":"HTTP+JSON"}]`)
  let caps: Field[] = objectFields(find(cf, "capabilities") ?? "") ?? []
  setField(&caps, "pushNotifications", pushOn && cardPushes(card) ? "true" : "false")
  setField(&cf, "capabilities", build(caps))
  setField(&cf, "securitySchemes", `{"bifrostVirtualKey":{"type":"apiKey","in":"header","name":"x-bf-vk"}}`)
  setField(&cf, "security", `[{"bifrostVirtualKey":[]}]`)
  const out: Field[] = []
  for (const f of cf) {
    if (f.key !== "signatures") out.push(f)
  }
  return build(out)
}

// The card that lists the agents a caller may call, at GET /agents/a2a (Raiju's own; Bifrost serves cards per
// agent only). It is an agent card for the gateway as a whole: the skills of every listed agent, prefixed with
// the agent's name, and an agents list with each agent's gateway routes.
export function aggregateCard(list: AgentConfig[], base: string, pushOn: bool): string {
  const skills: string[] = []
  const agents: string[] = []
  let streaming = false
  let pushing = false
  for (const a of list) {
    const card = a.card ?? ""
    if (card === "") continue
    const cf = objectFields(card)
    if (cf === undefined) continue
    const root = base + "/agents/a2a/" + a.name
    const ids: string[] = []
    const sraw = find(cf, "skills")
    if (sraw !== undefined && sraw.startsWith("[")) {
      try {
        for (const it of elements(sraw)) {
          const sf = objectFields(it)
          if (sf === undefined) continue
          const sid = rawStr(sf, "id") ?? rawStr(sf, "name") ?? ""
          if (sid === "") continue
          const gid = a.name + "/" + sid
          ids.push(gid)
          const tags = strList(find(sf, "tags") ?? "") ?? []
          if (!tags.includes(a.name)) tags.push(a.name)
          let out = sf
          setField(&out, "id", quote(gid))
          setField(&out, "tags", JSON.stringify(tags))
          skills.push(build(out))
        }
      } catch (e) {
        // an agent whose skills cannot be read is listed without them
      }
    }
    const caps = objectFields(find(cf, "capabilities") ?? "")
    if (caps !== undefined && rawBool(caps, "streaming") === true) streaming = true
    if (pushOn && cardPushes(card)) pushing = true
    agents.push(`{"name":${quote(a.name)},"description":${quote(rawStr(cf, "description") ?? "")},"agent_card_url":${quote(root + CARD_PATH)},"json_rpc_url":${quote(root + JSON_RPC_SUFFIX)},"rest_url":${quote(root + REST_PREFIX)},"skills":${JSON.stringify(ids)}}`)
  }
  const parts: string[] = [
    `"name":"Raiju agent gateway"`,
    `"description":"The A2A agents registered with this gateway"`,
    `"url":${quote(base + "/agents/a2a")}`,
    `"version":"1.0.0"`,
    `"protocolVersion":"0.3.0"`,
    `"capabilities":{"streaming":${streaming ? "true" : "false"},"pushNotifications":${pushing ? "true" : "false"}}`,
    `"defaultInputModes":["text/plain"]`,
    `"defaultOutputModes":["text/plain"]`,
    `"skills":[${skills.join(",")}]`,
    `"agents":[${agents.join(",")}]`,
    `"securitySchemes":{"bifrostVirtualKey":{"type":"apiKey","in":"header","name":"x-bf-vk"}}`,
    `"security":[{"bifrostVirtualKey":[]}]`,
  ]
  return "{" + parts.join(",") + "}"
}

// Fetches an agent card and checks it: a JSON object with a name and an endpoint the URL guard allows. The
// card's raw text is what the registration keeps. credId names the OAuth token cache entry of the auth.
export async function fetchCard(url: string, auth: AgentAuth | undefined, allowPrivate: bool, credId: string): Promise<CardResult, Error> {
  const bad = urlProblem(url, allowPrivate)
  if (bad !== "") return { card: "", error: `agent_card_url: ${bad}` }
  const ah = await upstreamHeaders(credId, auth, allowPrivate)
  if (ah.error !== "") return { card: "", error: `the agent card could not be fetched: ${ah.error}` }
  const hm = ah.headers
  hm.set("accept", "application/json")
  const hs: Record<string, string> = hm
  const dl = deadline(CARD_TIMEOUT_MS)
  try {
    const r = await fetch(url, { headers: hs, signal: dl.controller.signal, tls: tlsOf(auth) })
    const text = await r.text()
    dl.finish()
    if (r.status < 200 || r.status >= 300) return { card: "", error: `the agent card answered HTTP ${r.status}` }
    const cf = objectFields(text)
    if (cf === undefined) return { card: "", error: "the agent card is not a JSON object" }
    if ((rawStr(cf, "name") ?? "") === "") return { card: "", error: "the agent card has no name" }
    if (endpointOf(text) === "" && restEndpointOf(text) === "") return { card: "", error: "the agent card names no endpoint" }
    for (const i of interfacesOf(text).list) {
      if (i.binding !== "JSONRPC" && i.binding !== "HTTP+JSON") continue
      const epBad = urlProblem(i.url, allowPrivate)
      if (epBad !== "") return { card: "", error: `the agent card's endpoint: ${epBad}` }
    }
    return { card: text, error: "" }
  } catch (e) {
    dl.finish()
    return { card: "", error: `the agent card could not be fetched: ${e.message}` }
  }
}

// A whole-number field as JSON: its value, or null when it is not set.
function numOrNull(v: int | undefined): string {
  if (v === undefined) return "null"
  return JSON.stringify(v)
}

// The API view of a registration: its settings, the cached card, and the gateway's endpoints.
// Secret values are masked; the card is its raw JSON.
export function agentView(a: AgentConfig, base: string): string {
  const gw = base + "/agents/a2a/" + a.name
  const card = a.card === undefined || a.card === "" ? "null" : a.card
  const vks: string[] = a.virtual_key_ids ?? []
  const parts: string[] = [
    `"name":${quote(a.name)}`,
    `"agent_card_url":${quote(a.agent_card_url)}`,
    `"enabled":${a.enabled === false ? "false" : "true"}`,
    `"allow_by_default":${a.allow_by_default === true ? "true" : "false"}`,
    `"forward_accepted_credential":${a.forward_accepted_credential === true ? "true" : "false"}`,
    `"forward_accepted_credential_overrides_auth":${a.forward_accepted_credential_overrides_auth === true ? "true" : "false"}`,
    `"virtual_key_ids":${JSON.stringify(vks)}`,
    `"discovery_auth":${authView(a.discovery_auth)}`,
    `"runtime_auth":${authView(a.runtime_auth)}`,
    `"allow_private_network":${a.allow_private_network === true ? "true" : "false"}`,
    `"card":${card}`,
    `"card_fetched_at":${numOrNull(a.card_fetched_at)}`,
    `"endpoint":${quote(endpointOf(card === "null" ? "" : card))}`,
    `"rest_endpoint":${quote(restEndpointOf(card === "null" ? "" : card))}`,
    `"created_at":${numOrNull(a.created_at)}`,
    `"updated_at":${numOrNull(a.updated_at)}`,
    `"gateway":{"agent_card_url":${quote(gw + CARD_PATH)},"json_rpc_url":${quote(gw + JSON_RPC_SUFFIX)},"rest_url":${quote(gw + REST_PREFIX)}}`,
  ]
  return "{" + parts.join(",") + "}"
}

// The fields of a create or replace body, checked. error is the reason it is refused. A masked secret
// keeps the stored value of the same field (old, for a replace).
type Draft = { url: string, enabled: bool, allowDefault: bool, forward: bool, forwardOver: bool, vks: string[], discovery: AgentAuth | undefined, runtime: AgentAuth | undefined, allowPrivate: bool, error: string }

// The stored value of a secret, for a masked one.
function keepStr(v: string, was: string | undefined): string {
  if (v !== MASK) return v
  return was ?? v
}

// The auth of a body with masked values filled in from the stored one.
function filled(a: AuthRead, old: AgentAuth | undefined): AgentAuth | undefined {
  const au = a.auth
  if (au === undefined) return undefined
  let headers: Map<string, string> | undefined = undefined
  const hs = au.headers
  if (hs !== undefined) {
    const m: Map<string, string> = new Map()
    const oh = old?.headers
    for (const k of hs.keys()) m.set(k, keepStr(hs.get(k) ?? "", oh === undefined ? undefined : oh.get(k)))
    headers = m
  }
  let oauth = au.oauth
  const oo = old?.oauth
  if (oauth !== undefined) oauth = { provider_url: oauth.provider_url, discovery_url: oauth.discovery_url, token_url: oauth.token_url, client_id: keepStr(oauth.client_id, oo?.client_id), client_secret: keepStr(oauth.client_secret, oo?.client_secret), scopes: oauth.scopes, resource: oauth.resource }
  let tls = au.tls
  const ot = old?.tls
  if (tls !== undefined) tls = { insecure_skip_verify: tls.insecure_skip_verify, ca_cert_pem: tls.ca_cert_pem === undefined ? undefined : keepStr(tls.ca_cert_pem, ot?.ca_cert_pem), client_cert_pem: tls.client_cert_pem === undefined ? undefined : keepStr(tls.client_cert_pem, ot?.client_cert_pem), client_key_pem: tls.client_key_pem === undefined ? undefined : keepStr(tls.client_key_pem, ot?.client_key_pem) }
  return { type: au.type, headers: headers, oauth: oauth, security_schemes: au.security_schemes, advanced: au.advanced, tls: tls }
}

function draftOf(fs: Field[], old: AgentConfig | undefined): Draft {
  const url = rawStr(fs, "agent_card_url") ?? ""
  const allowPrivate = rawBool(fs, "allow_private_network") ?? old?.allow_private_network ?? false
  const bad = (msg: string): Draft => ({ url: url, enabled: true, allowDefault: false, forward: false, forwardOver: false, vks: [], discovery: undefined, runtime: undefined, allowPrivate: allowPrivate, error: msg })
  if (url === "") return bad("agent_card_url is required")
  const up = urlProblem(url, allowPrivate)
  if (up !== "") return bad(`agent_card_url: ${up}`)
  const vraw = find(fs, "virtual_key_ids")
  const vks: string[] = []
  if (vraw !== undefined && !isNull(vraw)) {
    let items: string[] = []
    try {
      items = elements(vraw)
      for (const it of items) {
        const id = decodeString(it)
        if (!it.startsWith("\"") || id === "" || vks.includes(id)) return bad("virtual_key_ids: empty and duplicate IDs are rejected")
        vks.push(id)
      }
    } catch (e) {
      return bad("virtual_key_ids must be an array of strings")
    }
  }
  const d = authFrom(fs, "discovery_auth", allowPrivate)
  if (d.bad !== "") return bad(d.bad)
  const r = authFrom(fs, "runtime_auth", allowPrivate)
  if (r.bad !== "") return bad(r.bad)
  for (const k of ["forward_accepted_credential", "forward_accepted_credential_overrides_auth"]) {
    const raw = find(fs, k)
    if (raw !== undefined && !isNull(raw) && raw !== "true" && raw !== "false") return bad(`${k} must be a boolean`)
  }
  return { url: url, enabled: rawBool(fs, "enabled") ?? true, allowDefault: rawBool(fs, "allow_by_default") ?? false, forward: rawBool(fs, "forward_accepted_credential") ?? false, forwardOver: rawBool(fs, "forward_accepted_credential_overrides_auth") ?? false, vks: vks, discovery: filled(d, old?.discovery_auth), runtime: filled(r, old?.runtime_auth), allowPrivate: allowPrivate, error: "" }
}

function indexOf(list: AgentConfig[], name: string): int {
  for (let i = 0; i < list.length; i++) {
    if (list[i]!.name === name) return i
  }
  return -1
}

function withoutAt(list: AgentConfig[], i: int): AgentConfig[] {
  const out: AgentConfig[] = []
  for (let j = 0; j < list.length; j++) {
    if (j !== i) out.push(list[j]!)
  }
  return out
}

async function create(list: AgentConfig[], body: string, base: string): Promise<AgentReply, Error> {
  const fs = objectFields(body)
  if (fs === undefined) return fail(400, "invalid request body")
  const name = rawStr(fs, "name") ?? ""
  if (!validName(name)) return fail(400, "name must be lowercase letters and digits, with single hyphens between them")
  if (indexOf(list, name) >= 0) return fail(409, "an agent with this name already exists")
  const d = draftOf(fs, undefined)
  if (d.error !== "") return fail(400, d.error)
  const f = await fetchCard(d.url, d.discovery, d.allowPrivate, name + "|discovery")
  if (f.error !== "") return fail(400, f.error)
  const now = Math.floor(Date.now())
  const made: AgentConfig = { name: name, agent_card_url: d.url, enabled: d.enabled, allow_by_default: d.allowDefault, forward_accepted_credential: d.forward, forward_accepted_credential_overrides_auth: d.forwardOver, virtual_key_ids: d.vks, discovery_auth: d.discovery, runtime_auth: d.runtime, allow_private_network: d.allowPrivate, card: f.card, card_fetched_at: now, created_at: now, updated_at: now }
  return reply(201, agentView(made, base), list.concat([made]))
}

// A full replacement (PUT): the card is fetched again when its URL, its discovery auth or the private-network
// setting changed, or when none is cached.
async function replace(list: AgentConfig[], i: int, body: string, base: string): Promise<AgentReply, Error> {
  const old = list[i]!
  const fs = objectFields(body)
  if (fs === undefined) return fail(400, "invalid request body")
  const d = draftOf(fs, old)
  if (d.error !== "") return fail(400, d.error)
  const changed = d.url !== old.agent_card_url || d.allowPrivate !== (old.allow_private_network === true) || authKey(d.discovery) !== authKey(old.discovery_auth)
  let card = old.card ?? ""
  let fetched = old.card_fetched_at
  const now = Math.floor(Date.now())
  if (changed || card === "") {
    const f = await fetchCard(d.url, d.discovery, d.allowPrivate, old.name + "|discovery")
    if (f.error !== "") return fail(400, f.error)
    card = f.card
    fetched = now
  }
  const made: AgentConfig = { name: old.name, agent_card_url: d.url, enabled: d.enabled, allow_by_default: d.allowDefault, forward_accepted_credential: d.forward, forward_accepted_credential_overrides_auth: d.forwardOver, virtual_key_ids: d.vks, discovery_auth: d.discovery, runtime_auth: d.runtime, allow_private_network: d.allowPrivate, card: card, card_fetched_at: fetched, created_at: old.created_at, updated_at: now }
  const out: AgentConfig[] = []
  for (let j = 0; j < list.length; j++) out.push(j === i ? made : list[j]!)
  return reply(200, agentView(made, base), out)
}

// Fetches the card of a body's URL and answers it, without saving anything.
async function inspect(body: string): Promise<AgentReply, Error> {
  const fs = objectFields(body)
  if (fs === undefined) return fail(400, "invalid request body")
  const allowPrivate = rawBool(fs, "allow_private_network") ?? false
  const a = authFrom(fs, "discovery_auth", allowPrivate)
  if (a.bad !== "") return fail(400, a.bad)
  const f = await fetchCard(rawStr(fs, "agent_card_url") ?? "", a.auth, allowPrivate, "inspect|discovery")
  if (f.error !== "") return fail(400, f.error)
  return reply(200, `{"card":${f.card}}`)
}

// The registration with a freshly fetched card.
export function withCard(old: AgentConfig, card: string, now: int): AgentConfig {
  return { name: old.name, agent_card_url: old.agent_card_url, enabled: old.enabled, allow_by_default: old.allow_by_default, forward_accepted_credential: old.forward_accepted_credential, forward_accepted_credential_overrides_auth: old.forward_accepted_credential_overrides_auth, virtual_key_ids: old.virtual_key_ids, discovery_auth: old.discovery_auth, runtime_auth: old.runtime_auth, allow_private_network: old.allow_private_network, card: card, card_fetched_at: now, created_at: old.created_at, updated_at: now }
}

// Fetches the card again for a registration: its cache is replaced.
async function refresh(list: AgentConfig[], i: int, base: string): Promise<AgentReply, Error> {
  const old = list[i]!
  const f = await fetchCard(old.agent_card_url, old.discovery_auth, old.allow_private_network === true, old.name + "|discovery")
  if (f.error !== "") return fail(400, f.error)
  const made = withCard(old, f.card, Math.floor(Date.now()))
  const out: AgentConfig[] = []
  for (let j = 0; j < list.length; j++) out.push(j === i ? made : list[j]!)
  return reply(200, agentView(made, base), out)
}

// Fetches the card of every enabled registration again (the timer's pass) and returns the list to save, undefined
// when no card changed. A card that cannot be fetched is kept as it was. changed names the registrations whose card
// moved, failed those whose fetch failed and why.
export async function refreshAll(list: AgentConfig[]): Promise<{ next: AgentConfig[] | undefined, changed: string[], failed: string[] }> {
  const out: AgentConfig[] = []
  const changed: string[] = []
  const failed: string[] = []
  let any = false
  for (const a of list) {
    if (a.enabled === false) {
      out.push(a)
      continue
    }
    try {
      const f = await fetchCard(a.agent_card_url, a.discovery_auth, a.allow_private_network === true, a.name + "|discovery")
      if (f.error !== "") {
        failed.push(`${a.name}: ${f.error}`)
        out.push(a)
        continue
      }
      if (f.card === (a.card ?? "")) {
        out.push(a)
        continue
      }
      out.push(withCard(a, f.card, Math.floor(Date.now())))
      changed.push(a.name)
      any = true
    } catch (e) {
      failed.push(`${a.name}: ${e.message}`)
      out.push(a)
    }
  }
  return { next: any ? out : undefined, changed: changed, failed: failed }
}

// Routes one request under /api/agents (the history and the push configs are ops.tov's). base is the public
// base URL the gateway endpoints are shown at. Changes come back as next, the list to save.
export async function agentApi(cfg: AgentConfig[] | undefined, method: string, path: string, body: string, base: string): Promise<AgentReply, Error> {
  const list: AgentConfig[] = cfg ?? []
  const segs = path.split("?")[0]!.split("/").filter((x) => x !== "")
  const name = segs[2] ?? ""
  if (segs.length === 2) {
    if (method === "GET") {
      const views: string[] = []
      for (const a of list) views.push(agentView(a, base))
      return reply(200, `{"agents":[${views.join(",")}]}`)
    }
    if (method === "POST") return await create(list, body, base)
    return fail(405, "use GET or POST")
  }
  if (segs.length === 3 && name === "inspect") {
    if (method !== "POST") return fail(405, "use POST")
    return await inspect(body)
  }
  if (segs.length === 4 && segs[3] === "refresh-card") {
    if (method !== "POST") return fail(405, "use POST")
    const i = indexOf(list, name)
    if (i < 0) return fail(404, "agent not found")
    return await refresh(list, i, base)
  }
  if (segs.length === 3) {
    if (method !== "GET" && method !== "PUT" && method !== "DELETE") return fail(405, "use GET, PUT or DELETE")
    const i = indexOf(list, name)
    if (i < 0) return fail(404, "agent not found")
    if (method === "GET") return reply(200, agentView(list[i]!, base))
    if (method === "PUT") return await replace(list, i, body, base)
    return reply(200, `{"deleted":true,"name":${quote(name)}}`, withoutAt(list, i))
  }
  return fail(404, "no such route")
}

// ---- the gateway ----

// The public base URL the gateway's endpoints are advertised at: client.a2a_external_client_url when it is
// set, else the origin the request came in on.
export function publicBase(external: string | undefined, url: string): string {
  const ext = external ?? ""
  if (ext !== "") return ext.endsWith("/") ? ext.slice(0, ext.byteLength - 1) : ext
  const u = URL.parse(url)
  return u === undefined ? "" : u.origin
}

export function findAgent(list: AgentConfig[] | undefined, name: string): AgentConfig | undefined {
  for (const a of list ?? []) {
    if (a.name === name) return a
  }
  return undefined
}

// Whether a caller may call an agent: an identified key needs the agent's grant or allow_by_default. An
// anonymous call (no key, enforcement off) is not limited by the grants, as Bifrost does.
export function grantAllows(a: AgentConfig, vkId: string | undefined): bool {
  if (vkId === undefined) return true
  return a.allow_by_default === true || (a.virtual_key_ids ?? []).includes(vkId)
}

// The context id a request names (params.message.contextId): the conversation the call belongs to.
export function contextOfParams(params: string): string {
  try {
    const pf = fields(params)
    const mraw = find(pf, "message")
    if (mraw !== undefined) return rawStr(fields(mraw), "contextId") ?? ""
    return rawStr(pf, "contextId") ?? ""
  } catch (e) {
    return ""
  }
}

// The context id of a JSON-RPC request body.
export function contextOfRequest(body: string): string {
  try {
    return contextOfParams(find(fields(body), "params") ?? "{}")
  } catch (e) {
    return ""
  }
}

// The context id of a unary result (a task, a message, or a v1 {task} / {message} wrapper).
export function contextOfResult(result: string): string {
  try {
    const rf = fields(result)
    const direct = rawStr(rf, "contextId") ?? ""
    if (direct !== "") return direct
    const tr = find(rf, "task")
    if (tr !== undefined) return rawStr(fields(tr), "contextId") ?? ""
    const mr = find(rf, "message")
    if (mr !== undefined) return rawStr(fields(mr), "contextId") ?? ""
    return ""
  } catch (e) {
    return ""
  }
}

// The context id of a unary JSON-RPC answer (its result).
export function contextOfResponse(text: string): string {
  try {
    return contextOfResult(find(fields(text), "result") ?? "{}")
  } catch (e) {
    return ""
  }
}

// ---- tests ----

// The value of a header of an auth, "" when it has none.
function headerOf(a: AgentAuth | undefined, key: string): string {
  if (a === undefined) return ""
  const hs = a.headers
  if (hs === undefined) return ""
  return hs.get(key) ?? ""
}

function headersOf(pairs: string[][]): Map<string, string> {
  const m: Map<string, string> = new Map()
  for (const p of pairs) m.set(p[0]!, p[1]!)
  return m
}

test("agent names are lowercase, digits and single hyphens", () => {
  expect(validName("library-research")).toBe(true)
  expect(validName("a1")).toBe(true)
  expect(validName("Bad")).toBe(false)
  expect(validName("-lead")).toBe(false)
  expect(validName("two--hyphens")).toBe(false)
  expect(validName("")).toBe(false)
  expect(validName("with space")).toBe(false)
})

test("the endpoints are the card's interfaces of each binding", () => {
  expect(endpointOf(`{"name":"a","url":"https://x.example.com/rpc"}`)).toBe("https://x.example.com/rpc")
  expect(endpointOf(`{"name":"a","supportedInterfaces":[{"url":"https://x.example.com/rest","protocolBinding":"HTTP+JSON"},{"url":"https://x.example.com/v1","protocolBinding":"JSONRPC"}]}`)).toBe("https://x.example.com/v1")
  expect(restEndpointOf(`{"name":"a","supportedInterfaces":[{"url":"https://x.example.com/rest","protocolBinding":"HTTP+JSON"},{"url":"https://x.example.com/v1","protocolBinding":"JSONRPC"}]}`)).toBe("https://x.example.com/rest")
  expect(endpointOf(`{"name":"a","additionalInterfaces":[{"url":"https://x.example.com/t","transport":"JSONRPC"}]}`)).toBe("https://x.example.com/t")
  expect(endpointOf(`{"name":"a"}`)).toBe("")
  expect(endpointOf("not json")).toBe("")
  // a v0.3 card whose own url is the REST one has no JSON-RPC endpoint
  expect(endpointOf(`{"name":"a","url":"https://x.example.com/r","preferredTransport":"HTTP+JSON"}`)).toBe("")
  expect(restEndpointOf(`{"name":"a","url":"https://x.example.com/r","preferredTransport":"HTTP+JSON"}`)).toBe("https://x.example.com/r")
})

test("the gateway card points at the gateway's JSON-RPC and REST routes and asks for the virtual key", () => {
  const card = try gatewayCard(`{"name":"echo","url":"https://agent.example.com/rpc","signatures":[{"protected":"x","signature":"y"}],"capabilities":{"streaming":true,"pushNotifications":true},"supportedInterfaces":[{"url":"https://agent.example.com/v1","protocolBinding":"JSONRPC"}]}`, "https://gw.example.com", "echo", true)
  expect(endpointOf(card)).toBe("https://gw.example.com/agents/a2a/echo/json-rpc")
  expect(restEndpointOf(card)).toBe("https://gw.example.com/agents/a2a/echo/rest")
  expect(card.includes(`"supportedInterfaces":[{"url":"https://gw.example.com/agents/a2a/echo/json-rpc","protocolBinding":"JSONRPC","protocolVersion":"1.0"},{"url":"https://gw.example.com/agents/a2a/echo/rest","protocolBinding":"HTTP+JSON","protocolVersion":"1.0"}]`)).toBe(true)
  expect(card.includes(`"securitySchemes":{"bifrostVirtualKey":{"type":"apiKey","in":"header","name":"x-bf-vk"}}`)).toBe(true)
  expect(card.includes("signatures")).toBe(false)
  expect(card.includes(`"streaming":true`)).toBe(true)
  expect(card.includes(`"pushNotifications":true`)).toBe(true)
  expect(rawStr(try fields(card), "name")).toBe("echo")
  // push is advertised only when the gateway relays it and the agent can push
  expect(try gatewayCard(`{"name":"echo","url":"https://agent.example.com/rpc","capabilities":{"pushNotifications":true}}`, "https://gw.example.com", "echo", false).includes(`"pushNotifications":false`)).toBe(true)
  expect(try gatewayCard(`{"name":"echo","url":"https://agent.example.com/rpc"}`, "https://gw.example.com", "echo", true).includes(`"pushNotifications":false`)).toBe(true)
  // a v0.3 card lists its additional interfaces
  const old = try gatewayCard(`{"name":"echo","url":"https://agent.example.com/rpc"}`, "https://gw.example.com", "echo", true)
  expect(old.includes(`"additionalInterfaces":[{"url":"https://gw.example.com/agents/a2a/echo/json-rpc","transport":"JSONRPC"},{"url":"https://gw.example.com/agents/a2a/echo/rest","transport":"HTTP+JSON"}]`)).toBe(true)
  expect(old.includes("supportedInterfaces")).toBe(false)
})

test("the aggregated card lists the agents' skills under their names", () => {
  const a: AgentConfig = { name: "echo", agent_card_url: "https://a.example.com/card", card: `{"name":"e","description":"Echoes","url":"https://a.example.com/rpc","capabilities":{"streaming":true},"skills":[{"id":"say","name":"Say","description":"d","tags":["t"]}]}` }
  const b: AgentConfig = { name: "calc", agent_card_url: "https://b.example.com/card", card: `{"name":"c","url":"https://b.example.com/rpc","capabilities":{"pushNotifications":true},"skills":[{"id":"add","name":"Add"}]}` }
  const none: AgentConfig = { name: "unfetched", agent_card_url: "https://c.example.com/card" }
  const card = aggregateCard([a, b, none], "https://gw.example.com", true)
  const cf = try fields(card)
  expect(rawStr(cf, "name")).toBe("Raiju agent gateway")
  expect(rawStr(cf, "url")).toBe("https://gw.example.com/agents/a2a")
  expect(card.includes(`"id":"echo/say"`)).toBe(true)
  expect(card.includes(`"id":"calc/add"`)).toBe(true)
  expect(card.includes(`"tags":["t","echo"]`)).toBe(true)
  expect(card.includes(`"capabilities":{"streaming":true,"pushNotifications":true}`)).toBe(true)
  expect(card.includes(`"rest_url":"https://gw.example.com/agents/a2a/echo/rest"`)).toBe(true)
  expect(card.includes("unfetched")).toBe(false)
  expect(aggregateCard([], "https://gw.example.com", true).includes(`"agents":[]`)).toBe(true)
})

test("views show env references and mask stored secrets", () => {
  const a: AgentConfig = { name: "echo", agent_card_url: "https://a.example.com/card", virtual_key_ids: ["vk1"], forward_accepted_credential: true, runtime_auth: { type: "headers", headers: headersOf([["Authorization", "env.AGENT_TOKEN"], ["X-Key", "plain-secret"]]) }, discovery_auth: { type: "oauth", oauth: { token_url: "https://idp.example.com/token", client_id: "cid-plain", client_secret: "env.AGENT_SECRET", scopes: ["a2a"] }, tls: { ca_cert_pem: "PEM-TEXT" } }, card: `{"name":"echo","url":"https://a.example.com/rpc"}`, card_fetched_at: 5, created_at: 1, updated_at: 2 }
  const view = agentView(a, "https://gw.example.com")
  expect(view.includes(`"headers":{"Authorization":"env.AGENT_TOKEN","X-Key":"********"}`)).toBe(true)
  expect(view.includes("plain-secret")).toBe(false)
  expect(view.includes("cid-plain")).toBe(false)
  expect(view.includes("PEM-TEXT")).toBe(false)
  expect(view.includes(`"client_secret":"env.AGENT_SECRET"`)).toBe(true)
  expect(view.includes(`"client_id":"********"`)).toBe(true)
  expect(view.includes(`"scopes":["a2a"]`)).toBe(true)
  expect(view.includes(`"enabled":true`)).toBe(true)
  expect(view.includes(`"forward_accepted_credential":true`)).toBe(true)
  expect(view.includes(`"forward_accepted_credential_overrides_auth":false`)).toBe(true)
  expect(view.includes(`"virtual_key_ids":["vk1"]`)).toBe(true)
  expect(view.includes(`"endpoint":"https://a.example.com/rpc"`)).toBe(true)
  expect(view.includes(`"json_rpc_url":"https://gw.example.com/agents/a2a/echo/json-rpc"`)).toBe(true)
  expect(view.includes(`"rest_url":"https://gw.example.com/agents/a2a/echo/rest"`)).toBe(true)
  expect(rawStr(try fields(view), "name")).toBe("echo")
})

test("a masked secret keeps the stored value on replace; a new value replaces it", () => {
  const old: AgentConfig = { name: "echo", agent_card_url: "https://a.example.com/card", runtime_auth: { type: "headers", headers: headersOf([["X-Key", "stored"]]) }, discovery_auth: { type: "oauth", oauth: { token_url: "https://idp.example.com/token", client_id: "stored-id", client_secret: "stored-secret" }, tls: { ca_cert_pem: "STORED-PEM" } } }
  const kept = try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"headers","headers":{"X-Key":"********"}},"discovery_auth":{"type":"oauth","oauth":{"token_url":"https://idp.example.com/token","client_id":"********","client_secret":"********"},"tls":{"ca_cert_pem":"********"}}}`), old)
  expect(kept.error).toBe("")
  expect(headerOf(kept.runtime, "X-Key")).toBe("stored")
  expect(kept.discovery!.oauth!.client_id).toBe("stored-id")
  expect(kept.discovery!.oauth!.client_secret).toBe("stored-secret")
  expect(kept.discovery!.tls!.ca_cert_pem).toBe("STORED-PEM")
  expect(authKey(kept.discovery) === authKey(old.discovery_auth)).toBe(true)
  const changed = try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"headers","headers":{"X-Key":"fresh"}}}`), old)
  expect(headerOf(changed.runtime, "X-Key")).toBe("fresh")
  expect(changed.discovery).toBeUndefined()
  const none = try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card"}`), old)
  expect(none.runtime).toBeUndefined()
})

test("a registration body is checked: URL, grants and auth", () => {
  expect(try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card"}`), undefined).error).toBe("")
  expect(try draftOf(try fields(`{"agent_card_url":"https://user:pw@a.example.com/card"}`), undefined).error.includes("credentials")).toBe(true)
  expect(try draftOf(try fields(`{"agent_card_url":"http://127.0.0.1:1/card"}`), undefined).error.includes("private")).toBe(true)
  expect(try draftOf(try fields(`{"agent_card_url":"http://127.0.0.1:1/card","allow_private_network":true}`), undefined).error).toBe("")
  expect(try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","virtual_key_ids":["vk1","vk1"]}`), undefined).error.includes("duplicate")).toBe(true)
  expect(try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"headers","headers":{}}}`), undefined).error.includes("header")).toBe(true)
  expect(try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"headers","headers":{"Cookie":"x"}}}`), undefined).error.includes("forwardable")).toBe(true)
  expect(try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","discovery_auth":{"type":"basic"}}`), undefined).error.includes("none, headers or oauth")).toBe(true)
  expect(try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card"}`), undefined).enabled).toBe(true)
  expect(try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","enabled":false}`), undefined).enabled).toBe(false)
  const fwd = try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","forward_accepted_credential":true,"forward_accepted_credential_overrides_auth":true}`), undefined)
  expect(fwd.forward).toBe(true)
  expect(fwd.forwardOver).toBe(true)
  expect(try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","forward_accepted_credential":"yes"}`), undefined).error.includes("boolean")).toBe(true)
})

function draftError(body: string): string {
  try {
    return draftOf(fields(body), undefined).error
  } catch (e) {
    return "unreadable"
  }
}

test("an OAuth auth needs a client and a token source; tls and schemes are checked", () => {
  const ok = try draftOf(try fields(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"oauth","advanced":true,"security_schemes":["agentOauth"],"oauth":{"token_url":"https://idp.example.com/token","client_id":"id","client_secret":"s","scopes":["a","b"],"resource":"https://a.example.com"},"tls":{"ca_cert_pem":"PEM","insecure_skip_verify":false}}}`), undefined)
  expect(ok.error).toBe("")
  expect(ok.runtime!.type).toBe("oauth")
  expect(ok.runtime!.oauth!.scopes!.length).toBe(2)
  expect(ok.runtime!.oauth!.resource).toBe("https://a.example.com")
  expect(ok.runtime!.advanced).toBe(true)
  expect(ok.runtime!.security_schemes![0]!).toBe("agentOauth")
  expect(ok.runtime!.tls!.ca_cert_pem).toBe("PEM")
  expect(draftError(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"oauth"}}`).includes("oauth object")).toBe(true)
  expect(draftError(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"oauth","oauth":{"token_url":"https://idp.example.com/token","client_id":"id"}}}`).includes("client_secret")).toBe(true)
  expect(draftError(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"oauth","oauth":{"client_id":"id","client_secret":"s"}}}`).includes("token_url, discovery_url or provider_url")).toBe(true)
  expect(draftError(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"oauth","oauth":{"token_url":"http://127.0.0.1:1/t","client_id":"id","client_secret":"s"}}}`).includes("token_url")).toBe(true)
  expect(draftError(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"oauth","oauth":{"token_url":"https://idp.example.com/token","client_id":"id","client_secret":"s","scopes":[1]}}}`).includes("scopes")).toBe(true)
  expect(draftError(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"none","security_schemes":["a","a"]}}`).includes("duplicate")).toBe(true)
  expect(draftError(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"none","security_schemes":[" "]}}`).includes("empty name")).toBe(true)
  expect(draftError(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"none","tls":{"client_cert_pem":"c"}}}`).includes("both")).toBe(true)
  expect(draftError(`{"agent_card_url":"https://a.example.com/card","runtime_auth":{"type":"none","tls":{"ca_cert_pem":1}}}`).includes("string")).toBe(true)
})

test("JSON-RPC requests: the context a call belongs to", () => {
  const body = `{"jsonrpc":"2.0","id":7,"method":"message/send","params":{"message":{"messageId":"m1","contextId":"ctx-9","role":"user","parts":[{"kind":"text","text":"hi"}]}}}`
  expect(contextOfRequest(body)).toBe("ctx-9")
  expect(contextOfRequest(`{"jsonrpc":"2.0","id":1,"method":"tasks/get","params":{"id":"t1"}}`)).toBe("")
  expect(contextOfParams(`{"contextId":"c5"}`)).toBe("c5")
  expect(contextOfParams(`{"message":{"contextId":"c6"}}`)).toBe("c6")
})

test("grants: an identified key needs the grant or allow_by_default; anonymous calls pass", () => {
  const a: AgentConfig = { name: "echo", agent_card_url: "https://a.example.com/card", virtual_key_ids: ["vk1"] }
  expect(grantAllows(a, "vk1")).toBe(true)
  expect(grantAllows(a, "vk2")).toBe(false)
  expect(grantAllows(a, undefined)).toBe(true)
  const open: AgentConfig = { name: "echo", agent_card_url: "https://a.example.com/card", allow_by_default: true }
  expect(grantAllows(open, "vk2")).toBe(true)
})

test("the context of a unary answer comes from the task, the message or the result", () => {
  expect(contextOfResponse(`{"jsonrpc":"2.0","id":1,"result":{"kind":"task","id":"t1","contextId":"c1"}}`)).toBe("c1")
  expect(contextOfResponse(`{"jsonrpc":"2.0","id":1,"result":{"task":{"id":"t1","contextId":"c2"}}}`)).toBe("c2")
  expect(contextOfResponse(`{"jsonrpc":"2.0","id":1,"result":{"message":{"contextId":"c3"}}}`)).toBe("c3")
  expect(contextOfResponse(`{"jsonrpc":"2.0","id":1,"error":{"code":-32601,"message":"no"}}`)).toBe("")
  expect(contextOfResult(`{"task":{"contextId":"c4"}}`)).toBe("c4")
})
