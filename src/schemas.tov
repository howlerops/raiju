// OpenAI-shaped types the gateway translates to and from other providers.
// Fields that hold arbitrary JSON (tool parameters, tool call arguments) are
// kept as raw text by the lazy scanner in ./json and never appear here.

export type ImageUrl = { url: string, detail?: string }
export type ContentPart = { type: string, text?: string, image_url?: ImageUrl }
export type ToolCallFn = { name: string, arguments: string }
export type ToolCall = { id: string, type: string, function: ToolCallFn }

export type Message = {
  role: string,
  content?: string | ContentPart[],
  name?: string,
  tool_call_id?: string,
  tool_calls?: ToolCall[],
}

// The parts of a chat request the translators read. Everything else stays raw.
export type ChatRequest = {
  model: string,
  messages: Message[],
  stream?: bool,
  max_tokens?: int,
  max_completion_tokens?: int,
  temperature?: f64,
  top_p?: f64,
  stop?: string | string[],
  user?: string,
}

// cost: the billed USD the provider reports on its usage (OpenRouter), when it does
export type Usage = { prompt_tokens: int, completion_tokens: int, total_tokens: int, cost?: f64 }

export type ErrorBody = { message: string, type: string, code?: string, param?: string }

// The usage block of any OpenAI-shaped response.
export type UsageOnly = { usage?: Usage }

// Request headers read once into a hash map (lower-cased names): Headers
// lookups are linear scans, and a request is looked at a dozen times.
export type Hdrs = Map<string, string>

export function snapshot(h: Headers): Hdrs {
  const m: Hdrs = new Map()
  h.forEach((value, key) => {
    m.set(key, value)
  })
  return m
}

export function hdrs(pairs: string[][]): Hdrs {
  const m: Hdrs = new Map()
  for (const p of pairs) m.set(p[0]!, p[1]!)
  return m
}

export function textOf(c: string | ContentPart[] | undefined): string {
  if (c === undefined) return ""
  if (typeof c === "string") return c
  const out: string[] = []
  for (const p of c) {
    if (p.type === "text" && p.text !== undefined) out.push(p.text)
  }
  return out.join("")
}

export function errorJson(message: string, type: string, code: string | undefined): string {
  const e: { error: ErrorBody } = { error: { message: message, type: type, code: code } }
  return JSON.stringify(e)
}

export function nowSeconds(): int {
  return Math.floor(Date.now() / 1000)
}

let idCounter = 0

const HEX = "0123456789abcdef"

export function hex(n: int): string {
  if (n === 0) return "0"
  let v = n < 0 ? -n : n
  let out = ""
  while (v > 0) {
    const d = v % 16
    out = HEX.slice(d, d + 1) + out
    v = Math.floor(v / 16)
  }
  return out
}

// A request id: time plus a counter plus randomness, hex.
export function newId(prefix: string): string {
  idCounter += 1
  const r = Math.floor(Math.random() * 4294967296.0)
  return prefix + hex(Math.floor(Date.now())) + hex(idCounter) + hex(r)
}
