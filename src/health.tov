// Circuit breakers and adaptive load balancing for upstream targets (Bifrost's
// enterprise features). Pure logic: every call takes `now` in milliseconds, so
// nothing here reads a clock or starts a timer and tests are deterministic.
import { Field, fields, find, rawStr, rawBool, rawNum, elements, decodeString, quote } from "./json"
import { CircuitPolicyConfig } from "./config"
import { HoldBook } from "./holds"

export type BreakerConfig = {
  failureThreshold: int,
  failureRateThreshold: f64,
  minRequests: int,
  windowMs: int,
  openMs: int,
  halfOpenProbes: int,
}

export function defaultBreakerConfig(): BreakerConfig {
  return { failureThreshold: 5, failureRateThreshold: 0.5, minRequests: 10, windowMs: 60000, openMs: 30000, halfOpenProbes: 1 }
}

export type BreakerState = "closed" | "open" | "half_open"

export type TargetStatus = { id: string, state: string, ewmaMs: f64, successRate: f64, requests: int }

// A circuit policy (Bifrost's enterprise circuit breaker policies). A response-header signal
// names a header and, optionally, the value or part of it that trips the policy. The operator
// joins the signals: OR (any) or AND (all). cooldown_ms is how long the circuit stays open.
export type PolicySignal = { header_name: string, header_value?: string, header_contains?: string }

export type CircuitPolicy = {
  name: string,
  enabled: bool,
  primary_provider: string,
  primary_model: string,
  primary_key_ids: string[],
  fallback_provider: string,
  fallback_model: string,
  operator: string,
  signals: PolicySignal[],
  cooldown_ms: int,
  cooldown_header: string,
}

export type PolicyParse = { ok: bool, p: CircuitPolicy, err: string }

// The id of one key's sub-circuit under a policy.
function subCircuit(policy: string, key: string): string {
  return policy + "/" + key
}

// Outcomes are counted per second, so the window keeps a few buckets, not every request.
class Bucket {
  ok: int = 0
  fail: int = 0
  constructor(readonly sec: int) {}
}

class Track {
  ewma: f64 = 0.0
  hasLatency = false
  consecutive: int = 0
  requests: int = 0
  state: BreakerState = "closed"
  openedAt: f64 = 0.0
  probes: int = 0
  buckets: Bucket[] = []
  // an open circuit from a policy keeps its own cooldown; 0 means the breaker's openMs
  cooldownMs: int = 0
}

// The state a caller sees at `now`: an OPEN breaker whose timer has run out is
// HALF_OPEN. Computed without mutating, so reads never start a probe.
function effState(t: Track, now: f64, openMs: int): BreakerState {
  const span = t.cooldownMs > 0 ? t.cooldownMs : openMs
  if (t.state === "open" && now - t.openedAt >= span) return "half_open"
  return t.state
}

// Writes the lazy OPEN → HALF_OPEN move back into the track. A new half-open
// period starts with no probes in flight.
function settle(t: Track, now: f64, openMs: int): void {
  const s = effState(t, now, openMs)
  if (s !== t.state) {
    t.state = s
    t.probes = 0
  }
}

function openBreaker(t: Track, now: f64): void {
  t.state = "open"
  t.openedAt = now
  t.probes = 0
}

// Clears the window too, so the failures that tripped the breaker cannot
// re-trip it right after a successful probe.
function closeBreaker(t: Track): void {
  t.state = "closed"
  t.consecutive = 0
  t.probes = 0
  t.buckets = []
  t.cooldownMs = 0
}

function bucketAdd(t: Track, ok: bool, now: f64, windowMs: int): void {
  const sec = Math.floor(now / 1000.0)
  const last = t.buckets[t.buckets.length - 1]
  if (last === undefined || last.sec !== sec) t.buckets.push(new Bucket(sec))
  const b = t.buckets[t.buckets.length - 1]!
  if (ok) b.ok += 1
  else b.fail += 1
  // Drop buckets that ended before the window; this bounds memory.
  const cutoff = now - windowMs
  t.buckets = t.buckets.filter((x: Bucket) => (x.sec + 1) * 1000.0 > cutoff)
}

// Outcomes in buckets that still overlap the window ending at `now`. The
// window is accurate to within one second because buckets are per second.
function windowCounts(t: Track, cutoff: f64): { ok: int, fail: int } {
  let ok = 0
  let fail = 0
  for (const b of t.buckets) {
    if ((b.sec + 1) * 1000.0 <= cutoff) continue
    ok += b.ok
    fail += b.fail
  }
  return { ok: ok, fail: fail }
}

// Failure rate over the window. With no traffic in the window a target counts as healthy.
function successRate(t: Track, now: f64, windowMs: int): f64 {
  const c = windowCounts(t, now - windowMs)
  const total = c.ok + c.fail
  if (total === 0) return 1.0
  return c.ok / total
}

function rateTripped(t: Track, now: f64, cfg: BreakerConfig): bool {
  const c = windowCounts(t, now - cfg.windowMs)
  const total = c.ok + c.fail
  // minRequests keeps one early failure from tripping a cold target
  return total > 0 && total >= cfg.minRequests && c.fail / total >= cfg.failureRateThreshold
}

export class Health {
  private tracks: Map<string, Track> = new Map()
  private policies: CircuitPolicy[] = []
  // refusals that hold a key or model out of rotation, and the incidents of holds and opened circuits (holds.tov)
  readonly holds: HoldBook = new HoldBook()

  readonly cfg: BreakerConfig

  constructor(cfg?: BreakerConfig) {
    this.cfg = cfg ?? defaultBreakerConfig()
  }

  // Outcome of one request. Latency is only learned from successes, since a
  // timeout says nothing about how fast the target is.
  record(id: string, ok: bool, latencyMs: f64, now: f64): void {
    const t = this.track(id)
    const cfg = this.cfg
    settle(t, now, cfg.openMs)
    t.requests += 1
    bucketAdd(t, ok, now, cfg.windowMs)
    if (ok) {
      // alpha 0.2: a new sample moves the average by a fifth of the gap
      if (t.hasLatency) t.ewma = 0.2 * latencyMs + 0.8 * t.ewma
      else {
        t.ewma = latencyMs
        t.hasLatency = true
      }
      t.consecutive = 0
      if (t.state === "half_open") {
        closeBreaker(t)
        this.holds.noteClose(id, now)
      }
      return
    }
    t.consecutive += 1
    // A failed probe reopens the breaker and restarts the open timer.
    if (t.state === "half_open") {
      openBreaker(t, now)
      return
    }
    if (t.state !== "closed") return
    if (t.consecutive >= cfg.failureThreshold || rateTripped(t, now, cfg)) {
      openBreaker(t, now)
      this.holds.noteOpen(id, now)
    }
  }

  // Whether a request may go to the target now. In HALF_OPEN this counts as a
  // probe started, so call it only for the target that will actually be used.
  allow(id: string, now: f64): bool {
    const t = this.tracks.get(id)
    if (t === undefined) return true
    settle(t, now, this.cfg.openMs)
    if (t.state === "closed") return true
    if (t.state === "open") return false
    if (t.probes >= this.cfg.halfOpenProbes) return false
    t.probes += 1
    return true
  }

  // Same answer as allow() but starts no probe. Use it to filter candidates.
  wouldAllow(id: string, now: f64): bool {
    const t = this.tracks.get(id)
    if (t === undefined) return true
    const s = effState(t, now, this.cfg.openMs)
    if (s === "closed") return true
    if (s === "open") return false
    return t.probes < this.cfg.halfOpenProbes
  }

  state(id: string, now: f64): BreakerState {
    const t = this.tracks.get(id)
    if (t === undefined) return "closed"
    return effState(t, now, this.cfg.openMs)
  }

  // Base weight scaled by health: successRate² × (best EWMA / this EWMA),
  // clamped to [0.05, 1]. An open breaker gives 0; unknown targets keep their base weight.
  // `best` is the lowest EWMA among the targets being compared (they should
  // serve the same model); 0 or omitted means "across every tracked target".
  adaptiveWeight(id: string, baseWeight: f64, now: f64, best?: f64): f64 {
    const t = this.tracks.get(id)
    if (t === undefined) return baseWeight
    if (effState(t, now, this.cfg.openMs) === "open") return 0.0
    const sr = successRate(t, now, this.cfg.windowMs)
    const f = sr * sr * this.latencyRatio(t, best ?? 0.0)
    return baseWeight * Math.min(1.0, Math.max(0.05, f))
  }

  snapshot(now: f64): TargetStatus[] {
    const out: TargetStatus[] = []
    for (const id of this.tracks.keys()) {
      const t = this.tracks.get(id)!
      out.push({
        id: id,
        state: effState(t, now, this.cfg.openMs),
        ewmaMs: t.hasLatency ? t.ewma : 0.0,
        successRate: successRate(t, now, this.cfg.windowMs),
        requests: t.requests,
      })
    }
    return out
  }

  // ---- circuit policies (Bifrost's /api/circuit-breaker/policies) ----

  policyList(): CircuitPolicy[] {
    return this.policies
  }

  policyFind(name: string): CircuitPolicy | undefined {
    for (const p of this.policies) {
      if (p.name === name) return p
    }
    return undefined
  }

  // False when a policy with the name already exists.
  policyAdd(p: CircuitPolicy): bool {
    if (this.policyFind(p.name) !== undefined) return false
    this.policies.push(p)
    return true
  }

  // Swaps in the policies of a config (its circuit_breaker_policies). Open circuits keep their state.
  replacePolicies(list: CircuitPolicy[]): void {
    this.policies = list
  }

  // Replaces the policy called name. False when there is none.
  policyReplace(name: string, p: CircuitPolicy): bool {
    for (let i = 0; i < this.policies.length; i++) {
      if (this.policies[i]!.name !== name) continue
      this.policies[i] = p
      if (p.name !== name) this.reset(name)
      return true
    }
    return false
  }

  // Removes a policy and discards its open circuit. False when there is none.
  policyDelete(name: string): bool {
    const keep: CircuitPolicy[] = []
    let found = false
    for (const p of this.policies) {
      if (p.name === name) found = true
      else keep.push(p)
    }
    if (!found) return false
    this.policies = keep
    this.reset(name)
    // the policy's per-key sub-circuits go with it
    for (const id of this.tracks.keys()) {
      if (id.startsWith(name + "/")) this.tracks.delete(id)
    }
    return true
  }

  // The circuits open or half-open now, with when each opened and when it next lets a check through
  // (epoch ms). Policy sub-circuits are listed as "policy/key".
  openCircuits(now: f64): { id: string, state: string, openedAt: f64, nextCheck: f64 }[] {
    const out: { id: string, state: string, openedAt: f64, nextCheck: f64 }[] = []
    for (const id of this.tracks.keys()) {
      const t = this.tracks.get(id)!
      const st = this.state(id, now)
      if (st === "closed") continue
      const cool = t.cooldownMs > 0 ? t.cooldownMs : this.cfg.openMs
      out.push({ id: id, state: st, openedAt: t.openedAt, nextCheck: t.openedAt + cool })
    }
    return out
  }

  // Closes a circuit now, whatever its timer says. False when no circuit is tracked under id.
  reset(id: string): bool {
    const t = this.tracks.get(id)
    if (t === undefined) return false
    closeBreaker(t)
    return true
  }

  // Closes every circuit now. Returns how many circuits are tracked.
  resetAll(): int {
    const ids = this.tracks.keys()
    for (const id of ids) {
      const t = this.tracks.get(id)
      if (t !== undefined) closeBreaker(t)
    }
    return ids.length
  }

  // The policy whose open circuit reroutes requests for this primary provider and model, if any.
  policyFallback(provider: string, model: string, now: f64): CircuitPolicy | undefined {
    for (const p of this.policies) {
      if (!p.enabled || p.primary_provider !== provider || p.primary_model !== model) continue
      if (this.state(p.name, now) === "open") return p
    }
    return undefined
  }

  // Checks a response from this primary against each enabled policy for it, and opens the
  // circuit of each policy whose condition matches the headers. The cooldown is the policy's
  // default, or the cooldown_header value in milliseconds when the response carries one.
  // Returns the names of the policies that tripped.
  policyObserve(provider: string, model: string, keyId: string, headers: Map<string, string>, now: f64): string[] {
    const tripped: string[] = []
    for (const p of this.policies) {
      if (!p.enabled || p.primary_provider !== provider || p.primary_model !== model) continue
      if (p.primary_key_ids.length > 0 && !p.primary_key_ids.includes(keyId)) continue
      // an open circuit takes no more trips; a half-open probe that matches trips it again
      if (this.state(p.name, now) === "open") continue
      if (!policyMatches(p, headers)) continue
      let cool = p.cooldown_ms
      if (p.cooldown_header !== "") {
        const hv = headerGet(headers, p.cooldown_header)
        const ms = hv === undefined ? -1.0 : (parseFloat(hv) ?? -1.0)
        if (ms > 0.0) cool = Math.floor(ms)
      }
      // per-key sub-circuits (Bifrost's primary_key_ids): this key trips its own circuit, and the policy
      // opens only once every listed key's circuit is open at the same time
      if (p.primary_key_ids.length > 0) {
        const kt = this.track(subCircuit(p.name, keyId))
        kt.cooldownMs = cool
        openBreaker(kt, now)
        let every = true
        for (const k of p.primary_key_ids) {
          if (this.state(subCircuit(p.name, k), now) !== "open") every = false
        }
        if (!every) continue
      }
      const t = this.track(p.name)
      t.cooldownMs = cool
      openBreaker(t, now)
      tripped.push(p.name)
    }
    return tripped
  }

  private track(id: string): Track {
    const t = this.tracks.get(id)
    if (t !== undefined) return t
    const n = new Track()
    this.tracks.set(id, n)
    return n
  }

  // 1.0 for the fastest target, less for slower ones.
  private latencyRatio(t: Track, given: f64): f64 {
    if (!t.hasLatency || t.ewma <= 0.0) return 1.0
    const best = given > 0.0 ? given : this.bestEwma()
    if (best <= 0.0) return 1.0
    return Math.min(1.0, best / t.ewma)
  }

  // A target's measured performance for ranking providers: success rate squared over its latency EWMA (higher is
  // better), 0 when it has only failed, or -1 when it has not been tried.
  performance(id: string, now: f64): f64 {
    const t = this.tracks.get(id)
    if (t === undefined || t.requests === 0) return -1.0
    if (!t.hasLatency) return 0.0
    const sr = successRate(t, now, this.cfg.windowMs)
    return sr * sr / Math.max(1.0, t.ewma)
  }

  // The lowest EWMA among `ids` (0 when none has latency data).
  bestAmong(ids: string[]): f64 {
    let best = 0.0
    for (const id of ids) {
      const t = this.tracks.get(id)
      if (t === undefined || !t.hasLatency) continue
      if (best === 0.0 || t.ewma < best) best = t.ewma
    }
    return best
  }

  private bestEwma(): f64 {
    let best = 0.0
    let found = false
    for (const t of this.tracks.values()) {
      if (!t.hasLatency) continue
      if (!found || t.ewma < best) best = t.ewma
      found = true
    }
    return best
  }
}

// Weighted random choice among targets that would be allowed now, weighted by
// adaptiveWeight. `r` is in [0, 1) and supplied by the caller so tests are
// deterministic. Returns the index into `ids`, or -1 when nothing can take the
// request. The caller then calls health.allow() on the chosen id.
export function pickAdaptive(ids: string[], baseWeights: f64[], health: Health, now: f64, r: f64): int {
  const ws: f64[] = []
  let total = 0.0
  // latency is compared only among these candidates, not across other models
  const best = health.bestAmong(ids)
  for (let i = 0; i < ids.length; i++) {
    const id = ids[i]!
    const w = health.wouldAllow(id, now) ? health.adaptiveWeight(id, baseWeights[i] ?? 0.0, now, best) : 0.0
    ws.push(w)
    total += w
  }
  if (total <= 0.0) return -1
  const target = r * total
  let acc = 0.0
  let last = -1
  for (let i = 0; i < ws.length; i++) {
    const w = ws[i]!
    if (w <= 0.0) continue
    acc += w
    last = i
    if (target < acc) return i
  }
  // r near 1 can leave target at the total because of rounding
  return last
}

function policyFail(err: string): PolicyParse {
  return { ok: false, p: { name: "", enabled: true, primary_provider: "", primary_model: "", primary_key_ids: [], fallback_provider: "", fallback_model: "", operator: "OR", signals: [], cooldown_ms: 30000, cooldown_header: "" }, err: err }
}

// The string items of a JSON array; none when the value is missing or not an array.
function strList(raw: string | undefined): string[] {
  const out: string[] = []
  if (raw === undefined || !raw.startsWith("[")) return out
  try {
    for (const el of elements(raw)) out.push(decodeString(el))
  } catch (e) {
    return []
  }
  return out
}

// A Go duration string ("30s", "5m", "250ms") in milliseconds, or -1 when it is not one.
function durationMs(s: string): f64 {
  const cuts: string[] = ["ns", "us", "ms", "h", "m", "s"]
  const mults: f64[] = [0.000001, 0.001, 1.0, 3600000.0, 60000.0, 1000.0]
  for (let i = 0; i < cuts.length; i++) {
    const u = cuts[i]!
    if (!s.endsWith(u)) continue
    const n = parseFloat(s.slice(0, s.byteLength - u.byteLength)) ?? -1.0
    if (n < 0.0) return -1.0
    return n * mults[i]!
  }
  return -1.0
}

// Reads a policy from a request body, as Bifrost's POST and PUT take it. pathName is the name in
// the URL for PUT (the body may omit it, or repeat it), and "" for POST.
export function parsePolicy(body: string, pathName: string): PolicyParse {
  let fs: Field[] = []
  try {
    fs = fields(body)
  } catch (e) {
    return policyFail("Invalid request payload")
  }
  const bodyName = rawStr(fs, "name") ?? ""
  if (pathName !== "" && bodyName !== "" && bodyName !== pathName) return policyFail("the name in the body must match the name in the URL")
  const name = pathName !== "" ? pathName : bodyName
  if (name === "") return policyFail("name is required")
  const pp = rawStr(fs, "primary_provider") ?? ""
  const pm = rawStr(fs, "primary_model") ?? ""
  const fp = rawStr(fs, "fallback_provider") ?? ""
  const fm = rawStr(fs, "fallback_model") ?? ""
  if (pp === "" || pm === "" || fp === "" || fm === "") return policyFail("primary and fallback provider and model are required")
  const cfRaw = find(fs, "condition")
  if (cfRaw === undefined) return policyFail("condition is required")
  let cfs: Field[] = []
  try {
    cfs = fields(cfRaw)
  } catch (e) {
    return policyFail("condition must be an object")
  }
  const operator = rawStr(cfs, "operator") ?? "OR"
  if (operator !== "OR" && operator !== "AND") return policyFail("condition.operator must be OR or AND")
  let els: string[] = []
  try {
    els = elements(find(cfs, "signals") ?? "[]")
  } catch (e) {
    return policyFail("condition.signals must be an array")
  }
  if (els.length === 0) return policyFail("condition.signals needs at least one signal")
  const signals: PolicySignal[] = []
  for (const el of els) {
    let sfs: Field[] = []
    try {
      sfs = fields(el)
    } catch (e) {
      return policyFail("each signal must be an object")
    }
    if ((rawStr(sfs, "source") ?? "") !== "response_header") return policyFail("signal source must be response_header")
    const hn = rawStr(sfs, "header_name") ?? ""
    if (hn === "") return policyFail("signal header_name is required")
    const hv = rawStr(sfs, "header_value")
    const hc = rawStr(sfs, "header_contains")
    if (hv !== undefined && hc !== undefined) return policyFail("header_value and header_contains are mutually exclusive")
    signals.push({ header_name: hn, header_value: hv, header_contains: hc })
  }
  // default_cooldown: a Go duration string on write, or nanoseconds; 30 seconds when absent
  let cooldown: int = 30000
  const cdRaw = find(fs, "default_cooldown")
  if (cdRaw !== undefined && cdRaw.startsWith("\"")) {
    let d = ""
    try {
      d = decodeString(cdRaw)
    } catch (e) {
      return policyFail("default_cooldown must be a duration")
    }
    const ms = durationMs(d)
    if (ms < 0.0) return policyFail("default_cooldown must be a duration such as 30s")
    cooldown = Math.floor(ms)
  } else if (cdRaw !== undefined) {
    const ns = rawNum(fs, "default_cooldown") ?? -1.0
    if (ns < 0.0) return policyFail("default_cooldown must not be negative")
    cooldown = Math.floor(ns / 1000000.0)
  }
  const p: CircuitPolicy = {
    name: name,
    enabled: rawBool(fs, "enabled") ?? true,
    primary_provider: pp,
    primary_model: pm,
    primary_key_ids: strList(find(fs, "primary_key_ids")),
    fallback_provider: fp,
    fallback_model: fm,
    operator: operator,
    signals: signals,
    cooldown_ms: cooldown,
    cooldown_header: rawStr(fs, "cooldown_header") ?? "",
  }
  return { ok: true, p: p, err: "" }
}

// The policy as the config file keeps it (Bifrost's shape, default_cooldown as a Go duration in ms).
export function policyConfigOf(p: CircuitPolicy): CircuitPolicyConfig {
  const signals: { source: string, header_name: string, header_value?: string, header_contains?: string }[] = []
  for (const s of p.signals) {
    signals.push({ source: "response_header", header_name: s.header_name, header_value: s.header_value, header_contains: s.header_contains })
  }
  return {
    name: p.name,
    enabled: p.enabled,
    primary_provider: p.primary_provider,
    primary_model: p.primary_model,
    primary_key_ids: p.primary_key_ids,
    fallback_provider: p.fallback_provider,
    fallback_model: p.fallback_model,
    condition: { operator: p.operator, signals: signals },
    default_cooldown: `${p.cooldown_ms}ms`,
    cooldown_header: p.cooldown_header,
  }
}

// The policy as Bifrost's API shows it: default_cooldown in nanoseconds.
export function policyView(p: CircuitPolicy): string {
  const sig: string[] = []
  for (const s of p.signals) {
    let o = `{"source":"response_header","header_name":${quote(s.header_name)}`
    if ((s.header_value ?? "") !== "") o += `,"header_value":${quote(s.header_value ?? "")}`
    if ((s.header_contains ?? "") !== "") o += `,"header_contains":${quote(s.header_contains ?? "")}`
    sig.push(o + "}")
  }
  const keys: string[] = []
  for (const k of p.primary_key_ids) keys.push(quote(k))
  const on = p.enabled ? "true" : "false"
  return `{"name":${quote(p.name)},"enabled":${on},"primary_provider":${quote(p.primary_provider)},"primary_model":${quote(p.primary_model)},"primary_key_ids":[${keys.join(",")}],"fallback_provider":${quote(p.fallback_provider)},"fallback_model":${quote(p.fallback_model)},"condition":{"operator":${quote(p.operator)},"signals":[${sig.join(",")}]},"default_cooldown":${p.cooldown_ms * 1000000},"cooldown_header":${quote(p.cooldown_header)}}`
}

// Header lookup, case-insensitive.
function headerGet(headers: Map<string, string>, name: string): string | undefined {
  const want = name.toLowerCase()
  for (const k of headers.keys()) {
    if (k.toLowerCase() === want) return headers.get(k)
  }
  return undefined
}

function signalHits(s: PolicySignal, headers: Map<string, string>): bool {
  const v = headerGet(headers, s.header_name)
  if (v === undefined) return false
  const hv = s.header_value ?? ""
  if (hv !== "") return v.toLowerCase() === hv.toLowerCase()
  const hc = s.header_contains ?? ""
  if (hc !== "") return v.toLowerCase().includes(hc.toLowerCase())
  return true
}

// Whether a response's headers satisfy the policy's condition (OR: any signal; AND: all).
function policyMatches(p: CircuitPolicy, headers: Map<string, string>): bool {
  const and = p.operator === "AND"
  for (const s of p.signals) {
    const hit = signalHits(s, headers)
    if (and && !hit) return false
    if (!and && hit) return true
  }
  return and && p.signals.length > 0
}

test("a policy over several keys opens only once every listed key has tripped", () => {
  const h = new Health()
  const p: CircuitPolicy = { name: "quota", enabled: true, primary_provider: "azure", primary_model: "gpt", primary_key_ids: ["k1", "k2"], fallback_provider: "openai", fallback_model: "gpt", operator: "OR", signals: [{ header_name: "x-quota", header_contains: "exceeded" }], cooldown_ms: 60000, cooldown_header: "" }
  expect(h.policyAdd(p)).toBe(true)
  const hd = new Map<string, string>()
  hd.set("x-quota", "exceeded")
  const now = Date.now()
  expect(h.policyObserve("azure", "gpt", "k1", hd, now).length).toBe(0)
  expect(h.policyFallback("azure", "gpt", now) === undefined).toBe(true)
  expect(h.policyObserve("azure", "gpt", "k2", hd, now).join(",")).toBe("quota")
  expect(h.policyFallback("azure", "gpt", now)!.name).toBe("quota")
  expect(h.openCircuits(now).some((c) => c.id === "quota/k1")).toBe(true)
  expect(h.openCircuits(now).some((c) => c.id === "quota")).toBe(true)
  // deleting the policy drops its sub-circuits too
  expect(h.policyDelete("quota")).toBe(true)
  expect(h.openCircuits(now).length).toBe(0)
})

test("policy bodies parse, validate and show Bifrost's shape", () => {
  const ok = parsePolicy(`{"name":"quota","primary_provider":"azure","primary_model":"gpt-4o","primary_key_ids":["k1"],"fallback_provider":"openai","fallback_model":"gpt-4o-mini","condition":{"signals":[{"source":"response_header","header_name":"x-quota","header_contains":"exceeded"}]},"default_cooldown":"5m"}`, "")
  expect(ok.ok).toBe(true)
  expect(ok.p.cooldown_ms).toBe(300000)
  expect(ok.p.operator).toBe("OR")
  expect(policyView(ok.p).includes(`"default_cooldown":300000000000`)).toBe(true)
  expect(policyView(ok.p).includes(`"header_contains":"exceeded"`)).toBe(true)
  // nanoseconds are accepted too, and PUT may omit or repeat the name
  const ns = parsePolicy(`{"primary_provider":"a","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"operator":"AND","signals":[{"source":"response_header","header_name":"h"}]},"default_cooldown":2500000000}`, "quota")
  expect(ns.ok).toBe(true)
  expect(ns.p.name).toBe("quota")
  expect(ns.p.cooldown_ms).toBe(2500)
  expect(parsePolicy(`{"name":"other","primary_provider":"a","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"signals":[{"source":"response_header","header_name":"h"}]}}`, "quota").ok).toBe(false)
  expect(parsePolicy(`{"primary_provider":"a","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"signals":[{"source":"body","header_name":"h"}]}}`, "").ok).toBe(false)
  expect(parsePolicy(`{"name":"x","primary_provider":"a","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"signals":[]}}`, "").ok).toBe(false)
  expect(parsePolicy(`{"name":"x","primary_provider":"a","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"signals":[{"source":"response_header","header_name":"h","header_value":"1","header_contains":"1"}]}}`, "").ok).toBe(false)
  expect(parsePolicy(`{"name":"x","primary_provider":"a","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"signals":[{"source":"response_header","header_name":"h"}]},"default_cooldown":"soon"}`, "").ok).toBe(false)
  expect(parsePolicy(`{"name":"x","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"signals":[{"source":"response_header","header_name":"h"}]}}`, "").ok).toBe(false)
})

test("a policy opens its primary's circuit on a matching header and reroutes until the cooldown", () => {
  const h = new Health()
  const pol = parsePolicy(`{"name":"p1","primary_provider":"azure","primary_model":"gpt-4o","fallback_provider":"openai","fallback_model":"gpt-4o","condition":{"signals":[{"source":"response_header","header_name":"X-Quota","header_value":"exhausted"}]},"default_cooldown":"10s"}`, "")
  expect(h.policyAdd(pol.p)).toBe(true)
  expect(h.policyAdd(pol.p)).toBe(false)
  const hit: Map<string, string> = new Map()
  hit.set("x-quota", "Exhausted")
  const miss: Map<string, string> = new Map()
  miss.set("x-quota", "ok")
  expect(h.policyObserve("azure", "gpt-4o", "", miss, 500.0).length).toBe(0)
  expect(h.policyObserve("azure", "gpt-4o", "", hit, 1000.0).join(",")).toBe("p1")
  expect(h.policyFallback("azure", "gpt-4o", 5000.0)?.fallback_provider).toBe("openai")
  expect(h.policyFallback("azure", "gpt-4o-mini", 5000.0) === undefined).toBe(true)
  // after the 10 seconds the circuit is half-open: no reroute, and a matching probe trips it again
  expect(h.policyFallback("azure", "gpt-4o", 11000.0) === undefined).toBe(true)
  expect(h.policyObserve("azure", "gpt-4o", "", hit, 11000.0).join(",")).toBe("p1")
  expect(h.reset("p1")).toBe(true)
  expect(h.policyFallback("azure", "gpt-4o", 11001.0) === undefined).toBe(true)
  expect(h.reset("nope")).toBe(false)
  expect(h.policyReplace("p1", pol.p)).toBe(true)
  expect(h.policyDelete("p1")).toBe(true)
  expect(h.policyDelete("p1")).toBe(false)
  expect(h.policyList().length).toBe(0)
})

test("a policy's cooldown header overrides its default, and AND needs every signal", () => {
  const h = new Health()
  const pol = parsePolicy(`{"name":"ra","primary_provider":"azure","primary_model":"m","fallback_provider":"openai","fallback_model":"n","cooldown_header":"x-retry-ms","condition":{"operator":"AND","signals":[{"source":"response_header","header_name":"x-a"},{"source":"response_header","header_name":"x-b"}]}}`, "")
  expect(pol.ok).toBe(true)
  expect(pol.p.cooldown_ms).toBe(30000)
  h.policyAdd(pol.p)
  const one: Map<string, string> = new Map()
  one.set("x-a", "1")
  expect(h.policyObserve("azure", "m", "", one, 0.0).length).toBe(0)
  const both: Map<string, string> = new Map()
  both.set("x-a", "1")
  both.set("x-b", "2")
  both.set("x-retry-ms", "2500")
  expect(h.policyObserve("azure", "m", "", both, 0.0).join(",")).toBe("ra")
  expect(h.policyFallback("azure", "m", 2000.0) === undefined).toBe(false)
  expect(h.policyFallback("azure", "m", 2500.0) === undefined).toBe(true)
})

function tripConfig(failureThreshold: int): BreakerConfig {
  return { failureThreshold: failureThreshold, failureRateThreshold: 0.5, minRequests: 10, windowMs: 60000, openMs: 30000, halfOpenProbes: 1 }
}

function failN(h: Health, id: string, n: int, t: f64): void {
  for (let i = 0; i < n; i++) h.record(id, false, 0.0, t)
}

test("a circuit that failures open is an incident until a probe closes it", () => {
  const h = new Health(tripConfig(2))
  failN(h, "p#k", 2, 1000.0)
  expect(h.holds.incidentList().length).toBe(1)
  expect(h.holds.incidentList()[0]!.resolvedAt).toBe(0.0)
  // after the open timer the probe succeeds and the incident resolves
  expect(h.allow("p#k", 40000.0)).toBe(true)
  h.record("p#k", true, 10.0, 40000.0)
  expect(h.holds.incidentList()[0]!.resolvedAt).toBe(40000.0)
})

test("default breaker config", () => {
  expect(defaultBreakerConfig()).toEqual({ failureThreshold: 5, failureRateThreshold: 0.5, minRequests: 10, windowMs: 60000, openMs: 30000, halfOpenProbes: 1 })
})

test("breaker trips on consecutive failures", () => {
  const h = new Health()
  failN(h, "a", 4, 1000.0)
  expect(h.state("a", 1000.0)).toBe("closed")
  expect(h.allow("a", 1000.0)).toBe(true)
  h.record("a", false, 0.0, 1000.0)
  expect(h.state("a", 1000.0)).toBe("open")
  expect(h.allow("a", 1000.0)).toBe(false)
  expect(h.state("unknown", 1000.0)).toBe("closed")
  expect(h.allow("unknown", 1000.0)).toBe(true)
})

test("failure rate trips only after minRequests", () => {
  const h = new Health()
  // alternating outcomes never reach 5 in a row, and the rate is 50%
  for (let i = 0; i < 9; i++) h.record("a", i % 2 === 0, 10.0, 1000.0 + i)
  expect(h.state("a", 1009.0)).toBe("closed")
  h.record("a", false, 10.0, 1009.0)
  expect(h.state("a", 1009.0)).toBe("open")
})

test("breaker stays open until openMs has passed", () => {
  const h = new Health()
  const t = 1000.0
  failN(h, "a", 5, t)
  expect(h.allow("a", t + 29999.0)).toBe(false)
  expect(h.state("a", t + 29999.0)).toBe("open")
  expect(h.state("a", t + 30000.0)).toBe("half_open")
})

test("half-open allows exactly one probe", () => {
  const h = new Health()
  failN(h, "a", 5, 1000.0)
  expect(h.wouldAllow("a", 31000.0)).toBe(true)
  expect(h.allow("a", 31000.0)).toBe(true)
  expect(h.wouldAllow("a", 31000.0)).toBe(false)
  expect(h.allow("a", 31000.0)).toBe(false)
  expect(h.state("a", 31000.0)).toBe("half_open")
})

test("probe success closes and resets counters", () => {
  const h = new Health()
  failN(h, "a", 5, 1000.0)
  expect(h.allow("a", 31000.0)).toBe(true)
  h.record("a", true, 50.0, 31100.0)
  expect(h.state("a", 31100.0)).toBe("closed")
  expect(h.allow("a", 31100.0)).toBe(true)
  // the counters are fresh: four more failures do not trip it
  failN(h, "a", 4, 31200.0)
  expect(h.state("a", 31200.0)).toBe("closed")
})

test("probe failure reopens with a new timer", () => {
  const h = new Health()
  failN(h, "a", 5, 1000.0)
  expect(h.allow("a", 31000.0)).toBe(true)
  h.record("a", false, 0.0, 31000.0)
  expect(h.state("a", 31000.0)).toBe("open")
  expect(h.allow("a", 60999.0)).toBe(false)
  expect(h.state("a", 61000.0)).toBe("half_open")
})

test("window slides and old failures expire", () => {
  // control: ten failures inside one window trip the rate rule
  const control = new Health(tripConfig(1000))
  for (let i = 0; i < 10; i++) control.record("a", false, 0.0, 100.0 * i)
  expect(control.state("a", 1000.0)).toBe("open")

  // nine failures at t=0 are outside the window by t=70000
  const h = new Health(tripConfig(1000))
  failN(h, "a", 9, 0.0)
  for (let i = 0; i < 9; i++) h.record("a", true, 10.0, 70000.0 + i)
  expect(h.snapshot(70010.0)[0]!.successRate).toBe(1.0)
  h.record("a", false, 0.0, 70010.0)
  expect(h.state("a", 70010.0)).toBe("closed")
})

test("EWMA tracks successes only", () => {
  const h = new Health()
  h.record("a", true, 100.0, 1000.0)
  h.record("a", true, 200.0, 1001.0)
  expect(h.snapshot(1001.0)[0]!.ewmaMs).toBeCloseTo(120.0)
  h.record("a", false, 9999.0, 1002.0)
  expect(h.snapshot(1002.0)[0]!.ewmaMs).toBeCloseTo(120.0)
  h.record("a", true, 200.0, 1003.0)
  expect(h.snapshot(1003.0)[0]!.ewmaMs).toBeCloseTo(136.0)
  expect(h.snapshot(1003.0)[0]!.requests).toBe(4)
})

test("adaptive weights favor the faster and healthier target", () => {
  const h = new Health()
  h.record("fast", true, 100.0, 1000.0)
  h.record("slow", true, 400.0, 1000.0)
  h.record("flaky", true, 100.0, 1000.0)
  h.record("flaky", false, 0.0, 1001.0)
  expect(h.adaptiveWeight("fast", 1.0, 1001.0)).toBeCloseTo(1.0)
  expect(h.adaptiveWeight("slow", 1.0, 1001.0)).toBeCloseTo(0.25)
  expect(h.adaptiveWeight("flaky", 1.0, 1001.0)).toBeCloseTo(0.25)
  // no data keeps the base weight
  expect(h.adaptiveWeight("new", 2.0, 1001.0)).toBeCloseTo(2.0)
  // all failures clamp to the floor rather than zero
  h.record("dead", false, 0.0, 1000.0)
  expect(h.adaptiveWeight("dead", 1.0, 1001.0)).toBeCloseTo(0.05)
  // an open breaker gives zero
  failN(h, "slow", 5, 1000.0)
  expect(h.adaptiveWeight("slow", 1.0, 1001.0)).toBeCloseTo(0.0)
})

test("pickAdaptive never returns an open target", () => {
  const h = new Health()
  failN(h, "a", 5, 1000.0)
  failN(h, "b", 5, 1000.0)
  h.record("c", true, 50.0, 1000.0)
  const ids = ["a", "b", "c"]
  const ws = [1.0, 1.0, 1.0]
  for (let i = 0; i < 100; i++) expect(pickAdaptive(ids, ws, h, 1000.0, i / 100.0)).toBe(2)
  failN(h, "c", 5, 1000.0)
  expect(pickAdaptive(ids, ws, h, 1000.0, 0.5)).toBe(-1)
  expect(pickAdaptive([], [], h, 1000.0, 0.5)).toBe(-1)
})

test("pickAdaptive selection is deterministic for a given r", () => {
  const h = new Health()
  h.record("a", true, 100.0, 1000.0)
  h.record("b", true, 400.0, 1000.0)
  // weights 1.0 and 0.25: a owns [0, 0.8) of the range, b the rest
  const ids = ["a", "b"]
  const ws = [1.0, 1.0]
  expect(pickAdaptive(ids, ws, h, 1000.0, 0.1)).toBe(0)
  expect(pickAdaptive(ids, ws, h, 1000.0, 0.79)).toBe(0)
  expect(pickAdaptive(ids, ws, h, 1000.0, 0.81)).toBe(1)
  expect(pickAdaptive(ids, ws, h, 1000.0, 0.9)).toBe(1)
  expect(pickAdaptive(ids, ws, h, 1000.0, 0.9)).toBe(1)
})

test("a policy round-trips through the config shape", () => {
  const pol = parsePolicy(`{"name":"rt","primary_provider":"azure","primary_model":"m","primary_key_ids":["k1"],"fallback_provider":"openai","fallback_model":"n","condition":{"operator":"AND","signals":[{"source":"response_header","header_name":"X-A","header_contains":"full"},{"source":"response_header","header_name":"X-B","header_value":"1"}]},"default_cooldown":"5m","cooldown_header":"retry-after-ms"}`, "")
  expect(pol.ok).toBe(true)
  const c = policyConfigOf(pol.p)
  expect(c.default_cooldown).toBe("300000ms")
  const back = parsePolicy(JSON.stringify(c), "")
  expect(back.ok).toBe(true)
  expect(policyView(back.p)).toBe(policyView(pol.p))
  expect(back.p.primary_key_ids.length).toBe(1)
})

test("replacePolicies swaps the list and keeps the open circuits", () => {
  const h = new Health()
  const pol = parsePolicy(`{"name":"keep","primary_provider":"a","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"signals":[{"source":"response_header","header_name":"x"}]},"default_cooldown":"10s"}`, "")
  h.policyAdd(pol.p)
  const hit: Map<string, string> = new Map()
  hit.set("x", "1")
  expect(h.policyObserve("a", "m", "", hit, 0.0).join(",")).toBe("keep")
  h.replacePolicies([])
  expect(h.policyList().length).toBe(0)
  h.replacePolicies([pol.p])
  expect(h.policyFallback("a", "m", 1000.0)?.name).toBe("keep")
})
