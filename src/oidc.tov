const TEST_NOW_MS = 1700000000000.0
const TEST_ISS = "https://idp.example.com"
const TEST_CLIENT = "client-abc"

function testCfg(roleMap: Record<string, string>, defaultRole?: string, roleClaim?: string): OidcConfig {
  return {
    enabled: true,
    issuer: TEST_ISS,
    client_id: TEST_CLIENT,
    redirect_uri: "https://gw.example.com/admin/callback",
    role_map: roleMap,
    default_role: defaultRole,
    role_claim: roleClaim,
  }
}

function b64(s: string): string {
  return encodeUrl(utf8(s))
}

// A token over the given claims, signed with TEST_PKCS1 (header alg RS256, kid test-key).
function signedToken(claims: string): string throws SyntaxError {
  const input = b64(`{"alg":"RS256","kid":"test-key","typ":"JWT"}`) + "." + b64(claims)
  return input + "." + (try signRsTest(input))
}

function signRsTest(input: string): string throws SyntaxError {
  return try signRs256(TEST_PKCS1, input)
}

// Claims for a valid token; tests override single fields by building their own strings.
function claimsJson(extra: string): string {
  return `{"iss":"${TEST_ISS}","sub":"user-123","aud":"${TEST_CLIENT}","iat":1700000000,"exp":1700003600,"nonce":"n-1","email":"alice@example.com"${extra}}`
}

// Changes one character in the middle of a string, so the value changes but stays well formed.
function flipAt(s: string, i: int): string {
  const c = s.slice(i, i + 1)
  return s.slice(0, i) + (c === "A" ? "B" : "A") + s.slice(i + 1)
}

function paramOf(url: string, name: string): string | undefined {
  let at = url.indexOf("?" + name + "=")
  if (at < 0) at = url.indexOf("&" + name + "=")
  if (at < 0) return undefined
  const start = at + name.byteLength + 2
  const rest = url.slice(start)
  const end = rest.indexOf("&")
  return end < 0 ? rest : rest.slice(0, end)
}

const TEST_DISC: Discovery = {
  authorization_endpoint: "https://idp.example.com/authorize",
  token_endpoint: "https://idp.example.com/token",
  jwks_uri: "https://idp.example.com/jwks",
  issuer: TEST_ISS,
}

test("discovery URL drops trailing slashes", () => {
  expect(discoveryUrl("https://idp.example.com")).toBe("https://idp.example.com/.well-known/openid-configuration")
  expect(discoveryUrl("https://idp.example.com/")).toBe("https://idp.example.com/.well-known/openid-configuration")
  expect(discoveryUrl("https://idp.example.com/tenant//")).toBe("https://idp.example.com/tenant/.well-known/openid-configuration")
})

test("parses discovery and rejects incomplete or insecure documents", () => {
  const d = try parseDiscovery(`{"issuer":"${TEST_ISS}","authorization_endpoint":"https://idp.example.com/authorize","token_endpoint":"https://idp.example.com/token","jwks_uri":"https://idp.example.com/jwks","scopes_supported":["openid"]}`)
  expect(d.token_endpoint).toBe("https://idp.example.com/token")
  expect(d.issuer).toBe(TEST_ISS)
  let threw = false
  try {
    parseDiscovery(`{"issuer":"${TEST_ISS}","authorization_endpoint":"https://idp.example.com/authorize","token_endpoint":"https://idp.example.com/token"}`)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    parseDiscovery(`{"issuer":"${TEST_ISS}","authorization_endpoint":"https://idp.example.com/authorize","token_endpoint":"http://idp.example.com/token","jwks_uri":"https://idp.example.com/jwks"}`)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    parseDiscovery("not json")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("begin builds the authorize URL with PKCE S256 and a matching verifier", () => {
  const flows = new OidcFlows()
  const cfg = testCfg({})
  const r = try flows.begin(cfg, TEST_DISC, TEST_NOW_MS)
  expect(r.url.startsWith("https://idp.example.com/authorize?")).toBe(true)
  expect(paramOf(r.url, "response_type")).toBe("code")
  expect(paramOf(r.url, "client_id")).toBe(TEST_CLIENT)
  expect(paramOf(r.url, "code_challenge_method")).toBe("S256")
  expect(paramOf(r.url, "scope")).toBe("openid%20email%20profile")
  expect(paramOf(r.url, "redirect_uri")).toBe("https%3A%2F%2Fgw.example.com%2Fadmin%2Fcallback")
  expect(paramOf(r.url, "state")).toBe(r.state)
  const challenge = paramOf(r.url, "code_challenge")
  const nonce = paramOf(r.url, "nonce")
  expect(nonce === undefined).toBe(false)
  const done = flows.complete(r.state, TEST_NOW_MS)
  expect(done === undefined).toBe(false)
  if (done !== undefined) {
    expect(done.nonce).toBe(nonce!)
    expect(done.verifier.byteLength).toBe(64)
    expect(encodeUrl(sha256(utf8(done.verifier)))).toBe(challenge!)
  }
})

test("begin keeps a configured scope list and adds openid to it", () => {
  const flows = new OidcFlows()
  const cfg: OidcConfig = { enabled: true, issuer: TEST_ISS, client_id: TEST_CLIENT, redirect_uri: "https://gw.example.com/cb", scopes: ["email"] }
  const r = try flows.begin(cfg, TEST_DISC, TEST_NOW_MS)
  expect(paramOf(r.url, "scope")).toBe("openid%20email")
})

test("begin refuses a discovery document from another issuer", () => {
  const flows = new OidcFlows()
  const other: Discovery = { authorization_endpoint: "https://idp.example.com/authorize", token_endpoint: "https://idp.example.com/token", jwks_uri: "https://idp.example.com/jwks", issuer: "https://evil.example.com" }
  let threw = false
  try {
    flows.begin(testCfg({}), other, TEST_NOW_MS)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("state is single use and expires after 10 minutes", () => {
  const flows = new OidcFlows()
  const cfg = testCfg({})
  const a = try flows.begin(cfg, TEST_DISC, TEST_NOW_MS)
  const b = try flows.begin(cfg, TEST_DISC, TEST_NOW_MS)
  expect(a.state === b.state).toBe(false)
  expect(flows.complete(a.state, TEST_NOW_MS) === undefined).toBe(false)
  expect(flows.complete(a.state, TEST_NOW_MS) === undefined).toBe(true)
  expect(flows.complete("unknown-state", TEST_NOW_MS) === undefined).toBe(true)
  // 599 s is inside the window, 600 s is outside it
  expect(flows.complete(b.state, TEST_NOW_MS + 599000.0) === undefined).toBe(false)
  const c = try flows.begin(cfg, TEST_DISC, TEST_NOW_MS)
  expect(flows.complete(c.state, TEST_NOW_MS + 600000.0) === undefined).toBe(true)
})

test("token request body is form encoded and carries the verifier", () => {
  const cfg = testCfg({})
  const body = tokenRequestBody(cfg, "abc/123", "ver.ifier")
  expect(body.includes("grant_type=authorization_code")).toBe(true)
  expect(body.includes("code=abc%2F123")).toBe(true)
  expect(body.includes("code_verifier=ver.ifier")).toBe(true)
  expect(body.includes("client_id=client-abc")).toBe(true)
  expect(body.includes("client_secret")).toBe(false)
  const withSecret: OidcConfig = { enabled: true, issuer: TEST_ISS, client_id: TEST_CLIENT, redirect_uri: "https://gw.example.com/admin/callback", client_secret: "s3cr&t" }
  expect(tokenRequestBody(withSecret, "c", "v").includes("client_secret=s3cr%26t")).toBe(true)
})

test("verifies an openssl-signed token", () => {
  const r = verifyIdToken(OPENSSL_TOKEN, TEST_JWKS, testCfg({}), TEST_ISS, "n-0042", TEST_NOW_MS)
  expect(r.kind).toBe("ok")
  if (r.kind === "ok") {
    expect(r.sub).toBe("user-123")
    expect(r.email).toBe("alice@example.com")
    expect(r.role).toBe("viewer")
  }
})

test("verifies a token signed in the test", () => {
  const tok = try signedToken(claimsJson(""))
  const r = verifyIdToken(tok, TEST_JWKS, testCfg({}), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(r.kind).toBe("ok")
})

test("rejects a tampered signature and a tampered payload", () => {
  const tok = try signedToken(claimsJson(""))
  const parts = tok.split(".")
  const head = parts[0]! + "." + parts[1]! + "."
  const sig = parts[2]!
  const r1 = verifyIdToken(head + flipAt(sig, 20), TEST_JWKS, testCfg({}), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(r1.kind).toBe("error")
  // the same signature over a different email
  const forged = b64(claimsJson(`,"x":1`).replaceAll("alice", "mallory"))
  const r2 = verifyIdToken(parts[0]! + "." + forged + "." + sig, TEST_JWKS, testCfg({}), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(r2.kind).toBe("error")
  // a truncated signature
  const r3 = verifyIdToken(head + sig.slice(0, 100), TEST_JWKS, testCfg({}), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(r3.kind).toBe("error")
})

test("rejects a token checked against a different key", () => {
  const tok = try signedToken(claimsJson(""))
  const n = "4_SdoF7s2TMIr_XGII0fMmrXMKzQLq3EhMcQByZwJesgiswdlMWeTOH2n_imze3Dk4LsRtabiEtuLReF6SD3YVfOBOff-93SjxKUJst-XgdLvTQRyic-mZYRP4JcwuLkBgjCL2PGF3fZCh1BVkqemnQVGSn_nl0EyaQMt99x2pZUsK6ghQqqKRa1AtUzNQgQMVsYKcfxgc_htvD4BEktxtH4boEgKdqrZaWDn_wLx434ZiSpxu4SNAYxRV0_mr-EAddlUgPkxrmnEMolyap73-oLUWF5Y-UA2VMatZPLuerhyvIi4GKBWnOODBZyngcJmmDinr6AheLqQ-gXnfUcdw"
  const other = flipAt(n, 30)
  const jwks = `{"keys":[{"kty":"RSA","kid":"test-key","n":"${other}","e":"AQAB"}]}`
  const r = verifyIdToken(tok, jwks, testCfg({}), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(r.kind).toBe("error")
  // no key with the header's kid
  const noKid = `{"keys":[{"kty":"RSA","kid":"other","n":"${n}","e":"AQAB"}]}`
  expect(verifyIdToken(tok, noKid, testCfg({}), TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
})

test("rejects alg none, HS256 and malformed tokens", () => {
  const cfg = testCfg({})
  const none = b64(`{"alg":"none"}`) + "." + b64(claimsJson("")) + "."
  expect(verifyIdToken(none, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  const hs = b64(`{"alg":"HS256","kid":"test-key"}`) + "." + b64(claimsJson("")) + "." + b64("x")
  expect(verifyIdToken(hs, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  expect(verifyIdToken("abc", TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  expect(verifyIdToken("a.b.c.d", TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  expect(verifyIdToken("!!.!!.!!", TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
})

test("rejects a wrong issuer and a wrong audience", () => {
  const cfg = testCfg({})
  const wrongIss = try signedToken(claimsJson("").replace(TEST_ISS, "https://other.example.com"))
  expect(verifyIdToken(wrongIss, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  const wrongAud = try signedToken(claimsJson("").replace(`"aud":"${TEST_CLIENT}"`, `"aud":"someone-else"`))
  expect(verifyIdToken(wrongAud, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  // a list of audiences is fine when it contains this client
  const oneAud = try signedToken(claimsJson("").replace(`"aud":"${TEST_CLIENT}"`, `"aud":["${TEST_CLIENT}"]`))
  expect(verifyIdToken(oneAud, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("ok")
  // several audiences need azp (OIDC Core 3.1.3.7): refused without it, accepted with azp = this client
  const multi = try signedToken(claimsJson("").replace(`"aud":"${TEST_CLIENT}"`, `"aud":["x","${TEST_CLIENT}"]`))
  expect(verifyIdToken(multi, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  const multiAzp = try signedToken(claimsJson(`,"azp":"${TEST_CLIENT}"`).replace(`"aud":"${TEST_CLIENT}"`, `"aud":["x","${TEST_CLIENT}"]`))
  expect(verifyIdToken(multiAzp, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("ok")
  // azp for another client is refused
  const badAzp = try signedToken(claimsJson(`,"azp":"someone-else"`))
  expect(verifyIdToken(badAzp, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
})

test("checks exp with 60 s of skew", () => {
  const cfg = testCfg({})
  // exp is 1700003600; the token is good up to exp + 60 s
  const tok = try signedToken(claimsJson(""))
  expect(verifyIdToken(tok, TEST_JWKS, cfg, TEST_ISS, "n-1", 1700003660000.0).kind).toBe("ok")
  expect(verifyIdToken(tok, TEST_JWKS, cfg, TEST_ISS, "n-1", 1700003661000.0).kind).toBe("error")
  const noExp = try signedToken(claimsJson("").replace(`"exp":1700003600,`, ""))
  expect(verifyIdToken(noExp, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
})

test("checks nbf with 60 s of skew", () => {
  const cfg = testCfg({})
  const tok = try signedToken(claimsJson(`,"nbf":1700000100`))
  expect(verifyIdToken(tok, TEST_JWKS, cfg, TEST_ISS, "n-1", 1700000040000.0).kind).toBe("ok")
  expect(verifyIdToken(tok, TEST_JWKS, cfg, TEST_ISS, "n-1", 1700000030000.0).kind).toBe("error")
})

test("rejects a wrong nonce and a missing sub", () => {
  const cfg = testCfg({})
  const tok = try signedToken(claimsJson(""))
  expect(verifyIdToken(tok, TEST_JWKS, cfg, TEST_ISS, "n-2", TEST_NOW_MS).kind).toBe("error")
  const noNonce = try signedToken(claimsJson("").replace(`"nonce":"n-1",`, ""))
  expect(verifyIdToken(noNonce, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  const noSub = try signedToken(claimsJson("").replace(`"sub":"user-123",`, ""))
  expect(verifyIdToken(noSub, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
})

// The role of an ok result, or the error message, so a failed verification fails the assertion.
function resultRole(r: IdTokenResult): string {
  return r.kind === "ok" ? r.role : r.message
}

test("maps roles from the groups claim in claim order", () => {
  const tok = try signedToken(claimsJson(`,"groups":["stranger","platform-admins","engineers"]`))
  const map: Record<string, string> = { "engineers": "editor", "platform-admins": "admin" }
  const r = verifyIdToken(tok, TEST_JWKS, testCfg(map), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(r.kind).toBe("ok")
  expect(resultRole(r)).toBe("admin")
  // the first group with a mapping decides, even when a later group maps higher
  const tok2 = try signedToken(claimsJson(`,"groups":["engineers","platform-admins"]`))
  const r2 = verifyIdToken(tok2, TEST_JWKS, testCfg(map), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(resultRole(r2)).toBe("editor")
})

test("maps roles from a string claim, a custom claim and the default role", () => {
  const cfgRole = testCfg({ "admins": "admin", "ops": "auditor" }, undefined, "roles")
  const tok = try signedToken(claimsJson(`,"roles":"ops"`))
  const r = verifyIdToken(tok, TEST_JWKS, cfgRole, TEST_ISS, "n-1", TEST_NOW_MS)
  expect(resultRole(r)).toBe("auditor")
  // no group matches: default_role applies, and viewer when it is unset
  const none = try signedToken(claimsJson(`,"groups":["nobody"]`))
  const d1 = verifyIdToken(none, TEST_JWKS, testCfg({ "admins": "admin" }, "editor"), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(resultRole(d1)).toBe("editor")
  const d2 = verifyIdToken(none, TEST_JWKS, testCfg({ "admins": "admin" }), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(resultRole(d2)).toBe("viewer")
  // no groups claim at all
  const noGroups = try signedToken(claimsJson(""))
  const d3 = verifyIdToken(noGroups, TEST_JWKS, testCfg({}), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(resultRole(d3)).toBe("viewer")
})

test("refuses a role_map or default_role that is not a role", () => {
  const tok = try signedToken(claimsJson(`,"groups":["engineers"]`))
  const bad = verifyIdToken(tok, TEST_JWKS, testCfg({ "engineers": "superuser" }), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(bad.kind).toBe("error")
  const badDefault = verifyIdToken(tok, TEST_JWKS, testCfg({}, "root"), TEST_ISS, "n-1", TEST_NOW_MS)
  expect(badDefault.kind).toBe("error")
})

test("session store creates, reads, expires and deletes sessions", () => {
  const store = new UiSessions()
  const t = try store.create("user-1", "admin", TEST_NOW_MS)
  expect(t.startsWith("sk-sess-")).toBe(true)
  expect(t.byteLength).toBe(8 + 48)
  const s = store.get(t, TEST_NOW_MS + 1000.0)
  expect(s === undefined).toBe(false)
  if (s !== undefined) {
    expect(s.sub).toBe("user-1")
    expect(s.role).toBe("admin")
  }
  // 8 hours by default
  expect(store.get(t, TEST_NOW_MS + 28799000.0) === undefined).toBe(false)
  expect(store.get(t, TEST_NOW_MS + 28800000.0) === undefined).toBe(true)
  const t2 = try store.create("user-2", "viewer", TEST_NOW_MS)
  expect(t2 === t).toBe(false)
  expect(store.get("sk-sess-nope", TEST_NOW_MS) === undefined).toBe(true)
  try store.delete(t2)
  expect(store.get(t2, TEST_NOW_MS) === undefined).toBe(true)
})

test("a session keeps the email of its sign-in", () => {
  const store = new UiSessions()
  const t = try store.create("user-9", "editor", TEST_NOW_MS, "dana@example.com")
  const s = store.get(t, TEST_NOW_MS)
  expect(s === undefined ? "" : s.email ?? "").toBe("dana@example.com")
  const t2 = try store.create("user-10", "viewer", TEST_NOW_MS)
  const s2 = store.get(t2, TEST_NOW_MS)
  expect(s2 === undefined ? "x" : s2.email ?? "").toBe("")
})

test("session TTL follows session_ttl_seconds", () => {
  const store = new UiSessions(60)
  const t = try store.create("u", "editor", TEST_NOW_MS)
  expect(store.get(t, TEST_NOW_MS + 59000.0) === undefined).toBe(false)
  expect(store.get(t, TEST_NOW_MS + 60000.0) === undefined).toBe(true)
})

test("the configured audiences replace the client id; Entra's app ID URI is one of them", () => {
  const cfg: OidcConfig = { enabled: true, issuer: TEST_ISS, client_id: TEST_CLIENT, audiences: ["api://client-abc", "custom-aud"] }
  const v1 = try signedToken(claimsJson("").replace(`"aud":"${TEST_CLIENT}"`, `"aud":"api://client-abc"`))
  expect(verifyIdToken(v1, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("ok")
  // before: only the client id was accepted
  expect(verifyIdToken(v1, TEST_JWKS, testCfg({}), TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  // the client id itself is no longer enough once audiences are set
  const plain = try signedToken(claimsJson(""))
  const r = verifyIdToken(plain, TEST_JWKS, cfg, TEST_ISS, "n-1", TEST_NOW_MS)
  expect(r.kind === "error" && r.message.startsWith("invalid audience")).toBe(true)
  expect(acceptedAudiences(testCfg({})).join(",")).toBe(TEST_CLIENT)
})

test("a refreshed ID token needs no nonce; a sign-in's still does", () => {
  const noNonce = try signedToken(claimsJson("").replace(`"nonce":"n-1",`, ""))
  expect(verifyIdToken(noNonce, TEST_JWKS, testCfg({}), TEST_ISS, undefined, TEST_NOW_MS).kind).toBe("ok")
  expect(verifyIdToken(noNonce, TEST_JWKS, testCfg({}), TEST_ISS, "n-1", TEST_NOW_MS).kind).toBe("error")
  const body = refreshRequestBody({ enabled: true, issuer: TEST_ISS, client_id: TEST_CLIENT, client_secret: "s&t" }, "rt/1")
  expect(body).toBe("grant_type=refresh_token&refresh_token=rt%2F1&client_id=client-abc&client_secret=s%26t")
})

test("access token claims: signature, issuer, lifetime, and an audience or azp of this client", () => {
  const cfg = testCfg({})
  const kc = try signedToken(`{"iss":"${TEST_ISS}","sub":"u-1","aud":"account","azp":"${TEST_CLIENT}","exp":1700003600,"realm_access":{"roles":["raiju-admin"]}}`)
  const ok = accessTokenClaims(kc, TEST_JWKS, cfg, TEST_ISS, TEST_NOW_MS)
  expect(ok.kind === "ok" && ok.claims.includes("raiju-admin")).toBe(true)
  const other = try signedToken(`{"iss":"${TEST_ISS}","sub":"u-1","aud":"account","azp":"another","exp":1700003600}`)
  expect(accessTokenClaims(other, TEST_JWKS, cfg, TEST_ISS, TEST_NOW_MS).kind).toBe("error")
  // an explicit audience must be in aud, azp is not enough then
  const strict: OidcConfig = { enabled: true, issuer: TEST_ISS, client_id: TEST_CLIENT, audiences: ["raiju-api"] }
  expect(accessTokenClaims(kc, TEST_JWKS, strict, TEST_ISS, TEST_NOW_MS).kind).toBe("error")
  expect(accessTokenClaims(kc, TEST_JWKS, cfg, "https://evil.example.com", TEST_NOW_MS).kind).toBe("error")
  expect(accessTokenClaims(kc, TEST_JWKS, cfg, TEST_ISS, 1700009999000.0).kind).toBe("error")
  expect(accessTokenClaims("opaque-token", TEST_JWKS, cfg, TEST_ISS, TEST_NOW_MS).kind).toBe("error")
})

test("a session with a refresh token waits past its expiry for a refresh, is renewed, swept and ended", () => {
  const store = new UiSessions(60)
  const t = try store.create("u-1", "editor", TEST_NOW_MS, "Ann@x.io", "rt-1")
  const plain = try store.create("u-2", "viewer", TEST_NOW_MS)
  expect(store.refreshable(t, TEST_NOW_MS + 1000.0) === undefined).toBe(true)
  // expired: no session, but it can be refreshed
  expect(store.get(t, TEST_NOW_MS + 61000.0) === undefined).toBe(true)
  const due = store.refreshable(t, TEST_NOW_MS + 61000.0)
  expect(due !== undefined && due.refresh === "rt-1" && due.sub === "u-1").toBe(true)
  expect(store.refreshable(plain, TEST_NOW_MS + 61000.0) === undefined).toBe(true)
  try store.renew(t, "admin", TEST_NOW_MS + 61000.0, "rt-2")
  const s = store.get(t, TEST_NOW_MS + 62000.0)
  expect(s !== undefined && s.role === "admin").toBe(true)
  expect(store.dueBy(TEST_NOW_MS + 62000.0, TEST_NOW_MS + 62000.0).length).toBe(0)
  const soon = store.dueBy(TEST_NOW_MS + 200000.0, TEST_NOW_MS + 62000.0)
  expect(soon.length === 1 && soon[0]!.refresh === "rt-2").toBe(true)
  expect(try store.endUser(["ann@x.io"], TEST_NOW_MS + 62000.0)).toBe(1)
  expect(store.get(t, TEST_NOW_MS + 62000.0) === undefined).toBe(true)
})

test("sessions on a shared file: made on one worker, used, refreshed and ended on another, kept across a restart", () => {
  const file = "/tmp/raiju-ui-sessions-test-" + process.pid + "-" + Math.floor(Date.now()) + ".json"
  const sealer: Sealer = { seal: (v: string): string => "sealed:" + v, open: (v: string): string | undefined => v.startsWith("sealed:") ? v.slice(7, v.byteLength) : undefined }
  const a = new UiSessions(60)
  a.setFile(file)
  a.sealer = sealer
  const b = new UiSessions(60)
  b.setFile(file)
  b.sealer = sealer
  const now = Date.now()
  const t = try a.create("u-1", "admin", now, "ann@x.io", "rt-secret")
  const plain = try a.create("u-2", "viewer", now)
  // another worker knows the session at once
  expect(b.get(t, now)?.sub ?? "").toBe("u-1")
  // the file holds neither the token nor the refresh token in clear
  const text = try readFileSync(file, "utf8")
  expect(text.includes(t) || text.includes(plain)).toBe(false)
  expect(text.includes("sealed:rt-secret")).toBe(true)
  // a restart: a new store on the file serves the sessions
  const c = new UiSessions(60)
  c.setFile(file)
  c.sealer = sealer
  expect(c.get(plain, now)?.role ?? "").toBe("viewer")
  // a refresh due on one worker, renewed there, is seen by the other
  const due = c.refreshable(t, now + 61000.0)
  expect(due !== undefined && due.refresh === "rt-secret").toBe(true)
  if (due !== undefined) try c.renew(due.token, "editor", now + 61000.0, "rt-2")
  expect(a.get(t, now + 62000.0)?.role ?? "").toBe("editor")
  // a logout on one worker ends the session on the others
  try b.delete(plain)
  expect(a.get(plain, now + 1.0)).toBeUndefined()
  expect(try c.endUser(["ANN@x.io"], now + 62000.0)).toBe(1)
  expect(b.get(t, now + 62001.0)).toBeUndefined()
  try {
    rmSync(file, { force: true })
  } catch (e) {}
})

test("a sign-in begun on one worker completes on another (one key), carrying its return path; nothing is stored", () => {
  const key = stateKeyFrom(utf8("a config encryption key"))
  const a = new OidcFlows()
  a.setKey(key)
  const b = new OidcFlows()
  b.setKey(key)
  const disc: Discovery = { authorization_endpoint: "https://idp.example.com/auth", token_endpoint: "https://idp.example.com/token", jwks_uri: "https://idp.example.com/jwks", issuer: TEST_ISS }
  const now = Date.now()
  const begun = try a.begin(testCfg({}), disc, now, "/mcp/consent?x=1")
  // the state reveals neither the verifier nor the return path
  expect(begun.state.startsWith("s1.")).toBe(true)
  expect(begun.state.includes("consent")).toBe(false)
  const done = b.complete(begun.state, now + 1000.0)
  expect(done !== undefined && done.back === "/mcp/consent?x=1" && done.verifier.byteLength === 64).toBe(true)
  if (done !== undefined) expect(encodeUrl(sha256(utf8(done.verifier)))).toBe(paramOf(begun.url, "code_challenge")!)
  // used once on a worker
  expect(b.complete(begun.state, now + 2000.0)).toBeUndefined()
  // another key (another node without the same encryption key, or a restart without one) cannot open it
  const other = new OidcFlows()
  other.setKey(stateKeyFrom(utf8("another key")))
  expect(other.complete(begun.state, now + 1000.0)).toBeUndefined()
})

test("a forged, changed or expired state is refused", () => {
  const f = new OidcFlows()
  f.setKey(stateKeyFrom(utf8("k")))
  const r = try f.begin(testCfg({}), TEST_DISC, TEST_NOW_MS)
  // one character changed anywhere in the sealed part fails its tag
  const mid = r.state.byteLength - 10
  const flip = r.state.slice(mid, mid + 1) === "A" ? "B" : "A"
  expect(f.complete(r.state.slice(0, mid) + flip + r.state.slice(mid + 1), TEST_NOW_MS)).toBeUndefined()
  expect(f.complete("s1." + encodeUrl(utf8(`{"v":"x","n":"y","e":1e15}`)), TEST_NOW_MS)).toBeUndefined()
  expect(f.complete("s1.%%%", TEST_NOW_MS)).toBeUndefined()
  expect(f.complete("s1." + "A".repeat(5000), TEST_NOW_MS)).toBeUndefined()
  expect(f.complete(r.state, TEST_NOW_MS + 600000.0)).toBeUndefined()
  // a worker with no key set makes one of its own: its states open there
  const own = new OidcFlows()
  const o = try own.begin(testCfg({}), TEST_DISC, TEST_NOW_MS)
  expect(own.complete(o.state, TEST_NOW_MS) === undefined).toBe(false)
  expect(f.complete(o.state, TEST_NOW_MS)).toBeUndefined()
})
