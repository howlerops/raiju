// OpenID Connect single sign-on for the admin UI and management API: the
// authorization code flow with PKCE (RFC 7636), ID token checks (OIDC Core
// 3.1.3.7) and RS256 signatures (RFC 7518, RSASSA-PKCS1-v1_5). The lead does
// the HTTP calls (discovery, token, JWKS); everything here is pure except the
// small state held by OidcFlows and UiSessions.
import { Field, fields, elements, find, rawStr, rawNum, decodeString } from "./json"
import { sha256, utf8, secureHex, toHex, hmacSha256 } from "./crypto"
import { gcmSeal, gcmOpen } from "./aesgcm"
import { SharedTable } from "./sharedtable"
import { readFileSync, rmSync } from "node:fs"
import { encodeUrl, decode } from "./base64"
import { modPow, signRs256 } from "./jwt"

export type OidcConfig = {
  enabled: bool,
  issuer: string,
  client_id: string,
  client_secret?: string,
  // absent: the gateway's own /api/oidc/callback on the host the sign-in came to (ops.tov withRedirect)
  redirect_uri?: string,
  scopes?: string[],
  role_claim?: string,
  role_map?: Record<string, string>,
  default_role?: string,
  session_ttl_seconds?: int,
  // the audiences an ID token may carry (absent: the client id). scim_config's audience and Entra's appIdUri.
  audiences?: string[],
  // "access_token": the claims are read from the access token (Keycloak puts its roles there), checked against the
  // same signing keys; else the ID token's.
  claims_token?: string,
}

export type Discovery = { authorization_endpoint: string, token_endpoint: string, jwks_uri: string, issuer: string }

// claims: the payload of the ID token (JSON), for the claim mappings of scim_config (claimsync.tov)
export type IdTokenResult = { kind: "ok", sub: string, email?: string, role: string, claims: string } | { kind: "error", message: string }

export type Session = { sub: string, role: string, email?: string }

const ROLES = ["admin", "editor", "viewer", "auditor"]

// Clock skew allowed on exp and nbf, in seconds.
const SKEW_S = 60

// A login must finish within this window; abandoned logins expire.
const PENDING_TTL_MS = 600000.0

// Upper bound on the used states a worker remembers (until they expire), so callbacks cannot grow memory without limit.
const MAX_USED = 10000

// A state value: this prefix, then base64url of a 12-byte nonce and the AES-256-GCM sealed sign-in.
const STATE_PREFIX = "s1."
const STATE_AAD = "raiju-oidc-state-v1"

const enc = new TextEncoder()

// ---- discovery ----

export function discoveryUrl(issuer: string): string {
  let base = issuer
  while (base.endsWith("/")) base = base.slice(0, base.byteLength - 1)
  return base + "/.well-known/openid-configuration"
}

// Endpoints must be https; plain http is allowed only for a local IdP in development.
function endpoint(fs: Field[], key: string): string throws SyntaxError {
  const u = rawStr(fs, key)
  if (u === undefined || !(u.startsWith("https://") || u.startsWith("http://localhost") || u.startsWith("http://127.0.0.1"))) {
    throw new SyntaxError(`discovery: ${key} is missing or not https`)
  }
  return u
}

export function parseDiscovery(json: string): Discovery throws SyntaxError {
  const fs = try fields(json)
  const issuer = rawStr(fs, "issuer")
  if (issuer === undefined) throw new SyntaxError("discovery: missing issuer")
  return {
    authorization_endpoint: try endpoint(fs, "authorization_endpoint"),
    token_endpoint: try endpoint(fs, "token_endpoint"),
    jwks_uri: try endpoint(fs, "jwks_uri"),
    issuer: issuer,
  }
}

// ---- encoding helpers ----

const HEX = "0123456789ABCDEF"

// Byte-indexed table: the RFC 3986 unreserved characters map to themselves, every other byte to "".
function makeUnreserved(): string[] {
  const t: string[] = []
  for (let i = 0; i < 256; i++) t.push("")
  const alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~"
  const bs = enc.encode(alpha)
  for (let i = 0; i < alpha.byteLength; i++) t[int(bs[i]!)] = alpha.slice(i, i + 1)
  return t
}

const UNRESERVED = makeUnreserved()

// Percent-encodes a string for a query or form body (RFC 3986).
function pct(s: string): string {
  const out: string[] = []
  for (const b of utf8(s)) {
    const c = int(b)
    const plain = UNRESERVED[c]!
    if (plain !== "") {
      out.push(plain)
    } else {
      out.push("%" + HEX.slice(c >> 4, (c >> 4) + 1) + HEX.slice(c & 15, (c & 15) + 1))
    }
  }
  return out.join("")
}

function kv(k: string, v: string): string {
  return pct(k) + "=" + pct(v)
}

function decodeText(s: string): string throws Error {
  return try new TextDecoder().decode(try decode(s))
}

// ---- authorization request and token request ----

// A sign-in in flight, as its state carries it: the PKCE verifier, the nonce, the expiry and where the sign-in returns
// (a consent page that sent its user to sign in; absent for the dashboard).
type Pending = { v: string, n: string, e: number, b?: string }

// Seals a secret kept in a shared file (the config's encryption key, store.tov sealStored), and opens it again
// (undefined when it cannot be opened). The default keeps it as it is (0600 file, tests).
export type Sealer = { seal: (v: string) => string, open: (v: string) => string | undefined }

export function plainSealer(): Sealer {
  return { seal: (v: string): string => v, open: (v: string): string | undefined => v }
}

function hashKey(token: string): string {
  return toHex(sha256(utf8(token)))
}

const HEXD = "0123456789abcdef"

function randomBytes(n: int): u8[] throws Error {
  const h = try secureHex(n * 2)
  const out: u8[] = []
  for (let i = 0; i + 1 < h.byteLength; i += 2) out.push(u8(HEXD.indexOf(h.slice(i, i + 1)) * 16 + HEXD.indexOf(h.slice(i + 1, i + 2))))
  return out
}

// The key that seals sign-in states, from the config's encryption key (its own key, derived), so every node and
// worker holding that key opens a state another one made, across restarts too.
export function stateKeyFrom(configKey: u8[]): u8[] {
  return hmacSha256(configKey, utf8(STATE_AAD))
}

// A key for sign-in states when the config has no encryption key: made once in the supervisor before the workers
// fork, so the node's workers share it; a sign-in begun before a restart, or on another node, is then refused.
export function randomStateKey(): u8[] throws Error {
  return try randomBytes(32)
}

// The sign-ins in flight. Nothing is kept per login: begin seals the verifier, nonce, expiry and return path into the
// state value itself (AES-256-GCM, so it can be neither read nor forged without the key), and the callback, on any
// worker, opens it. An unauthenticated /login therefore writes nothing. A state opened once is remembered by its worker
// until it expires and refused after; the identity provider's code it comes back with is single-use there.
export class OidcFlows {
  private key: u8[] = []
  // hashes of states already used here, with their expiry
  private used: Map<string, number> = new Map()

  setKey(key: u8[]): void {
    this.key = key
  }

  private sealKey(): u8[] throws Error {
    if (this.key.length !== 32) this.key = try randomStateKey()
    return this.key
  }

  private seal(p: Pending): string throws Error {
    const nonce = try randomBytes(12)
    return STATE_PREFIX + encodeUrl(nonce.concat(gcmSeal(try this.sealKey(), nonce, utf8(JSON.stringify(p)), utf8(STATE_AAD))))
  }

  private open(state: string): Pending | undefined {
    if (!state.startsWith(STATE_PREFIX) || state.byteLength > 4096) return undefined
    try {
      const raw = try decode(state.slice(STATE_PREFIX.byteLength))
      if (raw.length < 28) return undefined
      const pt = gcmOpen(try this.sealKey(), raw.slice(0, 12), raw.slice(12), utf8(STATE_AAD))
      if (pt === undefined) return undefined
      return try JSON.parse(try new TextDecoder().decode(pt)) as Pending
    } catch (e) {
      return undefined
    }
  }

  // Remembers a used state until it expires; past MAX_USED the ones that expire first are forgotten.
  private remember(h: string, expires: number, nowMs: number): void {
    if (this.used.size >= MAX_USED) {
      for (const k of this.used.keys()) {
        if ((this.used.get(k) ?? 0.0) <= nowMs) this.used.delete(k)
      }
      if (this.used.size >= MAX_USED) {
        const live = this.used.keys().map((k) => ({ k: k, e: this.used.get(k) ?? 0.0 }))
        live.sort((a: { k: string, e: number }, b: { k: string, e: number }): int => (a.e < b.e ? -1 : (a.e > b.e ? 1 : 0)))
        for (let i = 0; i < live.length - MAX_USED / 2; i++) this.used.delete(live[i]!.k)
      }
    }
    this.used.set(h, expires)
  }

  // Starts a login: seals state, nonce and PKCE verifier (and where to return, when back is set) into the state, and
  // returns the authorize URL.
  begin(cfg: OidcConfig, disc: Discovery, nowMs: number, back?: string): { url: string, state: string } throws Error {
    if (disc.issuer !== cfg.issuer) throw new Error("oidc: discovery issuer does not match the configured issuer")
    const nonce = try secureHex(32)
    // 64 hex characters are a valid PKCE verifier (43 to 128 unreserved characters).
    const verifier = try secureHex(64)
    const challenge = encodeUrl(sha256(utf8(verifier)))
    const state = try this.seal({ v: verifier, n: nonce, e: nowMs + PENDING_TTL_MS, b: back === "" ? undefined : back })
    let scopes = cfg.scopes ?? ["openid", "email", "profile"]
    if (!scopes.includes("openid")) scopes = ["openid"].concat(scopes)
    const params = [
      kv("response_type", "code"),
      kv("client_id", cfg.client_id),
      kv("redirect_uri", cfg.redirect_uri ?? ""),
      kv("scope", scopes.join(" ")),
      kv("state", state),
      kv("nonce", nonce),
      kv("code_challenge", challenge),
      kv("code_challenge_method", "S256"),
    ]
    const sep = disc.authorization_endpoint.includes("?") ? "&" : "?"
    return { url: disc.authorization_endpoint + sep + params.join("&"), state: state }
  }

  // Returns the verifier, nonce and return path a state carries, once per worker. A state that was not sealed with this
  // key, was changed, has expired or was used here already gets undefined.
  complete(state: string, nowMs: number): { verifier: string, nonce: string, back: string } | undefined {
    if (state === "") return undefined
    const p = this.open(state)
    if (p === undefined || p.e <= nowMs || p.v === "" || p.n === "") return undefined
    const h = hashKey(state)
    const seen = this.used.get(h)
    if (seen !== undefined && seen > nowMs) return undefined
    this.remember(h, p.e, nowMs)
    return { verifier: p.v, nonce: p.n, back: p.b ?? "" }
  }
}

// The form body for the token endpoint. client_secret is sent in the body (client_secret_post).
export function tokenRequestBody(cfg: OidcConfig, code: string, verifier: string): string {
  const parts = [
    kv("grant_type", "authorization_code"),
    kv("code", code),
    kv("redirect_uri", cfg.redirect_uri ?? ""),
    kv("client_id", cfg.client_id),
    kv("code_verifier", verifier),
  ]
  const secret = cfg.client_secret
  if (secret !== undefined && secret !== "") parts.push(kv("client_secret", secret))
  return parts.join("&")
}

// The form body that trades a refresh token for fresh tokens (a silent session refresh).
export function refreshRequestBody(cfg: OidcConfig, refreshToken: string): string {
  const parts = [kv("grant_type", "refresh_token"), kv("refresh_token", refreshToken), kv("client_id", cfg.client_id)]
  const secret = cfg.client_secret
  if (secret !== undefined && secret !== "") parts.push(kv("client_secret", secret))
  return parts.join("&")
}

// ---- RS256 verification ----

// Big-endian bytes as a non-negative bigint.
function bigOfBytes(b: u8[]): bigint {
  let v = 0n
  for (const x of b) v = v * 256n + BigInt(int(x))
  return v
}

function byteLenOf(x: bigint): int {
  let n = 0
  let v = x
  while (v > 0n) {
    v = v >> 8n
    n++
  }
  return n
}

// DigestInfo prefix for SHA-256 (RFC 8017, section 9.2 note 1).
const SHA256_DIGEST_INFO: int[] = [0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20]

// The expected padded message EM = 00 01 FF..FF 00 || DigestInfo || hash, as a k-byte number.
function expectedEm(hash: u8[], k: int): bigint throws Error {
  const tLen = SHA256_DIGEST_INFO.length + hash.length
  if (k < tLen + 11) throw new Error("oidc: RSA key too small for SHA-256")
  const em: u8[] = [u8(0), u8(1)]
  for (let i = 0; i < k - tLen - 3; i++) em.push(u8(0xff))
  em.push(u8(0))
  for (const b of SHA256_DIGEST_INFO) em.push(u8(b))
  for (const b of hash) em.push(b)
  return bigOfBytes(em)
}

// RSASSA-PKCS1-v1_5 verification: s^e mod n must equal the expected encoding.
function rsaVerify(signingInput: string, sigB64: string, nB64: string, eB64: string): bool throws Error {
  const n = bigOfBytes(try decode(nB64))
  const e = bigOfBytes(try decode(eB64))
  const k = byteLenOf(n)
  // Refuse keys under 2048 bits, and exponents that are not odd and above 1.
  if (k < 256) throw new Error("oidc: RSA key shorter than 2048 bits")
  if (e < 3n || (e & 1n) === 0n) throw new Error("oidc: invalid RSA exponent")
  const sig = try decode(sigB64)
  if (sig.length !== k) return false
  const s = bigOfBytes(sig)
  if (s >= n) return false
  const m = modPow(s, e, n)
  const want = try expectedEm(sha256(utf8(signingInput)), k)
  return m === want
}

// The JWK with the header's kid (or the only RSA signing key when there is no kid).
function findJwk(jwksJson: string, kid: string | undefined): Field[] throws Error {
  const jfs = try fields(jwksJson)
  const keysRaw = find(jfs, "keys")
  if (keysRaw === undefined) throw new Error("oidc: JWKS has no keys")
  const found: Field[][] = []
  for (const raw of try elements(keysRaw)) {
    const kfs = try fields(raw)
    if (rawStr(kfs, "kty") !== "RSA") continue
    const use = rawStr(kfs, "use")
    if (use !== undefined && use !== "sig") continue
    const alg = rawStr(kfs, "alg")
    if (alg !== undefined && alg !== "RS256") continue
    if (kid !== undefined && rawStr(kfs, "kid") !== kid) continue
    found.push(kfs)
  }
  if (found.length !== 1) throw new Error("oidc: no unique signing key matches the ID token")
  return found[0]!
}

// Strings in a JSON value: a string gives one, an array gives its string elements.
function stringsOf(raw: string | undefined): string[] throws SyntaxError {
  const out: string[] = []
  if (raw === undefined) return out
  if (raw.startsWith("\"")) {
    out.push(try decodeString(raw))
  } else if (raw.startsWith("[")) {
    for (const el of try elements(raw)) {
      if (el.startsWith("\"")) out.push(try decodeString(el))
    }
  }
  return out
}

const ROLE_DEFAULT = "viewer"

function isRole(r: string): bool {
  return ROLES.includes(r)
}

// First group (in claim order) with a role_map entry wins; else default_role.
function roleOf(cfg: OidcConfig, pfs: Field[]): string throws Error {
  const groups = try stringsOf(find(pfs, cfg.role_claim ?? "groups"))
  const map = cfg.role_map
  if (map !== undefined) {
    for (const g of groups) {
      const r = map.get(g)
      if (r !== undefined) {
        if (!isRole(r)) throw new Error(`oidc: role_map maps to unknown role ${r}`)
        return r
      }
    }
  }
  const d = cfg.default_role ?? ROLE_DEFAULT
  if (!isRole(d)) throw new Error(`oidc: default_role ${d} is not a role`)
  return d
}

// The payload of an RS256 JWS checked against the JWKS. what names the token in errors.
function signedPayload(token: string, jwksJson: string, what: string): string throws Error {
  const parts = token.split(".")
  if (parts.length !== 3) throw new Error(`oidc: ${what} is not a JWS compact serialization`)
  const hfs = try fields(try decodeText(parts[0]!))
  if (rawStr(hfs, "alg") !== "RS256") throw new Error(`oidc: ${what} alg is not RS256`)
  const kid = rawStr(hfs, "kid")
  const payload = try decodeText(parts[1]!)
  const jwk = try findJwk(jwksJson, kid)
  const nB64 = rawStr(jwk, "n")
  const eB64 = rawStr(jwk, "e")
  if (nB64 === undefined || eB64 === undefined) throw new Error("oidc: signing key has no modulus or exponent")
  const signingInput = parts[0]! + "." + parts[1]!
  const ok = try rsaVerify(signingInput, parts[2]!, nB64, eB64)
  if (!ok) throw new Error(`oidc: ${what} signature is invalid`)
  return payload
}

// The audiences a token may carry: the configured ones (scim_config's audience, Entra's appIdUri), else the client id.
export function acceptedAudiences(cfg: OidcConfig): string[] {
  const out = (cfg.audiences ?? []).filter((a) => a !== "")
  return out.length > 0 ? out : [cfg.client_id]
}

function timesValid(pfs: Field[], nowMs: number, what: string): void throws Error {
  const nowS = nowMs / 1000.0
  const exp = rawNum(pfs, "exp")
  if (exp === undefined) throw new Error(`oidc: ${what} has no exp`)
  if (nowS > exp + SKEW_S) throw new Error(`oidc: ${what} has expired`)
  const nbf = rawNum(pfs, "nbf")
  if (nbf !== undefined && nowS + SKEW_S < nbf) throw new Error(`oidc: ${what} is not valid yet`)
}

// nonce undefined: a token from a refresh, which carries no new nonce (OIDC Core 12.2).
function checkToken(idToken: string, jwksJson: string, cfg: OidcConfig, issuer: string, nonce: string | undefined, nowMs: number): IdTokenResult throws Error {
  const payload = try signedPayload(idToken, jwksJson, "ID token")
  const pfs = try fields(payload)

  if (rawStr(pfs, "iss") !== issuer) throw new Error("oidc: ID token issuer does not match")

  // aud is a string or an array; the array form also needs azp (OIDC Core 3.1.3.7 step 3 and 5).
  const audList = try stringsOf(find(pfs, "aud"))
  const accepted = acceptedAudiences(cfg)
  if (!audList.some((a) => accepted.includes(a))) throw new Error("invalid audience: the ID token audience is not this client's")
  const azp = rawStr(pfs, "azp")
  if (azp !== undefined && azp !== cfg.client_id) throw new Error("oidc: ID token azp is not this client")
  if (audList.length > 1 && azp === undefined) throw new Error("oidc: ID token has several audiences and no azp")

  try timesValid(pfs, nowMs, "ID token")

  if (nonce !== undefined && rawStr(pfs, "nonce") !== nonce) throw new Error("oidc: ID token nonce does not match")
  const sub = rawStr(pfs, "sub")
  if (sub === undefined || sub === "") throw new Error("oidc: ID token has no sub")
  const email = rawStr(pfs, "email")
  const role = try roleOf(cfg, pfs)
  return { kind: "ok", sub: sub, email: email, role: role, claims: payload }
}

// Checks an ID token from the token endpoint. Every failure is returned as kind "error".
export function verifyIdToken(idToken: string, jwksJson: string, cfg: OidcConfig, issuer: string, nonce: string | undefined, nowMs: number): IdTokenResult {
  try {
    return try checkToken(idToken, jwksJson, cfg, issuer, nonce, nowMs)
  } catch (e) {
    return { kind: "error", message: e.message }
  }
}

// The claims of an access token that is a JWT signed by the same keys (Keycloak's, which carry its roles): the
// signature, issuer and lifetime are checked, and its audience must be an accepted one or its azp this client
// (Keycloak's access tokens name the account service as their audience and the client as azp).
export function accessTokenClaims(token: string, jwksJson: string, cfg: OidcConfig, issuer: string, nowMs: number): { kind: "ok", claims: string } | { kind: "error", message: string } {
  try {
    const payload = try signedPayload(token, jwksJson, "access token")
    const pfs = try fields(payload)
    if (rawStr(pfs, "iss") !== issuer) throw new Error("oidc: access token issuer does not match")
    const audList = try stringsOf(find(pfs, "aud"))
    const accepted = acceptedAudiences(cfg)
    const azp = rawStr(pfs, "azp")
    const explicit = (cfg.audiences ?? []).filter((a) => a !== "").length > 0
    const audOk = audList.some((a) => accepted.includes(a))
    if (!audOk && (explicit || azp !== cfg.client_id)) throw new Error("invalid audience: the access token audience is not this client's")
    try timesValid(pfs, nowMs, "access token")
    return { kind: "ok", claims: payload }
  } catch (e) {
    return { kind: "error", message: e.message }
  }
}

// ---- UI sessions ----

// refresh: the identity provider's refresh token, kept on the server; a session that has one outlives its expiry by
// REFRESH_GRACE_MS so the next request can refresh it silently.
type SessionRecord = { sub: string, role: string, email?: string, expires: number, refresh?: string }

// A session that is due for a silent refresh: its token, user and refresh token.
export type DueSession = { token: string, sub: string, email?: string, refresh: string }

const SESSION_PREFIX = "sk-sess-"
const SESSION_TTL_S = 28800
// sessions kept at most (past it the ones that end first go)
const SESSION_CAP = 50000
const REFRESH_GRACE_MS = 7.0 * 24 * 3600 * 1000

// The dashboard's sessions (single sign-on and password sign-in), by a hash of their token. With a file (setFile, beside
// config.json) they are shared by the workers of a node and kept across restarts; the identity provider's refresh token
// is sealed there. A DueSession's token is the session's key (the hash), which renew and delete take as they take a
// token.
export class UiSessions {
  private table: SharedTable = new SharedTable("", SESSION_CAP)
  sealer: Sealer = plainSealer()

  ttlSeconds: number

  constructor(ttlSeconds?: number) {
    this.ttlSeconds = ttlSeconds ?? SESSION_TTL_S
  }

  setFile(file: string): void {
    this.table = new SharedTable(file, SESSION_CAP)
  }

  // A session token, or a key (a DueSession's), as the table's key.
  private keyOf(token: string): string {
    return token.startsWith(SESSION_PREFIX) ? hashKey(token) : token
  }

  private record(key: string, nowMs: number): SessionRecord | undefined {
    const v = this.table.get(key, nowMs)
    if (v === undefined) return undefined
    try {
      return try JSON.parse(v) as SessionRecord
    } catch (e) {
      return undefined
    }
  }

  // The last moment a record is kept: its expiry, or with a refresh token the grace for a refresh after it.
  private until(r: SessionRecord): number {
    return r.refresh === undefined ? r.expires : r.expires + REFRESH_GRACE_MS
  }

  // Throws when the sessions file's lock cannot be had (sharedtable.tov): the caller fails its request.
  private keep(key: string, r: SessionRecord, nowMs: number): void throws Error {
    try this.table.put(key, JSON.stringify(r), this.until(r), nowMs)
  }

  // The refresh token a record holds, opened ("" when it cannot be).
  private refreshOf(r: SessionRecord): string {
    const sealed = r.refresh
    if (sealed === undefined) return ""
    return this.sealer.open(sealed) ?? ""
  }

  // email is kept so a session can be checked against the user it names (governance lists users by email)
  create(sub: string, role: string, nowMs: number, email?: string, refresh?: string): string throws Error {
    const token = SESSION_PREFIX + (try secureHex(48))
    let sealed: string | undefined = undefined
    if (refresh !== undefined && refresh !== "") {
      const s = this.sealer.seal(refresh)
      // a refresh token that could not be sealed is not kept: the session then ends at its expiry
      if (s !== "") sealed = s
    }
    try this.keep(hashKey(token), { sub: sub, role: role, email: email, expires: nowMs + this.ttlSeconds * 1000.0, refresh: sealed }, nowMs)
    return token
  }

  get(token: string, nowMs: number): Session | undefined {
    const s = this.record(this.keyOf(token), nowMs)
    // an expired session with a refresh token waits for its refresh (refreshable, renew) until its row expires
    if (s === undefined || s.expires <= nowMs) return undefined
    return { sub: s.sub, role: s.role, email: s.email }
  }

  // The session behind a token when it has expired and holds a refresh token (the next request refreshes it).
  refreshable(token: string, nowMs: number): DueSession | undefined {
    const key = this.keyOf(token)
    const s = this.record(key, nowMs)
    if (s === undefined || s.expires > nowMs) return undefined
    const r = this.refreshOf(s)
    if (r === "") return undefined
    return { token: key, sub: s.sub, email: s.email, refresh: r }
  }

  // The sessions with a refresh token that expire before limitMs (the daily sweep refreshes them ahead of time).
  dueBy(limitMs: number, nowMs?: number): DueSession[] {
    const out: DueSession[] = []
    for (const row of this.table.entries(nowMs ?? Date.now())) {
      let s: SessionRecord | undefined = undefined
      try {
        s = JSON.parse(row.v) as SessionRecord
      } catch (e) {
        continue
      }
      if (s === undefined || s.expires >= limitMs) continue
      const r = this.refreshOf(s)
      if (r !== "") out.push({ token: row.k, sub: s.sub, email: s.email, refresh: r })
    }
    return out
  }

  // A refreshed session: a new lifetime from now, the role the fresh claims gave, and the new refresh token when the
  // identity provider rotated it.
  renew(token: string, role: string | undefined, nowMs: number, refresh: string | undefined): void throws Error {
    const key = this.keyOf(token)
    const s = this.record(key, nowMs)
    if (s === undefined) return
    let n = s
    if (role !== undefined) n.role = role
    n.expires = nowMs + this.ttlSeconds * 1000.0
    if (refresh !== undefined && refresh !== "") {
      const sealed = this.sealer.seal(refresh)
      if (sealed !== "") n.refresh = sealed
    }
    try this.keep(key, n, nowMs)
  }

  // Ends every session of a user (by subject or email, without regard to case): a removed user is signed out.
  endUser(names: string[], nowMs?: number): int throws Error {
    const now = nowMs ?? Date.now()
    const lower = names.filter((x) => x !== "").map((x) => x.toLowerCase())
    const gone: string[] = []
    for (const row of this.table.entries(now)) {
      let s: SessionRecord | undefined = undefined
      try {
        s = JSON.parse(row.v) as SessionRecord
      } catch (e) {
        continue
      }
      if (s === undefined) continue
      if (lower.includes(s.sub.toLowerCase()) || lower.includes((s.email ?? "").toLowerCase())) gone.push(row.k)
    }
    try this.table.del(gone, now)
    return gone.length
  }

  delete(token: string): void throws Error {
    try this.table.del([this.keyOf(token)], Date.now())
  }
}

