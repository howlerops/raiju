})

test("the OAuth config status answers a flow's own state with flow_id: pending, failed, expired or the config's", () => {
  const s = fixture()
  mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"gh2\",\"connection_type\":\"http\",\"connection_string\":\"https://gh.example/mcp\",\"auth\":{\"type\":\"oauth\",\"client_id\":\"c\",\"authorize_url\":\"https://gh.example/authorize\",\"token_url\":\"https://gh.example/token\"}}")
  const now = Date.now()
  const f = try startAdminFlow("gh2", "st-poll-1", "v".repeat(50), "http://gw/api/oauth/callback", "https://gh.example/authorize", now)
  const pending = oauthConfigRoute(s, "GET", "/api/oauth/config/gh2/status?flow_id=" + f.id)!
  expect(pending.body.includes("\"status\":\"pending\"")).toBe(true)
  expect(pending.body.includes("\"flow_status\":\"pending\"")).toBe(true)
  // a flow of another config is not found
  expect(oauthConfigRoute(s, "GET", "/api/oauth/config/fs/status?flow_id=" + f.id)!.status).toBe(404)
  failAdminFlow(f, now)
  expect(oauthConfigRoute(s, "GET", "/api/oauth/config/gh2/status?flow_id=" + f.id)!.body.includes("\"status\":\"failed\"")).toBe(true)
  // without flow_id the config reads failed: its last flow failed and it holds no token
  expect(oauthConfigRoute(s, "GET", "/api/oauth/config/gh2/status")!.body).toBe("{\"id\":\"gh2\",\"status\":\"failed\"}")
  // a flow that is gone while the config never got a token expired
  expect(oauthConfigRoute(s, "GET", "/api/oauth/config/gh2/status?flow_id=nope")!.body.includes("\"status\":\"failed\"")).toBe(true)
  endAdminFlow(f.id, now)
  expect(oauthConfigRoute(s, "GET", "/api/oauth/config/gh2/status?flow_id=nope")!.body.includes("\"status\":\"expired\"")).toBe(true)
  expect(pollStatus(undefined, "authorized", now)).toBe("authorized")
  expect(pollStatus(undefined, "pending", now)).toBe("expired")
  let failed = try JSON.parse(JSON.stringify(f)) as UserFlow
  failed.status = "failed"
  expect(pollStatus(failed, "authorized", now + 3600000.0)).toBe("failed")
  let live = try JSON.parse(JSON.stringify(f)) as UserFlow
  live.status = "pending"
  expect(pollStatus(live, "authorized", now)).toBe("pending")
  expect(pollStatus(live, "authorized", live.expires_at + 1.0)).toBe("expired")
  cleanupFile(s.path)
})

test("a per-user client lists the credential it keeps for its tools, without values", () => {
  const h: Map<string, string> = new Map()
  h.set("X-Tenant", "tenant-a-key-example")
  const hc: McpClientConfig = { name: "t", connection_type: "http", auth_type: "per_user_headers", per_user_header_keys: ["x-tenant"], headers: h }
  const ok = ownCredential(hc, 1.0)
  expect(ok.json).toBe(`{"kind":"headers","status":"active","has_refresh_token":false,"header_keys":["x-tenant"]}`)
  expect(ok.reauth).toBe(false)
  let more = hc
  more.per_user_header_keys = ["x-tenant", "x-region"]
  const stale = ownCredential(more, 1.0)
  expect(stale.json.includes("needs_update")).toBe(true)
  expect(stale.reauth).toBe(true)
  const none: McpClientConfig = { name: "u", connection_type: "http", auth_type: "per_user_headers", per_user_header_keys: ["x-tenant"] }
  expect(ownCredential(none, 1.0).json).toBe("")
  const po: McpClientConfig = { name: "po", connection_type: "http", auth_type: "per_user_oauth", auth: { type: "oauth", access_token: "at-example", refresh_token: "rt-example", token_expires_at: 2000.0 } }
  const live = ownCredential(po, 1000.0)
  expect(live.json.includes(`"kind":"oauth"`) && live.json.includes(`"has_refresh_token":true`) && !live.json.includes("at-example")).toBe(true)
  const dead: McpClientConfig = { name: "po", connection_type: "http", auth_type: "per_user_oauth", auth: { type: "oauth", access_token: "at-example", token_expires_at: 2000.0 } }
  expect(ownCredential(dead, 3000.0).reauth).toBe(true)
})

test("a token_exchange client is refused while dual_credential_conflict_behavior is error", () => {
  const s = fixture()
  const errMode: ClientConfig = { dual_credential_conflict_behavior: "error" }
  s.cfg.client = errMode
  const body = "{\"name\":\"jira\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"token_exchange\",\"token_exchange\":{\"audience\":\"api://jira\",\"client_id\":\"exch\"}}"
  const refused = mcpApi(s, "POST", "/api/mcp/client", body)!
  expect(refused.status).toBe(400)
  expect(refused.body.includes("dual_credential_conflict_behavior is 'error'")).toBe(true)
  // an existing client cannot be switched to token_exchange either
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"auth_type\":\"token_exchange\",\"token_exchange\":{\"audience\":\"api://jira\",\"client_id\":\"exch\"}}")!.body.includes("dual_credential")).toBe(true)
  const vkMode: ClientConfig = { dual_credential_conflict_behavior: "prefer_vk" }
  s.cfg.client = vkMode
  expect(mcpApi(s, "POST", "/api/mcp/client", body)!.status).toBe(201)
  expect(dualConflictError("token_exchange", { client: { dual_credential_conflict_behavior: "error" } }).includes("prefer_idp")).toBe(true)
  expect(dualConflictError("per_user_oauth", { client: { dual_credential_conflict_behavior: "error" } })).toBe("")
  cleanupFile(s.path)
})

test("virtual MCPs: data access scope, the granting profiles and the profile-held key rule", () => {
  const c: Config = {
    governance: {
      virtual_keys: [{ id: "vk1", value: "sk-bf-1", team_id: "t1" }, { id: "vk2", value: "sk-bf-2", team_id: "t2" }, { id: "vk3", value: "sk-bf-3", user_id: "ann", access_profile_ids: ["p1"] }],
      users: [{ name: "ann", role: "viewer", access_profile_ids: ["p1"] }, { name: "bo", role: "viewer" }],
      access_profiles: [{ id: "p1", name: "Base", virtual_mcps: ["dev"] }, { id: "p2", virtual_mcps: ["ops"] }],
    },
  }
  const none: vmcp.VirtualTool[] = []
  c.virtual_mcps = [{ name: "dev", tools: none, allowed_keys: ["vk1"] }, { name: "ops", tools: none, allowed_keys: ["vk2"] }, { name: "open", tools: none }]
  const s = new ConfigStore(tmpPath(), c)
  const t1: DataScope = { all: false, teams: ["t1"], businessUnits: [], customers: [], projects: [] }
  const list = mcpApi(s, "GET", "/api/mcp/virtual-mcps", "", false, t1)!.body
  expect(list.includes(`"name":"dev"`)).toBe(true)
  expect(list.includes(`"name":"open"`)).toBe(true)
  expect(list.includes(`"name":"ops"`)).toBe(false)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/ops", "", false, t1)!.status).toBe(404)
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/ops", "", false, t1)!.status).toBe(404)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/ops", "")!.status).toBe(200)
  const rev = mcpApi(s, "GET", "/api/mcp/virtual-mcps/dev/access-profiles", "")!
  expect(rev.status).toBe(200)
  expect(rev.body).toBe(`{"access_profiles":[{"id":"p1","name":"Base","is_active":true,"user_count":1}]}`)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/open/access-profiles", "")!.body).toBe(`{"access_profiles":[]}`)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/none/access-profiles", "")!.status).toBe(404)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/vk3", "")!.status).toBe(409)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/vk2", "")!.status).toBe(200)
})
