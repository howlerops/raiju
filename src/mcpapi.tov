// Bifrost's MCP management API: /api/mcp/clients, /api/mcp/client and /api/mcp/virtual-mcps.
// Client configs live in cfg.mcp.client_configs and virtual MCPs in cfg.virtual_mcps, so each
// write edits the config, saves it and hands it to the lead through onChange, as ConfigStore
// does for its own writes. A client's id is its name (its tools are served as "<name>-<tool>"),
// and a virtual MCP's id is its name too. Secrets are masked on every read, and a masked value
// sent back unchanged keeps the stored secret. Reconnect and refresh need the live manager, so
// they come back as an action for the lead to run on it.
import { readFileSync, unlinkSync } from "node:fs"
import { Config, ClientConfig } from "./config"
import { ConfigStore, maskSecret, randomId } from "./store"
import { McpAuthConfig, AuthEndpoints, discoveryUrls, registrationRequest, registrationResult, parseAuthEndpoints, codeTokenRequest, authorizeUrl, pkceVerifier, pkceChallenge, tokenFields } from "./mcpauth"
import { deadline } from "./deadline"
import { rfc3339Of } from "./vkexpiry"
import { secureHex } from "./crypto"
import { McpClientConfig, McpConfig, McpTlsConfig, McpUserCredential, McpHeaderFlow, McpSession, sanitizeName, durationMsOf, userHeadersOf } from "./mcp"
import { McpTokenExchange, IdpEndpoints, exchangeToken, adminCredential, needsReverify } from "./tokenexchange"
import { McpUserToken, UserFlow, userFlowById, userFlowsLive, takeUserFlow, forgetUserFlows, dropUserFlow, startUserFlow, startAdminFlow, adminFlowById, adminFlowsOf, failAdminFlow, endAdminFlow, peekFlow, mayOpenFlow, mintTempToken, endTempTokens, headersLink, exchangeUserCode, rowFromTokens, upsertUserRow, dropUserRow, userTokenIndex, tokenAction, flowIdOfPath, consentLink } from "./mcpuser"
import { OpenApiConfig, OpenApiCred, OpenApiDoc, OpenApiOp, OpScheme, Unsupported, parseSpec, inputSchema, previewJson, baseUrlOf, operationServersCover } from "./openapi"
import { resolvedTargetProblem } from "./netguard"
import * as vmcp from "./vmcp"
import { DataScope, inScope } from "./scope"
import { heldProfiles } from "./govapi"
import { Field, fields, elements, find, quote, rawStr, rawNum, rawBool, setField, build } from "./json"

// The reply. action asks the lead to run a step on the live manager after sending body:
// "reconnect" or "refresh" for the client named by id. For a refresh the lead answers with
// the tool count itself.
export type McpReply = { status: int, body: string, action?: "reconnect" | "refresh", id?: string, contentType?: string }

type ClientBody = {
  name?: string,
  connection_type?: string,
  connection_string?: string,
  auth_type?: string,
  headers?: Map<string, string>,
  auth?: McpAuthConfig,
  stdio_config?: { command: string, args?: string[], env?: Map<string, string>, cwd?: string },
  tools_to_execute?: string[],
  tools_to_skip?: string[],
  tools_to_auto_execute?: string[],
  allow_by_default?: bool,
  allow_on_all_virtual_keys?: bool,
  disabled?: bool,
  tool_sync_interval?: string,
  tls_config?: McpTlsConfig,
  is_ping_available?: bool,
  needs_session_stickiness?: bool,
  allowed_extra_headers?: string[],
  openapi_config?: OpenApiConfig,
  per_user_header_keys?: string[],
  is_code_mode_client?: bool,
  token_exchange?: McpTokenExchange,
  max_instructions_length?: int,
}

// A tool in a virtual MCP's tools: Bifrost's {mcp_client_id, tool_names} or Raiju's native form.
type ToolBody = { mcp_client_id?: string, tool_names?: string[], source?: string, as?: string, description?: string, defaults?: string }

type VmcpBody = { name?: string, endpoint_slug?: string, description?: string, enabled?: bool }

// The JSON kind each body field must have: s string, b bool, a array, o object.
const CLIENT_KINDS: string[] = ["name:s", "connection_type:s", "connection_string:s", "auth_type:s", "headers:o", "auth:o", "stdio_config:o", "tools_to_execute:a", "tools_to_skip:a", "tools_to_auto_execute:a", "allow_by_default:b", "allow_on_all_virtual_keys:b", "disabled:b", "tool_sync_interval:s", "tls_config:o", "is_ping_available:b", "needs_session_stickiness:b", "allowed_extra_headers:a", "tool_pricing:o", "openapi_config:o", "per_user_header_keys:a", "is_code_mode_client:b", "token_exchange:o", "max_instructions_length:n"]
const VMCP_KINDS: string[] = ["name:s", "endpoint_slug:s", "description:s", "enabled:b", "tools:a"]
const TOOL_KINDS: string[] = ["mcp_client_id:s", "tool_names:a", "source:s", "as:s", "description:s", "defaults:s"]
const CONNECT_MS = 15000
// a spec_url fetched for a caller (Bifrost's openAPISpecFetchTimeout)
const SPEC_FETCH_MS = 15000
const VERIFY_ROUTES: string[] =["complete-oauth", "initiate-verification", "reauthorize", "reregister", "verify-headers", "verify-exchange"]

function reply(status: int, body: string): McpReply {
  return { status: status, body: body }
}

function errorBody(message: string): string {
  return JSON.stringify({ error: { message: message } })
}

function fail(status: int, message: string): McpReply {
  return reply(status, errorBody(message))
}

function notAllowed(method: string): McpReply {
  return fail(405, `method ${method} is not allowed on this route`)
}

// The fields of a JSON object given as text, or undefined when the text is not one.
function objectFields(text: string): Field[] | undefined {
  const t = text.trim()
  if (!t.startsWith("{")) return undefined
  try {
    if (elements(`[${t}]`).length !== 1) return undefined
    return fields(t)
  } catch (e) {
    return undefined
  }
}

// Whether a field is present and not null.
function has(fs: Field[], key: string): bool {
  const r = find(fs, key)
  return r !== undefined && r !== "null"
}

// The value when the field is present, else undefined: a JSON null counts as absent.
function present<T>(fs: Field[], key: string, v: T | undefined): T | undefined {
  return has(fs, key) ? v : undefined
}

// Whether a field, when present and not null, has the JSON kind named by kind.
function kindOk(fs: Field[], key: string, kind: string): bool {
  const r = find(fs, key)
  if (r === undefined || r === "null") return true
  if (kind === "s") return r.startsWith("\"")
  if (kind === "b") return r === "true" || r === "false"
  if (kind === "a") return r.startsWith("[")
  if (kind === "n") return "-0123456789".includes(r.slice(0, 1))
  return r.startsWith("{")
}

function kindsOk(fs: Field[], spec: string[]): bool {
  for (const s of spec) {
    const parts = s.split(":")
    if (!kindOk(fs, parts[0]!, parts[1]!)) return false
  }
  return true
}

// Whether a raw array holds only strings, and a raw object only string values.
function strArrayOk(raw: string | undefined): bool {
  if (raw === undefined || raw === "null") return true
  if (!raw.startsWith("[")) return false
  try {
    for (const el of elements(raw)) {
      if (!el.startsWith("\"")) return false
    }
    return true
  } catch (e) {
    return false
  }
}

function strMapOk(raw: string | undefined): bool {
  if (raw === undefined || raw === "null") return true
  const fs = objectFields(raw)
  if (fs === undefined) return false
  for (const f of fs) {
    if (!f.raw.startsWith("\"")) return false
  }
  return true
}

// The request body's fields when the body is a JSON object of the right kinds, else undefined.
function checkedFields(body: string, spec: string[]): Field[] | undefined {
  const fs = objectFields(body)
  if (fs === undefined || !kindsOk(fs, spec)) return undefined
  return fs
}

function clientsOf(c: Config): McpClientConfig[] {
  const m = c.mcp
  if (m === undefined || m.client_configs === undefined) return []
  return m.client_configs
}

function virtualsOf(c: Config): vmcp.VirtualMcp[] {
  return c.virtual_mcps ?? []
}

function clientIndex(list: McpClientConfig[], name: string): int {
  for (let i = 0; i < list.length; i++) {
    if (list[i]!.name === name) return i
  }
  return -1
}

function virtualIndex(list: vmcp.VirtualMcp[], name: string): int {
  for (let i = 0; i < list.length; i++) {
    if (list[i]!.name === name) return i
  }
  return -1
}

function virtualKeyIds(c: Config): string[] {
  const out: string[] = []
  for (const vk of c.governance?.virtual_keys ?? []) out.push(vk.id)
  return out
}

// Writes next as the config and notifies the lead, as ConfigStore does. A failed save keeps
// the previous config, so memory never differs from the file.
function persist(store: ConfigStore, next: Config): McpReply | undefined {
  const prev = store.cfg
  store.cfg = next
  try {
    store.save()
  } catch (e) {
    store.cfg = prev
    return fail(500, `could not save config: ${e.message}`)
  }
  store.version += 1
  const f = store.onChange
  // the store's copy, as saving left it: a save may have kept a newer retained credential from the file
  if (f !== undefined) f(store.cfg)
  return undefined
}

function withClients(c: Config, list: McpClientConfig[]): Config {
  let n = c
  let m: McpConfig = n.mcp ?? {}
  m.client_configs = list
  n.mcp = m
  return n
}

function withVirtuals(c: Config, list: vmcp.VirtualMcp[]): Config {
  let n = c
  n.virtual_mcps = list
  return n
}

// ---- secrets ----

function maskMap(m: Map<string, string> | undefined): Map<string, string> | undefined {
  if (m === undefined) return undefined
  const out: Map<string, string> = new Map()
  for (const k of m.keys()) out.set(k, maskSecret(m.get(k)!))
  return out
}

function maskOpt(v: string | undefined): string | undefined {
  return v === undefined ? undefined : maskSecret(v)
}

// A masked value sent back unchanged keeps the stored one (prev, when there is one).
function keepStr(v: string, prev: string | undefined): string {
  if (prev !== undefined && v === maskSecret(prev)) return prev
  return v
}

function keepOpt(v: string | undefined, prev: string | undefined): string | undefined {
  if (v === undefined) return undefined
  return keepStr(v, prev)
}

function keepMap(incoming: Map<string, string> | undefined, old: Map<string, string> | undefined): Map<string, string> | undefined {
  if (incoming === undefined) return undefined
  const out: Map<string, string> = new Map()
  for (const k of incoming.keys()) {
    const prev: string | undefined = old === undefined ? undefined : old.get(k)
    out.set(k, keepStr(incoming.get(k)!, prev))
  }
  return out
}

function keepAuth(incoming: McpAuthConfig, old: McpAuthConfig | undefined): McpAuthConfig {
  let n = incoming
  const oh: Map<string, string> | undefined = old === undefined ? undefined : old.headers
  n.headers = keepMap(n.headers, oh)
  n.token = keepOpt(n.token, old === undefined ? undefined : old.token)
  n.client_secret = keepOpt(n.client_secret, old === undefined ? undefined : old.client_secret)
  n.refresh_token = keepOpt(n.refresh_token, old === undefined ? undefined : old.refresh_token)
  n.access_token = keepOpt(n.access_token, old === undefined ? undefined : old.access_token)
  // an authorization code client keeps what its flow saved (endpoints, the registered client, tokens) unless the body sends a value
  if (n.type === "oauth" && old !== undefined && old.type === "oauth") {
    n.authorize_url = n.authorize_url ?? old.authorize_url
    n.token_url = n.token_url ?? old.token_url
    n.registration_url = n.registration_url ?? old.registration_url
    n.client_id = n.client_id ?? old.client_id
    n.client_secret = n.client_secret ?? old.client_secret
    n.access_token = n.access_token ?? old.access_token
    n.refresh_token = n.refresh_token ?? old.refresh_token
    n.token_expires_at = n.token_expires_at ?? old.token_expires_at
  }
  return n
}

// A client with its secrets masked: header values, auth secrets and stdio env values.
function redactClient(c: McpClientConfig): McpClientConfig {
  let n = c
  n.headers = maskMap(n.headers)
  const a = n.auth
  if (a !== undefined) {
    let na = a
    na.headers = maskMap(na.headers)
    na.token = maskOpt(na.token)
    na.client_secret = maskOpt(na.client_secret)
    na.refresh_token = maskOpt(na.refresh_token)
    na.access_token = maskOpt(na.access_token)
    n.auth = na
  }
  const sc = n.stdio_config
  if (sc !== undefined) {
    let ns = sc
    ns.env = maskMap(ns.env)
    n.stdio_config = ns
  }
  const te = n.token_exchange
  if (te !== undefined) {
    let nt = te
    nt.client_secret = maskOpt(nt.client_secret)
    n.token_exchange = nt
  }
  const oc = n.openapi_config
  if (oc !== undefined) {
    let no = oc
    no.security_credentials = maskCreds(no.security_credentials)
    n.openapi_config = no
  }
  return n
}

// The security credentials of an openapi client with their secrets masked.
function maskCreds(m: Map<string, OpenApiCred> | undefined): Map<string, OpenApiCred> | undefined {
  if (m === undefined) return undefined
  const out: Map<string, OpenApiCred> = new Map()
  for (const k of m.keys()) {
    const c = m.get(k)!
    out.set(k, { value: maskOpt(c.value), username: c.username, password: maskOpt(c.password) })
  }
  return out
}

// An openapi_config update: a masked secret sent back unchanged keeps the stored one.
function keepOpenApi(incoming: OpenApiConfig | undefined, old: OpenApiConfig | undefined): OpenApiConfig | undefined {
  if (incoming === undefined) return undefined
  let n = incoming
  // the fields an update leaves out keep their stored values
  if (old !== undefined) {
    if ((n.spec ?? "") === "" && (n.spec_url ?? "") === "") {
      n.spec = old.spec
      n.spec_url = old.spec_url
    }
    if (n.base_url === undefined) n.base_url = old.base_url
    if (n.include_deprecated === undefined) n.include_deprecated = old.include_deprecated
    if (n.max_response_bytes === undefined) n.max_response_bytes = old.max_response_bytes
    if (n.security_credentials === undefined) n.security_credentials = old.security_credentials
  }
  const oldCreds = old === undefined ? undefined : old.security_credentials
  if (n.security_credentials !== undefined) {
    const out: Map<string, OpenApiCred> = new Map()
    for (const k of n.security_credentials.keys()) {
      const c = n.security_credentials.get(k)!
      const prev = oldCreds === undefined ? undefined : oldCreds.get(k)
      const value = keepOpt(c.value, prev === undefined ? undefined : prev.value)
      const password = keepOpt(c.password, prev === undefined ? undefined : prev.password)
      out.set(k, { value: value, username: c.username, password: password })
    }
    n.security_credentials = out
  }
  return n
}

// One client's JSON: its stored fields, secrets masked, with client_id (its name) first.
function clientJson(c: McpClientConfig): string {
  const j = JSON.stringify(redactClient(c))
  return `{"client_id":${quote(c.name)},${j.slice(1)}`
}

// ---- clients ----

// Bifrost's name rules for a client: ASCII, no hyphens or spaces, not starting with a digit.
function clientNameError(name: string): string {
  if (name.trim() === "") return "name is required for MCP client"
  // every ASCII character is one byte, so any longer byte count means a non-ASCII one
  if (name.byteLength !== name.chars().length) return "name must contain only ASCII characters"
  if (name.includes("-")) return "name cannot contain hyphens"
  if (name.includes(" ")) return "name cannot contain spaces"
  if ("0123456789".includes(name.slice(0, 1))) return "name cannot start with a number"
  return ""
}

const AUTH_TYPES: string[] = ["none", "bearer", "headers", "oauth_client_credentials", "oauth_refresh_token", "oauth"]

// The auth object must have a type this gateway knows. "" when fine or absent.
function authError(a: McpAuthConfig | undefined): string {
  if (a === undefined) return ""
  if (!AUTH_TYPES.includes(a.type)) return `auth.type "${a.type}" must be one of ${AUTH_TYPES.join(", ")}`
  return ""
}

// The connection fields a new client needs for its transport. "" when fine.
function connectionError(b: ClientBody, ct: string): string {
  if (ct === "openapi") {
    const oc = b.openapi_config
    if (oc === undefined || ((oc.spec ?? "") === "" && (oc.spec_url ?? "") === "")) return "openapi_config requires spec (inline document) or spec_url"
    if ((b.connection_string ?? "") !== "") return "connection_string must not be set for openapi connections"
    return ""
  }
  if (ct === "stdio") {
    if ((b.stdio_config?.command ?? "") === "") return "stdio_config.command is required for stdio connections"
    if ((b.connection_string ?? "") !== "") return "connection_string must not be set for stdio connections"
    return ""
  }
  const url = b.connection_string ?? ""
  if (url === "") return "connection_string is required for http and sse connections"
  if (!url.startsWith("http://") && !url.startsWith("https://")) return "connection_string must be an http or https URL"
  return ""
}

// A Go duration in whole seconds, as Bifrost takes tool_sync_interval: "0", "90s", "10m", "1h30m".
function durationError(s: string): string {
  const bad = "tool_sync_interval must be 0 or a positive duration in whole seconds, such as \"10m\" or \"90s\""
  if (s === "0") return ""
  let digits = ""
  let last: int = 0
  for (const ch of s.chars()) {
    if ("0123456789".includes(ch)) {
      digits += ch
      continue
    }
    const rank: int = ch === "h" ? 1 : ch === "m" ? 2 : ch === "s" ? 3 : 0
    if (rank === 0 || digits === "" || rank <= last) return bad
    last = rank
    digits = ""
  }
  if (digits !== "" || last === 0) return bad
  return ""
}

// The allow flag: allow_by_default decides, else the older allow_on_all_virtual_keys, else existing.
function allowFlag(fs: Field[], b: ClientBody, existing: bool): bool {
  if (has(fs, "allow_by_default")) return b.allow_by_default ?? existing
  if (has(fs, "allow_on_all_virtual_keys")) return b.allow_on_all_virtual_keys ?? existing
  return existing
}

// The body with every optional field that is null treated as absent.
function clientFields(fs: Field[], b: ClientBody): ClientBody {
  let n = b
  n.name = present(fs, "name", n.name)
  n.connection_type = present(fs, "connection_type", n.connection_type)
  n.connection_string = present(fs, "connection_string", n.connection_string)
  n.auth_type = present(fs, "auth_type", n.auth_type)
  n.headers = present(fs, "headers", n.headers)
  n.auth = present(fs, "auth", n.auth)
  n.stdio_config = present(fs, "stdio_config", n.stdio_config)
  n.tools_to_execute = present(fs, "tools_to_execute", n.tools_to_execute)
  n.tools_to_skip = present(fs, "tools_to_skip", n.tools_to_skip)
  n.tools_to_auto_execute = present(fs, "tools_to_auto_execute", n.tools_to_auto_execute)
  n.allow_by_default = present(fs, "allow_by_default", n.allow_by_default)
  n.allow_on_all_virtual_keys = present(fs, "allow_on_all_virtual_keys", n.allow_on_all_virtual_keys)
  n.disabled = present(fs, "disabled", n.disabled)
  n.tool_sync_interval = present(fs, "tool_sync_interval", n.tool_sync_interval)
  n.tls_config = present(fs, "tls_config", n.tls_config)
  n.is_ping_available = present(fs, "is_ping_available", n.is_ping_available)
  n.needs_session_stickiness = present(fs, "needs_session_stickiness", n.needs_session_stickiness)
  n.allowed_extra_headers = present(fs, "allowed_extra_headers", n.allowed_extra_headers)
  n.openapi_config = present(fs, "openapi_config", n.openapi_config)
  n.per_user_header_keys = present(fs, "per_user_header_keys", n.per_user_header_keys)
  n.is_code_mode_client = present(fs, "is_code_mode_client", n.is_code_mode_client)
  n.max_instructions_length = present(fs, "max_instructions_length", n.max_instructions_length)
  return n
}

// tool_execution_timeout: a Go duration string, or a bare number of seconds (Bifrost takes both).
// The stored form is always a duration string. error is "" when fine or absent.
function timeoutFrom(fs: Field[]): { value: string | undefined, error: string } {
  const raw = find(fs, "tool_execution_timeout")
  if (raw === undefined || raw === "null") return { value: undefined, error: "" }
  const bad = "tool_execution_timeout must be a duration such as \"30s\" or \"2m\", or a number of seconds"
  if (!raw.startsWith("\"")) {
    const n = rawNum(fs, "tool_execution_timeout") ?? 0.0
    if (n <= 0.0) return { value: undefined, error: bad }
    return { value: `${Math.floor(n)}s`, error: "" }
  }
  const s = rawStr(fs, "tool_execution_timeout") ?? ""
  if (durationMsOf(s) <= 0) return { value: undefined, error: bad }
  return { value: s, error: "" }
}

// tool_pricing: an object of costs per tool, each at least 0. error is "" when fine or absent.
function pricingFrom(fs: Field[]): { value: Map<string, f64> | undefined, error: string } {
  const raw = find(fs, "tool_pricing")
  if (raw === undefined || raw === "null") return { value: undefined, error: "" }
  const inner = objectFields(raw)
  if (inner === undefined) return { value: undefined, error: "tool_pricing must be an object of costs per tool" }
  const out: Map<string, f64> = new Map()
  for (const f of inner) {
    const n = parseFloat(f.raw)
    if (n === undefined || n < 0.0) return { value: undefined, error: `tool_pricing "${f.key}" must be a number of at least 0` }
    out.set(f.key, n)
  }
  return { value: out, error: "" }
}

function listClients(store: ConfigStore): McpReply {
  const list = clientsOf(store.cfg)
  const parts: string[] = []
  for (const c of list) {
    const j = clientJson(c)
    // a token_exchange client's retained admin credential, as Bifrost lists it (state and expiry, no token)
    let row: McpUserToken | undefined = undefined
    if (c.auth_type === "token_exchange") {
      for (const r of store.cfg.mcp?.exchange_admin ?? []) {
        if (r.mcp_client_name === c.name) row = r
      }
    }
    if (row !== undefined) {
      const cred = adminCredential(row)
      const state = needsReverify(row) ? `,"state":"needs_reauth"` : ""
      parts.push(`${j.slice(0, j.byteLength - 1)},"credential":${JSON.stringify(cred)}${state}}`)
      continue
    }
    const own = ownCredential(c, Date.now())
    if (own.json === "") parts.push(j)
    else parts.push(`${j.slice(0, j.byteLength - 1)},"credential":${own.json}${own.reauth ? `,"state":"needs_reauth"` : ""}}`)
  }
  return reply(200, `{"clients":[${parts.join(",")}],"count":${list.length},"total_count":${list.length}}`)
}

// The credential a per-user client holds on its own behalf to list its tools, as Bifrost's credential block shows it
// (no secret values): a per_user_headers client's admin sample (kind headers, its header names; needs_update when a
// declared header has no sample value, which puts the client in needs_reauth), and a per_user_oauth client's token from
// the admin's verification (kind oauth, its expiry and whether it can be refreshed). json is "" when there is none.
export function ownCredential(c: McpClientConfig, nowMs: f64): { json: string, reauth: bool } {
  if (c.auth_type === "per_user_headers") {
    const names: string[] = []
    const hs = c.headers
    if (hs !== undefined) {
      for (const k of hs.keys()) names.push(k.trim().toLowerCase())
    }
    if (names.length === 0) return { json: "", reauth: false }
    names.sort()
    let missing = false
    for (const k of c.per_user_header_keys ?? []) {
      if (!names.includes(k)) missing = true
    }
    const st = missing ? "needs_update" : "active"
    return { json: `{"kind":"headers","status":"${st}","has_refresh_token":false,"header_keys":${JSON.stringify(names)}}`, reauth: missing }
  }
  const a = c.auth
  if (c.auth_type === "per_user_oauth" && a !== undefined && a.type === "oauth" && authorized(a)) {
    const refresh = (a.refresh_token ?? "") !== ""
    const exp = a.token_expires_at ?? 0.0
    // a token past its expiry with nothing to renew it needs the admin's verification again
    const dead = !refresh && exp > 0.0 && exp <= nowMs
    const st = dead ? "needs_reauth" : "active"
    const expires = exp > 0.0 ? `,"expires_at":${quote(rfc3339Of(exp))}` : ""
    return { json: `{"kind":"oauth","status":"${st}"${expires},"has_refresh_token":${refresh}}`, reauth: dead }
  }
  return { json: "", reauth: false }
}

function createClient(store: ConfigStore, body: string, publicOnly: bool): McpReply {
  const fs = checkedFields(body, CLIENT_KINDS)
  if (fs === undefined || !strArrayOk(find(fs, "tools_to_execute")) || !strArrayOk(find(fs, "tools_to_skip")) || !strArrayOk(find(fs, "tools_to_auto_execute")) || !strArrayOk(find(fs, "allowed_extra_headers")) || !strMapOk(find(fs, "headers"))) {
    return fail(400, "Invalid request payload")
  }
  let parsed: ClientBody = {}
  try {
    parsed = JSON.parse(body) as ClientBody
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const b = clientFields(fs, parsed)
  const name = b.name ?? ""
  const nameProblem = clientNameError(name)
  if (nameProblem !== "") return fail(400, `Invalid client name: ${nameProblem}`)
  const list = clientsOf(store.cfg)
  if (clientIndex(list, name) >= 0 || virtualIndex(virtualsOf(store.cfg), name) >= 0) {
    return fail(409, "an MCP client or virtual MCP with this name already exists")
  }
  const ct = b.connection_type ?? ""
  if (ct !== "http" && ct !== "sse" && ct !== "stdio" && ct !== "openapi") return fail(400, `Invalid connection_type "${ct}": must be one of http, sse, stdio, openapi`)
  // the document is checked now (a spec_url was fetched and inlined before this, see inlineSpecUrl)
  let openapiCfg: OpenApiConfig | undefined = undefined
  if ((b.openapi_config?.spec_file ?? "").trim() !== "") return fail(400, "openapi_config.spec_file is only supported in config.json; send the document as spec or spec_url")
  if (ct === "openapi" && b.openapi_config !== undefined && (b.openapi_config.spec ?? "") !== "") {
    const oc = openapiChecked(name, b.openapi_config, b.tools_to_execute, b.tools_to_auto_execute)
    if (oc.error !== undefined) return oc.error
    openapiCfg = oc.config
  }
  const auth = b.auth_type ?? "none"
  const pue = perUserError(auth, ct, b.auth?.type ?? "", b.per_user_header_keys)
  if (pue !== "") return fail(400, pue)
  const tee = exchangeError(auth, ct, b.auth?.type ?? "", b.token_exchange)
  if (tee !== "") return fail(400, tee)
  const dce = dualConflictError(auth, store.cfg)
  if (dce !== "") return fail(400, dce)
  const cp = connectionError(b, ct)
  if (cp !== "") return fail(400, cp)
  const ae = authError(b.auth)
  if (ae !== "") return fail(400, ae)
  const syncErr = durationError(b.tool_sync_interval ?? "0")
  if (syncErr !== "") return fail(400, syncErr)
  const to = timeoutFrom(fs)
  if (to.error !== "") return fail(400, to.error)
  const pr = pricingFrom(fs)
  if (pr.error !== "") return fail(400, pr.error)
  if ((b.max_instructions_length ?? 0) < 0) return fail(400, "max_instructions_length must not be negative")
  // Bifrost: a new http client connects fresh for each call unless it says it needs a session
  const sticky = rawBool(fs, "needs_session_stickiness")
  if (ct !== "http" && sticky === false) return fail(400, "needs_session_stickiness false applies only to http connections: sse and stdio stay sticky")

  let c: McpClientConfig = { name: name, connection_type: ct }
  if (ct === "openapi") c.openapi_config = openapiCfg ?? b.openapi_config
  c.tool_execution_timeout = to.value
  c.is_ping_available = b.is_ping_available ?? true
  c.is_code_mode_client = b.is_code_mode_client
  c.max_instructions_length = (b.max_instructions_length ?? 0) > 0 ? b.max_instructions_length : undefined
  c.needs_session_stickiness = ct === "http" ? (sticky ?? false) : undefined
  c.allowed_extra_headers = b.allowed_extra_headers
  c.tool_pricing = pr.value
  // registered while dashboard auth is off: every dial must reach a public address
  c.require_public_target = publicOnly ? true : undefined
  if (ct === "http" || ct === "sse") c.connection_string = b.connection_string
  c.headers = b.headers
  c.auth = b.auth
  if (auth === "per_user_headers") {
    c.auth_type = auth
    c.per_user_header_keys = normalKeys(b.per_user_header_keys)
  }
  if (auth === "per_user_oauth") c.auth_type = auth
  if (auth === "token_exchange") {
    c.auth_type = auth
    c.token_exchange = b.token_exchange
  }
  c.stdio_config = b.stdio_config
  c.tools_to_execute = b.tools_to_execute
  c.tools_to_skip = b.tools_to_skip
  c.tools_to_auto_execute = b.tools_to_auto_execute
  c.allow_by_default = allowFlag(fs, b, false)
  c.disabled = b.disabled
  c.tool_sync_interval = b.tool_sync_interval
  c.tls_config = b.tls_config

  let next: McpClientConfig[] = list
  next.push(c)
  const err = persist(store, withClients(store.cfg, next))
  if (err !== undefined) return err
  return reply(201, clientJson(c))
}

function updateClient(store: ConfigStore, id: string, body: string, publicOnly: bool): McpReply {
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, "MCP client not found")
  const fs = checkedFields(body, CLIENT_KINDS)
  if (fs === undefined || !strArrayOk(find(fs, "tools_to_execute")) || !strArrayOk(find(fs, "tools_to_skip")) || !strArrayOk(find(fs, "tools_to_auto_execute")) || !strArrayOk(find(fs, "allowed_extra_headers")) || !strMapOk(find(fs, "headers"))) {
    return fail(400, "Invalid request payload")
  }
  let parsed: ClientBody = {}
  try {
    parsed = JSON.parse(body) as ClientBody
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const b = clientFields(fs, parsed)
  // The name is the id and the prefix of every tool name a virtual MCP uses, so it stays.
  if (b.name !== undefined && b.name !== id) return fail(400, "renaming an MCP client is not supported: its name prefixes its tools in virtual MCPs")
  if (has(fs, "tool_sync_interval")) {
    const syncErr = durationError(b.tool_sync_interval ?? "")
    if (syncErr !== "") return fail(400, syncErr)
  }
  const ae = authError(b.auth)
  if (ae !== "") return fail(400, ae)

  const cur = list[at]!
  let c = cur
  if (has(fs, "tool_execution_timeout")) {
    const to = timeoutFrom(fs)
    if (to.error !== "") return fail(400, to.error)
    c.tool_execution_timeout = to.value
  }
  if (has(fs, "tool_pricing")) {
    const pr = pricingFrom(fs)
    if (pr.error !== "") return fail(400, pr.error)
    c.tool_pricing = pr.value
  }
  if (has(fs, "needs_session_stickiness")) {
    const sticky = rawBool(fs, "needs_session_stickiness")
    if ((c.connection_type ?? "") !== "http" && sticky === false) return fail(400, "needs_session_stickiness false applies only to http connections: sse and stdio stay sticky")
    c.needs_session_stickiness = sticky
  }
  if (has(fs, "openapi_config")) {
    if (c.connection_type !== "openapi") return fail(400, "openapi_config applies only to openapi connections")
    if ((b.openapi_config?.spec_file ?? "").trim() !== "") return fail(400, "openapi_config.spec_file is only supported in config.json; send the document as spec or spec_url")
    const merged = keepOpenApi(b.openapi_config, c.openapi_config)
    if (merged !== undefined && (merged.spec ?? "") !== "") {
      const oc = openapiChecked(c.name, merged, has(fs, "tools_to_execute") ? b.tools_to_execute : c.tools_to_execute, has(fs, "tools_to_auto_execute") ? b.tools_to_auto_execute : c.tools_to_auto_execute)
      if (oc.error !== undefined) return oc.error
      c.openapi_config = oc.config
    } else {
      c.openapi_config = merged
    }
  }
  if (has(fs, "is_ping_available")) c.is_ping_available = b.is_ping_available
  if (has(fs, "is_code_mode_client")) c.is_code_mode_client = b.is_code_mode_client
  if (has(fs, "max_instructions_length")) {
    if ((b.max_instructions_length ?? 0) < 0) return fail(400, "max_instructions_length must not be negative")
    c.max_instructions_length = (b.max_instructions_length ?? 0) > 0 ? b.max_instructions_length : undefined
  }
  if (has(fs, "allowed_extra_headers")) c.allowed_extra_headers = b.allowed_extra_headers
  // can be turned on, never off (Bifrost's require_public_target)
  if (publicOnly) c.require_public_target = true
  if (has(fs, "disabled")) c.disabled = b.disabled
  if (has(fs, "allow_by_default") || has(fs, "allow_on_all_virtual_keys")) c.allow_by_default = allowFlag(fs, b, c.allow_by_default ?? false)
  if (has(fs, "tools_to_execute")) c.tools_to_execute = b.tools_to_execute
  if (has(fs, "tools_to_skip")) c.tools_to_skip = b.tools_to_skip
  if (has(fs, "tools_to_auto_execute")) c.tools_to_auto_execute = b.tools_to_auto_execute
  if (has(fs, "tool_sync_interval")) c.tool_sync_interval = b.tool_sync_interval
  if (has(fs, "tls_config")) c.tls_config = b.tls_config
  if (has(fs, "headers")) c.headers = keepMap(b.headers, c.headers)
  if (has(fs, "auth")) c.auth = keepAuth(b.auth!, c.auth)
  if (has(fs, "auth_type") || has(fs, "per_user_header_keys")) {
    const t = b.auth_type ?? (c.auth_type ?? "none")
    const keys = has(fs, "per_user_header_keys") ? b.per_user_header_keys : c.per_user_header_keys
    const pue = perUserError(t, c.connection_type, c.auth?.type ?? "", keys)
    if (pue !== "") return fail(400, pue)
    const tte = exchangeError(t, c.connection_type, c.auth?.type ?? "", has(fs, "token_exchange") ? b.token_exchange : c.token_exchange)
    if (tte !== "") return fail(400, tte)
    if (list[at]!.auth_type !== "token_exchange") {
      const dce = dualConflictError(t, store.cfg)
      if (dce !== "") return fail(400, dce)
    }
    c.auth_type = t === "per_user_headers" || t === "per_user_oauth" || t === "token_exchange" ? t : undefined
    c.per_user_header_keys = t === "per_user_headers" ? normalKeys(keys) : undefined
    c.token_exchange = t === "token_exchange" ? (has(fs, "token_exchange") ? b.token_exchange : c.token_exchange) : undefined
  } else if (has(fs, "token_exchange") && c.auth_type === "token_exchange") {
    const tte = exchangeError("token_exchange", c.connection_type, c.auth?.type ?? "", b.token_exchange)
    if (tte !== "") return fail(400, tte)
    c.token_exchange = b.token_exchange
  }

  // a changed token exchange (its audience, client or identity provider) needs a new verification: the admin credential goes
  const exchangeChanged = JSON.stringify(list[at]!.token_exchange) !== JSON.stringify(c.token_exchange) || list[at]!.auth_type !== c.auth_type
  let next: McpClientConfig[] = list
  next[at] = c
  let cfgNext = withClients(store.cfg, next)
  if (exchangeChanged) {
    cfgNext = withExchangeAdmin(cfgNext, exchangeAdminWithout(store.cfg.mcp?.exchange_admin ?? [], c.name))
  }
  const err = persist(store, cfgNext)
  if (err !== undefined) return err
  if (exchangeChanged) noteAdminRemoved(c.name)
  return reply(200, clientJson(c))
}

function deleteClient(store: ConfigStore, id: string): McpReply {
  const list = clientsOf(store.cfg)
  if (clientIndex(list, id) < 0) return fail(404, "MCP client not found")
  let next: McpClientConfig[] = []
  for (const c of list) {
    if (c.name !== id) next.push(c)
  }
  const err = persist(store, withExchangeAdmin(withClients(store.cfg, next), exchangeAdminWithout(store.cfg.mcp?.exchange_admin ?? [], id)))
  if (err !== undefined) return err
  noteAdminRemoved(id)
  return reply(200, `{"status":"success","message":"MCP client removed successfully"}`)
}

// Reconnect and refresh are the manager's work: this checks the client, then hands the step over.
function runClient(store: ConfigStore, id: string, step: string): McpReply {
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, "MCP client not found")
  const c = list[at]!
  if (step === "reconnect") {
    if (c.disabled === true) return fail(400, "cannot reconnect a disabled MCP client: enable the client first")
    return { status: 200, body: `{"status":"success","message":"MCP client reconnected successfully"}`, action: "reconnect", id: id }
  }
  if (c.disabled === true) return fail(400, "cannot refresh tools for a disabled MCP client: enable the client first")
  return { status: 200, body: `{"status":"success","message":"MCP client tools refreshed successfully"}`, action: "refresh", id: id }
}

// The OpenAPI document of an openapi client, as it was stored (a spec_url sent over the API is fetched and
// stored with the client). A client from config.json that names only a spec_url fetches it when it connects.
function openapiSpec(store: ConfigStore, id: string): McpReply {
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, "OpenAPI MCP client not found")
  const c = list[at]!
  if (c.connection_type !== "openapi") return fail(404, "OpenAPI MCP client not found")
  const spec = c.openapi_config?.spec ?? ""
  if (spec.trim() === "") return fail(404, "This client has no stored spec (it is fetched from spec_url at connect time)")
  return { status: 200, body: spec, contentType: spec.trim().startsWith("{") ? "application/json; charset=utf-8" : "application/yaml; charset=utf-8" }
}

// Bifrost's prepareOpenAPIConfig for a document sent over the API: max_response_bytes not negative, a document
// that parses and yields at least one tool, a base URL (base_url or an absolute server, unless every operation
// names its own), tool lists that name tools the spec defines; the server-computed fields are filled in.
function openapiChecked(name: string, oc: OpenApiConfig, toolsToExecute: string[] | undefined, toolsToAuto: string[] | undefined): { error?: McpReply, config: OpenApiConfig } {
  let n = oc
  if ((n.max_response_bytes ?? 0) < 0) return { error: fail(400, "openapi_config.max_response_bytes must not be negative"), config: n }
  const text = n.spec ?? ""
  if (text.trim() === "") return { error: fail(400, "openapi_config requires spec (inline document) or spec_url"), config: n }
  let doc: OpenApiDoc | undefined = undefined
  try {
    doc = parseSpec(text, n.include_deprecated === true, n.spec_url ?? "", name)
  } catch (e) {
    return { error: fail(e.message.includes("exceeds") ? 413 : 400, `Invalid openapi_config.spec: ${e.message}`), config: n }
  }
  const d = doc!
  if (d.ops.length === 0) {
    const reasons = d.unsupported.map((u: Unsupported): string => `${u.method} ${u.path}: ${u.reason}`)
    return { error: fail(400, "No operation in the spec can be exposed as a tool: " + reasons.join("; ")), config: n }
  }
  const bu = (n.base_url ?? "").trim()
  n.base_url = bu === "" ? undefined : (bu.endsWith("/") ? bu.slice(0, bu.byteLength - 1) : bu)
  const b = baseUrlOf(d, n.base_url ?? "")
  if (b.base === "" && !operationServersCover(d)) return { error: fail(400, "The spec declares no absolute server URL; set openapi_config.base_url"), config: n }
  const names = d.ops.map((o: OpenApiOp): string => o.name)
  const ue = (toolsToExecute ?? []).filter((t) => t !== "*" && !names.includes(t))
  if (ue.length > 0) return { error: fail(400, `Invalid tools_to_execute: the spec defines no tool named ${ue.join(", ")}`), config: n }
  const ua = (toolsToAuto ?? []).filter((t) => t !== "*" && !names.includes(t))
  if (ua.length > 0) return { error: fail(400, `Invalid tools_to_auto_execute: the spec defines no tool named ${ua.join(", ")}`), config: n }
  n.spec_size = d.spec_size
  n.spec_hash = d.spec_hash
  n.spec_title = d.title
  n.openapi_version = d.openapi_version
  n.operation_count = d.ops.length
  return { config: n }
}

// Fetches a spec_url for the caller. With dashboard auth off only a public address may be fetched. error is
// set (with the status to answer) when it cannot be.
async function fetchSpec(url: string, publicOnly: bool): Promise<{ text: string, error?: McpReply }> {
  const u = url.trim()
  if (!u.startsWith("http://") && !u.startsWith("https://")) return { text: "", error: fail(400, `could not load spec_url: invalid spec_url: "${u}" must be an http(s) URL`) }
  if (publicOnly) {
    const pr = await resolvedTargetProblem(u, [])
    if (pr !== "") return { text: "", error: fail(403, pr) }
  }
  const dl = deadline(SPEC_FETCH_MS)
  try {
    const hs: Record<string, string> = new Map()
    hs.set("accept", "application/json, application/yaml, application/x-yaml, text/yaml, text/plain;q=0.9, */*;q=0.1")
    hs.set("user-agent", "Bifrost-OpenAPI-MCP/1.0")
    const r = await fetch(u, { headers: hs, signal: dl.controller.signal })
    if (r.status < 200 || r.status >= 300) return { text: "", error: fail(400, `could not load spec_url: fetching spec_url: upstream returned HTTP ${r.status}`) }
    const text = await r.text()
    if (text.byteLength > 5242880) return { text: "", error: fail(413, "could not load spec_url: openapi spec exceeds 5242880 bytes") }
    if (text.trim() === "") return { text: "", error: fail(400, "could not load spec_url: openapi spec is empty") }
    return { text: text }
  } catch (e) {
    const q = e.message.indexOf("?")
    return { text: "", error: fail(400, `could not load spec_url: fetching spec_url: ${q < 0 ? e.message : e.message.slice(0, q)}`) }
  } finally {
    dl.finish()
  }
}

// A create or update of an openapi client whose openapi_config names a spec_url and no spec: the document is
// fetched now and stored inline with the client (spec_url stays as its provenance), as Bifrost does. Any other
// request passes through unchanged; error is set when the fetch fails.
export async function inlineSpecUrl(method: string, path: string, body: string, publicOnly: bool): Promise<{ body: string, error?: McpReply }> {
  const q = path.indexOf("?")
  const pure = q < 0 ? path : path.slice(0, q)
  const create = method === "POST" && pure === "/api/mcp/client"
  const update = method === "PUT" && pure.startsWith("/api/mcp/client/") && pure.split("/").length === 5
  if (!create && !update) return { body: body }
  const fs = objectFields(body)
  if (fs === undefined) return { body: body }
  const ocRaw = find(fs, "openapi_config")
  if (ocRaw === undefined || !ocRaw.trim().startsWith("{")) return { body: body }
  let oc: Field[] = []
  try {
    oc = fields(ocRaw.trim())
  } catch (e) {
    return { body: body }
  }
  const url = rawStr(oc, "spec_url") ?? ""
  if ((rawStr(oc, "spec") ?? "").trim() !== "" || url.trim() === "") return { body: body }
  const got = await fetchSpec(url, publicOnly)
  const err = got.error
  if (err !== undefined) return { body: body, error: err }
  setField(&oc, "spec", quote(got.text))
  setField(&oc, "spec_url", quote(url.trim()))
  let out = fs
  setField(&out, "openapi_config", build(oc))
  return { body: build(out) }
}

function clientRoute(store: ConfigStore, m: string, segs: string[], body: string, p: string, publicOnly: bool): McpReply {
  if (segs.length === 3) return m === "POST" ? createClient(store, body, publicOnly) : notAllowed(m)
  const id = segs[3]!
  if (segs.length === 4) {
    if (m === "PUT") return updateClient(store, id, body, publicOnly)
    if (m === "DELETE") return deleteClient(store, id)
    return notAllowed(m)
  }
  if (segs.length !== 5) return fail(404, `no route for ${p}`)
  const sub = segs[4]!
  if (sub === "reconnect" || sub === "refresh-tools") {
    if (m !== "POST") return notAllowed(m)
    return runClient(store, id, sub === "reconnect" ? "reconnect" : "refresh")
  }
  // Bifrost's GET: no client here is an OpenAPI one, so none has a spec to return
  if (sub === "openapi-spec") return m === "GET" ? openapiSpec(store, id) : notAllowed(m)
  if (VERIFY_ROUTES.includes(sub)) return m === "POST" ? verifyRoute(store, id, sub) : notAllowed(m)
  return fail(404, `no route for ${p}`)
}

// The auth type a client is reported under in the verification messages: its auth type, else
// headers or none.
function clientAuthType(c: McpClientConfig): string {
  const t = c.auth?.type
  if (t !== undefined) return t
  return c.headers === undefined ? "none" : "headers"
}

// The verification and reauthorization routes. Bifrost answers each by the auth type of the client:
// OAuth consent (oauth, per_user_oauth), per-user headers and token exchange. Raiju's clients have
// none of those (its OAuth grants are client credentials and refresh tokens), and no OAuth config
// rows exist for complete-oauth to finish, so each route refuses with Bifrost's message.
function verifyRoute(store: ConfigStore, id: string, sub: string): McpReply {
  if (sub === "complete-oauth") return fail(404, "OAuth config not found")
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, `MCP client '${id}' not found`)
  const t = clientAuthType(list[at]!)
  if (sub === "initiate-verification") return fail(400, `initiate-verification only applies to OAuth-based clients (oauth, per_user_oauth), got "${t}"`)
  if (sub === "reauthorize" || sub === "reregister") return fail(400, `reauthorize only applies to OAuth-based clients (oauth, per_user_oauth), got "${t}"`)
  if (sub === "verify-headers") return fail(400, `verify-headers only applies to auth_type='per_user_headers' clients, got "${t}"`)
  return fail(400, `verify-exchange only applies to auth_type='token_exchange' clients, got "${t}"`)
}

// ---- per-user headers (auth_type per_user_headers) ----

// A submission flow stays open for half an hour, as Bifrost's does.
const HEADER_FLOW_TTL_MS: f64 = 1800000.0

// auth_type per_user_headers applies to http and sse clients with per_user_header_keys, and the client
// carries no auth object. "" when the combination is fine.
function perUserError(t: string, ct: string, authT: string, keys: string[] | undefined): string {
  if (t === "token_exchange") return ""
  if (t !== "none" && t !== "headers" && t !== "per_user_headers" && t !== "per_user_oauth") return `auth_type "${t}" is not supported by this gateway: use none, headers, per_user_headers or per_user_oauth`
  if (t === "per_user_oauth") {
    if (ct !== "http" && ct !== "sse") return "auth_type per_user_oauth applies to http and sse connections"
    if (authT !== "oauth") return "auth_type per_user_oauth needs an auth object of type oauth (the client's OAuth registration)"
    return ""
  }
  if (t !== "per_user_headers") return ""
  if (authT !== "") return "auth and auth_type per_user_headers cannot be set together"
  if (ct !== "http" && ct !== "sse") return "auth_type per_user_headers applies to http and sse connections"
  const ks = keys ?? []
  if (ks.length === 0) return "per_user_header_keys is required (non-empty) for per_user_headers auth type"
  for (const k of ks) {
    if (k.trim() === "") return "per_user_header_keys must not contain an empty name"
  }
  return ""
}

// A token_exchange client cannot be added while client.dual_credential_conflict_behavior is "error": that setting
// refuses the requests such a client relies on (Bifrost's mcp.go). "" when the pairing is fine.
export function dualConflictError(authType: string, c: Config): string {
  if (authType !== "token_exchange" || c.client?.dual_credential_conflict_behavior !== "error") return ""
  return "auth_type 'token_exchange' cannot be used while dual_credential_conflict_behavior is 'error': change it to 'prefer_idp' or 'prefer_vk' first"
}

// auth_type token_exchange applies to http and sse clients with a token_exchange block (its audience, and the
// exchange application's client_id unless use_idp_credentials), and no auth object. "" when the combination is fine.
function exchangeError(t: string, ct: string, authT: string, te: McpTokenExchange | undefined): string {
  if (t !== "token_exchange") return ""
  if (ct !== "http" && ct !== "sse") return "auth_type token_exchange applies to http and sse connections"
  if (authT !== "") return "auth and auth_type token_exchange cannot be set together"
  if (te === undefined) return "token_exchange is required for auth_type token_exchange"
  if ((te.audience ?? "").trim() === "") return "token_exchange.audience is required"
  if (te.use_idp_credentials !== true && (te.client_id ?? "").trim() === "") return "token_exchange.client_id is required unless use_idp_credentials is set"
  return ""
}

// The declared header names, trimmed, lowercased and without repeats.
function normalKeys(keys: string[] | undefined): string[] {
  const out: string[] = []
  for (const k of keys ?? []) {
    const lk = k.trim().toLowerCase()
    if (!out.includes(lk)) out.push(lk)
  }
  return out
}

// A header map with its names lowercased and trimmed, as the client's headers are matched.
function canonMap(m: Map<string, string> | undefined): Map<string, string> {
  const out: Map<string, string> = new Map()
  if (m === undefined) return out
  for (const k of m.keys()) out.set(k.trim().toLowerCase(), m.get(k)!)
  return out
}

function withHeaderState(c: Config, creds: McpUserCredential[], flows: McpHeaderFlow[]): Config {
  let n = c
  let m: McpConfig = n.mcp ?? {}
  m.user_credentials = creds
  m.header_flows = flows
  n.mcp = m
  return n
}

function flowIndex(list: McpHeaderFlow[], id: string): int {
  for (let i = 0; i < list.length; i++) {
    if (list[i]!.id === id) return i
  }
  return -1
}

function credentialIndex(list: McpUserCredential[], client: string, vk: string): int {
  for (let i = 0; i < list.length; i++) {
    if (list[i]!.mcp_client_name === client && list[i]!.virtual_key_id === vk) return i
  }
  return -1
}

// Connects to a per_user_headers client with these header values and reports the tools it lists, or why it
// could not connect. The client is a copy: nothing is saved here.
async function dialWith(cfg: McpClientConfig, headers: Map<string, string>, allow: string[], admin?: string): Promise<{ ok: bool, tools: int, error: string }> {
  let c = cfg
  c.headers = headers
  const s = new McpSession(c, CONNECT_MS, allow)
  // a token_exchange client connects with its admin credential; a verification passes the token it has just exchanged
  s.adminToken = admin ?? ""
  await s.connect()
  return { ok: s.connected, tools: s.tools.length, error: s.lastError }
}

// The header values of a submission, merged over the key's stored values, with the declared names only.
// missing names the declared headers that have no value.
function mergedValues(stored: Map<string, string> | undefined, given: Map<string, string>, keys: string[]): { values: Map<string, string>, missing: string[] } {
  const merged: Map<string, string> = new Map()
  const old = stored ?? new Map<string, string>()
  for (const k of old.keys()) merged.set(k, old.get(k)!)
  for (const k of given.keys()) merged.set(k, given.get(k)!)
  const values: Map<string, string> = new Map()
  const missing: string[] = []
  for (const k of keys) {
    if (merged.has(k)) values.set(k, merged.get(k)!)
    else missing.push(k)
  }
  return { values: values, missing: missing }
}

function dropExpired(list: McpHeaderFlow[], now: f64): McpHeaderFlow[] {
  const out: McpHeaderFlow[] = []
  for (const f of list) {
    if (f.expires_at > now) out.push(f)
  }
  return out
}

// POST /api/mcp/per-user-headers/flows: opens a submission for one virtual key and one per_user_headers
// client. A pending submission for the same pair is kept and its expiry renewed.
function createFlow(store: ConfigStore, body: string): McpReply {
  let parsed: { mcp_client_name?: string, virtual_key_id?: string } = {}
  try {
    parsed = JSON.parse(body) as { mcp_client_name?: string, virtual_key_id?: string }
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const cname = parsed.mcp_client_name ?? ""
  const vk = parsed.virtual_key_id ?? ""
  if (cname === "" || vk === "") return fail(400, "mcp_client_name and virtual_key_id are required")
  const cfg = store.cfg
  const clients = clientsOf(cfg)
  const ci = clientIndex(clients, cname)
  if (ci < 0) return fail(404, `MCP client '${cname}' not found`)
  if (clients[ci]!.auth_type !== "per_user_headers") return fail(400, `headers submissions only apply to auth_type='per_user_headers' clients, got "${clientAuthType(clients[ci]!)}"`)
  const vks = cfg.governance?.virtual_keys ?? []
  if (!vks.some((v) => v.id === vk)) return fail(404, `virtual key '${vk}' not found`)
  const now = Date.now()
  const o = openHeaderFlow(store, cname, vk, now)
  if (o.error !== undefined) return o.error
  return reply(201, `{"id":${quote(o.id)},"flow_mode":"vk","status":"pending","mcp_client_name":${quote(cname)},"virtual_key_id":${quote(vk)},"expires_at":${now + HEADER_FLOW_TTL_MS},"url":${quote(`/api/mcp/per-user-headers/flows/${o.id}`)}}`)
}

// Opens a submission for one key and one per_user_headers client, or renews the pending one of that pair (Bifrost's
// find-or-update), and saves it. The flow's id, or the reply that says why it could not be saved.
function openHeaderFlow(store: ConfigStore, cname: string, vk: string, now: f64): { id: string, error: McpReply | undefined } {
  const cfg = store.cfg
  let list = dropExpired(cfg.mcp?.header_flows ?? [], now)
  let id = ""
  const at = list.findIndex((f) => f.mcp_client_name === cname && f.virtual_key_id === vk)
  if (at >= 0) {
    let f = list[at]!
    f.expires_at = now + HEADER_FLOW_TTL_MS
    list[at] = f
    id = f.id
  } else {
    id = randomId("mcphf")
    list.push({ id: id, mcp_client_name: cname, virtual_key_id: vk, expires_at: now + HEADER_FLOW_TTL_MS, created_at: now })
  }
  const err = persist(store, withHeaderState(cfg, cfg.mcp?.user_credentials ?? [], list))
  return { id: id, error: err }
}

// The answer of a tool call whose key has not submitted the per-user headers of a client: a submission is opened
// (or renewed) for the key, and the message names its page (the auth page with kind=headers), with a temp token in
// the fragment when client.mcp_enable_temp_token_auth is on (Bifrost's inline 401). "" when no flow could be opened.
export function headersAuthMessage(store: ConfigStore, client: string, vk: string, base: string): string {
  const now = Date.now()
  const o = openHeaderFlow(store, client, vk, now)
  if (o.error !== undefined) return ""
  let temp = ""
  if (store.cfg.client?.mcp_enable_temp_token_auth === true) {
    try {
      // the token lives as long as the submission, at most the temp tokens' 15 minutes
      temp = mintTempToken("mcp_headers_auth", o.id, now + Math.min(HEADER_FLOW_TTL_MS, 900000.0))
    } catch (e) {
      temp = ""
    }
  }
  const link = headersLink(base, o.id, temp)
  return consentMessageOf(client, link, temp !== "", "to submit the required headers")
}

// Bifrost's wording of an inline 401 with a page to visit, and the reminder to keep the fragment when there is one.
function consentMessageOf(client: string, link: string, tempToken: bool, what: string): string {
  let m = `Authentication required for ${client}. Visit ${link} ${what}.`
  if (tempToken) m += " IMPORTANT: this link includes a required fragment after the '#' character (a one-time auth token). Copy and share the ENTIRE URL exactly as given, including everything after the '#' — the link will not work without it."
  return m
}

// GET /api/mcp/per-user-headers/flows/{id}: the flow, the header names it asks for and the names already submitted.
function flowDetail(store: ConfigStore, id: string): McpReply {
  const cfg = store.cfg
  const list = cfg.mcp?.header_flows ?? []
  const at = flowIndex(list, id)
  if (at < 0) return fail(404, "Headers submission flow not found")
  const f = list[at]!
  if (f.expires_at <= Date.now()) return fail(410, "Headers submission flow has expired; create a new one")
  const clients = clientsOf(cfg)
  const ci = clientIndex(clients, f.mcp_client_name)
  const keys: string[] = ci < 0 ? [] : (clients[ci]!.per_user_header_keys ?? [])
  const cred = userHeadersOf(cfg.mcp?.user_credentials, f.mcp_client_name, f.virtual_key_id)
  const submitted: string[] = []
  if (cred !== undefined) {
    for (const k of cred.keys()) submitted.push(k)
  }
  submitted.sort()
  return reply(200, JSON.stringify({
    id: f.id,
    flow_mode: "vk",
    status: "pending",
    expires_at: f.expires_at,
    created_at: f.created_at,
    mcp_client: { name: f.mcp_client_name },
    virtual_key: { id: f.virtual_key_id },
    required_header_keys: keys,
    has_active_credential: cred !== undefined,
    submitted_keys: submitted,
  }))
}

// DELETE /api/mcp/per-user-headers/credential/{id}: removes one key's values for one client, and any pending
// submission for that pair.
function revokeCredential(store: ConfigStore, id: string): McpReply {
  const cfg = store.cfg
  const creds = cfg.mcp?.user_credentials ?? []
  const at = creds.findIndex((c) => c.id === id)
  if (at < 0) return fail(404, "credential not found")
  const row = creds[at]!
  const kept: McpUserCredential[] = []
  for (const c of creds) {
    if (c.id !== id) kept.push(c)
  }
  const flows: McpHeaderFlow[] = []
  const ended: string[] = []
  for (const f of cfg.mcp?.header_flows ?? []) {
    if (!(f.mcp_client_name === row.mcp_client_name && f.virtual_key_id === row.virtual_key_id)) flows.push(f)
    else ended.push(f.id)
  }
  const err = persist(store, withHeaderState(cfg, kept, flows))
  if (err !== undefined) return err
  for (const id of ended) endTempTokens(id)
  return reply(200, `{"status":"success","message":"credential revoked"}`)
}

function headersRoute(store: ConfigStore, m: string, segs: string[], body: string, p: string): McpReply {
  if (segs.length === 4 && segs[3] === "flows") return m === "POST" ? createFlow(store, body) : notAllowed(m)
  if (segs.length === 5 && segs[3] === "flows") return m === "GET" ? flowDetail(store, segs[4]!) : notAllowed(m)
  if (segs.length === 5 && segs[3] === "credential") return m === "DELETE" ? revokeCredential(store, segs[4]!) : notAllowed(m)
  return fail(404, `no route for ${p}`)
}

// PUT /api/mcp/per-user-headers/flows/{id}: checks the submitted values against the MCP server, then stores
// them for the flow's key and closes the flow.
async function submitFlow(store: ConfigStore, id: string, body: string): Promise<McpReply> {
  const cfg = store.cfg
  const list = dropExpired(cfg.mcp?.header_flows ?? [], Date.now())
  const at = flowIndex(list, id)
  if (at < 0) return fail(404, "Headers submission flow not found")
  const f = list[at]!
  const clients = clientsOf(cfg)
  const ci = clientIndex(clients, f.mcp_client_name)
  if (ci < 0) return fail(404, `MCP client '${f.mcp_client_name}' not found`)
  const client = clients[ci]!
  let parsed: { headers?: Map<string, string> } = {}
  try {
    parsed = JSON.parse(body) as { headers?: Map<string, string> }
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const keys = client.per_user_header_keys ?? []
  const merged = mergedValues(userHeadersOf(cfg.mcp?.user_credentials, f.mcp_client_name, f.virtual_key_id), canonMap(parsed.headers), keys)
  if (merged.missing.length > 0) return fail(400, `missing values for required keys: ${merged.missing.join(", ")}`)
  const v = try await dialWith(client, merged.values, cfg.mcp?.oauth_private_allowlist ?? [])
  if (!v.ok) return fail(422, `Verification failed: ${v.error}`)
  const now = Date.now()
  let creds = cfg.mcp?.user_credentials ?? []
  const ui = credentialIndex(creds, f.mcp_client_name, f.virtual_key_id)
  const credId = ui >= 0 ? creds[ui]!.id : randomId("mcpuc")
  const row: McpUserCredential = { id: credId, mcp_client_name: f.mcp_client_name, virtual_key_id: f.virtual_key_id, headers: merged.values, updated_at: now }
  if (ui >= 0) creds[ui] = row
  else creds.push(row)
  const flows: McpHeaderFlow[] = []
  for (const x of list) {
    if (x.id !== id) flows.push(x)
  }
  const err = persist(store, withHeaderState(cfg, creds, flows))
  if (err !== undefined) return err
  // the submission is done: its temp token ends with it (Bifrost deletes it by the flow's id)
  endTempTokens(id)
  return { status: 200, body: `{"status":"success","credential_id":${quote(credId)},"updated_at":${now}}` }
}

// POST /api/mcp/client/{id}/verify-headers for a per_user_headers client: checks the sample values by connecting
// to the server, then keeps them as the client's headers, the ones it connects with to list its tools.
async function verifyClient(store: ConfigStore, id: string, body: string): Promise<McpReply> {
  const cfg = store.cfg
  const clients = clientsOf(cfg)
  const ci = clientIndex(clients, id)
  const client = clients[ci]!
  let parsed: { headers?: Map<string, string> } = {}
  try {
    parsed = JSON.parse(body) as { headers?: Map<string, string> }
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const keys = client.per_user_header_keys ?? []
  const merged = mergedValues(undefined, canonMap(parsed.headers), keys)
  if (merged.missing.length > 0) return fail(400, `missing values for required keys: ${merged.missing.join(", ")}`)
  const v = try await dialWith(client, merged.values, cfg.mcp?.oauth_private_allowlist ?? [])
  if (!v.ok) return fail(422, `Verification failed: ${v.error}`)
  let c = client
  c.headers = merged.values
  const err = persist(store, withClients(cfg, replaceAt(clients, ci, c)))
  if (err !== undefined) return err
  return { status: 200, body: `{"status":"success","message":${quote(`MCP client verified. ${v.tools} tools discovered. Each virtual key submits its own header values.`)},"tools_count":${v.tools}}`, action: "reconnect", id: id }
}

// The per-user headers routes that reach the MCP server: PUT .../flows/{id} and POST .../verify-headers of a
// per_user_headers client. undefined for any other request, which mcpApi answers.
export async function headersRouteAsync(store: ConfigStore, method: string, path: string, body: string): Promise<McpReply | undefined> {
  const q = path.indexOf("?")
  const p = q < 0 ? path : path.slice(0, q)
  const segs = p.split("/").filter((s) => s !== "")
  if (segs.length < 4 || segs[0] !== "api" || segs[1] !== "mcp") return undefined
  const m = method.toUpperCase()
  if (segs.length === 5 && segs[2] === "per-user-headers" && segs[3] === "flows" && m === "PUT") return try await submitFlow(store, segs[4]!, body)
  if (segs.length === 5 && segs[2] === "client" && segs[4] === "verify-headers" && m === "POST") {
    const clients = clientsOf(store.cfg)
    const ci = clientIndex(clients, segs[3]!)
    if (ci < 0 || clients[ci]!.auth_type !== "per_user_headers") return undefined
    return try await verifyClient(store, segs[3]!, body)
  }
  return undefined
}

// The config with the admin discovery credentials of the token_exchange clients set.
function withExchangeAdmin(c: Config, list: McpUserToken[]): Config {
  let n = c
  let m: McpConfig = n.mcp ?? {}
  m.exchange_admin = list
  n.mcp = m
  return n
}

// The admin credentials without the one of client.
function exchangeAdminWithout(list: McpUserToken[], client: string): McpUserToken[] {
  const out: McpUserToken[] = []
  for (const r of list) {
    if (r.mcp_client_name !== client) out.push(r)
  }
  return out
}

// Saves a token_exchange client's admin credential: a renewal, a refusal, or one another worker or node renewed or
// verified. It replaces the client's credential while the config still names the client (a deleted client keeps
// none), and a credential the file already holds unchanged is not written again. A failed save is logged: the
// renewal runs again when it is next due.
export function saveExchangeAdmin(store: ConfigStore, row: McpUserToken): void {
  let named = false
  for (const c of store.cfg.mcp?.client_configs ?? []) {
    if (c.name === row.mcp_client_name) named = true
  }
  if (!named) return
  const list = store.cfg.mcp?.exchange_admin ?? []
  let found = false
  let same = false
  const next: McpUserToken[] = []
  for (const r of list) {
    if (r.mcp_client_name === row.mcp_client_name) {
      same = r.access_token === row.access_token && r.refresh_token === row.refresh_token && r.token_expires_at === row.token_expires_at && r.last_refreshed_at === row.last_refreshed_at && (r.status ?? "") === (row.status ?? "")
      next.push(row)
      found = true
    } else {
      next.push(r)
    }
  }
  if (!found) next.push(row)
  if (same) return
  const err = persist(store, withExchangeAdmin(store.cfg, next))
  if (err !== undefined) console.error(`raiju: the admin credential of MCP client ${row.mcp_client_name} could not be saved`)
}

// Sends a credential that verify-exchange kept to the other nodes (set by main.tov; see clusterstate.tov).
let adminPublished: ((r: McpUserToken) => void) | undefined = undefined

export function setAdminPublished(f: ((r: McpUserToken) => void) | undefined): void {
  adminPublished = f
}

// Tells the other nodes that a client's admin credential was removed (set by main.tov): a deleted client, or one whose
// token exchange changed.
let adminRemoved: ((client: string) => void) | undefined = undefined

export function setAdminRemoved(f: ((client: string) => void) | undefined): void {
  adminRemoved = f
}

function noteAdminRemoved(client: string): void {
  const f = adminRemoved
  if (f !== undefined) f(client)
}

// Drops a client's admin credential from the config: one another node removed. A credential the config does not hold is
// left alone.
export function dropExchangeAdmin(store: ConfigStore, client: string): void {
  let held = false
  for (const r of store.cfg.mcp?.exchange_admin ?? []) {
    if (r.mcp_client_name === client) held = true
  }
  if (!held) return
  const err = persist(store, withExchangeAdmin(store.cfg, exchangeAdminWithout(store.cfg.mcp?.exchange_admin ?? [], client)))
  if (err !== undefined) console.error(`raiju: the admin credential of MCP client ${client} could not be removed`)
}

// POST /api/mcp/client/{id}/verify-exchange for a token_exchange client. The body names the identity-provider
// token to check the exchange with (subject_token): it is exchanged for one scoped to the audience, and the
// server is dialed with the result, which must list tools. The exchanged token is then kept as the client's
// admin credential (Bifrost's retained admin token): the client's tools are listed with it from then on, and
// the caller's own tokens are exchanged per call as before.
async function verifyExchange(store: ConfigStore, idp: IdpEndpoints, client: McpClientConfig, body: string): Promise<McpReply> {
  let parsed: { subject_token?: string } = {}
  try {
    parsed = JSON.parse(body) as { subject_token?: string }
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const subject = (parsed.subject_token ?? "").trim()
  if (subject === "") return fail(400, "subject_token is required: the identity-provider token to verify the exchange with")
  const te = client.token_exchange
  if (te === undefined) return fail(400, "the client has no token_exchange settings")
  const oc = store.cfg.oidc
  const r = await exchangeToken(te, subject, idp, oc?.issuer ?? "", oc?.client_id ?? "", oc?.client_secret ?? "")
  if (r.error !== "") return fail(422, `Admin credential exchange failed: ${r.error}`)
  const hs: Map<string, string> = new Map()
  hs.set("authorization", "Bearer " + r.token)
  const v = await dialWith(client, hs, store.cfg.mcp?.oauth_private_allowlist ?? [], r.token)
  if (!v.ok) return fail(422, `Verification failed: ${v.error}`)
  const now = Date.now()
  // the refresh token, when the identity provider issued one, renews the credential before it expires
  const row: McpUserToken = { id: "exchange-" + client.name, mcp_client_name: client.name, virtual_key_id: "", session_id: "", access_token: r.token, refresh_token: r.refreshToken, token_expires_at: r.expiresIn > 0.0 ? now + r.expiresIn * 1000.0 : 0.0, scopes: [], created_at: now, last_refreshed_at: now, status: "active" }
  const kept = exchangeAdminWithout(store.cfg.mcp?.exchange_admin ?? [], client.name)
  kept.push(row)
  const err = persist(store, withExchangeAdmin(store.cfg, kept))
  if (err !== undefined) return err
  const pub = adminPublished
  if (pub !== undefined) pub(row)
  return { status: 200, body: `{"status":"success","message":${quote(`Token exchange verified. ${v.tools} tools discovered.`)},"tools_count":${v.tools}}` }
}

// The token_exchange route that reaches the MCP server: POST .../verify-exchange of a token_exchange client.
// undefined for any other request, which mcpApi answers.
export async function exchangeRouteAsync(store: ConfigStore, idp: IdpEndpoints, method: string, path: string, body: string): Promise<McpReply | undefined> {
  const q = path.indexOf("?")
  const p = q < 0 ? path : path.slice(0, q)
  const segs = p.split("/").filter((s) => s !== "")
  if (segs.length !== 5 || segs[0] !== "api" || segs[1] !== "mcp" || segs[2] !== "client" || segs[4] !== "verify-exchange") return undefined
  const clients = clientsOf(store.cfg)
  const ci = clientIndex(clients, segs[3]!)
  if (ci < 0 || clients[ci]!.auth_type !== "token_exchange") return undefined
  if (method.toUpperCase() !== "POST") return fail(405, "use POST")
  return await verifyExchange(store, idp, clients[ci]!, body)
}

// ---- virtual MCPs ----

// The virtual tools a tools list means. A Bifrost spec {mcp_client_id, tool_names} becomes sources
// "<server>-<tool>" (or "<server>-*" for "*"); a native tool {source, as, description, defaults} is
// kept as it is. A source whose server is not a configured client is named in the error.
function virtualTools(raw: string, clients: McpClientConfig[]): { tools: vmcp.VirtualTool[], error: string } {
  let out: vmcp.VirtualTool[] = []
  let unknown: string[] = []
  let els: string[] = []
  try {
    els = elements(raw)
  } catch (e) {
    return { tools: [], error: "tools must be a JSON array" }
  }
  for (const el of els) {
    const fs = objectFields(el)
    if (fs === undefined || !kindsOk(fs, TOOL_KINDS) || !strArrayOk(find(fs, "tool_names"))) return { tools: [], error: "each tool must be a JSON object" }
    let parsed: ToolBody = {}
    try {
      parsed = JSON.parse(el) as ToolBody
    } catch (e) {
      return { tools: [], error: "each tool must be a JSON object" }
    }
    const t: ToolBody = { mcp_client_id: present(fs, "mcp_client_id", parsed.mcp_client_id), tool_names: present(fs, "tool_names", parsed.tool_names), source: present(fs, "source", parsed.source), as: present(fs, "as", parsed.as), description: present(fs, "description", parsed.description), defaults: present(fs, "defaults", parsed.defaults) }
    if (t.mcp_client_id !== undefined) {
      const id = t.mcp_client_id
      const at = clientIndex(clients, id)
      if (at < 0) {
        unknown.push(id)
        continue
      }
      const server = clients[at]!.name
      for (const name of t.tool_names ?? []) {
        out.push({ source: name === "*" ? `${sanitizeName(server)}-*` : sanitizeName(`${server}-${name}`) })
      }
    } else {
      const src = t.source ?? ""
      let vt: vmcp.VirtualTool = { source: src }
      if (t.as !== undefined) vt.as = t.as
      if (t.description !== undefined) vt.description = t.description
      if (t.defaults !== undefined) vt.defaults = t.defaults
      if (src !== "" && !clients.some((c) => src.startsWith(sanitizeName(c.name) + "-"))) unknown.push(src)
      out.push(vt)
    }
  }
  if (unknown.length > 0) return { tools: [], error: "invalid MCP client IDs: " + unknown.join(", ") }
  return { tools: out, error: "" }
}

// One virtual MCP's JSON. virtual_key_ids is who may use it: every key when allowed_keys is unset.
function virtualJson(v: vmcp.VirtualMcp, keyIds: string[]): string {
  const keys = v.allowed_keys ?? keyIds
  const quotedKeys: string[] = []
  for (const k of keys) quotedKeys.push(quote(k))
  const desc = v.description === undefined ? "" : `,"description":${quote(v.description)}`
  return `{"id":${quote(v.name)},"name":${quote(v.name)},"endpoint_slug":${quote(v.name)}${desc},"enabled":true,"tools":${JSON.stringify(v.tools)},"virtual_key_ids":[${quotedKeys.join(",")}]}`
}

function listVirtuals(store: ConfigStore, scope: DataScope | undefined): McpReply {
  const list = virtualsOf(store.cfg).filter((v) => virtualVisible(store.cfg, v, scope))
  const keyIds = virtualKeyIds(store.cfg)
  const parts: string[] = []
  for (const v of list) parts.push(virtualJson(v, keyIds))
  return reply(200, `{"virtual_mcps":[${parts.join(",")}],"count":${list.length},"total_count":${list.length}}`)
}

// Data access control on virtual MCPs (Bifrost's vMCP visibility): a caller with a narrowed data scope sees a virtual
// MCP when one of its attached keys is in that scope (the key's team or customer); one without allowed_keys is
// attached to every key and seen by all. An unscoped caller sees every one.
export function virtualVisible(c: Config, v: vmcp.VirtualMcp, scope: DataScope | undefined): bool {
  if (scope === undefined || scope.all) return true
  const keys = v.allowed_keys
  if (keys === undefined) return true
  for (const vk of c.governance?.virtual_keys ?? []) {
    if (keys.includes(vk.id) && inScope(scope, vk.team_id ?? "", "", vk.customer_id ?? "", "")) return true
  }
  return false
}

// The reverse lookup of a virtual MCP: the access profiles that grant it (their virtual_mcps name it) and how many users
// reach it through each, the users who hold the profile (by hand or through a role) and the users of the keys it is
// attached to.
export function grantingProfilesJson(c: Config, name: string): string {
  const g = c.governance
  const rows: string[] = []
  for (const p of g?.access_profiles ?? []) {
    if (!(p.virtual_mcps ?? []).includes(name)) continue
    const users: string[] = []
    for (const u of g?.users ?? []) {
      if (heldProfiles(g?.users, g?.roles, g?.access_profiles, u.name).some((h) => h.id === p.id) && !users.includes(u.name)) users.push(u.name)
    }
    for (const vk of g?.virtual_keys ?? []) {
      const uid = vk.user_id ?? ""
      if (uid !== "" && (vk.access_profile_ids ?? []).includes(p.id) && !users.includes(uid)) users.push(uid)
    }
    rows.push(`{"id":${quote(p.id)},"name":${quote(p.name ?? p.id)},"is_active":${p.is_active === false ? "false" : "true"},"user_count":${users.length}}`)
  }
  return `[${rows.join(",")}]`
}

// Whether a virtual MCP name is taken by another virtual MCP or by an MCP client (they share
// the endpoint namespace). self is the virtual MCP being renamed, which does not count.
function virtualNameTaken(store: ConfigStore, name: string, self: string): bool {
  if (name !== self && virtualIndex(virtualsOf(store.cfg), name) >= 0) return true
  return clientIndex(clientsOf(store.cfg), name) >= 0
}

const NAME_TAKEN = "a virtual MCP with this name or endpoint already exists"

function createVirtual(store: ConfigStore, body: string): McpReply {
  const fs = checkedFields(body, VMCP_KINDS)
  if (fs === undefined) return fail(400, "Invalid request payload")
  let parsed: VmcpBody = {}
  try {
    parsed = JSON.parse(body) as VmcpBody
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const b: VmcpBody = { name: present(fs, "name", parsed.name), endpoint_slug: present(fs, "endpoint_slug", parsed.endpoint_slug), description: present(fs, "description", parsed.description), enabled: present(fs, "enabled", parsed.enabled) }
  const name = b.name ?? ""
  if (name === "") return fail(400, "name is required")
  if (b.endpoint_slug !== undefined && b.endpoint_slug !== name) return fail(400, "endpoint_slug must equal the name: a virtual MCP is served at /mcp/<name>")
  if (b.enabled === false) return fail(400, "enabled: false is not supported: a virtual MCP is always served")
  const shape = vmcp.validate({ name: name, tools: [] })
  if (shape !== "") return fail(400, shape)
  if (virtualNameTaken(store, name, "")) return fail(409, NAME_TAKEN)
  let tools: vmcp.VirtualTool[] = []
  if (has(fs, "tools")) {
    const got = virtualTools(find(fs, "tools")!, clientsOf(store.cfg))
    if (got.error !== "") return fail(400, got.error)
    tools = got.tools
  }
  let v: vmcp.VirtualMcp = { name: name, tools: tools }
  v.description = b.description
  const problem = vmcp.validate(v)
  if (problem !== "") return fail(400, problem)
  let next: vmcp.VirtualMcp[] = virtualsOf(store.cfg)
  next.push(v)
  const err = persist(store, withVirtuals(store.cfg, next))
  if (err !== undefined) return err
  return reply(201, `{"virtual_mcp":${virtualJson(v, virtualKeyIds(store.cfg))}}`)
}

function updateVirtual(store: ConfigStore, id: string, body: string): McpReply {
  const list = virtualsOf(store.cfg)
  const at = virtualIndex(list, id)
  if (at < 0) return fail(404, "virtual MCP not found")
  const fs = checkedFields(body, VMCP_KINDS)
  if (fs === undefined) return fail(400, "Invalid request payload")
  let b: VmcpBody = {}
  try {
    b = JSON.parse(body) as VmcpBody
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  if (b.enabled === false) return fail(400, "enabled: false is not supported: a virtual MCP is always served")
  let v = list[at]!
  if (has(fs, "name") && b.name !== id) {
    const newName = b.name ?? ""
    const shape = vmcp.validate({ name: newName, tools: [] })
    if (shape !== "") return fail(400, shape)
    if (virtualNameTaken(store, newName, id)) return fail(409, NAME_TAKEN)
    v.name = newName
  }
  if (has(fs, "description")) v.description = b.description
  if (has(fs, "tools")) {
    const got = virtualTools(find(fs, "tools")!, clientsOf(store.cfg))
    if (got.error !== "") return fail(400, got.error)
    v.tools = got.tools
  }
  const problem = vmcp.validate(v)
  if (problem !== "") return fail(400, problem)
  let next: vmcp.VirtualMcp[] = list
  next[at] = v
  const err = persist(store, withVirtuals(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, `{"virtual_mcp":${virtualJson(v, virtualKeyIds(store.cfg))}}`)
}

function deleteVirtual(store: ConfigStore, id: string): McpReply {
  const list = virtualsOf(store.cfg)
  if (virtualIndex(list, id) < 0) return fail(404, "virtual MCP not found")
  let next: vmcp.VirtualMcp[] = []
  for (const v of list) {
    if (v.name !== id) next.push(v)
  }
  const err = persist(store, withVirtuals(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, `{"success":true}`)
}

// Attaches or detaches a virtual key. An unset allowed_keys means every key already has it, so
// attaching changes nothing, and detaching lists every other key explicitly.
function setAttached(store: ConfigStore, id: string, vkId: string, attach: bool): McpReply {
  const list = virtualsOf(store.cfg)
  const at = virtualIndex(list, id)
  if (at < 0) return fail(404, "virtual MCP not found")
  if (attach && !virtualKeyIds(store.cfg).includes(vkId)) return fail(404, "virtual key not found")
  // a key whose owner holds an access profile takes its virtual MCPs from the profile (Bifrost answers 409)
  const g = store.cfg.governance
  for (const vk of g?.virtual_keys ?? []) {
    const uid = vk.user_id ?? ""
    if (vk.id === vkId && uid !== "" && heldProfiles(g?.users, g?.roles, g?.access_profiles, uid).length > 0) return fail(409, "the virtual key's owner holds an access profile; grant the virtual MCP through the profile")
  }
  let v = list[at]!
  let keys: string[] = v.allowed_keys ?? virtualKeyIds(store.cfg)
  if (attach) {
    if (v.allowed_keys === undefined || keys.includes(vkId)) return reply(200, `{"success":true}`)
    keys.push(vkId)
  } else {
    if (v.allowed_keys === undefined && !keys.includes(vkId)) return reply(200, `{"success":true}`)
    keys = keys.filter((k) => k !== vkId)
  }
  v.allowed_keys = keys
  let next: vmcp.VirtualMcp[] = list
  next[at] = v
  const err = persist(store, withVirtuals(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, `{"success":true}`)
}

function virtualRoute(store: ConfigStore, m: string, segs: string[], body: string, p: string, scope: DataScope | undefined): McpReply {
  if (segs.length === 3) {
    if (m === "GET") return listVirtuals(store, scope)
    if (m === "POST") return createVirtual(store, body)
    return notAllowed(m)
  }
  const id = segs[3]!
  // one the caller's data scope does not reach is not found, as Bifrost answers
  const seen = virtualIndex(virtualsOf(store.cfg), id)
  if (seen >= 0 && !virtualVisible(store.cfg, virtualsOf(store.cfg)[seen]!, scope)) return fail(404, "virtual MCP not found")
  if (segs.length === 5 && segs[4] === "access-profiles") {
    if (m !== "GET") return notAllowed(m)
    if (seen < 0) return fail(404, "virtual MCP not found")
    return reply(200, `{"access_profiles":${grantingProfilesJson(store.cfg, id)}}`)
  }
  if (segs.length === 4) {
    if (m === "GET") {
      const at = virtualIndex(virtualsOf(store.cfg), id)
      if (at < 0) return fail(404, "virtual MCP not found")
      return reply(200, `{"virtual_mcp":${virtualJson(virtualsOf(store.cfg)[at]!, virtualKeyIds(store.cfg))}}`)
    }
    if (m === "PUT") return updateVirtual(store, id, body)
    if (m === "DELETE") return deleteVirtual(store, id)
    return notAllowed(m)
  }
  if (segs.length === 6 && segs[4] === "virtual-keys") {
    if (m === "POST") return setAttached(store, id, segs[5]!, true)
    if (m === "DELETE") return setAttached(store, id, segs[5]!, false)
    return notAllowed(m)
  }
  return fail(404, `no route for ${p}`)
}

// ---- OpenAPI preview: POST /api/mcp/openapi/preview ----

// The preview route (Bifrost's previewOpenAPISpec): the document is the spec, or spec_url fetched now (the
// client is not created). A fetched document comes back as spec, with the spec_url it was read from.
export async function openapiRoute(method: string, path: string, body: string, publicOnly?: bool): Promise<McpReply | undefined> {
  const q = path.indexOf("?")
  const pure = q < 0 ? path : path.slice(0, q)
  if (pure !== "/api/mcp/openapi/preview") return undefined
  if (method.toUpperCase() !== "POST") return notAllowed(method)
  const fs = objectFields(body)
  if (fs === undefined) return fail(400, "Invalid request payload")
  let text = (rawStr(fs, "spec") ?? "").trim()
  const url = (rawStr(fs, "spec_url") ?? "").trim()
  if (text === "" && url === "") return fail(400, "spec or spec_url is required")
  let fetched = false
  if (text === "") {
    const got = await fetchSpec(url, publicOnly === true)
    const err = got.error
    if (err !== undefined) return err
    text = got.text
    fetched = true
  }
  let out = ""
  try {
    const doc = parseSpec(text, rawBool(fs, "include_deprecated") ?? false, url, (rawStr(fs, "client_name") ?? "").trim())
    out = previewJson(doc, (rawStr(fs, "base_url") ?? "").trim())
  } catch (e) {
    return fail(e.message.includes("exceeds") ? 413 : 400, `Invalid OpenAPI spec: ${e.message}`)
  }
  if (fetched) out = `${out.slice(0, out.byteLength - 1)},"spec":${quote(text)},"spec_url":${quote(url)}}`
  return reply(200, out)
}

// ---- tool groups: /api/mcp/tool-groups, Bifrost's deprecated alias of the virtual MCPs ----
// The same store, with the group's shape. Its governance associations (team_ids, customer_ids and
// provider_names) reach the virtual keys they name, and virtual_key_ids are attached keys; the
// keys are stored as the virtual MCP's allowed_keys. A create must send enabled: true, since a virtual MCP cannot be disabled here.
// user_ids and api_key_ids have no Raiju counterpart, so a body that sends them is refused.

// The string list a JSON array holds, or [] when it is absent or not one.
function stringList(raw: string | undefined): string[] {
  if (raw === undefined || !raw.startsWith("[")) return []
  try {
    return JSON.parse(raw) as string[]
  } catch (e) {
    return []
  }
}

// The virtual keys a tool group reaches: its virtual_key_ids, and every key of the teams, customers
// and providers its associations name.
function groupKeys(store: ConfigStore, fs: Field[]): string[] {
  const out: string[] = []
  for (const k of stringList(find(fs, "virtual_key_ids"))) {
    if (!out.includes(k)) out.push(k)
  }
  const teams = stringList(find(fs, "team_ids"))
  const customers = stringList(find(fs, "customer_ids"))
  const providers = stringList(find(fs, "provider_names"))
  if (teams.length + customers.length + providers.length === 0) return out
  for (const vk of store.cfg.governance?.virtual_keys ?? []) {
    const tid: string = vk.team_id ?? ""
    const cid: string = vk.customer_id ?? ""
    let hit = (tid !== "" && teams.includes(tid)) || (cid !== "" && customers.includes(cid))
    for (const pc of vk.provider_configs ?? []) {
      if (providers.includes(pc.provider)) hit = true
    }
    if (hit && !out.includes(vk.id)) out.push(vk.id)
  }
  return out
}

// The virtual MCP body a tool group body means: tools read as {mcp_client_id, tool_names}, and enabled
// false on create unless the body enables it.
function groupVirtualBody(fs: Field[], name: string, creating: bool): string throws SyntaxError {
  const parts: string[] = [`"name":${quote(name)}`]
  const desc = find(fs, "description")
  if (desc !== undefined && desc !== "null") parts.push(`"description":${desc}`)
  const en = find(fs, "enabled")
  if (en !== undefined && en !== "null") parts.push(`"enabled":${en}`)
  const tools: string[] = []
  const raw = find(fs, "tools")
  if (raw !== undefined && raw.startsWith("[")) {
    for (const el of try elements(raw)) {
      const tf = try fields(el)
      const client = rawStr(tf, "mcp_client_name") ?? rawStr(tf, "mcp_client_id") ?? ""
      const names = find(tf, "tool_names")
      const tn = names === undefined || names === "null" ? "" : `,"tool_names":${names}`
      tools.push(`{"mcp_client_id":${quote(client)}${tn}}`)
    }
  }
  parts.push(`"tools":[${tools.join(",")}]`)
  return `{${parts.join(",")}}`
}

// The stored virtual MCP with its allowed keys set to keys (undefined when there is no such virtual MCP).
function setVirtualKeys(store: ConfigStore, id: string, keys: string[]): McpReply | undefined {
  const list = virtualsOf(store.cfg)
  const at = virtualIndex(list, id)
  if (at < 0) return fail(404, "virtual MCP not found")
  let next: vmcp.VirtualMcp[] = list
  let v = next[at]!
  v.allowed_keys = keys
  next[at] = v
  return persist(store, withVirtuals(store.cfg, next))
}

// POST (id "") and PUT of a tool group. A write that names association fields sets the keys afresh.
function toolGroupWrite(store: ConfigStore, id: string, body: string): McpReply {
  const creating = id === ""
  const fs = objectFields(body)
  if (fs === undefined) return fail(400, "Invalid request payload")
  for (const k of ["user_ids", "api_key_ids"]) {
    if (has(fs, k)) return fail(400, `${k} has no Raiju equivalent: attach the tool group to virtual keys with virtual_key_ids or team_ids, customer_ids and provider_names`)
  }
  // Raiju's virtual MCPs are always served, so a group cannot be created disabled (Bifrost's default)
  if (creating && rawBool(fs, "enabled") !== true) return fail(400, "enabled must be true: Raiju serves every virtual MCP, so a tool group cannot be created disabled")
  const name = creating ? (rawStr(fs, "name") ?? "") : id
  if (!creating && rawStr(fs, "name") !== undefined && rawStr(fs, "name") !== id) return fail(400, "renaming a tool group is not supported: its name is its id")
  let vb = ""
  try {
    vb = groupVirtualBody(fs, name, creating)
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const assoc = has(fs, "virtual_key_ids") || has(fs, "team_ids") || has(fs, "customer_ids") || has(fs, "provider_names")
  const r = creating ? createVirtual(store, vb) : updateVirtual(store, id, vb)
  if (r.status >= 300) return r
  if (creating || assoc) {
    const kr = setVirtualKeys(store, name, groupKeys(store, fs))
    if (kr !== undefined && kr.status >= 300) return kr
  }
  const at = virtualIndex(virtualsOf(store.cfg), name)
  if (at < 0) return fail(404, "virtual MCP not found")
  return reply(creating ? 201 : 200, `{"mcp_tool_group":${virtualJson(virtualsOf(store.cfg)[at]!, virtualKeyIds(store.cfg))}}`)
}

function toolGroupRoute(store: ConfigStore, m: string, segs: string[], body: string, p: string): McpReply {
  if (segs.length === 3) {
    if (m === "GET") {
      const list = virtualsOf(store.cfg)
      const keyIds = virtualKeyIds(store.cfg)
      const parts: string[] = []
      for (const v of list) parts.push(virtualJson(v, keyIds))
      return reply(200, `{"mcp_tool_groups":[${parts.join(",")}],"count":${list.length},"total_count":${list.length}}`)
    }
    return m === "POST" ? toolGroupWrite(store, "", body) : notAllowed(m)
  }
  if (segs.length !== 4) return fail(404, `no route for ${p}`)
  const id = segs[3]!
  if (m === "GET") {
    const at = virtualIndex(virtualsOf(store.cfg), id)
    if (at < 0) return fail(404, "tool group not found")
    return reply(200, `{"mcp_tool_group":${virtualJson(virtualsOf(store.cfg)[at]!, virtualKeyIds(store.cfg))}}`)
  }
  if (m === "PUT") return toolGroupWrite(store, id, body)
  if (m === "DELETE") {
    const r = deleteVirtual(store, id)
    return r.status === 200 ? reply(200, `{"success":true}`) : r
  }
  return notAllowed(m)
}

// ---- OAuth configs: /api/oauth/config/{id}/status and DELETE /api/oauth/config/{id} ----
// An OAuth config is the MCP client of auth type "oauth" with that name. Its status is "authorized" when the
// client holds a token, "failed" when its last verification flow failed, and "pending" otherwise. With
// ?flow_id= (the flow a reauthorize answered) the status is that flow's (pollStatus). DELETE revokes: the tokens
// are dropped and the client stays. A live session keeps the token it had until the client next connects.

// The status a poller acts on for one admin flow (Bifrost's resolveOAuthFlowPollStatus). A flow still held is
// failed, or pending until its deadline and expired after it; a flow no longer held finished, and the config's
// status says how (authorized or failed), else it expired unseen.
export function pollStatus(flow: UserFlow | undefined, configStatus: string, nowMs: f64): string {
  if (flow !== undefined) {
    if (flow.status === "failed") return "failed"
    return nowMs > flow.expires_at ? "expired" : "pending"
  }
  if (configStatus === "authorized" || configStatus === "failed") return configStatus
  return "expired"
}

export function oauthConfigRoute(store: ConfigStore, method: string, path: string): McpReply | undefined {
  const q = path.indexOf("?")
  const pure = q < 0 ? path : path.slice(0, q)
  const segs = pure.split("/").filter((s) => s !== "")
  if (segs.length < 4 || segs[0] !== "api" || segs[1] !== "oauth" || segs[2] !== "config") return undefined
  const id = segs[3]!
  const isStatus = segs.length === 5 && segs[4] === "status"
  if (!isStatus && segs.length !== 4) return undefined
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  const a = at < 0 ? undefined : oauthAuthOf(list[at]!)
  if (isStatus) {
    if (method !== "GET") return notAllowed(method)
    if (a === undefined) return fail(404, "OAuth config not found")
    const flows = adminFlowsOf(id)
    const lastFailed = flows.length > 0 && flows[0]!.status === "failed"
    const configStatus = authorized(a) ? "authorized" : lastFailed ? "failed" : "pending"
    const flowId = queryParam(path, "flow_id")
    if (flowId !== "") {
      const f = adminFlowById(flowId)
      // a flow of another config is not found here, so a poll on one config cannot read another's flow
      if (f !== undefined && f.client !== id) return fail(404, "OAuth flow not found for this OAuth config")
      const st = pollStatus(f, configStatus, Date.now())
      let out = `{"id":${quote(id)},"status":"${st}","flow_id":${quote(flowId)}`
      if (f !== undefined) out += `,"flow_status":${quote(f.status ?? "pending")}`
      if (st === "authorized") out += tokenFieldsOf(a)
      return reply(200, out + "}")
    }
    const tail = configStatus === "authorized" ? tokenFieldsOf(a) : ""
    return reply(200, `{"id":${quote(id)},"status":"${configStatus}"${tail}}`)
  }
  if (method !== "DELETE") return notAllowed(method)
  if (a === undefined) return fail(404, "OAuth config not found")
  let na = a
  na.access_token = undefined
  na.refresh_token = undefined
  na.token_expires_at = undefined
  const revoked = withAuth(list[at]!, na)
  let next: McpClientConfig[] = list
  next[at] = revoked
  const err = persist(store, withClients(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, `{"status":"success","message":"OAuth config revoked"}`)
}

// The token fields of an authorized config's status: when its access token expires (RFC 3339), if known.
function tokenFieldsOf(a: McpAuthConfig): string {
  const exp = a.token_expires_at ?? 0.0
  return exp > 0.0 ? `,"token_expires_at":${quote(rfc3339Of(exp))}` : ""
}

// ---- OAuth for clients of auth type "oauth": the authorization code flow with PKCE (Bifrost's
// initiate-verification, complete-oauth, reauthorize and reregister). A flow (its state, verifier and redirect
// URI) is an admin flow of mcpuser.tov's table, kept in the flow state file until the callback returns or its
// time is up. The callback saves the tokens on the client; the client connects with them.

const FLOW_TIMEOUT_MS = 10000

// The auth of a client that uses the authorization code flow, else undefined.
function oauthAuthOf(c: McpClientConfig): McpAuthConfig | undefined {
  const a = c.auth
  return a !== undefined && a.type === "oauth" ? a : undefined
}

// Whether the flow has saved a token on the client.
function authorized(a: McpAuthConfig): bool {
  return (a.refresh_token ?? "") !== "" || (a.access_token ?? "") !== ""
}

// The client with its auth replaced.
function withAuth(c: McpClientConfig, a: McpAuthConfig): McpClientConfig {
  let n = c
  n.auth = a
  return n
}

// The list with the client at index at replaced.
function replaceAt(list: McpClientConfig[], at: int, c: McpClientConfig): McpClientConfig[] {
  const out: McpClientConfig[] = []
  for (let i = 0; i < list.length; i++) out.push(i === at ? c : list[i]!)
  return out
}

// A request to an authorization server under a deadline: the body of a 2xx answer, else an error.
async function callAuthServer(url: string, method: string, headers: Map<string, string>, body: string): Promise<string> throws Error {
  const dl = deadline(FLOW_TIMEOUT_MS)
  try {
    const hs: Record<string, string> = headers
    const r = method === "GET" ? await fetch(url, { signal: dl.controller.signal }) : await fetch(url, { method: "POST", headers: hs, body: body, signal: dl.controller.signal })
    const text = await r.text()
    if (r.status < 200 || r.status >= 300) throw new Error(`HTTP ${r.status} from ${url}`)
    dl.finish()
    return text
  } catch (e) {
    dl.finish()
    throw new Error(`${url}: ${e.message}`)
  }
}

// The authorization server's endpoints, from its metadata at the origin of the MCP server (RFC 8414).
async function discover(serverUrl: string): Promise<AuthEndpoints> throws Error {
  const urls = discoveryUrls(serverUrl)
  if (urls.length < 2) throw new Error("connection_string must be an http or https URL")
  const text = try await callAuthServer(urls[1]!, "GET", new Map(), "")
  return try parseAuthEndpoints(text)
}

// Dynamic client registration (RFC 7591), with the gateway's callback as the redirect URI.
async function register(url: string, redirect: string): Promise<{ client_id: string, client_secret: string }> throws Error {
  const rq = try registrationRequest(url, redirect, "Raiju")
  const text = try await callAuthServer(rq.url, "POST", rq.headers, rq.body)
  return try registrationResult(text)
}

// Starts the authorization flow of a client. It finds the endpoints in the server's metadata and
// registers a client when it has none; then it saves the client and returns the authorize URL.
// mode is "initiate", "reauthorize" (the client must be authorized already) or "reregister" (a new
// client is registered in place of the stored one).
async function startFlow(store: ConfigStore, id: string, base: string, mode: string): Promise<McpReply> {
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, `MCP client '${id}' not found`)
  const c = list[at]!
  const a0 = oauthAuthOf(c)
  if (a0 === undefined) return fail(400, "OAuth flows apply to auth type oauth clients only")
  if (mode === "reauthorize" && !authorized(a0)) return fail(400, "MCP client has not completed initial OAuth authorization yet; use initiate-verification instead")
  const server = c.connection_string ?? ""
  if (server === "") return fail(400, "MCP client connection_string is required to initiate OAuth discovery")
  let a = a0
  if (mode === "reregister") {
    a.client_id = undefined
    a.client_secret = undefined
  }
  if ((a.authorize_url ?? "") === "" || (a.token_url ?? "") === "") {
    let meta: AuthEndpoints = { authorization_endpoint: "", token_endpoint: "", registration_endpoint: "" }
    try {
      meta = await discover(server)
    } catch (e) {
      return fail(502, `OAuth discovery failed: ${e.message}`)
    }
    if ((a.authorize_url ?? "") === "") a.authorize_url = meta.authorization_endpoint
    if ((a.token_url ?? "") === "") a.token_url = meta.token_endpoint
    if ((a.registration_url ?? "") === "") a.registration_url = meta.registration_endpoint
  }
  const redirect = base + "/api/oauth/callback"
  if ((a.client_id ?? "") === "") {
    const reg = a.registration_url ?? ""
    if (reg === "") return fail(400, "MCP client has no client_id, and its authorization server has no registration endpoint: set client_id")
    let got = { client_id: "", client_secret: "" }
    try {
      got = await register(reg, redirect)
    } catch (e) {
      return fail(502, `client registration failed: ${e.message}`)
    }
    a.client_id = got.client_id
    a.client_secret = got.client_secret === "" ? undefined : got.client_secret
  }
  let verifier = ""
  let state = ""
  let authUrl = ""
  try {
    verifier = pkceVerifier()
    state = secureHex(32)
    authUrl = authorizeUrl(a, redirect, state, pkceChallenge(verifier))
  } catch (e) {
    return fail(500, `could not start the flow: ${e.message}`)
  }
  let flowId = ""
  let expires = 0.0
  try {
    const flow = startAdminFlow(id, state, verifier, redirect, authUrl, Date.now())
    flowId = flow.id
    expires = flow.expires_at
  } catch (e) {
    return fail(500, `could not start the flow: ${e.message}`)
  }
  const perr = persist(store, withClients(store.cfg, replaceAt(list, at, withAuth(c, a))))
  if (perr !== undefined) return perr
  // a reauthorize polls its flow: the config may read authorized from an earlier verification all along
  const statusUrl = mode === "reauthorize" ? `/api/oauth/config/${id}/status?flow_id=${flowId}` : `/api/oauth/config/${id}/status`
  const out = {
    status: "pending_oauth",
    oauth_config_id: id,
    flow_id: flowId,
    authorize_url: authUrl,
    expires_at: expires,
    mcp_client_id: id,
    complete_url: `/api/mcp/client/${id}/complete-oauth`,
    status_url: statusUrl,
    next_steps: ["1. Open authorize_url in a browser to approve access", "2. Poll status_url to check when status becomes 'authorized'", "3. POST complete_url to connect the MCP client"],
  }
  return reply(200, JSON.stringify(out))
}

// A page for the browser that came back to the callback.
function callbackPage(status: int, msg: string): { status: int, html: string } {
  const safe = msg.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll("\"", "&quot;")
  return { status: status, html: `<!doctype html><html><head><meta charset="utf-8"><title>MCP authorization</title></head><body><p>${safe}</p></body></html>` }
}

// GET /api/oauth/callback: the browser returns from the authorization server with a code. The code
// is exchanged for tokens (with the flow's PKCE verifier and redirect URI), the tokens are saved on
// the client, and the page says what happened. A flow is single use.
export async function oauthCallback(store: ConfigStore, query: URLSearchParams): Promise<{ status: int, html: string }> {
  const state = query.get("state") ?? ""
  const refused = query.get("error") ?? ""
  if (refused !== "") {
    // the authorization server refused: an admin flow is marked failed (its status route says so); a per-user flow
    // stays pending, so the same link can be tried again while it lives (as Bifrost)
    const seen = peekFlow(state)
    if (seen !== undefined && seen.mode === "admin" && seen.status !== "failed") failAdminFlow(seen, Date.now())
    return callbackPage(400, `The authorization server refused access: ${refused}`)
  }
  const flow = takeUserFlow(state, Date.now())
  if (flow === undefined) return callbackPage(400, "This authorization link is unknown or has expired. Start the flow again.")
  // a per-user consent flow (auth_type per_user_oauth): the caller's own token row is saved
  if (flow.mode !== "admin") return await userCallback(store, flow, query)
  const code = query.get("code") ?? ""
  if (code === "") {
    failAdminFlow(flow, Date.now())
    return callbackPage(400, "The callback has no authorization code.")
  }
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, flow.client)
  if (at < 0) {
    endAdminFlow(flow.id, Date.now())
    return callbackPage(404, `MCP client '${flow.client}' no longer exists.`)
  }
  const c = list[at]!
  const a = oauthAuthOf(c)
  if (a === undefined) {
    endAdminFlow(flow.id, Date.now())
    return callbackPage(400, "The MCP client does not use the OAuth flow.")
  }
  let tokens = { access: "", refresh: "", expiresAt: 0.0 }
  try {
    const tr = codeTokenRequest(a, code, flow.verifier, flow.redirect)
    const text = await callAuthServer(tr.url, "POST", tr.headers, tr.body)
    tokens = tokenFields(text, Date.now())
  } catch (e) {
    failAdminFlow(flow, Date.now())
    return callbackPage(502, `The token request failed: ${e.message}`)
  }
  let next = a
  next.access_token = tokens.access
  next.token_expires_at = tokens.expiresAt
  if (tokens.refresh !== "") next.refresh_token = tokens.refresh
  const perr = persist(store, withClients(store.cfg, replaceAt(list, at, withAuth(c, next))))
  if (perr !== undefined) {
    failAdminFlow(flow, Date.now())
    return callbackPage(500, "The tokens could not be saved.")
  }
  endAdminFlow(flow.id, Date.now())
  return callbackPage(200, `MCP client ${flow.client} is authorized. You can close this window.`)
}

// The OAuth routes of a client with auth type oauth. undefined for any other route or client, which
// mcpApi answers. base is the gateway's origin, for the callback's redirect URI.
export async function oauthRoute(store: ConfigStore, method: string, path: string, body: string, base: string): Promise<McpReply | undefined> {
  const segs = path.split("/").filter((s) => s !== "")
  if (segs.length !== 5 || segs[0] !== "api" || segs[1] !== "mcp" || segs[2] !== "client") return undefined
  if (method !== "POST") return undefined
  const id = segs[3]!
  const sub = segs[4]!
  if (sub !== "initiate-verification" && sub !== "reauthorize" && sub !== "reregister" && sub !== "complete-oauth") return undefined
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return undefined
  const a = oauthAuthOf(list[at]!)
  if (a === undefined) return undefined
  if (sub === "complete-oauth") {
    if (!authorized(a)) return fail(400, "OAuth not authorized yet. Current status: pending")
    return { status: 200, body: `{"status":"success","message":"MCP client authorized"}`, action: "reconnect", id: id }
  }
  const mode = sub === "reregister" ? "reregister" : sub === "reauthorize" ? "reauthorize" : "initiate"
  return await startFlow(store, id, base, mode)
}

// The MCP management route for method and path, or undefined when the path is not one of them.
// The caller passes every /api/mcp path that is not handled elsewhere (the /api/mcp view and the
// library are not).
export function mcpApi(store: ConfigStore, method: string, path: string, body: string, publicOnly?: bool, scope?: DataScope): McpReply | undefined {
  const m = method.toUpperCase()
  const q = path.indexOf("?")
  const p = q < 0 ? path : path.slice(0, q)
  const segs = p.split("/").filter((s) => s !== "")
  if (segs.length < 3 || segs[0] !== "api" || segs[1] !== "mcp") return undefined
  const area = segs[2]!
  if (area === "clients") return m === "GET" ? listClients(store) : notAllowed(m)
  if (area === "client") return clientRoute(store, m, segs, body, p, publicOnly ?? false)
  if (area === "virtual-mcps") return virtualRoute(store, m, segs, body, p, scope)
  if (area === "tool-groups") return toolGroupRoute(store, m, segs, body, p)
  if (area === "per-user-headers") return headersRoute(store, m, segs, body, p)
  return undefined
}

// ---- per-user OAuth (auth_type per_user_oauth): the callers' consent flows, their token rows and the sessions ----

// The config with the per-user token rows set.
function withUserTokens(c: Config, list: McpUserToken[]): Config {
  let n = c
  let m: McpConfig = n.mcp ?? {}
  m.user_tokens = list
  n.mcp = m
  return n
}

// Saves a token row the gateway refreshed. A failed save is logged: the next call refreshes again.
export function saveUserToken(store: ConfigStore, row: McpUserToken): void {
  const next = upsertUserRow(store.cfg.mcp?.user_tokens ?? [], row)
  const err = persist(store, withUserTokens(store.cfg, next))
  if (err !== undefined) console.error(`raiju: the MCP token of ${row.mcp_client_name} could not be saved`)
}

// The index of a token row by id, or -1.
function tokenRowIndex(list: McpUserToken[], id: string): int {
  for (let i = 0; i < list.length; i++) {
    if (list[i]!.id === id) return i
  }
  return -1
}

// The callback of a per-user flow: the code is exchanged for the caller's tokens, which become its row (the
// row keeps its id; a refresh token the server did not return keeps the old one).
async function userCallback(store: ConfigStore, f: UserFlow, query: URLSearchParams): Promise<{ status: int, html: string }> {
  const refused = query.get("error") ?? ""
  if (refused !== "") return callbackPage(400, `The authorization server refused access: ${refused}`)
  const code = query.get("code") ?? ""
  if (code === "") return callbackPage(400, "The callback has no authorization code.")
  const clients = clientsOf(store.cfg)
  const ci = clientIndex(clients, f.client)
  if (ci < 0) return callbackPage(404, `MCP client '${f.client}' no longer exists.`)
  const a = oauthAuthOf(clients[ci]!)
  if (a === undefined) return callbackPage(400, "The MCP client does not use the OAuth flow.")
  const now = Date.now()
  try {
    const list = store.cfg.mcp?.user_tokens ?? []
    const ui = userTokenIndex(list, f.client, f.virtual_key_id, f.session_id, f.user_id)
    let id = ""
    let oldRefresh = ""
    if (ui >= 0) {
      id = list[ui]!.id
      oldRefresh = list[ui]!.refresh_token
    } else {
      id = try secureHex(12)
    }
    const text = await exchangeUserCode(a, code, f.verifier, f.redirect, now)
    const row = try rowFromTokens(text, now, f.client, f.virtual_key_id, f.session_id, id, oldRefresh, f.user_id)
    const perr = persist(store, withUserTokens(store.cfg, upsertUserRow(list, row)))
    if (perr !== undefined) return callbackPage(500, "The tokens could not be saved.")
  } catch (e) {
    return callbackPage(502, `The token request failed: ${e.message}`)
  }
  return callbackPage(200, `MCP client ${f.client} is authorized for this caller. You can close this window.`)
}

// The per-user OAuth routes: GET /api/oauth/per-user/flows/{id} (the flow), GET .../{id}/start (its upstream
// authorize URL) and /api/mcp/sessions (list; DELETE {id}; POST {id}/reauth). base is the gateway's origin, the
// redirect URI of a flow started here. callerUser is the identity-provider user of the caller's single sign-on
// session ("" when none): a user-mode flow opens for that user only. undefined for any other route.
export function perUserApi(store: ConfigStore, method: string, path: string, body: string, base: string, callerUser?: string): McpReply | undefined {
  const m = method.toUpperCase()
  const q = path.indexOf("?")
  const pure = q < 0 ? path : path.slice(0, q)
  const fid = flowIdOfPath(path)
  if (fid !== "") return perUserFlowRoute(store, m, fid, pure, callerUser ?? "")
  const segs = pure.split("/").filter((s) => s !== "")
  if (segs.length >= 3 && segs[0] === "api" && segs[1] === "mcp" && segs[2] === "sessions") return sessionRoute(store, m, segs, path, base)
  return undefined
}

// The flow's mode: user, session or vk.
function flowModeOf(vk: string, session: string, user: string | undefined): string {
  if ((user ?? "") !== "") return "user"
  return session !== "" ? "session" : "vk"
}

// The flow's detail, or its start URL (the upstream authorize URL, with the flow's state). A user-mode flow opens
// only for its own user (Bifrost's canAccessUserFlow).
function perUserFlowRoute(store: ConfigStore, m: string, id: string, pure: string, callerUser: string): McpReply {
  if (m !== "GET") return notAllowed(m)
  const f = userFlowById(id, Date.now())
  if (f === undefined) return fail(404, "Per-user OAuth flow not found or expired")
  if (!mayOpenFlow(f, callerUser)) return fail(403, "This authentication link is bound to a different user.")
  if (pure.endsWith("/start")) return reply(200, JSON.stringify({ authorize_url: f.authorize_url }))
  const has = userTokenIndex(store.cfg.mcp?.user_tokens ?? [], f.client, f.virtual_key_id, f.session_id, f.user_id) >= 0
  return reply(200, JSON.stringify({ id: f.id, flow_mode: flowModeOf(f.virtual_key_id, f.session_id, f.user_id), status: "pending", mcp_client: { name: f.client }, user_id: f.user_id ?? "", virtual_key_id: f.virtual_key_id, session_id: f.session_id, expires_at: f.expires_at, created_at: f.created_at, has_active_token: has }))
}

// One row of the sessions list: a token row ("token"), a pending consent flow ("flow") or a per-user header
// credential ("header"). Fields that do not apply are "" (or 0 and false).
type SessionRow = { id: string, kind: string, auth_kind: string, auth_mode: string, user_id: string, virtual_key_id: string, session_id: string, mcp_client: { name: string }, status: string, expires_at: f64, created_at: f64, has_refresh_token: bool, can_reauth: bool }

function sessionRows(cfg: Config, now: f64): SessionRow[] {
  const out: SessionRow[] = []
  for (const t of cfg.mcp?.user_tokens ?? []) {
    const st = tokenAction(t, now) === "consent" ? "needs_reauth" : "active"
    out.push({ id: t.id, kind: "token", auth_kind: "oauth", auth_mode: flowModeOf(t.virtual_key_id, t.session_id, t.user_id), user_id: t.user_id ?? "", virtual_key_id: t.virtual_key_id, session_id: t.session_id, mcp_client: { name: t.mcp_client_name }, status: st, expires_at: t.token_expires_at, created_at: t.created_at, has_refresh_token: t.refresh_token !== "", can_reauth: true })
  }
  for (const f of userFlowsLive(now)) {
    out.push({ id: f.id, kind: "flow", auth_kind: "oauth", auth_mode: flowModeOf(f.virtual_key_id, f.session_id, f.user_id), user_id: f.user_id ?? "", virtual_key_id: f.virtual_key_id, session_id: f.session_id, mcp_client: { name: f.client }, status: "pending", expires_at: f.expires_at, created_at: f.created_at, has_refresh_token: false, can_reauth: false })
  }
  for (const c of cfg.mcp?.user_credentials ?? []) {
    out.push({ id: c.id, kind: "header", auth_kind: "headers", auth_mode: "vk", user_id: "", virtual_key_id: c.virtual_key_id, session_id: "", mcp_client: { name: c.mcp_client_name }, status: "active", expires_at: 0.0, created_at: c.updated_at, has_refresh_token: false, can_reauth: false })
  }
  return out
}

// The value of one query parameter of a path, or "".
function queryParam(path: string, key: string): string {
  const q = path.indexOf("?")
  if (q < 0) return ""
  for (const kv of path.slice(q + 1).split("&")) {
    const eq = kv.indexOf("=")
    if (eq > 0 && kv.slice(0, eq) === key) return kv.slice(eq + 1)
  }
  return ""
}

// GET /api/mcp/sessions: the rows, filtered by kind (token, flow or header), paged by limit (default 50, at
// most 500) and offset.
function sessionsList(store: ConfigStore, path: string): McpReply {
  const kind = queryParam(path, "kind")
  let limit = 50
  const lp = parseInt(queryParam(path, "limit"))
  if (lp !== undefined && lp >= 1) limit = lp > 500 ? 500 : lp
  let offset = 0
  const op = parseInt(queryParam(path, "offset"))
  if (op !== undefined && op >= 0) offset = op
  const rows: SessionRow[] = []
  for (const r of sessionRows(store.cfg, Date.now())) {
    if (kind === "" || r.kind === kind) rows.push(r)
  }
  const page: SessionRow[] = []
  for (let i = offset; i < rows.length && page.length < limit; i++) page.push(rows[i]!)
  return reply(200, JSON.stringify({ sessions: page, count: page.length, total_count: rows.length, limit: limit, offset: offset }))
}

function sessionRoute(store: ConfigStore, m: string, segs: string[], path: string, base: string): McpReply {
  if (segs.length === 3) return m === "GET" ? sessionsList(store, path) : notAllowed(m)
  if (segs.length === 4) return m === "DELETE" ? revokeSession(store, segs[3]!) : notAllowed(m)
  if (segs.length === 5 && segs[4] === "reauth") return m === "POST" ? reauthSession(store, segs[3]!, base) : notAllowed(m)
  return fail(404, `no route for ${path}`)
}

// DELETE /api/mcp/sessions/{id}: revokes a token row (its pending flows go with it), a pending flow, or a header
// credential. The client stays, and a live session keeps its token until the next call refreshes or fails.
function revokeSession(store: ConfigStore, id: string): McpReply {
  const cfg = store.cfg
  const toks = cfg.mcp?.user_tokens ?? []
  const ti = tokenRowIndex(toks, id)
  if (ti >= 0) {
    const row = toks[ti]!
    forgetUserFlows(row.mcp_client_name, row.virtual_key_id, row.session_id, row.user_id)
    const err = persist(store, withUserTokens(cfg, dropUserRow(toks, id)))
    if (err !== undefined) return err
    return reply(200, `{"status":"success","message":"session revoked"}`)
  }
  if (userFlowById(id, Date.now()) !== undefined) {
    dropUserFlow(id)
    return reply(200, `{"status":"success","message":"session revoked"}`)
  }
  if ((cfg.mcp?.user_credentials ?? []).some((c) => c.id === id)) return revokeCredential(store, id)
  return fail(404, "session not found")
}

// POST /api/mcp/sessions/{id}/reauth: opens a new consent flow for a token row's caller, which replaces its
// pending flows. The answer carries the flow's link (with its temp token when that is on).
function reauthSession(store: ConfigStore, id: string, base: string): McpReply {
  const cfg = store.cfg
  const toks = cfg.mcp?.user_tokens ?? []
  const ti = tokenRowIndex(toks, id)
  if (ti < 0) {
    if ((cfg.mcp?.user_credentials ?? []).some((c) => c.id === id)) return fail(400, "header credentials are renewed through their submission flow, not reauth")
    return fail(404, "session not found")
  }
  const row = toks[ti]!
  const clients = clientsOf(cfg)
  const ci = clientIndex(clients, row.mcp_client_name)
  if (ci < 0) return fail(404, `MCP client '${row.mcp_client_name}' not found`)
  const a = oauthAuthOf(clients[ci]!)
  if (a === undefined) return fail(400, "reauth applies to per_user_oauth clients only")
  forgetUserFlows(row.mcp_client_name, row.virtual_key_id, row.session_id, row.user_id)
  const tempOn = cfg.client?.mcp_enable_temp_token_auth === true
  const r = startUserFlow(a, row.mcp_client_name, row.virtual_key_id, row.session_id, base, tempOn, Date.now(), row.user_id)
  if (r.flow === undefined) return fail(400, r.error)
  const f = r.flow!
  return reply(200, JSON.stringify({ status: "pending_oauth", id: f.id, mcp_client: { name: f.client }, url: consentLink(base, f.id, f.temp_token), expires_at: f.expires_at }))
}

// ---- tests ----

function tmpPath(): string {
  return "/tmp/raiju-mcpapi-" + randomId("t") + ".json"
}

function cleanupFile(path: string): void {
  try {
    unlinkSync(path)
  } catch (e) {
    // already gone
  }
  try {
    unlinkSync(path + ".bak")
  } catch (e) {
    // no backup on a first save
  }
}

function oneEntry(k: string, v: string): Map<string, string> {
  const m: Map<string, string> = new Map()
  m.set(k, v)
  return m
}

// A store on a fresh file: two virtual keys and two clients, one http and one stdio.
function fixture(): ConfigStore {
  const c: Config = {
    governance: { virtual_keys: [{ id: "vk1", value: "sk-bf-1", name: "dev" }, { id: "vk2", value: "sk-bf-2", name: "ops" }] },
    mcp: {
      client_configs: [
        { name: "fs", connection_type: "http", connection_string: "http://localhost:9000/mcp", headers: oneEntry("authorization", "Bearer abcdefghijklmnop"), tools_to_execute: ["*"] },
        { name: "git", connection_type: "stdio", stdio_config: { command: "git-mcp", env: oneEntry("TOKEN", "tok-secret-value") } },
      ],
    },
  }
  return new ConfigStore(tmpPath(), c)
}

test("list shows every client with secrets masked", () => {
  const s = fixture()
  const r = mcpApi(s, "GET", "/api/mcp/clients", "")!
  expect(r.status).toBe(200)
  expect(r.body.includes("\"client_id\":\"fs\"")).toBe(true)
  expect(r.body.includes("\"count\":2")).toBe(true)
  expect(r.body.includes("abcdefghijklmnop")).toBe(false)
  expect(r.body.includes("tok-secret-value")).toBe(false)
  expect(r.body.includes("Bearer abcd")).toBe(false)
  expect(mcpApi(s, "POST", "/api/mcp/clients", "{}")!.status).toBe(405)
  expect(mcpApi(s, "GET", "/api/mcp/other", "") === undefined).toBe(true)
  expect(mcpApi(s, "GET", "/api/mcp/virtual", "") === undefined).toBe(true)
  cleanupFile(s.path)
})

test("create adds a client, validates it, and saves", () => {
  const s = fixture()
  const v0 = s.version
  const r = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"docs\",\"connection_type\":\"http\",\"connection_string\":\"https://docs.example/mcp\",\"headers\":{\"x-key\":\"sk-live-0123456789\"},\"tool_sync_interval\":\"10m\",\"tls_config\":{\"insecure_skip_verify\":false}}")!
  expect(r.status).toBe(201)
  expect(r.body.includes("\"client_id\":\"docs\"")).toBe(true)
  expect(r.body.includes("sk-live-0123456789")).toBe(false)
  expect(clientsOf(s.cfg).length).toBe(3)
  expect(s.version).toBe(v0 + 1)
  const saved = try readFileSync(s.path, "utf8")
  expect(saved.includes("\"docs\"")).toBe(true)
  expect(saved.includes("sk-live-0123456789")).toBe(true)
  expect(saved.includes("\"tool_sync_interval\": \"10m\"")).toBe(true)

  const withCap = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"capped\",\"connection_type\":\"http\",\"connection_string\":\"https://c.example/mcp\",\"max_instructions_length\":256}")!
  expect(withCap.status).toBe(201)
  expect(withCap.body.includes("\"max_instructions_length\":256")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"neg\",\"connection_type\":\"http\",\"connection_string\":\"https://c.example/mcp\",\"max_instructions_length\":-5}")!.body.includes("must not be negative")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "not json")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "[1]")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":5}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"connection_type\":\"http\"}")!.body.includes("name is required")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"my-srv\",\"connection_type\":\"http\"}")!.body.includes("cannot contain hyphens")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"1abc\",\"connection_type\":\"http\"}")!.body.includes("cannot start with a number")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"fs\",\"connection_type\":\"http\",\"connection_string\":\"http://x\"}")!.status).toBe(409)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"inprocess\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\"}")!.body.includes("connection_string is required")).toBe(true)
  expect(clientsOf(s.cfg).length).toBe(4)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"ftp://x\"}")!.body.includes("http or https")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"stdio\"}")!.body.includes("stdio_config.command is required")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"auth_type\":\"oauth\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"auth\":{\"type\":\"weird\"}}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"tool_sync_interval\":\"1500ms\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"headers\":{\"a\":1}}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"tools_to_execute\":[1]}")!.status).toBe(400)
  expect(clientsOf(s.cfg).length).toBe(4)
  cleanupFile(s.path)
})

test("duration checks accept Go durations in whole seconds", () => {
  expect(durationError("0")).toBe("")
  expect(durationError("90s")).toBe("")
  expect(durationError("10m")).toBe("")
  expect(durationError("1h30m")).toBe("")
  expect(durationError("1h30m15s")).toBe("")
  expect(durationError("1m30m") === "").toBe(false)
  expect(durationError("30m1h") === "").toBe(false)
  expect(durationError("10") === "").toBe(false)
  expect(durationError("") === "").toBe(false)
  expect(durationError("1500ms") === "").toBe(false)
})

test("update patches fields, keeps masked secrets, and refuses renames", () => {
  const s = fixture()
  const r = mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"disabled\":true,\"tools_to_skip\":[\"rm\"],\"headers\":{\"authorization\":\"Bear…mnop\",\"x-new\":\"v\"}}")!
  expect(r.status).toBe(200)
  expect(r.body.includes("\"disabled\":true")).toBe(true)
  const c = s.cfg.mcp!.client_configs![0]!
  expect(c.disabled).toBe(true)
  expect(c.tools_to_skip!.includes("rm")).toBe(true)
  expect(c.headers!.get("authorization")).toBe("Bearer abcdefghijklmnop")
  expect(c.headers!.get("x-new")).toBe("v")
  expect(c.tools_to_execute!.includes("*")).toBe(true)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"allow_on_all_virtual_keys\":true}")!.body.includes("\"allow_by_default\":true")).toBe(true)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"name\":\"files\"}")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"name\":\"fs\"}")!.status).toBe(200)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"is_code_mode_client\":true}")!.status).toBe(200)
  expect(s.cfg.mcp!.client_configs![0]!.is_code_mode_client).toBe(true)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"is_code_mode_client\":\"yes\"}")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"max_instructions_length\":-1}")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"max_instructions_length\":\"big\"}")!.status).toBe(400)
  const mil = mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"max_instructions_length\":512}")!
  expect(mil.status).toBe(200)
  expect(mil.body.includes("\"max_instructions_length\":512")).toBe(true)
  expect(s.cfg.mcp!.client_configs![0]!.max_instructions_length).toBe(512)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"max_instructions_length\":0}")!.status).toBe(200)
  expect(s.cfg.mcp!.client_configs![0]!.max_instructions_length).toBeUndefined()
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"tool_sync_interval\":\"soon\"}")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"auth\":null,\"disabled\":false}")!.status).toBe(200)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"auth\":{\"type\":\"weird\"}}")!.status).toBe(400)
  const au = mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"auth\":{\"type\":\"bearer\",\"token\":\"tok-123456789\"}}")!
  expect(au.body.includes("tok-…6789")).toBe(true)
  expect(au.body.includes("tok-123456789")).toBe(false)
  const kept = mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"auth\":{\"type\":\"bearer\",\"token\":\"tok-…6789\"}}")!
  expect(kept.status).toBe(200)
  expect(s.cfg.mcp!.client_configs![0]!.auth!.token).toBe("tok-123456789")
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "not json")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/client/nope", "{}")!.status).toBe(404)
  expect(mcpApi(s, "GET", "/api/mcp/client/fs", "")!.status).toBe(405)
  cleanupFile(s.path)
})

test("delete removes a client", () => {
  const s = fixture()
  expect(mcpApi(s, "DELETE", "/api/mcp/client/git", "")!.status).toBe(200)
  expect(s.cfg.mcp!.client_configs!.length).toBe(1)
  expect(mcpApi(s, "DELETE", "/api/mcp/client/git", "")!.status).toBe(404)
  cleanupFile(s.path)
})

test("reconnect and refresh hand the step to the lead, and refuse disabled clients", () => {
  const s = fixture()
  const rc = mcpApi(s, "POST", "/api/mcp/client/fs/reconnect", "")!
  expect(rc.status).toBe(200)
  expect(rc.action === "reconnect").toBe(true)
  expect(rc.id === "fs").toBe(true)
  const rf = mcpApi(s, "POST", "/api/mcp/client/git/refresh-tools", "")!
  expect(rf.action === "refresh").toBe(true)
  expect(rf.id === "git").toBe(true)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"disabled\":true}")!.status).toBe(200)
  const off = mcpApi(s, "POST", "/api/mcp/client/fs/reconnect", "")!
  expect(off.status).toBe(400)
  expect(off.action === undefined).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/refresh-tools", "")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client/nope/reconnect", "")!.status).toBe(404)
  expect(mcpApi(s, "GET", "/api/mcp/client/fs/reconnect", "")!.status).toBe(405)
  expect(mcpApi(s, "GET", "/api/mcp/client/fs/openapi-spec", "")!.status).toBe(404)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/openapi-spec", "")!.status).toBe(405)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/complete-oauth", "")!.status).toBe(404)
  const init = mcpApi(s, "POST", "/api/mcp/client/fs/initiate-verification", "")!
  expect(init.status).toBe(400)
  expect(init.body.includes("only applies to OAuth-based clients")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client/nope/initiate-verification", "")!.status).toBe(404)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/reauthorize", "")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/verify-headers", "")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/verify-exchange", "")!.status).toBe(400)
  expect(mcpApi(s, "GET", "/api/mcp/client/fs/verify-headers", "")!.status).toBe(405)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/whatever", "")!.status).toBe(404)
  cleanupFile(s.path)
})

test("virtual MCPs: create with Bifrost and native tools, then read, update and delete", () => {
  const s = fixture()
  const c = mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"dev\",\"description\":\"Dev tools\",\"tools\":[{\"mcp_client_id\":\"fs\",\"tool_names\":[\"read\",\"write\"]},{\"mcp_client_id\":\"git\",\"tool_names\":[\"*\"]}]}")!
  expect(c.status).toBe(201)
  expect(c.body.includes("\"source\":\"fs-read\"")).toBe(true)
  expect(c.body.includes("\"source\":\"git-*\"")).toBe(true)
  expect(c.body.includes("\"description\":\"Dev tools\"")).toBe(true)
  expect(c.body.includes("\"virtual_key_ids\":[\"vk1\",\"vk2\"]")).toBe(true)

  const native = mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"nat\",\"endpoint_slug\":\"nat\",\"tools\":[{\"source\":\"fs-read\",\"as\":\"read_file\",\"defaults\":\"{\\\"limit\\\":5}\"}]}")!
  expect(native.status).toBe(201)
  expect(native.body.includes("\"as\":\"read_file\"")).toBe(true)

  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"dev\"}")!.status).toBe(409)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"fs\"}")!.status).toBe(409)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{}")!.body.includes("name is required")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"Bad Name\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"endpoint_slug\":\"y\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"enabled\":false}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":[{\"mcp_client_id\":\"nope\",\"tool_names\":[\"a\"]}]}")!.body.includes("invalid MCP client IDs: nope")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":[{\"source\":\"zzz-read\"}]}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":[{\"source\":\"fs-*\",\"as\":\"n\"}]}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":\"no\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":[\"fs-read\"]}")!.status).toBe(400)

  const list = mcpApi(s, "GET", "/api/mcp/virtual-mcps", "")!
  expect(list.body.includes("\"count\":2")).toBe(true)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/dev", "")!.body.includes("\"virtual_mcp\"")).toBe(true)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/nope", "")!.status).toBe(404)

  const up = mcpApi(s, "PUT", "/api/mcp/virtual-mcps/dev", "{\"description\":\"Renamed\",\"tools\":[{\"source\":\"git-log\"}]}")!
  expect(up.status).toBe(200)
  expect(up.body.includes("\"description\":\"Renamed\"")).toBe(true)
  expect(s.cfg.virtual_mcps![0]!.tools.length).toBe(1)
  expect(mcpApi(s, "PUT", "/api/mcp/virtual-mcps/dev", "{\"name\":\"nat\"}")!.status).toBe(409)
  expect(mcpApi(s, "PUT", "/api/mcp/virtual-mcps/dev", "{\"name\":\"devs\"}")!.status).toBe(200)
  expect(mcpApi(s, "PUT", "/api/mcp/virtual-mcps/devs", "{\"enabled\":false}")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/virtual-mcps/nope", "{}")!.status).toBe(404)

  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/devs", "")!.body.includes("\"success\":true")).toBe(true)
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/devs", "")!.status).toBe(404)
  expect(mcpApi(s, "PATCH", "/api/mcp/virtual-mcps", "")!.status).toBe(405)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/nat/other", "")!.status).toBe(404)
  cleanupFile(s.path)
})

test("attach and detach change which virtual keys may use a virtual MCP", () => {
  const s = fixture()
  mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"dev\"}")
  // unset allowed_keys: every key already has it, so attaching changes nothing
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/vk1", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys === undefined).toBe(true)
  // detaching from an open one lists the other keys
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/dev/virtual-keys/vk2", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys!.join(",")).toBe("vk1")
  expect(vmcp.keyAllowed(s.cfg.virtual_mcps![0]!, "vk2")).toBe(false)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/vk2", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys!.join(",")).toBe("vk1,vk2")
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/vk2", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys!.length).toBe(2)
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/dev/virtual-keys/vk1", "")!.status).toBe(200)
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/dev/virtual-keys/vk2", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys!.length).toBe(0)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/nope", "")!.status).toBe(404)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/nope/virtual-keys/vk1", "")!.status).toBe(404)
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/nope/virtual-keys/vk1", "")!.status).toBe(404)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/dev/virtual-keys/vk1", "")!.status).toBe(405)
  cleanupFile(s.path)
})

test("tool groups alias virtual MCPs, OAuth configs report status and revoke, and openapi needs a spec it can read", () => {
  const s = fixture()
  expect(mcpApi(s, "POST", "/api/mcp/tool-groups", "{\"name\":\"ops\",\"tools\":[{\"mcp_client_name\":\"fs\",\"tool_names\":[\"read\"]}],\"virtual_key_ids\":[\"vk2\"]}")!.status).toBe(400)
  const g = mcpApi(s, "POST", "/api/mcp/tool-groups", "{\"name\":\"ops\",\"enabled\":true,\"tools\":[{\"mcp_client_name\":\"fs\",\"tool_names\":[\"read\"]}],\"virtual_key_ids\":[\"vk2\"]}")!
  expect(g.status).toBe(201)
  expect(g.body.includes("\"virtual_key_ids\":[\"vk2\"]")).toBe(true)
  expect(mcpApi(s, "GET", "/api/mcp/tool-groups/ops", "")!.status).toBe(200)
  expect(mcpApi(s, "GET", "/api/mcp/tool-groups", "")!.body.includes("\"mcp_tool_groups\":[")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/tool-groups", "{\"name\":\"x\",\"tools\":[],\"user_ids\":[\"u1\"]}")!.status).toBe(400)
  expect(mcpApi(s, "DELETE", "/api/mcp/tool-groups/ops", "")!.status).toBe(200)
  expect(mcpApi(s, "GET", "/api/mcp/tool-groups/ops", "")!.status).toBe(404)

  const oa = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"gh\",\"connection_type\":\"http\",\"connection_string\":\"https://gh.example/mcp\",\"auth\":{\"type\":\"oauth\",\"authorize_url\":\"https://gh.example/authorize\",\"token_url\":\"https://gh.example/token\"}}")!
  expect(oa.status).toBe(201)
  expect(oauthConfigRoute(s, "GET", "/api/oauth/config/gh/status")!.body).toBe("{\"id\":\"gh\",\"status\":\"pending\"}")
  expect(oauthConfigRoute(s, "GET", "/api/oauth/config/fs/status")!.status).toBe(404)
  expect(oauthConfigRoute(s, "DELETE", "/api/oauth/config/gh")!.status).toBe(200)
  expect(oauthConfigRoute(s, "POST", "/api/oauth/config/gh/status")!.status).toBe(405)

  const bad = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"api\",\"connection_type\":\"openapi\",\"openapi_config\":{\"spec\":\"{\\\"swagger\\\":\\\"2.0\\\"}\"}}")!
  expect(bad.status).toBe(400)
  const none = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"api\",\"connection_type\":\"openapi\"}")!
  expect(none.status).toBe(400)
  cleanupFile(s.path)
})

test("per_user_headers clients name their header keys and carry no auth", () => {
  const s = fixture()
  const none = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"tenant\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"per_user_headers\"}")!
  expect(none.status).toBe(400)
  expect(none.body.includes("per_user_header_keys is required")).toBe(true)
  const both = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"tenant\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"per_user_headers\",\"per_user_header_keys\":[\"X-Tenant-Key\"],\"auth\":{\"type\":\"bearer\",\"token\":\"tok-123456789\"}}")!
  expect(both.status).toBe(400)
  const stdio = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"tenant\",\"connection_type\":\"stdio\",\"stdio_config\":{\"command\":\"x\"},\"auth_type\":\"per_user_headers\",\"per_user_header_keys\":[\"x\"]}")!
  expect(stdio.status).toBe(400)
  const oauth = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"tenant\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"per_user_oauth\"}")!
  expect(oauth.status).toBe(400)
  const ok = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"tenant\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"per_user_headers\",\"per_user_header_keys\":[\"X-Tenant-Key\", \"x-tenant-key\"]}")!
  expect(ok.status).toBe(201)
  expect(ok.body.includes("\"auth_type\":\"per_user_headers\"")).toBe(true)
  expect(ok.body.includes("\"per_user_header_keys\":[\"x-tenant-key\"]")).toBe(true)
  expect(clientsOf(s.cfg)[2]!.auth === undefined).toBe(true)
  cleanupFile(s.path)
})

test("per-user headers: flows are opened per key, read, and revoked with their pending submissions", () => {
  const s = fixture()
  mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"tenant\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"per_user_headers\",\"per_user_header_keys\":[\"x-tenant-key\"]}")
  expect(mcpApi(s, "POST", "/api/mcp/per-user-headers/flows", "{\"mcp_client_name\":\"fs\",\"virtual_key_id\":\"vk1\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/per-user-headers/flows", "{\"mcp_client_name\":\"tenant\",\"virtual_key_id\":\"nope\"}")!.status).toBe(404)
  expect(mcpApi(s, "POST", "/api/mcp/per-user-headers/flows", "{\"mcp_client_name\":\"nope\",\"virtual_key_id\":\"vk1\"}")!.status).toBe(404)
  expect(mcpApi(s, "POST", "/api/mcp/per-user-headers/flows", "{\"mcp_client_name\":\"tenant\"}")!.status).toBe(400)
  const f = mcpApi(s, "POST", "/api/mcp/per-user-headers/flows", "{\"mcp_client_name\":\"tenant\",\"virtual_key_id\":\"vk1\"}")!
  expect(f.status).toBe(201)
  const id = f.body.slice(7).slice(0, f.body.slice(7).indexOf('\"'))
  const again = mcpApi(s, "POST", "/api/mcp/per-user-headers/flows", "{\"mcp_client_name\":\"tenant\",\"virtual_key_id\":\"vk1\"}")!
  expect(again.body.includes('\"id\":\"' + id + '\"')).toBe(true)
  expect(s.cfg.mcp!.header_flows!.length).toBe(1)
  const d = mcpApi(s, "GET", "/api/mcp/per-user-headers/flows/" + id, "")!
  expect(d.status).toBe(200)
  expect(d.body.includes("\"required_header_keys\":[\"x-tenant-key\"]")).toBe(true)
  expect(d.body.includes("\"has_active_credential\":false")).toBe(true)
  expect(mcpApi(s, "GET", "/api/mcp/per-user-headers/flows/nope", "")!.status).toBe(404)
  expect(mcpApi(s, "PATCH", "/api/mcp/per-user-headers/flows/" + id, "")!.status).toBe(405)
  // a stored submission shows as submitted, and revoking it clears the key's pending flows
  s.cfg.mcp!.user_credentials = [{ id: "uc1", mcp_client_name: "tenant", virtual_key_id: "vk1", headers: oneEntry("x-tenant-key", "tenant-a-key-example"), updated_at: 1.0 }]
  const d2 = mcpApi(s, "GET", "/api/mcp/per-user-headers/flows/" + id, "")!
  expect(d2.body.includes("\"submitted_keys\":[\"x-tenant-key\"]")).toBe(true)
  expect(d2.body.includes("tenant-a-key-example")).toBe(false)
  expect(mcpApi(s, "DELETE", "/api/mcp/per-user-headers/credential/nope", "")!.status).toBe(404)
  expect(mcpApi(s, "DELETE", "/api/mcp/per-user-headers/credential/uc1", "")!.status).toBe(200)
  expect(s.cfg.mcp!.user_credentials!.length).toBe(0)
  expect(mcpApi(s, "GET", "/api/mcp/per-user-headers/flows/" + id, "")!.status).toBe(404)
  cleanupFile(s.path)
})

test("per_user_oauth clients need an oauth registration over http or sse", () => {
  const s = fixture()
  const bare = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"po\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"per_user_oauth\"}")!
  expect(bare.status).toBe(400)
  expect(bare.body.includes("needs an auth object of type oauth")).toBe(true)
  const bearer = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"po\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"per_user_oauth\",\"auth\":{\"type\":\"bearer\",\"token\":\"tok-123456789\"}}")!
  expect(bearer.status).toBe(400)
  const ok = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"po\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"per_user_oauth\",\"auth\":{\"type\":\"oauth\",\"client_id\":\"cid\",\"authorize_url\":\"https://auth.example/authorize\",\"token_url\":\"https://auth.example/token\"}}")!
  expect(ok.status).toBe(201)
  expect(ok.body.includes("\"auth_type\":\"per_user_oauth\"")).toBe(true)
  cleanupFile(s.path)
})

// The OAuth registration of a client in the store's config, by name.
function registrationOf(s: ConfigStore, name: string): McpAuthConfig {
  for (const c of clientsOf(s.cfg)) {
    if (c.name === name) return c.auth!
  }
  return { type: "oauth" }
}

test("per-user flows answer their start URL, sessions list, reauth and revoke", () => {
  const s = fixture()
  mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"po\",\"connection_type\":\"http\",\"connection_string\":\"http://127.0.0.1:1/mcp\",\"auth_type\":\"per_user_oauth\",\"auth\":{\"type\":\"oauth\",\"client_id\":\"cid\",\"authorize_url\":\"https://auth.example/authorize\",\"token_url\":\"https://auth.example/token\"}}")
  const started = startUserFlow(registrationOf(s, "po"), "po", "vk-flow", "", "http://gw.example", true, Date.now())
  const f = started.flow!
  expect(started.error).toBe("")
  const st = perUserApi(s, "GET", "/api/oauth/per-user/flows/" + f.id + "/start", "", "")!
  expect(st.status).toBe(200)
  expect(st.body.includes("code_challenge_method=S256")).toBe(true)
  expect(st.body.includes("state=" + f.state)).toBe(true)
  const det = perUserApi(s, "GET", "/api/oauth/per-user/flows/" + f.id, "", "")!
  expect(det.body.includes("\"status\":\"pending\"")).toBe(true)
  expect(perUserApi(s, "GET", "/api/oauth/per-user/flows/nope/start", "", "")!.status).toBe(404)
  expect(perUserApi(s, "DELETE", "/api/oauth/per-user/flows/" + f.id, "", "")!.status).toBe(405)
  const listed = perUserApi(s, "GET", "/api/mcp/sessions?kind=flow", "", "")!
  expect(listed.body.includes("\"id\":\"" + f.id + "\"")).toBe(true)
  const row: McpUserToken = { id: "ut-t1", mcp_client_name: "po", virtual_key_id: "vk-flow", session_id: "", access_token: "at-1", refresh_token: "rt-1", token_expires_at: Date.now() + 3600000.0, scopes: [], created_at: Date.now(), last_refreshed_at: Date.now() }
  saveUserToken(s, row)
  expect(s.cfg.mcp!.user_tokens!.length).toBe(1)
  const all = perUserApi(s, "GET", "/api/mcp/sessions", "", "")!
  expect(all.body.includes("\"kind\":\"token\"")).toBe(true)
  expect(all.body.includes("\"status\":\"active\"")).toBe(true)
  expect(all.body.includes("at-1")).toBe(false)
  const re = perUserApi(s, "POST", "/api/mcp/sessions/ut-t1/reauth", "", "http://gw.example")!
  expect(re.status).toBe(200)
  expect(re.body.includes("/workspace/mcp-sessions/auth?flow=")).toBe(true)
  const del = perUserApi(s, "DELETE", "/api/mcp/sessions/ut-t1", "", "")!
  expect(del.status).toBe(200)
  expect(s.cfg.mcp!.user_tokens!.length).toBe(0)
  expect(perUserApi(s, "DELETE", "/api/mcp/sessions/ut-t1", "", "")!.status).toBe(404)
  expect(perUserApi(s, "POST", "/api/mcp/sessions/ut-t1/reauth", "", "")!.status).toBe(404)
  expect(perUserApi(s, "GET", "/api/mcp/clients", "", "")).toBe(undefined)
  cleanupFile(s.path)
})

