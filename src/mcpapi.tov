// Bifrost's MCP management API: /api/mcp/clients, /api/mcp/client and /api/mcp/virtual-mcps.
// Client configs live in cfg.mcp.client_configs and virtual MCPs in cfg.virtual_mcps, so each
// write edits the config, saves it and hands it to the lead through onChange, as ConfigStore
// does for its own writes. A client's id is its name (its tools are served as "<name>-<tool>"),
// and a virtual MCP's id is its name too. Secrets are masked on every read, and a masked value
// sent back unchanged keeps the stored secret. Reconnect and refresh need the live manager, so
// they come back as an action for the lead to run on it.
import { readFileSync, unlinkSync } from "node:fs"
import { Config } from "./config"
import { ConfigStore, maskSecret, randomId } from "./store"
import { McpAuthConfig, AuthEndpoints, discoveryUrls, registrationRequest, registrationResult, parseAuthEndpoints, codeTokenRequest, authorizeUrl, pkceVerifier, pkceChallenge, tokenFields } from "./mcpauth"
import { deadline } from "./deadline"
import { secureHex } from "./crypto"
import { McpClientConfig, McpConfig, McpTlsConfig, sanitizeName, durationMsOf } from "./mcp"
import { OpenApiConfig, OpenApiCred, OpenApiDoc, OpenApiOp, OpScheme, parseSpec, inputSchema } from "./openapi"
import * as vmcp from "./vmcp"
import { Field, fields, elements, find, quote, rawStr, rawNum, rawBool } from "./json"

// The reply. action asks the lead to run a step on the live manager after sending body:
// "reconnect" or "refresh" for the client named by id. For a refresh the lead answers with
// the tool count itself.
export type McpReply = { status: int, body: string, action?: "reconnect" | "refresh", id?: string }

type ClientBody = {
  name?: string,
  connection_type?: string,
  connection_string?: string,
  auth_type?: string,
  headers?: Map<string, string>,
  auth?: McpAuthConfig,
  stdio_config?: { command: string, args?: string[], env?: Map<string, string>, cwd?: string },
  tools_to_execute?: string[],
  tools_to_skip?: string[],
  tools_to_auto_execute?: string[],
  allow_by_default?: bool,
  allow_on_all_virtual_keys?: bool,
  disabled?: bool,
  tool_sync_interval?: string,
  tls_config?: McpTlsConfig,
  is_ping_available?: bool,
  needs_session_stickiness?: bool,
  allowed_extra_headers?: string[],
  openapi_config?: OpenApiConfig,
}

// A tool in a virtual MCP's tools: Bifrost's {mcp_client_id, tool_names} or Raiju's native form.
type ToolBody = { mcp_client_id?: string, tool_names?: string[], source?: string, as?: string, description?: string, defaults?: string }

type VmcpBody = { name?: string, endpoint_slug?: string, description?: string, enabled?: bool }

// The JSON kind each body field must have: s string, b bool, a array, o object.
const CLIENT_KINDS: string[] = ["name:s", "connection_type:s", "connection_string:s", "auth_type:s", "headers:o", "auth:o", "stdio_config:o", "tools_to_execute:a", "tools_to_skip:a", "tools_to_auto_execute:a", "allow_by_default:b", "allow_on_all_virtual_keys:b", "disabled:b", "tool_sync_interval:s", "tls_config:o", "is_ping_available:b", "needs_session_stickiness:b", "allowed_extra_headers:a", "tool_pricing:o", "openapi_config:o"]
const VMCP_KINDS: string[] = ["name:s", "endpoint_slug:s", "description:s", "enabled:b", "tools:a"]
const TOOL_KINDS: string[] = ["mcp_client_id:s", "tool_names:a", "source:s", "as:s", "description:s", "defaults:s"]
const CONNECT_MS = 15000
const VERIFY_ROUTES: string[] =["complete-oauth", "initiate-verification", "reauthorize", "reregister", "verify-headers", "verify-exchange"]

function reply(status: int, body: string): McpReply {
  return { status: status, body: body }
}

function errorBody(message: string): string {
  return JSON.stringify({ error: { message: message } })
}

function fail(status: int, message: string): McpReply {
  return reply(status, errorBody(message))
}

function notAllowed(method: string): McpReply {
  return fail(405, `method ${method} is not allowed on this route`)
}

// The fields of a JSON object given as text, or undefined when the text is not one.
function objectFields(text: string): Field[] | undefined {
  const t = text.trim()
  if (!t.startsWith("{")) return undefined
  try {
    if (elements(`[${t}]`).length !== 1) return undefined
    return fields(t)
  } catch (e) {
    return undefined
  }
}

// Whether a field is present and not null.
function has(fs: Field[], key: string): bool {
  const r = find(fs, key)
  return r !== undefined && r !== "null"
}

// The value when the field is present, else undefined: a JSON null counts as absent.
function present<T>(fs: Field[], key: string, v: T | undefined): T | undefined {
  return has(fs, key) ? v : undefined
}

// Whether a field, when present and not null, has the JSON kind named by kind.
function kindOk(fs: Field[], key: string, kind: string): bool {
  const r = find(fs, key)
  if (r === undefined || r === "null") return true
  if (kind === "s") return r.startsWith("\"")
  if (kind === "b") return r === "true" || r === "false"
  if (kind === "a") return r.startsWith("[")
  return r.startsWith("{")
}

function kindsOk(fs: Field[], spec: string[]): bool {
  for (const s of spec) {
    const parts = s.split(":")
    if (!kindOk(fs, parts[0]!, parts[1]!)) return false
  }
  return true
}

// Whether a raw array holds only strings, and a raw object only string values.
function strArrayOk(raw: string | undefined): bool {
  if (raw === undefined || raw === "null") return true
  if (!raw.startsWith("[")) return false
  try {
    for (const el of elements(raw)) {
      if (!el.startsWith("\"")) return false
    }
    return true
  } catch (e) {
    return false
  }
}

function strMapOk(raw: string | undefined): bool {
  if (raw === undefined || raw === "null") return true
  const fs = objectFields(raw)
  if (fs === undefined) return false
  for (const f of fs) {
    if (!f.raw.startsWith("\"")) return false
  }
  return true
}

// The request body's fields when the body is a JSON object of the right kinds, else undefined.
function checkedFields(body: string, spec: string[]): Field[] | undefined {
  const fs = objectFields(body)
  if (fs === undefined || !kindsOk(fs, spec)) return undefined
  return fs
}

function clientsOf(c: Config): McpClientConfig[] {
  const m = c.mcp
  if (m === undefined || m.client_configs === undefined) return []
  return m.client_configs
}

function virtualsOf(c: Config): vmcp.VirtualMcp[] {
  return c.virtual_mcps ?? []
}

function clientIndex(list: McpClientConfig[], name: string): int {
  for (let i = 0; i < list.length; i++) {
    if (list[i]!.name === name) return i
  }
  return -1
}

function virtualIndex(list: vmcp.VirtualMcp[], name: string): int {
  for (let i = 0; i < list.length; i++) {
    if (list[i]!.name === name) return i
  }
  return -1
}

function virtualKeyIds(c: Config): string[] {
  const out: string[] = []
  for (const vk of c.governance?.virtual_keys ?? []) out.push(vk.id)
  return out
}

// Writes next as the config and notifies the lead, as ConfigStore does. A failed save keeps
// the previous config, so memory never differs from the file.
function persist(store: ConfigStore, next: Config): McpReply | undefined {
  const prev = store.cfg
  store.cfg = next
  try {
    store.save()
  } catch (e) {
    store.cfg = prev
    return fail(500, `could not save config: ${e.message}`)
  }
  store.version += 1
  const f = store.onChange
  if (f !== undefined) f(next)
  return undefined
}

function withClients(c: Config, list: McpClientConfig[]): Config {
  let n = c
  let m: McpConfig = n.mcp ?? {}
  m.client_configs = list
  n.mcp = m
  return n
}

function withVirtuals(c: Config, list: vmcp.VirtualMcp[]): Config {
  let n = c
  n.virtual_mcps = list
  return n
}

// ---- secrets ----

function maskMap(m: Map<string, string> | undefined): Map<string, string> | undefined {
  if (m === undefined) return undefined
  const out: Map<string, string> = new Map()
  for (const k of m.keys()) out.set(k, maskSecret(m.get(k)!))
  return out
}

function maskOpt(v: string | undefined): string | undefined {
  return v === undefined ? undefined : maskSecret(v)
}

// A masked value sent back unchanged keeps the stored one (prev, when there is one).
function keepStr(v: string, prev: string | undefined): string {
  if (prev !== undefined && v === maskSecret(prev)) return prev
  return v
}

function keepOpt(v: string | undefined, prev: string | undefined): string | undefined {
  if (v === undefined) return undefined
  return keepStr(v, prev)
}

function keepMap(incoming: Map<string, string> | undefined, old: Map<string, string> | undefined): Map<string, string> | undefined {
  if (incoming === undefined) return undefined
  const out: Map<string, string> = new Map()
  for (const k of incoming.keys()) {
    const prev: string | undefined = old === undefined ? undefined : old.get(k)
    out.set(k, keepStr(incoming.get(k)!, prev))
  }
  return out
}

function keepAuth(incoming: McpAuthConfig, old: McpAuthConfig | undefined): McpAuthConfig {
  let n = incoming
  const oh: Map<string, string> | undefined = old === undefined ? undefined : old.headers
  n.headers = keepMap(n.headers, oh)
  n.token = keepOpt(n.token, old === undefined ? undefined : old.token)
  n.client_secret = keepOpt(n.client_secret, old === undefined ? undefined : old.client_secret)
  n.refresh_token = keepOpt(n.refresh_token, old === undefined ? undefined : old.refresh_token)
  n.access_token = keepOpt(n.access_token, old === undefined ? undefined : old.access_token)
  // an authorization code client keeps what its flow saved (endpoints, the registered client, tokens) unless the body sends a value
  if (n.type === "oauth" && old !== undefined && old.type === "oauth") {
    n.authorize_url = n.authorize_url ?? old.authorize_url
    n.token_url = n.token_url ?? old.token_url
    n.registration_url = n.registration_url ?? old.registration_url
    n.client_id = n.client_id ?? old.client_id
    n.client_secret = n.client_secret ?? old.client_secret
    n.access_token = n.access_token ?? old.access_token
    n.refresh_token = n.refresh_token ?? old.refresh_token
    n.token_expires_at = n.token_expires_at ?? old.token_expires_at
  }
  return n
}

// A client with its secrets masked: header values, auth secrets and stdio env values.
function redactClient(c: McpClientConfig): McpClientConfig {
  let n = c
  n.headers = maskMap(n.headers)
  const a = n.auth
  if (a !== undefined) {
    let na = a
    na.headers = maskMap(na.headers)
    na.token = maskOpt(na.token)
    na.client_secret = maskOpt(na.client_secret)
    na.refresh_token = maskOpt(na.refresh_token)
    na.access_token = maskOpt(na.access_token)
    n.auth = na
  }
  const sc = n.stdio_config
  if (sc !== undefined) {
    let ns = sc
    ns.env = maskMap(ns.env)
    n.stdio_config = ns
  }
  const oc = n.openapi_config
  if (oc !== undefined) {
    let no = oc
    no.security_credentials = maskCreds(no.security_credentials)
    n.openapi_config = no
  }
  return n
}

// The security credentials of an openapi client with their secrets masked.
function maskCreds(m: Map<string, OpenApiCred> | undefined): Map<string, OpenApiCred> | undefined {
  if (m === undefined) return undefined
  const out: Map<string, OpenApiCred> = new Map()
  for (const k of m.keys()) {
    const c = m.get(k)!
    out.set(k, { value: maskOpt(c.value), username: c.username, password: maskOpt(c.password) })
  }
  return out
}

// An openapi_config update: a masked secret sent back unchanged keeps the stored one.
function keepOpenApi(incoming: OpenApiConfig | undefined, old: OpenApiConfig | undefined): OpenApiConfig | undefined {
  if (incoming === undefined) return undefined
  let n = incoming
  const oldCreds = old === undefined ? undefined : old.security_credentials
  if (n.security_credentials !== undefined) {
    const out: Map<string, OpenApiCred> = new Map()
    for (const k of n.security_credentials.keys()) {
      const c = n.security_credentials.get(k)!
      const prev = oldCreds === undefined ? undefined : oldCreds.get(k)
      const value = keepOpt(c.value, prev === undefined ? undefined : prev.value)
      const password = keepOpt(c.password, prev === undefined ? undefined : prev.password)
      out.set(k, { value: value, username: c.username, password: password })
    }
    n.security_credentials = out
  }
  return n
}

// One client's JSON: its stored fields, secrets masked, with client_id (its name) first.
function clientJson(c: McpClientConfig): string {
  const j = JSON.stringify(redactClient(c))
  return `{"client_id":${quote(c.name)},${j.slice(1)}`
}

// ---- clients ----

// Bifrost's name rules for a client: ASCII, no hyphens or spaces, not starting with a digit.
function clientNameError(name: string): string {
  if (name.trim() === "") return "name is required for MCP client"
  // every ASCII character is one byte, so any longer byte count means a non-ASCII one
  if (name.byteLength !== name.chars().length) return "name must contain only ASCII characters"
  if (name.includes("-")) return "name cannot contain hyphens"
  if (name.includes(" ")) return "name cannot contain spaces"
  if ("0123456789".includes(name.slice(0, 1))) return "name cannot start with a number"
  return ""
}

const AUTH_TYPES: string[] = ["none", "bearer", "headers", "oauth_client_credentials", "oauth_refresh_token", "oauth"]

// The auth object must have a type this gateway knows. "" when fine or absent.
function authError(a: McpAuthConfig | undefined): string {
  if (a === undefined) return ""
  if (!AUTH_TYPES.includes(a.type)) return `auth.type "${a.type}" must be one of ${AUTH_TYPES.join(", ")}`
  return ""
}

// The connection fields a new client needs for its transport. "" when fine.
function connectionError(b: ClientBody, ct: string): string {
  if (ct === "openapi") {
    const oc = b.openapi_config
    if (oc === undefined || ((oc.spec ?? "") === "" && (oc.spec_url ?? "") === "")) return "openapi_config needs spec or spec_url for openapi connections"
    if ((b.connection_string ?? "") !== "") return "connection_string must not be set for openapi connections"
    return ""
  }
  if (ct === "stdio") {
    if ((b.stdio_config?.command ?? "") === "") return "stdio_config.command is required for stdio connections"
    if ((b.connection_string ?? "") !== "") return "connection_string must not be set for stdio connections"
    return ""
  }
  const url = b.connection_string ?? ""
  if (url === "") return "connection_string is required for http and sse connections"
  if (!url.startsWith("http://") && !url.startsWith("https://")) return "connection_string must be an http or https URL"
  return ""
}

// A Go duration in whole seconds, as Bifrost takes tool_sync_interval: "0", "90s", "10m", "1h30m".
function durationError(s: string): string {
  const bad = "tool_sync_interval must be 0 or a positive duration in whole seconds, such as \"10m\" or \"90s\""
  if (s === "0") return ""
  let digits = ""
  let last: int = 0
  for (const ch of s.chars()) {
    if ("0123456789".includes(ch)) {
      digits += ch
      continue
    }
    const rank: int = ch === "h" ? 1 : ch === "m" ? 2 : ch === "s" ? 3 : 0
    if (rank === 0 || digits === "" || rank <= last) return bad
    last = rank
    digits = ""
  }
  if (digits !== "" || last === 0) return bad
  return ""
}

// The allow flag: allow_by_default decides, else the older allow_on_all_virtual_keys, else existing.
function allowFlag(fs: Field[], b: ClientBody, existing: bool): bool {
  if (has(fs, "allow_by_default")) return b.allow_by_default ?? existing
  if (has(fs, "allow_on_all_virtual_keys")) return b.allow_on_all_virtual_keys ?? existing
  return existing
}

// The body with every optional field that is null treated as absent.
function clientFields(fs: Field[], b: ClientBody): ClientBody {
  let n = b
  n.name = present(fs, "name", n.name)
  n.connection_type = present(fs, "connection_type", n.connection_type)
  n.connection_string = present(fs, "connection_string", n.connection_string)
  n.auth_type = present(fs, "auth_type", n.auth_type)
  n.headers = present(fs, "headers", n.headers)
  n.auth = present(fs, "auth", n.auth)
  n.stdio_config = present(fs, "stdio_config", n.stdio_config)
  n.tools_to_execute = present(fs, "tools_to_execute", n.tools_to_execute)
  n.tools_to_skip = present(fs, "tools_to_skip", n.tools_to_skip)
  n.tools_to_auto_execute = present(fs, "tools_to_auto_execute", n.tools_to_auto_execute)
  n.allow_by_default = present(fs, "allow_by_default", n.allow_by_default)
  n.allow_on_all_virtual_keys = present(fs, "allow_on_all_virtual_keys", n.allow_on_all_virtual_keys)
  n.disabled = present(fs, "disabled", n.disabled)
  n.tool_sync_interval = present(fs, "tool_sync_interval", n.tool_sync_interval)
  n.tls_config = present(fs, "tls_config", n.tls_config)
  n.is_ping_available = present(fs, "is_ping_available", n.is_ping_available)
  n.needs_session_stickiness = present(fs, "needs_session_stickiness", n.needs_session_stickiness)
  n.allowed_extra_headers = present(fs, "allowed_extra_headers", n.allowed_extra_headers)
  n.openapi_config = present(fs, "openapi_config", n.openapi_config)
  return n
}

// tool_execution_timeout: a Go duration string, or a bare number of seconds (Bifrost takes both).
// The stored form is always a duration string. error is "" when fine or absent.
function timeoutFrom(fs: Field[]): { value: string | undefined, error: string } {
  const raw = find(fs, "tool_execution_timeout")
  if (raw === undefined || raw === "null") return { value: undefined, error: "" }
  const bad = "tool_execution_timeout must be a duration such as \"30s\" or \"2m\", or a number of seconds"
  if (!raw.startsWith("\"")) {
    const n = rawNum(fs, "tool_execution_timeout") ?? 0.0
    if (n <= 0.0) return { value: undefined, error: bad }
    return { value: `${Math.floor(n)}s`, error: "" }
  }
  const s = rawStr(fs, "tool_execution_timeout") ?? ""
  if (durationMsOf(s) <= 0) return { value: undefined, error: bad }
  return { value: s, error: "" }
}

// tool_pricing: an object of costs per tool, each at least 0. error is "" when fine or absent.
function pricingFrom(fs: Field[]): { value: Map<string, f64> | undefined, error: string } {
  const raw = find(fs, "tool_pricing")
  if (raw === undefined || raw === "null") return { value: undefined, error: "" }
  const inner = objectFields(raw)
  if (inner === undefined) return { value: undefined, error: "tool_pricing must be an object of costs per tool" }
  const out: Map<string, f64> = new Map()
  for (const f of inner) {
    const n = parseFloat(f.raw)
    if (n === undefined || n < 0.0) return { value: undefined, error: `tool_pricing "${f.key}" must be a number of at least 0` }
    out.set(f.key, n)
  }
  return { value: out, error: "" }
}

function listClients(store: ConfigStore): McpReply {
  const list = clientsOf(store.cfg)
  const parts: string[] = []
  for (const c of list) parts.push(clientJson(c))
  return reply(200, `{"clients":[${parts.join(",")}],"count":${list.length},"total_count":${list.length}}`)
}

function createClient(store: ConfigStore, body: string, publicOnly: bool): McpReply {
  const fs = checkedFields(body, CLIENT_KINDS)
  if (fs === undefined || !strArrayOk(find(fs, "tools_to_execute")) || !strArrayOk(find(fs, "tools_to_skip")) || !strArrayOk(find(fs, "tools_to_auto_execute")) || !strArrayOk(find(fs, "allowed_extra_headers")) || !strMapOk(find(fs, "headers"))) {
    return fail(400, "Invalid request payload")
  }
  let parsed: ClientBody = {}
  try {
    parsed = JSON.parse(body) as ClientBody
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const b = clientFields(fs, parsed)
  const name = b.name ?? ""
  const nameProblem = clientNameError(name)
  if (nameProblem !== "") return fail(400, `Invalid client name: ${nameProblem}`)
  const list = clientsOf(store.cfg)
  if (clientIndex(list, name) >= 0 || virtualIndex(virtualsOf(store.cfg), name) >= 0) {
    return fail(409, "an MCP client or virtual MCP with this name already exists")
  }
  const ct = b.connection_type ?? ""
  if (ct !== "http" && ct !== "sse" && ct !== "stdio" && ct !== "openapi") return fail(400, `Invalid connection_type "${ct}": must be one of http, sse, stdio, openapi`)
  // an inline spec is checked now; a spec_url is fetched when the client connects
  const specText = b.openapi_config?.spec ?? ""
  if (specText !== "") {
    try {
      parseSpec(specText, b.openapi_config?.include_deprecated === true)
    } catch (e) {
      return fail(400, `openapi_config.spec: ${e.message}`)
    }
  }
  const auth = b.auth_type ?? "none"
  if (auth !== "none" && auth !== "headers") return fail(400, `auth_type "${auth}" is not supported by this gateway: use none or headers`)
  const cp = connectionError(b, ct)
  if (cp !== "") return fail(400, cp)
  const ae = authError(b.auth)
  if (ae !== "") return fail(400, ae)
  const syncErr = durationError(b.tool_sync_interval ?? "0")
  if (syncErr !== "") return fail(400, syncErr)
  const to = timeoutFrom(fs)
  if (to.error !== "") return fail(400, to.error)
  const pr = pricingFrom(fs)
  if (pr.error !== "") return fail(400, pr.error)
  // Bifrost: a new http client connects fresh for each call unless it says it needs a session
  const sticky = rawBool(fs, "needs_session_stickiness")
  if (ct !== "http" && sticky === false) return fail(400, "needs_session_stickiness false applies only to http connections: sse and stdio stay sticky")

  let c: McpClientConfig = { name: name, connection_type: ct }
  if (ct === "openapi") c.openapi_config = b.openapi_config
  c.tool_execution_timeout = to.value
  c.is_ping_available = b.is_ping_available ?? true
  c.needs_session_stickiness = ct === "http" ? (sticky ?? false) : undefined
  c.allowed_extra_headers = b.allowed_extra_headers
  c.tool_pricing = pr.value
  // registered while dashboard auth is off: every dial must reach a public address
  c.require_public_target = publicOnly ? true : undefined
  if (ct === "http" || ct === "sse") c.connection_string = b.connection_string
  c.headers = b.headers
  c.auth = b.auth
  c.stdio_config = b.stdio_config
  c.tools_to_execute = b.tools_to_execute
  c.tools_to_skip = b.tools_to_skip
  c.tools_to_auto_execute = b.tools_to_auto_execute
  c.allow_by_default = allowFlag(fs, b, false)
  c.disabled = b.disabled
  c.tool_sync_interval = b.tool_sync_interval
  c.tls_config = b.tls_config

  let next: McpClientConfig[] = list
  next.push(c)
  const err = persist(store, withClients(store.cfg, next))
  if (err !== undefined) return err
  return reply(201, clientJson(c))
}

function updateClient(store: ConfigStore, id: string, body: string, publicOnly: bool): McpReply {
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, "MCP client not found")
  const fs = checkedFields(body, CLIENT_KINDS)
  if (fs === undefined || !strArrayOk(find(fs, "tools_to_execute")) || !strArrayOk(find(fs, "tools_to_skip")) || !strArrayOk(find(fs, "tools_to_auto_execute")) || !strArrayOk(find(fs, "allowed_extra_headers")) || !strMapOk(find(fs, "headers"))) {
    return fail(400, "Invalid request payload")
  }
  let parsed: ClientBody = {}
  try {
    parsed = JSON.parse(body) as ClientBody
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const b = clientFields(fs, parsed)
  // The name is the id and the prefix of every tool name a virtual MCP uses, so it stays.
  if (b.name !== undefined && b.name !== id) return fail(400, "renaming an MCP client is not supported: its name prefixes its tools in virtual MCPs")
  if (has(fs, "tool_sync_interval")) {
    const syncErr = durationError(b.tool_sync_interval ?? "")
    if (syncErr !== "") return fail(400, syncErr)
  }
  const ae = authError(b.auth)
  if (ae !== "") return fail(400, ae)

  const cur = list[at]!
  let c = cur
  if (has(fs, "tool_execution_timeout")) {
    const to = timeoutFrom(fs)
    if (to.error !== "") return fail(400, to.error)
    c.tool_execution_timeout = to.value
  }
  if (has(fs, "tool_pricing")) {
    const pr = pricingFrom(fs)
    if (pr.error !== "") return fail(400, pr.error)
    c.tool_pricing = pr.value
  }
  if (has(fs, "needs_session_stickiness")) {
    const sticky = rawBool(fs, "needs_session_stickiness")
    if ((c.connection_type ?? "") !== "http" && sticky === false) return fail(400, "needs_session_stickiness false applies only to http connections: sse and stdio stay sticky")
    c.needs_session_stickiness = sticky
  }
  if (has(fs, "openapi_config")) {
    if (c.connection_type !== "openapi") return fail(400, "openapi_config applies only to openapi connections")
    c.openapi_config = keepOpenApi(b.openapi_config, c.openapi_config)
  }
  if (has(fs, "is_ping_available")) c.is_ping_available = b.is_ping_available
  if (has(fs, "allowed_extra_headers")) c.allowed_extra_headers = b.allowed_extra_headers
  // can be turned on, never off (Bifrost's require_public_target)
  if (publicOnly) c.require_public_target = true
  if (has(fs, "disabled")) c.disabled = b.disabled
  if (has(fs, "allow_by_default") || has(fs, "allow_on_all_virtual_keys")) c.allow_by_default = allowFlag(fs, b, c.allow_by_default ?? false)
  if (has(fs, "tools_to_execute")) c.tools_to_execute = b.tools_to_execute
  if (has(fs, "tools_to_skip")) c.tools_to_skip = b.tools_to_skip
  if (has(fs, "tools_to_auto_execute")) c.tools_to_auto_execute = b.tools_to_auto_execute
  if (has(fs, "tool_sync_interval")) c.tool_sync_interval = b.tool_sync_interval
  if (has(fs, "tls_config")) c.tls_config = b.tls_config
  if (has(fs, "headers")) c.headers = keepMap(b.headers, c.headers)
  if (has(fs, "auth")) c.auth = keepAuth(b.auth!, c.auth)

  let next: McpClientConfig[] = list
  next[at] = c
  const err = persist(store, withClients(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, clientJson(c))
}

function deleteClient(store: ConfigStore, id: string): McpReply {
  const list = clientsOf(store.cfg)
  if (clientIndex(list, id) < 0) return fail(404, "MCP client not found")
  let next: McpClientConfig[] = []
  for (const c of list) {
    if (c.name !== id) next.push(c)
  }
  const err = persist(store, withClients(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, `{"status":"success","message":"MCP client removed successfully"}`)
}

// Reconnect and refresh are the manager's work: this checks the client, then hands the step over.
function runClient(store: ConfigStore, id: string, step: string): McpReply {
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, "MCP client not found")
  const c = list[at]!
  if (step === "reconnect") {
    if (c.disabled === true) return fail(400, "cannot reconnect a disabled MCP client: enable the client first")
    return { status: 200, body: `{"status":"success","message":"MCP client reconnected successfully"}`, action: "reconnect", id: id }
  }
  if (c.disabled === true) return fail(400, "cannot refresh tools for a disabled MCP client: enable the client first")
  return { status: 200, body: `{"status":"success","message":"MCP client tools refreshed successfully"}`, action: "refresh", id: id }
}

// The inline OpenAPI document of an openapi client, as it was stored. A spec_url client keeps only the URL.
function openapiSpec(store: ConfigStore, id: string): McpReply {
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, "OpenAPI MCP client not found")
  const c = list[at]!
  const spec = c.openapi_config?.spec ?? ""
  if (c.connection_type !== "openapi" || spec === "") return fail(404, "OpenAPI MCP client not found")
  return reply(200, spec)
}

function clientRoute(store: ConfigStore, m: string, segs: string[], body: string, p: string, publicOnly: bool): McpReply {
  if (segs.length === 3) return m === "POST" ? createClient(store, body, publicOnly) : notAllowed(m)
  const id = segs[3]!
  if (segs.length === 4) {
    if (m === "PUT") return updateClient(store, id, body, publicOnly)
    if (m === "DELETE") return deleteClient(store, id)
    return notAllowed(m)
  }
  if (segs.length !== 5) return fail(404, `no route for ${p}`)
  const sub = segs[4]!
  if (sub === "reconnect" || sub === "refresh-tools") {
    if (m !== "POST") return notAllowed(m)
    return runClient(store, id, sub === "reconnect" ? "reconnect" : "refresh")
  }
  // Bifrost's GET: no client here is an OpenAPI one, so none has a spec to return
  if (sub === "openapi-spec") return m === "GET" ? openapiSpec(store, id) : notAllowed(m)
  if (VERIFY_ROUTES.includes(sub)) return m === "POST" ? verifyRoute(store, id, sub) : notAllowed(m)
  return fail(404, `no route for ${p}`)
}

// The auth type a client is reported under in the verification messages: its auth type, else
// headers or none.
function clientAuthType(c: McpClientConfig): string {
  const t = c.auth?.type
  if (t !== undefined) return t
  return c.headers === undefined ? "none" : "headers"
}

// The verification and reauthorization routes. Bifrost answers each by the auth type of the client:
// OAuth consent (oauth, per_user_oauth), per-user headers and token exchange. Raiju's clients have
// none of those (its OAuth grants are client credentials and refresh tokens), and no OAuth config
// rows exist for complete-oauth to finish, so each route refuses with Bifrost's message.
function verifyRoute(store: ConfigStore, id: string, sub: string): McpReply {
  if (sub === "complete-oauth") return fail(404, "OAuth config not found")
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, `MCP client '${id}' not found`)
  const t = clientAuthType(list[at]!)
  if (sub === "initiate-verification") return fail(400, `initiate-verification only applies to OAuth-based clients (oauth, per_user_oauth), got "${t}"`)
  if (sub === "reauthorize" || sub === "reregister") return fail(400, `reauthorize only applies to OAuth-based clients (oauth, per_user_oauth), got "${t}"`)
  if (sub === "verify-headers") return fail(400, `verify-headers only applies to auth_type='per_user_headers' clients, got "${t}"`)
  return fail(400, `verify-exchange only applies to auth_type='token_exchange' clients, got "${t}"`)
}

// ---- virtual MCPs ----

// The virtual tools a tools list means. A Bifrost spec {mcp_client_id, tool_names} becomes sources
// "<server>-<tool>" (or "<server>-*" for "*"); a native tool {source, as, description, defaults} is
// kept as it is. A source whose server is not a configured client is named in the error.
function virtualTools(raw: string, clients: McpClientConfig[]): { tools: vmcp.VirtualTool[], error: string } {
  let out: vmcp.VirtualTool[] = []
  let unknown: string[] = []
  let els: string[] = []
  try {
    els = elements(raw)
  } catch (e) {
    return { tools: [], error: "tools must be a JSON array" }
  }
  for (const el of els) {
    const fs = objectFields(el)
    if (fs === undefined || !kindsOk(fs, TOOL_KINDS) || !strArrayOk(find(fs, "tool_names"))) return { tools: [], error: "each tool must be a JSON object" }
    let parsed: ToolBody = {}
    try {
      parsed = JSON.parse(el) as ToolBody
    } catch (e) {
      return { tools: [], error: "each tool must be a JSON object" }
    }
    const t: ToolBody = { mcp_client_id: present(fs, "mcp_client_id", parsed.mcp_client_id), tool_names: present(fs, "tool_names", parsed.tool_names), source: present(fs, "source", parsed.source), as: present(fs, "as", parsed.as), description: present(fs, "description", parsed.description), defaults: present(fs, "defaults", parsed.defaults) }
    if (t.mcp_client_id !== undefined) {
      const id = t.mcp_client_id
      const at = clientIndex(clients, id)
      if (at < 0) {
        unknown.push(id)
        continue
      }
      const server = clients[at]!.name
      for (const name of t.tool_names ?? []) {
        out.push({ source: name === "*" ? `${sanitizeName(server)}-*` : sanitizeName(`${server}-${name}`) })
      }
    } else {
      const src = t.source ?? ""
      let vt: vmcp.VirtualTool = { source: src }
      if (t.as !== undefined) vt.as = t.as
      if (t.description !== undefined) vt.description = t.description
      if (t.defaults !== undefined) vt.defaults = t.defaults
      if (src !== "" && !clients.some((c) => src.startsWith(sanitizeName(c.name) + "-"))) unknown.push(src)
      out.push(vt)
    }
  }
  if (unknown.length > 0) return { tools: [], error: "invalid MCP client IDs: " + unknown.join(", ") }
  return { tools: out, error: "" }
}

// One virtual MCP's JSON. virtual_key_ids is who may use it: every key when allowed_keys is unset.
function virtualJson(v: vmcp.VirtualMcp, keyIds: string[]): string {
  const keys = v.allowed_keys ?? keyIds
  const quotedKeys: string[] = []
  for (const k of keys) quotedKeys.push(quote(k))
  const desc = v.description === undefined ? "" : `,"description":${quote(v.description)}`
  return `{"id":${quote(v.name)},"name":${quote(v.name)},"endpoint_slug":${quote(v.name)}${desc},"enabled":true,"tools":${JSON.stringify(v.tools)},"virtual_key_ids":[${quotedKeys.join(",")}]}`
}

function listVirtuals(store: ConfigStore): McpReply {
  const list = virtualsOf(store.cfg)
  const keyIds = virtualKeyIds(store.cfg)
  const parts: string[] = []
  for (const v of list) parts.push(virtualJson(v, keyIds))
  return reply(200, `{"virtual_mcps":[${parts.join(",")}],"count":${list.length},"total_count":${list.length}}`)
}

// Whether a virtual MCP name is taken by another virtual MCP or by an MCP client (they share
// the endpoint namespace). self is the virtual MCP being renamed, which does not count.
function virtualNameTaken(store: ConfigStore, name: string, self: string): bool {
  if (name !== self && virtualIndex(virtualsOf(store.cfg), name) >= 0) return true
  return clientIndex(clientsOf(store.cfg), name) >= 0
}

const NAME_TAKEN = "a virtual MCP with this name or endpoint already exists"

function createVirtual(store: ConfigStore, body: string): McpReply {
  const fs = checkedFields(body, VMCP_KINDS)
  if (fs === undefined) return fail(400, "Invalid request payload")
  let parsed: VmcpBody = {}
  try {
    parsed = JSON.parse(body) as VmcpBody
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const b: VmcpBody = { name: present(fs, "name", parsed.name), endpoint_slug: present(fs, "endpoint_slug", parsed.endpoint_slug), description: present(fs, "description", parsed.description), enabled: present(fs, "enabled", parsed.enabled) }
  const name = b.name ?? ""
  if (name === "") return fail(400, "name is required")
  if (b.endpoint_slug !== undefined && b.endpoint_slug !== name) return fail(400, "endpoint_slug must equal the name: a virtual MCP is served at /mcp/<name>")
  if (b.enabled === false) return fail(400, "enabled: false is not supported: a virtual MCP is always served")
  const shape = vmcp.validate({ name: name, tools: [] })
  if (shape !== "") return fail(400, shape)
  if (virtualNameTaken(store, name, "")) return fail(409, NAME_TAKEN)
  let tools: vmcp.VirtualTool[] = []
  if (has(fs, "tools")) {
    const got = virtualTools(find(fs, "tools")!, clientsOf(store.cfg))
    if (got.error !== "") return fail(400, got.error)
    tools = got.tools
  }
  let v: vmcp.VirtualMcp = { name: name, tools: tools }
  v.description = b.description
  const problem = vmcp.validate(v)
  if (problem !== "") return fail(400, problem)
  let next: vmcp.VirtualMcp[] = virtualsOf(store.cfg)
  next.push(v)
  const err = persist(store, withVirtuals(store.cfg, next))
  if (err !== undefined) return err
  return reply(201, `{"virtual_mcp":${virtualJson(v, virtualKeyIds(store.cfg))}}`)
}

function updateVirtual(store: ConfigStore, id: string, body: string): McpReply {
  const list = virtualsOf(store.cfg)
  const at = virtualIndex(list, id)
  if (at < 0) return fail(404, "virtual MCP not found")
  const fs = checkedFields(body, VMCP_KINDS)
  if (fs === undefined) return fail(400, "Invalid request payload")
  let b: VmcpBody = {}
  try {
    b = JSON.parse(body) as VmcpBody
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  if (b.enabled === false) return fail(400, "enabled: false is not supported: a virtual MCP is always served")
  let v = list[at]!
  if (has(fs, "name") && b.name !== id) {
    const newName = b.name ?? ""
    const shape = vmcp.validate({ name: newName, tools: [] })
    if (shape !== "") return fail(400, shape)
    if (virtualNameTaken(store, newName, id)) return fail(409, NAME_TAKEN)
    v.name = newName
  }
  if (has(fs, "description")) v.description = b.description
  if (has(fs, "tools")) {
    const got = virtualTools(find(fs, "tools")!, clientsOf(store.cfg))
    if (got.error !== "") return fail(400, got.error)
    v.tools = got.tools
  }
  const problem = vmcp.validate(v)
  if (problem !== "") return fail(400, problem)
  let next: vmcp.VirtualMcp[] = list
  next[at] = v
  const err = persist(store, withVirtuals(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, `{"virtual_mcp":${virtualJson(v, virtualKeyIds(store.cfg))}}`)
}

function deleteVirtual(store: ConfigStore, id: string): McpReply {
  const list = virtualsOf(store.cfg)
  if (virtualIndex(list, id) < 0) return fail(404, "virtual MCP not found")
  let next: vmcp.VirtualMcp[] = []
  for (const v of list) {
    if (v.name !== id) next.push(v)
  }
  const err = persist(store, withVirtuals(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, `{"success":true}`)
}

// Attaches or detaches a virtual key. An unset allowed_keys means every key already has it, so
// attaching changes nothing, and detaching lists every other key explicitly.
function setAttached(store: ConfigStore, id: string, vkId: string, attach: bool): McpReply {
  const list = virtualsOf(store.cfg)
  const at = virtualIndex(list, id)
  if (at < 0) return fail(404, "virtual MCP not found")
  if (attach && !virtualKeyIds(store.cfg).includes(vkId)) return fail(404, "virtual key not found")
  let v = list[at]!
  let keys: string[] = v.allowed_keys ?? virtualKeyIds(store.cfg)
  if (attach) {
    if (v.allowed_keys === undefined || keys.includes(vkId)) return reply(200, `{"success":true}`)
    keys.push(vkId)
  } else {
    if (v.allowed_keys === undefined && !keys.includes(vkId)) return reply(200, `{"success":true}`)
    keys = keys.filter((k) => k !== vkId)
  }
  v.allowed_keys = keys
  let next: vmcp.VirtualMcp[] = list
  next[at] = v
  const err = persist(store, withVirtuals(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, `{"success":true}`)
}

function virtualRoute(store: ConfigStore, m: string, segs: string[], body: string, p: string): McpReply {
  if (segs.length === 3) {
    if (m === "GET") return listVirtuals(store)
    if (m === "POST") return createVirtual(store, body)
    return notAllowed(m)
  }
  const id = segs[3]!
  if (segs.length === 4) {
    if (m === "GET") {
      const at = virtualIndex(virtualsOf(store.cfg), id)
      if (at < 0) return fail(404, "virtual MCP not found")
      return reply(200, `{"virtual_mcp":${virtualJson(virtualsOf(store.cfg)[at]!, virtualKeyIds(store.cfg))}}`)
    }
    if (m === "PUT") return updateVirtual(store, id, body)
    if (m === "DELETE") return deleteVirtual(store, id)
    return notAllowed(m)
  }
  if (segs.length === 6 && segs[4] === "virtual-keys") {
    if (m === "POST") return setAttached(store, id, segs[5]!, true)
    if (m === "DELETE") return setAttached(store, id, segs[5]!, false)
    return notAllowed(m)
  }
  return fail(404, `no route for ${p}`)
}

// ---- OpenAPI preview: POST /api/mcp/openapi/preview ----

// The preview of a document: its info, servers and security schemes, and the tool each operation makes.
function previewJson(text: string, includeDeprecated: bool, base: string): string throws SyntaxError {
  const doc = try parseSpec(text, includeDeprecated)
  const servers: string[] = doc.servers.map((s: string): string => quote(s))
  const resolved = base !== "" ? base : doc.servers.length > 0 ? doc.servers[0]! : ""
  const schemes: string[] = doc.schemes.map((s: OpScheme): string => `{"name":${quote(s.name)},"type":${quote(s.type)},"in":${quote(s.in)},"param_name":${quote(s.param_name)},"scheme":${quote(s.scheme)}}`)
  const tools: string[] = doc.ops.map((o: OpenApiOp): string => `{"name":${quote(o.name)},"description":${quote(o.description)},"method":${quote(o.method)},"path":${quote(o.path)},"deprecated":${o.deprecated},"input_schema":${inputSchema(o)}}`)
  return `{"title":${quote(doc.title)},"version":${quote(doc.version)},"openapi_version":${quote(doc.openapi_version)},"description":${quote(doc.description)},"servers":[${servers.join(",")}],"base_url":${quote(resolved)},"operation_servers":false,"security_schemes":[${schemes.join(",")}],"tools":[${tools.join(",")}],"tool_count":${doc.ops.length}}`
}

// The preview route. The document is the spec, or spec_url fetched now (the client is not created).
export async function openapiRoute(method: string, path: string, body: string): Promise<McpReply | undefined> {
  const q = path.indexOf("?")
  const pure = q < 0 ? path : path.slice(0, q)
  if (pure !== "/api/mcp/openapi/preview") return undefined
  if (method.toUpperCase() !== "POST") return notAllowed(method)
  const fs = objectFields(body)
  if (fs === undefined) return fail(400, "Invalid request payload")
  let text = rawStr(fs, "spec") ?? ""
  const url = rawStr(fs, "spec_url") ?? ""
  if (text === "" && url === "") return fail(400, "spec or spec_url is required")
  if (text === "") {
    const dl = deadline(CONNECT_MS)
    try {
      const r = try await fetch(url, { signal: dl.controller.signal })
      if (r.status < 200 || r.status >= 300) return fail(400, `could not fetch the spec: HTTP ${r.status}`)
      text = try await r.text()
    } catch (e) {
      return fail(400, `could not fetch the spec: ${e.message}`)
    } finally {
      dl.finish()
    }
  }
  let out = ""
  try {
    out = try previewJson(text, rawBool(fs, "include_deprecated") ?? false, rawStr(fs, "base_url") ?? "")
  } catch (e) {
    return fail(400, `invalid OpenAPI document: ${e.message}`)
  }
  return reply(200, out)
}

// ---- tool groups: /api/mcp/tool-groups, Bifrost's deprecated alias of the virtual MCPs ----
// The same store, with the group's shape. Its governance associations (team_ids, customer_ids and
// provider_names) reach the virtual keys they name, and virtual_key_ids are attached keys; the
// keys are stored as the virtual MCP's allowed_keys. A create must send enabled: true, since a virtual MCP cannot be disabled here.
// user_ids and api_key_ids have no Raiju counterpart, so a body that sends them is refused.

// The string list a JSON array holds, or [] when it is absent or not one.
function stringList(raw: string | undefined): string[] {
  if (raw === undefined || !raw.startsWith("[")) return []
  try {
    return JSON.parse(raw) as string[]
  } catch (e) {
    return []
  }
}

// The virtual keys a tool group reaches: its virtual_key_ids, and every key of the teams, customers
// and providers its associations name.
function groupKeys(store: ConfigStore, fs: Field[]): string[] {
  const out: string[] = []
  for (const k of stringList(find(fs, "virtual_key_ids"))) {
    if (!out.includes(k)) out.push(k)
  }
  const teams = stringList(find(fs, "team_ids"))
  const customers = stringList(find(fs, "customer_ids"))
  const providers = stringList(find(fs, "provider_names"))
  if (teams.length + customers.length + providers.length === 0) return out
  for (const vk of store.cfg.governance?.virtual_keys ?? []) {
    const tid: string = vk.team_id ?? ""
    const cid: string = vk.customer_id ?? ""
    let hit = (tid !== "" && teams.includes(tid)) || (cid !== "" && customers.includes(cid))
    for (const pc of vk.provider_configs ?? []) {
      if (providers.includes(pc.provider)) hit = true
    }
    if (hit && !out.includes(vk.id)) out.push(vk.id)
  }
  return out
}

// The virtual MCP body a tool group body means: tools read as {mcp_client_id, tool_names}, and enabled
// false on create unless the body enables it.
function groupVirtualBody(fs: Field[], name: string, creating: bool): string throws SyntaxError {
  const parts: string[] = [`"name":${quote(name)}`]
  const desc = find(fs, "description")
  if (desc !== undefined && desc !== "null") parts.push(`"description":${desc}`)
  const en = find(fs, "enabled")
  if (en !== undefined && en !== "null") parts.push(`"enabled":${en}`)
  const tools: string[] = []
  const raw = find(fs, "tools")
  if (raw !== undefined && raw.startsWith("[")) {
    for (const el of try elements(raw)) {
      const tf = try fields(el)
      const client = rawStr(tf, "mcp_client_name") ?? rawStr(tf, "mcp_client_id") ?? ""
      const names = find(tf, "tool_names")
      const tn = names === undefined || names === "null" ? "" : `,"tool_names":${names}`
      tools.push(`{"mcp_client_id":${quote(client)}${tn}}`)
    }
  }
  parts.push(`"tools":[${tools.join(",")}]`)
  return `{${parts.join(",")}}`
}

// The stored virtual MCP with its allowed keys set to keys (undefined when there is no such virtual MCP).
function setVirtualKeys(store: ConfigStore, id: string, keys: string[]): McpReply | undefined {
  const list = virtualsOf(store.cfg)
  const at = virtualIndex(list, id)
  if (at < 0) return fail(404, "virtual MCP not found")
  let next: vmcp.VirtualMcp[] = list
  let v = next[at]!
  v.allowed_keys = keys
  next[at] = v
  return persist(store, withVirtuals(store.cfg, next))
}

// POST (id "") and PUT of a tool group. A write that names association fields sets the keys afresh.
function toolGroupWrite(store: ConfigStore, id: string, body: string): McpReply {
  const creating = id === ""
  const fs = objectFields(body)
  if (fs === undefined) return fail(400, "Invalid request payload")
  for (const k of ["user_ids", "api_key_ids"]) {
    if (has(fs, k)) return fail(400, `${k} has no Raiju equivalent: attach the tool group to virtual keys with virtual_key_ids or team_ids, customer_ids and provider_names`)
  }
  // Raiju's virtual MCPs are always served, so a group cannot be created disabled (Bifrost's default)
  if (creating && rawBool(fs, "enabled") !== true) return fail(400, "enabled must be true: Raiju serves every virtual MCP, so a tool group cannot be created disabled")
  const name = creating ? (rawStr(fs, "name") ?? "") : id
  if (!creating && rawStr(fs, "name") !== undefined && rawStr(fs, "name") !== id) return fail(400, "renaming a tool group is not supported: its name is its id")
  let vb = ""
  try {
    vb = groupVirtualBody(fs, name, creating)
  } catch (e) {
    return fail(400, "Invalid request payload")
  }
  const assoc = has(fs, "virtual_key_ids") || has(fs, "team_ids") || has(fs, "customer_ids") || has(fs, "provider_names")
  const r = creating ? createVirtual(store, vb) : updateVirtual(store, id, vb)
  if (r.status >= 300) return r
  if (creating || assoc) {
    const kr = setVirtualKeys(store, name, groupKeys(store, fs))
    if (kr !== undefined && kr.status >= 300) return kr
  }
  const at = virtualIndex(virtualsOf(store.cfg), name)
  if (at < 0) return fail(404, "virtual MCP not found")
  return reply(creating ? 201 : 200, `{"mcp_tool_group":${virtualJson(virtualsOf(store.cfg)[at]!, virtualKeyIds(store.cfg))}}`)
}

function toolGroupRoute(store: ConfigStore, m: string, segs: string[], body: string, p: string): McpReply {
  if (segs.length === 3) {
    if (m === "GET") {
      const list = virtualsOf(store.cfg)
      const keyIds = virtualKeyIds(store.cfg)
      const parts: string[] = []
      for (const v of list) parts.push(virtualJson(v, keyIds))
      return reply(200, `{"mcp_tool_groups":[${parts.join(",")}],"count":${list.length},"total_count":${list.length}}`)
    }
    return m === "POST" ? toolGroupWrite(store, "", body) : notAllowed(m)
  }
  if (segs.length !== 4) return fail(404, `no route for ${p}`)
  const id = segs[3]!
  if (m === "GET") {
    const at = virtualIndex(virtualsOf(store.cfg), id)
    if (at < 0) return fail(404, "tool group not found")
    return reply(200, `{"mcp_tool_group":${virtualJson(virtualsOf(store.cfg)[at]!, virtualKeyIds(store.cfg))}}`)
  }
  if (m === "PUT") return toolGroupWrite(store, id, body)
  if (m === "DELETE") {
    const r = deleteVirtual(store, id)
    return r.status === 200 ? reply(200, `{"success":true}`) : r
  }
  return notAllowed(m)
}

// ---- OAuth configs: /api/oauth/config/{id}/status and DELETE /api/oauth/config/{id} ----
// An OAuth config is the MCP client of auth type "oauth" with that name. Its status is "authorized"
// when the client holds a token and "pending" otherwise. DELETE revokes: the tokens are dropped and the
// client stays. A live session keeps the token it had until the client next connects (see LIMITS).
export function oauthConfigRoute(store: ConfigStore, method: string, path: string): McpReply | undefined {
  const q = path.indexOf("?")
  const pure = q < 0 ? path : path.slice(0, q)
  const segs = pure.split("/").filter((s) => s !== "")
  if (segs.length < 4 || segs[0] !== "api" || segs[1] !== "oauth" || segs[2] !== "config") return undefined
  const id = segs[3]!
  const isStatus = segs.length === 5 && segs[4] === "status"
  if (!isStatus && segs.length !== 4) return undefined
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  const a = at < 0 ? undefined : oauthAuthOf(list[at]!)
  if (isStatus) {
    if (method !== "GET") return notAllowed(method)
    if (a === undefined) return fail(404, "OAuth config not found")
    const st = authorized(a) ? "authorized" : "pending"
    return reply(200, `{"id":${quote(id)},"status":"${st}"}`)
  }
  if (method !== "DELETE") return notAllowed(method)
  if (a === undefined) return fail(404, "OAuth config not found")
  let na = a
  na.access_token = undefined
  na.refresh_token = undefined
  na.token_expires_at = undefined
  const revoked = withAuth(list[at]!, na)
  let next: McpClientConfig[] = list
  next[at] = revoked
  const err = persist(store, withClients(store.cfg, next))
  if (err !== undefined) return err
  return reply(200, `{"status":"success","message":"OAuth config revoked"}`)
}

// ---- OAuth for clients of auth type "oauth": the authorization code flow with PKCE (Bifrost's
// initiate-verification, complete-oauth, reauthorize and reregister). A flow's state (its verifier
// and redirect URI) is held by this process until the callback returns, for FLOW_TTL_MS. The
// callback saves the tokens on the client; the client connects with them.

type OauthFlow = { client: string, verifier: string, redirect: string, expiresAt: number }

const FLOW_TTL_MS = 900000
const FLOW_TIMEOUT_MS = 10000
const FLOWS: Map<string, OauthFlow> = new Map()

// The auth of a client that uses the authorization code flow, else undefined.
function oauthAuthOf(c: McpClientConfig): McpAuthConfig | undefined {
  const a = c.auth
  return a !== undefined && a.type === "oauth" ? a : undefined
}

// Whether the flow has saved a token on the client.
function authorized(a: McpAuthConfig): bool {
  return (a.refresh_token ?? "") !== "" || (a.access_token ?? "") !== ""
}

// The client with its auth replaced.
function withAuth(c: McpClientConfig, a: McpAuthConfig): McpClientConfig {
  let n = c
  n.auth = a
  return n
}

// The list with the client at index at replaced.
function replaceAt(list: McpClientConfig[], at: int, c: McpClientConfig): McpClientConfig[] {
  const out: McpClientConfig[] = []
  for (let i = 0; i < list.length; i++) out.push(i === at ? c : list[i]!)
  return out
}

// A request to an authorization server under a deadline: the body of a 2xx answer, else an error.
async function callAuthServer(url: string, method: string, headers: Map<string, string>, body: string): Promise<string> throws Error {
  const dl = deadline(FLOW_TIMEOUT_MS)
  try {
    const hs: Record<string, string> = headers
    const r = method === "GET" ? await fetch(url, { signal: dl.controller.signal }) : await fetch(url, { method: "POST", headers: hs, body: body, signal: dl.controller.signal })
    const text = await r.text()
    if (r.status < 200 || r.status >= 300) throw new Error(`HTTP ${r.status} from ${url}`)
    dl.finish()
    return text
  } catch (e) {
    dl.finish()
    throw new Error(`${url}: ${e.message}`)
  }
}

// The authorization server's endpoints, from its metadata at the origin of the MCP server (RFC 8414).
async function discover(serverUrl: string): Promise<AuthEndpoints> throws Error {
  const urls = discoveryUrls(serverUrl)
  if (urls.length < 2) throw new Error("connection_string must be an http or https URL")
  const text = try await callAuthServer(urls[1]!, "GET", new Map(), "")
  return try parseAuthEndpoints(text)
}

// Dynamic client registration (RFC 7591), with the gateway's callback as the redirect URI.
async function register(url: string, redirect: string): Promise<{ client_id: string, client_secret: string }> throws Error {
  const rq = try registrationRequest(url, redirect, "Raiju")
  const text = try await callAuthServer(rq.url, "POST", rq.headers, rq.body)
  return try registrationResult(text)
}

// Flows whose time is up, by state.
function expiredFlows(now: f64): string[] {
  const out: string[] = []
  for (const k of FLOWS.keys()) {
    const f = FLOWS.get(k)
    if (f !== undefined && f.expiresAt < now) out.push(k)
  }
  return out
}

// Starts the authorization flow of a client. It finds the endpoints in the server's metadata and
// registers a client when it has none; then it saves the client and returns the authorize URL.
// mode is "initiate", "reauthorize" (the client must be authorized already) or "reregister" (a new
// client is registered in place of the stored one).
async function startFlow(store: ConfigStore, id: string, base: string, mode: string): Promise<McpReply> {
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return fail(404, `MCP client '${id}' not found`)
  const c = list[at]!
  const a0 = oauthAuthOf(c)
  if (a0 === undefined) return fail(400, "OAuth flows apply to auth type oauth clients only")
  if (mode === "reauthorize" && !authorized(a0)) return fail(400, "MCP client has not completed initial OAuth authorization yet; use initiate-verification instead")
  const server = c.connection_string ?? ""
  if (server === "") return fail(400, "MCP client connection_string is required to initiate OAuth discovery")
  let a = a0
  if (mode === "reregister") {
    a.client_id = undefined
    a.client_secret = undefined
  }
  if ((a.authorize_url ?? "") === "" || (a.token_url ?? "") === "") {
    let meta: AuthEndpoints = { authorization_endpoint: "", token_endpoint: "", registration_endpoint: "" }
    try {
      meta = await discover(server)
    } catch (e) {
      return fail(502, `OAuth discovery failed: ${e.message}`)
    }
    if ((a.authorize_url ?? "") === "") a.authorize_url = meta.authorization_endpoint
    if ((a.token_url ?? "") === "") a.token_url = meta.token_endpoint
    if ((a.registration_url ?? "") === "") a.registration_url = meta.registration_endpoint
  }
  const redirect = base + "/api/oauth/callback"
  if ((a.client_id ?? "") === "") {
    const reg = a.registration_url ?? ""
    if (reg === "") return fail(400, "MCP client has no client_id, and its authorization server has no registration endpoint: set client_id")
    let got = { client_id: "", client_secret: "" }
    try {
      got = await register(reg, redirect)
    } catch (e) {
      return fail(502, `client registration failed: ${e.message}`)
    }
    a.client_id = got.client_id
    a.client_secret = got.client_secret === "" ? undefined : got.client_secret
  }
  let verifier = ""
  let state = ""
  let authUrl = ""
  try {
    verifier = pkceVerifier()
    state = secureHex(32)
    authUrl = authorizeUrl(a, redirect, state, pkceChallenge(verifier))
  } catch (e) {
    return fail(500, `could not start the flow: ${e.message}`)
  }
  for (const k of expiredFlows(Date.now())) FLOWS.delete(k)
  const expires = Date.now() + FLOW_TTL_MS
  FLOWS.set(state, { client: id, verifier: verifier, redirect: redirect, expiresAt: expires })
  const perr = persist(store, withClients(store.cfg, replaceAt(list, at, withAuth(c, a))))
  if (perr !== undefined) return perr
  const out = {
    status: "pending_oauth",
    oauth_config_id: state,
    authorize_url: authUrl,
    expires_at: expires,
    mcp_client_id: id,
    complete_url: `/api/mcp/client/${id}/complete-oauth`,
    next_steps: ["1. Open authorize_url in a browser to approve access", "2. The authorization server returns to the gateway's callback, which saves the tokens", "3. POST complete_url to connect the MCP client"],
  }
  return reply(200, JSON.stringify(out))
}

// A page for the browser that came back to the callback.
function callbackPage(status: int, msg: string): { status: int, html: string } {
  const safe = msg.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll("\"", "&quot;")
  return { status: status, html: `<!doctype html><html><head><meta charset="utf-8"><title>MCP authorization</title></head><body><p>${safe}</p></body></html>` }
}

// GET /api/oauth/callback: the browser returns from the authorization server with a code. The code
// is exchanged for tokens (with the flow's PKCE verifier and redirect URI), the tokens are saved on
// the client, and the page says what happened. A flow is single use.
export async function oauthCallback(store: ConfigStore, query: URLSearchParams): Promise<{ status: int, html: string }> {
  const state = query.get("state") ?? ""
  const flow = FLOWS.get(state)
  FLOWS.delete(state)
  if (flow === undefined || flow.expiresAt < Date.now()) return callbackPage(400, "This authorization link is unknown or has expired. Start the flow again.")
  const refused = query.get("error") ?? ""
  if (refused !== "") return callbackPage(400, `The authorization server refused access: ${refused}`)
  const code = query.get("code") ?? ""
  if (code === "") return callbackPage(400, "The callback has no authorization code.")
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, flow.client)
  if (at < 0) return callbackPage(404, `MCP client '${flow.client}' no longer exists.`)
  const c = list[at]!
  const a = oauthAuthOf(c)
  if (a === undefined) return callbackPage(400, "The MCP client does not use the OAuth flow.")
  let tokens = { access: "", refresh: "", expiresAt: 0.0 }
  try {
    const tr = codeTokenRequest(a, code, flow.verifier, flow.redirect)
    const text = await callAuthServer(tr.url, "POST", tr.headers, tr.body)
    tokens = tokenFields(text, Date.now())
  } catch (e) {
    return callbackPage(502, `The token request failed: ${e.message}`)
  }
  let next = a
  next.access_token = tokens.access
  next.token_expires_at = tokens.expiresAt
  if (tokens.refresh !== "") next.refresh_token = tokens.refresh
  const perr = persist(store, withClients(store.cfg, replaceAt(list, at, withAuth(c, next))))
  if (perr !== undefined) return callbackPage(500, "The tokens could not be saved.")
  return callbackPage(200, `MCP client ${flow.client} is authorized. You can close this window.`)
}

// The OAuth routes of a client with auth type oauth. undefined for any other route or client, which
// mcpApi answers. base is the gateway's origin, for the callback's redirect URI.
export async function oauthRoute(store: ConfigStore, method: string, path: string, body: string, base: string): Promise<McpReply | undefined> {
  const segs = path.split("/").filter((s) => s !== "")
  if (segs.length !== 5 || segs[0] !== "api" || segs[1] !== "mcp" || segs[2] !== "client") return undefined
  if (method !== "POST") return undefined
  const id = segs[3]!
  const sub = segs[4]!
  if (sub !== "initiate-verification" && sub !== "reauthorize" && sub !== "reregister" && sub !== "complete-oauth") return undefined
  const list = clientsOf(store.cfg)
  const at = clientIndex(list, id)
  if (at < 0) return undefined
  const a = oauthAuthOf(list[at]!)
  if (a === undefined) return undefined
  if (sub === "complete-oauth") {
    if (!authorized(a)) return fail(400, "OAuth not authorized yet. Current status: pending")
    return { status: 200, body: `{"status":"success","message":"MCP client authorized"}`, action: "reconnect", id: id }
  }
  const mode = sub === "reregister" ? "reregister" : sub === "reauthorize" ? "reauthorize" : "initiate"
  return await startFlow(store, id, base, mode)
}

// The MCP management route for method and path, or undefined when the path is not one of them.
// The caller passes every /api/mcp path that is not handled elsewhere (the /api/mcp view and the
// library are not).
export function mcpApi(store: ConfigStore, method: string, path: string, body: string, publicOnly?: bool): McpReply | undefined {
  const m = method.toUpperCase()
  const q = path.indexOf("?")
  const p = q < 0 ? path : path.slice(0, q)
  const segs = p.split("/").filter((s) => s !== "")
  if (segs.length < 3 || segs[0] !== "api" || segs[1] !== "mcp") return undefined
  const area = segs[2]!
  if (area === "clients") return m === "GET" ? listClients(store) : notAllowed(m)
  if (area === "client") return clientRoute(store, m, segs, body, p, publicOnly ?? false)
  if (area === "virtual-mcps") return virtualRoute(store, m, segs, body, p)
  if (area === "tool-groups") return toolGroupRoute(store, m, segs, body, p)
  return undefined
}

// ---- tests ----

function tmpPath(): string {
  return "/tmp/raiju-mcpapi-" + randomId("t") + ".json"
}

function cleanupFile(path: string): void {
  try {
    unlinkSync(path)
  } catch (e) {
    // already gone
  }
  try {
    unlinkSync(path + ".bak")
  } catch (e) {
    // no backup on a first save
  }
}

function oneEntry(k: string, v: string): Map<string, string> {
  const m: Map<string, string> = new Map()
  m.set(k, v)
  return m
}

// A store on a fresh file: two virtual keys and two clients, one http and one stdio.
function fixture(): ConfigStore {
  const c: Config = {
    governance: { virtual_keys: [{ id: "vk1", value: "sk-bf-1", name: "dev" }, { id: "vk2", value: "sk-bf-2", name: "ops" }] },
    mcp: {
      client_configs: [
        { name: "fs", connection_type: "http", connection_string: "http://localhost:9000/mcp", headers: oneEntry("authorization", "Bearer abcdefghijklmnop"), tools_to_execute: ["*"] },
        { name: "git", connection_type: "stdio", stdio_config: { command: "git-mcp", env: oneEntry("TOKEN", "tok-secret-value") } },
      ],
    },
  }
  return new ConfigStore(tmpPath(), c)
}

test("list shows every client with secrets masked", () => {
  const s = fixture()
  const r = mcpApi(s, "GET", "/api/mcp/clients", "")!
  expect(r.status).toBe(200)
  expect(r.body.includes("\"client_id\":\"fs\"")).toBe(true)
  expect(r.body.includes("\"count\":2")).toBe(true)
  expect(r.body.includes("abcdefghijklmnop")).toBe(false)
  expect(r.body.includes("tok-secret-value")).toBe(false)
  expect(r.body.includes("Bearer abcd")).toBe(false)
  expect(mcpApi(s, "POST", "/api/mcp/clients", "{}")!.status).toBe(405)
  expect(mcpApi(s, "GET", "/api/mcp/other", "") === undefined).toBe(true)
  expect(mcpApi(s, "GET", "/api/mcp/virtual", "") === undefined).toBe(true)
  cleanupFile(s.path)
})

test("create adds a client, validates it, and saves", () => {
  const s = fixture()
  const v0 = s.version
  const r = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"docs\",\"connection_type\":\"http\",\"connection_string\":\"https://docs.example/mcp\",\"headers\":{\"x-key\":\"sk-live-0123456789\"},\"tool_sync_interval\":\"10m\",\"tls_config\":{\"insecure_skip_verify\":false}}")!
  expect(r.status).toBe(201)
  expect(r.body.includes("\"client_id\":\"docs\"")).toBe(true)
  expect(r.body.includes("sk-live-0123456789")).toBe(false)
  expect(clientsOf(s.cfg).length).toBe(3)
  expect(s.version).toBe(v0 + 1)
  const saved = try readFileSync(s.path, "utf8")
  expect(saved.includes("\"docs\"")).toBe(true)
  expect(saved.includes("sk-live-0123456789")).toBe(true)
  expect(saved.includes("\"tool_sync_interval\": \"10m\"")).toBe(true)

  expect(mcpApi(s, "POST", "/api/mcp/client", "not json")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "[1]")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":5}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"connection_type\":\"http\"}")!.body.includes("name is required")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"my-srv\",\"connection_type\":\"http\"}")!.body.includes("cannot contain hyphens")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"1abc\",\"connection_type\":\"http\"}")!.body.includes("cannot start with a number")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"fs\",\"connection_type\":\"http\",\"connection_string\":\"http://x\"}")!.status).toBe(409)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"inprocess\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\"}")!.body.includes("connection_string is required")).toBe(true)
  expect(clientsOf(s.cfg).length).toBe(3)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"ftp://x\"}")!.body.includes("http or https")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"stdio\"}")!.body.includes("stdio_config.command is required")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"auth_type\":\"oauth\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"auth\":{\"type\":\"weird\"}}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"tool_sync_interval\":\"1500ms\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"headers\":{\"a\":1}}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"x\",\"connection_type\":\"http\",\"connection_string\":\"http://x\",\"tools_to_execute\":[1]}")!.status).toBe(400)
  expect(clientsOf(s.cfg).length).toBe(3)
  cleanupFile(s.path)
})

test("duration checks accept Go durations in whole seconds", () => {
  expect(durationError("0")).toBe("")
  expect(durationError("90s")).toBe("")
  expect(durationError("10m")).toBe("")
  expect(durationError("1h30m")).toBe("")
  expect(durationError("1h30m15s")).toBe("")
  expect(durationError("1m30m") === "").toBe(false)
  expect(durationError("30m1h") === "").toBe(false)
  expect(durationError("10") === "").toBe(false)
  expect(durationError("") === "").toBe(false)
  expect(durationError("1500ms") === "").toBe(false)
})

test("update patches fields, keeps masked secrets, and refuses renames", () => {
  const s = fixture()
  const r = mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"disabled\":true,\"tools_to_skip\":[\"rm\"],\"headers\":{\"authorization\":\"Bear…mnop\",\"x-new\":\"v\"}}")!
  expect(r.status).toBe(200)
  expect(r.body.includes("\"disabled\":true")).toBe(true)
  const c = s.cfg.mcp!.client_configs![0]!
  expect(c.disabled).toBe(true)
  expect(c.tools_to_skip!.includes("rm")).toBe(true)
  expect(c.headers!.get("authorization")).toBe("Bearer abcdefghijklmnop")
  expect(c.headers!.get("x-new")).toBe("v")
  expect(c.tools_to_execute!.includes("*")).toBe(true)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"allow_on_all_virtual_keys\":true}")!.body.includes("\"allow_by_default\":true")).toBe(true)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"name\":\"files\"}")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"name\":\"fs\"}")!.status).toBe(200)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"tool_sync_interval\":\"soon\"}")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"auth\":null,\"disabled\":false}")!.status).toBe(200)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"auth\":{\"type\":\"weird\"}}")!.status).toBe(400)
  const au = mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"auth\":{\"type\":\"bearer\",\"token\":\"tok-123456789\"}}")!
  expect(au.body.includes("tok-…6789")).toBe(true)
  expect(au.body.includes("tok-123456789")).toBe(false)
  const kept = mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"auth\":{\"type\":\"bearer\",\"token\":\"tok-…6789\"}}")!
  expect(kept.status).toBe(200)
  expect(s.cfg.mcp!.client_configs![0]!.auth!.token).toBe("tok-123456789")
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "not json")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/client/nope", "{}")!.status).toBe(404)
  expect(mcpApi(s, "GET", "/api/mcp/client/fs", "")!.status).toBe(405)
  cleanupFile(s.path)
})

test("delete removes a client", () => {
  const s = fixture()
  expect(mcpApi(s, "DELETE", "/api/mcp/client/git", "")!.status).toBe(200)
  expect(s.cfg.mcp!.client_configs!.length).toBe(1)
  expect(mcpApi(s, "DELETE", "/api/mcp/client/git", "")!.status).toBe(404)
  cleanupFile(s.path)
})

test("reconnect and refresh hand the step to the lead, and refuse disabled clients", () => {
  const s = fixture()
  const rc = mcpApi(s, "POST", "/api/mcp/client/fs/reconnect", "")!
  expect(rc.status).toBe(200)
  expect(rc.action === "reconnect").toBe(true)
  expect(rc.id === "fs").toBe(true)
  const rf = mcpApi(s, "POST", "/api/mcp/client/git/refresh-tools", "")!
  expect(rf.action === "refresh").toBe(true)
  expect(rf.id === "git").toBe(true)
  expect(mcpApi(s, "PUT", "/api/mcp/client/fs", "{\"disabled\":true}")!.status).toBe(200)
  const off = mcpApi(s, "POST", "/api/mcp/client/fs/reconnect", "")!
  expect(off.status).toBe(400)
  expect(off.action === undefined).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/refresh-tools", "")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client/nope/reconnect", "")!.status).toBe(404)
  expect(mcpApi(s, "GET", "/api/mcp/client/fs/reconnect", "")!.status).toBe(405)
  expect(mcpApi(s, "GET", "/api/mcp/client/fs/openapi-spec", "")!.status).toBe(404)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/openapi-spec", "")!.status).toBe(405)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/complete-oauth", "")!.status).toBe(404)
  const init = mcpApi(s, "POST", "/api/mcp/client/fs/initiate-verification", "")!
  expect(init.status).toBe(400)
  expect(init.body.includes("only applies to OAuth-based clients")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/client/nope/initiate-verification", "")!.status).toBe(404)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/reauthorize", "")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/verify-headers", "")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/verify-exchange", "")!.status).toBe(400)
  expect(mcpApi(s, "GET", "/api/mcp/client/fs/verify-headers", "")!.status).toBe(405)
  expect(mcpApi(s, "POST", "/api/mcp/client/fs/whatever", "")!.status).toBe(404)
  cleanupFile(s.path)
})

test("virtual MCPs: create with Bifrost and native tools, then read, update and delete", () => {
  const s = fixture()
  const c = mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"dev\",\"description\":\"Dev tools\",\"tools\":[{\"mcp_client_id\":\"fs\",\"tool_names\":[\"read\",\"write\"]},{\"mcp_client_id\":\"git\",\"tool_names\":[\"*\"]}]}")!
  expect(c.status).toBe(201)
  expect(c.body.includes("\"source\":\"fs-read\"")).toBe(true)
  expect(c.body.includes("\"source\":\"git-*\"")).toBe(true)
  expect(c.body.includes("\"description\":\"Dev tools\"")).toBe(true)
  expect(c.body.includes("\"virtual_key_ids\":[\"vk1\",\"vk2\"]")).toBe(true)

  const native = mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"nat\",\"endpoint_slug\":\"nat\",\"tools\":[{\"source\":\"fs-read\",\"as\":\"read_file\",\"defaults\":\"{\\\"limit\\\":5}\"}]}")!
  expect(native.status).toBe(201)
  expect(native.body.includes("\"as\":\"read_file\"")).toBe(true)

  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"dev\"}")!.status).toBe(409)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"fs\"}")!.status).toBe(409)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{}")!.body.includes("name is required")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"Bad Name\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"endpoint_slug\":\"y\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"enabled\":false}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":[{\"mcp_client_id\":\"nope\",\"tool_names\":[\"a\"]}]}")!.body.includes("invalid MCP client IDs: nope")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":[{\"source\":\"zzz-read\"}]}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":[{\"source\":\"fs-*\",\"as\":\"n\"}]}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":\"no\"}")!.status).toBe(400)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"x\",\"tools\":[\"fs-read\"]}")!.status).toBe(400)

  const list = mcpApi(s, "GET", "/api/mcp/virtual-mcps", "")!
  expect(list.body.includes("\"count\":2")).toBe(true)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/dev", "")!.body.includes("\"virtual_mcp\"")).toBe(true)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/nope", "")!.status).toBe(404)

  const up = mcpApi(s, "PUT", "/api/mcp/virtual-mcps/dev", "{\"description\":\"Renamed\",\"tools\":[{\"source\":\"git-log\"}]}")!
  expect(up.status).toBe(200)
  expect(up.body.includes("\"description\":\"Renamed\"")).toBe(true)
  expect(s.cfg.virtual_mcps![0]!.tools.length).toBe(1)
  expect(mcpApi(s, "PUT", "/api/mcp/virtual-mcps/dev", "{\"name\":\"nat\"}")!.status).toBe(409)
  expect(mcpApi(s, "PUT", "/api/mcp/virtual-mcps/dev", "{\"name\":\"devs\"}")!.status).toBe(200)
  expect(mcpApi(s, "PUT", "/api/mcp/virtual-mcps/devs", "{\"enabled\":false}")!.status).toBe(400)
  expect(mcpApi(s, "PUT", "/api/mcp/virtual-mcps/nope", "{}")!.status).toBe(404)

  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/devs", "")!.body.includes("\"success\":true")).toBe(true)
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/devs", "")!.status).toBe(404)
  expect(mcpApi(s, "PATCH", "/api/mcp/virtual-mcps", "")!.status).toBe(405)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/nat/other", "")!.status).toBe(404)
  cleanupFile(s.path)
})

test("attach and detach change which virtual keys may use a virtual MCP", () => {
  const s = fixture()
  mcpApi(s, "POST", "/api/mcp/virtual-mcps", "{\"name\":\"dev\"}")
  // unset allowed_keys: every key already has it, so attaching changes nothing
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/vk1", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys === undefined).toBe(true)
  // detaching from an open one lists the other keys
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/dev/virtual-keys/vk2", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys!.join(",")).toBe("vk1")
  expect(vmcp.keyAllowed(s.cfg.virtual_mcps![0]!, "vk2")).toBe(false)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/vk2", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys!.join(",")).toBe("vk1,vk2")
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/vk2", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys!.length).toBe(2)
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/dev/virtual-keys/vk1", "")!.status).toBe(200)
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/dev/virtual-keys/vk2", "")!.status).toBe(200)
  expect(s.cfg.virtual_mcps![0]!.allowed_keys!.length).toBe(0)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/dev/virtual-keys/nope", "")!.status).toBe(404)
  expect(mcpApi(s, "POST", "/api/mcp/virtual-mcps/nope/virtual-keys/vk1", "")!.status).toBe(404)
  expect(mcpApi(s, "DELETE", "/api/mcp/virtual-mcps/nope/virtual-keys/vk1", "")!.status).toBe(404)
  expect(mcpApi(s, "GET", "/api/mcp/virtual-mcps/dev/virtual-keys/vk1", "")!.status).toBe(405)
  cleanupFile(s.path)
})

test("tool groups alias virtual MCPs, OAuth configs report status and revoke, and openapi needs a spec it can read", () => {
  const s = fixture()
  expect(mcpApi(s, "POST", "/api/mcp/tool-groups", "{\"name\":\"ops\",\"tools\":[{\"mcp_client_name\":\"fs\",\"tool_names\":[\"read\"]}],\"virtual_key_ids\":[\"vk2\"]}")!.status).toBe(400)
  const g = mcpApi(s, "POST", "/api/mcp/tool-groups", "{\"name\":\"ops\",\"enabled\":true,\"tools\":[{\"mcp_client_name\":\"fs\",\"tool_names\":[\"read\"]}],\"virtual_key_ids\":[\"vk2\"]}")!
  expect(g.status).toBe(201)
  expect(g.body.includes("\"virtual_key_ids\":[\"vk2\"]")).toBe(true)
  expect(mcpApi(s, "GET", "/api/mcp/tool-groups/ops", "")!.status).toBe(200)
  expect(mcpApi(s, "GET", "/api/mcp/tool-groups", "")!.body.includes("\"mcp_tool_groups\":[")).toBe(true)
  expect(mcpApi(s, "POST", "/api/mcp/tool-groups", "{\"name\":\"x\",\"tools\":[],\"user_ids\":[\"u1\"]}")!.status).toBe(400)
  expect(mcpApi(s, "DELETE", "/api/mcp/tool-groups/ops", "")!.status).toBe(200)
  expect(mcpApi(s, "GET", "/api/mcp/tool-groups/ops", "")!.status).toBe(404)

  const oa = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"gh\",\"connection_type\":\"http\",\"connection_string\":\"https://gh.example/mcp\",\"auth\":{\"type\":\"oauth\",\"authorize_url\":\"https://gh.example/authorize\",\"token_url\":\"https://gh.example/token\"}}")!
  expect(oa.status).toBe(201)
  expect(oauthConfigRoute(s, "GET", "/api/oauth/config/gh/status")!.body).toBe("{\"id\":\"gh\",\"status\":\"pending\"}")
  expect(oauthConfigRoute(s, "GET", "/api/oauth/config/fs/status")!.status).toBe(404)
  expect(oauthConfigRoute(s, "DELETE", "/api/oauth/config/gh")!.status).toBe(200)
  expect(oauthConfigRoute(s, "POST", "/api/oauth/config/gh/status")!.status).toBe(405)

  const bad = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"api\",\"connection_type\":\"openapi\",\"openapi_config\":{\"spec\":\"{\\\"swagger\\\":\\\"2.0\\\"}\"}}")!
  expect(bad.status).toBe(400)
  const none = mcpApi(s, "POST", "/api/mcp/client", "{\"name\":\"api\",\"connection_type\":\"openapi\"}")!
  expect(none.status).toBe(400)
  cleanupFile(s.path)
})
