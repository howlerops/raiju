// GPT Live over WebRTC, terminated here as Bifrost's webrtclive.go and webrtcrelay.go do: the browser's
// SDP offer is answered by this gateway's own peer connection, a second peer connection offers to the
// provider, and the two are relayed: audio as RTP packets (never decoded) and the "oai-events" data
// channel as text. Every data-channel event passes through LiveCore, which meters, guards and reports
// it. The peer connections are libdatachannel's (tov-patches/0006, std/rtc).
//
// Layout of this file, top to bottom:
//   - SDP and RTP helpers (pure): the Opus-only offer, a2=max-message-size, RTP header cleanup
//   - LiveEventFilter: the server-event permissions of the create body (liveeventfilter.go)
//   - LiveCore: the session's policy and metering (livesession.go and livemeter.go): usage seconds in
//     billing windows, the 15 s minimum, token usage of delegated responses, the transcript, the
//     guard hooks, draining until session.closed
//   - Relay: the two legs wired to a core, with the queues and the clock
//   - establish: the create handshake with real peer connections
import { RTCPeerConnection, RTCDataChannel, RTCTrack, RTCConfig } from "std/rtc"
import { Field, fields, find, rawStr, setField, build, quote, elements } from "./json"

// What OpenAI bills a WebRTC session when it is created, credited against its running time.
export const LIVE_MINIMUM_SECONDS = 15.0
// How much voice time accrues before the session's budget is checked again.
export const LIVE_WINDOW_SECONDS = 30.0
// How long the provider has to answer a session.close with session.closed.
const DRAIN_MS = 15000.0
// How often an idle session meets the window check, and how long without usage counts as idle.
const STALE_EVERY_MS = 5000.0
const STALE_AFTER_MS = 2.0 * LIVE_WINDOW_SECONDS * 1000.0
// Bounds: the transcript kept per session, and the messages waiting for a channel to open.
const TRANSCRIPT_MAX = 1048576
const PENDING_MAX = 1000
// Bifrost's handshake timeouts
const HANDSHAKE_MS = 10000
const GATHER_MS = 3000
const BROWSER_DRAIN_MS = 10000

export const DATA_CHANNEL_LABEL = "oai-events"

// ---------------------------------------------------------------- SDP and RTP helpers

function sdpLines(sdp: string): string[] {
  return sdp.split("\n")
}

// The value of a line a=max-message-size:N, or undefined.
export function sdpMaxMessageSize(sdp: string): int | undefined {
  for (const l of sdpLines(sdp)) {
    const t = l.trim()
    if (t.startsWith("a=max-message-size:")) {
      const n = parseInt(t.slice(19))
      if (n !== undefined && n > 0) return n
      return undefined
    }
  }
  return undefined
}

// Sets (or adds, ahead of the application section) the a=max-message-size line.
export function setSdpMaxMessageSize(sdp: string, n: int): string {
  const line = "a=max-message-size:" + n
  const out: string[] = []
  let done = false
  const ls = sdpLines(sdp)
  const eol = sdp.includes("\r\n") ? "\r" : ""
  for (const l of ls) {
    if (l.trim().startsWith("a=max-message-size:")) {
      out.push(line + (l.endsWith("\r") ? "\r" : ""))
      done = true
    } else {
      out.push(l)
    }
  }
  if (done) return out.join("\n")
  const added: string[] = []
  for (const l of out) {
    if (!done && l.startsWith("m=application ")) {
      added.push(line + eol)
      done = true
    }
    added.push(l)
  }
  return added.join("\n")
}

// The provider must not be offered a larger message than the browser takes: the offer's limit is lowered
// to the browser's.
export function constrainMaxMessageSize(upstreamOffer: string, browserOffer: string): string {
  const b = sdpMaxMessageSize(browserOffer)
  if (b === undefined) return upstreamOffer
  const u = sdpMaxMessageSize(upstreamOffer)
  if (u !== undefined && u <= b) return upstreamOffer
  return setSdpMaxMessageSize(upstreamOffer, b)
}

// The SDP with each audio section restricted to its Opus payload types, so the answer can only pick
// Opus: both legs must agree on the codec, because the packets are forwarded as they are. A section
// with no Opus is left as it is.
export function opusOnly(sdp: string): string {
  const ls = sdpLines(sdp)
  const out: string[] = []
  let i = 0
  while (i < ls.length) {
    const l = ls[i]!
    if (!l.startsWith("m=audio ")) {
      out.push(l)
      i += 1
      continue
    }
    // the section: this line and those up to the next m= line
    let j = i + 1
    while (j < ls.length && !ls[j]!.startsWith("m=")) j += 1
    const sec = ls.slice(i + 1, j)
    const keep: string[] = []
    for (const s of sec) {
      if (s.startsWith("a=rtpmap:")) {
        const sp = s.indexOf(" ")
        if (sp > 0 && s.slice(sp + 1).toLowerCase().startsWith("opus/")) keep.push(s.slice(9, sp))
      }
    }
    if (keep.length === 0) {
      out.push(l)
      for (const s of sec) out.push(s)
      i = j
      continue
    }
    const parts = l.trim().split(" ")
    const head = parts.slice(0, 3).join(" ")
    const cr = l.endsWith("\r") ? "\r" : ""
    out.push(head + " " + keep.join(" ") + cr)
    for (const s of sec) {
      const t = s.trim()
      let pt = ""
      if (t.startsWith("a=rtpmap:") || t.startsWith("a=fmtp:") || t.startsWith("a=rtcp-fb:")) {
        const colon = t.indexOf(":")
        const rest = t.slice(colon + 1)
        const sp = rest.indexOf(" ")
        pt = sp > 0 ? rest.slice(0, sp) : rest
      }
      if (pt === "" || pt === "*" || keep.includes(pt)) out.push(s)
    }
    i = j
  }
  return out.join("\n")
}

// An RTP packet ready for the other leg: the header without CSRCs and extensions (their ids belong to
// the leg they came from), the payload as it is. undefined for something that is not an RTP packet
// (RTCP, or a runt).
export function forwardRtp(p: u8[]): u8[] | undefined {
  if (p.length < 12) return undefined
  const b0 = int(p[0]!)
  if ((b0 >> 6) !== 2) return undefined
  const b1 = int(p[1]!)
  if (b1 >= 192 && b1 <= 223) return undefined
  const cc = b0 & 15
  let start = 12 + 4 * cc
  if ((b0 & 16) !== 0) {
    if (p.length < start + 4) return undefined
    start += 4 + 4 * ((int(p[start + 2]!) << 8) + int(p[start + 3]!))
  }
  if (start > p.length) return undefined
  if (start === 12 && (b0 & 31) === 0) return p
  let head = p.slice(0, 12)
  head[0] = u8(b0 & 224)
  return head.concat(p.slice(start))
}

// ---------------------------------------------------------------- JSON helpers

// The raw value at a path of object keys, or undefined.
function jsonAt(text: string, path: string[]): string | undefined {
  let cur = text
  for (const k of path) {
    let fs: Field[] = []
    try {
      fs = fields(cur)
    } catch (e) {
      return undefined
    }
    const v = find(fs, k)
    if (v === undefined) return undefined
    cur = v
  }
  return cur
}

export function strAt(text: string, path: string[]): string {
  const v = jsonAt(text, path)
  if (v === undefined) return ""
  try {
    return rawStr([{ key: "v", raw: v }], "v") ?? ""
  } catch (e) {
    return ""
  }
}

function numAt(text: string, path: string[]): f64 {
  const v = jsonAt(text, path)
  if (v === undefined) return 0.0
  return parseFloat(v.trim()) ?? 0.0
}

// The text with the value at path replaced by raw (the objects on the way must exist).
export function withJsonAt(text: string, path: string[], raw: string): string throws SyntaxError {
  if (path.length === 0) return raw
  let fs = try fields(text)
  const k = path[0]!
  const inner = find(fs, k)
  if (path.length === 1) {
    setField(&fs, k, raw)
    return build(fs)
  }
  if (inner === undefined) throw new SyntaxError("no " + k)
  setField(&fs, k, try withJsonAt(inner, path.slice(1), raw))
  return build(fs)
}

export function eventType(m: string): string {
  try {
    return rawStr(fields(m), "type") ?? ""
  } catch (e) {
    return ""
  }
}

// The error event a refused session sends its client.
export function errorEvent(type: string, message: string): string {
  return JSON.stringify({ type: "error", error: { type: type, code: type, message: message } })
}

// ---------------------------------------------------------------- server-event permissions

const EVENTS_PATH = ["session", "client", "data_channel", "allowed_server_events"]

// The events the gateway's controller needs from the provider, whatever the browser asked for.
const REQUIRED: string[][] = [
  ["session.started", ""],
  ["session.updated", ""],
  ["session.closed", ""],
  ["session.usage.updated", ""],
  ["session.delegation.created", ""],
  ["session.input_transcript.delta", ""],
  ["session.output_transcript.delta", ""],
  ["error", ""],
  ["response.event", "response.output_item.done"],
  ["response.event", "response.completed"],
  ["response.event", "response.incomplete"],
  ["response.event", "response.failed"],
]

// A browser's restricted list of server events. The provider is asked for those and the ones the
// controller consumes; the browser is sent only what it asked for.
export class LiveEventFilter {
  allowed: Set<string> = new Set<string>()
  original = ""

  allows(m: string): bool {
    const t = eventType(m)
    const key = t === "response.event" ? t + "|" + strAt(m, ["event", "type"]) : t + "|"
    return this.allowed.has(key)
  }

  // The frame for the browser: undefined when it asked not to get it, and its own permissions
  // restored wherever the provider echoes them.
  clientMessage(m: string): string | undefined {
    if (!this.allows(m)) return undefined
    if (jsonAt(m, EVENTS_PATH) === undefined) return m
    try {
      return withJsonAt(m, EVENTS_PATH, this.original)
    } catch (e) {
      return m
    }
  }
}

// The create body with its transport.sdp replaced (the gateway, not the browser, is the provider's peer).
export function withOffer(body: string, sdp: string): string throws SyntaxError {
  return try withJsonAt(body, ["transport", "sdp"], quote(sdp))
}

export type PreparedEvents = { body: string, filter: LiveEventFilter | undefined, error: string }

// Widens a restricted server-event list in the create body (the omitted list and "all" already deliver
// every event). error is the 400 message for a list that is not one.
export function prepareServerEvents(body: string): PreparedEvents {
  const value = jsonAt(body, EVENTS_PATH)
  if (value === undefined) return { body: body, filter: undefined, error: "" }
  const v = value.trim()
  if (v === `"all"`) return { body: body, filter: undefined, error: "" }
  const path = "session.client.data_channel.allowed_server_events"
  if (!v.startsWith("[")) return { body: body, filter: undefined, error: path + ` must be "all" or an array of server event selectors` }
  const filter = new LiveEventFilter()
  filter.original = v
  const items: string[][] = []
  let els: string[] = []
  try {
    els = elements(v)
  } catch (e) {
    return { body: body, filter: undefined, error: path + ` must be "all" or an array of server event selectors` }
  }
  let n = 0
  for (const el of els) {
    let fs: Field[] = []
    try {
      fs = fields(el)
    } catch (e) {
      return { body: body, filter: undefined, error: `${path} selector ${n} must be an object` }
    }
    const t = rawStr(fs, "type")
    if (t === undefined || t.byteLength < 1 || t.chars().length > 256) return { body: body, filter: undefined, error: `${path} selector ${n} type must be a string of 1 to 256 characters` }
    const nested = find(fs, "response_event")
    let re = ""
    if (t === "response.event") {
      const r = rawStr(fs, "response_event")
      if (nested === undefined || r === undefined || r.byteLength < 1 || r.chars().length > 256) return { body: body, filter: undefined, error: `${path} selector ${n} response_event must be a string of 1 to 256 characters for response.event` }
      re = r
    } else if (nested !== undefined) {
      return { body: body, filter: undefined, error: `${path} selector ${n} response_event is only allowed for response.event` }
    }
    for (const f of fs) {
      if (f.key !== "type" && f.key !== "response_event") return { body: body, filter: undefined, error: `${path} selector ${n} only supports type and response_event` }
    }
    filter.allowed.add(t + "|" + re)
    items.push([t, re])
    n += 1
  }
  for (const r of REQUIRED) {
    if (!filter.allowed.has(r[0]! + "|" + r[1]!)) items.push(r)
  }
  const parts: string[] = []
  for (const it of items) {
    parts.push(it[1]! === "" ? `{"type":${quote(it[0]!)}}` : `{"response_event":${quote(it[1]!)},"type":${quote(it[0]!)}}`)
  }
  try {
    return { body: withJsonAt(body, EVENTS_PATH, "[" + parts.join(",") + "]"), filter: filter, error: "" }
  } catch (e) {
    return { body: body, filter: undefined, error: "failed to prepare live server event permissions" }
  }
}

// ---------------------------------------------------------------- the session's core

// What a guard decided about a piece of text: action is "pass", "redact" (text is the replacement) or "block".
export type Verdict = { action: string, text: string, reason: string }

// What the core writes to: the two legs, and the end of the whole relay.
export class LiveIO {
  constructor(readonly toClient: (m: string) => void, readonly toProvider: (m: string) => void, readonly abandon: () => void) {}
}

// Why a session may not go on: the HTTP status and error type of the denial, and its message.
export type Refusal = { status: int, type: string, message: string }

// What the core asks of the gateway: re-admit the session for its next window (undefined, or the
// refusal), record the finished session, bind the provider's session id to the virtual key that
// opened it (false when it can't be recorded), and the metrics of an event.
export class LiveHooks {
  // The plugins' LLM hooks on each realtime turn (livehooks.tov TurnPlugins, Bifrost's RunRealtimeTurnPreHooks), when
  // a plugin takes part: turnPre gets the turn's Responses-shaped request ({input, instructions, tools}, without the
  // model) as the turn starts, and a refusal ends the session as a re-admission's does; turnPost gets the turn's
  // response ({object, model, status, output, usage}) or its error with the HTTP status when the turn ends, and a
  // refusal (a post hook's error) ends the session after the turn's row.
  turnPre: ((body: string) => Refusal | undefined) | undefined = undefined
  turnPost: ((status: int, body: string) => Refusal | undefined) | undefined = undefined

  constructor(readonly readmit: () => Refusal | undefined, readonly report: (r: LiveReport) => void, readonly bind: (id: string) => bool, readonly count: (direction: string, type: string) => void, readonly turn: (t: TurnReport) => void) {}
}

// What a realtime turn's request is made of, as Bifrost's buildRealtimeTurnPreRequest makes it: the caller's messages and
// tool outputs since the last turn (as Responses input items with their text), then the input items of the
// response.create that starts the turn, its instructions, and its tools (else the session's).
export function turnRequestJson(inputs: string[], create: string, sessionTools: string): string {
  const items = inputs.slice()
  let instructions: string | undefined = undefined
  let tools: string | undefined = undefined
  if (create !== "") {
    const extra = jsonAt(create, ["response", "input"])
    if (extra !== undefined && extra.trim().startsWith("[")) {
      try {
        for (const it of elements(extra)) items.push(it)
      } catch (e) {
        // not a list of items: left out
      }
    }
    const ins = jsonAt(create, ["response", "instructions"])
    if (ins !== undefined && ins.startsWith("\"")) instructions = ins
    const t = jsonAt(create, ["response", "tools"])
    if (t !== undefined && t.trim().startsWith("[")) tools = t
  }
  if (tools === undefined && sessionTools !== "") tools = sessionTools
  let out = `{"input":[${items.join(",")}]`
  if (instructions !== undefined) out += `,"instructions":${instructions}`
  if (tools !== undefined) out += `,"tools":${tools}`
  return out + "}"
}

// The input item a caller's event adds to the next turn's request ("" for none): a user message's text (its input_text
// parts) or a function call's output, from conversation.item.create; the caller's transcribed speech, from the
// provider's input transcription.
export function turnInputOf(type: string, m: string): string {
  if (type === INPUT_TRANSCRIPT) {
    const t = strAt(m, ["transcript"]).trim()
    return t === "" ? "" : `{"type":"message","role":"user","content":${quote(t)}}`
  }
  if (type !== "conversation.item.create") return ""
  const item = jsonAt(m, ["item"])
  if (item === undefined) return ""
  const it = strAt(item, ["type"])
  if (it === "function_call_output") {
    const o = strAt(item, ["output"]).trim()
    return o === "" ? "" : `{"type":"function_call_output","output":${quote(o)}}`
  }
  if (it !== "message" || strAt(item, ["role"]) !== "user") return ""
  const texts: string[] = []
  const c = jsonAt(item, ["content"])
  if (c !== undefined && c.trim().startsWith("[")) {
    try {
      for (const part of elements(c)) {
        const t = strAt(part, ["text"])
        if (t !== "") texts.push(t)
      }
    } catch (e) {
      return ""
    }
  }
  const s = texts.join("\n").trim()
  return s === "" ? "" : `{"type":"message","role":"user","content":${quote(s)}}`
}

// A realtime turn's response in the Responses shape, as Bifrost's buildRealtimeTurnPostResponse makes it: the model's
// text as an assistant message, the function calls the response.done lists, and its usage.
export function turnResponseJson(model: string, done: string, text: string): string {
  const out: string[] = []
  if (text !== "") out.push(`{"type":"message","role":"assistant","content":[{"type":"output_text","text":${quote(text)}}]}`)
  const items = jsonAt(done, ["response", "output"])
  if (items !== undefined && items.trim().startsWith("[")) {
    try {
      for (const it of elements(items)) {
        if (strAt(it, ["type"]) !== "function_call") continue
        out.push(`{"type":"function_call","call_id":${quote(strAt(it, ["call_id"]))},"name":${quote(strAt(it, ["name"]))},"arguments":${quote(strAt(it, ["arguments"]))}}`)
      }
    } catch (e) {
      // no function calls read
    }
  }
  const u = ["response", "usage"]
  const inT = Math.trunc(numAt(done, u.concat(["input_tokens"])))
  const outT = Math.trunc(numAt(done, u.concat(["output_tokens"])))
  const status = strAt(done, ["response", "status"])
  return `{"object":"response","model":${quote(model)},"status":${quote(status === "" ? "completed" : status)},"output":[${out.join(",")}],"usage":{"input_tokens":${inT},"output_tokens":${outT},"total_tokens":${inT + outT}}}`
}

// The error body a turn's post hooks get when it did not finish with a response.
export function turnErrorJson(status: int, message: string): string {
  return `{"error":{"message":${quote(message)},"type":${quote(status === 400 ? "invalid_request_error" : "server_error")}},"status_code":${status}}`
}

// The tokens a session's responses used under one model, as the provider reported them: the totals,
// the cached part of the prompt, and the audio tokens among each side's.
export type ModelTokens = { model: string, prompt: int, completion: int, cached: int, inputAudio: int, outputAudio: int }

// One billing unit that closed, for its log row, as Bifrost's meter closes them: a window of voice time, a
// delegated response, or the voice unit that ends a live session ("window", "delegation", "end"); a realtime
// response ("turn"), or what a turn left behind when the session ended ("end"). The units of a session are
// linked by its id.
export type TurnReport = {
  kind: string,
  // 1-based, in the order the units closed
  index: int,
  sessionId: string,
  // voice time the provider reported in this unit, and what is billed for it
  seconds: f64,
  billedSeconds: f64,
  promptTokens: int,
  completionTokens: int,
  uses: ModelTokens[],
  status: int,
  error: string,
  reason: string,
  startedMs: f64,
  endedMs: f64,
  input: string,
  output: string,
  events: int,
  // the unit that ends the session
  last: bool,
  // how a realtime response ended, as its response.done says ("completed", "failed", "cancelled", "incomplete"; ""
  // for a unit that is no response), and why (status_details.reason, or the error's code)
  state: string,
  stateReason: string,
}

// How a response ended, for its row: the response.done's status and reason, the HTTP status the row is logged with
// and its error.
export type DoneOutcome = { state: string, reason: string, status: int, error: string }

// The status Bifrost gives a realtime error (newBifrostErrorFromRealtimeError): 500, or 400 when its type, code or
// message names an invalid request, or 429 when one names a rate limit, a quota, a budget or billing (the last of
// them that matches wins, as Bifrost reads them in that order).
export function realtimeErrorStatus(values: string[]): int {
  let status = 500
  for (const v of values) {
    const l = v.trim().toLowerCase()
    if (l === "") continue
    if (l.includes("invalid_request_error")) status = 400
    else if (l.includes("rate_limit") || l.includes("rate limit") || l.includes("too many requests") || l.includes("quota") || l.includes("budget") || l.includes("billing")) status = 429
  }
  return status
}

// What a response.done says about the end of its response. completed (or no status) is 200. failed is the realtime
// error its status_details carry, with Bifrost's status for it (realtimeErrorStatus) and its message. cancelled (the
// caller's response.cancel, or a turn the caller's speech cut off) is 499, the status Bifrost logs a cancelled
// request with. incomplete (max_output_tokens, a content filter) delivered what it had, so it is 200 as Bifrost logs
// it, with the reason beside it.
export function doneOutcome(m: string): DoneOutcome {
  const state = strAt(m, ["response", "status"])
  const reason = strAt(m, ["response", "status_details", "reason"])
  if (state === "failed") {
    const e = ["response", "status_details", "error"]
    const type = strAt(m, e.concat(["type"]))
    const code = strAt(m, e.concat(["code"]))
    const msg = strAt(m, e.concat(["message"]))
    return { state: state, reason: reason !== "" ? reason : code, status: realtimeErrorStatus([type, code, msg]), error: msg.trim() !== "" ? msg.trim() : "realtime turn failed" }
  }
  if (state === "cancelled") return { state: state, reason: reason, status: 499, error: "the response was cancelled" + (reason !== "" ? " (" + reason + ")" : "") }
  return { state: state, reason: reason, status: 200, error: "" }
}

// One finished session, for its gauge and totals.
export type LiveReport = {
  sessionId: string,
  // voice time the provider reported, and what is billed (at least the minimum)
  seconds: f64,
  billedSeconds: f64,
  promptTokens: int,
  completionTokens: int,
  // the same tokens by the model that used them (the realtime model, or the models of delegated responses)
  uses: ModelTokens[],
  status: int,
  error: string,
  reason: string,
  startedMs: f64,
  endedMs: f64,
  input: string,
  output: string,
  events: int,
}

type TranscriptLine = { role: string, text: string }

// The client's events that carry text a guard should see, in the order they come: the field that
// holds it, and the text. A rewrite puts guarded text back (rewriteTexts).
export function clientTexts(type: string, m: string): string[] {
  const out: string[] = []
  if (type === "session.update" || type === "session.start") {
    const a = strAt(m, ["session", "instructions"])
    if (a !== "") out.push(a)
    const b = strAt(m, ["session", "delegation", "responses", "instructions"])
    if (b !== "") out.push(b)
  } else if (type === "session.instructions.append" || type === "session.thinking.append" || type === "session.commentary.append") {
    const a = strAt(m, ["content"])
    if (a !== "") out.push(a)
  } else if (type === "response.item.create" || type === "conversation.item.create") {
    const item = jsonAt(m, ["item"])
    if (item !== undefined) {
      const o = strAt(item, ["output"])
      if (o !== "") out.push(o)
      const c = jsonAt(item, ["content"])
      if (c !== undefined && c.trim().startsWith("[")) {
        try {
          for (const part of elements(c)) {
            const t = strAt(part, ["text"])
            if (t !== "") out.push(t)
          }
        } catch (e) {
          // not an array of parts: nothing to guard
        }
      }
    }
  } else if (type === "response.create") {
    const a = strAt(m, ["response", "instructions"])
    if (a !== "") out.push(a)
  }
  return out
}

// The same event with its guarded texts replaced, in the order clientTexts gave them.
export function rewriteClientTexts(type: string, m: string, texts: string[]): string {
  let i = 0
  const next = (): string => {
    const t = texts[i] ?? ""
    i += 1
    return quote(t)
  }
  try {
    if (type === "session.update" || type === "session.start") {
      let out = m
      if (strAt(out, ["session", "instructions"]) !== "") out = withJsonAt(out, ["session", "instructions"], next())
      if (strAt(out, ["session", "delegation", "responses", "instructions"]) !== "") out = withJsonAt(out, ["session", "delegation", "responses", "instructions"], next())
      return out
    }
    if (type === "session.instructions.append" || type === "session.thinking.append" || type === "session.commentary.append") {
      return strAt(m, ["content"]) !== "" ? withJsonAt(m, ["content"], next()) : m
    }
    if (type === "response.item.create" || type === "conversation.item.create") {
      const item = jsonAt(m, ["item"])
      if (item === undefined) return m
      let it = item
      if (strAt(it, ["output"]) !== "") it = withJsonAt(it, ["output"], next())
      const c = jsonAt(it, ["content"])
      if (c !== undefined && c.trim().startsWith("[")) {
        const parts: string[] = []
        for (const part of elements(c)) {
          parts.push(strAt(part, ["text"]) !== "" ? withJsonAt(part, ["text"], next()) : part)
        }
        it = withJsonAt(it, ["content"], "[" + parts.join(",") + "]")
      }
      return withJsonAt(m, ["item"], it)
    }
    if (type === "response.create") {
      return strAt(m, ["response", "instructions"]) !== "" ? withJsonAt(m, ["response", "instructions"], next()) : m
    }
  } catch (e) {
    return m
  }
  return m
}

// The provider event's text a guard checks: an output transcript delta, or a delegated response's text
// delta. "" when the event carries none.
export function providerText(type: string, m: string): string {
  if (type === "session.output_transcript.delta") return strAt(m, ["delta"])
  if (type === "response.event" && strAt(m, ["event", "type"]) === "response.output_text.delta") return strAt(m, ["event", "delta"])
  // the realtime API: text and audio transcript deltas, in the GA and the beta names; and what the
  // provider transcribed of the caller's audio
  if (isRealtimeOutputDelta(type)) return strAt(m, ["delta"])
  if (type === INPUT_TRANSCRIPT) return strAt(m, ["transcript"])
  return ""
}

// The realtime events whose delta is output text.
function isRealtimeOutputDelta(type: string): bool {
  return type === "response.output_text.delta" || type === "response.text.delta" || type === "response.output_audio_transcript.delta" || type === "response.audio_transcript.delta"
}

const INPUT_TRANSCRIPT = "conversation.item.input_audio_transcription.completed"
// What Bifrost answers a response.create made while a response is running.
const ACTIVE_RESPONSE = "Conversation already has an active response in progress."

// The check of a live session.update before it reaches the provider (live.tov checkDelegation): the frame to send (its
// delegated-responses model put as the provider names it) and the backend model it switches to ("" for none), or the
// refusal (message not "") the client is sent instead.
export type UpdateCheck = { frame: string, model: string, status: int, type: string, message: string }

// What a provider event's text is checked as: "input" for the transcript of the caller's own audio, "output" for
// anything the model said.
export function providerSource(type: string): string {
  return type === INPUT_TRANSCRIPT ? "input" : "output"
}

function withProviderText(type: string, m: string, text: string): string {
  try {
    if (type === "session.output_transcript.delta" || isRealtimeOutputDelta(type)) return withJsonAt(m, ["delta"], quote(text))
    if (type === INPUT_TRANSCRIPT) return withJsonAt(m, ["transcript"], quote(text))
    return withJsonAt(m, ["event", "delta"], quote(text))
  } catch (e) {
    return m
  }
}

export class LiveCore {
  filter: LiveEventFilter | undefined = undefined
  // the least voice time billed (the provider bills a created WebRTC session this much)
  minimum = LIVE_MINIMUM_SECONDS
  // A realtime session (the Realtime API: OpenAI, Azure, xAI) rather than a GPT Live one. It has no
  // session.close or session.closed and no voice seconds: it is admitted again at each turn, its tokens
  // come from response.done, and it ends when either side leaves.
  realtime = false
  // A realtime transcription session (?intent=transcription, or a call whose session is of type transcription): its
  // units are the transcriptions of the caller's audio (conversation.item.input_audio_transcription.completed), each
  // billed from the usage that event reports at the model's transcription rates.
  transcription = false
  // the model the session runs, which the tokens of its own responses (realtime) are billed under, and the
  // model of a live session's delegated responses when they name none
  model = ""
  backendModel = ""
  // a live session's check of each session.update (Bifrost's liveUpdatePolicy), when it has one
  checkUpdate: ((m: string) => UpdateCheck) | undefined = undefined
  // a turn (a response, from its start to its response.done) is running
  turnActive = false
  // what the next realtime turn's request is made of (turnRequestJson): the caller's inputs since the last turn, the
  // response.create that starts it, the session's tools; and whether the running turn's pre hooks ran (its post hooks
  // are owed)
  turnInputs: string[] = []
  pendingCreate = ""
  sessionTools = ""
  turnHooked = false
  // the provider's connection ended abnormally
  providerFailed = false
  uses: ModelTokens[] = []
  sessionId = ""
  // the units already closed: how many, the voice seconds they were reported and billed, and when the
  // voice unit and the realtime turn that are open began
  units = 0
  emittedBilled = 0.0
  emittedAudio = 0.0
  unitStartMs: f64 = 0.0
  turnStartMs: f64 = 0.0
  // delegated responses that finished after the session was refused: billed on the unit that ends it
  pendingUses: ModelTokens[] = []
  lastBackendMs: f64 = 0.0
  // the provider's latest cumulative voice seconds, and those not yet checked against a window
  reported = 0.0
  accrued = 0.0
  promptTokens = 0
  completionTokens = 0
  startedMs: f64 = 0.0
  lastUsageMs: f64 = 0.0
  nextStaleMs: f64 = 0.0
  // when the drain after a session.close ends (0: none running)
  drainAt: f64 = 0.0
  // session.closed arrived, the browser is gone, the session is over and reported, session.close went out
  sessionClosed = false
  clientGone = false
  finished = false
  closeSent = false
  // nothing more is sent to the browser (a refusal, or an id that could not be recorded)
  withhold = false
  refused = false
  status = 200
  error = ""
  reason = ""
  events = 0
  lines: TranscriptLine[] = []
  transcriptBytes = 0
  tail: string[] = []
  billed: Set<string> = new Set<string>()
  // the clock as of the last call into the core
  now: f64 = 0.0

  constructor(readonly io: LiveIO, readonly hooks: LiveHooks, nowMs: f64) {
    this.startedMs = nowMs
    this.unitStartMs = nowMs
    this.lastUsageMs = nowMs
    this.nextStaleMs = nowMs + STALE_EVERY_MS
  }

  // ---- browser to provider

  // The texts of a browser event a guard should check.
  clientTextsOf(m: string): string[] {
    return clientTexts(eventType(m), m)
  }

  // Passes a browser event on (guards have run; texts are what they left, or empty when nothing was
  // checked). A session.close starts the drain.
  fromClient(m: string, texts: string[], nowMs: f64): void {
    this.now = nowMs
    if (this.finished) return
    const type = eventType(m)
    let out = m
    if (texts.length > 0) out = rewriteClientTexts(type, m, texts)
    this.hooks.count("in", type)
    this.events += 1
    // the turn hooks' request: the caller's messages and tool outputs, and the session's tools
    if (this.realtime) {
      const inp = turnInputOf(type, out)
      if (inp !== "" && this.turnInputs.length < 256) this.turnInputs.push(inp)
      if (type === "session.update") this.noteTools(out)
    }
    // a realtime turn the caller starts is admitted first; a refusal ends the session and the event goes nowhere. A
    // response.create while a turn is running is refused and goes nowhere either, as Bifrost does (the session goes on)
    if (this.realtime && type === "response.create") {
      if (this.turnActive) {
        this.io.toClient(errorEvent("invalid_request_error", ACTIVE_RESPONSE))
        return
      }
      this.pendingCreate = out
      this.startTurn()
      if (this.refused) return
    }
    // a live session.update that names a delegated-responses model is checked first: a refused one goes nowhere and the
    // session goes on; an admitted one switches the model its delegated responses are billed under
    const chk = this.checkUpdate
    if (!this.realtime && type === "session.update" && chk !== undefined) {
      const c = chk(out)
      if (c.message !== "") {
        this.io.toClient(errorEvent(c.type, c.message))
        return
      }
      out = c.frame
      if (c.model !== "") this.backendModel = c.model
    }
    if (type === "session.close") {
      this.closeSent = true
      this.startDrain(nowMs)
    }
    this.io.toProvider(out)
  }

  // A guard refused a browser event: the browser is told, the event goes nowhere.
  refuseClient(reason: string): void {
    this.io.toClient(errorEvent("guardrail_violation", "request blocked by guardrails: " + reason))
  }

  // ---- provider to browser

  // The output text of a provider event a guard should check ("" for none), and the window it is
  // checked in: the last deltas, so a secret split across tokens is seen.
  providerTextOf(m: string): string {
    return providerText(eventType(m), m)
  }

  outputWindow(delta: string): string {
    return this.tail.join("") + delta
  }

  // Handles a provider event: metering and state first, then it goes to the browser (unless withheld or
  // filtered). repl is the guarded replacement of its text, or undefined when it was not changed.
  fromProvider(m: string, repl: string | undefined, nowMs: f64): void {
    this.now = nowMs
    if (this.finished) return
    const type = eventType(m)
    this.hooks.count("out", type)
    this.events += 1
    let out = m
    // (an if chain: a switch on a string variable releases the string twice in this compiler)
    if (this.realtime) {
      out = this.realtimeEvent(type, m, repl)
    } else if (type === "session.started") {
      if (this.startedMs === 0.0) this.startedMs = nowMs
      const id = strAt(m, ["session", "id"])
      if (id !== "") {
        this.sessionId = id
        if (!this.hooks.bind(id)) {
          // the id is never forwarded: this frame and every later one are withheld
          this.withhold = true
          this.endForRefusal("server_error", "the live session could not be recorded for its virtual key and was not opened", 500)
        }
      }
    } else if (type === "session.input_transcript.delta") {
      this.append("user", strAt(m, ["delta"]))
    } else if (type === "session.output_transcript.delta") {
      const d = strAt(m, ["delta"])
      this.append("assistant", d)
      this.note(d)
      if (repl !== undefined) out = withProviderText(type, m, repl)
    } else if (type === "session.usage.updated") {
      this.onUsage(numAt(m, ["usage", "seconds"]), nowMs)
    } else if (type === "response.event") {
      const et = strAt(m, ["event", "type"])
      if (et === "response.output_text.delta") {
        this.note(strAt(m, ["event", "delta"]))
        if (repl !== undefined) out = withProviderText(type, m, repl)
      } else if (et === "response.completed" || et === "response.incomplete" || et === "response.failed") {
        this.onBackend(m)
      }
    } else if (type === "session.closed") {
      this.sessionClosed = true
      this.reason = strAt(m, ["reason"])
      this.finish(numAt(m, ["usage", "seconds"]), nowMs)
    }
    if (this.withhold) return
    let sent: string | undefined = out
    const f = this.filter
    if (f !== undefined) sent = f.clientMessage(out)
    if (sent !== undefined) this.io.toClient(sent)
  }

  // A guard blocked provider output: the browser is told, nothing more reaches it, and the session
  // is closed upstream so what it used is still reported.
  blockOutput(reason: string): void {
    this.endForRefusal("guardrail_violation", "response blocked by guardrails: " + reason, 400)
  }

  // A guard blocked what the provider transcribed of the caller's audio: the audio is already with the
  // provider, so the session ends.
  blockInput(reason: string): void {
    this.endForRefusal("guardrail_violation", "request blocked by guardrails: " + reason, 400)
  }

  // The source ("input" or "output") a guard checks a provider event's text as.
  providerSourceOf(m: string): string {
    return providerSource(eventType(m))
  }

  // A realtime turn starts: it is admitted (the first one with the connection, each later one here), and
  // a budget or limit that ran out ends the session.
  private startTurn(): void {
    if (this.turnActive || this.finished || this.refused) return
    this.turnActive = true
    this.turnStartMs = this.now
    this.lastUsageMs = this.now
    const why = this.hooks.readmit()
    if (why !== undefined) {
      this.endForRefusal(why.type, why.message, why.status)
      return
    }
    // the plugins' pre hooks on the turn's request (Bifrost's RunRealtimeTurnPreHooks): a refusal (a short-circuit error,
    // or a short-circuit answer, which a turn cannot take) closes the session with its error, as Bifrost closes it
    const pre = this.hooks.turnPre
    const create = this.pendingCreate
    this.pendingCreate = ""
    if (!this.realtime || pre === undefined) return
    const r = pre(turnRequestJson(this.turnInputs, create, this.sessionTools))
    if (r !== undefined) {
      this.turnInputs = []
      this.endForRefusal(r.type, r.message, r.status)
      return
    }
    this.turnHooked = true
  }

  // The session's tools, from a session.update the caller sent or a session.created or session.updated the provider sent.
  private noteTools(m: string): void {
    const t = jsonAt(m, ["session", "tools"])
    if (t !== undefined && t.trim().startsWith("[")) this.sessionTools = t
  }

  // The turn's post hooks, on its response (status 200) or its error: a refusal is a post hook's error.
  private turnDone(status: int, body: string): Refusal | undefined {
    const post = this.hooks.turnPost
    const hooked = this.turnHooked
    this.turnHooked = false
    this.turnInputs = []
    if (!hooked || post === undefined) return undefined
    return post(status, body)
  }

  // The realtime events that carry state: the turn they start or end, the transcripts and the output
  // text (checked above, repl is what the guard left), and the usage of a finished response.
  private realtimeEvent(type: string, m: string, repl: string | undefined): string {
    let out = m
    if (type === "session.created" || type === "session.updated") this.noteTools(m)
    if (type === INPUT_TRANSCRIPT && !this.transcription) {
      const inp = turnInputOf(type, m)
      if (inp !== "" && this.turnInputs.length < 256) this.turnInputs.push(inp)
    }
    if (type === "session.created") {
      const id = strAt(m, ["session", "id"])
      if (id !== "" && this.sessionId === "") this.sessionId = id
    } else if (type === "response.created" || type === "input_audio_buffer.committed") {
      this.startTurn()
    } else if (type === INPUT_TRANSCRIPT) {
      if (this.transcription) {
        if (repl !== undefined) out = withProviderText(type, m, repl)
        this.onTranscribed(m)
      } else {
        this.append("user", strAt(m, ["transcript"]))
        if (repl !== undefined) out = withProviderText(type, m, repl)
      }
    } else if (isRealtimeOutputDelta(type)) {
      const d = strAt(m, ["delta"])
      this.append("assistant", d)
      this.note(d)
      if (repl !== undefined) out = withProviderText(type, m, repl)
    } else if (type === "response.done") {
      this.turnActive = false
      this.onRealtimeDone(m)
    }
    return out
  }

  // A realtime response finished: its usage joins the session's (once per response) and closes the turn,
  // which is logged and charged on its own.
  private onRealtimeDone(m: string): void {
    const id = strAt(m, ["response", "id"])
    if (id !== "") {
      if (this.billed.has(id)) return
      this.billed.add(id)
    }
    const u = ["response", "usage"]
    const used = this.addTokens(this.model, Math.trunc(numAt(m, u.concat(["input_tokens"]))), Math.trunc(numAt(m, u.concat(["output_tokens"]))),
      Math.trunc(numAt(m, u.concat(["input_token_details", "cached_tokens"]))), Math.trunc(numAt(m, u.concat(["input_token_details", "audio_tokens"]))),
      Math.trunc(numAt(m, u.concat(["output_token_details", "audio_tokens"]))))
    const text = this.takeText()
    const began = this.turnStartMs > 0.0 ? this.turnStartMs : this.now
    this.turnStartMs = 0.0
    let outcome = doneOutcome(m)
    // the turn's post hooks (its response, or the error a failed or cancelled response is); a post hook's error is the
    // turn's error, and the session ends after its row, as Bifrost closes it with the error
    const refused = this.turnDone(outcome.status, outcome.status === 200 ? turnResponseJson(this.model, m, text.output) : turnErrorJson(outcome.status, outcome.error))
    if (refused !== undefined) outcome = { state: outcome.state, reason: outcome.reason, status: refused.status, error: refused.message }
    this.emit("turn", 0.0, 0.0, [used], text.input, text.output, began, this.now, false, outcome)
    if (refused !== undefined) this.endForRefusal(refused.type, refused.message, refused.status)
  }

  // A transcription of the caller's audio finished: the unit is admitted if no commit opened it, then its usage (tokens,
  // or the seconds of audio for a model billed by duration) is logged and charged on its own, once per item.
  private onTranscribed(m: string): void {
    const item = strAt(m, ["item_id"])
    if (item !== "") {
      if (this.billed.has("item:" + item)) return
      this.billed.add("item:" + item)
    }
    if (!this.turnActive) {
      this.startTurn()
      if (this.refused) return
    }
    this.turnActive = false
    // the transcript is the unit's output: a transcription session answers with what the caller said
    this.append("assistant", strAt(m, ["transcript"]))
    let used: ModelTokens = { model: this.model, prompt: 0, completion: 0, cached: 0, inputAudio: 0, outputAudio: 0 }
    let seconds = 0.0
    if (strAt(m, ["usage", "type"]) === "duration") {
      seconds = numAt(m, ["usage", "seconds"])
    } else {
      used = this.addTokens(this.model, Math.trunc(numAt(m, ["usage", "input_tokens"])), Math.trunc(numAt(m, ["usage", "output_tokens"])), 0,
        Math.trunc(numAt(m, ["usage", "input_token_details", "audio_tokens"])), 0)
    }
    const text = this.takeText()
    const began = this.turnStartMs > 0.0 ? this.turnStartMs : this.now
    this.turnStartMs = 0.0
    const refused = this.turnDone(200, turnResponseJson(this.model, `{"response":{"usage":{"input_tokens":${used.prompt},"output_tokens":${used.completion}}}}`, text.output))
    const outcome: DoneOutcome | undefined = refused === undefined ? undefined : { state: "", reason: "", status: refused.status, error: refused.message }
    this.emit("transcription", seconds, 0.0, [used], text.input, text.output, began, this.now, false, outcome)
    if (refused !== undefined) this.endForRefusal(refused.type, refused.message, refused.status)
  }

  // Adds tokens to the session's totals and to the model's; what was added is returned.
  private addTokens(model: string, prompt: int, completion: int, cached: int, inputAudio: int, outputAudio: int): ModelTokens {
    this.promptTokens += prompt
    this.completionTokens += completion
    const added: ModelTokens = { model: model, prompt: prompt, completion: completion, cached: cached, inputAudio: inputAudio, outputAudio: outputAudio }
    for (let i = 0; i < this.uses.length; i++) {
      const u = this.uses[i]!
      if (u.model === model) {
        this.uses[i] = { model: model, prompt: u.prompt + prompt, completion: u.completion + completion, cached: u.cached + cached, inputAudio: u.inputAudio + inputAudio, outputAudio: u.outputAudio + outputAudio }
        return added
      }
    }
    this.uses.push(added)
    return added
  }

  // The transcript lines so far as the text a row holds (the caller's, the model's), and they start over.
  private takeText(): { input: string, output: string } {
    let input = ""
    let output = ""
    for (const l of this.lines) {
      if (l.role === "user") input += (input === "" ? "" : "\n") + l.text
      else output += (output === "" ? "" : "\n") + l.text
    }
    this.lines = []
    this.transcriptBytes = 0
    return { input: input, output: output }
  }

  // A billing unit closes: its row is handed to the gateway, which logs it and charges it (budgets and
  // token limits) at once.
  // A response's outcome (outcome) gives its row's status and error; otherwise a unit is 200 unless it ends the session.
  private emit(kind: string, seconds: f64, billed: f64, uses: ModelTokens[], input: string, output: string, startedMs: f64, endedMs: f64, last: bool, outcome: DoneOutcome | undefined): void {
    this.units += 1
    let prompt = 0
    let completion = 0
    for (const u of uses) {
      prompt += u.prompt
      completion += u.completion
    }
    let status = last ? this.status : 200
    let error = last ? this.error : ""
    let state = ""
    let stateReason = ""
    if (outcome !== undefined) {
      status = outcome.status
      error = outcome.error
      state = outcome.state
      stateReason = outcome.reason
    }
    this.hooks.turn({
      kind: kind, index: this.units, sessionId: this.sessionId, seconds: seconds, billedSeconds: billed, promptTokens: prompt, completionTokens: completion, uses: uses,
      status: status, error: error, reason: last ? this.reason : "", startedMs: startedMs, endedMs: endedMs, input: input, output: output,
      events: this.events, last: last, state: state, stateReason: stateReason,
    })
  }

  // A voice unit closes: its seconds, as reported and as billed.
  private emitVoice(kind: string, seconds: f64, billed: f64, last: bool, input: string, output: string): void {
    this.emittedAudio += seconds
    this.emittedBilled += billed
    const began = this.unitStartMs
    this.unitStartMs = this.now
    this.emit(kind, seconds, billed, [], input, output, began, this.now, last, undefined)
  }

  private append(role: string, delta: string): void {
    if (delta === "" || this.transcriptBytes + delta.byteLength > TRANSCRIPT_MAX) return
    this.transcriptBytes += delta.byteLength
    const n = this.lines.length
    if (n > 0 && this.lines[n - 1]!.role === role) {
      this.lines[n - 1] = { role: role, text: this.lines[n - 1]!.text + delta }
    } else {
      this.lines.push({ role: role, text: delta })
    }
  }

  // Keeps the last output deltas for the guard's window.
  private note(delta: string): void {
    if (delta === "") return
    this.tail.push(delta)
    if (this.tail.length > 16) this.tail.shift()
  }

  private onUsage(cumulative: f64, nowMs: f64): void {
    this.lastUsageMs = nowMs
    if (cumulative > this.reported) {
      this.accrued += cumulative - this.reported
      this.reported = cumulative
    }
    if (this.accrued >= LIVE_WINDOW_SECONDS) this.window()
  }

  // The next window starts: the session is admitted for it again (a budget or limit that ran out
  // ends the session, and the open window is billed with it). Otherwise the window that ends is
  // logged and charged now, with the voice seconds that accrued in it.
  private window(): void {
    if (this.finished || this.refused) return
    const why = this.hooks.readmit()
    if (why !== undefined) {
      this.endForRefusal(why.type, why.message, why.status)
      return
    }
    const seconds = this.accrued
    this.accrued = 0.0
    // (an idle session meets its budget check here, but a window with no voice time is not a row)
    if (seconds > 0.0) this.emitVoice("window", seconds, seconds, false, "", "")
  }

  // A delegated response finished: its token usage joins the session's (once per response). The next
  // unit is admitted, then this response is logged and charged on its own; a refusal ends the session and
  // the response is billed with it.
  private onBackend(m: string): void {
    const id = strAt(m, ["event", "response", "id"])
    if (id !== "") {
      if (this.billed.has(id)) return
      this.billed.add(id)
    }
    // the tokens are billed under the model the response names, else the session's backend model
    let model = strAt(m, ["event", "response", "model"])
    if (model === "") model = this.backendModel
    if (model === "") model = this.model
    const u = ["event", "response", "usage"]
    const used = this.addTokens(model, Math.trunc(numAt(m, u.concat(["input_tokens"]))), Math.trunc(numAt(m, u.concat(["output_tokens"]))),
      Math.trunc(numAt(m, u.concat(["input_tokens_details", "cached_tokens"]))), 0, 0)
    if (this.finished || this.refused) {
      this.pendingUses.push(used)
      return
    }
    const began = this.lastBackendMs > 0.0 ? this.lastBackendMs : this.startedMs
    const why = this.hooks.readmit()
    if (why !== undefined) {
      this.pendingUses.push(used)
      this.endForRefusal(why.type, why.message, why.status)
      return
    }
    this.lastBackendMs = this.now
    this.emit("delegation", 0.0, 0.0, [used], "", "", began, this.now, false, undefined)
  }

  // Tells the browser why the session is ending, then closes it upstream so the usage already spent
  // is still reported.
  private endForRefusal(type: string, message: string, status: int): void {
    if (this.refused) return
    this.refused = true
    this.status = status
    this.error = message
    this.io.toClient(errorEvent(type, message))
    this.withhold = true
    if (this.realtime) {
      // nothing to wait for: the session is reported and both connections are let go
      this.finish(this.reported, this.now)
      this.io.abandon()
      return
    }
    this.requestClose()
  }

  // ---- ends

  // The browser's connection or channel ended: the provider is asked to close, and the session lives
  // on until session.closed, so its final usage is billed.
  clientLeft(nowMs: f64): void {
    this.now = nowMs
    if (this.clientGone) return
    this.clientGone = true
    this.withhold = true
    if (this.realtime) {
      this.finish(this.reported, nowMs)
      return
    }
    this.requestClose()
    this.startDrain(nowMs)
  }

  private requestClose(): void {
    if (this.closeSent || this.finished) return
    this.closeSent = true
    this.io.toProvider(`{"type":"session.close"}`)
    this.startDrain(this.now)
  }

  private startDrain(nowMs: f64): void {
    if (this.drainAt === 0.0) this.drainAt = nowMs + DRAIN_MS
  }

  // The provider's connection ended. Without a session.closed, what it last reported is billed, and a
  // browser still connected is told.
  providerEnded(nowMs: f64): void {
    this.now = nowMs
    if (this.finished) return
    if (this.realtime) {
      // a realtime provider just hangs up: only a connection that broke is an error
      if (this.providerFailed && !this.clientGone && !this.refused) {
        const msg = "the realtime session's upstream connection was interrupted"
        if (this.status === 200) {
          this.status = 502
          this.error = msg
        }
        if (!this.withhold) this.io.toClient(errorEvent("server_error", msg))
      }
      this.finish(this.reported, nowMs)
      return
    }
    const early = !this.sessionClosed && !this.clientGone
    if (early) {
      if (this.status === 200 && !this.closeSent) {
        this.status = 502
        this.error = "the live session's upstream connection ended before session.closed"
      }
      if (!this.withhold) this.io.toClient(errorEvent("server_error", "the live session's upstream connection ended before session.closed"))
    }
    this.finish(this.reported, nowMs)
  }

  // The session's setup failed after the provider created it: the minimum is billed, with the error.
  abort(status: int, message: string, nowMs: f64): void {
    this.now = nowMs
    if (this.finished) return
    if (this.status === 200) {
      this.status = status
      this.error = message
    }
    this.finish(this.reported, nowMs)
  }

  // Closes the last billing unit, and reports the session, once. The unit that ends a live session carries
  // what the earlier ones did not: the rest of the voice time (at least the minimum, in all), the
  // transcript, the status and the close reason. A realtime session ends with a row only when something is
  // left: a refusal or failure, a turn that never finished, or text no turn took.
  finish(finalSeconds: f64, nowMs: f64): void {
    if (this.finished) return
    this.finished = true
    this.now = nowMs
    this.drainAt = 0.0
    let seconds = finalSeconds
    if (this.reported > seconds) seconds = this.reported
    const billed = seconds < this.minimum ? this.minimum : seconds
    const text = this.takeText()
    if (this.realtime) {
      // a turn whose pre hooks ran and that never finished: its post hooks get the error the session ended with
      if (this.turnHooked) {
        const st = this.status !== 200 ? this.status : 499
        this.turnDone(st, turnErrorJson(st, this.error !== "" ? this.error : "the realtime session ended before the turn finished"))
      }
      if (this.status !== 200 || this.turnActive || text.input !== "" || text.output !== "") {
        this.emit("end", 0.0, 0.0, [], text.input, text.output, this.turnStartMs > 0.0 ? this.turnStartMs : nowMs, nowMs, true, undefined)
      }
    } else {
      if (this.pendingUses.length > 0) {
        this.emit("delegation", 0.0, 0.0, this.pendingUses, "", "", this.lastBackendMs > 0.0 ? this.lastBackendMs : this.startedMs, nowMs, false, undefined)
        this.pendingUses = []
      }
      const rest = seconds - this.emittedAudio
      const owed = billed - this.emittedBilled
      this.emitVoice("end", rest > 0.0 ? rest : 0.0, owed > 0.0 ? owed : 0.0, true, text.input, text.output)
    }
    this.hooks.report({
      sessionId: this.sessionId, seconds: seconds, billedSeconds: billed, promptTokens: this.promptTokens, completionTokens: this.completionTokens, uses: this.uses,
      status: this.status, error: this.error, reason: this.reason, startedMs: this.startedMs, endedMs: nowMs, input: text.input, output: text.output, events: this.events,
    })
  }

  // The clock: the drain after a close ends (the relay is abandoned), and an idle session meets its window.
  tick(nowMs: f64): void {
    this.now = nowMs
    if (this.finished) return
    if (this.drainAt > 0.0 && nowMs >= this.drainAt) {
      this.drainAt = 0.0
      this.io.abandon()
      return
    }
    // (a realtime session has no voice windows: it is admitted at each turn)
    if (!this.realtime && nowMs >= this.nextStaleMs) {
      this.nextStaleMs = nowMs + STALE_EVERY_MS
      if (nowMs - this.lastUsageMs >= STALE_AFTER_MS && !this.closeSent) {
        this.lastUsageMs = nowMs
        this.window()
      }
    }
  }
}

// ---------------------------------------------------------------- the relay

// One leg of the relay (the browser's, or the provider's): what the relay needs of a peer connection,
// as closures, so the relay runs on fake legs in tests.
// close gets the WebSocket close code and reason a leg that is a WebSocket ends with (a peer connection has no use for them).
export class Leg {
  constructor(readonly sendText: (m: string) => bool, readonly sendPacket: (p: u8[]) => bool, readonly buffered: () => int, readonly close: (code: int, reason: string) => void) {}
}

// Checks a piece of text against the gateway's guardrails (source "input" or "output").
export type GuardFn = (text: string, source: string) => Promise<Verdict>

class Cell {
  weak relay: Relay | undefined
}

// The browser and the provider joined by a LiveCore. Messages cross as text; a message sent before its
// channel is open waits (up to PENDING_MAX of them). With guardrails on, each direction is a queue that
// is checked in order. Audio crosses as packets, without waiting for anything.
export class Relay {
  core: LiveCore
  client: Leg | undefined = undefined
  provider: Leg | undefined = undefined
  clientOpen = false
  providerOpen = false
  closing = false
  closed = false
  setupDone = false
  private cell: Cell
  private pendingClient: string[] = []
  private pendingProvider: string[] = []
  private qUp: string[] = []
  private qDown: string[] = []
  private busyUp = false
  private busyDown = false
  private packetsIn = 0
  private packetsOut = 0
  // runs once the relay is closed (the registry forgets it)
  onClosed: (() => void) | undefined = undefined
  // the clock's timer, cleared on close
  ticker: ((() => void) | undefined) = undefined

  constructor(hooks: LiveHooks, readonly guard: GuardFn | undefined, nowMs: f64) {
    const cell = new Cell()
    this.cell = cell
    const io = new LiveIO((m) => {
      const r = cell.relay
      if (r !== undefined) r.sendClient(m)
    }, (m) => {
      const r = cell.relay
      if (r !== undefined) r.sendProvider(m)
    }, () => {
      const r = cell.relay
      if (r !== undefined) r.abandon()
    })
    this.core = new LiveCore(io, hooks, nowMs)
    cell.relay = this
  }

  // ---- text

  sendClient(m: string): void {
    const c = this.client
    if (this.closed || c === undefined) return
    if (this.clientOpen && this.pendingClient.length === 0) {
      c.sendText(m)
      return
    }
    if (this.pendingClient.length >= PENDING_MAX) {
      this.close()
      return
    }
    this.pendingClient.push(m)
  }

  sendProvider(m: string): void {
    const p = this.provider
    if (this.closed || p === undefined) return
    if (this.providerOpen && this.pendingProvider.length === 0) {
      p.sendText(m)
      return
    }
    if (this.pendingProvider.length >= PENDING_MAX) {
      this.close()
      return
    }
    this.pendingProvider.push(m)
  }

  // A channel opened: what waited for it goes out.
  channelOpened(isClient: bool): void {
    if (this.closed) return
    if (isClient) {
      this.clientOpen = true
      const c = this.client
      const q = this.pendingClient
      this.pendingClient = []
      if (c !== undefined) for (const m of q) c.sendText(m)
    } else {
      this.providerOpen = true
      const p = this.provider
      const q = this.pendingProvider
      this.pendingProvider = []
      if (p !== undefined) for (const m of q) p.sendText(m)
    }
  }

  // A message from the browser's data channel.
  fromBrowser(m: string): void {
    if (this.closed) return
    this.qUp.push(m)
    if (!this.busyUp) this.drainUp()
  }

  // A message from the provider's data channel.
  fromProvider(m: string): void {
    if (this.closed) return
    this.qDown.push(m)
    if (!this.busyDown) this.drainDown()
  }

  // The browser's queue: events with nothing to guard go straight through; one with text to check
  // waits for the guard, and the events behind it wait for that one.
  private drainUp(): void {
    while (this.qUp.length > 0 && !this.closed) {
      const m = this.qUp[0]!
      if (this.guard !== undefined && this.core.clientTextsOf(m).length > 0) {
        this.busyUp = true
        this.guardUp()
        return
      }
      this.qUp.shift()
      this.core.fromClient(m, [], Date.now())
      if (this.core.finished) this.endSoon()
    }
  }

  private async guardUp(): Promise<void> {
    const m = this.qUp.shift()!
    const g = this.guard
    const texts = this.core.clientTextsOf(m)
    if (g !== undefined && !this.closed) {
      const out: string[] = []
      let changed = false
      let refused = false
      for (const t of texts) {
        const v = await g(t, "input")
        if (v.action === "block") {
          this.core.refuseClient(v.reason)
          refused = true
          break
        }
        if (v.action === "redact") {
          out.push(v.text)
          changed = true
        } else {
          out.push(t)
        }
      }
      if (!refused && !this.closed) this.core.fromClient(m, changed ? out : [], Date.now())
      if (this.core.finished) this.endSoon()
    }
    this.busyUp = false
    this.drainUp()
  }

  // The provider's queue, the same way: only output text is checked.
  private drainDown(): void {
    while (this.qDown.length > 0 && !this.closed) {
      const m = this.qDown[0]!
      if (this.guard !== undefined && this.core.providerTextOf(m) !== "") {
        this.busyDown = true
        this.guardDown()
        return
      }
      this.qDown.shift()
      this.core.fromProvider(m, undefined, Date.now())
      if (this.core.finished) this.endSoon()
    }
  }

  private async guardDown(): Promise<void> {
    const m = this.qDown.shift()!
    const g = this.guard
    const t = this.core.providerTextOf(m)
    const source = this.core.providerSourceOf(m)
    let repl: string | undefined = undefined
    let blocked = ""
    if (g !== undefined) {
      // output is checked with the deltas before it, so a secret split across tokens is seen
      const v = await g(source === "output" ? this.core.outputWindow(t) : t, source)
      if (v.action === "block") {
        blocked = v.reason
      } else if (v.action === "redact") {
        // the window found something: the delta alone says what to put in its place
        const d = source === "output" ? await g(t, source) : v
        if (d.action === "redact") repl = d.text
      }
    }
    if (!this.closed) {
      if (blocked !== "") {
        if (source === "input") this.core.blockInput(blocked)
        else this.core.blockOutput(blocked)
      }
      this.core.fromProvider(m, repl, Date.now())
      if (this.core.finished) this.endSoon()
    }
    this.busyDown = false
    this.drainDown()
  }

  // ---- audio

  packetFromBrowser(p: u8[]): void {
    const o = this.provider
    if (this.closed || o === undefined) return
    const f = forwardRtp(p)
    if (f === undefined) return
    this.packetsIn += 1
    o.sendPacket(f)
  }

  packetFromProvider(p: u8[]): void {
    const o = this.client
    if (this.closed || o === undefined) return
    const f = forwardRtp(p)
    if (f === undefined) return
    this.packetsOut += 1
    o.sendPacket(f)
  }

  get packets(): int {
    return this.packetsIn + this.packetsOut
  }

  // ---- ends

  // The browser's connection or data channel ended.
  browserGone(): void {
    if (this.closed) return
    this.core.clientLeft(Date.now())
    // before the setup finished there is no session to wait for, and a realtime one has no closing exchange
    if (!this.setupDone || this.core.realtime) this.close()
  }

  // The provider's connection or data channel ended: what it last reported is billed and the relay ends.
  providerGone(): void {
    if (this.closed) return
    this.close()
  }

  // The provider's connection broke (it did not close normally).
  providerBroke(): void {
    if (this.closed) return
    this.core.providerFailed = true
    this.close()
  }

  // The drain after a close ran out: the provider is let go.
  abandon(): void {
    this.providerGone()
  }

  // The session is over (session.closed went out): the relay ends once the browser has it.
  private endSoon(): void {
    const r = this
    setTimeout(() => {
      r.close()
    }, 0)
  }

  // The clock, once a second.
  tick(nowMs: f64): void {
    if (this.closed) return
    this.core.tick(nowMs)
  }

  // Ends the relay: the session is reported, the browser gets what is queued for it, then both legs go.
  close(): void {
    if (this.closing) return
    this.closing = true
    this.core.providerEnded(Date.now())
    this.drain(Date.now() + BROWSER_DRAIN_MS)
  }

  // Waits for the browser's queue to empty (final events, errors), bounded.
  private drain(deadlineMs: f64): void {
    const c = this.client
    const pending = this.pendingClient.length > 0 || (c !== undefined && this.clientOpen && c.buffered() > 0)
    if (!pending || Date.now() >= deadlineMs || c === undefined) {
      this.finalize()
      return
    }
    const r = this
    setTimeout(() => {
      r.drain(deadlineMs)
    }, 10)
  }

  private finalize(): void {
    if (this.closed) return
    this.closed = true
    const t = this.ticker
    if (t !== undefined) t()
    this.ticker = undefined
    const c = this.client
    const p = this.provider
    this.client = undefined
    this.provider = undefined
    this.pendingClient = []
    this.pendingProvider = []
    this.qUp = []
    this.qDown = []
    // a WebSocket leg ends with the session's own outcome: refused, failed, or done
    const core = this.core
    let code = 1000
    let why = "session ended"
    if (core.refused) {
      code = 1008
      why = "refused"
    } else if (core.providerFailed || core.status !== 200) {
      code = 1011
      why = "session failed"
    }
    if (c !== undefined) c.close(code, why)
    if (p !== undefined) p.close(1000, "session ended")
    const done = this.onClosed
    this.onClosed = undefined
    this.cell.relay = undefined
    if (done !== undefined) done()
  }
}

// ---------------------------------------------------------------- the create handshake

// The provider's side of the handshake: status 0 with its SDP answer and session id, or the status, error
// and (when it sent one) its own error body and content type, which are passed on as they are.
export type Exchange = { status: int, type: string, message: string, sdp: string, sessionId: string, body: string, contentType: string }

export type Setup = {
  // the browser's SDP offer, and the provider's side of the exchange: it gets this gateway's own offer
  // and answers with the provider's SDP (status 0), or with the error to send the caller
  offer: string,
  exchange: (offer: string) => Promise<Exchange>,
  hooks: LiveHooks,
  guard: GuardFn | undefined,
  filter: LiveEventFilter | undefined,
  iceServers: string[],
  bindAddress: string,
  // a realtime call (POST /v1/realtime/calls) rather than a GPT Live session, the model it runs, and the
  // model a live session's delegated responses run on
  realtime: bool,
  model: string,
  backendModel: string,
  // a realtime transcription session (LiveCore.transcription)
  transcription?: bool,
  // a live session's check of each session.update (LiveCore.checkUpdate)
  checkUpdate?: (m: string) => UpdateCheck,
}

export type Established = { status: int, type: string, message: string, answer: string, sessionId: string, relay: Relay | undefined, body: string, contentType: string }

function failed(status: int, type: string, message: string): Established {
  return { status: status, type: type, message: message, answer: "", sessionId: "", relay: undefined, body: "", contentType: "" }
}

// Resolves when the connection has gathered its candidates (or the wait ran out).
function whenGathered(pc: RTCPeerConnection, ms: int): Promise<void> {
  return new Promise<void>((resolve) => {
    if (pc.gatheringState === "complete") {
      resolve()
      return
    }
    let done = false
    pc.ongatheringchange = (s) => {
      if (s === "complete" && !done) {
        done = true
        resolve()
      }
    }
    setTimeout(() => {
      if (!done) {
        done = true
        resolve()
      }
    }, ms)
  })
}

// Wait for a connection to connect: true when it does, false when it fails or closes first.
class Connect {
  waiting: ((ok: bool) => void) | undefined = undefined
  state = "new"

  fire(ok: bool): void {
    const w = this.waiting
    this.waiting = undefined
    if (w !== undefined) w(ok)
  }

  // Call with each state change of the connection.
  seen(st: string): void {
    this.state = st
    if (st === "connected") this.fire(true)
    else if (st === "failed" || st === "closed") this.fire(false)
  }

  wait(ms: int): Promise<bool> {
    const c = this
    return new Promise<bool>((resolve) => {
      if (c.state === "connected") {
        resolve(true)
        return
      }
      if (c.state === "failed" || c.state === "closed") {
        resolve(false)
        return
      }
      c.waiting = resolve
      setTimeout(() => {
        c.fire(false)
      }, ms)
    })
  }
}

function randomSsrc(): int {
  return 1 + Math.floor(Math.random() * 4294967294.0)
}

// What a leg stands on: its connection, and the channel and track as they arrive.
class PeerLeg {
  channel: RTCDataChannel | undefined = undefined
  track: RTCTrack | undefined = undefined
  pt = -1
  constructor(readonly pc: RTCPeerConnection, readonly ssrc: int) {}
}

// A relay leg on a peer connection: its data channel and audio track.
function rtcLeg(st: PeerLeg): Leg {
  return new Leg((m) => {
    const c = st.channel
    return c !== undefined && c.send(m)
  }, (p) => {
    const t = st.track
    if (t === undefined) return false
    // the other leg's packets go out on this leg's stream, in the payload type it negotiated
    if (st.pt < 0) st.pt = t.payloadType
    return t.sendRtp(p, st.ssrc, st.pt)
  }, () => {
    const c = st.channel
    return c === undefined ? 0 : c.bufferedAmount
  }, () => {
    st.pc.close()
    st.channel = undefined
    st.track = undefined
  })
}

// Starts the relay's clock, once a second, until the relay is over.
export function startClock(relay: Relay): void {
  const clock = setInterval(() => {
    relay.tick(Date.now())
  }, 1000)
  relay.ticker = () => {
    clearInterval(clock)
  }
}

function makePeer(cfg: RTCConfig): RTCPeerConnection | undefined {
  try {
    return try new RTCPeerConnection(cfg)
  } catch (e) {
    return undefined
  }
}

// Makes the two peer connections, runs the handshake and returns the browser's SDP answer, with the
// relay running. A failure before the provider created the session bills nothing; after it, the
// minimum.
export async function establish(s: Setup): Promise<Established> {
  const cfg: RTCConfig = { iceServers: s.iceServers, bindAddress: s.bindAddress }
  const down = makePeer(cfg)
  if (down === undefined) return failed(500, "server_error", "failed to create browser peer connection")
  const up = makePeer(cfg)
  if (up === undefined) {
    down.close()
    return failed(500, "server_error", "failed to create upstream peer connection")
  }
  const relay = new Relay(s.hooks, s.guard, Date.now())
  relay.core.filter = s.filter
  relay.core.realtime = s.realtime
  relay.core.transcription = s.transcription ?? false
  relay.core.model = s.model
  relay.core.backendModel = s.backendModel
  relay.core.checkUpdate = s.checkUpdate
  // nothing is billed until the provider has created the session
  relay.core.minimum = 0.0
  const downLeg = new PeerLeg(down, randomSsrc())
  const upLeg = new PeerLeg(up, randomSsrc())
  relay.client = rtcLeg(downLeg)
  relay.provider = rtcLeg(upLeg)
  const abort = (st: int, type: string, msg: string): Established => {
    relay.core.abort(st, msg, Date.now())
    relay.close()
    return failed(st, type, msg)
  }

  // the provider side: an audio track and the events channel
  let upTrack: RTCTrack | undefined = undefined
  try {
    upTrack = try up.addTrack({ direction: "sendrecv", codec: "opus", payloadType: 111, ssrc: upLeg.ssrc, name: "audio", profile: "minptime=10;useinbandfec=1" })
  } catch (e) {
    return abort(500, "server_error", "failed to attach provider audio track")
  }
  const upChannel = up.createDataChannel(DATA_CHANNEL_LABEL)
  upLeg.channel = upChannel
  upLeg.track = upTrack
  upChannel.onopen = () => {
    relay.channelOpened(false)
  }
  upChannel.onmessage = (m) => {
    if (typeof m === "string") relay.fromProvider(m)
  }
  upChannel.onclose = () => {
    relay.providerGone()
  }
  upChannel.onerror = (e) => {
    relay.providerGone()
  }
  if (upTrack !== undefined) {
    upTrack.onpacket = (p) => {
      relay.packetFromProvider(p)
    }
  }

  // the browser side: what the browser's offer brings
  down.ondatachannel = (incoming) => {
    const ch = incoming
    if (downLeg.channel !== undefined) {
      ch.close()
      return
    }
    downLeg.channel = ch
    ch.onopen = () => {
      relay.channelOpened(true)
    }
    ch.onmessage = (m) => {
      if (typeof m === "string") relay.fromBrowser(m)
    }
    ch.onclose = () => {
      relay.browserGone()
    }
    ch.onerror = (e) => {
      relay.browserGone()
    }
  }
  down.ontrack = (incoming) => {
    const t = incoming
    // only the audio that negotiated Opus is relayed
    if (downLeg.track !== undefined || t.payloadType < 0) return
    downLeg.track = t
    t.onpacket = (p) => {
      relay.packetFromBrowser(p)
    }
  }
  const downState = new Connect()
  down.onstatechange = (st) => {
    downState.seen(st)
    if (st === "failed" || st === "closed") relay.browserGone()
  }
  const upState = new Connect()
  up.onstatechange = (st) => {
    upState.seen(st)
    if (st === "failed" || st === "closed") relay.providerGone()
  }

  const bad = down.setRemoteDescription(opusOnly(s.offer), "offer")
  if (bad !== "") return abort(400, "invalid_request_error", "invalid browser SDP offer")
  if (up.setLocalDescription("") !== "") return abort(500, "server_error", "failed to create upstream SDP offer")
  await whenGathered(up, GATHER_MS)
  let upOffer = up.localDescription
  if (upOffer === "") return abort(500, "server_error", "failed to create upstream SDP offer")
  upOffer = constrainMaxMessageSize(upOffer, s.offer)

  const ex = await s.exchange(upOffer)
  if (ex.status !== 0) {
    const r = abort(ex.status, ex.type, ex.message)
    return { status: r.status, type: r.type, message: r.message, answer: "", sessionId: "", relay: undefined, body: ex.body, contentType: ex.contentType }
  }
  // the provider has created the session: the minimum is incurred (a realtime call has none, and the
  // provider names its session later, in session.created)
  if (!s.realtime) relay.core.minimum = LIVE_MINIMUM_SECONDS
  if (ex.sessionId !== "") relay.core.sessionId = ex.sessionId
  if (ex.sessionId !== "" && !s.hooks.bind(ex.sessionId)) return abort(500, "server_error", "the live session could not be recorded for its virtual key and was not opened")
  if (ex.sdp === "") return abort(502, "upstream_connection_error", "live session create response has no SDP answer")
  if (up.setRemoteDescription(ex.sdp, "answer") !== "") return abort(502, "upstream_connection_error", "invalid upstream SDP answer")
  const connected = await upState.wait(HANDSHAKE_MS)
  if (!connected) return abort(502, "upstream_connection_error", "upstream WebRTC connection failed")
  await whenGathered(down, GATHER_MS)
  const answer = down.localDescription
  if (answer === "" || down.localDescriptionType !== "answer") return abort(500, "server_error", "failed to create browser SDP answer")
  if (relay.closing) return failed(502, "upstream_connection_error", "the WebRTC session closed during setup")
  relay.setupDone = true
  startClock(relay)
  return { status: 0, type: "", message: "", answer: answer, sessionId: ex.sessionId, relay: relay, body: "", contentType: "" }
}

// ---------------------------------------------------------------- tests

class Capture {
  client: string[] = []
  provider: string[] = []
  abandoned = 0
  reports: LiveReport[] = []
  turns: TurnReport[] = []
  binds: string[] = []
  bindOk = true
  readmitWhy = ""
  readmits = 0
  readmitType = "budget_exceeded"
  counts: string[] = []
}

function fixture(): { core: LiveCore, cap: Capture } {
  const cap = new Capture()
  const io = new LiveIO((m) => {
    cap.client.push(m)
  }, (m) => {
    cap.provider.push(m)
  }, () => {
    cap.abandoned += 1
  })
  const hooks = new LiveHooks(() => {
    cap.readmits += 1
    if (cap.readmitWhy === "") return undefined
    return { status: 429, type: cap.readmitType, message: cap.readmitWhy }
  }, (r) => {
    cap.reports.push(r)
  }, (id) => {
    cap.binds.push(id)
    return cap.bindOk
  }, (d, t) => {
    cap.counts.push(d + ":" + t)
  }, (t) => {
    cap.turns.push(t)
  })
  return { core: new LiveCore(io, hooks, 1000.0), cap: cap }
}

test("max-message-size lines", () => {
  const offer = "v=0\r\nm=audio 9 UDP/TLS/RTP/SAVPF 111\r\na=mid:0\r\nm=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\na=sctp-port:5000\r\na=max-message-size:1073741823\r\n"
  expect(sdpMaxMessageSize(offer)).toBe(1073741823)
  expect(sdpMaxMessageSize("v=0\r\n")).toBe(undefined)
  const lowered = constrainMaxMessageSize(offer, "v=0\r\nm=application 9 x\r\na=max-message-size:262144\r\n")
  expect(sdpMaxMessageSize(lowered)).toBe(262144)
  expect(lowered.includes("a=max-message-size:1073741823")).toBe(false)
  // a browser offer that is larger leaves the provider's limit alone
  expect(constrainMaxMessageSize(lowered, "a=max-message-size:1073741823\r\n")).toBe(lowered)
  // none in the browser's offer: unchanged
  expect(constrainMaxMessageSize(offer, "v=0\r\n")).toBe(offer)
  // added ahead of the application section when the offer has none
  const bare = "v=0\r\nm=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\na=sctp-port:5000\r\n"
  const added = setSdpMaxMessageSize(bare, 65536)
  expect(added).toBe("v=0\r\na=max-message-size:65536\r\nm=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\na=sctp-port:5000\r\n")
})

test("an offer is cut down to Opus", () => {
  const offer = "v=0\r\nm=audio 9 UDP/TLS/RTP/SAVPF 111 63 9 0 8\r\nc=IN IP4 0.0.0.0\r\na=mid:0\r\na=rtpmap:111 opus/48000/2\r\na=fmtp:111 minptime=10;useinbandfec=1\r\na=rtcp-fb:111 transport-cc\r\na=rtpmap:9 G722/8000\r\na=rtpmap:0 PCMU/8000\r\na=rtpmap:8 PCMA/8000\r\na=sendrecv\r\nm=application 9 UDP/DTLS/SCTP webrtc-datachannel\r\na=sctp-port:5000\r\n"
  const out = opusOnly(offer)
  expect(out.includes("m=audio 9 UDP/TLS/RTP/SAVPF 111\r\n")).toBe(true)
  expect(out.includes("G722")).toBe(false)
  expect(out.includes("PCMU")).toBe(false)
  expect(out.includes("a=fmtp:111 minptime=10;useinbandfec=1")).toBe(true)
  expect(out.includes("a=rtcp-fb:111 transport-cc")).toBe(true)
  expect(out.includes("a=mid:0")).toBe(true)
  expect(out.includes("m=application 9 UDP/DTLS/SCTP webrtc-datachannel")).toBe(true)
  // no Opus: left alone
  const g = "v=0\r\nm=audio 9 UDP/TLS/RTP/SAVPF 0 8\r\na=rtpmap:0 PCMU/8000\r\n"
  expect(opusOnly(g)).toBe(g)
})

test("RTP headers are cleaned for the other leg", () => {
  const plain: u8[] = [u8(0x80), u8(111), u8(0), u8(1), u8(0), u8(0), u8(0), u8(160), u8(0), u8(0), u8(16), u8(146), u8(7), u8(8)]
  const same = forwardRtp(plain)
  expect(same === undefined).toBe(false)
  expect(same!.length).toBe(14)
  // one extension word (profile, length 1, 4 bytes) and one CSRC are dropped
  const ext: u8[] = [u8(0x91), u8(111), u8(0), u8(2), u8(0), u8(0), u8(0), u8(160), u8(0), u8(0), u8(16), u8(146),
    u8(1), u8(2), u8(3), u8(4),
    u8(0xBE), u8(0xDE), u8(0), u8(1), u8(9), u8(9), u8(9), u8(9),
    u8(42), u8(43)]
  const cleaned = forwardRtp(ext)
  expect(cleaned === undefined).toBe(false)
  expect(cleaned!.length).toBe(14)
  expect(int(cleaned![0]!)).toBe(0x80)
  expect(int(cleaned![12]!)).toBe(42)
  expect(int(cleaned![13]!)).toBe(43)
  // RTCP (a sender report), a runt and a wrong version are not forwarded
  const rtcp: u8[] = [u8(0x80), u8(200), u8(0), u8(6), u8(0), u8(0), u8(0), u8(1), u8(0), u8(0), u8(0), u8(0), u8(0)]
  expect(forwardRtp(rtcp) === undefined).toBe(true)
  expect(forwardRtp([u8(0x80), u8(111)]) === undefined).toBe(true)
  const v1: u8[] = [u8(0x40), u8(111), u8(0), u8(1), u8(0), u8(0), u8(0), u8(160), u8(0), u8(0), u8(16), u8(146), u8(1)]
  expect(forwardRtp(v1) === undefined).toBe(true)
})

test("server event permissions are widened for the provider and kept for the browser", () => {
  const body = `{"session":{"model":"openai/gpt-live","client":{"data_channel":{"allowed_server_events":[{"type":"session.output_transcript.delta"},{"type":"response.event","response_event":"response.completed"}]}}},"transport":{"type":"webrtc","sdp":"x"}}`
  const p = prepareServerEvents(body)
  expect(p.error).toBe("")
  expect(p.filter === undefined).toBe(false)
  const widened = jsonAt(p.body, EVENTS_PATH)!
  expect(widened.includes(`{"type":"session.usage.updated"}`)).toBe(true)
  expect(widened.includes(`{"response_event":"response.failed","type":"response.event"}`)).toBe(true)
  // the browser's own two are kept once
  expect(widened.split(`"session.output_transcript.delta"`).length).toBe(2)
  const f = p.filter!
  expect(f.allows(`{"type":"session.output_transcript.delta","delta":"hi"}`)).toBe(true)
  expect(f.allows(`{"type":"session.usage.updated","usage":{"seconds":3}}`)).toBe(false)
  expect(f.allows(`{"type":"response.event","event":{"type":"response.completed"}}`)).toBe(true)
  expect(f.allows(`{"type":"response.event","event":{"type":"response.output_text.delta"}}`)).toBe(false)
  // an echo of the permissions carries the browser's list again
  const echoed = f.clientMessage(`{"type":"session.output_transcript.delta","session":{"client":{"data_channel":{"allowed_server_events":[{"type":"x"}]}}}}`)!
  expect(jsonAt(echoed, EVENTS_PATH)).toBe(`[{"type":"session.output_transcript.delta"},{"type":"response.event","response_event":"response.completed"}]`)
  expect(f.clientMessage(`{"type":"session.usage.updated"}`) === undefined).toBe(true)
  // "all", or no list: the body is untouched and nothing is filtered
  const all = `{"session":{"client":{"data_channel":{"allowed_server_events":"all"}}}}`
  expect(prepareServerEvents(all).body).toBe(all)
  expect(prepareServerEvents(all).filter === undefined).toBe(true)
  expect(prepareServerEvents(`{"session":{"model":"m"}}`).filter === undefined).toBe(true)
  // bad lists
  expect(prepareServerEvents(`{"session":{"client":{"data_channel":{"allowed_server_events":5}}}}`).error.includes("must be")).toBe(true)
  expect(prepareServerEvents(`{"session":{"client":{"data_channel":{"allowed_server_events":[{"type":"response.event"}]}}}}`).error.includes("response_event must be")).toBe(true)
  expect(prepareServerEvents(`{"session":{"client":{"data_channel":{"allowed_server_events":[{"type":"error","response_event":"x"}]}}}}`).error.includes("only allowed for response.event")).toBe(true)
  expect(prepareServerEvents(`{"session":{"client":{"data_channel":{"allowed_server_events":[{"type":"error","extra":1}]}}}}`).error.includes("only supports type and response_event")).toBe(true)
})

test("client texts are found and put back", () => {
  const upd = `{"type":"session.update","session":{"instructions":"be brief","voice":"alloy"}}`
  expect(clientTexts("session.update", upd).join("|")).toBe("be brief")
  expect(rewriteClientTexts("session.update", upd, ["be [x]"])).toBe(`{"type":"session.update","session":{"instructions":"be [x]","voice":"alloy"}}`)
  const item = `{"type":"response.item.create","item":{"type":"message","content":[{"type":"input_text","text":"hello"},{"type":"input_text","text":"again"}]}}`
  expect(clientTexts("response.item.create", item).join("|")).toBe("hello|again")
  expect(rewriteClientTexts("response.item.create", item, ["a", "b"]).includes(`"text":"a"`)).toBe(true)
  expect(rewriteClientTexts("response.item.create", item, ["a", "b"]).includes(`"text":"b"`)).toBe(true)
  const out = `{"type":"response.item.create","item":{"type":"function_call_output","call_id":"c","output":"sk"}}`
  expect(clientTexts("response.item.create", out).join("|")).toBe("sk")
  expect(clientTexts("session.input_audio.mute", `{"type":"session.input_audio.mute"}`).length).toBe(0)
  expect(clientTexts("session.instructions.append", `{"type":"session.instructions.append","content":"more"}`).join("|")).toBe("more")
})

test("a session is metered: usage, the minimum and the report", () => {
  const t = fixture()
  const c = t.core
  c.fromProvider(`{"type":"session.started","session":{"id":"sess_1"}}`, undefined, 1100.0)
  expect(t.cap.binds.join(",")).toBe("sess_1")
  c.fromProvider(`{"type":"session.input_transcript.delta","delta":"hi there","start_ms":0,"end_ms":10}`, undefined, 1200.0)
  c.fromProvider(`{"type":"session.output_transcript.delta","delta":"hello"}`, undefined, 1300.0)
  c.fromProvider(`{"type":"session.output_transcript.delta","delta":" you"}`, undefined, 1310.0)
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":4.5}}`, undefined, 1400.0)
  c.fromProvider(`{"type":"response.event","delegation_id":"d","event":{"type":"response.completed","response":{"id":"r1","usage":{"input_tokens":12,"output_tokens":7}}}}`, undefined, 1500.0)
  // the same response again is not counted twice
  c.fromProvider(`{"type":"response.event","delegation_id":"d","event":{"type":"response.completed","response":{"id":"r1","usage":{"input_tokens":12,"output_tokens":7}}}}`, undefined, 1510.0)
  expect(t.cap.client.length).toBe(7)
  expect(t.cap.reports.length).toBe(0)
  c.fromProvider(`{"type":"session.closed","reason":"close_requested","usage":{"seconds":6.25}}`, undefined, 9000.0)
  expect(t.cap.reports.length).toBe(1)
  const r = t.cap.reports[0]!
  expect(r.sessionId).toBe("sess_1")
  expect(r.seconds).toBe(6.25)
  // a WebRTC session bills at least 15 seconds
  expect(r.billedSeconds).toBe(15.0)
  expect(r.promptTokens).toBe(12)
  expect(r.completionTokens).toBe(7)
  expect(r.status).toBe(200)
  expect(r.reason).toBe("close_requested")
  expect(r.input).toBe("hi there")
  expect(r.output).toBe("hello you")
  expect(r.events).toBe(8)
  // nothing is reported twice, and nothing flows after the end
  c.providerEnded(9100.0)
  c.fromProvider(`{"type":"error"}`, undefined, 9200.0)
  expect(t.cap.reports.length).toBe(1)
  expect(t.cap.client.length).toBe(8)
  expect(t.cap.counts.includes("out:session.usage.updated")).toBe(true)
})

test("a long session bills what it ran, and each window is admitted again", () => {
  const t = fixture()
  const c = t.core
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":20}}`, undefined, 2000.0)
  expect(t.cap.readmits).toBe(0)
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":35}}`, undefined, 3000.0)
  expect(t.cap.readmits).toBe(1)
  // snapshots are cumulative: an older one adds nothing
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":10}}`, undefined, 3100.0)
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":80}}`, undefined, 4000.0)
  expect(t.cap.readmits).toBe(2)
  c.fromProvider(`{"type":"session.closed","usage":{"seconds":90}}`, undefined, 5000.0)
  expect(t.cap.reports[0]!.billedSeconds).toBe(90.0)
})

test("a refused window ends the session with an error and a close upstream", () => {
  const t = fixture()
  t.cap.readmitWhy = "budget exceeded"
  const c = t.core
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":31}}`, undefined, 2000.0)
  // the usage event itself is withheld along with everything after the refusal
  expect(t.cap.client.length).toBe(1)
  expect(t.cap.client[0]!.includes("budget exceeded")).toBe(true)
  expect(t.cap.client[0]!.includes(`"type":"error"`)).toBe(true)
  expect(t.cap.provider.join("|")).toBe(`{"type":"session.close"}`)
  c.fromProvider(`{"type":"session.output_transcript.delta","delta":"more"}`, undefined, 2100.0)
  expect(t.cap.client.length).toBe(1)
  c.fromProvider(`{"type":"session.closed","usage":{"seconds":31}}`, undefined, 2200.0)
  const r = t.cap.reports[0]!
  expect(r.status).toBe(429)
  expect(r.billedSeconds).toBe(31.0)
  // a second close is not sent
  c.clientLeft(2300.0)
  expect(t.cap.provider.length).toBe(1)
})

test("an id that cannot be recorded is never sent to the browser", () => {
  const t = fixture()
  t.cap.bindOk = false
  t.core.fromProvider(`{"type":"session.started","session":{"id":"sess_9"}}`, undefined, 1100.0)
  expect(t.cap.client.length).toBe(1)
  expect(t.cap.client[0]!.includes("sess_9")).toBe(false)
  expect(t.cap.client[0]!.includes("could not be recorded")).toBe(true)
  expect(t.cap.provider.join("|")).toBe(`{"type":"session.close"}`)
})

test("a browser that leaves closes the session upstream and waits for the end", () => {
  const t = fixture()
  const c = t.core
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":3}}`, undefined, 1500.0)
  c.clientLeft(2000.0)
  expect(t.cap.provider.join("|")).toBe(`{"type":"session.close"}`)
  expect(t.cap.reports.length).toBe(0)
  // the provider's last events are metered but not sent
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":9}}`, undefined, 2500.0)
  expect(t.cap.client.length).toBe(1)
  c.tick(5000.0)
  expect(t.cap.abandoned).toBe(0)
  c.fromProvider(`{"type":"session.closed","usage":{"seconds":9.5}}`, undefined, 6000.0)
  expect(t.cap.reports[0]!.billedSeconds).toBe(15.0)
  expect(t.cap.reports[0]!.seconds).toBe(9.5)
})

test("a provider that never answers a close is abandoned after the drain", () => {
  const t = fixture()
  const c = t.core
  c.fromClient(`{"type":"session.close"}`, [], 2000.0)
  expect(t.cap.provider.join("|")).toBe(`{"type":"session.close"}`)
  c.tick(16000.0)
  expect(t.cap.abandoned).toBe(0)
  c.tick(17001.0)
  expect(t.cap.abandoned).toBe(1)
  // the relay ends the provider leg, which reports what was last seen
  c.providerEnded(17002.0)
  expect(t.cap.reports.length).toBe(1)
  expect(t.cap.reports[0]!.status).toBe(200)
})

test("a provider that ends early is reported with an error and the browser is told", () => {
  const t = fixture()
  t.core.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":40}}`, undefined, 1500.0)
  t.core.providerEnded(2000.0)
  expect(t.cap.reports.length).toBe(1)
  expect(t.cap.reports[0]!.status).toBe(502)
  expect(t.cap.reports[0]!.billedSeconds).toBe(40.0)
  expect(t.cap.client[t.cap.client.length - 1]!.includes("before session.closed")).toBe(true)
})

test("a failed setup still bills the minimum", () => {
  const t = fixture()
  t.core.abort(502, "upstream WebRTC connection failed", 1200.0)
  expect(t.cap.reports.length).toBe(1)
  expect(t.cap.reports[0]!.status).toBe(502)
  expect(t.cap.reports[0]!.billedSeconds).toBe(15.0)
  expect(t.cap.reports[0]!.error).toBe("upstream WebRTC connection failed")
})

test("an idle session meets its window", () => {
  const t = fixture()
  t.core.tick(7000.0)
  expect(t.cap.readmits).toBe(0)
  t.core.tick(59000.0)
  expect(t.cap.readmits).toBe(0)
  t.core.tick(64000.0)
  expect(t.cap.readmits).toBe(1)
  t.core.tick(66000.0)
  expect(t.cap.readmits).toBe(1)
  t.core.tick(130000.0)
  expect(t.cap.readmits).toBe(2)
})

test("the browser sees only the events it asked for, and guarded text is replaced", () => {
  const t = fixture()
  const p = prepareServerEvents(`{"session":{"client":{"data_channel":{"allowed_server_events":[{"type":"session.output_transcript.delta"}]}}}}`)
  t.core.filter = p.filter
  t.core.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":1}}`, undefined, 1100.0)
  expect(t.cap.client.length).toBe(0)
  t.core.fromProvider(`{"type":"session.output_transcript.delta","delta":"key sk-123"}`, "key [redacted]", 1200.0)
  expect(t.cap.client.join("|")).toBe(`{"type":"session.output_transcript.delta","delta":"key [redacted]"}`)
  expect(t.core.outputWindow("x")).toBe("key sk-123x")
  // blocked output ends it
  t.core.blockOutput("secret")
  expect(t.cap.client[1]!.includes("response blocked by guardrails: secret")).toBe(true)
  expect(t.cap.provider.join("|")).toBe(`{"type":"session.close"}`)
})

test("guarded browser events are passed on with their texts replaced", () => {
  const t = fixture()
  const upd = `{"type":"session.update","session":{"instructions":"token abc"}}`
  expect(t.core.clientTextsOf(upd).join("|")).toBe("token abc")
  t.core.fromClient(upd, ["token [x]"], 1100.0)
  expect(t.cap.provider.join("|")).toBe(`{"type":"session.update","session":{"instructions":"token [x]"}}`)
  t.core.refuseClient("prompt injection")
  expect(t.cap.client[0]!.includes("request blocked by guardrails: prompt injection")).toBe(true)
  expect(t.cap.client[0]!.includes("guardrail_violation")).toBe(true)
})

class FakeLeg {
  texts: string[] = []
  packets: u8[][] = []
  closes = 0
  codes: int[] = []
  queued = 0
  leg(): Leg {
    const f = this
    return new Leg((m) => {
      f.texts.push(m)
      return true
    }, (p) => {
      f.packets.push(p)
      return true
    }, () => f.queued, (code, why) => {
      f.codes.push(code)
      f.closes += 1
    })
  }
}

class RelayFixture {
  relay: Relay
  cap: Capture
  browser = new FakeLeg()
  provider = new FakeLeg()
  constructor() {
    const cap = new Capture()
    this.cap = cap
    const hooks = new LiveHooks(() => undefined, (r) => {
      cap.reports.push(r)
    }, (id) => {
      cap.binds.push(id)
      return true
    }, (d, t) => {
      cap.counts.push(d + ":" + t)
    }, (t) => {
      cap.turns.push(t)
    })
    this.relay = new Relay(hooks, undefined, 1000.0)
    this.relay.client = this.browser.leg()
    this.relay.provider = this.provider.leg()
  }
}

test("messages wait for their channel, then go out in order", () => {
  const t = new RelayFixture()
  const r = t.relay
  // the browser's channel is not open yet: the provider's events wait
  r.channelOpened(false)
  r.fromProvider(`{"type":"session.started","session":{"id":"sess_1"}}`)
  r.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":2}}`)
  expect(t.browser.texts.length).toBe(0)
  r.channelOpened(true)
  expect(t.browser.texts.length).toBe(2)
  expect(t.browser.texts[0]!.includes("session.started")).toBe(true)
  expect(t.browser.texts[1]!.includes("session.usage.updated")).toBe(true)
  // events after that go straight through
  r.fromProvider(`{"type":"session.output_transcript.delta","delta":"hi"}`)
  expect(t.browser.texts.length).toBe(3)
  expect(t.cap.binds.join(",")).toBe("sess_1")
})

test("browser events reach the provider through the core", () => {
  const t = new RelayFixture()
  const r = t.relay
  r.fromBrowser(`{"type":"session.update","session":{"voice":"alloy"}}`)
  // the provider's channel is not open: it waits
  expect(t.provider.texts.length).toBe(0)
  r.channelOpened(false)
  expect(t.provider.texts.join("|")).toBe(`{"type":"session.update","session":{"voice":"alloy"}}`)
  r.fromBrowser(`{"type":"session.input_audio.mute"}`)
  expect(t.provider.texts.length).toBe(2)
  expect(t.cap.counts.join(",")).toBe("in:session.update,in:session.input_audio.mute")
})

test("audio goes both ways as packets, cleaned, and RTCP stays behind", () => {
  const t = new RelayFixture()
  const r = t.relay
  const pkt: u8[] = [u8(0x90), u8(111), u8(0), u8(1), u8(0), u8(0), u8(0), u8(160), u8(0), u8(0), u8(1), u8(2), u8(0xBE), u8(0xDE), u8(0), u8(0), u8(5), u8(6)]
  r.packetFromBrowser(pkt)
  expect(t.provider.packets.length).toBe(1)
  expect(t.provider.packets[0]!.length).toBe(14)
  r.packetFromProvider(pkt)
  expect(t.browser.packets.length).toBe(1)
  const sr: u8[] = [u8(0x80), u8(200), u8(0), u8(6), u8(0), u8(0), u8(0), u8(1), u8(0), u8(0), u8(0), u8(0), u8(0)]
  r.packetFromBrowser(sr)
  expect(t.provider.packets.length).toBe(1)
  expect(r.packets).toBe(2)
})

test("a session.closed ends the relay after the browser has it", () => {
  const t = new RelayFixture()
  const r = t.relay
  r.channelOpened(true)
  r.channelOpened(false)
  r.fromProvider(`{"type":"session.closed","reason":"close_requested","usage":{"seconds":20}}`)
  expect(t.browser.texts.length).toBe(1)
  expect(t.cap.reports.length).toBe(1)
  expect(t.cap.reports[0]!.billedSeconds).toBe(20.0)
  // (the relay closes on the next turn of the loop: close it as that would)
  r.close()
  expect(r.closed).toBe(true)
  expect(t.browser.closes).toBe(1)
  expect(t.provider.closes).toBe(1)
  // once closed, nothing moves
  r.fromBrowser(`{"type":"session.update"}`)
  r.packetFromBrowser([u8(0x80), u8(111), u8(0), u8(1), u8(0), u8(0), u8(0), u8(160), u8(0), u8(0), u8(1), u8(2), u8(7)])
  expect(t.provider.texts.length).toBe(0)
  expect(t.provider.packets.length).toBe(0)
  expect(t.cap.reports.length).toBe(1)
})

test("a provider that disappears is billed what it reported and the browser is told", () => {
  const t = new RelayFixture()
  const r = t.relay
  r.channelOpened(true)
  r.channelOpened(false)
  r.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":33}}`)
  r.providerGone()
  expect(r.closed).toBe(true)
  expect(t.cap.reports[0]!.billedSeconds).toBe(33.0)
  expect(t.cap.reports[0]!.status).toBe(502)
  expect(t.browser.texts[t.browser.texts.length - 1]!.includes("before session.closed")).toBe(true)
})

test("a browser that disappears closes the session upstream first", () => {
  const t = new RelayFixture()
  const r = t.relay
  r.channelOpened(true)
  r.channelOpened(false)
  r.setupDone = true
  r.browserGone()
  expect(r.closed).toBe(false)
  expect(t.provider.texts.join("|")).toBe(`{"type":"session.close"}`)
  r.fromProvider(`{"type":"session.closed","usage":{"seconds":4}}`)
  expect(t.cap.reports[0]!.billedSeconds).toBe(15.0)
  expect(t.browser.texts.length).toBe(0)
  r.close()
  expect(r.closed).toBe(true)
})

test("a browser that goes before the setup is done ends the relay at once", () => {
  const t = new RelayFixture()
  t.relay.browserGone()
  expect(t.relay.closed).toBe(true)
  expect(t.provider.closes).toBe(1)
})

test("a queue that overflows ends the relay", () => {
  const t = new RelayFixture()
  const r = t.relay
  // the browser's channel never opens
  for (let i = 0; i < 1001; i++) r.sendClient(`{"type":"x"}`)
  expect(r.closing).toBe(true)
})

function realtimeFixture(): { core: LiveCore, cap: Capture } {
  const t = fixture()
  t.core.realtime = true
  t.core.minimum = 0.0
  t.core.model = "gpt-realtime"
  return t
}

const DONE_1 = `{"type":"response.done","response":{"id":"resp_1","status":"completed","usage":{"total_tokens":150,"input_tokens":100,"output_tokens":50,"input_token_details":{"text_tokens":60,"audio_tokens":40,"cached_tokens":20},"output_token_details":{"text_tokens":10,"audio_tokens":40}}}}`

test("a realtime session bills the usage of its responses, once each, by model", () => {
  const t = realtimeFixture()
  t.core.fromProvider(`{"type":"session.created","session":{"id":"sess_rt1"}}`, undefined, 1100.0)
  t.core.fromProvider(DONE_1, undefined, 1200.0)
  // the same response again is not billed twice
  t.core.fromProvider(DONE_1, undefined, 1300.0)
  t.core.fromProvider(`{"type":"response.done","response":{"id":"resp_2","usage":{"input_tokens":10,"output_tokens":5,"input_token_details":{"audio_tokens":4,"cached_tokens":0},"output_token_details":{"audio_tokens":1}}}}`, undefined, 1400.0)
  // a response with no usage adds nothing
  t.core.fromProvider(`{"type":"response.done","response":{"id":"resp_3"}}`, undefined, 1500.0)
  t.core.clientLeft(1600.0)
  expect(t.cap.reports.length).toBe(1)
  const r = t.cap.reports[0]!
  expect(r.sessionId).toBe("sess_rt1")
  expect(r.promptTokens).toBe(110)
  expect(r.completionTokens).toBe(55)
  expect(r.uses.length).toBe(1)
  expect(r.uses[0]!.model).toBe("gpt-realtime")
  expect(r.uses[0]!.cached).toBe(20)
  expect(r.uses[0]!.inputAudio).toBe(44)
  expect(r.uses[0]!.outputAudio).toBe(41)
  expect(r.billedSeconds).toBe(0.0)
  expect(r.status).toBe(200)
  // every event reached the client: the usage is not hidden from it
  expect(t.cap.client.length).toBe(5)
})

test("a realtime session ends at once when the client leaves, and sends no session.close", () => {
  const t = realtimeFixture()
  t.core.fromProvider(DONE_1, undefined, 1200.0)
  t.core.clientLeft(1300.0)
  expect(t.cap.provider.length).toBe(0)
  expect(t.cap.reports.length).toBe(1)
  expect(t.core.finished).toBe(true)
  // later events change nothing
  t.core.fromProvider(DONE_1, undefined, 1400.0)
  expect(t.cap.reports.length).toBe(1)
})

test("a realtime turn is admitted when it starts, once, whoever starts it", () => {
  const t = realtimeFixture()
  // the caller starts a turn
  t.core.fromClient(`{"type":"response.create"}`, [], 1100.0)
  expect(t.cap.readmits).toBe(1)
  expect(t.cap.provider.length).toBe(1)
  // the provider's own events for the same turn do not admit it again
  t.core.fromProvider(`{"type":"response.created","response":{"id":"resp_1"}}`, undefined, 1150.0)
  expect(t.cap.readmits).toBe(1)
  // another response.create while it runs is refused, as Bifrost does: the caller is told, the provider never sees it
  const sentBefore = t.cap.client.length
  t.core.fromClient(`{"type":"response.create"}`, [], 1160.0)
  expect(t.cap.readmits).toBe(1)
  expect(t.cap.provider.length).toBe(1)
  expect(t.cap.client.length).toBe(sentBefore + 1)
  expect(t.cap.client[sentBefore]!).toBe(`{"type":"error","error":{"message":"Conversation already has an active response in progress.","type":"invalid_request_error","code":"invalid_request_error"}}`)
  expect(t.core.finished).toBe(false)
  t.core.fromProvider(DONE_1, undefined, 1200.0)
  expect(t.core.turnActive).toBe(false)
  // once the response is done, the next response.create starts a turn
  t.core.fromClient(`{"type":"response.create"}`, [], 1250.0)
  expect(t.cap.readmits).toBe(2)
  expect(t.cap.provider.length).toBe(2)
  t.core.fromProvider(`{"type":"response.done","response":{"id":"resp_1b"}}`, undefined, 1260.0)
  expect(t.cap.readmits).toBe(2)
  // the provider starts the next one (the caller's speech was committed)
  t.core.fromProvider(`{"type":"input_audio_buffer.committed","item_id":"item_1"}`, undefined, 1300.0)
  expect(t.cap.readmits).toBe(3)
  t.core.fromProvider(`{"type":"response.created","response":{"id":"resp_2"}}`, undefined, 1310.0)
  expect(t.cap.readmits).toBe(3)
  // events that start no turn do not admit
  t.core.fromProvider(`{"type":"response.output_audio.delta","delta":"AAAA"}`, undefined, 1320.0)
  t.core.fromClient(`{"type":"input_audio_buffer.append","audio":"AAAA"}`, [], 1330.0)
  expect(t.cap.readmits).toBe(3)
})

test("a live session.update is checked before it goes: a refusal is the client's error, an admitted model is billed next", () => {
  const t = fixture()
  t.core.backendModel = "gpt-back"
  t.core.checkUpdate = (m: string): UpdateCheck => {
    if (m.includes("anthropic/")) return { frame: "", model: "", status: 400, type: "invalid_request_error", message: "session.delegation.responses.model must be served by openai, the provider of session.model" }
    if (m.includes("gpt-next")) return { frame: m.replace("openai/gpt-next", "gpt-next"), model: "gpt-next", status: 0, type: "", message: "" }
    return { frame: m, model: "", status: 0, type: "", message: "" }
  }
  t.core.fromClient(`{"type":"session.update","session":{"delegation":{"type":"responses","responses":{"model":"anthropic/claude"}}}}`, [], 1100.0)
  expect(t.cap.provider.length).toBe(0)
  expect(t.cap.client.join("|")).toBe(`{"type":"error","error":{"message":"session.delegation.responses.model must be served by openai, the provider of session.model","type":"invalid_request_error","code":"invalid_request_error"}}`)
  expect(t.core.finished).toBe(false)
  expect(t.core.backendModel).toBe("gpt-back")
  t.core.fromClient(`{"type":"session.update","session":{"delegation":{"type":"responses","responses":{"model":"openai/gpt-next"}}}}`, [], 1200.0)
  expect(t.cap.provider.join("|")).toBe(`{"type":"session.update","session":{"delegation":{"type":"responses","responses":{"model":"gpt-next"}}}}`)
  expect(t.core.backendModel).toBe("gpt-next")
  // other events are not checked
  t.core.fromClient(`{"type":"session.input_audio.mute","x":"anthropic/"}`, [], 1300.0)
  expect(t.cap.provider.length).toBe(2)
})

test("a refused realtime turn ends the session: the caller is told and the event goes nowhere", () => {
  const t = realtimeFixture()
  t.cap.readmitWhy = "budget is spent"
  t.cap.readmitType = "budget_exceeded"
  t.core.fromClient(`{"type":"response.create"}`, [], 1100.0)
  expect(t.cap.provider.length).toBe(0)
  expect(t.cap.client.length).toBe(1)
  expect(t.cap.client[0]!.includes("budget is spent")).toBe(true)
  expect(t.cap.client[0]!.includes("budget_exceeded")).toBe(true)
  expect(t.cap.abandoned).toBe(1)
  expect(t.core.finished).toBe(true)
  expect(t.cap.reports.length).toBe(1)
  expect(t.cap.reports[0]!.status).toBe(429)
  expect(t.cap.reports[0]!.error).toBe("budget is spent")
  // a turn the provider starts is admitted the same way
  const u = realtimeFixture()
  u.cap.readmitWhy = "rate limit reached"
  u.core.fromProvider(`{"type":"response.created","response":{"id":"resp_9"}}`, undefined, 1100.0)
  expect(u.cap.client.length).toBe(1)
  expect(u.cap.client[0]!.includes("rate limit reached")).toBe(true)
  expect(u.cap.reports[0]!.status).toBe(429)
})

test("realtime text is guarded: output deltas in both naming schemes, and what the caller's audio said", () => {
  expect(providerText("response.output_audio_transcript.delta", `{"type":"response.output_audio_transcript.delta","delta":"hi there"}`)).toBe("hi there")
  expect(providerText("response.audio_transcript.delta", `{"type":"response.audio_transcript.delta","delta":"old name"}`)).toBe("old name")
  expect(providerText("response.output_text.delta", `{"type":"response.output_text.delta","delta":"text"}`)).toBe("text")
  expect(providerText("response.text.delta", `{"type":"response.text.delta","delta":"beta"}`)).toBe("beta")
  expect(providerText("conversation.item.input_audio_transcription.completed", `{"type":"conversation.item.input_audio_transcription.completed","transcript":"my key"}`)).toBe("my key")
  expect(providerText("response.output_audio.delta", `{"type":"response.output_audio.delta","delta":"AAAA"}`)).toBe("")
  expect(providerSource("conversation.item.input_audio_transcription.completed")).toBe("input")
  expect(providerSource("response.output_text.delta")).toBe("output")
  // the caller's item text is checked, and put back as the guard left it
  const item = `{"type":"conversation.item.create","item":{"type":"message","role":"user","content":[{"type":"input_text","text":"hello"}]}}`
  expect(clientTexts("conversation.item.create", item).join("|")).toBe("hello")
  expect(rewriteClientTexts("conversation.item.create", item, ["[redacted]"]).includes(`"text":"[redacted]"`)).toBe(true)
  // redacted output reaches the caller; the transcript the log keeps is what the provider said
  const t = realtimeFixture()
  t.core.fromProvider(`{"type":"response.output_audio_transcript.delta","delta":"key sk-123"}`, "key [redacted]", 1100.0)
  expect(t.cap.client.join("|")).toBe(`{"type":"response.output_audio_transcript.delta","delta":"key [redacted]"}`)
  t.core.fromProvider(`{"type":"conversation.item.input_audio_transcription.completed","transcript":"my card"}`, "my [redacted]", 1200.0)
  expect(t.cap.client[1]!.includes(`"transcript":"my [redacted]"`)).toBe(true)
  t.core.clientLeft(1300.0)
  expect(t.cap.reports[0]!.output).toBe("key sk-123")
  expect(t.cap.reports[0]!.input).toBe("my card")
})

test("realtime guard blocks end the session, input or output", () => {
  const t = realtimeFixture()
  t.core.blockOutput("secret")
  expect(t.cap.client[0]!.includes("response blocked by guardrails: secret")).toBe(true)
  expect(t.cap.abandoned).toBe(1)
  expect(t.cap.reports[0]!.status).toBe(400)
  const u = realtimeFixture()
  u.core.blockInput("card number")
  expect(u.cap.client[0]!.includes("request blocked by guardrails: card number")).toBe(true)
  expect(u.cap.reports[0]!.status).toBe(400)
})

test("a realtime provider that hangs up is no error; one that breaks is", () => {
  const t = realtimeFixture()
  t.core.fromProvider(DONE_1, undefined, 1200.0)
  t.core.providerEnded(1300.0)
  expect(t.cap.reports.length).toBe(1)
  expect(t.cap.reports[0]!.status).toBe(200)
  expect(t.cap.reports[0]!.promptTokens).toBe(100)
  expect(t.cap.client.length).toBe(1)
  const u = realtimeFixture()
  u.core.fromProvider(DONE_1, undefined, 1200.0)
  u.core.providerFailed = true
  u.core.providerEnded(1300.0)
  expect(u.cap.reports[0]!.status).toBe(502)
  expect(u.cap.reports[0]!.promptTokens).toBe(100)
  expect(u.cap.client[u.cap.client.length - 1]!.includes("interrupted")).toBe(true)
})

test("a realtime session has no voice windows and no stale check", () => {
  const t = realtimeFixture()
  t.core.tick(7000.0)
  t.core.tick(64000.0)
  t.core.tick(130000.0)
  expect(t.cap.readmits).toBe(0)
  // usage events of a live session mean nothing here
  t.core.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":100}}`, undefined, 1100.0)
  t.core.clientLeft(1200.0)
  expect(t.cap.readmits).toBe(0)
  expect(t.cap.reports[0]!.seconds).toBe(0.0)
})

test("live backend tokens are kept by the model that ran them, with the cache", () => {
  const t = fixture()
  t.core.model = "gpt-live"
  t.core.backendModel = "gpt-5.4"
  t.core.fromProvider(`{"type":"response.event","event":{"type":"response.completed","response":{"id":"r1","usage":{"input_tokens":100,"output_tokens":10,"input_tokens_details":{"cached_tokens":30}}}}}`, undefined, 1100.0)
  t.core.fromProvider(`{"type":"response.event","event":{"type":"response.completed","response":{"id":"r2","model":"gpt-5.4-mini","usage":{"input_tokens":7,"output_tokens":3}}}}`, undefined, 1200.0)
  t.core.fromProvider(`{"type":"session.closed","usage":{"seconds":20}}`, undefined, 1300.0)
  const r = t.cap.reports[0]!
  expect(r.promptTokens).toBe(107)
  expect(r.completionTokens).toBe(13)
  expect(r.uses.length).toBe(2)
  expect(r.uses[0]!.model).toBe("gpt-5.4")
  expect(r.uses[0]!.cached).toBe(30)
  expect(r.uses[1]!.model).toBe("gpt-5.4-mini")
  expect(r.billedSeconds).toBe(20.0)
})

test("a relay for a realtime session ends when the client leaves", () => {
  const t = new RelayFixture()
  const r = t.relay
  r.core.realtime = true
  r.core.minimum = 0.0
  r.channelOpened(true)
  r.channelOpened(false)
  r.setupDone = true
  r.fromBrowser(`{"type":"session.update","session":{"voice":"alloy"}}`)
  expect(t.provider.texts.length).toBe(1)
  r.fromProvider(DONE_1)
  r.browserGone()
  expect(r.closing).toBe(true)
  expect(t.cap.reports.length).toBe(1)
  expect(t.cap.reports[0]!.promptTokens).toBe(100)
  // the provider got no session.close
  expect(t.provider.texts.length).toBe(1)
})

test("a WebSocket client leg ends with the session's own outcome", () => {
  // a refused realtime session: policy violation, after the client has the error event
  const a = new RelayFixture()
  a.relay.core.realtime = true
  a.relay.core.minimum = 0.0
  a.relay.channelOpened(true)
  a.relay.channelOpened(false)
  a.relay.setupDone = true
  a.relay.core.blockOutput("secret")
  expect(a.relay.closing).toBe(true)
  expect(a.browser.texts.length).toBe(1)
  expect(a.browser.texts[0]!.includes("response blocked by guardrails: secret")).toBe(true)
  a.relay.close()
  expect(a.browser.codes.join(",")).toBe("1008")
  // a session that just ends
  const b = new RelayFixture()
  b.relay.core.realtime = true
  b.relay.core.minimum = 0.0
  b.relay.channelOpened(true)
  b.relay.channelOpened(false)
  b.relay.setupDone = true
  b.relay.providerGone()
  expect(b.browser.codes.join(",")).toBe("1000")
  expect(b.provider.codes.join(",")).toBe("1000")
  // a provider that broke
  const c = new RelayFixture()
  c.relay.core.realtime = true
  c.relay.core.minimum = 0.0
  c.relay.channelOpened(true)
  c.relay.channelOpened(false)
  c.relay.setupDone = true
  c.relay.providerBroke()
  expect(c.browser.codes.join(",")).toBe("1011")
  expect(c.cap.reports[0]!.status).toBe(502)
})

const DONE_2 = `{"type":"response.done","response":{"id":"resp_2","status":"completed","usage":{"total_tokens":30,"input_tokens":20,"output_tokens":10,"input_token_details":{"audio_tokens":5,"cached_tokens":0},"output_token_details":{"audio_tokens":4}}}}`

test("each realtime response is a row of its own, with its tokens and its text", () => {
  const t = realtimeFixture()
  t.core.fromProvider(`{"type":"session.created","session":{"id":"sess_rt1"}}`, undefined, 1100.0)
  t.core.fromClient(`{"type":"response.create"}`, [], 1200.0)
  t.core.fromProvider(`{"type":"conversation.item.input_audio_transcription.completed","transcript":"hi"}`, undefined, 1250.0)
  t.core.fromProvider(`{"type":"response.output_audio_transcript.delta","delta":"hello"}`, undefined, 1300.0)
  expect(t.cap.turns.length).toBe(0)
  t.core.fromProvider(DONE_1, undefined, 1400.0)
  expect(t.cap.turns.length).toBe(1)
  const a = t.cap.turns[0]!
  expect(a.kind).toBe("turn")
  expect(a.index).toBe(1)
  expect(a.sessionId).toBe("sess_rt1")
  expect(a.promptTokens).toBe(100)
  expect(a.completionTokens).toBe(50)
  expect(a.uses[0]!.cached).toBe(20)
  expect(a.uses[0]!.inputAudio).toBe(40)
  expect(a.input).toBe("hi")
  expect(a.output).toBe("hello")
  expect(a.startedMs).toBe(1200.0)
  expect(a.endedMs).toBe(1400.0)
  expect(a.last).toBe(false)
  // the second turn counts its own tokens only, and none of the first turn's text
  t.core.fromProvider(`{"type":"response.created","response":{"id":"resp_2"}}`, undefined, 1500.0)
  t.core.fromProvider(`{"type":"response.output_audio_transcript.delta","delta":"again"}`, undefined, 1550.0)
  t.core.fromProvider(DONE_2, undefined, 1600.0)
  expect(t.cap.turns.length).toBe(2)
  const b = t.cap.turns[1]!
  expect(b.index).toBe(2)
  expect(b.promptTokens).toBe(20)
  expect(b.completionTokens).toBe(10)
  expect(b.input).toBe("")
  expect(b.output).toBe("again")
  expect(b.startedMs).toBe(1500.0)
  // the same response again is no new row
  t.core.fromProvider(DONE_2, undefined, 1700.0)
  expect(t.cap.turns.length).toBe(2)
  // a session that ends with nothing left adds no row; its report still totals the tokens
  t.core.clientLeft(1800.0)
  expect(t.cap.turns.length).toBe(2)
  expect(t.cap.reports[0]!.promptTokens).toBe(120)
})

test("a realtime turn is admitted before it is logged: a refusal is a row with the refusal, and no tokens", () => {
  const t = realtimeFixture()
  t.core.fromClient(`{"type":"response.create"}`, [], 1100.0)
  t.core.fromProvider(DONE_1, undefined, 1200.0)
  expect(t.cap.turns.length).toBe(1)
  expect(t.cap.turns[0]!.status).toBe(200)
  t.cap.readmitWhy = "budget is spent"
  t.core.fromClient(`{"type":"response.create"}`, [], 1300.0)
  expect(t.cap.turns.length).toBe(2)
  const r = t.cap.turns[1]!
  expect(r.kind).toBe("end")
  expect(r.last).toBe(true)
  expect(r.status).toBe(429)
  expect(r.error).toBe("budget is spent")
  expect(r.promptTokens).toBe(0)
  expect(r.startedMs).toBe(1300.0)
})

test("a realtime turn the caller cut off, or text no turn took, is a closing row", () => {
  const t = realtimeFixture()
  t.core.fromClient(`{"type":"response.create"}`, [], 1100.0)
  t.core.clientLeft(1200.0)
  expect(t.cap.turns.length).toBe(1)
  expect(t.cap.turns[0]!.kind).toBe("end")
  expect(t.cap.turns[0]!.status).toBe(200)
  expect(t.cap.turns[0]!.promptTokens).toBe(0)
  const u = realtimeFixture()
  u.core.fromProvider(`{"type":"conversation.item.input_audio_transcription.completed","transcript":"unanswered"}`, undefined, 1100.0)
  u.core.clientLeft(1200.0)
  expect(u.cap.turns.length).toBe(1)
  expect(u.cap.turns[0]!.input).toBe("unanswered")
  // nothing at all: no row
  const v = realtimeFixture()
  v.core.clientLeft(1200.0)
  expect(v.cap.turns.length).toBe(0)
})

test("a failed or cancelled response.done is a row with the status Bifrost gives it; an incomplete one is 200", () => {
  const t = realtimeFixture()
  t.core.fromClient(`{"type":"response.create"}`, [], 1100.0)
  t.core.fromProvider(`{"type":"response.done","response":{"id":"r_f","status":"failed","status_details":{"type":"failed","error":{"type":"server_error","code":"upstream_error","message":"the model crashed"}},"usage":{"input_tokens":30,"output_tokens":2}}}`, undefined, 1200.0)
  expect(t.cap.turns.length).toBe(1)
  const f = t.cap.turns[0]!
  expect(f.status).toBe(500)
  expect(f.error).toBe("the model crashed")
  expect(f.state).toBe("failed")
  expect(f.stateReason).toBe("upstream_error")
  // what the failed response used is still billed
  expect(f.promptTokens).toBe(30)
  t.core.fromClient(`{"type":"response.create"}`, [], 1300.0)
  t.core.fromProvider(`{"type":"response.done","response":{"id":"r_c","status":"cancelled","status_details":{"type":"cancelled","reason":"turn_detected"},"usage":{"input_tokens":5,"output_tokens":1}}}`, undefined, 1400.0)
  const c = t.cap.turns[1]!
  expect(c.status).toBe(499)
  expect(c.error).toBe("the response was cancelled (turn_detected)")
  expect(c.stateReason).toBe("turn_detected")
  t.core.fromClient(`{"type":"response.create"}`, [], 1500.0)
  t.core.fromProvider(`{"type":"response.done","response":{"id":"r_i","status":"incomplete","status_details":{"type":"incomplete","reason":"max_output_tokens"}}}`, undefined, 1600.0)
  const i = t.cap.turns[2]!
  expect(i.status).toBe(200)
  expect(i.error).toBe("")
  expect(i.state).toBe("incomplete")
  expect(i.stateReason).toBe("max_output_tokens")
  t.core.fromProvider(DONE_2, undefined, 1700.0)
  expect(t.cap.turns[3]!.status).toBe(200)
  expect(t.cap.turns[3]!.state).toBe("completed")
  // the session itself is no failure
  t.core.clientLeft(1800.0)
  expect(t.cap.reports[0]!.status).toBe(200)
})

test("a realtime error's status follows its type, code and message", () => {
  expect(realtimeErrorStatus(["server_error", "", "boom"])).toBe(500)
  expect(realtimeErrorStatus(["invalid_request_error", "bad_param", "nope"])).toBe(400)
  expect(realtimeErrorStatus(["", "rate_limit_exceeded", "slow down"])).toBe(429)
  expect(realtimeErrorStatus(["invalid_request_error", "insufficient_quota", ""])).toBe(429)
  expect(doneOutcome(`{"type":"response.done","response":{"status":"failed"}}`).error).toBe("realtime turn failed")
  expect(doneOutcome(`{"type":"response.done","response":{}}`).status).toBe(200)
})

test("a transcription session is a row per transcription, billed from the usage that event reports", () => {
  const t = realtimeFixture()
  t.core.transcription = true
  t.core.model = "gpt-4o-transcribe"
  t.core.fromProvider(`{"type":"transcription_session.created","session":{"id":"sess_tr"}}`, undefined, 1050.0)
  t.core.fromProvider(`{"type":"input_audio_buffer.committed","item_id":"item_1"}`, undefined, 1100.0)
  expect(t.cap.readmits).toBe(1)
  t.core.fromProvider(`{"type":"conversation.item.input_audio_transcription.delta","item_id":"item_1","delta":"hel"}`, undefined, 1150.0)
  t.core.fromProvider(`{"type":"conversation.item.input_audio_transcription.completed","item_id":"item_1","transcript":"hello there","usage":{"type":"tokens","total_tokens":28,"input_tokens":20,"input_token_details":{"text_tokens":4,"audio_tokens":16},"output_tokens":8}}`, undefined, 1300.0)
  expect(t.cap.turns.length).toBe(1)
  const a = t.cap.turns[0]!
  expect(a.kind).toBe("transcription")
  expect(a.status).toBe(200)
  expect(a.promptTokens).toBe(20)
  expect(a.completionTokens).toBe(8)
  expect(a.uses[0]!.model).toBe("gpt-4o-transcribe")
  expect(a.uses[0]!.inputAudio).toBe(16)
  expect(a.output).toBe("hello there")
  expect(a.input).toBe("")
  expect(a.startedMs).toBe(1100.0)
  // the same item again is not billed twice
  t.core.fromProvider(`{"type":"conversation.item.input_audio_transcription.completed","item_id":"item_1","transcript":"hello there","usage":{"type":"tokens","input_tokens":20,"output_tokens":8}}`, undefined, 1350.0)
  expect(t.cap.turns.length).toBe(1)
  // a model billed by duration: the seconds, and no commit before it (the unit is admitted as it closes)
  t.core.fromProvider(`{"type":"conversation.item.input_audio_transcription.completed","item_id":"item_2","transcript":"bye","usage":{"type":"duration","seconds":2.5}}`, undefined, 1400.0)
  expect(t.cap.readmits).toBe(2)
  const b = t.cap.turns[1]!
  expect(b.seconds).toBe(2.5)
  expect(b.promptTokens).toBe(0)
  expect(b.output).toBe("bye")
  // a commit that never got its transcript is the closing row
  t.core.fromProvider(`{"type":"input_audio_buffer.committed","item_id":"item_3"}`, undefined, 1500.0)
  t.core.clientLeft(1600.0)
  expect(t.cap.turns.length).toBe(3)
  expect(t.cap.turns[2]!.kind).toBe("end")
})

test("a live session is a row per window of voice time, and the last one carries the end", () => {
  const t = fixture()
  const c = t.core
  c.fromProvider(`{"type":"session.started","session":{"id":"sess_l1"}}`, undefined, 1100.0)
  c.fromProvider(`{"type":"session.input_transcript.delta","delta":"hello"}`, undefined, 1200.0)
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":20}}`, undefined, 2000.0)
  expect(t.cap.turns.length).toBe(0)
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":35}}`, undefined, 3000.0)
  expect(t.cap.turns.length).toBe(1)
  expect(t.cap.turns[0]!.kind).toBe("window")
  expect(t.cap.turns[0]!.seconds).toBe(35.0)
  expect(t.cap.turns[0]!.billedSeconds).toBe(35.0)
  expect(t.cap.turns[0]!.input).toBe("")
  c.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":80}}`, undefined, 4000.0)
  expect(t.cap.turns.length).toBe(2)
  expect(t.cap.turns[1]!.seconds).toBe(45.0)
  c.fromProvider(`{"type":"session.closed","reason":"close_requested","usage":{"seconds":90}}`, undefined, 5000.0)
  expect(t.cap.turns.length).toBe(3)
  const e = t.cap.turns[2]!
  expect(e.kind).toBe("end")
  expect(e.last).toBe(true)
  expect(e.seconds).toBe(10.0)
  expect(e.billedSeconds).toBe(10.0)
  expect(e.reason).toBe("close_requested")
  expect(e.input).toBe("hello")
  expect(e.sessionId).toBe("sess_l1")
  // the rows add up to what the session ran
  let sum = 0.0
  for (const x of t.cap.turns) sum += x.billedSeconds
  expect(sum).toBe(90.0)
  expect(t.cap.turns[0]!.index).toBe(1)
  expect(e.index).toBe(3)
})

test("the minimum voice time is billed once, on the unit that ends a short session", () => {
  const t = fixture()
  t.core.fromProvider(`{"type":"session.closed","usage":{"seconds":4}}`, undefined, 2000.0)
  expect(t.cap.turns.length).toBe(1)
  expect(t.cap.turns[0]!.seconds).toBe(4.0)
  expect(t.cap.turns[0]!.billedSeconds).toBe(15.0)
  // a session past the minimum in its first window owes no more at the end
  const u = fixture()
  u.core.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":31}}`, undefined, 2000.0)
  u.core.fromProvider(`{"type":"session.closed","usage":{"seconds":33}}`, undefined, 3000.0)
  expect(u.cap.turns.length).toBe(2)
  expect(u.cap.turns[0]!.billedSeconds).toBe(31.0)
  expect(u.cap.turns[1]!.billedSeconds).toBe(2.0)
})

test("a refused window leaves the open window to the closing row, with the refusal", () => {
  const t = fixture()
  t.core.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":31}}`, undefined, 2000.0)
  expect(t.cap.turns.length).toBe(1)
  t.cap.readmitWhy = "budget exceeded"
  t.core.fromProvider(`{"type":"session.usage.updated","usage":{"seconds":62}}`, undefined, 3000.0)
  // the window that was refused is not closed yet
  expect(t.cap.turns.length).toBe(1)
  t.core.fromProvider(`{"type":"session.closed","usage":{"seconds":62}}`, undefined, 3100.0)
  expect(t.cap.turns.length).toBe(2)
  const e = t.cap.turns[1]!
  expect(e.status).toBe(429)
  expect(e.error).toBe("budget exceeded")
  expect(e.seconds).toBe(31.0)
  expect(e.billedSeconds).toBe(31.0)
})

test("each delegated response is a row of its own with its model's tokens, admitted first", () => {
  const t = fixture()
  t.core.model = "gpt-live"
  t.core.backendModel = "gpt-5.4"
  t.core.fromProvider(`{"type":"response.event","event":{"type":"response.completed","response":{"id":"r1","usage":{"input_tokens":100,"output_tokens":10,"input_tokens_details":{"cached_tokens":30}}}}}`, undefined, 1100.0)
  expect(t.cap.readmits).toBe(1)
  expect(t.cap.turns.length).toBe(1)
  const a = t.cap.turns[0]!
  expect(a.kind).toBe("delegation")
  expect(a.promptTokens).toBe(100)
  expect(a.uses[0]!.model).toBe("gpt-5.4")
  expect(a.uses[0]!.cached).toBe(30)
  expect(a.billedSeconds).toBe(0.0)
  t.core.fromProvider(`{"type":"response.event","event":{"type":"response.completed","response":{"id":"r2","model":"gpt-5.4-mini","usage":{"input_tokens":7,"output_tokens":3}}}}`, undefined, 1200.0)
  expect(t.cap.turns.length).toBe(2)
  expect(t.cap.turns[1]!.uses[0]!.model).toBe("gpt-5.4-mini")
  expect(t.cap.turns[1]!.promptTokens).toBe(7)
  // the same response again is no new row
  t.core.fromProvider(`{"type":"response.event","event":{"type":"response.completed","response":{"id":"r2","usage":{"input_tokens":7,"output_tokens":3}}}}`, undefined, 1250.0)
  expect(t.cap.turns.length).toBe(2)
  // a response whose admission is refused ends the session and is billed on the closing rows
  t.cap.readmitWhy = "budget exceeded"
  t.core.fromProvider(`{"type":"response.event","event":{"type":"response.completed","response":{"id":"r3","usage":{"input_tokens":50,"output_tokens":5}}}}`, undefined, 1300.0)
  expect(t.cap.turns.length).toBe(2)
  t.core.fromProvider(`{"type":"session.closed","usage":{"seconds":20}}`, undefined, 1400.0)
  expect(t.cap.turns.length).toBe(4)
  expect(t.cap.turns[2]!.kind).toBe("delegation")
  expect(t.cap.turns[2]!.promptTokens).toBe(50)
  expect(t.cap.turns[3]!.kind).toBe("end")
  expect(t.cap.turns[3]!.status).toBe(429)
  // every token the provider reported is in some row
  let sum = 0
  for (const x of t.cap.turns) sum += x.promptTokens
  expect(sum).toBe(157)
})

test("an idle live session meets its budget check, and logs no row for a window with no voice time", () => {
  const t = fixture()
  t.core.tick(70000.0)
  expect(t.cap.readmits).toBe(1)
  expect(t.cap.turns.length).toBe(0)
  // a refusal at that check ends the session, with the closing row
  t.cap.readmitWhy = "budget exceeded"
  t.core.tick(140000.0)
  t.core.fromProvider(`{"type":"session.closed","usage":{"seconds":0}}`, undefined, 141000.0)
  expect(t.cap.turns.length).toBe(1)
  expect(t.cap.turns[0]!.status).toBe(429)
  expect(t.cap.turns[0]!.billedSeconds).toBe(15.0)
})

class TurnCapture {
  pre: string[] = []
  post: string[] = []
  preWhy = ""
  postWhy = ""
}

// A realtime fixture whose turns run plugin hooks that record what they get and refuse when told to.
function hookedFixture(): { core: LiveCore, cap: Capture, tc: TurnCapture } {
  const t = realtimeFixture()
  const tc = new TurnCapture()
  t.core.hooks.turnPre = (body: string): Refusal | undefined => {
    tc.pre.push(body)
    if (tc.preWhy === "") return undefined
    return { status: 418, type: "policy_error", message: tc.preWhy }
  }
  t.core.hooks.turnPost = (status: int, body: string): Refusal | undefined => {
    tc.post.push(status + " " + body)
    if (tc.postWhy === "") return undefined
    return { status: 429, type: "plugin_error", message: tc.postWhy }
  }
  return { core: t.core, cap: t.cap, tc: tc }
}

test("the turn request is made of the caller's inputs, the response.create and the session's tools", () => {
  expect(turnInputOf("conversation.item.create", `{"type":"conversation.item.create","item":{"type":"message","role":"user","content":[{"type":"input_text","text":"hi"},{"type":"input_text","text":"there"}]}}`)).toBe(`{"type":"message","role":"user","content":"hi\\nthere"}`)
  expect(turnInputOf("conversation.item.create", `{"item":{"type":"function_call_output","call_id":"c1","output":"{\\"t\\":20}"}}`)).toBe(`{"type":"function_call_output","output":"{\\"t\\":20}"}`)
  expect(turnInputOf("conversation.item.create", `{"item":{"type":"message","role":"assistant","content":[{"type":"text","text":"x"}]}}`)).toBe("")
  expect(turnInputOf(INPUT_TRANSCRIPT, `{"transcript":" said this "}`)).toBe(`{"type":"message","role":"user","content":"said this"}`)
  expect(turnInputOf("input_audio_buffer.append", `{}`)).toBe("")
  const tools = `[{"type":"function","name":"weather"}]`
  expect(turnRequestJson([`{"a":1}`], "", tools)).toBe(`{"input":[{"a":1}],"tools":${tools}}`)
  expect(turnRequestJson([], `{"type":"response.create","response":{"instructions":"be brief","input":[{"b":2}],"tools":[]}}`, tools)).toBe(`{"input":[{"b":2}],"instructions":"be brief","tools":[]}`)
  const resp = turnResponseJson("gpt-realtime", `{"response":{"status":"completed","output":[{"type":"function_call","call_id":"c9","name":"weather","arguments":"{}"}],"usage":{"input_tokens":7,"output_tokens":3}}}`, "Sunny")
  expect(resp).toBe(`{"object":"response","model":"gpt-realtime","status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"Sunny"}]},{"type":"function_call","call_id":"c9","name":"weather","arguments":"{}"}],"usage":{"input_tokens":7,"output_tokens":3,"total_tokens":10}}`)
})

test("a realtime turn runs the plugins' pre hooks as it starts and their post hooks on its response", () => {
  const t = hookedFixture()
  t.core.fromClient(`{"type":"session.update","session":{"tools":[{"type":"function","name":"weather"}]}}`, [], 1100.0)
  t.core.fromClient(`{"type":"conversation.item.create","item":{"type":"message","role":"user","content":[{"type":"input_text","text":"weather in Oslo?"}]}}`, [], 1150.0)
  expect(t.tc.pre.length).toBe(0)
  t.core.fromClient(`{"type":"response.create","response":{"instructions":"be brief"}}`, [], 1200.0)
  expect(t.tc.pre.length).toBe(1)
  expect(t.tc.pre[0]).toBe(`{"input":[{"type":"message","role":"user","content":"weather in Oslo?"}],"instructions":"be brief","tools":[{"type":"function","name":"weather"}]}`)
  t.core.fromProvider(`{"type":"response.created","response":{"id":"resp_h"}}`, undefined, 1250.0)
  t.core.fromProvider(`{"type":"response.output_text.delta","delta":"Sunny"}`, undefined, 1300.0)
  t.core.fromProvider(`{"type":"response.done","response":{"id":"resp_h","status":"completed","usage":{"input_tokens":9,"output_tokens":2}}}`, undefined, 1400.0)
  expect(t.tc.pre.length).toBe(1)
  expect(t.tc.post.length).toBe(1)
  expect(t.tc.post[0]!.startsWith(`200 {"object":"response","model":"gpt-realtime","status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"Sunny"}]}],"usage":{"input_tokens":9,"output_tokens":2,"total_tokens":11}}`)).toBe(true)
  expect(t.cap.turns[0]!.status).toBe(200)
  // the next turn starts from new inputs: the server's own turn (voice activity) has none
  t.core.fromProvider(`{"type":"response.created","response":{"id":"resp_i"}}`, undefined, 1500.0)
  expect(t.tc.pre[1]).toBe(`{"input":[],"tools":[{"type":"function","name":"weather"}]}`)
  // a session that ends during a turn gives its post hooks the error
  t.core.clientLeft(1600.0)
  expect(t.tc.post.length).toBe(2)
  expect(t.tc.post[1]!.startsWith(`499 {"error":`)).toBe(true)
})

test("a turn the pre hooks refuse closes the session with their error; a post hook's error ends it after the turn", () => {
  const t = hookedFixture()
  t.tc.preWhy = "blocked by the plugin"
  t.core.fromClient(`{"type":"response.create"}`, [], 1100.0)
  expect(t.tc.pre.length).toBe(1)
  expect(t.cap.provider.length).toBe(0)
  expect(t.cap.client[0]!.includes("blocked by the plugin")).toBe(true)
  expect(t.cap.abandoned).toBe(1)
  expect(t.cap.turns[t.cap.turns.length - 1]!.status).toBe(418)
  expect(t.tc.post.length).toBe(0)
  const u = hookedFixture()
  u.tc.postWhy = "turned into an error"
  u.core.fromClient(`{"type":"response.create"}`, [], 1100.0)
  u.core.fromProvider(`{"type":"response.done","response":{"id":"resp_p","status":"completed","usage":{"input_tokens":1,"output_tokens":1}}}`, undefined, 1200.0)
  expect(u.cap.turns[0]!.kind).toBe("turn")
  expect(u.cap.turns[0]!.status).toBe(429)
  expect(u.cap.turns[0]!.error).toBe("turned into an error")
  expect(u.cap.abandoned).toBe(1)
  // a session without turn hooks is untouched
  const v = realtimeFixture()
  v.core.fromClient(`{"type":"response.create"}`, [], 1100.0)
  expect(v.cap.provider.length).toBe(1)
})
