// Request log store: a searchable history of gateway requests, kept in memory
// (a ring of the newest entries) and appended to one JSON-lines file per UTC
// day. Tov has no database driver, so the files are the durable store.
import { mkdirSync, appendFileSync, readFileSync, existsSync, readdirSync, unlinkSync, writeFileSync, rmSync, statSync } from "node:fs"
import { writeFileAtomic, appendPrivate, mkdirPrivate } from "./atomicfile"
import { join } from "node:path"
import { isoMs } from "./exports"
import { DataScope, inScope } from "./scope"
import { fields, elements, decodeString } from "./json"

// kind: "mcp" for an MCP tool execution (op "tool", with tool and server set); absent for an LLM request.
export type LogEntry = {
  id: string,
  ts: f64, // ms since the epoch
  request_id: string,
  op: string,
  provider: string,
  model: string,
  status: int,
  latency_ms: f64,
  prompt_tokens: int,
  completion_tokens: int,
  cost: f64,
  cache_hit: bool,
  virtual_key?: string,
  // who the request is attributed to (governance's team, customer, business unit and project ids)
  team_id?: string,
  customer_id?: string,
  business_unit_id?: string,
  project_id?: string,
  // the caller's session (x-bf-session-id or a coding harness's session header), the user its key is
  // assigned to, the raw User-Agent and the app that User-Agent maps to (logapi.tov)
  session_id?: string,
  user_id?: string,
  user_agent?: string,
  app?: string,
  error?: string,
  input?: string, // request body, only when content logging is on
  output?: string, // response body, only when content logging is on
  kind?: string,
  tool?: string,
  server?: string,
  // the raw upstream request and response, when store_raw_request_response (or its header) keeps them
  raw_request?: string,
  raw_response?: string,
  // the request's bodies were kept as a hidden object in object storage (retained.tov), so the row has none
  content_hidden?: bool,
  // the hybrid store moved the row's payload fields to object storage (hybrid.tov); the log detail reads them back
  has_object?: bool,
  // the request's row metadata (client.logging_headers, x-bf-lh-*, x-bf-dim-*; reqlog.tov)
  metadata?: Record<string, string>,
  // the caller's parent request id and agent correlation id (x-bf-parent-request-id, x-bf-agent-correlation-id)
  parent_request_id?: string,
  agent_correlation_id?: string,
  // Maxim trace attributes the caller named (x-bf-maxim-*): the reserved ids and names, and the tags
  maxim?: Record<string, string>,
  maxim_tags?: Record<string, string>,
  // how the request was routed: the key that served it, the routing rule that matched (its id) and the
  // engine that chose the target, the model alias the caller named, the complexity tier and how it was
  // classified, the local cache hit ("direct" or "semantic") and the stop reason of the answer
  selected_key_id?: string,
  selected_key_name?: string,
  routing_rule_id?: string,
  routing_engine_used?: string,
  alias?: string,
  complexity_tier?: string,
  complexity_mechanism?: string,
  cache_hit_type?: string,
  stop_reason?: string,
  // the names of the tools the answer called (reqlog.tov toolCallNamesOf), the heuristic complexity score
  // behind the tier (heuristic mechanism only) and the prompt the request named with x-bf-prompt-id
  tool_call_names?: string[],
  // the answer was asked for as a stream (Bifrost's *_stream request types)
  streamed?: bool,
  complexity_score?: f64,
  selected_prompt_id?: string,
  selected_prompt_name?: string,
  selected_prompt_version?: int,
  // the gateway's overhead for the request (ms; the latency histogram's overhead fields), the price's input and
  // output parts and any billed difference beyond them, and the alias's canonical model name (Bifrost's rankings)
  overhead_ms?: f64,
  input_cost?: f64,
  output_cost?: f64,
  additional_cost?: f64,
  canonical_model_name?: string,
  // the registered A2A agent a call went to (kind "a2a"; agents.tov); session_id is the call's context id
  agent_name?: string,
  // an A2A row's kind: "request" (the call; also when unset) or "event", one event of a call's stream (Bifrost's
  // ObserveA2AEvent), linked to its call by request_id. An event row carries its 1-based sequence in the stream, its
  // type (message, task, status_update, artifact_update), the task state, message and artifact it names, the media
  // type of its first part, and the event itself (content: kept when the call's content is)
  record_kind?: string,
  event_sequence?: int,
  event_type?: string,
  task_state?: string,
  message_id?: string,
  artifact_id?: string,
  content_type?: string,
  event_body?: string,
  // the crew routing of a crew/<pool> call (crew.tov): the task, its pool, the role the caller named, the class the
  // task was fixed to, the candidate that served the call and the attempt. Rows from before L153 have none.
  task_id?: string,
  crew_pool?: string,
  crew_role?: string,
  crew_class?: string,
  crew_candidate?: string,
  crew_attempt?: int,
  // an A2A call's bindings: the one the caller used and the one the agent was called on (JSONRPC, HTTP+JSON, GRPC);
  // task_id above is then the A2A task the call names or made
  downstream_transport?: string,
  upstream_transport?: string,
  // the plugin logs of the request, grouped by plugin name (Bifrost's plugin_logs: {"<plugin>": [{plugin_name, level,
  // message, timestamp}]}): a WebAssembly plugin's output and failed hooks, and compat's warnings
  plugin_logs?: string,
  // the reveal mapping of a logs_only redaction ({"input": {"EMAIL-1": "..."}, "output": {...}}), sealed when the
  // config has an encryption key. Only GET /api/logs/{id} and /api/mcp-logs/{id} show it, to a caller holding
  // Logs:Reveal; every other read and export leaves it out (publicEntry).
  redaction_mapping?: string,
}

// An entry as reads and exports may show it: without its reveal mapping.
export function publicEntry(e: LogEntry): LogEntry {
  if (e.redaction_mapping === undefined) return e
  let out = e
  out.redaction_mapping = undefined
  return out
}

// An entry without its bodies, raw payloads, plugin logs and reveal mapping: what another node needs of a row for
// stats, histograms and rankings (cross-node log reads, ops.tov clusterLogs).
export function liteEntry(e: LogEntry): LogEntry {
  let out = e
  out.input = undefined
  out.output = undefined
  out.raw_request = undefined
  out.raw_response = undefined
  out.plugin_logs = undefined
  out.redaction_mapping = undefined
  return out
}

// This node's rows and the rows other nodes sent for the same read, as one list oldest first. A row both have (nodes
// that share a logs folder) is kept once, as this node holds it.
export function mergeRows(local: LogEntry[], extra: LogEntry[]): LogEntry[] {
  if (extra.length === 0) return local
  const seen: Set<string> = new Set()
  for (const e of local) seen.add(e.id)
  const more: LogEntry[] = []
  for (const e of extra) {
    if (seen.has(e.id)) continue
    seen.add(e.id)
    more.push(e)
  }
  if (more.length === 0) return local
  more.sort((a, b) => (a.ts < b.ts ? -1 : a.ts > b.ts ? 1 : 0))
  // both lists are oldest first: merge them
  const out: LogEntry[] = []
  let i = 0
  let j = 0
  while (i < local.length || j < more.length) {
    if (j >= more.length || (i < local.length && local[i]!.ts <= more[j]!.ts)) {
      out.push(local[i]!)
      i += 1
    } else {
      out.push(more[j]!)
      j += 1
    }
  }
  return out
}

export type LogStoreConfig = {
  dir: string,
  retention_days: int,
  max_memory_entries: int,
  content_logging: bool,
  max_content_bytes: int,
  // a day file is cut into segments of about this size (MB; default 32), so start-up and shared queries read only
  // the newest segments, never a whole day
  max_file_mb?: int,
  // the log files may take this much disk (MB) in all; the oldest segments go first. 0 (the default): no cap
  max_disk_mb?: int,
}

export type LogQuery = {
  provider?: string,
  model?: string,
  status?: "success" | "error",
  virtual_key?: string,
  team_id?: string,
  customer_id?: string,
  business_unit_id?: string,
  project_id?: string,
  // the entries the caller's data access scope may see (see scope.tov); all when absent
  scope?: DataScope,
  since?: f64,
  until?: f64,
  text?: string, // substring of model, error or request_id
  limit?: int,
  offset?: int,
  kind?: string, // "mcp" for MCP tool executions; LLM requests when absent
}

export type ModelStats = { model: string, requests: int, cost: f64 }

export type LogStats = {
  requests: int,
  errors: int,
  tokens: int,
  cost: f64,
  avg_latency_ms: f64,
  by_model: ModelStats[],
}

export function defaultLogStoreConfig(dir: string): LogStoreConfig {
  return { dir: dir, retention_days: 7, max_memory_entries: 10000, content_logging: false, max_content_bytes: 8192, max_file_mb: DEFAULT_FILE_MB, max_disk_mb: 0 }
}

export const DEFAULT_FILE_MB = 32
// Rows are written in batches: when this many bytes are waiting, or FLUSH_MS after the first row of a batch.
const FLUSH_BYTES = 65536
const FLUSH_MS = 100
// A segment this many times the segment size (a day file from before segments, say) is not read whole at start-up.
const LOAD_SKIP_FACTOR = 4
// the disk cap and retention are checked this often while rows are written
const MAINTAIN_MS = 60000
// a failing disk is reported at most this often
const ERROR_EVERY_MS = 10000

const DAY_MS = 86400000

// Days since 1970-01-01 for a proleptic Gregorian date (Howard Hinnant's
// algorithm; the 400-year eras make it exact for every year, leap years included).
export function daysFromCivil(y0: int, m: int, d: int): int {
  const y = m <= 2 ? y0 - 1 : y0
  const era = Math.floor(y / 400)
  const yoe = y - era * 400
  const mp = m > 2 ? m - 3 : m + 9
  const doy = Math.floor((153 * mp + 2) / 5) + d - 1
  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy
  return era * 146097 + doe - 719468
}

function civilFromDays(z0: int): { y: int, m: int, d: int } {
  const z = z0 + 719468
  const era = Math.floor(z / 146097)
  const doe = z - era * 146097
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365)
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100))
  const mp = Math.floor((5 * doy + 2) / 153)
  const d = doy - Math.floor((153 * mp + 2) / 5) + 1
  const m = mp < 10 ? mp + 3 : mp - 9
  const y = yoe + era * 400
  return { y: m <= 2 ? y + 1 : y, m: m, d: d }
}

function pad(n: int, width: int): string {
  let s = "" + n
  while (s.byteLength < width) s = "0" + s
  return s
}

// The UTC calendar day of a timestamp, as YYYY-MM-DD. Floor division keeps
// times before 1970 on the right day.
function dayOf(ms: f64): string {
  const c = civilFromDays(Math.floor(ms / DAY_MS))
  return pad(c.y, 4) + "-" + pad(c.m, 2) + "-" + pad(c.d, 2)
}

function fileName(ts: f64): string {
  return "requests-" + dayOf(ts) + ".jsonl"
}

// The file of segment seg of a day (YYYY-MM-DD): requests-<day>.jsonl, then requests-<day>.<seg>.jsonl.
function segmentName(day: string, seg: int): string {
  return seg === 0 ? "requests-" + day + ".jsonl" : "requests-" + day + "." + seg + ".jsonl"
}

type Segment = { name: string, day: int, seg: int }

// what the scan's index knows of a segment: its size when it was read, and its oldest and newest row times
type SegSpan = { size: int, min: f64, max: f64 }

// The time of a stored row, read from its line without parsing the rest: the first "ts" followed by a colon is the
// row's own key (rows begin with their id and time; a string value that holds "ts" has no colon after it). A row
// written by another tool may have spaces around the colon. undefined for a line without one.
export function lineTs(line: string): f64 | undefined {
  const n = line.byteLength
  let from = 0
  while (from < n) {
    const at = line.slice(from, n).indexOf(`"ts"`)
    if (at < 0) return undefined
    let j = from + at + 4
    while (j < n && line.slice(j, j + 1) === " ") j += 1
    if (j < n && line.slice(j, j + 1) === ":") {
      j += 1
      let k = j
      while (k < n) {
        const c = line.slice(k, k + 1)
        if (c === "," || c === "}") break
        k += 1
      }
      return parseFloat(line.slice(j, k).trim())
    }
    from = from + at + 4
  }
  return undefined
}

// The day and segment of a request log file, or undefined for any other name.
function segmentOf(name: string): Segment | undefined {
  if (name.byteLength < 25 || !name.startsWith("requests-") || !name.endsWith(".jsonl")) return undefined
  const day = fileDay(name.slice(0, 19) + ".jsonl")
  if (day === undefined) return undefined
  if (name.byteLength === 25) return { name: name, day: day, seg: 0 }
  // requests-YYYY-MM-DD.<n>.jsonl, n a positive number without leading zeros
  const mid = name.slice(19, name.byteLength - 6)
  if (mid.byteLength < 2 || !mid.startsWith(".") || mid.startsWith(".0")) return undefined
  for (const b of new TextEncoder().encode(mid.slice(1))) {
    if (int(b) < 48 || int(b) > 57) return undefined
  }
  const n = parseInt(mid.slice(1))
  if (n === undefined || n <= 0) return undefined
  return { name: name, day: day, seg: n }
}

// The request log files of a folder, oldest first (by day, then segment).
function segmentsIn(dir: string): Segment[] {
  const out: Segment[] = []
  let names: string[] = []
  try {
    names = readdirSync(dir)
  } catch (err) {
    return out
  }
  for (const name of names) {
    const s = segmentOf(name)
    if (s !== undefined) out.push(s)
  }
  out.sort((a, b) => (a.day !== b.day ? a.day - b.day : a.seg - b.seg))
  return out
}

function sizeOf(path: string): int {
  try {
    return statSync(path).size
  } catch (err) {
    return -1
  }
}

// The day number of a requests-YYYY-MM-DD.jsonl file, or undefined for any
// other name (including dates that do not exist, such as 2026-02-31).
function fileDay(name: string): int | undefined {
  if (name.byteLength !== 25 || !name.startsWith("requests-") || !name.endsWith(".jsonl")) return undefined
  const y = parseInt(name.slice(9, 13))
  const m = parseInt(name.slice(14, 16))
  const d = parseInt(name.slice(17, 19))
  if (y === undefined || m === undefined || d === undefined) return undefined
  const days = daysFromCivil(y, m, d)
  const c = civilFromDays(days)
  if (c.y !== y || c.m !== m || c.d !== d) return undefined
  return days
}

// Cuts s to at most max bytes without ending inside a multi-byte character:
// a UTF-8 continuation byte (10xxxxxx) marks the middle of one.
// Raw upstream payloads kept in the log: cut to 1 MiB, Bifrost's truncated_log_bytes default.
const RAW_MAX = 1048576

function clip(s: string | undefined, max: int): string | undefined {
  if (s === undefined || s.byteLength <= max) return s
  const bytes = new TextEncoder().encode(s)
  let end = Math.max(0, max)
  while (end > 0 && (int(bytes[end]!) & 0xc0) === 0x80) end -= 1
  try {
    return new TextDecoder().decode(bytes.slice(0, end))
  } catch (err) {
    return ""
  }
}

function isSuccess(e: LogEntry): bool {
  return e.status >= 200 && e.status < 300
}

function mentions(e: LogEntry, text: string): bool {
  if (e.model.includes(text) || e.request_id.includes(text)) return true
  const tool = e.tool
  if (tool !== undefined && tool.includes(text)) return true
  const err = e.error
  if (err !== undefined && err.includes(text)) return true
  return contentMentions(e.input, text) || contentMentions(e.output, text)
}

// The keys whose string values are message text (Bifrost's content summary: the input messages, the
// Responses input, embedding input and the output message), in request and answer bodies of any format.
const TEXT_KEYS = ["content", "text", "input", "prompt", "instructions", "system", "query", "delta", "output_text", "documents"]

function collectText(raw: string, key: string, inout out: string[], depth: int): void {
  if (depth > 32 || raw === "") return
  const c = raw.slice(0, 1)
  try {
    if (c === "\"") {
      if (TEXT_KEYS.includes(key)) out.push(decodeString(raw))
    } else if (c === "{") {
      for (const f of fields(raw)) collectText(f.raw, f.key, &out, depth + 1)
    } else if (c === "[") {
      for (const el of elements(raw)) collectText(el, key, &out, depth + 1)
    }
  } catch (e) {
    return
  }
}

// The message text of a logged body: a JSON body, or the data lines of a streamed answer.
export function contentTextOf(body: string): string {
  let out: string[] = []
  const t = body.trim()
  if (t.startsWith("{") || t.startsWith("[")) {
    collectText(t, "", &out, 0)
  } else {
    for (const line of t.split("\n")) {
      if (!line.startsWith("data:")) continue
      const d = line.slice(5).trim()
      if (d.startsWith("{")) collectText(d, "", &out, 0)
    }
  }
  return out.join("")
}

// content_search over a body's message text, ignoring case (as Bifrost's LIKE and full-text search). A JSON
// body that does not hold the text at all is ruled out before it is parsed; a streamed answer splits its text
// across events, so it is always parsed.
function contentMentions(body: string | undefined, text: string): bool {
  if (body === undefined || body === "") return false
  const needle = text.toLowerCase()
  const t = body.trim()
  const json = t.startsWith("{") || t.startsWith("[")
  // (a \u escape may spell the text, so a body with one is always parsed)
  if (json && !t.includes("\\u") && !t.toLowerCase().includes(needle)) return false
  return contentTextOf(t).toLowerCase().includes(needle)
}

// LLM requests and MCP tool executions share the store; kind tells them apart.
export function kindOf(e: LogEntry): string {
  return e.kind ?? "llm"
}

// Bifrost's request type (its logs' object_type) for one of Raiju's ops; an op with no Bifrost name is
// returned as it is. Chat, text completions and Responses have a _stream type when the answer streamed.
export function bifrostRequestType(op: string, streamed: bool): string {
  const names: Map<string, string> = new Map()
  for (const p of [
    ["chat", "chat_completion"], ["anthropic.messages", "chat_completion"], ["completions", "text_completion"],
    ["embeddings", "embedding"], ["audio.speech", "speech"], ["audio.transcriptions", "transcription"],
    ["images.generations", "image_generation"], ["images.edits", "image_edit"], ["images.variations", "image_variation"],
    ["models.list", "list_models"], ["models.retrieve", "model_retrieve"], ["responses.retrieve", "responses_retrieve"],
    ["responses.delete", "responses_delete"], ["responses.cancel", "responses_cancel"], ["responses.input_items", "responses_input_items"],
  ]) names.set(p[0]!, p[1]!)
  const t = names.get(op) ?? op
  return streamed && (t === "chat_completion" || t === "text_completion" || t === "responses") ? t + "_stream" : t
}

function matches(e: LogEntry, q: LogQuery): bool {
  if (kindOf(e) !== (q.kind ?? "llm")) return false
  if (q.provider !== undefined && e.provider !== q.provider) return false
  if (q.model !== undefined && e.model !== q.model) return false
  if (q.status !== undefined && isSuccess(e) !== (q.status === "success")) return false
  if (q.virtual_key !== undefined && e.virtual_key !== q.virtual_key) return false
  if (q.team_id !== undefined && e.team_id !== q.team_id) return false
  if (q.customer_id !== undefined && e.customer_id !== q.customer_id) return false
  if (q.business_unit_id !== undefined && e.business_unit_id !== q.business_unit_id) return false
  if (q.project_id !== undefined && e.project_id !== q.project_id) return false
  if (q.scope !== undefined && !visibleTo(e, q.scope)) return false
  if (q.since !== undefined && e.ts < q.since) return false
  if (q.until !== undefined && e.ts > q.until) return false
  if (q.text !== undefined && q.text !== "" && !mentions(e, q.text)) return false
  return true
}

export class LogStore {
  // With several workers, each logs to the same day files, row by row; queries then read the newest segments of
  // today (cached until they grow) so every worker answers with every worker's requests.
  shared = false
  // called with each entry this store adds, after it is kept
  onAdd: ((e: LogEntry) => void) | undefined = undefined
  // called with each entry as it is about to be stored (bodies already cut or dropped), for the row that is kept: the
  // hybrid store moves the payload fields to object storage here (gateway.tov, hybrid.tov)
  onPrepare: ((e: LogEntry) => LogEntry) | undefined = undefined
  private viewKey = ""
  private view: LogEntry[] = []
  // the rows of earlier days read back from the files (earlierRows), and what they were read from
  private olderKey = ""
  private older: LogEntry[] = []
  // the oldest and newest row times of each segment read whole, and its size then (scanRows)
  private segIndex: Map<string, SegSpan> = new Map()
  private ring: LogEntry[] = []
  // Where the next entry goes: once the ring is full this is the oldest slot.
  private next: int = 0
  private cap: int
  // rows not yet written, by day (YYYY-MM-DD), oldest first
  private pending: Map<string, string[]> = new Map()
  private pendingBytes = 0
  private flushTimer = -1
  // the segment each day's rows go to, as this process last saw it
  private segs: Map<string, int> = new Map()
  private lastMaintain = 0.0
  private lastError = 0.0
  // segments past the disk cap that were deleted (as a whole), since start
  capped: int = 0

  constructor(readonly cfg: LogStoreConfig) {
    this.cap = Math.max(1, cfg.max_memory_entries)
    // request logs may hold prompts and answers: the folder and its files are private
    try mkdirPrivate(cfg.dir)
    // the newest of today's rows, from the newest segments only: a long day is never read whole
    const rows = this.newestRows(Math.floor(Date.now() / DAY_MS), this.cap, true)
    for (let k = rows.length - 1; k >= 0; k--) this.remember(rows[k]!)
    this.enforceCap()
    // (the gateway prunes at start; the upkeep comes MAINTAIN_MS later)
    this.lastMaintain = Date.now()
  }

  private fileBytes(): int {
    const mb = this.cfg.max_file_mb ?? DEFAULT_FILE_MB
    return (mb > 0 ? mb : DEFAULT_FILE_MB) * 1048576
  }

  // Up to want rows of a day, newest first, read from its newest segments. At start-up a segment far over the
  // segment size (written before segments existed) is skipped with a note rather than read whole.
  private newestRows(day: int, want: int, starting: bool): LogEntry[] {
    const out: LogEntry[] = []
    const all = segmentsIn(this.cfg.dir).filter((s) => s.day === day)
    for (let i = all.length - 1; i >= 0 && out.length < want; i--) {
      const path = join(this.cfg.dir, all[i]!.name)
      if (starting && sizeOf(path) > this.fileBytes() * LOAD_SKIP_FACTOR) {
        console.error(`logstore: ${all[i]!.name} is too large to load at start-up; its rows are kept on disk but not in /api/logs`)
        continue
      }
      let lines: string[] = []
      try {
        lines = readFileSync(path, "utf8").split("\n")
      } catch (err) {
        continue
      }
      for (let k = lines.length - 1; k >= 0 && out.length < want; k--) {
        const line = lines[k]!
        if (line === "") continue
        // a torn or foreign line is skipped, not fatal
        try {
          out.push(JSON.parse(line) as LogEntry)
        } catch (err) {
          continue
        }
      }
    }
    return out
  }

  // Keeps the entry in memory and queues it for its day's file; the file write is batched (flush) in a process alone. A failed write
  // is counted and reported on stderr (at most every ERROR_EVERY_MS); it must not fail the request that was logged.
  add(e: LogEntry): void {
    const pre = this.onPrepare
    const entry = pre === undefined ? this.prepare(e) : pre(this.prepare(e))
    this.remember(entry)
    const line = JSON.stringify(entry) + "\n"
    const day = dayOf(entry.ts)
    let rows = this.pending.get(day)
    if (rows === undefined) {
      const fresh: string[] = []
      rows = fresh
    }
    rows.push(line)
    this.pending.set(day, rows)
    this.pendingBytes += line.byteLength
    // (the workers of a node read each other's rows from the files, and some decisions (a crew task's calls) need the
    // newest at once: shared stores write each row as it comes)
    if (this.shared || this.pendingBytes >= FLUSH_BYTES) this.flush()
    else if (this.flushTimer < 0) {
      this.flushTimer = setTimeout(() => {
        this.flushTimer = -1
        this.flush()
      }, FLUSH_MS)
    }
    // the live feed takes each entry this process wrote (ops.tov feedPublish)
    const h = this.onAdd
    if (h !== undefined) h(entry)
  }

  // Rows waiting for the next flush.
  pendingRows(): int {
    let n = 0
    for (const rows of this.pending.values()) n += rows.length
    return n
  }

  // Writes the queued rows: one append per day, to the day's current segment (the next one once it has reached the
  // segment size). Called by the batch timer, when a batch is full, and before anything reads or rewrites the files.
  flush(): void {
    if (this.pendingBytes === 0) return
    const batch = this.pending
    this.pending = new Map()
    this.pendingBytes = 0
    let rotated = false
    for (const day of batch.keys()) {
      const rows = batch.get(day)!
      const seg = this.segmentFor(day)
      if (seg.rotated) rotated = true
      try {
        appendPrivate(join(this.cfg.dir, segmentName(day, seg.n)), rows.join(""))
      } catch (err) {
        this.dropped += rows.length
        const now = Date.now()
        if (now - this.lastError >= ERROR_EVERY_MS) {
          this.lastError = now
          console.error(`logstore: could not write request log (${this.dropped} rows dropped so far): ${err.message}`)
        }
      }
    }
    const now = Date.now()
    if (rotated || now - this.lastMaintain >= MAINTAIN_MS) this.maintain(now)
  }

  // The segment a day's next rows go to. Every worker of a node applies the same rule to the same files (the
  // first segment under the size, counting up from the last one seen), so they agree on it without talking.
  private segmentFor(day: string): { n: int, rotated: bool } {
    let n = this.segs.get(day) ?? -1
    if (n < 0) {
      n = 0
      for (const s of segmentsIn(this.cfg.dir)) {
        if (s.seg > n && segmentName(day, s.seg) === s.name) n = s.seg
      }
    }
    const limit = this.fileBytes()
    let rotated = false
    while (sizeOf(join(this.cfg.dir, segmentName(day, n))) >= limit) {
      n += 1
      rotated = true
    }
    this.segs.set(day, n)
    return { n: n, rotated: rotated }
  }

  // The periodic upkeep while rows are written: retention by days and the disk cap.
  private maintain(now: f64): void {
    this.lastMaintain = now
    try {
      this.prune(now)
    } catch (err) {
      // an unreadable folder: the writes report it
    }
    this.enforceCap()
  }

  // logs_store.max_disk_mb: deletes the oldest segments until the files fit, never the newest one (being written).
  // Returns how many went.
  enforceCap(): int {
    const mb = this.cfg.max_disk_mb ?? 0
    if (mb <= 0) return 0
    const limit = mb * 1048576
    const all = segmentsIn(this.cfg.dir)
    const sizes: int[] = []
    let total = 0
    for (const s of all) {
      const n = Math.max(0, sizeOf(join(this.cfg.dir, s.name)))
      sizes.push(n)
      total += n
    }
    let removed = 0
    for (let i = 0; i < all.length - 1 && total > limit; i++) {
      try {
        unlinkSync(join(this.cfg.dir, all[i]!.name))
        total -= sizes[i]!
        removed += 1
      } catch (err) {
        console.error(`logstore: could not delete ${all[i]!.name}: ${err.message}`)
      }
    }
    if (removed > 0) {
      this.capped += removed
      this.viewKey = ""
      console.error(`logstore: deleted ${removed} old request log file${removed === 1 ? "" : "s"} to stay under logs_store.max_disk_mb (${mb} MB)`)
    }
    return removed
  }

  // Entries that could not be written to their day file (Bifrost's /api/logs/dropped).
  dropped: int = 0

  // Removes the entries with these ids from memory and from every day file. Returns how many went.
  delete(ids: string[]): int {
    const drop: Set<string> = new Set()
    for (const id of ids) drop.add(id)
    // the ids that went, from memory or from a file (an entry can be in both)
    const gone: Set<string> = new Set()
    // the ring rebuilt oldest first, so its slots line up again
    const keep: LogEntry[] = []
    for (let k = this.ring.length - 1; k >= 0; k--) {
      const e = this.newest(k)
      if (drop.has(e.id)) gone.add(e.id)
      else keep.push(e)
    }
    this.ring = keep
    this.next = keep.length % this.cap
    this.viewKey = ""
    // (queued rows are written first, so a deleted id cannot come back with them)
    this.flush()
    for (const sg of segmentsIn(this.cfg.dir)) {
      const name = sg.name
      const path = join(this.cfg.dir, name)
      let lines: string[] = []
      try {
        lines = readFileSync(path, "utf8").split("\n")
      } catch (err) {
        continue
      }
      const out: string[] = []
      let hit = 0
      for (const line of lines) {
        if (line === "") continue
        try {
          const id = (JSON.parse(line) as LogEntry).id
          if (drop.has(id)) {
            gone.add(id)
            hit += 1
            continue
          }
        } catch (err) {
          // a torn line is kept as it is
        }
        out.push(line)
      }
      if (hit === 0) continue
      try {
        writeFileAtomic(path, out.length === 0 ? "" : out.join("\n") + "\n")
      } catch (err) {
        console.error(`logstore: could not rewrite ${name}: ${err.message}`)
      }
    }
    return gone.size
  }

  // The entries queries see, newest first: memory, or the newest segments of today when shared.
  private recent(): LogEntry[] {
    if (!this.shared) {
      const out: LogEntry[] = []
      for (let k = 0; k < this.ring.length; k++) out.push(this.newest(k))
      return out
    }
    this.flush()
    const today = Math.floor(Date.now() / DAY_MS)
    const segs = segmentsIn(this.cfg.dir).filter((sg) => sg.day === today)
    const last = segs.length === 0 ? "" : segs[segs.length - 1]!.name
    const key = last === "" ? "none" : `${segs.length}:${last}:${sizeOf(join(this.cfg.dir, last))}`
    if (key === this.viewKey) return this.view
    this.view = this.newestRows(today, this.cap, false)
    this.viewKey = key
    return this.view
  }

  query(q: LogQuery): { entries: LogEntry[], total: int } {
    const limit = Math.min(1000, Math.max(0, q.limit ?? 50))
    const offset = Math.max(0, q.offset ?? 0)
    const entries: LogEntry[] = []
    let total = 0
    for (const e of this.recent()) {
      if (!matches(e, q)) continue
      if (total >= offset && entries.length < limit) entries.push(e)
      total += 1
    }
    return { entries: entries, total: total }
  }

  // Totals over the in-memory entries logged at or after since.
  stats(since: f64): LogStats {
    let requests = 0
    let errors = 0
    let tokens = 0
    let cost = 0.0
    let latency = 0.0
    const perModel: Map<string, ModelStats> = new Map()
    for (const e of this.recent()) {
      if (e.ts < since || kindOf(e) !== "llm") continue
      requests += 1
      if (!isSuccess(e)) errors += 1
      tokens += e.prompt_tokens + e.completion_tokens
      cost += e.cost
      latency += e.latency_ms
      const m = perModel.get(e.model) ?? { model: e.model, requests: 0, cost: 0.0 }
      perModel.set(e.model, { model: e.model, requests: m.requests + 1, cost: m.cost + e.cost })
    }
    const byModel: ModelStats[] = []
    for (const name of perModel.keys()) byModel.push(perModel.get(name)!)
    byModel.sort((a, b) => b.cost - a.cost)
    return {
      requests: requests,
      errors: errors,
      tokens: tokens,
      cost: cost,
      avg_latency_ms: requests > 0 ? latency / requests : 0.0,
      by_model: byModel,
    }
  }

  // Replaces the cost of every entry that pick() prices (it returns the new cost, or undefined to keep
  // the entry as it is), in memory and in the day files. Returns how many changed.
  recost(pick: (e: LogEntry) => f64 | undefined): int {
    // an entry can be in memory and in its file: counted once, by id
    const changed: Set<string> = new Set()
    for (let i = 0; i < this.ring.length; i++) {
      const e = this.ring[i]!
      const c = pick(e)
      if (c === undefined || c === e.cost) continue
      let n = this.ring[i]!
      n.cost = c
      this.ring[i] = n
      changed.add(e.id)
    }
    this.viewKey = ""
    this.flush()
    for (const sg of segmentsIn(this.cfg.dir)) {
      const name = sg.name
      const path = join(this.cfg.dir, name)
      let lines: string[] = []
      try {
        lines = readFileSync(path, "utf8").split("\n")
      } catch (err) {
        continue
      }
      const out: string[] = []
      let hit = 0
      for (const line of lines) {
        if (line === "") continue
        let parsed: LogEntry | undefined = undefined
        try {
          parsed = JSON.parse(line) as LogEntry
        } catch (err) {
          out.push(line)
          continue
        }
        if (parsed === undefined) {
          out.push(line)
          continue
        }
        const e: LogEntry = parsed
        const c = pick(e)
        if (c === undefined || c === e.cost) {
          out.push(line)
          continue
        }
        e.cost = c
        out.push(JSON.stringify(e))
        changed.add(e.id)
        hit += 1
      }
      if (hit === 0) continue
      try {
        writeFileAtomic(path, out.length === 0 ? "" : out.join("\n") + "\n")
      } catch (err) {
        console.error(`logstore: could not rewrite ${name}: ${err.message}`)
      }
    }
    return changed.size
  }

  // Deletes the day files (every segment) older than retention_days before now; returns how many. It runs at start
  // and then with the store's upkeep (every MAINTAIN_MS while rows are written).
  prune(now: f64): int throws Error {
    const cutoff = Math.floor(now / DAY_MS) - this.cfg.retention_days
    let removed = 0
    for (const name of try readdirSync(this.cfg.dir)) {
      const sg = segmentOf(name)
      if (sg === undefined || sg.day >= cutoff) continue
      try {
        unlinkSync(join(this.cfg.dir, name))
        removed += 1
      } catch (err) {
        console.error(`logstore: could not delete ${name}: ${err.message}`)
      }
    }
    return removed
  }

  // The entry as it is stored: bodies cut to the limit, or dropped entirely
  // when content logging is off.
  private prepare(e: LogEntry): LogEntry {
    const on = this.cfg.content_logging
    const max = this.cfg.max_content_bytes
    return {
      id: e.id,
      ts: e.ts,
      request_id: e.request_id,
      op: e.op,
      provider: e.provider,
      model: e.model,
      status: e.status,
      latency_ms: e.latency_ms,
      prompt_tokens: e.prompt_tokens,
      completion_tokens: e.completion_tokens,
      cost: e.cost,
      cache_hit: e.cache_hit,
      virtual_key: e.virtual_key,
      team_id: e.team_id,
      customer_id: e.customer_id,
      business_unit_id: e.business_unit_id,
      project_id: e.project_id,
      session_id: e.session_id,
      user_id: e.user_id,
      user_agent: e.user_agent,
      app: e.app,
      error: e.error,
      input: on ? clip(e.input, max) : undefined,
      output: on ? clip(e.output, max) : undefined,
      kind: e.kind,
      tool: e.tool,
      server: e.server,
      agent_name: e.agent_name,
      task_id: e.task_id,
      record_kind: e.record_kind,
      event_sequence: e.event_sequence,
      event_type: e.event_type,
      task_state: e.task_state,
      message_id: e.message_id,
      artifact_id: e.artifact_id,
      content_type: e.content_type,
      event_body: on ? clip(e.event_body, max) : undefined,
      crew_pool: e.crew_pool,
      crew_role: e.crew_role,
      crew_class: e.crew_class,
      crew_candidate: e.crew_candidate,
      crew_attempt: e.crew_attempt,
      // raw payloads are kept whenever they were captured (store_raw_request_response), cut to Bifrost's
      // truncated_log_bytes default of 1 MiB
      raw_request: clip(e.raw_request, RAW_MAX),
      raw_response: clip(e.raw_response, RAW_MAX),
      content_hidden: e.content_hidden,
      has_object: e.has_object,
      metadata: e.metadata,
      parent_request_id: e.parent_request_id,
      agent_correlation_id: e.agent_correlation_id,
      maxim: e.maxim,
      maxim_tags: e.maxim_tags,
      selected_key_id: e.selected_key_id,
      selected_key_name: e.selected_key_name,
      routing_rule_id: e.routing_rule_id,
      routing_engine_used: e.routing_engine_used,
      alias: e.alias,
      complexity_tier: e.complexity_tier,
      complexity_mechanism: e.complexity_mechanism,
      cache_hit_type: e.cache_hit_type,
      stop_reason: e.stop_reason,
      tool_call_names: e.tool_call_names,
      streamed: e.streamed,
      complexity_score: e.complexity_score,
      selected_prompt_id: e.selected_prompt_id,
      selected_prompt_name: e.selected_prompt_name,
      selected_prompt_version: e.selected_prompt_version,
      overhead_ms: e.overhead_ms,
      input_cost: e.input_cost,
      output_cost: e.output_cost,
      additional_cost: e.additional_cost,
      canonical_model_name: e.canonical_model_name,
      downstream_transport: e.downstream_transport,
      upstream_transport: e.upstream_transport,
      plugin_logs: e.plugin_logs,
      redaction_mapping: e.redaction_mapping,
    }
  }

  private remember(e: LogEntry): void {
    if (this.ring.length < this.cap) {
      this.ring.push(e)
      this.next = this.ring.length % this.cap
    } else {
      this.ring[this.next] = e
      this.next = (this.next + 1) % this.cap
    }
  }

  // The entries newer than ts (and, with until, logged at or before it), oldest first, as the analytics read them:
  // the day file when the workers share it (so every worker answers with every worker's requests), else memory.
  viewSince(ts: f64, until?: f64): LogEntry[] {
    let out: LogEntry[] = []
    const today = Math.floor(Date.now() / DAY_MS)
    const dayStart: f64 = today * 1.0 * DAY_MS
    // the oldest row in hand: memory's, or, when the workers read today's files, today's start (or the oldest row
    // read, when today has more rows than max_memory_entries)
    let first: f64 = this.oldestTs()
    if (!this.shared) out = this.since(ts)
    else {
      const all = this.recent()
      first = all.length >= this.cap ? all[all.length - 1]!.ts : dayStart
      for (let k = all.length - 1; k >= 0; k--) {
        if (all[k]!.ts > ts) out.push(all[k]!)
      }
    }
    if (until !== undefined) {
      const u: f64 = until
      out = out.filter((e) => e.ts <= u)
    }
    // a window that starts before the rows in hand also gets the older rows from the files: today's rows beyond
    // max_memory_entries, and the days before (after a restart memory holds only today's)
    if (ts >= first) return out
    if (until !== undefined && until <= ts) return out
    const back = this.scanRows(ts, first, until)
    if (back.length === 0) return out
    // the scan includes rows at the oldest time in hand (rows logged in the same millisecond can be on either side),
    // so the rows already in hand are left out by id
    const held: Set<string> = new Set()
    for (const e of out) held.add(e.id)
    const add: LogEntry[] = []
    for (let k = back.length - 1; k >= 0; k--) {
      if (!held.has(back[k]!.id)) add.push(back[k]!)
    }
    return add.concat(out)
  }

  // The time of the oldest row in memory (now when there is none).
  private oldestTs(): f64 {
    if (this.ring.length === 0) return Date.now()
    return this.newest(this.ring.length - 1).ts
  }

  // Rows logged after from and before to (and at or before until), newest first, up to max_memory_entries of them,
  // read from the segments back from the newest that can hold them: a paged scan, so the cap bounds the rows of the
  // window asked for rather than the newest rows. A row's time is read from its line before the line is parsed, and
  // each segment read whole leaves its oldest and newest times in an index (segIndex, checked against the segment's
  // size), so later scans skip the segments outside their window unread. The answer is cached until the window or the
  // files change (a new row, a segment, a delete or a recost changes their sizes).
  private scanRows(from: f64, to: f64, until?: f64): LogEntry[] {
    this.flush()
    const segs = segmentsIn(this.cfg.dir)
    // rows at until are in the window, and so are rows at to (the oldest row in hand), which the caller leaves out by id
    const hi: f64 = until === undefined ? to : Math.min(to, until + 0.0005)
    const parts: string[] = [`${from}:${hi}`]
    for (const sg of segs) parts.push(`${sg.name}:${sizeOf(join(this.cfg.dir, sg.name))}`)
    const key = parts.join("|")
    if (key === this.olderKey) return this.older
    const out: LogEntry[] = []
    let counted = 0
    for (let i = segs.length - 1; i >= 0 && counted < this.cap; i--) {
      const sg = segs[i]!
      const start: f64 = sg.day * 1.0 * DAY_MS
      if (start >= hi || start + DAY_MS <= from) continue
      const path = join(this.cfg.dir, sg.name)
      const size = sizeOf(path)
      // a segment far over the segment size (written before segments existed) is not read whole on a query either
      if (size > this.fileBytes() * LOAD_SKIP_FACTOR) continue
      const span = this.segIndex.get(sg.name)
      if (span !== undefined && span.size === size && (span.max <= from || span.min > hi)) continue
      let lines: string[] = []
      try {
        lines = readFileSync(path, "utf8").split("\n")
      } catch (err) {
        continue
      }
      let lo: f64 = 1.0e308
      let top: f64 = -1.0e308
      let whole = true
      for (let k = lines.length - 1; k >= 0; k--) {
        const line = lines[k]!
        if (line === "") continue
        const t = lineTs(line)
        if (t === undefined) continue
        if (t < lo) lo = t
        if (t > top) top = t
        if (t <= from || t > hi) continue
        // rows at hi share the oldest row's millisecond in hand: mostly rows in hand, so they do not count to the cap
        if (t < hi && counted >= this.cap) {
          whole = false
          break
        }
        if (t < hi) counted += 1
        // a torn or foreign line is skipped, not fatal
        try {
          out.push(JSON.parse(line) as LogEntry)
        } catch (err) {
          continue
        }
      }
      if (whole && top >= lo) this.segIndex.set(sg.name, { size: size, min: lo, max: top })
    }
    this.older = out
    this.olderKey = key
    return out
  }

  // One row by id, wherever it is: memory (or today's shared rows), then every segment newest first, rows beyond
  // max_memory_entries and earlier days alike. A segment or line that does not hold the id is not parsed.
  findById(id: string): LogEntry | undefined {
    for (const e of this.recent()) {
      if (e.id === id) return e
    }
    this.flush()
    // (the quoted id; the line is parsed to check it is the row's id)
    const needle = JSON.stringify(id)
    const segs = segmentsIn(this.cfg.dir)
    for (let i = segs.length - 1; i >= 0; i--) {
      let text = ""
      try {
        text = readFileSync(join(this.cfg.dir, segs[i]!.name), "utf8")
      } catch (err) {
        continue
      }
      if (!text.includes(needle)) continue
      for (const line of text.split("\n")) {
        if (!line.includes(needle)) continue
        try {
          const e = JSON.parse(line) as LogEntry
          if (e.id === id) return e
        } catch (err) {
          continue
        }
      }
    }
    return undefined
  }

  // Entries newer than ts, oldest first (for log exports).
  since(ts: f64): LogEntry[] {
    const out: LogEntry[] = []
    for (let k = this.ring.length - 1; k >= 0; k--) {
      const e = this.newest(k)
      if (e.ts > ts) out.push(e)
    }
    return out
  }

  // The k-th newest entry in memory (k = 0 is the newest).
  private newest(k: int): LogEntry {
    const n = this.ring.length
    const i = (((this.next - 1 - k) % n) + n) % n
    return this.ring[i]!
  }
}

// ---- analytics: the /api/logs/* histograms, stats and rankings, and /api/mcp-logs/* ----
// Pure functions over the entries of one window. Each view returns the response body as JSON
// text, in Bifrost's field names. Dimensions Raiju does not record (team, customer, user, app)
// are refused by the handlers rather than answered with empty rows.

// The bucket width in seconds for a span, as Bifrost picks it (its log store's DefaultBucketSize).
export function bucketSeconds(spanMs: f64): f64 {
  const day = 86400000.0
  if (spanMs >= 365.0 * day) return 30.0 * 86400.0
  if (spanMs >= 90.0 * day) return 7.0 * 86400.0
  if (spanMs > 31.0 * day) return 3.0 * 86400.0
  if (spanMs >= 7.0 * day) return 86400.0
  if (spanMs >= 3.0 * day) return 8.0 * 3600.0
  if (spanMs >= day) return 3600.0
  if (spanMs >= 7200000.0) return 600.0
  return 60.0
}

// What the analytics endpoints select on: Bifrost's filters for the fields Raiju records. A
// bound at -1 (or an empty list or string) is not applied.
export type Filter = {
  kind: string,
  providers: string[],
  models: string[],
  virtual_keys: string[],
  teams: string[],
  customers: string[],
  businessUnits: string[],
  projects: string[],
  tools: string[],
  servers: string[],
  statuses: string[], // "success", "error" or "cancelled"; any of them when the list is empty
  users: string[],
  sessionId: string,
  userAgents: string[],
  apps: string[],
  objects: string[], // the request type (the entry's op)
  missingCost: bool, // only entries with no cost
  since: f64, // ms, inclusive
  until: f64, // ms, exclusive
  min_latency: f64,
  max_latency: f64,
  min_tokens: f64,
  max_tokens: f64,
  min_cost: f64,
  max_cost: f64,
  text: string,
  request_id: string,
  selectedKeys: string[],
  routingRules: string[],
  routingEngines: string[],
  stopReasons: string[],
  aliases: string[],
  complexityTiers: string[],
  complexityMechanisms: string[],
  minComplexity: f64, // -1 when no bound; the heuristic score must be at least this
  maxComplexity: f64, // -1 when no bound; and at most this
  cacheHitTypes: string[],
  toolCallNames: string[], // the answer called any of these tools
  promptIds: string[],
  promptNames: string[],
  parentId: string, // exact parent_request_id
  correlationId: string, // exact agent_correlation_id
  // agent_names: the sessions of the A2A calls to those agents (agentSessionsOf); absent when the filter is not used
  agentSessions?: string[],
  rootsOnly: bool, // see applyChains
  groupSessions: bool, // see applyChains
}

function listParam(v: string | undefined): string[] {
  const out: string[] = []
  for (const x of (v ?? "").split(",")) {
    if (x !== "") out.push(x)
  }
  return out
}

// The values of a comma list, or of a single value parameter, both (Raiju's singular names and Bifrost's plurals).
function listOr(sp: URLSearchParams, plural: string, single: string): string[] {
  const out = listParam(sp.get(plural) ?? undefined)
  const one = sp.get(single) ?? ""
  if (one !== "" && !out.includes(one)) out.push(one)
  return out
}

function numParam(sp: URLSearchParams, name: string): f64 {
  const v = sp.get(name) ?? ""
  if (v === "") return -1.0
  return parseFloat(v) ?? -1.0
}

// The filter from a query string. since and until are the window (epoch ms), already resolved.
export function filterFrom(sp: URLSearchParams, kind: string, since: f64, until: f64): Filter {
  return {
    kind: kind,
    providers: listOr(sp, "providers", "provider"),
    models: listOr(sp, "models", "model"),
    virtual_keys: listOr(sp, "virtual_key_ids", "virtual_key"),
    teams: listParam(sp.get("team_ids") ?? undefined),
    customers: listParam(sp.get("customer_ids") ?? undefined),
    businessUnits: listParam(sp.get("business_unit_ids") ?? undefined),
    projects: listParam(sp.get("project_ids") ?? undefined),
    tools: listParam(sp.get("tool_names") ?? undefined),
    servers: listParam(sp.get("server_labels") ?? undefined),
    statuses: listParam(sp.get("status") ?? undefined),
    users: listParam(sp.get("user_ids") ?? undefined),
    sessionId: (sp.get("session_id") ?? "").trim(),
    userAgents: listParam(sp.get("user_agents") ?? undefined),
    apps: listParam(sp.get("apps") ?? undefined),
    objects: listParam(sp.get("objects") ?? undefined),
    missingCost: sp.get("missing_cost_only") === "true",
    since: since,
    until: until,
    min_latency: numParam(sp, "min_latency"),
    max_latency: numParam(sp, "max_latency"),
    min_tokens: numParam(sp, "min_tokens"),
    max_tokens: numParam(sp, "max_tokens"),
    min_cost: numParam(sp, "min_cost"),
    max_cost: numParam(sp, "max_cost"),
    text: sp.get("content_search") ?? sp.get("text") ?? "",
    request_id: sp.get("request_id") ?? "",
    selectedKeys: listParam(sp.get("selected_key_ids") ?? undefined),
    routingRules: listParam(sp.get("routing_rule_ids") ?? undefined),
    routingEngines: listParam(sp.get("routing_engine_used") ?? undefined),
    stopReasons: listParam(sp.get("stop_reasons") ?? undefined),
    aliases: listParam(sp.get("aliases") ?? undefined),
    complexityTiers: listParam(sp.get("complexity_tiers") ?? undefined),
    complexityMechanisms: listParam(sp.get("complexity_mechanisms") ?? undefined),
    minComplexity: numParam(sp, "min_complexity_score"),
    maxComplexity: numParam(sp, "max_complexity_score"),
    cacheHitTypes: listParam(sp.get("cache_hit_types") ?? undefined),
    toolCallNames: listParam(sp.get("tool_call_names") ?? undefined),
    promptIds: listParam(sp.get("selected_prompt_ids") ?? undefined),
    promptNames: listParam(sp.get("prompt_names") ?? undefined),
    parentId: (sp.get("parent_request_id") ?? "").trim(),
    correlationId: (sp.get("agent_correlation_id") ?? "").trim(),
    rootsOnly: sp.get("roots_only") === "true",
    groupSessions: sp.get("group_sessions") === "true",
  }
}

// How a request was answered from the local cache: "direct" or "semantic". Entries logged before
// cache_hit_type was recorded and marked as hits were exact-match hits.
export function hitTypeOf(e: LogEntry): string {
  if (e.cache_hit_type !== undefined && e.cache_hit_type !== "") return e.cache_hit_type
  return e.cache_hit ? "direct" : ""
}

// Whether an entry has one of the statuses a filter names: success (2xx), cancelled (499) or error (the rest).
function statusMatches(e: LogEntry, st: string): bool {
  if (st === "success") return isSuccess(e)
  if (st === "cancelled") return e.status === 499
  if (st === "error") return !isSuccess(e) && e.status !== 499
  return false
}

// Whether an answer called any of the named tools.
function calledAny(called: string[] | undefined, want: string[]): bool {
  if (called === undefined) return false
  for (const n of called) {
    if (want.includes(n)) return true
  }
  return false
}

// Whether an entry is in the filter's window and passes its filters.
export function selects(e: LogEntry, f: Filter): bool {
  if (kindOf(e) !== f.kind) return false
  if (e.ts < f.since || e.ts >= f.until) return false
  if (f.providers.length > 0 && !f.providers.includes(e.provider)) return false
  if (f.models.length > 0 && !f.models.includes(e.model)) return false
  if (f.virtual_keys.length > 0 && !f.virtual_keys.includes(e.virtual_key ?? "")) return false
  if (f.teams.length > 0 && !f.teams.includes(e.team_id ?? "")) return false
  if (f.customers.length > 0 && !f.customers.includes(e.customer_id ?? "")) return false
  if (f.businessUnits.length > 0 && !f.businessUnits.includes(e.business_unit_id ?? "")) return false
  if (f.projects.length > 0 && !f.projects.includes(e.project_id ?? "")) return false
  if (f.tools.length > 0 && !f.tools.includes(e.tool ?? "")) return false
  if (f.servers.length > 0 && !f.servers.includes(e.server ?? "")) return false
  if (f.users.length > 0 && !f.users.includes(e.user_id ?? "")) return false
  if (f.sessionId !== "" && e.session_id !== f.sessionId) return false
  if (f.userAgents.length > 0 && !f.userAgents.includes(e.user_agent ?? "")) return false
  if (f.apps.length > 0 && !f.apps.includes(e.app ?? "")) return false
  if (f.objects.length > 0 && !f.objects.includes(e.op)) return false
  if (f.missingCost && e.cost !== 0.0) return false
  if (f.statuses.length > 0 && !f.statuses.some((st) => statusMatches(e, st))) return false
  const tokens = e.prompt_tokens + e.completion_tokens
  if (f.min_latency >= 0.0 && e.latency_ms < f.min_latency) return false
  if (f.max_latency >= 0.0 && e.latency_ms > f.max_latency) return false
  if (f.min_tokens >= 0.0 && tokens < f.min_tokens) return false
  if (f.max_tokens >= 0.0 && tokens > f.max_tokens) return false
  if (f.min_cost >= 0.0 && e.cost < f.min_cost) return false
  if (f.max_cost >= 0.0 && e.cost > f.max_cost) return false
  if (f.request_id !== "" && e.request_id !== f.request_id) return false
  if (f.text !== "" && !mentions(e, f.text)) return false
  if (f.selectedKeys.length > 0 && !f.selectedKeys.includes(e.selected_key_id ?? "")) return false
  if (f.routingRules.length > 0 && !f.routingRules.includes(e.routing_rule_id ?? "")) return false
  if (f.routingEngines.length > 0 && !f.routingEngines.includes(e.routing_engine_used ?? "")) return false
  if (f.stopReasons.length > 0 && !f.stopReasons.includes(e.stop_reason ?? "")) return false
  if (f.aliases.length > 0 && !f.aliases.includes(e.alias ?? "")) return false
  if (f.complexityTiers.length > 0 && !f.complexityTiers.includes(e.complexity_tier ?? "")) return false
  if (f.complexityMechanisms.length > 0 && !f.complexityMechanisms.includes(e.complexity_mechanism ?? "")) return false
  if (f.cacheHitTypes.length > 0 && !f.cacheHitTypes.includes(hitTypeOf(e))) return false
  if (f.toolCallNames.length > 0 && !calledAny(e.tool_call_names, f.toolCallNames)) return false
  if (f.minComplexity >= 0.0 && (e.complexity_score === undefined || e.complexity_score < f.minComplexity)) return false
  if (f.maxComplexity >= 0.0 && (e.complexity_score === undefined || e.complexity_score > f.maxComplexity)) return false
  if (f.promptIds.length > 0 && !f.promptIds.includes(e.selected_prompt_id ?? "")) return false
  if (f.promptNames.length > 0 && !f.promptNames.includes(e.selected_prompt_name ?? "")) return false
  if (f.parentId !== "" && e.parent_request_id !== f.parentId) return false
  if (f.correlationId !== "" && e.agent_correlation_id !== f.correlationId) return false
  const sessions = f.agentSessions
  if (sessions !== undefined && !sessions.includes(e.session_id ?? "")) return false
  return true
}

// The sessions (A2A context ids) of the calls to the named agents within [since, until): the LLM requests
// in those sessions are what the agent_names filter selects (Bifrost's agent context filter).
export function agentSessionsOf(es: LogEntry[], names: string[], since: f64, until: f64): string[] {
  const out: string[] = []
  for (const e of es) {
    const n = e.agent_name ?? ""
    const sid = e.session_id ?? ""
    if (kindOf(e) !== "a2a" || !names.includes(n) || sid === "" || e.ts < since || e.ts >= until) continue
    if (!out.includes(sid)) out.push(sid)
  }
  return out
}

// Chains and sessions (Bifrost's roots_only and group_sessions). roots_only hides a row whose
// parent_request_id names another row of the same selection, so a chain lists as its root. group_sessions,
// with roots_only, keeps one row per session: the session's earliest root. A parent filter ends roots_only,
// as Bifrost's does, and a session or request id filter ends group_sessions.
export function applyChains(es: LogEntry[], f: Filter): LogEntry[] {
  if (!f.rootsOnly || f.parentId !== "") return es
  const ids: Set<string> = new Set()
  for (const e of es) ids.add(e.request_id)
  const roots: LogEntry[] = []
  for (const e of es) {
    const p = e.parent_request_id ?? ""
    if (p !== "" && ids.has(p)) continue
    roots.push(e)
  }
  if (!f.groupSessions || f.sessionId !== "" || f.request_id !== "") return roots
  // the earliest root of each session, by its id and time
  const firstId: Map<string, string> = new Map()
  const firstTs: Map<string, f64> = new Map()
  for (const e of roots) {
    const s = e.session_id ?? ""
    if (s === "") continue
    const ts = firstTs.get(s)
    if (ts === undefined || e.ts < ts) {
      firstTs.set(s, e.ts)
      firstId.set(s, e.id)
    }
  }
  const out: LogEntry[] = []
  for (const e of roots) {
    const s = e.session_id ?? ""
    if (s === "") {
      out.push(e)
      continue
    }
    const keep = firstId.get(s)
    if (keep !== undefined && keep === e.id) out.push(e)
  }
  return out
}

// Whether a data access scope may see an entry: by the team, business unit, customer or project it is attributed to.
// An entry with no owner is seen by all-data scopes only.
export function visibleTo(e: LogEntry, sc: DataScope): bool {
  return inScope(sc, e.team_id ?? "", e.business_unit_id ?? "", e.customer_id ?? "", e.project_id ?? "")
}

// The entries a scope may see, in order.
export function scopedEntries(es: LogEntry[], sc: DataScope): LogEntry[] {
  if (sc.all) return es
  const out: LogEntry[] = []
  for (const e of es) {
    if (visibleTo(e, sc)) out.push(e)
  }
  return out
}

export function selectAll(es: LogEntry[], f: Filter): LogEntry[] {
  const out: LogEntry[] = []
  for (const e of es) {
    if (selects(e, f)) out.push(e)
  }
  return out
}

// The buckets of a window: each starts on a multiple of its width, as Bifrost aligns them.
export type Grid = { first: f64, step: f64, n: int, sizeSec: f64 }

export function gridOf(start: f64, end: f64): Grid {
  const sizeSec = bucketSeconds(end - start)
  const step = sizeSec * 1000.0
  const first = Math.floor(start / step) * step
  const n = Math.ceil((end - first) / step)
  return { first: first, step: step, n: n, sizeSec: sizeSec }
}

// The entries of each bucket, oldest bucket first.
function bucketize(es: LogEntry[], g: Grid): LogEntry[][] {
  const out: LogEntry[][] = []
  for (let i = 0; i < g.n; i++) out.push([])
  for (const e of es) {
    const i = Math.floor((e.ts - g.first) / g.step)
    if (i < 0 || i >= g.n) continue
    out[i]!.push(e)
  }
  return out
}

// The dimensions an entry can be grouped by. Others are not recorded for this gateway.
export function validDimension(dim: string): bool {
  return dim === "provider" || dim === "model" || dim === "virtual_key" || dim === "tool" || dim === "server" || dim === "team" || dim === "customer" || dim === "business_unit" || dim === "project" || dim === "user" || dim === "app" || dim === "user_agent"
}

// The store's name for a dimension Bifrost's histograms name with an id suffix (team_id is team).
export function histogramDimName(dim: string): string {
  if (dim === "team_id") return "team"
  if (dim === "customer_id") return "customer"
  if (dim === "user_id") return "user"
  if (dim === "business_unit_id") return "business_unit"
  if (dim === "project_id") return "project"
  return dim
}

export function dimValue(e: LogEntry, dim: string): string {
  if (dim === "provider") return e.provider
  if (dim === "model") return e.model
  if (dim === "virtual_key") return e.virtual_key ?? ""
  if (dim === "team") return e.team_id ?? ""
  if (dim === "customer") return e.customer_id ?? ""
  if (dim === "business_unit") return e.business_unit_id ?? ""
  if (dim === "project") return e.project_id ?? ""
  if (dim === "tool") return e.tool ?? ""
  if (dim === "server") return e.server ?? ""
  if (dim === "user") return e.user_id ?? ""
  if (dim === "app") return e.app ?? ""
  if (dim === "user_agent") return e.user_agent ?? ""
  return ""
}

// The distinct values of a dimension, ascending.
export function distinctDim(es: LogEntry[], dim: string): string[] {
  const seen: string[] = []
  for (const e of es) {
    const v = dimValue(e, dim)
    if (v !== "" && !seen.includes(v)) seen.push(v)
  }
  seen.sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
  return seen
}

// JSON helpers for the views: every value is already a JSON text.
// A finite number as JSON; NaN and infinities print as 0.
export function jn(v: f64): string {
  return v - v === 0.0 ? JSON.stringify(v) : "0"
}

export function jobj(pairs: string[]): string {
  return "{" + pairs.join(",") + "}"
}

export function jarr(xs: string[]): string {
  return "[" + xs.join(",") + "]"
}

export function jkv(k: string, v: string): string {
  return JSON.stringify(k) + ":" + v
}

export function jstrs(xs: string[]): string {
  const out: string[] = []
  for (const x of xs) out.push(JSON.stringify(x))
  return jarr(out)
}

function tsOf(g: Grid, i: int): string {
  return JSON.stringify(isoMs(g.first + i * g.step))
}

// Nearest-rank percentile of an ascending list.
function percentile(sorted: f64[], p: f64): f64 {
  if (sorted.length === 0) return 0.0
  const i = Math.min(sorted.length - 1, Math.max(0, Math.ceil(p * sorted.length) - 1))
  return sorted[i]!
}

function sortedLatency(es: LogEntry[]): f64[] {
  const xs: f64[] = []
  for (const e of es) xs.push(e.latency_ms)
  xs.sort((a, b) => a - b)
  return xs
}

function latencyFields(es: LogEntry[]): string {
  const xs = sortedLatency(es)
  let sum = 0.0
  for (const x of xs) sum += x
  return jobj([
    jkv("avg_latency", jn(es.length > 0 ? sum / es.length : 0.0)),
    jkv("p90_latency", jn(percentile(xs, 0.9))),
    jkv("p95_latency", jn(percentile(xs, 0.95))),
    jkv("p99_latency", jn(percentile(xs, 0.99))),
    jkv("total_requests", jn(es.length)),
  ])
}

function tokenFields(es: LogEntry[]): string {
  let p = 0
  let c = 0
  for (const e of es) {
    p += e.prompt_tokens
    c += e.completion_tokens
  }
  return jobj([jkv("prompt_tokens", jn(p)), jkv("completion_tokens", jn(c)), jkv("total_tokens", jn(p + c))])
}

function costOf(es: LogEntry[]): f64 {
  let c = 0.0
  for (const e of es) c += e.cost
  return c
}

// Completion tokens over the seconds they took, from the successful entries with a measured latency
// (Bifrost's tokensPerSecond: failed rows spend latency without finishing the answer).
function throughputOf(es: LogEntry[]): f64 {
  let tokens = 0.0
  let ms = 0.0
  for (const e of es) {
    if (!isSuccess(e) || e.latency_ms <= 0.0) continue
    tokens += e.completion_tokens
    ms += e.latency_ms
  }
  return ms > 0.0 ? tokens / (ms / 1000.0) : 0.0
}

function throughputFields(es: LogEntry[]): string {
  let tokens = 0
  let n = 0
  for (const e of es) {
    if (!isSuccess(e) || e.latency_ms <= 0.0) continue
    tokens += e.completion_tokens
    n += 1
  }
  return jobj([jkv("tokens_per_second", jn(throughputOf(es))), jkv("total_completion_tokens", jn(tokens)), jkv("total_requests", jn(n))])
}

// The status counts of a set of entries: success is 2xx, cancelled is 499, error the rest.
type Counts = { total: f64, success: f64, error: f64, cancelled: f64 }

function countsOf(es: LogEntry[]): Counts {
  let ok = 0.0
  let err = 0.0
  let can = 0.0
  for (const e of es) {
    if (e.status === 499) can += 1.0
    else if (isSuccess(e)) ok += 1.0
    else err += 1.0
  }
  return { total: ok + err + can, success: ok, error: err, cancelled: can }
}

function statusFields(es: LogEntry[]): string {
  const c = countsOf(es)
  return jobj([jkv("total", jn(c.total)), jkv("success", jn(c.success)), jkv("error", jn(c.error)), jkv("cancelled", jn(c.cancelled))])
}

// Per-group rows: the group's entries are picked by dim, and each row is rendered by fields.
function groupBy(es: LogEntry[], dim: string): Map<string, LogEntry[]> {
  const m: Map<string, LogEntry[]> = new Map()
  for (const e of es) {
    const v = dimValue(e, dim)
    const cur = m.get(v) ?? []
    cur.push(e)
    m.set(v, cur)
  }
  return m
}

function byGroup(es: LogEntry[], dim: string, render: (group: LogEntry[]) => string): string {
  const groups = groupBy(es, dim)
  const keys = distinctDim(es, dim)
  const parts: string[] = []
  for (const k of keys) parts.push(JSON.stringify(k) + ":" + render(groups.get(k) ?? []))
  return "{" + parts.join(",") + "}"
}

function bucketed(g: Grid, rows: string[]): string {
  return jobj([jkv("buckets", jarr(rows)), jkv("bucket_size_seconds", jn(g.sizeSec))])
}

// GET /api/logs/histogram: request counts by status. success is 2xx, cancelled is 499, error the rest.
export function requestsView(es: LogEntry[], g: Grid): string {
  const groups = bucketize(es, g)
  const rows: string[] = []
  for (let i = 0; i < g.n; i++) {
    const c = countsOf(groups[i]!)
    rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("count", jn(c.total)), jkv("success", jn(c.success)), jkv("error", jn(c.error)), jkv("cancelled", jn(c.cancelled))]))
  }
  return bucketed(g, rows)
}

// GET /api/logs/histogram/tokens
export function tokensView(es: LogEntry[], g: Grid): string {
  const groups = bucketize(es, g)
  const rows: string[] = []
  for (let i = 0; i < g.n; i++) rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("prompt_tokens", jn(sumOf(groups[i]!, "prompt"))), jkv("completion_tokens", jn(sumOf(groups[i]!, "completion"))), jkv("total_tokens", jn(sumOf(groups[i]!, "total")))]))
  return bucketed(g, rows)
}

function sumOf(es: LogEntry[], what: string): f64 {
  let s = 0.0
  for (const e of es) {
    if (what === "prompt") s += e.prompt_tokens
    else if (what === "completion") s += e.completion_tokens
    else if (what === "total") s += e.prompt_tokens + e.completion_tokens
    else s += e.cost
  }
  return s
}

// GET /api/logs/histogram/cost: cost per bucket, with the cost of each model
export function costView(es: LogEntry[], g: Grid): string {
  const groups = bucketize(es, g)
  const rows: string[] = []
  for (let i = 0; i < g.n; i++) {
    rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("total_cost", jn(costOf(groups[i]!))), jkv("by_model", byGroup(groups[i]!, "model", (x) => jn(costOf(x))))]))
  }
  return jobj([jkv("buckets", jarr(rows)), jkv("bucket_size_seconds", jn(g.sizeSec)), jkv("models", jstrs(distinctDim(es, "model")))])
}

// GET /api/logs/histogram/models: status counts per model in each bucket
export function modelsView(es: LogEntry[], g: Grid): string {
  const groups = bucketize(es, g)
  const rows: string[] = []
  for (let i = 0; i < g.n; i++) {
    rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("by_model", byGroup(groups[i]!, "model", (x) => statusFields(x)))]))
  }
  return jobj([jkv("buckets", jarr(rows)), jkv("bucket_size_seconds", jn(g.sizeSec)), jkv("models", jstrs(distinctDim(es, "model")))])
}

// GET /api/logs/histogram/latency: latency percentiles per bucket
export function latencyView(es: LogEntry[], g: Grid): string {
  const groups = bucketize(es, g)
  const rows: string[] = []
  for (let i = 0; i < g.n; i++) rows.push(jobj([jkv("timestamp", tsOf(g, i)), latencyPairs(groups[i]!)]))
  return bucketed(g, rows)
}

// The overall latency histogram's fields: latencyFields, then the gateway overhead (Bifrost's avg_overhead
// and percentiles), spliced into an object that already has a timestamp.
function latencyPairs(es: LogEntry[]): string {
  const t = latencyFields(es)
  return t.slice(1, t.byteLength - 1) + "," + overheadPairs(es)
}

// The overhead of the entries that recorded one; 0 when none did.
function overheadPairs(es: LogEntry[]): string {
  const xs: f64[] = []
  for (const e of es) {
    const o = e.overhead_ms
    if (o !== undefined) xs.push(o)
  }
  xs.sort((a, b) => a - b)
  let sum = 0.0
  for (const x of xs) sum += x
  return [
    jkv("avg_overhead", jn(xs.length > 0 ? sum / xs.length : 0.0)),
    jkv("p90_overhead", jn(percentile(xs, 0.9))),
    jkv("p95_overhead", jn(percentile(xs, 0.95))),
    jkv("p99_overhead", jn(percentile(xs, 0.99))),
  ].join(",")
}

// GET /api/logs/histogram/cost/by-provider, tokens/by-provider, latency/by-provider and
// throughput/by-provider: one value per provider in each bucket.
export function providerView(es: LogEntry[], g: Grid, what: string): string {
  const groups = bucketize(es, g)
  const rows: string[] = []
  for (let i = 0; i < g.n; i++) {
    const b = groups[i]!
    if (what === "cost") rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("total_cost", jn(costOf(b))), jkv("by_provider", byGroup(b, "provider", (x) => jn(costOf(x))))]))
    else if (what === "tokens") rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("by_provider", byGroup(b, "provider", (x) => tokenFields(x)))]))
    else if (what === "latency") rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("by_provider", byGroup(b, "provider", (x) => latencyFields(x)))]))
    else rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("by_provider", byGroup(b, "provider", (x) => throughputFields(x)))]))
  }
  return jobj([jkv("buckets", jarr(rows)), jkv("bucket_size_seconds", jn(g.sizeSec)), jkv("providers", jstrs(distinctDim(es, "provider")))])
}

// GET /api/logs/histogram/throughput: completion tokens per second per bucket
export function throughputView(es: LogEntry[], g: Grid): string {
  const groups = bucketize(es, g)
  const rows: string[] = []
  for (let i = 0; i < g.n; i++) rows.push(jobj([jkv("timestamp", tsOf(g, i)), throughputPairs(groups[i]!)]))
  return bucketed(g, rows)
}

function throughputPairs(es: LogEntry[]): string {
  const t = throughputFields(es)
  return t.slice(1, t.byteLength - 1)
}

// GET /api/logs/histogram/cost|tokens|latency/by-dimension, for a dimension Raiju records.
// echo is the dimension name the caller asked for (Bifrost's team_id for team), when it differs from dim.
export function dimensionView(es: LogEntry[], g: Grid, what: string, dim: string, echo?: string): string {
  const groups = bucketize(es, g)
  const rows: string[] = []
  for (let i = 0; i < g.n; i++) {
    const b = groups[i]!
    if (what === "cost") rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("total_cost", jn(costOf(b))), jkv("by_dimension", byGroup(b, dim, (x) => jn(costOf(x))))]))
    else if (what === "tokens") rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("by_dimension", byGroup(b, dim, (x) => tokenFields(x)))]))
    else rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("by_dimension", byGroup(b, dim, (x) => latencyFields(x)))]))
  }
  return jobj([jkv("buckets", jarr(rows)), jkv("bucket_size_seconds", jn(g.sizeSec)), jkv("dimension", JSON.stringify(echo ?? dim)), jkv("dimension_values", jstrs(distinctDim(es, dim)))])
}

// GET /api/logs/stats: Bifrost's totals (SearchStats fields at the top level), with the older
// Raiju fields kept beside them.
export function statsView(es: LogEntry[]): string {
  let n = 0
  let errors = 0
  let tokens = 0
  let prompt = 0
  let completion = 0
  let cost = 0.0
  let latency = 0.0
  let direct = 0
  let semantic = 0
  for (const e of es) {
    n += 1
    if (!isSuccess(e)) errors += 1
    prompt += e.prompt_tokens
    completion += e.completion_tokens
    tokens += e.prompt_tokens + e.completion_tokens
    cost += e.cost
    latency += e.latency_ms
    const hit = hitTypeOf(e)
    if (hit === "direct") direct += 1
    else if (hit === "semantic") semantic += 1
  }
  const rate = n > 0 ? (100.0 * (n - errors)) / n : 0.0
  const avg = n > 0 ? latency / n : 0.0
  const byModel = byGroup(es, "model", (x) => jobj([jkv("requests", jn(x.length)), jkv("cost", jn(costOf(x)))]))
  return jobj([
    jkv("total_requests", jn(n)),
    jkv("success_rate", jn(rate)),
    jkv("user_facing_success_rate", jn(rate)),
    jkv("user_facing_total_requests", jn(n)),
    jkv("average_latency", jn(avg)),
    jkv("total_tokens", jn(tokens)),
    jkv("prompt_tokens", jn(prompt)),
    jkv("completion_tokens", jn(completion)),
    jkv("total_cost", jn(cost)),
    jkv("cache_hit_rate_total_requests", jn(n)),
    jkv("direct_cache_hits", jn(direct)),
    jkv("semantic_cache_hits", jn(semantic)),
    jkv("requests", jn(n)),
    jkv("errors", jn(errors)),
    jkv("tokens", jn(tokens)),
    jkv("cost", jn(cost)),
    jkv("avg_latency_ms", jn(avg)),
    jkv("by_model", byModel),
  ])
}

// Bifrost's pctChange: the percent change from old to cur, 0 without a base.
function pctChange(old: f64, cur: f64): f64 {
  return old === 0.0 ? 0.0 : ((cur - old) / old) * 100.0
}

// Bifrost's metricTrend: null when a zero base moves to a nonzero value (no percentage change), else pctChange.
function metricTrend(old: f64, cur: f64): string {
  if (old === 0.0 && cur !== 0.0) return "null"
  return jn(pctChange(old, cur))
}

// One ranking row: the group's totals, and its trend against the same group in the previous period.
// head is the row's key pair and extra the pairs that follow it.
function rankRow(head: string, es: LogEntry[], prev: LogEntry[], extra: string): string {
  const c = countsOf(es)
  const req = c.total
  const oldReq = countsOf(prev).total
  const cost = costOf(es)
  const oldCost = costOf(prev)
  const tot = sumOf(es, "total")
  const oldTot = sumOf(prev, "total")
  const avg = es.length > 0 ? sumLatency(es) / es.length : 0.0
  const oldAvg = prev.length > 0 ? sumLatency(prev) / prev.length : 0.0
  const tps = throughputOf(es)
  const oldTps = throughputOf(prev)
  const trend = jobj([
    jkv("has_previous_period", prev.length > 0 ? "true" : "false"),
    jkv("requests_trend", jn(pctChange(oldReq, req))),
    jkv("tokens_trend", metricTrend(oldTot, tot)),
    jkv("cost_trend", metricTrend(oldCost, cost)),
    jkv("latency_trend", jn(oldAvg > 0.0 ? pctChange(oldAvg, avg) : 0.0)),
    jkv("throughput_trend", jn(oldTps > 0.0 ? pctChange(oldTps, tps) : 0.0)),
  ])
  return jobj([head, extra, jkv("total_requests", jn(req)), jkv("success_count", jn(c.success)), jkv("success_rate", jn(req > 0.0 ? (100.0 * c.success) / req : 0.0)), jkv("total_tokens", jn(tot)), jkv("total_cost", jn(cost)), jkv("avg_latency", jn(avg)), jkv("throughput", jn(tps)), jkv("trend", trend)])
}

// The price split of a group: input, output and additional cost (Bifrost's model ranking fields).
function costPairs(es: LogEntry[]): string {
  let i = 0.0
  let o = 0.0
  let a = 0.0
  for (const e of es) {
    i += e.input_cost ?? 0.0
    o += e.output_cost ?? 0.0
    a += e.additional_cost ?? 0.0
  }
  return jkv("input_cost", jn(i)) + "," + jkv("output_cost", jn(o)) + "," + jkv("additional_cost", jn(a))
}

// The largest canonical model name of a group ("" when none is set), as Bifrost's MAX over the rows.
function canonicalOf(es: LogEntry[]): string {
  let out = ""
  for (const e of es) {
    const c = e.canonical_model_name ?? ""
    if (c !== "" && c > out) out = c
  }
  return out
}

// Rankings group by (provider, model), as Bifrost's: the same model served by two providers ranks twice.
function pairKey(e: LogEntry): string {
  return JSON.stringify([e.provider, e.model])
}

function groupByPair(es: LogEntry[]): Map<string, LogEntry[]> {
  const m: Map<string, LogEntry[]> = new Map()
  for (const e of es) {
    const k = pairKey(e)
    const cur = m.get(k) ?? []
    cur.push(e)
    m.set(k, cur)
  }
  return m
}

function sumLatency(es: LogEntry[]): f64 {
  let s = 0.0
  for (const e of es) s += e.latency_ms
  return s
}

// GET /api/logs/rankings: the (provider, model) pairs by request count, each with its trend against prev (the
// same span just before the window). limit caps the rows; 0 means no cap. A row carries its provider, its
// input, output and additional cost, and the alias's canonical model name when one is set.
export function modelRankingsView(es: LogEntry[], prev: LogEntry[], limit: int): string {
  const groups = groupByPair(es)
  const prevGroups = groupByPair(prev)
  const keys: string[] = []
  for (const e of es) {
    const k = pairKey(e)
    if (!keys.includes(k)) keys.push(k)
  }
  const rows: { text: string, n: f64 }[] = []
  for (const k of keys) {
    const es2 = groups.get(k) ?? []
    const first = es2[0]!
    const extra: string[] = [jkv("provider", JSON.stringify(first.provider)), costPairs(es2)]
    const canon = canonicalOf(es2)
    if (canon !== "") extra.push(jkv("canonical_model_name", JSON.stringify(canon)))
    rows.push({ text: rankRow(jkv("model", JSON.stringify(first.model)), es2, prevGroups.get(k) ?? [], extra.join(",")), n: es2.length })
  }
  rows.sort((a, b) => b.n - a.n)
  const out: string[] = []
  for (const r of rows) {
    if (limit > 0 && out.length >= limit) break
    out.push(r.text)
  }
  return jobj([jkv("rankings", jarr(out))])
}

// One model's spend in a budget's cycle, as the quota view's per_model_usage lists it (Bifrost's quotaModelSpend).
export type ModelSpend = { model: string, provider?: string, total_requests: int, total_tokens: int, total_cost: f64, input_cost: f64, output_cost: f64, additional_cost: f64 }

// The LLM requests of a key (by its id), or of a user when user is set, logged from start to now, summed per model and
// provider, most requests first (Bifrost's GetModelRankings over the budget's cycle).
export function perModelUsage(es: LogEntry[], keyId: string, user: string, start: f64, now: f64): ModelSpend[] {
  const picked: LogEntry[] = []
  for (const e of es) {
    if (kindOf(e) !== "llm" || e.ts < start || e.ts > now) continue
    if (user !== "" ? (e.user_id ?? "") !== user : (e.virtual_key ?? "") !== keyId) continue
    picked.push(e)
  }
  const groups = groupByPair(picked)
  const keys: string[] = []
  for (const e of picked) {
    const k = pairKey(e)
    if (!keys.includes(k)) keys.push(k)
  }
  const out: ModelSpend[] = []
  for (const k of keys) {
    const g = groups.get(k) ?? []
    const first = g[0]!
    let tokens = 0
    let cost = 0.0
    let i = 0.0
    let o = 0.0
    let a = 0.0
    for (const e of g) {
      tokens += e.prompt_tokens + e.completion_tokens
      cost += e.cost
      i += e.input_cost ?? 0.0
      o += e.output_cost ?? 0.0
      a += e.additional_cost ?? 0.0
    }
    const row: ModelSpend = { model: first.model, total_requests: g.length, total_tokens: tokens, total_cost: cost, input_cost: i, output_cost: o, additional_cost: a }
    if (first.provider !== "") row.provider = first.provider
    out.push(row)
  }
  out.sort((x, y) => y.total_requests - x.total_requests)
  return out
}

// GET /api/logs/rankings/by-dimension: the same rows, grouped by a dimension.
export function dimensionRankingsView(es: LogEntry[], prev: LogEntry[], dim: string, limit: int): string {
  const groups = groupBy(es, dim)
  const prevGroups = groupBy(prev, dim)
  const rows: { text: string, n: f64 }[] = []
  let attributed = 0
  for (const k of distinctDim(es, dim)) {
    const es2 = groups.get(k) ?? []
    attributed += es2.length
    rows.push({ text: rankRow(jkv("id", JSON.stringify(k)), es2, prevGroups.get(k) ?? [], jkv("name", JSON.stringify(k))), n: es2.length })
  }
  rows.sort((a, b) => b.n - a.n)
  const out: string[] = []
  for (const r of rows) {
    if (limit > 0 && out.length >= limit) break
    out.push(r.text)
  }
  return jobj([jkv("rankings", jarr(out)), jkv("dimension", JSON.stringify(dim)), jkv("total_actual_requests", jn(es.length)), jkv("total_attributed_requests", jn(attributed))])
}

// ---- MCP tool executions ----

// One MCP execution as the log list shows it.
export function mcpLogJson(e: LogEntry): string {
  return jobj([
    jkv("id", JSON.stringify(e.id)),
    jkv("timestamp", JSON.stringify(isoMs(e.ts))),
    jkv("created_at", JSON.stringify(isoMs(e.ts))),
    jkv("tool_name", JSON.stringify(e.tool ?? "")),
    jkv("server_label", JSON.stringify(e.server ?? "")),
    jkv("virtual_key_id", JSON.stringify(e.virtual_key ?? "")),
    jkv("latency", jn(e.latency_ms)),
    jkv("cost", jn(e.cost)),
    jkv("status", JSON.stringify(isSuccess(e) ? "success" : "error")),
    jkv("error_details", e.error === undefined ? "null" : jobj([jkv("message", JSON.stringify(e.error))])),
    jkv("llm_request_id", JSON.stringify(e.request_id)),
  ])
}

// One A2A call (kind "a2a") as the agent history lists it.
export function a2aLogJson(e: LogEntry): string {
  const parts: string[] = [
    jkv("id", JSON.stringify(e.id)),
    jkv("timestamp", JSON.stringify(isoMs(e.ts))),
    jkv("agent_name", JSON.stringify(e.agent_name ?? "")),
    jkv("method", JSON.stringify(e.op)),
    // Bifrost's names for the row: the operation, its kind, the request it belongs to, the task and the two bindings
    jkv("operation", JSON.stringify(e.op)),
    jkv("record_kind", JSON.stringify(e.record_kind ?? "request")),
    jkv("request_id", JSON.stringify(e.request_id === "" ? e.id : e.request_id)),
  ]
  const opt = (k: string, v: string | undefined): void => {
    if (v !== undefined && v !== "") parts.push(jkv(k, JSON.stringify(v)))
  }
  if (e.record_kind === "event") {
    parts.push(jkv("event_sequence", jn(e.event_sequence ?? 0)))
    opt("event_type", e.event_type)
    opt("task_state", e.task_state)
    opt("message_id", e.message_id)
    opt("artifact_id", e.artifact_id)
    opt("content_type", e.content_type)
  }
  parts.push(jkv("task_id", JSON.stringify(e.task_id ?? "")))
  parts.push(jkv("downstream_transport", JSON.stringify(e.downstream_transport ?? "")))
  parts.push(jkv("upstream_transport", JSON.stringify(e.upstream_transport ?? "")))
  parts.push(jkv("context_id", JSON.stringify(e.session_id ?? "")))
  parts.push(jkv("virtual_key_id", JSON.stringify(e.virtual_key ?? "")))
  // the governance attribution, as Bifrost's AgentLogSummary carries it when set
  opt("user_id", e.user_id)
  opt("team_id", e.team_id)
  opt("customer_id", e.customer_id)
  opt("business_unit_id", e.business_unit_id)
  opt("project_id", e.project_id)
  parts.push(jkv("latency", jn(e.latency_ms)))
  parts.push(jkv("status", JSON.stringify(isSuccess(e) ? "success" : "error")))
  parts.push(jkv("status_code", jn(e.status)))
  parts.push(jkv("error_details", e.error === undefined ? "null" : jobj([jkv("message", JSON.stringify(e.error))])))
  return jobj(parts)
}

// GET /api/mcp-logs/stats
export function mcpStatsView(es: LogEntry[]): string {
  let ok = 0
  let latency = 0.0
  let cost = 0.0
  for (const e of es) {
    if (isSuccess(e)) ok += 1
    latency += e.latency_ms
    cost += e.cost
  }
  const n = es.length
  return jobj([jkv("total_executions", jn(n)), jkv("success_rate", jn(n > 0 ? (100.0 * ok) / n : 0.0)), jkv("average_latency", jn(n > 0 ? latency / n : 0.0)), jkv("total_cost", jn(cost))])
}

// GET /api/mcp-logs/histogram/cost
export function mcpCostView(es: LogEntry[], g: Grid): string {
  const groups = bucketize(es, g)
  const rows: string[] = []
  for (let i = 0; i < g.n; i++) rows.push(jobj([jkv("timestamp", tsOf(g, i)), jkv("total_cost", jn(costOf(groups[i]!)))]))
  return bucketed(g, rows)
}

// GET /api/mcp-logs/histogram/top-tools: the tools by call count, most used first.
export function topToolsView(es: LogEntry[], limit: int): string {
  const groups = groupBy(es, "tool")
  const rows: { name: string, n: f64, text: string }[] = []
  for (const k of distinctDim(es, "tool")) {
    const xs = groups.get(k) ?? []
    rows.push({ name: k, n: xs.length, text: jobj([jkv("tool_name", JSON.stringify(k)), jkv("count", jn(xs.length)), jkv("cost", jn(costOf(xs)))]) })
  }
  rows.sort((a, b) => b.n - a.n)
  const out: string[] = []
  for (const r of rows) {
    if (limit > 0 && out.length >= limit) break
    out.push(r.text)
  }
  return jobj([jkv("tools", jarr(out))])
}

// ---- the store's own queries over these views ----

// The distinct values the filter menus offer, from the entries of a window.
export function filterMenus(es: LogEntry[]): string {
  return jobj([
    jkv("models", jstrs(distinctDim(es, "model"))),
    jkv("providers", jstrs(distinctDim(es, "provider"))),
    jkv("tool_names", jstrs(distinctDim(es, "tool"))),
    jkv("server_labels", jstrs(distinctDim(es, "server"))),
  ])
}

// The (kind, window) text search the MCP list needs: newest first, paged.
export function pageOf(es: LogEntry[], limit: int, offset: int): { page: LogEntry[], total: int } {
  const page: LogEntry[] = []
  for (let i = offset; i < es.length && page.length < limit; i++) page.push(es[i]!)
  return { page: page, total: es.length }
}

// Reads the query string of GET /api/logs. Empty or malformed values are
// ignored; limit and offset are clamped when the query runs.
export function parseQuery(params: URLSearchParams): LogQuery {
  const q: LogQuery = {}
  const provider = params.get("provider")
  if (provider !== undefined && provider !== "") q.provider = provider
  const model = params.get("model")
  if (model !== undefined && model !== "") q.model = model
  const status = params.get("status")
  if (status === "success") q.status = "success"
  if (status === "error") q.status = "error"
  const vk = params.get("virtual_key")
  if (vk !== undefined && vk !== "") q.virtual_key = vk
  const since = params.get("since")
  if (since !== undefined) q.since = Number(since)
  const until = params.get("until")
  if (until !== undefined) q.until = Number(until)
  const text = params.get("text")
  if (text !== undefined && text !== "") q.text = text
  const limit = params.get("limit")
  if (limit !== undefined) q.limit = parseInt(limit)
  const offset = params.get("offset")
  if (offset !== undefined) q.offset = parseInt(offset)
  return q
}

test("UTC day of a timestamp, across leap years and month ends", () => {
  expect(dayOf(0)).toBe("1970-01-01")
  expect(dayOf(-86400000)).toBe("1969-12-31")
  expect(dayOf(951782400000)).toBe("2000-02-29")
  expect(dayOf(1709164800000)).toBe("2024-02-29")
  expect(dayOf(1709164800000 - 1)).toBe("2024-02-28")
  expect(dayOf(1709208000000)).toBe("2024-02-29")
  expect(dayOf(1769817600000)).toBe("2026-01-31")
  expect(dayOf(1772323200000 - 1)).toBe("2026-02-28")
  expect(dayOf(1772323200000)).toBe("2026-03-01")
  expect(dayOf(1791936000000)).toBe("2026-10-14")
  expect(fileName(1791979200000)).toBe("requests-2026-10-14.jsonl")
})

test("day files parse back to their day, and reject impossible dates", () => {
  expect(fileDay("requests-2026-10-14.jsonl")).toBe(Math.floor(1791936000000 / DAY_MS))
  expect(fileDay("requests-2024-02-29.jsonl")).toBe(Math.floor(1709164800000 / DAY_MS))
  expect(fileDay("requests-2026-02-29.jsonl")).toBeUndefined()
  expect(fileDay("requests-2026-13-01.jsonl")).toBeUndefined()
  expect(fileDay("notes.txt")).toBeUndefined()
  expect(fileDay("requests-2026-10-14.jsonl.bak")).toBeUndefined()
})

function tmpDir(): string {
  // the clock as well as the random number: a directory left by an earlier run must not be reused
  return "/tmp/raiju-logstore-test-" + Date.now() + "-" + Math.floor(Math.random() * 1000000000)
}

type Over = { provider?: string, virtual_key?: string, error?: string, input?: string, output?: string, cost?: f64, latency_ms?: f64, prompt_tokens?: int, completion_tokens?: int }

function sample(id: string, ts: f64, model: string, status: int, o: Over): LogEntry {
  return {
    id: id,
    ts: ts,
    request_id: "req-" + id,
    op: "chat",
    provider: o.provider ?? "openai",
    model: model,
    status: status,
    latency_ms: o.latency_ms ?? 10.0,
    prompt_tokens: o.prompt_tokens ?? 3,
    completion_tokens: o.completion_tokens ?? 4,
    cost: o.cost ?? 0.5,
    cache_hit: false,
    virtual_key: o.virtual_key,
    error: o.error,
    input: o.input,
    output: o.output,
  }
}

test("add and query: filters, newest first, limit and offset", () => {
  const dir = tmpDir()
  try {
    const s = try new LogStore(defaultLogStoreConfig(dir))
    s.add(sample("a", 1000.0, "gpt-4o", 200, {}))
    s.add(sample("b", 2000.0, "claude", 500, { provider: "anthropic", virtual_key: "vk1", error: "upstream down" }))
    s.add(sample("c", 3000.0, "gpt-4o", 200, { virtual_key: "vk1" }))
    s.add(sample("d", 4000.0, "gpt-4o-mini", 429, {}))

    const all = s.query({})
    expect(all.total).toBe(4)
    expect(all.entries.map((e) => e.id).join(",")).toBe("d,c,b,a")

    expect(s.query({ provider: "anthropic" }).total).toBe(1)
    expect(s.query({ model: "gpt-4o" }).total).toBe(2)
    expect(s.query({ status: "error" }).total).toBe(2)
    expect(s.query({ status: "success" }).total).toBe(2)
    expect(s.query({ virtual_key: "vk1" }).total).toBe(2)
    expect(s.query({ since: 2000.0, until: 3000.0 }).total).toBe(2)
    expect(s.query({ text: "req-c" }).total).toBe(1)
    expect(s.query({ text: "mini" }).total).toBe(1)
    expect(s.query({ text: "upstream" }).total).toBe(1)
    expect(s.query({ text: "nothing-matches" }).total).toBe(0)

    const page = s.query({ limit: 2, offset: 1 })
    expect(page.total).toBe(4)
    expect(page.entries.map((e) => e.id).join(",")).toBe("c,b")
    expect(s.query({ limit: 0 }).total).toBe(4)
    expect(s.query({ limit: 0 }).entries.length).toBe(0)
    expect(s.query({ offset: 10 }).entries.length).toBe(0)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("the ring keeps only the newest max_memory_entries", () => {
  const dir = tmpDir()
  try {
    const cfg = defaultLogStoreConfig(dir)
    cfg.max_memory_entries = 3
    const s = try new LogStore(cfg)
    for (let i = 1; i <= 5; i++) s.add(sample("e" + i, i * 1000.0, "m", 200, {}))
    const r = s.query({})
    expect(r.total).toBe(3)
    expect(r.entries.map((e) => e.id).join(",")).toBe("e5,e4,e3")
    // the file keeps every entry; memory holds only the newest window
    s.flush()
    const lines = try readFileSync(join(dir, fileName(1000.0)), "utf8").split("\n").filter((l) => l !== "")
    expect(lines.length).toBe(5)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("content is dropped when logging is off and cut on a UTF-8 boundary when on", () => {
  const dir = tmpDir()
  try {
    const off = try new LogStore(defaultLogStoreConfig(dir))
    off.add(sample("x", 1.0, "m", 200, { input: "secret prompt", output: "secret answer" }))
    const got = off.query({}).entries[0]!
    expect(got.input).toBeUndefined()
    expect(got.output).toBeUndefined()
    off.flush()
    expect(try readFileSync(join(dir, fileName(1.0)), "utf8").includes("secret")).toBe(false)

    const onCfg = defaultLogStoreConfig(dir + "-on")
    onCfg.content_logging = true
    onCfg.max_content_bytes = 4
    const on = try new LogStore(onCfg)
    // "aé日" is 1 + 2 + 3 bytes; byte 4 falls inside 日
    on.add(sample("y", 1.0, "m", 200, { input: "aé日", output: "short" }))
    const kept = on.query({}).entries[0]!
    expect(kept.input).toBe("aé")
    expect(kept.output).toBe("shor")
    on.add(sample("z", 2.0, "m", 200, { input: "aé日", output: "x" }))
    const cut = on.query({ text: "req-z" }).entries[0]!
    expect(cut.input).toBe("aé")
    try rmSync(dir + "-on", { recursive: true, force: true })
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("a cut inside the first byte of a character backs up to its start", () => {
  expect(clip("日本", 1)).toBe("")
  expect(clip("日本", 3)).toBe("日")
  expect(clip("日本", 6)).toBe("日本")
  expect(clip("ab", 5)).toBe("ab")
  expect(clip(undefined, 5)).toBeUndefined()
})

test("persistence: a new store on the same dir sees today's entries", () => {
  const dir = tmpDir()
  try {
    const a = try new LogStore(defaultLogStoreConfig(dir))
    a.add(sample("p1", Date.now(), "m", 200, {}))
    a.add(sample("p2", Date.now(), "m", 500, {}))
    a.flush()
    const b = try new LogStore(defaultLogStoreConfig(dir))
    const r = b.query({})
    expect(r.total).toBe(2)
    expect(r.entries[0]!.id).toBe("p2")
    expect(r.entries[1]!.status).toBe(200)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("prune deletes day files past retention and keeps recent ones", () => {
  const dir = tmpDir()
  try {
    const s = try new LogStore(defaultLogStoreConfig(dir))
    try writeFileSync(join(dir, "requests-2026-09-01.jsonl"), "{}\n")
    try writeFileSync(join(dir, "requests-2026-10-06.jsonl"), "{}\n")
    try writeFileSync(join(dir, "requests-2026-10-07.jsonl"), "{}\n")
    try writeFileSync(join(dir, "requests-2026-10-14.jsonl"), "{}\n")
    try writeFileSync(join(dir, "other.txt"), "keep\n")
    // 2026-10-14 noon, retention 7 days: 2026-10-07 is exactly 7 days back and stays
    const removed = try s.prune(1791979200000)
    expect(removed).toBe(2)
    expect(existsSync(join(dir, "requests-2026-09-01.jsonl"))).toBe(false)
    expect(existsSync(join(dir, "requests-2026-10-06.jsonl"))).toBe(false)
    expect(existsSync(join(dir, "requests-2026-10-07.jsonl"))).toBe(true)
    expect(existsSync(join(dir, "requests-2026-10-14.jsonl"))).toBe(true)
    expect(existsSync(join(dir, "other.txt"))).toBe(true)
    expect(try s.prune(1791979200000)).toBe(0)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("segment names parse back to their day and number", () => {
  expect(segmentOf("requests-2026-10-14.jsonl")!.seg).toBe(0)
  expect(segmentOf("requests-2026-10-14.3.jsonl")!.seg).toBe(3)
  expect(segmentOf("requests-2026-10-14.12.jsonl")!.day).toBe(Math.floor(1791936000000 / DAY_MS))
  expect(segmentOf("requests-2026-10-14.0.jsonl")).toBeUndefined()
  expect(segmentOf("requests-2026-10-14.01.jsonl")).toBeUndefined()
  expect(segmentOf("requests-2026-10-14.x.jsonl")).toBeUndefined()
  expect(segmentOf("requests-2026-02-30.1.jsonl")).toBeUndefined()
  expect(segmentOf("requests-2026-10-14.1.jsonl.bak")).toBeUndefined()
  expect(segmentName("2026-10-14", 0)).toBe("requests-2026-10-14.jsonl")
  expect(segmentName("2026-10-14", 2)).toBe("requests-2026-10-14.2.jsonl")
})

test("rows are written in batches: on flush, or at once when a batch is full", () => {
  const dir = tmpDir()
  try {
    const s = try new LogStore(defaultLogStoreConfig(dir))
    const now = Date.now()
    for (let i = 0; i < 3; i++) s.add(sample("b" + i, now, "m", 200, {}))
    // kept in memory at once, on disk at the next flush
    expect(s.query({}).total).toBe(3)
    expect(s.pendingRows()).toBe(3)
    expect(existsSync(join(dir, fileName(now)))).toBe(false)
    s.flush()
    expect(s.pendingRows()).toBe(0)
    expect(try readFileSync(join(dir, fileName(now)), "utf8").split("\n").filter((l) => l !== "").length).toBe(3)
    // a row that fills the batch is written with it, without waiting for the timer
    s.add(sample("big", now, "m", 500, { error: "e".repeat(70000) }))
    expect(s.pendingRows()).toBe(0)
    expect(try readFileSync(join(dir, fileName(now)), "utf8").includes("\"big\"")).toBe(true)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("a day goes on in a new segment once its file reaches max_file_mb, and pruning takes every segment", () => {
  const dir = tmpDir()
  try {
    const cfg = defaultLogStoreConfig(dir)
    cfg.max_file_mb = 1
    try mkdirSync(dir, { recursive: true })
    const now = Date.now()
    const day = dayOf(now)
    try writeFileSync(join(dir, segmentName(day, 0)), "x".repeat(1048576) + "\n")
    const s = try new LogStore(cfg)
    s.add(sample("s1", now, "m", 200, {}))
    s.flush()
    expect(try readFileSync(join(dir, segmentName(day, 1)), "utf8").includes("\"s1\"")).toBe(true)
    // another process on the same folder agrees on the segment
    const t = try new LogStore(cfg)
    t.add(sample("s2", now, "m", 200, {}))
    t.flush()
    expect(try readFileSync(join(dir, segmentName(day, 1)), "utf8").includes("\"s2\"")).toBe(true)
    // the old day's segments all go with retention
    try writeFileSync(join(dir, "requests-2026-09-01.jsonl"), "{}\n")
    try writeFileSync(join(dir, "requests-2026-09-01.1.jsonl"), "{}\n")
    try writeFileSync(join(dir, "requests-2026-09-01.2.jsonl"), "{}\n")
    expect(try s.prune(now)).toBe(3)
    expect(existsSync(join(dir, segmentName(day, 1)))).toBe(true)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("start-up reads only the newest segments of today, and skips one far over the segment size", () => {
  const dir = tmpDir()
  try {
    try mkdirSync(dir, { recursive: true })
    const now = Date.now()
    const day = dayOf(now)
    const row = (id: string): string => JSON.stringify(sample(id, now, "m", 200, {})) + "\n"
    // a day file from before segments, five times the segment size
    try writeFileSync(join(dir, segmentName(day, 0)), row("old") + "x".repeat(5 * 1048576) + "\n")
    try writeFileSync(join(dir, segmentName(day, 1)), row("a") + row("b"))
    try writeFileSync(join(dir, segmentName(day, 2)), row("c") + row("d"))
    const cfg = defaultLogStoreConfig(dir)
    cfg.max_file_mb = 1
    cfg.max_memory_entries = 3
    const s = try new LogStore(cfg)
    expect(s.query({}).entries.map((e) => e.id).join(",")).toBe("d,c,b")
    cfg.max_memory_entries = 10
    const all = try new LogStore(cfg)
    // the oversized segment is not read (its rows stay on disk)
    expect(all.query({}).entries.map((e) => e.id).join(",")).toBe("d,c,b,a")
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("reads of a window before today's rows take the earlier days from the files, after a restart too", () => {
  const dir = tmpDir()
  try {
    try mkdirSync(dir, { recursive: true })
    const now = Date.now()
    const row = (id: string, ts: f64): string => JSON.stringify(sample(id, ts, "m", 200, {})) + "\n"
    const y1 = now - 86400000.0
    const y2 = now - 2.0 * 86400000.0
    try writeFileSync(join(dir, segmentName(dayOf(y2), 0)), row("two-days", y2))
    try writeFileSync(join(dir, segmentName(dayOf(y1), 0)), row("yesterday-a", y1 - 1000.0) + row("yesterday-b", y1))
    try writeFileSync(join(dir, segmentName(dayOf(now), 0)), row("today", now - 10.0))
    const s = try new LogStore(defaultLogStoreConfig(dir))
    // memory holds today's rows only; a window over the last three days reads the rest from the files, oldest first
    expect(s.viewSince(now - 3.0 * 86400000.0).map((e) => e.id).join(",")).toBe("two-days,yesterday-a,yesterday-b,today")
    expect(s.viewSince(y1 - 500.0).map((e) => e.id).join(",")).toBe("yesterday-b,today")
    // a window inside today reads nothing from the files
    expect(s.viewSince(now - 100.0).map((e) => e.id).join(",")).toBe("today")
    // workers that share the files read the earlier days the same way
    const w = try new LogStore(defaultLogStoreConfig(dir))
    w.shared = true
    expect(w.viewSince(0.0).map((e) => e.id).join(",")).toBe("two-days,yesterday-a,yesterday-b,today")
    // a delete reaches the earlier days' rows (the cache follows the files)
    expect(s.delete(["yesterday-a"])).toBe(1)
    expect(s.viewSince(0.0).map((e) => e.id).join(",")).toBe("two-days,yesterday-b,today")
    // no rows in memory at all: every day comes from the files
    try rmSync(join(dir, segmentName(dayOf(now), 0)), { force: true })
    const fresh = try new LogStore(defaultLogStoreConfig(dir))
    expect(fresh.viewSince(0.0).map((e) => e.id).join(",")).toBe("two-days,yesterday-b")
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("rows beyond max_memory_entries: a row logged in the same millisecond as the oldest row in memory is read once", () => {
  const dir = tmpDir()
  try {
    try mkdirSync(dir, { recursive: true })
    const now = Date.now()
    const t0 = Math.max(Math.floor(now / 86400000.0) * 86400000.0, now - 60000.0)
    const row = (id: string, ts: f64): string => JSON.stringify(sample(id, ts, "m", 200, {})) + "\n"
    // five rows; the second and the third share a millisecond, and memory (three) holds the third to the fifth
    const ts: f64[] = [t0, t0 + 2.0, t0 + 2.0, t0 + 3.0, t0 + 4.0]
    let text = ""
    for (let i = 0; i < 5; i++) text += row("s" + i, ts[i]!)
    try writeFileSync(join(dir, segmentName(dayOf(now), 0)), text)
    const cfg = defaultLogStoreConfig(dir)
    cfg.max_memory_entries = 3
    const s = try new LogStore(cfg)
    expect(s.viewSince(t0 - 1.0).map((e) => e.id).join(",")).toBe("s0,s1,s2,s3,s4")
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("rows beyond max_memory_entries: today's older rows and a window far back are read from the files", () => {
  const dir = tmpDir()
  try {
    try mkdirSync(dir, { recursive: true })
    const now = Date.now()
    const dayStart = Math.floor(now / 86400000.0) * 86400000.0
    const row = (id: string, ts: f64): string => JSON.stringify(sample(id, ts, "m", 200, {})) + "\n"
    // three days back: ten rows an hour apart; today: six rows, a second apart, ending a minute ago
    const back = dayStart - 2.0 * 86400000.0
    let old = ""
    for (let i = 0; i < 10; i++) old += row("old" + i, back + i * 3600000.0)
    try writeFileSync(join(dir, segmentName(dayOf(back), 0)), old)
    let today = ""
    const t0 = Math.max(dayStart, now - 60000.0 - 6000.0)
    for (let i = 0; i < 6; i++) today += row("t" + i, t0 + i * 1000.0)
    try writeFileSync(join(dir, segmentName(dayOf(now), 0)), today)
    const cfg = defaultLogStoreConfig(dir)
    cfg.max_memory_entries = 3
    const s = try new LogStore(cfg)
    // memory holds the newest three; a window over today reads today's older rows from the file
    expect(s.query({}).entries.map((e) => e.id).join(",")).toBe("t5,t4,t3")
    expect(s.viewSince(t0 - 1.0).map((e) => e.id).join(",")).toBe("t0,t1,t2,t3,t4,t5")
    // a narrow window three days back gets its rows, though more than max_memory_entries rows are newer
    expect(s.viewSince(back + 2.5 * 3600000.0, back + 5.0 * 3600000.0).map((e) => e.id).join(",")).toBe("old3,old4,old5")
    // a wide window takes the newest max_memory_entries rows before memory
    expect(s.viewSince(0.0).map((e) => e.id).join(",")).toBe("t0,t1,t2,t3,t4,t5")
    // the index skips segments outside a window: the old day is not read again for a window inside today
    expect(s.viewSince(t0 + 500.0).map((e) => e.id).join(",")).toBe("t1,t2,t3,t4,t5")
    // one row by id, wherever it is
    expect(s.findById("old1")!.ts).toBe(back + 3600000.0)
    expect(s.findById("t0")!.id).toBe("t0")
    expect(s.findById("t5")!.id).toBe("t5")
    expect(s.findById("nope")).toBe(undefined)
    // shared workers read today's rows beyond the cap the same way
    const w = try new LogStore(cfg)
    w.shared = true
    expect(w.viewSince(t0 - 1.0).map((e) => e.id).join(",")).toBe("t0,t1,t2,t3,t4,t5")
    expect(lineTs(`{"id":"x","ts":1791979200000.5,"op":"chat"}`)).toBe(1791979200000.5)
    expect(lineTs(`{"id":"x"}`)).toBe(undefined)
    expect(lineTs(`{"id": "x", "ts": 1500.0, "op": "chat"}`)).toBe(1500.0)
    expect(lineTs(`{"id":"ts","ts":42,"op":"chat"}`)).toBe(42.0)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("rows from other nodes merge in time order, once each, and travel without their bodies when lite", () => {
  const a = sample("a", 1000.0, "m", 200, {})
  const c = sample("c", 3000.0, "m", 200, {})
  const b = sample("b", 2000.0, "m", 200, { input: "secret prompt", output: "answer" })
  const d = sample("d", 500.0, "m", 200, {})
  expect(mergeRows([a, c], [b, d, a]).map((e) => e.id).join(",")).toBe("d,a,b,c")
  expect(mergeRows([a, c], []).map((e) => e.id).join(",")).toBe("a,c")
  expect(mergeRows([], [c, b]).map((e) => e.id).join(",")).toBe("b,c")
  const m: LogEntry = { id: b.id, ts: b.ts, request_id: b.request_id, op: b.op, provider: b.provider, model: b.model, status: b.status, latency_ms: 1.0, prompt_tokens: 1, completion_tokens: 1, cost: 0.0, cache_hit: false, input: "secret prompt", redaction_mapping: "sealed", raw_request: "{}" }
  const l = liteEntry(m)
  expect(l.input).toBe(undefined)
  expect(l.output).toBe(undefined)
  expect(l.raw_request).toBe(undefined)
  expect(l.redaction_mapping).toBe(undefined)
  expect(l.model).toBe("m")
  expect(b.input).toBe("secret prompt")
})

test("shared stores write each row at once and answer with each other's rows", () => {
  const dir = tmpDir()
  try {
    const a = try new LogStore(defaultLogStoreConfig(dir))
    const b = try new LogStore(defaultLogStoreConfig(dir))
    a.shared = true
    b.shared = true
    const now = Date.now()
    a.add(sample("w1", now, "m", 200, {}))
    b.add(sample("w2", now, "m", 200, {}))
    // a shared store writes each row at once: the other sees it on its next query
    expect(b.pendingRows()).toBe(0)
    expect(a.query({}).entries.map((e) => e.id).join(",")).toBe("w2,w1")
    expect(b.query({}).total).toBe(2)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("max_disk_mb deletes the oldest segments first and never the newest", () => {
  const dir = tmpDir()
  try {
    try mkdirSync(dir, { recursive: true })
    const big = "x".repeat(600 * 1024) + "\n"
    try writeFileSync(join(dir, "requests-2026-09-01.jsonl"), big)
    try writeFileSync(join(dir, "requests-2026-09-02.jsonl"), big)
    try writeFileSync(join(dir, "requests-2026-09-02.1.jsonl"), big)
    const cfg = defaultLogStoreConfig(dir)
    cfg.max_disk_mb = 1
    const s = try new LogStore(cfg)
    // 1.8 MB over a 1 MB cap: the two oldest go
    expect(s.capped).toBe(2)
    expect(existsSync(join(dir, "requests-2026-09-01.jsonl"))).toBe(false)
    expect(existsSync(join(dir, "requests-2026-09-02.jsonl"))).toBe(false)
    expect(existsSync(join(dir, "requests-2026-09-02.1.jsonl"))).toBe(true)
    // a single file over the cap is the one being written: it stays
    const one = defaultLogStoreConfig(dir)
    one.max_disk_mb = 1
    try writeFileSync(join(dir, "requests-2026-09-02.1.jsonl"), big + big)
    expect((try new LogStore(one)).capped).toBe(0)
    // no cap by default
    try writeFileSync(join(dir, "requests-2026-09-01.jsonl"), big)
    expect((try new LogStore(defaultLogStoreConfig(dir))).capped).toBe(0)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("a failed write counts the rows it dropped", () => {
  const dir = tmpDir()
  try {
    const s = try new LogStore(defaultLogStoreConfig(dir))
    // the folder is replaced by a file: appends fail
    try rmSync(dir, { recursive: true, force: true })
    try writeFileSync(dir, "not a folder")
    s.add(sample("f1", Date.now(), "m", 200, {}))
    s.add(sample("f2", Date.now(), "m", 200, {}))
    s.flush()
    expect(s.dropped).toBe(2)
    expect(s.query({}).total).toBe(2)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("stats: totals, error count, average latency and per-model breakdown", () => {
  const dir = tmpDir()
  try {
    const s = try new LogStore(defaultLogStoreConfig(dir))
    s.add(sample("s1", 100.0, "A", 200, { prompt_tokens: 10, completion_tokens: 5, cost: 0.5, latency_ms: 100.0 }))
    s.add(sample("s2", 200.0, "A", 200, { prompt_tokens: 20, completion_tokens: 10, cost: 1.0, latency_ms: 200.0 }))
    s.add(sample("s3", 300.0, "B", 500, { prompt_tokens: 1, completion_tokens: 2, cost: 0.25, latency_ms: 300.0 }))

    const all = s.stats(0.0)
    expect(all.requests).toBe(3)
    expect(all.errors).toBe(1)
    expect(all.tokens).toBe(48)
    expect(all.cost).toBe(1.75)
    expect(all.avg_latency_ms).toBe(200.0)
    expect(all.by_model.length).toBe(2)
    expect(all.by_model[0]!.model).toBe("A")
    expect(all.by_model[0]!.requests).toBe(2)
    expect(all.by_model[0]!.cost).toBe(1.5)
    expect(all.by_model[1]!.model).toBe("B")
    expect(all.by_model[1]!.cost).toBe(0.25)

    const recent = s.stats(150.0)
    expect(recent.requests).toBe(2)
    expect(recent.errors).toBe(1)
    expect(recent.avg_latency_ms).toBe(250.0)

    const none = s.stats(1000.0)
    expect(none.requests).toBe(0)
    expect(none.avg_latency_ms).toBe(0.0)
    expect(none.by_model.length).toBe(0)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("parseQuery reads the HTTP query string and ignores bad values", () => {
  const q = parseQuery(new URLSearchParams("provider=openai&status=error&limit=20&offset=5&virtual_key=vk1&since=100&until=900&text=gpt"))
  expect(q.provider).toBe("openai")
  expect(q.status).toBe("error")
  expect(q.limit).toBe(20)
  expect(q.offset).toBe(5)
  expect(q.virtual_key).toBe("vk1")
  expect(q.since).toBe(100.0)
  expect(q.until).toBe(900.0)
  expect(q.text).toBe("gpt")
  expect(q.model).toBeUndefined()

  const bad = parseQuery(new URLSearchParams("status=weird&limit=abc&offset=&provider="))
  expect(bad.status).toBeUndefined()
  expect(bad.limit).toBeUndefined()
  expect(bad.offset).toBeUndefined()
  expect(bad.provider).toBeUndefined()
})

test("bucket widths follow Bifrost's rule", () => {
  const day = 86400000.0
  expect(bucketSeconds(30.0 * 60000.0)).toBe(60.0)
  expect(bucketSeconds(3.0 * 3600000.0)).toBe(600.0)
  expect(bucketSeconds(2.0 * day)).toBe(3600.0)
  expect(bucketSeconds(8.0 * day)).toBe(86400.0)
  expect(bucketSeconds(40.0 * day)).toBe(3.0 * 86400.0)
  expect(bucketSeconds(100.0 * day)).toBe(7.0 * 86400.0)
})

test("histograms count by status, sum tokens and cost, and split by model and provider", () => {
  const t0 = 3600000.0 * 1000.0
  const es: LogEntry[] = [
    sample("h1", t0 + 1000.0, "A", 200, { provider: "openai", prompt_tokens: 10, completion_tokens: 5, cost: 1.0, latency_ms: 100.0 }),
    sample("h2", t0 + 2000.0, "A", 200, { provider: "openai", prompt_tokens: 20, completion_tokens: 10, cost: 2.0, latency_ms: 300.0 }),
    sample("h3", t0 + 3000.0, "B", 500, { provider: "anthropic", prompt_tokens: 1, completion_tokens: 0, cost: 0.5, latency_ms: 50.0 }),
    sample("h4", t0 + 61000.0, "B", 499, { provider: "anthropic", cost: 0.0, latency_ms: 0.0 }),
  ]
  const g = gridOf(t0, t0 + 120000.0)
  expect(g.n).toBe(2)
  expect(g.sizeSec).toBe(60.0)
  const req = requestsView(es, g)
  expect(req.includes(`"count":3,"success":2,"error":1,"cancelled":0`)).toBe(true)
  expect(req.includes(`"count":1,"success":0,"error":0,"cancelled":1`)).toBe(true)
  const tok = tokensView(es, g)
  expect(tok.includes(`"prompt_tokens":31,"completion_tokens":15,"total_tokens":46`)).toBe(true)
  const cost = costView(es, g)
  expect(cost.includes(`"total_cost":3.5`)).toBe(true)
  expect(cost.includes(`"by_model":{"A":3,"B":0.5}`)).toBe(true)
  expect(cost.includes(`"models":["A","B"]`)).toBe(true)
  const prov = providerView(es, g, "cost")
  expect(prov.includes(`"providers":["anthropic","openai"]`)).toBe(true)
  expect(prov.includes(`"by_provider":{"anthropic":0.5,"openai":3}`)).toBe(true)
  const lat = latencyView(es, g)
  // the first bucket holds 100, 300 and 50 ms
  expect(lat.includes(`"avg_latency":150,"p90_latency":300,"p95_latency":300,"p99_latency":300,"total_requests":3`)).toBe(true)
  const thr = throughputView(es, g)
  // 15 completion tokens in the first bucket, from its two successful rows (the error row is left out)
  expect(thr.includes(`"total_completion_tokens":15,"total_requests":2`)).toBe(true)
  const byDim = dimensionView(es, g, "cost", "provider")
  expect(byDim.includes(`"dimension":"provider"`)).toBe(true)
  expect(byDim.includes(`"dimension_values":["anthropic","openai"]`)).toBe(true)
  expect(validDimension("team")).toBe(true)
  expect(validDimension("widget")).toBe(false)
  expect(validDimension("provider")).toBe(true)
  const models = modelsView(es, g)
  expect(models.includes(`"A":{"total":2,"success":2,"error":0,"cancelled":0}`)).toBe(true)
})

test("stats views: Bifrost's totals with the older fields beside them, and rankings with trends", () => {
  const t0 = 1000000.0
  const now: LogEntry[] = [
    sample("r1", t0 + 1.0, "A", 200, { cost: 2.0, latency_ms: 100.0, prompt_tokens: 4, completion_tokens: 6 }),
    sample("r2", t0 + 2.0, "A", 200, { cost: 2.0, latency_ms: 300.0, prompt_tokens: 4, completion_tokens: 6 }),
    sample("r3", t0 + 3.0, "B", 429, { cost: 0.0, latency_ms: 10.0, prompt_tokens: 0, completion_tokens: 0 }),
  ]
  const prev: LogEntry[] = [sample("p1", t0 - 5.0, "A", 200, { cost: 1.0, latency_ms: 200.0, prompt_tokens: 2, completion_tokens: 3 })]
  const st = statsView(now)
  expect(st.includes(`"total_requests":3,"success_rate":66.66666666666667`)).toBe(true)
  expect(st.includes(`"total_tokens":20`)).toBe(true)
  expect(st.includes(`"total_cost":4`)).toBe(true)
  expect(st.includes(`"requests":3,"errors":1`)).toBe(true)
  expect(st.includes(`"by_model":{"A":{"requests":2,"cost":4},"B":{"requests":1,"cost":0}}`)).toBe(true)

  const rk = modelRankingsView(now, prev, 0)
  // A leads with two requests against one before: +100% requests
  expect(rk.startsWith(`{"rankings":[{"model":"A","provider":"openai",`)).toBe(true)
  expect(rk.includes(`"total_requests":2,"success_count":2,"success_rate":100`)).toBe(true)
  expect(rk.includes(`"requests_trend":100`)).toBe(true)
  expect(rk.includes(`"has_previous_period":true`)).toBe(true)
  // B has no previous requests and no tokens or cost now: zero to zero is a 0% trend
  expect(rk.includes(`"tokens_trend":0,"cost_trend":0`)).toBe(true)
  expect(modelRankingsView(now, prev, 1).split(`"model":`).length).toBe(2)
  expect(dimensionRankingsView(now, prev, "virtual_key", 0).includes(`"total_attributed_requests":0`)).toBe(true)
})

test("rankings are per provider and model, with the price split, canonical name and success-only throughput", () => {
  const a1 = sample("h1", 500.0, "A", 200, { provider: "openai", latency_ms: 1000.0, completion_tokens: 50 })
  a1.input_cost = 0.25
  a1.output_cost = 0.5
  a1.additional_cost = 0.25
  a1.canonical_model_name = "alias-a"
  a1.overhead_ms = 4.0
  const a2 = sample("h2", 600.0, "A", 500, { provider: "openai", latency_ms: 1000.0, completion_tokens: 50 })
  a2.overhead_ms = 8.0
  const a3 = sample("h3", 700.0, "A", 200, { provider: "anthropic", latency_ms: 500.0, completion_tokens: 10 })
  // the overall latency histogram averages the overhead of the rows that recorded one
  const lv = latencyView([a1, a2, a3], gridOf(0.0, 120000.0))
  expect(lv.includes(`"avg_overhead":6,"p90_overhead":8,"p95_overhead":8,"p99_overhead":8`)).toBe(true)
  const rk = modelRankingsView([a1, a2, a3], [], 0)
  expect(rk.split(`"model":`).length).toBe(3)
  // the failed row spends latency but adds no throughput: 50 tokens over 1 s
  expect(rk.includes(`"provider":"openai","input_cost":0.25,"output_cost":0.5,"additional_cost":0.25,"canonical_model_name":"alias-a"`)).toBe(true)
  expect(rk.includes(`"throughput":50,"trend"`)).toBe(true)
  expect(rk.includes(`"provider":"anthropic","input_cost":0,"output_cost":0,"additional_cost":0,"total_requests":1`)).toBe(true)
  expect(rk.includes(`"throughput":20,"trend"`)).toBe(true)
  // no previous period: a nonzero token total has no base, so its trend is null
  expect(rk.includes(`"tokens_trend":null`)).toBe(true)
  expect(histogramDimName("team_id")).toBe("team")
  expect(histogramDimName("provider")).toBe("provider")
})

test("filters: status, providers, text, bounds and the window", () => {
  const sp = new URLSearchParams("status=error&providers=openai,anthropic&min_latency=50&content_search=upstream")
  const f = filterFrom(sp, "llm", 0.0, 1000.0)
  expect(f.statuses.join(",")).toBe("error")
  expect(f.providers.join(",")).toBe("openai,anthropic")
  expect(f.min_latency).toBe(50.0)
  expect(f.max_latency).toBe(-1.0)
  const hit = sample("f1", 500.0, "m", 500, { provider: "openai", latency_ms: 80.0, error: "upstream down" })
  expect(selects(hit, f)).toBe(true)
  const fast = sample("f2", 500.0, "m", 500, { provider: "openai", latency_ms: 10.0, error: "upstream down" })
  expect(selects(fast, f)).toBe(false)
  const late = sample("f3", 1000.0, "m", 500, { provider: "openai", latency_ms: 80.0, error: "upstream down" })
  expect(selects(late, f)).toBe(false)
  const ok = sample("f4", 500.0, "m", 200, { provider: "openai", latency_ms: 80.0 })
  expect(selects(ok, f)).toBe(false)
  const mcp = sample("f5", 500.0, "", 500, {})
  mcp.kind = "mcp"
  expect(selects(mcp, f)).toBe(false)
  expect(selects(mcp, filterFrom(new URLSearchParams(""), "mcp", 0.0, 1000.0))).toBe(true)
})

test("content_search matches prompt and answer text in any format, ignoring case, but not JSON keys", () => {
  const chat = sample("c1", 500.0, "m", 200, { provider: "openai" })
  chat.input = `{"model":"m","messages":[{"role":"system","content":"Be brief"},{"role":"user","content":[{"type":"text","text":"What is the Capital of France?"}]}]}`
  chat.output = `{"choices":[{"message":{"role":"assistant","content":"Paris \\u00e9t\\u00e9"}}]}`
  const resp = sample("c2", 500.0, "m", 200, { provider: "openai" })
  resp.input = `{"model":"m","input":"summarise the quarterly report","instructions":"formal"}`
  const streamed = sample("c3", 500.0, "m", 200, { provider: "openai" })
  streamed.output = `data: {"choices":[{"delta":{"content":"Blue "}}]}\n\ndata: {"choices":[{"delta":{"content":"whale"}}]}\n\ndata: [DONE]\n\n`
  const es = [chat, resp, streamed]
  expect(idsOf(es, "content_search=capital%20of%20france").join(",")).toBe("c1")
  expect(idsOf(es, "content_search=QUARTERLY").join(",")).toBe("c2")
  expect(idsOf(es, "content_search=be%20brief").join(",")).toBe("c1")
  // the answer's text, decoded, and a streamed answer's text across events
  expect(idsOf(es, "content_search=paris%20%C3%A9t%C3%A9").join(",")).toBe("c1")
  expect(idsOf(es, "content_search=blue%20whale").join(",")).toBe("c3")
  // keys and roles are not message text
  expect(idsOf(es, "content_search=messages").length).toBe(0)
  expect(idsOf(es, "content_search=assistant").length).toBe(0)
  expect(contentTextOf(`{"input":["a","b"],"model":"x"}`)).toBe("ab")
  expect(contentTextOf("not json")).toBe("")
})

test("Bifrost request type names of Raiju's ops", () => {
  expect(bifrostRequestType("chat", false)).toBe("chat_completion")
  expect(bifrostRequestType("chat", true)).toBe("chat_completion_stream")
  expect(bifrostRequestType("anthropic.messages", true)).toBe("chat_completion_stream")
  expect(bifrostRequestType("embeddings", true)).toBe("embedding")
  expect(bifrostRequestType("audio.transcriptions", false)).toBe("transcription")
  expect(bifrostRequestType("files.upload", false)).toBe("files.upload")
})

test("routing, cache, stop and chain filters select the recorded fields", () => {
  const a = sample("c1", 500.0, "m", 200, { provider: "openai" })
  a.request_id = "r1"
  a.selected_key_id = "key-1"
  a.routing_rule_id = "rule-x"
  a.routing_engine_used = "routing-rule"
  a.alias = "fast"
  a.complexity_tier = "SIMPLE"
  a.complexity_mechanism = "heuristic"
  a.cache_hit_type = "semantic"
  a.stop_reason = "stop"
  a.parent_request_id = "p0"
  a.agent_correlation_id = "agent-7"
  const b = sample("c2", 600.0, "m", 200, { provider: "openai" })
  b.request_id = "r2"
  b.selected_key_id = "key-2"
  b.parent_request_id = "r1"
  b.session_id = "s1"
  a.session_id = "s1"
  const es: LogEntry[] = [a, b]
  expect(idsOf(es, "selected_key_ids=key-1").join(",")).toBe("c1")
  expect(idsOf(es, "routing_rule_ids=rule-x").join(",")).toBe("c1")
  expect(idsOf(es, "routing_engine_used=loadbalancing").length).toBe(0)
  expect(idsOf(es, "stop_reasons=stop,length").join(",")).toBe("c1")
  expect(idsOf(es, "aliases=fast").join(",")).toBe("c1")
  expect(idsOf(es, "complexity_tiers=SIMPLE").join(",")).toBe("c1")
  expect(idsOf(es, "complexity_mechanisms=heuristic").join(",")).toBe("c1")
  expect(idsOf(es, "cache_hit_types=semantic").join(",")).toBe("c1")
  expect(idsOf(es, "cache_hit_types=direct").length).toBe(0)
  expect(idsOf(es, "parent_request_id=p0").join(",")).toBe("c1")
  expect(idsOf(es, "agent_correlation_id=agent-7").join(",")).toBe("c1")
  expect(idsOf(es, "agent_correlation_id=agent").length).toBe(0)
})

test("agent_names selects the requests of the sessions an agent's calls ran in", () => {
  const es: LogEntry[] = []
  const t = 1000.0
  const call = sample("a2a1", t, "", 200, {})
  call.kind = "a2a"
  call.op = "message/send"
  call.agent_name = "echo"
  call.session_id = "ctx-1"
  es.push(call)
  const other = sample("a2a2", t + 1.0, "", 200, {})
  other.kind = "a2a"
  other.agent_name = "other"
  other.session_id = "ctx-2"
  es.push(other)
  const inside = sample("llm1", t + 2.0, "gpt-4o", 200, {})
  inside.session_id = "ctx-1"
  es.push(inside)
  const outside = sample("llm2", t + 3.0, "gpt-4o", 200, {})
  outside.session_id = "ctx-2"
  es.push(outside)
  const names = ["echo"]
  expect(agentSessionsOf(es, names, 0.0, 5000.0).join(",")).toBe("ctx-1")
  expect(agentSessionsOf(es, names, 1500.0, 5000.0).length).toBe(0)
  let f = filterFrom(new URLSearchParams(""), "llm", 0.0, 5000.0)
  f.agentSessions = agentSessionsOf(es, names, 0.0, 5000.0)
  expect(selectAll(es, f).map((e) => e.id).join(",")).toBe("llm1")
  // the A2A calls are not LLM rows, and their own list is the history
  expect(selectAll(es, filterFrom(new URLSearchParams(""), "llm", 0.0, 5000.0)).length).toBe(2)
  expect(a2aLogJson(call).includes(`"agent_name":"echo"`)).toBe(true)
  expect(a2aLogJson(call).includes(`"context_id":"ctx-1"`)).toBe(true)
})

// The ids of the entries a query selects, in order (a top-level helper, so the tests capture nothing).
function idsOf(es: LogEntry[], q: string): string[] {
  return selectAll(es, filterFrom(new URLSearchParams(q), "llm", 0.0, 1000.0)).map((e) => e.id)
}

test("tool call, complexity score and prompt filters select the recorded fields", () => {
  const a = sample("t1", 500.0, "m", 200, { provider: "openai" })
  a.tool_call_names = ["get_weather", "lookup_city"]
  a.complexity_score = 2.5
  a.selected_prompt_id = "pr-1"
  a.selected_prompt_name = "greet"
  a.selected_prompt_version = 2
  const b = sample("t2", 600.0, "m", 200, { provider: "openai" })
  b.tool_call_names = ["search"]
  b.complexity_score = 9.0
  const c = sample("t3", 700.0, "m", 200, { provider: "openai" })
  const es: LogEntry[] = [a, b, c]
  expect(idsOf(es, "tool_call_names=lookup_city").join(",")).toBe("t1")
  expect(idsOf(es, "tool_call_names=search,nothing").join(",")).toBe("t2")
  expect(idsOf(es, "tool_call_names=nothing").length).toBe(0)
  expect(idsOf(es, "min_complexity_score=0").join(",")).toBe("t1,t2")
  expect(idsOf(es, "min_complexity_score=5").join(",")).toBe("t2")
  expect(idsOf(es, "max_complexity_score=5").join(",")).toBe("t1")
  expect(idsOf(es, "min_complexity_score=2&max_complexity_score=9").join(",")).toBe("t1,t2")
  expect(idsOf(es, "min_complexity_score=10").length).toBe(0)
  expect(idsOf(es, "selected_prompt_ids=pr-1").join(",")).toBe("t1")
  expect(idsOf(es, "prompt_names=greet").join(",")).toBe("t1")
  expect(idsOf(es, "prompt_names=other").length).toBe(0)
  expect(idsOf(es, "selected_prompt_ids=pr-1&prompt_names=other").length).toBe(0)
})

test("a cache hit without a recorded type is a direct hit, and the stats count both kinds", () => {
  const old = sample("h1", 500.0, "m", 200, {})
  old.cache_hit = true
  const sem = sample("h2", 500.0, "m", 200, {})
  sem.cache_hit = true
  sem.cache_hit_type = "semantic"
  const miss = sample("h3", 500.0, "m", 200, {})
  expect(hitTypeOf(old)).toBe("direct")
  expect(hitTypeOf(sem)).toBe("semantic")
  expect(hitTypeOf(miss)).toBe("")
  const v = statsView([old, sem, miss])
  expect(v.includes(`"cache_hit_rate_total_requests":3`)).toBe(true)
  expect(v.includes(`"direct_cache_hits":1`)).toBe(true)
  expect(v.includes(`"semantic_cache_hits":1`)).toBe(true)
})

test("roots_only hides chained rows; group_sessions keeps each session's earliest root", () => {
  const root = sample("g1", 100.0, "m", 200, {})
  root.request_id = "R1"
  root.session_id = "S"
  const child = sample("g2", 200.0, "m", 200, {})
  child.request_id = "R2"
  child.parent_request_id = "R1"
  child.session_id = "S"
  const root2 = sample("g3", 300.0, "m", 200, {})
  root2.request_id = "R3"
  root2.session_id = "S"
  const other = sample("g4", 400.0, "m", 200, {})
  other.request_id = "R4"
  const all = [root, child, root2, other]
  const plain = filterFrom(new URLSearchParams(""), "llm", 0.0, 1000.0)
  expect(applyChains(all, plain).length).toBe(4)
  const roots = filterFrom(new URLSearchParams("roots_only=true"), "llm", 0.0, 1000.0)
  expect(applyChains(all, roots).map((e) => e.id).join(",")).toBe("g1,g3,g4")
  const grouped = filterFrom(new URLSearchParams("roots_only=true&group_sessions=true"), "llm", 0.0, 1000.0)
  expect(applyChains(all, grouped).map((e) => e.id).join(",")).toBe("g1,g4")
  // a parent filter ends roots_only: the chain's children are listed
  const kids = filterFrom(new URLSearchParams("roots_only=true&parent_request_id=R1"), "llm", 0.0, 1000.0)
  expect(applyChains(selectAll(all, kids), kids).map((e) => e.id).join(",")).toBe("g2")
})

test("MCP tool executions share the store but not the LLM views", () => {
  const dir = tmpDir()
  try {
    const s = try new LogStore(defaultLogStoreConfig(dir))
    // today's timestamps, so a reopened store reads the same day file
    const t = Date.now()
    s.add(sample("llm1", t + 1.0, "gpt-4o", 200, {}))
    const m1 = sample("mcp1", t + 2.0, "", 200, { latency_ms: 40.0, cost: 0.01 })
    m1.kind = "mcp"
    m1.op = "tool"
    m1.tool = "get-weather"
    m1.server = "weather"
    s.add(m1)
    const m2 = sample("mcp2", t + 3.0, "", 500, { error: "tool failed" })
    m2.kind = "mcp"
    m2.op = "tool"
    m2.tool = "get-weather"
    m2.server = "weather"
    s.add(m2)
    expect(s.query({}).total).toBe(1)
    expect(s.query({ kind: "mcp" }).total).toBe(2)
    expect(s.query({ kind: "mcp", text: "get-weather" }).total).toBe(2)
    expect(s.stats(0.0).requests).toBe(1)
    expect(mcpStatsView(s.since(0.0).filter((e) => kindOf(e) === "mcp")).includes(`"total_executions":2,"success_rate":50`)).toBe(true)
    expect(topToolsView(s.since(0.0), 10).includes(`"tool_name":"get-weather","count":2`)).toBe(true)
    expect(mcpLogJson(m2).includes(`"status":"error","error_details":{"message":"tool failed"}`)).toBe(true)
    // delete removes from memory and from the day file
    expect(s.delete(["mcp1"])).toBe(1)
    expect(s.query({ kind: "mcp" }).total).toBe(1)
    const reopened = try new LogStore(defaultLogStoreConfig(dir))
    expect(reopened.query({ kind: "mcp" }).total).toBe(1)
    expect(reopened.query({}).total).toBe(1)
    expect(s.delete(["nope"])).toBe(0)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("per-model usage: a key's or a user's requests in a budget cycle, summed per model", () => {
  let a = sample("a", 100.0, "gpt-4o", 200, {})
  a.virtual_key = "vk-1"
  a.user_id = "ann"
  let b = sample("b", 200.0, "gpt-4o", 200, {})
  b.virtual_key = "vk-1"
  let c = sample("c", 300.0, "claude", 200, { provider: "anthropic", cost: 2.0 })
  c.virtual_key = "vk-1"
  c.user_id = "ann"
  let d = sample("d", 50.0, "gpt-4o", 200, {})
  d.virtual_key = "vk-1"
  let e = sample("e", 250.0, "gpt-4o", 200, {})
  e.virtual_key = "vk-2"
  let t = sample("t", 250.0, "x", 200, {})
  t.kind = "mcp"
  t.virtual_key = "vk-1"
  const rows = perModelUsage([a, b, c, d, e, t], "vk-1", "", 100.0, 400.0)
  expect(JSON.stringify(rows)).toBe(`[{"model":"gpt-4o","provider":"openai","total_requests":2,"total_tokens":14,"total_cost":1,"input_cost":0,"output_cost":0,"additional_cost":0},{"model":"claude","provider":"anthropic","total_requests":1,"total_tokens":7,"total_cost":2,"input_cost":0,"output_cost":0,"additional_cost":0}]`)
  const mine = perModelUsage([a, b, c, d, e], "vk-1", "ann", 0.0, 400.0)
  expect(mine.map((r) => r.model).join(",")).toBe("gpt-4o,claude")
  expect(mine[0]!.total_requests).toBe(1)
  expect(perModelUsage([a], "vk-1", "", 150.0, 400.0).length).toBe(0)
})
