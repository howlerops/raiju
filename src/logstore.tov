// Request log store: a searchable history of gateway requests, kept in memory
// (a ring of the newest entries) and appended to one JSON-lines file per UTC
// day. Tov has no database driver, so the files are the durable store.
import { mkdirSync, appendFileSync, readFileSync, existsSync, readdirSync, unlinkSync, writeFileSync, rmSync } from "node:fs"
import { join } from "node:path"

export type LogEntry = {
  id: string,
  ts: f64, // ms since the epoch
  request_id: string,
  op: string,
  provider: string,
  model: string,
  status: int,
  latency_ms: f64,
  prompt_tokens: int,
  completion_tokens: int,
  cost: f64,
  cache_hit: bool,
  virtual_key?: string,
  error?: string,
  input?: string, // request body, only when content logging is on
  output?: string, // response body, only when content logging is on
}

export type LogStoreConfig = {
  dir: string,
  retention_days: int,
  max_memory_entries: int,
  content_logging: bool,
  max_content_bytes: int,
}

export type LogQuery = {
  provider?: string,
  model?: string,
  status?: "success" | "error",
  virtual_key?: string,
  since?: f64,
  until?: f64,
  text?: string, // substring of model, error or request_id
  limit?: int,
  offset?: int,
}

export type ModelStats = { model: string, requests: int, cost: f64 }

export type LogStats = {
  requests: int,
  errors: int,
  tokens: int,
  cost: f64,
  avg_latency_ms: f64,
  by_model: ModelStats[],
}

export function defaultLogStoreConfig(dir: string): LogStoreConfig {
  return { dir: dir, retention_days: 7, max_memory_entries: 10000, content_logging: false, max_content_bytes: 8192 }
}

const DAY_MS = 86400000

// Days since 1970-01-01 for a proleptic Gregorian date (Howard Hinnant's
// algorithm; the 400-year eras make it exact for every year, leap years included).
function daysFromCivil(y0: int, m: int, d: int): int {
  const y = m <= 2 ? y0 - 1 : y0
  const era = Math.floor(y / 400)
  const yoe = y - era * 400
  const mp = m > 2 ? m - 3 : m + 9
  const doy = Math.floor((153 * mp + 2) / 5) + d - 1
  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy
  return era * 146097 + doe - 719468
}

function civilFromDays(z0: int): { y: int, m: int, d: int } {
  const z = z0 + 719468
  const era = Math.floor(z / 146097)
  const doe = z - era * 146097
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365)
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100))
  const mp = Math.floor((5 * doy + 2) / 153)
  const d = doy - Math.floor((153 * mp + 2) / 5) + 1
  const m = mp < 10 ? mp + 3 : mp - 9
  const y = yoe + era * 400
  return { y: m <= 2 ? y + 1 : y, m: m, d: d }
}

function pad(n: int, width: int): string {
  let s = "" + n
  while (s.byteLength < width) s = "0" + s
  return s
}

// The UTC calendar day of a timestamp, as YYYY-MM-DD. Floor division keeps
// times before 1970 on the right day.
function dayOf(ms: f64): string {
  const c = civilFromDays(Math.floor(ms / DAY_MS))
  return pad(c.y, 4) + "-" + pad(c.m, 2) + "-" + pad(c.d, 2)
}

function fileName(ts: f64): string {
  return "requests-" + dayOf(ts) + ".jsonl"
}

// The day number of a requests-YYYY-MM-DD.jsonl file, or undefined for any
// other name (including dates that do not exist, such as 2026-02-31).
function fileDay(name: string): int | undefined {
  if (name.byteLength !== 25 || !name.startsWith("requests-") || !name.endsWith(".jsonl")) return undefined
  const y = parseInt(name.slice(9, 13))
  const m = parseInt(name.slice(14, 16))
  const d = parseInt(name.slice(17, 19))
  if (y === undefined || m === undefined || d === undefined) return undefined
  const days = daysFromCivil(y, m, d)
  const c = civilFromDays(days)
  if (c.y !== y || c.m !== m || c.d !== d) return undefined
  return days
}

// Cuts s to at most max bytes without ending inside a multi-byte character:
// a UTF-8 continuation byte (10xxxxxx) marks the middle of one.
function clip(s: string | undefined, max: int): string | undefined {
  if (s === undefined || s.byteLength <= max) return s
  const bytes = new TextEncoder().encode(s)
  let end = Math.max(0, max)
  while (end > 0 && (int(bytes[end]!) & 0xc0) === 0x80) end -= 1
  try {
    return new TextDecoder().decode(bytes.slice(0, end))
  } catch (err) {
    return ""
  }
}

function isSuccess(e: LogEntry): bool {
  return e.status >= 200 && e.status < 300
}

function mentions(e: LogEntry, text: string): bool {
  if (e.model.includes(text) || e.request_id.includes(text)) return true
  const err = e.error
  return err !== undefined && err.includes(text)
}

function matches(e: LogEntry, q: LogQuery): bool {
  if (q.provider !== undefined && e.provider !== q.provider) return false
  if (q.model !== undefined && e.model !== q.model) return false
  if (q.status !== undefined && isSuccess(e) !== (q.status === "success")) return false
  if (q.virtual_key !== undefined && e.virtual_key !== q.virtual_key) return false
  if (q.since !== undefined && e.ts < q.since) return false
  if (q.until !== undefined && e.ts > q.until) return false
  if (q.text !== undefined && q.text !== "" && !mentions(e, q.text)) return false
  return true
}

export class LogStore {
  private ring: LogEntry[] = []
  // Where the next entry goes: once the ring is full this is the oldest slot.
  private next: int = 0
  private cap: int

  constructor(readonly cfg: LogStoreConfig) {
    this.cap = Math.max(1, cfg.max_memory_entries)
    try mkdirSync(cfg.dir, { recursive: true })
    const today = join(cfg.dir, fileName(Date.now()))
    if (existsSync(today)) {
      for (const line of try readFileSync(today, "utf8").split("\n")) {
        if (line === "") continue
        // a torn or foreign line is skipped, not fatal
        try {
          this.remember(try JSON.parse(line) as LogEntry)
        } catch (err) {
          continue
        }
      }
    }
  }

  // Appends the entry to its day's file and to memory. A failed write is
  // reported on stderr; it must not fail the request that was logged.
  add(e: LogEntry): void {
    const entry = this.prepare(e)
    this.remember(entry)
    try {
      appendFileSync(join(this.cfg.dir, fileName(entry.ts)), JSON.stringify(entry) + "\n")
    } catch (err) {
      console.error(`logstore: could not write request log: ${err.message}`)
    }
  }

  query(q: LogQuery): { entries: LogEntry[], total: int } {
    const limit = Math.min(1000, Math.max(0, q.limit ?? 50))
    const offset = Math.max(0, q.offset ?? 0)
    const entries: LogEntry[] = []
    let total = 0
    for (let k = 0; k < this.ring.length; k++) {
      const e = this.newest(k)
      if (!matches(e, q)) continue
      if (total >= offset && entries.length < limit) entries.push(e)
      total += 1
    }
    return { entries: entries, total: total }
  }

  // Totals over the in-memory entries logged at or after since.
  stats(since: f64): LogStats {
    let requests = 0
    let errors = 0
    let tokens = 0
    let cost = 0.0
    let latency = 0.0
    const perModel: Map<string, ModelStats> = new Map()
    for (let k = 0; k < this.ring.length; k++) {
      const e = this.newest(k)
      if (e.ts < since) continue
      requests += 1
      if (!isSuccess(e)) errors += 1
      tokens += e.prompt_tokens + e.completion_tokens
      cost += e.cost
      latency += e.latency_ms
      const m = perModel.get(e.model) ?? { model: e.model, requests: 0, cost: 0.0 }
      perModel.set(e.model, { model: e.model, requests: m.requests + 1, cost: m.cost + e.cost })
    }
    const byModel: ModelStats[] = []
    for (const name of perModel.keys()) byModel.push(perModel.get(name)!)
    byModel.sort((a, b) => b.cost - a.cost)
    return {
      requests: requests,
      errors: errors,
      tokens: tokens,
      cost: cost,
      avg_latency_ms: requests > 0 ? latency / requests : 0.0,
      by_model: byModel,
    }
  }

  // Deletes the day files older than retention_days before now; returns how many.
  prune(now: f64): int throws Error {
    const cutoff = Math.floor(now / DAY_MS) - this.cfg.retention_days
    let removed = 0
    for (const name of try readdirSync(this.cfg.dir)) {
      const day = fileDay(name)
      if (day === undefined || day >= cutoff) continue
      try {
        unlinkSync(join(this.cfg.dir, name))
        removed += 1
      } catch (err) {
        console.error(`logstore: could not delete ${name}: ${err.message}`)
      }
    }
    return removed
  }

  // The entry as it is stored: bodies cut to the limit, or dropped entirely
  // when content logging is off.
  private prepare(e: LogEntry): LogEntry {
    const on = this.cfg.content_logging
    const max = this.cfg.max_content_bytes
    return {
      id: e.id,
      ts: e.ts,
      request_id: e.request_id,
      op: e.op,
      provider: e.provider,
      model: e.model,
      status: e.status,
      latency_ms: e.latency_ms,
      prompt_tokens: e.prompt_tokens,
      completion_tokens: e.completion_tokens,
      cost: e.cost,
      cache_hit: e.cache_hit,
      virtual_key: e.virtual_key,
      error: e.error,
      input: on ? clip(e.input, max) : undefined,
      output: on ? clip(e.output, max) : undefined,
    }
  }

  private remember(e: LogEntry): void {
    if (this.ring.length < this.cap) {
      this.ring.push(e)
      this.next = this.ring.length % this.cap
    } else {
      this.ring[this.next] = e
      this.next = (this.next + 1) % this.cap
    }
  }

  // The k-th newest entry in memory (k = 0 is the newest).
  private newest(k: int): LogEntry {
    const n = this.ring.length
    const i = (((this.next - 1 - k) % n) + n) % n
    return this.ring[i]!
  }
}

// Reads the query string of GET /api/logs. Empty or malformed values are
// ignored; limit and offset are clamped when the query runs.
export function parseQuery(params: URLSearchParams): LogQuery {
  const q: LogQuery = {}
  const provider = params.get("provider")
  if (provider !== undefined && provider !== "") q.provider = provider
  const model = params.get("model")
  if (model !== undefined && model !== "") q.model = model
  const status = params.get("status")
  if (status === "success") q.status = "success"
  if (status === "error") q.status = "error"
  const vk = params.get("virtual_key")
  if (vk !== undefined && vk !== "") q.virtual_key = vk
  const since = params.get("since")
  if (since !== undefined) q.since = Number(since)
  const until = params.get("until")
  if (until !== undefined) q.until = Number(until)
  const text = params.get("text")
  if (text !== undefined && text !== "") q.text = text
  const limit = params.get("limit")
  if (limit !== undefined) q.limit = parseInt(limit)
  const offset = params.get("offset")
  if (offset !== undefined) q.offset = parseInt(offset)
  return q
}

test("UTC day of a timestamp, across leap years and month ends", () => {
  expect(dayOf(0)).toBe("1970-01-01")
  expect(dayOf(-86400000)).toBe("1969-12-31")
  expect(dayOf(951782400000)).toBe("2000-02-29")
  expect(dayOf(1709164800000)).toBe("2024-02-29")
  expect(dayOf(1709164800000 - 1)).toBe("2024-02-28")
  expect(dayOf(1709208000000)).toBe("2024-02-29")
  expect(dayOf(1769817600000)).toBe("2026-01-31")
  expect(dayOf(1772323200000 - 1)).toBe("2026-02-28")
  expect(dayOf(1772323200000)).toBe("2026-03-01")
  expect(dayOf(1791936000000)).toBe("2026-10-14")
  expect(fileName(1791979200000)).toBe("requests-2026-10-14.jsonl")
})

test("day files parse back to their day, and reject impossible dates", () => {
  expect(fileDay("requests-2026-10-14.jsonl")).toBe(Math.floor(1791936000000 / DAY_MS))
  expect(fileDay("requests-2024-02-29.jsonl")).toBe(Math.floor(1709164800000 / DAY_MS))
  expect(fileDay("requests-2026-02-29.jsonl")).toBeUndefined()
  expect(fileDay("requests-2026-13-01.jsonl")).toBeUndefined()
  expect(fileDay("notes.txt")).toBeUndefined()
  expect(fileDay("requests-2026-10-14.jsonl.bak")).toBeUndefined()
})

function tmpDir(): string {
  return "/tmp/raiju-logstore-test-" + Math.floor(Math.random() * 1000000000)
}

type Over = { provider?: string, virtual_key?: string, error?: string, input?: string, output?: string, cost?: f64, latency_ms?: f64, prompt_tokens?: int, completion_tokens?: int }

function sample(id: string, ts: f64, model: string, status: int, o: Over): LogEntry {
  return {
    id: id,
    ts: ts,
    request_id: "req-" + id,
    op: "chat",
    provider: o.provider ?? "openai",
    model: model,
    status: status,
    latency_ms: o.latency_ms ?? 10.0,
    prompt_tokens: o.prompt_tokens ?? 3,
    completion_tokens: o.completion_tokens ?? 4,
    cost: o.cost ?? 0.5,
    cache_hit: false,
    virtual_key: o.virtual_key,
    error: o.error,
    input: o.input,
    output: o.output,
  }
}

test("add and query: filters, newest first, limit and offset", () => {
  const dir = tmpDir()
  try {
    const s = try new LogStore(defaultLogStoreConfig(dir))
    s.add(sample("a", 1000.0, "gpt-4o", 200, {}))
    s.add(sample("b", 2000.0, "claude", 500, { provider: "anthropic", virtual_key: "vk1", error: "upstream down" }))
    s.add(sample("c", 3000.0, "gpt-4o", 200, { virtual_key: "vk1" }))
    s.add(sample("d", 4000.0, "gpt-4o-mini", 429, {}))

    const all = s.query({})
    expect(all.total).toBe(4)
    expect(all.entries.map((e) => e.id).join(",")).toBe("d,c,b,a")

    expect(s.query({ provider: "anthropic" }).total).toBe(1)
    expect(s.query({ model: "gpt-4o" }).total).toBe(2)
    expect(s.query({ status: "error" }).total).toBe(2)
    expect(s.query({ status: "success" }).total).toBe(2)
    expect(s.query({ virtual_key: "vk1" }).total).toBe(2)
    expect(s.query({ since: 2000.0, until: 3000.0 }).total).toBe(2)
    expect(s.query({ text: "req-c" }).total).toBe(1)
    expect(s.query({ text: "mini" }).total).toBe(1)
    expect(s.query({ text: "upstream" }).total).toBe(1)
    expect(s.query({ text: "nothing-matches" }).total).toBe(0)

    const page = s.query({ limit: 2, offset: 1 })
    expect(page.total).toBe(4)
    expect(page.entries.map((e) => e.id).join(",")).toBe("c,b")
    expect(s.query({ limit: 0 }).total).toBe(4)
    expect(s.query({ limit: 0 }).entries.length).toBe(0)
    expect(s.query({ offset: 10 }).entries.length).toBe(0)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("the ring keeps only the newest max_memory_entries", () => {
  const dir = tmpDir()
  try {
    const cfg = defaultLogStoreConfig(dir)
    cfg.max_memory_entries = 3
    const s = try new LogStore(cfg)
    for (let i = 1; i <= 5; i++) s.add(sample("e" + i, i * 1000.0, "m", 200, {}))
    const r = s.query({})
    expect(r.total).toBe(3)
    expect(r.entries.map((e) => e.id).join(",")).toBe("e5,e4,e3")
    // the file keeps every entry; memory holds only the newest window
    const lines = try readFileSync(join(dir, fileName(1000.0)), "utf8").split("\n").filter((l) => l !== "")
    expect(lines.length).toBe(5)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("content is dropped when logging is off and cut on a UTF-8 boundary when on", () => {
  const dir = tmpDir()
  try {
    const off = try new LogStore(defaultLogStoreConfig(dir))
    off.add(sample("x", 1.0, "m", 200, { input: "secret prompt", output: "secret answer" }))
    const got = off.query({}).entries[0]!
    expect(got.input).toBeUndefined()
    expect(got.output).toBeUndefined()
    expect(try readFileSync(join(dir, fileName(1.0)), "utf8").includes("secret")).toBe(false)

    const onCfg = defaultLogStoreConfig(dir + "-on")
    onCfg.content_logging = true
    onCfg.max_content_bytes = 4
    const on = try new LogStore(onCfg)
    // "aé日" is 1 + 2 + 3 bytes; byte 4 falls inside 日
    on.add(sample("y", 1.0, "m", 200, { input: "aé日", output: "short" }))
    const kept = on.query({}).entries[0]!
    expect(kept.input).toBe("aé")
    expect(kept.output).toBe("shor")
    on.add(sample("z", 2.0, "m", 200, { input: "aé日", output: "x" }))
    const cut = on.query({ text: "req-z" }).entries[0]!
    expect(cut.input).toBe("aé")
    try rmSync(dir + "-on", { recursive: true, force: true })
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("a cut inside the first byte of a character backs up to its start", () => {
  expect(clip("日本", 1)).toBe("")
  expect(clip("日本", 3)).toBe("日")
  expect(clip("日本", 6)).toBe("日本")
  expect(clip("ab", 5)).toBe("ab")
  expect(clip(undefined, 5)).toBeUndefined()
})

test("persistence: a new store on the same dir sees today's entries", () => {
  const dir = tmpDir()
  try {
    const a = try new LogStore(defaultLogStoreConfig(dir))
    a.add(sample("p1", Date.now(), "m", 200, {}))
    a.add(sample("p2", Date.now(), "m", 500, {}))
    const b = try new LogStore(defaultLogStoreConfig(dir))
    const r = b.query({})
    expect(r.total).toBe(2)
    expect(r.entries[0]!.id).toBe("p2")
    expect(r.entries[1]!.status).toBe(200)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("prune deletes day files past retention and keeps recent ones", () => {
  const dir = tmpDir()
  try {
    const s = try new LogStore(defaultLogStoreConfig(dir))
    try writeFileSync(join(dir, "requests-2026-09-01.jsonl"), "{}\n")
    try writeFileSync(join(dir, "requests-2026-10-06.jsonl"), "{}\n")
    try writeFileSync(join(dir, "requests-2026-10-07.jsonl"), "{}\n")
    try writeFileSync(join(dir, "requests-2026-10-14.jsonl"), "{}\n")
    try writeFileSync(join(dir, "other.txt"), "keep\n")
    // 2026-10-14 noon, retention 7 days: 2026-10-07 is exactly 7 days back and stays
    const removed = try s.prune(1791979200000)
    expect(removed).toBe(2)
    expect(existsSync(join(dir, "requests-2026-09-01.jsonl"))).toBe(false)
    expect(existsSync(join(dir, "requests-2026-10-06.jsonl"))).toBe(false)
    expect(existsSync(join(dir, "requests-2026-10-07.jsonl"))).toBe(true)
    expect(existsSync(join(dir, "requests-2026-10-14.jsonl"))).toBe(true)
    expect(existsSync(join(dir, "other.txt"))).toBe(true)
    expect(try s.prune(1791979200000)).toBe(0)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("stats: totals, error count, average latency and per-model breakdown", () => {
  const dir = tmpDir()
  try {
    const s = try new LogStore(defaultLogStoreConfig(dir))
    s.add(sample("s1", 100.0, "A", 200, { prompt_tokens: 10, completion_tokens: 5, cost: 0.5, latency_ms: 100.0 }))
    s.add(sample("s2", 200.0, "A", 200, { prompt_tokens: 20, completion_tokens: 10, cost: 1.0, latency_ms: 200.0 }))
    s.add(sample("s3", 300.0, "B", 500, { prompt_tokens: 1, completion_tokens: 2, cost: 0.25, latency_ms: 300.0 }))

    const all = s.stats(0.0)
    expect(all.requests).toBe(3)
    expect(all.errors).toBe(1)
    expect(all.tokens).toBe(48)
    expect(all.cost).toBe(1.75)
    expect(all.avg_latency_ms).toBe(200.0)
    expect(all.by_model.length).toBe(2)
    expect(all.by_model[0]!.model).toBe("A")
    expect(all.by_model[0]!.requests).toBe(2)
    expect(all.by_model[0]!.cost).toBe(1.5)
    expect(all.by_model[1]!.model).toBe("B")
    expect(all.by_model[1]!.cost).toBe(0.25)

    const recent = s.stats(150.0)
    expect(recent.requests).toBe(2)
    expect(recent.errors).toBe(1)
    expect(recent.avg_latency_ms).toBe(250.0)

    const none = s.stats(1000.0)
    expect(none.requests).toBe(0)
    expect(none.avg_latency_ms).toBe(0.0)
    expect(none.by_model.length).toBe(0)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("parseQuery reads the HTTP query string and ignores bad values", () => {
  const q = parseQuery(new URLSearchParams("provider=openai&status=error&limit=20&offset=5&virtual_key=vk1&since=100&until=900&text=gpt"))
  expect(q.provider).toBe("openai")
  expect(q.status).toBe("error")
  expect(q.limit).toBe(20)
  expect(q.offset).toBe(5)
  expect(q.virtual_key).toBe("vk1")
  expect(q.since).toBe(100.0)
  expect(q.until).toBe(900.0)
  expect(q.text).toBe("gpt")
  expect(q.model).toBeUndefined()

  const bad = parseQuery(new URLSearchParams("status=weird&limit=abc&offset=&provider="))
  expect(bad.status).toBeUndefined()
  expect(bad.limit).toBeUndefined()
  expect(bad.offset).toBeUndefined()
  expect(bad.provider).toBeUndefined()
})
