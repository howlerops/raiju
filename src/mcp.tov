// MCP (Model Context Protocol) client. Connects to MCP servers over Streamable
// HTTP, lists their tools so chat requests can offer them to the model, and runs
// the tool calls the model makes. The protocol lives in pure functions that test
// without a network; McpSession and McpManager wrap them around fetch.
import { McpAuthConfig, TokenCache, staticHeaders, tokenRequest, discoveryUrls, parseAuthServerMetadata } from "./mcpauth"
import { McpUserToken } from "./mcpuser"
import { McpTokenExchange, AdminCredential, adminCredential, needsReverify, reverifyRow } from "./tokenexchange"
import { InstructionPart, aggregate, commentBlock } from "./mcpinstructions"

// one reply of a per-user call: its status, content type, body and the session id it carries
type UserReply = { status: int, contentType: string, body: string, sid: string }
import { fields, elements, find, rawStr, rawBool, rawNum, quote, build, setField, isNull, decodeString } from "./json"
import { deadline } from "./deadline"
import { resolvedTargetProblem } from "./netguard"
import { OpenApiConfig, OpenApiCred, OpenApiDoc, OpenApiOp, OpRequest, parseSpec, inputSchema, requestFor, callOperation, toolDescription, baseUrlOf, operationServersCover, specInstructions, specFilePath } from "./openapi"
import { readFileSync } from "node:fs"

// The folder an openapi_config.spec_file is read from (the config file's), set once at start.
let specBaseDir = ""

export function setSpecBaseDir(dir: string): void {
  specBaseDir = dir
}

// Bifrost's client config. "http" is Streamable HTTP ("sse" uses the same POST
// transport); "stdio" runs stdio_config.command and speaks newline-delimited
// JSON-RPC on its stdin and stdout (needs Tov's Bun.spawnSocket, tov-patches/).
export type McpClientConfig = {
  name: string,
  connection_type: string,
  connection_string?: string, // http and sse
  headers?: Map<string, string>,
  tools_to_execute?: string[],
  tools_to_skip?: string[],
  // credentials for the server: a bearer token, extra headers, or OAuth (client credentials, refresh token)
  auth?: McpAuthConfig,
  // stdio servers: the program, its arguments, extra environment and working directory
  stdio_config?: { command: string, args?: string[], env?: Map<string, string>, cwd?: string },
  // Bifrost's fields. disabled stops the connection (connect() below); the rest are stored
  // as the management API takes them and are not applied yet.
  disabled?: bool,
  allow_by_default?: bool,
  tools_to_auto_execute?: string[],
  tool_sync_interval?: string,
  tls_config?: McpTlsConfig,
  // Bifrost's per-client settings. tool_execution_timeout is a Go duration that overrides the global
  // timeout for this server. needs_session_stickiness false (http only) connects fresh for each call.
  // require_public_target keeps every dial to a public address. allowed_extra_headers lists the request
  // headers that may be forwarded to this server on a tool call ("*" for all). tool_pricing is the cost
  // per execution by server tool name. is_ping_available false skips the ping of the periodic check (the tool
  // list alone checks the server).
  tool_execution_timeout?: string,
  is_ping_available?: bool,
  needs_session_stickiness?: bool,
  require_public_target?: bool,
  allowed_extra_headers?: string[],
  tool_pricing?: Map<string, f64>,
  // connection_type "openapi": each operation of the document is a tool (src/openapi.tov)
  openapi_config?: OpenApiConfig,
  // auth_type "per_user_headers": each virtual key submits its own values of per_user_header_keys, and
  // those values go with its tool calls. headers then holds the sample the verification checked, which
  // the client connects with to list its tools.
  auth_type?: string,
  per_user_header_keys?: string[],
  // auth_type "token_exchange": the caller's identity-provider token is exchanged for one scoped to the
  // audience, and the result goes with its tool calls (src/tokenexchange.tov)
  token_exchange?: McpTokenExchange,
  // is_code_mode_client: the tools are not offered one by one; the model reaches them through the code mode
  // meta-tools (src/codemode.tov). Their tools still run through the same gates when a program calls them.
  is_code_mode_client?: bool,
  // the byte cap on this server's forwarded instructions; 0 or unset uses mcp.max_instructions_per_client
  max_instructions_length?: int,
}

// The code mode limits as the config gives them (Bifrost's mcp_code_mode_limits); 0 or a missing field is the default.
export type CodeLimitsIn = {
  max_source_bytes?: int,
  max_steps?: int,
  max_memory_bytes?: int,
  max_log_bytes?: int,
  max_tool_calls?: int,
  max_value_bytes?: int,
  max_nesting_depth?: int,
}

export type McpTlsConfig = { insecure_skip_verify?: bool, ca_cert_pem?: string }

// The header values one virtual key submitted for one per_user_headers client (Bifrost's per-user
// headers credential). Its values are sealed in the saved file.
export type McpUserCredential = { id: string, mcp_client_name: string, virtual_key_id: string, headers: Map<string, string>, updated_at: f64 }

// A pending submission of those values (Bifrost's per-user headers flow). It expires at expires_at, in
// epoch milliseconds, and is removed once submitted or revoked.
export type McpHeaderFlow = { id: string, mcp_client_name: string, virtual_key_id: string, expires_at: f64, created_at: f64 }

export type McpConfig = {
  client_configs?: McpClientConfig[],
  tool_execution_timeout_seconds?: int,
  // the default tool_sync_interval of clients that have none (Bifrost's mcp.tool_sync_interval)
  tool_sync_interval?: string,
  // hosts that may be reached although private, by clients with require_public_target (oauth_private_allowlist)
  oauth_private_allowlist?: string[],
  user_credentials?: McpUserCredential[],
  header_flows?: McpHeaderFlow[],
  // the tokens each caller obtained for the per_user_oauth clients (src/mcpuser.tov); sealed at rest
  user_tokens?: McpUserToken[],
  // the admin discovery credential of each token_exchange client, kept by its verification (verify-exchange):
  // the tools are listed with it, as Bifrost's admin bootstrap token does. Sealed at rest, never returned.
  exchange_admin?: McpUserToken[],
  // code mode: "server" (one stub file per server, the default) or "tool" (one per tool), and the run limits
  code_mode_binding_level?: string,
  code_mode_limits?: CodeLimitsIn,
  // byte caps on the MCP server instructions forwarded to the model: per server (4096 when unset) and
  // for the whole set (16384 when unset); a client's max_instructions_length overrides the first
  max_instructions_per_client?: int,
  max_instructions_total?: int,
}

// The per-user headers a virtual key submitted for one client; undefined when it has submitted none.
export function userHeadersOf(creds: McpUserCredential[] | undefined, client: string, vk: string): Map<string, string> | undefined {
  const list = creds ?? []
  for (const c of list) {
    if (c.mcp_client_name === client && c.virtual_key_id === vk) return c.headers
  }
  return undefined
}

// The names of the clients whose auth_type is per_user_oauth.
export function perUserOAuthNames(list: McpClientConfig[] | undefined): string[] {
  const out: string[] = []
  for (const c of list ?? []) {
    if (c.auth_type === "per_user_oauth") out.push(c.name)
  }
  return out
}

// The names of the clients whose auth_type is token_exchange.
export function tokenExchangeNames(list: McpClientConfig[] | undefined): string[] {
  const out: string[] = []
  for (const c of list ?? []) {
    if (c.auth_type === "token_exchange") out.push(c.name)
  }
  return out
}

// The admin discovery credential a token_exchange client was verified with ("" when none is kept). An expired
// credential, or one whose renewal was refused, reads as none: the client waits for a new verification. nowMs
// is epoch milliseconds.
export function adminTokenOf(list: McpUserToken[] | undefined, client: string, nowMs: f64): string {
  for (const r of list ?? []) {
    if (r.mcp_client_name !== client) continue
    if (needsReverify(r)) return ""
    if (r.token_expires_at > 0.0 && r.token_expires_at <= nowMs) return ""
    return r.access_token
  }
  return ""
}

// The retained admin credential row of a token_exchange client, or undefined.
export function adminRowOf(list: McpUserToken[] | undefined, client: string): McpUserToken | undefined {
  for (const r of list ?? []) {
    if (r.mcp_client_name === client) return r
  }
  return undefined
}

// Renews a token_exchange client's admin credential after the server answered 401 to it (used is the refused token):
// the token to use, or "" when there is none. Set once by the gateway (the renewal saves the credential).
let adminRenew: ((client: string, used: string) => Promise<string>) | undefined = undefined

export function setAdminRenew(f: ((client: string, used: string) => Promise<string>) | undefined): void {
  adminRenew = f
}

// the error a token_exchange client shows while its admin credential needs a new verification
function reverifyError(row: McpUserToken): string {
  const why = row.status_reason ?? ""
  return `needs re-verification: ${why !== "" ? why : "the admin credential can no longer be renewed"}; verify it again with POST /api/mcp/client/{id}/verify-exchange`
}

// The names of the clients whose auth_type is per_user_headers.
export function perUserClientNames(list: McpClientConfig[] | undefined): string[] {
  const out: string[] = []
  for (const c of list ?? []) {
    if (c.auth_type === "per_user_headers") out.push(c.name)
  }
  return out
}

// A virtual key's MCP tool allow-list for one client (Bifrost's virtual_key_mcp_config). tools_to_execute:
// ["*"] every tool, [] none, a list only those tools.
export type McpKeyConfig = { mcp_client_name: string, tools_to_execute?: string[] }

// Milliseconds in a Go duration ("30s", "2m", "1m30s", "500ms"). A bare number counts seconds, as Bifrost
// reads it. 0 when unset or not a duration.
export function durationMsOf(s: string | undefined): int {
  if (s === undefined || s.trim() === "") return 0
  const cs = s.trim().chars()
  let i = 0
  let total = 0.0
  while (i < cs.length) {
    let num = ""
    while (i < cs.length && "0123456789.".includes(cs[i]!)) {
      num += cs[i]!
      i++
    }
    let unit = ""
    while (i < cs.length && !"0123456789.".includes(cs[i]!)) {
      unit += cs[i]!
      i++
    }
    const n = parseFloat(num)
    if (n === undefined) return 0
    const mult: f64 = unit === "" || unit === "s" ? 1000.0 : unit === "m" ? 60000.0 : unit === "h" ? 3600000.0 : unit === "ms" ? 1.0 : -1.0
    if (mult < 0.0) return 0
    total += n * mult
  }
  return Math.floor(total)
}

// Whether a key's mcp_configs lets it run a tool of one server. A key that declares no mcp_configs
// (undefined) is not limited here. A declared list judges the server by its entry; a server it does not
// name is allowed only when the server is allow_by_default.
export function keyRuleAllows(keys: McpKeyConfig[] | undefined, server: string, tool: string, allowByDefault: bool): bool {
  if (keys === undefined) return true
  for (const k of keys) {
    if (k.mcp_client_name !== server) continue
    const allow = k.tools_to_execute ?? []
    return allow.includes("*") || allow.includes(tool)
  }
  return allowByDefault
}

// The MCP access of the project a request names (Bifrost's project mcp_configs): its per-client tool lists,
// composed with the caller's own access by its access_rule ("union" adds to it, "intersect" caps it, anything
// else permits nothing). via is set when the call comes through a virtual MCP the project is assigned: the
// project's part then allows the call.
export type ProjectMcp = { rule: string, keys: McpKeyConfig[], via?: bool }

// Whether a project lets the caller run server's tool, given what the caller's own rules said. A project
// names a server by an entry (an empty list allows nothing there); a server it does not name gets nothing
// from it.
export function projectPass(p: ProjectMcp | undefined, server: string, tool: string, callerOk: bool): bool {
  if (p === undefined) return callerOk
  const projOk = p.via === true || (keyNamesClient(p.keys, server) && keyRuleAllows(p.keys, server, tool, false))
  if (p.rule === "union") return callerOk || projOk
  if (p.rule === "intersect") return callerOk && projOk
  return false
}

export type McpTool = { name: string, description: string, inputSchemaRaw: string }

export type RpcResult = { kind: "result", raw: string } | { kind: "error", code: int, message: string }

export type ToolText = { text: string, isError: bool }

const PROTOCOL = "2025-06-18"
const CONNECT_TIMEOUT_MS = 15000
const DEFAULT_TOOL_TIMEOUT_MS = 30000
// A server that keeps returning a cursor is cut off here.
const MAX_TOOL_PAGES = 100
// Bifrost's connection checker: the cadence of a healthy client's check (when no tool_sync_interval sets one),
// the tight one after a failed check, and the bound on each ping or listing
const HEALTHY_CHECK_SECONDS = 600
const UNSTABLE_CHECK_MS = 10000
const CHECK_TIMEOUT_MS = 5000
const EMPTY_SCHEMA = '{"type":"object","properties":{}}'
const NAME_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
const MAX_NAME = 64
// Request headers never forwarded to an MCP server, whatever its allowed_extra_headers says.
const FRAMING_HEADERS: string[] = ["host", "content-length", "connection", "transfer-encoding", "content-type", "accept", "mcp-session-id", "mcp-protocol-version"]

// Request ids are plain ints; a notification has no id.
export function initializeRequest(id: int): string {
  return `{"jsonrpc":"2.0","id":${id},"method":"initialize","params":{"protocolVersion":"${PROTOCOL}","capabilities":{},"clientInfo":{"name":"raiju","version":"0.1.0"}}}`
}

export function initializedNotification(): string {
  return '{"jsonrpc":"2.0","method":"notifications/initialized"}'
}

export function listToolsRequest(id: int, cursor?: string): string {
  const params = cursor === undefined ? "{}" : `{"cursor":${quote(cursor)}}`
  return `{"jsonrpc":"2.0","id":${id},"method":"tools/list","params":${params}}`
}

// Checks that text is one JSON object and returns it trimmed ("" means no arguments).
function objectText(text: string): string throws SyntaxError {
  const t = text.trim()
  if (t === "") return "{}"
  try fields(t)
  return t
}

// argumentsJson is the tool's arguments object as raw JSON text.
export function callToolRequest(id: int, name: string, argumentsJson: string): string throws SyntaxError {
  const args = try objectText(argumentsJson)
  return `{"jsonrpc":"2.0","id":${id},"method":"tools/call","params":{"name":${quote(name)},"arguments":${args}}}`
}

// The data of each SSE event in a body. The data lines of one event are joined by newlines.
function sseData(body: string): string[] {
  const out: string[] = []
  let cur: string[] = []
  for (const raw of body.split("\n")) {
    const line = raw.endsWith("\r") ? raw.slice(0, raw.byteLength - 1) : raw
    if (line === "") {
      if (cur.length > 0) out.push(cur.join("\n"))
      cur = []
    } else if (line.startsWith("data:")) {
      let v = line.slice(5)
      if (v.startsWith(" ")) v = v.slice(1)
      cur.push(v)
    }
  }
  if (cur.length > 0) out.push(cur.join("\n"))
  return out
}

// The JSON-RPC messages in a body: SSE events, a batch array, or the body itself.
function messageTexts(contentType: string, body: string): string[] {
  if (contentType.toLowerCase().indexOf("text/event-stream") >= 0) return sseData(body)
  const t = body.trim()
  if (t.startsWith("[")) return try elements(t)
  return [t]
}

// The reply to request `id` in one message, or undefined. Notifications and
// server requests carry a method, so they never match.
function matchMessage(text: string, id: int): RpcResult | undefined {
  try {
    const fs = fields(text)
    if (find(fs, "method") !== undefined) return undefined
    if (find(fs, "id") !== `${id}`) return undefined
    const result = find(fs, "result")
    if (result !== undefined) return { kind: "result", raw: result }
    const errRaw = find(fs, "error")
    if (errRaw !== undefined) {
      const ef = fields(errRaw)
      return { kind: "error", code: Math.floor(rawNum(ef, "code") ?? -32603), message: rawStr(ef, "message") ?? "unknown error" }
    }
    return undefined
  } catch (e) {
    return undefined
  }
}

// The reply to request `id`, from a plain JSON body or a text/event-stream body.
export function parseRpcResponse(contentType: string, body: string, id: int): RpcResult {
  let texts: string[] = []
  try {
    texts = messageTexts(contentType, body)
  } catch (e) {
    return { kind: "error", code: -32700, message: `invalid MCP response: ${e.message}` }
  }
  for (const t of texts) {
    const m = matchMessage(t, id)
    if (m !== undefined) return m
  }
  return { kind: "error", code: -32603, message: "MCP response had no reply to this request" }
}

// One page of a tools/list result.
export function parseTools(resultRaw: string): { tools: McpTool[], nextCursor?: string } throws SyntaxError {
  const fs = try fields(resultRaw)
  const tools: McpTool[] = []
  const list = find(fs, "tools")
  if (list !== undefined && !isNull(list)) {
    for (const el of try elements(list)) {
      const tf = try fields(el)
      const name = rawStr(tf, "name")
      if (name === undefined || name === "") continue
      const schema = find(tf, "inputSchema")
      tools.push({
        name: name,
        description: rawStr(tf, "description") ?? "",
        inputSchemaRaw: schema === undefined || isNull(schema) ? EMPTY_SCHEMA : schema,
      })
    }
  }
  const out: { tools: McpTool[], nextCursor?: string } = { tools: tools }
  const cursor = rawStr(fs, "nextCursor")
  if (cursor !== undefined && cursor !== "") out.nextCursor = cursor
  return out
}

// Replaces every byte outside [a-zA-Z0-9_-] with "_" and truncates to 64 bytes.
export function sanitizeName(s: string): string {
  const bytes = new TextEncoder().encode(s)
  let out = ""
  for (let i = 0; i < bytes.length; i++) {
    const c = int(bytes[i]!)
    // Only ASCII bytes are sliced, so every slice starts on a character boundary.
    out += c < 128 && NAME_CHARS.indexOf(s.slice(i, i + 1)) >= 0 ? s.slice(i, i + 1) : "_"
  }
  return out.slice(0, MAX_NAME)
}

// The name a tool has in chat: "<server>-<tool>", sanitized.
function chatName(server: string, tool: string): string {
  return sanitizeName(`${server}-${tool}`)
}

export function chatToolName(server: string, tool: string): string {
  return chatName(server, tool)
}

// The predicate that decides which of a session's tools a caller sees: the key's mcp_configs rules and
// the access profile's patterns, with allow_by_default for a client neither names.
function visibleTo(s: McpSession, policy: string[] | undefined, keys: McpKeyConfig[] | undefined, proj?: ProjectMcp): (orig: string, chat: string) => bool {
  const name = s.cfg.name
  const byDefault = s.cfg.allow_by_default === true
  const ks: McpKeyConfig[] = keys ?? []
  const pol: string[] = policy ?? []
  const keyNamed = keys !== undefined && keyNamesClient(ks, name)
  let polNamed = false
  if (policy !== undefined) polNamed = namesClient(pol, name)
  return (orig: string, chat: string): bool => {
    const keyOk = keys === undefined || (keyNamed ? keyRuleAllows(ks, name, orig, byDefault) : byDefault)
    const polOk = policy === undefined || (polNamed ? pol.some((p) => patternMatches(chat, p)) : byDefault)
    return projectPass(proj, name, orig, keyOk && polOk)
  }
}

// Bifrost's allow and skip lists. An empty allow list (or "*") exposes every tool.
function toolAllowed(name: string, cfg: McpClientConfig): bool {
  const allow = cfg.tools_to_execute ?? []
  if (allow.length > 0 && !allow.includes("*") && !allow.includes(name)) return false
  return !(cfg.tools_to_skip ?? []).includes(name)
}

// The instructions of an initialize result, "" when it has none.
export function instructionsOf(resultRaw: string): string {
  try {
    return rawStr(fields(resultRaw), "instructions") ?? ""
  } catch (e) {
    return ""
  }
}

// One OpenAI tool definition.
function toolJson(name: string, t: McpTool): string {
  return `{"type":"function","function":{"name":${quote(name)},"description":${quote(t.description)},"parameters":${t.inputSchemaRaw}}}`
}

// OpenAI tool definitions for the tools this server exposes.
export function toolsForChat(server: string, tools: McpTool[], cfg: McpClientConfig): string[] {
  const out: string[] = []
  for (const t of tools) {
    if (!toolAllowed(t.name, cfg)) continue
    out.push(toolJson(chatName(server, t.name), t))
  }
  return out
}

// Whether a chat tool name matches one pattern of an access profile: "*", "<server>-*" or "<server>-<tool>".
export function patternMatches(name: string, pattern: string): bool {
  if (pattern === "*") return true
  if (pattern.endsWith("*")) return name.startsWith(pattern.slice(0, pattern.byteLength - 1))
  return name === pattern
}

// Whether an access profile's tool patterns name a client at all: "*" names every client.
export function namesClient(policy: string[], server: string): bool {
  return policy.some((p) => p === "*" || p.startsWith(server + "-"))
}

// Seconds in a Go duration as tool_sync_interval takes it ("0", "90s", "10m", "1h30m"). 0 when unset.
export function syncSeconds(s: string | undefined): int {
  if (s === undefined) return 0
  let total = 0
  let digits = ""
  for (const ch of s.chars()) {
    if ("0123456789".includes(ch)) {
      digits += ch
      continue
    }
    const n = parseInt(digits) ?? 0
    total += ch === "h" ? n * 3600 : ch === "m" ? n * 60 : n
    digits = ""
  }
  return total + (parseInt(digits) ?? 0)
}

// The chat-name patterns of a list of mcp_configs: "<client>-*" for "*", "<client>-<tool>" for each
// listed tool. An entry with no tools contributes nothing.
export function keyPatterns(keys: McpKeyConfig[]): string[] {
  const out: string[] = []
  for (const k of keys) {
    for (const t of k.tools_to_execute ?? []) out.push(t === "*" ? `${k.mcp_client_name}-*` : `${k.mcp_client_name}-${t}`)
  }
  return out
}

// Whether a key's mcp_configs has an entry for the client.
export function keyNamesClient(keys: McpKeyConfig[], server: string): bool {
  return keys.some((k) => k.mcp_client_name === server)
}

// The auto-execute patterns of every client's tools_to_auto_execute, for the MCP agent: "<server>-<tool>",
// or "<server>-*" for "*". Clients add to the global client.mcp_auto_execute list.
export function autoExecutePatterns(clients: McpClientConfig[]): string[] {
  const out: string[] = []
  for (const c of clients) {
    for (const t of c.tools_to_auto_execute ?? []) {
      out.push(t === "*" ? sanitizeName(c.name) + "-*" : chatName(c.name, t))
    }
  }
  return out
}

// The name of a tool definition, or undefined when it has none.
function toolName(json: string): string | undefined throws SyntaxError {
  const fs = try fields(json)
  const fnRaw = find(fs, "function")
  if (fnRaw === undefined || isNull(fnRaw)) return undefined
  return rawStr(try fields(fnRaw), "name")
}

// Appends tool definitions to a chat request's tools array, skipping names it already
// has. A request with nothing to add is returned unchanged; otherwise the other fields
// keep their raw values.
export function injectTools(chatBody: string, toolJsons: string[]): string throws SyntaxError {
  let fs = try fields(chatBody)
  const have: string[] = []
  const out: string[] = []
  const existing = find(fs, "tools")
  if (existing !== undefined && !isNull(existing)) {
    for (const el of try elements(existing)) {
      out.push(el)
      const n = try toolName(el)
      if (n !== undefined) have.push(n)
    }
  }
  let added = 0
  for (const tj of toolJsons) {
    const n = try toolName(tj)
    if (n === undefined || have.includes(n)) continue
    have.push(n)
    out.push(tj)
    added += 1
  }
  if (added === 0) return chatBody
  setField(&fs, "tools", "[" + out.join(",") + "]")
  return build(fs)
}

// Splits "<server>-<tool>" into its parts. When several server names fit, the longest wins.
export function splitToolName(full: string, servers: string[]): { server: string, tool: string } | undefined {
  let best: { server: string, tool: string } | undefined = undefined
  let bestLen = 0
  for (const s of servers) {
    const prefix = sanitizeName(s) + "-"
    const len = prefix.byteLength
    if (full.startsWith(prefix) && full.byteLength > len && len > bestLen) {
      best = { server: s, tool: full.slice(len) }
      bestLen = len
    }
  }
  return best
}

// One content item of a tool result, as text. Non-text items are described in brackets.
function contentText(raw: string): string throws SyntaxError {
  const p = try fields(raw)
  const type = rawStr(p, "type") ?? ""
  if (type === "text") return rawStr(p, "text") ?? ""
  if (type === "image" || type === "audio") return `[${type} ${rawStr(p, "mimeType") ?? "unknown"}]`
  if (type === "resource") {
    const rf = try fields(find(p, "resource") ?? "{}")
    const text = rawStr(rf, "text")
    if (text !== undefined) return text
    return `[resource ${rawStr(rf, "uri") ?? ""} ${rawStr(rf, "mimeType") ?? ""}]`
  }
  return `[${type === "" ? "content" : type}]`
}

// The text of a tools/call result. Parts are joined by newlines.
export function toolResultText(resultRaw: string): ToolText throws SyntaxError {
  const fs = try fields(resultRaw)
  const parts: string[] = []
  const content = find(fs, "content")
  if (content !== undefined && !isNull(content)) {
    for (const el of try elements(content)) parts.push(try contentText(el))
  }
  return { text: parts.join("\n"), isError: rawBool(fs, "isError") ?? false }
}

// The chat message that answers a tool call.
export function toolMessage(callId: string, result: string): string {
  return `{"role":"tool","tool_call_id":${quote(callId)},"content":${quote(result)}}`
}

// The body of POST /v1/mcp/tool/execute: one OpenAI-style tool call. The arguments may be
// a JSON string (OpenAI's form) or an object. callId is the call's id, when it has one.
export function executeEndpointBody(body: string): { name: string, argumentsJson: string, callId?: string } throws SyntaxError {
  const fs = try fields(body)
  const type = rawStr(fs, "type")
  if (type !== undefined && type !== "function") throw new SyntaxError(`unsupported tool call type ${type}`)
  const fnRaw = find(fs, "function")
  if (fnRaw === undefined || isNull(fnRaw)) throw new SyntaxError("tool call has no function")
  const fn = try fields(fnRaw)
  const name = rawStr(fn, "name")
  if (name === undefined || name === "") throw new SyntaxError("tool call has no name")
  const argsRaw = find(fn, "arguments")
  let argsText = "{}"
  if (argsRaw !== undefined && !isNull(argsRaw)) {
    argsText = argsRaw.startsWith('"') ? try decodeString(argsRaw) : argsRaw
  }
  const out: { name: string, argumentsJson: string, callId?: string } = { name: name, argumentsJson: try objectText(argsText) }
  const callId = rawStr(fs, "id")
  if (callId !== undefined) out.callId = callId
  return out
}

type Reply = { status: int, contentType: string, body: string }

// The stdio transport: one JSON-RPC message per line, both ways, on a child process.
class StdioChannel {
  sock: Socket<undefined> | undefined = undefined
  private buf = ""
  private waiting: Map<int, (line: string) => void> = new Map()
  private dec: TextDecoder | undefined = undefined
  closed = false

  async open(name: string, cmd: string[], env: Map<string, string>, cwd: string): Promise<void> throws Error {
    try {
      this.dec = new TextDecoder()
    } catch (e) {
      this.dec = undefined
    }
    const self = this
    const envRec: Record<string, string> = env
    try {
      this.sock = await Bun.spawnSocket({
        cmd: cmd,
        env: envRec,
        cwd: cwd,
        socket: {
          data(sock, bytes) {
            self.onData(bytes)
          },
          close(sock) {
            self.onClose()
          },
        },
      })
    } catch (e) {
      throw new Error(`${name}: could not start ${cmd[0] ?? ""}: ${e.message}`)
    }
  }

  private onData(bytes: u8[]): void {
    const d = this.dec
    if (d === undefined) return
    try {
      this.buf += d.decode(bytes, { stream: true })
    } catch (e) {
      return
    }
    while (true) {
      const nl = this.buf.indexOf("\n")
      if (nl < 0) break
      const line = this.buf.slice(0, nl).trim()
      this.buf = this.buf.slice(nl + 1)
      if (line === "") continue
      // only replies are of interest; the server's own requests and notifications are ignored
      let id = -1
      try {
        const fs = fields(line)
        if (find(fs, "method") !== undefined) continue
        id = Math.floor(rawNum(fs, "id") ?? -1)
      } catch (e) {
        continue
      }
      const w = this.waiting.get(id)
      if (w !== undefined) {
        this.waiting.delete(id)
        w(line)
      }
    }
  }

  private onClose(): void {
    this.closed = true
    const ws = this.waiting
    this.waiting = new Map()
    for (const k of ws.keys()) ws.get(k)!("")
  }

  async request(body: string, id: int, timeoutMs: int): Promise<string> throws Error {
    const s = this.sock
    if (s === undefined || this.closed) throw new Error("the server process has exited")
    const p = new Promise<string>((resolve) => {
      this.waiting.set(id, resolve)
    })
    const t = setTimeout(() => {
      const w = this.waiting.get(id)
      if (w !== undefined) {
        this.waiting.delete(id)
        w("")
      }
    }, timeoutMs)
    s.write(body + "\n")
    const line = await p
    clearTimeout(t)
    if (line === "") throw new Error(this.closed ? "the server process has exited" : "no reply in time")
    return line
  }

  send(body: string): void throws Error {
    const s = this.sock
    if (s === undefined || this.closed) throw new Error("the server process has exited")
    s.write(body + "\n")
  }

  stop(): void {
    const s = this.sock
    if (s !== undefined && !this.closed) s.end()
  }
}

// One connection to an MCP server. connect() initializes and lists every tool; a failure
// is kept in lastError and leaves connected false.
export class McpSession {
  tools: McpTool[] = []
  connected = false
  lastError = ""
  // the instructions the server sent with its initialize answer ("" when it sent none)
  instructions = ""
  private sessionId = ""
  private version = ""
  private nextId = 1
  // chat tool name → the server's name for the tool, for allowed tools only
  private exposed: Map<string, string> = new Map()

  readonly timeoutMs: int
  private tokens = new TokenCache()
  private stdio: StdioChannel | undefined = undefined
  // the OAuth token endpoint, from auth.token_url or the server's metadata
  private tokenUrl = ""

  // the hosts require_public_target lets through (oauth_private_allowlist)
  private allow: string[] = []
  // an openapi client: its document and the base URL its calls go to
  private openapi: OpenApiDoc | undefined = undefined
  private opBase = ""
  // base_url set the base (the operations' own servers are then not used)
  private opExplicit = false

  // the config this session runs with; follow() swaps in a changed tool policy for a kept stdio process
  cfg: McpClientConfig
  // a token_exchange client's admin discovery credential: its tools are listed with it (see adminTokenOf)
  adminToken = ""
  // the retained row behind it (its expiry, renewal state), for the status view
  adminRow: McpUserToken | undefined = undefined

  // timeoutMs bounds each tool call unless the client has its own tool_execution_timeout.
  constructor(cfg: McpClientConfig, timeoutMs?: int, allowList?: string[]) {
    this.cfg = cfg
    const own = durationMsOf(cfg.tool_execution_timeout)
    this.timeoutMs = own > 0 ? own : timeoutMs ?? DEFAULT_TOOL_TIMEOUT_MS
    this.allow = allowList ?? []
    // the tokens the authorization code flow saved on the client
    const a = cfg.auth
    if (a !== undefined && a.type === "oauth" && (a.access_token ?? "") !== "") this.tokens.seed(cfg.name, a.access_token ?? "", a.token_expires_at ?? 0.0, a.refresh_token ?? "")
  }

  private newId(): int {
    const id = this.nextId
    this.nextId += 1
    return id
  }

  // The request headers a tool call may forward to this server: those its allowed_extra_headers names
  // ("*" for all). The headers that frame the HTTP exchange or the protocol are never forwarded.
  private forwardable(extra: Map<string, string> | undefined): Map<string, string> | undefined {
    if (extra === undefined) return undefined
    const allowed = this.cfg.allowed_extra_headers ?? []
    if (allowed.length === 0) return undefined
    const out: Map<string, string> = new Map()
    for (const k of extra.keys()) {
      const lk = k.toLowerCase()
      if (FRAMING_HEADERS.includes(lk)) continue
      if (allowed.includes("*") || allowed.some((a) => a.toLowerCase() === lk)) out.set(lk, extra.get(k)!)
    }
    return out
  }

  // Headers for one POST. The configured headers go first so the protocol headers win.
  private headers(extra?: Map<string, string>): Map<string, string> {
    const h: Map<string, string> = new Map()
    const cfgHeaders = this.cfg.headers
    if (cfgHeaders !== undefined) {
      for (const k of cfgHeaders.keys()) h.set(k.toLowerCase(), cfgHeaders.get(k)!)
    }
    if (extra !== undefined) {
      for (const k of extra.keys()) h.set(k, extra.get(k)!)
    }
    const a = this.cfg.auth
    if (a !== undefined) {
      const sh = staticHeaders(a)
      for (const k of sh.keys()) h.set(k, sh.get(k)!)
      const bearer = this.tokens.header(this.cfg.name, Date.now())
      if (bearer !== undefined) h.set("authorization", bearer)
    }
    if (this.cfg.auth_type === "token_exchange" && this.adminToken !== "") h.set("authorization", "Bearer " + this.adminToken)
    h.set("content-type", "application/json")
    h.set("accept", "application/json, text/event-stream")
    if (this.sessionId !== "") h.set("mcp-session-id", this.sessionId)
    if (this.version !== "") h.set("mcp-protocol-version", this.version)
    return h
  }

  private isOAuth(): bool {
    const t = this.cfg.auth?.type
    return t === "oauth_client_credentials" || t === "oauth_refresh_token" || t === "oauth"
  }

  // Gets an OAuth access token (client credentials, or the refresh token), finding the
  // token endpoint in the server's authorization metadata when none is configured.
  private async fetchToken(): Promise<void> throws Error {
    const a = this.cfg.auth
    if (a === undefined) return
    if (this.tokenUrl === "") this.tokenUrl = a.token_url ?? ""
    if (this.tokenUrl === "") {
      const urls = discoveryUrls(this.cfg.connection_string ?? "")
      if (urls.length < 2) throw new Error(`${this.cfg.name}: no token_url and no metadata URL`)
      // the discovery chain reaches public addresses only, or those in oauth_private_allowlist (Bifrost's
      // SSRF-hardened OAuth discovery client)
      const pr = await resolvedTargetProblem(urls[1]!, this.allow)
      if (pr !== "") throw new Error(`${this.cfg.name}: OAuth metadata: ${pr} (add the host to oauth_private_allowlist to allow it)`)
      const dl = deadline(CONNECT_TIMEOUT_MS)
      try {
        const r = await fetch(urls[1]!, { signal: dl.controller.signal })
        this.tokenUrl = parseAuthServerMetadata(await r.text()).token_endpoint
      } catch (e) {
        throw new Error(`${this.cfg.name}: OAuth metadata: ${e.message}`)
      } finally {
        dl.finish()
      }
    }
    const refresh = a.type === "oauth_refresh_token" || a.type === "oauth"
    const rt = this.tokens.refreshToken(this.cfg.name)
    // an authorization code client has no grant of its own: the flow must run first
    if (a.type === "oauth" && rt === undefined) throw new Error(`${this.cfg.name}: not authorized yet: run the OAuth flow (initiate-verification)`)
    let req = a
    req.token_url = this.tokenUrl
    if (refresh && rt !== undefined) req.refresh_token = rt
    const tr = try tokenRequest(req)
    const dl = deadline(CONNECT_TIMEOUT_MS)
    try {
      const hs: Record<string, string> = tr.headers
      const r = await fetch(tr.url, { method: "POST", headers: hs, body: tr.body, signal: dl.controller.signal })
      const text = await r.text()
      if (r.status < 200 || r.status >= 300) throw new Error(`HTTP ${r.status}`)
      this.tokens.store(this.cfg.name, text, Date.now())
    } catch (e) {
      throw new Error(`${this.cfg.name}: OAuth token request failed: ${e.message}`)
    } finally {
      dl.finish()
    }
  }

  // POSTs one message, with an OAuth token when the server needs one: fetched first if
  // missing, and once more after a 401. A token_exchange client's admin credential is renewed after a 401.
  private async exchange(body: string, timeoutMs: int, extra?: Map<string, string>): Promise<Reply> throws Error {
    if (this.isOAuth() && this.tokens.header(this.cfg.name, Date.now()) === undefined) try await this.fetchToken()
    const first = try await this.send(body, timeoutMs, extra)
    if (first.status === 401 && this.cfg.auth_type === "token_exchange" && this.adminToken !== "") {
      const renew = adminRenew
      if (renew === undefined) return first
      const used = this.adminToken
      const fresh = await renew(this.cfg.name, used)
      if (fresh === "" || fresh === used) return first
      this.adminToken = fresh
      return try await this.send(body, timeoutMs, extra)
    }
    if (first.status !== 401 || !this.isOAuth()) return first
    this.tokens.invalidate(this.cfg.name)
    try await this.fetchToken()
    return try await this.send(body, timeoutMs, extra)
  }

  // POSTs one message under a deadline. The session id from the server is kept for later requests.
  private async send(body: string, timeoutMs: int, extra?: Map<string, string>): Promise<Reply> throws Error {
    // require_public_target: every dial must reach a public address, checked on each request
    if (this.cfg.require_public_target === true) {
      const pr = await resolvedTargetProblem(this.cfg.connection_string ?? "", this.allow)
      if (pr !== "") throw new Error(`${this.cfg.name}: ${pr}`)
    }
    const dl = deadline(timeoutMs)
    let reply: Reply = { status: 0, contentType: "", body: "" }
    try {
      const hs: Record<string, string> = this.headers(extra)
      const res = await fetch(this.cfg.connection_string ?? "", { method: "POST", headers: hs, body: body, signal: dl.controller.signal })
      const sid = res.headers.get("mcp-session-id") ?? ""
      if (sid !== "") this.sessionId = sid
      const text = await res.text()
      reply = { status: res.status, contentType: res.headers.get("content-type") ?? "", body: text }
    } catch (e) {
      throw new Error(`${this.cfg.name}: request failed: ${e.message}`)
    } finally {
      dl.finish()
    }
    return reply
  }

  // A request: returns the raw result, or throws on HTTP and JSON-RPC errors.
  private async rpc(body: string, id: int, timeoutMs: int, extra?: Map<string, string>): Promise<string> throws Error {
    const ch = this.stdio
    if (ch !== undefined) {
      let line = ""
      try {
        line = await ch.request(body, id, timeoutMs)
      } catch (e) {
        throw new Error(`${this.cfg.name}: ${e.message}`)
      }
      const r = parseRpcResponse("application/json", line, id)
      if (r.kind === "error") throw new Error(`${this.cfg.name}: ${r.message} (code ${r.code})`)
      return r.raw
    }
    const reply = try await this.exchange(body, timeoutMs, extra)
    if (reply.status < 200 || reply.status >= 300) throw new Error(`${this.cfg.name}: HTTP ${reply.status}`)
    const r = parseRpcResponse(reply.contentType, reply.body, id)
    if (r.kind === "error") throw new Error(`${this.cfg.name}: ${r.message} (code ${r.code})`)
    return r.raw
  }

  // A notification: no reply body is expected.
  private async notify(body: string, extra?: Map<string, string>): Promise<void> throws Error {
    const ch = this.stdio
    if (ch !== undefined) {
      try {
        ch.send(body)
      } catch (e) {
        throw new Error(`${this.cfg.name}: ${e.message}`)
      }
      return
    }
    const reply = try await this.exchange(body, CONNECT_TIMEOUT_MS, extra)
    if (reply.status < 200 || reply.status >= 300) throw new Error(`${this.cfg.name}: HTTP ${reply.status} for notification`)
  }

  async connect(): Promise<void> {
    this.connected = false
    this.lastError = ""
    this.sessionId = ""
    this.version = ""
    if (this.cfg.disabled === true) {
      this.lastError = "disabled"
      return
    }
    // a token_exchange client lists its tools with the admin credential its verification kept; without one it waits
    if (this.cfg.auth_type === "token_exchange" && this.adminToken === "") {
      this.lastError = this.awaitingError()
      return
    }
    try {
      const transport = this.cfg.connection_type
      if (transport !== "http" && transport !== "sse" && transport !== "stdio" && transport !== "openapi") throw new Error(`unsupported connection type ${transport}`)
      if (transport === "openapi") {
        await this.loadOpenApi()
        this.connected = true
        return
      }
      if (transport === "stdio") {
        const sc = this.cfg.stdio_config
        if (sc === undefined || sc.command === "") throw new Error("stdio needs stdio_config.command")
        const old = this.stdio
        if (old !== undefined) old.stop()
        const ch = new StdioChannel()
        try await ch.open(this.cfg.name, [sc.command].concat(sc.args ?? []), sc.env ?? new Map(), sc.cwd ?? "")
        this.stdio = ch
      }
      const initId = this.newId()
      const initRaw = try await this.rpc(initializeRequest(initId), initId, CONNECT_TIMEOUT_MS)
      this.instructions = instructionsOf(initRaw)
      // From here on the protocol version is sent with every request.
      this.version = PROTOCOL
      try await this.notify(initializedNotification())
      try await this.listAll()
      this.connected = true
    } catch (e) {
      this.connected = false
      this.lastError = this.cfg.auth_type === "token_exchange" && this.adminToken === "" ? this.awaitingError() : e.message
    }
  }

  // Lists every page of the server's tools and sets the ones this session exposes.
  private async listAll(): Promise<void> throws Error {
    const all: McpTool[] = []
    let cursor: string | undefined = undefined
    for (let page = 0; page < MAX_TOOL_PAGES; page++) {
      const id = this.newId()
      const raw = try await this.rpc(listToolsRequest(id, cursor), id, CONNECT_TIMEOUT_MS)
      const got = try parseTools(raw)
      for (const t of got.tools) all.push(t)
      cursor = got.nextCursor
      if (cursor === undefined) break
    }
    this.tools = all
    const ex: Map<string, string> = new Map()
    for (const t of all) {
      if (toolAllowed(t.name, this.cfg)) ex.set(chatName(this.cfg.name, t.name), t.name)
    }
    this.exposed = ex
  }

  // Reads an openapi client's document (its spec, or spec_url fetched now) and makes each operation a tool.
  private async loadOpenApi(): Promise<void> throws Error {
    const oc = this.cfg.openapi_config
    if (oc === undefined) throw new Error(`${this.cfg.name}: openapi_config is required for an openapi connection`)
    let text = oc.spec ?? ""
    const specUrl = oc.spec_url ?? ""
    const specFile = oc.spec_file ?? ""
    // a spec_file (config.json only) is read from the config file's folder, and must stay inside it
    if (text === "" && specFile.trim() !== "") {
      const p = specFilePath(specFile, specBaseDir)
      if (p === "") throw new Error(`${this.cfg.name}: spec_file "${specFile}" resolves outside the config directory`)
      try {
        text = readFileSync(p, "utf8")
      } catch (e) {
        throw new Error(`${this.cfg.name}: spec_file "${specFile}": ${e.message}`)
      }
    }
    if (text === "" && specUrl !== "") {
      if (this.cfg.require_public_target === true) {
        const pr = await resolvedTargetProblem(specUrl, this.allow)
        if (pr !== "") throw new Error(`${this.cfg.name}: ${pr}`)
      }
      const dl = deadline(CONNECT_TIMEOUT_MS)
      try {
        const r = await fetch(specUrl, { signal: dl.controller.signal })
        if (r.status < 200 || r.status >= 300) throw new Error(`HTTP ${r.status}`)
        text = await r.text()
      } catch (e) {
        throw new Error(`${this.cfg.name}: OpenAPI spec: ${e.message}`)
      } finally {
        dl.finish()
      }
    }
    if (text === "") throw new Error(`${this.cfg.name}: openapi_config needs spec, spec_file or spec_url`)
    let doc: OpenApiDoc | undefined = undefined
    try {
      doc = try parseSpec(text, oc.include_deprecated === true, specUrl, this.cfg.name)
    } catch (e) {
      throw new Error(`${this.cfg.name}: ${e.message}`)
    }
    const d = doc!
    if (d.ops.length === 0) throw new Error(`${this.cfg.name}: no operation in the spec can be exposed as a tool`)
    const b = baseUrlOf(d, oc.base_url ?? "")
    if (b.base === "" && !operationServersCover(d)) throw new Error(`${this.cfg.name}: the spec declares no absolute server URL; set openapi_config.base_url`)
    this.openapi = d
    this.opBase = b.base
    this.opExplicit = b.explicit
    // the API's description serves as the server's instructions, as Bifrost's in-process server sends it
    this.instructions = specInstructions(d)
    const ts: McpTool[] = []
    const ex: Map<string, string> = new Map()
    for (const op of d.ops) {
      ts.push({ name: op.name, description: toolDescription(op), inputSchemaRaw: inputSchema(op) })
      if (toolAllowed(op.name, this.cfg)) ex.set(chatName(this.cfg.name, op.name), op.name)
    }
    this.tools = ts
    this.exposed = ex
  }

  // Calls one operation of an openapi client: the HTTP request it describes, with the configured credentials.
  private async callOpenApi(name: string, argsJson: string): Promise<ToolText> throws Error {
    const doc = this.openapi
    if (doc === undefined) throw new Error(`${this.cfg.name}: no OpenAPI document loaded`)
    let op: OpenApiOp | undefined = undefined
    for (const o of doc.ops) {
      if (o.name === name) op = o
    }
    if (op === undefined) throw new Error(`${this.cfg.name}: no operation ${name}`)
    const oc = this.cfg.openapi_config
    const creds: Map<string, OpenApiCred> = oc?.security_credentials ?? new Map()
    let req: OpRequest | undefined = undefined
    try {
      // the client's static headers go with each call, as Bifrost's header resolver sends them
      const conf: Map<string, string> = new Map()
      const ch = this.cfg.headers
      if (ch !== undefined) {
        for (const k of ch.keys()) conf.set(k.toLowerCase(), ch.get(k)!)
      }
      req = try requestFor(op, this.opBase, argsJson, doc, creds, conf, this.opExplicit)
    } catch (e) {
      return { text: e.message, isError: true }
    }
    if (this.cfg.require_public_target === true) {
      const pr = await resolvedTargetProblem(req!.url, this.allow)
      if (pr !== "") return { text: `${this.cfg.name}: ${pr}`, isError: true }
    }
    const r = try await callOperation(req!, this.timeoutMs, oc?.max_response_bytes ?? 0)
    return { text: r.text, isError: r.isError }
  }

  // Why a token_exchange client without an admin credential cannot list its tools.
  private awaitingError(): string {
    const row = this.adminRow
    if (row !== undefined && needsReverify(row)) return reverifyError(row)
    return "awaiting verification: the admin credential of this token_exchange client is missing or expired; verify it with POST /api/mcp/client/{id}/verify-exchange"
  }

  // Whether this token_exchange client's admin credential needs a new verification (Bifrost's needs_reauth).
  awaitingReverify(): bool {
    const row = this.adminRow
    return this.cfg.auth_type === "token_exchange" && row !== undefined && needsReverify(row)
  }

  // Whether calls connect fresh each time (Bifrost's per-call clients): an http client without session
  // stickiness, and the per-user and token exchange auth types.
  perCall(): bool {
    const t = this.cfg.auth_type ?? ""
    return (this.cfg.connection_type === "http" && this.cfg.needs_session_stickiness === false) || t === "per_user_oauth" || t === "per_user_headers" || t === "token_exchange"
  }

  // Re-reads the server's initialize instructions over a throwaway handshake; the live session is kept.
  async rereadInstructions(): Promise<void> throws Error {
    if (this.cfg.connection_type !== "http" && this.cfg.connection_type !== "sse") return
    const sid = this.sessionId
    const ver = this.version
    this.sessionId = ""
    this.version = ""
    try {
      const id = this.newId()
      const raw = try await this.rpc(initializeRequest(id), id, CHECK_TIMEOUT_MS)
      this.instructions = instructionsOf(raw)
    } finally {
      this.sessionId = sid
      this.version = ver
    }
  }

  // MCP ping (the health check of servers that offer it). Throws when the server does not answer.
  async ping(): Promise<void> throws Error {
    const id = this.newId()
    try await this.rpc(`{"jsonrpc":"2.0","id":${id},"method":"ping"}`, id, CHECK_TIMEOUT_MS)
  }

  // One check of Bifrost's connection checker. A connected sticky client is pinged (unless is_ping_available is
  // false) and its tools listed again; a failure reconnects it. A per-call client has no connection to ping: its
  // tools are listed (a failed listing keeps them, as before) and its instructions re-read. A client that is not
  // connected reconnects. True when the client ends up connected without an error.
  async check(): Promise<bool> {
    if (this.cfg.disabled === true) return true
    if (!this.connected) {
      await this.connect()
      return this.connected
    }
    if (this.perCall()) {
      await this.relist()
      if (this.lastError === "") {
        try {
          await this.rereadInstructions()
        } catch (e) {
          // best effort: the installed text stays
        }
      }
      return this.lastError === ""
    }
    try {
      if (this.cfg.is_ping_available !== false && this.cfg.connection_type !== "openapi") try await this.ping()
      if (this.cfg.connection_type === "openapi") try await this.loadOpenApi()
      else try await this.listAll()
      this.lastError = ""
      return true
    } catch (e) {
      this.lastError = e.message
    }
    await this.connect()
    return this.connected
  }

  // Lists the tools again (the periodic tool_sync_interval refresh). A failure keeps the tools it had; a
  // success clears the error an earlier one left. A token_exchange client without its admin credential keeps
  // its tools (each caller's calls still run with their own exchanged tokens) and says why it cannot list.
  async relist(): Promise<void> {
    if (!this.connected) return
    if (this.cfg.auth_type === "token_exchange" && this.adminToken === "") {
      this.lastError = this.awaitingError()
      return
    }
    try {
      if (this.cfg.connection_type === "openapi") {
        try await this.loadOpenApi()
      } else {
        try await this.listAll()
      }
      this.lastError = ""
    } catch (e) {
      // a renewal refused during this listing (after the server's 401) says so rather than "HTTP 401"
      this.lastError = this.cfg.auth_type === "token_exchange" && this.adminToken === "" ? this.awaitingError() : e.message
    }
  }

  // The chat tool definitions for this server's allowed tools.
  chatTools(): string[] {
    return toolsForChat(this.cfg.name, this.tools, this.cfg)
  }

  // The chat tool definitions of this server's allowed tools that keep accepts, given the server's
  // name for the tool and its chat name.
  toolsWhere(keep: (orig: string, chat: string) => bool): string[] {
    const out: string[] = []
    for (const t of this.tools) {
      if (!toolAllowed(t.name, this.cfg)) continue
      const n = chatName(this.cfg.name, t.name)
      if (!keep(t.name, n)) continue
      out.push(toolJson(n, t))
    }
    return out
  }

  // The chat tool definitions of this server's allowed tools whose chat names keep accepts.
  chatToolsWhere(keep: (name: string) => bool): string[] {
    const out: string[] = []
    for (const t of this.tools) {
      if (!toolAllowed(t.name, this.cfg)) continue
      const n = chatName(this.cfg.name, t.name)
      if (!keep(n)) continue
      out.push(toolJson(n, t))
    }
    return out
  }

  // The server's name for a chat tool name, if this session exposes it.
  original(chatToolName: string): string | undefined {
    for (const t of this.tools) {
      if (toolAllowed(t.name, this.cfg) && chatName(this.cfg.name, t.name) === chatToolName) return t.name
    }
    return undefined
  }

  exposedNames(): string[] {
    return this.exposed.keys()
  }

  exposedCount(): int {
    return this.exposed.size
  }

  // Re-applies this client's tool policy to the tools already listed, without a new listing.
  applyPolicy(): void {
    const ex: Map<string, string> = new Map()
    for (const t of this.tools) {
      if (toolAllowed(t.name, this.cfg)) ex.set(chatName(this.cfg.name, t.name), t.name)
    }
    this.exposed = ex
  }

  // Every tool the server listed, by its own name, with whether this client's config allows it (the
  // management UI turns tools on and off through tools_to_skip and tools_to_execute).
  toolStates(): { name: string, allowed: bool }[] {
    const out: { name: string, allowed: bool }[] = []
    for (const t of this.tools) out.push({ name: t.name, allowed: toolAllowed(t.name, this.cfg) })
    return out
  }

  // A tool call of a per_user_oauth client with the calling key's own token. Each call opens a fresh session
  // (initialize with that token), so no session id is shared between callers and the admin's token is not
  // sent. A 401 throws "HTTP 401", which the gateway answers by refreshing the caller's token.
  async callAsUser(name: string, argsJson: string, extra: Map<string, string> | undefined, bearer: string): Promise<ToolText> throws Error {
    if (!this.connected) throw new Error(`${this.cfg.name}: not connected: ${this.lastError}`)
    const hs: Map<string, string> = new Map()
    const cfgHeaders = this.cfg.headers
    if (cfgHeaders !== undefined) {
      for (const k of cfgHeaders.keys()) hs.set(k.toLowerCase(), cfgHeaders.get(k)!)
    }
    const fwd = this.forwardable(extra)
    if (fwd !== undefined) {
      for (const k of fwd.keys()) hs.set(k, fwd.get(k)!)
    }
    hs.set("authorization", "Bearer " + bearer)
    hs.set("content-type", "application/json")
    hs.set("accept", "application/json, text/event-stream")
    const initId = this.newId()
    const init = try await this.postAs(hs, initializeRequest(initId), CONNECT_TIMEOUT_MS, initId)
    const sid = init.sid
    hs.set("mcp-protocol-version", PROTOCOL)
    if (sid !== "") hs.set("mcp-session-id", sid)
    try await this.postAs(hs, initializedNotification(), CONNECT_TIMEOUT_MS, -1)
    const id = this.newId()
    const body = try callToolRequest(id, name, argsJson)
    const reply = try await this.postAs(hs, body, this.timeoutMs, id)
    const r = parseRpcResponse(reply.contentType, reply.body, id)
    if (r.kind === "error") throw new Error(`${this.cfg.name}: ${r.message} (code ${r.code})`)
    return try toolResultText(r.raw)
  }

  // One POST for callAsUser under the given headers. A non-2xx answer throws "HTTP <status>". id is the
  // request whose reply is parsed (-1 for a notification, which has none).
  private async postAs(base: Map<string, string>, body: string, timeoutMs: int, id: int): Promise<UserReply> throws Error {
    if (this.cfg.require_public_target === true) {
      const pr = await resolvedTargetProblem(this.cfg.connection_string ?? "", this.allow)
      if (pr !== "") throw new Error(`${this.cfg.name}: ${pr}`)
    }
    const hs: Record<string, string> = base
    const dl = deadline(timeoutMs)
    let out: UserReply = { status: 0, contentType: "", body: "", sid: "" }
    try {
      const res = await fetch(this.cfg.connection_string ?? "", { method: "POST", headers: hs, body: body, signal: dl.controller.signal })
      const text = await res.text()
      out = { status: res.status, contentType: res.headers.get("content-type") ?? "", body: text, sid: res.headers.get("mcp-session-id") ?? "" }
    } catch (e) {
      throw new Error(`${this.cfg.name}: request failed: ${e.message}`)
    } finally {
      dl.finish()
    }
    if (out.status < 200 || out.status >= 300) throw new Error(`${this.cfg.name}: HTTP ${out.status}`)
    if (id >= 0) {
      const r = parseRpcResponse(out.contentType, out.body, id)
      if (r.kind === "error") throw new Error(`${this.cfg.name}: ${r.message} (code ${r.code})`)
    }
    return out
  }

  // Calls a tool by its name on the server. Tool failures come back as isError; protocol failures throw.
  // extra holds the caller's request headers; only those allowed_extra_headers names are sent. An http
  // client with needs_session_stickiness false opens a fresh session (initialize) before each call.
  // user holds the calling virtual key's per-user headers. A per_user_headers client takes only those, and
  // a call without them is refused.
  async callTool(name: string, argsJson: string, extra?: Map<string, string>, user?: Map<string, string>): Promise<ToolText> throws Error {
    if (!this.connected) throw new Error(`${this.cfg.name}: not connected: ${this.lastError}`)
    if (this.cfg.connection_type === "openapi") return try await this.callOpenApi(name, argsJson)
    let sent = this.forwardable(extra)
    if (this.cfg.auth_type === "per_user_headers") {
      if (user === undefined) throw new Error(`${this.cfg.name}: the per-user headers of this key are not submitted`)
      const own: Map<string, string> = sent ?? new Map()
      for (const k of user.keys()) own.set(k, user.get(k)!)
      sent = own
    }
    if (this.cfg.connection_type === "http" && this.cfg.needs_session_stickiness === false) {
      this.sessionId = ""
      this.version = ""
      const initId = this.newId()
      const initRaw = try await this.rpc(initializeRequest(initId), initId, CONNECT_TIMEOUT_MS, sent)
      // each fresh handshake brings the server's current instructions
      this.instructions = instructionsOf(initRaw)
      this.version = PROTOCOL
      try await this.notify(initializedNotification(), sent)
    }
    const id = this.newId()
    const body = try callToolRequest(id, name, argsJson)
    const raw = try await this.rpc(body, id, this.timeoutMs, sent)
    return try toolResultText(raw)
  }
}

// One finished tool execution, for the request log (kind "mcp"). cost is the tool's tool_pricing price, for a
// call that returned (what the caller's budgets are debited).
export type McpToolCall = { server: string, tool: string, latencyMs: f64, ok: bool, error: string, cost?: f64 }

let toolLog: ((c: McpToolCall) => void) | undefined = undefined

// Set once by the ops layer: every tool execution is handed to it after it finishes.
export function setMcpToolLog(f: ((c: McpToolCall) => void) | undefined): void {
  toolLog = f
}

function reportTool(c: McpToolCall): void {
  const f = toolLog
  if (f === undefined) return
  try {
    f(c)
  } catch (e) {
    // logging must not fail the tool call
  }
}

// All configured MCP servers: connects them, offers their tools to chat and routes tool calls.
export class McpManager {
  sessions: McpSession[]
  // the connection checker's timers, one per enabled client (syncTimers lists them)
  syncTimers: int[] = []
  private checkTimers: Map<string, int> = new Map()
  private syncGen = 0

  // Follows a changed config. Each client takes the session of list, which carries the new config
  // (and the tokens an OAuth flow saved); connectNew() connects those. A stdio client keeps its
  // running process; a client removed from the config is dropped.
  follow(list: McpSession[]): void {
    const keep: McpSession[] = []
    for (const n of list) {
      let kept: McpSession | undefined = undefined
      for (const s of this.sessions) {
        if (s.cfg.name !== n.cfg.name) continue
        // a stdio server keeps its process; an unchanged HTTP client keeps its connection and tools,
        // so a config write elsewhere doesn't empty the tool list while it reconnects
        if (s.cfg.connection_type === "stdio") {
          // the kept process takes the saved tool policy, so a tool switched off or on applies now
          if (JSON.stringify(s.cfg) !== JSON.stringify(n.cfg)) {
            s.cfg = n.cfg
            s.applyPolicy()
          }
          kept = s
        } else if (JSON.stringify(s.cfg) === JSON.stringify(n.cfg) && s.adminToken === n.adminToken) {
          s.adminRow = n.adminRow
          kept = s
        } else if (JSON.stringify(s.cfg) === JSON.stringify(n.cfg) && n.cfg.auth_type === "token_exchange" && n.adminToken === "" && s.connected) {
          // the admin credential ran out or needs a new verification: the connected client keeps its tools and
          // each caller's calls, and only stops re-listing (as Bifrost's needs_reauth for per-user clients)
          s.adminToken = ""
          s.adminRow = n.adminRow
          kept = s
        }
      }
      keep.push(kept ?? n)
    }
    this.sessions = keep
  }

  // Connects the sessions that have not been tried yet (the clients added by a config change).
  async connectNew(): Promise<void> {
    await Promise.all(this.sessions.filter((s) => s.cfg.connection_type !== "stdio" && !s.connected && s.lastError === "").map((s) => s.connect()))
  }

  // the global tool_sync_interval, for clients with none of their own (0: no periodic re-list)
  private defaultSyncSecs: int = 0
  private allow: string[] = []
  private instrPerClient: int = 0
  private instrTotal: int = 0

  constructor(cfg: McpConfig) {
    const secs = cfg.tool_execution_timeout_seconds
    const ms: int = secs === undefined ? DEFAULT_TOOL_TIMEOUT_MS : secs * 1000
    const list = cfg.client_configs ?? []
    this.allow = cfg.oauth_private_allowlist ?? []
    this.defaultSyncSecs = syncSeconds(cfg.tool_sync_interval)
    this.instrPerClient = cfg.max_instructions_per_client ?? 0
    this.instrTotal = cfg.max_instructions_total ?? 0
    const admin = cfg.exchange_admin
    this.sessions = list.map((c) => {
      const s = new McpSession(c, ms, this.allow)
      s.adminToken = adminTokenOf(admin, c.name, Date.now())
      s.adminRow = adminRowOf(admin, c.name)
      return s
    })
  }

  // Takes a token_exchange client's renewed (or refused) admin credential in place, so the running session
  // keeps its connection: the next listing uses the new token, and a refused one stops the listing.
  setAdmin(row: McpUserToken): void {
    for (const s of this.sessions) {
      if (s.cfg.name !== row.mcp_client_name) continue
      // a session that waited for its credential is connectable now: clearing its error lets connectNew (run after the
      // config change that follows) connect it, as a session built from the saved config would be
      const waiting = s.adminToken === "" && !s.connected && s.lastError !== ""
      s.adminRow = row
      s.adminToken = needsReverify(row) ? "" : row.access_token
      if (needsReverify(row)) s.lastError = reverifyError(row)
      else if (waiting && s.adminToken !== "") s.lastError = ""
    }
  }

  // Connects every HTTP server. A server that fails is recorded in status(), not thrown.
  async connectAll(): Promise<void> {
    await Promise.all(this.sessions.filter((s) => s.cfg.connection_type !== "stdio").map((s) => s.connect()))
    this.startToolSync()
  }

  // Starts and connects the stdio servers. Called once the process serves (in every worker
  // after the fork), so each worker talks to its own server process.
  async connectStdio(): Promise<void> {
    await Promise.all(this.sessions.filter((s) => s.cfg.connection_type === "stdio").map((s) => s.connect()))
    this.startToolSync()
  }

  // Bifrost's connection checker, one per enabled client: every tool_sync_interval (the client's, else the global
  // one, else 10 minutes) the client is checked (see McpSession.check: ping, tool list, reconnect); after a failed
  // check the next one comes in 10 seconds. Clears the timers it had, so a changed interval applies when this
  // runs again.
  startToolSync(): void {
    this.stopToolSync()
    this.syncGen += 1
    const gen = this.syncGen
    for (const s of this.sessions) {
      if (s.cfg.disabled === true) continue
      this.scheduleCheck(s, gen, this.healthyMs(s))
    }
  }

  private healthyMs(s: McpSession): int {
    const own = syncSeconds(s.cfg.tool_sync_interval)
    const secs = own > 0 ? own : this.defaultSyncSecs > 0 ? this.defaultSyncSecs : HEALTHY_CHECK_SECONDS
    return secs * 1000
  }

  private scheduleCheck(s: McpSession, gen: int, ms: int): void {
    const name = s.cfg.name
    const t = setTimeout(() => {
      this.runCheck(s, gen)
    }, ms)
    this.checkTimers.set(name, t)
    this.syncTimers = this.checkTimers.values()
  }

  private async runCheck(s: McpSession, gen: int): Promise<void> {
    if (gen !== this.syncGen || !this.sessions.some((x) => x === s)) return
    const ok = await s.check()
    if (gen !== this.syncGen || !this.sessions.some((x) => x === s)) return
    this.scheduleCheck(s, gen, ok ? this.healthyMs(s) : UNSTABLE_CHECK_MS)
  }

  // Clears every check timer.
  stopToolSync(): void {
    for (const t of this.checkTimers.values()) clearTimeout(t)
    this.checkTimers = new Map()
    this.syncTimers = []
    this.syncGen += 1
  }

  // The chat tool definitions a key may see. policy is the key's access-profile tool patterns;
  // undefined means the key has no list, so every connected client's tools are offered. A client
  // the list names gets only the tools it names. A client it does not name gets its tools only
  // when its allow_by_default is set (Bifrost: an explicit assignment decides for that caller).
  // The chat tool definitions one caller may see: the access profile's patterns (policy) and the key's
  // mcp_configs (keys). Each filter judges a client it names by its entry, and a client it does not name
  // only when that client is allow_by_default. Undefined filters do not restrict.
  allToolsFor(policy: string[] | undefined, keys?: McpKeyConfig[], proj?: ProjectMcp): string[] {
    if (policy === undefined && keys === undefined && proj === undefined) return this.allTools()
    const out: string[] = []
    for (const s of this.sessions) {
      if (!s.connected || s.cfg.is_code_mode_client === true) continue
      const pass = s.toolsWhere(visibleTo(s, policy, keys, proj))
      for (const t of pass) out.push(t)
    }
    return out
  }

  // The servers whose instructions a caller may be sent: the connected clients that gave some and
  // that offer the caller at least one tool (a server the caller cannot reach is not heard from), by
  // name. Code mode clients are left out: their guidance rides in the stub files.
  instructionParts(policy: string[] | undefined, keys?: McpKeyConfig[], proj?: ProjectMcp): InstructionPart[] {
    const out: InstructionPart[] = []
    for (const s of this.sessions) {
      if (!s.connected || s.cfg.is_code_mode_client === true || s.instructions === "") continue
      if (s.toolsWhere(visibleTo(s, policy, keys, proj)).length === 0) continue
      out.push({ name: s.cfg.name, text: s.instructions, max: s.cfg.max_instructions_length ?? 0 })
    }
    out.sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0))
    return out
  }

  // The parts as one block, within the caps; "" when there are none.
  renderInstructions(parts: InstructionPart[]): string {
    return aggregate(parts, this.instrPerClient, this.instrTotal)
  }

  // The block of server instructions a caller is sent, within the caps; "" when there is none.
  instructionsFor(policy: string[] | undefined, keys?: McpKeyConfig[]): string {
    return this.renderInstructions(this.instructionParts(policy, keys))
  }

  // Follows a changed config's caps (the sessions are followed by follow()).
  setInstructionCaps(perClient: int, total: int): void {
    this.instrPerClient = perClient
    this.instrTotal = total
  }

  // The instructions of a code mode client, for its stub file ("" when it gave none).
  codeInstructions(name: string): { text: string, max: int } {
    for (const s of this.sessions) {
      if (s.cfg.name === name && s.connected) return { text: s.instructions, max: s.cfg.max_instructions_length ?? 0 }
    }
    return { text: "", max: 0 }
  }

  // The tools of the code mode clients a caller may see, by client (the same rules as allToolsFor).
  codeToolsFor(policy: string[] | undefined, keys?: McpKeyConfig[], proj?: ProjectMcp): { name: string, tools: McpTool[], instructions?: string }[] {
    const out: { name: string, tools: McpTool[], instructions?: string }[] = []
    for (const s of this.sessions) {
      if (!s.connected || s.cfg.is_code_mode_client !== true) continue
      const pass = visibleTo(s, policy, keys, proj)
      const tools: McpTool[] = []
      for (const t of s.tools) {
        if (!toolAllowed(t.name, s.cfg)) continue
        if (!pass(t.name, chatName(s.cfg.name, t.name))) continue
        tools.push(t)
      }
      if (tools.length > 0) out.push({ name: s.cfg.name, tools: tools, instructions: commentBlock(s.instructions, (s.cfg.max_instructions_length ?? 0) > 0 ? s.cfg.max_instructions_length! : this.instrPerClient) })
    }
    return out
  }

  // Whether a caller may run one chat tool ("<server>-<tool>"), by the same rules that decide which
  // tools it is offered. false when the tool is not exposed.
  mayRun(policy: string[] | undefined, keys: McpKeyConfig[] | undefined, fullToolName: string, proj?: ProjectMcp): bool {
    for (const s of this.sessions) {
      if (!s.connected) continue
      const orig = s.original(fullToolName)
      if (orig === undefined) continue
      const name = s.cfg.name
      const byDefault = s.cfg.allow_by_default === true
      let callerOk = true
      if (keys !== undefined) {
        const ok = keyNamesClient(keys, name) ? keyRuleAllows(keys, name, orig, byDefault) : byDefault
        if (!ok) callerOk = false
      }
      if (policy !== undefined) {
        const ok = namesClient(policy, name) ? policy.some((p) => patternMatches(fullToolName, p)) : byDefault
        if (!ok) callerOk = false
      }
      return projectPass(proj, name, orig, callerOk)
    }
    return false
  }

  // Whether a connected server exposes the chat tool.
  hasTool(fullToolName: string): bool {
    for (const s of this.sessions) {
      if (s.connected && s.original(fullToolName) !== undefined) return true
    }
    return false
  }

  // The tool_pricing cost of one execution of a chat tool, 0 when it has none.
  priceOf(fullToolName: string): f64 {
    for (const s of this.sessions) {
      const orig = s.original(fullToolName)
      if (orig === undefined) continue
      const pm = s.cfg.tool_pricing
      if (pm === undefined) return 0.0
      return pm.get(orig) ?? 0.0
    }
    return 0.0
  }

  // Chat tool definitions from every connected server (the code mode clients' tools are not offered one by one).
  allTools(): string[] {
    const out: string[] = []
    for (const s of this.sessions) {
      if (!s.connected || s.cfg.is_code_mode_client === true) continue
      for (const t of s.chatTools()) out.push(t)
    }
    return out
  }

  // Runs a tool by its chat name ("<server>-<tool>"). Every run is reported to the tool log.
  // bearer is the calling key's own token for a per_user_oauth client (undefined for other clients).
  async execute(fullToolName: string, argsJson: string, extra?: Map<string, string>, user?: Map<string, string>, bearer?: string): Promise<ToolText> throws Error {
    for (const s of this.sessions) {
      if (!s.connected) continue
      const original = s.original(fullToolName)
      if (original !== undefined) {
        const t0 = Date.now()
        let r: ToolText = { text: "", isError: false }
        try {
          if (s.cfg.auth_type === "per_user_oauth" || s.cfg.auth_type === "token_exchange") {
            if (bearer === undefined) throw new Error(`${s.cfg.name}: the caller has no token for this server: complete the consent link first`)
            r = await s.callAsUser(original, argsJson, extra, bearer)
          } else {
            r = await s.callTool(original, argsJson, extra, user)
          }
        } catch (e) {
          reportTool({ server: s.cfg.name, tool: original, latencyMs: Date.now() - t0, ok: false, error: e.message })
          throw e
        }
        reportTool({ server: s.cfg.name, tool: original, latencyMs: Date.now() - t0, ok: !r.isError, error: r.isError ? r.text : "", cost: this.priceOf(fullToolName) })
        return r
      }
    }
    throw new Error(`unknown MCP tool ${fullToolName}`)
  }

  // Chat names of every connected server's allowed tools.
  toolNames(): string[] {
    const out: string[] = []
    for (const s of this.sessions) {
      if (!s.connected || s.cfg.is_code_mode_client === true) continue
      for (const n of s.exposedNames()) out.push(n)
    }
    return out
  }

  // Each client's state. A token_exchange client shows its retained admin credential (credential, no token
  // values), and state "needs_reauth" once that credential needs a new verification.
  status(): { name: string, connected: bool, tools: int, error: string, stdio: bool, tools_list: { name: string, allowed: bool }[], state?: string, credential?: AdminCredential }[] {
    return this.sessions.map((s) => {
      const row = s.adminRow
      const cred: AdminCredential | undefined = s.cfg.auth_type === "token_exchange" && row !== undefined ? adminCredential(row) : undefined
      const state: string | undefined = s.awaitingReverify() ? "needs_reauth" : undefined
      return { name: s.cfg.name, connected: s.connected, tools: s.exposedCount(), error: s.lastError, stdio: s.cfg.connection_type === "stdio", tools_list: s.toolStates(), state: state, credential: cred }
    })
  }
}

test("instructions go to a caller for the servers that offer it a tool, within the caps", () => {
  const m = new McpManager({ client_configs: [{ name: "docs", connection_type: "http", connection_string: "http://x/mcp", max_instructions_length: 10 }, { name: "vcs", connection_type: "http", connection_string: "http://y/mcp" }, { name: "code", connection_type: "http", connection_string: "http://z/mcp", is_code_mode_client: true }, { name: "quiet", connection_type: "http", connection_string: "http://q/mcp" }], max_instructions_per_client: 50 })
  const tool: McpTool = { name: "go", description: "", inputSchemaRaw: "{}" }
  for (const s of m.sessions) {
    s.connected = true
    s.tools = [tool]
  }
  m.sessions[0]!.instructions = "Search before you read anything."
  m.sessions[1]!.instructions = "Commit small."
  m.sessions[2]!.instructions = "Never shown as a block."
  const parts = m.instructionParts(undefined)
  expect(parts.map((p) => p.name).join(",")).toBe("docs,vcs")
  expect(parts[0]!.max).toBe(10)
  const text = m.instructionsFor(undefined)
  expect(text.includes("<mcp_server name=\"docs\">\nSearch bef\n[truncated: 22 bytes omitted]\n</mcp_server>")).toBe(true)
  expect(text.includes("<mcp_server name=\"vcs\">\nCommit small.\n</mcp_server>")).toBe(true)
  // a key whose rules name only vcs is not told what docs said
  const only = m.instructionParts(undefined, [{ mcp_client_name: "vcs", tools_to_execute: ["*"] }])
  expect(only.map((p) => p.name).join(",")).toBe("vcs")
  // the code mode client's guidance rides in its stub comment
  expect(m.codeInstructions("code").text).toBe("Never shown as a block.")
  m.sessions[1]!.connected = false
  expect(m.instructionParts(undefined).map((p) => p.name).join(",")).toBe("docs")
})

test("an initialize result's instructions are read, and absent ones are empty", () => {
  expect(instructionsOf(`{"protocolVersion":"2025-06-18","instructions":"Use it well.\\nTwice."}`)).toBe("Use it well.\nTwice.")
  expect(instructionsOf(`{"protocolVersion":"2025-06-18"}`)).toBe("")
  expect(instructionsOf("not json")).toBe("")
})

test("tool_sync_interval seconds and the timers it starts and clears", () => {
  expect(syncSeconds(undefined)).toBe(0)
  expect(syncSeconds("0")).toBe(0)
  expect(syncSeconds("90s")).toBe(90)
  expect(syncSeconds("10m")).toBe(600)
  expect(syncSeconds("1h30m")).toBe(5400)
  const m = new McpManager({ client_configs: [{ name: "fs", connection_type: "http", connection_string: "http://x/mcp", tool_sync_interval: "10m" }, { name: "git", connection_type: "http", connection_string: "http://y/mcp" }] })
  // every enabled client gets a checker (the healthy cadence is 10 minutes without a tool_sync_interval)
  m.startToolSync()
  expect(m.syncTimers.length).toBe(2)
  m.startToolSync()
  expect(m.syncTimers.length).toBe(2)
  m.stopToolSync()
  expect(m.syncTimers.length).toBe(0)
  const off = new McpManager({ client_configs: [{ name: "fs", connection_type: "http", connection_string: "http://x/mcp", disabled: true }] })
  off.startToolSync()
  expect(off.syncTimers.length).toBe(0)
  // per-call clients: http without stickiness, and the per-user and token exchange auth types
  expect(new McpSession({ name: "a", connection_type: "http", needs_session_stickiness: false }).perCall()).toBe(true)
  expect(new McpSession({ name: "b", connection_type: "http", needs_session_stickiness: true }).perCall()).toBe(false)
  expect(new McpSession({ name: "c", connection_type: "sse", auth_type: "per_user_oauth" }).perCall()).toBe(true)
})

test("allow_by_default and access-profile patterns decide which tools a key sees", () => {
  const m = new McpManager({ client_configs: [
    { name: "fs", connection_type: "http", connection_string: "http://x/mcp" },
    { name: "git", connection_type: "http", connection_string: "http://y/mcp", allow_by_default: true },
    { name: "web", connection_type: "http", connection_string: "http://z/mcp" },
  ] })
  for (const s of m.sessions) {
    s.connected = true
    s.tools = [{ name: "read", description: "", inputSchemaRaw: EMPTY_SCHEMA }, { name: "write", description: "", inputSchemaRaw: EMPTY_SCHEMA }]
  }
  const names = (list: string[]): string => list.map((t) => { const i = t.indexOf('"name":"'); return t.slice(i + 8).split('"')[0]! }).join(",")
  expect(m.allToolsFor(undefined).length).toBe(6)
  expect(names(m.allToolsFor(["fs-read"]))).toBe("fs-read,git-read,git-write")
  expect(names(m.allToolsFor(["fs-*"]))).toBe("fs-read,fs-write,git-read,git-write")
  expect(names(m.allToolsFor(["*"]))).toBe("fs-read,fs-write,git-read,git-write,web-read,web-write")
  expect(names(m.allToolsFor(["web-write"]))).toBe("git-read,git-write,web-write")
  expect(m.allToolsFor(["nothing-here"]).length).toBe(2)
  expect(patternMatches("fs-read", "fs-*")).toBe(true)
  expect(patternMatches("fs-read", "fs-re")).toBe(false)
})

test("code mode clients are not offered one by one; codeToolsFor lists them for the caller", () => {
  const m = new McpManager({ client_configs: [
    { name: "fs", connection_type: "http", connection_string: "http://x/mcp", is_code_mode_client: true },
    { name: "git", connection_type: "http", connection_string: "http://y/mcp", allow_by_default: true },
  ] })
  for (const s of m.sessions) {
    s.connected = true
    s.tools = [{ name: "read", description: "reads", inputSchemaRaw: EMPTY_SCHEMA }, { name: "write", description: "", inputSchemaRaw: EMPTY_SCHEMA }]
  }
  const names = (list: string[]): string => list.map((t) => { const i = t.indexOf('"name":"'); return t.slice(i + 8).split('"')[0]! }).join(",")
  expect(names(m.allToolsFor(undefined))).toBe("git-read,git-write")
  expect(m.toolNames().includes("fs-read")).toBe(false)
  const cm = m.codeToolsFor(undefined)
  expect(cm.length).toBe(1)
  expect(cm[0]!.name).toBe("fs")
  expect(cm[0]!.tools.map((t) => t.name).join(",")).toBe("read,write")
  expect(cm[0]!.tools[0]!.description).toBe("reads")
  // the key's rules apply to the code mode tools as they do to direct ones
  expect(m.codeToolsFor(["fs-read"])[0]!.tools.map((t) => t.name).join(",")).toBe("read")
  expect(m.codeToolsFor(["git-*"]).length).toBe(0)
  expect(chatToolName("fs", "read")).toBe("fs-read")
})

test("tools_to_auto_execute becomes agent patterns per client", () => {
  const p = autoExecutePatterns([
    { name: "fs", connection_type: "http", tools_to_auto_execute: ["read"] },
    { name: "git", connection_type: "http", tools_to_auto_execute: ["*"] },
    { name: "web", connection_type: "http" },
  ])
  expect(p.join(",")).toBe("fs-read,git-*")
})

test("request bodies", () => {
  expect(initializeRequest(1)).toBe('{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"raiju","version":"0.1.0"}}}')
  expect(initializedNotification()).toBe('{"jsonrpc":"2.0","method":"notifications/initialized"}')
  expect(listToolsRequest(2)).toBe('{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}')
  expect(listToolsRequest(3, "page 2")).toBe('{"jsonrpc":"2.0","id":3,"method":"tools/list","params":{"cursor":"page 2"}}')
  expect(try callToolRequest(4, "get-weather", ' {"city":"Paris"} ')).toBe('{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"get-weather","arguments":{"city":"Paris"}}}')
  expect(try callToolRequest(5, "ping", "")).toBe('{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"ping","arguments":{}}}')
  let threw = false
  try {
    callToolRequest(6, "ping", "[1]")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("parses plain JSON, SSE and error responses", () => {
  const plain = parseRpcResponse("application/json", '{"jsonrpc":"2.0","id":3,"result":{"tools":[]}}', 3)
  expect(plain.kind).toBe("result")
  if (plain.kind === "result") expect(plain.raw).toBe('{"tools":[]}')

  // a notification arrives before the reply, and a multi-line data field is joined
  const sse = 'event: message\r\ndata: {"jsonrpc":"2.0","method":"notifications/message","params":{}}\r\n\r\ndata: {"jsonrpc":"2.0",\ndata: "id":2,"result":{"ok":true}}\n\n'
  const fromSse = parseRpcResponse("text/event-stream; charset=utf-8", sse, 2)
  expect(fromSse.kind).toBe("result")
  if (fromSse.kind === "result") expect(fromSse.raw).toBe('{"ok":true}')

  const err = parseRpcResponse("application/json", '{"jsonrpc":"2.0","id":4,"error":{"code":-32601,"message":"Method not found"}}', 4)
  expect(err.kind).toBe("error")
  if (err.kind === "error") {
    expect(err.code).toBe(-32601)
    expect(err.message).toBe("Method not found")
  }

  const missing = parseRpcResponse("text/event-stream", 'data: {"jsonrpc":"2.0","id":9,"result":{}}\n\n', 5)
  expect(missing.kind).toBe("error")
  const garbage = parseRpcResponse("application/json", "not json", 1)
  expect(garbage.kind).toBe("error")
})

test("parses tool pages with a cursor", () => {
  const page = try parseTools('{"tools":[{"name":"get-weather","description":"Weather","inputSchema":{"type":"object","properties":{"city":{"type":"string"}}}},{"name":"ping"},{"description":"no name"}],"nextCursor":"p2"}')
  expect(page.tools.length).toBe(2)
  expect(page.tools[0]!.name).toBe("get-weather")
  expect(page.tools[0]!.description).toBe("Weather")
  expect(page.tools[0]!.inputSchemaRaw).toBe('{"type":"object","properties":{"city":{"type":"string"}}}')
  expect(page.tools[1]!.description).toBe("")
  expect(page.tools[1]!.inputSchemaRaw).toBe(EMPTY_SCHEMA)
  expect(page.nextCursor).toBe("p2")
  const last = try parseTools('{"tools":[]}')
  expect(last.tools.length).toBe(0)
  expect(last.nextCursor).toBe(undefined)
})

test("chat tool names are sanitized and filtered", () => {
  const tools: McpTool[] = [
    { name: "get weather/v2.1", description: "d", inputSchemaRaw: '{"type":"object"}' },
    { name: "é", description: "unicode", inputSchemaRaw: "{}" },
    { name: "skipme", description: "", inputSchemaRaw: "{}" },
    { name: "keep", description: "", inputSchemaRaw: "{}" },
  ]
  const base: McpClientConfig = { name: "my.srv", connection_type: "http", connection_string: "http://localhost" }
  const all = toolsForChat("my.srv", tools, base)
  expect(all.length).toBe(4)
  const first = try fields(all[0]!)
  const fn = try fields(find(first, "function")!)
  expect(rawStr(fn, "name")).toBe("my_srv-get_weather_v2_1")
  expect(rawStr(fn, "description")).toBe("d")
  expect(find(fn, "parameters")).toBe('{"type":"object"}')
  const uni = try fields(find(try fields(all[1]!), "function")!)
  expect(rawStr(uni, "name")).toBe("my_srv-__")

  let long = ""
  for (let i = 0; i < 80; i++) long += "a"
  const lt = toolsForChat("s", [{ name: long, description: "", inputSchemaRaw: "{}" }], base)
  const lname = rawStr(try fields(find(try fields(lt[0]!), "function")!), "name") ?? ""
  expect(lname.byteLength).toBe(64)
  expect(lname.startsWith("s-a")).toBe(true)

  const allowList: McpClientConfig = { name: "my.srv", connection_type: "http", connection_string: "http://localhost", tools_to_execute: ["keep", "skipme"], tools_to_skip: ["skipme"] }
  const allowed = toolsForChat("my.srv", tools, allowList)
  expect(allowed.length).toBe(1)
  expect(rawStr(try fields(find(try fields(allowed[0]!), "function")!), "name")).toBe("my_srv-keep")
  const emptyList: McpClientConfig = { name: "my.srv", connection_type: "http", connection_string: "http://localhost", tools_to_execute: [] }
  expect(toolsForChat("my.srv", tools, emptyList).length).toBe(4)
  const starList: McpClientConfig = { name: "my.srv", connection_type: "http", connection_string: "http://localhost", tools_to_execute: ["*"], tools_to_skip: ["keep"] }
  expect(toolsForChat("my.srv", tools, starList).length).toBe(3)
})

test("injects tools into a chat request", () => {
  const t1 = '{"type":"function","function":{"name":"s-a","description":"","parameters":{}}}'
  const t2 = '{"type":"function","function":{"name":"s-b","description":"","parameters":{}}}'
  expect(try injectTools('{"model":"m","messages":[]}', [t1])).toBe(`{"model":"m","messages":[],"tools":[${t1}]}`)

  const body = '{"tools":[' + t1 + '],"model":"m","messages":[{"role":"user","content":"caf\\u00e9 \\"q\\""}]}'
  const merged = try injectTools(body, [t1, t2])
  expect(merged).toBe(`{"tools":[${t1},${t2}],"model":"m","messages":[{"role":"user","content":"caf\\u00e9 \\"q\\""}]}`)
  expect(try injectTools(body, [t1])).toBe(body)
  expect(try injectTools(body, [])).toBe(body)

  let threw = false
  try {
    injectTools("[1]", [t1])
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("splits tool names when server names have dashes", () => {
  const servers = ["my-server", "my", "other"]
  expect(splitToolName("my-server-get_thing", servers)).toEqual({ server: "my-server", tool: "get_thing" })
  expect(splitToolName("my-get_x", servers)).toEqual({ server: "my", tool: "get_x" })
  expect(splitToolName("other-x", servers)).toEqual({ server: "other", tool: "x" })
  expect(splitToolName("unknown-x", servers)).toBe(undefined)
  expect(splitToolName("my-server-", ["my-server"])).toBe(undefined)
})

test("turns tool results into text", () => {
  const r = try toolResultText('{"content":[{"type":"text","text":"hello"},{"type":"image","data":"AAA","mimeType":"image/png"},{"type":"text","text":"world"}],"isError":true}')
  expect(r.text).toBe("hello\n[image image/png]\nworld")
  expect(r.isError).toBe(true)
  const res = try toolResultText('{"content":[{"type":"resource","resource":{"uri":"file:///a.txt","mimeType":"text/plain"}}]}')
  expect(res.text).toBe("[resource file:///a.txt text/plain]")
  expect(res.isError).toBe(false)
  const empty = try toolResultText("{}")
  expect(empty.text).toBe("")
})

test("parses tool execute bodies and builds tool messages", () => {
  const call = try executeEndpointBody('{"id":"call_1","type":"function","function":{"name":"my-server-get_weather","arguments":"{\\"city\\":\\"Paris\\"}"}}')
  expect(call.name).toBe("my-server-get_weather")
  expect(call.argumentsJson).toBe('{"city":"Paris"}')
  expect(call.callId).toBe("call_1")

  const obj = try executeEndpointBody('{"function":{"name":"s-a","arguments":{"n":1}}}')
  expect(obj.argumentsJson).toBe('{"n":1}')
  expect(obj.callId).toBe(undefined)
  const none = try executeEndpointBody('{"function":{"name":"s-a","arguments":""}}')
  expect(none.argumentsJson).toBe("{}")

  let threw = 0
  try {
    executeEndpointBody('{"function":{"arguments":"{}"}}')
  } catch (e) {
    threw += 1
  }
  try {
    executeEndpointBody('{"function":{"name":"s-a","arguments":"[1]"}}')
  } catch (e) {
    threw += 1
  }
  try {
    executeEndpointBody('{"type":"retrieval","function":{"name":"s-a"}}')
  } catch (e) {
    threw += 1
  }
  expect(threw).toBe(3)

  const msg = toolMessage("call_1", 'a "quoted" line')
  expect(msg).toBe('{"role":"tool","tool_call_id":"call_1","content":"a \\"quoted\\" line"}')
  expect(rawStr(try fields(msg), "role")).toBe("tool")
})

test("a config change keeps unchanged HTTP clients with their tools and replaces changed ones", () => {
  const a: McpClientConfig = { name: "a", connection_type: "http", connection_string: "http://127.0.0.1:1/mcp" }
  const b: McpClientConfig = { name: "b", connection_type: "http", connection_string: "http://127.0.0.1:2/mcp" }
  const m = new McpManager({ client_configs: [a, b] })
  const oldA = m.sessions[0]!
  oldA.tools = [{ name: "t", description: "", inputSchemaRaw: EMPTY_SCHEMA }]
  const b2: McpClientConfig = { name: "b", connection_type: "http", connection_string: "http://127.0.0.1:3/mcp" }
  const next = new McpManager({ client_configs: [a, b2] })
  m.follow(next.sessions)
  expect(m.sessions[0]! === oldA).toBe(true)
  expect(m.sessions[0]!.tools.length).toBe(1)
  expect(m.sessions[1]!.cfg.connection_string).toBe("http://127.0.0.1:3/mcp")
})

test("a token_exchange client lists with its retained admin credential, and a new one replaces the session", () => {
  const te: McpClientConfig = { name: "jira", connection_type: "http", connection_string: "http://127.0.0.1:1/mcp", auth_type: "token_exchange", token_exchange: { audience: "api://jira", client_id: "exch" } }
  const row: McpUserToken = { id: "ex1", mcp_client_name: "jira", virtual_key_id: "", session_id: "", access_token: "admin-tok", refresh_token: "", token_expires_at: 0.0, scopes: [], created_at: 1.0, last_refreshed_at: 1.0 }
  // no credential: the client waits for verification
  expect(adminTokenOf(undefined, "jira", 1000.0)).toBe("")
  expect(adminTokenOf([row], "other", 1000.0)).toBe("")
  expect(adminTokenOf([row], "jira", 1000.0)).toBe("admin-tok")
  // an expired credential reads as none
  const old: McpUserToken = { id: "ex1", mcp_client_name: "jira", virtual_key_id: "", session_id: "", access_token: "admin-tok", refresh_token: "", token_expires_at: 500.0, scopes: [], created_at: 1.0, last_refreshed_at: 1.0 }
  expect(adminTokenOf([old], "jira", 1000.0)).toBe("")
  const m = new McpManager({ client_configs: [te] })
  expect(m.sessions[0]!.adminToken).toBe("")
  const verified = new McpManager({ client_configs: [te], exchange_admin: [row] })
  expect(verified.sessions[0]!.adminToken).toBe("admin-tok")
  // a verification that lands on a running client replaces its session, so it connects
  m.follow(verified.sessions)
  expect(m.sessions[0]! === verified.sessions[0]!).toBe(true)
  expect(m.sessions[0]!.adminToken).toBe("admin-tok")
  // an unchanged credential keeps the running session
  const again = new McpManager({ client_configs: [te], exchange_admin: [row] })
  m.follow(again.sessions)
  expect(m.sessions[0]! === verified.sessions[0]!).toBe(true)
})

test("a session that waited for its admin credential connects once the credential arrives, and a connected one keeps its state", () => {
  const te: McpClientConfig = { name: "jira", connection_type: "http", connection_string: "http://127.0.0.1:1/mcp", auth_type: "token_exchange", token_exchange: { audience: "api://jira", client_id: "exch" } }
  const row: McpUserToken = { id: "ex1", mcp_client_name: "jira", virtual_key_id: "", session_id: "", access_token: "admin-tok", refresh_token: "", token_expires_at: 0.0, scopes: [], created_at: 1.0, last_refreshed_at: 1.0 }
  const m = new McpManager({ client_configs: [te] })
  const s = m.sessions[0]!
  // connect() leaves a client with no credential waiting, with its error
  s.lastError = "waiting for the admin credential"
  // the credential reaches a node that was waiting for it: the error clears, so the next connect pass runs it
  m.setAdmin(row)
  expect(s.adminToken).toBe("admin-tok")
  expect(s.lastError).toBe("")
  // a session that is already connected keeps its state when the same credential comes again
  s.connected = true
  s.lastError = ""
  m.setAdmin(row)
  expect(s.connected).toBe(true)
  expect(s.lastError).toBe("")
})

test("a renewed admin credential is taken in place, and a refused one keeps the client's tools and shows needs_reauth", () => {
  const te: McpClientConfig = { name: "jira", connection_type: "http", connection_string: "http://127.0.0.1:1/mcp", auth_type: "token_exchange", token_exchange: { audience: "api://jira", client_id: "exch" } }
  const row: McpUserToken = { id: "ex1", mcp_client_name: "jira", virtual_key_id: "", session_id: "", access_token: "admin-1", refresh_token: "rt-1", token_expires_at: Date.now() + 60000.0, scopes: [], created_at: 1.0, last_refreshed_at: 1.0 }
  const m = new McpManager({ client_configs: [te], exchange_admin: [row] })
  const live = m.sessions[0]!
  live.connected = true
  live.tools = [{ name: "search", description: "", inputSchemaRaw: "{}" }]
  expect(m.status()[0]!.credential!.has_refresh_token).toBe(true)
  expect(m.status()[0]!.state === undefined).toBe(true)
  // a renewal: the running session takes the new token, and the saved config that follows keeps it
  let renewed = row
  renewed.access_token = "admin-2"
  m.setAdmin(renewed)
  expect(live.adminToken).toBe("admin-2")
  m.follow(new McpManager({ client_configs: [te], exchange_admin: [renewed] }).sessions)
  expect(m.sessions[0]! === live).toBe(true)
  // a refused renewal: no admin token, the tools stay, and the status says it needs a new verification
  const dead = reverifyRow(renewed, "provider rejected the refresh (HTTP 400, invalid_grant)")
  expect(adminTokenOf([dead], "jira", 1000.0)).toBe("")
  m.setAdmin(dead)
  m.follow(new McpManager({ client_configs: [te], exchange_admin: [dead] }).sessions)
  expect(m.sessions[0]! === live).toBe(true)
  expect(live.adminToken).toBe("")
  expect(live.connected).toBe(true)
  expect(m.hasTool("jira-search")).toBe(true)
  const st = m.status()[0]!
  expect(st.state).toBe("needs_reauth")
  expect(st.credential!.status).toBe("needs_reauth")
  expect(st.error.includes("needs re-verification")).toBe(true)
  expect(st.error.includes("invalid_grant")).toBe(true)
  expect(JSON.stringify(st).includes("rt-1")).toBe(false)
  // a client that was not connected starts in that state with the same reason
  const cold = new McpManager({ client_configs: [te], exchange_admin: [dead] })
  expect(cold.status()[0]!.state).toBe("needs_reauth")
})

test("per-client durations and virtual key allow-lists", () => {
  expect(durationMsOf(undefined)).toBe(0)
  expect(durationMsOf("30s")).toBe(30000)
  expect(durationMsOf("2m")).toBe(120000)
  expect(durationMsOf("1m30s")).toBe(90000)
  expect(durationMsOf("500ms")).toBe(500)
  expect(durationMsOf("45")).toBe(45000)
  expect(durationMsOf("soon")).toBe(0)

  // a key that declares no mcp_configs is not limited; a declared list judges the clients it names
  expect(keyRuleAllows(undefined, "git", "push", false)).toBe(true)
  const keys: McpKeyConfig[] = [{ mcp_client_name: "fs", tools_to_execute: ["read"] }, { mcp_client_name: "web", tools_to_execute: ["*"] }, { mcp_client_name: "db", tools_to_execute: [] }]
  expect(keyRuleAllows(keys, "fs", "read", false)).toBe(true)
  expect(keyRuleAllows(keys, "fs", "write", false)).toBe(false)
  expect(keyRuleAllows(keys, "web", "anything", false)).toBe(true)
  expect(keyRuleAllows(keys, "db", "query", true)).toBe(false)
  expect(keyRuleAllows(keys, "git", "push", false)).toBe(false)
  expect(keyRuleAllows(keys, "git", "push", true)).toBe(true)

  const prices: Map<string, f64> = new Map()
  prices.set("read", 0.5)
  const m = new McpManager({ client_configs: [
    { name: "fs", connection_type: "http", connection_string: "http://x/mcp", tool_pricing: prices },
    { name: "git", connection_type: "http", connection_string: "http://y/mcp", allow_by_default: true },
    { name: "web", connection_type: "http", connection_string: "http://z/mcp" },
  ] })
  for (const s of m.sessions) {
    s.connected = true
    s.tools = [{ name: "read", description: "", inputSchemaRaw: EMPTY_SCHEMA }, { name: "write", description: "", inputSchemaRaw: EMPTY_SCHEMA }]
  }
  const names = (list: string[]): string => list.map((t) => { const i = t.indexOf('"name":"'); return t.slice(i + 8).split('"')[0]! }).join(",")
  // the key limits fs to read and names no web tools; git is allow_by_default
  const onlyFs: McpKeyConfig[] = [{ mcp_client_name: "fs", tools_to_execute: ["read"] }]
  expect(names(m.allToolsFor(undefined, onlyFs))).toBe("fs-read,git-read,git-write")
  expect(names(m.allToolsFor(["*"], [{ mcp_client_name: "web", tools_to_execute: [] }]))).toBe("git-read,git-write")
  expect(m.allToolsFor(undefined, []).length).toBe(2)
  expect(m.mayRun(undefined, onlyFs, "fs-read")).toBe(true)
  expect(m.mayRun(undefined, onlyFs, "fs-write")).toBe(false)
  expect(m.mayRun(["fs-*"], undefined, "web-read")).toBe(false)
  expect(m.mayRun(undefined, undefined, "web-read")).toBe(true)
  expect(m.mayRun(undefined, undefined, "nothing-here")).toBe(false)
  // a project's tool lists: union adds to the caller's access, intersect caps it, another rule permits nothing
  const addWeb: ProjectMcp = { rule: "union", keys: [{ mcp_client_name: "web", tools_to_execute: ["read"] }] }
  expect(m.mayRun(undefined, onlyFs, "web-read", addWeb)).toBe(true)
  expect(m.mayRun(undefined, onlyFs, "web-write", addWeb)).toBe(false)
  expect(names(m.allToolsFor(undefined, onlyFs, addWeb))).toBe("fs-read,git-read,git-write,web-read")
  const capFs: ProjectMcp = { rule: "intersect", keys: [{ mcp_client_name: "fs", tools_to_execute: ["*"] }] }
  expect(names(m.allToolsFor(undefined, undefined, capFs))).toBe("fs-read,fs-write")
  expect(m.mayRun(undefined, onlyFs, "fs-write", capFs)).toBe(false)
  expect(m.mayRun(undefined, undefined, "git-read", { rule: "intersect", keys: [] })).toBe(false)
  expect(m.mayRun(undefined, undefined, "git-read", { rule: "intersect", keys: [], via: true })).toBe(true)
  expect(m.mayRun(undefined, undefined, "git-read", { rule: "mystery", keys: capFs.keys })).toBe(false)
  // a server the project names with an empty list gets nothing from it
  expect(m.mayRun(undefined, [], "web-read", { rule: "union", keys: [{ mcp_client_name: "web", tools_to_execute: [] }] })).toBe(false)
  expect(m.priceOf("fs-read")).toBe(0.5)
  expect(m.priceOf("fs-write")).toBe(0.0)
  expect(m.priceOf("git-read")).toBe(0.0)
})

test("the global tool_sync_interval is the default for clients without their own", () => {
  const m = new McpManager({ tool_sync_interval: "5m", client_configs: [
    { name: "fs", connection_type: "http", connection_string: "http://x/mcp", tool_sync_interval: "90s" },
    { name: "git", connection_type: "http", connection_string: "http://y/mcp" },
  ] })
  m.startToolSync()
  expect(m.syncTimers.length).toBe(2)
  m.stopToolSync()
})
