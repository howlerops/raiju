// The HTML pages of the MCP OAuth consent flows, each one self-contained (no external assets, no
// scripts from elsewhere). The page is opened from the link a caller was given; its temp token rides in the
// URL fragment (#t=...), which the script reads and sends as X-Bifrost-Temp-Token, so the page needs no
// dashboard session. Both scripts build the page with textContent only, since the flow id, the client name
// and the redirect URI come from the URL or from another party.

// The per-user OAuth page (Bifrost's /workspace/mcp-sessions/auth?flow={id}#t={token}): it reads the flow,
// and its Connect button opens the upstream authorize URL that the start route answers.
export function connectPageHtml(): string {
  return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Connect an MCP client</title>
<style>
:root { --bg: #f6f7f9; --surface: #ffffff; --text: #1b1f24; --muted: #59626d; --border: #d8dde3; --accent: #2456d6; --accent-text: #ffffff; --bad: #cf222e; --ok: #1a7f37; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg: #0d1117; --surface: #161b22; --text: #e6edf3; --muted: #9198a1; --border: #30363d; --accent: #4c8dff; --accent-text: #0d1117; --bad: #f85149; --ok: #3fb950; } }
:root[data-theme="dark"] { --bg: #0d1117; --surface: #161b22; --text: #e6edf3; --muted: #9198a1; --border: #30363d; --accent: #4c8dff; --accent-text: #0d1117; --bad: #f85149; --ok: #3fb950; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
main { max-width: 480px; margin: 48px auto; padding: 0 16px; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
h1 { font-size: 20px; margin: 0 0 12px; }
p { margin: 0 0 12px; }
.muted { color: var(--muted); font-size: 13px; }
.bad { color: var(--bad); }
.ok { color: var(--ok); }
button { font: inherit; padding: 8px 16px; border: 0; border-radius: 6px; background: var(--accent); color: var(--accent-text); cursor: pointer; }
button:disabled { opacity: 0.5; cursor: default; }
</style>
</head>
<body>
<main>
<div class="card">
<h1>Connect an MCP client</h1>
<p id="msg" class="muted">Loading the connection request...</p>
<div id="details" hidden>
<p>The MCP client <strong id="client"></strong> asks for its own connection to your account. The sign-in happens at the provider; this gateway stores the result for your virtual key only.</p>
<p class="muted" id="caller"></p>
<p><button id="go" type="button">Connect</button></p>
</div>
</div>
</main>
<script>
(function () {
  var flow = new URLSearchParams(location.search).get("flow") || "";
  var hash = location.hash || "";
  var token = hash.indexOf("#t=") === 0 ? decodeURIComponent(hash.slice(3)) : "";
  var base = "/api/oauth/per-user/flows/" + encodeURIComponent(flow);
  var headers = token === "" ? {} : { "X-Bifrost-Temp-Token": token };
  var msg = document.getElementById("msg");
  function fail(text) { msg.textContent = text; msg.className = "bad"; }
  function failOf(res) {
    return res.json().then(function (b) {
      var m = b && b.error && b.error.message ? b.error.message : "the request failed";
      fail(m + " (HTTP " + res.status + ")");
    }, function () { fail("the request failed (HTTP " + res.status + ")"); });
  }
  if (flow === "") { fail("This link has no flow. Ask for a new connection link."); return; }
  if (token === "") { fail("This link has no sign-in token. Open the whole link, including the part after #."); return; }
  fetch(base, { headers: headers }).then(function (res) {
    if (!res.ok) return failOf(res);
    return res.json().then(function (f) {
      msg.textContent = "";
      msg.className = "muted";
      document.getElementById("client").textContent = f.mcp_client && f.mcp_client.name ? f.mcp_client.name : "";
      document.getElementById("caller").textContent = f.virtual_key_id ? "Virtual key: " + f.virtual_key_id : "";
      document.getElementById("details").hidden = false;
    });
  }, function () { fail("The gateway could not be reached."); });
  document.getElementById("go").addEventListener("click", function () {
    var go = document.getElementById("go");
    go.disabled = true;
    fetch(base + "/start", { headers: headers }).then(function (res) {
      if (!res.ok) { go.disabled = false; return failOf(res); }
      return res.json().then(function (b) { location.assign(b.authorize_url); });
    }, function () { go.disabled = false; fail("The gateway could not be reached."); });
  });
})();
</script>
</body>
</html>
`
}

// The authorization server's consent page (Bifrost's /oauth/consent?flow={id}#t={token}): the request's
// client and redirect URI, and a form that takes a virtual key. Submitting it answers the redirect URL with
// the one-time code, which the client exchanges at /oauth2/token.
export function consentPageHtml(): string {
  return `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Authorize an MCP client</title>
<style>
:root { --bg: #f6f7f9; --surface: #ffffff; --text: #1b1f24; --muted: #59626d; --border: #d8dde3; --accent: #2456d6; --accent-text: #ffffff; --bad: #cf222e; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg: #0d1117; --surface: #161b22; --text: #e6edf3; --muted: #9198a1; --border: #30363d; --accent: #4c8dff; --accent-text: #0d1117; --bad: #f85149; } }
:root[data-theme="dark"] { --bg: #0d1117; --surface: #161b22; --text: #e6edf3; --muted: #9198a1; --border: #30363d; --accent: #4c8dff; --accent-text: #0d1117; --bad: #f85149; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
main { max-width: 480px; margin: 48px auto; padding: 0 16px; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px; }
h1 { font-size: 20px; margin: 0 0 12px; }
p { margin: 0 0 12px; }
.muted { color: var(--muted); font-size: 13px; word-break: break-all; }
.bad { color: var(--bad); }
label { display: block; margin: 12px 0; }
input { display: block; width: 100%; box-sizing: border-box; margin-top: 4px; padding: 8px; font: inherit; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: 6px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
button { font: inherit; padding: 8px 16px; border: 0; border-radius: 6px; background: var(--accent); color: var(--accent-text); cursor: pointer; }
button:disabled { opacity: 0.5; cursor: default; }
</style>
</head>
<body>
<main>
<div class="card">
<h1>Authorize an MCP client</h1>
<p id="msg" class="muted">Loading the request...</p>
<form id="form" hidden>
<p>The MCP client <strong id="client"></strong> asks to call this gateway's MCP endpoint as a virtual key. Enter that key to approve the request.</p>
<p class="muted">Redirects to <span id="redirect"></span></p>
<label>Virtual key
<input id="vk" name="vk" type="password" autocomplete="off" spellcheck="false" required>
</label>
<p><button id="go" type="submit">Authorize</button></p>
</form>
<div id="session" hidden>
<p>Or approve as the dashboard user signed in here. The client then runs without a virtual key.</p>
<p><button id="go-session" type="button">Continue as the signed-in user</button></p>
</div>
</div>
</main>
<script>
(function () {
  var flow = new URLSearchParams(location.search).get("flow") || "";
  var hash = location.hash || "";
  var token = hash.indexOf("#t=") === 0 ? decodeURIComponent(hash.slice(3)) : "";
  var base = "/api/oauth2/consent/flows/" + encodeURIComponent(flow);
  var headers = { "X-Bifrost-Temp-Token": token };
  var msg = document.getElementById("msg");
  function fail(text) { msg.textContent = text; msg.className = "bad"; }
  function failOf(res) {
    return res.json().then(function (b) {
      var m = b && b.error && b.error.message ? b.error.message : "the request failed";
      fail(m + " (HTTP " + res.status + ")");
    }, function () { fail("the request failed (HTTP " + res.status + ")"); });
  }
  if (flow === "" || token === "") { fail("This link is incomplete. Start the connection again from the MCP client."); return; }
  fetch(base, { headers: headers }).then(function (res) {
    if (!res.ok) return failOf(res);
    return res.json().then(function (r) {
      msg.textContent = "";
      msg.className = "muted";
      document.getElementById("client").textContent = r.client_name || "";
      document.getElementById("redirect").textContent = r.redirect_uri || "";
      document.getElementById("form").hidden = false;
      if ((r.available_modes || []).indexOf("session") >= 0) document.getElementById("session").hidden = false;
    });
  }, function () { fail("The gateway could not be reached."); });
  // approves the request in the given mode (vk with the key typed, or session for the signed-in user)
  function submit(body, button) {
    button.disabled = true;
    fetch(base, { method: "PUT", headers: { "Content-Type": "application/json", "X-Bifrost-Temp-Token": token }, body: JSON.stringify(body) }).then(function (res) {
      if (!res.ok) { button.disabled = false; return failOf(res); }
      return res.json().then(function (b) { location.assign(b.redirect_url); });
    }, function () { button.disabled = false; fail("The gateway could not be reached."); });
  }
  document.getElementById("form").addEventListener("submit", function (ev) {
    ev.preventDefault();
    var value = document.getElementById("vk").value.trim();
    if (value === "") { fail("Enter the virtual key."); return; }
    submit({ mode: "vk", value: value }, document.getElementById("go"));
  });
  document.getElementById("go-session").addEventListener("click", function () {
    submit({ mode: "session" }, document.getElementById("go-session"));
  });
})();
</script>
</body>
</html>
`
}
