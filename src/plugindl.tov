// Plugins loaded from a URL, as Bifrost loads a plugin whose path starts with "http" (framework/plugins/utils.go
// DownloadPlugin): fetched with a 120 second timeout, at most 5 redirects, a 200 answer only, at most 200 MiB of body,
// and no private, loopback, link-local or metadata address unless the host is in
// server.plugin_download_private_allowlist (Bifrost's SSRF-hardened download client; each hop's host is resolved and
// every address checked, netguard.tov). The file is kept under the plugin cache directory by the URL's hash, so the
// chain (plugins.tov makePlugin, which is synchronous) loads the copy, and the workers of a host share it.
//
// Stricter than Bifrost, because the module runs on every request: the URL (and every redirect) must be https, unless
// the plugin entry pins the file's SHA-256 (sha256), which is checked on download and again each time the copy is
// loaded; and the cache directory is private (0700, beside the config file unless RAIJU_PLUGIN_DIR names another).

import { chmodSync, existsSync, mkdirSync, readFileBytesSync, statSync } from "node:fs"
import { writeFileAtomic } from "./atomicfile"
import { targetProblem, resolvedTargetProblem, peerOf, strictPolicy } from "./netguard"
import { sha256, toHex, utf8 } from "./crypto"
import { deadline } from "./deadline"

// Bifrost's maxPluginDownloadBytes.
export const MAX_PLUGIN_BYTES = 209715200
const TIMEOUT_MS = 120000
const MAX_REDIRECTS = 5

// A plugin that loads from a file or a URL, with the SHA-256 its entry pins ("" for none).
export type PluginSource = { path: string, sha256: string }

// Whether a plugin path is a URL to download (Bifrost: a path that starts with "http").
export function isPluginUrl(path: string | undefined): bool {
  if (path === undefined) return false
  const p = path.trim()
  return p.startsWith("http")
}

// The folder the cache goes in when RAIJU_PLUGIN_DIR is not set: plugin-cache beside the config file (main.tov sets it).
let cacheBase = ""
let cacheDir = ""

export function setPluginCacheBase(dir: string): void {
  cacheBase = dir
  cacheDir = ""
}

// The directory the downloads are kept in: RAIJU_PLUGIN_DIR, else plugin-cache beside the config file, else (no
// config folder known, or it is read-only, as a mounted ConfigMap is) raiju-plugins under the temporary directory.
// Wherever it is, ensurePrivateCacheDir makes it 0700 before a download is written, and refuses one it cannot.
export function pluginCacheDir(): string {
  const d = process.env.RAIJU_PLUGIN_DIR ?? ""
  if (d !== "") return d
  if (cacheDir !== "") return cacheDir
  if (cacheBase !== "") {
    const beside = cacheBase + "/plugin-cache"
    try {
      mkdirSync(beside, { recursive: true })
      cacheDir = beside
      return beside
    } catch (e) {
      // a read-only config folder: the temporary directory below
    }
  }
  return (process.env.TMPDIR ?? "/tmp") + "/raiju-plugins"
}

// Creates the cache directory if needed and makes it private (0700). "" when it is, else the reason: a directory this
// process cannot chmod belongs to someone else, who could swap the files in it.
export function ensurePrivateCacheDir(): string {
  const dir = pluginCacheDir()
  try {
    mkdirSync(dir, { recursive: true })
    chmodSync(dir, 448)
    if ((statSync(dir).mode & 63) !== 0) return `plugin cache directory ${dir} is open to other users`
  } catch (e) {
    return `plugin cache directory ${dir} cannot be made private (set RAIJU_PLUGIN_DIR to a folder of this user's): ${e.message}`
  }
  return ""
}

// The local copy of a plugin URL (its file name is the URL's SHA-256 and the extension of its path).
export function pluginFileFor(url: string): string {
  const u = url.trim()
  const ext = u.split("?")[0]!.endsWith(".so") ? ".so" : ".wasm"
  return `${pluginCacheDir()}/${toHex(sha256(utf8(u)))}${ext}`
}

// A pin as stored: lower case, without spaces; "" for none.
export function normalPin(pin: string | undefined): string {
  return (pin ?? "").trim().toLowerCase()
}

// Why a sha256 pin is malformed ("" when it is fine or absent): 64 hex digits.
export function pinProblem(pin: string | undefined): string {
  const p = normalPin(pin)
  if (p === "") return ""
  if (p.byteLength !== 64) return "sha256 must be 64 hex digits"
  for (const c of new TextEncoder().encode(p)) {
    const v = int(c)
    if (!((v >= 48 && v <= 57) || (v >= 97 && v <= 102))) return "sha256 must be 64 hex digits"
  }
  return ""
}

// The SHA-256 of a byte string as lower-case hex.
export function sha256Hex(b: u8[]): string {
  return toHex(sha256(b))
}

// Why a file does not match its pin ("" when it does, or nothing is pinned).
export function fileMatchesPin(file: string, pin: string | undefined): string {
  const p = normalPin(pin)
  if (p === "") return ""
  const bad = pinProblem(p)
  if (bad !== "") return bad
  let got = ""
  try {
    got = sha256Hex(readFileBytesSync(file))
  } catch (e) {
    return `plugin file ${file}: ${e.message}`
  }
  return got === p ? "" : `plugin file ${file} does not match its sha256 pin (sha256 is ${got})`
}

// The local copy of a downloaded plugin URL, or undefined when it has not been downloaded (or, with a pin, when the
// copy no longer matches it).
export function downloadedPlugin(url: string, pin?: string): string | undefined {
  const f = pluginFileFor(url)
  try {
    if (!existsSync(f)) return undefined
    // a copy in a folder others may write to is not trusted
    if ((statSync(pluginCacheDir()).mode & 18) !== 0) return undefined
  } catch (e) {
    return undefined
  }
  return fileMatchesPin(f, pin) === "" ? f : undefined
}

// Why a URL may not be fetched, or "": https (plain http only when the entry pins the file's sha256), and no private
// address unless the host is allowed. Judged as written; downloadPlugin also resolves the host.
export function urlProblem(url: string, allow: string[], pinned: bool): string {
  const u = URL.parse(url)
  if (u === undefined) return `invalid plugin URL "${url}"`
  if (u.protocol !== "http:" && u.protocol !== "https:") return `unsupported plugin URL scheme "${u.protocol.replace(":", "")}" (only https allowed)`
  if (u.protocol === "http:" && !pinned) return `plugin URL "${url}" must be https (plain http needs the plugin's sha256 to be pinned)`
  const p = targetProblem(url, allow)
  return p === "" ? "" : `plugin URL "${url}" is refused: ${p} (add the host to server.plugin_download_private_allowlist to allow it)`
}

// urlProblem at connect time: the host is resolved and every address it names is checked.
export async function connectProblem(url: string, allow: string[], pinned: bool): Promise<string> {
  const p = urlProblem(url, allow, pinned)
  if (p !== "") return p
  const r = await resolvedTargetProblem(url, allow)
  return r === "" ? "" : `plugin URL "${url}" is refused: ${r} (add the host to server.plugin_download_private_allowlist to allow it)`
}

// Where a redirect goes: an absolute URL, or a path on the same origin; "" for anything else.
export function redirectTarget(from: string, location: string): string {
  if (location.includes("://")) return location
  const u = URL.parse(from)
  if (u === undefined || !location.startsWith("/")) return ""
  return u.origin + location
}

// Reads at most max bytes of a body; undefined when it holds more (the limit Bifrost's LimitReader applies).
export async function readCapped(body: ReadableStream | undefined, max: int): Promise<u8[] | undefined> throws Error {
  const out: u8[] = []
  if (body === undefined) return out
  while (true) {
    const r = try await body.pull()
    const v = r.value
    if (r.done || v === undefined) break
    if (out.length + v.length > max) {
      try {
        await body.cancel()
      } catch (e) {
        // the source is gone already
      }
      return undefined
    }
    for (const b of v) out.push(b)
  }
  return out
}

// Downloads a plugin URL to its local copy (pluginFileFor), checking the pin when there is one. The error message is
// Bifrost's where it has one.
export async function downloadPlugin(url: string, allow: string[], pin?: string): Promise<{ path: string, error: string }> {
  const start = url.trim()
  const want = normalPin(pin)
  const pp = pinProblem(want)
  if (pp !== "") return { path: "", error: `plugin at "${start}": ${pp}` }
  let at = start
  const dl = deadline(TIMEOUT_MS)
  try {
    for (let hop = 0; hop <= MAX_REDIRECTS; hop++) {
      const bad = await connectProblem(at, allow, want !== "")
      if (bad !== "") return { path: "", error: hop === 0 ? bad : `blocked redirect: ${bad}` }
      const res = try await fetch(at, { method: "GET", headers: { accept: "application/octet-stream", "accept-language": "en-US,en;q=0.9" }, signal: dl.controller.signal, redirect: "manual", peer: peerOf(strictPolicy(allow)) })
      if (res.status >= 300 && res.status < 400) {
        const loc = res.headers.get("location") ?? ""
        if (loc === "") return { path: "", error: `failed to download plugin: HTTP ${res.status}` }
        const next = redirectTarget(at, loc)
        if (next === "") return { path: "", error: `failed to download plugin: invalid redirect "${loc}"` }
        at = next
        continue
      }
      if (res.status !== 200) return { path: "", error: `failed to download plugin: HTTP ${res.status}` }
      const body = try await readCapped(res.body, MAX_PLUGIN_BYTES)
      if (body === undefined) return { path: "", error: `plugin at "${start}" exceeds ${MAX_PLUGIN_BYTES}-byte limit` }
      if (want !== "") {
        const got = sha256Hex(body)
        if (got !== want) return { path: "", error: `plugin at "${start}" does not match its sha256 pin (the download's sha256 is ${got})` }
      }
      const priv = ensurePrivateCacheDir()
      if (priv !== "") return { path: "", error: `failed to write plugin: ${priv}` }
      const file = pluginFileFor(start)
      try {
        writeFileAtomic(file, body, { mode: 384, durable: false })
      } catch (e) {
        return { path: "", error: `failed to write plugin to temporary file: ${e.message}` }
      }
      return { path: file, error: "" }
    }
    return { path: "", error: "too many redirects downloading plugin" }
  } catch (e) {
    return { path: "", error: `failed to download plugin: ${e.message}` }
  } finally {
    dl.finish()
  }
}

function isSoUrl(u: string): bool {
  return u.split("?")[0]!.toLowerCase().endsWith(".so")
}

// The plugin URLs among sources that have no local copy yet, or none that matches the pin (a .so URL is left out: it
// cannot load here).
export function missingPluginUrls(sources: PluginSource[]): PluginSource[] {
  const out: PluginSource[] = []
  const seen: string[] = []
  for (const s of sources) {
    const u = s.path.trim()
    if (!isPluginUrl(u) || isSoUrl(u) || seen.includes(u)) continue
    if (downloadedPlugin(u, s.sha256) === undefined) {
      seen.push(u)
      out.push({ path: u, sha256: s.sha256 })
    }
  }
  return out
}

// The plugin URLs among sources (a .so URL is left out: it cannot load here).
function pluginUrls(sources: PluginSource[]): PluginSource[] {
  const out: PluginSource[] = []
  const seen: string[] = []
  for (const s of sources) {
    const u = s.path.trim()
    if (isPluginUrl(u) && !isSoUrl(u) && !seen.includes(u)) {
      seen.push(u)
      out.push({ path: u, sha256: s.sha256 })
    }
  }
  return out
}

// Downloads the plugin URLs among sources (all of them, as Bifrost downloads a plugin each time it loads it, or with
// onlyMissing those that have no matching local copy yet): how many were fetched, and the errors.
export async function fetchPluginUrls(sources: PluginSource[], allow: string[], onlyMissing: bool): Promise<{ fetched: int, errors: string[] }> {
  let fetched = 0
  const errors: string[] = []
  for (const s of onlyMissing ? missingPluginUrls(sources) : pluginUrls(sources)) {
    const r = await downloadPlugin(s.path, allow, s.sha256)
    if (r.error !== "") errors.push(r.error)
    else fetched += 1
  }
  return { fetched: fetched, errors: errors }
}

// ---- tests ----

test("plugin URLs: https only unless pinned, private hosts only when allowed, and a cache file per URL", () => {
  expect(isPluginUrl("https://example.com/p.wasm")).toBe(true)
  expect(isPluginUrl("/opt/plugins/p.wasm")).toBe(false)
  expect(isPluginUrl(undefined)).toBe(false)
  expect(urlProblem("https://plugins.example.com/p.wasm", [], false)).toBe("")
  expect(urlProblem("ftp://plugins.example.com/p.wasm", [], false).includes("only https")).toBe(true)
  expect(urlProblem("http://plugins.example.com/p.wasm", [], false).includes("must be https")).toBe(true)
  expect(urlProblem("http://plugins.example.com/p.wasm", [], true)).toBe("")
  expect(urlProblem("https://127.0.0.1:9/p.wasm", [], false).includes("private address")).toBe(true)
  expect(urlProblem("https://2130706433:9/p.wasm", [], false).includes("private address")).toBe(true)
  expect(urlProblem("https://127.0.0.1:9/p.wasm", ["127.0.0.1"], false)).toBe("")
  expect(urlProblem("https://169.254.169.254/p.wasm", ["169.254.169.254"], false).includes("metadata")).toBe(true)
  const a = pluginFileFor("https://example.com/a.wasm")
  expect(a.endsWith(".wasm") && a.startsWith(pluginCacheDir() + "/")).toBe(true)
  expect(a === pluginFileFor("https://example.com/b.wasm")).toBe(false)
  expect(pluginFileFor("https://example.com/a.so").endsWith(".so")).toBe(true)
  expect(redirectTarget("https://a.example/x/p.wasm", "/y/p.wasm")).toBe("https://a.example/y/p.wasm")
  expect(redirectTarget("https://a.example/x/p.wasm", "https://b.example/p.wasm")).toBe("https://b.example/p.wasm")
  expect(redirectTarget("https://a.example/x/p.wasm", "p.wasm")).toBe("")
})

test("sha256 pins: format, file checks, and a private cache directory", () => {
  const hello = sha256Hex(utf8("hello"))
  expect(hello).toBe("2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824")
  expect(pinProblem(undefined)).toBe("")
  expect(pinProblem(" " + hello.toUpperCase() + " ")).toBe("")
  expect(pinProblem("abc")).toBe("sha256 must be 64 hex digits")
  expect(pinProblem(hello.slice(0, 63) + "g")).toBe("sha256 must be 64 hex digits")
  const prev = cacheBase
  const base = (process.env.TMPDIR ?? "/tmp") + "/raiju-plugindl-test-" + Math.floor(Math.random() * 1000000000)
  setPluginCacheBase(base)
  expect(pluginCacheDir()).toBe(base + "/plugin-cache")
  try mkdirSync(base + "/plugin-cache", { recursive: true })
  try chmodSync(base + "/plugin-cache", 511)
  expect(ensurePrivateCacheDir()).toBe("")
  expect((try statSync(base + "/plugin-cache")).mode & 511).toBe(448)
  const f = pluginFileFor("https://example.com/hello.wasm")
  try writeFileAtomic(f, utf8("hello"), { mode: 384, durable: false })
  expect(downloadedPlugin("https://example.com/hello.wasm")).toBe(f)
  expect(downloadedPlugin("https://example.com/hello.wasm", hello)).toBe(f)
  expect(downloadedPlugin("https://example.com/hello.wasm", sha256Hex(utf8("other")))).toBe(undefined)
  expect(fileMatchesPin(f, sha256Hex(utf8("other"))).includes("does not match its sha256 pin")).toBe(true)
  expect(missingPluginUrls([{ path: "https://example.com/hello.wasm", sha256: hello }]).length).toBe(0)
  expect(missingPluginUrls([{ path: "https://example.com/hello.wasm", sha256: sha256Hex(utf8("x")) }]).length).toBe(1)
  setPluginCacheBase(prev)
})
