// Virtual keys, budgets and rate limits, with Bifrost's Customer → Team → VK
// hierarchy. State is in memory, per process.
import { Config, VirtualKeyConfig, BudgetConfig, BudgetOverride, RateLimitConfig, RateLimitShare, AccessProfile, ModelConfigGovernance, ProviderGovernance, ProjectConfig, ProviderConfigRef, GovernanceConfig } from "./config"
import { Effective, applyProfiles, applyHeld, modelAllowed } from "./profiles"
import { heldProfiles } from "./govapi"
import { Hdrs, hdrs } from "./schemas"
import { BudgetUsage, RateUse, ScopeUsage } from "./alerts"
import { rfc3339Ms, rfc3339Of } from "./vkexpiry"

// "30s", "5m", "1h", "1d", "1w", "1M" (30 days), "1Q", "1Y" in milliseconds.
export function durationMs(s: string): int {
  let i = 0
  while (i < s.byteLength && "0123456789".includes(s.slice(i, i + 1))) i += 1
  const n = parseInt(s.slice(0, i)) ?? 1
  const unit = s.slice(i)
  if (unit === "s") return n * 1000
  if (unit === "m") return n * 60000
  if (unit === "h") return n * 3600000
  if (unit === "d") return n * 86400000
  if (unit === "w") return n * 604800000
  if (unit === "M") return n * 2592000000
  if (unit === "Q") return n * 7776000000
  if (unit === "Y") return n * 31536000000
  return n * 60000
}

class Window {
  used = 0.0
  start = 0.0
  // usage reported by other cluster nodes for the same window
  remote = 0.0
  // clustered windows start on multiples of the period, so every node agrees on them
  aligned = false
  // a cycles budget override: extra adds to the limit for extraCycles more windows (the current one
  // counts). extraSig names the override it came from, so a config reload keeps the count it has run.
  extra = 0.0
  extraCycles = 0
  extraSig = ""
  constructor(readonly limit: f64, readonly periodMs: int) {}
  roll(now: f64): void {
    if (this.aligned) {
      const s = Math.floor(now / this.periodMs) * this.periodMs
      if (s !== this.start) {
        this.start = s
        this.used = 0.0
        this.remote = 0.0
        this.endCycle()
      }
      return
    }
    if (now - this.start >= this.periodMs) {
      this.start = now
      this.used = 0.0
      this.endCycle()
    }
  }
  // A new window began: a cycles override runs out after its last cycle.
  private endCycle(): void {
    if (this.extraCycles > 0) this.extraCycles -= 1
    if (this.extraCycles <= 0) this.extra = 0.0
  }
  remaining(now: f64): f64 {
    this.roll(now)
    return this.limit + this.extra - this.used - this.remote
  }
  // The window's id across nodes: its index, zero-padded so ids sort as strings.
  id(now: f64): string {
    this.roll(now)
    const n = "" + Math.floor(now / this.periodMs)
    return "0000000000000000".slice(0, Math.max(0, 16 - n.byteLength)) + n
  }
  add(now: f64, by: f64): void {
    this.roll(now)
    this.used += by
  }
}

class Limits {
  requests: Window | undefined = undefined
  tokens: Window | undefined = undefined
}

export type Denial = { kind: "denial", status: int, type: string, message: string }

// Who a request is attributed to: its team, customer, business unit and project, by id and name ("" when none).
// Recorded on log entries and metric labels whether or not the project or customer charges anything.
export type Attribution = { teamId: string, teamName: string, customerId: string, customerName: string, businessUnitId: string, businessUnitName: string, projectId: string, projectName: string }

export function noAttribution(): Attribution {
  return { teamId: "", teamName: "", customerId: "", customerName: "", businessUnitId: "", businessUnitName: "", projectId: "", projectName: "" }
}

// What a request is allowed to do once its virtual key checks out.
export type Grant = { kind: "grant", vk: VirtualKeyConfig | undefined, budgets: string[], rateLimits: string[], attr?: Attribution }

// Bifrost's virtual key prefix: a key with it is a virtual key, never a provider key.
const VK_PREFIX = "sk-bf-"

// The caller's own provider key (Bifrost's direct key), or undefined. It counts only when the server
// allows direct keys (client.allow_direct_keys) and the request says x-bf-direct-key: true. The key is
// the Bearer token, else x-api-key, else x-goog-api-key; a virtual key never counts. Matches ctx.go.
export function directKeyFrom(h: Hdrs, allowed: bool): string | undefined {
  if (!allowed || h.get("x-bf-direct-key") !== "true") return undefined
  const isProviderKey = (v: string): bool => v !== "" && !v.toLowerCase().startsWith(VK_PREFIX)
  const auth = h.get("authorization") ?? ""
  if (auth.toLowerCase().startsWith("bearer ")) {
    const v = auth.slice(7).trim()
    if (isProviderKey(v)) return v
  }
  for (const name of ["x-api-key", "x-goog-api-key"]) {
    const v = (h.get(name) ?? "").trim()
    if (isProviderKey(v)) return v
  }
  return undefined
}

// A budget's limit with its override applied: a "forever" override adds its amount to max_limit.
export function effectiveBudgetLimit(b: BudgetConfig): f64 {
  const o = b.override
  if (o === undefined || o.mode !== "forever") return b.max_limit
  return b.max_limit + o.amount
}

// The rate limit config with this id, or undefined.
function rateLimitConfigOf(g: GovernanceConfig, id: string): RateLimitConfig | undefined {
  for (const r of g.rate_limits ?? []) {
    if (r.id === id) return r
  }
  return undefined
}

// A member's slice of one count (tokens or requests) of a rate limit: under an equal split, the whole
// part of the source's count per member; otherwise the member's share of it (a percent of the count, or
// an amount), 0 when the member has none.
function rateShareOf(max: int | undefined, equal: bool, n: int, shares: RateLimitShare[], src: string, kind: string): int {
  if (max === undefined) return 0
  if (equal) return Math.floor(max / n)
  let out = 0
  for (const s of shares) {
    if (s.source_rate_limit_id !== src) continue
    const v = kind === "token" ? s.token_share : s.request_share
    if (v === undefined) continue
    const t = kind === "token" ? s.token_share_type : s.request_share_type
    out = t === "percent" ? Math.floor(max * v / 100) : v
  }
  return out
}

// The cycles a cycles override still has at now: its cycles less the reset windows since started_at.
export function cyclesLeft(o: BudgetOverride, periodMs: int, now: f64): int {
  const at = rfc3339Ms(o.started_at ?? "")
  const passed = at === undefined ? 0 : Math.max(0, Math.floor((now - at) / periodMs))
  return (o.cycles ?? 1) - passed
}

// The start of the reset window the cycles of an override are in at now (from started_at), or undefined
// when the override has no start.
export function cycleStart(o: BudgetOverride, periodMs: int, now: f64): f64 | undefined {
  const at = rfc3339Ms(o.started_at ?? "")
  if (at === undefined) return undefined
  const passed = Math.max(0, Math.floor((now - at) / periodMs))
  return at + passed * periodMs
}

// The configured budget with this id, or undefined.
function budgetConfigOf(g: GovernanceConfig, id: string): BudgetConfig | undefined {
  for (const b of g.budgets ?? []) {
    if (b.id === id) return b
  }
  return undefined
}

export class Governance {
  vks: Map<string, VirtualKeyConfig> = new Map()
  budgets: Map<string, Window> = new Map()
  limits: Map<string, Limits> = new Map()
  teams: Map<string, { budget?: string, customer?: string, bu?: string }> = new Map()
  customers: Map<string, string | undefined> = new Map()
  businessUnits: Map<string, { budget?: string, rate?: string, customers: string[] }> = new Map()
  // governance.projects by id
  projects: Map<string, ProjectConfig> = new Map()
  // team, customer, business unit and project names, for routing rules' team_name and customer_name
  names: Map<string, string> = new Map()
  // customers by name, for x-bf-customer-name
  customerIds: Map<string, string> = new Map()
  enforce = false
  // other credentials accepted on inference when enforced (admin users and tokens, as Bifrost)
  altAuth: ((h: Hdrs) => bool) | undefined = undefined
  // client.dual_credential_conflict_behavior "error": a request with an identity token and x-bf-vk is refused
  dualError = false
  required: string[] = []
  // client.allow_direct_keys: a request may carry its own provider key instead of a virtual key
  directKeys = false
  // the effective policy of each key that uses access profiles, by key id
  policies: Map<string, Effective> = new Map()
  // when each key expires (epoch ms), by key id
  expiry: Map<string, number> = new Map()
  // a rotated key's retired value, by value: it keeps working until its grace period ends
  prevVks: Map<string, { vk: VirtualKeyConfig, until: number }> = new Map()
  // governance.model_configs and governance.providers, applied to every request by modelLimits()
  modelConfigs: ModelConfigGovernance[] = []
  providerGovs: ProviderGovernance[] = []
  // a project member's slices of the project's budgets, by "project/user": the derived budget ids
  memberCaps: Map<string, string[]> = new Map()
  // a project member's slices of the project's rate limits, by "project/user": the derived rate limit ids
  memberRateCaps: Map<string, string[]> = new Map()
  // a user's own copies of the budgets and rate limits of the profiles they hold, by user name: the derived ids
  heldBudgets: Map<string, string[]> = new Map()
  heldRates: Map<string, string[]> = new Map()

  constructor(cfg: Config) {
    const g0 = cfg.governance
    const a = g0?.auth_config
    const hasCredentials = (g0?.virtual_keys ?? []).length > 0 || (g0?.users ?? []).length > 0 ||
      (a !== undefined && ((a.token ?? "") !== "" || (a.username ?? "") !== ""))
    // Bifrost's enforce_auth_on_inference (enforce_governance_header is its older name)
    this.enforce = cfg.client?.enforce_auth_on_inference ?? cfg.client?.enforce_governance_header ?? hasCredentials
    this.required = (cfg.client?.required_headers ?? []).map((n) => n.toLowerCase())
    this.dualError = cfg.client?.dual_credential_conflict_behavior === "error"
    this.directKeys = cfg.client?.allow_direct_keys === true
    const g = cfg.governance
    if (g === undefined) return
    this.modelConfigs = g.model_configs ?? []
    this.providerGovs = g.providers ?? []
    for (const b of g.budgets ?? []) {
      const w = new Window(effectiveBudgetLimit(b), durationMs(b.reset_duration))
      w.used = b.current_usage ?? 0.0
      w.start = Date.now()
      const o = b.override
      if (o !== undefined && o.mode === "cycles") {
        // the cycles run from started_at, so a restart resumes them: the windows that have passed since
        // then are used up (an override without started_at, from before it was kept, starts again)
        const left = cyclesLeft(o, w.periodMs, Date.now())
        if (left > 0) {
          w.extra = o.amount
          w.extraCycles = left
        }
        w.extraSig = `${o.amount}/${o.cycles ?? 1}`
        // the window this boot starts in is the one the cycles are in, so the next reset comes when it should
        const cs = cycleStart(o, w.periodMs, Date.now())
        if (cs !== undefined) w.start = cs
      }
      this.budgets.set(b.id, w)
    }
    this.addMemberCaps(g)
    for (const r of g.rate_limits ?? []) this.addRateLimit(r)
    const profiles: Map<string, AccessProfile> = new Map()
    for (const p of g.access_profiles ?? []) profiles.set(p.id, p)
    // the profiles each user holds, by hand or through the user's role: they govern the user's keys
    const held: Map<string, AccessProfile[]> = new Map()
    for (const u of g.users ?? []) {
      const hs = heldProfiles(g.users, g.roles, g.access_profiles, u.name)
      if (hs.length > 0) held.set(u.name, hs)
    }
    for (const name of held.keys()) this.addHeldCaps(g, name, held.get(name)!)
    for (const vk of g.virtual_keys ?? []) {
      this.trackGrace(vk)
      const ids = vk.access_profile_ids ?? []
      const uid: string = vk.user_id ?? ""
      const hs: AccessProfile[] = held.has(uid) ? held.get(uid)! : []
      if (ids.length === 0 && hs.length === 0) {
        this.vks.set(vk.value, vk)
        continue
      }
      let eff = applyProfiles(vk, ids, profiles)
      if (hs.length > 0) eff = applyHeld(eff, hs)
      this.vks.set(vk.value, eff.vk)
      this.policies.set(vk.id, eff)
    }
    this.names = new Map()
    for (const t of g.teams ?? []) {
      this.teams.set(t.id, { budget: t.budget_id, customer: t.customer_id, bu: t.business_unit_id })
      this.names.set("team:" + t.id, t.name)
    }
    for (const c of g.customers ?? []) {
      this.customers.set(c.id, c.budget_id)
      this.names.set("customer:" + c.id, c.name)
      this.customerIds.set(c.name, c.id)
    }
    // a team listed under a business unit joins it, unless the team names its unit itself
    for (const b of g.business_units ?? []) {
      this.businessUnits.set(b.id, { budget: b.budget_id, rate: b.rate_limit_id, customers: b.customer_ids ?? [] })
      this.names.set("bu:" + b.id, b.name)
      for (const tid of b.team_ids ?? []) {
        const cur = this.teams.get(tid)
        if (cur !== undefined && cur.bu === undefined) this.teams.set(tid, { budget: cur.budget, customer: cur.customer, bu: b.id })
      }
    }
    for (const p of g.projects ?? []) {
      this.projects.set(p.id, p)
      this.names.set("project:" + p.id, p.name)
    }
  }

  // A user's own copy of each budget and rate limit that the profiles they hold name: a window per user,
  // checked and debited on each of the user's requests (admit, admitTool). Its id is the shared one with
  // "@user/<name>" added. Every held profile's budget is charged, where Bifrost charges one of them.
  private addHeldCaps(g: GovernanceConfig, user: string, hs: AccessProfile[]): void {
    const budgets: string[] = []
    const rates: string[] = []
    for (const p of hs) {
      if (p.is_active === false) continue
      const b = p.budget_id
      if (b !== undefined) {
        const sb = budgetConfigOf(g, b)
        const id = `${b}@user/${user}`
        if (sb !== undefined && !budgets.includes(id)) {
          const w = new Window(effectiveBudgetLimit(sb), durationMs(sb.reset_duration))
          w.start = Date.now()
          this.budgets.set(id, w)
          budgets.push(id)
        }
      }
      const r = p.rate_limit_id
      if (r !== undefined) {
        const sl = rateLimitConfigOf(g, r)
        const id = `${r}@user/${user}`
        if (sl !== undefined && !rates.includes(id)) {
          const l = new Limits()
          if (sl.request_max_limit !== undefined) l.requests = new Window(sl.request_max_limit, durationMs(sl.request_reset_duration ?? "1m"))
          if (sl.token_max_limit !== undefined) l.tokens = new Window(sl.token_max_limit, durationMs(sl.token_reset_duration ?? "1m"))
          this.limits.set(id, l)
          rates.push(id)
        }
      }
    }
    this.heldBudgets.set(user, budgets)
    this.heldRates.set(user, rates)
  }

  addRateLimit(r: RateLimitConfig): void {
    const l = new Limits()
    const rm = r.request_max_limit
    if (rm !== undefined) l.requests = new Window(rm, durationMs(r.request_reset_duration ?? "1m"))
    const tm = r.token_max_limit
    if (tm !== undefined) l.tokens = new Window(tm, durationMs(r.token_reset_duration ?? "1m"))
    this.limits.set(r.id, l)
  }

  // Finds the virtual key in any header an SDK might carry it in.
  findKey(h: Hdrs): VirtualKeyConfig | undefined {
    const candidates: string[] = []
    const direct = h.get("x-bf-vk")
    if (direct !== undefined) candidates.push(direct)
    const auth = h.get("authorization")
    if (auth !== undefined && auth.startsWith("Bearer ")) candidates.push(auth.slice(7))
    for (const name of ["x-api-key", "x-goog-api-key", "api-key"]) {
      const v = h.get(name)
      if (v !== undefined) candidates.push(v)
    }
    for (const c of candidates) {
      const vk = this.vks.get(c.trim())
      if (vk !== undefined) return vk
    }
    // a rotated key's old value works until its grace period ends
    const now = Date.now()
    for (const c of candidates) {
      const p = this.prevVks.get(c.trim())
      if (p !== undefined && p.until > now) return this.vks.get(p.vk.value) ?? p.vk
    }
    return undefined
  }

  // Records a key's expiry and its retired value's grace period, as read from the config.
  trackGrace(vk: VirtualKeyConfig): void {
    const exp = rfc3339Ms(vk.expires_at ?? "")
    if (exp !== undefined) this.expiry.set(vk.id, exp)
    const pv = vk.previous_value ?? ""
    const until = rfc3339Ms(vk.previous_value_expires_at ?? "")
    if (pv !== "" && until !== undefined) this.prevVks.set(pv, { vk: vk, until: until })
  }

  expired(vk: VirtualKeyConfig): bool {
    const at = this.expiry.get(vk.id)
    return at !== undefined && at <= Date.now()
  }

  // Checks the key, the provider and model it may use, the project it names, and every limit above
  // them. The caller's own access (its key's profile and provider configs) and the project's access
  // combine by the project's access_rule: union when either allows, intersect when both do.
  admit(h: Hdrs, provider: string, model: string): Grant | Denial {
    const missing = missingHeader(h, this.required)
    if (missing !== undefined) return { kind: "denial", status: 400, type: "invalid_request_error", message: `the request needs the ${missing} header` }
    // an identity token and a virtual key on one request: refused under "error", and otherwise the key governs it
    if (this.dualError && h.get("x-bf-vk") !== undefined) {
      const idAuth = this.altAuth
      if (idAuth !== undefined && idAuth(h)) return { kind: "denial", status: 400, type: "invalid_request_error", message: "the request carries both an identity token and x-bf-vk, and client.dual_credential_conflict_behavior is error" }
    }
    const vk = this.findKey(h)
    if (vk === undefined) {
      const alt = this.altAuth
      // a direct provider key satisfies the auth requirement, as in Bifrost; provider and model limits still apply
      const direct = directKeyFrom(h, this.directKeys) !== undefined
      if (this.enforce && !direct && !(alt !== undefined && alt(h))) return { kind: "denial", status: 401, type: "authentication_error", message: "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)" }
    } else if (vk.is_active === false) {
      return { kind: "denial", status: 403, type: "permission_error", message: `virtual key ${vk.name ?? vk.id} is inactive` }
    } else if (this.expired(vk)) {
      return { kind: "denial", status: 403, type: "permission_error", message: `virtual key ${vk.name ?? vk.id} has expired` }
    }
    const pol = vk === undefined ? undefined : this.policies.get(vk.id)
    if (vk !== undefined && pol !== undefined) {
      // fail closed: a profile that went missing must not lift its restrictions
      if (pol.errors.length > 0) return { kind: "denial", status: 403, type: "permission_error", message: `virtual key ${vk.name ?? vk.id}: ${pol.errors.join("; ")}` }
      const miss = missingHeader(h, pol.requiredHeaders)
      if (miss !== undefined) return { kind: "denial", status: 400, type: "invalid_request_error", message: `the request needs the ${miss} header` }
    }
    // the project the request names: missing, inactive or not open to this key is refused as not found
    const pr = this.projectOf(h)
    let project: ProjectConfig | undefined = undefined
    if (pr.requested) {
      const p = pr.p
      if (p === undefined || p.is_active === false || !this.projectAdmits(p, vk)) {
        return { kind: "denial", status: 403, type: "access_blocked", message: `project "${pr.label}" not found. It does not exist or does not admit this request.` }
      }
      project = p
    }
    const callerNo = this.callerDenial(vk, pol, provider, model)
    const pcs: ProviderConfigRef[] = project === undefined ? [] : (project.provider_configs ?? [])
    const projectYes = project !== undefined && pcs.some((pc) => pc.provider === provider && pcMatches(pc, model))
    if (project === undefined) {
      if (callerNo !== undefined) return callerNo
    } else {
      const projectNo: Denial = { kind: "denial", status: 403, type: "permission_error", message: `project ${project.name} may not use ${provider}/${model}` }
      const rule = project.access_rule ?? "union"
      if (rule === "intersect") {
        if (callerNo !== undefined) return callerNo
        if (!projectYes) return projectNo
      } else if (rule === "union") {
        if (callerNo !== undefined && !projectYes) return callerNo
      } else {
        // an unrecognised access rule permits nothing
        return projectNo
      }
    }
    // accounting: which ledgers the request draws from
    const acc = project?.accounting_mode ?? "both"
    const useProject = project !== undefined && acc !== "principal_only"
    const useCaller = callerNo === undefined && acc !== "project_only"
    const budgets: string[] = []
    const rateLimits: string[] = []
    if (project !== undefined && useProject) {
      if (project.budget_id !== undefined) budgets.push(project.budget_id)
      if (project.rate_limit_id !== undefined) rateLimits.push(project.rate_limit_id)
      for (const pc of pcs) {
        if (pc.provider !== provider || !pcMatches(pc, model)) continue
        if (pc.budget_id !== undefined) budgets.push(pc.budget_id)
        if (pc.rate_limit_id !== undefined) rateLimits.push(pc.rate_limit_id)
      }
      // the member's own slices of the project's budgets and rate limits
      const uid = vk === undefined ? undefined : vk.user_id
      if (uid !== undefined) {
        for (const id of this.memberCaps.get(project.id + "/" + uid) ?? []) budgets.push(id)
        for (const id of this.memberRateCaps.get(project.id + "/" + uid) ?? []) rateLimits.push(id)
      }
    }
    // the hierarchy above the key: team, business unit, and the customers it reaches
    const teamId = vk === undefined ? undefined : vk.team_id
    const team = teamId === undefined ? undefined : this.teams.get(teamId)
    const buId = team?.bu
    const bu = buId === undefined ? undefined : this.businessUnits.get(buId)
    const primary = vk?.customer_id ?? team?.customer
    const reach: string[] = []
    if (primary !== undefined) reach.push(primary)
    for (const c of bu?.customers ?? []) {
      if (!reach.includes(c)) reach.push(c)
    }
    // x-bf-customer-id (or -name) charges only that customer; it must be one the key reaches
    let charged: string[] = reach
    const cid = (h.get("x-bf-customer-id") ?? "").trim()
    const cname = (h.get("x-bf-customer-name") ?? "").trim()
    if (vk !== undefined && (cid !== "" || cname !== "")) {
      const want = cid !== "" ? cid : (this.customerIds.get(cname) ?? "")
      if (want === "" || !reach.includes(want)) {
        return { kind: "denial", status: 403, type: "permission_error", message: `customer ${cid !== "" ? cid : cname} is not reachable by virtual key ${vk.name ?? vk.id}` }
      }
      charged = [want]
    }
    if (vk !== undefined && useCaller) {
      for (const pc of vk.provider_configs ?? []) {
        if (pc.provider !== provider || !pcMatches(pc, model)) continue
        if (pc.budget_id !== undefined) budgets.push(pc.budget_id)
        if (pc.rate_limit_id !== undefined) rateLimits.push(pc.rate_limit_id)
      }
      if (vk.budget_id !== undefined) budgets.push(vk.budget_id)
      if (vk.rate_limit_id !== undefined) rateLimits.push(vk.rate_limit_id)
      // the user's own copies of the budgets and rate limits of the profiles they hold
      const huid: string = vk.user_id ?? ""
      for (const id of this.heldBudgets.get(huid) ?? []) budgets.push(id)
      for (const id of this.heldRates.get(huid) ?? []) rateLimits.push(id)
      if (team !== undefined && team.budget !== undefined) budgets.push(team.budget)
      if (bu !== undefined) {
        if (bu.budget !== undefined) budgets.push(bu.budget)
        if (bu.rate !== undefined) rateLimits.push(bu.rate)
      }
      for (const c of charged) {
        const cb = this.customers.get(c)
        if (cb !== undefined) budgets.push(cb)
      }
    }
    // model configs and provider governance add their budgets and limits to the request's own
    const lim = this.modelLimits(vk, provider, model)
    for (const id of lim.budgets) budgets.push(id)
    for (const id of lim.rateLimits) rateLimits.push(id)
    const cust = charged[0]
    const attr: Attribution = {
      teamId: teamId ?? "",
      teamName: this.teamName(vk) ?? "",
      customerId: cust ?? "",
      customerName: cust === undefined ? "" : (this.names.get("customer:" + cust) ?? ""),
      businessUnitId: buId ?? "",
      businessUnitName: buId === undefined ? "" : (this.names.get("bu:" + buId) ?? ""),
      projectId: project?.id ?? "",
      projectName: project?.name ?? "",
    }
    return this.checkLimits(vk, budgets, rateLimits, attr)
  }

  // The project a request names: x-bf-project-id when present (even empty, which names none), else x-bf-project-name.
  private projectOf(h: Hdrs): { requested: bool, p: ProjectConfig | undefined, label: string } {
    const byId = h.get("x-bf-project-id")
    if (byId !== undefined) {
      const label = byId.trim()
      return { requested: true, p: this.projects.get(label), label: label }
    }
    const byName = (h.get("x-bf-project-name") ?? "").trim()
    if (byName === "") return { requested: false, p: undefined, label: "" }
    return { requested: true, p: this.projectByName(byName), label: byName }
  }

  private projectByName(name: string): ProjectConfig | undefined {
    for (const k of this.projects.keys()) {
      const p = this.projects.get(k)
      if (p !== undefined && p.name === name) return p
    }
    return undefined
  }

  // An open project admits any caller; an explicit one admits the virtual keys it lists.
  private projectAdmits(p: ProjectConfig, vk: VirtualKeyConfig | undefined): bool {
    if ((p.membership_mode ?? "explicit") === "open") return true
    if (vk === undefined) return false
    if ((p.virtual_key_ids ?? []).includes(vk.id)) return true
    // a key assigned to a member user is admitted as that member
    const uid = vk.user_id
    return uid !== undefined && (p.members ?? []).some((m) => m.user_id === uid)
  }

  // The caller's own access to provider and model: its access profile's model rules, then its provider
  // configs. Undefined when allowed (and always when there is no key).
  private callerDenial(vk: VirtualKeyConfig | undefined, pol: Effective | undefined, provider: string, model: string): Denial | undefined {
    if (vk === undefined) return undefined
    const no: Denial = { kind: "denial", status: 403, type: "permission_error", message: `virtual key ${vk.name ?? vk.id} may not use ${provider}/${model}` }
    if (pol !== undefined && !modelAllowed(pol, provider, model)) return no
    const pcs = vk.provider_configs ?? []
    if (pcs.length > 0 && !pcs.some((pc) => pc.provider === provider && pcMatches(pc, model))) return no
    return undefined
  }

  // A member's slice of each budget and rate limit its project holds (the project's own and each provider's):
  // under an equal split an equal part of every one, otherwise the member's own shares. A slice is a cap of
  // its own, checked with the cap it divides and debited with it (admit). Token and request counts divide
  // in whole numbers, so a remainder stays unallocated, as Bifrost does it. Redivision on a roster change
  // comes with the config reload, and the slices keep the use they have counted (carryUsage).
  private addMemberCaps(g: GovernanceConfig): void {
    for (const pj of g.projects ?? []) {
      const members = pj.members ?? []
      if (members.length === 0) continue
      const sources: string[] = []
      if (pj.budget_id !== undefined) sources.push(pj.budget_id)
      for (const pc of pj.provider_configs ?? []) {
        const b = pc.budget_id
        if (b !== undefined && !sources.includes(b)) sources.push(b)
      }
      const rsources: string[] = []
      if (pj.rate_limit_id !== undefined) rsources.push(pj.rate_limit_id)
      for (const pc of pj.provider_configs ?? []) {
        const r = pc.rate_limit_id
        if (r !== undefined && !rsources.includes(r)) rsources.push(r)
      }
      const equal = pj.split_policy === "equal"
      for (const m of members) {
        const ids: string[] = []
        for (const src of sources) {
          const sb = budgetConfigOf(g, src)
          if (sb === undefined) continue
          const base = effectiveBudgetLimit(sb)
          let amount = 0.0
          if (equal) {
            amount = base / members.length
          } else {
            for (const s of m.budget_shares ?? []) {
              if (s.source_budget_id !== src) continue
              amount = s.share_type === "percent" ? base * s.share_value / 100.0 : s.share_value
            }
          }
          if (!(amount > 0.0)) continue
          const id = `${src}@${pj.id}/${m.user_id}`
          const w = new Window(amount, durationMs(sb.reset_duration))
          w.start = Date.now()
          this.budgets.set(id, w)
          ids.push(id)
        }
        this.memberCaps.set(pj.id + "/" + m.user_id, ids)
        const rshares: RateLimitShare[] = m.rate_limit_shares ?? []
        const rids: string[] = []
        for (const src of rsources) {
          const sl = rateLimitConfigOf(g, src)
          if (sl === undefined) continue
          const tokens = rateShareOf(sl.token_max_limit, equal, members.length, rshares, src, "token")
          const requests = rateShareOf(sl.request_max_limit, equal, members.length, rshares, src, "request")
          if (!(tokens > 0) && !(requests > 0)) continue
          const id = `${src}@${pj.id}/${m.user_id}`
          const l = new Limits()
          if (requests > 0) l.requests = new Window(requests, durationMs(sl.request_reset_duration ?? "1m"))
          if (tokens > 0) l.tokens = new Window(tokens, durationMs(sl.token_reset_duration ?? "1m"))
          this.limits.set(id, l)
          rids.push(id)
        }
        this.memberRateCaps.set(pj.id + "/" + m.user_id, rids)
      }
    }
  }

  // Denies when a budget is used up (402) or a rate limit is reached (429); otherwise counts the request.
  checkLimits(vk: VirtualKeyConfig | undefined, budgets: string[], rateLimits: string[], attr?: Attribution): Grant | Denial {
    const now = Date.now()
    for (const id of budgets) {
      const b = this.budgets.get(id)
      if (b !== undefined && b.remaining(now) <= 0.0) return { kind: "denial", status: 402, type: "budget_exceeded", message: `budget ${id} is used up until it resets` }
    }
    for (const id of rateLimits) {
      const l = this.limits.get(id)
      if (l === undefined) continue
      const r = l.requests
      if (r !== undefined && r.remaining(now) < 1.0) return { kind: "denial", status: 429, type: "rate_limit_exceeded", message: `request rate limit ${id} reached` }
      const t = l.tokens
      if (t !== undefined && t.remaining(now) <= 0.0) return { kind: "denial", status: 429, type: "rate_limit_exceeded", message: `token rate limit ${id} reached` }
    }
    for (const id of rateLimits) {
      const r = this.limits.get(id)?.requests
      if (r !== undefined) r.add(now, 1.0)
    }
    return { kind: "grant", vk: vk, budgets: budgets, rateLimits: rateLimits, attr: attr }
  }

  // The budgets and rate limits that model configs and provider governance put on provider/model.
  // A model config applies when its model is this one or "*", and its provider is this one or unset;
  // a virtual_key-scoped one only for that key. Every match applies. Base-model aliases are not matched.
  modelLimits(vk: VirtualKeyConfig | undefined, provider: string, model: string): { budgets: string[], rateLimits: string[] } {
    const budgets: string[] = []
    const rateLimits: string[] = []
    for (const mc of this.modelConfigs) {
      if (mc.model_name !== model && mc.model_name !== "*") continue
      const p = mc.provider
      if (p !== undefined && p !== provider) continue
      const sc = mc.scope ?? "global"
      if (sc === "virtual_key") {
        if (vk === undefined || mc.scope_id !== vk.id) continue
      } else if (sc !== "global") continue
      const one = mc.budget_id
      if (one !== undefined) budgets.push(one)
      for (const id of mc.budget_ids ?? []) budgets.push(id)
      const rl = mc.rate_limit_id
      if (rl !== undefined) rateLimits.push(rl)
    }
    for (const pg of this.providerGovs) {
      if (pg.name !== provider) continue
      const pb = pg.budget_id
      if (pb !== undefined) budgets.push(pb)
      for (const id of pg.budget_ids ?? []) budgets.push(id)
      const pr = pg.rate_limit_id
      if (pr !== undefined) rateLimits.push(pr)
    }
    return { budgets: budgets, rateLimits: rateLimits }
  }

  // Debits cost from every budget and tokens from every token limit.
  record(g: Grant, tokens: int, cost: f64): void {
    const now = Date.now()
    for (const id of g.budgets) {
      const b = this.budgets.get(id)
      if (b !== undefined) b.add(now, cost)
    }
    for (const id of g.rateLimits) {
      const t = this.limits.get(id)?.tokens
      if (t !== undefined) t.add(now, tokens)
    }
  }

  // Every counter, for sharing with other cluster nodes.
  private windows(): { name: string, w: Window }[] {
    const out: { name: string, w: Window }[] = []
    for (const id of this.budgets.keys()) out.push({ name: "budget:" + id, w: this.budgets.get(id)! })
    for (const id of this.limits.keys()) {
      const l = this.limits.get(id)!
      const r = l.requests
      if (r !== undefined) out.push({ name: "rl:" + id + ":requests", w: r })
      const t = l.tokens
      if (t !== undefined) out.push({ name: "rl:" + id + ":tokens", w: t })
    }
    return out
  }

  // Starts every window on a multiple of its period (as clusters and sibling workers need),
  // keeping the usage counted so far.
  alignWindows(): void {
    const now = Date.now()
    for (const x of this.windows()) {
      if (x.w.aligned) continue
      x.w.aligned = true
      x.w.start = Math.floor(now / x.w.periodMs) * x.w.periodMs
    }
  }

  sharedUsage(now: f64): { name: string, window: string, used: f64 }[] {
    return this.windows().map((x) => ({ name: x.name, window: x.w.id(now), used: x.w.used }))
  }

  setRemote(name: string, window: string, remote: f64, now: f64): void {
    for (const x of this.windows()) {
      if (x.name === name && x.w.id(now) === window) x.w.remote = remote
    }
  }

  // Keeps the usage counted so far in budgets and rate limits that still exist.
  carryUsage(old: Governance): void {
    for (const id of old.budgets.keys()) {
      const was = old.budgets.get(id)!
      const now = this.budgets.get(id)
      if (now !== undefined) {
        now.used = was.used
        now.start = was.start
        now.remote = was.remote
        // the same cycles override keeps the cycles it has run; a changed or new one starts fresh
        if (now.extraSig === was.extraSig) {
          now.extra = was.extra
          now.extraCycles = was.extraCycles
        }
      }
    }
    for (const id of old.limits.keys()) {
      const was = old.limits.get(id)!
      const now = this.limits.get(id)
      if (now === undefined) continue
      const wr = was.requests
      const nr = now.requests
      if (wr !== undefined && nr !== undefined) {
        nr.used = wr.used
        nr.start = wr.start
        nr.remote = wr.remote
      }
      const wt = was.tokens
      const nt = now.tokens
      if (wt !== undefined && nt !== undefined) {
        nt.used = wt.used
        nt.start = wt.start
        nt.remote = wt.remote
      }
    }
  }

  // The highest fraction used among a key's budgets (for routing rules' budget_used).
  budgetFraction(vk: VirtualKeyConfig | undefined): f64 {
    if (vk === undefined) return 0.0
    let worst = 0.0
    const ids: string[] = []
    if (vk.budget_id !== undefined) ids.push(vk.budget_id)
    for (const pc of vk.provider_configs ?? []) {
      if (pc.budget_id !== undefined) ids.push(pc.budget_id)
    }
    for (const id of ids) {
      const b = this.budgets.get(id)
      if (b !== undefined && b.limit > 0.0) worst = Math.max(worst, b.used / b.limit)
    }
    return worst
  }

  teamName(vk: VirtualKeyConfig | undefined): string | undefined {
    const t = vk?.team_id
    return t === undefined ? undefined : this.names.get("team:" + t)
  }

  // The name of the customer a key belongs to, directly or through its team.
  customerName(vk: VirtualKeyConfig | undefined): string | undefined {
    if (vk === undefined) return undefined
    let c = vk.customer_id
    if (c === undefined && vk.team_id !== undefined) c = this.teams.get(vk.team_id)?.customer
    return c === undefined ? undefined : this.names.get("customer:" + c)
  }

  // The highest fraction used among a key's rate limits of one kind (routing rules' request and tokens_used).
  rateFraction(vk: VirtualKeyConfig | undefined, kind: "request" | "token"): f64 {
    if (vk === undefined) return 0.0
    const ids: string[] = []
    if (vk.rate_limit_id !== undefined) ids.push(vk.rate_limit_id)
    for (const pc of vk.provider_configs ?? []) {
      if (pc.rate_limit_id !== undefined) ids.push(pc.rate_limit_id)
    }
    const now = Date.now()
    let worst = 0.0
    for (const id of ids) {
      const l = this.limits.get(id)
      if (l === undefined) continue
      const w = kind === "request" ? l.requests : l.tokens
      if (w === undefined || w.limit <= 0.0) continue
      w.roll(now)
      worst = Math.max(worst, (w.used + w.remote) / w.limit)
    }
    return worst
  }

  // The access-profile policy of the request's key, if it has one.
  policyFor(h: Hdrs): Effective | undefined {
    const vk = this.findKey(h)
    return vk === undefined ? undefined : this.policies.get(vk.id)
  }

  // The project the request names, when it exists, is active and admits the request's key.
  projectFor(h: Hdrs): ProjectConfig | undefined {
    const pr = this.projectOf(h)
    const p = pr.p
    if (!pr.requested || p === undefined || p.is_active === false || !this.projectAdmits(p, this.findKey(h))) return undefined
    return p
  }

  // The gate of an MCP tool call: an inactive or broken key is refused, and the key's budgets (its own,
  // its team's and its customer's) must have room. A call with no key is not limited here, as before
  // the key rules existed. The grant is what record() later debits the tool's price from.
  admitTool(h: Hdrs): Grant | Denial {
    const vk = this.findKey(h)
    if (vk === undefined) return { kind: "grant", vk: undefined, budgets: [], rateLimits: [] }
    if (vk.is_active === false) return { kind: "denial", status: 403, type: "permission_error", message: `virtual key ${vk.name ?? vk.id} is inactive` }
    const pol = this.policies.get(vk.id)
    if (pol !== undefined && pol.errors.length > 0) return { kind: "denial", status: 403, type: "permission_error", message: `virtual key ${vk.name ?? vk.id}: ${pol.errors.join("; ")}` }
    const budgets: string[] = []
    const effective: VirtualKeyConfig = pol === undefined ? vk : pol.vk
    const own = effective.budget_id
    if (own !== undefined) budgets.push(own)
    const team = vk.team_id === undefined ? undefined : this.teams.get(vk.team_id)
    if (team !== undefined && team.budget !== undefined) budgets.push(team.budget)
    const customer = vk.customer_id === undefined ? undefined : this.customers.get(vk.customer_id)
    if (customer !== undefined) budgets.push(customer)
    const tuid: string = vk.user_id ?? ""
    for (const id of this.heldBudgets.get(tuid) ?? []) budgets.push(id)
    return this.checkLimits(vk, budgets, [])
  }

  // Rate-limit windows as used/limit, other cluster nodes' and workers' use included (alerting).
  rateLimitUsage(now: f64): { id: string, kind: "request" | "token", used: f64, limit: f64 }[] {
    const out: { id: string, kind: "request" | "token", used: f64, limit: f64 }[] = []
    for (const id of this.limits.keys()) {
      const l = this.limits.get(id)!
      const r = l.requests
      if (r !== undefined) {
        r.roll(now)
        out.push({ id: id, kind: "request", used: r.used + r.remote, limit: r.limit })
      }
      const t = l.tokens
      if (t !== undefined) {
        t.roll(now)
        out.push({ id: id, kind: "token", used: t.used + t.remote, limit: t.limit })
      }
    }
    return out
  }

  // What a scope's alert rules are judged on: its budgets (each with the reset cycle it is
  // in), and its highest-used request and token rate limits. Undefined when the scope does
  // not exist. A virtual key owns its budget, and its provider configs' budgets and limits;
  // a team or customer owns its budget. Reads the windows (rolling them to now) and changes nothing else.
  scopeUsage(scopeType: string, scopeId: string, now: f64): ScopeUsage | undefined {
    const budgetIds: string[] = []
    const limitIds: string[] = []
    if (scopeType === "virtual_key") {
      const vk = this.vkById(scopeId)
      if (vk === undefined) return undefined
      if (vk.budget_id !== undefined) budgetIds.push(vk.budget_id)
      if (vk.rate_limit_id !== undefined) limitIds.push(vk.rate_limit_id)
      for (const pc of vk.provider_configs ?? []) {
        if (pc.budget_id !== undefined) budgetIds.push(pc.budget_id)
        if (pc.rate_limit_id !== undefined) limitIds.push(pc.rate_limit_id)
      }
    } else if (scopeType === "team") {
      const t = this.teams.get(scopeId)
      if (t === undefined) return undefined
      if (t.budget !== undefined) budgetIds.push(t.budget)
    } else if (scopeType === "customer") {
      if (!this.customers.has(scopeId)) return undefined
      const cb = this.customers.get(scopeId)
      if (cb !== undefined) budgetIds.push(cb)
    } else {
      return undefined
    }
    const budgets: BudgetUsage[] = []
    for (const id of budgetIds) {
      const b = this.budgets.get(id)
      if (b === undefined) continue
      b.roll(now)
      budgets.push({ id: id, spent: b.used + b.remote, limit: b.limit, window: b.id(now) })
    }
    const out: ScopeUsage = { scope_type: scopeType, scope_id: scopeId, budgets: budgets }
    const rq = this.topLimit(limitIds, "request", now)
    if (rq !== undefined) out.requests = rq
    const tk = this.topLimit(limitIds, "token", now)
    if (tk !== undefined) out.tokens = tk
    return out
  }

  // The virtual key with this id (vks is keyed by the key's value).
  private vkById(id: string): VirtualKeyConfig | undefined {
    for (const k of this.vks.keys()) {
      const vk = this.vks.get(k)
      if (vk !== undefined && vk.id === id) return vk
    }
    return undefined
  }

  // The most-used of the named rate limits of one kind, as used (other nodes' use included) and limit.
  private topLimit(ids: string[], kind: "request" | "token", now: f64): RateUse | undefined {
    let best: RateUse | undefined = undefined
    let bestFrac = -1.0
    for (const id of ids) {
      const l = this.limits.get(id)
      if (l === undefined) continue
      const w = kind === "request" ? l.requests : l.tokens
      if (w === undefined || w.limit <= 0.0) continue
      w.roll(now)
      const used = w.used + w.remote
      const frac = used / w.limit
      if (frac > bestFrac) {
        bestFrac = frac
        best = { id: id, used: used, limit: w.limit }
      }
    }
    return best
  }

  budgetUsage(): { id: string, used: f64, limit: f64 }[] {
    const out: { id: string, used: f64, limit: f64 }[] = []
    const now = Date.now()
    for (const id of this.budgets.keys()) {
      const b = this.budgets.get(id)!
      // a cycles override adds to the limit while its cycles run (rolled to now first)
      b.roll(now)
      out.push({ id: id, used: b.used, limit: b.limit + b.extra })
    }
    return out
  }
}

// Whether a provider config allows this model: an empty or "*" allowlist allows every model.
function pcMatches(pc: ProviderConfigRef, model: string): bool {
  const am = pc.allowed_models ?? []
  return am.length === 0 || am.includes(model) || am.includes("*")
}

// The first of `names` the request lacks (or sends empty), if any.
export function missingHeader(h: Hdrs, names: string[]): string | undefined {
  for (const n of names) {
    const v = h.get(n)
    if (v === undefined || v.trim() === "") return n
  }
  return undefined
}

export function isDenial(x: Grant | Denial): bool {
  return x.kind === "denial"
}

function govConfig(): Config {
  return {
    client: { enforce_governance_header: true },
    governance: {
      budgets: [{ id: "b-team", max_limit: 1.0, reset_duration: "1d" }, { id: "b-vk", max_limit: 10.0, reset_duration: "1M" }],
      rate_limits: [{ id: "rl", request_max_limit: 2, request_reset_duration: "1m" }],
      teams: [{ id: "t1", name: "core", budget_id: "b-team" }],
      virtual_keys: [
        { id: "vk1", value: "sk-bf-one", team_id: "t1", budget_id: "b-vk", rate_limit_id: "rl", provider_configs: [{ provider: "openai", allowed_models: ["gpt-4o-mini"] }] },
        { id: "vk2", value: "sk-bf-off", is_active: false },
      ],
    },
  }
}

test("virtual keys: a rotated value works during its grace period, an expired key is refused", () => {
  const future = "2999-01-01T00:00:00Z"
  const cfg: Config = {
    client: { enforce_governance_header: true },
    governance: {
      virtual_keys: [
        { id: "vkA", value: "sk-bf-new", previous_value: "sk-bf-old", previous_value_expires_at: future },
        { id: "vkB", value: "sk-bf-b-new", previous_value: "sk-bf-b-old", previous_value_expires_at: "2000-01-01T00:00:00Z" },
        { id: "vkC", value: "sk-bf-c", expires_at: "2000-01-01T00:00:00Z" },
        { id: "vkD", value: "sk-bf-d", expires_at: future },
      ],
    },
  }
  const g = new Governance(cfg)
  expect(g.findKey(hdrs([["authorization", "Bearer sk-bf-old"]]))?.id).toBe("vkA")
  expect(g.findKey(hdrs([["x-bf-vk", "sk-bf-new"]]))?.id).toBe("vkA")
  expect(g.findKey(hdrs([["x-bf-vk", "sk-bf-b-old"]]))).toBe(undefined)
  expect(isDenial(g.admit(hdrs([["x-bf-vk", "sk-bf-c"]]), "openai", "gpt-4o"))).toBe(true)
  expect(isDenial(g.admit(hdrs([["x-bf-vk", "sk-bf-d"]]), "openai", "gpt-4o"))).toBe(false)
  expect(isDenial(g.admit(hdrs([["x-bf-vk", "sk-bf-old"]]), "openai", "gpt-4o"))).toBe(false)
})

test("durations", () => {
  expect(durationMs("30s")).toBe(30000)
  expect(durationMs("1h")).toBe(3600000)
  expect(durationMs("1M")).toBe(2592000000)
})

test("virtual key admission and limits", () => {
  const g = new Governance(govConfig())
  const none = hdrs([])
  const a = g.admit(none, "openai", "gpt-4o-mini")
  expect(isDenial(a)).toBe(true)
  const h = hdrs([["authorization", "Bearer sk-bf-one"]])
  expect(isDenial(g.admit(h, "anthropic", "claude"))).toBe(true)
  const ok = g.admit(h, "openai", "gpt-4o-mini")
  expect(isDenial(ok)).toBe(false)
  expect((ok as Grant).budgets).toEqual(["b-vk", "b-team"])
  expect(isDenial(g.admit(h, "openai", "gpt-4o-mini"))).toBe(false)
  // third request inside the minute hits the request limit
  const third = g.admit(h, "openai", "gpt-4o-mini")
  expect((third as Denial).status).toBe(429)
  const off = g.admit(hdrs([["x-bf-vk", "sk-bf-off"]]), "openai", "x")
  expect((off as Denial).status).toBe(403)
})

test("budgets debit up the hierarchy", () => {
  const g = new Governance(govConfig())
  const grant: Grant = { kind: "grant", vk: undefined, budgets: ["b-vk", "b-team"], rateLimits: [] }
  g.record(grant, 100, 1.5)
  const h = hdrs([["x-api-key", "sk-bf-one"]])
  const d = g.admit(h, "openai", "gpt-4o-mini")
  expect((d as Denial).status).toBe(402)
})

test("required headers", () => {
  const g = new Governance({ client: { required_headers: ["X-Team"] } })
  const d = g.admit(hdrs([["content-type", "application/json"]]), "openai", "gpt-4o")
  expect(d.kind).toBe("denial")
  if (d.kind === "denial") {
    expect(d.status).toBe(400)
    expect(d.message.includes("x-team")).toBe(true)
  }
  expect(g.admit(hdrs([["x-team", " "]]), "openai", "gpt-4o").kind).toBe("denial")
  expect(g.admit(hdrs([["x-team", "core"]]), "openai", "gpt-4o").kind).toBe("grant")
})

test("dual credentials: an identity token with x-bf-vk is refused only under error", () => {
  const cfg: Config = { client: { enforce_auth_on_inference: false }, governance: { virtual_keys: [{ id: "k", value: "sk-bf-k" }] } }
  const both = hdrs([["authorization", "Bearer user-token"], ["x-bf-vk", "sk-bf-k"]])
  const vkOnly = hdrs([["x-bf-vk", "sk-bf-k"]])
  const g = new Governance(cfg)
  g.altAuth = (h) => h.get("authorization") === "Bearer user-token"
  expect(g.admit(both, "openai", "m").kind).toBe("grant")
  const errCfg: Config = { client: { enforce_auth_on_inference: false, dual_credential_conflict_behavior: "error" }, governance: { virtual_keys: [{ id: "k", value: "sk-bf-k" }] } }
  const strict = new Governance(errCfg)
  strict.altAuth = (h) => h.get("authorization") === "Bearer user-token"
  const d = strict.admit(both, "openai", "m") as Denial
  expect(d.kind).toBe("denial")
  expect(d.status).toBe(400)
  expect(strict.admit(vkOnly, "openai", "m").kind).toBe("grant")
  expect(strict.admit(hdrs([["authorization", "Bearer sk-bf-k"], ["x-bf-vk", "sk-bf-k"]]), "openai", "m").kind).toBe("grant")
})

test("inference auth defaults on when there are credentials", () => {
  expect(new Governance({}).enforce).toBe(false)
  expect(new Governance({ governance: { virtual_keys: [{ id: "k", value: "sk-bf-k" }] } }).enforce).toBe(true)
  expect(new Governance({ governance: { auth_config: { token: "t" } } }).enforce).toBe(true)
  expect(new Governance({ client: { enforce_auth_on_inference: false }, governance: { virtual_keys: [{ id: "k", value: "sk-bf-k" }] } }).enforce).toBe(false)
  expect(new Governance({ client: { enforce_auth_on_inference: true } }).enforce).toBe(true)
  const g = new Governance({ client: { enforce_auth_on_inference: true } })
  g.altAuth = (h) => h.get("authorization") === "Bearer admin"
  expect(g.admit(hdrs([["authorization", "Bearer admin"]]), "openai", "m").kind).toBe("grant")
  expect(g.admit(hdrs([]), "openai", "m").kind).toBe("denial")
})

test("direct keys: header gate, key sources and virtual keys never count", () => {
  const on = [["x-bf-direct-key", "true"], ["authorization", "Bearer sk-prov"]]
  expect(directKeyFrom(hdrs(on), true)).toBe("sk-prov")
  expect(directKeyFrom(hdrs(on), false)).toBe(undefined)
  expect(directKeyFrom(hdrs([["authorization", "Bearer sk-prov"]]), true)).toBe(undefined)
  expect(directKeyFrom(hdrs([["x-bf-direct-key", "1"], ["authorization", "Bearer sk-prov"]]), true)).toBe(undefined)
  expect(directKeyFrom(hdrs([["x-bf-direct-key", "true"], ["x-api-key", "anth-key"]]), true)).toBe("anth-key")
  expect(directKeyFrom(hdrs([["x-bf-direct-key", "true"], ["x-goog-api-key", "g-key"]]), true)).toBe("g-key")
  // a virtual key in Authorization is not a provider key; the next source is tried
  expect(directKeyFrom(hdrs([["x-bf-direct-key", "true"], ["authorization", "Bearer sk-bf-vk"], ["x-api-key", "anth"]]), true)).toBe("anth")
  expect(directKeyFrom(hdrs([["x-bf-direct-key", "true"], ["authorization", "Bearer sk-bf-vk"]]), true)).toBe(undefined)
})

test("direct keys satisfy enforced inference auth, with no virtual key", () => {
  const g = new Governance({ client: { enforce_auth_on_inference: true, allow_direct_keys: true }, governance: { virtual_keys: [{ id: "k", value: "sk-bf-k" }] } })
  expect(g.admit(hdrs([["x-bf-direct-key", "true"], ["x-api-key", "anth"]]), "anthropic", "m").kind).toBe("grant")
  expect(g.admit(hdrs([["x-api-key", "anth"]]), "anthropic", "m").kind).toBe("denial")
  // the gate is off: the header alone does nothing
  const off = new Governance({ client: { enforce_auth_on_inference: true }, governance: { virtual_keys: [{ id: "k", value: "sk-bf-k" }] } })
  expect(off.admit(hdrs([["x-bf-direct-key", "true"], ["x-api-key", "anth"]]), "anthropic", "m").kind).toBe("denial")
})

test("model config budget denies 402 for that model only", () => {
  const cfg: Config = {
    governance: {
      budgets: [{ id: "mb", max_limit: 1.0, reset_duration: "1d" }],
      model_configs: [{ id: "mc1", model_name: "gpt-4o", provider: "openai", budget_id: "mb" }],
    },
  }
  const g = new Governance(cfg)
  const none = hdrs([])
  const a = g.admit(none, "openai", "gpt-4o")
  expect(isDenial(a)).toBe(false)
  expect((a as Grant).budgets).toEqual(["mb"])
  g.record(a as Grant, 0, 1.5)
  const d = g.admit(none, "openai", "gpt-4o")
  expect((d as Denial).status).toBe(402)
  expect(isDenial(g.admit(none, "openai", "gpt-4o-mini"))).toBe(false)
  expect(isDenial(g.admit(none, "anthropic", "gpt-4o"))).toBe(false)
})

test("model config limits apply to a virtual key and wildcard models", () => {
  const cfg: Config = {
    governance: {
      budgets: [{ id: "wb", max_limit: 5.0, reset_duration: "1d" }],
      virtual_keys: [{ id: "vk1", value: "sk-bf-one" }, { id: "vk2", value: "sk-bf-two" }],
      model_configs: [
        { id: "mc-all", model_name: "*", provider: "openai", budget_ids: ["wb"] },
        { id: "mc-vk", model_name: "*", scope: "virtual_key", scope_id: "vk2", rate_limit_id: "rl" },
      ],
      rate_limits: [{ id: "rl", request_max_limit: 1, request_reset_duration: "1m" }],
    },
  }
  const g = new Governance(cfg)
  const one = g.admit(hdrs([["x-bf-vk", "sk-bf-one"]]), "openai", "gpt-4o")
  expect((one as Grant).budgets).toEqual(["wb"])
  expect((one as Grant).rateLimits).toEqual([])
  const two = hdrs([["x-bf-vk", "sk-bf-two"]])
  expect((g.admit(two, "openai", "gpt-4o") as Grant).rateLimits).toEqual(["rl"])
  expect((g.admit(two, "openai", "gpt-4o") as Denial).status).toBe(429)
})

test("provider rate limit denies 429 for that provider only", () => {
  const cfg: Config = {
    governance: {
      rate_limits: [{ id: "prl", request_max_limit: 1, request_reset_duration: "1m" }],
      providers: [{ name: "anthropic", rate_limit_id: "prl" }],
    },
  }
  const g = new Governance(cfg)
  const none = hdrs([])
  expect(isDenial(g.admit(none, "anthropic", "claude"))).toBe(false)
  const d = g.admit(none, "anthropic", "claude")
  expect((d as Denial).status).toBe(429)
  expect(isDenial(g.admit(none, "openai", "gpt-4o"))).toBe(false)
})

test("scopeUsage gives a scope's budgets and most-used rate limits", () => {
  const cfg: Config = {
    governance: {
      budgets: [
        { id: "b-vk", max_limit: 10.0, reset_duration: "1M" },
        { id: "b-team", max_limit: 100.0, reset_duration: "1d", current_usage: 25.0 },
        { id: "b-cust", max_limit: 50.0, reset_duration: "1M" },
      ],
      rate_limits: [
        { id: "rl-a", request_max_limit: 10, request_reset_duration: "1m", token_max_limit: 1000, token_reset_duration: "1m" },
        { id: "rl-b", request_max_limit: 4, request_reset_duration: "1m" },
      ],
      teams: [{ id: "t1", name: "core", budget_id: "b-team", customer_id: "c1" }],
      customers: [{ id: "c1", name: "Acme", budget_id: "b-cust" }],
      virtual_keys: [{ id: "vk1", value: "sk-bf-one", team_id: "t1", budget_id: "b-vk", rate_limit_id: "rl-a", provider_configs: [{ provider: "openai", rate_limit_id: "rl-b" }] }],
    },
  }
  const g = new Governance(cfg)
  const now = Date.now()
  g.record({ kind: "grant", vk: undefined, budgets: ["b-vk"], rateLimits: ["rl-a"] }, 300, 2.5)

  const vk = g.scopeUsage("virtual_key", "vk1", now)!
  expect(vk.budgets.length).toBe(1)
  expect(vk.budgets[0]!.id).toBe("b-vk")
  expect(vk.budgets[0]!.spent).toBe(2.5)
  expect(vk.budgets[0]!.limit).toBe(10.0)
  expect(vk.requests!.id).toBe("rl-a")
  expect(vk.requests!.limit).toBe(10.0)
  expect(vk.tokens!.used).toBe(300.0)
  expect(vk.tokens!.limit).toBe(1000.0)

  const team = g.scopeUsage("team", "t1", now)!
  expect(team.budgets[0]!.id).toBe("b-team")
  expect(team.budgets[0]!.spent).toBe(25.0)
  expect(team.requests).toBeUndefined()
  expect(team.tokens).toBeUndefined()

  const cust = g.scopeUsage("customer", "c1", now)!
  expect(cust.budgets[0]!.id).toBe("b-cust")
  expect(cust.budgets[0]!.spent).toBe(0.0)

  expect(g.scopeUsage("virtual_key", "nope", now)).toBeUndefined()
  expect(g.scopeUsage("team", "t9", now)).toBeUndefined()
  expect(g.scopeUsage("customer", "c9", now)).toBeUndefined()
  expect(g.scopeUsage("widget", "vk1", now)).toBeUndefined()
})

function projCfg(): Config {
  return {
    governance: {
      budgets: [
        { id: "b-proj", max_limit: 1.0, reset_duration: "1d" },
        { id: "b-bu", max_limit: 5.0, reset_duration: "1d" },
        { id: "b-team", max_limit: 100.0, reset_duration: "1d" },
        { id: "b-cust", max_limit: 100.0, reset_duration: "1d" },
      ],
      rate_limits: [{ id: "rl-proj", request_max_limit: 2, request_reset_duration: "1m" }],
      customers: [{ id: "c1", name: "Acme", budget_id: "b-cust" }],
      teams: [{ id: "t1", name: "core", customer_id: "c1", budget_id: "b-team", business_unit_id: "bu1" }],
      business_units: [{ id: "bu1", name: "emea", budget_id: "b-bu" }],
      virtual_keys: [
        { id: "vk1", value: "sk-bf-one", team_id: "t1", provider_configs: [{ provider: "openai" }] },
        { id: "vk2", value: "sk-bf-two" },
      ],
      projects: [
        { id: "p-eval", name: "claude-eval", budget_id: "b-proj", rate_limit_id: "rl-proj", access_rule: "union", provider_configs: [{ provider: "anthropic" }], virtual_key_ids: ["vk1"] },
        { id: "p-int", name: "narrow", membership_mode: "open", access_rule: "intersect", provider_configs: [{ provider: "openai", allowed_models: ["gpt-4o-mini"] }] },
        { id: "p-only", name: "pays", membership_mode: "open", accounting_mode: "project_only", budget_id: "b-proj" },
      ],
    },
  }
}

test("project budget: a project's own budget refuses 402 once spent", () => {
  const g = new Governance(projCfg())
  const h = hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-project-id", "p-eval"]])
  const a = g.admit(h, "anthropic", "claude-sonnet")
  expect(isDenial(a)).toBe(false)
  expect((a as Grant).budgets).toEqual(["b-proj"])
  expect((a as Grant).attr!.projectId).toBe("p-eval")
  expect((a as Grant).attr!.teamId).toBe("t1")
  g.record(a as Grant, 10, 1.5)
  const d = g.admit(h, "anthropic", "claude-sonnet")
  expect((d as Denial).status).toBe(402)
  expect((d as Denial).type).toBe("budget_exceeded")
})

test("union project adds access the key lacks, and only for its own requests", () => {
  const g = new Governance(projCfg())
  // vk1 has no anthropic access of its own
  expect((g.admit(hdrs([["x-bf-vk", "sk-bf-one"]]), "anthropic", "claude") as Denial).status).toBe(403)
  // the same key, naming the project by name, reaches anthropic
  const named = hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-project-name", "claude-eval"]])
  expect(isDenial(g.admit(named, "anthropic", "claude"))).toBe(false)
  // union keeps the key's own openai access inside the project too
  expect(isDenial(g.admit(named, "openai", "gpt-4o"))).toBe(false)
})

test("project admission: non-members, unknown and empty project ids are refused as not found", () => {
  const g = new Governance(projCfg())
  const notMember = g.admit(hdrs([["x-bf-vk", "sk-bf-two"], ["x-bf-project-id", "p-eval"]]), "anthropic", "claude") as Denial
  expect(notMember.status).toBe(403)
  expect(notMember.type).toBe("access_blocked")
  expect(notMember.message.includes("does not admit this request")).toBe(true)
  const unknown = g.admit(hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-project-id", "nope"]]), "openai", "gpt-4o") as Denial
  expect(unknown.status).toBe(403)
  // an empty id names no project and is refused, rather than falling back to the key's own access
  expect(isDenial(g.admit(hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-project-id", " "]]), "openai", "gpt-4o"))).toBe(true)
  // the id header decides even when the name header is valid
  expect(isDenial(g.admit(hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-project-id", "nope"], ["x-bf-project-name", "claude-eval"]]), "anthropic", "claude"))).toBe(true)
})

test("intersect project permits only what both the key and the project allow", () => {
  const g = new Governance(projCfg())
  const h = hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-project-id", "p-int"]])
  expect(isDenial(g.admit(h, "openai", "gpt-4o-mini"))).toBe(false)
  expect((g.admit(h, "openai", "gpt-4o") as Denial).status).toBe(403)
  expect((g.admit(h, "anthropic", "claude") as Denial).status).toBe(403)
  // a project with no provider configs permits nothing under intersect
  const none = new Governance({ governance: { virtual_keys: [{ id: "k", value: "sk-bf-k" }], projects: [{ id: "p", name: "p", membership_mode: "open", access_rule: "intersect" }] } })
  expect(isDenial(none.admit(hdrs([["x-bf-vk", "sk-bf-k"], ["x-bf-project-id", "p"]]), "openai", "m"))).toBe(true)
})

test("project_only accounting leaves the key, team, business unit and customer out of the ledgers", () => {
  const g = new Governance(projCfg())
  const pays = g.admit(hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-project-id", "p-only"]]), "openai", "gpt-4o")
  expect((pays as Grant).budgets).toEqual(["b-proj"])
  // attribution is still recorded
  expect((pays as Grant).attr!.teamId).toBe("t1")
  expect((pays as Grant).attr!.projectName).toBe("pays")
  // without a project, the whole hierarchy is charged
  const own = g.admit(hdrs([["x-bf-vk", "sk-bf-one"]]), "openai", "gpt-4o") as Grant
  expect(own.budgets).toEqual(["b-team", "b-bu", "b-cust"])
  expect(own.attr!.projectId).toBe("")
  expect(own.attr!.businessUnitId).toBe("bu1")
  expect(own.attr!.customerId).toBe("c1")
})

test("business unit budget applies to the teams in it", () => {
  const g = new Governance(projCfg())
  const h = hdrs([["x-bf-vk", "sk-bf-one"]])
  g.record({ kind: "grant", vk: undefined, budgets: ["b-bu"], rateLimits: [] }, 0, 6.0)
  const d = g.admit(h, "openai", "gpt-4o") as Denial
  expect(d.status).toBe(402)
  expect(d.message.includes("b-bu")).toBe(true)
})

test("x-bf-customer-id charges only a customer the key reaches", () => {
  const g = new Governance(projCfg())
  const ok = g.admit(hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-customer-id", "c1"]]), "openai", "gpt-4o") as Grant
  expect(ok.budgets).toEqual(["b-team", "b-bu", "b-cust"])
  expect(ok.attr!.customerId).toBe("c1")
  expect(ok.attr!.customerName).toBe("Acme")
  const byName = g.admit(hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-customer-name", "Acme"]]), "openai", "gpt-4o") as Grant
  expect(byName.attr!.customerId).toBe("c1")
  expect((g.admit(hdrs([["x-bf-vk", "sk-bf-one"], ["x-bf-customer-id", "c9"]]), "openai", "gpt-4o") as Denial).status).toBe(403)
})

test("a cycles budget override adds to the limit for its cycles and then runs out", () => {
  const cfg: Config = { governance: { budgets: [{ id: "b-cy", max_limit: 10.0, reset_duration: "1d", override: { amount: 5.0, mode: "cycles", cycles: 2 } }] } }
  const g = new Governance(cfg)
  const w = g.budgets.get("b-cy")!
  const day = 86400000
  const now = Date.now()
  expect(w.remaining(now)).toBe(15.0)
  // the first reset: one cycle of the two is left, so the extra still counts
  w.start = now - day - 1
  expect(w.remaining(now)).toBe(15.0)
  // the second reset: the override has run its cycles
  w.start = now - day - 1
  expect(w.remaining(now)).toBe(10.0)
  // a reload keeps the cycles a same override has run; a changed override starts again
  const g2 = new Governance(cfg)
  const w2 = g2.budgets.get("b-cy")!
  w2.start = now - day - 1
  w2.remaining(now)
  const g3 = new Governance(cfg)
  g3.carryUsage(g2)
  expect(g3.budgets.get("b-cy")!.extraCycles).toBe(1)
  expect(g3.budgets.get("b-cy")!.extra).toBe(5.0)
  const other: Config = { governance: { budgets: [{ id: "b-cy", max_limit: 10.0, reset_duration: "1d", override: { amount: 7.0, mode: "cycles", cycles: 2 } }] } }
  const g4 = new Governance(other)
  g4.carryUsage(g2)
  expect(g4.budgets.get("b-cy")!.extra).toBe(7.0)
  expect(g4.budgets.get("b-cy")!.extraCycles).toBe(2)
})

test("a cycles override resumes its cycles after a restart, counting the windows since it started", () => {
  const day = 86400000
  const now = Date.now()
  const mk = (startedAgo: number, cycles: int): Config => ({ governance: { budgets: [{ id: "b-cy", max_limit: 10.0, reset_duration: "1d", override: { amount: 5.0, mode: "cycles", cycles: cycles, started_at: rfc3339Of(now - startedAgo) } }] } })
  // set 1.5 days ago with two cycles: one window has passed, so one cycle is left and the extra counts
  const one = new Governance(mk(day * 1.5, 2)).budgets.get("b-cy")!
  expect(one.extraCycles).toBe(1)
  expect(one.remaining(now)).toBe(15.0)
  // the window the boot is in began half a day ago (the last cycle boundary), so the cycle ends at its next reset
  expect(now - one.start < day && one.start <= now).toBe(true)
  expect(one.remaining(now + day * 0.6)).toBe(10.0)
  // set 2.5 days ago with two cycles: both have run out, so the restart grants nothing
  const none = new Governance(mk(day * 2.5, 2)).budgets.get("b-cy")!
  expect(none.extra).toBe(0.0)
  expect(none.remaining(now)).toBe(10.0)
  // the view counts the same cycles
  expect(cyclesLeft({ amount: 5.0, mode: "cycles", cycles: 2, started_at: rfc3339Of(now - day * 2.5) }, day, now)).toBe(0)
  expect(cyclesLeft({ amount: 5.0, mode: "cycles", cycles: 3 }, day, now)).toBe(3)
})

test("a member's rate limit shares split the project's token and request caps", () => {
  const cfg: Config = { governance: {
    rate_limits: [{ id: "rl-pj", token_max_limit: 1000, token_reset_duration: "1d", request_max_limit: 10, request_reset_duration: "1d" }],
    virtual_keys: [{ id: "k-a", value: "sk-bf-a", user_id: "ana" }],
    projects: [{ id: "p-none", name: "none", rate_limit_id: "rl-pj", members: [{ id: "m1", user_id: "ana", rate_limit_shares: [{ source_rate_limit_id: "rl-pj", token_share: 30, token_share_type: "percent", request_share: 2 }] }] }],
  } }
  const g = new Governance(cfg)
  const h = hdrs([["x-bf-vk", "sk-bf-a"], ["x-bf-project-id", "p-none"]])
  // ana's slice is 2 requests, though the project allows 10
  expect((g.admit(h, "openai", "gpt-4o") as Grant).kind).toBe("grant")
  expect((g.admit(h, "openai", "gpt-4o") as Grant).kind).toBe("grant")
  expect((g.admit(h, "openai", "gpt-4o") as Denial).status).toBe(429)
  // the token slice is 30% of 1000: spending 300 leaves none
  const g2 = new Governance(cfg)
  g2.record(g2.admit(h, "openai", "gpt-4o") as Grant, 300, 0.0)
  expect((g2.admit(h, "openai", "gpt-4o") as Denial).status).toBe(429)
})

test("an equal split gives each member a whole part of the project's rate limit", () => {
  const cfg: Config = { governance: {
    rate_limits: [{ id: "rl-eq", token_max_limit: 101, token_reset_duration: "1d", request_max_limit: 9, request_reset_duration: "1d" }],
    virtual_keys: [{ id: "k-a", value: "sk-bf-a", user_id: "ana" }, { id: "k-b", value: "sk-bf-b", user_id: "bo" }],
    projects: [{ id: "p-eq", name: "eq", rate_limit_id: "rl-eq", split_policy: "equal", members: [{ id: "m1", user_id: "ana" }, { id: "m2", user_id: "bo" }] }],
  } }
  const g = new Governance(cfg)
  const ha = hdrs([["x-bf-vk", "sk-bf-a"], ["x-bf-project-id", "p-eq"]])
  // 9 requests over 2 members: 4 each (a remainder stays unallocated)
  expect((g.admit(ha, "openai", "gpt-4o") as Grant).kind).toBe("grant")
  expect((g.admit(ha, "openai", "gpt-4o") as Grant).kind).toBe("grant")
  expect((g.admit(ha, "openai", "gpt-4o") as Grant).kind).toBe("grant")
  expect((g.admit(ha, "openai", "gpt-4o") as Grant).kind).toBe("grant")
  expect((g.admit(ha, "openai", "gpt-4o") as Denial).status).toBe(429)
  // bo has a slice of her own, 50 tokens of the 101
  const hb = hdrs([["x-bf-vk", "sk-bf-b"], ["x-bf-project-id", "p-eq"]])
  const b1 = g.admit(hb, "openai", "gpt-4o") as Grant
  expect(b1.kind).toBe("grant")
  g.record(b1, 51, 0.0)
  expect((g.admit(hb, "openai", "gpt-4o") as Denial).status).toBe(429)
  // the derived limit is listed with the project's own
  expect(g.rateLimitUsage(Date.now()).some((u) => u.id === "rl-eq@p-eq/ana")).toBe(true)
})

test("a profile a user holds through their role governs the user's keys, with a budget copy per user", () => {
  const cfg: Config = { governance: {
    roles: [{ id: 1, name: "ops" }],
    users: [{ name: "ana", role: "ops" }, { name: "cy", role: "ops" }, { name: "bo", role: "viewer" }],
    access_profiles: [{ id: "p-role", allowed_models: ["openai/gpt-4o"], budget_id: "b-hp", max_tokens: 100, roles: [{ role_id: 1 }] }],
    budgets: [{ id: "b-hp", max_limit: 10.0, reset_duration: "1d" }],
    virtual_keys: [{ id: "k-a", value: "sk-bf-a", user_id: "ana" }, { id: "k-c", value: "sk-bf-c", user_id: "cy" }, { id: "k-b", value: "sk-bf-b", user_id: "bo" }],
  } }
  const g = new Governance(cfg)
  const ha = hdrs([["x-bf-vk", "sk-bf-a"]])
  // the profile's model list governs ana's key without being linked to it
  expect((g.admit(ha, "openai", "gpt-4o-mini") as Denial).status).toBe(403)
  const a1 = g.admit(ha, "openai", "gpt-4o") as Grant
  expect(a1.kind).toBe("grant")
  expect(a1.budgets.includes("b-hp@user/ana")).toBe(true)
  g.record(a1, 0, 10.0)
  // ana's own copy is used up, while cy's copy and bo (no role) are not
  expect((g.admit(ha, "openai", "gpt-4o") as Denial).status).toBe(402)
  expect((g.admit(hdrs([["x-bf-vk", "sk-bf-c"]]), "openai", "gpt-4o") as Grant).kind).toBe("grant")
  expect((g.admit(hdrs([["x-bf-vk", "sk-bf-b"]]), "openai", "gpt-4o-mini") as Grant).kind).toBe("grant")
})

test("an equal split gives each member a slice of the project budget, checked with it", () => {
  const cfg: Config = { governance: {
    budgets: [{ id: "b-pj", max_limit: 100.0, reset_duration: "1M" }],
    virtual_keys: [{ id: "k-a", value: "sk-bf-a", user_id: "ana" }, { id: "k-b", value: "sk-bf-b", user_id: "bo" }, { id: "k-c", value: "sk-bf-c", user_id: "cy" }],
    projects: [{ id: "p-eq", name: "eq", budget_id: "b-pj", split_policy: "equal", members: [{ id: "m1", user_id: "ana" }, { id: "m2", user_id: "bo" }] }],
  } }
  const g = new Governance(cfg)
  const ha = hdrs([["x-bf-vk", "sk-bf-a"], ["x-bf-project-id", "p-eq"]])
  const a1 = g.admit(ha, "openai", "gpt-4o") as Grant
  expect(a1.kind).toBe("grant")
  g.record(a1, 0, 40.0)
  const a2 = g.admit(ha, "openai", "gpt-4o") as Grant
  expect(a2.kind).toBe("grant")
  g.record(a2, 0, 15.0)
  // ana's slice is 50 and she has spent 55: refused, though the project has 100 left
  const a3 = g.admit(ha, "openai", "gpt-4o") as Denial
  expect(a3.status).toBe(402)
  // bo has a slice of her own
  const hb = hdrs([["x-bf-vk", "sk-bf-b"], ["x-bf-project-id", "p-eq"]])
  expect((g.admit(hb, "openai", "gpt-4o") as Grant).kind).toBe("grant")
  // cy is not a member: the project does not admit the key
  const hc = hdrs([["x-bf-vk", "sk-bf-c"], ["x-bf-project-id", "p-eq"]])
  expect((g.admit(hc, "openai", "gpt-4o") as Denial).status).toBe(403)
})

test("a member's own percent share caps the member under split none", () => {
  const cfg: Config = { governance: {
    budgets: [{ id: "b-pj", max_limit: 200.0, reset_duration: "1M" }],
    virtual_keys: [{ id: "k-a", value: "sk-bf-a", user_id: "ana" }],
    projects: [{ id: "p-none", name: "none", budget_id: "b-pj", members: [{ id: "m1", user_id: "ana", budget_shares: [{ source_budget_id: "b-pj", share_value: 25, share_type: "percent" }] }] }],
  } }
  const g = new Governance(cfg)
  const h = hdrs([["x-bf-vk", "sk-bf-a"], ["x-bf-project-id", "p-none"]])
  const a1 = g.admit(h, "openai", "gpt-4o") as Grant
  g.record(a1, 0, 49.0)
  expect((g.admit(h, "openai", "gpt-4o") as Grant).kind).toBe("grant")
  g.record(g.admit(h, "openai", "gpt-4o") as Grant, 0, 5.0)
  expect((g.admit(h, "openai", "gpt-4o") as Denial).status).toBe(402)
})
