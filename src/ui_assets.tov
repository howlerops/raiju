    { path: "assets/style-D_nCSEzN.css", type: "text/css; charset=utf-8", etag: "\"449ad26c95bc67cd63d801b5911179590846e3ed0fa2f3e7d0ff094bb567bd9b\"", base64: false, body: ":root{--bg:#f6f7f9;--surface:#fff;--surface-2:#f0f2f5;--text:#1b1f24;--muted:#59626d;--border:#d8dde3;--border-strong:#afb8c1;--accent:#2456d6;--accent-text:#fff;--focus:#0969da;--ok:#1a7f37;--ok-bg:#dafbe1;--warn:#8a5a00;--warn-bg:#fff8c5;--bad:#cf222e;--bad-bg:#ffebe9;--neutral:#59626d;--neutral-bg:#eaeef2;--code-bg:#f6f8fa;--c1:#2a78d6;--c2:#eb6834;--c3:#1baf7a;--c4:#eda100;--c5:#e87ba4;--c6:#6250d6;--c-other:#8b9199;--radius:8px;--lightningcss-light:initial;--lightningcss-dark: ;color-scheme:light dark}@media (prefers-color-scheme:dark){:root{--lightningcss-light: ;--lightningcss-dark:initial;--bg:#0d1117;--surface:#161b22;--surface-2:#1c2330;--text:#e6edf3;--muted:#9198a1;--border:#30363d;--border-strong:#484f58;--accent:#4c8dff;--accent-text:#0d1117;--focus:#58a6ff;--ok:#3fb950;--ok-bg:#12261e;--warn:#d29922;--warn-bg:#2b2208;--bad:#f85149;--bad-bg:#2d1517;--neutral:#9198a1;--neutral-bg:#21262d;--code-bg:#0d1117;--c1:#3987e5;--c2:#d95926;--c3:#199e70;--c4:#c98500;--c5:#d55181;--c6:#9085e9;--c-other:#7b838c}}:root[data-theme=light]{--c1:#2a78d6;--c2:#eb6834;--c3:#1baf7a;--c4:#eda100;--c5:#e87ba4;--c6:#6250d6;--c-other:#8b9199;--bg:#f6f7f9;--surface:#fff;--surface-2:#f0f2f5;--text:#1b1f24;--muted:#59626d;--border:#d8dde3;--border-strong:#afb8c1;--accent:#2456d6;--accent-text:#fff;--focus:#0969da;--ok:#1a7f37;--ok-bg:#dafbe1;--warn:#8a5a00;--warn-bg:#fff8c5;--bad:#cf222e;--bad-bg:#ffebe9;--neutral:#59626d;--neutral-bg:#eaeef2;--code-bg:#f6f8fa}*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}body{background:var(--bg);color:var(--text);min-width:0;margin:0;font:14px/1.45 system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif}h1{margin:0;font-size:20px}h2{margin:0 0 10px;font-size:15px}h3{margin:0;font-size:14px}h4{color:var(--muted);margin:10px 0 4px;font-size:12px}p{margin:0 0 8px}.mono,code,pre,input.mono,textarea.mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,Liberation Mono,monospace;font-size:12.5px}.muted{color:var(--muted)}.hint{color:var(--muted);font-size:12px}.error{color:var(--bad)}.grow{flex:auto}[hidden]{display:none!important}:focus-visible{outline:2px solid var(--focus);outline-offset:2px}.top{z-index:5;background:var(--surface);border-bottom:1px solid var(--border);justify-content:space-between;align-items:center;gap:8px;padding:10px 16px;display:flex;position:sticky;top:0}.brand{align-items:center;gap:8px;min-width:0;font-weight:700;display:flex}.logo{background:var(--accent);width:24px;height:24px;color:var(--accent-text);border-radius:6px;flex:none;place-items:center;font-size:13px;display:inline-grid}.top-right{flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:8px;display:flex}.tabs{background:var(--surface);border-bottom:1px solid var(--border);gap:2px;padding:0 12px;display:flex;overflow-x:auto}.tabs a{color:var(--muted);white-space:nowrap;border-bottom:2px solid #0000;padding:10px;text-decoration:none}.tabs a:hover{color:var(--text)}.tabs a[aria-current=page]{color:var(--text);border-bottom-color:var(--accent);font-weight:600}main{max-width:1200px;margin:0 auto;padding:16px}.toolbar{flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:12px;display:flex}.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);min-width:0;margin-bottom:14px;padding:14px}.grid{grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px;display:grid}.grid>.card{margin-bottom:0}.cards{grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:14px;display:grid}.stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);min-width:0;padding:12px}.stat .label{color:var(--muted);font-size:12px}.stat .value{font-variant-numeric:tabular-nums;overflow-wrap:anywhere;font-size:22px;font-weight:600}.stat .sub{color:var(--muted);font-size:12px}.table-wrap{-webkit-overflow-scrolling:touch;max-width:100%;overflow-x:auto}table{border-collapse:collapse;font-variant-numeric:tabular-nums;width:100%}th,td{text-align:left;border-bottom:1px solid var(--border);vertical-align:top;padding:7px 8px}th{color:var(--muted);white-space:nowrap;font-size:12px;font-weight:600}td{overflow-wrap:anywhere}tr.clickable{cursor:pointer}tr.clickable:hover td,tr.clickable:focus-visible td,tr.detail td{background:var(--surface-2)}tr.placeholder td{color:var(--muted)}.nowrap{white-space:nowrap}.row-actions{flex-wrap:wrap;gap:6px;display:inline-flex}.confirm{flex-wrap:wrap;align-items:center;gap:6px;display:inline-flex}.tool-chips{flex-wrap:wrap;gap:6px;display:flex}.pill{white-space:nowrap;background:var(--neutral-bg);color:var(--neutral);border-radius:999px;padding:1px 8px;font-size:12px;font-weight:600;display:inline-block}.pill.ok{background:var(--ok-bg);color:var(--ok)}.pill.warn{background:var(--warn-bg);color:var(--warn)}.pill.bad{background:var(--bad-bg);color:var(--bad)}button{font:inherit;border:1px solid var(--border-strong);background:var(--surface);color:var(--text);cursor:pointer;white-space:nowrap;border-radius:6px;padding:6px 12px}button:hover{background:var(--surface-2)}button:disabled{opacity:.6;cursor:default}button.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-text)}button.primary:hover{filter:brightness(1.08);background:var(--accent)}button.ghost{background:0 0}button.danger-outline{color:var(--bad);border-color:var(--bad);background:0 0}button.danger{background:var(--bad);border-color:var(--bad);color:#fff}button.toggle{border-radius:999px;padding:2px 10px;font-size:12px;font-weight:600}button.toggle[aria-pressed=true]{background:var(--ok-bg);color:var(--ok);border-color:var(--ok)}button.toggle[aria-pressed=false]{background:var(--neutral-bg);color:var(--neutral)}input,select,textarea{font:inherit;border:1px solid var(--border-strong);background:var(--surface);width:100%;min-width:0;color:var(--text);border-radius:6px;padding:6px 8px}input[readonly]{background:var(--surface-2);color:var(--muted)}textarea{resize:vertical}label{color:var(--muted);flex-direction:column;gap:4px;min-width:0;font-size:13px;display:flex}label.check{color:var(--text);flex-direction:row;align-items:center;gap:6px}label.check input{width:auto}.form-grid{grid-template-columns:repeat(auto-fill,minmax(180px,1fr));align-items:end;gap:10px 12px;display:grid}.wide{grid-column:1/-1}.actions{flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:8px;display:flex}.actions.wide{grid-column:1/-1}.inline-form{grid-template-columns:repeat(auto-fit,minmax(140px,1fr));align-items:end;gap:8px;margin-top:10px;display:grid}.inline-form .actions{grid-column:1/-1}details.add{margin-top:10px}details summary{cursor:pointer;color:var(--accent)}fieldset{border:1px solid var(--border);border-radius:6px;min-width:0;margin:0 0 10px;padding:10px}legend{color:var(--muted);padding:0 4px;font-size:13px}.rule{grid-template-columns:repeat(auto-fit,minmax(150px,1fr));align-items:end;gap:8px;margin-bottom:8px;display:grid}.filters{grid-template-columns:repeat(auto-fit,minmax(140px,1fr));align-items:end;gap:8px;margin-bottom:12px;display:grid}.pager{flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:8px;margin-top:10px;display:flex}.callout{border:1px solid var(--warn);background:var(--warn-bg);border-radius:var(--radius);margin-bottom:14px;padding:12px}.secret-row{flex-wrap:wrap;align-items:center;gap:8px;display:flex}.secret-row input{flex:220px}pre.code,pre.reply{background:var(--code-bg);border:1px solid var(--border);white-space:pre-wrap;overflow-wrap:anywhere;border-radius:6px;max-height:320px;margin:0;padding:10px;overflow:auto}pre.reply{max-height:none;font-family:inherit;font-size:14px}dl.meta{grid-template-columns:max-content minmax(0,1fr);gap:4px 12px;margin:0 0 10px;display:grid}dl.meta dt{color:var(--muted)}dl.meta dd{overflow-wrap:anywhere;margin:0}.kv{grid-template-columns:max-content minmax(0,1fr);align-items:center;gap:6px 12px;display:grid}.kv dt{color:var(--muted)}.kv dd{margin:0}#pg-result:empty{display:none}.chat-meta{margin-bottom:8px;font-size:12px}.overlay{z-index:20;background:#00000073;place-items:center;padding:16px;display:grid;position:fixed;inset:0}.dialog{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);gap:10px;width:min(420px,100%);padding:18px;display:grid}.dialog h2{margin:0}.toasts{z-index:30;gap:8px;width:min(360px,100% - 24px);display:grid;position:fixed;bottom:12px;right:12px}.toast{background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--accent);overflow-wrap:anywhere;border-radius:6px;padding:10px 12px;box-shadow:0 4px 16px #0000002e}.toast.ok{border-left-color:var(--ok)}.toast.error{border-left-color:var(--bad)}@media (max-width:480px){main,.card{padding:12px}.top{padding:10px 12px}.tabs{padding:0 6px}.tabs a{padding:10px 8px}}.grid.charts{grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))}.chart-card{min-width:0}figure.chart{min-width:0;margin:0;position:relative}figure.chart figcaption{margin-bottom:6px;font-weight:600}.chart-empty{margin:8px 0}.chart-plot{position:relative}.chart-plot svg{touch-action:pan-y;max-width:100%;display:block}.chart-plot svg:focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:4px}svg .grid{stroke:var(--border);stroke-width:1px}svg .axis{fill:var(--muted);font-variant-numeric:tabular-nums;font-size:11px}svg .cross{stroke:var(--border-strong);stroke-width:1px;stroke-dasharray:3 3}svg .bar{shape-rendering:crispedges}.legend{color:var(--muted);flex-wrap:wrap;gap:4px 14px;margin:0 0 6px;padding:0;font-size:12px;list-style:none;display:flex}.swatch{vertical-align:baseline;border-radius:2px;width:10px;height:10px;margin-right:5px;display:inline-block}.chart-tip{z-index:2;pointer-events:none;background:var(--surface);border:1px solid var(--border-strong);border-radius:6px;max-width:220px;padding:6px 8px;font-size:12px;position:absolute;top:4px;box-shadow:0 4px 12px #00000026}details.chart-table{margin-top:6px;font-size:12px}label.inline{flex-direction:row;align-items:center;gap:6px}label.inline select{width:auto}.rank{gap:10px;margin:0;padding:0;list-style:none;display:grid}.rank-head{justify-content:space-between;gap:8px;display:flex}.rank-label{overflow-wrap:anywhere}.rank-value{font-variant-numeric:tabular-nums;font-weight:600}.rank-track{background:var(--surface-2);border-radius:3px;height:6px;margin:3px 0;overflow:hidden}.rank-fill{border-radius:3px;height:100%}.vlist{-webkit-overflow-scrolling:touch;border-radius:var(--radius);max-width:100%;height:min(62vh,560px);position:relative;overflow:auto}.grid-cols{grid-template-columns:170px 90px minmax(170px,1.4fr) 70px 90px 120px 90px 60px minmax(120px,1fr);align-items:center;min-width:1060px;display:grid}.grid-cols.node{grid-template-columns:170px 90px minmax(170px,1.4fr) 70px 90px 120px 90px 60px minmax(120px,1fr) 110px}.vhead{z-index:2;background:var(--surface);border-bottom:1px solid var(--border);height:34px;color:var(--muted);font-size:12px;font-weight:600;position:sticky;top:0}.vbody{min-width:1060px;position:relative}.vrow{border-bottom:1px solid var(--border);cursor:pointer;font-variant-numeric:tabular-nums;height:36px;position:absolute;top:0;left:0;right:0}.vrow:hover,.vrow:focus-visible,.vrow.selected{background:var(--surface-2)}.vc{text-overflow:ellipsis;white-space:nowrap;padding:0 8px;overflow:hidden}a.button{border:1px solid var(--border-strong);color:var(--text);background:var(--surface);border-radius:6px;padding:6px 12px;text-decoration:none;display:inline-block}.inline-label{flex-direction:row;align-items:center;gap:6px}.inline-label select{width:auto}\n/*$vite$:1*/", gz: "" },
    { path: "index.html", type: "text/html; charset=utf-8", etag: "\"feb2cb5e9ba37c40889ceaf15d4710adf11715bd04c7e3b79e02dae14a7dc854\"", base64: false, body: "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>Raiju Gateway</title>\n  <script type=\"module\" crossorigin src=\"/assets/index-RSJLhNk7.js\"></script>\n  <link rel=\"stylesheet\" crossorigin href=\"/assets/style-D_nCSEzN.css\">\n</head>\n<body>\n<div id=\"root\"></div>\n<noscript><p style=\"padding:16px\">This page needs JavaScript.</p></noscript>\n</body>\n</html>\n", gz: "" },
