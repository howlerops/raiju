// Generated by scripts/embed_ui.py from ui/index.html. Do not edit.
export const INDEX_HTML: string = "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>Raiju Gateway</title>\n<style>\n:root {\n  --bg: #f6f7f9;\n  --surface: #ffffff;\n  --surface-2: #f0f2f5;\n  --text: #1b1f24;\n  --muted: #59626d;\n  --border: #d8dde3;\n  --border-strong: #afb8c1;\n  --accent: #2456d6;\n  --accent-text: #ffffff;\n  --focus: #0969da;\n  --ok: #1a7f37;\n  --ok-bg: #dafbe1;\n  --warn: #8a5a00;\n  --warn-bg: #fff8c5;\n  --bad: #cf222e;\n  --bad-bg: #ffebe9;\n  --neutral: #59626d;\n  --neutral-bg: #eaeef2;\n  --code-bg: #f6f8fa;\n  --radius: 8px;\n  color-scheme: light dark;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --bg: #0d1117;\n    --surface: #161b22;\n    --surface-2: #1c2330;\n    --text: #e6edf3;\n    --muted: #9198a1;\n    --border: #30363d;\n    --border-strong: #484f58;\n    --accent: #4c8dff;\n    --accent-text: #0d1117;\n    --focus: #58a6ff;\n    --ok: #3fb950;\n    --ok-bg: #12261e;\n    --warn: #d29922;\n    --warn-bg: #2b2208;\n    --bad: #f85149;\n    --bad-bg: #2d1517;\n    --neutral: #9198a1;\n    --neutral-bg: #21262d;\n    --code-bg: #0d1117;\n  }\n}\n:root[data-theme=\"light\"] {\n  --bg: #f6f7f9;\n  --surface: #ffffff;\n  --surface-2: #f0f2f5;\n  --text: #1b1f24;\n  --muted: #59626d;\n  --border: #d8dde3;\n  --border-strong: #afb8c1;\n  --accent: #2456d6;\n  --accent-text: #ffffff;\n  --focus: #0969da;\n  --ok: #1a7f37;\n  --ok-bg: #dafbe1;\n  --warn: #8a5a00;\n  --warn-bg: #fff8c5;\n  --bad: #cf222e;\n  --bad-bg: #ffebe9;\n  --neutral: #59626d;\n  --neutral-bg: #eaeef2;\n  --code-bg: #f6f8fa;\n}\n* { box-sizing: border-box; }\nhtml { -webkit-text-size-adjust: 100%; }\nbody {\n  margin: 0;\n  background: var(--bg);\n  color: var(--text);\n  font: 14px/1.45 system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  min-width: 0;\n}\nh1 { font-size: 20px; margin: 0; }\nh2 { font-size: 15px; margin: 0 0 10px; }\nh3 { font-size: 14px; margin: 0; }\nh4 { font-size: 12px; margin: 10px 0 4px; color: var(--muted); }\np { margin: 0 0 8px; }\n.mono, code, pre, input.mono, textarea.mono {\n  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace;\n  font-size: 12.5px;\n}\n.muted { color: var(--muted); }\n.hint { font-size: 12px; color: var(--muted); }\n.error { color: var(--bad); }\n.grow { flex: 1 1 auto; }\n[hidden] { display: none !important; }\n:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }\n\n.top {\n  position: sticky;\n  top: 0;\n  z-index: 5;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 10px 16px;\n  background: var(--surface);\n  border-bottom: 1px solid var(--border);\n}\n.brand { font-weight: 700; display: flex; align-items: center; gap: 8px; min-width: 0; }\n.logo {\n  width: 24px; height: 24px; border-radius: 6px;\n  background: var(--accent); color: var(--accent-text);\n  display: inline-grid; place-items: center; font-size: 13px; flex: none;\n}\n.top-right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }\n.tabs {\n  display: flex; gap: 2px; overflow-x: auto;\n  padding: 0 12px;\n  background: var(--surface);\n  border-bottom: 1px solid var(--border);\n}\n.tabs a {\n  padding: 10px; color: var(--muted); text-decoration: none;\n  border-bottom: 2px solid transparent; white-space: nowrap;\n}\n.tabs a:hover { color: var(--text); }\n.tabs a[aria-current=\"page\"] { color: var(--text); border-bottom-color: var(--accent); font-weight: 600; }\n\nmain { padding: 16px; max-width: 1200px; margin: 0 auto; }\n.toolbar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }\n.card {\n  background: var(--surface); border: 1px solid var(--border);\n  border-radius: var(--radius); padding: 14px; margin-bottom: 14px; min-width: 0;\n}\n.grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }\n.grid > .card { margin-bottom: 0; }\n.cards { display: grid; gap: 10px; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); margin-bottom: 14px; }\n.stat { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 12px; min-width: 0; }\n.stat .label { color: var(--muted); font-size: 12px; }\n.stat .value { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }\n.stat .sub { font-size: 12px; color: var(--muted); }\n\n.table-wrap { overflow-x: auto; max-width: 100%; -webkit-overflow-scrolling: touch; }\ntable { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }\nth, td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }\nth { color: var(--muted); font-weight: 600; font-size: 12px; white-space: nowrap; }\ntd { overflow-wrap: anywhere; }\ntr.clickable { cursor: pointer; }\ntr.clickable:hover td, tr.clickable:focus-visible td { background: var(--surface-2); }\ntr.detail td { background: var(--surface-2); }\ntr.placeholder td { color: var(--muted); }\n.nowrap { white-space: nowrap; }\n.row-actions { display: inline-flex; gap: 6px; flex-wrap: wrap; }\n.confirm { display: inline-flex; gap: 6px; align-items: center; flex-wrap: wrap; }\n.tool-chips { display: flex; flex-wrap: wrap; gap: 6px; }\n\n.pill {\n  display: inline-block; padding: 1px 8px; border-radius: 999px;\n  font-size: 12px; font-weight: 600; white-space: nowrap;\n  background: var(--neutral-bg); color: var(--neutral);\n}\n.pill.ok { background: var(--ok-bg); color: var(--ok); }\n.pill.warn { background: var(--warn-bg); color: var(--warn); }\n.pill.bad { background: var(--bad-bg); color: var(--bad); }\n\nbutton {\n  font: inherit; padding: 6px 12px; border-radius: 6px;\n  border: 1px solid var(--border-strong); background: var(--surface);\n  color: var(--text); cursor: pointer; white-space: nowrap;\n}\nbutton:hover { background: var(--surface-2); }\nbutton:disabled { opacity: 0.6; cursor: default; }\nbutton.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-text); }\nbutton.primary:hover { filter: brightness(1.08); background: var(--accent); }\nbutton.ghost { background: transparent; }\nbutton.danger-outline { color: var(--bad); border-color: var(--bad); background: transparent; }\nbutton.danger { background: var(--bad); border-color: var(--bad); color: #fff; }\nbutton.toggle { padding: 2px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }\nbutton.toggle[aria-pressed=\"true\"] { background: var(--ok-bg); color: var(--ok); border-color: var(--ok); }\nbutton.toggle[aria-pressed=\"false\"] { background: var(--neutral-bg); color: var(--neutral); }\n\ninput, select, textarea {\n  font: inherit; width: 100%; padding: 6px 8px; min-width: 0;\n  border: 1px solid var(--border-strong); border-radius: 6px;\n  background: var(--surface); color: var(--text);\n}\ninput[readonly] { background: var(--surface-2); color: var(--muted); }\ntextarea { resize: vertical; }\nlabel {\n  display: flex; flex-direction: column; gap: 4px;\n  font-size: 13px; color: var(--muted); min-width: 0;\n}\nlabel.check { flex-direction: row; align-items: center; gap: 6px; color: var(--text); }\nlabel.check input { width: auto; }\n.form-grid {\n  display: grid; gap: 10px 12px; align-items: end;\n  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n}\n.wide { grid-column: 1 / -1; }\n.actions { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; align-items: center; }\n.actions.wide { grid-column: 1 / -1; }\n.inline-form {\n  display: grid; gap: 8px; align-items: end; margin-top: 10px;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n}\n.inline-form .actions { grid-column: 1 / -1; }\ndetails.add { margin-top: 10px; }\ndetails summary { cursor: pointer; color: var(--accent); }\nfieldset { border: 1px solid var(--border); border-radius: 6px; margin: 0 0 10px; padding: 10px; min-width: 0; }\nlegend { color: var(--muted); font-size: 13px; padding: 0 4px; }\n.rule {\n  display: grid; gap: 8px; align-items: end; margin-bottom: 8px;\n  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n}\n.filters {\n  display: grid; gap: 8px; align-items: end; margin-bottom: 12px;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n}\n.pager { display: flex; align-items: center; gap: 8px; justify-content: flex-end; margin-top: 10px; flex-wrap: wrap; }\n\n.callout {\n  border: 1px solid var(--warn); background: var(--warn-bg);\n  border-radius: var(--radius); padding: 12px; margin-bottom: 14px;\n}\n.secret-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }\n.secret-row input { flex: 1 1 220px; }\n\npre.code, pre.reply {\n  background: var(--code-bg); border: 1px solid var(--border); border-radius: 6px;\n  padding: 10px; overflow: auto; max-height: 320px;\n  white-space: pre-wrap; overflow-wrap: anywhere; margin: 0;\n}\npre.reply { font-family: inherit; font-size: 14px; max-height: none; }\ndl.meta { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 12px; margin: 0 0 10px; }\ndl.meta dt { color: var(--muted); }\ndl.meta dd { margin: 0; overflow-wrap: anywhere; }\n.kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 12px; align-items: center; }\n.kv dt { color: var(--muted); }\n.kv dd { margin: 0; }\n#pg-result:empty { display: none; }\n.chat-meta { margin-bottom: 8px; font-size: 12px; }\n\n.overlay {\n  position: fixed; inset: 0; z-index: 20;\n  background: rgba(0, 0, 0, 0.45);\n  display: grid; place-items: center; padding: 16px;\n}\n.dialog {\n  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);\n  padding: 18px; width: min(420px, 100%); display: grid; gap: 10px;\n}\n.dialog h2 { margin: 0; }\n.toasts {\n  position: fixed; right: 12px; bottom: 12px; z-index: 30;\n  display: grid; gap: 8px; width: min(360px, calc(100% - 24px));\n}\n.toast {\n  background: var(--surface); border: 1px solid var(--border);\n  border-left: 4px solid var(--accent); border-radius: 6px;\n  padding: 10px 12px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);\n  overflow-wrap: anywhere;\n}\n.toast.ok { border-left-color: var(--ok); }\n.toast.error { border-left-color: var(--bad); }\n\n@media (max-width: 480px) {\n  main { padding: 12px; }\n  .card { padding: 12px; }\n  .top { padding: 10px 12px; }\n  .tabs { padding: 0 6px; }\n  .tabs a { padding: 10px 8px; }\n}\n</style>\n</head>\n<body>\n<header class=\"top\">\n  <div class=\"brand\"><span class=\"logo\" aria-hidden=\"true\">R</span><span>Raiju <span class=\"muted\">gateway</span></span></div>\n  <div class=\"top-right\">\n    <span id=\"health-pill\" class=\"pill\" role=\"status\">checking</span>\n    <button type=\"button\" id=\"token-btn\" class=\"ghost\">Admin token</button>\n  </div>\n</header>\n\n<nav class=\"tabs\" aria-label=\"Sections\">\n  <a href=\"#overview\" data-nav=\"overview\">Overview</a>\n  <a href=\"#live\" data-nav=\"live\">Live</a>\n  <a href=\"#providers\" data-nav=\"providers\">Providers</a>\n  <a href=\"#keys\" data-nav=\"keys\">Virtual keys</a>\n  <a href=\"#governance\" data-nav=\"governance\">Budgets &amp; limits</a>\n  <a href=\"#logs\" data-nav=\"logs\">Logs</a>\n  <a href=\"#mcp\" data-nav=\"mcp\">MCP</a>\n  <a href=\"#config\" data-nav=\"config\">Config</a>\n  <a href=\"#playground\" data-nav=\"playground\">Playground</a>\n</nav>\n\n<main>\n  <noscript><p class=\"error\">This page needs JavaScript.</p></noscript>\n\n  <!-- Overview -->\n  <section data-view=\"overview\" aria-labelledby=\"ov-title\" hidden>\n    <div class=\"toolbar\">\n      <h1 id=\"ov-title\">Overview</h1>\n      <span class=\"hint\" id=\"ov-updated\" role=\"status\"></span>\n      <span class=\"grow\"></span>\n      <button type=\"button\" id=\"ov-refresh\" class=\"ghost\">Refresh</button>\n    </div>\n    <div class=\"cards\" id=\"ov-stats\"></div>\n    <div class=\"grid\">\n      <section class=\"card\" aria-labelledby=\"ov-models-h\"><h2 id=\"ov-models-h\">Models, last hour</h2><div id=\"ov-models\"></div></section>\n      <section class=\"card\" aria-labelledby=\"ov-breakers-h\"><h2 id=\"ov-breakers-h\">Circuit breakers</h2><div id=\"ov-breakers\"></div></section>\n      <section class=\"card\" aria-labelledby=\"ov-cache-h\"><h2 id=\"ov-cache-h\">Response cache</h2><div id=\"ov-cache\"></div></section>\n      <section class=\"card\" aria-labelledby=\"ov-mcp-h\"><h2 id=\"ov-mcp-h\">MCP clients</h2><div id=\"ov-mcp\"></div></section>\n    </div>\n    <details class=\"card\" id=\"ov-metrics-box\" style=\"margin-top:14px\">\n      <summary>Prometheus metrics</summary>\n      <pre class=\"code\" id=\"ov-metrics\">Opening this loads /metrics.</pre>\n    </details>\n  </section>\n\n  <!-- Live feed -->\n  <section data-view=\"live\" aria-labelledby=\"lv-title\" hidden>\n    <div class=\"toolbar\">\n      <h1 id=\"lv-title\">Live requests</h1>\n      <span class=\"pill\" id=\"lv-state\" role=\"status\">Stopped</span>\n      <span class=\"hint\" id=\"lv-count\"></span>\n      <span class=\"grow\"></span>\n      <button type=\"button\" id=\"lv-pause\" class=\"ghost\" aria-pressed=\"false\">Pause</button>\n      <button type=\"button\" id=\"lv-clear\" class=\"ghost\">Clear</button>\n    </div>\n    <p class=\"hint\" id=\"lv-note\">Newest first. The list keeps the latest 500 requests; requests made while the connection is down are not replayed.</p>\n    <div class=\"card\" style=\"padding:0\">\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th scope=\"col\">Time</th><th scope=\"col\">Provider</th><th scope=\"col\">Model</th>\n              <th scope=\"col\">Status</th><th scope=\"col\">Latency</th><th scope=\"col\">Tokens in / out</th>\n              <th scope=\"col\">Cost</th><th scope=\"col\">Cache</th><th scope=\"col\">Key</th>\n            </tr>\n          </thead>\n          <tbody id=\"lv-body\"></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <!-- Providers -->\n  <section data-view=\"providers\" aria-labelledby=\"pv-title\" hidden>\n    <div class=\"toolbar\">\n      <h1 id=\"pv-title\">Providers</h1>\n      <span class=\"grow\"></span>\n      <button type=\"button\" id=\"pv-refresh\" class=\"ghost\">Refresh</button>\n    </div>\n    <div id=\"pv-list\"></div>\n    <section class=\"card\" aria-labelledby=\"pv-add-h\">\n      <h2 id=\"pv-add-h\">Add provider</h2>\n      <form id=\"pv-add\" class=\"form-grid\">\n        <label>Name <input name=\"name\" required placeholder=\"e.g. openai-eu\" autocomplete=\"off\"></label>\n        <label>Kind\n          <select name=\"kind\" id=\"pv-kind\">\n            <option value=\"openai\">openai</option>\n            <option value=\"anthropic\">anthropic</option>\n            <option value=\"gemini\">gemini</option>\n            <option value=\"vertex\">vertex</option>\n            <option value=\"bedrock\">bedrock</option>\n            <option value=\"cohere\">cohere</option>\n            <option value=\"custom\">custom (base type)</option>\n          </select>\n        </label>\n        <label id=\"pv-custom-wrap\" hidden>Base provider type\n          <input name=\"base_provider_type\" placeholder=\"openai, anthropic, ...\" autocomplete=\"off\">\n        </label>\n        <label>Base URL (optional) <input name=\"base_url\" type=\"url\" placeholder=\"https://...\" autocomplete=\"off\"></label>\n        <p class=\"error wide\" id=\"pv-add-error\" role=\"alert\" hidden></p>\n        <div class=\"actions wide\">\n          <span class=\"hint grow\">Built-in kinds use the kind as the name when the name is blank.</span>\n          <button type=\"submit\" class=\"primary\">Save provider</button>\n        </div>\n      </form>\n    </section>\n  </section>\n\n  <!-- Virtual keys -->\n  <section data-view=\"keys\" aria-labelledby=\"vk-title\" hidden>\n    <div class=\"toolbar\">\n      <h1 id=\"vk-title\">Virtual keys</h1>\n      <span class=\"grow\"></span>\n      <button type=\"button\" id=\"vk-refresh\" class=\"ghost\">Refresh</button>\n      <button type=\"button\" id=\"vk-new\" class=\"primary\">New virtual key</button>\n    </div>\n    <div id=\"vk-secret\" class=\"callout\" role=\"status\" hidden>\n      <p><strong>Copy this key now.</strong> The full value is shown only once.</p>\n      <div class=\"secret-row\">\n        <input id=\"vk-secret-value\" class=\"mono\" readonly aria-label=\"New virtual key value\">\n        <button type=\"button\" id=\"vk-copy\" class=\"primary\">Copy</button>\n        <button type=\"button\" id=\"vk-secret-close\" class=\"ghost\">Done</button>\n      </div>\n      <p class=\"hint\" id=\"vk-copy-msg\"></p>\n    </div>\n    <form id=\"vk-form\" class=\"card\" aria-labelledby=\"vk-form-title\" hidden>\n      <h2 id=\"vk-form-title\">New virtual key</h2>\n      <div class=\"form-grid\">\n        <label>Name <input name=\"name\" required autocomplete=\"off\"></label>\n        <label>ID <input name=\"id\" class=\"mono\" placeholder=\"blank = generated\" autocomplete=\"off\"></label>\n        <label class=\"wide\">Description <input name=\"description\" autocomplete=\"off\"></label>\n        <label>Team <select name=\"team_id\"></select></label>\n        <label>Customer <select name=\"customer_id\"></select></label>\n        <label>Budget <select name=\"budget_id\"></select></label>\n        <label>Rate limit <select name=\"rate_limit_id\"></select></label>\n        <label class=\"check\"><input type=\"checkbox\" name=\"is_active\" checked> Active</label>\n      </div>\n      <fieldset class=\"wide\" style=\"margin-top:12px\">\n        <legend>Provider access</legend>\n        <p class=\"hint\">Blank models means every model of that provider.</p>\n        <div id=\"vk-rules\"></div>\n        <button type=\"button\" id=\"vk-add-rule\" class=\"ghost\">Add provider</button>\n      </fieldset>\n      <fieldset class=\"wide\" style=\"margin-top:12px\">\n        <legend>MCP tools</legend>\n        <p class=\"hint\">With no rows the key is not limited to MCP tools. Tools: * for all, blank for none, or a comma list.</p>\n        <div id=\"vk-mcp\"></div>\n        <button type=\"button\" id=\"vk-add-mcp\" class=\"ghost\">Add MCP client</button>\n      </fieldset>\n      <p class=\"error wide\" id=\"vk-error\" role=\"alert\" hidden></p>\n      <div class=\"actions\">\n        <button type=\"button\" id=\"vk-cancel\" class=\"ghost\">Cancel</button>\n        <button type=\"submit\" id=\"vk-save\" class=\"primary\">Create key</button>\n      </div>\n    </form>\n    <div id=\"vk-list\" class=\"card\"></div>\n  </section>\n\n  <!-- Budgets and rate limits -->\n  <section data-view=\"governance\" aria-labelledby=\"gv-title\" hidden>\n    <div class=\"toolbar\">\n      <h1 id=\"gv-title\">Budgets &amp; limits</h1>\n      <span class=\"grow\"></span>\n      <button type=\"button\" id=\"gv-refresh\" class=\"ghost\">Refresh</button>\n    </div>\n    <div id=\"gov-root\"></div>\n  </section>\n\n  <!-- Logs -->\n  <section data-view=\"logs\" aria-labelledby=\"lg-title\" hidden>\n    <div class=\"toolbar\">\n      <h1 id=\"lg-title\">Logs</h1>\n      <span class=\"grow\"></span>\n      <span class=\"hint\" id=\"lg-range\" role=\"status\"></span>\n    </div>\n    <form id=\"lg-filter\" class=\"card filters\" role=\"search\" aria-label=\"Filter logs\">\n      <label>Provider <input name=\"provider\" list=\"lg-providers\" autocomplete=\"off\"></label>\n      <datalist id=\"lg-providers\"></datalist>\n      <label>Model <input name=\"model\" list=\"lg-models\" autocomplete=\"off\"></label>\n      <datalist id=\"lg-models\"></datalist>\n      <label>Virtual key\n        <select name=\"virtual_key\"><option value=\"\">Any</option></select>\n      </label>\n      <label>Status\n        <select name=\"status\">\n          <option value=\"\">Any</option>\n          <option value=\"success\">Success</option>\n          <option value=\"error\">Error</option>\n        </select>\n      </label>\n      <label>Time range\n        <select name=\"period\">\n          <option value=\"\">Any time</option>\n          <option value=\"1h\">Last hour</option>\n          <option value=\"24h\">Last 24 hours</option>\n          <option value=\"7d\">Last 7 days</option>\n          <option value=\"custom\">Custom</option>\n        </select>\n      </label>\n      <label id=\"lg-from-wrap\" hidden>From <input name=\"from\" type=\"datetime-local\"></label>\n      <label id=\"lg-to-wrap\" hidden>To <input name=\"to\" type=\"datetime-local\"></label>\n      <label>Text <input name=\"text\" autocomplete=\"off\" placeholder=\"search\"></label>\n      <div class=\"actions\">\n        <button type=\"button\" id=\"lg-clear\" class=\"ghost\">Clear</button>\n        <button type=\"submit\" class=\"primary\">Apply</button>\n      </div>\n    </form>\n    <div class=\"card\" style=\"padding:0\">\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th scope=\"col\">Time</th><th scope=\"col\">Provider</th><th scope=\"col\">Model</th>\n              <th scope=\"col\">Status</th><th scope=\"col\">Latency</th><th scope=\"col\">Tokens in / out</th>\n              <th scope=\"col\">Cost</th><th scope=\"col\">Cache</th><th scope=\"col\">Key</th>\n            </tr>\n          </thead>\n          <tbody id=\"lg-body\"></tbody>\n        </table>\n      </div>\n    </div>\n    <div class=\"pager\">\n      <button type=\"button\" id=\"lg-prev\" class=\"ghost\">Previous</button>\n      <button type=\"button\" id=\"lg-next\" class=\"ghost\">Next</button>\n    </div>\n  </section>\n\n  <!-- MCP clients -->\n  <section data-view=\"mcp\" aria-labelledby=\"mcp-title\" hidden>\n    <div class=\"toolbar\">\n      <h1 id=\"mcp-title\">MCP clients</h1>\n      <span class=\"grow\"></span>\n      <button type=\"button\" id=\"mcp-refresh\" class=\"ghost\">Refresh</button>\n      <button type=\"button\" id=\"mcp-new\" class=\"primary\">Add client</button>\n    </div>\n    <form id=\"mcp-form\" class=\"card\" aria-labelledby=\"mcp-form-title\" hidden>\n      <h2 id=\"mcp-form-title\">Add MCP client</h2>\n      <div class=\"form-grid\">\n        <label>Name <input name=\"name\" required autocomplete=\"off\" placeholder=\"letters, digits, underscores\"></label>\n        <label>Connection\n          <select name=\"connection_type\">\n            <option value=\"http\">HTTP</option>\n            <option value=\"sse\">SSE</option>\n            <option value=\"stdio\">stdio</option>\n          </select>\n        </label>\n        <label class=\"wide\">URL (HTTP or SSE) <input name=\"connection_string\" type=\"url\" autocomplete=\"off\" placeholder=\"https://...\"></label>\n        <label>Command (stdio) <input name=\"command\" autocomplete=\"off\" placeholder=\"npx\"></label>\n        <label>Arguments (stdio, comma separated) <input name=\"args\" autocomplete=\"off\"></label>\n        <label class=\"wide\">Headers, one per line as Name: value\n          <textarea name=\"headers\" class=\"mono\" rows=\"3\" spellcheck=\"false\"></textarea>\n        </label>\n        <label class=\"check\"><input type=\"checkbox\" name=\"disabled\"> Disabled</label>\n        <p class=\"error wide\" id=\"mcp-error\" role=\"alert\" hidden></p>\n      </div>\n      <div class=\"actions\">\n        <button type=\"button\" id=\"mcp-cancel\" class=\"ghost\">Cancel</button>\n        <button type=\"submit\" id=\"mcp-save\" class=\"primary\">Add client</button>\n      </div>\n    </form>\n    <div id=\"mcp-list\"></div>\n  </section>\n\n  <!-- Configuration -->\n  <section data-view=\"config\" aria-labelledby=\"cfg-title\" hidden>\n    <div class=\"toolbar\">\n      <h1 id=\"cfg-title\">Configuration</h1>\n      <span class=\"grow\"></span>\n      <button type=\"button\" id=\"cfg-refresh\" class=\"ghost\">Reload</button>\n    </div>\n    <section class=\"card\" id=\"cfg-box\" aria-labelledby=\"cfg-edit-h\">\n      <h2 id=\"cfg-edit-h\">Settings</h2>\n      <p class=\"hint\">Saves three sections with PUT /api/config: client_config, framework_config (pricing sync) and auth_config (admin login). Other sections are changed on their own pages. A secret shown as &lt;redacted&gt; keeps its stored value.</p>\n      <label class=\"wide\">Settings as JSON\n        <textarea id=\"cfg-json\" class=\"mono\" rows=\"16\" spellcheck=\"false\" aria-describedby=\"cfg-edit-h\"></textarea>\n      </label>\n      <p class=\"error\" id=\"cfg-error\" role=\"alert\" hidden></p>\n      <div class=\"actions\" style=\"margin-top:10px\">\n        <button type=\"button\" id=\"cfg-discard\" class=\"ghost\">Discard changes</button>\n        <button type=\"button\" id=\"cfg-save\" class=\"primary\">Save configuration</button>\n      </div>\n    </section>\n    <details class=\"card\" id=\"cfg-full-box\">\n      <summary>Full configuration (read only, secrets redacted)</summary>\n      <pre class=\"code\" id=\"cfg-full\">Opening this loads /api/config.</pre>\n    </details>\n  </section>\n\n  <!-- Playground -->\n  <section data-view=\"playground\" aria-labelledby=\"pg-title\" hidden>\n    <div class=\"toolbar\"><h1 id=\"pg-title\">Playground</h1></div>\n    <form id=\"pg-form\" class=\"card\">\n      <div class=\"form-grid\">\n        <label>Model\n          <input name=\"model\" list=\"pg-models\" required placeholder=\"openai/gpt-4o-mini\" autocomplete=\"off\">\n        </label>\n        <datalist id=\"pg-models\"></datalist>\n        <label>Virtual key (optional)\n          <input name=\"vk\" type=\"password\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"sk-bf-...\">\n        </label>\n        <div class=\"actions\">\n          <button type=\"button\" id=\"pg-load\" class=\"ghost\">Load models</button>\n        </div>\n        <p class=\"hint wide\" id=\"pg-models-msg\" role=\"status\"></p>\n        <label class=\"wide\">Message\n          <textarea name=\"message\" rows=\"4\" required placeholder=\"Say hello\"></textarea>\n        </label>\n        <div class=\"actions wide\">\n          <span class=\"hint grow\">Ctrl+Enter sends.</span>\n          <button type=\"submit\" class=\"primary\">Send</button>\n        </div>\n      </div>\n    </form>\n    <div id=\"pg-result\" class=\"card\" aria-live=\"polite\"></div>\n  </section>\n</main>\n\n<div id=\"auth\" class=\"overlay\" hidden>\n  <form id=\"auth-form\" class=\"dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"auth-title\">\n    <h2 id=\"auth-title\">Admin token</h2>\n    <p id=\"auth-msg\" class=\"muted\">Enter the admin bearer token. It is kept for this browser tab only.</p>\n    <label>Token\n      <input id=\"auth-input\" type=\"password\" autocomplete=\"off\" spellcheck=\"false\">\n    </label>\n    <p id=\"auth-sso\" hidden><a class=\"button\" href=\"/api/oidc/login\">Sign in with SSO</a></p>\n    <div class=\"actions\">\n      <button type=\"button\" id=\"auth-clear\" class=\"ghost\">Clear saved token</button>\n      <button type=\"button\" id=\"auth-cancel\">Cancel</button>\n      <button type=\"submit\" class=\"primary\">Save</button>\n    </div>\n  </form>\n</div>\n\n<div id=\"toasts\" class=\"toasts\" aria-live=\"polite\"></div>\n\n<script>\n'use strict';\n\nconst PAGE_SIZE = 25;\nconst LOG_COLS = 9;\nconst LIVE_MAX = 500;\nconst PERIOD_MS = { '1h': 3600000, '24h': 86400000, '7d': 604800000 };\nconst TOKEN_KEY = 'raiju.adminToken';\nconst VIEWS = ['overview', 'live', 'providers', 'keys', 'governance', 'logs', 'mcp', 'config', 'playground'];\n\nconst state = {\n  opts: { providers: [], teams: [], customers: [], budgets: [], rate_limits: [], mcp: [] },\n  editing: null,\n  editingVk: null,\n  modelsLoaded: false,\n};\nconst logState = { offset: 0 };\nconst live = { want: false, paused: false, connected: false, queue: [], retry: 0, timer: -1, waitText: '', ws: null };\nconst mcpForm = { editing: null };\nconst auth = { pending: null, resolve: null, declined: false };\nlet adminToken = readToken();\nlet ovBusy = false;\nlet cfgEditorDirty = false;\n\n// ---- DOM helpers (dynamic data only ever goes in through textContent) ----\n\nfunction $(sel, root) { return (root || document).querySelector(sel); }\nfunction $$(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }\nfunction fld(form, name) { return form.elements.namedItem(name); }\nfunction enc(s) { return encodeURIComponent(String(s)); }\nfunction on(sel, ev, fn) { $(sel).addEventListener(ev, fn); }\n\nfunction el(tag, props) {\n  const n = document.createElement(tag);\n  if (props) {\n    for (const k of Object.keys(props)) {\n      const v = props[k];\n      if (v === undefined || v === null || v === false) continue;\n      if (k === 'text') n.textContent = String(v);\n      else if (k === 'class') n.className = v;\n      else if (k.indexOf('on') === 0 && typeof v === 'function') n.addEventListener(k.slice(2), v);\n      else n.setAttribute(k, v === true ? '' : String(v));\n    }\n  }\n  const kids = Array.prototype.slice.call(arguments, 2).flat();\n  for (const c of kids) {\n    if (c === undefined || c === null || c === false) continue;\n    n.append(c instanceof Node ? c : document.createTextNode(String(c)));\n  }\n  return n;\n}\n\nfunction table(cols, rows) {\n  return el('div', { class: 'table-wrap' },\n    el('table', null,\n      el('thead', null, el('tr', null, cols.map((c) => el('th', { scope: 'col', text: c })))),\n      el('tbody', null, rows.map((r) => el('tr', null, r.map((c) => el('td', null, c)))))));\n}\n\nfunction kv(pairs) {\n  return el('dl', { class: 'kv' }, pairs.flatMap((p) => [el('dt', { text: p[0] }), el('dd', null, p[1])]));\n}\n\nfunction pill(text, tone) { return el('span', { class: 'pill ' + (tone || ''), text: text }); }\nfunction stateTone(s) {\n  if (s === 'closed') return 'ok';\n  if (s === 'half_open') return 'warn';\n  if (s === 'open') return 'bad';\n  return '';\n}\n\n// ---- formatting ----\n\nfunction num(v) { const n = Number(v); return Number.isFinite(n) ? n : 0; }\nfunction fmtInt(v) { return num(v).toLocaleString(); }\nfunction fmtMoney(v) { return '$' + num(v).toFixed(4); }\nfunction fmtMs(v) {\n  const n = num(v);\n  return (n < 10 ? n.toFixed(1) : Math.round(n).toLocaleString()) + ' ms';\n}\nfunction fmtPct(fraction) {\n  let n = num(fraction);\n  if (n <= 1) n *= 100;\n  return n.toFixed(1) + '%';\n}\nfunction fmtTime(ts) {\n  let n = num(ts);\n  if (n > 0 && n < 1e12) n *= 1000;\n  return n > 0 ? new Date(n).toLocaleString() : '—';\n}\nfunction splitList(s) { return String(s || '').split(',').map((x) => x.trim()).filter(Boolean); }\nfunction pretty(v) {\n  let x = v;\n  if (typeof x === 'string') {\n    try { x = JSON.parse(x); } catch (e) { return x; }\n  }\n  try { return JSON.stringify(x, null, 2); } catch (e) { return String(x); }\n}\nfunction contentText(c) {\n  if (typeof c === 'string') return c;\n  if (Array.isArray(c)) return c.map((p) => (p && typeof p.text === 'string' ? p.text : '')).join('');\n  return '';\n}\n\n// ---- storage, HTTP and auth ----\n\nfunction readToken() {\n  try { return sessionStorage.getItem(TOKEN_KEY) || ''; } catch (e) { return ''; }\n}\nfunction writeToken(t) {\n  try {\n    if (t) sessionStorage.setItem(TOKEN_KEY, t);\n    else sessionStorage.removeItem(TOKEN_KEY);\n  } catch (e) { /* storage blocked: the token lasts for this page only */ }\n}\nfunction setToken(t) {\n  adminToken = t;\n  writeToken(t);\n  $('#token-btn').textContent = t ? 'Admin token: set' : 'Admin token';\n}\n\nclass ApiError extends Error {\n  constructor(status, message) {\n    super(message);\n    this.status = status;\n  }\n}\n\nfunction errorText(status, data, text, path) {\n  if (status === 404) return 'Not available on this gateway build: ' + path;\n  let msg = '';\n  if (data && typeof data === 'object') {\n    const e = data.error;\n    msg = typeof e === 'string' ? e : (e && e.message) || '';\n  }\n  if (msg) return msg;\n  if (status === 401) return 'Unauthorized. Sign in with the admin token (top right).';\n  if (typeof text === 'string' && text.trim()) return text.trim().slice(0, 300);\n  return 'Request failed with HTTP ' + status;\n}\n\n// send() returns { res, data, text }. opts: body, headers, auth (false skips the admin token).\nasync function send(method, path, opts) {\n  const o = opts || {};\n  const attempt = async () => {\n    const headers = Object.assign({ accept: 'application/json' }, o.headers || {});\n    if (o.body !== undefined) headers['content-type'] = 'application/json';\n    if (o.auth !== false && adminToken) headers.authorization = 'Bearer ' + adminToken;\n    let res;\n    try {\n      res = await fetch(path, {\n        method: method,\n        headers: headers,\n        body: o.body === undefined ? undefined : JSON.stringify(o.body),\n        cache: 'no-store',\n      });\n    } catch (e) {\n      throw new ApiError(0, 'Cannot reach the gateway. Is it running?');\n    }\n    const text = await res.text();\n    let data;\n    try { data = text ? JSON.parse(text) : undefined; } catch (e) { data = text; }\n    return { res: res, data: data, text: text };\n  };\n  let r = await attempt();\n  if (r.res.status === 401 && o.auth !== false) {\n    const t = await askToken(adminToken\n      ? 'The admin token was rejected. Enter a valid token.'\n      : 'This page needs the admin token to continue.');\n    if (t) r = await attempt();\n  }\n  if (!r.res.ok) throw new ApiError(r.res.status, errorText(r.res.status, r.data, r.text, path));\n  return r;\n}\n\nfunction api(method, path, body, opts) {\n  return send(method, path, Object.assign({ body: body }, opts || {})).then((r) => r.data);\n}\n\nfunction askToken(message) {\n  if (auth.declined) return Promise.resolve('');\n  if (!auth.pending) {\n    auth.pending = new Promise((resolve) => {\n      auth.resolve = resolve;\n      $('#auth-msg').textContent = message || 'Enter the admin token.';\n      $('#auth-input').value = '';\n      $('#auth').hidden = false;\n      $('#auth-input').focus();\n    });\n  }\n  return auth.pending;\n}\n\nfunction closeAuth(token) {\n  $('#auth').hidden = true;\n  const resolve = auth.resolve;\n  auth.pending = null;\n  auth.resolve = null;\n  if (resolve) resolve(token || '');\n}\n\n// offer SSO when the gateway has an identity provider configured\nfetch('/api/oidc/status').then((r) => r.ok ? r.json() : { enabled: false }).then((j) => {\n  if (j && j.enabled) $('#auth-sso').hidden = false;\n}).catch(() => {});\n\non('#auth-form', 'submit', (ev) => {\n  ev.preventDefault();\n  const t = $('#auth-input').value.trim();\n  setToken(t);\n  auth.declined = !t;\n  closeAuth(t);\n});\non('#auth-clear', 'click', () => {\n  setToken('');\n  auth.declined = true;\n  closeAuth('');\n});\non('#auth-cancel', 'click', () => {\n  auth.declined = true;\n  closeAuth('');\n});\non('#token-btn', 'click', () => {\n  auth.declined = false;\n  askToken('Enter the admin token. Submit it blank to clear it.');\n});\ndocument.addEventListener('keydown', (ev) => {\n  if (ev.key === 'Escape' && !$('#auth').hidden) {\n    auth.declined = true;\n    closeAuth('');\n  }\n});\n\n// ---- notices and small UI pieces ----\n\nfunction notify(message, tone) {\n  const t = el('div', {\n    class: 'toast ' + (tone || ''),\n    role: tone === 'error' ? 'alert' : 'status',\n    text: message,\n  });\n  $('#toasts').append(t);\n  setTimeout(() => t.remove(), tone === 'error' ? 8000 : 4000);\n}\n\nfunction errP(err) {\n  return el('p', { class: 'error', role: 'alert', text: err && err.message ? err.message : String(err) });\n}\n\n// An empty error line for a form. It stays hidden until runIn() fills it.\nfunction errLine() {\n  return el('p', { class: 'error wide', role: 'alert', hidden: true });\n}\n\n// Runs fn with the buttons inside root disabled, reporting failures as notices.\nasync function run(root, fn) {\n  const buttons = $$('button', root);\n  buttons.forEach((b) => { b.disabled = true; });\n  try {\n    await fn();\n  } catch (e) {\n    notify(e && e.message ? e.message : String(e), 'error');\n  } finally {\n    buttons.forEach((b) => { b.disabled = false; });\n  }\n}\n\n// Like run(), but a failure is written into errBox inside the form, next to the fields.\nasync function runIn(root, errBox, fn) {\n  errBox.hidden = true;\n  errBox.textContent = '';\n  const buttons = $$('button', root);\n  buttons.forEach((b) => { b.disabled = true; });\n  try {\n    await fn();\n  } catch (e) {\n    errBox.textContent = e && e.message ? e.message : String(e);\n    errBox.hidden = false;\n  } finally {\n    buttons.forEach((b) => { b.disabled = false; });\n  }\n}\n\n// A delete button that asks for an in-page confirmation (no confirm() dialogs).\nfunction dangerButton(label, action) {\n  const wrap = el('span', { class: 'confirm' });\n  const show = (confirming) => {\n    wrap.replaceChildren();\n    if (!confirming) {\n      wrap.append(el('button', { type: 'button', class: 'danger-outline', text: label, onclick: () => show(true) }));\n      return;\n    }\n    wrap.append(\n      el('span', { class: 'muted', text: 'Are you sure?' }),\n      el('button', {\n        type: 'button',\n        class: 'danger',\n        text: 'Confirm ' + label.toLowerCase(),\n        onclick: async () => {\n          wrap.querySelectorAll('button').forEach((b) => { b.disabled = true; });\n          try {\n            await action();\n          } catch (e) {\n            notify(e && e.message ? e.message : String(e), 'error');\n          } finally {\n            show(false);\n          }\n        },\n      }),\n      el('button', { type: 'button', class: 'ghost', text: 'Cancel', onclick: () => show(false) }));\n  };\n  show(false);\n  return wrap;\n}\n\nfunction statCard(label, value, sub) {\n  return el('div', { class: 'stat' },\n    el('div', { class: 'label', text: label }),\n    el('div', { class: 'value', text: value }),\n    sub ? el('div', { class: 'sub', text: sub }) : null);\n}\n\n// Copies text. Falls back to selecting the text in the given field.\nasync function copyText(text, field) {\n  try {\n    if (navigator.clipboard) {\n      await navigator.clipboard.writeText(text);\n      return true;\n    }\n  } catch (e) { /* fall through to the selection fallback */ }\n  if (field) {\n    field.focus();\n    field.select();\n    try { return document.execCommand('copy'); } catch (e) { return false; }\n  }\n  return false;\n}\n\nfunction settle(p) {\n  return p.then((value) => ({ ok: true, value: value }), (error) => ({ ok: false, error: error }));\n}\n\nfunction listOf(body, key) {\n  if (Array.isArray(body)) return body;\n  if (body && typeof body === 'object') {\n    if (Array.isArray(body[key])) return body[key];\n    for (const k of Object.keys(body)) if (Array.isArray(body[k])) return body[k];\n  }\n  return [];\n}\n\nfunction listSilently(path, key) {\n  return api('GET', path).then((b) => listOf(b, key), () => []);\n}\n\n// ---- health ----\n\nfunction setPill(node, text, tone) {\n  node.className = 'pill ' + (tone || '');\n  node.textContent = text;\n}\n\nasync function checkHealth() {\n  const p = $('#health-pill');\n  try {\n    await send('GET', '/health', { auth: false });\n    setPill(p, 'gateway ok', 'ok');\n  } catch (e) {\n    setPill(p, e.status ? 'gateway error ' + e.status : 'gateway unreachable', 'bad');\n  }\n}\n\n// ---- overview ----\n\nasync function loadOverview() {\n  if (ovBusy) return;\n  ovBusy = true;\n  try {\n    const since = Date.now() - 3600000;\n    const [stats, cache, health, mcp] = await Promise.all([\n      settle(api('GET', '/api/logs/stats?since=' + since)),\n      settle(api('GET', '/api/cache')),\n      settle(api('GET', '/api/health')),\n      settle(api('GET', '/api/mcp')),\n    ]);\n    renderStats(stats);\n    renderModels(stats);\n    renderBreakers(health);\n    renderCache(cache);\n    renderMcpOverview(mcp);\n    $('#ov-updated').textContent = 'Updated ' + new Date().toLocaleTimeString();\n  } finally {\n    ovBusy = false;\n  }\n}\n\nfunction renderStats(r) {\n  const box = $('#ov-stats');\n  if (!r.ok) return box.replaceChildren(errP(r.error));\n  const s = r.value || {};\n  const reqs = num(s.requests);\n  box.replaceChildren(\n    statCard('Requests', fmtInt(s.requests), 'last hour'),\n    statCard('Errors', fmtInt(s.errors), reqs ? fmtPct(num(s.errors) / reqs) + ' error rate' : 'no traffic'),\n    statCard('Tokens', fmtInt(s.tokens), 'last hour'),\n    statCard('Cost', fmtMoney(s.cost), 'last hour'),\n    statCard('Avg latency', fmtMs(s.avg_latency_ms), 'last hour'));\n}\n\nfunction renderModels(r) {\n  const box = $('#ov-models');\n  if (!r.ok) return box.replaceChildren(errP(r.error));\n  const rows = listOf(r.value, 'by_model').slice().sort((a, b) => num(b.requests) - num(a.requests));\n  if (!rows.length) return box.replaceChildren(el('p', { class: 'muted', text: 'No traffic in the last hour.' }));\n  box.replaceChildren(table(['Model', 'Requests', 'Cost'], rows.map((m) => [\n    el('span', { class: 'mono', text: m.model || '—' }),\n    fmtInt(m.requests),\n    fmtMoney(m.cost),\n  ])));\n}\n\nfunction renderBreakers(r) {\n  const box = $('#ov-breakers');\n  if (!r.ok) return box.replaceChildren(errP(r.error));\n  const targets = listOf(r.value, 'targets');\n  if (!targets.length) return box.replaceChildren(el('p', { class: 'muted', text: 'No targets have reported yet.' }));\n  box.replaceChildren(table(['Target', 'State', 'Latency', 'Success', 'Requests'], targets.map((t) => [\n    el('span', { class: 'mono', text: t.id || '—' }),\n    pill(String(t.state || 'unknown'), stateTone(t.state)),\n    t.ewmaMs === undefined ? '—' : fmtMs(t.ewmaMs),\n    t.successRate === undefined ? '—' : fmtPct(t.successRate),\n    fmtInt(t.requests),\n  ])));\n}\n\nfunction renderCache(r) {\n  const box = $('#ov-cache');\n  if (!r.ok) return box.replaceChildren(errP(r.error));\n  const c = r.value || {};\n  const hits = num(c.hits), misses = num(c.misses);\n  const total = hits + misses;\n  box.replaceChildren(kv([\n    ['Status', pill(c.enabled ? 'enabled' : 'disabled', c.enabled ? 'ok' : '')],\n    ['Entries', fmtInt(c.entries)],\n    ['Hits', fmtInt(hits)],\n    ['Misses', fmtInt(misses)],\n    ['Hit rate', total ? fmtPct(hits / total) : '—'],\n  ]));\n}\n\nfunction renderMcpOverview(r) {\n  const box = $('#ov-mcp');\n  if (!r.ok) return box.replaceChildren(errP(r.error));\n  const clients = listOf(r.value, 'clients');\n  if (!clients.length) return box.replaceChildren(el('p', { class: 'muted', text: 'No MCP clients configured.' }));\n  box.replaceChildren(table(['Client', 'Connection', 'Tools', 'Error'], clients.map((c) => [\n    el('span', { class: 'mono', text: c.name || '—' }),\n    c.connected ? pill('connected', 'ok') : pill('down', 'bad'),\n    fmtInt(c.tools),\n    c.error ? el('span', { class: 'error', text: c.error }) : '—',\n  ])));\n}\n\n// ---- providers ----\n\nasync function loadProviders() {\n  const box = $('#pv-list');\n  try {\n    const body = await api('GET', '/api/providers');\n    state.opts.providers = listOf(body, 'providers');\n    renderProviders(box, state.opts.providers);\n  } catch (e) {\n    box.replaceChildren(errP(e));\n  }\n}\n\nfunction renderProviders(box, providers) {\n  if (!providers.length) {\n    return box.replaceChildren(el('p', { class: 'card muted', text: 'No providers configured yet. Add one below.' }));\n  }\n  box.replaceChildren(...providers.map(providerCard));\n}\n\n// A key is addressed by its id; older records without one fall back to the name.\nfunction keyRef(k) { return k.id || k.name; }\n\nfunction providerCard(p) {\n  const keys = p.keys || [];\n  const custom = !!p.custom_provider_config;\n  const editForm = providerEditForm(p, custom);\n  const keyBox = el('div');\n  const editBtn = el('button', {\n    type: 'button',\n    class: 'ghost',\n    text: 'Edit',\n    'aria-expanded': 'false',\n    onclick: () => {\n      editForm.hidden = !editForm.hidden;\n      editBtn.setAttribute('aria-expanded', String(!editForm.hidden));\n      if (!editForm.hidden) fld(editForm, 'base_url').focus();\n    },\n  });\n  const keyRows = keys.map((k) => [\n    el('span', { class: 'mono', text: k.name || '—' }),\n    k.models && k.models.length ? k.models.join(', ') : 'all models',\n    k.weight === undefined ? '—' : String(k.weight),\n    el('span', { class: 'row-actions' },\n      el('button', {\n        type: 'button',\n        class: 'ghost',\n        text: 'Edit',\n        onclick: () => {\n          keyBox.replaceChildren(keyEditForm(p, k, () => keyBox.replaceChildren()));\n          const first = keyBox.querySelector('input');\n          if (first) first.focus();\n        },\n      }),\n      dangerButton('Delete', () => removeKey(p.name, keyRef(k)))),\n  ]);\n  return el('article', { class: 'card', 'aria-label': 'Provider ' + p.name },\n    el('header', { class: 'toolbar', style: 'margin-bottom:8px' },\n      el('h3', { text: p.name }),\n      pill(p.kind || 'unknown'),\n      el('span', { class: 'hint mono grow', text: (p.network_config && p.network_config.base_url) || p.base_url || 'default endpoint' }),\n      el('span', { class: 'row-actions' }, editBtn, dangerButton('Delete', () => removeProvider(p.name)))),\n    editForm,\n    keys.length\n      ? table(['Key', 'Models', 'Weight', ''], keyRows)\n      : el('p', { class: 'muted', text: 'No keys. Requests to this provider fail until one is added.' }),\n    keyBox,\n    addKeyForm(p.name));\n}\n\nfunction providerEditForm(p, custom) {\n  const err = errLine();\n  const form = el('form', { class: 'form-grid', hidden: true, 'aria-label': 'Edit provider ' + p.name },\n    el('label', null, 'Base URL (optional)',\n      el('input', { name: 'base_url', type: 'url', value: (p.network_config && p.network_config.base_url) || p.base_url || '', placeholder: 'https://...', autocomplete: 'off' })),\n    custom ? el('label', null, 'Base provider type',\n      el('input', { name: 'base_provider_type', value: (p.custom_provider_config && p.custom_provider_config.base_provider_type) || '', autocomplete: 'off' })) : null,\n    el('div', { class: 'actions wide' },\n      el('button', { type: 'button', class: 'ghost', text: 'Cancel', onclick: () => { form.hidden = true; } }),\n      el('button', { type: 'submit', class: 'primary', text: 'Save provider' })),\n    err);\n  form.addEventListener('submit', (ev) => {\n    ev.preventDefault();\n    const url = fld(form, 'base_url').value.trim();\n    const baseType = custom ? fld(form, 'base_provider_type').value.trim() : '';\n    runIn(form, err, async () => {\n      if (custom && !baseType) throw new Error('Enter the base provider type for a custom provider.');\n      // keys are left out, so the saved keys stay as they are (a PUT without keys keeps them)\n      const network = Object.assign({}, p.network_config || {});\n      if (url) network.base_url = url;\n      else delete network.base_url;\n      await api('PUT', '/api/providers/' + enc(p.name), {\n        network_config: Object.keys(network).length ? network : undefined,\n        custom_provider_config: custom ? Object.assign({}, p.custom_provider_config, { base_provider_type: baseType }) : undefined,\n        proxy_config: p.proxy_config,\n        send_back_raw_response: p.send_back_raw_response,\n      });\n      notify('Provider \"' + p.name + '\" saved', 'ok');\n      await loadProviders();\n    });\n  });\n  return form;\n}\n\nfunction keyEditForm(p, k, close) {\n  const err = errLine();\n  const form = el('form', { class: 'inline-form', 'aria-label': 'Edit key ' + (k.name || keyRef(k)) },\n    el('label', null, 'Key name', el('input', { name: 'name', required: true, value: k.name || '', autocomplete: 'off' })),\n    el('label', null, 'New API key', el('input', { name: 'value', type: 'password', autocomplete: 'new-password', spellcheck: 'false', placeholder: 'leave blank to keep it' })),\n    el('label', null, 'Models', el('input', { name: 'models', value: (k.models || []).join(', '), placeholder: 'blank = all models', autocomplete: 'off' })),\n    el('label', null, 'Weight', el('input', { name: 'weight', type: 'number', min: '0', step: '0.1', value: k.weight === undefined ? '1' : String(k.weight) })),\n    el('div', { class: 'actions' },\n      el('button', { type: 'button', class: 'ghost', text: 'Cancel', onclick: () => close() }),\n      el('button', { type: 'submit', class: 'primary', text: 'Save key' })),\n    err);\n  form.addEventListener('submit', (ev) => {\n    ev.preventDefault();\n    runIn(form, err, async () => {\n      const weight = fld(form, 'weight').value;\n      const body = {\n        name: fld(form, 'name').value.trim(),\n        models: splitList(fld(form, 'models').value),\n        weight: weight === '' ? 1 : Number(weight),\n      };\n      // a blank value leaves the stored key as it is\n      const value = fld(form, 'value').value;\n      if (value !== '') body.value = value;\n      await api('PUT', '/api/providers/' + enc(p.name) + '/keys/' + enc(keyRef(k)), body);\n      notify('Key saved', 'ok');\n      await loadProviders();\n    });\n  });\n  return form;\n}\n\nfunction addKeyForm(provider) {\n  const err = errLine();\n  const form = el('form', { class: 'inline-form' },\n    el('label', null, 'Key name', el('input', { name: 'name', required: true, placeholder: 'e.g. primary', autocomplete: 'off' })),\n    el('label', null, 'API key', el('input', { name: 'value', type: 'password', required: true, autocomplete: 'new-password', spellcheck: 'false' })),\n    el('label', null, 'Models', el('input', { name: 'models', placeholder: 'blank = all models', autocomplete: 'off' })),\n    el('label', null, 'Weight', el('input', { name: 'weight', type: 'number', min: '0', step: '0.1', value: '1' })),\n    el('div', { class: 'actions' }, el('button', { type: 'submit', class: 'primary', text: 'Add key' })),\n    err);\n  form.addEventListener('submit', (ev) => {\n    ev.preventDefault();\n    runIn(form, err, async () => {\n      const weight = fld(form, 'weight').value;\n      const body = {\n        name: fld(form, 'name').value.trim(),\n        value: fld(form, 'value').value,\n        models: splitList(fld(form, 'models').value),\n        weight: weight === '' ? 1 : Number(weight),\n      };\n      await api('POST', '/api/providers/' + enc(provider) + '/keys', body);\n      notify('Key added to ' + provider, 'ok');\n      await loadProviders();\n    });\n  });\n  return el('details', { class: 'add' }, el('summary', { text: 'Add key' }), form);\n}\n\nasync function removeKey(provider, keyId) {\n  await api('DELETE', '/api/providers/' + enc(provider) + '/keys/' + enc(keyId));\n  notify('Key deleted', 'ok');\n  await loadProviders();\n}\n\nasync function removeProvider(name) {\n  await api('DELETE', '/api/providers/' + enc(name));\n  notify('Provider deleted', 'ok');\n  await loadProviders();\n}\n\non('#pv-kind', 'change', () => {\n  $('#pv-custom-wrap').hidden = fld($('#pv-add'), 'kind').value !== 'custom';\n});\n\non('#pv-add', 'submit', (ev) => {\n  ev.preventDefault();\n  const form = $('#pv-add');\n  const errBox = $('#pv-add-error');\n  runIn(form, errBox, async () => {\n    const kind = fld(form, 'kind').value;\n    const name = fld(form, 'name').value.trim() || (kind !== 'custom' ? kind : '');\n    const base = fld(form, 'base_url').value.trim();\n    const baseType = fld(form, 'base_provider_type').value.trim();\n    if (!name) throw new Error('Enter a provider name.');\n    if (kind === 'custom' && !baseType) throw new Error('Enter the base provider type for a custom provider.');\n    if (state.opts.providers.some((p) => p.name === name)) {\n      throw new Error('Provider \"' + name + '\" already exists. Edit it or add keys below.');\n    }\n    // keys is left out on purpose: the form only sets the endpoint of a new provider\n    await api('PUT', '/api/providers/' + enc(name), {\n      network_config: base ? { base_url: base } : undefined,\n      custom_provider_config: kind === 'custom' ? { base_provider_type: baseType } : undefined,\n    });\n    notify('Provider \"' + name + '\" saved', 'ok');\n    form.reset();\n    $('#pv-custom-wrap').hidden = true;\n    await loadProviders();\n  });\n});\n\non('#pv-refresh', 'click', () => loadProviders());\n\n// ---- virtual keys ----\n\nasync function loadOptions() {\n  const [providers, teams, customers, budgets, rate_limits, mcp] = await Promise.all([\n    listSilently('/api/providers', 'providers'),\n    listSilently('/api/governance/teams', 'teams'),\n    listSilently('/api/governance/customers', 'customers'),\n    listSilently('/api/governance/budgets', 'budgets'),\n    listSilently('/api/governance/rate-limits', 'rate_limits'),\n    listSilently('/api/mcp/clients', 'clients'),\n  ]);\n  state.opts = { providers: providers, teams: teams, customers: customers, budgets: budgets, rate_limits: rate_limits, mcp: mcp };\n  return state.opts;\n}\n\nfunction labelOf(item) { return item.name ? item.name + ' (' + item.id + ')' : String(item.id); }\n\nfunction nameOf(items, id) {\n  if (!id) return '—';\n  const hit = items.find((x) => x.id === id);\n  return hit ? (hit.name || hit.id) : id;\n}\n\nasync function loadKeys() {\n  const box = $('#vk-list');\n  try {\n    const [body] = await Promise.all([api('GET', '/api/governance/virtual-keys'), loadOptions()]);\n    renderVkList(box, listOf(body, 'virtual_keys'));\n  } catch (e) {\n    box.replaceChildren(errP(e));\n  }\n}\n\n// What a key may run on MCP: absent means no list (not limited), an empty list means none.\nfunction mcpSummary(list) {\n  if (list === undefined || list === null) return 'Not limited';\n  if (!list.length) return 'None';\n  return list.map((c) => {\n    const t = c.tools_to_execute || [];\n    const what = t.indexOf('*') >= 0 ? 'all tools' : (t.length ? t.join(', ') : 'none');\n    return c.mcp_client_name + ' (' + what + ')';\n  }).join('; ');\n}\n\nfunction renderVkList(box, keys) {\n  if (!keys.length) {\n    return box.replaceChildren(el('p', { class: 'muted', text: 'No virtual keys yet. Create one to give a client scoped access.' }));\n  }\n  const o = state.opts;\n  const rows = keys.map((vk) => {\n    const active = vk.is_active !== false;\n    const rules = (vk.provider_configs || []).map((p) => {\n      const models = p.allowed_models && p.allowed_models.length ? p.allowed_models.join(', ') : 'all models';\n      return p.provider + ' (' + models + ')';\n    }).join('; ');\n    return [\n      el('div', null, el('strong', { text: vk.name || vk.id }), el('div', { class: 'hint mono', text: vk.id })),\n      el('button', {\n        type: 'button',\n        class: 'toggle',\n        'aria-pressed': String(active),\n        text: active ? 'Active' : 'Disabled',\n        onclick: () => run(box, async () => {\n          await api('PUT', '/api/governance/virtual-keys/' + enc(vk.id), vkRecordBody(vk, { is_active: !active }));\n          notify((vk.name || vk.id) + (active ? ' disabled' : ' enabled'), 'ok');\n          await loadKeys();\n        }),\n      }),\n      rules || 'none',\n      mcpSummary(vk.mcp_configs),\n      nameOf(o.teams, vk.team_id),\n      nameOf(o.customers, vk.customer_id),\n      nameOf(o.budgets, vk.budget_id),\n      nameOf(o.rate_limits, vk.rate_limit_id),\n      el('span', { class: 'row-actions' },\n        el('button', { type: 'button', class: 'ghost', text: 'Edit', onclick: () => openVkForm(vk).catch((e) => notify(e.message, 'error')) }),\n        el('button', {\n          type: 'button',\n          class: 'ghost',\n          text: 'Rotate',\n          onclick: () => run(box, async () => {\n            const r = await api('POST', '/api/governance/virtual-keys/' + enc(vk.id) + '/rotate');\n            await loadKeys();\n            const value = r && r.value;\n            if (value) showSecret(String(value));\n            else notify('Virtual key rotated', 'ok');\n          }),\n        }),\n        dangerButton('Delete', async () => {\n          await api('DELETE', '/api/governance/virtual-keys/' + enc(vk.id));\n          notify('Virtual key deleted', 'ok');\n          await loadKeys();\n        })),\n    ];\n  });\n  box.replaceChildren(table(['Name', 'Status', 'Providers', 'MCP tools', 'Team', 'Customer', 'Budget', 'Rate limit', ''], rows));\n}\n\n// Body for PUT built from a listed key. The masked value is left out, which keeps the stored one.\nfunction vkRecordBody(vk, patch) {\n  const base = {\n    id: vk.id,\n    name: vk.name || '',\n    description: vk.description || '',\n    is_active: vk.is_active !== false,\n    team_id: vk.team_id || null,\n    customer_id: vk.customer_id || null,\n    budget_id: vk.budget_id || null,\n    rate_limit_id: vk.rate_limit_id || null,\n    provider_configs: vk.provider_configs || [],\n    key_ids: vk.key_ids,\n    expires_at: vk.expires_at,\n    disable_content_logging: vk.disable_content_logging,\n    mcp_configs: vk.mcp_configs,\n  };\n  return Object.assign(base, patch || {});\n}\n\nfunction fillSelect(sel, items, selected) {\n  sel.replaceChildren(el('option', { value: '', text: 'None' }));\n  for (const it of items) sel.append(el('option', { value: it.id, text: labelOf(it) }));\n  if (selected && !items.some((i) => i.id === selected)) {\n    sel.append(el('option', { value: selected, text: selected + ' (missing)' }));\n  }\n  sel.value = selected || '';\n}\n\nfunction ruleRow(pre) {\n  const names = state.opts.providers.map((p) => p.name);\n  if (pre && pre.provider && names.indexOf(pre.provider) < 0) names.push(pre.provider);\n  const provider = el('select', { 'aria-label': 'Provider' }, el('option', { value: '', text: 'Choose provider' }));\n  for (const n of names) provider.append(el('option', { value: n, text: n }));\n  provider.value = pre && pre.provider ? pre.provider : '';\n  const models = el('input', {\n    type: 'text',\n    'aria-label': 'Allowed models',\n    placeholder: 'all models',\n    autocomplete: 'off',\n    value: pre && pre.allowed_models ? pre.allowed_models.join(', ') : '',\n  });\n  const row = el('div', { class: 'rule' },\n    provider,\n    models,\n    el('button', { type: 'button', class: 'ghost', text: 'Remove', onclick: () => row.remove() }));\n  return row;\n}\n\nfunction mcpRow(pre) {\n  const names = state.opts.mcp.map((c) => c.name);\n  if (pre && pre.mcp_client_name && names.indexOf(pre.mcp_client_name) < 0) names.push(pre.mcp_client_name);\n  const client = el('select', { 'aria-label': 'MCP client' }, el('option', { value: '', text: 'Choose MCP client' }));\n  for (const n of names) client.append(el('option', { value: n, text: n }));\n  client.value = pre && pre.mcp_client_name ? pre.mcp_client_name : '';\n  const tools = el('input', {\n    type: 'text',\n    'aria-label': 'Allowed MCP tools',\n    placeholder: '* for all, blank for none, or a comma list',\n    autocomplete: 'off',\n    value: pre ? (pre.tools_to_execute || []).join(', ') : '*',\n  });\n  const row = el('div', { class: 'rule mcp-rule' },\n    client,\n    tools,\n    el('button', { type: 'button', class: 'ghost', text: 'Remove', onclick: () => row.remove() }));\n  return row;\n}\n\nasync function openVkForm(vk) {\n  await loadOptions();\n  const form = $('#vk-form');\n  state.editing = vk ? vk.id : null;\n  state.editingVk = vk || null;\n  form.reset();\n  fld(form, 'name').value = vk ? vk.name || '' : '';\n  fld(form, 'id').value = vk ? vk.id : '';\n  fld(form, 'id').readOnly = !!vk;\n  fld(form, 'description').value = vk ? vk.description || '' : '';\n  fillSelect(fld(form, 'team_id'), state.opts.teams, vk ? vk.team_id : '');\n  fillSelect(fld(form, 'customer_id'), state.opts.customers, vk ? vk.customer_id : '');\n  fillSelect(fld(form, 'budget_id'), state.opts.budgets, vk ? vk.budget_id : '');\n  fillSelect(fld(form, 'rate_limit_id'), state.opts.rate_limits, vk ? vk.rate_limit_id : '');\n  fld(form, 'is_active').checked = vk ? vk.is_active !== false : true;\n  $('#vk-form-title').textContent = vk ? 'Edit ' + (vk.name || vk.id) : 'New virtual key';\n  $('#vk-save').textContent = vk ? 'Save changes' : 'Create key';\n  const rules = $('#vk-rules');\n  rules.replaceChildren();\n  for (const p of (vk && vk.provider_configs) || []) rules.append(ruleRow(p));\n  const mcp = $('#vk-mcp');\n  mcp.replaceChildren();\n  for (const m of (vk && vk.mcp_configs) || []) mcp.append(mcpRow(m));\n  form.hidden = false;\n  if (form.scrollIntoView) form.scrollIntoView({ block: 'start' });\n  fld(form, 'name').focus();\n}\n\nfunction closeVkForm() {\n  const form = $('#vk-form');\n  state.editing = null;\n  state.editingVk = null;\n  form.reset();\n  form.hidden = true;\n  $('#vk-rules').replaceChildren();\n  $('#vk-mcp').replaceChildren();\n  $('#vk-error').hidden = true;\n}\n\n// The PUT body for the form. For an edit it starts from the listed record, so fields the form does\n// not show (key ids, expiry, content logging) are sent back as they were.\nfunction vkFormBody(form, vk) {\n  const opt = (name) => fld(form, name).value || null;\n  const rules = [];\n  for (const row of $$('.rule', $('#vk-rules'))) {\n    const provider = row.querySelector('select').value;\n    if (!provider) continue;\n    const prev = ((vk && vk.provider_configs) || []).find((p) => p.provider === provider) || {};\n    rules.push({\n      weight: prev.weight,\n      budget_id: prev.budget_id,\n      rate_limit_id: prev.rate_limit_id,\n      provider: provider,\n      allowed_models: splitList(row.querySelector('input').value),\n    });\n  }\n  const mcp = [];\n  for (const row of $$('.mcp-rule', $('#vk-mcp'))) {\n    const client = row.querySelector('select').value;\n    if (!client) continue;\n    mcp.push({ mcp_client_name: client, tools_to_execute: splitList(row.querySelector('input').value) });\n  }\n  const body = Object.assign(vk ? vkRecordBody(vk) : {}, {\n    name: fld(form, 'name').value.trim(),\n    description: fld(form, 'description').value.trim(),\n    is_active: fld(form, 'is_active').checked,\n    team_id: opt('team_id'),\n    customer_id: opt('customer_id'),\n    budget_id: opt('budget_id'),\n    rate_limit_id: opt('rate_limit_id'),\n    provider_configs: rules,\n    mcp_configs: mcp.length ? mcp : undefined,\n  });\n  const id = vk ? vk.id : fld(form, 'id').value.trim();\n  if (id) body.id = id;\n  return body;\n}\n\nfunction showSecret(value) {\n  const box = $('#vk-secret');\n  const input = $('#vk-secret-value');\n  input.value = value;\n  $('#vk-copy-msg').textContent = '';\n  box.hidden = false;\n  input.focus();\n  input.select();\n}\n\non('#vk-new', 'click', () => openVkForm(null).catch((e) => notify(e.message, 'error')));\non('#vk-refresh', 'click', () => loadKeys());\non('#vk-cancel', 'click', () => closeVkForm());\non('#vk-add-rule', 'click', () => $('#vk-rules').append(ruleRow(null)));\non('#vk-add-mcp', 'click', () => $('#vk-mcp').append(mcpRow(null)));\n\non('#vk-copy', 'click', async () => {\n  const input = $('#vk-secret-value');\n  const ok = await copyText(input.value, input);\n  $('#vk-copy-msg').textContent = ok ? 'Copied to the clipboard.' : 'Press Ctrl+C (Cmd+C) to copy the selected key.';\n});\non('#vk-secret-close', 'click', () => {\n  $('#vk-secret-value').value = '';\n  $('#vk-secret').hidden = true;\n});\n\non('#vk-form', 'submit', (ev) => {\n  ev.preventDefault();\n  const form = $('#vk-form');\n  const editing = state.editing;\n  const current = state.editingVk;\n  runIn(form, $('#vk-error'), async () => {\n    const body = vkFormBody(form, current);\n    if (editing) {\n      await api('PUT', '/api/governance/virtual-keys/' + enc(editing), body);\n      closeVkForm();\n      notify('Virtual key saved', 'ok');\n    } else {\n      const created = await api('POST', '/api/governance/virtual-keys', body);\n      closeVkForm();\n      const value = created && (created.value || (created.virtual_key && created.virtual_key.value));\n      if (value) showSecret(String(value));\n      else notify('Virtual key created', 'ok');\n    }\n    await loadKeys();\n  });\n});\n\n// ---- budgets, rate limits, teams, customers ----\n\nconst GOV_SPECS = [\n  {\n    noun: 'Budget',\n    title: 'Budgets',\n    path: '/api/governance/budgets',\n    listKey: 'budgets',\n    fields: [\n      { name: 'id', label: 'ID', required: true, key: true, placeholder: 'e.g. team-ops', wide: false },\n      { name: 'max_limit', label: 'Max limit (USD)', type: 'number', step: 'any', min: '0', num: true, required: true },\n      { name: 'reset_duration', label: 'Reset every', placeholder: '1d, 1h, 30m', required: true },\n    ],\n    columns: [\n      { label: 'ID', get: (b) => el('span', { class: 'mono', text: b.id || '—' }) },\n      { label: 'Max limit', get: (b) => fmtMoney(b.max_limit) },\n      { label: 'Used', get: (b) => (b.current_usage === undefined ? '—' : fmtMoney(b.current_usage)) },\n      { label: 'Reset', get: (b) => b.reset_duration || '—' },\n    ],\n  },\n  {\n    noun: 'Rate limit',\n    title: 'Rate limits',\n    path: '/api/governance/rate-limits',\n    listKey: 'rate_limits',\n    fields: [\n      { name: 'id', label: 'ID', required: true, key: true, placeholder: 'e.g. standard' },\n      { name: 'token_max_limit', label: 'Max tokens', type: 'number', step: '1', min: '0', num: true },\n      { name: 'token_reset_duration', label: 'Token window', placeholder: '1m, 1h' },\n      { name: 'request_max_limit', label: 'Max requests', type: 'number', step: '1', min: '0', num: true },\n      { name: 'request_reset_duration', label: 'Request window', placeholder: '1m, 1h' },\n    ],\n    columns: [\n      { label: 'ID', get: (r) => el('span', { class: 'mono', text: r.id || '—' }) },\n      { label: 'Tokens', get: (r) => (r.token_max_limit === undefined ? '—' : fmtInt(r.token_max_limit) + ' / ' + (r.token_reset_duration || '?')) },\n      { label: 'Requests', get: (r) => (r.request_max_limit === undefined ? '—' : fmtInt(r.request_max_limit) + ' / ' + (r.request_reset_duration || '?')) },\n    ],\n  },\n  {\n    noun: 'Team',\n    title: 'Teams',\n    path: '/api/governance/teams',\n    listKey: 'teams',\n    fields: [\n      { name: 'id', label: 'ID', required: true, key: true },\n      { name: 'name', label: 'Name', required: true },\n      { name: 'customer_id', label: 'Customer ID' },\n      { name: 'budget_id', label: 'Budget ID' },\n    ],\n    columns: [\n      { label: 'ID', get: (t) => el('span', { class: 'mono', text: t.id || '—' }) },\n      { label: 'Name', get: (t) => t.name || '—' },\n      { label: 'Customer', get: (t) => t.customer_id || '—' },\n      { label: 'Budget', get: (t) => t.budget_id || '—' },\n    ],\n  },\n  {\n    noun: 'Customer',\n    title: 'Customers',\n    path: '/api/governance/customers',\n    listKey: 'customers',\n    fields: [\n      { name: 'id', label: 'ID', required: true, key: true },\n      { name: 'name', label: 'Name', required: true },\n      { name: 'budget_id', label: 'Budget ID' },\n    ],\n    columns: [\n      { label: 'ID', get: (c) => el('span', { class: 'mono', text: c.id || '—' }) },\n      { label: 'Name', get: (c) => c.name || '—' },\n      { label: 'Budget', get: (c) => c.budget_id || '—' },\n    ],\n  },\n];\n\nlet govCruds = null;\n\nfunction crud(root, spec) {\n  let editingId = null;\n  const inputs = {};\n  const fieldNodes = spec.fields.map((f) => {\n    const input = el('input', {\n      name: f.name,\n      type: f.type || 'text',\n      placeholder: f.placeholder,\n      step: f.step,\n      min: f.min,\n      required: f.required,\n      autocomplete: 'off',\n    });\n    inputs[f.name] = { input: input, f: f };\n    return el('label', { class: f.wide ? 'wide' : null }, f.label, input);\n  });\n  const submit = el('button', { type: 'submit', class: 'primary', text: 'Create' });\n  const cancel = el('button', { type: 'button', class: 'ghost', text: 'Cancel', hidden: true, onclick: () => reset() });\n  const err = errLine();\n  const form = el('form', { class: 'form-grid' }, fieldNodes, el('div', { class: 'actions wide' }, cancel, submit), err);\n  const list = el('div');\n  root.replaceChildren(el('section', { class: 'card', 'aria-label': spec.title },\n    el('h2', { text: spec.title }), form, list));\n\n  function reset() {\n    editingId = null;\n    form.reset();\n    for (const k of Object.keys(inputs)) inputs[k].input.readOnly = false;\n    submit.textContent = 'Create';\n    cancel.hidden = true;\n    err.hidden = true;\n  }\n\n  function startEdit(it) {\n    editingId = String(it.id);\n    for (const k of Object.keys(inputs)) {\n      const v = it[k];\n      inputs[k].input.value = v === undefined || v === null ? '' : String(v);\n      if (inputs[k].f.key) inputs[k].input.readOnly = true;\n    }\n    submit.textContent = 'Save changes';\n    cancel.hidden = false;\n    const first = form.querySelector('input:not([readonly])');\n    if (first) first.focus();\n  }\n\n  function actions(it) {\n    return el('span', { class: 'row-actions' },\n      el('button', { type: 'button', class: 'ghost', text: 'Edit', onclick: () => startEdit(it) }),\n      dangerButton('Delete', async () => {\n        await api('DELETE', spec.path + '/' + enc(it.id));\n        notify(spec.noun + ' deleted', 'ok');\n        if (editingId === String(it.id)) reset();\n        await load();\n      }));\n  }\n\n  form.addEventListener('submit', (ev) => {\n    ev.preventDefault();\n    const body = {};\n    const editing = editingId;\n    runIn(form, err, async () => {\n      for (const k of Object.keys(inputs)) {\n        const raw = inputs[k].input.value.trim();\n        const f = inputs[k].f;\n        if (raw === '') { body[k] = null; continue; }\n        if (f.num) {\n          const n = Number(raw);\n          if (!Number.isFinite(n)) throw new Error(f.label + ' must be a number.');\n          body[k] = n;\n        } else {\n          body[k] = raw;\n        }\n      }\n      if (editing !== null) await api('PUT', spec.path + '/' + enc(editing), body);\n      else await api('POST', spec.path, body);\n      notify(spec.noun + (editing !== null ? ' saved' : ' created'), 'ok');\n      reset();\n      await load();\n    });\n  });\n\n  async function load() {\n    try {\n      const items = listOf(await api('GET', spec.path), spec.listKey);\n      if (!items.length) {\n        list.replaceChildren(el('p', { class: 'muted', text: 'Nothing here yet.' }));\n        return;\n      }\n      list.replaceChildren(table(\n        spec.columns.map((c) => c.label).concat(['']),\n        items.map((it) => spec.columns.map((c) => c.get(it)).concat([actions(it)]))));\n    } catch (e) {\n      list.replaceChildren(errP(e));\n    }\n  }\n\n  return { load: load };\n}\n\nasync function loadGovernance() {\n  if (!govCruds) {\n    const host = $('#gov-root');\n    govCruds = GOV_SPECS.map((spec) => {\n      const root = el('div', { class: 'gov-block' });\n      host.append(root);\n      return crud(root, spec);\n    });\n  }\n  await Promise.all(govCruds.map((c) => c.load()));\n}\n\non('#gv-refresh', 'click', () => loadGovernance());\n\n// ---- live feed (the /ws socket) ----\n\nfunction livePlaceholder() {\n  const body = $('#lv-body');\n  if (body.querySelector('tr.clickable')) return;\n  body.replaceChildren(el('tr', { class: 'placeholder' }, el('td', { colspan: String(LOG_COLS), text: live.want ? 'Waiting for requests.' : 'Open this page to start the live feed.' })));\n}\n\nfunction liveCount() {\n  const shown = $('#lv-body').querySelectorAll('tr.clickable').length;\n  $('#lv-count').textContent = shown + ' shown' + (live.paused && live.queue.length ? ', ' + live.queue.length + ' waiting' : '');\n}\n\nfunction paintLive() {\n  let text = 'Stopped';\n  let tone = '';\n  if (live.want) {\n    if (live.paused) { text = 'Paused'; tone = 'warn'; }\n    else if (live.connected) { text = 'Live'; tone = 'ok'; }\n    else { text = live.waitText || 'Connecting'; tone = 'warn'; }\n  }\n  setPill($('#lv-state'), text, tone);\n  $('#lv-pause').setAttribute('aria-pressed', String(live.paused));\n  $('#lv-pause').textContent = live.paused ? 'Resume' : 'Pause';\n}\n\nfunction addLiveRow(e) {\n  const body = $('#lv-body');\n  body.querySelectorAll('tr.placeholder').forEach((n) => n.remove());\n  body.prepend(logRow(e));\n  const rows = body.querySelectorAll('tr.clickable');\n  for (let i = LIVE_MAX; i < rows.length; i++) {\n    const next = rows[i].nextElementSibling;\n    if (next && next.classList.contains('detail')) next.remove();\n    rows[i].remove();\n  }\n  liveCount();\n}\n\nfunction onLiveMessage(text) {\n  let msg;\n  try { msg = JSON.parse(text); } catch (e) { return; }\n  if (!msg || msg.type !== 'log' || !msg.data) return;\n  if (live.paused) {\n    live.queue.push(msg.data);\n    if (live.queue.length > LIVE_MAX) live.queue.shift();\n    liveCount();\n    return;\n  }\n  addLiveRow(msg.data);\n}\n\nfunction liveRetry() {\n  if (!live.want) return;\n  const delay = Math.min(30000, 1000 * Math.pow(2, live.retry));\n  live.retry += 1;\n  live.waitText = 'Reconnecting in ' + Math.round(delay / 1000) + ' s';\n  paintLive();\n  clearTimeout(live.timer);\n  live.timer = setTimeout(() => { live.timer = -1; connectLive(); }, delay);\n}\n\nasync function connectLive() {\n  if (!live.want) return;\n  live.waitText = 'Connecting';\n  paintLive();\n  let ticket = '';\n  try {\n    const r = await api('POST', '/api/session/ws-ticket');\n    ticket = r && r.ticket ? String(r.ticket) : '';\n  } catch (e) {\n    $('#lv-note').textContent = 'Live feed: ' + e.message;\n    return liveRetry();\n  }\n  if (!live.want) return;\n  if (!ticket) return liveRetry();\n  const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';\n  let ws;\n  try {\n    ws = new WebSocket(proto + '//' + location.host + '/ws?ticket=' + enc(ticket));\n  } catch (e) {\n    $('#lv-note').textContent = 'Live feed: ' + e.message;\n    return liveRetry();\n  }\n  live.ws = ws;\n  ws.onopen = () => {\n    live.connected = true;\n    live.retry = 0;\n    live.waitText = '';\n    $('#lv-note').textContent = 'Newest first. The list keeps the latest 500 requests; requests made while the connection is down are not replayed.';\n    paintLive();\n  };\n  ws.onmessage = (ev) => onLiveMessage(String(ev.data));\n  ws.onclose = () => {\n    if (live.ws === ws) live.ws = null;\n    live.connected = false;\n    liveRetry();\n  };\n  ws.onerror = () => {};\n}\n\nfunction startLive() {\n  if (live.want) return;\n  live.want = true;\n  live.retry = 0;\n  livePlaceholder();\n  liveCount();\n  connectLive();\n}\n\nfunction stopLive() {\n  live.want = false;\n  live.connected = false;\n  clearTimeout(live.timer);\n  live.timer = -1;\n  if (live.ws) {\n    const ws = live.ws;\n    live.ws = null;\n    ws.onclose = null;\n    ws.close();\n  }\n  paintLive();\n}\n\non('#lv-pause', 'click', () => {\n  live.paused = !live.paused;\n  if (!live.paused) {\n    const waiting = live.queue;\n    live.queue = [];\n    for (const e of waiting) addLiveRow(e);\n  }\n  paintLive();\n  liveCount();\n});\non('#lv-clear', 'click', () => {\n  live.queue = [];\n  $('#lv-body').replaceChildren();\n  livePlaceholder();\n  liveCount();\n});\n\n// ---- logs ----\n\nfunction statusPill(s) {\n  if (s === undefined || s === null || s === '') return pill('—');\n  const bad = typeof s === 'string' ? s === 'error' : num(s) >= 400;\n  return pill(String(s), bad ? 'bad' : 'ok');\n}\n\nfunction logRow(e) {\n  let detail = null;\n  const toggle = (tr) => {\n    if (detail) {\n      detail.remove();\n      detail = null;\n      tr.setAttribute('aria-expanded', 'false');\n      return;\n    }\n    detail = el('tr', { class: 'detail' }, el('td', { colspan: String(LOG_COLS) }, el('p', { class: 'muted', text: 'Loading...' })));\n    tr.after(detail);\n    tr.setAttribute('aria-expanded', 'true');\n    fillLogDetail(detail.querySelector('td'), e);\n  };\n  const tr = el('tr', {\n    class: 'clickable',\n    tabindex: '0',\n    'aria-expanded': 'false',\n    onclick: () => toggle(tr),\n    onkeydown: (ev) => {\n      if (ev.key === 'Enter' || ev.key === ' ') {\n        ev.preventDefault();\n        toggle(tr);\n      }\n    },\n  },\n  el('td', { class: 'nowrap' }, fmtTime(e.ts)),\n  el('td', null, e.provider || '—'),\n  el('td', { class: 'mono' }, e.model || '—'),\n  el('td', null, statusPill(e.status)),\n  el('td', null, fmtMs(e.latency_ms)),\n  el('td', null, fmtInt(e.prompt_tokens) + ' / ' + fmtInt(e.completion_tokens)),\n  el('td', null, fmtMoney(e.cost)),\n  el('td', null, e.cache_hit ? pill('hit', 'ok') : '—'),\n  el('td', { class: 'mono' }, e.virtual_key || '—'));\n  return tr;\n}\n\nfunction block(label, v) {\n  if (v === undefined || v === null || v === '') {\n    return el('p', { class: 'hint', text: label + ': not recorded' });\n  }\n  return el('div', null, el('h4', { text: label }), el('pre', { class: 'code', text: pretty(v) }));\n}\n\n// The detail of one log: the row's fields, then the bodies and raw payloads from GET /api/logs/{id}.\nasync function fillLogDetail(cell, e) {\n  let full = e;\n  let err = null;\n  try {\n    full = Object.assign({}, e, await api('GET', '/api/logs/' + enc(e.id)));\n  } catch (x) {\n    err = x;\n  }\n  const pairs = [\n    ['Request ID', full.request_id],\n    ['Operation', full.op],\n    ['Status', full.status],\n    ['Virtual key', full.virtual_key],\n    ['Team', full.team_id],\n    ['Customer', full.customer_id],\n    ['MCP server', full.server],\n    ['MCP tool', full.tool],\n    ['Error', full.error],\n  ].filter((p) => p[1] !== undefined && p[1] !== null && p[1] !== '');\n  const meta = el('dl', { class: 'meta' });\n  for (const p of pairs) meta.append(el('dt', { text: p[0] }), el('dd', { text: String(p[1]) }));\n  const parts = [err ? errP(err) : null, meta, block('Request', full.input), block('Response', full.output)];\n  if (full.raw_request !== undefined && full.raw_request !== '') parts.push(block('Raw request', full.raw_request));\n  if (full.raw_response !== undefined && full.raw_response !== '') parts.push(block('Raw response', full.raw_response));\n  cell.replaceChildren(...parts.filter(Boolean));\n}\n\nfunction fillDatalist(dl, names) {\n  dl.replaceChildren(...names.map((n) => el('option', { value: n })));\n}\n\nasync function loadLogFilters() {\n  const form = $('#lg-filter');\n  let f = {};\n  try {\n    f = (await api('GET', '/api/logs/filterdata')) || {};\n  } catch (e) {\n    return;\n  }\n  fillDatalist($('#lg-providers'), listOf(f, 'providers'));\n  fillDatalist($('#lg-models'), listOf(f, 'models'));\n  const sel = fld(form, 'virtual_key');\n  const keep = sel.value;\n  sel.replaceChildren(el('option', { value: '', text: 'Any' }));\n  for (const v of listOf(f, 'virtual_keys')) {\n    sel.append(el('option', { value: v.id, text: v.name ? v.name + ' (' + v.id + ')' : String(v.id) }));\n  }\n  sel.value = keep;\n}\n\nfunction syncPeriod() {\n  const custom = fld($('#lg-filter'), 'period').value === 'custom';\n  $('#lg-from-wrap').hidden = !custom;\n  $('#lg-to-wrap').hidden = !custom;\n}\n\nasync function loadLogs() {\n  const form = $('#lg-filter');\n  const q = new URLSearchParams();\n  for (const k of ['provider', 'model', 'status', 'virtual_key', 'text']) {\n    const v = fld(form, k).value.trim();\n    if (v) q.set(k, v);\n  }\n  const period = fld(form, 'period').value;\n  if (period === 'custom') {\n    const from = new Date(fld(form, 'from').value).getTime();\n    const to = new Date(fld(form, 'to').value).getTime();\n    if (Number.isFinite(from)) q.set('since', String(from));\n    if (Number.isFinite(to)) q.set('until', String(to));\n  } else if (PERIOD_MS[period]) {\n    q.set('since', String(Date.now() - PERIOD_MS[period]));\n  }\n  q.set('limit', String(PAGE_SIZE));\n  q.set('offset', String(logState.offset));\n  const body = $('#lg-body');\n  try {\n    const data = await api('GET', '/api/logs?' + q.toString());\n    const entries = listOf(data, 'entries');\n    const total = data && Number.isFinite(data.total) ? data.total : null;\n    if (!entries.length) {\n      body.replaceChildren(el('tr', { class: 'placeholder' }, el('td', { colspan: String(LOG_COLS), text: logState.offset ? 'No more entries.' : 'No matching entries.' })));\n    } else {\n      body.replaceChildren(...entries.map(logRow));\n    }\n    const from = entries.length ? logState.offset + 1 : 0;\n    const to = logState.offset + entries.length;\n    $('#lg-range').textContent = total === null\n      ? from + '–' + to\n      : (total ? from + '–' + to + ' of ' + fmtInt(total) : 'no entries');\n    $('#lg-prev').disabled = logState.offset === 0;\n    $('#lg-next').disabled = total !== null ? to >= total : entries.length < PAGE_SIZE;\n  } catch (e) {\n    body.replaceChildren(el('tr', null, el('td', { colspan: String(LOG_COLS) }, errP(e))));\n    $('#lg-range').textContent = '';\n  }\n}\n\non('#lg-filter', 'submit', (ev) => {\n  ev.preventDefault();\n  logState.offset = 0;\n  loadLogs();\n});\non('#lg-filter', 'change', (ev) => {\n  if (ev.target && ev.target.name === 'period') syncPeriod();\n});\non('#lg-clear', 'click', () => {\n  $('#lg-filter').reset();\n  syncPeriod();\n  logState.offset = 0;\n  loadLogs();\n});\non('#lg-prev', 'click', () => {\n  logState.offset = Math.max(0, logState.offset - PAGE_SIZE);\n  loadLogs();\n});\non('#lg-next', 'click', () => {\n  logState.offset += PAGE_SIZE;\n  loadLogs();\n});\n\n// ---- MCP clients ----\n\nfunction headersOf(text) {\n  const out = {};\n  for (const line of String(text || '').split('\\n')) {\n    if (line.trim() === '') continue;\n    const i = line.indexOf(':');\n    const k = i > 0 ? line.slice(0, i).trim() : '';\n    if (k === '') throw new Error('Each header line must read Name: value. Check: ' + line.trim());\n    out[k] = line.slice(i + 1).trim();\n  }\n  return out;\n}\n\n// A client's stored config without its id, ready for PUT (masked secrets go back unchanged).\nfunction clientBody(c) {\n  const b = Object.assign({}, c);\n  delete b.client_id;\n  return b;\n}\n\nasync function loadMcp() {\n  const box = $('#mcp-list');\n  try {\n    const [cfg, st] = await Promise.all([api('GET', '/api/mcp/clients'), settle(api('GET', '/api/mcp'))]);\n    const clients = listOf(cfg, 'clients');\n    state.opts.mcp = clients;\n    const byName = {};\n    if (st.ok) for (const s of listOf(st.value, 'clients')) byName[s.name] = s;\n    renderMcp(box, clients, byName);\n  } catch (e) {\n    box.replaceChildren(errP(e));\n  }\n}\n\nfunction renderMcp(box, clients, byName) {\n  if (!clients.length) {\n    return box.replaceChildren(el('p', { class: 'card muted', text: 'No MCP clients yet. Add one above.' }));\n  }\n  box.replaceChildren(...clients.map((c) => mcpCard(c, byName[c.name] || {})));\n}\n\n// Turns one tool on or off: the tool goes in or out of tools_to_skip, and of tools_to_execute when that\n// list is set.\nasync function setToolAllowed(c, tool, allow) {\n  const body = clientBody(c);\n  body.tools_to_skip = (c.tools_to_skip || []).filter((x) => x !== tool).concat(allow ? [] : [tool]);\n  const exec = c.tools_to_execute || [];\n  if (exec.length && exec.indexOf('*') < 0) {\n    body.tools_to_execute = exec.filter((x) => x !== tool).concat(allow ? [tool] : []);\n  }\n  await api('PUT', '/api/mcp/client/' + enc(c.name), body);\n  notify(tool + (allow ? ' enabled' : ' disabled'), 'ok');\n  await loadMcp();\n}\n\nfunction mcpCard(c, st) {\n  const tools = st.tools_list || [];\n  const status = c.disabled ? 'disabled' : (st.connected ? 'connected' : 'down');\n  const tone = c.disabled ? '' : (st.connected ? 'ok' : 'bad');\n  const where = c.connection_string || (c.stdio_config && c.stdio_config.command) || '';\n  return el('article', { class: 'card', 'aria-label': 'MCP client ' + c.name },\n    el('header', { class: 'toolbar', style: 'margin-bottom:8px' },\n      el('h3', { text: c.name }),\n      pill(c.connection_type || 'http'),\n      pill(status, tone),\n      el('span', { class: 'hint mono grow', text: where }),\n      el('span', { class: 'row-actions' },\n        el('button', { type: 'button', class: 'ghost', text: 'Edit', onclick: () => openMcpForm(c) }),\n        el('button', {\n          type: 'button',\n          class: 'ghost',\n          text: 'Reconnect',\n          onclick: (ev) => run(ev.currentTarget.closest('article'), async () => {\n            await api('POST', '/api/mcp/client/' + enc(c.name) + '/reconnect');\n            notify('Reconnecting ' + c.name, 'ok');\n            await loadMcp();\n          }),\n        }),\n        dangerButton('Delete', async () => {\n          await api('DELETE', '/api/mcp/client/' + enc(c.name));\n          notify('MCP client deleted', 'ok');\n          await loadMcp();\n        }))),\n    st.error && !st.connected && !c.disabled ? el('p', { class: 'error', text: st.error }) : null,\n    el('h4', { text: 'Tools' + (tools.length ? ' (' + tools.length + ')' : '') }),\n    tools.length\n      ? el('div', { class: 'tool-chips' }, tools.map((t) => el('button', {\n        type: 'button',\n        class: 'toggle mono',\n        'aria-pressed': String(!!t.allowed),\n        title: t.allowed ? 'Enabled. Select to disable.' : 'Disabled. Select to enable.',\n        text: t.name,\n        onclick: (ev) => run(ev.currentTarget.closest('article'), () => setToolAllowed(c, t.name, !t.allowed)),\n      })))\n      : el('p', { class: 'hint', text: c.disabled ? 'The client is disabled.' : 'No tools listed yet. Tools appear once the client connects.' }));\n}\n\nfunction openMcpForm(c) {\n  const form = $('#mcp-form');\n  mcpForm.editing = c || null;\n  form.reset();\n  const nameIn = fld(form, 'name');\n  nameIn.value = c ? c.name : '';\n  nameIn.readOnly = !!c;\n  fld(form, 'connection_type').value = c ? (c.connection_type || 'http') : 'http';\n  fld(form, 'connection_string').value = c ? (c.connection_string || '') : '';\n  fld(form, 'command').value = c && c.stdio_config ? (c.stdio_config.command || '') : '';\n  fld(form, 'args').value = c && c.stdio_config ? (c.stdio_config.args || []).join(', ') : '';\n  fld(form, 'headers').value = c && c.headers ? Object.keys(c.headers).map((k) => k + ': ' + c.headers[k]).join('\\n') : '';\n  fld(form, 'disabled').checked = !!(c && c.disabled);\n  $('#mcp-form-title').textContent = c ? 'Edit ' + c.name : 'Add MCP client';\n  $('#mcp-save').textContent = c ? 'Save changes' : 'Add client';\n  $('#mcp-error').hidden = true;\n  form.hidden = false;\n  if (form.scrollIntoView) form.scrollIntoView({ block: 'start' });\n  nameIn.focus();\n}\n\nfunction closeMcpForm() {\n  mcpForm.editing = null;\n  $('#mcp-form').hidden = true;\n}\n\non('#mcp-new', 'click', () => openMcpForm(null));\non('#mcp-cancel', 'click', () => closeMcpForm());\non('#mcp-refresh', 'click', () => loadMcp());\n\non('#mcp-form', 'submit', (ev) => {\n  ev.preventDefault();\n  const form = $('#mcp-form');\n  const current = mcpForm.editing;\n  runIn(form, $('#mcp-error'), async () => {\n    const type = fld(form, 'connection_type').value;\n    const prevStdio = (current && current.stdio_config) || {};\n    const body = Object.assign(current ? clientBody(current) : {}, {\n      name: fld(form, 'name').value.trim(),\n      connection_type: type,\n      connection_string: type === 'stdio' ? undefined : (fld(form, 'connection_string').value.trim() || undefined),\n      stdio_config: type === 'stdio'\n        ? Object.assign({}, prevStdio, { command: fld(form, 'command').value.trim(), args: splitList(fld(form, 'args').value) })\n        : undefined,\n      headers: headersOf(fld(form, 'headers').value),\n      disabled: fld(form, 'disabled').checked,\n    });\n    if (current) await api('PUT', '/api/mcp/client/' + enc(current.name), body);\n    else await api('POST', '/api/mcp/client', body);\n    notify(current ? 'MCP client saved' : 'MCP client added', 'ok');\n    closeMcpForm();\n    await loadMcp();\n  });\n});\n\n// ---- configuration ----\n\n// The settings the editor shows, in the shape PUT /api/config takes.\nfunction editableConfig(full) {\n  const client = full.client || {};\n  const out = { client_config: client };\n  const ps = full.pricing_sync;\n  if (ps && (ps.url || ps.interval_seconds)) {\n    out.framework_config = { pricing_url: ps.url || '' };\n    if (ps.interval_seconds > 0) out.framework_config.pricing_sync_interval = ps.interval_seconds;\n  }\n  const au = full.governance && full.governance.auth_config;\n  if (au && au.username) {\n    out.auth_config = {\n      admin_username: au.username,\n      admin_password: '<redacted>',\n      disable_auth_on_inference: client.enforce_auth_on_inference === false,\n    };\n  }\n  return out;\n}\n\nasync function loadConfig() {\n  const errBox = $('#cfg-error');\n  errBox.hidden = true;\n  try {\n    const cfg = (await api('GET', '/api/config')) || {};\n    $('#cfg-full').textContent = pretty(cfg);\n    $('#cfg-json').value = JSON.stringify(editableConfig(cfg), null, 2);\n    cfgEditorDirty = false;\n  } catch (e) {\n    $('#cfg-full').textContent = e.message;\n    errBox.textContent = e.message;\n    errBox.hidden = false;\n  }\n}\n\non('#cfg-refresh', 'click', () => loadConfig());\non('#cfg-discard', 'click', () => loadConfig());\non('#cfg-json', 'input', () => { cfgEditorDirty = true; });\non('#cfg-save', 'click', () => {\n  const errBox = $('#cfg-error');\n  runIn($('#cfg-box'), errBox, async () => {\n    let body;\n    try {\n      body = JSON.parse($('#cfg-json').value);\n    } catch (e) {\n      throw new Error('The settings are not valid JSON: ' + e.message);\n    }\n    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error('The settings must be a JSON object.');\n    const send = {};\n    for (const k of ['client_config', 'client', 'framework_config', 'auth_config']) {\n      if (body[k] !== undefined) send[k] = body[k];\n    }\n    if (!Object.keys(send).length) throw new Error('Nothing to save: the object needs client_config, framework_config or auth_config.');\n    await api('PUT', '/api/config', send);\n    notify('Configuration saved', 'ok');\n    await loadConfig();\n  });\n});\n\n// ---- playground ----\n\nfunction playgroundVk() {\n  return fld($('#pg-form'), 'vk').value.trim();\n}\n\nasync function loadModels() {\n  const msg = $('#pg-models-msg');\n  const vk = playgroundVk();\n  try {\n    const body = await api('GET', '/v1/models', undefined, {\n      auth: false,\n      headers: vk ? { 'x-bf-vk': vk } : {},\n    });\n    const ids = listOf(body, 'data').map((m) => m && m.id).filter(Boolean);\n    $('#pg-models').replaceChildren(...ids.map((id) => el('option', { value: id })));\n    state.modelsLoaded = true;\n    msg.textContent = ids.length ? ids.length + ' models available.' : 'The gateway returned no models.';\n  } catch (e) {\n    msg.textContent = 'Could not load models: ' + e.message;\n  }\n}\n\nfunction chatResult(body, ms) {\n  const choice = listOf(body, 'choices')[0] || {};\n  const text = contentText(choice.message && choice.message.content) || choice.text || '';\n  const usage = (body && body.usage) || {};\n  return el('div', null,\n    el('div', { class: 'chat-meta muted' },\n      Math.round(ms) + ' ms',\n      ' · ',\n      fmtInt(usage.prompt_tokens) + ' in / ' + fmtInt(usage.completion_tokens) + ' out tokens',\n      body && body.model ? ' · ' + body.model : ''),\n    el('pre', { class: 'reply', text: text || '(empty reply)' }),\n    el('details', { style: 'margin-top:10px' },\n      el('summary', { text: 'Raw response' }),\n      el('pre', { class: 'code', text: pretty(body) })));\n}\n\nasync function sendChat(form) {\n  const model = fld(form, 'model').value.trim();\n  const message = fld(form, 'message').value.trim();\n  const vk = playgroundVk();\n  const out = $('#pg-result');\n  if (!model || !message) return notify('Choose a model and enter a message.', 'error');\n  out.replaceChildren(el('p', { class: 'muted', role: 'status', text: 'Sending...' }));\n  const t0 = performance.now();\n  await run(form, async () => {\n    try {\n      const body = await api('POST', '/v1/chat/completions',\n        { model: model, messages: [{ role: 'user', content: message }] },\n        { auth: false, headers: vk ? { 'x-bf-vk': vk } : {} });\n      out.replaceChildren(chatResult(body, performance.now() - t0));\n    } catch (e) {\n      out.replaceChildren(el('p', { class: 'error', role: 'alert', text: e.message }));\n    }\n  });\n}\n\non('#pg-form', 'submit', (ev) => {\n  ev.preventDefault();\n  sendChat($('#pg-form'));\n});\non('#pg-load', 'click', () => loadModels());\nfld($('#pg-form'), 'message').addEventListener('keydown', (ev) => {\n  if (ev.key === 'Enter' && (ev.ctrlKey || ev.metaKey)) {\n    ev.preventDefault();\n    $('#pg-form').requestSubmit();\n  }\n});\n\n// ---- overview wiring, metrics, routing ----\n\non('#ov-refresh', 'click', () => loadOverview());\n$('#ov-metrics-box').addEventListener('toggle', async (ev) => {\n  if (!ev.currentTarget.open) return;\n  const pre = $('#ov-metrics');\n  try {\n    const r = await send('GET', '/metrics');\n    pre.textContent = r.text || '(no metrics)';\n  } catch (e) {\n    pre.textContent = e.message;\n  }\n});\n\nconst loaders = {\n  overview: () => { loadOverview(); },\n  live: () => { startLive(); },\n  providers: () => { loadProviders(); },\n  keys: () => { loadKeys(); },\n  governance: () => { loadGovernance(); },\n  logs: () => { loadLogFilters(); loadLogs(); },\n  mcp: () => { loadMcp(); },\n  config: () => { loadConfig(); },\n  playground: () => { if (!state.modelsLoaded) loadModels(); },\n};\n\nlet current = 'overview';\n\nfunction currentView() {\n  const h = location.hash.replace(/^#/, '');\n  return VIEWS.indexOf(h) >= 0 ? h : 'overview';\n}\n\nfunction route() {\n  const next = currentView();\n  // the socket is open only while the live view is shown\n  if (current === 'live' && next !== 'live') stopLive();\n  current = next;\n  for (const s of $$('[data-view]')) s.hidden = s.getAttribute('data-view') !== current;\n  for (const a of $$('[data-nav]')) {\n    if (a.getAttribute('data-nav') === current) a.setAttribute('aria-current', 'page');\n    else a.removeAttribute('aria-current');\n  }\n  loaders[current]();\n}\n\nwindow.addEventListener('hashchange', route);\nwindow.addEventListener('pagehide', () => stopLive());\n\n// Keep the overview fresh every 10 s, but only while the tab is visible.\nsetInterval(() => {\n  if (document.hidden) return;\n  checkHealth();\n  if (current === 'overview') loadOverview();\n}, 10000);\ndocument.addEventListener('visibilitychange', () => {\n  if (!document.hidden) {\n    checkHealth();\n    if (current === 'overview') loadOverview();\n  }\n});\n\nsetToken(adminToken);\ncheckHealth();\nroute();\n</script>\n</body>\n</html>\n"
