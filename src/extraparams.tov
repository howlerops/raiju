// x-bf-passthrough-extra-params: true. Provider fields that no route schema knows travel in the body's
// "extra_params" object; with the header they are merged into the request (Bifrost's MergeExtraParamsIntoJSON
// in core/providers/utils): a key the body already has is overwritten where it stands, an object meeting an
// object is merged key by key, and new keys go at the end in sorted order. Without the header the object is
// left as it is, as Bifrost leaves it.
// Bifrost merges the extras into the provider's own body. So that a provider whose format differs (Anthropic, Gemini,
// Bedrock, Cohere, ...) gets them too, the object also rides with the request (EXTRA_PARAMS_CARRY, base64 JSON) and is
// merged into each upstream body once it is built (mergeIntoUpstream); for a provider the body passes through to,
// that second merge changes nothing.
import { Field, fields, find, build, setField, without } from "./json"
import { encode, decode } from "./base64"
import { utf8 } from "./crypto"

// The header that turns the merge on (its value must be exactly "true").
export const EXTRA_PARAMS_HEADER = "x-bf-passthrough-extra-params"

// The internal header that carries the extra_params object to the upstream body builder.
export const EXTRA_PARAMS_CARRY = "x-raiju-extra-params"

function isObject(raw: string): bool {
  return raw.trim().startsWith("{")
}

// The members of `base` with those of `extra` merged in.
export function mergeFields(base: Field[], extra: Field[]): Field[] throws SyntaxError {
  let out = base.slice()
  const added: Field[] = []
  for (const f of extra) {
    const cur = find(out, f.key)
    if (cur === undefined) {
      added.push(f)
    } else if (isObject(cur) && isObject(f.raw)) {
      setField(&out, f.key, build(try mergeFields(try fields(cur), try fields(f.raw))))
    } else {
      setField(&out, f.key, f.raw)
    }
  }
  added.sort((a: Field, b: Field): int => a.key < b.key ? -1 : (a.key > b.key ? 1 : 0))
  for (const f of added) out.push(f)
  return out
}

// The request body with its extra_params object merged in and removed; the text as it was when it is no JSON
// object or has no extra_params object.
export function mergeExtraParams(text: string): string {
  try {
    const fs = fields(text)
    const ep = find(fs, "extra_params")
    if (ep === undefined || !isObject(ep)) return text
    return build(try mergeFields(without(fs, ["extra_params"]), try fields(ep)))
  } catch (e) {
    return text
  }
}

// The body's extra_params object as the carry header's value (base64 of its JSON); undefined when there is none.
export function extraParamsCarry(text: string): string | undefined {
  try {
    const ep = find(fields(text), "extra_params")
    if (ep === undefined || !isObject(ep)) return undefined
    return encode(utf8(build(fields(ep))))
  } catch (e) {
    return undefined
  }
}

// An upstream request body with the carried extras merged in, as Bifrost merges them into the provider's body; the
// body as it was when it is no JSON object or the carry cannot be read.
export function mergeIntoUpstream(body: string, carry: string): string {
  if (!body.trim().startsWith("{")) return body
  try {
    const extra = fields(new TextDecoder().decode(decode(carry)))
    return build(mergeFields(fields(body), extra))
  } catch (e) {
    return body
  }
}

test("the carried extras merge into a converted provider body, and again into a merged one without change", () => {
  const carry = extraParamsCarry(`{"model":"m","extra_params":{"top_k":5,"metadata":{"b":2}}}`)!
  const anthropic = `{"model":"claude","messages":[],"max_tokens":9,"metadata":{"a":1}}`
  expect(mergeIntoUpstream(anthropic, carry)).toBe(`{"model":"claude","messages":[],"max_tokens":9,"metadata":{"a":1,"b":2},"top_k":5}`)
  const merged = mergeExtraParams(`{"model":"m","metadata":{"a":1},"extra_params":{"top_k":5,"metadata":{"b":2}}}`)
  expect(mergeIntoUpstream(merged, carry)).toBe(merged)
  expect(mergeIntoUpstream("", carry)).toBe("")
  expect(mergeIntoUpstream(`{"a":1}`, "%%%")).toBe(`{"a":1}`)
  expect(extraParamsCarry(`{"model":"m"}`)).toBeUndefined()
})

test("extra_params members are merged into the body", () => {
  expect(mergeExtraParams(`{"model":"m","extra_params":{"top_k":5,"guardrailConfig":{"id":"g"}},"input":"x"}`)).toBe(`{"model":"m","input":"x","guardrailConfig":{"id":"g"},"top_k":5}`)
})

test("an existing key is overwritten in place, and objects merge", () => {
  const got = mergeExtraParams(`{"model":"m","temperature":1,"metadata":{"a":1,"b":{"c":1}},"extra_params":{"temperature":0.2,"metadata":{"b":{"d":2},"e":3}}}`)
  expect(got).toBe(`{"model":"m","temperature":0.2,"metadata":{"a":1,"b":{"c":1,"d":2},"e":3}}`)
})

test("a body without an extra_params object is left as it is", () => {
  expect(mergeExtraParams(`{"model":"m"}`)).toBe(`{"model":"m"}`)
  expect(mergeExtraParams(`{"model":"m","extra_params":[1]}`)).toBe(`{"model":"m","extra_params":[1]}`)
  expect(mergeExtraParams(`not json`)).toBe(`not json`)
})
