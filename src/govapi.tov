// Management API logic that needs no store: the RBAC listings, budget overrides, the expired-key
// cleanup, routing rule checks and the complexity analyzer config. store.tov and ops.tov route to these.
import { AccessProfile, AdminUserConfig, BudgetOverride, ClientConfig, ComplexitySettings, GovernanceConfig, PermissionPair, ProfileRole, RoleConfig, VirtualKeyConfig } from "./config"
import { RoutingRule, compile } from "./cel"
import { fields, Field, find, rawStr } from "./json"
import { rfc3339Ms } from "./vkexpiry"
import { anyRoleId, builtinRoleId, builtinPairs, customRole, isBuiltinRole, roleIdOf, withRoleIds } from "./rbac"

// ---- RBAC listings ----

// A (resource, operation) pair with its id. Ids number the pairs resource-major from 1, so they
// hold for as long as the resource and operation lists keep their order (Bifrost's permission_ids).
export type PermissionDoc = { id: int, resource: string, operation: string }

export function permissionDocs(resources: string[], operations: string[]): PermissionDoc[] {
  const out: PermissionDoc[] = []
  let id = 0
  for (const r of resources) {
    for (const op of operations) {
      id += 1
      out.push({ id: id, resource: r, operation: op })
    }
  }
  return out
}

// The pair an id names, or undefined when no pair has it.
export function pairOfId(resources: string[], operations: string[], id: int): PermissionPair | undefined {
  if (id < 1) return undefined
  const n = operations.length
  if (n === 0) return undefined
  const ri = Math.floor((id - 1) / n)
  const oi = (id - 1) % n
  const r = resources[ri]
  const op = operations[oi]
  if (r === undefined || op === undefined) return undefined
  return { resource: r, operation: op }
}

// The ids of a role's pairs, in the catalog's order.
export function permissionIds(resources: string[], operations: string[], pairs: PermissionPair[]): int[] {
  const out: int[] = []
  for (const d of permissionDocs(resources, operations)) {
    if (pairs.some((p) => p.resource === d.resource && p.operation === d.operation)) out.push(d.id)
  }
  return out
}

// The (resource, operation) pairs a role holds: a built-in role's fixed rules as pairs, a custom role's own.
export function rolePairs(roles: RoleConfig[] | undefined, role: string, resources: string[], operations: string[]): PermissionPair[] {
  if (isBuiltinRole(role) && customRole(roles, role) === undefined) return builtinPairs(role, resources, operations)
  return customRole(roles, role)?.permissions ?? []
}

// Bifrost's PermissionsResponse: every resource with every operation, true where the pairs hold it.
export function permissionMap(pairs: PermissionPair[], resources: string[], operations: string[]): string {
  const rs: string[] = []
  for (const r of resources) {
    const ops: string[] = []
    for (const op of operations) {
      const held = pairs.some((p) => p.resource === r && p.operation === op)
      ops.push(`${JSON.stringify(op)}:${held ? "true" : "false"}`)
    }
    rs.push(`${JSON.stringify(r)}:{${ops.join(",")}}`)
  }
  return `{"permissions":{${rs.join(",")}}}`
}

// ---- users by email ----

// A user in Bifrost's UserObject shape: the name is the id, the role a {id, name, is_system_role} object
// beside role_id, and the access profiles the user holds (heldProfiles order).
export function userObjectJson(u: AdminUserConfig, users: AdminUserConfig[] | undefined, roles: RoleConfig[] | undefined, profiles: AccessProfile[] | undefined): string {
  const rid = anyRoleId(roles, u.role)
  const system = builtinRoleId(u.role) !== undefined
  const role: string[] = []
  if (rid !== undefined) role.push(`"id":${rid}`)
  role.push(`"name":${JSON.stringify(u.role)}`)
  const desc = customRole(roles, u.role)?.description
  if (desc !== undefined) role.push(`"description":${JSON.stringify(desc)}`)
  role.push(`"is_system_role":${system ? "true" : "false"}`)
  const held: string[] = []
  for (const p of heldProfiles(users, roles, profiles, u.name)) held.push(`{"id":${JSON.stringify(p.id)},"name":${JSON.stringify(p.name ?? p.id)}}`)
  const ridText = rid === undefined ? "null" : `${rid}`
  const parts: string[] = [
    `"id":${JSON.stringify(u.name)}`,
    `"name":${JSON.stringify(u.name)}`,
    `"email":${JSON.stringify(emailOf(u))}`,
    `"role_id":${ridText}`,
    `"role":{${role.join(",")}}`,
    `"disabled":${u.disabled === true ? "true" : "false"}`,
    `"teams":${JSON.stringify((u.teams ?? []).map((t) => ({ id: t })))}`,
    `"business_units":${JSON.stringify((u.business_units ?? []).map((b) => ({ id: b })))}`,
    `"access_profiles":[${held.join(",")}]`,
  ]
  return "{" + parts.join(",") + "}"
}

// A user's email: the one set on the user, else the name when it is an address (a sign-in identity), else "".
export function emailOf(u: AdminUserConfig): string {
  const e = u.email
  if (e !== undefined) return e
  return u.name.includes("@") ? u.name : ""
}

// Bifrost's UserVirtualKeyLookupResponse: the virtual keys assigned to the user (their user_id), with values.
export function userKeysJson(u: AdminUserConfig, vks: VirtualKeyConfig[] | undefined): string {
  const keys: string[] = []
  for (const vk of vks ?? []) {
    if ((vk.user_id ?? "") !== u.name) continue
    keys.push(`{"id":${JSON.stringify(vk.id)},"name":${JSON.stringify(vk.name ?? vk.id)},"value":${JSON.stringify(vk.value)},"is_active":${vk.is_active !== false ? "true" : "false"}}`)
  }
  return `{"user_id":${JSON.stringify(u.name)},"email":${JSON.stringify(emailOf(u))},"virtual_keys":[${keys.join(",")}]}`
}

// ---- budget overrides ----

export type OverrideResult = { kind: "ok", override: BudgetOverride } | { kind: "error", message: string }

// Reads a PUT .../override body: {"amount": n, "mode": "forever"} or {"amount": n, "mode": "cycles",
// "cycles": k}. A cycles override adds amount to the limit for k reset windows, the current one
// counted as the first (Bifrost's cycles); k defaults to 1.
export function parseOverride(body: string): OverrideResult {
  let fs: Field[] = []
  try {
    fs = fields(body)
  } catch (e) {
    return { kind: "error", message: "invalid request body" }
  }
  const amount = find(fs, "amount") ?? ""
  const n = parseFloat(amount)
  if (n === undefined || n <= 0.0) return { kind: "error", message: "amount must be a positive number" }
  const mode = find(fs, "mode") ?? ""
  if (mode === "\"forever\"") return { kind: "ok", override: { amount: n, mode: "forever" } }
  if (mode !== "\"cycles\"") return { kind: "error", message: "mode must be forever or cycles" }
  const k = parseInt(find(fs, "cycles") ?? "1") ?? 0
  if (k < 1 || k > 1000) return { kind: "error", message: "cycles must be a whole number from 1 to 1000" }
  return { kind: "ok", override: { amount: n, mode: "cycles", cycles: k } }
}

// The budgets a virtual key draws on: its own budget and the ones on its provider configs.
export function keyBudgetIds(vk: VirtualKeyConfig): string[] {
  const out: string[] = []
  if (vk.budget_id !== undefined) out.push(vk.budget_id)
  for (const pc of vk.provider_configs ?? []) {
    const b = pc.budget_id
    if (b !== undefined && !out.includes(b)) out.push(b)
  }
  return out
}

// ---- expired virtual keys ----

// The keys the cleanup deletes now: expired ones that opted in, by delete_after_expire or, when that
// is unset, client.delete_expired_virtual_keys.
export function expiredToDelete(g: GovernanceConfig | undefined, c: ClientConfig | undefined, nowMs: number): string[] {
  const out: string[] = []
  const inherit = c?.delete_expired_virtual_keys === true
  for (const vk of g?.virtual_keys ?? []) {
    const at = rfc3339Ms(vk.expires_at ?? "")
    if (at === undefined || at > nowMs) continue
    const opted = vk.delete_after_expire ?? inherit
    if (opted) out.push(vk.id)
  }
  return out
}

// ---- routing rules ----

const RULE_SCOPES = ["global", "virtual_key", "team", "customer"]

// "" when a routing rule is usable, else what is wrong with it. The expression must compile as CEL.
export function ruleError(r: RoutingRule): string {
  if (r.id === "") return "id is required"
  if (r.cel_expression.trim() === "") return "cel_expression is required"
  try {
    compile(r.cel_expression)
  } catch (e) {
    return `cel_expression does not compile: ${e.message}`
  }
  if (r.targets.length === 0) return "at least one target is required"
  for (const t of r.targets) {
    if (t.provider === "") return "every target needs a provider"
  }
  const s = r.scope
  if (s !== undefined && !RULE_SCOPES.includes(s)) return `scope must be one of ${RULE_SCOPES.join(", ")}`
  if (s !== undefined && s !== "global" && (r.scope_id ?? "") === "") return `scope ${s} needs scope_id`
  return ""
}

// ---- complexity analyzer config ----

// "" when the body is a complexity analyzer config this module accepts, else what is wrong with it.
export function complexityProblem(text: string): string {
  if (!text.trim().startsWith("{")) return "the body must be a JSON object"
  let fs: Field[] = []
  try {
    fs = fields(text)
  } catch (e) {
    return "the body must be a JSON object"
  }
  for (const f of fs) {
    const raw = f.raw
    if (f.key === "enabled") {
      if (raw !== "true" && raw !== "false") return "enabled must be true or false"
    } else if (f.key === "simple_max_score" || f.key === "complex_min_score") {
      if (parseFloat(raw) === undefined) return `${f.key} must be a number`
    } else if (f.key === "model" || f.key === "classifier") {
      if (!raw.startsWith("\"")) return `${f.key} must be a string`
    } else if (f.key === "tiers" || f.key === "decision" || f.key === "llm" || f.key === "semantic" || f.key === "session") {
      if (!raw.startsWith("{")) return `${f.key} must be an object`
    } else return `unknown complexity analyzer setting ${f.key}`
  }
  // Bifrost's checks on the semantic block's fallback and storage, and on the session block
  try {
    const sem = fields(find(fs, "semantic") ?? "{}")
    const fbRaw = find(sem, "fallback")
    if (fbRaw !== undefined) {
      const fb = (rawStr(sem, "fallback") ?? "?").trim().toLowerCase()
      if (fb !== "" && fb !== "none" && fb !== "llm" && fb !== "decision") return `semantic fallback must be "none", "llm", or "decision", got "${fb}"`
      if (fb === "llm" && rawStr(fields(find(fs, "llm") ?? "{}"), "model") === undefined) return `semantic fallback "llm" requires an llm config block`
    }
    const vs = find(sem, "vector_store")
    if (vs !== undefined) {
      const v = (rawStr(sem, "vector_store") ?? "?").trim().toLowerCase()
      if (v !== "" && v !== "embedded" && v !== "vector_store") return `semantic vector_store must be "embedded" or "vector_store", got "${v}"`
    }
    const cb = find(sem, "count_toward_budgets")
    if (cb !== undefined && cb !== "true" && cb !== "false") return "semantic count_toward_budgets must be true or false"
    const sess = find(fs, "session")
    if (sess !== undefined) {
      const sf = fields(sess)
      for (const k of sf) {
        if (k.key !== "enabled") return `unknown complexity session field "${k.key}"`
      }
      const en = find(sf, "enabled")
      if (en !== "true" && en !== "false") return "complexity session config requires enabled"
    }
  } catch (e) {
    return "the body must be a JSON object"
  }
  return ""
}

// The settings a complexity analyzer config body holds, as Raiju stores them.
export function complexityFrom(text: string): ComplexitySettings | undefined {
  try {
    return JSON.parse(text) as ComplexitySettings
  } catch (e) {
    return undefined
  }
}

// ---- user access profiles and virtual-key creation ----

function profileNamed(profiles: AccessProfile[] | undefined, id: string): AccessProfile | undefined {
  for (const p of profiles ?? []) {
    if (p.id === id) return p
  }
  return undefined
}

// GET /api/users/me/vk-creation-policy: the active access profile the caller holds that governs the
// keys it creates (the first one held, highest-ranked, as heldProfiles lists them). A caller with no
// stored user, or no active profile, gets {"has_access_profile": false}; creating a key stays allowed, ungoverned.
export function creationPolicy(users: AdminUserConfig[] | undefined, roles: RoleConfig[] | undefined, profiles: AccessProfile[] | undefined, actor: string): string {
  for (const p of heldProfiles(users, roles, profiles, actor)) {
    if (p.is_active !== false) return JSON.stringify({ has_access_profile: true, profile_name: p.name ?? p.id })
  }
  return JSON.stringify({ has_access_profile: false })
}

// ---- access profile propagation ----

// The fields a propagate call may push from a profile onto the keys that hold it.
export const PROPAGATED_FIELDS = ["provider_configs", "budgets", "rate_limit", "mcp_configs"]

// The keys after a propagate: each key that holds the profile takes the chosen fields from it. A field
// the profile leaves unset is not pushed. Budgets and rate limits are matched by id, so usage is kept.
export function propagateProfileKeys(vks: VirtualKeyConfig[], p: AccessProfile, chosen: string[]): { vks: VirtualKeyConfig[], updated: int } {
  const out: VirtualKeyConfig[] = []
  let updated = 0
  for (const vk of vks) {
    if (!(vk.access_profile_ids ?? []).includes(p.id)) {
      out.push(vk)
      continue
    }
    let nv = vk
    if (chosen.includes("provider_configs") && p.provider_configs !== undefined) nv.provider_configs = p.provider_configs
    if (chosen.includes("budgets") && p.budget_id !== undefined) nv.budget_id = p.budget_id
    if (chosen.includes("rate_limit") && p.rate_limit_id !== undefined) nv.rate_limit_id = p.rate_limit_id
    if (chosen.includes("mcp_configs") && p.mcp_configs !== undefined) nv.mcp_configs = p.mcp_configs
    out.push(nv)
    updated += 1
  }
  return { vks: out, updated: updated }
}

// The user with this name, or undefined.
function userNamed(users: AdminUserConfig[] | undefined, name: string): AdminUserConfig | undefined {
  for (const u of users ?? []) {
    if (u.name === name) return u
  }
  return undefined
}

// The ids of the access profiles a user holds, in rank order: those set on the user (access_profile_ids),
// then those attached to the user's role (the profile's roles; built-in roles have fixed ids). A profile is
// listed once, and an id that names no profile is skipped.
export function heldProfileIds(users: AdminUserConfig[] | undefined, roles: RoleConfig[] | undefined, profiles: AccessProfile[] | undefined, name: string): string[] {
  const out: string[] = []
  const u = userNamed(users, name)
  if (u === undefined) return out
  for (const id of u.access_profile_ids ?? []) {
    if (profileNamed(profiles, id) !== undefined && !out.includes(id)) out.push(id)
  }
  const rid = anyRoleId(roles, u.role)
  if (rid !== undefined) {
    const want: int = rid
    for (const p of profiles ?? []) {
      if (out.includes(p.id)) continue
      if ((p.roles ?? []).some((b) => b.role_id === want && bindingReaches(b, name))) out.push(p.id)
    }
  }
  return out
}

// Whether a role attachment reaches a user of that role: every user when it records no users, else the users
// it was applied to, and with is_default every user not in the role when it was attached.
export function bindingReaches(b: ProfileRole, name: string): bool {
  const users = b.users
  if (users === undefined) return true
  if (users.includes(name)) return true
  return b.is_default === true && !(b.except ?? []).includes(name)
}

// The attachment of roles to a profile (Bifrost's attach): the users of those roles now (holders) are given the
// profile with apply_to_existing; with is_default the role's later users get it too. A user who already held it
// through an earlier attachment of the same role keeps it.
export function attachBinding(roleId: int, isDefault: bool | undefined, apply: bool, holders: string[], prior: ProfileRole | undefined): ProfileRole {
  const users: string[] = []
  if (prior !== undefined) {
    for (const h of holders) {
      if (bindingReaches(prior, h)) users.push(h)
    }
  }
  if (apply) {
    for (const h of holders) {
      if (!users.includes(h)) users.push(h)
    }
  }
  const except: string[] = []
  for (const h of holders) {
    if (!users.includes(h)) except.push(h)
  }
  return { role_id: roleId, is_default: isDefault, users: users, except: except }
}

// The access profiles a user holds, in the order heldProfileIds gives, as the users API lists them.
export function heldProfiles(users: AdminUserConfig[] | undefined, roles: RoleConfig[] | undefined, profiles: AccessProfile[] | undefined, name: string): AccessProfile[] {
  const out: AccessProfile[] = []
  for (const id of heldProfileIds(users, roles, profiles, name)) {
    const p = profileNamed(profiles, id)
    if (p !== undefined) out.push(p)
  }
  return out
}

// ---- tests ----

test("permissionDocs numbers pairs resource-major from 1, and pairOfId reads them back", () => {
  const rs = ["Logs", "VirtualKeys"]
  const ops = ["View", "Create", "Update"]
  const docs = permissionDocs(rs, ops)
  expect(docs.length).toBe(6)
  expect(docs[0]!.id).toBe(1)
  expect(docs[5]!.resource).toBe("VirtualKeys")
  expect(docs[5]!.operation).toBe("Update")
  const p = pairOfId(rs, ops, 4)!
  expect(p.resource).toBe("VirtualKeys")
  expect(p.operation).toBe("View")
  expect(pairOfId(rs, ops, 7)).toBeUndefined()
  expect(pairOfId(rs, ops, 0)).toBeUndefined()
  expect(permissionIds(rs, ops, [{ resource: "VirtualKeys", operation: "Create" }, { resource: "Logs", operation: "View" }]).join(",")).toBe("1,5")
})

test("parseOverride keeps forever and cycles overrides and refuses the rest", () => {
  const ok = parseOverride(`{"amount": 25, "mode": "forever"}`)
  expect(ok.kind).toBe("ok")
  const cy = parseOverride(`{"amount": 40, "mode": "cycles", "cycles": 3}`)
  expect(cy.kind === "ok" && cy.override.cycles === 3).toBe(true)
  const cy1 = parseOverride(`{"amount": 40, "mode": "cycles"}`)
  expect(cy1.kind === "ok" && cy1.override.cycles === 1).toBe(true)
  expect(parseOverride(`{"amount": 40, "mode": "cycles", "cycles": 0}`).kind).toBe("error")
  const bad1 = parseOverride(`{"amount": 0, "mode": "forever"}`)
  expect(bad1.kind).toBe("error")
  const bad2 = parseOverride(`{"amount": 5, "mode": "weekly"}`)
  expect(bad2.kind).toBe("error")
  const bad3 = parseOverride(`{"amount": 5}`)
  expect(bad3.kind).toBe("error")
  const bad4 = parseOverride("not json")
  expect(bad4.kind).toBe("error")
})

test("expiredToDelete honours delete_after_expire and the client default", () => {
  const past = "2020-01-01T00:00:00Z"
  const future = "2099-01-01T00:00:00Z"
  const g: GovernanceConfig = { virtual_keys: [
    { id: "a", value: "v1", expires_at: past },
    { id: "b", value: "v2", expires_at: past, delete_after_expire: false },
    { id: "c", value: "v3", expires_at: past, delete_after_expire: true },
    { id: "d", value: "v4", expires_at: future, delete_after_expire: true },
    { id: "e", value: "v5" },
  ] }
  expect(expiredToDelete(g, undefined, Date.now()).join(",")).toBe("c")
  expect(expiredToDelete(g, { delete_expired_virtual_keys: true }, Date.now()).join(",")).toBe("a,c")
  expect(expiredToDelete(undefined, { delete_expired_virtual_keys: true }, Date.now()).length).toBe(0)
})

test("keyBudgetIds lists the key's budget and its provider budgets once each", () => {
  const vk: VirtualKeyConfig = { id: "k", value: "v", budget_id: "b1", provider_configs: [{ provider: "openai", budget_id: "b2" }, { provider: "anthropic", budget_id: "b1" }] }
  expect(keyBudgetIds(vk).join(",")).toBe("b1,b2")
})

test("ruleError accepts a usable rule and names what is wrong with the others", () => {
  const good: RoutingRule = { id: "r1", cel_expression: "request > 10", targets: [{ provider: "openai" }] }
  expect(ruleError(good)).toBe("")
  expect(ruleError({ id: "r1", cel_expression: "request >", targets: [{ provider: "openai" }] }) !== "").toBe(true)
  expect(ruleError({ id: "r1", cel_expression: "true", targets: [] })).toBe("at least one target is required")
  expect(ruleError({ id: "r1", cel_expression: "true", targets: [{ provider: "openai" }], scope: "team" })).toBe("scope team needs scope_id")
})

test("complexityProblem checks types and refuses unknown settings", () => {
  expect(complexityProblem(`{"enabled": true, "simple_max_score": 0.3, "complex_min_score": 0.7}`)).toBe("")
  expect(complexityProblem(`{"enabled": "yes"}`)).toBe("enabled must be true or false")
  expect(complexityProblem(`{"simple_max_score": "low"}`)).toBe("simple_max_score must be a number")
  expect(complexityProblem(`{"tiers": 3}`)).toBe("tiers must be an object")
  expect(complexityProblem(`{"colour": 1}`)).toBe("unknown complexity analyzer setting colour")
  expect(complexityProblem("[]")).toBe("the body must be a JSON object")
  // the semantic block's fallback, storage and budgets flag, and the session block, as Bifrost checks them
  expect(complexityProblem(`{"semantic": {"fallback": "llm", "vector_store": "vector_store", "count_toward_budgets": true}, "llm": {"model": "m"}, "session": {"enabled": true}}`)).toBe("")
  expect(complexityProblem(`{"semantic": {"fallback": "maybe"}}`)).toBe(`semantic fallback must be "none", "llm", or "decision", got "maybe"`)
  expect(complexityProblem(`{"semantic": {"fallback": "llm"}}`)).toBe(`semantic fallback "llm" requires an llm config block`)
  expect(complexityProblem(`{"semantic": {"vector_store": "disk"}}`)).toBe(`semantic vector_store must be "embedded" or "vector_store", got "disk"`)
  expect(complexityProblem(`{"session": {"enabled": true, "ttl": 5}}`)).toBe(`unknown complexity session field "ttl"`)
  expect(complexityProblem(`{"session": {}}`)).toBe("complexity session config requires enabled")
})

test("creationPolicy names the first active profile a user holds", () => {
  const users: AdminUserConfig[] = [{ name: "ana", role: "editor", access_profile_ids: ["p-off", "p-on", "p-two"] }, { name: "bo", role: "viewer" }]
  const profiles: AccessProfile[] = [{ id: "p-off", name: "Off", is_active: false }, { id: "p-on", name: "Engineer" }, { id: "p-two" }]
  expect(creationPolicy(users, [], profiles, "ana")).toBe(`{"has_access_profile":true,"profile_name":"Engineer"}`)
  expect(creationPolicy(users, [], profiles, "bo")).toBe(`{"has_access_profile":false}`)
  expect(creationPolicy(users, [], profiles, "nobody")).toBe(`{"has_access_profile":false}`)
  expect(creationPolicy(users, [], [], "ana")).toBe(`{"has_access_profile":false}`)
})

test("propagateProfileKeys pushes the chosen set fields to the keys that hold the profile", () => {
  const p: AccessProfile = { id: "p1", budget_id: "b-new", rate_limit_id: "rl-new", provider_configs: [{ provider: "openai" }] }
  const vks: VirtualKeyConfig[] = [
    { id: "k1", value: "v1", access_profile_ids: ["p1"], budget_id: "b-old", rate_limit_id: "rl-old" },
    { id: "k2", value: "v2", access_profile_ids: ["p2"], budget_id: "b-old" },
  ]
  const r = propagateProfileKeys(vks, p, ["budgets"])
  expect(r.updated).toBe(1)
  expect(r.vks[0]!.budget_id).toBe("b-new")
  expect(r.vks[0]!.rate_limit_id).toBe("rl-old")
  expect(r.vks[1]!.budget_id).toBe("b-old")
  const all = propagateProfileKeys(vks, p, PROPAGATED_FIELDS)
  expect(all.vks[0]!.rate_limit_id).toBe("rl-new")
  expect(all.vks[0]!.provider_configs!.length).toBe(1)
  // a field the profile leaves unset does not clear the key's own
  const bare: AccessProfile = { id: "p1" }
  expect(propagateProfileKeys(vks, bare, PROPAGATED_FIELDS).vks[0]!.budget_id).toBe("b-old")
})

test("heldProfiles lists a user's profiles in rank order and skips unknown ids", () => {
  const users: AdminUserConfig[] = [{ name: "ana", role: "editor", access_profile_ids: ["p-b", "gone", "p-a"] }]
  const profiles: AccessProfile[] = [{ id: "p-a" }, { id: "p-b" }]
  expect(heldProfiles(users, [], profiles, "ana").map((p) => p.id).join(",")).toBe("p-b,p-a")
  expect(heldProfiles(users, [], profiles, "bo").length).toBe(0)
})

test("a role's profile attachments are held by the users of that role, after the ones set by hand", () => {
  const roles: RoleConfig[] = [{ id: 1, name: "ops" }, { id: 9, name: "dev" }]
  const users: AdminUserConfig[] = [{ name: "ana", role: "ops", access_profile_ids: ["p-two"] }, { name: "bo", role: "dev" }, { name: "cy", role: "viewer" }]
  const profiles: AccessProfile[] = [
    { id: "p-one", roles: [{ role_id: 1 }] },
    { id: "p-two", roles: [{ role_id: 1, is_default: true }] },
    { id: "p-three", roles: [{ role_id: 9 }] },
  ]
  expect(heldProfileIds(users, roles, profiles, "ana").join(",")).toBe("p-two,p-one")
  expect(heldProfileIds(users, roles, profiles, "bo").join(",")).toBe("p-three")
  expect(heldProfileIds(users, roles, profiles, "cy").length).toBe(0)
  expect(creationPolicy(users, roles, profiles, "bo")).toBe(`{"has_access_profile":true,"profile_name":"p-three"}`)
})

test("withRoleIds keeps the ids roles have and numbers the rest after the largest", () => {
  const out = withRoleIds([{ name: "a" }, { id: 5, name: "b" }, { name: "c" }])
  expect(out.map((r) => r.id ?? 0).join(",")).toBe("6,5,7")
  expect(roleIdOf([{ name: "a" }, { id: 5, name: "b" }], "a")).toBe(6)
  expect(roleIdOf([{ name: "a" }], "zz")).toBeUndefined()
})


test("a built-in role's attachments are held by its users", () => {
  const users: AdminUserConfig[] = [{ name: "cy", role: "viewer" }, { name: "di", role: "editor" }]
  const profiles: AccessProfile[] = [{ id: "p-view", roles: [{ role_id: 9003 }] }]
  expect(heldProfileIds(users, [], profiles, "cy").join(",")).toBe("p-view")
  expect(heldProfileIds(users, [], profiles, "di").length).toBe(0)
})

test("role pairs expand built-in roles, and the permission map lists every pair", () => {
  const roles: RoleConfig[] = [{ id: 1, name: "ops", permissions: [{ resource: "Teams", operation: "View" }] }]
  expect(rolePairs(roles, "ops", ["Teams"], ["View"]).length).toBe(1)
  expect(rolePairs(roles, "viewer", ["Teams", "Users"], ["View", "Create"]).map((p) => p.resource + ":" + p.operation).join(",")).toBe("Teams:View")
  expect(rolePairs(roles, "ghost", ["Teams"], ["View"]).length).toBe(0)
  const m = permissionMap([{ resource: "Teams", operation: "View" }], ["Teams", "Logs"], ["View", "Create"])
  expect(m).toBe(`{"permissions":{"Teams":{"View":true,"Create":false},"Logs":{"View":false,"Create":false}}}`)
})

test("a user reads in Bifrost's UserObject shape, and its keys by email", () => {
  const roles: RoleConfig[] = [{ id: 1, name: "ops", description: "on call" }]
  const users: AdminUserConfig[] = [{ name: "ann", email: "ann@example.com", role: "ops", teams: ["t1"] }, { name: "bo@example.com", role: "viewer" }]
  const profiles: AccessProfile[] = [{ id: "p1", name: "Base", roles: [{ role_id: 1 }] }]
  const a = userObjectJson(users[0]!, users, roles, profiles)
  expect(a).toBe(`{"id":"ann","name":"ann","email":"ann@example.com","role_id":1,"role":{"id":1,"name":"ops","description":"on call","is_system_role":false},"disabled":false,"teams":[{"id":"t1"}],"business_units":[],"access_profiles":[{"id":"p1","name":"Base"}]}`)
  const b = userObjectJson(users[1]!, users, roles, profiles)
  expect(b.includes(`"email":"bo@example.com","role_id":9003,"role":{"id":9003,"name":"viewer","is_system_role":true}`)).toBe(true)
  const vks: VirtualKeyConfig[] = [{ id: "vk1", name: "mine", value: "sk-bf-a", user_id: "ann" }, { id: "vk2", value: "sk-bf-b", user_id: "zed", is_active: false }]
  expect(userKeysJson(users[0]!, vks)).toBe(`{"user_id":"ann","email":"ann@example.com","virtual_keys":[{"id":"vk1","name":"mine","value":"sk-bf-a","is_active":true}]}`)
  expect(userKeysJson(users[1]!, vks)).toBe(`{"user_id":"bo@example.com","email":"bo@example.com","virtual_keys":[]}`)
})

test("role attachments: apply_to_existing reaches the role's users now, is_default its later users", () => {
  const holders = ["ana", "bo"]
  // neither: nobody now, nobody later
  const none = attachBinding(1, undefined, false, holders, undefined)
  expect(bindingReaches(none, "ana")).toBe(false)
  expect(bindingReaches(none, "zed")).toBe(false)
  // apply only: the users now, not later ones
  const now = attachBinding(1, undefined, true, holders, undefined)
  expect(bindingReaches(now, "bo")).toBe(true)
  expect(bindingReaches(now, "zed")).toBe(false)
  // default only: later users, not the ones in the role now
  const later = attachBinding(1, true, false, holders, undefined)
  expect(bindingReaches(later, "ana")).toBe(false)
  expect(bindingReaches(later, "zed")).toBe(true)
  // both: everyone
  const all = attachBinding(1, true, true, holders, undefined)
  expect(bindingReaches(all, "ana") && bindingReaches(all, "zed")).toBe(true)
  // attaching again keeps those the earlier attachment reached
  const again = attachBinding(1, undefined, false, holders, now)
  expect(bindingReaches(again, "ana")).toBe(true)
  // an attachment from the config file reaches every user of the role
  expect(bindingReaches({ role_id: 1 }, "anyone")).toBe(true)
  const users: AdminUserConfig[] = [{ name: "ana", role: "ops" }, { name: "zed", role: "ops" }]
  const roles: RoleConfig[] = [{ id: 1, name: "ops" }]
  const profiles: AccessProfile[] = [{ id: "p1", roles: [later] }]
  expect(heldProfileIds(users, roles, profiles, "ana").length).toBe(0)
  expect(heldProfileIds(users, roles, profiles, "zed").join(",")).toBe("p1")
})
