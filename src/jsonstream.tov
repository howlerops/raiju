// A streaming JSON reader (large_payload_optimization): bytes go in as they arrive, in chunks of any size, and
// tokens come out. Nothing is held beyond the token being read: keys, numbers and short strings are collected
// whole (up to strMax bytes), a longer string comes out in pieces (a head, then pieces, then its end) so a
// base64 image of any size passes through in bounded memory. The reader checks the JSON grammar as it goes.
//
// Strings are raw: the bytes between the quotes with their escapes as the sender wrote them, so a piece can be
// copied to another JSON string as it is. A piece may end inside an escape sequence.

export const T_OBJ = 1
export const T_OBJ_END = 2
export const T_ARR = 3
export const T_ARR_END = 4
// an object key (raw bytes between the quotes)
export const T_KEY = 5
// a string value of at most strMax bytes, whole
export const T_STR = 6
// the start of a longer string: its first bytes (more than strMax); T_STRP pieces and a T_STRE follow
export const T_STRH = 7
export const T_STRP = 8
export const T_STRE = 9
// a number, true, false or null (raw text)
export const T_LIT = 10

export type Tok = { kind: int, raw: u8[] }

const NONE: u8[] = []

function isSpace(c: int): bool {
  return c === 32 || c === 9 || c === 10 || c === 13
}

function isDelim(c: int): bool {
  return c === 44 || c === 125 || c === 93 || isSpace(c)
}

// Frame states. Objects: 0 after "{", 1 after ",", 2 after a key, 3 after ":", 4 after a value.
// Arrays: 10 after "[", 11 after ",", 12 after a value.
export class JsonTokenizer {
  // 0 structure, 1 key, 2 short string, 3 long string, 4 literal
  private mode = 0
  private esc = false
  private acc: u8[] = []
  private stack: int[] = []
  private rootDone = false
  private seen = 0
  private out: Tok[] = []
  // the number of containers open
  depth = 0
  constructor(readonly strMax: int, readonly keyMax: int) {}

  private fail(what: string, at: int): void throws SyntaxError {
    throw new SyntaxError(`invalid JSON: ${what} at byte ${this.seen + at}`)
  }

  private valueStart(at: int): void throws SyntaxError {
    const n = this.stack.length
    if (n === 0) {
      if (this.rootDone) try this.fail("data after the value", at)
      return
    }
    const s = this.stack[n - 1]!
    if (s === 3 || s === 10 || s === 11) return
    try this.fail("unexpected value", at)
  }

  private afterValue(): void {
    const n = this.stack.length
    if (n === 0) {
      this.rootDone = true
      return
    }
    const s = this.stack[n - 1]!
    this.stack[n - 1] = s < 10 ? 4 : 12
  }

  // One byte outside strings and literals.
  private structural(c: int, at: int): void throws SyntaxError {
    if (isSpace(c)) return
    const n = this.stack.length
    const top = n === 0 ? -1 : this.stack[n - 1]!
    if (c === 123) {
      try this.valueStart(at)
      this.stack.push(0)
      this.depth += 1
      this.out.push({ kind: T_OBJ, raw: NONE })
    } else if (c === 91) {
      try this.valueStart(at)
      this.stack.push(10)
      this.depth += 1
      this.out.push({ kind: T_ARR, raw: NONE })
    } else if (c === 125) {
      if (top !== 0 && top !== 4) try this.fail("unexpected }", at)
      this.stack.pop()
      this.depth -= 1
      this.out.push({ kind: T_OBJ_END, raw: NONE })
      this.afterValue()
    } else if (c === 93) {
      if (top !== 10 && top !== 12) try this.fail("unexpected ]", at)
      this.stack.pop()
      this.depth -= 1
      this.out.push({ kind: T_ARR_END, raw: NONE })
      this.afterValue()
    } else if (c === 34) {
      if (top === 0 || top === 1) {
        this.mode = 1
      } else {
        try this.valueStart(at)
        this.mode = 2
      }
      this.acc = []
      this.esc = false
    } else if (c === 58) {
      if (top !== 2) try this.fail("unexpected :", at)
      this.stack[n - 1] = 3
    } else if (c === 44) {
      if (top === 4) this.stack[n - 1] = 1
      else if (top === 12) this.stack[n - 1] = 11
      else try this.fail("unexpected ,", at)
    } else {
      // a number, true, false or null
      if (!(c === 45 || (c >= 48 && c <= 57) || c === 116 || c === 102 || c === 110)) try this.fail("unexpected character", at)
      try this.valueStart(at)
      this.mode = 4
      this.acc = [u8(c)]
    }
  }

  private literal(): void {
    this.out.push({ kind: T_LIT, raw: this.acc })
    this.acc = []
    this.mode = 0
    this.afterValue()
  }

  // Reads the next bytes; the tokens they complete.
  push(b: u8[]): Tok[] throws SyntaxError {
    const n = b.length
    let i = 0
    while (i < n) {
      const m = this.mode
      if (m === 0) {
        try this.structural(int(b[i]!), i)
        i += 1
      } else if (m === 4) {
        const c = int(b[i]!)
        if (isDelim(c)) {
          this.literal()
        } else {
          this.acc.push(b[i]!)
          if (this.acc.length > 4096) try this.fail("literal too long", i)
          i += 1
        }
      } else if (m === 3) {
        // a long string: find its end and pass the bytes up to it on
        let j = i
        let esc = this.esc
        while (j < n) {
          const c = int(b[j]!)
          if (esc) esc = false
          else if (c === 92) esc = true
          else if (c === 34) break
          j += 1
        }
        this.esc = esc
        if (j > i) this.out.push({ kind: T_STRP, raw: b.slice(i, j) })
        if (j < n) {
          this.out.push({ kind: T_STRE, raw: NONE })
          this.mode = 0
          this.esc = false
          this.afterValue()
          i = j + 1
        } else {
          i = n
        }
      } else {
        // a key or a short string, byte by byte (at most strMax of them)
        const c = int(b[i]!)
        i += 1
        if (this.esc) {
          this.esc = false
          this.acc.push(u8(c))
        } else if (c === 92) {
          this.esc = true
          this.acc.push(u8(c))
        } else if (c === 34) {
          if (m === 1) {
            this.out.push({ kind: T_KEY, raw: this.acc })
            this.stack[this.stack.length - 1] = 2
          } else if (this.acc.length > this.strMax) {
            this.out.push({ kind: T_STRH, raw: this.acc })
            this.out.push({ kind: T_STRE, raw: NONE })
            this.afterValue()
          } else {
            this.out.push({ kind: T_STR, raw: this.acc })
            this.afterValue()
          }
          this.acc = []
          this.mode = 0
        } else {
          this.acc.push(u8(c))
          if (m === 1) {
            if (this.acc.length > this.keyMax) try this.fail("key too long", i)
          } else if (this.acc.length > this.strMax) {
            this.out.push({ kind: T_STRH, raw: this.acc })
            this.acc = []
            this.mode = 3
          }
        }
      }
    }
    this.seen += n
    const res = this.out
    this.out = []
    return res
  }

  // The end of the input: the last token, or an error when the JSON is cut short.
  finish(): Tok[] throws SyntaxError {
    if (this.mode === 4) this.literal()
    if (this.mode !== 0 || this.stack.length > 0 || !this.rootDone) throw new SyntaxError("invalid JSON: the input ends inside a value")
    const res = this.out
    this.out = []
    return res
  }
}

// ---- output ----

// Bytes on their way out: small writes collect in one buffer, a big piece is kept as a chunk of its own.
export class ByteOut {
  chunks: u8[][] = []
  cur: u8[] = []
  size = 0

  text(s: string): void {
    const b = new TextEncoder().encode(s)
    for (let i = 0; i < b.length; i++) this.cur.push(b[i]!)
    this.size += b.length
  }

  byte(c: int): void {
    this.cur.push(u8(c))
    this.size += 1
  }

  bytes(b: u8[]): void {
    const n = b.length
    if (n === 0) return
    this.size += n
    if (n >= 2048) {
      if (this.cur.length > 0) {
        this.chunks.push(this.cur)
        this.cur = []
      }
      this.chunks.push(b)
      return
    }
    for (let i = 0; i < n; i++) this.cur.push(b[i]!)
  }

  // everything written since the last take, in order
  take(): u8[][] {
    if (this.cur.length > 0) {
      this.chunks.push(this.cur)
      this.cur = []
    }
    const out = this.chunks
    this.chunks = []
    this.size = 0
    return out
  }

  // the bytes as one array (for what is held whole)
  all(): u8[] {
    const parts = this.take()
    const out: u8[] = []
    for (const p of parts) for (let i = 0; i < p.length; i++) out.push(p[i]!)
    return out
  }
}

// Tokens written back as compact JSON (no whitespace). Raw strings are copied as they are.
export class Compact {
  private kinds: bool[] = []
  private first: bool[] = []
  private longOpen = false
  private any = false

  constructor(readonly out: ByteOut) {}

  // a value has been written whole (or none has been started)
  get complete(): bool {
    return this.kinds.length === 0 && !this.longOpen
  }

  get started(): bool {
    return this.any
  }

  private beforeValue(): void {
    const n = this.kinds.length
    if (n > 0 && !this.kinds[n - 1]!) {
      if (!this.first[n - 1]!) this.out.byte(44)
      this.first[n - 1] = false
    }
    this.any = true
  }

  tok(t: Tok): void {
    const k = t.kind
    if (k === T_KEY) {
      const n = this.kinds.length - 1
      if (!this.first[n]!) this.out.byte(44)
      this.first[n] = false
      this.out.byte(34)
      this.out.bytes(t.raw)
      this.out.byte(34)
      this.out.byte(58)
    } else if (k === T_OBJ) {
      this.beforeValue()
      this.out.byte(123)
      this.kinds.push(true)
      this.first.push(true)
    } else if (k === T_ARR) {
      this.beforeValue()
      this.out.byte(91)
      this.kinds.push(false)
      this.first.push(true)
    } else if (k === T_OBJ_END) {
      this.out.byte(125)
      this.kinds.pop()
      this.first.pop()
    } else if (k === T_ARR_END) {
      this.out.byte(93)
      this.kinds.pop()
      this.first.pop()
    } else if (k === T_STR) {
      this.beforeValue()
      this.out.byte(34)
      this.out.bytes(t.raw)
      this.out.byte(34)
    } else if (k === T_STRH) {
      this.beforeValue()
      this.out.byte(34)
      this.out.bytes(t.raw)
      this.longOpen = true
    } else if (k === T_STRP) {
      this.out.bytes(t.raw)
    } else if (k === T_STRE) {
      this.out.byte(34)
      this.longOpen = false
    } else {
      this.beforeValue()
      this.out.bytes(t.raw)
    }
  }
}

// ---- helpers for tests and callers ----

export function bytesOf(s: string): u8[] {
  return new TextEncoder().encode(s)
}

export function textOfBytes(b: u8[]): string {
  try {
    return new TextDecoder().decode(b)
  } catch (e) {
    return ""
  }
}

// Reads a whole JSON text through a tokenizer in chunks of `step` bytes and writes it back compact.
export function compactOf(text: string, step: int, strMax: int): string throws SyntaxError {
  const tk = new JsonTokenizer(strMax, 65536)
  const out = new ByteOut()
  const w = new Compact(out)
  const b = bytesOf(text)
  let i = 0
  while (i < b.length) {
    const e = i + step < b.length ? i + step : b.length
    for (const t of try tk.push(b.slice(i, e))) w.tok(t)
    i = e
  }
  for (const t of try tk.finish()) w.tok(t)
  return textOfBytes(out.all())
}

const SAMPLE = `{ "a" : [ 1 , -2.5e3 , true , null , "x\\"y\\\\" ] , "b" : { "c" : "A longer string value than eight bytes \\u00e9\\/ end" , "d" : [ ] , "e" : { } } , "f" : "" }`
const SAMPLE_COMPACT = `{"a":[1,-2.5e3,true,null,"x\\"y\\\\"],"b":{"c":"A longer string value than eight bytes \\u00e9\\/ end","d":[],"e":{}},"f":""}`

test("tokens come out the same whatever the chunk size and string limit", () => {
  for (const step of [1, 2, 3, 5, 7, 64, 100000]) {
    for (const mx of [0, 1, 4, 8, 4096]) {
      expect(try compactOf(SAMPLE, step, mx)).toBe(SAMPLE_COMPACT)
    }
  }
})

test("a string over the limit comes out as a head, pieces and an end", () => {
  const tk = new JsonTokenizer(4, 100)
  const toks = try tk.push(bytesOf(`["abcdefghij","xy"`))
  const kinds = toks.map((t) => t.kind)
  expect(kinds).toEqual([T_ARR, T_STRH, T_STRP, T_STRE, T_STR])
  expect(textOfBytes(toks[1]!.raw)).toBe("abcde")
  expect(textOfBytes(toks[2]!.raw)).toBe("fghij")
  expect(textOfBytes(toks[4]!.raw)).toBe("xy")
  expect(tk.depth).toBe(1)
  try tk.push(bytesOf("]"))
  expect(tk.depth).toBe(0)
})

test("an escaped quote at a chunk boundary does not end a string", () => {
  const tk = new JsonTokenizer(2, 100)
  const a = try tk.push(bytesOf(`["abcd\\`))
  const b = try tk.push(bytesOf(`"efg"]`))
  let joined = ""
  for (const t of a.concat(b)) if (t.kind === T_STRH || t.kind === T_STRP) joined += textOfBytes(t.raw)
  expect(joined).toBe(`abcd\\"efg`)
})

test("bad JSON is refused", () => {
  const bad = [`{"a" 1}`, `{"a":1,}x`, `[1 2]`, `{"a":}`, `[1,]`, `{1:2}`, `}`, `{"a":1}{`, `{"a":1`, `[tru`, `"abc`, `{"a":1} 2`, `x`]
  for (const s of bad) {
    let threw = false
    try {
      compactOf(s, 3, 8)
    } catch (e) {
      threw = true
    }
    expect(threw).toBe(true)
  }
})

test("a top-level scalar is a value", () => {
  expect(try compactOf(` 12 `, 1, 8)).toBe("12")
  expect(try compactOf(`"hi there, a long one"`, 1, 4)).toBe(`"hi there, a long one"`)
})
