// raiju: an LLM gateway. Flags follow Bifrost's: -port, -host, -app-dir
// (which holds config.json), plus -config <file> and -workers <n>. -mode broker runs the
// cluster broker instead of a gateway (cluster_config.type "broker"). -healthcheck [path] probes a
// gateway running on this host (the -host and -port given) and exits 0 when it answers 2xx.
import { aliasProblems } from "./router"
import { configureCrews } from "./crew"
import { startBroker } from "./broker"
import * as path from "node:path"
import { Config, loadConfig, loadRawConfig, resolveConfig, providerNames, withAppDirs } from "./config"
import { ConfigStore, ConfigCipher, cipherFromConfig, openConfig } from "./store"
import { Engine, pluginPaths } from "./gateway"
import { fetchPluginUrls, setPluginCacheBase } from "./plugindl"
import { McpManager, setAdminRenew, setSpecBaseDir } from "./mcp"
import { McpUserToken, openFlowState } from "./mcpuser"
import { saveUserToken, headersAuthMessage, saveExchangeAdmin, setAdminPublished, setAdminRemoved, dropExchangeAdmin } from "./mcpapi"
import { readStoredAdmin, sealAdminRow, openAdminRow, sealStored, openStored } from "./store"
import { setEkSeal } from "./rtsession"
import { clusterState } from "./clusterstate"
import { McpShare, CLIENT_NS, diskConfig, saveShared, pullsConfig } from "./mcpshare"
import { FileLease, FILE_LEASE_MS } from "./filelease"
import { start, startCluster, bodyLimits, NO_BODY_LIMIT, startLiveModelRefresher, Served } from "./server"
import { serverLimits, stopSettings, beginStop, ServerLimits } from "./lifecycle"
import { secretProblem } from "./cluster"
import { Ops, withSecrets, makeShareDir } from "./ops"
import { fromBifrost, merge } from "./guardrails_compat"
import { warnings } from "./config_compat"
import { existsSync, readFileSync } from "node:fs"
import { startFront, startClusterFront } from "./front"
import { openIssuerState } from "./mcpissuer"
import { setA2aGrpc, listenA2aGrpc, claimA2aGrpc } from "./a2agrpc"
import { healthcheckUrl, runHealthcheck } from "./healthcheck"

// healthcheck: the path -healthcheck probes ("" when the flag is not given)
type Args = { port: int, host: string, config: string, workers: int, server: string, mode: string, healthcheck: string }

function parseArgs(argv: string[]): Args {
  // the bind address defaults to the loopback, as Bifrost's (localhost, BIFROST_HOST overrides); containers pass -host 0.0.0.0
  const a: Args = { port: 8080, host: process.env.BIFROST_HOST ?? "127.0.0.1", config: "", workers: 1, server: process.env.RAIJU_SERVER ?? "", mode: process.env.RAIJU_MODE ?? "", healthcheck: "" }
  const envPort = process.env.PORT
  if (envPort !== undefined) a.port = parseInt(envPort) ?? 8080
  const envConfig = process.env.RAIJU_CONFIG
  if (envConfig !== undefined) a.config = envConfig
  const envWorkers = process.env.RAIJU_WORKERS
  if (envWorkers !== undefined) a.workers = parseInt(envWorkers) ?? 1
  let appDir = process.env.APP_DIR ?? ""
  for (let i = 0; i < argv.length; i++) {
    const flag = argv[i]!.replace("--", "-")
    const v = argv[i + 1] ?? ""
    if (flag === "-port") a.port = parseInt(v) ?? a.port
    else if (flag === "-host") a.host = v
    else if (flag === "-config") a.config = v
    else if (flag === "-app-dir") appDir = v
    else if (flag === "-workers") a.workers = parseInt(v) ?? a.workers
    else if (flag === "-server") a.server = v
    else if (flag === "-mode") a.mode = v
    else if (flag === "-healthcheck") {
      // the path is optional: /health unless the next argument is one
      a.healthcheck = v.startsWith("/") ? v : "/health"
      if (!v.startsWith("/")) continue
    }
    else continue
    i += 1
  }
  if (a.config === "") a.config = appDir === "" ? "config.json" : path.join(appDir, "config.json")
  return a
}

function loadConfigOrExit(file: string): Config | undefined {
  try {
    return loadRawConfig(file)
  } catch (e) {
    console.error(`raiju: can't load ${file}: ${e.message}`)
    return undefined
  }
}

// Bifrost's guardrails_config, translated and merged into the served config (never saved:
// the store keeps the section as written).
function withBifrostGuardrails(c: Config, store: ConfigStore, report: bool): Config {
  const raw = store.rawSection("guardrails_config")
  if (raw === undefined) return c
  let g = c.guardrails
  try {
    const t = fromBifrost(raw)
    if (report) for (const w of t.warnings) console.error(`raiju: guardrails: ${w}`)
    g = merge(c.guardrails, t.config)
  } catch (e) {
    console.error(`raiju: guardrails_config: ${e.message}`)
  }
  let n = c
  n.guardrails = g
  return n
}

// What Raiju makes of the config file: Bifrost names it reads differently, keys it ignores.
function reportConfig(file: string): void {
  try {
    if (!existsSync(file)) return
    for (const w of warnings(readFileSync(file, "utf8"))) console.error(`raiju: ${w}`)
  } catch (e) {
    // a broken file was already reported by the loader
  }
}

// A saved config (or one another worker or node saved, store.tov takeGeneration): env and secret references resolved,
// the log folders read from the app dir, then swapped in.
async function applyChange(engine: Engine, ops: Ops, store: ConfigStore, c: Config, appDir: string): Promise<void> {
  let resolved = c
  resolveConfig(&resolved)
  const next = withBifrostGuardrails(withAppDirs(await withSecrets(resolved), appDir), store, false)
  engine.reload(next)
  // the other workers learn that this one runs the generation (a management API answer waits for them, ops.settleConfig)
  ops.ackConfig()
  // the clients added by the change connect (their OAuth tokens, if any, are in the config)
  const newMcp = engine.mcp
  if (newMcp !== undefined) await newMcp.connectNew()
  // a changed tool_sync_interval restarts the MCP tool sync timers
  engine.mcp?.startToolSync()
  // a new or renewed token_exchange admin credential sets the next renewal
  engine.scheduleAdminRenewal()
  // a token_exchange client added without an authorization_server_url has its token endpoint discovered now
  await discoverTokenEndpoint(engine)
  ops.configure(next)
}

// Discovers the identity provider's token endpoint (oidc.issuer) when a token_exchange client names no
// authorization_server_url, so a discovery problem shows at start and the first exchange does not wait for it.
async function discoverTokenEndpoint(engine: Engine): Promise<void> {
  const issuer = engine.cfg.oidc?.issuer ?? ""
  const needs = (engine.cfg.mcp?.client_configs ?? []).filter((c) => c.auth_type === "token_exchange" && c.disabled !== true && (c.token_exchange?.authorization_server_url ?? "") === "")
  if (needs.length === 0) return
  if (issuer === "") {
    console.error(`raiju: mcp ${needs[0]!.name}: token_exchange names no authorization_server_url and oidc.issuer is not set`)
    return
  }
  engine.idp.allow = engine.cfg.mcp?.oauth_private_allowlist ?? []
  const ep = await engine.idp.tokenEndpoint(issuer)
  if (ep === "") console.error(`raiju: mcp: the token endpoint of ${issuer} could not be discovered; token exchanges will try again`)
}

async function startStdio(mcp: McpManager): Promise<void> {
  await mcp.connectStdio()
  for (const s of mcp.status()) {
    if (s.stdio) console.error(`raiju: mcp ${s.name} (stdio, pid ${process.pid}): ${s.connected ? `${s.tools} tools` : `not connected (${s.error})`}`)
  }
}

// Clustering signs every peer route with cluster.secret, so a secret that is missing, still an unresolved env.NAME
// reference or shorter than 32 bytes stops the start (rawSecret: as written, first: the resolved config). "" when fine.
function clusterSecretProblem(rawSecret: string, first: Config, broker: bool): string {
  const cc = first.cluster
  if (cc === undefined || !(cc.enabled || broker)) return ""
  return secretProblem(rawSecret, cc.secret)
}

// The cluster listener (cluster.listen_port, on cluster.bind or the gateway's host): the peer routes, /health and,
// with cluster.serve_metrics, /metrics. Opened before the workers fork, so each worker accepts on it. undefined when
// it is not configured.
function openClusterListener(engine: Engine, ops: Ops, cfg: Config, host: string, server: string, limits: ServerLimits, maxBody: int): Served | undefined {
  const cc = cfg.cluster
  if (cc === undefined) return undefined
  const port = cc.listen_port ?? 0
  if (port <= 0 || !(cc.enabled || cc.serve_metrics === true)) return undefined
  const b = cc.bind ?? ""
  const bind = b === "" ? host : b
  const served = server === "http1" ? startClusterFront(engine, ops, bind, port, maxBody, limits) : startCluster(engine, ops, port, bind, limits, maxBody)
  ops.clusterPort = port
  ops.metricsOnCluster = cc.serve_metrics === true
  return served
}

// Broker mode: the relay only, with no store, providers or gateway. It serves on cluster_config.broker.listen_port
// and accepts only requests signed with cluster.secret.
function runBroker(c: Config, host: string): int {
  const cc = c.cluster
  if (cc === undefined || cc.secret === "") {
    console.error("raiju: broker mode needs cluster.secret")
    return 1
  }
  const served = startBroker(cc, host, serverLimits(c.server, Bun.fdLimit()))
  console.error(`raiju broker listening on ${served.url}`)
  // SIGTERM and SIGINT stop it gracefully, as the gateway: /ready turns 503, the listener closes after
  // server.shutdown_delay_seconds, the exchanges in hand finish within server.shutdown_grace_seconds, exit 0. The
  // broker keeps nothing that needs writing out: the nodes send their state again to the next broker.
  Bun.onStopSignal((sig: string) => {
    beginStop(sig, stopSettings(c.server), {
      stopListener: served.stopListener,
      open: served.open,
      flush: async (): Promise<void> => {},
      exit: (code: int) => {
        process.exit(code)
      },
    })
  })
  return 0
}

async function main(): Promise<int> {
  const args = parseArgs(process.argv.slice(2))
  if (args.healthcheck !== "") {
    // the Docker HEALTHCHECK: no config is read and nothing is started
    process.exit(await runHealthcheck(healthcheckUrl(args.host, args.port, args.healthcheck)))
  }
  // an OpenAPI MCP client's spec_file is read relative to the config file, and so are the log and audit folders
  const appDir = path.dirname(path.resolve(args.config))
  setSpecBaseDir(appDir)
  // downloaded plugins are kept in a private plugin-cache folder beside the config file (RAIJU_PLUGIN_DIR overrides)
  setPluginCacheBase(appDir)
  const loaded = loadConfigOrExit(args.config)
  if (loaded === undefined) return 1
  // Encryption at rest: the sealed secrets in the file are opened with the cipher from encryption_key
  // (or BIFROST_ENCRYPTION_KEY). A value that cannot be opened stops the start, as it is never guessed at.
  let cipher: ConfigCipher | undefined = undefined
  let raw = loaded
  try {
    cipher = try cipherFromConfig(loaded)
    const opened = try openConfig(loaded, cipher)
    for (const e of opened.errors) console.error(`raiju: ${e}`)
    if (opened.errors.length > 0) return 1
    raw = opened.cfg
  } catch (e) {
    console.error(`raiju: encryption_key: ${e.message}`)
    return 1
  }
  if (cipher !== undefined) console.error("raiju: encryption at rest is on: secrets are sealed in the config file")
  // The store keeps the config as written (env.NAME references intact); the engine runs on a resolved copy.
  const store = new ConfigStore(args.config, raw)
  store.cipher = cipher
  const rawSecret = raw.cluster?.secret ?? ""
  let first = raw
  resolveConfig(&first)
  const weak = clusterSecretProblem(rawSecret, first, args.mode === "broker")
  if (weak !== "") {
    console.error(`raiju: ${weak}; refusing to start with clustering on`)
    return 1
  }
  if (args.mode === "broker") return runBroker(first, args.host)
  reportConfig(args.config)
  const cfg = withBifrostGuardrails(withAppDirs(await withSecrets(first), appDir), store, true)
  for (const p of aliasProblems(cfg)) console.error(`raiju: config: ${p}`)
  // crew routing (crew.tov): the pools, priors and classifier are checked and loaded here, relative to the config file's folder
  const crewProblems = configureCrews(cfg, path.dirname(args.config))
  for (const p of crewProblems) console.error(`raiju: config: ${p}`)
  if (crewProblems.length > 0) return 1
  // the MCP authorization server's state beside config.json: its signing key (generated when none is configured)
  // and its grants. It is opened before the workers start, so every worker signs with the same key.
  const stateNote = openIssuerState(cfg, path.join(path.dirname(args.config), "mcp-oauth-state.json"), cipher)
  if (stateNote !== "") console.error(`raiju: mcp oauth: ${stateNote}`)
  // plugins whose path is a URL are downloaded before the chain is built (plugindl.tov)
  const pdl = await fetchPluginUrls(pluginPaths(cfg), cfg.server?.plugin_download_private_allowlist ?? [], false)
  for (const e of pdl.errors) console.error(`raiju: plugin: ${e}`)
  const engine = new Engine(cfg)
  const ops = new Ops(engine, store)
  // a required log store or audit log that cannot open stops the start, as Bifrost's does (required: false keeps going)
  const storage = ops.storageProblems()
  for (const p of storage) console.error(`raiju: ${p} (set required: false to start without it)`)
  if (storage.length > 0) return 1
  // refreshed per-user OAuth tokens are saved to the config file
  engine.userTokenSaved = (r) => {
    saveUserToken(store, r)
  }
  // a tool call of a per_user_headers client whose key has submitted nothing opens a submission and names its page
  engine.headersAuth = (client: string, vk: string, session: string, user: string, base: string): string => headersAuthMessage(store, client, vk, session, user, base)
  // token_exchange admin credentials: renewed before they expire and after a 401, and saved to the config file
  engine.adminSaved = (r) => {
    saveExchangeAdmin(store, r)
  }
  // token_exchange admin credentials. Each is renewed by one node of the cluster (Ops.ownsAdmin) and by one worker of
  // that node at a time (the lease in the supervisor's share folder, shared by its workers). The renewed credential is
  // read back from the config file by the other workers, and sent to the other nodes through the cluster state with
  // its tokens sealed (every node must hold the same encryption_key for them to open it)
  // The node's share folder is made here, in the supervisor before the workers fork, so every worker names the same
  // private folder (ops.startLocalShare)
  const shareDir = args.workers > 1 && args.server !== "http1" ? makeShareDir(process.pid) : ""
  if (shareDir !== "") engine.adminLease = new FileLease(shareDir + "/leases", FILE_LEASE_MS)
  // the closures below take a const copy of the cipher: a mutable local captured by a closure in this async function
  // does not compile
  const sealKey: ConfigCipher | undefined = cipher
  // the MCP OAuth flows in flight (per-user consent and admin verification) and their temp tokens, beside config.json:
  // a restart between a consent link and its callback keeps the flow; the PKCE verifiers are sealed with the config's key
  const flowNote = openFlowState(path.join(path.dirname(args.config), "mcp-flow-state.json"), (v: string): string => {
    try {
      return sealStored(sealKey, v)
    } catch (e) {
      return ""
    }
  }, (v: string): string | undefined => openStored(sealKey, v))
  if (flowNote !== "") console.error(`raiju: mcp oauth: ${flowNote}`)
  const configPath = args.config
  engine.adminOwns = (client: string): bool => ops.ownsAdmin(client)
  engine.adminStored = (client: string): McpUserToken | undefined => readStoredAdmin(configPath, sealKey, client)
  const publishAdmin = (r: McpUserToken): void => {
    try {
      clusterState().put("mcp.exchange_admin", r.mcp_client_name, sealAdminRow(sealKey, r))
    } catch (e) {
      console.error(`raiju: mcp ${r.mcp_client_name}: the admin credential could not be sent to the other nodes: ${e.message}`)
    }
  }
  engine.adminPublish = publishAdmin
  // the provider tokens behind realtime client secrets travel on the cluster state sealed the same way (a token that
  // could not be sealed is not kept, so its client secret does not open)
  setEkSeal((v: string): string => {
    try {
      return sealStored(sealKey, v)
    } catch (e) {
      return ""
    }
  }, (v: string): string | undefined => openStored(sealKey, v))
  setAdminPublished(publishAdmin)
  // a credential removed on another node (its client deleted, or its token exchange changed) is removed here too
  setAdminRemoved((client: string) => {
    clusterState().del("mcp.exchange_admin", client)
  })
  clusterState().onChange("mcp.exchange_admin", (client: string, value: string | undefined) => {
    if (value === undefined) {
      dropExchangeAdmin(store, client)
      return
    }
    const row = openAdminRow(sealKey, value)
    if (row === undefined || row.mcp_client_name !== client) return
    engine.adoptRemoteAdmin(row)
  })
  setAdminRenew(async (client: string, used: string): Promise<string> => await engine.renewAdminCredential(client, used))
  // MCP client configs are shared across the cluster (mcpshare.tov): a save that changed them puts the changed clients
  // on the cluster state and deletes the removed ones; a change another node wrote is applied to the config as the
  // file holds it now and saved here (that save is not sent back)
  const share = new McpShare(store.cfg)
  store.onChange = (c) => {
    const ch = share.changes(c)
    // with cluster.config_sync "pull" the whole config travels as a generation (store.tov), so the clients need not
    if (!pullsConfig(engine.cfg)) {
      for (const p of ch.put) {
        try {
          clusterState().put(CLIENT_NS, p.name, sealStored(sealKey, p.json))
        } catch (e) {
          console.error(`raiju: mcp ${p.name}: the client config could not be sent to the other nodes: ${e.message}`)
        }
      }
      for (const name of ch.del) clusterState().del(CLIENT_NS, name)
    }
    applyChange(engine, ops, store, c, appDir)
  }
  clusterState().onChange(CLIENT_NS, (name: string, value: string | undefined) => {
    // a pulled config generation carries the clients already
    if (pullsConfig(engine.cfg)) return
    let json: string | undefined = undefined
    if (value !== undefined) {
      json = openStored(sealKey, value)
      if (json === undefined) {
        console.error(`raiju: mcp ${name}: a client config from another node could not be opened (every node needs the same encryption_key)`)
        return
      }
    }
    try {
      const disk = diskConfig(configPath, sealKey)
      const next = share.applied(disk ?? store.cfg, name, json)
      // the file holds it already (a worker of this node saved it, or the nodes share the file): the config
      // generation of that save makes this process reread it (ops.takeConfigGen), so it is not applied twice
      if (next === undefined) return
      const err = saveShared(store, next)
      if (err !== "") console.error(`raiju: mcp ${name}: a client config from another node could not be saved: ${err}`)
    } catch (e) {
      console.error(`raiju: mcp ${name}: a client config from another node was refused: ${e.message}`)
    }
  })
  const mcp = engine.mcp
  if (mcp !== undefined) {
    // the identity provider's token endpoint, for the token_exchange clients that name none, is discovered now
    // rather than on the first exchange
    await discoverTokenEndpoint(engine)
    // an admin credential that ran out while the gateway was down is renewed before the clients connect
    await engine.renewDueAdmins()
    await mcp.connectAll()
    for (const s of mcp.status().filter((x) => !x.stdio)) console.error(`raiju: mcp ${s.name}: ${s.connected ? `${s.tools} tools` : `not connected (${s.error})`}`)
  }
  const providers = providerNames(engine.cfg)
  // bun (the default) is Tov's built-in server: multi-process workers, native WebSockets and,
  // with Tov's stream bodies, chunk-by-chunk streaming. http1 is the raw-socket fallback (one process).
  const server = args.server !== "" ? args.server : "bun"
  if (server === "http1" && args.workers > 1) console.error("raiju: the http1 server runs in one process; -workers needs -server bun")
  const maxBody = (cfg.client?.max_request_body_size_mb ?? 100) * 1048576
  // the A2A gRPC settings (server.a2a_grpc_base_domain and a2a_grpc_port): the cards advertise the interface in every worker;
  // the listener is opened here in a single-process gateway, and in one bun worker after the fork otherwise (a2agrpc.tov)
  const grpcNote = setA2aGrpc(ops, cfg.server)
  if (grpcNote !== "") {
    console.error(`raiju: ${grpcNote}`)
    return 1
  }
  const grpcShared = server !== "http1" && args.workers > 1
  if (!grpcShared) listenA2aGrpc(ops, args.host, cfg.server)
  // (the body limits and the stream threshold are read from the config as it is when a request comes, so a reload
  // moves them; bodyLimits in server.tov)
  // the header, idle and body timeouts and the connection cap (server.*; lifecycle.tov), read once at start
  const limits = serverLimits(cfg.server, Bun.fdLimit())
  const served = server === "http1" ? startFront(engine, ops, { hostname: args.host, port: args.port, maxBodyBytes: NO_BODY_LIMIT, limits: () => bodyLimits(engine), timeouts: limits }) : start(engine, ops, { port: args.port, hostname: args.host, workers: args.workers, maxBodyBytes: maxBody, limits: limits })
  const url = served.url
  const clusterServed = openClusterListener(engine, ops, cfg, args.host, server, limits, maxBody)
  if (clusterServed !== undefined) {
    const cu = clusterServed.url
    console.error(`raiju: cluster listener on ${cu} (the peer routes${ops.metricsOnCluster ? " and /metrics" : ""}; /api/cluster/* is refused on the main listener)`)
  }
  // SIGTERM and SIGINT stop gracefully (lifecycle.tov): in every worker, /ready turns 503, the listener closes, the
  // requests and streams in hand get up to server.shutdown_grace_seconds, and what is queued is sent before the exit
  Bun.onStopSignal((sig: string) => {
    beginStop(sig, stopSettings(engine.cfg.server), {
      stopListener: () => {
        served.stopListener()
        const cs = clusterServed
        if (cs !== undefined) cs.stopListener()
      },
      open: (): int => {
        const cs = clusterServed
        return served.open() + (cs === undefined ? 0 : cs.open())
      },
      flush: async (): Promise<void> => {
        await ops.flushForStop()
      },
      exit: (code: int) => {
        process.exit(code)
      },
    })
  })
  // Runs once the server is up: with -workers, in every worker after the fork.
  const supervisor = process.pid
  setTimeout(() => {
    if (process.pid !== supervisor) {
      ops.startLocalShare(shareDir)
      ops.startA2aRelay()
      // the card timer runs in every worker; one of them per node takes each period's turn (ops.cardTick)
      ops.startCardRefresh()
      // the directory sync schedule (one worker per period, by lease) and this worker's session sweep
      ops.startProvisioning()
      // one of the workers opens the gRPC listener (the lease in the share folder)
      if (grpcShared) claimA2aGrpc(ops, args.host, cfg.server, ops.shareDir)
    } else if (server === "http1" || args.workers <= 1) {
      ops.startExpirySweep()
      ops.startA2aRelay()
      ops.startCardRefresh()
      ops.startProvisioning()
    }
    // each worker starts its own stdio MCP servers
    if (mcp !== undefined) startStdio(mcp)
    // and keeps its own model listings fresh (framework.pricing.live_models_sync_interval); the supervisor of a
    // multi-worker Bun server serves no requests
    if (process.pid !== supervisor || server === "http1" || args.workers <= 1) {
      startLiveModelRefresher(engine)
      // held keys and incidents from the last run, and kept for the next (ops.startAdaptiveStore)
      ops.startAdaptiveStore()
    }
  }, 0)
  for (const w of ops.startupWarnings()) console.error(`raiju: warning: ${w}`)
  console.error(`raiju listening on ${url} (${providers.length} providers: ${providers.join(", ")}; ${args.workers} worker${args.workers === 1 ? "" : "s"})`)
  return 0
}
