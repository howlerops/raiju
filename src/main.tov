// raiju: an LLM gateway. Flags follow Bifrost's: -port, -host, -app-dir
// (which holds config.json), plus -config <file> and -workers <n>. -mode broker runs the
// cluster broker instead of a gateway (cluster_config.type "broker").
import { aliasProblems } from "./router"
import { configureCrews } from "./crew"
import { startBroker } from "./broker"
import * as path from "node:path"
import { Config, loadConfig, loadRawConfig, resolveConfig, providerNames } from "./config"
import { ConfigStore, ConfigCipher, cipherFromConfig, openConfig } from "./store"
import { Engine } from "./gateway"
import { McpManager, setAdminRenew, setSpecBaseDir } from "./mcp"
import { McpUserToken } from "./mcpuser"
import { saveUserToken, saveExchangeAdmin, setAdminPublished, setAdminRemoved, dropExchangeAdmin } from "./mcpapi"
import { readStoredAdmin, sealAdminRow, openAdminRow, sealStored, openStored } from "./store"
import { setEkSeal } from "./rtsession"
import { clusterState } from "./clusterstate"
import { FileLease, FILE_LEASE_MS } from "./filelease"
import { start } from "./server"
import { Ops, withSecrets } from "./ops"
import { fromBifrost, merge } from "./guardrails_compat"
import { warnings } from "./config_compat"
import { existsSync, readFileSync } from "node:fs"
import { startFront } from "./front"
import { openIssuerState } from "./mcpissuer"
import { setA2aGrpc, listenA2aGrpc, claimA2aGrpc } from "./a2agrpc"

type Args = { port: int, host: string, config: string, workers: int, server: string, mode: string }

function parseArgs(argv: string[]): Args {
  const a: Args = { port: 8080, host: "0.0.0.0", config: "", workers: 1, server: process.env.RAIJU_SERVER ?? "", mode: process.env.RAIJU_MODE ?? "" }
  const envPort = process.env.PORT
  if (envPort !== undefined) a.port = parseInt(envPort) ?? 8080
  const envConfig = process.env.RAIJU_CONFIG
  if (envConfig !== undefined) a.config = envConfig
  const envWorkers = process.env.RAIJU_WORKERS
  if (envWorkers !== undefined) a.workers = parseInt(envWorkers) ?? 1
  let appDir = process.env.APP_DIR ?? ""
  for (let i = 0; i < argv.length; i++) {
    const flag = argv[i]!.replace("--", "-")
    const v = argv[i + 1] ?? ""
    if (flag === "-port") a.port = parseInt(v) ?? a.port
    else if (flag === "-host") a.host = v
    else if (flag === "-config") a.config = v
    else if (flag === "-app-dir") appDir = v
    else if (flag === "-workers") a.workers = parseInt(v) ?? a.workers
    else if (flag === "-server") a.server = v
    else if (flag === "-mode") a.mode = v
    else continue
    i += 1
  }
  if (a.config === "") a.config = appDir === "" ? "config.json" : path.join(appDir, "config.json")
  return a
}

function loadConfigOrExit(file: string): Config | undefined {
  try {
    return loadRawConfig(file)
  } catch (e) {
    console.error(`raiju: can't load ${file}: ${e.message}`)
    return undefined
  }
}

// Bifrost's guardrails_config, translated and merged into the served config (never saved:
// the store keeps the section as written).
function withBifrostGuardrails(c: Config, store: ConfigStore, report: bool): Config {
  const raw = store.rawSection("guardrails_config")
  if (raw === undefined) return c
  let g = c.guardrails
  try {
    const t = fromBifrost(raw)
    if (report) for (const w of t.warnings) console.error(`raiju: guardrails: ${w}`)
    g = merge(c.guardrails, t.config)
  } catch (e) {
    console.error(`raiju: guardrails_config: ${e.message}`)
  }
  let n = c
  n.guardrails = g
  return n
}

// What Raiju makes of the config file: Bifrost names it reads differently, keys it ignores.
function reportConfig(file: string): void {
  try {
    if (!existsSync(file)) return
    for (const w of warnings(readFileSync(file, "utf8"))) console.error(`raiju: ${w}`)
  } catch (e) {
    // a broken file was already reported by the loader
  }
}

// A saved config: env and secret references resolved, then swapped in.
async function applyChange(engine: Engine, ops: Ops, store: ConfigStore, c: Config): Promise<void> {
  let resolved = c
  resolveConfig(&resolved)
  const next = withBifrostGuardrails(await withSecrets(resolved), store, false)
  engine.reload(next)
  // the clients added by the change connect (their OAuth tokens, if any, are in the config)
  const newMcp = engine.mcp
  if (newMcp !== undefined) await newMcp.connectNew()
  // a changed tool_sync_interval restarts the MCP tool sync timers
  engine.mcp?.startToolSync()
  // a new or renewed token_exchange admin credential sets the next renewal
  engine.scheduleAdminRenewal()
  ops.configure(next)
}

async function startStdio(mcp: McpManager): Promise<void> {
  await mcp.connectStdio()
  for (const s of mcp.status()) {
    if (s.stdio) console.error(`raiju: mcp ${s.name} (stdio, pid ${process.pid}): ${s.connected ? `${s.tools} tools` : `not connected (${s.error})`}`)
  }
}

// Broker mode: the relay only, with no store, providers or gateway. It serves on cluster_config.broker.listen_port
// and accepts only requests signed with cluster.secret.
function runBroker(c: Config, host: string): int {
  const cc = c.cluster
  if (cc === undefined || cc.secret === "") {
    console.error("raiju: broker mode needs cluster.secret")
    return 1
  }
  const url = startBroker(cc, host)
  console.error(`raiju broker listening on ${url}`)
  return 0
}

async function main(): Promise<int> {
  const args = parseArgs(process.argv.slice(2))
  // an OpenAPI MCP client's spec_file is read relative to the config file
  setSpecBaseDir(path.dirname(path.resolve(args.config)))
  const loaded = loadConfigOrExit(args.config)
  if (loaded === undefined) return 1
  // Encryption at rest: the sealed secrets in the file are opened with the cipher from encryption_key
  // (or BIFROST_ENCRYPTION_KEY). A value that cannot be opened stops the start, as it is never guessed at.
  let cipher: ConfigCipher | undefined = undefined
  let raw = loaded
  try {
    cipher = try cipherFromConfig(loaded)
    const opened = try openConfig(loaded, cipher)
    for (const e of opened.errors) console.error(`raiju: ${e}`)
    if (opened.errors.length > 0) return 1
    raw = opened.cfg
  } catch (e) {
    console.error(`raiju: encryption_key: ${e.message}`)
    return 1
  }
  if (cipher !== undefined) console.error("raiju: encryption at rest is on: secrets are sealed in the config file")
  // The store keeps the config as written (env.NAME references intact); the engine runs on a resolved copy.
  const store = new ConfigStore(args.config, raw)
  store.cipher = cipher
  let first = raw
  resolveConfig(&first)
  if (args.mode === "broker") return runBroker(first, args.host)
  reportConfig(args.config)
  const cfg = withBifrostGuardrails(await withSecrets(first), store, true)
  for (const p of aliasProblems(cfg)) console.error(`raiju: config: ${p}`)
  // crew routing (crew.tov): the pools, priors and classifier are checked and loaded here, relative to the config file's folder
  const crewProblems = configureCrews(cfg, path.dirname(args.config))
  for (const p of crewProblems) console.error(`raiju: config: ${p}`)
  if (crewProblems.length > 0) return 1
  // the MCP authorization server's state beside config.json: its signing key (generated when none is configured)
  // and its grants. It is opened before the workers start, so every worker signs with the same key.
  const stateNote = openIssuerState(cfg, path.join(path.dirname(args.config), "mcp-oauth-state.json"), cipher)
  if (stateNote !== "") console.error(`raiju: mcp oauth: ${stateNote}`)
  const engine = new Engine(cfg)
  const ops = new Ops(engine, store)
  // refreshed per-user OAuth tokens are saved to the config file
  engine.userTokenSaved = (r) => {
    saveUserToken(store, r)
  }
  // token_exchange admin credentials: renewed before they expire and after a 401, and saved to the config file
  engine.adminSaved = (r) => {
    saveExchangeAdmin(store, r)
  }
  // token_exchange admin credentials. Each is renewed by one node of the cluster (Ops.ownsAdmin) and by one worker of
  // that node at a time (the lease in the supervisor's share folder, shared by its workers). The renewed credential is
  // read back from the config file by the other workers, and sent to the other nodes through the cluster state with
  // its tokens sealed (every node must hold the same encryption_key for them to open it)
  // (process.pid is the supervisor's here, before the workers fork; ops.startLocalShare names the same folder)
  if (args.workers > 1 && args.server !== "http1") engine.adminLease = new FileLease("/tmp/raiju-" + process.pid + "/leases", FILE_LEASE_MS)
  // the closures below take a const copy of the cipher: a mutable local captured by a closure in this async function
  // does not compile
  const sealKey: ConfigCipher | undefined = cipher
  const configPath = args.config
  engine.adminOwns = (client: string): bool => ops.ownsAdmin(client)
  engine.adminStored = (client: string): McpUserToken | undefined => readStoredAdmin(configPath, sealKey, client)
  const publishAdmin = (r: McpUserToken): void => {
    try {
      clusterState().put("mcp.exchange_admin", r.mcp_client_name, sealAdminRow(sealKey, r))
    } catch (e) {
      console.error(`raiju: mcp ${r.mcp_client_name}: the admin credential could not be sent to the other nodes: ${e.message}`)
    }
  }
  engine.adminPublish = publishAdmin
  // the provider tokens behind realtime client secrets travel on the cluster state sealed the same way (a token that
  // could not be sealed is not kept, so its client secret does not open)
  setEkSeal((v: string): string => {
    try {
      return sealStored(sealKey, v)
    } catch (e) {
      return ""
    }
  }, (v: string): string | undefined => openStored(sealKey, v))
  setAdminPublished(publishAdmin)
  // a credential removed on another node (its client deleted, or its token exchange changed) is removed here too
  setAdminRemoved((client: string) => {
    clusterState().del("mcp.exchange_admin", client)
  })
  clusterState().onChange("mcp.exchange_admin", (client: string, value: string | undefined) => {
    if (value === undefined) {
      dropExchangeAdmin(store, client)
      return
    }
    const row = openAdminRow(sealKey, value)
    if (row === undefined || row.mcp_client_name !== client) return
    engine.adoptRemoteAdmin(row)
  })
  setAdminRenew(async (client: string, used: string): Promise<string> => await engine.renewAdminCredential(client, used))
  store.onChange = (c) => {
    applyChange(engine, ops, store, c)
  }
  const mcp = engine.mcp
  if (mcp !== undefined) {
    // an admin credential that ran out while the gateway was down is renewed before the clients connect
    await engine.renewDueAdmins()
    await mcp.connectAll()
    for (const s of mcp.status().filter((x) => !x.stdio)) console.error(`raiju: mcp ${s.name}: ${s.connected ? `${s.tools} tools` : `not connected (${s.error})`}`)
  }
  const providers = providerNames(engine.cfg)
  // bun (the default) is Tov's built-in server: multi-process workers, native WebSockets and,
  // with Tov's stream bodies, chunk-by-chunk streaming. http1 is the raw-socket fallback (one process).
  const server = args.server !== "" ? args.server : "bun"
  if (server === "http1" && args.workers > 1) console.error("raiju: the http1 server runs in one process; -workers needs -server bun")
  const maxBody = (cfg.client?.max_request_body_size_mb ?? 100) * 1048576
  // large_payload_optimization: bodies over its request threshold stream to the provider, and the gateway checks the sizes
  const lp = engine.large
  // the A2A gRPC settings (server.a2a_grpc_base_domain and a2a_grpc_port): the cards advertise the interface in every worker;
  // the listener is opened here in a single-process gateway, and in one bun worker after the fork otherwise (a2agrpc.tov)
  const grpcNote = setA2aGrpc(ops, cfg.server)
  if (grpcNote !== "") {
    console.error(`raiju: ${grpcNote}`)
    return 1
  }
  const grpcShared = server !== "http1" && args.workers > 1
  if (!grpcShared) listenA2aGrpc(ops, args.host, cfg.server)
  const url = server === "http1" ? startFront(engine, ops, { hostname: args.host, port: args.port, maxBodyBytes: lp === undefined ? maxBody : 1099511627776, streamThreshold: lp === undefined ? 0 : Math.max(1, lp.requestThreshold), limitBytes: lp === undefined ? 0 : maxBody }) : start(engine, ops, { port: args.port, hostname: args.host, workers: args.workers, maxBodyBytes: maxBody })
  // Runs once the server is up: with -workers, in every worker after the fork.
  const supervisor = process.pid
  setTimeout(() => {
    if (process.pid !== supervisor) {
      ops.startLocalShare(supervisor)
      ops.startA2aRelay()
      // the card timer runs in every worker; one of them per node takes each period's turn (ops.cardTick)
      ops.startCardRefresh()
      // one of the workers opens the gRPC listener (the lease in the share folder)
      if (grpcShared) claimA2aGrpc(ops, args.host, cfg.server, ops.shareDir)
    } else if (server === "http1" || args.workers <= 1) {
      ops.startExpirySweep()
      ops.startA2aRelay()
      ops.startCardRefresh()
    }
    // each worker starts its own stdio MCP servers
    if (mcp !== undefined) startStdio(mcp)
  }, 0)
  console.error(`raiju listening on ${url} (${providers.length} providers: ${providers.join(", ")}; ${args.workers} worker${args.workers === 1 ? "" : "s"})`)
  return 0
}
