// Address checks shared by the outbound callers that must not reach internal hosts: webhook
// endpoints (webhooks.tov) and MCP servers marked require_public_target (mcp.tov). A leaf module,
// so the callers can import it without a cycle through the config types.

// Hosts and address ranges that are private or local: loopback, RFC 1918, carrier-grade NAT,
// IPv6 unique-local and link-local, and localhost names.
export function isPrivateHost(h: string): bool {
  if (h === "localhost" || h.endsWith(".localhost") || h === "[::1]" || h === "::1") return true
  if (h.startsWith("127.") || h.startsWith("10.") || h.startsWith("192.168.")) return true
  if (h.startsWith("[fc") || h.startsWith("[fd") || h.startsWith("[fe80")) return true
  if (h.startsWith("172.")) {
    const second = parseInt(h.split(".")[1] ?? "")
    if (second !== undefined && second >= 16 && second <= 31) return true
  }
  if (h.startsWith("100.")) {
    const second = parseInt(h.split(".")[1] ?? "")
    if (second !== undefined && second >= 64 && second <= 127) return true
  }
  return false
}

// Link-local and cloud metadata addresses: refused even when private addresses are allowed.
export function isMetadataHost(h: string): bool {
  return h.startsWith("169.254.") || h === "0.0.0.0" || h === "metadata.google.internal" || h === "fd00:ec2::254"
}

// The reason a target URL is refused for a caller that may reach only public addresses, or "".
// allow lists the hosts that may be reached even when private (oauth_private_allowlist); the
// metadata addresses are refused whatever the list says.
export function targetProblem(raw: string, allow: string[]): string {
  const u = URL.parse(raw)
  if (u === undefined) return "url is not a valid URL"
  const host = u.hostname
  if (isMetadataHost(host)) return "link-local and metadata addresses are not allowed"
  if (allow.includes(host)) return ""
  if (isPrivateHost(host)) return "url points at a private address"
  return ""
}

test("target URLs must be public unless the host is allowed", () => {
  expect(targetProblem("https://mcp.example.com/mcp", [])).toBe("")
  expect(targetProblem("http://127.0.0.1:9/mcp", [])).toBe("url points at a private address")
  expect(targetProblem("http://127.0.0.1:9/mcp", ["127.0.0.1"])).toBe("")
  expect(targetProblem("http://169.254.169.254/x", ["169.254.169.254"])).toBe("link-local and metadata addresses are not allowed")
  expect(targetProblem("not a url", [])).toBe("url is not a valid URL")
})

test("private and metadata hosts", () => {
  expect(isPrivateHost("127.0.0.1")).toBe(true)
  expect(isPrivateHost("localhost")).toBe(true)
  expect(isPrivateHost("172.20.0.1")).toBe(true)
  expect(isPrivateHost("172.40.0.1")).toBe(false)
  expect(isPrivateHost("100.64.1.1")).toBe(true)
  expect(isPrivateHost("mcp.example.com")).toBe(false)
  expect(isMetadataHost("169.254.169.254")).toBe(true)
  expect(isMetadataHost("10.0.0.1")).toBe(false)
})
