// Text to numbers, in one place. Every module reads numbers out of text through these two
// functions, so what counts as a number is decided once:
//
// - strToInt reads a leading integer, as JavaScript's parseInt does: whitespace, a sign, then
//   digits of the base, stopping at the first other character ("12abc" is 12). Without a base
//   the text is decimal, or hexadecimal after "0x". The result keeps every digit of a 64-bit
//   integer; text with no digit, and a value that does not fit in 64 bits, is undefined.
// - strToFloat reads a whole decimal number: optional whitespace around a sign, digits with an
//   optional fraction and exponent, or "Infinity". Anything else ("", "1.5abc", "0x1f", "NaN")
//   is undefined.

export function strToInt(s: string, radix?: int): int | undefined {
  return parseInt(s, radix ?? 0)
}

export function strToFloat(s: string): f64 | undefined {
  return parseFloat(s)
}

test("strToInt reads a leading integer and refuses text without one", () => {
  expect(strToInt("42")).toBe(42)
  expect(strToInt("-42")).toBe(-42)
  expect(strToInt("+7")).toBe(7)
  expect(strToInt("  12")).toBe(12)
  expect(strToInt("\t\n12")).toBe(12)
  expect(strToInt("12abc")).toBe(12)
  expect(strToInt("12.9")).toBe(12)
  expect(strToInt("12 ")).toBe(12)
  expect(strToInt("007")).toBe(7)
  expect(strToInt("0")).toBe(0)
  expect(strToInt("-0")).toBe(0)
  expect(strToInt("") === undefined).toBe(true)
  expect(strToInt("   ") === undefined).toBe(true)
  expect(strToInt("abc") === undefined).toBe(true)
  expect(strToInt("-") === undefined).toBe(true)
  expect(strToInt("+-1") === undefined).toBe(true)
  expect(strToInt(".5") === undefined).toBe(true)
  expect(strToInt("é1") === undefined).toBe(true)
  expect(strToInt("1é")).toBe(1)
  expect(strToInt("١٢") === undefined).toBe(true)
  expect(strToInt("NaN") === undefined).toBe(true)
  expect(strToInt("Infinity") === undefined).toBe(true)
})

test("strToInt keeps every digit of a 64-bit integer and refuses one that does not fit", () => {
  expect(strToInt("9007199254740992")).toBe(9007199254740992)
  expect(strToInt("9007199254740993")).toBe(9007199254740993)
  expect(strToInt("-9007199254740993")).toBe(-9007199254740993)
  expect(strToInt("1234567890123456789")).toBe(1234567890123456789)
  expect(strToInt("9223372036854775807")).toBe(9223372036854775807)
  expect(strToInt("  9223372036854775807xyz")).toBe(9223372036854775807)
  expect(strToInt("-9223372036854775807")).toBe(-9223372036854775807)
  expect(strToInt("-9223372036854775808")).toBe(-9223372036854775807 - 1)
  expect(strToInt("9223372036854775808") === undefined).toBe(true)
  expect(strToInt("-9223372036854775809") === undefined).toBe(true)
  expect(strToInt("99999999999999999999999") === undefined).toBe(true)
  expect(strToInt("0x7fffffffffffffff")).toBe(9223372036854775807)
  expect(strToInt("7fffffffffffffff", 16)).toBe(9223372036854775807)
  expect(strToInt("7FFFFFFFFFFFFFFE", 16)).toBe(9223372036854775806)
  expect(strToInt("8000000000000000", 16) === undefined).toBe(true)
  expect(strToInt("-8000000000000000", 16)).toBe(-9223372036854775807 - 1)
})

test("strToInt reads other bases", () => {
  expect(strToInt("ff", 16)).toBe(255)
  expect(strToInt("FF", 16)).toBe(255)
  expect(strToInt("0xff", 16)).toBe(255)
  expect(strToInt("0xff")).toBe(255)
  expect(strToInt("-0x10")).toBe(-16)
  expect(strToInt("0x") === undefined).toBe(true)
  expect(strToInt("0x10", 10)).toBe(0)
  expect(strToInt("101", 2)).toBe(5)
  expect(strToInt("102", 2)).toBe(2)
  expect(strToInt("2", 2) === undefined).toBe(true)
  expect(strToInt("zz", 36)).toBe(1295)
  expect(strToInt("17", 8)).toBe(15)
  expect(strToInt("g", 16) === undefined).toBe(true)
  expect(strToInt("10", 1) === undefined).toBe(true)
  expect(strToInt("10", 37) === undefined).toBe(true)
})

test("strToFloat reads a whole decimal number and refuses anything else", () => {
  expect(strToFloat("1.5")).toBe(1.5)
  expect(strToFloat("-1.5")).toBe(-1.5)
  expect(strToFloat("+2")).toBe(2.0)
  expect(strToFloat("  3.25  ")).toBe(3.25)
  expect(strToFloat(".5")).toBe(0.5)
  expect(strToFloat("5.")).toBe(5.0)
  expect(strToFloat("1e3")).toBe(1000.0)
  expect(strToFloat("1E-2")).toBe(0.01)
  expect(strToFloat("1.5e+2")).toBe(150.0)
  expect(strToFloat("0")).toBe(0.0)
  expect(strToFloat("9007199254740993")).toBe(9007199254740992.0)
  expect(strToFloat("Infinity")! > 1e308).toBe(true)
  expect(strToFloat("-Infinity")! < -1e308).toBe(true)
  expect(strToFloat("1e999")! > 1e308).toBe(true)
  expect(strToFloat("") === undefined).toBe(true)
  expect(strToFloat("   ") === undefined).toBe(true)
  expect(strToFloat(".") === undefined).toBe(true)
  expect(strToFloat("-") === undefined).toBe(true)
  expect(strToFloat("e5") === undefined).toBe(true)
  expect(strToFloat("1e") === undefined).toBe(true)
  expect(strToFloat("1e+") === undefined).toBe(true)
  expect(strToFloat("1.5abc") === undefined).toBe(true)
  expect(strToFloat("1.5 2") === undefined).toBe(true)
  expect(strToFloat("1,5") === undefined).toBe(true)
  expect(strToFloat("0x1f") === undefined).toBe(true)
  expect(strToFloat("0b11") === undefined).toBe(true)
  expect(strToFloat("1_000") === undefined).toBe(true)
  expect(strToFloat("NaN") === undefined).toBe(true)
  expect(strToFloat("infinity") === undefined).toBe(true)
  expect(strToFloat("Infinityx") === undefined).toBe(true)
  expect(strToFloat("1é") === undefined).toBe(true)
  expect(strToFloat("١") === undefined).toBe(true)
  expect(strToFloat("1.2.3") === undefined).toBe(true)
  expect(strToFloat("--1") === undefined).toBe(true)
})
