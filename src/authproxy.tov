const EC_Y: bigint = 57010252108148945031621947102177812533038713903682107994991377745564634299747n
const EC_TOKEN = "eyJhbGciOiJFUzI1NiIsImtpZCI6ImVjLXRlc3QtMSIsInR5cCI6IkpXVCJ9.eyJleHAiOjE3OTIwNzg0NDIsImlhdCI6MTc5MjA3Nzg0Miwic2lnbmVyIjoiYXJuOmF3czplbGFzdGljbG9hZGJhbGFuY2luZzp1cy1lYXN0LTE6MTIzNDU2Nzg5MDEyOmxvYWRiYWxhbmNlci9hcHAvbXktYWxiLzUwZGM2YzQ5NWMwYzkxODgiLCJpc3MiOiJodHRwczovL29pZGMuZXhhbXBsZSIsImVtYWlsIjoiYWxpY2VAZXhhbXBsZS5jb20iLCJzdWIiOiJ1LTEifQ.fdE4u7_E3z2viRJgPXQeaWDTikonYXEhGnu2HmTXgxPrBOXdYMTGn_EKDMwT-1xj7ud3h4YP3t2UBDh20C7N1Q"
const EC_NOW_MS: f64 = 1792077842000.0
const ALB_ARN = "arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/app/my-alb/50dc6c495c0c9188"
const RSA_TOKEN = "eyJhbGciOiJSUzI1NiIsImtpZCI6InJzYS10ZXN0LTEiLCJ0eXAiOiJKV1QifQ.eyJleHAiOjE3OTIwNzg0NDIsIm5iZiI6MTc5MjA3NzgzMiwiaXNzIjoiaHR0cHM6Ly90ZWFtLmNsb3VkZmxhcmVhY2Nlc3MuY29tIiwiYXVkIjpbImF1ZC1hcHAtMSJdLCJlbWFpbCI6ImJvYkBleGFtcGxlLmNvbSIsImdyb3VwcyI6WyJlbmciLCJvcHMiXSwic3ViIjoidS0yIn0.LyX6gyXnjQ8lQ9wQqALcepAe9v09FunGtcNH4mvh6V20T1HCEe9JRRzQWCyeYZ2uUyodBbQmEYn6gsGmNroN95nOSl-TX13AidlsB2AT6ilHT9pVZpys2LrqTnv8jOYto_02kdA1UCy0Yjkmns6uP9_yzbhOg0ubdiatsToiXg0XrqVnEwFFQ4ggdLdejNHU93NCsspzM9C3FrAi5zh-3zsI0kXgJyQ0vpo8Dnz8IEUE_3uIdSsNW5uwInalffpa2B5aZL81JOlGr2hhUwCSHsc5CV-tjC-rqKjIaruc3_uN7c86tGRhf_wa4CmgLbSG2U4ko3WVHjkBnPoMWE8QPw"
const RSA_JWKS = `{"keys":[{"kty":"RSA","kid":"rsa-test-1","alg":"RS256","use":"sig","n":"m1vvBb1AQThPXvJWNO2Tzpl-iMqVMQtKHblj65kEiQbgG3NWekGsIog9kXL_zbrLcuudf6CiVRmftbRZKBhjxQtU2Od4lbLf1eMjvraJuKj32NiImE4Q5hrXdUSIgl2DhrJpHR7-tybtUmBGlfNHp1IFatkPDu_Otmd7Kv2ZUB5yYtmy9ppThfvj51Ua0LZcU-MUPhqSAZ2dKC9CieDk6MrPy5mpxGpaUeF5zu_E6bO3PSolGjFw0hasnptzHZl7DPRA2278qH4bTYakWOSt9-v5ufEaBElKrmRMgIFmsJmr_hXMJJ5fWTza-Pi7xUZsINPaX1zyciILj1g-Ti82kw","e":"AQAB"}]}`
const RSA_NOW_MS: f64 = 1792077842000.0

function albCfg(): AuthProxyConfig {
  return { enabled: true, provider: "aws-alb", expected_signer: ALB_ARN }
}

function cfCfg(): AuthProxyConfig {
  return { enabled: true, provider: "cloudflare-access", issuer_url: "https://team.cloudflareaccess.com", audience: "aud-app-1" }
}

// A key store with the given keys preloaded (no network in tests).
function loaded(cfg: AuthProxyConfig, kid: string, key: ProxyKey): ProxyKeys {
  const ks = new ProxyKeys(cfg)
  ks.put(kid, key)
  return ks
}

test("reads an EC P-256 public key from PEM", () => {
  const k = try keyFromPem(EC_PEM)
  expect(k.kind).toBe("ec")
  if (k.kind === "ec") {
    expect(k.x).toBe(EC_X)
    expect(k.y).toBe(EC_Y)
  }
})

test("rejects a PEM that is not a public key", () => {
  let threw = false
  try {
    const k = try keyFromPem("not a key")
    expect(k.kind).toBe("ec")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("verifies an ES256 token and rejects a changed one", () => {
  const cfg: AuthProxyConfig = albCfg()
  const ks = loaded(cfg, "ec-test-1", { kind: "ec", x: EC_X, y: EC_Y })
  const ok = checkProxyToken(cfg, ks, EC_TOKEN, EC_NOW_MS)
  expect(ok.kind).toBe("ok")
  if (ok.kind === "ok") expect(ok.identity).toBe("alice@example.com")
  // a different payload under the same signature
  const parts = EC_TOKEN.split(".")
  const forged = parts[0]! + "." + parts[1]!.slice(0, 10) + "A" + parts[1]!.slice(11) + "." + parts[2]!
  expect(checkProxyToken(cfg, ks, forged, EC_NOW_MS).kind).toBe("error")
  // a different key rejects it
  const other = loaded(cfg, "ec-test-1", { kind: "ec", x: EC_Y, y: EC_X })
  expect(checkProxyToken(cfg, other, EC_TOKEN, EC_NOW_MS).kind).toBe("error")
})

test("ES256 checks the signer, expiry and not-before", () => {
  const cfg = albCfg()
  const ks = loaded(cfg, "ec-test-1", { kind: "ec", x: EC_X, y: EC_Y })
  const wrong: AuthProxyConfig = { enabled: true, provider: "aws-alb", expected_signer: "arn:aws:elasticloadbalancing:us-east-1:1:loadbalancer/app/other/1" }
  expect(checkProxyToken(wrong, ks, EC_TOKEN, EC_NOW_MS).kind).toBe("error")
  expect(checkProxyToken(cfg, ks, EC_TOKEN, EC_NOW_MS + 3600000.0).kind).toBe("error")
})

test("an unknown kid asks for its key", () => {
  const cfg = albCfg()
  const ks = new ProxyKeys(cfg)
  const r = checkProxyToken(cfg, ks, EC_TOKEN, EC_NOW_MS)
  expect(r.kind).toBe("unknown")
  if (r.kind === "unknown") expect(r.kid).toBe("ec-test-1")
})

test("builds the ALB key URL and refuses odd key ids", () => {
  expect(regionOf(ALB_ARN)).toBe("us-east-1")
  expect(try albKeyUrl(albCfg(), "ec-test-1")).toBe("https://public-keys.auth.elb.us-east-1.amazonaws.com/ec-test-1")
  expect(try albKeyUrl({ enabled: true, provider: "aws-alb", region: "us-gov-west-1", expected_signer: ALB_ARN }, "k")).toBe("https://public-keys.auth.elb.us-gov-west-1.amazonaws.com/k")
  let refused = false
  try {
    const u = try albKeyUrl(albCfg(), "../x")
    expect(u).toBe("")
  } catch (e) {
    refused = true
  }
  expect(refused).toBe(true)
})

test("verifies an RS256 token from a JWKS", () => {
  const cfg = cfCfg()
  const ks = new ProxyKeys(cfg)
  for (const k of try keysFromJwks(RSA_JWKS)) ks.put(k.kid, k.key)
  const r = checkProxyToken(cfg, ks, RSA_TOKEN, RSA_NOW_MS)
  expect(r.kind).toBe("ok")
  if (r.kind === "ok") {
    expect(r.identity).toBe("bob@example.com")
    const rm: Record<string, string> = new Map()
  rm.set("ops", "auditor")
  expect(try mappedRole(r.claims, "groups", rm, undefined)).toBe("auditor")
  }
  const badAud: AuthProxyConfig = { enabled: true, provider: "cloudflare-access", issuer_url: "https://team.cloudflareaccess.com", audience: "other" }
  expect(checkProxyToken(badAud, ks, RSA_TOKEN, RSA_NOW_MS).kind).toBe("error")
  const badIss: AuthProxyConfig = { enabled: true, provider: "cloudflare-access", issuer_url: "https://evil.cloudflareaccess.com", audience: "aud-app-1" }
  expect(checkProxyToken(badIss, ks, RSA_TOKEN, RSA_NOW_MS).kind).toBe("error")
})

test("the generic provider takes RS256 and ES256 by key", () => {
  const gen: AuthProxyConfig = { enabled: true, provider: "generic", header_name: "X-Forwarded-Assertion", issuer_url: "https://team.cloudflareaccess.com", audience: "aud-app-1" }
  const ks = new ProxyKeys(gen)
  for (const k of try keysFromJwks(RSA_JWKS)) ks.put(k.kid, k.key)
  expect(checkProxyToken(gen, ks, RSA_TOKEN, RSA_NOW_MS).kind).toBe("ok")
  // an ES256 token against an RSA key is refused
  const ec = loaded({ enabled: true, provider: "generic", header_name: "h", issuer_url: "https://x.example", audience: "a" }, "ec-test-1", { kind: "ec", x: EC_X, y: EC_Y })
  expect(checkProxyToken({ enabled: true, provider: "generic", header_name: "h", issuer_url: "https://team.cloudflareaccess.com", audience: "aud-app-1" }, ec, RSA_TOKEN, RSA_NOW_MS).kind).toBe("unknown")
})

test("validates the proxy settings", () => {
  expect(proxyProblem(albCfg())).toBe("")
  expect(proxyProblem({ enabled: true, provider: "aws-alb" })).toBe("aws-alb needs expected_signer, the load balancer's ARN")
  expect(proxyProblem({ enabled: true, provider: "aws-alb", expected_signer: ALB_ARN, public_key_base_url: "http://keys.example" })).toBe("aws-alb: public_key_base_url must be https")
  expect(proxyProblem(cfCfg())).toBe("")
  expect(proxyProblem({ enabled: true, provider: "cloudflare-access", issuer_url: "https://t.example" })).toBe("cloudflare-access: audience or allowed_audiences is required")
  expect(proxyProblem({ enabled: true, provider: "generic", issuer_url: "https://t.example", audience: "a" })).toBe("generic: header_name is required")
  expect(proxyProblem({ enabled: true, provider: "saml", issuer_url: "https://t.example", audience: "a" })).toBe("provider saml is not aws-alb, cloudflare-access or generic")
  expect(proxyProblem({ enabled: true, provider: "aws-alb", expected_signer: ALB_ARN, mode: "admin" })).toBe("mode admin is not login_only or full")
})

test("picks the header and the JWKS URL", () => {
  expect(headerOf(albCfg())).toBe("x-amzn-oidc-data")
  expect(headerOf(cfCfg())).toBe("Cf-Access-Jwt-Assertion")
  expect(jwksUrl(cfCfg())).toBe("https://team.cloudflareaccess.com/cdn-cgi/access/certs")
  expect(jwksUrl({ enabled: true, provider: "generic", issuer_url: "https://auth.example/", audience: "a", header_name: "h" })).toBe("https://auth.example/.well-known/openid-configuration")
})

test("maps groups to roles, with a default", () => {
  const claims = try fields(`{"groups":["eng","ops"],"email":"x"}`)
  const map: Record<string, string> = new Map()
  map.set("ops", "editor")
  map.set("eng", "viewer")
  // the first group in claim order that maps wins
  expect(try mappedRole(claims, undefined, map, undefined)).toBe("viewer")
  expect(try mappedRole(claims, "roles", map, "auditor")).toBe("auditor")
  expect(try mappedRole(claims, "roles", map, undefined)).toBe(undefined)
})

