  { name: "raiju_crew_outcomes_total", text: "Attempt outcomes recorded, by pool, class and verifier (pass, fail or none) (Raiju extra)." },
  { name: "raiju_crew_outcome_quality", text: "Quality of the recorded attempt outcomes, by pool and class; the mean is the sum over the count (Raiju extra)." },
  { name: "raiju_crew_task_cost_usd", text: "Cost in USD of each completed crew task (the log rows of all its attempts), by pool (Raiju extra)." },
  { name: "raiju_crew_lambda", text: "The quality-per-dollar multiplier lambda in use for a pool's class (Raiju extra)." },
  { name: "raiju_crew_subscription_phi", text: "Remaining quota fraction phi of a crew subscription in its window; 1 when unused (Raiju extra)." },
]

function helpFor(name: string): string {
  for (const h of HELP) if (h.name === name) return h.text
  return ""
}

class Histogram {
  counts: int[] = []
  sum = 0.0
  count = 0
  constructor(readonly b: Buckets) {
    for (const _b of b.bounds) this.counts.push(0)
  }
  observe(v: f64): void {
    for (let i = 0; i < this.b.bounds.length; i++) {
      if (v <= this.b.bounds[i]!) this.counts[i] = this.counts[i]! + 1
    }
    this.sum += v
    this.count += 1
  }
}

class Registry {
  counters: Map<string, f64> = new Map()
  histograms: Map<string, Histogram> = new Map()
  gauges: Map<string, f64> = new Map()
}

const reg = new Registry()

function esc(v: string): string {
  if (!v.includes("\\") && !v.includes("\"") && !v.includes("\n")) return v
  return v.replaceAll("\\", "\\\\").replaceAll("\"", "\\\"").replaceAll("\n", "\\n")
}

function seriesKey(name: string, labels: string): string {
  return name + "{" + labels + "}"
}

export function inc(name: string, labels: string, by: f64): void {
  const k = seriesKey(name, labels)
  reg.counters.set(k, (reg.counters.get(k) ?? 0.0) + by)
}

export function setGauge(name: string, labels: string, v: f64): void {
  reg.gauges.set(seriesKey(name, labels), v)
}

export function addGauge(name: string, labels: string, by: f64): void {
  const k = seriesKey(name, labels)
  reg.gauges.set(k, (reg.gauges.get(k) ?? 0.0) + by)
}

export function observe(name: string, labels: string, v: f64): void {
  const k = seriesKey(name, labels)
  let h = reg.histograms.get(k)
  if (h === undefined) {
    const nh = new Histogram(bucketsFor(name))
    reg.histograms.set(k, nh)
    h = nh
  }
  h.observe(v)
}

function splitKey(k: string): { name: string, labels: string } {
  const i = k.indexOf("{")
  return { name: k.slice(0, i), labels: k.slice(i + 1, k.byteLength - 1) }
}

function withLabel(labels: string, extra: string): string {
  if (labels === "") return "{" + extra + "}"
  return "{" + labels + "," + extra + "}"
}

function braces(labels: string): string {
  return labels === "" ? "" : "{" + labels + "}"
}

function typeHeader(inout out: string[], inout typed: Set<string>, name: string, kind: string): void {
  if (typed.has(name)) return
  typed.add(name)
  const help = helpFor(name)
  if (help !== "") out.push(`# HELP ${name} ${help}`)
  out.push(`# TYPE ${name} ${kind}`)
}

export function render(): string {
  let out: string[] = []
  let typed: Set<string> = new Set()
  for (const k of reg.counters.keys()) {
    const s = splitKey(k)
    typeHeader(&out, &typed, s.name, "counter")
    out.push(`${s.name}${braces(s.labels)} ${reg.counters.get(k) ?? 0.0}`)
  }
  for (const k of reg.gauges.keys()) {
    const s = splitKey(k)
    typeHeader(&out, &typed, s.name, "gauge")
    out.push(`${s.name}${braces(s.labels)} ${reg.gauges.get(k) ?? 0.0}`)
  }
  for (const k of reg.histograms.keys()) {
    const s = splitKey(k)
    const h = reg.histograms.get(k)!
    typeHeader(&out, &typed, s.name, "histogram")
    for (let i = 0; i < h.b.bounds.length; i++) {
      out.push(`${s.name}_bucket${withLabel(s.labels, `le="${h.b.les[i]!}"`)} ${h.counts[i]!}`)
    }
    out.push(`${s.name}_bucket${withLabel(s.labels, `le="+Inf"`)} ${h.count}`)
    out.push(`${s.name}_sum${braces(s.labels)} ${h.sum}`)
    out.push(`${s.name}_count${braces(s.labels)} ${h.count}`)
  }
  return out.join("\n") + "\n"
}

function sampleName(k: string): string {
  const i = k.indexOf("{")
  return i < 0 ? k : k.slice(0, i)
}

// Histogram samples (_bucket, _sum, _count) belong to the histogram's family.
function familyOf(name: string, kinds: Map<string, string>): string {
  if (kinds.has(name)) return name
  for (const suf of ["_bucket", "_sum", "_count"]) {
    if (name.endsWith(suf)) {
      const base = name.slice(0, name.byteLength - suf.byteLength)
      if (kinds.get(base) === "histogram") return base
    }
  }
  return name
}

// Gauges every worker reports alike (the pool's multiplier and the subscriptions' quota fractions come from the
// cluster state and the shared logs): the merge keeps the largest instead of summing them.
const MAX_MERGED: string[] = ["raiju_crew_lambda", "raiju_crew_subscription_phi"]

// Several workers' expositions as one: every sample summed by series, each family's HELP and
// TYPE once, and each family's samples kept together (even when workers saw different series).
export function mergeRendered(texts: string[]): string {
  const kinds: Map<string, string> = new Map()
  const hdr: Map<string, string> = new Map()
  const hdrSeen: Set<string> = new Set()
  const famOrder: string[] = []
  const values: Map<string, f64> = new Map()
  const keyOrder: string[] = []
  for (const t of texts) {
    for (const line of t.split("\n")) {
      if (line === "") continue
      if (line.startsWith("# TYPE ") || line.startsWith("# HELP ")) {
        const parts = line.split(" ")
        const fam = parts[2] ?? ""
        if (fam === "" || hdrSeen.has(line)) continue
        hdrSeen.add(line)
        if (line.startsWith("# TYPE ")) kinds.set(fam, parts[3] ?? "")
        if (!hdr.has(fam)) famOrder.push(fam)
        hdr.set(fam, (hdr.get(fam) ?? "") + line + "\n")
        continue
      }
      if (line.startsWith("#")) continue
      let sp = line.byteLength - 1
      while (sp > 0 && line.slice(sp, sp + 1) !== " ") sp -= 1
      if (sp <= 0) continue
      const key = line.slice(0, sp)
      const v = parseFloat(line.slice(sp + 1))
      if (v === undefined) continue
      const cur = values.get(key)
      if (cur === undefined) {
        keyOrder.push(key)
        values.set(key, v)
      } else {
        values.set(key, MAX_MERGED.includes(sampleName(key)) ? Math.max(cur, v) : cur + v)
      }
    }
  }
  const famOf: Map<string, string> = new Map()
  const extra: string[] = []
  const extraSeen: Set<string> = new Set()
  for (const k of keyOrder) {
    const fam = familyOf(sampleName(k), kinds)
    famOf.set(k, fam)
    if (!hdr.has(fam) && !extraSeen.has(fam)) {
      extraSeen.add(fam)
      extra.push(fam)
    }
  }
  const fams: string[] = []
  for (const f of famOrder) fams.push(f)
  for (const f of extra) fams.push(f)
  let out = ""
  for (const fam of fams) {
    out += hdr.get(fam) ?? ""
    for (const k of keyOrder) {
      if (famOf.get(k) === fam) out += `${k} ${values.get(k) ?? 0.0}\n`
    }
  }
  return out
}

const labelCache: Map<string, string> = new Map()

// Raiju's own labels (provider, model, status) for the raiju_* families.
export function labels(provider: string, model: string, status: string): string {
  const k = provider + "\u0000" + model + "\u0000" + status
  const hit = labelCache.get(k)
  if (hit !== undefined) return hit
  const text = `provider="${esc(provider)}",model="${esc(model)}",status="${esc(status)}"`
  if (labelCache.size < 100000) labelCache.set(k, text)
  return text
}

// --- Bifrost request labels ---

// One record per request, filled by the gateway as the request is routed. Each field maps to a
// Bifrost enrichment dimension (metric tier) of the same meaning. Unset fields are "" and render
// as empty label values, as Bifrost does. Build with newLabels(); set fields on a `let` copy.
export type RequestLabels = {
  provider: string, model: string, method: string,
  alias: string, app: string, routingEngineUsed: string,
  virtualKeyId: string, virtualKeyName: string,
  selectedKeyId: string, selectedKeyName: string,
  routingRuleId: string, routingRuleName: string,
  complexityTier: string, complexityMechanism: string,
  teamId: string, teamName: string,
  customerId: string, customerName: string,
  businessUnitId: string, businessUnitName: string,
  projectId: string, projectName: string,
  fallbackIndex: string,
  // the end user, as user_labels_enabled reports it (empty when there is none)
  userId: string, userName: string,
  // values of client.prometheus_labels, in the configured order (see setCustomLabels)
  custom: string[],
}

// Base label names, in Bifrost's order (the metric-safe enrichment dimensions).
const BASE_NAMES: string[] = [
  "provider", "model", "method", "alias", "app", "routing_engine_used",
  "virtual_key_id", "virtual_key_name", "selected_key_id", "selected_key_name",
  "routing_rule_id", "routing_rule_name", "complexity_tier", "complexity_mechanism",
  "team_id", "team_name", "customer_id", "customer_name",
  "business_unit_id", "business_unit_name", "project_id", "project_name", "fallback_index",
]

function baseValues(l: RequestLabels): string[] {
  const vals = [
    l.provider, l.model, l.method, l.alias, l.app, l.routingEngineUsed,
    l.virtualKeyId, l.virtualKeyName, l.selectedKeyId, l.selectedKeyName,
    l.routingRuleId, l.routingRuleName, l.complexityTier, l.complexityMechanism,
    l.teamId, l.teamName, l.customerId, l.customerName,
    l.businessUnitId, l.businessUnitName, l.projectId, l.projectName, l.fallbackIndex,
  ]
  if (userLabels) vals.push(l.userId, l.userName)
  for (const v of l.custom) vals.push(v)
  return vals
}

// Telemetry's two switches (the telemetry plugin's options, see setTelemetry). The overhead split is off
// by default, as in Bifrost; user_id and user_name are opt-in because each user is a series.
let overheadBreakdown = false
let userLabels = false

export function setTelemetry(overheadSplit: bool, users: bool): void {
  overheadBreakdown = overheadSplit
  userLabels = users
  baseCache.clear()
}

const baseCache: Map<string, string> = new Map()

// client.prometheus_labels: extra label names on the bifrost_* request families. Each one is filled
// per request from the x-bf-dim-<name> header (customValues), as Bifrost's telemetry plugin does.
// Names that are not valid label names, that repeat, or that clash with a built-in label are dropped.
let customNames: string[] = []

const RESERVED_LABELS: string[] = ["status", "path", "is_success", "status_code", "error_type", "cache_type", "le"]

function validLabelName(n: string): bool {
  if (n === "") return false
  for (let i = 0; i < n.byteLength; i++) {
    const c = n.slice(i, i + 1)
    const ok = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".includes(c) || (i > 0 && "0123456789".includes(c))
    if (!ok) return false
  }
  return true
}

export function setCustomLabels(names: string[]): void {
  const out: string[] = []
  for (const n of names) {
    if (!validLabelName(n) || BASE_NAMES.includes(n) || RESERVED_LABELS.includes(n) || out.includes(n)) continue
    out.push(n)
  }
  customNames = out
  baseCache.clear()
}

// The custom label values of a request, in the configured order ("" when the header is absent).
export function customValues(h: Map<string, string>): string[] {
  const out: string[] = []
  for (const n of customNames) out.push(h.get("x-bf-dim-" + n.toLowerCase()) ?? "")
  return out
}

// The same values, read from the request's headers, for the http_* families.
export function httpCustomValues(headers: Headers): string[] {
  const out: string[] = []
  for (const n of customNames) out.push(headers.get("x-bf-dim-" + n.toLowerCase()) ?? "")
  return out
}

// The rendered base label set for a request, built once per distinct combination.
export function baseLabels(l: RequestLabels): string {
  const vals = baseValues(l)
  const k = vals.join("\u0000")
  const hit = baseCache.get(k)
  if (hit !== undefined) return hit
  const names: string[] = (userLabels ? BASE_NAMES.concat(["user_id", "user_name"]) : BASE_NAMES).concat(customNames)
  let text = ""
  for (let i = 0; i < names.length; i++) {
    if (i > 0) text += ","
    text += `${names[i]!}="${esc(vals[i] ?? "")}"`
  }
  if (baseCache.size < 100000) baseCache.set(k, text)
  return text
}

export function newLabels(provider: string, model: string, method: string): RequestLabels {
  return {
    provider: provider, model: model, method: method,
    alias: "", app: "", routingEngineUsed: "",
    virtualKeyId: "", virtualKeyName: "", selectedKeyId: "", selectedKeyName: "",
    routingRuleId: "", routingRuleName: "", complexityTier: "", complexityMechanism: "",
    teamId: "", teamName: "", customerId: "", customerName: "",
    businessUnitId: "", businessUnitName: "", projectId: "", projectName: "",
    fallbackIndex: "", userId: "", userName: "", custom: [],
  }
}

// How one request ended. status is the effective HTTP status (Bifrost's status_code);
// errorType is one of Bifrost's closed error_type values (see docs/features/observability/prometheus.mdx).
// retries is the number of retries the request used.
export type Outcome = { ok: bool, status: int, errorType: string, retries: f64 }

// Bifrost's error_type for a failure with an HTTP status (the Inferred rows of Bifrost's
// error vocabulary). "" for statuses that do not map; use a declared type when the code knows it.
export function errorTypeForStatus(status: int): string {
  if (status === 499) return "caller_cancelled"
  if (status === 504) return "provider_timeout"
  if (status === 401 || status === 403) return "provider_auth_failed"
  if (status === 402) return "provider_billing"
  if (status === 429) return "provider_rate_limited"
  if (status === 503 || status === 529) return "provider_overloaded"
  if (status === 404) return "caller_model_unknown"
  if (status >= 400 && status < 500) return "caller_invalid_request"
  if (status >= 500) return "provider_server_error"
  return ""
}

// One call per request, once the outcome is known. upstreamSeconds is the provider call time.
// Feeds bifrost_upstream_requests_total, bifrost_upstream_latency_seconds (is_success),
// bifrost_success_requests_total or bifrost_error_requests_total, and bifrost_request_retries.
export function observeRequest(l: RequestLabels, o: Outcome, upstreamSeconds: f64): void {
  const base = baseLabels(l)
  inc("bifrost_upstream_requests_total", base, 1.0)
  const isSuccess = o.ok ? "true" : "false"
  observe("bifrost_upstream_latency_seconds", base + `,is_success="${isSuccess}"`, upstreamSeconds)
  if (o.ok) {
    inc("bifrost_success_requests_total", base, 1.0)
  } else {
    inc("bifrost_error_requests_total", base + `,status_code="${o.status}",error_type="${esc(o.errorType)}"`, 1.0)
  }
  observe("bifrost_request_retries", base, o.retries)
}

// Token counts and cost of a finished request. Cache counts and cost are only recorded when > 0,
// as Bifrost does. cacheWrite5m and cacheWrite1h are subsets of cacheWrite.
export type Usage = {
  input: f64, output: f64, cost: f64,
  cacheRead: f64, cacheWrite: f64, cacheWrite5m: f64, cacheWrite1h: f64,
}

export function observeUsage(l: RequestLabels, u: Usage): void {
  const base = baseLabels(l)
  inc("bifrost_input_tokens_total", base, u.input)
  inc("bifrost_output_tokens_total", base, u.output)
  if (u.cost > 0.0) inc("bifrost_cost_total", base, u.cost)
  if (u.cacheRead > 0.0) inc("bifrost_cache_read_input_tokens_total", base, u.cacheRead)
  if (u.cacheWrite > 0.0) inc("bifrost_cache_write_input_tokens_total", base, u.cacheWrite)
  if (u.cacheWrite5m > 0.0) inc("bifrost_cache_write_input_tokens_5m_total", base, u.cacheWrite5m)
  if (u.cacheWrite1h > 0.0) inc("bifrost_cache_write_input_tokens_1h_total", base, u.cacheWrite1h)
}

// A Bifrost cache hit. cacheType is "direct" or "semantic".
export function observeCacheHit(l: RequestLabels, cacheType: string): void {
  inc("bifrost_cache_hits_total", baseLabels(l) + `,cache_type="${esc(cacheType)}"`, 1.0)
}

// One streamed chunk. Chunk 0 feeds the first-token histogram, later chunks the inter-token one.
// latencySeconds is the time to that chunk.
export function observeStreamChunk(l: RequestLabels, index: int, latencySeconds: f64): void {
  const base = baseLabels(l)
  if (index === 0) {
    observe("bifrost_stream_first_token_latency_seconds", base, latencySeconds)
  } else {
    observe("bifrost_stream_inter_token_latency_seconds", base, latencySeconds)
  }
}

// Bifrost's own overhead for a request, in microseconds (total time minus time blocked on upstream).
export function observeOverheadFor(l: RequestLabels, us: f64): void {
  observe("bifrost_overhead_latency_microseconds", baseLabels(l), us)
}

// bifrost_overhead_component_microseconds: the overhead split by Bifrost's overhead_component values
// (plugins, routing, conversion, miscellaneous). For one request the components sum to its overhead.
export function observeOverheadComponent(l: RequestLabels, component: string, us: f64): void {
  if (!overheadBreakdown) return
  observe("bifrost_overhead_component_microseconds", baseLabels(l) + `,overhead_component="${esc(component)}"`, us)
}

// raiju_routing_decisions_total: requests the complexity router or a routing rule decided, by the
// engine that decided, the complexity tier and the rule's name. A Raiju counter: see docs/parity.md.
export function observeRouting(engine: string, tier: string, rule: string): void {
  inc("raiju_routing_decisions_total", `routing_engine="${esc(engine)}",complexity_tier="${esc(tier)}",routing_rule_name="${esc(rule)}"`, 1.0)
}

// The classifiers' own calls (complexity.tov). Their cost counts here whether or not budgets see it.
// phase is "request" for the message embedding and "warmup" for the exemplar embeddings.
export function observeRoutingEmbedding(provider: string, model: string, phase: string, cost: f64): void {
  const l = `provider="${esc(provider)}",model="${esc(model)}",phase="${esc(phase)}"`
  inc("bifrost_routing_embedding_requests_total", l, 1.0)
  inc("bifrost_routing_embedding_cost_total", l, cost)
}

export function observeRoutingLLM(provider: string, model: string, cost: f64): void {
  const l = `provider="${esc(provider)}",model="${esc(model)}"`
  inc("bifrost_routing_llm_requests_total", l, 1.0)
  inc("bifrost_routing_llm_cost_total", l, cost)
}

// Unlabelled fallback for callers without a RequestLabels. Prefer observeOverheadFor.
export function observeOverhead(us: f64): void {
  observe("bifrost_overhead_latency_microseconds", baseLabels(newLabels("", "", "")), us)
}

// One HTTP request at the server. path is the matched route template, not the raw URL.
// reqBytes and respBytes are the body sizes.
// custom holds the client.prometheus_labels values of the request (httpCustomValues), which the http_*
// families take after path, method and status, as Bifrost's telemetry plugin does.
export function observeHttp(path: string, method: string, status: int, durationSeconds: f64, reqBytes: f64, respBytes: f64, custom: string[]): void {
  let l = `path="${esc(path)}",method="${esc(method)}",status="${status}"`
  for (let i = 0; i < customNames.length; i++) l += `,${customNames[i]!}="${esc(custom[i] ?? "")}"`
  inc("http_requests_total", l, 1.0)
  observe("http_request_duration_seconds", l, durationSeconds)
  observe("http_request_size_bytes", l, reqBytes)
  observe("http_response_size_bytes", l, respBytes)
}

// Labels of the per-key families (bifrost_provider_key_up, bifrost_key_rotation_events_total).
export function keyLabels(provider: string, keyId: string, keyName: string): string {
  return `provider="${esc(provider)}",key_id="${esc(keyId)}",key_name="${esc(keyName)}"`
}

// bifrost_provider_key_up: 1 when the key's last attempt succeeded, 0 when it failed.
export function observeKeyUp(provider: string, keyId: string, keyName: string, ok: bool): void {
  setGauge("bifrost_provider_key_up", keyLabels(provider, keyId, keyName), ok ? 1.0 : 0.0)
}

// bifrost_key_rotation_events_total: a failed attempt on one key that moved the request to another.
export function observeRotation(provider: string, model: string, keyId: string, keyName: string, reason: string): void {
  inc("bifrost_key_rotation_events_total", `provider="${esc(provider)}",requested_model="${esc(model)}",key_id="${esc(keyId)}",key_name="${esc(keyName)}",fail_reason="${esc(reason)}"`, 1.0)
}

// bifrost_active_requests: by is +1 when a request starts and -1 when it ends.
export function activeRequests(method: string, by: f64): void {
  addGauge("bifrost_active_requests", `method="${esc(method)}"`, by)
}

// bifrost_a2a_client_operation_duration_seconds: one call to an upstream agent, by the A2A operation, the wire
// method, the virtual key and the error type ("" on success). OTLP pushes it under Bifrost's name and keys.
export function observeA2a(operation: string, method: string, virtualKeyId: string, errorType: string, seconds: f64): void {
  let labels = `bifrost_a2a_operation_name="${esc(operation)}",a2a_method_name="${esc(method)}"`
  if (virtualKeyId !== "") labels += `,virtual_key_id="${esc(virtualKeyId)}"`
  if (errorType !== "") labels += `,error_type="${esc(errorType)}"`
  observe("bifrost_a2a_client_operation_duration_seconds", labels, seconds)
}

// bifrost_mcp_client_operation_duration_seconds: one MCP tool call, timed at the client.
export function observeMcp(client: string, tool: string, errorType: string, seconds: f64): void {
  observe("bifrost_mcp_client_operation_duration_seconds", `mcp_client="${esc(client)}",mcp_tool_name="${esc(tool)}",mcp_method="tools/call",error_type="${esc(errorType)}"`, seconds)
}

// ---- crew routing (crew.tov; docs/crew-routing.md) ----

function crewLabels(pool: string, klass: string): string {
  return `pool="${esc(pool)}",class="${esc(klass)}"`
}

// A task is given its crew: by a crew/<pool> call with no assignment in force, or by the assign API.
export function observeCrewAssignment(pool: string, klass: string): void {
  inc("raiju_crew_assignments_total", crewLabels(pool, klass), 1.0)
}

// A call routed to a role's candidate.
export function observeCrewCall(pool: string, role: string, candidate: string): void {
  inc("raiju_crew_calls_total", `pool="${esc(pool)}",role="${esc(role)}",candidate="${esc(candidate)}"`, 1.0)
}

// An attempt started. escalation is true when the sequential layer opened it (next), false for a task's first attempt.
export function observeCrewAttempt(pool: string, klass: string, escalation: bool): void {
  inc("raiju_crew_attempts_total", crewLabels(pool, klass), 1.0)
  if (escalation) inc("raiju_crew_escalations_total", crewLabels(pool, klass), 1.0)
}

export function observeCrewAccept(pool: string, klass: string): void {
  inc("raiju_crew_accepts_total", crewLabels(pool, klass), 1.0)
}

// A recorded outcome (a repeat of an attempt's outcome is not recorded twice). verifier is pass, fail or "" (none).
export function observeCrewOutcome(pool: string, klass: string, verifier: string, quality: f64): void {
  const v = verifier === "" ? "none" : verifier
  inc("raiju_crew_outcomes_total", crewLabels(pool, klass) + `,verifier="${esc(v)}"`, 1.0)
  observe("raiju_crew_outcome_quality", crewLabels(pool, klass), quality)
}

// A completed task's cost, once per task and writer.
export function observeCrewTaskCost(pool: string, cost: f64): void {
  observe("raiju_crew_task_cost_usd", `pool="${esc(pool)}"`, cost)
}

// The multiplier a class is priced at now.
export function setCrewLambda(pool: string, klass: string, lambda: f64): void {
  setGauge("raiju_crew_lambda", crewLabels(pool, klass), lambda)
}

export function setCrewQuotaFraction(pool: string, subscription: string, phi: f64): void {
  setGauge("raiju_crew_subscription_phi", `pool="${esc(pool)}",subscription="${esc(subscription)}"`, phi)
}

test("key, active-request, rotation and MCP families carry Bifrost names and labels", () => {
  observeKeyUp("openai", "key-1", "primary", false)
  observeRotation("openai", "gpt-4o", "key-1", "primary", "provider_rate_limited")
  activeRequests("chat_completion", 1.0)
  activeRequests("chat_completion", -1.0)
  observeMcp("fs", "fs__read", "", 0.15)
  observeA2a("SendMessage", "message/send", "vk-1", "", 0.3)
  expect(render().includes(`bifrost_a2a_client_operation_duration_seconds_bucket{bifrost_a2a_operation_name="SendMessage",a2a_method_name="message/send",virtual_key_id="vk-1",le="0.5"} 1`)).toBe(true)
  const text = render()
  expect(text.includes("# TYPE bifrost_provider_key_up gauge\n")).toBe(true)
  expect(text.includes(`bifrost_provider_key_up{provider="openai",key_id="key-1",key_name="primary"} 0`)).toBe(true)
  expect(text.includes(`bifrost_key_rotation_events_total{provider="openai",requested_model="gpt-4o",key_id="key-1",key_name="primary",fail_reason="provider_rate_limited"} 1`)).toBe(true)
  expect(text.includes(`bifrost_active_requests{method="chat_completion"} 0`)).toBe(true)
  expect(text.includes(`bifrost_mcp_client_operation_duration_seconds_bucket{mcp_client="fs",mcp_tool_name="fs__read",mcp_method="tools/call",error_type="",le="0.2"} 1`)).toBe(true)
  expect(text.includes(`bifrost_mcp_client_operation_duration_seconds_count{mcp_client="fs"`)).toBe(true)
})

test("bifrost request family carries Bifrost names, labels and HELP", () => {
  let l = newLabels("openai", "gpt-4o", "chat_completion")
  l.virtualKeyId = "vk-1"
  observeRequest(l, { ok: true, status: 200, errorType: "", retries: 0.0 }, 0.2)
  const text = render()
  expect(text.includes("# HELP bifrost_upstream_requests_total Total number of requests forwarded to upstream providers by Bifrost.\n# TYPE bifrost_upstream_requests_total counter\n")).toBe(true)
  expect(text.includes(`bifrost_upstream_requests_total{provider="openai",model="gpt-4o",method="chat_completion",alias="",app="",routing_engine_used="",virtual_key_id="vk-1",virtual_key_name="",selected_key_id="",selected_key_name="",routing_rule_id="",routing_rule_name="",complexity_tier="",complexity_mechanism="",team_id="",team_name="",customer_id="",customer_name="",business_unit_id="",business_unit_name="",project_id="",project_name="",fallback_index=""} 1`)).toBe(true)
  expect(text.includes(`bifrost_success_requests_total{provider="openai",model="gpt-4o",method="chat_completion",alias="",app="",routing_engine_used="",virtual_key_id="vk-1"`)).toBe(true)
  expect(text.includes(`bifrost_upstream_latency_seconds_bucket{provider="openai",model="gpt-4o",method="chat_completion",alias="",app="",routing_engine_used="",virtual_key_id="vk-1",virtual_key_name="",selected_key_id="",selected_key_name="",routing_rule_id="",routing_rule_name="",complexity_tier="",complexity_mechanism="",team_id="",team_name="",customer_id="",customer_name="",business_unit_id="",business_unit_name="",project_id="",project_name="",fallback_index="",is_success="true",le="0.25"} 1`)).toBe(true)
  expect(text.includes(`is_success="true",le="900"} 1`)).toBe(true)
  expect(text.includes(`is_success="true",le="+Inf"} 1`)).toBe(true)
  expect(text.includes(`bifrost_upstream_latency_seconds_count{provider="openai"`)).toBe(true)
})

test("prometheus_labels add named labels filled from x-bf-dim headers", () => {
  setCustomLabels(["env", "team", "env", "le", "bad-name", "provider"])
  const dims: Map<string, string> = new Map()
  dims.set("x-bf-dim-env", "prod")
  let l = newLabels("openai", "gpt-4o", "chat_completion")
  l.custom = customValues(dims)
  observeRequest(l, { ok: true, status: 200, errorType: "", retries: 0.0 }, 0.2)
  const text = render()
  expect(text.includes(`fallback_index="",env="prod",team=""} 1`)).toBe(true)
  // a request without the header gets an empty value
  let plain = newLabels("openai", "gpt-4o", "chat_completion")
  plain.custom = customValues(new Map())
  observeRequest(plain, { ok: true, status: 200, errorType: "", retries: 0.0 }, 0.2)
  const again = render()
  expect(again.includes(`fallback_index="",env="",team=""} 1`)).toBe(true)
  setCustomLabels([])
  expect(customValues(dims).length).toBe(0)
})

test("error counter carries status_code and error_type, latency is_success=false", () => {
  const l = newLabels("anthropic", "claude-x", "chat_completion")
  const base = `provider="anthropic",model="claude-x",method="chat_completion",alias="",app="",routing_engine_used="",virtual_key_id="",virtual_key_name="",selected_key_id="",selected_key_name="",routing_rule_id="",routing_rule_name="",complexity_tier="",complexity_mechanism="",team_id="",team_name="",customer_id="",customer_name="",business_unit_id="",business_unit_name="",project_id="",project_name="",fallback_index=""`
  observeRequest(l, { ok: false, status: 429, errorType: "provider_rate_limited", retries: 2.0 }, 1.5)
  expect(render().includes(`bifrost_error_requests_total{${base},status_code="429",error_type="provider_rate_limited"} 1`)).toBe(true)
  expect(render().includes(`bifrost_upstream_latency_seconds_bucket{${base},is_success="false",le="2.5"} 1`)).toBe(true)
  expect(render().includes(`bifrost_upstream_latency_seconds_bucket{${base},is_success="false",le="1"} 0`)).toBe(true)
  expect(render().includes(`bifrost_request_retries_bucket{${base},le="2"} 1`)).toBe(true)
  expect(render().includes(`bifrost_request_retries_bucket{${base},le="1"} 0`)).toBe(true)
})

test("usage, cache, stream, overhead and http families", () => {
  const l = newLabels("bedrock", "nova", "chat_completion")
  const base = `provider="bedrock",model="nova",method="chat_completion",alias="",app="",routing_engine_used="",virtual_key_id="",virtual_key_name="",selected_key_id="",selected_key_name="",routing_rule_id="",routing_rule_name="",complexity_tier="",complexity_mechanism="",team_id="",team_name="",customer_id="",customer_name="",business_unit_id="",business_unit_name="",project_id="",project_name="",fallback_index=""`
  observeUsage(l, { input: 120.0, output: 30.0, cost: 0.0, cacheRead: 40.0, cacheWrite: 0.0, cacheWrite5m: 0.0, cacheWrite1h: 0.0 })
  observeCacheHit(l, "semantic")
  observeStreamChunk(l, 0, 0.3)
  observeStreamChunk(l, 1, 0.02)
  observeOverheadFor(l, 1500000.0)
  observeHttp("/v1/usage-test", "POST", 200, 0.8, 500.0, 2000.0, [])
  const text = render()
  expect(text.includes(`bifrost_input_tokens_total{${base}} 120`)).toBe(true)
  expect(text.includes(`bifrost_output_tokens_total{${base}} 30`)).toBe(true)
  expect(text.includes(`bifrost_cache_read_input_tokens_total{${base}} 40`)).toBe(true)
  expect(text.includes(`bifrost_cost_total{${base}}`)).toBe(false)
  expect(text.includes(`bifrost_cache_write_input_tokens_total{${base}}`)).toBe(false)
  expect(text.includes(`bifrost_cache_hits_total{${base},cache_type="semantic"} 1`)).toBe(true)
  expect(text.includes(`bifrost_stream_first_token_latency_seconds_bucket{${base},le="0.5"} 1`)).toBe(true)
  expect(text.includes(`bifrost_stream_first_token_latency_seconds_bucket{${base},le="0.25"} 0`)).toBe(true)
  expect(text.includes(`bifrost_stream_inter_token_latency_seconds_bucket{${base},le="0.025"} 1`)).toBe(true)
  expect(text.includes(`bifrost_overhead_latency_microseconds_bucket{${base},le="2.5e+06"} 1`)).toBe(true)
  expect(text.includes(`bifrost_overhead_latency_microseconds_bucket{${base},le="1e+06"} 0`)).toBe(true)
  expect(text.includes(`http_requests_total{path="/v1/usage-test",method="POST",status="200"} 1`)).toBe(true)
  expect(text.includes(`http_request_duration_seconds_bucket{path="/v1/usage-test",method="POST",status="200",le="1"} 1`)).toBe(true)
  expect(text.includes(`http_request_size_bytes_bucket{path="/v1/usage-test",method="POST",status="200",le="1000"} 1`)).toBe(true)
  expect(text.includes(`http_request_size_bytes_bucket{path="/v1/usage-test",method="POST",status="200",le="100"} 0`)).toBe(true)
  expect(text.includes(`http_response_size_bytes_bucket{path="/v1/usage-test",method="POST",status="200",le="10000"} 1`)).toBe(true)
  expect(text.includes("# TYPE http_request_duration_seconds histogram\n")).toBe(true)
})

test("error_type from an upstream status", () => {
  expect(errorTypeForStatus(429)).toBe("provider_rate_limited")
  expect(errorTypeForStatus(529)).toBe("provider_overloaded")
  expect(errorTypeForStatus(500)).toBe("provider_server_error")
  expect(errorTypeForStatus(400)).toBe("caller_invalid_request")
  expect(errorTypeForStatus(200)).toBe("")
})

test("telemetry switches: the overhead split and user labels are opt-in; custom labels reach the http families", () => {
  setTelemetry(true, true)
  setCustomLabels(["team"])
  const hm = new Map<string, string>()
  hm.set("x-bf-dim-team", "core")
  const l = newLabels("openai", "gpt-4o", "chat_completion")
  l.userId = "user-7"
  l.userName = "Ada"
  l.custom = customValues(hm)
  observeOverheadComponent(l, "routing", 12.0)
  observeHttp("/v1/telemetry-switch", "GET", 200, 0.1, 1.0, 2.0, customValues(hm))
  const on = render()
  expect(on.includes(`bifrost_overhead_component_microseconds_count{provider="openai",model="gpt-4o",method="chat_completion"`)).toBe(true)
  expect(on.includes(`user_id="user-7",user_name="Ada"`)).toBe(true)
  expect(on.includes(`http_requests_total{path="/v1/telemetry-switch",method="GET",status="200",team="core"} 1`)).toBe(true)
  setTelemetry(false, false)
  setCustomLabels([])
  observeOverheadComponent(l, "conversion", 5.0)
  expect(render().includes(`overhead_component="conversion"`)).toBe(false)
})

test("raiju families keep their own labels and default buckets", () => {
  inc("raiju_guardrail_checks_total", labels("", "p-test", "block"), 1.0)
  observe("raiju_probe_seconds", "", 0.2)
  const text = render()
  expect(text.includes(`raiju_guardrail_checks_total{provider="",model="p-test",status="block"} 1`)).toBe(true)
  expect(text.includes(`raiju_probe_seconds_bucket{le="0.25"} 1`)).toBe(true)
  expect(text.includes(`raiju_probe_seconds_bucket{le="60"} 1`)).toBe(true)
})

test("worker expositions merge by series and stay grouped by family", () => {
  const a = "# HELP x_total Help.\n# TYPE x_total counter\nx_total{p=\"a\"} 2\nx_total{p=\"b\"} 1\n# TYPE h histogram\nh_bucket{le=\"1\"} 1\nh_bucket{le=\"+Inf\"} 1\nh_sum 0.5\nh_count 1\n# TYPE y gauge\ny 7\n"
  const b = "# HELP x_total Help.\n# TYPE x_total counter\nx_total{p=\"a\"} 3\nx_total{p=\"c\"} 4\n# TYPE h histogram\nh_bucket{le=\"1\"} 0\nh_bucket{le=\"+Inf\"} 2\nh_sum 1.5\nh_count 2\n"
  expect(mergeRendered([a, b])).toBe("# HELP x_total Help.\n# TYPE x_total counter\nx_total{p=\"a\"} 5\nx_total{p=\"b\"} 1\nx_total{p=\"c\"} 4\n# TYPE h histogram\nh_bucket{le=\"1\"} 1\nh_bucket{le=\"+Inf\"} 3\nh_sum 2\nh_count 3\n# TYPE y gauge\ny 7\n")
})

test("crew families carry their labels, the escalation split and the quality and cost buckets", () => {
  observeCrewAssignment("codeaf-m", "bug-fix")
  observeCrewCall("codeaf-m", "worker", "cheap")
  observeCrewAttempt("codeaf-m", "bug-fix", false)
  observeCrewAttempt("codeaf-m", "bug-fix", true)
  observeCrewAccept("codeaf-m", "bug-fix")
  observeCrewOutcome("codeaf-m", "bug-fix", "fail", 0.4)
  observeCrewOutcome("codeaf-m", "bug-fix", "", 0.9)
  observeCrewTaskCost("codeaf-m", 0.02)
  setCrewLambda("codeaf-m", "bug-fix", 1.5)
  setCrewQuotaFraction("codeaf-m", "team", 0.5)
  const text = render()
  expect(text.includes(`raiju_crew_assignments_total{pool="codeaf-m",class="bug-fix"} 1`)).toBe(true)
  expect(text.includes(`raiju_crew_calls_total{pool="codeaf-m",role="worker",candidate="cheap"} 1`)).toBe(true)
  expect(text.includes(`raiju_crew_attempts_total{pool="codeaf-m",class="bug-fix"} 2`)).toBe(true)
  expect(text.includes(`raiju_crew_escalations_total{pool="codeaf-m",class="bug-fix"} 1`)).toBe(true)
  expect(text.includes(`raiju_crew_accepts_total{pool="codeaf-m",class="bug-fix"} 1`)).toBe(true)
  expect(text.includes(`raiju_crew_outcomes_total{pool="codeaf-m",class="bug-fix",verifier="fail"} 1`)).toBe(true)
  expect(text.includes(`raiju_crew_outcomes_total{pool="codeaf-m",class="bug-fix",verifier="none"} 1`)).toBe(true)
  expect(text.includes(`raiju_crew_outcome_quality_bucket{pool="codeaf-m",class="bug-fix",le="0.5"} 1`)).toBe(true)
  expect(text.includes(`raiju_crew_outcome_quality_count{pool="codeaf-m",class="bug-fix"} 2`)).toBe(true)
  expect(text.includes(`raiju_crew_task_cost_usd_bucket{pool="codeaf-m",le="0.05"} 1`)).toBe(true)
  expect(text.includes(`raiju_crew_lambda{pool="codeaf-m",class="bug-fix"} 1.5`)).toBe(true)
  expect(text.includes(`raiju_crew_subscription_phi{pool="codeaf-m",subscription="team"} 0.5`)).toBe(true)
  expect(text.includes("# TYPE raiju_crew_outcome_quality histogram\n")).toBe(true)
})

test("the merge keeps the largest crew gauge and sums the crew counters", () => {
  const a = "# TYPE raiju_crew_lambda gauge\nraiju_crew_lambda{pool=\"p\",class=\"c\"} 1.5\n# TYPE raiju_crew_calls_total counter\nraiju_crew_calls_total{pool=\"p\"} 2\n"
  const b = "# TYPE raiju_crew_lambda gauge\nraiju_crew_lambda{pool=\"p\",class=\"c\"} 1.5\n# TYPE raiju_crew_calls_total counter\nraiju_crew_calls_total{pool=\"p\"} 3\n"
  expect(mergeRendered([a, b])).toBe("# TYPE raiju_crew_lambda gauge\nraiju_crew_lambda{pool=\"p\",class=\"c\"} 1.5\n# TYPE raiju_crew_calls_total counter\nraiju_crew_calls_total{pool=\"p\"} 5\n")
})
