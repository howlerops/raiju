  { name: "bifrost_overhead_latency_microseconds", text: "Latency added by Bifrost itself, in microseconds: total request time minus time blocked on upstream providers." },
  { name: "bifrost_overhead_component_microseconds", text: "Bifrost overhead latency broken down by internal component (overhead_component label), in microseconds. The components of a request sum to bifrost_overhead_latency_microseconds." },
  { name: "raiju_routing_decisions_total", text: "Requests decided by the complexity router or a routing rule (Raiju extra), by routing_engine, complexity_tier and routing_rule_name." },
  { name: "raiju_feed_relayed_total", text: "Live-feed events this node sent to its peers or the broker (Raiju extra, cluster_wide)." },
  { name: "raiju_feed_dropped_total", text: "Live-feed events that did not get through, by reason: queue (a peer was too slow and the oldest went), send (a relay request failed) or missed (the broker's ring had moved past them) (Raiju extra)." },
  { name: "raiju_feed_replayed_total", text: "Live-feed events replayed to a /ws client that resumed with since= (Raiju extra)." },
  { name: "raiju_feed_gap_events_total", text: "Live-feed events a resume could not replay because the ring no longer held them (Raiju extra)." },
  { name: "bifrost_success_requests_total", text: "Total number of successful requests forwarded to upstream providers by Bifrost." },
  { name: "bifrost_error_requests_total", text: "Total number of failed requests, by effective status_code and normalized error_type." },
  { name: "bifrost_input_tokens_total", text: "Total number of input tokens forwarded to upstream providers by Bifrost." },
  { name: "bifrost_output_tokens_total", text: "Total number of output tokens forwarded to upstream providers by Bifrost." },
  { name: "bifrost_cache_hits_total", text: "Total number of cache hits forwarded to upstream providers by Bifrost, separated by cache type (direct/semantic)." },
  { name: "bifrost_cache_read_input_tokens_total", text: "Total provider-side prompt-cache read (cached) input tokens. Billed at a reduced rate by the provider." },
  { name: "bifrost_cache_write_input_tokens_total", text: "Total provider-side prompt-cache creation (write) input tokens." },
  { name: "bifrost_cache_write_input_tokens_5m_total", text: "Provider-side prompt-cache write input tokens with a 5-minute TTL (Anthropic only). Subset of bifrost_cache_write_input_tokens_total — do not sum with it." },
  { name: "bifrost_cache_write_input_tokens_1h_total", text: "Provider-side prompt-cache write input tokens with a 1-hour TTL (Anthropic only). Subset of bifrost_cache_write_input_tokens_total — do not sum with it." },
  { name: "bifrost_cost_total", text: "Total cost in USD for requests to upstream providers." },
  { name: "bifrost_stream_inter_token_latency_seconds", text: "Latency of the intermediate tokens of a stream response." },
  { name: "bifrost_stream_first_token_latency_seconds", text: "Latency of the first token of a stream response." },
  { name: "bifrost_request_retries", text: "Number of retries used per request (observed once per request)." },
  { name: "bifrost_active_requests", text: "Number of LLM requests currently in-flight." },
  { name: "bifrost_provider_key_up", text: "Health of a provider key. 1 = last attempt succeeded, 0 = last attempt failed." },
  { name: "bifrost_key_rotation_events_total", text: "Number of key rotations, broken down by provider, key, and failure reason. One increment per per-key failure (rate limit, rejected credential, exhausted quota, model access, retired model, region block) that triggered a switch to a different key on the next retry." },
  { name: "bifrost_routing_embedding_requests_total", text: "Total number of embedding calls made by semantic routing, labeled by the embedding provider/model and phase (request classification vs warmup)." },
  { name: "bifrost_routing_embedding_cost_total", text: "Total cost in USD of semantic routing embeddings, labeled by the embedding provider/model and phase (request classification vs warmup). Recorded regardless of whether the cost counts toward budgets." },
  { name: "bifrost_routing_llm_requests_total", text: "Total number of chat completions made by llm complexity routing, labeled by the classifier provider/model." },
  { name: "bifrost_routing_llm_cost_total", text: "Total cost in USD of llm complexity routing completions, labeled by the classifier provider/model. Recorded regardless of whether the cost counts toward budgets." },
