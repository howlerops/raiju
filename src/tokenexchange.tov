// Token exchange for MCP clients of auth_type token_exchange (RFC 8693, Bifrost's token_exchange): the
// identity-provider access token a caller presents is exchanged at the token endpoint for one scoped to the
// client's audience. The identity provider does the checking: a subject token it does not accept is refused
// there. Exchanged tokens are cached per caller until shortly before they expire. The admin credential a
// verification keeps is renewed with its refresh token shortly before it expires (Bifrost's admin bootstrap
// token); a refused renewal marks it as needing a new verification.
import { formEncode, formHeaders } from "./mcpauth"
import { McpUserToken } from "./mcpuser"
import { rfc3339Of } from "./vkexpiry"
import { deadline } from "./deadline"
import { sha256, toHex, utf8 } from "./crypto"
import { discoveryUrl, parseDiscovery } from "./oidc"

// An MCP client's token_exchange block. client_id and client_secret are the exchange application's own;
// use_idp_credentials sends the login application's (the oidc block's) instead.
export type McpTokenExchange = {
  audience?: string,
  client_id?: string,
  client_secret?: string,
  use_idp_credentials?: bool,
  scopes?: string[],
  authorization_server_url?: string,
}

export const EXCHANGE_GRANT = "urn:ietf:params:oauth:grant-type:token-exchange"
export const SUBJECT_TOKEN_TYPE = "urn:ietf:params:oauth:token-type:access_token"
const EXCHANGE_TIMEOUT_MS = 15000
// a cached token is not used this close to its expiry (Bifrost's safety margin)
const MARGIN_MS: f64 = 30000.0
// a token whose answer names no lifetime is kept this long
const DEFAULT_TTL_MS: f64 = 300000.0

// Bifrost's refresh worker renews a credential this long before it expires (its look-ahead window); a
// shorter-lived credential is renewed halfway through its life
export const RENEW_LEAD_MS: f64 = 300000.0
// a renewal that failed for a reason that may pass (the network, a 5xx) is tried again after this long
export const RENEW_RETRY_MS: f64 = 30000.0

// Renewals of one credential run on one node of a cluster (its owner, chosen from the live nodes). Another node
// renews it only this long after it falls due, so the owner's renewal, which the others then read, comes first.
export const ADMIN_TAKEOVER_MS: f64 = 60000.0
// A renewal that finds another process renewing the same credential waits this long for its result, polling the
// config file, and then renews it itself.
export const ADMIN_WAIT_MS: f64 = 20000.0
export const ADMIN_POLL_MS = 100

// The outcome of one exchange or renewal: the token, its lifetime in seconds (0 when none was named) and the
// refresh token ("" when none was issued), or the reason. rejected: the identity provider refused the grant
// for good (HTTP 401, or 400 invalid_grant or unauthorized_client, as Bifrost classifies it), so retrying
// cannot help.
export type ExchangeResult = { token: string, expiresIn: f64, error: string, refreshToken: string, rejected: bool }

type ExchangeJson = { access_token?: string, expires_in?: f64, refresh_token?: string, error?: string, error_description?: string }

function refused(message: string): ExchangeResult {
  return { token: "", expiresIn: 0.0, error: message, refreshToken: "", rejected: false }
}

function rejectedBy(message: string): ExchangeResult {
  return { token: "", expiresIn: 0.0, error: message, refreshToken: "", rejected: true }
}

// Whether a token endpoint's error answer refuses the grant for good (RFC 6749 section 5.2, as Bifrost reads
// it): a 401, or a 400 whose error is invalid_grant or unauthorized_client. Other answers may pass.
export function isRejection(status: int, text: string): bool {
  if (status === 401) return true
  if (status !== 400) return false
  let x: ExchangeJson = {}
  try {
    x = JSON.parse(text) as ExchangeJson
  } catch (e) {
    return false
  }
  const err = x.error ?? ""
  return err === "invalid_grant" || err === "unauthorized_client"
}

// The reason kept on a credential whose renewal was refused: the HTTP status and the OAuth error and its
// description, and nothing else of the body (Bifrost's refreshRejectionReason).
export function rejectionReason(status: int, text: string): string {
  let x: ExchangeJson = {}
  try {
    x = JSON.parse(text) as ExchangeJson
  } catch (e) {
    return `provider rejected the refresh (HTTP ${status})`
  }
  const err = x.error ?? ""
  if (err === "") return `provider rejected the refresh (HTTP ${status})`
  const desc = x.error_description ?? ""
  if (desc === "") return `provider rejected the refresh (HTTP ${status}, ${err})`
  return `provider rejected the refresh (HTTP ${status}, ${err}: ${desc})`
}

// The client credentials an exchange authenticates with. With use_idp_credentials they are the login
// application's; otherwise the client's own. error names a missing client id.
export function credentialsOf(cfg: McpTokenExchange, idpId: string, idpSecret: string): { id: string, secret: string, error: string } {
  if (cfg.use_idp_credentials === true) {
    if (idpId === "") return { id: "", secret: "", error: "use_idp_credentials is set, but the identity provider (oidc) has no client_id" }
    return { id: idpId, secret: idpSecret, error: "" }
  }
  const id = cfg.client_id ?? ""
  if (id === "") return { id: "", secret: "", error: "token_exchange.client_id is missing" }
  return { id: id, secret: cfg.client_secret ?? "", error: "" }
}

// The form body of the exchange (RFC 8693 section 2.1): the subject token is the caller's, the audience and
// scopes name what it is exchanged for.
export function exchangeBody(cfg: McpTokenExchange, clientId: string, clientSecret: string, subject: string): string throws Error {
  const grant = try formEncode(EXCHANGE_GRANT)
  const subj = try formEncode(subject)
  const subjType = try formEncode(SUBJECT_TOKEN_TYPE)
  const aud = try formEncode(cfg.audience ?? "")
  const cid = try formEncode(clientId)
  const parts: string[] = ["grant_type=" + grant, "subject_token=" + subj, "subject_token_type=" + subjType, "audience=" + aud, "client_id=" + cid]
  if (clientSecret !== "") {
    const sec = try formEncode(clientSecret)
    parts.push("client_secret=" + sec)
  }
  const scope = (cfg.scopes ?? []).join(" ")
  if (scope !== "") {
    const sc = try formEncode(scope)
    parts.push("scope=" + sc)
  }
  return parts.join("&")
}

// The token of an exchange answer (RFC 8693 section 2.2.1), or the error it names.
export function parseExchange(json: string): ExchangeResult {
  let x: ExchangeJson = {}
  try {
    x = JSON.parse(json) as ExchangeJson
  } catch (e) {
    return refused("the identity provider's answer is not JSON")
  }
  const tok = x.access_token ?? ""
  if (tok === "") return refused(x.error_description ?? x.error ?? "the answer has no access token")
  return { token: tok, expiresIn: x.expires_in ?? 0.0, error: "", refreshToken: (x.refresh_token ?? "").trim(), rejected: false }
}

// The form body of a renewal (RFC 6749 section 6): the refresh token and the exchange's client credentials,
// as Bifrost's refreshExchangeAdminToken sends them.
export function refreshBody(clientId: string, clientSecret: string, refreshToken: string): string throws Error {
  const rt = try formEncode(refreshToken)
  const cid = try formEncode(clientId)
  const parts: string[] = ["grant_type=refresh_token", "refresh_token=" + rt, "client_id=" + cid]
  if (clientSecret !== "") {
    const sec = try formEncode(clientSecret)
    parts.push("client_secret=" + sec)
  }
  return parts.join("&")
}

// The token endpoint an exchange posts to: the client's authorization_server_url when it names one, or the
// identity provider's (discovered) token endpoint.
export function endpointOf(cfg: McpTokenExchange, discovered: string): string {
  const u = cfg.authorization_server_url ?? ""
  return u !== "" ? u : discovered
}

// A short, non-reversible name for a subject token, so the cache never holds the token itself as a key.
export function subjectFingerprint(subject: string): string {
  return toHex(sha256(utf8(subject))).slice(0, 16)
}

// The cache key of one caller's exchanged token: the client, the caller's identity (its virtual key) and the
// subject token it presented.
export function exchangeKey(client: string, identity: string, subject: string): string {
  return client + "\n" + identity + "\n" + subjectFingerprint(subject)
}

// Exchanged tokens by cache key. A token is used until MARGIN_MS before its lifetime ends, and an answer
// with no lifetime keeps it DEFAULT_TTL_MS.
export class ExchangeCache {
  private entries: Map<string, { token: string, until: f64 }> = new Map()

  // The cached token, or undefined when none is held or it has run out.
  get(key: string, nowMs: f64): string | undefined {
    const e = this.entries.get(key)
    if (e === undefined) return undefined
    if (e.until <= nowMs) {
      this.entries.delete(key)
      return undefined
    }
    return e.token
  }

  put(key: string, token: string, expiresIn: f64, nowMs: f64): void {
    let ttl = expiresIn > 0.0 ? expiresIn * 1000.0 : DEFAULT_TTL_MS
    // a lifetime shorter than the margin keeps its full length rather than none (Bifrost's rule)
    if (ttl - MARGIN_MS > 0.0) ttl = ttl - MARGIN_MS
    this.entries.set(key, { token: token, until: nowMs + ttl })
  }

  drop(key: string): void {
    this.entries.delete(key)
  }
}

// The token endpoints discovered from identity-provider issuers, fetched once per issuer.
export class IdpEndpoints {
  private found: Map<string, string> = new Map()

  // The token_endpoint of the issuer's discovery document, or "" when it cannot be read.
  async tokenEndpoint(issuer: string): Promise<string> {
    if (issuer === "") return ""
    const hit = this.found.get(issuer)
    if (hit !== undefined) return hit
    const dl = deadline(EXCHANGE_TIMEOUT_MS)
    try {
      const r = await fetch(discoveryUrl(issuer), { signal: dl.controller.signal })
      if (r.status < 200 || r.status >= 300) return ""
      const d = try parseDiscovery(await r.text())
      this.found.set(issuer, d.token_endpoint)
      return d.token_endpoint
    } catch (e) {
      return ""
    } finally {
      dl.finish()
    }
  }
}

// One POST of a form to the client's token endpoint (discovered from the issuer unless the client names one).
// status 0 with error set when it could not be sent.
async function postForm(cfg: McpTokenExchange, body: string, idp: IdpEndpoints, issuer: string): Promise<{ status: int, text: string, error: string }> {
  let discovered = ""
  if ((cfg.authorization_server_url ?? "") === "") discovered = await idp.tokenEndpoint(issuer)
  const endpoint = endpointOf(cfg, discovered)
  if (endpoint === "") return { status: 0, text: "", error: "no token endpoint: set authorization_server_url, or configure oidc with a reachable issuer" }
  const dl = deadline(EXCHANGE_TIMEOUT_MS)
  try {
    const hs: Record<string, string> = formHeaders()
    const r = await fetch(endpoint, { method: "POST", headers: hs, body: body, signal: dl.controller.signal })
    const text = await r.text()
    return { status: r.status, text: text, error: "" }
  } catch (e) {
    return { status: 0, text: "", error: e.message }
  } finally {
    dl.finish()
  }
}

// One exchange of a subject token: the credentials, the form, the endpoint and the POST. Nothing is cached here.
export async function exchangeToken(cfg: McpTokenExchange, subject: string, idp: IdpEndpoints, issuer: string, idpId: string, idpSecret: string): Promise<ExchangeResult> {
  const cr = credentialsOf(cfg, idpId, idpSecret)
  if (cr.error !== "") return refused(cr.error)
  let body = ""
  try {
    body = try exchangeBody(cfg, cr.id, cr.secret, subject)
  } catch (e) {
    return refused(e.message)
  }
  const r = await postForm(cfg, body, idp, issuer)
  if (r.error !== "") return refused(r.error)
  if (r.status < 200 || r.status >= 300) {
    const parsed = parseExchange(r.text)
    const msg = parsed.error !== "" && parsed.error !== "the answer has no access token" ? parsed.error : `HTTP ${r.status}`
    return isRejection(r.status, r.text) ? rejectedBy(msg) : refused(msg)
  }
  return parseExchange(r.text)
}

// One renewal of an exchanged token with its refresh token (the refresh_token grant at the same endpoint, with
// the same client credentials). A refusal for good comes back rejected, with Bifrost's reason text.
export async function refreshExchanged(cfg: McpTokenExchange, refreshToken: string, idp: IdpEndpoints, issuer: string, idpId: string, idpSecret: string): Promise<ExchangeResult> {
  const cr = credentialsOf(cfg, idpId, idpSecret)
  if (cr.error !== "") return refused(cr.error)
  let body = ""
  try {
    body = try refreshBody(cr.id, cr.secret, refreshToken)
  } catch (e) {
    return refused(e.message)
  }
  const r = await postForm(cfg, body, idp, issuer)
  if (r.error !== "") return refused(r.error)
  if (r.status < 200 || r.status >= 300) {
    if (isRejection(r.status, r.text)) return rejectedBy(rejectionReason(r.status, r.text))
    return refused(`token request failed with status ${r.status}`)
  }
  return parseExchange(r.text)
}

// ---- the admin credential a verification keeps ----

// Whether a retained admin credential was marked as needing a new verification.
export function needsReverify(row: McpUserToken): bool {
  return row.status === "needs_reauth"
}

// When a retained admin credential is renewed, in epoch milliseconds: RENEW_LEAD_MS before it expires, or
// halfway through a shorter life. A credential without a refresh token cannot be renewed, so it is looked at
// when it expires (and then marked). 0: never (no expiry named, or it already needs a new verification).
export function renewAt(row: McpUserToken): f64 {
  if (needsReverify(row) || row.token_expires_at <= 0.0) return 0.0
  if (row.refresh_token === "") return row.token_expires_at
  let lead = RENEW_LEAD_MS
  const life = row.token_expires_at - row.last_refreshed_at
  if (life > 0.0 && life / 2.0 < lead) lead = life / 2.0
  return row.token_expires_at - lead
}

// Whether a credential is due for renewal at nowMs; retryAt holds off a renewal that failed for a passing reason.
export function renewDue(row: McpUserToken, retryAt: f64, nowMs: f64): bool {
  const at = renewAt(row)
  return at > 0.0 && at <= nowMs && retryAt <= nowMs
}

// The earliest time any of the clients' credentials is due (each held off by its retry time), or 0 when none
// ever is. clients names the token_exchange clients; rows of other clients are left alone.
export function nextRenewal(rows: McpUserToken[], retry: Map<string, f64>, clients: string[]): f64 {
  let best = 0.0
  for (const r of rows) {
    if (!clients.includes(r.mcp_client_name)) continue
    let at = renewAt(r)
    if (at <= 0.0) continue
    const hold = retry.get(r.mcp_client_name) ?? 0.0
    if (hold > at) at = hold
    if (best === 0.0 || at < best) best = at
  }
  return best
}

// The credential after a renewal: the new access token and lifetime; the refresh token is kept unless a new
// one was issued (rotation).
export function renewedRow(row: McpUserToken, r: ExchangeResult, nowMs: f64): McpUserToken {
  let n = row
  n.access_token = r.token
  if (r.refreshToken !== "") n.refresh_token = r.refreshToken
  n.token_expires_at = r.expiresIn > 0.0 ? nowMs + r.expiresIn * 1000.0 : 0.0
  n.last_refreshed_at = nowMs
  n.status = "active"
  n.status_reason = ""
  return n
}

// The credential marked as needing a new verification, with the reason (Bifrost's needs_reauth).
export function reverifyRow(row: McpUserToken, reason: string): McpUserToken {
  let n = row
  n.status = "needs_reauth"
  n.status_reason = "admin token exchange failed: " + reason
  return n
}

// The outcome of one renewal: the row to keep (changed: renewed, or marked as needing a new verification), or
// the passing reason it failed (changed false: keep the row and try again later).
export type Renewal = { row: McpUserToken, changed: bool, error: string }

// Renews a retained admin credential with its refresh token. No refresh token, or a refusal for good, marks
// it as needing a new verification; any other failure leaves it to be tried again.
export async function renewAdmin(cfg: McpTokenExchange, row: McpUserToken, idp: IdpEndpoints, issuer: string, idpId: string, idpSecret: string, nowMs: f64): Promise<Renewal> {
  if (row.refresh_token === "") return { row: reverifyRow(row, "admin exchange credential has no refresh token to renew with"), changed: true, error: "" }
  const r = await refreshExchanged(cfg, row.refresh_token, idp, issuer, idpId, idpSecret)
  if (r.error === "") return { row: renewedRow(row, r, nowMs), changed: true, error: "" }
  if (r.rejected) return { row: reverifyRow(row, r.error), changed: true, error: "" }
  return { row: row, changed: false, error: r.error }
}

// How a retained admin credential is shown (Bifrost's MCPClientCredentialResponse): its status and why, its
// expiry and last renewal, and whether a refresh token is held. No token value appears.
export type AdminCredential = {
  kind: string,
  status: string,
  status_reason?: string,
  expires_at?: string,
  last_refreshed_at?: string,
  has_refresh_token: bool,
  created_at: string,
}

export function adminCredential(row: McpUserToken): AdminCredential {
  const reason = row.status_reason ?? ""
  return {
    kind: "oauth",
    status: needsReverify(row) ? "needs_reauth" : "active",
    status_reason: reason !== "" ? reason : undefined,
    expires_at: row.token_expires_at > 0.0 ? rfc3339Of(row.token_expires_at) : undefined,
    last_refreshed_at: row.last_refreshed_at > row.created_at ? rfc3339Of(row.last_refreshed_at) : undefined,
    has_refresh_token: row.refresh_token !== "",
    created_at: rfc3339Of(row.created_at),
  }
}

// the form body, or "" when it cannot be built (tests only)
function formOf(cfg: McpTokenExchange, clientId: string, clientSecret: string, subject: string): string {
  try {
    return exchangeBody(cfg, clientId, clientSecret, subject)
  } catch (e) {
    return ""
  }
}

test("the exchange form names the grant, the subject, the audience and the client", () => {
  const cfg: McpTokenExchange = { audience: "api://jira", scopes: ["read", "write"] }
  const body = formOf(cfg, "cid", "sec", "a.b.c")
  expect(body.includes("grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Atoken-exchange")).toBe(true)
  expect(body.includes("subject_token=a.b.c")).toBe(true)
  expect(body.includes("subject_token_type=urn%3Aietf%3Aparams%3Aoauth%3Atoken-type%3Aaccess_token")).toBe(true)
  expect(body.includes("audience=api%3A%2F%2Fjira")).toBe(true)
  expect(body.includes("client_id=cid")).toBe(true)
  expect(body.includes("client_secret=sec")).toBe(true)
  expect(body.includes("scope=read%20write")).toBe(true)
  // a public client sends no secret
  expect(formOf(cfg, "cid", "", "t").includes("client_secret")).toBe(false)
})

test("the exchange credentials are the client's own, or the login application's with use_idp_credentials", () => {
  const own: McpTokenExchange = { audience: "x", client_id: "exch", client_secret: "s1" }
  expect(credentialsOf(own, "login", "s0").id).toBe("exch")
  expect(credentialsOf(own, "login", "s0").secret).toBe("s1")
  const idp: McpTokenExchange = { audience: "x", use_idp_credentials: true }
  expect(credentialsOf(idp, "login", "s0").id).toBe("login")
  expect(credentialsOf(idp, "login", "s0").secret).toBe("s0")
  expect(credentialsOf(idp, "", "").error.includes("client_id")).toBe(true)
  expect(credentialsOf({ audience: "x" }, "login", "").error.includes("client_id")).toBe(true)
})

test("an exchange answer gives its token and lifetime, or the identity provider's error", () => {
  const ok = parseExchange(`{"access_token":"tok","expires_in":3600,"token_type":"Bearer"}`)
  expect(ok.token).toBe("tok")
  expect(ok.expiresIn).toBe(3600.0)
  expect(ok.error).toBe("")
  const refusedAnswer = parseExchange(`{"error":"invalid_grant","error_description":"subject token expired"}`)
  expect(refusedAnswer.token).toBe("")
  expect(refusedAnswer.error).toBe("subject token expired")
  expect(parseExchange(`{"error":"invalid_target"}`).error).toBe("invalid_target")
  expect(parseExchange("<html>").error.includes("not JSON")).toBe(true)
  expect(parseExchange(`{"token_type":"Bearer"}`).error.includes("no access token")).toBe(true)
})

test("the endpoint is the client's authorization_server_url, else the discovered one", () => {
  expect(endpointOf({ audience: "x", authorization_server_url: "https://as.example/token" }, "https://idp/token")).toBe("https://as.example/token")
  expect(endpointOf({ audience: "x" }, "https://idp/token")).toBe("https://idp/token")
  expect(endpointOf({ audience: "x" }, "")).toBe("")
})

test("cached exchanged tokens are used until shortly before they expire, per caller and subject", () => {
  const c = new ExchangeCache()
  const k = exchangeKey("jira", "vk-1", "subject-one")
  expect(k.includes("subject-one")).toBe(false)
  expect(exchangeKey("jira", "vk-1", "subject-two") === k).toBe(false)
  expect(exchangeKey("jira", "vk-2", "subject-one") === k).toBe(false)
  c.put(k, "exchanged", 3600.0, 1000.0)
  expect(c.get(k, 1000.0)).toBe("exchanged")
  expect(c.get(k, 1000.0 + 3570000.0 - 1.0)).toBe("exchanged")
  // the margin is 30 seconds before the hour is up
  expect(c.get(k, 1000.0 + 3570000.0 + 1.0)).toBe(undefined)
  c.put(k, "again", 3600.0, 5000.0)
  c.drop(k)
  expect(c.get(k, 1000.0)).toBe(undefined)
})

test("an answer without a lifetime is kept for the default, and a short lifetime keeps its length", () => {
  const c = new ExchangeCache()
  c.put("none", "t1", 0.0, 0.0)
  expect(c.get("none", 269000.0)).toBe("t1")
  expect(c.get("none", 271000.0)).toBe(undefined)
  c.put("short", "t2", 20.0, 0.0)
  expect(c.get("short", 19000.0)).toBe("t2")
  expect(c.get("short", 21000.0)).toBe(undefined)
})

function adminRow(expires: f64, refreshed: f64, refresh: string): McpUserToken {
  return { id: "exchange-jira", mcp_client_name: "jira", virtual_key_id: "", session_id: "", access_token: "adm-1", refresh_token: refresh, token_expires_at: expires, scopes: [], created_at: 0.0, last_refreshed_at: refreshed }
}

// the renewal form, or "" when it cannot be built (tests only)
function refreshFormOf(clientId: string, clientSecret: string, rt: string): string {
  try {
    return refreshBody(clientId, clientSecret, rt)
  } catch (e) {
    return ""
  }
}

test("an exchange answer keeps the refresh token it issued", () => {
  const r = parseExchange(`{"access_token":"tok","expires_in":60,"refresh_token":" rt-1 "}`)
  expect(r.refreshToken).toBe("rt-1")
  expect(parseExchange(`{"access_token":"tok"}`).refreshToken).toBe("")
})

test("the renewal form is the refresh_token grant with the exchange's client credentials", () => {
  const body = refreshFormOf("exch", "sec", "rt/1")
  expect(body.includes("grant_type=refresh_token")).toBe(true)
  expect(body.includes("refresh_token=rt%2F1")).toBe(true)
  expect(body.includes("client_id=exch")).toBe(true)
  expect(body.includes("client_secret=sec")).toBe(true)
  expect(refreshFormOf("exch", "", "rt").includes("client_secret")).toBe(false)
})

test("a refusal for good is a 401, or a 400 invalid_grant or unauthorized_client; the reason names the error", () => {
  expect(isRejection(401, "")).toBe(true)
  expect(isRejection(400, `{"error":"invalid_grant"}`)).toBe(true)
  expect(isRejection(400, `{"error":"unauthorized_client"}`)).toBe(true)
  expect(isRejection(400, `{"error":"invalid_request"}`)).toBe(false)
  expect(isRejection(400, "<html>")).toBe(false)
  expect(isRejection(503, `{"error":"invalid_grant"}`)).toBe(false)
  expect(rejectionReason(400, `{"error":"invalid_grant","error_description":"refresh token revoked"}`)).toBe("provider rejected the refresh (HTTP 400, invalid_grant: refresh token revoked)")
  expect(rejectionReason(400, `{"error":"invalid_grant"}`)).toBe("provider rejected the refresh (HTTP 400, invalid_grant)")
  expect(rejectionReason(401, "nope")).toBe("provider rejected the refresh (HTTP 401)")
})

test("an admin credential is renewed five minutes before it expires, or halfway through a shorter life", () => {
  // an hour-long credential: at 55 minutes
  const hour = adminRow(3600000.0, 0.0, "rt")
  expect(renewAt(hour)).toBe(3300000.0)
  expect(renewDue(hour, 0.0, 3299999.0)).toBe(false)
  expect(renewDue(hour, 0.0, 3300000.0)).toBe(true)
  // a four-second credential: after two seconds
  const short = adminRow(14000.0, 10000.0, "rt")
  expect(renewAt(short)).toBe(12000.0)
  // a failed attempt holds the next one off until its retry time
  expect(renewDue(short, 20000.0, 13000.0)).toBe(false)
  expect(renewDue(short, 20000.0, 20000.0)).toBe(true)
  // no refresh token: looked at when it expires; no expiry, or already marked: never
  expect(renewAt(adminRow(14000.0, 10000.0, ""))).toBe(14000.0)
  expect(renewAt(adminRow(0.0, 10000.0, "rt"))).toBe(0.0)
  expect(renewAt(reverifyRow(short, "x"))).toBe(0.0)
})

test("the next renewal is the earliest due time of the token_exchange clients, held off by retries", () => {
  let other = adminRow(5000.0, 0.0, "rt")
  other.mcp_client_name = "gone"
  const a = adminRow(3600000.0, 0.0, "rt")
  let b = adminRow(20000.0, 10000.0, "rt")
  b.mcp_client_name = "wiki"
  const none: Map<string, f64> = new Map()
  expect(nextRenewal([other, a, b], none, ["jira", "wiki"])).toBe(15000.0)
  const held: Map<string, f64> = new Map()
  held.set("wiki", 40000.0)
  expect(nextRenewal([a, b], held, ["jira", "wiki"])).toBe(40000.0)
  expect(nextRenewal([a], none, ["wiki"])).toBe(0.0)
  expect(nextRenewal([reverifyRow(a, "x")], none, ["jira"])).toBe(0.0)
})

test("a renewal replaces the access token and keeps the refresh token unless a new one came", () => {
  const row = reverifyRow(adminRow(5000.0, 0.0, "rt-old"), "earlier")
  const kept = renewedRow(row, { token: "adm-2", expiresIn: 60.0, error: "", refreshToken: "", rejected: false }, 100000.0)
  expect(kept.access_token).toBe("adm-2")
  expect(kept.refresh_token).toBe("rt-old")
  expect(kept.token_expires_at).toBe(160000.0)
  expect(kept.last_refreshed_at).toBe(100000.0)
  expect(needsReverify(kept)).toBe(false)
  const rotated = renewedRow(row, { token: "adm-3", expiresIn: 0.0, error: "", refreshToken: "rt-new", rejected: false }, 1.0)
  expect(rotated.refresh_token).toBe("rt-new")
  expect(rotated.token_expires_at).toBe(0.0)
})

test("a credential that needs a new verification says why, and its view shows no token", () => {
  const row = reverifyRow(adminRow(5000.0, 0.0, "rt-secret"), "provider rejected the refresh (HTTP 400, invalid_grant)")
  expect(needsReverify(row)).toBe(true)
  const v = adminCredential(row)
  expect(v.status).toBe("needs_reauth")
  expect((v.status_reason ?? "").includes("invalid_grant")).toBe(true)
  expect(v.has_refresh_token).toBe(true)
  expect(v.expires_at).toBe("1970-01-01T00:00:05Z")
  const text = JSON.stringify(v)
  expect(text.includes("rt-secret")).toBe(false)
  expect(text.includes("adm-1")).toBe(false)
  const fresh = adminCredential(adminRow(0.0, 0.0, ""))
  expect(fresh.status).toBe("active")
  expect(fresh.status_reason === undefined).toBe(true)
  expect(fresh.expires_at === undefined).toBe(true)
})
