// Model ids from the provider listings that are not OpenAI's shape: Bedrock's foundation models
// and inference profiles, Vertex's Model Garden publishers and Cloudflare's Workers AI search.
// server.tov fetches the pages; this module reads them. Ids come back as the provider names them.
import { fields, elements, find, rawStr } from "./json"

// The Workers AI tasks Bifrost lists (cloudflare/models.go): the chat and embeddings models.
const CLOUDFLARE_TASKS = ["Text Generation", "Text Embeddings"]

// The ids under one array of a Bedrock listing: modelSummaries[].modelId for the foundation models,
// inferenceProfileSummaries[].inferenceProfileId for the profiles. A missing array is none.
export function bedrockIds(text: string, arrayKey: string, idKey: string): string[] throws SyntaxError {
  const fs = try fields(text)
  const arr = find(fs, arrayKey)
  const ids: string[] = []
  if (arr === undefined || !arr.startsWith("[")) return ids
  for (const el of try elements(arr)) {
    const id = rawStr(try fields(el), idKey)
    if (id !== undefined && id !== "") ids.push(id)
  }
  return ids
}

// The model id of a Model Garden name ("publishers/google/models/gemini-2.5-pro" gives "gemini-2.5-pro").
export function publisherModelId(name: string): string {
  const parts = name.split("/")
  return parts[parts.length - 1] ?? ""
}

// One page of a publisher listing: the ids, and the token of the next page ("" on the last page).
export function publisherPage(text: string): { ids: string[], next: string } throws SyntaxError {
  const fs = try fields(text)
  const ids: string[] = []
  const arr = find(fs, "publisherModels")
  if (arr !== undefined && arr.startsWith("[")) {
    for (const el of try elements(arr)) {
      const id = publisherModelId(rawStr(try fields(el), "name") ?? "")
      if (id !== "") ids.push(id)
    }
  }
  return { ids: ids, next: rawStr(fs, "nextPageToken") ?? "" }
}

// The path of one Workers AI model-search page under the account (1-based page number).
export function cloudflareSearchPath(page: int): string {
  return `/ai/models/search?per_page=100&page=${page}`
}

// The ids of one Workers AI search page whose task is one Bifrost lists, and whether the page was full
// (a full page means another may follow).
export function cloudflarePage(text: string): { ids: string[], full: bool } throws SyntaxError {
  const fs = try fields(text)
  const ids: string[] = []
  const arr = find(fs, "result")
  let count = 0
  if (arr !== undefined && arr.startsWith("[")) {
    for (const el of try elements(arr)) {
      count++
      const f = try fields(el)
      const task = find(f, "task")
      const taskName = task === undefined || !task.startsWith("{") ? "" : rawStr(try fields(task), "name") ?? ""
      const name = rawStr(f, "name") ?? ""
      if (CLOUDFLARE_TASKS.includes(taskName) && name !== "") ids.push(name)
    }
  }
  return { ids: ids, full: count >= 100 }
}

test("Bedrock listings: foundation models and inference profiles", () => {
  const fm = `{"modelSummaries":[{"modelArn":"arn:x","modelId":"anthropic.claude-3-haiku-20240307-v1:0","modelName":"Claude 3 Haiku"},{"modelId":"amazon.titan-embed-text-v2:0"}]}`
  expect(try bedrockIds(fm, "modelSummaries", "modelId").join(",")).toBe("anthropic.claude-3-haiku-20240307-v1:0,amazon.titan-embed-text-v2:0")
  const ip = `{"inferenceProfileSummaries":[{"inferenceProfileId":"us.anthropic.claude-sonnet-4-20250514-v1:0","status":"ACTIVE"}]}`
  expect(try bedrockIds(ip, "inferenceProfileSummaries", "inferenceProfileId").join(",")).toBe("us.anthropic.claude-sonnet-4-20250514-v1:0")
  expect(try bedrockIds(`{}`, "modelSummaries", "modelId").length).toBe(0)
})

test("Vertex publisher pages give the model ids and the next token", () => {
  expect(publisherModelId("publishers/google/models/gemini-2.5-pro")).toBe("gemini-2.5-pro")
  expect(publisherModelId("publishers/anthropic/models/claude-sonnet-4@20250514")).toBe("claude-sonnet-4@20250514")
  const p1 = try publisherPage(`{"publisherModels":[{"name":"publishers/google/models/gemini-2.5-flash"},{"name":"publishers/google/models/gemini-2.5-pro"}],"nextPageToken":"t2"}`)
  expect(p1.ids.join(",")).toBe("gemini-2.5-flash,gemini-2.5-pro")
  expect(p1.next).toBe("t2")
  const p2 = try publisherPage(`{"publisherModels":[{"name":"publishers/google/models/imagen-3"}]}`)
  expect(p2.next).toBe("")
})

test("Cloudflare search pages keep the text generation and embeddings models", () => {
  const page = `{"success":true,"result":[{"name":"@cf/meta/llama-3.1-8b-instruct","task":{"name":"Text Generation"}},{"name":"@cf/baai/bge-base-en-v1.5","task":{"name":"Text Embeddings"}},{"name":"@cf/stabilityai/stable-diffusion-xl-base-1.0","task":{"name":"Text-to-Image"}}]}`
  const p = try cloudflarePage(page)
  expect(p.ids.join(",")).toBe("@cf/meta/llama-3.1-8b-instruct,@cf/baai/bge-base-en-v1.5")
  expect(p.full).toBe(false)
  expect(cloudflareSearchPath(2)).toBe("/ai/models/search?per_page=100&page=2")
})
