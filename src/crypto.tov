import { readFileSync } from "node:fs"
// SHA-256 and HMAC-SHA256 (FIPS 180-4, RFC 2104), for AWS SigV4 request
// signing. Written in Tov so the gateway stays one native binary without a
// JavaScript engine. Words are kept in int and masked to 32 bits.

const M32 = 0xffffffff

const K: int[] = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]

function rotr(x: int, n: int): int {
  return ((x >> n) | (x << (32 - n))) & M32
}

const enc = new TextEncoder()

export function utf8(s: string): u8[] {
  return enc.encode(s)
}

// SHA-256 over input that arrives in pieces: update() as often as needed, then digest().
export class Sha256 {
  private h: int[] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
  private w: int[] = []
  private buf: u8[] = []
  // the bytes hashed so far
  total = 0

  constructor() {
    for (let i = 0; i < 64; i++) this.w.push(0)
  }

  private block(data: u8[], off: int): void {
    // (the fields are used in place: a local copy of an array would not carry the changes back)
    for (let i = 0; i < 16; i++) {
      const j = off + i * 4
      this.w[i] = (int(data[j]!) << 24) | (int(data[j + 1]!) << 16) | (int(data[j + 2]!) << 8) | int(data[j + 3]!)
    }
    for (let i = 16; i < 64; i++) {
      const w15 = this.w[i - 15]!
      const w2 = this.w[i - 2]!
      const s0 = rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >> 3)
      const s1 = rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >> 10)
      this.w[i] = (this.w[i - 16]! + s0 + this.w[i - 7]! + s1) & M32
    }
    let a = this.h[0]!
    let b = this.h[1]!
    let c = this.h[2]!
    let d = this.h[3]!
    let e = this.h[4]!
    let f = this.h[5]!
    let g = this.h[6]!
    let hh = this.h[7]!
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
      const ch = (e & f) ^ ((~e & M32) & g)
      const t1 = (hh + S1 + ch + K[i]! + this.w[i]!) & M32
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
      const maj = (a & b) ^ (a & c) ^ (b & c)
      const t2 = (S0 + maj) & M32
      hh = g
      g = f
      f = e
      e = (d + t1) & M32
      d = c
      c = b
      b = a
      a = (t1 + t2) & M32
    }
    this.h[0] = (this.h[0]! + a) & M32
    this.h[1] = (this.h[1]! + b) & M32
    this.h[2] = (this.h[2]! + c) & M32
    this.h[3] = (this.h[3]! + d) & M32
    this.h[4] = (this.h[4]! + e) & M32
    this.h[5] = (this.h[5]! + f) & M32
    this.h[6] = (this.h[6]! + g) & M32
    this.h[7] = (this.h[7]! + hh) & M32
  }

  update(b: u8[]): void {
    const n = b.length
    this.total += n
    let i = 0
    if (this.buf.length > 0) {
      while (i < n && this.buf.length < 64) {
        this.buf.push(b[i]!)
        i += 1
      }
      if (this.buf.length < 64) return
      this.block(this.buf, 0)
      this.buf = []
    }
    while (i + 64 <= n) {
      this.block(b, i)
      i += 64
    }
    while (i < n) {
      this.buf.push(b[i]!)
      i += 1
    }
  }

  // the hash of everything given to update (the hasher is spent afterwards)
  digest(): u8[] {
    const bitLen = this.total * 8
    const tail: u8[] = this.buf.slice()
    tail.push(u8(0x80))
    while (tail.length % 64 !== 56) tail.push(u8(0))
    for (let i = 7; i >= 0; i--) tail.push(u8((bitLen >> (i * 8)) & 0xff))
    this.buf = []
    for (let off = 0; off < tail.length; off += 64) this.block(tail, off)
    const out: u8[] = []
    for (const v of this.h) {
      out.push(u8((v >> 24) & 0xff))
      out.push(u8((v >> 16) & 0xff))
      out.push(u8((v >> 8) & 0xff))
      out.push(u8(v & 0xff))
    }
    return out
  }
}

export function sha256(msg: u8[]): u8[] {
  const s = new Sha256()
  s.update(msg)
  return s.digest()
}

export function hmacSha256(key: u8[], msg: u8[]): u8[] {
  let k = key
  if (k.length > 64) k = sha256(k)
  const ipad: u8[] = []
  const opad: u8[] = []
  for (let i = 0; i < 64; i++) {
    const b = i < k.length ? int(k[i]!) : 0
    ipad.push(u8(b ^ 0x36))
    opad.push(u8(b ^ 0x5c))
  }
  const inner = sha256(ipad.concat(msg))
  return sha256(opad.concat(inner))
}

// ---- SHA-512 and SHA-384 (FIPS 180-4) ----
// int traps on overflow, so each 64-bit word is a pair of 32-bit halves (hi, lo).

// the 80 round constants, as hi, lo pairs
const K512: int[] = [
  0x428a2f98, 0xd728ae22, 0x71374491, 0x23ef65cd, 0xb5c0fbcf, 0xec4d3b2f, 0xe9b5dba5, 0x8189dbbc,
  0x3956c25b, 0xf348b538, 0x59f111f1, 0xb605d019, 0x923f82a4, 0xaf194f9b, 0xab1c5ed5, 0xda6d8118,
  0xd807aa98, 0xa3030242, 0x12835b01, 0x45706fbe, 0x243185be, 0x4ee4b28c, 0x550c7dc3, 0xd5ffb4e2,
  0x72be5d74, 0xf27b896f, 0x80deb1fe, 0x3b1696b1, 0x9bdc06a7, 0x25c71235, 0xc19bf174, 0xcf692694,
  0xe49b69c1, 0x9ef14ad2, 0xefbe4786, 0x384f25e3, 0x0fc19dc6, 0x8b8cd5b5, 0x240ca1cc, 0x77ac9c65,
  0x2de92c6f, 0x592b0275, 0x4a7484aa, 0x6ea6e483, 0x5cb0a9dc, 0xbd41fbd4, 0x76f988da, 0x831153b5,
  0x983e5152, 0xee66dfab, 0xa831c66d, 0x2db43210, 0xb00327c8, 0x98fb213f, 0xbf597fc7, 0xbeef0ee4,
  0xc6e00bf3, 0x3da88fc2, 0xd5a79147, 0x930aa725, 0x06ca6351, 0xe003826f, 0x14292967, 0x0a0e6e70,
  0x27b70a85, 0x46d22ffc, 0x2e1b2138, 0x5c26c926, 0x4d2c6dfc, 0x5ac42aed, 0x53380d13, 0x9d95b3df,
  0x650a7354, 0x8baf63de, 0x766a0abb, 0x3c77b2a8, 0x81c2c92e, 0x47edaee6, 0x92722c85, 0x1482353b,
  0xa2bfe8a1, 0x4cf10364, 0xa81a664b, 0xbc423001, 0xc24b8b70, 0xd0f89791, 0xc76c51a3, 0x0654be30,
  0xd192e819, 0xd6ef5218, 0xd6990624, 0x5565a910, 0xf40e3585, 0x5771202a, 0x106aa070, 0x32bbd1b8,
  0x19a4c116, 0xb8d2d0c8, 0x1e376c08, 0x5141ab53, 0x2748774c, 0xdf8eeb99, 0x34b0bcb5, 0xe19b48a8,
  0x391c0cb3, 0xc5c95a63, 0x4ed8aa4a, 0xe3418acb, 0x5b9cca4f, 0x7763e373, 0x682e6ff3, 0xd6b2b8a3,
  0x748f82ee, 0x5defb2fc, 0x78a5636f, 0x43172f60, 0x84c87814, 0xa1f0ab72, 0x8cc70208, 0x1a6439ec,
  0x90befffa, 0x23631e28, 0xa4506ceb, 0xde82bde9, 0xbef9a3f7, 0xb2c67915, 0xc67178f2, 0xe372532b,
  0xca273ece, 0xea26619c, 0xd186b8c7, 0x21c0c207, 0xeada7dd6, 0xcde0eb1e, 0xf57d4f7f, 0xee6ed178,
  0x06f067aa, 0x72176fba, 0x0a637dc5, 0xa2c898a6, 0x113f9804, 0xbef90dae, 0x1b710b35, 0x131c471b,
  0x28db77f5, 0x23047d84, 0x32caab7b, 0x40c72493, 0x3c9ebe0a, 0x15c9bebc, 0x431d67c4, 0x9c100d4c,
  0x4cc5d4be, 0xcb3e42b6, 0x597f299c, 0xfc657e2a, 0x5fcb6fab, 0x3ad6faec, 0x6c44198c, 0x4a475817,
]

// a + b on (hi, lo) words, wrapping at 2^64
function add64(ah: int, al: int, bh: int, bl: int): int[] {
  const lo = al + bl
  return [(ah + bh + (lo >> 32)) & M32, lo & M32]
}

// rotate right by n (0 < n < 64)
function rotr64(h: int, l: int, n: int): int[] {
  if (n === 32) return [l, h]
  if (n > 32) return rotr64(l, h, n - 32)
  return [((h >> n) | (l << (32 - n))) & M32, ((l >> n) | (h << (32 - n))) & M32]
}

// shift right by n (0 < n < 32)
function shr64(h: int, l: int, n: int): int[] {
  return [h >> n, ((l >> n) | (h << (32 - n))) & M32]
}

function xor3(a: int[], b: int[], c: int[]): int[] {
  return [a[0]! ^ b[0]! ^ c[0]!, a[1]! ^ b[1]! ^ c[1]!]
}

// SHA-512 (or SHA-384, with its own initial words and a 48-byte digest) over the whole message.
function sha512Family(msg: u8[], init: int[], outLen: int): u8[] {
  const hv: int[] = init.slice()
  const tail: u8[] = msg.slice()
  const bitLen = msg.length * 8
  tail.push(u8(0x80))
  while (tail.length % 128 !== 112) tail.push(u8(0))
  // a 128-bit length; the top 64 bits are zero for any message held in memory
  for (let i = 0; i < 8; i++) tail.push(u8(0))
  for (let i = 7; i >= 0; i--) tail.push(u8((bitLen >> (i * 8)) & 0xff))
  const w: int[] = []
  for (let i = 0; i < 160; i++) w.push(0)
  for (let off = 0; off < tail.length; off += 128) {
    for (let i = 0; i < 32; i++) {
      const j = off + i * 4
      w[i] = (int(tail[j]!) << 24) | (int(tail[j + 1]!) << 16) | (int(tail[j + 2]!) << 8) | int(tail[j + 3]!)
    }
    for (let t = 16; t < 80; t++) {
      const h15 = w[(t - 15) * 2]!
      const l15 = w[(t - 15) * 2 + 1]!
      const h2 = w[(t - 2) * 2]!
      const l2 = w[(t - 2) * 2 + 1]!
      const s0 = xor3(rotr64(h15, l15, 1), rotr64(h15, l15, 8), shr64(h15, l15, 7))
      const s1 = xor3(rotr64(h2, l2, 19), rotr64(h2, l2, 61), shr64(h2, l2, 6))
      let v = add64(w[(t - 16) * 2]!, w[(t - 16) * 2 + 1]!, s0[0]!, s0[1]!)
      v = add64(v[0]!, v[1]!, w[(t - 7) * 2]!, w[(t - 7) * 2 + 1]!)
      v = add64(v[0]!, v[1]!, s1[0]!, s1[1]!)
      w[t * 2] = v[0]!
      w[t * 2 + 1] = v[1]!
    }
    const s: int[] = hv.slice()
    for (let t = 0; t < 80; t++) {
      const eh = s[8]!
      const el = s[9]!
      const S1 = xor3(rotr64(eh, el, 14), rotr64(eh, el, 18), rotr64(eh, el, 41))
      const chh = (eh & s[10]!) ^ ((~eh & M32) & s[12]!)
      const chl = (el & s[11]!) ^ ((~el & M32) & s[13]!)
      let t1 = add64(s[14]!, s[15]!, S1[0]!, S1[1]!)
      t1 = add64(t1[0]!, t1[1]!, chh, chl)
      t1 = add64(t1[0]!, t1[1]!, K512[t * 2]!, K512[t * 2 + 1]!)
      t1 = add64(t1[0]!, t1[1]!, w[t * 2]!, w[t * 2 + 1]!)
      const ah = s[0]!
      const al = s[1]!
      const S0 = xor3(rotr64(ah, al, 28), rotr64(ah, al, 34), rotr64(ah, al, 39))
      const majh = (ah & s[2]!) ^ (ah & s[4]!) ^ (s[2]! & s[4]!)
      const majl = (al & s[3]!) ^ (al & s[5]!) ^ (s[3]! & s[5]!)
      const t2 = add64(S0[0]!, S0[1]!, majh, majl)
      for (let i = 15; i >= 2; i--) s[i] = s[i - 2]!
      const e = add64(s[8]!, s[9]!, t1[0]!, t1[1]!)
      s[8] = e[0]!
      s[9] = e[1]!
      const a = add64(t1[0]!, t1[1]!, t2[0]!, t2[1]!)
      s[0] = a[0]!
      s[1] = a[1]!
    }
    for (let i = 0; i < 16; i += 2) {
      const v = add64(hv[i]!, hv[i + 1]!, s[i]!, s[i + 1]!)
      hv[i] = v[0]!
      hv[i + 1] = v[1]!
    }
  }
  const out: u8[] = []
  for (const v of hv) {
    out.push(u8((v >> 24) & 0xff))
    out.push(u8((v >> 16) & 0xff))
    out.push(u8((v >> 8) & 0xff))
    out.push(u8(v & 0xff))
  }
  return out.slice(0, outLen)
}

const SHA512_INIT: int[] = [0x6a09e667, 0xf3bcc908, 0xbb67ae85, 0x84caa73b, 0x3c6ef372, 0xfe94f82b, 0xa54ff53a, 0x5f1d36f1, 0x510e527f, 0xade682d1, 0x9b05688c, 0x2b3e6c1f, 0x1f83d9ab, 0xfb41bd6b, 0x5be0cd19, 0x137e2179]
const SHA384_INIT: int[] = [0xcbbb9d5d, 0xc1059ed8, 0x629a292a, 0x367cd507, 0x9159015a, 0x3070dd17, 0x152fecd8, 0xf70e5939, 0x67332667, 0xffc00b31, 0x8eb44a87, 0x68581511, 0xdb0c2e0d, 0x64f98fa7, 0x47b5481d, 0xbefa4fa4]

export function sha512(msg: u8[]): u8[] {
  return sha512Family(msg, SHA512_INIT, 64)
}

export function sha384(msg: u8[]): u8[] {
  return sha512Family(msg, SHA384_INIT, 48)
}

// HMAC (RFC 2104) over SHA-384 or SHA-512, whose block is 128 bytes.
function hmac512Family(key: u8[], msg: u8[], hash: (m: u8[]) => u8[]): u8[] {
  let k = key
  if (k.length > 128) k = hash(k)
  const ipad: u8[] = []
  const opad: u8[] = []
  for (let i = 0; i < 128; i++) {
    const b = i < k.length ? int(k[i]!) : 0
    ipad.push(u8(b ^ 0x36))
    opad.push(u8(b ^ 0x5c))
  }
  return hash(opad.concat(hash(ipad.concat(msg))))
}

export function hmacSha384(key: u8[], msg: u8[]): u8[] {
  return hmac512Family(key, msg, sha384)
}

export function hmacSha512(key: u8[], msg: u8[]): u8[] {
  return hmac512Family(key, msg, sha512)
}

const HEXCHARS = "0123456789abcdef"

// n hex digits from the kernel's CSPRNG. Each read of /proc/sys/kernel/random/uuid
// is a fresh random v4 UUID: 122 random bits, i.e. 30 usable hex digits once the
// fixed version digit (index 12) and variant digit (index 16) are dropped.
// Tov exposes no other secure source, so this throws rather than fall back to Math.random.
export function secureHex(n: int): string throws Error {
  let out = ""
  while (out.byteLength < n) {
    const u = (try readFileSync("/proc/sys/kernel/random/uuid", "utf8")).trim().replaceAll("-", "")
    if (u.byteLength !== 32) throw new Error("the kernel random source returned an unexpected value")
    out += u.slice(0, 12) + u.slice(13, 16) + u.slice(17)
  }
  return out.slice(0, n)
}

export function toHex(b: u8[]): string {
  const parts: string[] = []
  for (const x of b) {
    const v = int(x)
    parts.push(HEXCHARS.slice(v >> 4, (v >> 4) + 1) + HEXCHARS.slice(v & 15, (v & 15) + 1))
  }
  return parts.join("")
}

test("sha256 known vectors", () => {
  expect(toHex(sha256(utf8("")))).toBe("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
  expect(toHex(sha256(utf8("abc")))).toBe("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  expect(toHex(sha256(utf8("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")))).toBe("248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
})

test("secure hex digits are random and well-formed", () => {
  const a = try secureHex(64)
  const b = try secureHex(64)
  expect(a.byteLength).toBe(64)
  expect(a === b).toBe(false)
  let ok = true
  for (const c of a.chars()) {
    if (!HEXCHARS.includes(c)) ok = false
  }
  expect(ok).toBe(true)
})

test("sha256 in pieces matches sha256 whole", () => {
  const data: u8[] = []
  for (let i = 0; i < 1000; i++) data.push(u8((i * 7 + 3) % 251))
  const whole = toHex(sha256(data))
  for (const step of [1, 3, 63, 64, 65, 100, 999, 1000]) {
    const s = new Sha256()
    let i = 0
    while (i < data.length) {
      const e = i + step < data.length ? i + step : data.length
      s.update(data.slice(i, e))
      i = e
    }
    expect(toHex(s.digest())).toBe(whole)
  }
  expect(toHex(new Sha256().digest())).toBe("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
})

test("hmac-sha256 RFC 4231 case 2", () => {
  expect(toHex(hmacSha256(utf8("Jefe"), utf8("what do ya want for nothing?")))).toBe("5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
})

test("sha512 and sha384 known vectors", () => {
  expect(toHex(sha512(utf8("abc")))).toBe("ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
  expect(toHex(sha512(utf8("")))).toBe("cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
  expect(toHex(sha384(utf8("abc")))).toBe("cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
  expect(toHex(sha384(utf8("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")))).toBe("09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039")
})

test("hmac-sha384 and hmac-sha512 RFC 4231 case 2", () => {
  expect(toHex(hmacSha384(utf8("Jefe"), utf8("what do ya want for nothing?")))).toBe("af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
  expect(toHex(hmacSha512(utf8("Jefe"), utf8("what do ya want for nothing?")))).toBe("164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
})
