// SHA-256 and HMAC-SHA256 (FIPS 180-4, RFC 2104), for AWS SigV4 request
// signing. Written in Tov so the gateway stays one native binary without a
// JavaScript engine. Words are kept in int and masked to 32 bits.

const M32 = 0xffffffff

const K: int[] = [
  0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
  0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
  0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
  0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
  0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
  0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
  0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
  0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
]

function rotr(x: int, n: int): int {
  return ((x >> n) | (x << (32 - n))) & M32
}

const enc = new TextEncoder()

export function utf8(s: string): u8[] {
  return enc.encode(s)
}

export function sha256(msg: u8[]): u8[] {
  const h: int[] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
  const bitLen = msg.length * 8
  const data: u8[] = msg.slice()
  data.push(u8(0x80))
  while (data.length % 64 !== 56) data.push(u8(0))
  for (let i = 7; i >= 0; i--) data.push(u8((bitLen >> (i * 8)) & 0xff))
  const w: int[] = []
  for (let i = 0; i < 64; i++) w.push(0)
  for (let off = 0; off < data.length; off += 64) {
    for (let i = 0; i < 16; i++) {
      const j = off + i * 4
      w[i] = (int(data[j]!) << 24) | (int(data[j + 1]!) << 16) | (int(data[j + 2]!) << 8) | int(data[j + 3]!)
    }
    for (let i = 16; i < 64; i++) {
      const w15 = w[i - 15]!
      const w2 = w[i - 2]!
      const s0 = rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >> 3)
      const s1 = rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >> 10)
      w[i] = (w[i - 16]! + s0 + w[i - 7]! + s1) & M32
    }
    let a = h[0]!
    let b = h[1]!
    let c = h[2]!
    let d = h[3]!
    let e = h[4]!
    let f = h[5]!
    let g = h[6]!
    let hh = h[7]!
    for (let i = 0; i < 64; i++) {
      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
      const ch = (e & f) ^ ((~e & M32) & g)
      const t1 = (hh + S1 + ch + K[i]! + w[i]!) & M32
      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
      const maj = (a & b) ^ (a & c) ^ (b & c)
      const t2 = (S0 + maj) & M32
      hh = g
      g = f
      f = e
      e = (d + t1) & M32
      d = c
      c = b
      b = a
      a = (t1 + t2) & M32
    }
    h[0] = (h[0]! + a) & M32
    h[1] = (h[1]! + b) & M32
    h[2] = (h[2]! + c) & M32
    h[3] = (h[3]! + d) & M32
    h[4] = (h[4]! + e) & M32
    h[5] = (h[5]! + f) & M32
    h[6] = (h[6]! + g) & M32
    h[7] = (h[7]! + hh) & M32
  }
  const out: u8[] = []
  for (const v of h) {
    out.push(u8((v >> 24) & 0xff))
    out.push(u8((v >> 16) & 0xff))
    out.push(u8((v >> 8) & 0xff))
    out.push(u8(v & 0xff))
  }
  return out
}

export function hmacSha256(key: u8[], msg: u8[]): u8[] {
  let k = key
  if (k.length > 64) k = sha256(k)
  const ipad: u8[] = []
  const opad: u8[] = []
  for (let i = 0; i < 64; i++) {
    const b = i < k.length ? int(k[i]!) : 0
    ipad.push(u8(b ^ 0x36))
    opad.push(u8(b ^ 0x5c))
  }
  const inner = sha256(ipad.concat(msg))
  return sha256(opad.concat(inner))
}

const HEXCHARS = "0123456789abcdef"

export function toHex(b: u8[]): string {
  const parts: string[] = []
  for (const x of b) {
    const v = int(x)
    parts.push(HEXCHARS.slice(v >> 4, (v >> 4) + 1) + HEXCHARS.slice(v & 15, (v & 15) + 1))
  }
  return parts.join("")
}

test("sha256 known vectors", () => {
  expect(toHex(sha256(utf8("")))).toBe("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
  expect(toHex(sha256(utf8("abc")))).toBe("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  expect(toHex(sha256(utf8("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")))).toBe("248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
})

test("hmac-sha256 RFC 4231 case 2", () => {
  expect(toHex(hmacSha256(utf8("Jefe"), utf8("what do ya want for nothing?")))).toBe("5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
})
