// Virtual key expiry and rotation grace: RFC 3339 times in config, as Bifrost writes them.

// Days from 1970-01-01 to the given civil date (proleptic Gregorian).
function daysFromCivil(y0: number, m: number, d: number): number {
  const y = m <= 2 ? y0 - 1 : y0
  const era = Math.floor(y / 400)
  const yoe = y - era * 400
  const mp = m > 2 ? m - 3 : m + 9
  const doy = Math.floor((153 * mp + 2) / 5) + d - 1
  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy
  return era * 146097 + doe - 719468
}

// The instant an RFC 3339 time names, in epoch milliseconds, or undefined when it is not one.
// Accepts a fraction of seconds and a Z or +hh:mm / -hh:mm offset.
export function rfc3339Ms(s: string): number | undefined {
  if (s.byteLength < 20) return undefined
  if (s.slice(4, 5) !== "-" || s.slice(7, 8) !== "-" || s.slice(10, 11) !== "T" || s.slice(13, 14) !== ":" || s.slice(16, 17) !== ":") return undefined
  const y = parseInt(s.slice(0, 4))
  const mo = parseInt(s.slice(5, 7))
  const d = parseInt(s.slice(8, 10))
  const hh = parseInt(s.slice(11, 13))
  const mi = parseInt(s.slice(14, 16))
  const ss = parseInt(s.slice(17, 19))
  if (y === undefined || mo === undefined || d === undefined || hh === undefined || mi === undefined || ss === undefined) return undefined
  if (mo < 1 || mo > 12 || d < 1 || d > 31 || hh > 23 || mi > 59 || ss > 60) return undefined
  let i = 19
  let frac = 0.0
  if (s.slice(i, i + 1) === ".") {
    i += 1
    let scale = 100.0
    while (i < s.byteLength && s.slice(i, i + 1) >= "0" && s.slice(i, i + 1) <= "9") {
      frac += scale * parseInt(s.slice(i, i + 1))!
      scale = scale / 10.0
      i += 1
    }
  }
  let off = 0
  const z = s.slice(i)
  if (z === "Z" || z === "z") {
    off = 0
  } else if (z.byteLength === 6 && (z.startsWith("+") || z.startsWith("-")) && z.slice(3, 4) === ":") {
    const oh = parseInt(z.slice(1, 3))
    const om = parseInt(z.slice(4, 6))
    if (oh === undefined || om === undefined || oh > 23 || om > 59) return undefined
    off = (oh * 60 + om) * (z.startsWith("-") ? -1 : 1)
  } else {
    return undefined
  }
  const days = daysFromCivil(y, mo, d)
  const secs = days * 86400 + hh * 3600 + mi * 60 + ss - off * 60
  return secs * 1000 + Math.floor(frac)
}

// The RFC 3339 UTC text (whole seconds, Z) for epoch milliseconds.
export function rfc3339Of(ms: number): string {
  const secs = Math.floor(ms / 1000)
  const days = Math.floor(secs / 86400)
  const rem = secs - days * 86400
  // civil date from the day count (Howard Hinnant's algorithm)
  const z = days + 719468
  const era = Math.floor(z / 146097)
  const doe = z - era * 146097
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365)
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100))
  const mp = Math.floor((5 * doy + 2) / 153)
  const d = doy - Math.floor((153 * mp + 2) / 5) + 1
  const m = mp < 10 ? mp + 3 : mp - 9
  const y = yoe + era * 400 + (m <= 2 ? 1 : 0)
  return pad(y, 4) + "-" + pad(m, 2) + "-" + pad(d, 2) + "T" + pad(Math.floor(rem / 3600), 2) + ":" + pad(Math.floor((rem % 3600) / 60), 2) + ":" + pad(rem % 60, 2) + "Z"
}

function pad(n: number, w: number): string {
  let s = `${Math.floor(n)}`
  while (s.byteLength < w) s = "0" + s
  return s
}

test("rfc3339Ms reads Z, offsets and fractions, and refuses other text", () => {
  expect(rfc3339Ms("1970-01-01T00:00:00Z")).toBe(0)
  expect(rfc3339Ms("1969-12-31T23:59:59Z")).toBe(-1000)
  expect(rfc3339Ms("2024-02-29T00:00:00Z")).toBe(1709164800000)
  expect(rfc3339Ms("2026-10-15T12:00:00Z")).toBe(1792065600000)
  expect(rfc3339Ms("2026-10-15T16:30:00+04:30")).toBe(1792065600000)
  expect(rfc3339Ms("2026-10-15T07:30:00-04:30")).toBe(1792065600000)
  expect(rfc3339Ms("2026-10-15T12:00:00.250Z")).toBe(1792065600250)
  expect(rfc3339Ms("2026-10-15 12:00:00Z") === undefined).toBe(true)
  expect(rfc3339Ms("2026-10-15T12:00:00") === undefined).toBe(true)
  expect(rfc3339Ms("2026-13-15T12:00:00Z") === undefined).toBe(true)
  expect(rfc3339Ms("tomorrow") === undefined).toBe(true)
})

test("rfc3339Of writes whole seconds in UTC and reads back", () => {
  expect(rfc3339Of(0)).toBe("1970-01-01T00:00:00Z")
  expect(rfc3339Of(-1000)).toBe("1969-12-31T23:59:59Z")
  expect(rfc3339Of(1792065600999)).toBe("2026-10-15T12:00:00Z")
  expect(rfc3339Of(1709164800000)).toBe("2024-02-29T00:00:00Z")
  expect(rfc3339Ms(rfc3339Of(1792074600000))).toBe(1792074600000)
})
