// Per-token prices in USD for cost tracking and budgets.
//
// find(provider, model) tries, in order:
//   1. config.pricing: "provider/model" or "model", per token
//   2. Bifrost pricing overrides (governance.pricing_overrides), patched over
//      the datasheet price for the same model
//   3. the datasheet: exact "provider/model" key, "model" key, provider + base
//      model; then the same with a trailing "-YYYYMMDD" removed; then the
//      longest key the model starts with, or contains as ".key" (regions).
//
// The datasheet is PRICING_DATA (scripts/gen_pricing.py); replaceCatalog swaps
// in a fresh one parsed by parseDatasheet. Rows carry no mode, so chat and
// embedding entries are looked up alike.
import { Config, PricingEntry } from "./config"
import { PRICING_DATA } from "./pricing_data"

// USD per token. A missing cache rate bills cached tokens at the input rate. The decision rates
// bill a decision request's tokens; a missing one is the normal rate (computeDecisionCost in Bifrost).
// inputAudio and outputAudio are the rates of audio tokens (realtime and audio models report them in
// their usage details; a missing one bills audio tokens at the text rate), perSecond is the voice rate
// (USD per second, input_cost_per_second). A live session bills its seconds at it (liveCost in livehooks.tov,
// as Bifrost's computeLiveCost); a transcription whose answer has no tokens bills its seconds at it
// (transcriptionCost). inputCharacter is the rate per character of speech's input (input_cost_per_character).
export type Price = { input: f64, output: f64, cacheRead?: f64, cacheWrite?: f64, inputDecisions?: f64, outputDecisions?: f64, inputAudio?: f64, outputAudio?: f64, perSecond?: f64, inputCharacter?: f64 }

// The tokens a realtime or live response used, as the provider reports them: prompt and completion are
// the totals, cached the part of the prompt read from cache, and inputAudio and outputAudio the audio
// tokens among them.
export type TokenUsage = { prompt: int, completion: int, cached: int, inputAudio: int, outputAudio: int }

// A transcription's usage as Bifrost's extractTranscriptionUsage reads it: the prompt and completion tokens,
// the audio and text tokens of the prompt when the answer splits them (0 otherwise), and the seconds of
// audio (undefined when the answer gives none).
export type SttUsage = { prompt: int, completion: int, inputAudio: int, inputText: int, seconds: f64 | undefined }

// One datasheet row with the provider and base model it was filed under.
export type PriceRow = { provider: string, baseModel: string, price: Price }

// A request's price split into its input and output parts (USD).
export type CostParts = { input: f64, output: f64 }

// A pricing override as Bifrost stores it. Only scope_kind "global" and
// "provider" apply; virtual-key scopes need request context and are skipped
// (setOverrides returns how many it skipped). request_types decide which billing
// an override patches: "decisions" for a decision request, any other type for the
// rest. An override with no request_types patches both, as before.
export type PricingOverride = {
  scope_kind: string,
  provider_id?: string,
  request_types?: string[],
  match_type: string,
  pattern: string,
  pricing_patch: string,
}

// Rates an override sets. pricing_patch is JSON in Bifrost's field names;
// only the fields present replace the datasheet's.
type PricePatch = {
  input_cost_per_token?: f64,
  output_cost_per_token?: f64,
  cache_read_input_token_cost?: f64,
  cache_creation_input_token_cost?: f64,
  input_cost_per_token_decisions?: f64,
  output_cost_per_token_decisions?: f64,
  input_cost_per_audio_token?: f64,
  output_cost_per_audio_token?: f64,
  input_cost_per_second?: f64,
}

// decisions and others: whether the patch applies to a decision request, and to any other request.
type Patch = { provider: string, pattern: string, wildcard: bool, rates: PricePatch, decisions: bool, others: bool }

type Catalog = {
  rows: Map<string, PriceRow>,
  byBase: Map<string, PriceRow>,   // "provider|baseModel" -> plainest row
  keys: string[],                  // longest first, for prefix matching
  byModel: Map<string, string[]>,  // bare model name -> providers that serve it
}

type DatasheetEntry = {
  provider?: string,
  base_model?: string,
  input_cost_per_token?: f64,
  output_cost_per_token?: f64,
  cache_read_input_token_cost?: f64,
  cache_creation_input_token_cost?: f64,
  input_cost_per_audio_token?: f64,
  output_cost_per_audio_token?: f64,
  input_cost_per_second?: f64,
  input_cost_per_character?: f64,
}

// Bedrock variants and Vertex's two spellings are filed under one name each.
function normalizeProvider(p: string): string {
  if (p.startsWith("bedrock")) return "bedrock"
  if (p === "vertex" || p === "google-vertex") return "vertex_ai"
  return p
}

function makeRow(provider: string, baseModel: string, price: Price): PriceRow {
  return { provider: normalizeProvider(provider), baseModel, price: price }
}

// Parses PRICING_DATA's lines: key, provider, input, output, cacheRead, cacheWrite, baseModel and,
// in a ten or eleven column line, inputAudio, outputAudio, perSecond and, in the eleventh, inputCharacter.
// Empty rates are missing; malformed lines are skipped.
function parseTable(text: string): Map<string, PriceRow> {
  const rows: Map<string, PriceRow> = new Map()
  for (const line of text.split("\n")) {
    const f = line.split("\t")
    if (f.length !== 7 && f.length !== 10 && f.length !== 11) continue
    const input = parseFloat(f[2]!)
    const output = parseFloat(f[3]!)
    const wide = f.length >= 10
    const perSecond = wide ? parseFloat(f[9]!) : undefined
    const inputCharacter = f.length === 11 ? parseFloat(f[10]!) : undefined
    if (input === undefined && output === undefined && perSecond === undefined && inputCharacter === undefined) continue
    const inputAudio = wide ? parseFloat(f[7]!) : undefined
    const outputAudio = wide ? parseFloat(f[8]!) : undefined
    rows.set(f[0]!, makeRow(f[1]!, f[6]!, { input: input ?? 0.0, output: output ?? 0.0, cacheRead: parseFloat(f[4]!), cacheWrite: parseFloat(f[5]!), inputAudio, outputAudio, perSecond, inputCharacter }))
  }
  return rows
}

// Parses a Bifrost datasheet (https://getbifrost.ai/datasheet). Entries with no input, output, voice or
// character rate are dropped; a missing input or output rate is 0.
export function parseDatasheet(json: string): Map<string, PriceRow> throws SyntaxError {
  const sheet = try JSON.parse(json) as Record<string, DatasheetEntry>
  const rows: Map<string, PriceRow> = new Map()
  for (const k of sheet.keys()) {
    const e = sheet.get(k)!
    if (e.input_cost_per_token === undefined && e.output_cost_per_token === undefined && e.input_cost_per_second === undefined && e.input_cost_per_character === undefined) continue
    rows.set(k, makeRow(e.provider ?? "", e.base_model ?? "", { input: e.input_cost_per_token ?? 0.0, output: e.output_cost_per_token ?? 0.0, cacheRead: e.cache_read_input_token_cost, cacheWrite: e.cache_creation_input_token_cost, inputAudio: e.input_cost_per_audio_token, outputAudio: e.output_cost_per_audio_token, perSecond: e.input_cost_per_second, inputCharacter: e.input_cost_per_character }))
  }
  return rows
}

// Orders names by length, then by bytes; `dir` is 1 for shortest first.
function byLength(dir: int): (a: string, b: string) => int {
  return (a: string, b: string): int => {
    if (a.byteLength !== b.byteLength) return dir * (a.byteLength - b.byteLength)
    if (a === b) return 0
    return a < b ? -1 : 1
  }
}

function buildCatalog(rows: Map<string, PriceRow>): Catalog {
  const keys = rows.keys()
  // Shortest name first, so the plainest key wins for each provider and base model.
  keys.sort(byLength(1))
  const byBase: Map<string, PriceRow> = new Map()
  for (const k of keys) {
    const r = rows.get(k)!
    if (r.baseModel === "") continue
    const bk = r.provider + "|" + r.baseModel
    if (!byBase.has(bk)) byBase.set(bk, r)
  }
  const longest = keys.slice()
  longest.sort(byLength(-1))
  // Bare names: the key without its "provider/" part, and the base model.
  const byModel: Map<string, string[]> = new Map()
  for (const k of keys) {
    const r = rows.get(k)!
    if (r.provider === "") continue
    const pre = r.provider + "/"
    const names: string[] = [k.startsWith(pre) ? k.slice(pre.byteLength) : k]
    if (r.baseModel !== "") names.push(r.baseModel)
    for (const n of names) {
      // arrays are values: write the list back after adding to it
      const have: string[] = byModel.get(n) ?? []
      if (!have.includes(r.provider)) {
        have.push(r.provider)
        byModel.set(n, have)
      }
    }
  }
  return { rows, byBase, keys: longest, byModel: byModel }
}

const BUILTIN: Catalog = buildCatalog(parseTable(PRICING_DATA))

// A dated suffix is "-" and eight digits at the end of the name ("-20250514").
function stripDate(model: string): string {
  const n = model.byteLength
  if (n < 9 || model.slice(n - 9, n - 8) !== "-") return model
  for (let i = n - 8; i < n; i += 1) {
    const ch = model.slice(i, i + 1)
    if (ch < "0" || ch > "9") return model
  }
  return model.slice(0, n - 9)
}

// True when key k is at byte offset `at` of model and ends the name there.
function startsAt(model: string, k: string, at: int): bool {
  const end = at + k.byteLength
  if (model.slice(at, end) !== k) return false
  if (end === model.byteLength) return true
  const next = model.slice(end, end + 1)
  return next === "-" || next === ":" || next === "@"
}

function byName(c: Catalog, provider: string, model: string): PriceRow | undefined {
  const r = c.rows.get(provider + "/" + model)
  if (r !== undefined) return r
  const m = c.rows.get(model)
  if (m !== undefined) return m
  return c.byBase.get(normalizeProvider(provider) + "|" + model)
}

function prefixMatch(c: Catalog, model: string): PriceRow | undefined {
  for (const k of c.keys) {
    if (startsAt(model, k, 0)) return c.rows.get(k)
    const d = model.indexOf("." + k)
    if (d >= 0 && startsAt(model, k, d + 1)) return c.rows.get(k)
  }
  return undefined
}

// Providers the catalog lists for a bare model name, sorted by name. A dated
// name also matches its undated form.
function catalogProviders(c: Catalog, model: string): string[] {
  const hit: string[] | undefined = c.byModel.get(model) ?? c.byModel.get(stripDate(model))
  const out: string[] = hit === undefined ? [] : hit.slice()
  out.sort((a: string, b: string): int => (a < b ? -1 : a > b ? 1 : 0))
  return out
}

// Providers in the built-in datasheet that serve a bare model name.
export function datasheetProviders(model: string): string[] {
  return catalogProviders(BUILTIN, model)
}

function lookupDatasheet(c: Catalog, provider: string, model: string): Price | undefined {
  const exact = byName(c, provider, model)
  if (exact !== undefined) return exact.price
  const dated = stripDate(model)
  if (dated !== model) {
    const d = byName(c, provider, dated)
    if (d !== undefined) return d.price
  }
  const p = prefixMatch(c, dated)
  return p === undefined ? undefined : p.price
}

// Patches the datasheet price: fields the override sets win; a model with no
// datasheet row starts from zero rates.
function overlay(base: Price | undefined, r: PricePatch): Price {
  const b: Price = base ?? { input: 0.0, output: 0.0 }
  return {
    input: r.input_cost_per_token ?? b.input,
    output: r.output_cost_per_token ?? b.output,
    cacheRead: r.cache_read_input_token_cost ?? b.cacheRead,
    cacheWrite: r.cache_creation_input_token_cost ?? b.cacheWrite,
    inputDecisions: r.input_cost_per_token_decisions ?? b.inputDecisions,
    outputDecisions: r.output_cost_per_token_decisions ?? b.outputDecisions,
    inputAudio: r.input_cost_per_audio_token ?? b.inputAudio,
    outputAudio: r.output_cost_per_audio_token ?? b.outputAudio,
    perSecond: r.input_cost_per_second ?? b.perSecond,
    inputCharacter: b.inputCharacter,
  }
}

function overrideError(msg: string): SyntaxError {
  return new SyntaxError("pricing override: " + msg)
}

export class Pricing {
  overrides: Map<string, Price> = new Map()   // config.pricing, per token
  catalog: Catalog = BUILTIN
  patches: Patch[] = []                       // most specific first
  memo: Map<string, Price> = new Map()        // datasheet hits
  misses: Set<string> = new Set()             // datasheet misses

  constructor(cfg: Config) {
    const p = cfg.pricing
    if (p === undefined) return
    for (const k of p.keys()) {
      const e = p.get(k)!
      this.overrides.set(k, { input: e.input_cost_per_token, output: e.output_cost_per_token, cacheRead: e.cache_read_input_token_cost, inputAudio: e.input_cost_per_audio_token, outputAudio: e.output_cost_per_audio_token, perSecond: e.input_cost_per_second })
    }
  }

  // Swaps in a datasheet from parseDatasheet. Pure: the caller does the fetch.
  replaceCatalog(rows: Map<string, PriceRow>): void {
    this.catalog = buildCatalog(rows)
    this.clearMemo()
  }

  // Installs governance.pricing_overrides, replacing any earlier set. Returns
  // how many entries were skipped for an unsupported scope. Throws SyntaxError
  // for a malformed entry, leaving the previous set in place.
  setOverrides(list: PricingOverride[]): int throws SyntaxError {
    const groups: Patch[][] = [[], [], [], []]   // provider exact, provider wildcard, global exact, global wildcard
    let skipped = 0
    for (const o of list) {
      if (o.scope_kind !== "global" && o.scope_kind !== "provider") {
        skipped += 1
        continue
      }
      const provider = o.scope_kind === "provider" ? normalizeProvider(o.provider_id ?? "") : ""
      if (o.scope_kind === "provider" && provider === "") throw overrideError("provider scope needs provider_id")
      const rates = try JSON.parse(o.pricing_patch) as PricePatch
      let pattern = o.pattern
      let wildcard = false
      if (o.match_type === "wildcard") {
        wildcard = true
        if (!pattern.endsWith("*")) throw overrideError("wildcard pattern must end with *")
        pattern = pattern.slice(0, pattern.byteLength - 1)
      } else if (o.match_type !== "exact") {
        throw overrideError("unknown match_type " + o.match_type)
      }
      const types = o.request_types ?? []
      const decisions = types.length === 0 || types.includes("decisions")
      const others = types.length === 0 || types.filter((t: string): bool => t !== "decisions").length > 0
      const g = (provider === "" ? 2 : 0) + (wildcard ? 1 : 0)
      groups[g]!.push({ provider, pattern, wildcard, rates, decisions, others })
    }
    for (const g of [1, 3]) groups[g]!.sort((a, b) => b.pattern.byteLength - a.pattern.byteLength)
    const out: Patch[] = []
    for (const g of groups) for (const p of g) out.push(p)
    this.patches = out
    this.clearMemo()
    return skipped
  }

  clearMemo(): void {
    this.memo = new Map()
    this.misses = new Set()
  }

  patchFor(provider: string, model: string, decision: bool): PricePatch | undefined {
    const p = normalizeProvider(provider)
    for (const x of this.patches) {
      if (x.provider !== "" && x.provider !== p) continue
      if (decision ? !x.decisions : !x.others) continue
      const hit = x.wildcard ? model.startsWith(x.pattern) : model === x.pattern
      if (hit) return x.rates
    }
    return undefined
  }

  // Providers in the loaded datasheet that serve a bare model name.
  providersFor(model: string): string[] {
    return catalogProviders(this.catalog, model)
  }

  datasheet(provider: string, model: string): Price | undefined {
    const key = provider + "\n" + model
    const hit = this.memo.get(key)
    if (hit !== undefined) return hit
    if (this.misses.has(key)) return undefined
    const p = lookupDatasheet(this.catalog, provider, model)
    if (p === undefined) {
      if (this.misses.size >= 4096) this.misses = new Set()
      this.misses.add(key)
      return undefined
    }
    if (this.memo.size >= 4096) this.memo = new Map()
    this.memo.set(key, p)
    return p
  }

  // Per-token price for the model, or undefined when nothing prices it. decision picks the
  // billing of a decision request: the overrides that cover decisions apply.
  priceFor(provider: string, model: string, decision: bool): Price | undefined {
    const c = this.overrides.get(provider + "/" + model) ?? this.overrides.get(model)
    if (c !== undefined) return c
    const base = this.datasheet(provider, model)
    const patch = this.patchFor(provider, model, decision)
    if (patch === undefined) return base
    return overlay(base, patch)
  }

  find(provider: string, model: string): Price | undefined {
    return this.priceFor(provider, model, false)
  }

  known(provider: string, model: string): bool {
    return this.find(provider, model) !== undefined
  }

  // The first of refs without a price (a fallback the key may use counts), or undefined when
  // all are priced. A budgeted request is refused for it when refuse_unpriced_models is on.
  // decision prices the refs as decision requests.
  unpriced(refs: { provider: string, model: string }[], decision?: bool): { provider: string, model: string } | undefined {
    for (const r of refs) {
      if (this.priceFor(r.provider, r.model, decision === true) === undefined) return r
    }
    return undefined
  }

  // USD for one request; 0 when the model's price is unknown. promptTokens
  // includes the cached ones (cachedRead and cachedWrite are subsets of it),
  // as the Anthropic translator reports them.
  cost(provider: string, model: string, promptTokens: int, completionTokens: int, cachedRead?: int, cachedWrite?: int): f64 {
    const p = this.find(provider, model)
    if (p === undefined) return 0.0
    const r = cachedRead ?? 0
    const w = cachedWrite ?? 0
    const fresh = Math.max(0, promptTokens - r - w)
    const readRate = p.cacheRead ?? p.input
    const writeRate = p.cacheWrite ?? p.input
    return fresh * p.input + r * readRate + w * writeRate + completionTokens * p.output
  }

  // USD for one decision request: its tokens at the decision rates when the price has them, else
  // the normal rates (computeDecisionCost). A negative rate marks a model with no fixed price, so
  // nothing is billed for it.
  decisionCost(provider: string, model: string, promptTokens: int, completionTokens: int): f64 {
    const p = this.priceFor(provider, model, true)
    if (p === undefined) return 0.0
    const ri = p.inputDecisions ?? p.input
    const ro = p.outputDecisions ?? p.output
    if (ri < 0 || ro < 0) return 0.0
    return promptTokens * ri + completionTokens * ro
  }

  // The input and output parts of a realtime or live response's price, as Bifrost's computeTextCost
  // splits them: cached prompt tokens at the cache rate, audio tokens at the audio rates (taken out of
  // the text cost; a missing audio rate leaves them at the text rate), the rest at the text rates. Both
  // are 0 when the model's price is unknown.
  usageParts(provider: string, model: string, u: TokenUsage): CostParts {
    const p = this.find(provider, model)
    if (p === undefined) return { input: 0.0, output: 0.0 }
    const prompt = Math.max(0, u.prompt)
    const completion = Math.max(0, u.completion)
    const cached = Math.min(Math.max(0, u.cached), prompt)
    const fresh = prompt - cached
    let input = fresh * p.input + cached * (p.cacheRead ?? p.input)
    let output = completion * p.output
    const ia = p.inputAudio
    if (ia !== undefined) {
      // audio tokens are taken from the uncached ones
      const n = Math.min(Math.min(Math.max(0, u.inputAudio), prompt), fresh)
      input += n * (ia - p.input)
    }
    const oa = p.outputAudio
    if (oa !== undefined) {
      const n = Math.min(Math.max(0, u.outputAudio), completion)
      output += n * (oa - p.output)
    }
    return { input: input, output: output }
  }

  // USD of a realtime or live response's tokens.
  usageCost(provider: string, model: string, u: TokenUsage): f64 {
    const c = this.usageParts(provider, model, u)
    return c.input + c.output
  }

  // USD of a live session's voice time: seconds at the model's rate per second (0 without one). Callers bill
  // only live sessions with it; a realtime session's tokens are its cost.
  voiceCost(provider: string, model: string, seconds: f64): f64 {
    const p = this.find(provider, model)
    if (p === undefined || seconds <= 0.0) return 0.0
    return seconds * (p.perSecond ?? 0.0)
  }

  // The input and output parts of a transcription (Bifrost's computeTranscriptionCost). The input is audio:
  // its audio and text tokens when the answer splits its prompt, else the prompt tokens, else its seconds at the
  // voice rate. The output is the text tokens. Both are 0 when the model's price is unknown.
  transcriptionCost(provider: string, model: string, u: SttUsage): CostParts {
    const p = this.find(provider, model)
    if (p === undefined) return { input: 0.0, output: 0.0 }
    let input = 0.0
    if (u.inputAudio > 0 || u.inputText > 0) {
      input = Math.max(0, u.inputAudio) * (p.inputAudio ?? p.input) + Math.max(0, u.inputText) * p.input
    } else if (u.prompt > 0) {
      input = u.prompt * p.input
    } else if (u.seconds !== undefined && u.seconds > 0 && (p.perSecond ?? 0.0) > 0) {
      input = u.seconds * (p.perSecond ?? 0.0)
    }
    return { input: input, output: Math.max(0, u.completion) * p.output }
  }

  // The input and output parts of speech (Bifrost's computeSpeechCost). The input is its characters at the
  // per-character rate, which Bifrost takes at the text rate when the model has none; without characters, its
  // prompt tokens at the text rate. The output is the audio tokens at the audio rate (the text rate when none).
  // Speech answers carry no seconds here, so no per-second output is billed. Both are 0 when the price is unknown.
  speechCost(provider: string, model: string, chars: int, promptTokens: int, completionTokens: int): CostParts {
    const p = this.find(provider, model)
    if (p === undefined) return { input: 0.0, output: 0.0 }
    let input = 0.0
    if (chars > 0) input = chars * (p.inputCharacter ?? p.input)
    else if (promptTokens > 0) input = promptTokens * p.input
    const output = completionTokens > 0 ? completionTokens * (p.outputAudio ?? p.output) : 0.0
    return { input: input, output: output }
  }

  // The input and output parts of a request's price without cache tokens (Bifrost's input_cost and
  // output_cost); both are 0 when the model's price is unknown.
  costParts(provider: string, model: string, promptTokens: int, completionTokens: int): CostParts {
    const p = this.find(provider, model)
    if (p === undefined) return { input: 0.0, output: 0.0 }
    return { input: promptTokens * p.input, output: completionTokens * p.output }
  }
}

test("datasheet prices for OpenAI, Anthropic, Gemini and Vertex", () => {
  const p = new Pricing({})
  expect(p.cost("openai", "gpt-4o", 1000000, 0)).toBeCloseTo(2.5)
  expect(p.cost("openai", "gpt-4o", 0, 1000000)).toBeCloseTo(10.0)
  expect(p.cost("anthropic", "claude-sonnet-4-5", 1000000, 1000000)).toBeCloseTo(18.0)
  expect(p.cost("gemini", "gemini-2.5-pro", 1000000, 0)).toBeCloseTo(1.25)
  expect(p.cost("vertex_ai", "gemini-2.5-flash", 1000000, 0)).toBeCloseTo(0.3)
  expect(p.known("openai", "text-embedding-3-small")).toBe(true)
})

test("the input and output parts add up to the cost; an unknown model has none", () => {
  const p = new Pricing({})
  const parts = p.costParts("openai", "gpt-4o", 1000000, 1000000)
  expect(parts.input).toBeCloseTo(2.5)
  expect(parts.output).toBeCloseTo(10.0)
  expect(parts.input + parts.output).toBeCloseTo(p.cost("openai", "gpt-4o", 1000000, 1000000))
  const none = p.costParts("nowhere", "no-model", 5, 5)
  expect(none.input + none.output).toBe(0.0)
})

test("unpriced finds the first ref with no price, overrides included", () => {
  const p = new Pricing({})
  expect(p.unpriced([{ provider: "openai", model: "gpt-4o" }])).toBeUndefined()
  const bad = p.unpriced([{ provider: "openai", model: "gpt-4o" }, { provider: "acme", model: "fake-9" }])
  expect(bad!.provider).toBe("acme")
  expect(bad!.model).toBe("fake-9")
  expect(p.unpriced([])).toBeUndefined()
  const prices: Map<string, PricingEntry> = new Map()
  prices.set("acme/fake-9", { input_cost_per_token: 0.000001, output_cost_per_token: 0.000001 })
  const cfg: Config = { pricing: prices }
  expect(new Pricing(cfg).unpriced([{ provider: "acme", model: "fake-9" }])).toBeUndefined()
})

test("regional and dated names resolve to their base price", () => {
  const p = new Pricing({})
  expect(p.cost("bedrock", "us.anthropic.claude-sonnet-4-20250514-v1:0", 1000000, 0)).toBeCloseTo(3.0)
  expect(p.cost("bedrock", "claude-sonnet-4-20250514", 1000000, 0)).toBeCloseTo(3.0)
  expect(p.cost("bedrock", "anthropic.claude-sonnet-4-20250514-v1:0", 1000000, 0)).toBeCloseTo(3.0)
  expect(p.cost("openai", "gpt-4o-2024-08-06", 1000000, 0)).toBeCloseTo(2.5)
  expect(p.known("openai", "no-such-model")).toBe(false)
  expect(p.cost("openai", "no-such-model", 100, 100)).toBe(0.0)
})

test("cache read and write tokens are billed at their own rates", () => {
  const p = new Pricing({})
  // 1000 prompt tokens: 600 read from cache, none written.
  expect(p.cost("anthropic", "claude-sonnet-4-5", 1000, 0, 600)).toBeCloseTo(0.00138)
  // 200 of them written to cache as well.
  expect(p.cost("anthropic", "claude-sonnet-4-5", 1000, 0, 600, 200)).toBeCloseTo(0.00153)
  // gpt-4 has no cache rate, so cached tokens cost the input rate.
  expect(p.cost("openai", "gpt-4", 1000, 0, 500)).toBeCloseTo(0.03)
})

test("overrides: config beats Bifrost, provider scope beats global", () => {
  const cfg: Config = { pricing: new Map() }
  cfg.pricing!.set("openai/gpt-4o", { input_cost_per_token: 0.000001, output_cost_per_token: 0.000002 })
  const p = new Pricing(cfg)
  const skipped = try p.setOverrides([
    { scope_kind: "global", match_type: "exact", pattern: "gpt-4o", pricing_patch: "{\"input_cost_per_token\":0.000005}" },
    { scope_kind: "provider", provider_id: "openai", match_type: "wildcard", pattern: "gpt-4*", pricing_patch: "{\"input_cost_per_token\":0.000007}" },
    { scope_kind: "virtual_key", match_type: "exact", pattern: "gpt-4o", pricing_patch: "{}" },
  ])
  expect(skipped).toBe(1)
  // The config entry wins outright.
  expect(p.cost("openai", "gpt-4o", 1000000, 0)).toBeCloseTo(1.0)
  // Without it, the provider-scoped override patches the input rate and keeps the datasheet output.
  const q = new Pricing({})
  try q.setOverrides([
    { scope_kind: "global", match_type: "exact", pattern: "gpt-4o", pricing_patch: "{\"input_cost_per_token\":0.000005}" },
    { scope_kind: "provider", provider_id: "openai", match_type: "wildcard", pattern: "gpt-4*", pricing_patch: "{\"input_cost_per_token\":0.000007}" },
  ])
  expect(q.cost("openai", "gpt-4o", 1000000, 1000000)).toBeCloseTo(17.0)
  expect(q.cost("anthropic", "gpt-4o", 1000000, 0)).toBeCloseTo(5.0)
  // Override-only models: unset rates are zero.
  try q.setOverrides([{ scope_kind: "global", match_type: "exact", pattern: "my-model", pricing_patch: "{\"output_cost_per_token\":0.00001}" }])
  expect(q.cost("custom", "my-model", 1000000, 1000000)).toBeCloseTo(10.0)
  expect(q.cost("openai", "gpt-4o", 1000000, 0)).toBeCloseTo(2.5)
})

test("malformed overrides throw and keep the previous set", () => {
  const p = new Pricing({})
  try p.setOverrides([{ scope_kind: "global", match_type: "exact", pattern: "gpt-4o", pricing_patch: "{\"input_cost_per_token\":0.000001}" }])
  let threw = false
  try {
    p.setOverrides([{ scope_kind: "global", match_type: "exact", pattern: "gpt-4o", pricing_patch: "not json" }])
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  expect(p.cost("openai", "gpt-4o", 1000000, 0)).toBeCloseTo(1.0)
})

test("parseDatasheet and replaceCatalog swap the table", () => {
  const sample = "{" +
    "\"fake-1\": {\"provider\": \"acme\", \"base_model\": \"fake\", \"input_cost_per_token\": 0.000001, \"output_cost_per_token\": 0.000002, \"cache_read_input_token_cost\": 0.0000001, \"mode\": \"chat\"}," +
    "\"fake-2\": {\"provider\": \"acme\", \"base_model\": \"fake\", \"input_cost_per_token\": 0.000009, \"output_cost_per_token\": 0.000009}," +
    "\"output-only\": {\"provider\": \"acme\", \"output_cost_per_token\": 0.5}," +
    "\"no-price\": {\"provider\": \"acme\", \"mode\": \"image\"}" +
    "}"
  const rows = try parseDatasheet(sample)
  expect(rows.size).toBe(3)
  const p = new Pricing({})
  expect(p.known("acme", "fake-1")).toBe(false)
  p.replaceCatalog(rows)
  // Half the prompt is cached: 0.5 at 1.0 + 0.5 at 0.1, plus 2.0 of output.
  expect(p.cost("acme", "fake-1", 1000000, 1000000, 500000)).toBeCloseTo(2.55)
  // The plainest key wins for a provider and base model.
  expect(p.cost("acme", "fake", 1000000, 0)).toBeCloseTo(1.0)
  // Input is missing, so prompt tokens are free; one completion token costs 0.5.
  expect(p.cost("acme", "output-only", 1000000, 1)).toBeCloseTo(0.5)
  expect(p.known("acme", "no-price")).toBe(false)
  expect(p.cost("openai", "gpt-4o", 1000000, 0)).toBe(0.0)
  // Not in the new table, so the built-in one no longer applies.
  expect(p.known("openai", "gpt-4o")).toBe(false)
  let threw = false
  try {
    parseDatasheet("{\"x\": ")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("request_types: a decision takes the overrides that cover decisions, other requests the rest", () => {
  const p = new Pricing({})
  // The chat-only override comes first; the decision rates must not come from it.
  try p.setOverrides([
    { scope_kind: "global", request_types: ["chat_completion"], match_type: "exact", pattern: "jev-latest", pricing_patch: "{\"input_cost_per_token\":0.000001}" },
    { scope_kind: "global", request_types: ["decisions"], match_type: "exact", pattern: "jev-latest", pricing_patch: "{\"input_cost_per_token_decisions\":0.00002,\"output_cost_per_token_decisions\":0.00005}" },
  ])
  expect(p.decisionCost("typesafe", "jev-latest", 1000, 10)).toBeCloseTo(0.0205)
  // the chat override's input rate and the datasheet's output rate
  expect(p.cost("typesafe", "jev-latest", 1000, 10)).toBeCloseTo(0.001)
  // A decision-only override does not price other requests of the model: a model with no datasheet row
  // is unpriced for chat, and priced for decisions.
  const q = new Pricing({})
  try q.setOverrides([{ scope_kind: "global", request_types: ["decisions"], match_type: "exact", pattern: "fake-jev", pricing_patch: "{\"input_cost_per_token_decisions\":0.00002}" }])
  expect(q.known("typesafe", "fake-jev")).toBe(false)
  expect(q.cost("typesafe", "fake-jev", 1000, 0)).toBe(0.0)
  expect(q.decisionCost("typesafe", "fake-jev", 1000, 0)).toBeCloseTo(0.02)
  expect(q.unpriced([{ provider: "typesafe", model: "fake-jev" }], true)).toBeUndefined()
  expect(q.unpriced([{ provider: "typesafe", model: "fake-jev" }])!.model).toBe("fake-jev")
})

test("decision rates fall back to the normal rates, and an override without request_types covers both", () => {
  const p = new Pricing({})
  try p.setOverrides([{ scope_kind: "global", match_type: "exact", pattern: "my-model", pricing_patch: "{\"input_cost_per_token\":0.000003,\"output_cost_per_token\":0.000004}" }])
  expect(p.decisionCost("custom", "my-model", 1000000, 1000000)).toBeCloseTo(7.0)
  expect(p.cost("custom", "my-model", 1000000, 1000000)).toBeCloseTo(7.0)
  // A decision rate of zero is a rate: it bills nothing for the input.
  try p.setOverrides([{ scope_kind: "global", match_type: "exact", pattern: "my-model", request_types: ["decisions", "chat_completion"], pricing_patch: "{\"input_cost_per_token_decisions\":0}" }])
  expect(p.decisionCost("custom", "my-model", 1000000, 1000000)).toBeCloseTo(0.0)
  expect(p.cost("custom", "my-model", 1000000, 0)).toBe(0.0)
  // A negative rate is unpriced: nothing billed.
  try p.setOverrides([{ scope_kind: "global", match_type: "exact", pattern: "my-model", request_types: ["decisions"], pricing_patch: "{\"input_cost_per_token_decisions\":-1}" }])
  expect(p.decisionCost("custom", "my-model", 1000, 1000)).toBe(0.0)
  // A decision override on a datasheet model keeps the datasheet's rates for the other requests.
  try p.setOverrides([{ scope_kind: "global", match_type: "exact", pattern: "gpt-4o", request_types: ["decisions"], pricing_patch: "{\"output_cost_per_token_decisions\":0.00001}" }])
  expect(p.cost("openai", "gpt-4o", 1000000, 1000000)).toBeCloseTo(12.5)
  expect(p.decisionCost("openai", "gpt-4o", 1000000, 1000000)).toBeCloseTo(12.5)
})

test("a datasheet row carries audio token rates and a voice rate per second", () => {
  const sample = "{" +
    "\"rt-1\": {\"provider\": \"acme\", \"input_cost_per_token\": 0.000004, \"output_cost_per_token\": 0.000016, \"cache_read_input_token_cost\": 0.0000004, \"input_cost_per_audio_token\": 0.000032, \"output_cost_per_audio_token\": 0.000064}," +
    "\"live-1\": {\"provider\": \"acme\", \"input_cost_per_second\": 0.0005}" +
    "}"
  const p = new Pricing({})
  p.replaceCatalog(try parseDatasheet(sample))
  const a = p.find("acme", "rt-1")!
  expect(a.inputAudio!).toBeCloseTo(0.000032)
  expect(a.outputAudio!).toBeCloseTo(0.000064)
  // a row with only a voice rate is kept
  const l = p.find("acme", "live-1")!
  expect(l.perSecond!).toBeCloseTo(0.0005)
  expect(l.input).toBe(0.0)
  expect(p.voiceCost("acme", "live-1", 40.0)).toBeCloseTo(0.02)
  expect(p.voiceCost("acme", "rt-1", 40.0)).toBe(0.0)
  expect(p.voiceCost("acme", "live-1", 0.0)).toBe(0.0)
  expect(p.voiceCost("acme", "nowhere", 10.0)).toBe(0.0)
})

test("realtime usage: audio tokens at the audio rates, cached tokens at the cache rate", () => {
  const cfg: Config = { pricing: new Map() }
  cfg.pricing!.set("acme/rt", { input_cost_per_token: 0.000004, output_cost_per_token: 0.000016, cache_read_input_token_cost: 0.0000004, input_cost_per_audio_token: 0.000032, output_cost_per_audio_token: 0.000064 })
  const p = new Pricing(cfg)
  // 1000 prompt tokens: 200 cached, 300 of them audio; 500 completion tokens, 400 of them audio
  const u: TokenUsage = { prompt: 1000, completion: 500, cached: 200, inputAudio: 300, outputAudio: 400 }
  const parts = p.usageParts("acme", "rt", u)
  // input: 500 text at 4e-6, 300 audio at 32e-6, 200 cached at 0.4e-6
  expect(parts.input).toBeCloseTo(0.002 + 0.0096 + 0.00008)
  // output: 100 text at 16e-6, 400 audio at 64e-6
  expect(parts.output).toBeCloseTo(0.0016 + 0.0256)
  expect(p.usageCost("acme", "rt", u)).toBeCloseTo(parts.input + parts.output)
  // audio tokens beyond the uncached prompt are clamped, as Bifrost does
  const c = p.usageParts("acme", "rt", { prompt: 100, completion: 0, cached: 80, inputAudio: 100, outputAudio: 0 })
  expect(c.input).toBeCloseTo(20.0 * 0.000032 + 80.0 * 0.0000004)
  // negative counts are no counts
  const n = p.usageParts("acme", "rt", { prompt: -5, completion: -5, cached: -5, inputAudio: -5, outputAudio: -5 })
  expect(n.input + n.output).toBe(0.0)
  // an unknown model costs nothing
  expect(p.usageCost("acme", "nowhere", { prompt: 10, completion: 10, cached: 0, inputAudio: 0, outputAudio: 0 })).toBe(0.0)
})

test("without audio rates, audio tokens are text tokens; plain usage matches cost()", () => {
  const p = new Pricing({})
  const u: TokenUsage = { prompt: 1000, completion: 100, cached: 0, inputAudio: 500, outputAudio: 50 }
  expect(p.usageCost("openai", "gpt-4o", u)).toBeCloseTo(p.cost("openai", "gpt-4o", 1000, 100))
  const c: TokenUsage = { prompt: 1000, completion: 0, cached: 600, inputAudio: 0, outputAudio: 0 }
  expect(p.usageCost("anthropic", "claude-sonnet-4-5", c)).toBeCloseTo(p.cost("anthropic", "claude-sonnet-4-5", 1000, 0, 600))
})

test("an override patches the audio rates and the voice rate", () => {
  const p = new Pricing({})
  try p.setOverrides([{ scope_kind: "global", match_type: "exact", pattern: "gpt-realtime", pricing_patch: "{\"input_cost_per_audio_token\":0.00004,\"output_cost_per_audio_token\":0.00008,\"input_cost_per_second\":0.001}" }])
  const price = p.find("openai", "gpt-realtime")!
  expect(price.inputAudio!).toBeCloseTo(0.00004)
  expect(price.outputAudio!).toBeCloseTo(0.00008)
  expect(price.perSecond!).toBeCloseTo(0.001)
  // the datasheet's text rates stay
  expect(price.input).toBeCloseTo(0.000004)
  expect(p.voiceCost("openai", "gpt-realtime", 10.0)).toBeCloseTo(0.01)
})

test("the built-in table parses ten column rows", () => {
  const rows = parseTable("rt-x\tacme\t0.000001\t0.000002\t\t\trt-x\t0.00001\t0.00002\t\nlive-x\tacme\t\t\t\t\tlive-x\t\t\t0.002\nold\tacme\t0.1\t0.2\t\t\told\n")
  expect(rows.size).toBe(3)
  expect(rows.get("rt-x")!.price.inputAudio!).toBeCloseTo(0.00001)
  expect(rows.get("rt-x")!.price.perSecond).toBeUndefined()
  expect(rows.get("live-x")!.price.perSecond!).toBeCloseTo(0.002)
  expect(rows.get("old")!.price.outputAudio).toBeUndefined()
})

test("the built-in table carries the merged audio and voice rates, and its token rates stay", () => {
  const p = new Pricing({})
  // a transcription model: its audio token rate and per-second rate come from the price file
  const t = p.find("openai", "gpt-4o-transcribe")!
  expect(t.input).toBeCloseTo(0.0000025)
  expect(t.inputAudio!).toBeCloseTo(0.0000025)
  expect(t.perSecond!).toBeCloseTo(0.0001)
  // a realtime model the price file gives audio rates for
  expect(p.find("openai", "gpt-realtime-2")!.outputAudio!).toBeCloseTo(0.000064)
  // a model the price file gives no audio rate for keeps none
  expect(p.find("openai", "gpt-4o")!.inputAudio).toBeUndefined()
  // the speech and transcription rows added from the price file: OpenAI's TTS by character, Whisper by second
  expect(p.find("openai", "tts-1")!.inputCharacter!).toBeCloseTo(0.000015)
  expect(p.find("openai", "tts-1-hd")!.inputCharacter!).toBeCloseTo(0.00003)
  expect(p.speechCost("openai", "tts-1", 1000, 0, 0).input).toBeCloseTo(0.015)
  expect(p.find("openai", "whisper-1")!.perSecond!).toBeCloseTo(0.0001)
  expect(p.transcriptionCost("openai", "whisper-1", { prompt: 0, completion: 0, inputAudio: 0, inputText: 0, seconds: 125.0 }).input).toBeCloseTo(0.0125)
  // the live model: its voice rate per second (the price file gives no token rates for it)
  expect(p.find("openai", "gpt-live-1")!.perSecond!).toBeCloseTo(0.000833333333333)
  expect(p.voiceCost("openai", "gpt-live-1", 60.0)).toBeCloseTo(0.05)
})

test("an eleven column row carries an input character rate, alone or with the audio rates", () => {
  const rows = parseTable("tts-x\tacme\t\t\t\t\ttts-x\t\t\t\t0.00002\nrt-y\tacme\t0.000001\t0.000002\t\t\trt-y\t0.00001\t0.00002\t\t0.00003\n")
  expect(rows.size).toBe(2)
  expect(rows.get("tts-x")!.price.inputCharacter!).toBeCloseTo(0.00002)
  expect(rows.get("tts-x")!.price.input).toBe(0.0)
  expect(rows.get("rt-y")!.price.inputCharacter!).toBeCloseTo(0.00003)
  expect(rows.get("rt-y")!.price.inputAudio!).toBeCloseTo(0.00001)
  expect(rows.get("rt-y")!.price.perSecond).toBeUndefined()
})

// The sample rows of the transcription and speech tests: stt-1 has every audio rate, stt-2 no audio token
// rate, stt-3 no token rate and no voice rate; tts-1 has a character rate and an audio output rate, tts-2 neither.
const STT_SAMPLE = "{" +
  "\"stt-1\": {\"provider\": \"acme\", \"input_cost_per_token\": 0.00001, \"output_cost_per_token\": 0.00002, \"input_cost_per_audio_token\": 0.00003, \"input_cost_per_second\": 0.001}," +
  "\"stt-2\": {\"provider\": \"acme\", \"input_cost_per_token\": 0.00001, \"output_cost_per_token\": 0.00002, \"input_cost_per_second\": 0.001}," +
  "\"tts-1\": {\"provider\": \"acme\", \"input_cost_per_token\": 0.000001, \"output_cost_per_token\": 0.00002, \"input_cost_per_character\": 0.00001, \"output_cost_per_audio_token\": 0.00005}," +
  "\"tts-2\": {\"provider\": \"acme\", \"input_cost_per_token\": 0.000001, \"output_cost_per_token\": 0.00002}" +
  "}"

test("a transcription bills its audio and text tokens first, then its prompt tokens, then its seconds", () => {
  const p = new Pricing({})
  p.replaceCatalog(try parseDatasheet(STT_SAMPLE))
  const split: SttUsage = { prompt: 20, completion: 5, inputAudio: 10, inputText: 4, seconds: undefined }
  // 10 audio tokens at the audio rate and 4 text tokens at the text rate; the output is the 5 completion tokens
  const a = p.transcriptionCost("acme", "stt-1", split)
  expect(a.input).toBeCloseTo(10 * 0.00003 + 4 * 0.00001)
  expect(a.output).toBeCloseTo(5 * 0.00002)
  // no audio token rate: the audio tokens are billed at the text rate
  expect(p.transcriptionCost("acme", "stt-2", split).input).toBeCloseTo(14 * 0.00001)
  // no split: the prompt tokens at the text rate, and the seconds are not billed
  const plain = { prompt: 20, completion: 0, inputAudio: 0, inputText: 0, seconds: 30.0 }
  expect(p.transcriptionCost("acme", "stt-1", plain).input).toBeCloseTo(20 * 0.00001)
  expect(p.transcriptionCost("acme", "stt-1", plain).output).toBe(0.0)
  // a duration answer (no tokens): its seconds at the voice rate
  const timed = { prompt: 0, completion: 0, inputAudio: 0, inputText: 0, seconds: 30.0 }
  expect(p.transcriptionCost("acme", "stt-1", timed).input).toBeCloseTo(0.03)
  // no tokens and no seconds, or seconds with no rate, bill nothing
  expect(p.transcriptionCost("acme", "stt-1", { prompt: 0, completion: 0, inputAudio: 0, inputText: 0, seconds: undefined }).input).toBe(0.0)
  expect(p.transcriptionCost("acme", "tts-2", timed).input).toBe(0.0)
  // an unknown model costs nothing
  expect(p.transcriptionCost("acme", "nowhere", split).input).toBe(0.0)
})

test("speech bills its characters at the character rate, else at the text rate, then its tokens", () => {
  const p = new Pricing({})
  p.replaceCatalog(try parseDatasheet(STT_SAMPLE))
  // a character rate: 100 characters, and no output (the answer carries no tokens)
  const c = p.speechCost("acme", "tts-1", 100, 0, 0)
  expect(c.input).toBeCloseTo(100 * 0.00001)
  expect(c.output).toBe(0.0)
  // no character rate: the characters are billed at the text rate, as Bifrost does
  expect(p.speechCost("acme", "tts-2", 100, 0, 0).input).toBeCloseTo(100 * 0.000001)
  // no characters: the prompt tokens at the text rate
  expect(p.speechCost("acme", "tts-1", 0, 50, 0).input).toBeCloseTo(50 * 0.000001)
  // output tokens at the audio rate, or at the text rate when the model has none
  expect(p.speechCost("acme", "tts-1", 0, 0, 10).output).toBeCloseTo(10 * 0.00005)
  expect(p.speechCost("acme", "tts-2", 0, 0, 10).output).toBeCloseTo(10 * 0.00002)
  // an unknown model costs nothing
  expect(p.speechCost("acme", "nowhere", 100, 50, 10).input).toBe(0.0)
})

test("an override keeps the datasheet's character rate for speech", () => {
  const p = new Pricing({})
  p.replaceCatalog(try parseDatasheet(STT_SAMPLE))
  const set = try p.setOverrides([{ scope_kind: "global", match_type: "exact", pattern: "tts-1", pricing_patch: "{\"input_cost_per_token\": 0.5}" }])
  expect(set).toBe(0)
  // the patch replaces the text rate; the character rate is the datasheet's and stays
  expect(p.speechCost("acme", "tts-1", 100, 0, 0).input).toBeCloseTo(100 * 0.00001)
  expect(p.find("acme", "tts-1")!.input).toBeCloseTo(0.5)
})
