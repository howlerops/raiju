// Per-token prices for cost tracking and budgets. The built-in table covers
// common models (USD per million tokens, list prices); config.pricing entries
// ("provider/model" or "model", per token, as Bifrost writes them) override it.
import { Config } from "./config"

type Price = { input: f64, output: f64 }

function builtin(): Map<string, Price> {
  const m: Map<string, Price> = new Map()
  m.set("gpt-4o", { input: 2.5, output: 10.0 })
  m.set("gpt-4o-mini", { input: 0.15, output: 0.6 })
  m.set("gpt-4.1", { input: 2.0, output: 8.0 })
  m.set("gpt-4.1-mini", { input: 0.4, output: 1.6 })
  m.set("gpt-4.1-nano", { input: 0.1, output: 0.4 })
  m.set("o3", { input: 2.0, output: 8.0 })
  m.set("o4-mini", { input: 1.1, output: 4.4 })
  m.set("text-embedding-3-small", { input: 0.02, output: 0.0 })
  m.set("text-embedding-3-large", { input: 0.13, output: 0.0 })
  m.set("claude-opus-4", { input: 15.0, output: 75.0 })
  m.set("claude-sonnet-4", { input: 3.0, output: 15.0 })
  m.set("claude-3-5-haiku", { input: 0.8, output: 4.0 })
  m.set("gemini-2.5-pro", { input: 1.25, output: 10.0 })
  m.set("gemini-2.5-flash", { input: 0.3, output: 2.5 })
  m.set("gemini-2.0-flash", { input: 0.1, output: 0.4 })
  return m
}

const BUILTIN = builtin()

export class Pricing {
  overrides: Map<string, Price> = new Map()
  constructor(cfg: Config) {
    const p = cfg.pricing
    if (p === undefined) return
    for (const k of p.keys()) {
      const e = p.get(k)!
      this.overrides.set(k, { input: e.input_cost_per_token * 1000000.0, output: e.output_cost_per_token * 1000000.0 })
    }
  }

  find(provider: string, model: string): Price | undefined {
    const exact = this.overrides.get(provider + "/" + model) ?? this.overrides.get(model)
    if (exact !== undefined) return exact
    const b = BUILTIN.get(model)
    if (b !== undefined) return b
    // Dated and regional variants ("claude-sonnet-4-20250514",
    // "us.anthropic.claude-sonnet-4-...") match the longest known prefix.
    let best = ""
    for (const k of BUILTIN.keys()) {
      if ((model.startsWith(k) || model.includes("." + k)) && k.byteLength > best.byteLength) best = k
    }
    return best === "" ? undefined : BUILTIN.get(best)
  }

  // USD for one request; 0 when the model's price is unknown.
  cost(provider: string, model: string, promptTokens: int, completionTokens: int): f64 {
    const p = this.find(provider, model)
    if (p === undefined) return 0.0
    return (promptTokens * p.input + completionTokens * p.output) / 1000000.0
  }
}

test("costs from the table, prefixes and overrides", () => {
  const cfg: Config = { pricing: new Map() }
  cfg.pricing!.set("openai/gpt-4o", { input_cost_per_token: 0.000001, output_cost_per_token: 0.000002 })
  const p = new Pricing(cfg)
  expect(p.cost("openai", "gpt-4o", 1000000, 0)).toBeCloseTo(1.0)
  expect(p.cost("anthropic", "claude-sonnet-4-20250514", 1000, 1000)).toBeCloseTo(0.018)
  expect(p.cost("bedrock", "us.anthropic.claude-sonnet-4-20250514-v1:0", 1000000, 0)).toBeCloseTo(3.0)
  expect(p.cost("x", "unknown", 100, 100)).toBe(0.0)
})
