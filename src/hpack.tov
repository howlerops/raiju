  expect(d.entries()).toEqual([{ name: ":status", value: "307" }, { name: "location", value: "https://www.example.com" }, { name: "date", value: "Mon, 21 Oct 2013 20:13:21 GMT" }, { name: "cache-control", value: "private" }])
  expect(d.tableSize()).toBe(222)
  // step 3
  expect(try d.decode(hexOf("88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007"))).toEqual([{ name: ":status", value: "200" }, { name: "cache-control", value: "private" }, { name: "date", value: "Mon, 21 Oct 2013 20:13:22 GMT" }, { name: "location", value: "https://www.example.com" }, { name: "content-encoding", value: "gzip" }, { name: "set-cookie", value: "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1" }])
  expect(d.entries()).toEqual([{ name: "set-cookie", value: "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1" }, { name: "content-encoding", value: "gzip" }, { name: "date", value: "Mon, 21 Oct 2013 20:13:22 GMT" }])
  expect(d.tableSize()).toBe(215)
})

