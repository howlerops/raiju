// Per-provider concurrency and queue (concurrency_and_buffer_size). At most
// `limit` upstream calls run simultaneously and up to `buffer` wait for a slot.
// When the queue is full and client.drop_excess_requests is enabled, requests
// immediately receive 503; otherwise they wait. Limits are per worker process.

export class Limiter {
  active: int = 0
  waiting: (() => void)[] = []
  // the first queued request not yet let in: release() moves this on, so it does not copy the queue each time
  head = 0

  constructor(readonly limit: int, readonly buffer: int, readonly drop: bool) {}

  // "ok" takes a slot now, "wait" means queue with wait(), "drop" sheds the request.
  admit(): string {
    if (this.active < this.limit) {
      this.active += 1
      return "ok"
    }
    if (this.drop && this.waiting.length - this.head >= this.buffer) return "drop"
    return "wait"
  }

  // Queues for a slot and resolves when one is handed over. Call after admit() said "wait".
  async wait(): Promise<void> {
    await new Promise<void>((resolve) => {
      this.waiting.push(() => resolve())
    })
  }

  // admit() and wait() together: false when the request is dropped.
  async acquire(): Promise<bool> {
    const d = this.admit()
    if (d === "ok") return true
    if (d === "drop") return false
    await this.wait()
    return true
  }

  // Gives the slot back. A queued request takes it over; otherwise the count goes down.
  release(): void {
    if (this.head < this.waiting.length) {
      const next = this.waiting[this.head]!
      this.head += 1
      // the taken prefix is dropped when the queue empties or once it is most of the array
      if (this.head === this.waiting.length) {
        this.waiting = []
        this.head = 0
      } else if (this.head > 1024 && this.head * 2 > this.waiting.length) {
        this.waiting = this.waiting.slice(this.head)
        this.head = 0
      }
      next()
      return
    }
    if (this.active > 0) this.active -= 1
  }

  inFlight(): int {
    return this.active
  }

  queued(): int {
    return this.waiting.length - this.head
  }
}

test("limiter admits up to the limit, then queues", () => {
  const l = new Limiter(2, 5, false)
  expect(l.admit()).toBe("ok")
  expect(l.admit()).toBe("ok")
  expect(l.admit()).toBe("wait")
  expect(l.inFlight()).toBe(2)
})

test("limiter drops when the queue is full and drop is on", () => {
  const l = new Limiter(1, 1, true)
  expect(l.admit()).toBe("ok")
  expect(l.admit()).toBe("wait")
  // one waiter is queued and the buffer is 1: the next request is shed
  l.waiting.push(() => {})
  expect(l.admit()).toBe("drop")
  // without drop it keeps waiting
  const keep = new Limiter(1, 1, false)
  keep.admit()
  keep.waiting.push(() => {})
  expect(keep.admit()).toBe("wait")
})

test("release frees a slot, or hands it to the next waiter", () => {
  const l = new Limiter(1, 3, false)
  expect(l.admit()).toBe("ok")
  l.waiting.push(() => {})
  expect(l.queued()).toBe(1)
  l.release()
  // the slot went to the waiter: still one in flight, nothing queued
  expect(l.inFlight()).toBe(1)
  expect(l.queued()).toBe(0)
  l.release()
  expect(l.inFlight()).toBe(0)
  // releasing an idle limiter stays at zero
  l.release()
  expect(l.inFlight()).toBe(0)
})

// the waiters a test let in, in order (a class, so the queued closures share it)
class Seen {
  order: int[] = []
}

test("waiters are let in in order, and the queue's taken prefix is dropped", () => {
  const l = new Limiter(1, 5000, true)
  expect(l.admit()).toBe("ok")
  const seen = new Seen()
  for (let i = 0; i < 3000; i++) l.waiting.push(() => seen.order.push(i))
  const order = (): int[] => seen.order
  expect(l.queued()).toBe(3000)
  for (let i = 0; i < 2000; i++) l.release()
  expect(l.queued()).toBe(1000)
  expect(order().length).toBe(2000)
  expect(order()[0]!).toBe(0)
  expect(order()[1999]!).toBe(1999)
  // compacted on the way: the array holds what is still queued, not everything ever queued
  expect(l.waiting.length < 3000).toBe(true)
  // the drop limit counts the queued requests only
  expect(l.admit()).toBe("wait")
  for (let i = 0; i < 1000; i++) l.release()
  expect(l.queued()).toBe(0)
  expect(l.waiting.length).toBe(0)
  expect(order()[2999]!).toBe(2999)
  expect(l.inFlight()).toBe(1)
  l.release()
  expect(l.inFlight()).toBe(0)
})
