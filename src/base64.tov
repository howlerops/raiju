// Base64 (RFC 4648): standard and URL-safe alphabets, for PEM keys, JWTs and
// signatures. Written in Tov so the gateway needs no JavaScript engine for it.

const ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
const ALPHA_URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

const enc = new TextEncoder()

// Maps a byte to its 6-bit value, or -1. Accepts both alphabets, so decoding
// takes either form of a JWT segment.
function makeDecodeTable(): int[] {
  const t: int[] = []
  for (let i = 0; i < 256; i++) t.push(-1)
  const std = enc.encode(ALPHA)
  for (let i = 0; i < 64; i++) t[int(std[i]!)] = i
  t[int(enc.encode("-")[0]!)] = 62
  t[int(enc.encode("_")[0]!)] = 63
  return t
}

const DEC = makeDecodeTable()

function encodeWith(bytes: u8[], alpha: string, pad: bool): string {
  const out: string[] = []
  let i = 0
  while (i + 3 <= bytes.length) {
    const n = (int(bytes[i]!) << 16) | (int(bytes[i + 1]!) << 8) | int(bytes[i + 2]!)
    out.push(alpha.slice(n >> 18, (n >> 18) + 1))
    out.push(alpha.slice((n >> 12) & 63, ((n >> 12) & 63) + 1))
    out.push(alpha.slice((n >> 6) & 63, ((n >> 6) & 63) + 1))
    out.push(alpha.slice(n & 63, (n & 63) + 1))
    i += 3
  }
  const rest = bytes.length - i
  if (rest === 1) {
    const n = int(bytes[i]!) << 16
    out.push(alpha.slice(n >> 18, (n >> 18) + 1))
    out.push(alpha.slice((n >> 12) & 63, ((n >> 12) & 63) + 1))
    if (pad) out.push("==")
  } else if (rest === 2) {
    const n = (int(bytes[i]!) << 16) | (int(bytes[i + 1]!) << 8)
    out.push(alpha.slice(n >> 18, (n >> 18) + 1))
    out.push(alpha.slice((n >> 12) & 63, ((n >> 12) & 63) + 1))
    out.push(alpha.slice((n >> 6) & 63, ((n >> 6) & 63) + 1))
    if (pad) out.push("=")
  }
  return out.join("")
}

// Standard base64 with padding.
export function encode(bytes: u8[]): string {
  return encodeWith(bytes, ALPHA, true)
}

// base64url with no padding (RFC 7515), as JWTs use it.
export function encodeUrl(bytes: u8[]): string {
  return encodeWith(bytes, ALPHA_URL, false)
}

// Decodes either alphabet. Whitespace is ignored; padding is optional, but if
// present the length must come out whole.
export function decode(s: string): u8[] throws SyntaxError {
  const out: u8[] = []
  let acc = 0
  let bits = 0
  let sextets = 0
  let pads = 0
  for (const b of enc.encode(s)) {
    const c = int(b)
    if (c === 32 || c === 9 || c === 10 || c === 13) continue
    if (c === 61) {
      pads++
      continue
    }
    if (pads > 0) throw new SyntaxError("base64: data after padding")
    const v = DEC[c]!
    if (v < 0) throw new SyntaxError("base64: invalid character")
    acc = ((acc << 6) | v) & 0xffffff
    bits += 6
    sextets++
    if (bits >= 8) {
      bits -= 8
      out.push(u8((acc >> bits) & 0xff))
    }
  }
  // one leftover sextet can't carry a whole byte
  if (sextets % 4 === 1) throw new SyntaxError("base64: truncated input")
  if (pads > 2 || (pads > 0 && (sextets + pads) % 4 !== 0)) throw new SyntaxError("base64: bad padding")
  return out
}

test("encodes RFC 4648 vectors", () => {
  expect(encode(enc.encode(""))).toBe("")
  expect(encode(enc.encode("f"))).toBe("Zg==")
  expect(encode(enc.encode("fo"))).toBe("Zm8=")
  expect(encode(enc.encode("foo"))).toBe("Zm9v")
  expect(encode(enc.encode("foob"))).toBe("Zm9vYg==")
  expect(encode(enc.encode("fooba"))).toBe("Zm9vYmE=")
  expect(encode(enc.encode("foobar"))).toBe("Zm9vYmFy")
})

test("encodes the URL alphabet without padding", () => {
  // 0xfb 0xff is "+/8=" in the standard alphabet
  expect(encode([u8(0xfb), u8(0xff)])).toBe("+/8=")
  expect(encodeUrl([u8(0xfb), u8(0xff)])).toBe("-_8")
  expect(encodeUrl(enc.encode("f"))).toBe("Zg")
  expect(encodeUrl(enc.encode("foobar"))).toBe("Zm9vYmFy")
})

function decodeText(s: string): string throws Error {
  return try new TextDecoder().decode(try decode(s))
}

test("decodes RFC 4648 vectors and ignores whitespace", () => {
  expect(try decodeText("")).toBe("")
  expect(try decodeText("Zg==")).toBe("f")
  expect(try decodeText("Zm8=")).toBe("fo")
  expect(try decodeText("Zm9vYmFy")).toBe("foobar")
  expect(try decodeText("Zm9v\nYmFy\r\n")).toBe("foobar")
  expect(try decodeText("Zm9vYg")).toBe("foob")
  // both alphabets decode to the same bytes
  const url = try decode("-_8")
  expect(url.length).toBe(2)
  expect(int(url[0]!)).toBe(0xfb)
  expect(int(url[1]!)).toBe(0xff)
})

test("round trips binary and rejects bad input", () => {
  const all: u8[] = []
  for (let i = 0; i < 256; i++) all.push(u8(i))
  const back = try decode(encodeUrl(all))
  expect(back.length).toBe(256)
  expect(int(back[255]!)).toBe(255)
  let threw = false
  try {
    decode("Zm9v!")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    decode("Z")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})
