test("vertex instances: gemini carries the custom id in labels, claude at the top", () => {
  const jsonl = `{"custom_id":"c1","method":"POST","url":"/v1/chat/completions","body":{"model":"gemini-2.5-flash","messages":[{"role":"user","content":"hi"}]}}\n{"custom_id":"c2","method":"POST","url":"/v1/chat/completions","body":{"model":"anthropic/claude-sonnet-4-5","messages":[{"role":"user","content":"yo"}],"max_tokens":10}}\n`
  const out = try vertexInstances(jsonl, "")
  const ls = out.split("\n").filter((x) => x !== "")
  expect(ls.length).toBe(2)
  const g = try JSON.parse(ls[0]!) as { request: { labels: { bifrost_custom_id: string }, contents: { role: string }[] } }
  expect(g.request.labels.bifrost_custom_id).toBe("c1")
  expect(g.request.contents.length > 0).toBe(true)
  const c = try JSON.parse(ls[1]!) as { custom_id: string, request: { anthropic_version: string, model?: string, max_tokens: number } }
  expect(c.custom_id).toBe("c2")
  expect(c.request.anthropic_version).toBe("vertex-2023-10-16")
  expect(c.request.model === undefined).toBe(true)
  expect(c.request.max_tokens).toBe(10)
  let threw = 0
  for (const bad of [`{"body":{"model":"m","messages":[]}}`, `{"custom_id":"x","url":"/v1/embeddings","body":{"messages":[]}}`, `{"custom_id":"x","url":"/v1/chat/completions","body":{"model":"m"}}`]) {
    try {
      vertexInstances(bad + "\n", "gemini-2.5-flash")
    } catch (e) {
      threw += 1
    }
  }
  expect(threw).toBe(3)
  let none = false
  try {
    vertexInstances("\n", "gemini-2.5-flash")
  } catch (e) {
    none = true
  }
  expect(none).toBe(true)
})

test("vertex jobs: create, get, list and cancel requests", () => {
  const create = try vertexJobCreate(GT, "tok", "nightly", "gemini-2.5-flash", "gs://in/x.jsonl", "gs://out/d")
  expect(create.url).toBe("https://us-central1-aiplatform.googleapis.com/v1/projects/proj/locations/us-central1/batchPredictionJobs")
  expect((create.body as string).includes(`"model":"publishers/google/models/gemini-2.5-flash"`)).toBe(true)
  expect((create.body as string).includes(`"uris":["gs://in/x.jsonl"]`)).toBe(true)
  expect((create.body as string).includes(`"outputUriPrefix":"gs://out/d"`)).toBe(true)
  expect(create.headers.get("content-type")).toBe("application/json")
  const cl = try vertexJobCreate(GT, "tok", "n", "claude-sonnet-4-5", "gs://i", "gs://o")
  expect((cl.body as string).includes(`"model":"publishers/anthropic/models/claude-sonnet-4-5"`)).toBe(true)
  expect(try vertexJobGet(GT, "tok", "123").url).toBe("https://us-central1-aiplatform.googleapis.com/v1/projects/proj/locations/us-central1/batchPredictionJobs/123")
  expect(try vertexJobCancel(GT, "tok", "123").url.endsWith("/batchPredictionJobs/123:cancel")).toBe(true)
  expect(try vertexJobList(GT, "tok", "5", "t9").url.endsWith("/batchPredictionJobs?pageSize=5&pageToken=t9")).toBe(true)
  expect(try vertexJobList(GT, "tok", "", "").url.endsWith("/batchPredictionJobs")).toBe(true)
  const noRegion: Target = { provider: "vertex", kind: "vertex", model: "m", key: { value: "", vertex_key_config: { project_id: "p", region: "" } }, cfg: {} }
  let threw = false
  try {
    vertexLocation(noRegion)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("vertex job answers become openai batch objects", () => {
  const job = `{"name":"projects/p/locations/l/batchPredictionJobs/123","state":"JOB_STATE_SUCCEEDED","createTime":"2026-10-14T12:00:00Z","endTime":"2026-10-14T12:05:00Z","completionStats":{"successfulCount":"2","failedCount":"1","incompleteCount":"0"}}`
  const b = try JSON.parse(try vertexJobToOpenAI(job, "raiju-batch-output-123")) as { id: string, object: string, status: string, output_file_id: string, created_at: number, completed_at: number, request_counts: { total: number, completed: number, failed: number } }
  expect(b.id).toBe("123")
  expect(b.object).toBe("batch")
  expect(b.status).toBe("completed")
  expect(b.output_file_id).toBe("raiju-batch-output-123")
  expect(b.created_at).toBe(1791979200)
  expect(b.completed_at).toBe(1791979500)
  expect(b.request_counts.total).toBe(3)
  expect(b.request_counts.completed).toBe(2)
  expect(b.request_counts.failed).toBe(1)
  expect(try vertexJobEnded(job)).toBe(true)
  expect(try vertexJobEnded(`{"state":"JOB_STATE_RUNNING"}`)).toBe(false)
  expect(try vertexOutputDir(`{"outputInfo":{"gcsOutputDirectory":"gs://out/d/prediction-x"}}`)).toBe("gs://out/d/prediction-x")
  const cancelled = try JSON.parse(try vertexJobToOpenAI(`{"name":"projects/p/locations/l/batchPredictionJobs/9","state":"JOB_STATE_CANCELLED","endTime":"2026-10-14T12:00:00Z"}`, "")) as { status: string, cancelled_at: number, output_file_id?: string }
  expect(cancelled.status).toBe("cancelled")
  expect(cancelled.cancelled_at).toBe(1791979200)
  expect(cancelled.output_file_id === undefined).toBe(true)
  const list = try JSON.parse(try vertexJobListToOpenAI(`{"batchPredictionJobs":[${job}],"nextPageToken":"nx"}`)) as { data: { id: string }[], has_more: bool, last_id: string, first_id: string }
  expect(list.data[0]!.id).toBe("123")
  expect(list.first_id).toBe("123")
  expect(list.has_more).toBe(true)
  expect(list.last_id).toBe("nx")
})

test("vertex results: prediction lines become openai batch output", () => {
  const gem = `{"request":{"contents":[],"labels":{"bifrost_custom_id":"c1"}},"response":{"candidates":[{"content":{"role":"model","parts":[{"text":"hi there"}]},"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":1,"candidatesTokenCount":2,"totalTokenCount":3}},"status":""}`
  const err = `{"request":{"labels":{"bifrost_custom_id":"c2"}},"status":"quota exceeded"}`
  const lines = try vertexResultsToOpenAI(gem + "\n" + err + "\n", "gemini-2.5-flash")
  const out = lines.split("\n")
  expect(out.length).toBe(2)
  const ok = try JSON.parse(out[0]!) as { custom_id: string, response: { status_code: number, body: { choices: { message: { content: string } }[] } }, error?: string }
  expect(ok.custom_id).toBe("c1")
  expect(ok.response.status_code).toBe(200)
  expect(ok.response.body.choices[0]!.message.content).toBe("hi there")
  const bad = try JSON.parse(out[1]!) as { custom_id: string, response?: string, error: { code: string, message: string } }
  expect(bad.custom_id).toBe("c2")
  expect(bad.error.message).toBe("quota exceeded")
})

test("bedrock jobs: create, get, list and stop requests", () => {
  const o = { scheme: "http://", host: "mock.local:9" }
  const req = bedrockJobCreate(o, S3K, { name: "j1", model: "anthropic.claude-3-haiku", role: "arn:aws:iam::1:role/r", inputUri: "s3://in/a.jsonl", outputUri: "s3://out/p/", hours: 24 }, NOW)
  expect(req.url).toBe("http://mock.local:9/model-invocation-job")
  expect(req.method).toBe("POST")
  expect((req.body as string).includes(`"roleArn":"arn:aws:iam::1:role/r"`)).toBe(true)
  expect((req.body as string).includes(`"s3InputDataConfig":{"s3Uri":"s3://in/a.jsonl","s3InputFormat":"JSONL"}`)).toBe(true)
  expect((req.body as string).endsWith(`,"timeoutDurationInHours":24}`)).toBe(true)
  expect(req.headers.get("authorization")!.includes("/us-east-1/bedrock/aws4_request")).toBe(true)
  const noHours = bedrockJobCreate(o, S3K, { name: "j", model: "m", role: "r", inputUri: "s3://i/k", outputUri: "s3://o/", hours: 0 }, NOW)
  expect((noHours.body as string).includes("timeoutDurationInHours")).toBe(false)
  expect(bedrockJobGet(o, S3K, "abc123", NOW).url).toBe("http://mock.local:9/model-invocation-job/abc123")
  expect(bedrockJobStop(o, S3K, "abc123", NOW).url).toBe("http://mock.local:9/model-invocation-job/abc123/stop")
  expect(bedrockJobList(o, S3K, "3", "tk", NOW).url).toBe("http://mock.local:9/model-invocation-jobs?maxResults=3&nextToken=tk")
})

test("bedrock job answers become openai batch objects", () => {
  const job = `{"jobArn":"arn:aws:bedrock:us-east-1:1:model-invocation-job/abc123def456","status":"Completed","submitTime":"2026-10-14T12:00:00Z","endTime":"2026-10-14T12:05:00Z","modelId":"anthropic.claude-3-haiku"}`
  const b = try JSON.parse(try bedrockJobToOpenAI(job, "raiju-batch-output-abc123def456")) as { id: string, status: string, completed_at: number, output_file_id: string }
  expect(b.id).toBe("abc123def456")
  expect(b.status).toBe("completed")
  expect(b.completed_at).toBe(1791979500)
  expect(b.output_file_id).toBe("raiju-batch-output-abc123def456")
  expect(try bedrockJobEnded(job)).toBe(true)
  expect(try bedrockJobModel(job)).toBe("anthropic.claude-3-haiku")
  expect(try bedrockOutputUri(`{"outputDataConfig":{"s3OutputDataConfig":{"s3Uri":"s3://bkt/out/"}}}`)).toBe("s3://bkt/out/")
  expect(try bedrockOutputUri(`{}`)).toBe("")
  const statuses = ["Submitted", "Validating", "InProgress", "Failed", "PartiallyCompleted", "Stopping", "Stopped", "Expired"]
  const want = ["validating", "validating", "in_progress", "failed", "failed", "cancelling", "cancelled", "expired"]
  for (let i = 0; i < statuses.length; i++) {
    const s = try JSON.parse(try bedrockJobToOpenAI(`{"jobArn":"x/j${i}","status":"${statuses[i]!}"}`, "")) as { status: string }
    expect(s.status).toBe(want[i]!)
  }
  const list = try JSON.parse(try bedrockJobListToOpenAI(`{"invocationJobSummaries":[${job}],"nextToken":"nt"}`)) as { data: { id: string }[], has_more: bool, last_id: string }
  expect(list.data[0]!.id).toBe("abc123def456")
  expect(list.has_more).toBe(true)
  expect(list.last_id).toBe("nt")
})

test("bedrock input: claude records take a bedrock messages body, others pass through", () => {
  const jsonl = `{"custom_id":"c1","method":"POST","url":"/v1/chat/completions","body":{"model":"anthropic.claude-3-haiku","messages":[{"role":"user","content":"hi"}],"max_tokens":8}}\n{"custom_id":"c2","method":"POST","url":"/v1/chat/completions","body":{"model":"amazon.nova-lite","messages":[{"role":"user","content":"yo"}]}}\n`
  const out = try bedrockInputJsonl(jsonl, "")
  const ls = out.split("\n").filter((x) => x !== "")
  const a = try JSON.parse(ls[0]!) as { recordId: string, modelInput: { anthropic_version: string, max_tokens: number, model?: string } }
  expect(a.recordId).toBe("c1")
  expect(a.modelInput.anthropic_version).toBe("bedrock-2023-05-31")
  expect(a.modelInput.max_tokens).toBe(8)
  expect(a.modelInput.model === undefined).toBe(true)
  const b = try JSON.parse(ls[1]!) as { recordId: string, modelInput: { messages: { role: string }[], model?: string } }
  expect(b.recordId).toBe("c2")
  expect(b.modelInput.messages.length).toBe(1)
  expect(b.modelInput.model === undefined).toBe(true)
  let none = false
  try {
    bedrockInputJsonl("", "")
  } catch (e) {
    none = true
  }
  expect(none).toBe(true)
})

test("bedrock results: claude answers convert, errors and chat-shaped answers pass", () => {
  const msg = `{"id":"msg_1","type":"message","role":"assistant","model":"claude","content":[{"type":"text","text":"hello"}],"stop_reason":"end_turn","usage":{"input_tokens":2,"output_tokens":3}}`
  const jsonl = `{"recordId":"c1","modelInput":{},"modelOutput":${msg}}\n{"recordId":"c2","modelInput":{},"error":{"errorCode":500,"errorMessage":"throttled"}}\n`
  const out = try bedrockResultsToOpenAI(jsonl, "anthropic.claude-3-haiku")
  const ls = out.split("\n")
  const ok = try JSON.parse(ls[0]!) as { custom_id: string, response: { body: { choices: { message: { content: string } }[] } } }
  expect(ok.custom_id).toBe("c1")
  expect(ok.response.body.choices[0]!.message.content).toBe("hello")
  const bad = try JSON.parse(ls[1]!) as { custom_id: string, error: { code: string, message: string } }
  expect(bad.custom_id).toBe("c2")
  expect(bad.error.code).toBe("500")
  expect(bad.error.message).toBe("throttled")
  const chat = `{"recordId":"c3","modelOutput":{"id":"x","object":"chat.completion","choices":[]}}`
  expect(try bedrockResultsToOpenAI(chat, "amazon.nova").includes(`"custom_id":"c3"`)).toBe(true)
  expect(try bedrockResultsToOpenAI(`{"recordId":"c4","modelOutput":{"other":1}}`, "amazon.nova").includes("unsupported_output")).toBe(true)
})

test("bedrock roles, buckets, hours and names", () => {
  expect(bedrockRole("batch-r", "body-r", "key-r")).toBe("batch-r")
  expect(bedrockRole(undefined, "body-r", "key-r")).toBe("body-r")
  expect(bedrockRole("", "", "key-r")).toBe("key-r")
  expect(bedrockRole(undefined, "", undefined)).toBe("")
  const bk: BedrockKeyConfig = { access_key: "AK", secret_key: "s", batch_s3_config: { buckets: [{ bucket_name: "first", prefix: "f/" }, { bucket_name: "dflt", prefix: "d", is_default: true }] } }
  expect(batchBucket(bk)!.bucket).toBe("dflt")
  expect(batchBucket(bk)!.prefix).toBe("d")
  const first: BedrockKeyConfig = { batch_s3_config: { buckets: [{ bucket_name: "only" }] } }
  expect(batchBucket(first)!.bucket).toBe("only")
  expect(batchBucket(first)!.prefix).toBe("")
  expect(batchBucket({ access_key: "AK" }) === undefined).toBe(true)
  expect(windowHours("24h")).toBe(24)
  expect(windowHours("48h")).toBe(48)
  expect(windowHours("1d")).toBe(24)
  expect(jobName("mine")).toBe("mine")
  expect(jobName("").startsWith("raiju-batch-")).toBe(true)
  expect(bedrockInputName().startsWith("bedrock-batch-input/")).toBe(true)
  expect(vertexInputName().startsWith("vertex-batch-input/")).toBe(true)
})

test("bedrock credentials and origins", () => {
  const c = try staticCreds({ access_key: "AK", secret_key: "sec", session_token: "tok", region: "eu-west-1" })
  expect(c.region).toBe("eu-west-1")
  expect(c.sessionToken).toBe("tok")
  let noKey = false
  try {
    staticCreds({ region: "us-east-1" })
  } catch (e) {
    noKey = true
  }
  expect(noKey).toBe(true)
  expect(bedrockRegion({})).toBe("us-east-1")
  const over: Target = { provider: "bedrock", kind: "bedrock", model: "m", key: { value: "" }, cfg: { network_config: { base_url: "http://mock.local:1/" } } }
  expect(bedrockOrigin(over, "bedrock", "us-east-1").host).toBe("mock.local:1")
  expect(bedrockOrigin(over, "bedrock", "us-east-1").scheme).toBe("http://")
  expect(s3Endpoint(over)).toBe("http://mock.local:1")
  const plain: Target = { provider: "bedrock", kind: "bedrock", model: "m", key: { value: "" }, cfg: {} }
  expect(bedrockOrigin(plain, "bedrock", "eu-west-1").host).toBe("bedrock.eu-west-1.amazonaws.com")
  expect(s3Endpoint(plain)).toBe("")
  expect(assumedCreds({ accessKey: "A", secretKey: "S", sessionToken: "T", expiresAtMs: 1.0 }, "us-west-2").region).toBe("us-west-2")
})

test("s3 objects, listings and the list answers", () => {
  const put = s3Object(S3K, "", "bkt", "p/x.jsonl", "PUT", "{}\n", "application/jsonl", NOW)
  expect(put.url).toBe("https://bkt.s3.us-east-1.amazonaws.com/p/x.jsonl")
  expect(put.body).toBe("{}\n")
  const get = s3Object(S3K, "", "bkt", "p/x.jsonl", "GET", "", "", NOW)
  expect(get.body === undefined).toBe(true)
  const ls = s3List(S3K, "http://mock.local:9", "bkt", "p/", "", "10", NOW)
  expect(ls.url).toBe("http://mock.local:9/bkt?list-type=2&max-keys=10&prefix=p%2F")
  const xml = `<?xml version="1.0"?><ListBucketResult><Name>bkt</Name><IsTruncated>true</IsTruncated><NextContinuationToken>ct1</NextContinuationToken><Contents><Key>p/a b.jsonl</Key><Size>5</Size><LastModified>2026-10-14T12:00:00.000Z</LastModified></Contents><Contents><Key>p/c&amp;d.jsonl</Key><Size>7</Size><LastModified>2026-10-14T12:00:00.000Z</LastModified></Contents></ListBucketResult>`
  const l = try JSON.parse(s3ListToOpenAI(xml, "bkt")) as { data: { id: string, bytes: number, filename: string }[], has_more: bool, first_id: string, last_id: string }
  expect(l.data.length).toBe(2)
  expect(l.data[0]!.id).toBe("s3://bkt/p/a b.jsonl")
  expect(l.data[1]!.id).toBe("s3://bkt/p/c&d.jsonl")
  expect(l.data[1]!.bytes).toBe(7)
  expect(l.data[1]!.filename).toBe("c&d.jsonl")
  expect(l.has_more).toBe(true)
  expect(l.last_id).toBe("ct1")
  expect(s3Keys(xml).join("|")).toBe("p/a b.jsonl|p/c&d.jsonl")
  const one = try JSON.parse(s3FileFromList(xml, "bkt", "p/c&d.jsonl") ?? "{}") as { id: string, bytes: number }
  expect(one.id).toBe("s3://bkt/p/c&d.jsonl")
  expect(one.bytes).toBe(7)
  expect(s3FileFromList(xml, "bkt", "p/none") === undefined).toBe(true)
  const f = try JSON.parse(s3FileToOpenAI("bkt", "k/z.jsonl", 3, 1791979200.0)) as { id: string, purpose: string, status: string, created_at: number }
  expect(f.id).toBe("s3://bkt/k/z.jsonl")
  expect(f.purpose).toBe("batch")
  expect(f.status).toBe("processed")
  expect(f.created_at).toBe(1791979200)
})

test("the sigv4 canonical query sorts and encodes", () => {
  expect(canonicalQuery([["prefix", "a b"], ["list-type", "2"], ["prefix", "a"]])).toBe("list-type=2&prefix=a&prefix=a%20b")
  expect(canonicalQuery([])).toBe("")
})

test("path ids decode their escapes, and s3 keys drop empty prefix parts", () => {
  expect(pctDecode("gs%3A%2F%2Fb%2Fx%20y")).toBe("gs://b/x y")
  expect(pctDecode("plain")).toBe("plain")
  expect(pctDecode("bad%zz%2")).toBe("bad%zz%2")
  expect(pctDecode("%C3%A9")).toBe("é")
  expect(s3KeyFor("/p//q/", "a.jsonl")).toBe("p/q/a.jsonl")
  expect(s3KeyFor("", "a.jsonl")).toBe("a.jsonl")
})

test("the default batch output is the bucket's prefix with a slash", () => {
  expect(defaultOutputUri("bkt", "/jobs//out/")).toBe("s3://bkt/jobs/out/")
  expect(defaultOutputUri("bkt", "")).toBe("s3://bkt/")
})
