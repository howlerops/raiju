  expect(gcsObject(GT, "tok", "bkt", "a/b.jsonl", "GET", true).url.endsWith("?alt=media")).toBe(true)
  expect(gcsObject(GT, "tok", "bkt", "a/b.jsonl", "DELETE", false).method).toBe("DELETE")
  const L = gcsList(GT, "tok", "bkt", "x/y", "2", "abc")
