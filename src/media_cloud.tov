// Native image generation for Vertex AI and Bedrock. Builders return the request
// to send and converters take the upstream body, as in media_native.tov, which
// holds the Gemini and Anthropic side. Nothing here does HTTP: media.tov fetches
// Vertex's bearer token and sends the requests.
import { Field, fields, elements, find, rawStr, rawNum, quote, setField, build, without, isNull } from "./json"
import { Target, Translated, headers, addExtraHeaders, trimSlash } from "./providers/types"
import { TokenCache, isClaude } from "./providers/vertex"
import * as bedrock from "./providers/bedrock"
import * as anthropic from "./providers/anthropic"
import * as gemini from "./providers/gemini"
import * as native from "./media_native"
import { ChatRequest, nowSeconds, newId } from "./schemas"
import { encode } from "./base64"
import { S3Creds, AwsRequest, s3Call, awsCall, canonicalQuery } from "./exports"
import { AssumedCreds, credsCache, parseIsoUtcMs, xmlTag } from "./cloud_auth"
import { BedrockKeyConfig } from "./config"

// Bearer tokens for Vertex calls, by service account. media.tov fetches into it.
export const VERTEX_TOKENS: TokenCache = new TokenCache()

// Temporary credentials from AssumeRole, by role. media.tov fetches into it.
export const STS_CREDS = credsCache()

// ---- Vertex AI ----

// The regional origin (or the key's base_url). The global location has no prefix.
function vertexOrigin(t: Target, region: string): string {
  const b = t.cfg.network_config?.base_url
  if (b !== undefined && b !== "") return trimSlash(b)
  const host = region === "global" ? "aiplatform.googleapis.com" : `${region}-aiplatform.googleapis.com`
  return `https://${host}`
}

// The Gemini or Imagen request for an OpenAI images call, sent to Vertex's publisher
// path with the bearer token. The body is the one media_native builds for Gemini
// (the same shape on both), so only the URL and the auth differ.
export function vertexImage(t: Target, body: Field[], token: string): native.MediaRequest throws SyntaxError {
  return try vertexPublisher(t, try native.geminiImageGeneration(t, body), token)
}

// The image edit on Vertex: the same Gemini or Imagen body, sent to the publisher path.
export function vertexImageEdit(t: Target, ed: native.EditInput, token: string): native.MediaRequest throws SyntaxError {
  return try vertexPublisher(t, try native.geminiImageEdit(t, ed), token)
}

// A Gemini or Imagen request (media_native builds the body) moved to Vertex's publisher path,
// with the bearer token. Only the URL and the auth differ from the Gemini API.
function vertexPublisher(t: Target, g: native.MediaRequest, token: string): native.MediaRequest throws SyntaxError {
  const vk = t.key.vertex_key_config
  if (vk === undefined) throw new SyntaxError("vertex: key has no vertex_key_config")
  const action = g.url.endsWith(":predict") ? "predict" : "generateContent"
  const url = `${vertexOrigin(t, vk.region)}/v1/projects/${vk.project_id}/locations/${vk.region}/publishers/google/models/${t.model}:${action}`
  let h = headers([["content-type", "application/json"], ["authorization", "Bearer " + token]])
  addExtraHeaders(&h, t.cfg)
  return { method: "POST", url: url, headers: h, body: g.body as string }
}

// ---- Bedrock ----

// Bedrock's quality names: low and medium are standard, high is premium. Other
// values pass through as given.
function bedrockQuality(q: string): string {
  const s = q.trim().toLowerCase()
  if (s === "low" || s === "medium" || s === "standard") return "standard"
  if (s === "high" || s === "premium") return "premium"
  return q
}

// The two sides of a "WIDTHxHEIGHT" size. "auto" and "" give undefined.
type Pixels = { w: int, h: int }

function pixels(size: string): Pixels | undefined throws SyntaxError {
  const s = size.trim().toLowerCase()
  if (s === "" || s === "auto") return undefined
  const parts = s.split("x")
  if (parts.length !== 2) throw new SyntaxError(`invalid size format: expected 'WIDTHxHEIGHT', got ${size}`)
  const w = parseInt(parts[0]!)
  const h = parseInt(parts[1]!)
  if (w === undefined || h === undefined) throw new SyntaxError(`invalid size ${size}`)
  return { w: w, h: h }
}

// Titan Image Generator and Nova Canvas: the TEXT_IMAGE task with its text and
// config. Bifrost's mapping (bedrock/images.go).
function titanBody(prompt: string, body: Field[]): string throws SyntaxError {
  const tp: string[] = [`"text":${quote(prompt)}`]
  const neg = rawStr(body, "negative_prompt") ?? ""
  if (neg !== "") tp.push(`"negativeText":${quote(neg)}`)
  const style = rawStr(body, "style") ?? ""
  if (style !== "") tp.push(`"style":${quote(style)}`)
  const cfg: string[] = []
  const n = rawNum(body, "n")
  if (n !== undefined) cfg.push(`"numberOfImages":${n}`)
  const px = try pixels(rawStr(body, "size") ?? "")
  if (px !== undefined) {
    cfg.push(`"width":${px.w}`)
    cfg.push(`"height":${px.h}`)
  }
  const q = rawStr(body, "quality") ?? ""
  if (q !== "") cfg.push(`"quality":${quote(bedrockQuality(q))}`)
  const seed = rawNum(body, "seed")
  if (seed !== undefined) cfg.push(`"seed":${seed}`)
  return `{"taskType":"TEXT_IMAGE","textToImageParams":{${tp.join(",")}},"imageGenerationConfig":{${cfg.join(",")}}}`
}

// Stability AI's flat body: the prompt and the options it takes, when set.
function stabilityBody(prompt: string, body: Field[]): string {
  const fs: string[] = [`"prompt":${quote(prompt)}`]
  for (const k of ["aspect_ratio", "output_format", "negative_prompt"]) {
    const v = rawStr(body, k) ?? ""
    if (v !== "") fs.push(`${quote(k)}:${quote(v)}`)
  }
  const seed = rawNum(body, "seed")
  if (seed !== undefined) fs.push(`"seed":${seed}`)
  return `{${fs.join(",")}}`
}

// The InvokeModel request for an image on a Bedrock model. Stability models
// ("stability." in the id) take the flat body; the rest take TEXT_IMAGE. Signed with
// the key's AWS credentials, or sent with its API key, as the chat path does.
export function bedrockImage(t: Target, body: Field[]): native.MediaRequest throws SyntaxError {
  const prompt = rawStr(body, "prompt") ?? ""
  if (prompt === "") throw new SyntaxError("prompt is required")
  let payload = ""
  if (t.model.toLowerCase().includes("stability.")) payload = stabilityBody(prompt, body)
  else payload = try titanBody(prompt, body)
  const up = bedrock.signedRequest(t, "invoke", payload)
  return { method: "POST", url: up.url, headers: up.headers, body: up.body }
}

// The OpenAI images body from a Bedrock InvokeModel answer ({"images": [...]}).
// Bedrock's own error text (a content filter, say) becomes a SyntaxError.
export function bedrockImagesToOpenAI(raw: string): string throws SyntaxError {
  const fs = try fields(raw)
  const err = rawStr(fs, "error") ?? ""
  if (err !== "") throw new SyntaxError(err)
  const items: string[] = []
  for (const el of try elements(find(fs, "images") ?? "[]")) items.push(`{"b64_json":${el}}`)
  if (items.length === 0) throw new SyntaxError("no images in the response")
  return `{"created":${nowSeconds()},"data":[${items.join(",")}]}`
}

// Stability AI models take no variation body: Bifrost sends the Titan body to them and Bedrock rejects it.
function noStability(t: Target): void throws SyntaxError {
  if (t.model.toLowerCase().includes("stability.")) throw new SyntaxError("Stability AI models take no image variations; use an edit")
}

// The imageGenerationConfig of an edit or a variation: the count, size, quality, seed and cfgScale
// that are set. Edits pass no cfgScale; variations pass no seed.
function editConfig(n: int | undefined, size: string, quality: string, seed: int | undefined, cfg: f64 | undefined): string throws SyntaxError {
  const cs: string[] = []
  if (n !== undefined) cs.push(`"numberOfImages":${n}`)
  const px = try pixels(size)
  if (px !== undefined) {
    cs.push(`"width":${px.w}`)
    cs.push(`"height":${px.h}`)
  }
  if (quality !== "") cs.push(`"quality":${quote(bedrockQuality(quality))}`)
  if (seed !== undefined) cs.push(`"seed":${seed}`)
  if (cfg !== undefined) cs.push(`"cfgScale":${cfg}`)
  return `{${cs.join(",")}}`
}

// The form fields a Stability edit reads beyond the common ones (media.tov readEdit keeps them).
export function stabilityFormFields(): string[] {
  return ["select_prompt", "search_prompt", "grow_mask", "style_preset", "creativity", "control_strength", "aspect_ratio", "fidelity", "style_strength", "composition_fidelity", "change_strength", "left", "right", "up", "down"]
}

// The Stability task a form's type names (Bifrost's getStabilityAITaskTypeFromParams), or "".
function stabilityType(kind: string): string {
  const k = kind.toLowerCase()
  if (k === "inpainting" || k === "inpaint") return "inpaint"
  if (k === "outpainting" || k === "outpaint") return "outpaint"
  if (k === "background_removal" || k === "remove_background") return "remove-bg"
  if (k === "erase_object") return "erase-object"
  if (k === "upscale_fast") return "upscale-fast"
  if (k === "upscale_creative") return "upscale-creative"
  if (k === "upscale_conservative") return "upscale-conservative"
  if (k === "recolor") return "recolor"
  if (k === "search_replace") return "search-replace"
  if (k === "control_sketch") return "control-sketch"
  if (k === "control_structure") return "control-structure"
  if (k === "style_guide") return "style-guide"
  if (k === "style_transfer") return "style-transfer"
  return ""
}

// The Stability task a model id names, for a form that gives no type (Bifrost's getStabilityAIEditTaskType).
function stabilityTaskOfModel(model: string): string {
  const m = model.toLowerCase()
  const names = ["stable-creative-upscale", "stable-conservative-upscale", "stable-fast-upscale", "stable-image-inpaint", "stable-outpaint", "stable-image-search-recolor", "stable-image-search-replace", "stable-image-erase-object", "stable-image-remove-background", "stable-image-control-sketch", "stable-image-control-structure", "stable-image-style-guide", "stable-style-transfer"]
  const tasks = ["upscale-creative", "upscale-conservative", "upscale-fast", "inpaint", "outpaint", "recolor", "search-replace", "erase-object", "remove-bg", "control-sketch", "control-structure", "style-guide", "style-transfer"]
  for (let i = 0; i < names.length; i++) {
    if (m.includes(names[i]!)) return tasks[i]!
  }
  return ""
}

// Which of a Stability edit's options each task takes (Bifrost's allowlists, images.go).
function taskTakes(task: string, group: string): bool {
  if (group === "prompt") return ["inpaint", "recolor", "search-replace", "control-sketch", "control-structure", "style-guide", "upscale-creative", "upscale-conservative", "outpaint", "style-transfer"].includes(task)
  if (group === "negative") return ["inpaint", "outpaint", "recolor", "search-replace", "control-sketch", "control-structure", "style-guide", "upscale-creative", "upscale-conservative", "style-transfer"].includes(task)
  if (group === "seed") return ["inpaint", "outpaint", "recolor", "search-replace", "erase-object", "control-sketch", "control-structure", "style-guide", "upscale-creative", "upscale-conservative", "style-transfer"].includes(task)
  if (group === "mask") return task === "inpaint" || task === "erase-object"
  if (group === "style_preset") return ["inpaint", "outpaint", "recolor", "search-replace", "control-sketch", "control-structure", "style-guide", "upscale-creative"].includes(task)
  if (group === "grow_mask") return ["inpaint", "recolor", "search-replace", "erase-object"].includes(task)
  if (group === "outpaint") return task === "outpaint"
  if (group === "creativity") return ["upscale-creative", "upscale-conservative", "outpaint"].includes(task)
  if (group === "control") return task === "control-sketch" || task === "control-structure"
  if (group === "style_guide") return task === "style-guide"
  if (group === "style_transfer") return task === "style-transfer"
  return false
}

// An extra form option's text, or "" when the form did not send it.
function extraOf(ed: native.EditInput, key: string): string {
  const m = ed.extra
  if (m === undefined) return ""
  return m.get(key) ?? ""
}

// A form's integer or number option, or undefined when absent. A value that does not parse is a SyntaxError.
function optInt(ed: native.EditInput, key: string): int | undefined throws SyntaxError {
  const s = extraOf(ed, key)
  if (s === "") return undefined
  const v = parseInt(s)
  if (v === undefined) throw new SyntaxError(`${key} must be an integer`)
  return v
}

function optNum(ed: native.EditInput, key: string): f64 | undefined throws SyntaxError {
  const s = extraOf(ed, key)
  if (s === "") return undefined
  const v = parseFloat(s)
  if (v === undefined) throw new SyntaxError(`${key} must be a number`)
  return v
}

function optStr(ed: native.EditInput, key: string): string {
  return extraOf(ed, key)
}

// The flat InvokeModel body of a Stability edit task (Bifrost's ToStabilityAIImageEditRequest). Only
// the fields the task takes are set; style transfer takes an init image and a style image.
export function stabilityEditBody(task: string, ed: native.EditInput): string throws SyntaxError {
  const fs: string[] = []
  if (task === "") throw new SyntaxError("cannot determine the Stability task from the type or the model name")
  if (task === "style-transfer") {
    if (ed.images.length !== 2) throw new SyntaxError("style-transfer requires exactly two images: init_image and style_image")
    fs.push(`"init_image":${quote(encode(ed.images[0]!))}`)
    fs.push(`"style_image":${quote(encode(ed.images[1]!))}`)
  } else {
    if (ed.images.length === 0) throw new SyntaxError("at least one image is required")
    fs.push(`"image":${quote(encode(ed.images[0]!))}`)
  }
  if (taskTakes(task, "prompt")) fs.push(`"prompt":${quote(ed.prompt)}`)
  if (ed.negative !== "" && taskTakes(task, "negative")) fs.push(`"negative_prompt":${quote(ed.negative)}`)
  if (ed.seed !== undefined && taskTakes(task, "seed")) fs.push(`"seed":${ed.seed}`)
  if (ed.mask !== undefined && taskTakes(task, "mask")) fs.push(`"mask":${quote(encode(ed.mask))}`)
  if (ed.outputFormat !== "") fs.push(`"output_format":${quote(ed.outputFormat)}`)
  if (taskTakes(task, "style_preset") && optStr(ed, "style_preset") !== "") fs.push(`"style_preset":${quote(optStr(ed, "style_preset"))}`)
  if (taskTakes(task, "grow_mask")) {
    const g = try optInt(ed, "grow_mask")
    if (g !== undefined) fs.push(`"grow_mask":${g}`)
  }
  if (taskTakes(task, "outpaint")) {
    for (const k of ["left", "right", "up", "down"]) {
      const v = try optInt(ed, k)
      if (v !== undefined) fs.push(`"${k}":${v}`)
    }
  }
  if (taskTakes(task, "creativity")) {
    const c = try optNum(ed, "creativity")
    if (c !== undefined) fs.push(`"creativity":${c}`)
  }
  if (task === "recolor") {
    if (optStr(ed, "select_prompt") === "") throw new SyntaxError("select_prompt is required for stability ai recolor task")
    fs.push(`"select_prompt":${quote(optStr(ed, "select_prompt"))}`)
  }
  if (task === "search-replace") {
    if (optStr(ed, "search_prompt") === "") throw new SyntaxError("search_prompt is required for stability ai search-replace task")
    fs.push(`"search_prompt":${quote(optStr(ed, "search_prompt"))}`)
  }
  if (taskTakes(task, "control")) {
    const c = try optNum(ed, "control_strength")
    if (c !== undefined) fs.push(`"control_strength":${c}`)
  }
  if (taskTakes(task, "style_guide")) {
    if (optStr(ed, "aspect_ratio") !== "") fs.push(`"aspect_ratio":${quote(optStr(ed, "aspect_ratio"))}`)
    const f = try optNum(ed, "fidelity")
    if (f !== undefined) fs.push(`"fidelity":${f}`)
  }
  if (taskTakes(task, "style_transfer")) {
    for (const k of ["style_strength", "composition_fidelity", "change_strength"]) {
      const v = try optNum(ed, k)
      if (v !== undefined) fs.push(`"${k}":${v}`)
    }
  }
  return "{" + fs.join(",") + "}"
}

// The InvokeModel request for a Stability edit: the task from the form's type, else from the model id.
export function stabilityImageEdit(t: Target, ed: native.EditInput): native.MediaRequest throws SyntaxError {
  let task = stabilityType(ed.editType)
  if (ed.editType !== "" && task === "") throw new SyntaxError(`unsupported type for Stability AI: ${ed.editType}`)
  if (task === "") task = stabilityTaskOfModel(t.model)
  const payload = try stabilityEditBody(task, ed)
  const up = bedrock.signedRequest(t, "invoke", payload)
  return { method: "POST", url: up.url, headers: up.headers, body: up.body }
}

// The InvokeModel request for an image edit on a Bedrock model (Titan and Nova Canvas, as Bifrost
// maps them): inpainting or outpainting with the prompt, the mask and its settings, or background
// removal, which takes only the image. The type is required. Stability models take their own bodies.
export function bedrockImageEdit(t: Target, ed: native.EditInput): native.MediaRequest throws SyntaxError {
  if (t.model.toLowerCase().includes("stability.")) return try stabilityImageEdit(t, ed)
  if (ed.images.length === 0) throw new SyntaxError("at least one image is required")
  const kind = ed.editType.toLowerCase()
  const img = quote(encode(ed.images[0]!))
  let payload = ""
  if (kind === "inpainting" || kind === "outpainting") {
    const ps: string[] = [`"image":${img}`, `"text":${quote(ed.prompt)}`]
    if (ed.negative !== "") ps.push(`"negativeText":${quote(ed.negative)}`)
    if (ed.maskPrompt !== "") ps.push(`"maskPrompt":${quote(ed.maskPrompt)}`)
    const mask = ed.mask
    if (mask !== undefined) ps.push(`"maskImage":${quote(encode(mask))}`)
    const task = kind === "inpainting" ? "INPAINTING" : "OUTPAINTING"
    const key = kind === "inpainting" ? "inPaintingParams" : "outPaintingParams"
    const cfg = try editConfig(ed.n, ed.size, ed.quality, ed.seed, undefined)
    payload = `{"taskType":"${task}","${key}":{${ps.join(",")}},"imageGenerationConfig":${cfg}}`
  } else if (kind === "background_removal") {
    payload = `{"taskType":"BACKGROUND_REMOVAL","backgroundRemovalParams":{"image":${img}}}`
  } else if (kind === "") {
    throw new SyntaxError("type is required (inpainting, outpainting or background_removal)")
  } else {
    throw new SyntaxError(`unsupported type for Bedrock: ${kind} (must be inpainting, outpainting or background_removal)`)
  }
  const up = bedrock.signedRequest(t, "invoke", payload)
  return { method: "POST", url: up.url, headers: up.headers, body: up.body }
}

// The InvokeModel request for an image variation (IMAGE_VARIATION, Titan and Nova Canvas): the
// images, the optional prompt and negative text, the similarity strength (0.2 to 1.0) and the config.
export function bedrockImageVariation(t: Target, v: native.VariationInput): native.MediaRequest throws SyntaxError {
  try noStability(t)
  if (v.images.length === 0) throw new SyntaxError("at least one image is required")
  const imgs: string[] = []
  for (const b of v.images) imgs.push(quote(encode(b)))
  const ps: string[] = [`"images":[${imgs.join(",")}]`]
  if (v.prompt !== "") ps.push(`"text":${quote(v.prompt)}`)
  if (v.negative !== "") ps.push(`"negativeText":${quote(v.negative)}`)
  const sim = v.similarity
  if (sim !== undefined) {
    if (sim < 0.2 || sim > 1.0) throw new SyntaxError(`similarityStrength must be between 0.2 and 1.0, got ${sim}`)
    ps.push(`"similarityStrength":${sim}`)
  }
  const cfg = try editConfig(v.n, v.size, v.quality, undefined, v.cfgScale)
  const payload = `{"taskType":"IMAGE_VARIATION","imageVariationParams":{${ps.join(",")}},"imageGenerationConfig":${cfg}}`
  const up = bedrock.signedRequest(t, "invoke", payload)
  return { method: "POST", url: up.url, headers: up.headers, body: up.body }
}

// ---- files and batches ----
// Vertex's files are Google Cloud Storage objects and its batches are Batch Prediction
// jobs that read and write GCS. Bedrock's files are S3 objects and its batches are
// model invocation jobs that read and write S3. File ids are gs:// and s3:// URIs.
// Each job's input is written to the bucket in the provider's own JSONL shape, then the
// job is created; its output is read back and converted to OpenAI's batch output.

// The Google Cloud Storage origin: the key's base_url when set (a proxy or the mock), else Google's.
export function gcsOrigin(t: Target): string {
  const b = t.cfg.network_config?.base_url
  if (b !== undefined && b !== "") return trimSlash(b)
  return "https://storage.googleapis.com"
}

// The Vertex location that batch prediction jobs live under: ".../v1/projects/{p}/locations/{r}".
export function vertexLocation(t: Target): string throws SyntaxError {
  const vk = t.key.vertex_key_config
  if (vk === undefined) throw new SyntaxError("vertex: key has no vertex_key_config")
  if (vk.project_id === "" || vk.region === "") throw new SyntaxError("vertex: batch jobs need a project and a region")
  return `${vertexOrigin(t, vk.region)}/v1/projects/${vk.project_id}/locations/${vk.region}`
}

// The cached-contents collection of the key's project and region (Vertex serves it under v1beta1).
export function vertexCacheUrl(t: Target): string throws SyntaxError {
  const vk = t.key.vertex_key_config
  if (vk === undefined) throw new SyntaxError("vertex: key has no vertex_key_config")
  if (vk.project_id === "" || vk.region === "") throw new SyntaxError("vertex: cached contents need a project and a region")
  return `${vertexOrigin(t, vk.region)}/v1beta1/projects/${vk.project_id}/locations/${vk.region}/cachedContents`
}

// Headers for a Google call with a bearer token; json adds the content type.
function bearer(t: Target, token: string, json: bool): Map<string, string> {
  const pairs: string[][] = [["authorization", "Bearer " + token]]
  if (json) pairs.push(["content-type", "application/json"])
  let h = headers(pairs)
  addExtraHeaders(&h, t.cfg)
  return h
}

// The bucket and object key of a gs:// or s3:// URI. The key is "" for the bucket alone.
function bucketKey(uri: string, scheme: string): { bucket: string, key: string } throws SyntaxError {
  if (!uri.startsWith(scheme)) throw new SyntaxError(`invalid URI ${uri}: must start with ${scheme}`)
  const rest = uri.slice(scheme.byteLength)
  const slash = rest.indexOf("/")
  const bucket = slash < 0 ? rest : rest.slice(0, slash)
  if (bucket === "") throw new SyntaxError(`invalid URI ${uri}: no bucket`)
  return { bucket: bucket, key: slash < 0 ? "" : rest.slice(slash + 1) }
}

export function gsParse(uri: string): { bucket: string, key: string } throws SyntaxError {
  return try bucketKey(uri, "gs://")
}

export function s3Parse(uri: string): { bucket: string, key: string } throws SyntaxError {
  return try bucketKey(uri, "s3://")
}

// The string with its %XX escapes decoded as UTF-8; a malformed escape is kept as it is.
// Path ids arrive percent-encoded ("gs%3A%2F%2F..."), and Tov has no decodeURIComponent.
export function pctDecode(s: string): string {
  if (!s.includes("%")) return s
  const b = new TextEncoder().encode(s)
  const out: u8[] = []
  let i = 0
  while (i < b.length) {
    const c = int(b[i]!)
    if (c === 37 && i + 2 < b.length) {
      const hi = hexDigit(int(b[i + 1]!))
      const lo = hexDigit(int(b[i + 2]!))
      if (hi >= 0 && lo >= 0) {
        out.push(u8(hi * 16 + lo))
        i += 3
        continue
      }
    }
    out.push(b[i]!)
    i += 1
  }
  try {
    return new TextDecoder().decode(out)
  } catch (e) {
    return s
  }
}

// The value of one hex digit byte, or -1.
function hexDigit(c: int): int {
  if (c >= 48 && c <= 57) return c - 48
  if (c >= 65 && c <= 70) return c - 55
  if (c >= 97 && c <= 102) return c - 87
  return -1
}

// The S3 prefix that batch output goes under by default: the batch bucket's prefix, with a trailing slash.
export function defaultOutputUri(bucket: string, prefix: string): string {
  const p = prefix.split("/").filter((x) => x !== "").join("/")
  return "s3://" + bucket + "/" + (p === "" ? "" : p + "/")
}

// The object key for an uploaded file under a prefix (slashes at the ends are dropped).
export function s3KeyFor(prefix: string, filename: string): string {
  const p = prefix.split("/").filter((s) => s !== "").join("/")
  return p === "" ? filename : p + "/" + filename
}

// The last part of a slash path: "a/b/c" gives "c".
function lastSegment(s: string): string {
  const parts = s.split("/")
  return parts[parts.length - 1] ?? ""
}

// The non-blank lines of a JSONL text.
function jsonlLines(text: string): string[] {
  const out: string[] = []
  for (const line of text.split("\n")) {
    const s = line.trim()
    if (s !== "") out.push(s)
  }
  return out
}

// The send-ready form of an AWS request: an empty body is no body.
export function sendable(r: AwsRequest): native.MediaRequest {
  return { method: r.method, url: r.url, headers: r.headers, body: r.body === "" ? undefined : r.body }
}

// An OpenAI file object for an object of a bucket (its scheme is "gs://" or "s3://").
type OFile = { id: string, object: string, bytes: f64, created_at: f64, filename: string, purpose: string, status: string }

function fileObject(scheme: string, bucket: string, key: string, bytes: f64, createdAt: f64): string {
  const f: OFile = { id: scheme + bucket + "/" + key, object: "file", bytes: bytes, created_at: createdAt, filename: lastSegment(key), purpose: "batch", status: "processed" }
  return JSON.stringify(f)
}

// The OpenAI list object. firstId and lastId are "" when there are none; a list with more
// pages carries its next cursor as last_id, which the client sends back as "after".
function listJson(items: string[], hasMore: string, firstId: string, lastId: string): string {
  const first = firstId === "" ? "null" : quote(firstId)
  const last = lastId === "" ? "null" : quote(lastId)
  return `{"object":"list","data":[${items.join(",")}],"has_more":${hasMore},"first_id":${first},"last_id":${last}}`
}

// The seconds for a time that is either epoch seconds or an RFC 3339 string (0 when neither).
function timeOf(fs: Field[], key: string): f64 {
  const n = rawNum(fs, key)
  if (n !== undefined) return n
  const ms = parseIsoUtcMs(rawStr(fs, key) ?? "")
  return ms === undefined ? 0 : ms / 1000.0
}

// The seconds of an RFC 3339 string, 0 when it does not parse.
function isoSec(s: string): f64 {
  const ms = parseIsoUtcMs(s)
  return ms === undefined ? 0 : ms / 1000.0
}

// ---- Vertex: Google Cloud Storage objects ----

// A new object name for an uploaded file: "<prefix>/vertex-files/<id>/<filename>".
export function gcsObjectName(prefix: string, filename: string): string {
  const p = prefix.split("/").filter((s) => s !== "").join("/")
  const name = "vertex-files/" + newId("") + "/" + filename
  return p === "" ? name : p + "/" + name
}

// POST the object's bytes (uploadType=media); the object name goes in the query.
export function gcsUpload(t: Target, token: string, bucket: string, name: string, text: string, contentType: string): native.MediaRequest {
  const url = `${gcsOrigin(t)}/upload/storage/v1/b/${bedrock.encodeSegment(bucket)}/o?uploadType=media&name=${bedrock.encodeSegment(name)}`
  const h = bearer(t, token, false)
  h.set("content-type", contentType)
  return { method: "POST", url: url, headers: h, body: text }
}

// GET one object's metadata, or its bytes with media, or DELETE it.
export function gcsObject(t: Target, token: string, bucket: string, name: string, method: string, media: bool): native.MediaRequest {
  const alt = media ? "?alt=media" : ""
  const url = `${gcsOrigin(t)}/storage/v1/b/${bedrock.encodeSegment(bucket)}/o/${bedrock.encodeSegment(name)}${alt}`
  return { method: method, url: url, headers: bearer(t, token, false), body: undefined }
}

// GET the objects under a prefix, one page at a time.
export function gcsList(t: Target, token: string, bucket: string, prefix: string, limit: string, cursor: string): native.MediaRequest {
  const sp = new URLSearchParams()
  sp.set("prefix", prefix)
  if (limit !== "") sp.set("maxResults", limit)
  if (cursor !== "") sp.set("pageToken", cursor)
  return { method: "GET", url: `${gcsOrigin(t)}/storage/v1/b/${bedrock.encodeSegment(bucket)}/o?${sp.toString()}`, headers: bearer(t, token, false), body: undefined }
}

// The OpenAI file object for a GCS object resource (an upload's answer or a metadata GET).
export function gcsFileToOpenAI(raw: string, bucket: string): string throws SyntaxError {
  const fs = try fields(raw)
  const size: f64 = parseInt(rawStr(fs, "size") ?? "") ?? 0
  return fileObject("gs://", bucket, rawStr(fs, "name") ?? "", size, isoSec(rawStr(fs, "timeCreated") ?? ""))
}

// The OpenAI list object for a GCS object listing.
export function gcsFileListToOpenAI(raw: string, bucket: string): string throws SyntaxError {
  const fs = try fields(raw)
  const items: string[] = []
  const names: string[] = []
  for (const el of try elements(find(fs, "items") ?? "[]")) {
    items.push(try gcsFileToOpenAI(el, bucket))
    names.push(rawStr(try fields(el), "name") ?? "")
  }
  const next = rawStr(fs, "nextPageToken") ?? ""
  const firstId = names.length > 0 ? "gs://" + bucket + "/" + names[0]! : ""
  const lastId = next !== "" ? next : names.length > 0 ? "gs://" + bucket + "/" + names[names.length - 1]! : ""
  return listJson(items, next !== "" ? "true" : "false", firstId, lastId)
}

// The object names of a GCS listing, in order.
export function gcsNames(raw: string): string[] throws SyntaxError {
  const out: string[] = []
  for (const el of try elements(find(try fields(raw), "items") ?? "[]")) out.push(rawStr(try fields(el), "name") ?? "")
  return out
}

// Whether an object name is one of a batch's prediction files.
export function predictionName(name: string): bool {
  return lastSegment(name).startsWith("predictions")
}

// The OpenAI delete object, for a file of either provider.
export function deletedToOpenAI(id: string): string {
  return JSON.stringify({ id: id, object: "file", deleted: true })
}

// ---- Vertex: Batch Prediction jobs ----

// One line of an OpenAI batch input: its custom id, its model (the provider prefix
// dropped) and its body.
type InLine = { id: string, model: string, body: Field[] }

function inLine(line: string): InLine throws SyntaxError {
  const fs = try fields(line)
  const id = rawStr(fs, "custom_id") ?? ""
  if (id === "") throw new SyntaxError("every batch line needs a custom_id")
  if ((rawStr(fs, "url") ?? "") !== "/v1/chat/completions") throw new SyntaxError(`batch line ${id}: only /v1/chat/completions is supported`)
  const bodyRaw = find(fs, "body")
  if (bodyRaw === undefined || isNull(bodyRaw)) throw new SyntaxError(`batch line ${id}: body is required`)
  const body = try fields(bodyRaw)
  if (find(body, "messages") === undefined) throw new SyntaxError(`batch line ${id}: messages is required`)
  return { id: id, model: lastSegment(rawStr(body, "model") ?? ""), body: body }
}

// The line's chat request with its model set (the typed shape needs one).
function chatOf(l: InLine, model: string): ChatRequest throws SyntaxError {
  let fs = l.body
  setField(&fs, "model", quote(model))
  return try JSON.parse(build(fs)) as ChatRequest
}

// The Vertex instances for an OpenAI batch input. A Claude instance is a Messages body
// under "request" with its custom_id beside it; a Gemini instance is a GenerateContent
// request whose labels carry the custom id (Bifrost's shapes). Model is the job's.
export function vertexInstances(jsonl: string, model: string): string throws SyntaxError {
  const out: string[] = []
  for (const line of jsonlLines(jsonl)) {
    const l = try inLine(line)
    const m = l.model !== "" ? l.model : model
    if (m === "") throw new SyntaxError(`batch line ${l.id}: model is required`)
    if (isClaude(m)) {
      let fs = try fields(try anthropic.messagesBody(try chatOf(l, m), l.body, m, false, false))
      fs = without(fs, ["model"])
      if (find(fs, "anthropic_version") === undefined) setField(&fs, "anthropic_version", quote("vertex-2023-10-16"))
      out.push(`{"custom_id":${quote(l.id)},"request":${build(fs)}}`)
    } else {
      let fs = try fields(try gemini.generateBody(try chatOf(l, m), l.body))
      setField(&fs, "labels", `{"bifrost_custom_id":${quote(l.id)}}`)
      out.push(`{"request":${build(fs)}}`)
    }
  }
  if (out.length === 0) throw new SyntaxError("the batch input has no requests")
  return out.join("\n") + "\n"
}

// Vertex's job states as OpenAI's batch statuses (Bifrost's mapping).
function jobStatus(state: string): string {
  if (state === "JOB_STATE_QUEUED" || state === "JOB_STATE_PENDING") return "validating"
  if (state === "JOB_STATE_RUNNING" || state === "JOB_STATE_UPDATING") return "in_progress"
  if (state === "JOB_STATE_SUCCEEDED" || state === "JOB_STATE_PARTIALLY_SUCCEEDED") return "completed"
  if (state === "JOB_STATE_FAILED") return "failed"
  if (state === "JOB_STATE_CANCELLING") return "cancelling"
  if (state === "JOB_STATE_CANCELLED") return "cancelled"
  if (state === "JOB_STATE_EXPIRED") return "expired"
  return "in_progress"
}

// The POST that creates a Batch Prediction job: it reads inputUri (gs://) and writes
// under outputUri (gs://). The model is a publisher path, Anthropic's for Claude.
export function vertexJobCreate(t: Target, token: string, displayName: string, model: string, inputUri: string, outputUri: string): native.MediaRequest throws SyntaxError {
  const pub = isClaude(model) ? "anthropic" : "google"
  const mdl = `publishers/${pub}/models/${model}`
  const body = `{"displayName":${quote(displayName)},"model":${quote(mdl)},"inputConfig":{"instancesFormat":"jsonl","gcsSource":{"uris":[${quote(inputUri)}]}},"outputConfig":{"predictionsFormat":"jsonl","gcsDestination":{"outputUriPrefix":${quote(outputUri)}}}}`
  const loc = try vertexLocation(t)
  return { method: "POST", url: `${loc}/batchPredictionJobs`, headers: bearer(t, token, true), body: body }
}

export function vertexJobGet(t: Target, token: string, id: string): native.MediaRequest throws SyntaxError {
  const loc = try vertexLocation(t)
  return { method: "GET", url: `${loc}/batchPredictionJobs/${bedrock.encodeSegment(id)}`, headers: bearer(t, token, false), body: undefined }
}

export function vertexJobCancel(t: Target, token: string, id: string): native.MediaRequest throws SyntaxError {
  const loc = try vertexLocation(t)
  return { method: "POST", url: `${loc}/batchPredictionJobs/${bedrock.encodeSegment(id)}:cancel`, headers: bearer(t, token, true), body: "{}" }
}

// GET one page of the jobs: limit and cursor are OpenAI's, renamed for the API.
export function vertexJobList(t: Target, token: string, limit: string, cursor: string): native.MediaRequest throws SyntaxError {
  const sp = new URLSearchParams()
  if (limit !== "") sp.set("pageSize", limit)
  if (cursor !== "") sp.set("pageToken", cursor)
  const qs = sp.toString()
  const loc = try vertexLocation(t)
  return { method: "GET", url: `${loc}/batchPredictionJobs${qs === "" ? "" : "?" + qs}`, headers: bearer(t, token, false), body: undefined }
}

// The OpenAI batch object (the shape shared by the batch converters). The times are
// set for the status that ends the batch, and output_file_id only when given.
type BatchOut = { id: string, status: string, createdAt: f64, endedAt: f64, outputFileId: string, total: f64, completed: f64, failed: f64 }

type OBatch = {
  id: string,
  object: string,
  endpoint: string,
  completion_window: string,
  status: string,
  created_at: f64,
  cancelling_at?: f64,
  cancelled_at?: f64,
  completed_at?: f64,
  expired_at?: f64,
  failed_at?: f64,
  output_file_id?: string,
  request_counts: { total: f64, completed: f64, failed: f64 },
}

function batchJson(b: BatchOut): string {
  const o: OBatch = {
    id: b.id,
    object: "batch",
    endpoint: "/v1/chat/completions",
    completion_window: "24h",
    status: b.status,
    created_at: b.createdAt,
    output_file_id: b.outputFileId === "" ? undefined : b.outputFileId,
    request_counts: { total: b.total, completed: b.completed, failed: b.failed },
  }
  if (b.endedAt > 0) {
    if (b.status === "completed") o.completed_at = b.endedAt
    else if (b.status === "failed") o.failed_at = b.endedAt
    else if (b.status === "expired") o.expired_at = b.endedAt
    else if (b.status === "cancelled") o.cancelled_at = b.endedAt
  }
  return JSON.stringify(o)
}

// The OpenAI batch object for a Batch Prediction job (create, get and cancel).
export function vertexJobToOpenAI(raw: string, outputFileId: string): string throws SyntaxError {
  const fs = try fields(raw)
  const stats = try fields(find(fs, "completionStats") ?? "{}")
  const succeeded: f64 = parseInt(rawStr(stats, "successfulCount") ?? "") ?? 0
  const failed: f64 = parseInt(rawStr(stats, "failedCount") ?? "") ?? 0
  const incomplete: f64 = parseInt(rawStr(stats, "incompleteCount") ?? "") ?? 0
  return batchJson({
    id: lastSegment(rawStr(fs, "name") ?? ""),
    status: jobStatus(rawStr(fs, "state") ?? ""),
    createdAt: timeOf(fs, "createTime"),
    endedAt: timeOf(fs, "endTime"),
    outputFileId: outputFileId,
    total: succeeded + failed + incomplete,
    completed: succeeded,
    failed: failed,
  })
}

// The OpenAI list object for a page of Batch Prediction jobs.
export function vertexJobListToOpenAI(raw: string): string throws SyntaxError {
  const fs = try fields(raw)
  const items: string[] = []
  const ids: string[] = []
  for (const el of try elements(find(fs, "batchPredictionJobs") ?? "[]")) {
    items.push(try vertexJobToOpenAI(el, ""))
    ids.push(lastSegment(rawStr(try fields(el), "name") ?? ""))
  }
  const next = rawStr(fs, "nextPageToken") ?? ""
  const firstId = ids.length > 0 ? ids[0]! : ""
  const lastId = next !== "" ? next : ids.length > 0 ? ids[ids.length - 1]! : ""
  return listJson(items, next !== "" ? "true" : "false", firstId, lastId)
}

// Whether a job has reached an end state (its output is final, or it will never have any).
export function vertexJobEnded(raw: string): bool throws SyntaxError {
  const s = rawStr(try fields(raw), "state") ?? ""
  const st = jobStatus(s)
  return s !== "" && st !== "validating" && st !== "in_progress" && st !== "cancelling"
}

// The gs:// directory a job writes its predictions under, "" when it has none yet.
export function vertexOutputDir(raw: string): string throws SyntaxError {
  return rawStr(try fields(find(try fields(raw), "outputInfo") ?? "{}"), "gcsOutputDirectory") ?? ""
}

// The OpenAI batch output JSONL for Vertex prediction lines. A line echoes its request,
// which carries the custom id in its labels (Gemini) or at the top (Claude).
export function vertexResultsToOpenAI(jsonl: string, model: string): string throws SyntaxError {
  const out: string[] = []
  for (const line of jsonlLines(jsonl)) {
    const fs = try fields(line)
    const req = try fields(find(fs, "request") ?? "{}")
    const labels = try fields(find(req, "labels") ?? "{}")
    const id = rawStr(fs, "custom_id") ?? rawStr(labels, "bifrost_custom_id") ?? ""
    const resp = find(fs, "response")
    if (resp !== undefined && !isNull(resp)) {
      let done: Translated = { body: "", promptTokens: 0, completionTokens: 0 }
      if (isClaude(model)) done = try anthropic.chatResponse(resp, model)
      else done = try gemini.chatResponse(resp, model)
      out.push(successLine(id, done.body))
    } else {
      const status = rawStr(fs, "status") ?? ""
      out.push(errorLine(id, "request_failed", status !== "" ? status : "the request failed"))
    }
  }
  return out.join("\n")
}

// One OpenAI batch output line, for a request that succeeded or did not.
function successLine(customId: string, body: string): string {
  return `{"id":${quote(newId("batch_req_"))},"custom_id":${quote(customId)},"response":{"status_code":200,"request_id":${quote(newId("req_"))},"body":${body}},"error":null}`
}

function errorLine(customId: string, code: string, message: string): string {
  return `{"id":${quote(newId("batch_req_"))},"custom_id":${quote(customId)},"response":null,"error":{"code":${quote(code)},"message":${quote(message)}}}`
}

// The Vertex batch input location for a converted input: a sibling of the input file.
export function vertexInputName(): string {
  return "vertex-batch-input/" + newId("") + ".jsonl"
}

// ---- Bedrock: S3 objects ----

// The static AWS credentials of a Bedrock key, or an error when it has none.
export function staticCreds(bk: BedrockKeyConfig): S3Creds throws SyntaxError {
  const ak = bk.access_key ?? ""
  if (ak === "") throw new SyntaxError("bedrock: key has no access_key")
  return { accessKey: ak, secretKey: bk.secret_key ?? "", sessionToken: bk.session_token, region: bedrockRegion(bk) }
}

// The credentials from an AssumeRole answer, in the key's region.
export function assumedCreds(a: AssumedCreds, region: string): S3Creds {
  return { accessKey: a.accessKey, secretKey: a.secretKey, sessionToken: a.sessionToken, region: region }
}

// The key's region, us-east-1 when it has none.
export function bedrockRegion(bk: BedrockKeyConfig): string {
  const r = bk.region ?? ""
  return r === "" ? "us-east-1" : r
}

// The custom S3 endpoint of a key (its base_url), or "" for AWS's virtual-hosted URLs.
export function s3Endpoint(t: Target): string {
  const b = t.cfg.network_config?.base_url
  return b === undefined ? "" : trimSlash(b)
}

// The scheme and host of a Bedrock service in a region: the key's base_url when set, else AWS's.
export function bedrockOrigin(t: Target, service: string, region: string): { scheme: string, host: string } {
  const b = t.cfg.network_config?.base_url
  if (b !== undefined && b !== "") {
    const u = URL.parse(b)
    if (u !== undefined) return { scheme: b.startsWith("http://") ? "http://" : "https://", host: u.host }
  }
  return { scheme: "https://", host: `${service}.${region}.amazonaws.com` }
}

// The batch bucket and prefix of a key: its batch_s3_config default, else its first bucket.
export function batchBucket(bk: BedrockKeyConfig): { bucket: string, prefix: string } | undefined {
  const bs = bk.batch_s3_config?.buckets ?? []
  let pick: { bucket_name: string, prefix?: string, is_default?: bool } | undefined = undefined
  for (const b of bs) {
    if (b.is_default === true) pick = b
  }
  if (pick === undefined && bs.length > 0) pick = bs[0]
  if (pick === undefined) return undefined
  return { bucket: pick.bucket_name, prefix: pick.prefix ?? "" }
}

// The service role a batch job runs as, in Bifrost's order: the key's batch_role_arn,
// then the request's role_arn, then the key's role_arn.
export function bedrockRole(batchRole: string | undefined, bodyRole: string, keyRole: string | undefined): string {
  if (batchRole !== undefined && batchRole !== "") return batchRole
  if (bodyRole !== "") return bodyRole
  return keyRole ?? ""
}

// A signed S3 request for one object (GET, PUT or DELETE) of a bucket.
export function s3Object(c: S3Creds, endpoint: string, bucket: string, key: string, method: string, body: string, contentType: string, nowMs: number): native.MediaRequest {
  return sendable(s3Call(c, endpoint, method, bucket, key, [], body, contentType, nowMs))
}

// A signed ListObjectsV2 request for one page of a bucket under a prefix.
export function s3List(c: S3Creds, endpoint: string, bucket: string, prefix: string, token: string, limit: string, nowMs: number): native.MediaRequest {
  const pairs: string[][] = [["list-type", "2"]]
  if (prefix !== "") pairs.push(["prefix", prefix])
  if (token !== "") pairs.push(["continuation-token", token])
  if (limit !== "") pairs.push(["max-keys", limit])
  return sendable(s3Call(c, endpoint, "GET", bucket, "", pairs, "", "", nowMs))
}

// One object of a ListObjectsV2 answer.
type S3Item = { key: string, size: f64, modified: f64 }

// The objects of a ListObjectsV2 answer (keys are XML-unescaped).
function s3Items(xml: string): S3Item[] {
  const out: S3Item[] = []
  let rest = xml
  let start = rest.indexOf("<Contents>")
  while (start >= 0) {
    const from = rest.slice(start)
    const end = from.indexOf("</Contents>")
    if (end < 0) break
    const block = from.slice(0, end)
    const size: f64 = parseInt(xmlTag(block, "Size") ?? "") ?? 0
    const ms = parseIsoUtcMs(xmlTag(block, "LastModified") ?? "")
    out.push({ key: xmlTag(block, "Key") ?? "", size: size, modified: ms === undefined ? 0 : ms / 1000.0 })
    rest = from.slice(end + "</Contents>".byteLength)
    start = rest.indexOf("<Contents>")
  }
  return out
}

// The OpenAI file object for an S3 object.
export function s3FileToOpenAI(bucket: string, key: string, bytes: f64, modified: f64): string {
  return fileObject("s3://", bucket, key, bytes, modified)
}

// The OpenAI list object for a ListObjectsV2 answer.
export function s3ListToOpenAI(xml: string, bucket: string): string {
  const its = s3Items(xml)
  const items: string[] = []
  for (const i of its) items.push(fileObject("s3://", bucket, i.key, i.size, i.modified))
  const truncated = xmlTag(xml, "IsTruncated") === "true"
  const next = xmlTag(xml, "NextContinuationToken") ?? ""
  const firstId = its.length > 0 ? "s3://" + bucket + "/" + its[0]!.key : ""
  const lastId = truncated && next !== "" ? next : its.length > 0 ? "s3://" + bucket + "/" + its[its.length - 1]!.key : ""
  return listJson(items, truncated ? "true" : "false", firstId, lastId)
}

// The OpenAI file object of one key in a ListObjectsV2 answer, or undefined when absent.
export function s3FileFromList(xml: string, bucket: string, key: string): string | undefined {
  for (const i of s3Items(xml)) {
    if (i.key === key) return fileObject("s3://", bucket, i.key, i.size, i.modified)
  }
  return undefined
}

// The keys of a ListObjectsV2 answer, in order.
export function s3Keys(xml: string): string[] {
  const out: string[] = []
  for (const i of s3Items(xml)) out.push(i.key)
  return out
}

// ---- Bedrock: model invocation (batch) jobs ----

// The fields of a job the create call sends.
export type BedrockJob = { name: string, model: string, role: string, inputUri: string, outputUri: string, hours: int }

// POST /model-invocation-job: the job reads inputUri (s3://) and writes under outputUri.
export function bedrockJobCreate(o: { scheme: string, host: string }, c: S3Creds, j: BedrockJob, nowMs: number): native.MediaRequest {
  const tail = j.hours > 0 ? `,"timeoutDurationInHours":${j.hours}` : ""
  const body = `{"jobName":${quote(j.name)},"modelId":${quote(j.model)},"roleArn":${quote(j.role)},"inputDataConfig":{"s3InputDataConfig":{"s3Uri":${quote(j.inputUri)},"s3InputFormat":"JSONL"}},"outputDataConfig":{"s3OutputDataConfig":{"s3Uri":${quote(j.outputUri)}}}${tail}}`
  return sendable(awsCall(c, "bedrock", o.scheme, o.host, "POST", "/model-invocation-job", [], body, nowMs))
}

export function bedrockJobGet(o: { scheme: string, host: string }, c: S3Creds, id: string, nowMs: number): native.MediaRequest {
  return sendable(awsCall(c, "bedrock", o.scheme, o.host, "GET", "/model-invocation-job/" + bedrock.encodeSegment(id), [], "", nowMs))
}

// GET one page of the jobs: limit and cursor are OpenAI's, renamed for the API.
export function bedrockJobList(o: { scheme: string, host: string }, c: S3Creds, limit: string, cursor: string, nowMs: number): native.MediaRequest {
  const pairs: string[][] = []
  if (limit !== "") pairs.push(["maxResults", limit])
  if (cursor !== "") pairs.push(["nextToken", cursor])
  return sendable(awsCall(c, "bedrock", o.scheme, o.host, "GET", "/model-invocation-jobs", pairs, "", nowMs))
}

export function bedrockJobStop(o: { scheme: string, host: string }, c: S3Creds, id: string, nowMs: number): native.MediaRequest {
  return sendable(awsCall(c, "bedrock", o.scheme, o.host, "POST", "/model-invocation-job/" + bedrock.encodeSegment(id) + "/stop", [], "{}", nowMs))
}

// Bedrock's job statuses as OpenAI's batch statuses (Bifrost's mapping).
function bedrockStatus(s: string): string {
  if (s === "Submitted" || s === "Validating" || s === "Scheduled") return "validating"
  if (s === "Completed") return "completed"
  if (s === "Failed" || s === "PartiallyCompleted") return "failed"
  if (s === "Stopping") return "cancelling"
  if (s === "Stopped") return "cancelled"
  if (s === "Expired") return "expired"
  return "in_progress"
}

// The OpenAI batch object for a model invocation job. The id is the job's own id (the last
// part of its ARN), which Bedrock also takes in place of the ARN.
export function bedrockJobToOpenAI(raw: string, outputFileId: string): string throws SyntaxError {
  const fs = try fields(raw)
  return batchJson({
    id: lastSegment(rawStr(fs, "jobArn") ?? ""),
    status: bedrockStatus(rawStr(fs, "status") ?? ""),
    createdAt: timeOf(fs, "submitTime"),
    endedAt: timeOf(fs, "endTime"),
    outputFileId: outputFileId,
    total: 0,
    completed: 0,
    failed: 0,
  })
}

// The OpenAI list object for a page of model invocation jobs.
export function bedrockJobListToOpenAI(raw: string): string throws SyntaxError {
  const fs = try fields(raw)
  const items: string[] = []
  const ids: string[] = []
  for (const el of try elements(find(fs, "invocationJobSummaries") ?? "[]")) {
    items.push(try bedrockJobToOpenAI(el, ""))
    ids.push(lastSegment(rawStr(try fields(el), "jobArn") ?? ""))
  }
  const next = rawStr(fs, "nextToken") ?? ""
  const firstId = ids.length > 0 ? ids[0]! : ""
  const lastId = next !== "" ? next : ids.length > 0 ? ids[ids.length - 1]! : ""
  return listJson(items, next !== "" ? "true" : "false", firstId, lastId)
}

// Whether a job has reached an end state.
export function bedrockJobEnded(raw: string): bool throws SyntaxError {
  const st = bedrockStatus(rawStr(try fields(raw), "status") ?? "")
  return st === "completed" || st === "failed" || st === "cancelled" || st === "expired"
}

// The model a job runs on (its modelId).
export function bedrockJobModel(raw: string): string throws SyntaxError {
  return rawStr(try fields(raw), "modelId") ?? ""
}

// The S3 prefix a job writes its results under (its output URI), "" when it has none.
export function bedrockOutputUri(raw: string): string throws SyntaxError {
  const fs = try fields(raw)
  return rawStr(try fields(find(try fields(find(fs, "outputDataConfig") ?? "{}"), "s3OutputDataConfig") ?? "{}"), "s3Uri") ?? ""
}

// The Bedrock batch input (JSONL records) for an OpenAI batch input file. A Claude record's
// modelInput is a Messages body with Bedrock's version; other models take the body as given.
// The model is not in the record: it is the job's.
export function bedrockInputJsonl(jsonl: string, model: string): string throws SyntaxError {
  const out: string[] = []
  for (const line of jsonlLines(jsonl)) {
    const l = try inLine(line)
    const m = l.model !== "" ? l.model : model
    if (m === "") throw new SyntaxError(`batch line ${l.id}: model is required`)
    let mi = ""
    if (m.includes("anthropic.")) {
      let fs = try fields(try anthropic.messagesBody(try chatOf(l, m), l.body, m, false, false))
      fs = without(fs, ["model"])
      if (find(fs, "anthropic_version") === undefined) setField(&fs, "anthropic_version", quote("bedrock-2023-05-31"))
      mi = build(fs)
    } else {
      mi = build(without(l.body, ["model"]))
    }
    out.push(`{"recordId":${quote(l.id)},"modelInput":${mi}}`)
  }
  if (out.length === 0) throw new SyntaxError("the batch input has no requests")
  return out.join("\n") + "\n"
}

// The OpenAI batch output JSONL for Bedrock's result records. A Claude answer is converted
// from its Messages body; other models must already answer in the chat shape.
export function bedrockResultsToOpenAI(jsonl: string, model: string): string throws SyntaxError {
  const out: string[] = []
  for (const line of jsonlLines(jsonl)) {
    const fs = try fields(line)
    const id = rawStr(fs, "recordId") ?? ""
    const errRaw = find(fs, "error")
    if (errRaw !== undefined && !isNull(errRaw)) {
      const ef = try fields(errRaw)
      out.push(errorLine(id, `${rawNum(ef, "errorCode") ?? 0}`, rawStr(ef, "errorMessage") ?? "the request failed"))
      continue
    }
    const mo = find(fs, "modelOutput")
    if (mo === undefined || isNull(mo)) {
      out.push(errorLine(id, "no_output", "the request has no model output"))
      continue
    }
    if (model.includes("anthropic.")) {
      const done = try anthropic.chatResponse(mo, model)
      out.push(successLine(id, done.body))
    } else if (mo.includes(`"choices"`)) {
      out.push(successLine(id, mo))
    } else {
      out.push(errorLine(id, "unsupported_output", "this model's output is not converted to the chat shape"))
    }
  }
  return out.join("\n")
}

// A job's name: the caller's (metadata job_name), else a fresh one.
export function jobName(explicit: string): string {
  return explicit !== "" ? explicit : "raiju-batch-" + newId("")
}

// The hours of a completion window such as "24h" (24 when it is not in hours).
export function windowHours(w: string): int {
  if (!w.endsWith("h")) return 24
  return parseInt(w.slice(0, w.byteLength - 1)) ?? 24
}

// A fresh name for a batch input the gateway writes to a bucket.
export function bedrockInputName(): string {
  return "bedrock-batch-input/" + newId("") + ".jsonl"
}

