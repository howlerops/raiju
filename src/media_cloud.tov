test("stability edits: the task comes from the type or the model, and each task takes its own options", () => {
  const img = new TextEncoder().encode("img")
  const msk = new TextEncoder().encode("msk")
  const st: Target = { provider: "bedrock", kind: "bedrock", model: "stability.stable-image-inpaint-v1:0", key: BD.key, cfg: {} }
  const ed = bdEdit("inpainting", msk)
  ed.negative = "blur"
  ed.seed = 7
  const ex: Map<string, string> = new Map()
  ex.set("grow_mask", "5")
  ex.set("select_prompt", "ignored")
  ed.extra = ex
  const body = try stabilityEditBody("inpaint", ed)
  expect(body).toBe(`{"image":"${encode(img)}","prompt":"a red fox","negative_prompt":"blur","seed":7,"mask":"${encode(msk)}","grow_mask":5}`)
  const up = try bedrockImageEdit(st, bdEdit("", undefined))
  expect((up.body as string).startsWith(`{"image":"${encode(img)}","prompt":"a red fox"`)).toBe(true)
  expect(up.url).toBe("https://bedrock-runtime.us-east-1.amazonaws.com/model/stability.stable-image-inpaint-v1%3A0/invoke")
  const bg = try stabilityEditBody("remove-bg", bdEdit("remove_background", undefined))
  expect(bg).toBe(`{"image":"${encode(img)}"}`)
  const rc = bdEdit("recolor", undefined)
  let missing = false
  try {
    stabilityEditBody("recolor", rc)
  } catch (e) {
    missing = true
  }
  expect(missing).toBe(true)
  const rx: Map<string, string> = new Map()
  rx.set("select_prompt", "sky")
  rc.extra = rx
  expect(try stabilityEditBody("recolor", rc)).toBe(`{"image":"${encode(img)}","prompt":"a red fox","select_prompt":"sky"}`)
  const sx = bdEdit("style_transfer", undefined)
  sx.images = [img]
  let two = false
  try {
    stabilityEditBody("style-transfer", sx)
  } catch (e) {
    two = true
  }
  expect(two).toBe(true)
  let varRefused = false
  try {
    bedrockImageVariation(st, { images: [img], prompt: "", negative: "", similarity: undefined, n: undefined, size: "", quality: "", cfgScale: undefined })
  } catch (e) {
    varRefused = true
  }
  expect(varRefused).toBe(true)
})

