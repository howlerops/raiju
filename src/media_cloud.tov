  expect(list.headers.has("host")).toBe(false)
  const stop = awsCall({ accessKey: "AKIAIOSFODNN7EXAMPLE", secretKey: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY", region: "us-west-2" }, "bedrock", "https://", "bedrock.us-west-2.amazonaws.com", "POST", "/model-invocation-job/abc123/stop", [], "{}", NOW)
  expect(stop.url).toBe("https://bedrock.us-west-2.amazonaws.com/model-invocation-job/abc123/stop")
  expect(stop.headers.get("authorization")).toBe("AWS4-HMAC-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20261014/us-west-2/bedrock/aws4_request, SignedHeaders=content-type;host;x-amz-date, Signature=b24e6cb706cfcc045c0b12dca7cc3faf7cfa4aece87e583135d901e78e824dcd")
  expect(stop.headers.get("content-type")).toBe("application/json")
  const put = s3Call(S3K, "http://mock.local:9000/", "PUT", "bkt", "a/b c.jsonl", [], "x", "application/jsonl", NOW)
  expect(put.url).toBe("http://mock.local:9000/bkt/a/b%20c.jsonl")
  expect(put.headers.get("authorization")).toBe("AWS4-HMAC-SHA256 Credential=AKIAIOSFODNN7EXAMPLE/20261014/us-east-1/s3/aws4_request, SignedHeaders=content-type;host;x-amz-content-sha256;x-amz-date, Signature=52e807089a3508c4af3a93cdb97e715ff8d4fd6c4abca8f87684390d4709ff8a")
  expect(put.headers.get("content-type")).toBe("application/jsonl")
})

test("bucket and key parts of gs:// and s3:// URIs", () => {
  const g = try gsParse("gs://bkt/out/dir/x.jsonl")
  expect(g.bucket).toBe("bkt")
  expect(g.key).toBe("out/dir/x.jsonl")
  expect(try gsParse("gs://bkt").key).toBe("")
  expect(try s3Parse("s3://b2/k").key).toBe("k")
  let bad = 0
  for (const u of ["s3://b/k", "gs://", "gs:///x", "http://x"]) {
    try {
      gsParse(u)
    } catch (e) {
      bad += 1
    }
  }
  expect(bad).toBe(4)
})

