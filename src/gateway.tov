export type Build = (t: Target) => Upstream throws SyntaxError
// a chat request for a target, from its shaped body (tc parses the same request as a typed chat)
type ChatSender = (t: Target, b: Field[], tc: LazyChat) => Upstream throws SyntaxError
export type Translate = (t: Target, text: string, requestedModel: string) => Translated throws SyntaxError

type Outcome = { ok: bool, status: int, body: string, contentType: string, provider: string, model: string, promptTokens: int, completionTokens: int, attempts: int, upstreamMs: f64, direct?: bool, raw?: bool, key?: string, alias?: string, aliasName?: string, aliasFamily?: string, retryMs?: f64, served?: string, billed?: f64 }

// Where a streamed answer goes, when the server can stream (the http1 front end).
export class StreamSink {
  started = false
  // the client went away: stop reading the upstream
  cancelled = false
  // set by the relay while it reads the upstream: aborts a read that is waiting for the next chunk
  abort: (() => void) | undefined = undefined
  constructor(readonly open: (status: int, headers: Map<string, string>) => void, readonly write: (chunk: string) => void, readonly close: () => void) {}
  // binary event-stream frames (Bedrock's streaming routes); only the Bun.serve path sets it
  writeBytes: ((chunk: u8[]) => void) | undefined = undefined
}

// Turns a provider's streaming body into OpenAI SSE events as bytes arrive.
// One concrete class over the per-provider converters in streams.tov (calls
// through an interface value crashed this Tov build).
export class StreamConverter {
  oa: OpenAIPassthrough | undefined = undefined
  an: AnthropicToOpenAI | undefined = undefined
  ge: GeminiToOpenAI | undefined = undefined
  br: BedrockEventStreamToOpenAI | undefined = undefined
  co: CohereToOpenAI | undefined = undefined
  // a Responses stream (a chat request sent to Responses), read as chat chunks
  rs: ResponsesToChatStream | undefined = undefined
  // a chat stream answered to a text completion: each frame becomes a text_completion frame
  txt = false
  private txtPending = ""
  readonly dec: TextDecoder | undefined = utf8Decoder()
  // output converters: the client's own stream format (one is set, or none)
  gen: GenAIStream | undefined = undefined
  cohereOut: CohereStream | undefined = undefined
  cv: ConverseStream | undefined = undefined
  iv: InvokeStream | undefined = undefined
  // binary frames for the client, taken with takeFrames()
  private frames: u8[] = []

  // kind "responses-raw": a Responses stream from an OpenAI upstream, forwarded as it came
  rp: ResponsesPassthrough | undefined = undefined

  // the client's text is completed as JSON (jsonparser) and checked by the local output guardrails
  // (set by chatOnce); halted once either ends the stream
  jsonFix: JsonStreamFixer | undefined = undefined
  guard: OutputStreamGuard | undefined = undefined
  halted = false
  // the guard's redaction kinds already counted in the metrics
  private reportedKinds = 0

  constructor(readonly kind: string, requested: string, includeUsage: bool) {
    if (kind === "responses-raw") this.rp = new ResponsesPassthrough()
    else if (kind === "anthropic") this.an = new AnthropicToOpenAI(requested, includeUsage)
    else if (kind === "gemini") this.ge = new GeminiToOpenAI(requested, includeUsage)
    else if (kind === "bedrock") this.br = new BedrockEventStreamToOpenAI(requested, includeUsage)
    else if (kind === "cohere") this.co = new CohereToOpenAI(requested, includeUsage)
    else if (kind === "responses") this.rs = new ResponsesToChatStream(requested, includeUsage)
    else this.oa = new OpenAIPassthrough(requested, !includeUsage)
  }

  // text converters take whole characters: the streaming decoder holds back a split one
  text(bytes: u8[]): string {
    const d = this.dec
    if (d === undefined) return ""
    try {
      return d.decode(bytes, { stream: true })
    } catch (e) {
      return ""
    }
  }

  // For clients of the Anthropic Messages API: the OpenAI chunks become Messages events
  // (asAnthropic), or an Anthropic upstream's events pass through as they are (raw).
  out: StreamState | undefined = undefined
  raw = false
  private pending = ""
  // custom_provider_config: does_not_send_done_marker without wait_for_usage ends the stream at finish_reason
  stopAtFinish = false
  private finished = false
  private quirkSplit = new SseSplitter()

  private quirkPush(oa: OpenAIPassthrough, text: string): string {
    let out = ""
    for (const ev of this.quirkSplit.push(text)) {
      if (this.finished) continue
      out += oa.push(`data: ${ev.data}\n\n`)
      if (finishes(ev.data)) this.finished = true
    }
    return out
  }

  private quirkEnd(oa: OpenAIPassthrough): string {
    let out = ""
    for (const ev of this.quirkSplit.flush()) {
      if (this.finished) continue
      out += oa.push(`data: ${ev.data}\n\n`)
      if (finishes(ev.data)) this.finished = true
    }
    return out + oa.end()
  }

  asAnthropic(model: string): void {
    this.out = new StreamState(model)
  }

  asGenAI(model: string): void {
    this.gen = new GenAIStream(model)
  }

  asCohere(model: string): void {
    this.cohereOut = new CohereStream(model)
  }

  asConverse(): void {
    this.cv = new ConverseStream()
  }

  asInvoke(model: string): void {
    this.iv = new InvokeStream(model)
  }

  // Bedrock's event streams are binary, so their frames are kept apart from the text.
  framed(): bool {
    return this.cv !== undefined || this.iv !== undefined
  }

  takeFrames(): u8[] {
    const f = this.frames
    this.frames = []
    return f
  }

  private collect(bytes: u8[]): void {
    for (const b of bytes) this.frames.push(b)
  }

  push(bytes: u8[]): string {
    const rp = this.rp
    if (rp !== undefined) return rp.push(this.text(bytes))
    if (this.raw) {
      const t = this.text(bytes)
      const an = this.an
      if (an !== undefined && t !== "") an.push(t)
      return t
    }
    return this.post(this.inner(bytes))
  }

  end(): string {
    const rp = this.rp
    if (rp !== undefined) return rp.end()
    if (this.raw) {
      this.an?.end()
      return ""
    }
    const tail = this.post(this.innerEnd())
    const cv = this.cv
    if (cv !== undefined) this.collect(cv.end())
    const iv = this.iv
    if (iv !== undefined) this.collect(iv.end())
    const st = this.out
    if (st !== undefined) return tail + st.end()
    const g = this.gen
    if (g !== undefined) return tail + g.end()
    const co = this.cohereOut
    if (co !== undefined) return tail + co.end()
    return tail
  }

  // The client's text after the local output guardrails. A block halts the converter, and the
  // relay stops reading the upstream.
  guarded(s: string, last: bool): string {
    const jf = this.jsonFix
    const text = jf === undefined ? s : last ? jf.finish(s) : jf.filter(s)
    if (jf !== undefined && jf.stopped) {
      this.halted = true
      return text
    }
    const g = this.guard
    if (g === undefined) return text
    const out = last ? g.finish(text) : g.filter(text)
    if (g.stopped && !this.halted) {
      this.halted = true
      metrics.inc("raiju_guardrail_checks_total", metrics.labels("", g.blockedBy, "block"), 1.0)
    }
    for (let k = this.reportedKinds; k < g.kinds.length; k++) metrics.inc("raiju_guardrail_findings_total", metrics.labels("", g.kinds[k]!, "redact"), 1.0)
    this.reportedKinds = g.kinds.length
    return out
  }

  // Whole frames only: a text completion frame is built from a complete chat frame.
  private textPost(s: string): string {
    this.txtPending += s
    let res = ""
    while (true) {
      const i = this.txtPending.indexOf("\n\n")
      if (i < 0) break
      const ev = this.txtPending.slice(0, i)
      this.txtPending = this.txtPending.slice(i + 2)
      if (ev !== "") res += textFrame(ev) + "\n\n"
    }
    return res
  }

  private post(s: string): string {
    if (this.txt) return this.textPost(s)
    const st = this.out
    const g = this.gen
    const co = this.cohereOut
    const cv = this.cv
    const iv = this.iv
    if (st === undefined && g === undefined && co === undefined && cv === undefined && iv === undefined) return s
    this.pending += s
    let res = ""
    while (true) {
      const i = this.pending.indexOf("\n\n")
      if (i < 0) break
      const ev = this.pending.slice(0, i)
      this.pending = this.pending.slice(i + 2)
      for (const line of ev.split("\n")) {
        if (!line.startsWith("data:")) continue
        const payload = line.slice(5).trim()
        if (payload === "" || payload === "[DONE]") continue
        try {
          if (cv !== undefined) this.collect(cv.push(payload))
          else if (iv !== undefined) this.collect(iv.push(payload))
          else if (st !== undefined) res += st.push(payload)
          else if (g !== undefined) res += g.push(payload)
          else if (co !== undefined) res += co.push(payload)
        } catch (e) {
          // a malformed chunk is skipped
        }
      }
    }
    return res
  }

  private inner(bytes: u8[]): string {
    const br = this.br
    if (br !== undefined) return br.push(bytes)
    const t = this.text(bytes)
    if (t === "") return ""
    const rs = this.rs
    if (rs !== undefined) return rs.push(t)
    const an = this.an
    if (an !== undefined) return an.push(t)
    const ge = this.ge
    if (ge !== undefined) return ge.push(t)
    const co = this.co
    if (co !== undefined) return co.push(t)
    const oa = this.oa
    if (oa !== undefined) return this.stopAtFinish ? this.quirkPush(oa, t) : oa.push(t)
    return ""
  }

  private innerEnd(): string {
    const rs = this.rs
    if (rs !== undefined) return rs.end()
    const an = this.an
    if (an !== undefined) return an.end()
    const ge = this.ge
    if (ge !== undefined) return ge.end()
    const br = this.br
    if (br !== undefined) return br.end()
    const co = this.co
    if (co !== undefined) return co.end()
    const oa = this.oa
    if (oa !== undefined) return this.stopAtFinish ? this.quirkEnd(oa) : oa.end()
    return ""
  }

  // The provider's billed cost on a streamed answer (OpenRouter's usage.cost on the usage chunk).
  billedCost(): f64 | undefined {
    return this.oa?.billed
  }

  promptTokens(): int {
    return this.rp?.promptTokens ?? this.rs?.promptTokens ?? this.an?.inTokens ?? this.ge?.inTokens ?? this.br?.promptTokens ?? this.co?.inTokens ?? this.oa?.promptTokens ?? 0
  }

  completionTokens(): int {
    return this.rp?.completionTokens ?? this.rs?.completionTokens ?? this.an?.outTokens ?? this.ge?.outTokens ?? this.br?.completionTokens ?? this.co?.outTokens ?? this.oa?.completionTokens ?? 0
  }
}

// The chat body with its only message's text replaced, or undefined when there isn't exactly
// one message with string content.
// "provider/model" split at the first slash; a bare name has no provider.
function splitModel(m: string): { provider: string, model: string } {
  const i = m.indexOf("/")
  if (i < 0) return { provider: "", model: m }
  return { provider: m.slice(0, i), model: m.slice(i + 1) }
}

function singleTextMessage(chatBody: string, replacement: string): string | undefined {
  try {
    let fs = fields(chatBody)
    const msgs = find(fs, "messages")
    if (msgs === undefined) return undefined
    const els = elements(msgs)
    if (els.length !== 1) return undefined
    let m = fields(els[0]!)
    const c = find(m, "content")
    if (c === undefined || !c.startsWith("\"")) return undefined
    setField(&m, "content", quote(replacement))
    setField(&fs, "messages", "[" + build(m) + "]")
    return build(fs)
  } catch (e) {
    return undefined
  }
}

// A chat completion with its first choice's message content replaced.
function replaceFirstContent(completion: string, text: string): string {
  try {
    let fs = fields(completion)
    const choices = find(fs, "choices")
    if (choices === undefined) return completion
    const els = elements(choices)
    if (els.length === 0) return completion
    let c = fields(els[0]!)
    const mraw = find(c, "message")
    if (mraw === undefined) return completion
    let m = fields(mraw)
    setField(&m, "content", quote(text))
    setField(&c, "message", build(m))
    const rest = els.slice(1)
    setField(&fs, "choices", "[" + [build(c)].concat(rest).join(",") + "]")
    return build(fs)
  } catch (e) {
    return completion
  }
}

// The compat headers of a request's plan: the params and tools it dropped, and the request type it converted to.
function compatHeaders(inout out: Hdrs, cp: CompatPlan | undefined): void {
  if (cp === undefined || !cp.enabled) return
  if (cp.dropped.length > 0) out.set("x-bifrost-dropped-compat-params", cp.dropped.join(","))
  if (cp.toolDrops.length > 0) out.set("x-bifrost-dropped-unsupported-tools", cp.toolDrops.join(","))
  if (cp.converted !== "") out.set("x-bifrost-converted-request-type", cp.converted)
}

// The entries of an x-bf-mcp-include-tools value: "<client>-<tool>" or "<client>-*", comma-separated.
export function includeToolNames(value: string): string[] {
  const out: string[] = []
  for (const part of value.split(",")) {
    const n = part.trim()
    if (n !== "") out.push(n)
  }
  return out
}

// Whether a chat tool definition is listed: by its exact name, or by "<client>-*" for its client.
export function toolInList(toolJson: string, want: string[]): bool throws SyntaxError {
  const name = try toolFnName(toolJson)
  if (name === undefined) return false
  for (const w of want) {
    if (w === name) return true
    if (w.endsWith("-*") && name.startsWith(w.slice(0, w.byteLength - 1))) return true
  }
  return false
}

// Whether a chat tool definition's name is `pattern` ("<server>-<tool>", or "<server>-*").
function toolNameMatches(toolJson: string, pattern: string): bool {
  if (pattern === "*") return true
  if (pattern.endsWith("*")) return toolJson.includes(`"name":"${pattern.slice(0, pattern.byteLength - 1)}`)
  return toolJson.includes(`"name":"${pattern}"`)
}

class LastHeaders {
  h: Map<string, string> = new Map()
}

// Bifrost's request type names (core/schemas/bifrost.go), for x-bifrost-request-type.
// bifrost_mcp_client_operation_duration_seconds for one tool call. The client is the server the
// namespaced tool name belongs to; a name that does not split keeps an empty client.
function timedMcp(m: McpManager, name: string, t0: f64, isError: bool): void {
  const parts = splitToolName(name, m.status().map((s) => s.name))
  metrics.observeMcp(parts?.server ?? "", parts?.tool ?? name, isError ? "tool_error" : "", (performance.now() - t0) / 1000.0)
}

// The integration an op came in on, for picking among providers that serve a bare model.
function routeOf(op: string): string {
  const dot = op.indexOf(".")
  const head = dot < 0 ? op : op.slice(0, dot)
  if (head === "anthropic" || head === "cohere" || head === "genai" || head === "bedrock") return head
  return "openai"
}

function requestType(op: string, streamed: bool): string {
  let t = op
  if (op === "chat" || op === "anthropic.messages") t = "chat_completion"
  else if (op === "completions") t = "text_completion"
  else if (op === "embeddings") t = "embedding"
  else if (op === "responses") t = "responses"
  return streamed && (t === "chat_completion" || t === "text_completion" || t === "responses") ? t + "_stream" : t
}

// The routed identity, as Bifrost reports it (lib/responseheaders.go): who answered, what was
// asked for, and whether it took a fallback. key is the key's name, alias the upstream name
// the key's aliases mapped the request to ("" when none did).
// name and family are the alias config's canonical name and family ("" when unset).
function routedHeaders(inout out: Hdrs, primary: ModelRef, provider: string, model: string, idx: int, requested: string, upstreamMs: f64, key: string, alias: string, name: string, family: string): void {
  out.set("x-bifrost-provider", provider)
  out.set("x-bifrost-original-model", requested)
  out.set("x-bifrost-resolved-model", model)
  out.set("x-bifrost-fallback-index", "" + Math.max(0, idx))
  out.set("x-bifrost-upstream-latency-ms", "" + Math.round(upstreamMs))
  out.set("x-bifrost-routing-info-provider", provider)
  out.set("x-bifrost-routing-info-model", model)
  if (key !== "") out.set("x-bifrost-routing-info-key", key)
  if (alias !== "") out.set("x-bifrost-routing-info-alias-model-id", alias)
  if (name !== "") out.set("x-bifrost-routing-info-alias-model-name", name)
  if (family !== "") out.set("x-bifrost-routing-info-alias-model-family", family)
  out.set("x-bifrost-routing-info-is-fallback", idx > 0 ? "true" : "false")
  out.set("x-bifrost-routing-info-primary-provider", primary.provider)
  out.set("x-bifrost-routing-info-primary-model", primary.model)
  const slash = requested.indexOf("/")
  out.set("x-bifrost-routing-info-requested-provider", slash > 0 ? requested.slice(0, slash) : primary.provider)
  out.set("x-bifrost-routing-info-requested-model", slash > 0 ? requested.slice(slash + 1) : requested)
}

// The upstream name a key's aliases map the request model to, or "" when they do not change it.
function aliasTo(k: KeyConfig, model: string, maxDepth?: int): string {
  const to = resolveAlias(k, model, maxDepth).model
  return to !== model ? to : ""
}

// The canonical name and family the matching alias sets, or "" for each.
function aliasNameOf(k: KeyConfig, model: string): string {
  const e = matchedAlias(k, model)
  if (e === undefined || e.model_name === undefined) return ""
  return e.model_name
}

function aliasFamilyOf(k: KeyConfig, model: string): string {
  const e = matchedAlias(k, model)
  if (e === undefined || e.model_family === undefined) return ""
  return e.model_family
}

// The index of (provider, model) in the allowed chain: 0 for the primary, or when it is not there.
function fallbackIndex(allowed: ModelRef[], provider: string, model: string): int {
  for (let i = 0; i < allowed.length; i++) {
    if (allowed[i]!.provider === provider && allowed[i]!.model === model) return i
  }
  return 0
}

// The cache id Bifrost reports for a direct entry: a hash of its cache key.
function cacheId(key: string): string {
  return toHex(sha256(utf8(key)))
}

// On a hit, the provider, model and prompt tokens of the answer as it was first served.
function originHeaders(inout out: Hdrs, o: CacheOrigin | undefined): void {
  if (o === undefined) return
  out.set("x-bifrost-cache-provider-used", o.provider)
  out.set("x-bifrost-cache-model-used", o.model)
  out.set("x-bifrost-cache-input-tokens", "" + o.inputTokens)
}

// x-bifrost-cache-* for a lookup that ran. id is "" when the entry has none; latencyMs is the
// time spent serving a hit (a miss has none).
function cacheHeaders(inout out: Hdrs, kind: string, primary: ModelRef, similarity: f64 | undefined, threshold: f64 | undefined, id: string, latencyMs: f64 | undefined): void {
  out.set("x-bifrost-cache-hit", "true")
  out.set("x-bifrost-cache-hit-type", kind)
  if (id !== "") out.set("x-bifrost-cache-id", id)
  if (latencyMs !== undefined) out.set("x-bifrost-cache-hit-latency-ms", "" + Math.round(latencyMs))
  out.set("x-bifrost-cache-requested-provider", primary.provider)
  out.set("x-bifrost-cache-requested-model", primary.model)
  if (similarity !== undefined) out.set("x-bifrost-cache-similarity", similarity.toFixed(4))
  if (threshold !== undefined) out.set("x-bifrost-cache-threshold", "" + threshold)
}

// The retry hint of a failed upstream call, in milliseconds, as Bifrost reads it
// (core/providers/utils/retryafter.go): retry-after-ms, else Retry-After in seconds or as an
// seconds (an HTTP date is not read: Tov has no Date parsing). Clamped to 1s..5m. undefined when
// the response gives no usable hint.
export function retryHintMs(ms: string | undefined, after: string | undefined): f64 | undefined {
  const a = (ms ?? "").trim()
  if (a !== "") {
    const v = parseFloat(a)
    if (v !== undefined && v >= 0.0) return clampRetryMs(v)
  }
  const b = (after ?? "").trim()
  if (b === "") return undefined
  const s = parseFloat(b)
  if (s !== undefined && s >= 0.0) return clampRetryMs(s * 1000.0)
  return undefined
}

function clampRetryMs(ms: f64): f64 {
  return Math.min(Math.max(Math.floor(ms), 1000), 300000)
}

test("retry hint: retry-after-ms first, then Retry-After seconds, clamped to 1s..5m", () => {
  expect(retryHintMs("1500", "30")).toBe(1500)
  expect(retryHintMs("abc", "2")).toBe(2000)
  expect(retryHintMs(undefined, "0")).toBe(1000)
  expect(retryHintMs(undefined, "3600")).toBe(300000)
  expect(retryHintMs("5", undefined)).toBe(1000)
  expect(retryHintMs(undefined, undefined)).toBe(undefined)
  expect(retryHintMs(undefined, "")).toBe(undefined)
  expect(retryHintMs(undefined, "Thu, 01 Jan 1970 00:00:10 GMT")).toBe(undefined)
})

// The error's type field, for x-bifrost-error-type.
function errorType(body: string): string {
  try {
    const e = find(fields(body), "error")
    if (e === undefined || !e.startsWith("{")) return ""
    return rawStr(fields(e), "type") ?? ""
  } catch (e) {
    return ""
  }
}

// Whether a kind's streams can be converted as they arrive, and which converter does it.
export function streamable(t: Target): bool {
  return providers.streamsNatively(t.kind) || t.kind === "anthropic" || t.kind === "gemini" || t.kind === "bedrock" || t.kind === "cohere" || t.kind === "vertex"
}

export function converterKind(t: Target): string {
  // Vertex streams Anthropic events for Claude models and Gemini chunks for the rest
  const kind = t.kind === "vertex" ? (isClaude(t.model) ? "anthropic" : "gemini") : t.kind
  return providers.streamsNatively(kind) ? "openai" : kind
}

export type ConverterFactory = (t: Target, requestedModel: string) => StreamConverter | undefined

function utf8Decoder(): TextDecoder | undefined {
  try {
    return new TextDecoder()
  } catch (e) {
    return undefined
  }
}

// OpenAI-format upstreams: events pass through with the model renamed to what
// the caller asked for; usage is read for accounting and, when the caller
// didn't ask for it, the usage-only chunk is dropped.

async function sleep(ms: int): Promise<void> {
  await new Promise<void>((resolve) => {
    setTimeout(() => resolve(), ms)
  })
}

export function errorResponse(status: int, message: string, type: string, extra: Hdrs): Response {
  let h: Record<string, string> = extra
  h.set("content-type", "application/json")
  return new Response(errorJson(message, type, undefined), { status: status, headers: h })
}

export function noHeaders(): Hdrs {
  const m: Hdrs = new Map()
  return m
}

function respond(status: int, body: string, h: Hdrs): Response {
  const r: Record<string, string> = h
  return new Response(body, { status: status, headers: r })
}

// Bifrost's send_back_raw_request / send_back_raw_response: the provider's setting, which the
// x-bf-send-back-raw-request / -response header overrides when client.allow_per_request_raw_override is on.
function sendBackRaw(h: Hdrs, cfg: Config, p: ProviderConfig, which: string): bool {
  const hv = (h.get("x-bf-send-back-raw-" + which) ?? "").trim().toLowerCase()
  if (cfg.client?.allow_per_request_raw_override === true) {
    if (hv === "true" || hv === "1" || hv === "t") return true
    if (hv === "false" || hv === "0" || hv === "f") return false
  }
  return which === "request" ? p.send_back_raw_request === true : p.send_back_raw_response === true
}

// Bifrost's store_raw_request_response: the provider's setting, which x-bf-store-raw-request-response
// overrides when client.allow_per_request_content_storage_override is on.
function storeRawOn(h: Hdrs, cfg: Config, p: ProviderConfig): bool {
  const hv = (h.get("x-bf-store-raw-request-response") ?? "").trim().toLowerCase()
  if (cfg.client?.allow_per_request_content_storage_override === true) {
    if (hv === "true" || hv === "1" || hv === "t") return true
    if (hv === "false" || hv === "0" || hv === "f") return false
  }
  return p.store_raw_request_response === true
}

// Bifrost's custom_provider_config.allowed_requests: once the map is set, only the request types marked true are served.
function allowedRequest(p: ProviderConfig, rtype: string): bool {
  const allowed = p.custom_provider_config?.allowed_requests
  if (allowed === undefined) return true
  return allowed.get(rtype) === true
}

// Whether the stream ends at finish_reason: does_not_send_done_marker without wait_for_usage.
function quirkStopsAtFinish(t: Target): bool {
  const c = t.cfg.custom_provider_config
  return c?.does_not_send_done_marker === true && c?.wait_for_usage !== true
}

// Whether an OpenAI stream chunk carries a non-null finish_reason.
function finishes(data: string): bool {
  if (!data.includes("finish_reason")) return false
  try {
    const v = JSON.parse(data) as { choices?: { finish_reason?: string }[] }
    for (const c of v.choices ?? []) {
      if ((c.finish_reason ?? "") !== "") return true
    }
    return false
  } catch (e) {
    return false
  }
}

// Bifrost's default queue (core/schemas/provider.go), for a provider with no concurrency_and_buffer_size.
const DEFAULT_CONCURRENCY: int = 1000
const DEFAULT_BUFFER: int = 5000

// One limiter per provider (Bifrost's per-provider queue). A provider that sets
// concurrency_and_buffer_size gets that queue. With client.drop_excess_requests on, a provider
// without one gets Bifrost's default queue, so a full queue sheds requests there too; with it
// off, such a provider has no queue and its requests are never held or shed.
function limitersFor(cfg: Config): Map<string, Limiter> {
  const out: Map<string, Limiter> = new Map()
  const ps = cfg.providers
  if (ps === undefined) return out
  const drop = cfg.client?.drop_excess_requests === true
  for (const name of ps.keys()) {
    const c = ps.get(name)!.concurrency_and_buffer_size
    if (c === undefined) {
      if (drop) out.set(name, new Limiter(DEFAULT_CONCURRENCY, DEFAULT_BUFFER, true))
      continue
    }
    out.set(name, new Limiter(c.concurrency < 1 ? 1 : c.concurrency, c.buffer_size < 1 ? 1 : c.buffer_size, drop))
  }
  return out
}

// The limiters of a reloaded config, keeping the old ones whose settings did not change (their slots stay counted).
function carryLimiters(next: Map<string, Limiter>, prev: Map<string, Limiter>): Map<string, Limiter> {
  const out: Map<string, Limiter> = new Map()
  for (const name of next.keys()) {
    const n = next.get(name)!
    const old = prev.get(name)
    const same = old !== undefined && old.limit === n.limit && old.buffer === n.buffer && old.drop === n.drop
    out.set(name, same ? old! : n)
  }
  return out
}

// The chat names of every provider's injected tools, which the agent loop may run on their own.
function injectedNames(cfg: Config): string[] {
  const out: string[] = []
  const ps = cfg.providers
  if (ps === undefined) return out
  for (const name of ps.keys()) {
    for (const it of ps.get(name)!.injected_tools ?? []) out.push(it.name)
  }
  return out
}

// The MCP chat name ("<server>-<tool>") behind an injected tool name, or undefined.
function injectedChatName(cfg: Config, name: string): string | undefined {
  const ps = cfg.providers
  if (ps === undefined) return undefined
  for (const pn of ps.keys()) {
    for (const it of ps.get(pn)!.injected_tools ?? []) {
      if (it.name === name) return sanitizeName(`${it.mcp_client_name}-${it.tool_name}`)
    }
  }
  return undefined
}

// The name of a chat tool definition, or undefined.
function toolFnName(json: string): string | undefined throws SyntaxError {
  const fr = find(try fields(json), "function")
  if (fr === undefined || isNull(fr)) return undefined
  return rawStr(try fields(fr), "name")
}

// An MCP tool as a chat tool definition under the injected tool's name, or undefined when the tool is not connected.
function injectedDef(all: string[], it: InjectedTool): string | undefined throws SyntaxError {
  const chat = sanitizeName(`${it.mcp_client_name}-${it.tool_name}`)
  for (const tj of all) {
    if ((try toolFnName(tj)) !== chat) continue
    let outer = try fields(tj)
    let fn = try fields(find(outer, "function") ?? "{}")
    setField(&fn, "name", quote(it.name))
    setField(&outer, "function", build(fn))
    return build(outer)
  }
  return undefined
}

// A captured body as a JSON value, the way Bifrost embeds raw bytes: the body itself when it is JSON, else a JSON string.
function rawJson(s: string): string {
  return jsonOk(s) ? s.trim() : quote(s)
}

// A raw body is a JSON object or array (the scanners in json.tov accept only those).
function jsonOk(s: string): bool {
  try {
    try fields(s)
    return true
  } catch (e) {
    try {
      try elements(s)
      return true
    } catch (e2) {
      return false
    }
  }
}

// Adds Bifrost's extra_fields { raw_request, raw_response } to a JSON object body; other bodies pass unchanged.
function withRawFields(body: string, rawReq: string | undefined, rawResp: string | undefined): string {
  if (rawReq === undefined && rawResp === undefined) return body
  const t = body.trim()
  if (!t.startsWith("{") || !t.endsWith("}")) return body
  const parts: string[] = []
  if (rawReq !== undefined) parts.push(`"raw_request":${rawJson(rawReq)}`)
  if (rawResp !== undefined) parts.push(`"raw_response":${rawJson(rawResp)}`)
  const inner = t.slice(0, t.byteLength - 1).trim()
  const sep = inner === "{" ? "" : ","
  return `${inner}${sep}"extra_fields":{${parts.join(",")}}}`
}

// The caller's own key (x-bf-direct-key) as the target of the primary provider: no pool, no health, no rotation.
function directTarget(cfg: Config, ref: ModelRef, key: string): { t: Target, keyIndex: int } {
  const p: ProviderConfig = providerOf(cfg, ref.provider) ?? {}
  const k: KeyConfig = { id: "header-provided", name: "header-provided", value: key, weight: 1.0 }
  return { t: { provider: ref.provider, kind: kindOf(ref.provider, p), model: ref.model, key: k, cfg: p }, keyIndex: -1 }
}

function fallbackRefs(cfg: Config, body: Field[]): ModelRef[] {
  const out: ModelRef[] = []
  const raw = find(body, "fallbacks")
  if (raw === undefined || isNull(raw)) return out
  try {
    for (const el of elements(raw)) {
      if (el.startsWith("\"")) out.push(parseModel(cfg, JSON.parse(el) as string))
      else if (el.startsWith("{")) {
        // { "provider": "anthropic", "model": "claude-..." }
        const f = fields(el)
        const p = rawStr(f, "provider")
        const m = rawStr(f, "model")
        if (p !== undefined && m !== undefined) out.push({ provider: p, model: m })
      }
    }
  } catch (e) {
    // malformed fallbacks are ignored, as an absent list would be
  }
  return out
}

// What one request did, gathered as it runs and recorded once at the end
// (request log, log store, trace span).
class ReqCtx {
  provider = ""
  model = ""
  status = 0
  promptTokens = 0
  completionTokens = 0
  cost = 0.0
  cached = false
  error = ""
  virtualKey = ""
  // the team, customer, business unit and project the request is attributed to ("" when none)
  teamId = ""
  customerId = ""
  businessUnitId = ""
  projectId = ""
  // the user the key is assigned to, the caller's session and its User-Agent, for the request log
  userId = ""
  sessionId = ""
  userAgent = ""
  input = ""
  output = ""
  span: Span | undefined = undefined
  // the request's overhead and the stages it timed, for the otel plugin's spans
  overheadUs: f64 | undefined = undefined
  stages: StageTiming[] = []
  // the model as the caller named it
  requested = ""
  // headers plugins asked to send upstream
  upstreamHeaders: Map<string, string> = new Map()
  // set when the answer streams straight to the client
  sink: StreamSink | undefined = undefined
  makeConverter: ConverterFactory | undefined = undefined
  outHeaders: Map<string, string> = new Map()
  // request and response bodies stay out of the logs (content logging is off for this request)
  contentOff = false
  // the raw upstream request and response, kept for the log store (store_raw_request_response)
  rawRequest = ""
  rawResponse = ""
  // Bifrost's metric labels for this request, filled once it is routed and admitted
  labels: metrics.RequestLabels = metrics.newLabels("", "", "")
  // the log row's extra columns, read from the request's headers (reqlog.tov)
  meta: Record<string, string> | undefined = undefined
  parentId = ""
  agentId = ""
  // the local cache hit ("direct" or "semantic") and the stop reason of the answer, for the request log
  cacheType = ""
  stopReason = ""
  // the tools the answer called, the heuristic complexity score and the prompt the request named
  toolNames: string[] = []
  complexityScore: f64 | undefined = undefined
  promptId = ""
  promptName = ""
  promptVersion: int | undefined = undefined
  app = ""
  maximIds: Record<string, string> | undefined = undefined
  maximTags: Record<string, string> | undefined = undefined
  // the compat plan of a chat or completions request: its drops and conversions go out with the stream headers
  compat: CompatPlan | undefined = undefined
  constructor(readonly rid: string, readonly op: string, readonly started: f64) {}
}

// One request's plugin context, shared by its pre and post hooks.
class PluginRun {
  constructor(public ctx: PluginContext) {}
}

class LazyChat {
  value: ChatRequest | undefined = undefined
  constructor(readonly text: string) {}
  get(): ChatRequest throws SyntaxError {
    const v = this.value
    if (v !== undefined) return v
    const parsed = try JSON.parse(this.text) as ChatRequest
    this.value = parsed
    return parsed
  }
}

// A converted Responses request's body, streamed when its answer is piped to the client.
function streamedBody(fs: Field[], on: bool): Field[] {
  if (!on) return fs
  let out = fs.slice()
  setField(&out, "stream", "true")
  return out
}

// Whether a request asks for the usage chunk (stream_options.include_usage).
function streamUsage(body: Field[]): bool {
  const so = find(body, "stream_options")
  if (so === undefined || !so.startsWith("{")) return false
  try {
    return rawBool(fields(so), "include_usage") ?? false
  } catch (e) {
    return false
  }
}

// A text completion sent to a chat model: the chat request, streamed when the answer is piped.
function textAsChat(t: Target, sh: Shaped, stream: bool, canPipe: bool): Upstream throws SyntaxError {
  const req = try new LazyChat(sh.text).get()
  if (!stream) return try providers.chatUpstream(t, req, sh.body, false)
  if (providers.streamsNatively(t.kind)) {
    let sb = sh.body.slice()
    setField(&sb, "stream", "true")
    setField(&sb, "stream_options", `{"include_usage":true}`)
    return openai.chatRequest(t, sb)
  }
  if (canPipe) {
    const su = try providers.streamUpstream(t, req, sh.body, false)
    if (su !== undefined) return su
  }
  return try providers.chatUpstream(t, req, sh.body, false)
}

// Replicate's text completion: the prompt as the one user message of its chat prediction (Bifrost sends the
// prompt as the prediction's input, and the answer comes back as a text completion).
function replicateText(t: Target, body: Field[]): Upstream throws SyntaxError {
  const cf = try textToChatFields(body)
  return try providers.chatUpstream(t, try new LazyChat(build(cf)).get(), cf, false)
}

// The in-process rules of the regex and secrets providers, by provider id. A bad pattern is logged and its provider is skipped.
function compileLocalRules(providers: GuardrailProvider[]): Map<string, CompiledRule[]> {
  const out: Map<string, CompiledRule[]> = new Map()
  for (const p of providers) {
    if (p.kind !== "regex" && p.kind !== "secrets") continue
    try {
      out.set(p.id, try compileLocal(p))
    } catch (e) {
      console.error(`raiju: guardrail ${p.id}: ${e.message}`)
    }
  }
  return out
}

// The guards that check MCP tool calls. A bad pattern is logged and the tool guards are left off.
function compileGuards(providers: GuardrailProvider[]): ToolGuard[] {
  try {
    return try compileToolGuards(providers)
  } catch (e) {
    console.error(`raiju: MCP tool guardrails: ${e.message}`)
    return []
  }
}

// The outcome of userAuth: kind is "none" (not a per-user tool), "bearer" (call with token) or "denial" (answer
// with message and status, the consent link the caller must open).
type UserAuth = { kind: string, token: string, status: int, type: string, message: string }

function userAuthOf(kind: string, token: string, status: int, type: string, message: string): UserAuth {
  return { kind: kind, token: token, status: status, type: type, message: message }
}

// The registration (auth) of an MCP client by name, or undefined.
function authOfClient(cfg: Config, name: string): McpAuthConfig | undefined {
  for (const c of cfg.mcp?.client_configs ?? []) {
    if (c.name === name) return c.auth
  }
  return undefined
}

// The gateway's origin as the caller reached it, for the consent links: the Host header and the forwarded
// protocol. "" when the request names no host (the links are then relative).
function originOf(h: Hdrs): string {
  const host = h.get("host") ?? ""
  if (host === "") return ""
  return (h.get("x-forwarded-proto") ?? "http") + "://" + host
}

export class Engine {
  gov: Governance
  // the model parameters row for a model (the datasheet, as GET /api/models/parameters serves it), for compat
  paramsLookup: ((model: string) => Promise<string | undefined>) | undefined = undefined
  health: Health
  vertexTokens = new TokenCache()
  entraTokens: cloudAuth.TokenCache<string> = cloudAuth.stringCache()
  // Databricks OAuth M2M tokens, and GitHub Copilot tokens ("<host>\n<token>")
  databricksTokens: cloudAuth.TokenCache<string> = cloudAuth.stringCache()
  copilotTokens: cloudAuth.TokenCache<string> = cloudAuth.stringCache()
  stsCreds: cloudAuth.TokenCache<cloudAuth.AssumedCreds> = cloudAuth.credsCache()
  iamTokens: Map<string, { token: string, expiresAtSec: int }> = new Map()
  guard: GuardConfig | undefined = undefined
  rules: RuleSet | undefined = undefined
  logStore: LogStore | undefined = undefined
  tracer: Tracer | undefined = undefined
  mcp: McpManager | undefined = undefined
  jobs: JobStore
  plugins: PluginChain | undefined = undefined
  // jsonparser with usage all_requests: the JSON of each stream is completed (plugins.tov JsonStreamFixer)
  jsonStreamOn = false
  semantic: SemanticCache | undefined = undefined
  semanticCfg: SemanticCacheConfig = defaultSemanticConfig()
  // an external vector store for the semantic cache (Bifrost's vector_store), shared by all workers
  vstore: VectorStore | undefined = undefined
  vsNs = "BifrostSemanticCachePlugin"
  vsReady = false
  guardInput = false
  guardOutput = false
  pricing: Pricing
  // the latest synced datasheet, when one was fetched
  catalogRows: Map<string, PriceRow> | undefined = undefined
  private unpriced: Set<string> = new Set()
  // keeps a token row the gateway obtained (a refresh); the server saves it to the config file
  userTokenSaved: ((r: McpUserToken) => void) | undefined = undefined
  cache: ResponseCache | undefined = undefined
  cacheTtlMs = 300000
  autoPromptCache = false
  logRequests = true
  affinity: AffinityStore | undefined = undefined
  complexity: ComplexitySettings | undefined = undefined
  agent: AgentConfig | undefined = undefined
  // set by the alerting loop when alerts are on
  samples: SampleRing | undefined = undefined
  // budget and rate-limit windows shared with other processes (cluster nodes, sibling workers)
  sharedWindows = false
  // set by the exporters loop: every logged request is queued for each exporter
  exportQueues: ExportQueue[] = []
  guardProviders: GuardrailProvider[] = []
  // compiled regex and secrets providers, by id, and the guards on MCP tool calls
  localRules: Map<string, CompiledRule[]> = new Map()
  toolGuards: ToolGuard[] = []
  // per-provider concurrency and queue (concurrency_and_buffer_size)
  limiters: Map<string, Limiter> = new Map()

  constructor(public cfg: Config) {
    this.gov = new Governance(cfg)
    if (cfg.cluster?.enabled === true) this.gov.alignWindows()
    const specs = cfg.plugins ?? []
    if (specs.length > 0) {
      const entries: PluginEntry[] = specs.map((p) => ({ name: p.name, enabled: p.enabled, configJson: p.config_json ?? "{}", placement: p.placement, order: p.order }))
      const built = buildChain(entries)
      for (const e of built.errors) console.error(`raiju: plugin: ${e}`)
      this.plugins = built.chain
      this.jsonStreamOn = jsonStreamEnabled(entries)
    }
    const sc = cfg.semantic_cache
    if (sc !== undefined && sc.enabled !== false && sc.embedding_model !== "") {
      const d = defaultSemanticConfig()
      this.semanticCfg = {
        threshold: sc.threshold ?? d.threshold,
        ttl_ms: (sc.ttl ?? 300) * 1000,
        max_entries: sc.max_entries ?? d.max_entries,
        conversation_history_threshold: sc.conversation_history_threshold ?? d.conversation_history_threshold,
        exclude_system_prompt: sc.exclude_system_prompt ?? d.exclude_system_prompt,
        cache_by_model: sc.cache_by_model ?? d.cache_by_model,
        cache_by_provider: sc.cache_by_provider ?? d.cache_by_provider,
        cache_tool_call_responses: sc.cache_tool_call_responses ?? d.cache_tool_call_responses,
        disable_identity_scoping: sc.disable_identity_scoping ?? d.disable_identity_scoping,
      }
      this.semantic = new SemanticCache(this.semanticCfg)
      this.vsNs = sc.vector_store_namespace ?? "BifrostSemanticCachePlugin"
      try {
        this.vstore = openVectorStore(cfg.vector_store)
      } catch (e) {
        console.error(`raiju: vector_store: ${e.message}; using the in-process semantic cache`)
      }
    }
    this.jobs = new JobStore((cfg.client?.async_job_result_ttl ?? 3600) * 1000, 10000)
    const hc = cfg.health
    const d = defaultBreakerConfig()
    const bc: BreakerConfig = hc === undefined ? d : {
      failureThreshold: hc.failure_threshold ?? d.failureThreshold,
      failureRateThreshold: hc.failure_rate_threshold ?? d.failureRateThreshold,
      minRequests: hc.min_requests ?? d.minRequests,
      windowMs: (hc.window_seconds ?? 60) * 1000,
      openMs: (hc.open_seconds ?? 30) * 1000,
      halfOpenProbes: d.halfOpenProbes,
    }
    this.health = new Health(bc)
    // the circuit policies of the config (Bifrost's circuit_breaker_config.policies, kept as circuit_breaker_policies)
    for (const pc of cfg.circuit_breaker_policies ?? []) {
      const pr = parsePolicy(JSON.stringify(pc), "")
      if (!pr.ok) console.error(`raiju: circuit_breaker_policies ${pc.name}: ${pr.err}`)
      else this.health.policyAdd(pr.p)
    }
    const ls = cfg.logs_store
    if (ls !== undefined && ls.enabled === true) {
      const d = defaultLogStoreConfig(ls.dir ?? "logs")
      try {
        const store = new LogStore({ dir: d.dir, retention_days: ls.retention_days ?? d.retention_days, max_memory_entries: ls.max_memory_entries ?? d.max_memory_entries, content_logging: ls.content_logging ?? d.content_logging, max_content_bytes: d.max_content_bytes })
        store.prune(Date.now())
        this.logStore = store
      } catch (e) {
        console.error(`raiju: request log store disabled: ${e.message}`)
      }
    }
    const mc = cfg.mcp
    if (mc !== undefined && (mc.client_configs ?? []).length > 0) this.mcp = new McpManager(mc)
    const oc = cfg.otel
    if (oc !== undefined && tracesOn(oc)) this.tracer = new Tracer(oc)
    const rr = cfg.governance?.routing_rules
    if (rr !== undefined && rr.length > 0) {
      const rs = new RuleSet(rr)
      for (const e of rs.errors()) console.error(`raiju: routing rule: ${e}`)
      this.rules = rs
    }
    const g = cfg.guardrails
    if (g !== undefined && g.enabled !== false) {
      const mode = g.mode === "block" ? "block" : g.mode === "log" ? "log" : "redact"
      this.guard = { detect: g.detect ?? ["email", "phone", "ssn", "credit_card", "api_key", "aws_key", "jwt", "private_key"], mode: mode, custom: g.custom }
      const where = g.apply_to ?? "input"
      this.guardInput = where === "input" || where === "both"
      this.guardOutput = where === "output" || where === "both"
    }
    this.pricing = new Pricing(cfg)
    const po = cfg.governance?.pricing_overrides ?? []
    if (po.length > 0) {
      try {
        const skipped = this.pricing.setOverrides(po.map((o) => ({ scope_kind: o.scope_kind, provider_id: o.provider_id, match_type: o.match_type, pattern: o.pattern, pricing_patch: o.pricing_patch })))
        if (skipped > 0) console.error(`raiju: ${skipped} pricing overrides use a scope Raiju doesn't apply (only global and provider)`)
      } catch (e) {
        console.error(`raiju: pricing_overrides: ${e.message}`)
      }
    }
    const c = cfg.cache
    if (c !== undefined && c.enabled === true) {
      this.cacheTtlMs = (c.ttl_seconds ?? 300) * 1000
      this.cache = new ResponseCache(this.cacheTtlMs, c.max_entries ?? 10000)
    }
    this.autoPromptCache = cfg.prompt_cache?.auto_inject ?? false
    this.logRequests = cfg.client?.enable_logging ?? true
    metrics.setCustomLabels(cfg.client?.prometheus_labels ?? [])
    metrics.setTelemetry(cfg.telemetry?.overhead_breakdown_enabled === true, cfg.telemetry?.user_labels_enabled === true)
    this.limiters = limitersFor(cfg)
    if (injectedNames(cfg).length > 0 && (cfg.mcp?.client_configs ?? []).length === 0) console.error("raiju: injected_tools need MCP clients, and none are configured")
    this.guardProviders = cfg.guardrails?.providers ?? []
    this.localRules = compileLocalRules(this.guardProviders)
    this.toolGuards = compileGuards(this.guardProviders)
    const sa = cfg.session_affinity
    if (sa !== undefined && sa.enabled === true) {
      this.affinity = new AffinityStore({ enabled: true, ttl_ms: (sa.ttl_seconds ?? 3600) * 1000, max_sessions: sa.max_sessions ?? 100000 })
    }
    const cx = cfg.complexity_router
    if (cx !== undefined && cx.enabled !== false) this.complexity = cx
    // injected tools run in the agent loop, so they are auto-executed like mcp_auto_execute names
    const auto = (cfg.client?.mcp_auto_execute ?? []).concat(autoExecutePatterns(cfg.mcp?.client_configs ?? [])).concat(injectedNames(cfg))
    if (auto.length > 0) this.agent = { max_depth: cfg.client?.mcp_agent_depth ?? 10, auto_execute: auto, parallel: true }
  }

  // Asks every external guardrail that covers `source` about `text`; stops at the first block.
  // Judges go through the chat path, regex and secrets run in-process, and HTTP providers make one request.
  async externalGuard(text: string, source: "input" | "output"): Promise<{ action: string, reason: string, text?: string }> {
    let out: { action: string, reason: string, text?: string } = { action: "allow", reason: "" }
    for (const p of this.guardProviders) {
      if (!appliesTo(p, source)) continue
      if (!(p.targets ?? ["llm"]).includes("llm")) continue
      let v: Verdict = { action: "allow", reason: "" }
      if (p.kind === "prompt_judge") {
        v = await judgeText(p, text, source, (prov: string, b: string): Promise<string, Error> => this.judgeChat(prov, b))
      } else if (isLocal(p)) {
        const rules: CompiledRule[] = this.localRules.get(p.id) ?? []
        v = localVerdict(rules, text)
      } else {
        v = await this.httpVerdict(p, text, source)
      }
      metrics.inc("raiju_guardrail_checks_total", metrics.labels("", p.id, v.action), 1.0)
      if (v.action === "block") return { action: "block", reason: `${p.id}: ${v.reason}` }
      const red = v.text
      if (v.action === "redact" && red !== undefined) {
        text = red
        out = { action: "redact", reason: `${p.id}: ${v.reason}`, text: red }
      }
    }
    return out
  }

  // The local output guards (regex and secrets providers that cover the LLM output) that check a streamed answer.
  streamGuards(guardOn: bool): GuardedProvider[] {
    const out: GuardedProvider[] = []
    if (!guardOn) return out
    for (const p of this.guardProviders) {
      if (!appliesTo(p, "output") || !(p.targets ?? ["llm"]).includes("llm")) continue
      if (p.kind === "regex" || p.kind === "secrets") out.push({ id: p.id, rules: this.localRules.get(p.id) ?? [] })
    }
    return out
  }

  // A streamed answer that is built whole (not sent as it arrives) goes through the same guards, so what is
  // cached and logged is the redacted text. A block throws, as a blocked answer does.
  guardWhole(body: string, format: StreamFormat, guardOn: bool): string throws SyntaxError {
    const gs = this.streamGuards(guardOn)
    if (gs.length === 0) return body
    const g = new OutputStreamGuard(gs, format)
    const out = g.finish(body)
    for (const k of g.kinds) metrics.inc("raiju_guardrail_findings_total", metrics.labels("", k, "redact"), 1.0)
    if (g.stopped) {
      metrics.inc("raiju_guardrail_checks_total", metrics.labels("", g.blockedBy, "block"), 1.0)
      throw new SyntaxError("the response was blocked by guardrails")
    }
    return out
  }

  // One call to an HTTP guardrail; its verdict is read from the answer (a failed call follows the provider's on_error).
  async httpVerdict(p: GuardrailProvider, text: string, source: "input" | "output"): Promise<Verdict> {
    let status = 0
    let body = ""
    try {
      const r = checkRequest(p, text, source, Date.now())
      const hs: Record<string, string> = r.headers
      const dl = deadline(10000)
      try {
        const res = await fetch(r.url, { method: r.method, headers: hs, body: r.body, signal: dl.controller.signal })
        status = res.status
        body = await res.text()
      } catch (e) {
        status = 0
      }
      dl.finish()
    } catch (e) {
      status = 0
    }
    return parseVerdictFor(p, text, status, body)
  }

  // Sends a judge's chat body through the chat path with guardrails off for that call, so a judge is not judged.
  async judgeChat(provider: string, body: string): Promise<string, Error> {
    let f = try fields(body)
    const model = rawStr(f, "model") ?? ""
    if (provider !== "" && !model.includes("/")) setField(&f, "model", quote(`${provider}/${model}`))
    const hs: Record<string, string> = new Map()
    hs.set("content-type", "application/json")
    const req = new Request("http://127.0.0.1/v1/chat/completions", { method: "POST", headers: hs, body: build(f) })
    const r = try await this.chatOnce(req, undefined, true)
    if (r.status !== 200) throw new Error(`judge model returned ${r.status}`)
    return try await r.text()
  }

  // Remembers the key that served a session, so its next requests go to the same key.
  stick(h: Hdrs, ref: ModelRef, t: Target): void {
    const aff = this.affinity
    if (aff === undefined || affinityMode(h) === "off") return
    const sid = sessionId(h)
    const kid = t.key.id ?? t.key.name
    if (sid === undefined || kid === undefined) return
    aff.bind(sid, ref.provider, ref.model, kid, sessionTtl(h, aff.cfg), Date.now())
  }

  // The heuristic's tier and score; the score is undefined when the text cannot be scored.
  heuristicTier(text: string, cx: ComplexitySettings): { tier: Tier, mechanism: string, score: f64 | undefined } {
    try {
      const c = cplx.classify(text, { simple_max_score: cx.simple_max_score ?? 3.0, complex_min_score: cx.complex_min_score ?? 8.0 })
      return { tier: c.tier, mechanism: "heuristic", score: c.score }
    } catch (e) {
      return { tier: "MEDIUM", mechanism: "heuristic", score: undefined }
    }
  }

  // The complexity tier of a chat request: the configured classifier's, or the heuristic's when the
  // classifier names none (no decision model, no embedding, a timeout, or an unparseable answer).
  async tierFor(req: Request, text: string, cx: ComplexitySettings): Promise<{ tier: Tier, mechanism: string, score: f64 | undefined }> {
    const mode = cplx.classifierMode(cx.classifier)
    if (mode === "heuristic") return this.heuristicTier(text, cx)
    let t: Tier | undefined = undefined
    if (mode === "decision") t = await cplx.decisionTier(text, cx.decision, async (b: string, ph: string) => await this.classifierCall(req, "/v1/decisions", b, ph))
    else if (mode === "llm") t = await cplx.llmTier(text, cx.llm, async (b: string, ph: string) => await this.classifierCall(req, "/v1/chat/completions", b, ph))
    else t = await cplx.semanticTier(text, cx.semantic, async (b: string, ph: string) => await this.classifierCall(req, "/v1/embeddings", b, ph))
    if (t !== undefined) return { tier: t, mechanism: mode, score: undefined }
    return this.heuristicTier(text, cx)
  }

  // A classifier's own call, answered by the route it names with the caller's headers. The chat
  // call is marked with a forced tier, so it is not classified in turn. undefined when it fails.
  async classifierCall(req: Request, route: string, body: string, phase: string): Promise<string | undefined> {
    try {
      const hs: Record<string, string> = snapshot(req.headers)
      hs.set("x-bf-complexity-tier", "MEDIUM")
      const inner = new Request("http://raiju.internal" + route, { method: "POST", headers: hs, body: body })
      let res: Response = new Response(undefined, { status: 500 })
      if (route === "/v1/decisions") {
        const d = try parseDecision(body)
        const build: Build = (t) => try typesafe.systemoneUpstream(t, d)
        const tr: Translate = (t, out, requested) => try typesafe.translateDecision(out, d, requested)
        res = try await this.serve(inner, "decisions", undefined, try fields(body), body, build, tr, false)
      } else if (route === "/v1/embeddings") {
        res = try await this.embeddings(inner)
      } else {
        res = try await this.chat(inner)
      }
      const out = try await res.text()
      if (res.status !== 200) return undefined
      if (route !== "/v1/decisions") this.recordClassifier(route, body, out, phase)
      return out
    } catch (e) {
      return undefined
    }
  }

  // bifrost_routing_embedding_* and bifrost_routing_llm_*: the classifier's own call and its cost.
  recordClassifier(route: string, body: string, out: string, phase: string): void {
    try {
      const sent = try JSON.parse(body) as { model?: string }
      const at = splitModel(sent.model ?? "")
      const u = try JSON.parse(out) as { usage?: { prompt_tokens?: int, completion_tokens?: int } }
      const cost = this.pricing.cost(at.provider, at.model, u.usage?.prompt_tokens ?? 0, u.usage?.completion_tokens ?? 0)
      if (route === "/v1/embeddings") metrics.observeRoutingEmbedding(at.provider, at.model, phase, cost)
      else metrics.observeRoutingLLM(at.provider, at.model, cost)
    } catch (e) {
      return
    }
  }

  // Tries each model in order; within one, retries transient failures with
  // backoff and moves to another key on credential errors.
  async attempt(refs: ModelRef[], h: Hdrs, build: Build, translate: Translate, streamed: bool, ctx: ReqCtx): Promise<Outcome> {
    const pinned = h.get("x-bf-api-key") ?? h.get("x-bf-api-key-id") ?? undefined
    const direct = directKeyFrom(h, this.cfg.client?.allow_direct_keys === true)
    // x-bf-eh-* headers and allowlisted headers go upstream, as client.header_filter_config allows (headerfilter.tov)
    const extra = forwardedHeaders(h, headerFilterOf(this.cfg.client?.header_filter_config))
    let last: Outcome = { ok: false, status: 404, body: errorJson("no provider is configured for this model", "invalid_request_error", "model_not_found"), contentType: "application/json", provider: "", model: "", promptTokens: 0, completionTokens: 0, attempts: 0, upstreamMs: 0.0 }
    let attempts = 0
    let upstreamMs = 0.0
    let refIndex = -1
    for (const ref of refs) {
      refIndex += 1
      const tried: Set<int> = new Set()
      const p: ProviderConfig = providerOf(this.cfg, ref.provider) ?? {}
      // Bifrost's allowed_requests: a request type the provider does not allow is not sent; the next fallback may take it
      const rtype = requestType(ctx.op, streamed)
      if (!allowedRequest(p, rtype)) {
        last = { ok: false, status: 400, body: errorJson(`${rtype} is not supported by ${ref.provider} provider`, "invalid_request_error", "unsupported_operation"), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
        continue
      }
      const retries = maxRetries(p)
      let retry = 0
      // session affinity: the key that served this session before, tried first
      let soft: string | undefined = undefined
      const aff = this.affinity
      if (aff !== undefined && pinned === undefined) soft = resolveSticky(aff, h, ref.provider, ref.model, Date.now())?.keyId
      while (true) {
        // the caller's own key serves the primary provider only: a fallback never gets it
        const sel = refIndex === 0 && direct !== undefined ? directTarget(this.cfg, ref, direct) : target(this.cfg, ref, tried, pinned ?? soft, this.health)
        if (sel === undefined && soft !== undefined) {
          soft = undefined
          continue
        }
        if (sel === undefined) break
        let t = sel.t
        let tl = ctx.labels
        tl.provider = ref.provider
        tl.model = ref.model
        tl.fallbackIndex = "" + Math.max(0, refIndex)
        tl.selectedKeyId = t.key.id ?? ""
        tl.selectedKeyName = t.key.name ?? ""
        // labels are values: the copy with the key goes back to the request, for the metrics and the request log
        ctx.labels = tl
        if (t.kind === "watsonx") {
          const tok = await this.watsonxToken(t)
          if (tok.error !== "") {
            last = { ok: false, status: 502, body: errorJson(tok.error, "authentication_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
            break
          }
          t.key.value = tok.token
        }
        const dk = t.key.databricks_key_config
        if (t.kind === "databricks" && (t.key.value ?? "") === "" && dk !== undefined && dk.client_id !== undefined) {
          const tok = await this.databricksToken(t)
          if (tok.error !== "") {
            last = { ok: false, status: 502, body: errorJson(tok.error, "authentication_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
            break
          }
          t.key.value = tok.token
        }
        if (t.kind === "github-copilot" && (t.key.value ?? "") === "" && t.key.github_copilot_key_config !== undefined) {
          const tok = await this.copilotToken(t)
          if (tok.error !== "") {
            last = { ok: false, status: 502, body: errorJson(tok.error, "authentication_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
            break
          }
          t.key.value = tok.token
          let nc = t.cfg.network_config ?? {}
          nc.base_url = tok.host
          let pc = t.cfg
          pc.network_config = nc
          t.cfg = pc
        }
        if (t.kind === "azure" && t.key.azure_key_config?.tenant_id !== undefined) {
          const tok = await this.entraToken(t)
          if (tok.error !== "") {
            last = { ok: false, status: 502, body: errorJson(tok.error, "authentication_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
            break
          }
          t.key.value = tok.token
        }
        const bk = t.key.bedrock_key_config
        if ((t.kind === "bedrock" || t.kind === "bedrock_mantle") && bk !== undefined && bk.role_arn !== undefined) {
          const ar = await this.assumeRole(bk)
          if (ar.error !== "") {
            last = { ok: false, status: 502, body: errorJson(ar.error, "authentication_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
            break
          }
          let nb = bk
          nb.access_key = ar.creds!.accessKey
          nb.secret_key = ar.creds!.secretKey
          nb.session_token = ar.creds!.sessionToken
          nb.role_arn = undefined
          t.key.bedrock_key_config = nb
        }
        if (t.kind === "vertex") {
          const tok = await this.vertexToken(t)
          if (tok.error !== "") {
            last = { ok: false, status: 502, body: errorJson(tok.error, "authentication_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
            break
          }
          t.key.value = tok.token
        }
        let up: Upstream = { url: "", headers: new Map(), body: "" }
        try {
          up = build(t)
        } catch (e) {
          return { ok: false, status: 400, body: errorJson(e.message, "invalid_request_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
        }
        for (const k of extra.keys()) up.headers.set(k, extra.get(k)!)
        for (const k of ctx.upstreamHeaders.keys()) up.headers.set(k, ctx.upstreamHeaders.get(k)!)
        attempts += 1
        const tracer = this.tracer
        const parent = ctx.span
        let child: Span | undefined = undefined
        if (tracer !== undefined && parent !== undefined) {
          const cs = tracer.startChild(parent, `${ref.provider} ${ref.model}`, Date.now())
          cs.setStr("gen_ai.system", ref.provider)
          cs.setStr("server.address", up.url)
          if (cs.sampled) up.headers.set("traceparent", traceparentFor(cs.traceId, cs.spanId, true))
          child = cs
        }
        // Bifrost's per-provider queue: a dropped request is answered with a 503 and no upstream call
        const lim = this.limiters.get(ref.provider)
        let slot = false
        if (lim !== undefined) {
          const got = try await lim.acquire()
          if (!got) return { ok: false, status: 503, body: errorJson("request dropped: queue is full", "request_dropped", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
          slot = true
        }
        const storeRaw = !ctx.contentOff && storeRawOn(h, this.cfg, p)
        if (storeRaw) ctx.rawRequest = up.body
        const started = performance.now()
        let status = 0
        let text = ""
        let retryAfter: string | undefined = undefined
        let hintMs: f64 | undefined = undefined
        let live: Deadline | undefined = undefined
        try {
          const hs: Record<string, string> = up.headers
          const dl = deadline(timeoutMs(p))
          live = dl
          const signal = dl.controller.signal
          const px = proxyOf(p)
          const res = up.body === "" ? await fetch(up.url, { method: "GET", headers: hs, signal: signal, proxy: px, tls: tlsOf(t.cfg) }) : await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: signal, proxy: px, tls: tlsOf(t.cfg) })
          status = res.status
          // circuit policies: this response's headers may open the circuit of a policy for this primary
          if (this.health.policyList().length > 0) {
            const rh: Map<string, string> = new Map()
            res.headers.forEach((v, k) => {
              rh.set(k, v)
            })
            this.health.policyObserve(ref.provider, ref.model, t.key.id ?? "", rh, Date.now())
          }
          const sink = ctx.sink
          const mk = ctx.makeConverter
          const conv = status >= 200 && status < 300 && sink !== undefined && mk !== undefined ? mk(t, ref.provider + "/" + ref.model) : undefined
          const stream = res.body
          if (conv !== undefined && sink !== undefined && stream !== undefined) {
            // Past this point the client has bytes, so there's no retry or fallback.
            ctx.outHeaders.set("content-type", conv.framed() ? "application/vnd.amazon.eventstream" : "text/event-stream")
            ctx.outHeaders.set("cache-control", "no-cache")
            ctx.outHeaders.set("x-bf-attempts", "" + attempts)
            routedHeaders(&ctx.outHeaders, refs[0]!, ref.provider, ref.model, refIndex, ctx.requested, upstreamMs, t.key.name ?? t.key.id ?? "", aliasTo(t.key, ref.model, this.cfg.client?.routing_chain_max_depth), aliasNameOf(t.key, ref.model), aliasFamilyOf(t.key, ref.model))
            // the compat drops and conversions of this target are decided by now (build shaped it): they go out with the stream's headers
            compatHeaders(&ctx.outHeaders, ctx.compat)
            sink.started = true
            sink.open(200, ctx.outHeaders)
            const reader = stream.getReader()
            // a cancel while the upstream is silent aborts the pending read, not just the next one
            sink.abort = () => {
              dl.controller.abort()
            }
            try {
              let chunkIndex = 0
              let lastAt = started
              while (true) {
                if (sink.cancelled || conv.halted) {
                  await reader.cancel()
                  break
                }
                const c = await reader.read()
                if (c.done) break
                const v = c.value
                if (v !== undefined) {
                  const out = conv.guarded(conv.push(v), false)
                  if (out !== "") {
                    const at = performance.now()
                    metrics.observeStreamChunk(tl, chunkIndex, (at - lastAt) / 1000.0)
                    chunkIndex += 1
                    lastAt = at
                    sink.write(out)
                  }
                  const fb = conv.takeFrames()
                  const wb = sink.writeBytes
                  if (wb !== undefined && fb.length > 0) wb(fb)
                }
              }
            } catch (e) {
              // a binary stream just ends: a text error would corrupt its frames
              // (a client that cancelled is owed no error event)
              if (!conv.framed() && !sink.cancelled) sink.write(`data: ${errorJson(`the upstream stream failed: ${e.message}`, "api_error", undefined)}\n\ndata: [DONE]\n\n`)
            }
            const tail = conv.guarded(conv.end(), true)
            if (tail !== "") sink.write(tail)
            const fe = conv.takeFrames()
            const we = sink.writeBytes
            if (we !== undefined && fe.length > 0) we(fe)
            sink.close()
            dl.finish()
            upstreamMs += performance.now() - started
            metrics.observeRequest(tl, { ok: true, status: 200, errorType: "", retries: retry * 1.0 }, (performance.now() - started) / 1000.0)
            if (sel.keyIndex >= 0) this.stick(h, ref, t)
            return { ok: true, status: 200, body: "", contentType: "text/event-stream", provider: ref.provider, model: ref.model, promptTokens: conv.promptTokens(), completionTokens: conv.completionTokens(), attempts: attempts, upstreamMs: upstreamMs, direct: true, billed: t.cfg.ignore_provider_cost === true ? undefined : conv.billedCost() }
          }
          text = await res.text()
          // a streamed upstream body is not kept when local output guards apply: a match can be split across its events,
          // so the guards cannot redact it (the answer the client got is in the log's output, redacted)
          if (storeRaw) ctx.rawResponse = streamed && this.streamGuards(true).length > 0 ? "" : text
          // client.dump_errors_in_console_logs: the full upstream error goes to the server console
          if (status >= 400 && this.cfg.client?.dump_errors_in_console_logs === true) console.error(`raiju: upstream error from ${ref.provider} (${status}) for ${ref.model}: ${text}`)
          // follow-up calls of a multi-call request (one embedding input per call)
          const more = up.extra
          if (more !== undefined && status >= 200 && status < 300) {
            for (const x of more) {
              const xh: Record<string, string> = x.headers
              const xr = await fetch(x.url, { method: "POST", headers: xh, body: x.body, signal: signal, proxy: px, tls: tlsOf(t.cfg) })
              const xt = await xr.text()
              if (xr.status < 200 || xr.status >= 300) {
                status = xr.status
                text = xt
                break
              }
              text = text + RS + xt
            }
          }
          dl.finish()
          retryAfter = res.headers.get("retry-after") ?? undefined
          hintMs = retryHintMs(res.headers.get("retry-after-ms") ?? undefined, retryAfter)
        } catch (e) {
          live?.finish()
          status = 0
          text = errorJson(`${ref.provider} request failed: ${e.message}`, "api_connection_error", undefined)
        } finally {
          if (slot && lim !== undefined) lim.release()
        }
        const tookMs = performance.now() - started
        upstreamMs += tookMs
        if (tracer !== undefined && child !== undefined) {
          child.setInt("http.response.status_code", status)
          if (status < 200 || status >= 300) child.fail(`HTTP ${status}`)
          child.end(Date.now())
          tracer.finish(child)
        }
        const secs = tookMs / 1000.0
        const ok = status >= 200 && status < 300
        // Health counts what the provider got wrong: network errors, timeouts, 429 and 5xx.
        // A 4xx other than 429 is the caller's fault and says the provider is up.
        if (sel.keyIndex >= 0) {
          const healthy = ok || (status >= 400 && status < 500 && status !== 429 && status !== 408)
          const hid = healthId(ref.provider, t.key, sel.keyIndex)
          const now = Date.now()
          // a provider's refusal that holds the key (or its model) is the hold's to record (holds.tov); the
          // breaker below counts the same failure as before
          if (ok) this.health.holds.settle(hid, ref.model, "ok", "unknown", "", undefined, now, 0.0)
          else {
            const ep = errorParts(text)
            const fc = classifyFailure(status, ep.message, ep.type, ep.code)
            if (holdsKey(fc)) this.health.holds.settle(hid, ref.model, "refused", fc, ep.message, hintMs, now, Math.random())
            else this.health.holds.settle(hid, ref.model, "unsure", fc, "", undefined, now, Math.random())
          }
          this.health.record(hid, healthy, tookMs, now)
          metrics.observeKeyUp(ref.provider, t.key.id ?? "", t.key.name ?? "", ok)
        }
        metrics.observeRequest(tl, { ok: ok, status: status, errorType: ok ? "" : status === 0 ? "provider_connection_failed" : metrics.errorTypeForStatus(status), retries: retry * 1.0 }, secs)
        const requested = ref.provider + "/" + ref.model
        if (ok) {
          try {
            const tr = translate(t, text, requested)
            if (sel.keyIndex >= 0) this.stick(h, ref, t)
            // raw echo: not for streamed answers, whose body is not one JSON object
            // extra_fields_placement "headers" keeps the body as the provider's (no extra_fields)
            const inBody = this.cfg.client?.extra_fields_placement !== "headers"
            const echoReq = inBody && !streamed && up.body !== "" && sendBackRaw(h, this.cfg, p, "request")
            const echoResp = inBody && !streamed && sendBackRaw(h, this.cfg, p, "response")
            const rawBody = echoReq || echoResp ? withRawFields(tr.body, echoReq ? up.body : undefined, echoResp ? text : undefined) : tr.body
            return { ok: true, status: 200, body: rawBody, contentType: streamed ? "text/event-stream" : "application/json", provider: ref.provider, model: ref.model, promptTokens: tr.promptTokens, completionTokens: tr.completionTokens, attempts: attempts, upstreamMs: upstreamMs, raw: echoReq || echoResp, key: t.key.name ?? t.key.id ?? "", alias: aliasTo(t.key, ref.model, this.cfg.client?.routing_chain_max_depth), aliasName: aliasNameOf(t.key, ref.model), aliasFamily: aliasFamilyOf(t.key, ref.model), served: tr.served ?? "", billed: t.cfg.ignore_provider_cost === true ? undefined : tr.billed }
          } catch (e) {
            last = { ok: false, status: 502, body: errorJson(`could not read ${ref.provider}'s response: ${e.message}`, "api_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
            break
          }
        }
        last = { ok: false, status: status === 0 ? 502 : status, body: text.startsWith("{") ? text : errorJson(text === "" ? `${ref.provider} returned HTTP ${status}` : text, "api_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
        last.retryMs = hintMs
        const d = status === 0 ? "retry" : try classify(status)
        if (d === "fail") return last
        if (d === "fallback") break
        if (d === "rotate") {
          if (sel.keyIndex < 0 || pinned !== undefined) break
          metrics.observeRotation(ref.provider, ref.model, t.key.id ?? "", t.key.name ?? "", metrics.errorTypeForStatus(status))
          if (soft !== undefined) {
            // the sticky key stopped working: drop the binding and pick normally
            soft = undefined
            const sid = sessionId(h)
            if (aff !== undefined && sid !== undefined) aff.forget(sid)
          }
          tried.add(sel.keyIndex)
          continue
        }
        // retry
        if (retry >= retries) break
        await sleep(backoffMs(p, retry, retryAfter))
        retry += 1
      }
    }
    last.attempts = attempts
    last.upstreamMs = upstreamMs
    return last
  }

  // Applies a changed config (from the management API) without dropping state:
  // budget and rate-limit usage, key health, the response cache, the request log,
  // the tracer and MCP connections all carry over.
  reload(cfg: Config): void {
    const fresh = new Engine(cfg)
    fresh.gov.carryUsage(this.gov)
    if (this.sharedWindows) fresh.gov.alignWindows()
    this.cfg = cfg
    this.gov = fresh.gov
    this.pricing = fresh.pricing
    // a datasheet fetched at runtime carries over
    const rows = this.catalogRows
    if (rows !== undefined) this.pricing.replaceCatalog(rows)
    this.rules = fresh.rules
    // the breakers keep their state; the policies follow the config
    this.health.replacePolicies(fresh.health.policyList())
    // the MCP clients follow the config too: a client added since the start gets a session (main connects it)
    const fm = fresh.mcp
    if (fm === undefined) this.mcp = undefined
    else if (this.mcp === undefined) this.mcp = fm
    else this.mcp.follow(fm.sessions)
    this.guard = fresh.guard
    this.guardInput = fresh.guardInput
    this.guardOutput = fresh.guardOutput
    this.autoPromptCache = fresh.autoPromptCache
    this.plugins = fresh.plugins
    this.jsonStreamOn = fresh.jsonStreamOn
    this.logRequests = fresh.logRequests
    this.complexity = fresh.complexity
    this.guardProviders = fresh.guardProviders
    this.localRules = fresh.localRules
    this.toolGuards = fresh.toolGuards
    this.agent = fresh.agent
    this.limiters = carryLimiters(fresh.limiters, this.limiters)
    if (fresh.affinity === undefined) this.affinity = undefined
    else if (this.affinity === undefined) this.affinity = fresh.affinity
    if (this.cache === undefined) this.cache = fresh.cache
    if (this.semantic === undefined) {
      this.semantic = fresh.semantic
      this.semanticCfg = fresh.semanticCfg
    }
    if (this.vstore === undefined) {
      this.vstore = fresh.vstore
      this.vsNs = fresh.vsNs
    }
  }

  // Embeds text with the semantic cache's embedding provider and model.
  async embed(text: string): Promise<f64[]> throws Error {
    const sc = this.cfg.semantic_cache!
    const none: Set<int> = new Set()
    const sel = target(this.cfg, { provider: sc.provider, model: sc.embedding_model }, none, undefined)
    if (sel === undefined) throw new Error(`no key for the embedding model ${sc.provider}/${sc.embedding_model}`)
    const up = try providers.embeddingsUpstream(sel.t, try fields(`{"model":${quote(sc.embedding_model)},"input":${quote(text)}}`))
    const hs: Record<string, string> = up.headers
    const dl = deadline(10000)
    const res = try await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal, proxy: proxyOf(sel.t.cfg), tls: tlsOf(sel.t.cfg) })
    const body = try await res.text()
    dl.finish()
    if (!res.ok) throw new Error(`embedding request failed with HTTP ${res.status}`)
    return try parseEmbedding(body)
  }

  // Adds the connected MCP servers' tools to a chat request. x-bf-mcp-include-clients
  // (comma-separated server names) narrows them; "none" leaves the request alone.
  // Bifrost's injected_tools: the provider's MCP tools join each chat request it serves, under their configured names.
  // A client tool with an injected name is replaced. Unchanged when nothing can be injected.
  withInjected(t: Target, body: Field[]): Field[] throws SyntaxError {
    const inj = t.cfg.injected_tools ?? []
    const m = this.mcp
    if (inj.length === 0 || m === undefined) return body
    const all = m.allTools()
    const defs: string[] = []
    for (const it of inj) {
      const d = try injectedDef(all, it)
      if (d !== undefined) defs.push(d)
    }
    if (defs.length === 0) return body
    const names: string[] = inj.map((x) => x.name)
    const out: string[] = []
    const existing = find(body, "tools")
    if (existing !== undefined && !isNull(existing)) {
      for (const el of try elements(existing)) {
        const n = try toolFnName(el)
        if (n === undefined || !names.includes(n)) out.push(el)
      }
    }
    for (const d of defs) out.push(d)
    let fs = body
    setField(&fs, "tools", "[" + out.join(",") + "]")
    return fs
  }

  withMcpTools(text: string, h: Hdrs): string throws SyntaxError {
    const m = this.mcp
    if (m === undefined) return text
    // Bifrost's client.mcp_disable_auto_tool_inject: tools are added only when the request names its clients or tools
    const named = h.get("x-bf-mcp-include-clients") !== undefined || h.get("x-bf-mcp-include-tools") !== undefined
    if (this.cfg.client?.mcp_disable_auto_tool_inject === true && !named) return text
    // a key's access profile may limit the MCP tools it gets; clients it doesn't name
    // count only with allow_by_default
    let tools = m.allToolsFor(this.gov.policyFor(h)?.mcpTools, this.gov.findKey(h)?.mcp_configs)
    const only = h.get("x-bf-mcp-include-clients")
    if (only !== undefined) {
      if (only.trim() === "none") return text
      const names = only.split(",").map((n) => n.trim() + "-")
      tools = tools.filter((t) => names.some((n) => t.includes(`"name":"${n}`)))
    }
    // x-bf-mcp-include-tools: "<client>-<tool>" or "<client>-*" entries; the request's tool list
    // is narrowed to them (Bifrost's MCPContextKeyIncludeTools; an empty list includes no tool)
    const onlyTools = h.get("x-bf-mcp-include-tools")
    if (onlyTools !== undefined) {
      const want = includeToolNames(onlyTools)
      const kept: string[] = []
      for (const t of tools) {
        const listed = try toolInList(t, want)
        if (listed) kept.push(t)
      }
      tools = kept
    }
    if (tools.length === 0) return text
    return try injectTools(text, tools)
  }

  // The gate of one MCP tool call: the key's MCP rules (access profile patterns and mcp_configs) must
  // allow the tool, and the key's budgets must have room. A tool the gateway does not expose is left to
  // execution, which reports it as unknown.
  toolGate(m: McpManager, h: Hdrs, name: string): Grant | Denial {
    if (m.hasTool(name) && !m.mayRun(this.gov.policyFor(h)?.mcpTools, this.gov.findKey(h)?.mcp_configs, name)) {
      return { kind: "denial", status: 403, type: "permission_error", message: `tool ${name} is not allowed for this key` }
    }
    const client = this.perUserClient(name)
    if (client !== undefined && this.userHeaders(name, h) === undefined) {
      return { kind: "denial", status: 401, type: "authentication_error", message: `the per-user headers of MCP client ${client} are not submitted for this key: open a submission with POST /api/mcp/per-user-headers/flows` }
    }
    return this.gov.admitTool(h)
  }

  // The per_user_headers client a tool belongs to; undefined for the tools of any other client.
  perUserClient(name: string): string | undefined {
    const hit = splitToolName(name, perUserClientNames(this.cfg.mcp?.client_configs))
    return hit === undefined ? undefined : hit.server
  }

  // The header values the calling key submitted for the tool's per_user_headers client; undefined when the
  // tool belongs to no such client or the key has submitted none.
  userHeaders(name: string, h: Hdrs): Map<string, string> | undefined {
    const client = this.perUserClient(name)
    if (client === undefined) return undefined
    return userHeadersOf(this.cfg.mcp?.user_credentials, client, this.gov.findKey(h)?.id ?? "")
  }

  // The caller's token for a tool of a per_user_oauth client. "none" for other tools; "bearer" with the token to
  // call with (an expiring token is refreshed first and saved); "denial" with the consent link the caller must
  // open. force refreshes the token whatever its expiry (used after the server answered 401).
  async userAuth(name: string, h: Hdrs, force: bool): Promise<UserAuth> {
    const hit = splitToolName(name, perUserOAuthNames(this.cfg.mcp?.client_configs))
    if (hit === undefined) return userAuthOf("none", "", 0, "", "")
    const client = hit.server
    const vk = this.gov.findKey(h)?.id ?? ""
    const ident = identityOf(h.get("x-bf-mcp-session-id"), vk)
    if (ident.vk === "" && ident.session === "") return userAuthOf("denial", "", 401, "authentication_error", `per-user OAuth for MCP client ${client} needs a virtual key (x-bf-vk) or an x-bf-mcp-session-id header`)
    const now = Date.now()
    const row = userTokenOf(this.cfg.mcp?.user_tokens, client, ident.vk, ident.session)
    const act = force && row !== undefined && row.refresh_token !== "" ? "refresh" : tokenAction(row, now)
    const a = authOfClient(this.cfg, client)
    if (act === "valid" && row !== undefined) return userAuthOf("bearer", row.access_token, 0, "", "")
    if (act === "refresh" && a !== undefined && row !== undefined) {
      try {
        const fresh = try await refreshUserRow(a, row, now)
        this.saveUserRow(fresh)
        return userAuthOf("bearer", fresh.access_token, 0, "", "")
      } catch (e) {
        // the refresh failed: the caller has to consent again
      }
    }
    const base = originOf(h)
    const tempOn = this.cfg.client?.mcp_enable_temp_token_auth === true
    const start: McpAuthConfig = a ?? { type: "oauth" }
    const r = startUserFlow(start, client, ident.vk, ident.session, base, tempOn, now)
    if (r.flow === undefined) return userAuthOf("denial", "", 401, "authentication_error", r.error)
    const f = r.flow!
    return userAuthOf("denial", "", 401, "authentication_error", consentMessage(client, consentLink(base, f.id, f.temp_token), tempOn))
  }

  // Keeps a token row the gateway obtained; the server's saver writes it to the config file.
  saveUserRow(row: McpUserToken): void {
    const f = this.userTokenSaved
    if (f !== undefined) f(row)
  }

  // Runs one tool call with the caller's bearer. A 401 from the server on a per-user call refreshes the token once
  // and runs the call again.
  async runUser(m: McpManager, name: string, args: string, h: Hdrs, ua: UserAuth): Promise<ToolText> throws Error {
    const bearer = ua.kind === "bearer" ? ua.token : undefined
    try {
      return try await m.execute(name, args, h, this.userHeaders(name, h), bearer)
    } catch (e) {
      if (bearer === undefined || !e.message.includes("HTTP 401")) throw e
      const again = try await this.userAuth(name, h, true)
      if (again.kind !== "bearer") throw e
      return try await m.execute(name, args, h, this.userHeaders(name, h), again.token)
    }
  }

  // Debits the tool's tool_pricing cost from the grant's budgets after a call ran. Free tools, and calls
  // with no key, debit nothing.
  chargeTool(m: McpManager, g: Grant | Denial, name: string): void {
    const cost = m.priceOf(name)
    if (cost > 0 && g.kind === "grant") this.gov.record(g, 0, cost)
  }

  // POST /v1/mcp/tool/execute: runs one tool call and answers with the tool message.
  async executeTool(req: Request): Promise<Response> {
    const m = this.mcp
    if (m === undefined) return errorResponse(404, "no MCP servers are configured", "invalid_request_error", noHeaders())
    const text = await req.text()
    try {
      const call = executeEndpointBody(text)
      const tv = checkToolCall(this.toolGuards, call.name, call.argumentsJson)
      if (!tv.allowed) return errorResponse(400, `tool call blocked by guardrails: ${tv.reason}`, "guardrail_violation", noHeaders())
      const h = snapshot(req.headers)
      const gate = this.toolGate(m, h, call.name)
      if (gate.kind === "denial") return errorResponse(gate.status, gate.message, gate.type, noHeaders())
      const ua = try await this.userAuth(call.name, h, false)
      if (ua.kind === "denial") return errorResponse(ua.status, ua.message, ua.type, noHeaders())
      const t0 = performance.now()
      const result = try await this.runUser(m, call.name, call.argumentsJson, h, ua)
      this.chargeTool(m, gate, call.name)
      timedMcp(m, call.name, t0, result.isError)
      metrics.inc("raiju_mcp_tool_calls_total", metrics.labels("", call.name, result.isError ? "error" : "success"), 1.0)
      const r: Record<string, string> = new Map()
      r.set("content-type", "application/json")
      return new Response(toolMessage(call.callId ?? "", result.text), { status: 200, headers: r })
    } catch (e) {
      if (e instanceof SyntaxError) return errorResponse(400, e.message, "invalid_request_error", noHeaders())
      return errorResponse(502, e.message, "api_error", noHeaders())
    }
  }

  // A Vertex OAuth access token for the key's service account, from the cache
  // or from Google's token endpoint (a signed JWT exchanged for an hour-long token).
  // An IBM Cloud IAM token for a watsonx key, cached until a minute before it expires.
  async watsonxToken(t: Target): Promise<{ token: string, error: string }> {
    const wk = t.key.watsonx_key_config
    if (wk === undefined) return { token: "", error: "watsonx: the key needs watsonx_key_config" }
    const now = Math.floor(Date.now() / 1000)
    const c = this.iamTokens.get(wk.api_key)
    if (c !== undefined && c.expiresAtSec - 60 > now) return { token: c.token, error: "" }
    try {
      let up = watsonx.iamTokenRequest(wk.api_key)
      const iam = wk.iam_url
      if (iam !== undefined && iam !== "") up.url = iam
      const hs: Record<string, string> = up.headers
      const dl = deadline(10000)
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal })
      const text = await res.text()
      dl.finish()
      const tok = watsonx.parseIamToken(text)
      this.iamTokens.set(wk.api_key, tok)
      return { token: tok.token, error: "" }
    } catch (e) {
      return { token: "", error: `watsonx authentication failed: ${e.message}` }
    }
  }

  // A Databricks OAuth (machine-to-machine) token for a key's client_id and client_secret.
  async databricksToken(t: Target): Promise<{ token: string, error: string }> {
    const dk = t.key.databricks_key_config!
    try {
      const host = databricks.workspaceHost(t)
      const key = host + "|" + (dk.client_id ?? "")
      const now = Date.now()
      const cached = this.databricksTokens.get(key, now)
      if (cached !== undefined) return { token: cached, error: "" }
      const up = databricks.oauthTokenRequest(host, dk.client_id ?? "", dk.client_secret ?? "")
      const hs: Record<string, string> = up.headers
      const dl = deadline(10000)
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal, proxy: proxyOf(t.cfg), tls: tlsOf(t.cfg) })
      const text = await res.text()
      dl.finish()
      const tok = databricks.parseOAuthToken(text, now)
      this.databricksTokens.put(key, tok.token, tok.expiresAtMs)
      return { token: tok.token, error: "" }
    } catch (e) {
      return { token: "", error: `databricks authentication failed: ${e.message}` }
    }
  }

  // A GitHub Copilot token and the host to call, minted from a GitHub App installation.
  async copilotToken(t: Target): Promise<{ token: string, host: string, error: string }> {
    const gc = t.key.github_copilot_key_config!
    const key = gc.app_id + "|" + gc.installation_id + "|" + gc.repository_id
    const now = Date.now()
    const cached = this.copilotTokens.get(key, now)
    if (cached !== undefined) {
      const nl = cached.indexOf("\n")
      return { host: cached.slice(0, nl), token: cached.slice(nl + 1), error: "" }
    }
    try {
      const domain = gc.github_domain ?? ""
      const api = copilot.githubApiBase(domain)
      const jwt = copilot.appJwt(gc.app_id, gc.private_key, Math.floor(now / 1000))
      const iu = copilot.installationTokenRequest(api, gc.installation_id, gc.repository_id, jwt)
      const ih: Record<string, string> = iu.headers
      const dl = deadline(10000)
      const ir = await fetch(iu.url, { method: "POST", headers: ih, body: iu.body, signal: dl.controller.signal })
      const inst = copilot.parseInstallationToken(await ir.text())
      const cu = copilot.copilotTokenRequest(api, inst.token)
      const ch: Record<string, string> = cu.headers
      const cr = await fetch(cu.url, { method: "GET", headers: ch, signal: dl.controller.signal })
      const tok = copilot.parseCopilotToken(await cr.text(), domain, now / 1000.0)
      dl.finish()
      this.copilotTokens.put(key, tok.baseURL + "\n" + tok.token, tok.expiresAtSec * 1000.0)
      return { token: tok.token, host: tok.baseURL, error: "" }
    } catch (e) {
      return { token: "", host: "", error: `github copilot authentication failed: ${e.message}` }
    }
  }

  // An Entra ID access token for an Azure key with a service principal, cached until a minute before it expires.
  async entraToken(t: Target): Promise<{ token: string, error: string }> {
    const az = t.key.azure_key_config!
    const key = (az.tenant_id ?? "") + "/" + (az.client_id ?? "")
    const now = Date.now()
    const cached = this.entraTokens.get(key, now)
    if (cached !== undefined) return { token: cached, error: "" }
    try {
      const up = cloudAuth.entraTokenRequest(az.tenant_id ?? "", az.client_id ?? "", az.client_secret ?? "", az.scopes ?? [])
      const hs: Record<string, string> = up.headers
      const dl = deadline(10000)
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal })
      const text = await res.text()
      dl.finish()
      const tok = cloudAuth.parseTokenResponse(text, now)
      this.entraTokens.put(key, tok.token, tok.expiresAtMs)
      return { token: tok.token, error: "" }
    } catch (e) {
      return { token: "", error: `azure entra authentication failed: ${e.message}` }
    }
  }

  // Temporary credentials for a Bedrock key's role_arn (STS AssumeRole), cached until they near expiry.
  async assumeRole(bk: BedrockKeyConfig): Promise<{ creds?: cloudAuth.AssumedCreds, error: string }> {
    const role = bk.role_arn ?? ""
    const session = bk.session_name ?? "bifrost-session"
    const key = role + "|" + (bk.external_id ?? "") + "|" + session
    const now = Date.now()
    const cached = this.stsCreds.get(key, now)
    if (cached !== undefined) return { creds: cached, error: "" }
    try {
      const up = cloudAuth.assumeRoleRequest({ accessKey: bk.access_key ?? "", secretKey: bk.secret_key ?? "", sessionToken: bk.session_token }, bk.region ?? "us-east-1", role, bk.external_id, session, 3600, now)
      const hs: Record<string, string> = up.headers
      const dl = deadline(10000)
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal })
      const text = await res.text()
      dl.finish()
      const creds = cloudAuth.parseAssumeRole(text)
      this.stsCreds.put(key, creds, creds.expiresAtMs)
      return { creds: creds, error: "" }
    } catch (e) {
      return { error: `bedrock assume-role failed: ${e.message}` }
    }
  }

  async vertexToken(t: Target): Promise<{ token: string, error: string }> {
    const now = Math.floor(Date.now() / 1000)
    try {
      const sa = parseServiceAccount(t.key.vertex_key_config?.auth_credentials)
      const cached = this.vertexTokens.get(sa.client_email, now)
      if (cached !== undefined) return { token: cached, error: "" }
      const up = this.vertexTokens.tokenRequest(sa, now)
      const hs: Record<string, string> = up.headers
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: deadline(10000).controller.signal })
      const text = await res.text()
      this.vertexTokens.store(sa.client_email, text, now)
      return { token: this.vertexTokens.get(sa.client_email, now) ?? "", error: "" }
    } catch (e) {
      return { token: "", error: `vertex authentication failed: ${e.message}` }
    }
  }

  // Applies the first matching routing rule: its weighted target replaces the
  // requested model (keeping a pinned key), and its fallbacks come next.
  route(rules: RuleSet, op: string, refs: ModelRef[], inout h: Hdrs, body: Field[], tier: Tier | undefined): ModelRef[] | undefined {
    const first = refs[0]!
    const vk = this.gov.findKey(h)
    const params: Map<string, string> = new Map()
    for (const f of body) {
      if (!f.raw.startsWith("[") && !f.raw.startsWith("{")) params.set(f.key, f.raw)
    }
    const act: Activation = {
      model: first.model,
      provider: first.provider,
      request_type: op,
      virtual_key: vk?.id,
      team: vk?.team_id,
      customer: vk?.customer_id,
      // percentages, as Bifrost
      budget_used: this.gov.budgetFraction(vk) * 100.0,
      tokens_used: this.gov.rateFraction(vk, "token") * 100.0,
      request_used: this.gov.rateFraction(vk, "request") * 100.0,
      virtual_key_name: vk?.name,
      team_name: this.gov.teamName(vk),
      customer_name: this.gov.customerName(vk),
      complexity_tier: tier,
      headers: h,
      params: params,
    }
    // chain_rule: a matched rule with chain_rule sends its target back through the rules as the new
    // context. The chain ends on a terminal rule, at the depth limit, when nothing matches, or when a step
    // changes neither provider nor model. The last matched rule decides (Bifrost's accumulation).
    const maxDepth = this.cfg.client?.routing_chain_max_depth ?? 10
    let cur: ModelRef = first
    let decided: ModelRef[] | undefined = undefined
    let steps = 0
    while (true) {
      act.model = cur.model
      act.provider = cur.provider
      const m = rules.match(act, { virtual_key: vk?.id, team: vk?.team_id, customer: vk?.customer_id })
      if (m === undefined) break
      const i = pickTarget(m.targets, Math.random())
      if (i < 0) break
      const tg = m.targets[i]!
      const next: ModelRef = { provider: tg.provider, model: tg.model ?? cur.model }
      const out: ModelRef[] = [next]
      for (const f of m.fallbacks) out.push(parseModel(this.cfg, f))
      decided = out
      if (tg.key_id !== undefined) h.set("x-bf-api-key", tg.key_id)
      h.set("x-bf-routing-rule", m.rule)
      if (!m.chain || steps >= maxDepth) break
      steps += 1
      if (next.provider === cur.provider && next.model === cur.model) break
      cur = next
    }
    if (decided === undefined) return undefined
    for (const r of refs.slice(1)) decided.push(r)
    return decided
  }

  // Shared front half of every inference endpoint.
  async serve(req: Request, op: string, modelName: string | undefined, body: Field[], text: string, build: Build, translate: Translate, streamed: bool, upstreamHeaders?: Map<string, string>, sink?: StreamSink, makeConverter?: ConverterFactory, compat?: CompatPlan, prompt?: Applied): Promise<Response> {
    const h = snapshot(req.headers)
    const ctx = new ReqCtx(h.get("x-request-id") ?? newId("req_"), op, performance.now())
    ctx.sink = sink
    ctx.makeConverter = makeConverter
    ctx.compat = compat
    if (prompt !== undefined && prompt.prompt_id !== undefined) {
      ctx.promptId = prompt.prompt_id
      ctx.promptName = prompt.prompt_name ?? ""
      ctx.promptVersion = prompt.version
    }
    ctx.meta = logMetadata(h, this.cfg.client?.logging_headers ?? [])
    const cids = correlationIds(h)
    ctx.parentId = cids.parent
    ctx.agentId = cids.agent
    const ma = maximAttrs(h)
    ctx.maximIds = ma?.ids
    ctx.maximTags = ma?.tags
    if (upstreamHeaders !== undefined) ctx.upstreamHeaders = upstreamHeaders
    const tracer = this.tracer
    if (tracer !== undefined) {
      const sid = sessionId(h)
      const rs = tracer.startRequest(op, h.get("traceparent"), Date.now(), sid)
      tracer.recordRequestHeaders(rs, h)
      if (sid !== undefined) rs.setStr("session.id", sid)
      ctx.span = rs
    }
    ctx.contentOff = this.contentOff(h)
    ctx.userAgent = h.get("user-agent") ?? ""
    ctx.sessionId = sessionId(h) ?? ""
    if (this.logStore !== undefined && !ctx.contentOff) ctx.input = text
    // bifrost_active_requests: in flight from here until the answer (or the throw) is out
    const method = requestType(op, streamed)
    metrics.activeRequests(method, 1.0)
    let res: Response = new Response(undefined, { status: 500 })
    try {
      res = try await this.serveInner(req, h, ctx, modelName, body, text, build, translate, streamed, compat)
    } finally {
      metrics.activeRequests(method, -1.0)
    }
    ctx.status = res.status
    this.record(ctx)
    return res
  }

  async serveInner(req: Request, h0: Hdrs, ctx: ReqCtx, modelName: string | undefined, body: Field[], text: string, build: Build, translate: Translate, streamed: bool, compat?: CompatPlan): Promise<Response> {
    const op = ctx.op
    const started = ctx.started
    let h = h0
    const rid = ctx.rid
    let out: Hdrs = new Map()
    out.set("x-bifrost-request-id", rid)
    // Bifrost's tracing middleware echoes the request id as x-request-id too
    out.set("x-request-id", rid)
    out.set("x-bifrost-request-type", requestType(op, streamed))
    const span = ctx.span
    if (span !== undefined) out.set("x-bifrost-trace-id", span.traceId)
    const model = modelName ?? rawStr(body, "model")
    ctx.model = model ?? ""
    if (model === undefined) return errorResponse(400, "the request needs a model, e.g. \"openai/gpt-4o-mini\"", "invalid_request_error", out)
    // overhead components (bifrost_overhead_component_microseconds): routing starts here
    const tRoute = performance.now()
    // complexity tier: for routing rules (complexity_tier) and the tier map behind model "auto"
    let tier: Tier | undefined = undefined
    // how the tier was decided, for the request log: a classifier's name, "heuristic" or "override"
    let mechanism = ""
    const cx = this.complexity
    if (cx !== undefined && op === "chat") {
      const forced = overrideTier(h)
      if (forced !== undefined) {
        tier = forced
        mechanism = "override"
      } else {
        const d = await this.tierFor(req, text, cx)
        tier = d.tier
        mechanism = d.mechanism
        ctx.complexityScore = d.score
      }
      out.set("x-bf-complexity-tier", tier ?? "MEDIUM")
    }
    // a bare model name resolves through keys, then the catalog, preferring the SDK route's provider
    let refs = [parseModelVia(this.cfg, model, routeOf(op))].concat(fallbackRefs(this.cfg, body))
    if (cx !== undefined && tier !== undefined && model === (cx.model ?? "auto")) {
      const tt = tierTarget(tier, cx.tiers ?? {})
      if (tt !== undefined) refs = [parseModel(this.cfg, tt)].concat(refs.slice(1))
    }
    if (refs[0]!.provider === "") {
      ctx.error = "no provider for " + model
      return errorResponse(400, "could not auto resolve a provider for the request, please specify a provider explicitly", "invalid_request_error", out)
    }
    // a circuit policy whose circuit is open sends the primary's requests to its fallback (the primary is not tried)
    const open = this.health.policyFallback(refs[0]!.provider, refs[0]!.model, Date.now())
    if (open !== undefined) refs = [{ provider: open.fallback_provider, model: open.fallback_model }].concat(refs.slice(1))
    const rules = this.rules
    if (rules !== undefined) {
      const routed = this.route(rules, op, refs, &h, body, tier)
      if (routed !== undefined) {
        refs = routed
        out.set("x-bf-routing-rule", h.get("x-bf-routing-rule") ?? "")
      }
    }
    const routeUs = (performance.now() - tRoute) * 1000.0
    const primary = refs[0]!
    const tGov = performance.now()
    const admitted = this.gov.admit(h, primary.provider, primary.model)
    const govUs = (performance.now() - tGov) * 1000.0
    if (admitted.kind === "denial") {
      ctx.error = admitted.message
      return errorResponse(admitted.status, admitted.message, admitted.type, out)
    }
    const grant: Grant = admitted
    ctx.virtualKey = grant.vk?.id ?? ""
    ctx.userId = grant.vk?.user_id ?? ""
    ctx.provider = primary.provider
    let rl = metrics.newLabels(primary.provider, primary.model, requestType(op, streamed))
    const gvk = grant.vk
    if (gvk !== undefined) {
      rl.virtualKeyId = gvk.id
      rl.virtualKeyName = gvk.name ?? ""
    }
    // team, customer, business unit and project, as governance attributed them
    const at: Attribution = grant.attr ?? noAttribution()
    ctx.teamId = at.teamId
    ctx.customerId = at.customerId
    ctx.businessUnitId = at.businessUnitId
    ctx.projectId = at.projectId
    rl.teamId = at.teamId
    rl.teamName = at.teamName
    rl.customerId = at.customerId
    rl.customerName = at.customerName
    rl.businessUnitId = at.businessUnitId
    rl.businessUnitName = at.businessUnitName
    rl.projectId = at.projectId
    rl.projectName = at.projectName
    const ruleName = out.get("x-bf-routing-rule")
    if (ruleName !== undefined && ruleName !== "") {
      rl.routingRuleName = ruleName
      rl.routingRuleId = ruleName
      rl.routingEngineUsed = "routing_rule"
    }
    if (tier !== undefined) {
      rl.complexityTier = tier
      rl.complexityMechanism = mechanism
    }
    if (tier !== undefined || (ruleName !== undefined && ruleName !== "")) {
      metrics.observeRouting(ruleName !== undefined && ruleName !== "" ? "routing_rule" : "complexity", tier ?? "", ruleName ?? "")
    }
    if (model !== primary.provider + "/" + primary.model && model !== primary.model) rl.alias = model
    // the app: the caller's x-bf-app, else the one its User-Agent names (the operator's
    // user_agent_mappings first, then Bifrost's built-in identifiers)
    const xApp = h.get("x-bf-app") ?? ""
    rl.app = xApp !== "" ? xApp : appOf(h.get("user-agent") ?? "", this.cfg.user_agent_mappings ?? [])
    ctx.app = rl.app
    rl.userId = ctx.userId
    rl.custom = metrics.customValues(h)
    ctx.labels = rl
    // Fallbacks the key may not use are dropped.
    const allowed: ModelRef[] = [primary]
    for (const r of refs.slice(1)) {
      if (this.gov.admit(h, r.provider, r.model).kind === "grant") allowed.push(r)
    }

    // Budgets cannot count the cost of a model with no price, so with client.refuse_unpriced_models
    // a budgeted request is refused for any unpriced model it may reach (fallbacks included).
    if (grant.budgets.length > 0 && this.cfg.client?.refuse_unpriced_models === true) {
      const no = this.pricing.unpriced(allowed)
      if (no !== undefined) {
        const msg = `model ${no.provider}/${no.model} has no price, so the budget on this key cannot count it: add a pricing override, or turn off client.refuse_unpriced_models`
        ctx.error = msg
        return errorResponse(403, msg, "permission_error", out)
      }
    }

    const tCache = performance.now()
    const cache = this.cache
    let key = ""
    const noStore = h.get("x-bf-cache-no-store") === "true"
    if (cache !== undefined) {
      const scope = keyScope(op + (h.get("x-bf-cache-key") ?? ""), grant.vk?.id ?? "", this.cfg.cache?.scope_by_virtual_key !== false)
      key = cacheKey(scope, model, text)
      const hit = cache.get(key)
      if (hit !== undefined) {
        metrics.observeCacheHit(ctx.labels, "direct")
        out.set("x-bf-cache", "hit")
        cacheHeaders(&out, "direct", primary, undefined, undefined, cacheId(key), performance.now() - started)
        originHeaders(&out, hit.origin)
        out.set("content-type", hit.contentType)
        ctx.cached = true
        ctx.cacheType = "direct"
        if (this.logStore !== undefined) {
          ctx.stopReason = stopReasonOf(hit.body)
          ctx.toolNames = toolCallNamesOf(hit.body)
        }
        ctx.output = hit.body
        return respond(200, hit.body, out)
      }
    }

    // Semantic cache: only for requests that name a cache key (header or config default).
    let semScope = ""
    let semVec: f64[] = []
    const sem = this.semantic
    const semKey = h.get("x-bf-cache-key") ?? this.cfg.semantic_cache?.default_cache_key
    if (sem !== undefined && semKey !== undefined && op === "chat" && h.get("x-bf-cache-type") !== "direct") {
      try {
        const pt = promptText(text, this.semanticCfg)
        if (pt !== undefined) {
          semVec = await this.embed(pt)
          // entries stay with the virtual key that wrote them unless disable_identity_scoping
          semScope = identityScope(scopeKey(primary.provider, primary.model, semKey, this.semanticCfg), grant.vk?.id ?? "", this.semanticCfg)
          const th = h.get("x-bf-cache-threshold")
          const thr = th === undefined ? this.semanticCfg.threshold : (parseFloat(th) ?? this.semanticCfg.threshold)
          const hit = this.vstore !== undefined ? await this.vectorLookup(semScope, semVec, thr) : sem.lookup(semScope, semVec, Date.now(), th === undefined ? undefined : parseFloat(th))
          if (hit !== undefined) {
            metrics.observeCacheHit(ctx.labels, "semantic")
            out.set("x-bf-cache", "semantic-hit")
            out.set("x-bf-cache-similarity", hit.score.toFixed(4))
            cacheHeaders(&out, "semantic", primary, hit.score, th === undefined ? this.semanticCfg.threshold : (parseFloat(th) ?? this.semanticCfg.threshold), hit.id, performance.now() - started)
            originHeaders(&out, hit.origin)
            out.set("content-type", hit.contentType)
            ctx.cached = true
            ctx.cacheType = "semantic"
            return respond(200, hit.body, out)
          }
        }
      } catch (e) {
        // an embedding failure only skips the semantic cache
        semVec = []
      }
    }

    // the cache plugin's time (lookups and the semantic embedding), for the overhead components
    const cacheUs = (performance.now() - tCache) * 1000.0
    if (cache !== undefined || semVec.length > 0) out.set("x-bifrost-cache-hit", "false")
    ctx.outHeaders = out
    ctx.requested = model
    if (compat !== undefined && compat.enabled) await this.compatLoad(compat, allowed)
    const tAtt = performance.now()
    const r = try await this.attempt(allowed, h, build, translate, streamed, ctx)
    // translation and retries: the attempt's time less the upstream calls
    const convertUs = Math.max(0.0, (performance.now() - tAtt) * 1000.0 - r.upstreamMs * 1000.0)
    out.set("x-bf-attempts", "" + r.attempts)
    if (compat !== undefined && compat.enabled) {
      // Bifrost logs these as warnings: the fitted values and a dropped service tier
      for (const w of compat.warnings) console.error(`raiju: compat: ${w}`)
      compatHeaders(&out, compat)
    }
    if (!r.ok) {
      ctx.error = r.body.byteLength > 2000 ? r.body.slice(0, 2000) : r.body
      out.set("content-type", "application/json")
      const et = errorType(r.body)
      if (et !== "") out.set("x-bifrost-error-type", et)
      if (r.retryMs !== undefined) out.set("x-bifrost-retry-after-ms", "" + Math.round(r.retryMs))
      if (r.provider !== "") routedHeaders(&out, primary, r.provider, r.model, fallbackIndex(allowed, r.provider, r.model), model, r.upstreamMs, r.key ?? "", r.alias ?? "", r.aliasName ?? "", r.aliasFamily ?? "")
      return respond(r.status, r.body, out)
    }
    // a provider's billed cost (OpenRouter's usage.cost) replaces the datasheet estimate
    // an alias's model_name (Bifrost's canonical name) is the model priced when it is set
    const priced = r.aliasName !== undefined && r.aliasName !== "" ? r.aliasName : r.model
    const cost = r.billed !== undefined && r.billed > 0 ? r.billed : this.pricing.cost(r.provider, priced, r.promptTokens, r.completionTokens)
    if (grant.budgets.length > 0 && !this.pricing.known(r.provider, priced) && !this.unpriced.has(r.provider + "/" + priced)) {
      this.unpriced.add(r.provider + "/" + priced)
      console.error(`raiju: no price for ${r.provider}/${priced}: budgets don't count its requests; add a pricing override`)
    }
    this.gov.record(grant, r.promptTokens + r.completionTokens, cost)
    let ul = ctx.labels
    ul.provider = r.provider
    ul.model = r.model
    metrics.observeUsage(ul, { input: r.promptTokens, output: r.completionTokens, cost: cost, cacheRead: 0.0, cacheWrite: 0.0, cacheWrite5m: 0.0, cacheWrite1h: 0.0 })
    if (r.direct === true) {
      // already streamed to the client; nothing to cache or send
      ctx.provider = r.provider
      ctx.promptTokens = r.promptTokens
      ctx.completionTokens = r.completionTokens
      ctx.cost = cost
      return respond(200, "", out)
    }
    // a body with raw fields is for this caller only: it never enters a cache
    // a response with tool calls is replayed into someone else's agent loop, so it is kept only when opted in
    if (sem !== undefined && semVec.length > 0 && !noStore && r.raw !== true && (this.semanticCfg.cache_tool_call_responses || !hasToolCalls(r.body))) {
      const ttlHeader = h.get("x-bf-cache-ttl")
      const ttl = ttlHeader === undefined ? undefined : parseTtl(ttlHeader)
      const origin: CacheOrigin = { provider: r.provider, model: r.model, inputTokens: r.promptTokens }
      if (this.vstore !== undefined) await this.vectorStore(semScope, semVec, r.body, r.contentType, ttl ?? this.semanticCfg.ttl_ms, origin)
      else sem.store(semScope, semVec, r.body, r.contentType, Date.now(), ttl, origin, semKey)
    }
    if (cache !== undefined && !noStore && r.raw !== true) {
      const ttlHeader = h.get("x-bf-cache-ttl")
      const ttl = ttlHeader === undefined ? this.cacheTtlMs : parseTtl(ttlHeader) ?? this.cacheTtlMs
      cache.set(key, r.body, r.contentType, ttl, { provider: r.provider, model: r.model, inputTokens: r.promptTokens }, h.get("x-bf-cache-key") ?? "")
    }
    if (r.provider !== primary.provider || r.model !== primary.model) out.set("x-bf-fallback-used", r.provider + "/" + r.model)
    const idx = fallbackIndex(allowed, r.provider, r.model)
    routedHeaders(&out, primary, r.provider, r.model, idx, model, r.upstreamMs, r.key ?? "", r.alias ?? "", r.aliasName ?? "", r.aliasFamily ?? "")
    // the model a provider's server-side fallback answered with (Anthropic usage iterations)
    const served = r.served ?? ""
    if (served !== "") out.set("x-bifrost-routing-info-server-side-fallback-model", served)
    // a semantic lookup that missed still says which upstream answered and what it counted
    if (sem !== undefined && semVec.length > 0) {
      out.set("x-bifrost-cache-provider-used", r.provider)
      out.set("x-bifrost-cache-model-used", r.model)
      out.set("x-bifrost-cache-input-tokens", "" + r.promptTokens)
    }
    out.set("x-bifrost-latency-ms", "" + Math.round(performance.now() - started))
    out.set("content-type", r.contentType)
    if (r.contentType === "text/event-stream") out.set("cache-control", "no-cache")
    // Time spent in the gateway itself, upstream calls excluded (Bifrost's "overhead").
    const overheadUs = (performance.now() - started - r.upstreamMs) * 1000.0
    metrics.observeOverheadFor(ul, overheadUs)
    // Bifrost's components: governance and the cache are plugins there; the rest of the overhead is
    // miscellaneous, so the components sum to the overhead
    metrics.observeOverheadComponent(ul, "plugins", govUs + cacheUs)
    metrics.observeOverheadComponent(ul, "routing", routeUs)
    metrics.observeOverheadComponent(ul, "conversion", convertUs)
    metrics.observeOverheadComponent(ul, "miscellaneous", Math.max(0.0, overheadUs - (govUs + cacheUs + routeUs + convertUs)))
    out.set("x-bf-overhead-us", "" + Math.round(overheadUs))
    // the same measurements as spans for the otel plugin: the request span's overhead, and each stage
    const epochAt = (p: f64): f64 => Date.now() - (performance.now() - p)
    ctx.overheadUs = overheadUs
    ctx.stages = [
      { name: "plugin.routing.prehook", startMs: epochAt(tRoute), durUs: routeUs },
      { name: "plugin.governance.prehook", startMs: epochAt(tGov), durUs: govUs },
      { name: "convertor", startMs: epochAt(tAtt), durUs: convertUs },
    ]
    if (cache !== undefined) ctx.stages.push({ name: "plugin.semantic_cache.prehook", startMs: epochAt(tCache), durUs: cacheUs })
    ctx.provider = r.provider
    ctx.promptTokens = r.promptTokens
    ctx.completionTokens = r.completionTokens
    ctx.cost = cost
    if (this.logStore !== undefined) {
      ctx.output = r.body
      ctx.stopReason = stopReasonOf(r.body)
      ctx.toolNames = toolCallNamesOf(r.body)
    }
    return respond(200, r.body, out)
  }

  // Reads the datasheet row of each target into the plan. A failed read leaves the row unknown.
  async compatLoad(cp: CompatPlan, refs: ModelRef[]): Promise<void> {
    const look = this.paramsLookup
    for (const r of refs) {
      const key = r.provider + "/" + r.model
      if (cp.has(key)) continue
      let rec: string | undefined = undefined
      if (look !== undefined) {
        try {
          rec = await look(r.model)
        } catch (e) {
          rec = undefined
        }
      }
      cp.put(key, rec)
    }
  }

  // The best vector-store entry for a scope; a store error is a miss.
  async vectorLookup(scope: string, v: f64[], threshold: f64): Promise<{ id: string, body: string, contentType: string, score: f64, origin?: CacheOrigin } | undefined> {
    const vs = this.vstore
    if (vs === undefined) return undefined
    try {
      if (!this.vsReady) {
        await vs.ensure(this.vsNs, this.cfg.semantic_cache?.dimension ?? v.length, ["scope"])
        this.vsReady = true
      }
      const hit = await vs.search(this.vsNs, v, threshold, [{ key: "scope", eq: scopeTag(scope) }])
      if (hit === undefined) return undefined
      const pl = hit.payload
      const provider = pl.get("origin_provider") ?? ""
      const origin: CacheOrigin | undefined = provider === "" ? undefined : { provider: provider, model: pl.get("origin_model") ?? "", inputTokens: parseInt(pl.get("origin_input_tokens") ?? "") ?? 0 }
      return { id: hit.id, body: pl.get("body") ?? "", contentType: pl.get("contentType") ?? "application/json", score: hit.score, origin: origin }
    } catch (e) {
      console.error(`raiju: vector_store search: ${e.message}`)
      return undefined
    }
  }

  async vectorStore(scope: string, v: f64[], body: string, contentType: string, ttlMs: int, origin?: CacheOrigin): Promise<void> {
    const vs = this.vstore
    if (vs === undefined || !this.vsReady) return
    const payload: Map<string, string> = new Map()
    payload.set("scope", scopeTag(scope))
    payload.set("body", body)
    payload.set("contentType", contentType)
    if (origin !== undefined) {
      payload.set("origin_provider", origin.provider)
      payload.set("origin_model", origin.model)
      payload.set("origin_input_tokens", "" + origin.inputTokens)
    }
    try {
      await vs.add(this.vsNs, newId("sc-"), v, payload, ttlMs)
    } catch (e) {
      console.error(`raiju: vector_store add: ${e.message}`)
    }
  }

  // Whether a request's bodies stay out of the log store and exporters: the
  // x-bf-disable-content-logging header (when allowed), then the key's setting, then the client's.
  contentOff(h: Hdrs): bool {
    const cl = this.cfg.client
    const hv = h.get("x-bf-disable-content-logging")
    if (hv !== undefined && cl?.allow_per_request_content_storage_override === true) return hv === "true" || hv === "1"
    const vk = this.gov.findKey(h)
    if (vk !== undefined && vk.disable_content_logging !== undefined) return vk.disable_content_logging
    return cl?.disable_content_logging === true
  }

  // The raw upstream bodies that logs and log exports keep get the guardrail redaction too, as the
  // content fields do (Bifrost: stored log fields and exports carry the redacted payload). A response
  // also gets the local output rules that redact, the same rules that rewrite a streamed answer.
  redactRaw(raw: string, response: bool): string {
    let body = raw
    const g = this.guard
    if (g !== undefined && g.mode === "redact") body = applyToText(body, g).body
    if (response) {
      for (const p of this.guardProviders) {
        if (!appliesTo(p, "output") || !(p.kind === "regex" || p.kind === "secrets")) continue
        body = applyRegex(body, this.localRules.get(p.id) ?? []).body
      }
    }
    return body
  }

  record(c: ReqCtx): void {
    const ms = performance.now() - c.started
    const ok = c.status >= 200 && c.status < 300
    if (this.logRequests) {
      process.stdout.write(JSON.stringify({ ts: Date.now(), request_id: c.rid, op: c.op, provider: c.provider, model: c.model, status: c.status, prompt_tokens: c.promptTokens, completion_tokens: c.completionTokens, cost: c.cost, latency_ms: Math.round(ms), cache_hit: c.cached }) + "\n")
    }
    const ring = this.samples
    if (ring !== undefined) ring.push({ ts: Date.now(), provider: c.provider, model: c.model, status: c.status, latency_ms: ms, cost: c.cost })
    const store = this.logStore
    if (this.exportQueues.length > 0) {
      const e: LogEntry = {
        id: c.rid, ts: Date.now(), request_id: c.rid, op: c.op, provider: c.provider, model: c.model, status: c.status,
        latency_ms: ms, prompt_tokens: c.promptTokens, completion_tokens: c.completionTokens, cost: c.cost, cache_hit: c.cached,
        virtual_key: c.virtualKey === "" ? undefined : c.virtualKey, team_id: c.teamId === "" ? undefined : c.teamId,
        customer_id: c.customerId === "" ? undefined : c.customerId, business_unit_id: c.businessUnitId === "" ? undefined : c.businessUnitId,
        project_id: c.projectId === "" ? undefined : c.projectId, error: c.error === "" ? undefined : c.error,
        input: c.input === "" || c.contentOff ? undefined : c.input, output: c.output === "" || c.contentOff ? undefined : c.output,
        metadata: c.meta, parent_request_id: c.parentId === "" ? undefined : c.parentId, agent_correlation_id: c.agentId === "" ? undefined : c.agentId,
        app: c.app === "" ? undefined : c.app, user_agent: c.userAgent === "" ? undefined : c.userAgent, maxim: c.maximIds, maxim_tags: c.maximTags,
      }
      for (const q of this.exportQueues) q.add(e)
    }
    if (store !== undefined) {
      // the routing the request took (the labels hold the key, the rule and the tier; the engine is the rule's
      // when one matched, else the key picked by weight)
      const lb = c.labels
      // a key configured without an id is recorded by its name
      const keyRef = lb.selectedKeyId !== "" ? lb.selectedKeyId : lb.selectedKeyName
      const engine = lb.routingRuleId !== "" ? "routing-rule" : keyRef !== "" ? "loadbalancing" : ""
      store.add({
        selected_key_id: keyRef === "" ? undefined : keyRef,
        selected_key_name: lb.selectedKeyName === "" ? undefined : lb.selectedKeyName,
        routing_rule_id: lb.routingRuleId === "" ? undefined : lb.routingRuleId,
        routing_engine_used: engine === "" ? undefined : engine,
        alias: lb.alias === "" ? undefined : lb.alias,
        complexity_tier: lb.complexityTier === "" ? undefined : lb.complexityTier,
        complexity_mechanism: lb.complexityMechanism === "" ? undefined : lb.complexityMechanism,
        cache_hit_type: c.cacheType === "" ? undefined : c.cacheType,
        stop_reason: c.stopReason === "" ? undefined : c.stopReason,
        tool_call_names: c.toolNames.length === 0 ? undefined : c.toolNames,
        complexity_score: c.complexityScore,
        selected_prompt_id: c.promptId === "" ? undefined : c.promptId,
        selected_prompt_name: c.promptName === "" ? undefined : c.promptName,
        selected_prompt_version: c.promptVersion,
        raw_request: c.contentOff || c.rawRequest === "" ? undefined : this.redactRaw(c.rawRequest, false),
        raw_response: c.contentOff || c.rawResponse === "" ? undefined : this.redactRaw(c.rawResponse, true),
        id: c.rid, ts: Date.now(), request_id: c.rid, op: c.op, provider: c.provider, model: c.model, status: c.status,
        latency_ms: ms, prompt_tokens: c.promptTokens, completion_tokens: c.completionTokens, cost: c.cost, cache_hit: c.cached,
        virtual_key: c.virtualKey === "" ? undefined : c.virtualKey, team_id: c.teamId === "" ? undefined : c.teamId,
        customer_id: c.customerId === "" ? undefined : c.customerId, business_unit_id: c.businessUnitId === "" ? undefined : c.businessUnitId,
        project_id: c.projectId === "" ? undefined : c.projectId, error: c.error === "" ? undefined : c.error,
        session_id: c.sessionId === "" ? undefined : c.sessionId, user_id: c.userId === "" ? undefined : c.userId,
        input: c.input === "" || c.contentOff ? undefined : c.input, output: c.output === "" || c.contentOff ? undefined : c.output,
        metadata: c.meta, parent_request_id: c.parentId === "" ? undefined : c.parentId, agent_correlation_id: c.agentId === "" ? undefined : c.agentId,
        app: c.app === "" ? undefined : c.app, user_agent: c.userAgent === "" ? undefined : c.userAgent, maxim: c.maximIds, maxim_tags: c.maximTags,
      })
    }
    const tracer = this.tracer
    const span = c.span
    if (tracer !== undefined && span !== undefined) {
      genAiAttributes(span, { system: c.provider, operation: c.op, requestModel: c.model, inputTokens: c.promptTokens, outputTokens: c.completionTokens })
      span.setInt("http.response.status_code", c.status)
      span.setBool("raiju.cache_hit", c.cached)
      const ov = c.overheadUs
      if (ov !== undefined) span.setNum("bifrost.overhead.duration_ms", ov / 1000.0)
      if (!ok) span.fail(c.error === "" ? `HTTP ${c.status}` : c.error)
      span.end(Date.now())
      tracer.addStages(span, c.stages)
      tracer.finish(span)
      if (tracer.shouldFlush(Date.now())) this.flushTraces(tracer)
    }
  }

  // Sends queued spans to the collector in the background; export failures are logged, never raised.
  flushTraces(tracer: Tracer): void {
    if (usesGrpc(tracer.cfg)) {
      exportSpansGrpc(tracer)
      return
    }
    const payload = tracer.flushPayload()
    if (payload === undefined) return
    const up = exportRequest(tracer.cfg, payload)
    sendSpans(up.url, up.headers, up.body, tracer.tls, up.timeoutMs)
  }

  // Chat completions. With MCP agent mode on (client.mcp_auto_execute), tool calls to
  // the listed MCP tools run here and the model is called again, up to mcp_agent_depth
  // rounds; streamed requests and x-bf-mcp-agent: off skip it.
  async chat(req: Request, sink?: StreamSink): Promise<Response> {
    const ag = this.agent
    const m = this.mcp
    if (ag === undefined || m === undefined || req.method !== "POST" || req.headers.get("x-bf-mcp-agent") === "off") return try await this.chatOnce(req, sink)
    const text = await req.text()
    const hs: Record<string, string> = snapshot(req.headers)
    let streamed = false
    try {
      streamed = rawBool(fields(text), "stream") ?? false
    } catch (e) {
      streamed = false
    }
    if (streamed) return try await this.chatOnce(new Request(req.url, { method: "POST", headers: hs, body: text }), sink)
    const url = req.url
    const last = new LastHeaders()
    const call = async (b: string): Promise<{ status: int, body: string }> => {
      const r = try await this.chatOnce(new Request(url, { method: "POST", headers: hs, body: b }), undefined)
      const kept: Map<string, string> = new Map()
      r.headers.forEach((v, k) => {
        if (k !== "content-length") kept.set(k, v)
      })
      last.h = kept
      return { status: r.status, body: try await r.text() }
    }
    const exec = async (name: string, args: string): Promise<{ text: string, isError: bool }, Error> => {
      const real = injectedChatName(this.cfg, name) ?? name
      const tv = checkToolCall(this.toolGuards, real, args)
      if (!tv.allowed) return { text: `blocked by guardrails: ${tv.reason}`, isError: true }
      const h = snapshot(req.headers)
      const gate = this.toolGate(m, h, real)
      if (gate.kind === "denial") return { text: gate.message, isError: true }
      const ua = try await this.userAuth(real, h, false)
      if (ua.kind === "denial") return { text: ua.message, isError: true }
      const t0 = performance.now()
      const r = try await this.runUser(m, real, args, h, ua)
      this.chargeTool(m, gate, real)
      timedMcp(m, real, t0, r.isError)
      metrics.inc("raiju_mcp_tool_calls_total", metrics.labels("", real, r.isError ? "error" : "success"), 1.0)
      return { text: r.text, isError: r.isError }
    }
    try {
      const r = await runAgent(text, call, exec, ag, m.toolNames().concat(injectedNames(this.cfg)))
      // the last model call's headers (request id, cache, attempts), plus the agent's counts
      const out: Record<string, string> = last.h
      if (!out.has("content-type")) out.set("content-type", "application/json")
      out.set("x-bf-agent-steps", "" + r.steps)
      out.set("x-bf-agent-tool-calls", "" + r.toolCalls)
      return new Response(r.body, { status: r.status, headers: out })
    } catch (e) {
      return errorResponse(502, `agent mode failed: ${e.message}`, "api_error", noHeaders())
    }
  }

  async chatOnce(req: Request, sink?: StreamSink, skipGuards?: bool): Promise<Response> {
    let text = await req.text()
    let body: Field[] = []
    const guardOn = skipGuards !== true
    const guard = guardOn ? this.guard : undefined
    // reversible redaction: one vault per request, so the response restores to this request's values
    const vault = new Vault()
    const reversible = guard !== undefined && guard.mode === "redact" && this.cfg.guardrails?.reversible === true
    // the prompt the request named and the version it got, for the request log
    let promptUsed: Applied | undefined = undefined
    try {
      if (guard !== undefined && this.guardInput && reversible) {
        text = try tokenizeChatRequest(text, guard, vault)
      } else if (guard !== undefined && this.guardInput) {
        const g = applyToChatRequest(text, guard)
        for (const f of g.findings) metrics.inc("raiju_guardrail_findings_total", metrics.labels("", f.kind, guard.mode), 1.0)
        if (g.blocked) {
          const kinds: string[] = []
          for (const f of g.findings) {
            if (!kinds.includes(f.kind)) kinds.push(f.kind)
          }
          return errorResponse(400, `request blocked by guardrails: found ${kinds.join(", ")}`, "guardrail_violation", noHeaders())
        }
        text = g.body
      }
      if (guardOn && this.guardProviders.length > 0) {
        const v = await this.externalGuard(extractText(text), "input")
        if (v.action === "block") return errorResponse(400, `request blocked by guardrails: ${v.reason}`, "guardrail_violation", noHeaders())
        const red = v.text
        // a redaction replaces the prompt when it is a single text message; otherwise it can't be placed
        if (red !== undefined) {
          const one = singleTextMessage(text, red)
          if (one === undefined) return errorResponse(400, `request blocked by guardrails: ${v.reason} (redaction needs a single text message)`, "guardrail_violation", noHeaders())
          text = one
        }
      }
      text = try this.withMcpTools(text, snapshot(req.headers))
      body = fields(text)
      // the prompt named by x-bf-prompt-id goes before the messages (prompts.tov)
      const ph = snapshot(req.headers)
      if (ph.get("x-bf-prompt-id") !== undefined) {
        const vk = this.gov.findKey(ph)
        const applied = try applyPrompt(this.cfg.prompt_repo, ph, text, { budgetPercent: this.gov.budgetFraction(vk) * 100.0, tokensPercent: this.gov.rateFraction(vk, "token") * 100.0, requestsPercent: this.gov.rateFraction(vk, "request") * 100.0 })
        if (applied.prompt_id !== undefined) {
          text = applied.text
          body = try fields(text)
          promptUsed = applied
        }
      }
      // a key's access profile may cap max_tokens
      const cap = this.gov.policyFor(snapshot(req.headers))?.maxTokens
      if (cap !== undefined) {
        let changed = false
        for (const k of ["max_tokens", "max_completion_tokens"]) {
          const raw = find(body, k)
          const n = raw === undefined ? undefined : parseInt(raw)
          if (n === undefined || n > cap) {
            if (raw !== undefined || k === "max_tokens") {
              setField(&body, k, "" + cap)
              changed = true
            }
          }
        }
        if (changed) text = build(body)
      }
      // x-bf-passthrough-extra-params: true merges the body's extra_params object into the request, so
      // provider fields that are not in the chat schema reach the provider (Bifrost's SDK gate)
      if (req.headers.get("x-bf-passthrough-extra-params") === "true") {
        const ep = find(body, "extra_params")
        if (ep !== undefined && ep.startsWith("{")) {
          for (const f of try fields(ep)) setField(&body, f.key, f.raw)
          body = without(body, ["extra_params"])
          text = build(body)
        }
      }
    } catch (e) {
      return errorResponse(400, `invalid chat request: ${e.message}`, "invalid_request_error", noHeaders())
    }
    const chain = this.plugins
    let run: PluginRun | undefined = undefined
    if (chain !== undefined) {
      const r = new PluginRun({ requestId: req.headers.get("x-request-id") ?? newId("req_"), op: "chat", model: rawStr(body, "model") ?? "", provider: "", headers: new Map(), values: new Map() })
      const pre = chain.runPre(&r.ctx, text)
      if (pre.kind === "short_circuit") {
        const post = chain.runPost(&r.ctx, pre.status, pre.body)
        const delay = parseInt(r.ctx.values.get("mock_latency_ms") ?? "0") ?? 0
        if (delay > 0) await sleep(delay)
        const hs: Record<string, string> = new Map()
        hs.set("content-type", pre.contentType)
        hs.set("x-bf-plugin-short-circuit", "true")
        return new Response(post.body, { status: pre.status, headers: hs })
      }
      run = r
      if (pre.body !== text) {
        text = pre.body
        try {
          body = fields(text)
        } catch (e) {
          return errorResponse(500, `a plugin produced an invalid request: ${e.message}`, "api_error", noHeaders())
        }
      }
    }
    // The typed request is only needed to translate for non-OpenAI providers.
    const typed = new LazyChat(text)
    const stream = rawBool(body, "stream") ?? false
    let wantUsage = false
    const so = find(body, "stream_options")
    if (so !== undefined && so.startsWith("{")) {
      try {
        wantUsage = rawBool(fields(so), "include_usage") ?? false
      } catch (e) {
        wantUsage = false
      }
    }
    const autoCache = this.autoPromptCache || req.headers.get("x-bf-prompt-cache-auto-inject") === "true"
    const canPipe = stream && sink !== undefined
    // a provider's own prompt_cache.auto_inject turns the breakpoints on for its requests
    const autoFor = (t: Target): bool => autoCache || (t.cfg.prompt_cache?.auto_inject ?? false)
    // compat: the request for each target, shaped in build (drops and fits, and Responses when the model needs it)
    const cp = new CompatPlan(withHeader(settingsOf(this.cfg.client?.compat), req.headers.get("x-bf-compat") ?? undefined), "chat", stream)
    const sendChat: ChatSender = (t, b, tc) => {
      // Usage is always requested from streaming upstreams, for budgets and metrics.
      let streamBody = b.slice()
      if (stream) setField(&streamBody, "stream_options", `{"include_usage":true}`)
      if (stream && providers.streamsNatively(t.kind)) return openai.chatRequest(t, try this.withInjected(t, streamBody))
      if (stream) {
        const plain = try this.withInjected(t, streamBody.filter((f) => f.key !== "stream" && f.key !== "stream_options"))
        // with a streaming client, Anthropic, Gemini and Bedrock stream too and are converted as they go
        if (canPipe) {
          const su = try providers.streamUpstream(t, try tc.get(), plain, autoFor(t))
          if (su !== undefined) return su
        }
        // otherwise called without streaming and replayed as SSE below
        return try providers.chatUpstream(t, try tc.get(), plain, autoFor(t))
      }
      if (providers.streamsNatively(t.kind)) return openai.chatRequest(t, try this.withInjected(t, b))
      return try providers.chatUpstream(t, try tc.get(), try this.withInjected(t, b), autoFor(t))
    }
    const build: Build = (t) => {
      const sh = try cp.shape(t.provider, t.kind, t.model, body)
      if (sh.route === "responses") return openai.responsesRequest(t, streamedBody(sh.body, canPipe))
      return try sendChat(t, sh.body, sh.changed ? new LazyChat(sh.text) : typed)
    }
    const outGuard = this.guardOutput ? guard : undefined
    const pluginRun = run
    const pluginChain = chain
    const translate: Translate = (t, text, requested) => {
      if (!stream) {
        const sh = try cp.shape(t.provider, t.kind, t.model, body)
        let src = text
        if (sh.route === "responses") {
          const rc = try responseToChat(text, requested)
          src = rc.body
        }
        const tr = try providers.chatTranslate(t.kind, t.model, src, requested, false)
        let out = tr.body
        if (pluginChain !== undefined && pluginRun !== undefined) out = pluginChain.runPost(&pluginRun.ctx, 200, out).body
        if (reversible) out = try restoreCompletion(out, vault)
        if (outGuard === undefined) return { body: out, promptTokens: tr.promptTokens, completionTokens: tr.completionTokens, served: tr.served, billed: tr.billed }
        const g = try applyToCompletion(out, outGuard)
        for (const f of g.findings) metrics.inc("raiju_guardrail_findings_total", metrics.labels("", f.kind, outGuard.mode), 1.0)
        if (g.blocked) throw new SyntaxError("the response was blocked by guardrails")
        return { body: g.body, promptTokens: tr.promptTokens, completionTokens: tr.completionTokens, served: tr.served, billed: tr.billed }
      }
      // a chat request converted to Responses, answered whole (not piped): its chat completion, as SSE
      const shs = try cp.shape(t.provider, t.kind, t.model, body)
      if (shs.route === "responses") {
        const rc = try responseToChat(text, requested)
        return { body: try this.guardWhole(try completionToSse(rc.body, wantUsage), "chat", guardOn), promptTokens: rc.promptTokens, completionTokens: rc.completionTokens }
      }
      if (providers.streamsNatively(t.kind)) {
        const tr = openai.streamResponse(text, requested)
        return { body: try this.guardWhole(wantUsage ? tr.body : dropUsageChunks(tr.body), "chat", guardOn), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens, billed: tr.billed }
      }
      const tr = try providers.chatTranslate(t.kind, t.model, text, requested, false)
      return { body: try this.guardWhole(try completionToSse(tr.body, wantUsage), "chat", guardOn), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
    }
    // With a sink, OpenAI-format upstreams stream straight through as chunks arrive.
    const dropUsage = !wantUsage
    // local output guardrails (regex and secrets) check the stream as it accumulates (guard_stream.tov)
    const outGuards = stream ? this.streamGuards(guardOn) : []
    const jsonOn = stream && this.jsonStreamOn
    const guardedConv = (c: StreamConverter): StreamConverter => {
      if (outGuards.length > 0) c.guard = new OutputStreamGuard(outGuards, "chat")
      if (jsonOn) c.jsonFix = new JsonStreamFixer()
      return c
    }
    const mk: ConverterFactory = (t, requested) => {
      if (!streamable(t)) return undefined
      // a chat request converted to Responses: the Responses events come out as chat chunks
      if (cp.routeFor(t.provider, t.kind, t.model) === "responses") return guardedConv(new StreamConverter("responses", requested, wantUsage))
      const conv = new StreamConverter(converterKind(t), requested, !dropUsage)
      conv.stopAtFinish = quirkStopsAtFinish(t)
      return guardedConv(conv)
    }
    const res = try await this.serve(req, "chat", undefined, body, text, build, translate, stream, run === undefined ? undefined : run.ctx.headers, stream ? sink : undefined, mk, cp, promptUsed)
    // external output guardrails see the whole answer, so they apply to non-streamed answers
    if (!guardOn || this.guardProviders.length === 0 || stream || res.status !== 200) return res
    let answer = ""
    try {
      answer = await res.text()
    } catch (e) {
      return errorResponse(502, `could not read the answer: ${e.message}`, "api_error", noHeaders())
    }
    const v = await this.externalGuard(completionText(answer), "output")
    if (v.action === "block") return errorResponse(400, `response blocked by guardrails: ${v.reason}`, "guardrail_violation", noHeaders())
    let out = answer
    const red = v.text
    if (red !== undefined) out = replaceFirstContent(answer, red)
    const hs: Record<string, string> = new Map()
    res.headers.forEach((value, key) => {
      if (key !== "content-length") hs.set(key, value)
    })
    return new Response(out, { status: 200, headers: hs })
  }

  async embeddings(req: Request): Promise<Response> {
    const text = await req.text()
    let body: Field[] = []
    try {
      body = fields(text)
    } catch (e) {
      return errorResponse(400, `invalid embeddings request: ${e.message}`, "invalid_request_error", noHeaders())
    }
    const build: Build = (t) => {
      if (!providers.supportsEmbeddings(t.kind)) throw new SyntaxError(`${t.provider} does not serve embeddings through this gateway yet`)
      return try providers.embeddingsUpstream(t, body)
    }
    const translate: Translate = (t, text, requested) => try providers.embeddingsTranslate(t.kind, t.model, text, requested)
    return try await this.serve(req, "embeddings", undefined, body, text, build, translate, false)
  }

  async completions(req: Request, sink?: StreamSink): Promise<Response> {
    const text = await req.text()
    let body: Field[] = []
    try {
      body = fields(text)
    } catch (e) {
      return errorResponse(400, `invalid completions request: ${e.message}`, "invalid_request_error", noHeaders())
    }
    const stream = rawBool(body, "stream") ?? false
    const wantUsage = streamUsage(body)
    const canPipe = stream && sink !== undefined
    const cp = new CompatPlan(withHeader(settingsOf(this.cfg.client?.compat), req.headers.get("x-bf-compat") ?? undefined), "completions", stream)
    const build: Build = (t) => {
      const sh = try cp.shape(t.provider, t.kind, t.model, body)
      if (sh.route === "chat") return try textAsChat(t, sh, stream, canPipe)
      if (t.kind === "replicate") return try replicateText(t, body)
      if (!providers.streamsNatively(t.kind)) throw new SyntaxError(`${t.provider} does not serve text completions`)
      return openai.completionsRequest(t, sh.body)
    }
    const translate: Translate = (t, text, requested) => {
      const sh = try cp.shape(t.provider, t.kind, t.model, body)
      if (sh.route === "chat" || t.kind === "replicate") {
        // a chat answer read whole: a stream was sent as SSE (not piped), or a call made without streaming
        if (text.startsWith("data:")) {
          const sr = openai.streamResponse(text, requested)
          return { body: try this.guardWhole(chatSseToText(sr.body), "text", stream), promptTokens: sr.promptTokens, completionTokens: sr.completionTokens }
        }
        const tr = try providers.chatTranslate(t.kind, t.model, text, requested, false)
        if (!stream) return { body: try chatToText(tr.body), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
        return { body: try this.guardWhole(chatSseToText(try completionToSse(tr.body, wantUsage)), "text", true), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
      }
      if (stream) {
        const sr = openai.streamResponse(text, requested)
        return { body: try this.guardWhole(sr.body, "text", true), promptTokens: sr.promptTokens, completionTokens: sr.completionTokens }
      }
      if (sh.route !== "chat") return try openai.chatResponse(text, requested)
      const tr = try providers.chatTranslate(t.kind, t.model, text, requested, false)
      return { body: try chatToText(tr.body), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
    }
    // a text completion sent to a chat model streams as text_completion chunks, converted as they arrive
    // the local output guards check the streamed text (guard_stream.tov), in the text completion frames
    const tg = stream ? this.streamGuards(true) : []
    const mk: ConverterFactory = (t, requested) => {
      if (!streamable(t)) return undefined
      const conv = new StreamConverter(converterKind(t), requested, wantUsage)
      conv.txt = cp.routeFor(t.provider, t.kind, t.model) === "chat"
      if (tg.length > 0) conv.guard = new OutputStreamGuard(tg, "text")
      return conv
    }
    return try await this.serve(req, "completions", undefined, body, text, build, translate, stream, undefined, canPipe ? sink : undefined, mk, cp)
  }
}

async function sendSpans(url: string, headers: Map<string, string>, body: string, tls: TlsOpts | undefined, timeoutMs: int): Promise<void> {
  try {
    const hs: Record<string, string> = headers
    const res = await fetch(url, { method: "POST", headers: hs, body: body, tls: tls, signal: deadline(timeoutMs).controller.signal })
    await res.text()
    if (!res.ok) console.error(`raiju: trace export returned HTTP ${res.status}`)
  } catch (e) {
    console.error(`raiju: trace export failed: ${e.message}`)
  }
}

// Removes the trailing usage-only chunk the gateway asked for but the caller didn't.
export function dropUsageChunks(sse: string): string {
  return sse.split("\n\n").filter((e) => !(e.startsWith("data: ") && e.includes(`"choices":[]`) && e.includes(`"usage":`))).join("\n\n")
}

test("drops usage-only chunks", () => {
  const s = `data: {"choices":[{"delta":{}}]}\n\ndata: {"choices":[],"usage":{"prompt_tokens":1}}\n\ndata: [DONE]\n\n`
  expect(dropUsageChunks(s)).toBe(`data: {"choices":[{"delta":{}}]}\n\ndata: [DONE]\n\n`)
})

test("raw fields go into extra_fields, JSON bodies embedded and others quoted", () => {
  expect(withRawFields(`{"id":"x"}`, `{"model":"m"}`, `{"a":1}`)).toBe(`{"id":"x","extra_fields":{"raw_request":{"model":"m"},"raw_response":{"a":1}}}`)
  expect(withRawFields(`{}`, undefined, `{"a":1}`)).toBe(`{"extra_fields":{"raw_response":{"a":1}}}`)
  expect(withRawFields(`{"id":"x"}`, `not json`, undefined)).toBe(`{"id":"x","extra_fields":{"raw_request":"not json"}}`)
  // nothing to add, or not a JSON object: unchanged
  expect(withRawFields(`{"id":"x"}`, undefined, undefined)).toBe(`{"id":"x"}`)
  expect(withRawFields(`[1]`, `{}`, undefined)).toBe(`[1]`)
})

test("send-back-raw: the provider setting, overridden per request only when allowed", () => {
  const p: ProviderConfig = { send_back_raw_response: true }
  const cfg: Config = { client: { allow_per_request_raw_override: true } }
  const off: Config = { client: { allow_per_request_raw_override: false } }
  expect(sendBackRaw(hdrs([]), off, p, "response")).toBe(true)
  expect(sendBackRaw(hdrs([]), off, p, "request")).toBe(false)
  expect(sendBackRaw(hdrs([["x-bf-send-back-raw-response", "false"]]), cfg, p, "response")).toBe(false)
  expect(sendBackRaw(hdrs([["x-bf-send-back-raw-request", "true"]]), cfg, p, "request")).toBe(true)
  // the override is ignored unless allowed
  expect(sendBackRaw(hdrs([["x-bf-send-back-raw-response", "false"]]), off, p, "response")).toBe(true)
  expect(sendBackRaw(hdrs([["x-bf-send-back-raw-response", "garbage"]]), cfg, p, "response")).toBe(true)
})

test("direct key target: the caller's key replaces the pool", () => {
  const cfg: Config = { providers: new Map() }
  cfg.providers!.set("anthropic", { keys: [{ value: "pool-key" }] })
  const sel = directTarget(cfg, { provider: "anthropic", model: "claude-x" }, "caller-key")
  expect(sel.t.key.value).toBe("caller-key")
  expect(sel.t.kind).toBe("anthropic")
  expect(sel.keyIndex).toBe(-1)
})

test("store_raw_request_response: the header overrides the provider setting only when allowed", () => {
  const p: ProviderConfig = { store_raw_request_response: true }
  const off: ProviderConfig = {}
  const allow: Config = { client: { allow_per_request_content_storage_override: true } }
  const deny: Config = { client: {} }
  expect(storeRawOn(hdrs([]), deny, p)).toBe(true)
  expect(storeRawOn(hdrs([["x-bf-store-raw-request-response", "false"]]), deny, p)).toBe(true)
  expect(storeRawOn(hdrs([["x-bf-store-raw-request-response", "false"]]), allow, p)).toBe(false)
  expect(storeRawOn(hdrs([["x-bf-store-raw-request-response", "TRUE"]]), allow, off)).toBe(true)
  expect(storeRawOn(hdrs([]), allow, off)).toBe(false)
  expect(storeRawOn(hdrs([["x-bf-store-raw-request-response", "maybe"]]), allow, p)).toBe(true)
})

test("allowed_requests admits only the request types set to true", () => {
  const m: Map<string, bool> = new Map()
  m.set("chat_completion", true)
  m.set("embedding", false)
  const p: ProviderConfig = { custom_provider_config: { base_provider_type: "openai", allowed_requests: m } }
  expect(allowedRequest(p, "chat_completion")).toBe(true)
  expect(allowedRequest(p, "embedding")).toBe(false)
  expect(allowedRequest(p, "chat_completion_stream")).toBe(false)
  expect(allowedRequest({}, "embedding")).toBe(true)
})

test("does_not_send_done_marker without wait_for_usage ends at finish_reason", () => {
  const stop: Target = { provider: "x", kind: "openai", model: "m", key: { value: "" }, cfg: { custom_provider_config: { base_provider_type: "openai", does_not_send_done_marker: true } } }
  const wait: Target = { provider: "x", kind: "openai", model: "m", key: { value: "" }, cfg: { custom_provider_config: { base_provider_type: "openai", does_not_send_done_marker: true, wait_for_usage: true } } }
  expect(quirkStopsAtFinish(stop)).toBe(true)
  expect(quirkStopsAtFinish(wait)).toBe(false)
  const enc = new TextEncoder()
  const conv = new StreamConverter("openai", "openai/m", true)
  conv.stopAtFinish = true
  const a = conv.push(enc.encode(`data: {"model":"x","choices":[{"index":0,"delta":{"content":"hi"},"finish_reason":null}]}\n\ndata: {"model":"x","choices":[{"index":0,"delta":{},"finish_reason":"stop"}]}\n\ndata: {"model":"x","choices":[],"usage":{"prompt_tokens":3,"completion_tokens":4,"total_tokens":7}}\n\n`))
  const b = conv.end()
  const all = a + b
  expect(all.includes(`"content":"hi"`)).toBe(true)
  expect(all.includes("prompt_tokens")).toBe(false)
  expect(all.endsWith("data: [DONE]\n\n")).toBe(true)
  expect(conv.promptTokens()).toBe(0)
})

test("a Responses stream and a chat stream answering a text completion come out as their chunks", () => {
  const rc = new StreamConverter("responses", "openai/m", false)
  const rsse = "event: response.output_text.delta\ndata: {\"delta\":\"hi\"}\n\nevent: response.completed\ndata: {\"response\":{}}\n\n"
  const rout = rc.push(new TextEncoder().encode(rsse)) + rc.end()
  expect(rout.includes(`"delta":{"content":"hi"}`)).toBe(true)
  expect(rout.endsWith("data: [DONE]\n\n")).toBe(true)
  const tc = new StreamConverter("openai", "openai/m", false)
  tc.txt = true
  const csse = `data: {"id":"c","object":"chat.completion.chunk","created":1,"model":"m","choices":[{"index":0,"delta":{"content":"yo"},"finish_reason":null}]}\n\n`
  const tout = tc.push(new TextEncoder().encode(csse)) + tc.end()
  expect(tout.includes(`"text":"yo"`) && tout.includes(`"object":"text_completion"`)).toBe(true)
  expect(tout.endsWith("data: [DONE]\n\n")).toBe(true)
})

test("finishes sees a non-null finish_reason only", () => {
  expect(finishes(`{"choices":[{"delta":{},"finish_reason":"stop"}]}`)).toBe(true)
  expect(finishes(`{"choices":[{"delta":{"content":"a"},"finish_reason":null}]}`)).toBe(false)
  expect(finishes(`{"choices":[],"usage":{"prompt_tokens":1}}`)).toBe(false)
  expect(finishes("not json finish_reason")).toBe(false)
})

test("per-provider limiters follow concurrency_and_buffer_size and carry over unchanged", () => {
  const off: Map<string, ProviderConfig> = new Map()
  off.set("plain", {})
  expect(limitersFor({ providers: off, client: { drop_excess_requests: true } }).size).toBe(1)
  expect(limitersFor({ providers: off }).size).toBe(0)
  const ps: Map<string, ProviderConfig> = new Map()
  ps.set("slow", { concurrency_and_buffer_size: { concurrency: 2, buffer_size: 4 } })
  ps.set("plain", {})
  const cfg: Config = { providers: ps, client: { drop_excess_requests: true } }
  const made = limitersFor(cfg)
  // with drop on, the provider without a queue gets Bifrost's default one
  expect(made.size).toBe(2)
  expect(made.get("plain")!.limit).toBe(1000)
  expect(made.get("plain")!.buffer).toBe(5000)
  expect(made.get("slow")!.limit).toBe(2)
  expect(made.get("slow")!.buffer).toBe(4)
  expect(made.get("slow")!.drop).toBe(true)
  const again = limitersFor(cfg)
  const kept = carryLimiters(again, made)
  expect(kept.get("slow") === made.get("slow")).toBe(true)
  const changed: Map<string, ProviderConfig> = new Map()
  changed.set("slow", { concurrency_and_buffer_size: { concurrency: 3, buffer_size: 4 } })
  const moved = carryLimiters(limitersFor({ providers: changed }), made)
  expect(moved.get("slow")!.limit).toBe(3)
  expect(moved.get("slow") === made.get("slow")).toBe(false)
})

test("injected tools are named as configured and point at their MCP tool", () => {
  const all = [`{"type":"function","function":{"name":"weather-get_weather","description":"d","parameters":{"type":"object"}}}`]
  const it: InjectedTool = { name: "forecast", mcp_client_name: "weather", tool_name: "get_weather" }
  const def = try injectedDef(all, it)
  expect(def !== undefined).toBe(true)
  expect(def!.includes(`"name":"forecast"`)).toBe(true)
  expect(def!.includes("weather-get_weather")).toBe(false)
  const missing = try injectedDef(all, { name: "x", mcp_client_name: "nope", tool_name: "y" })
  expect(missing === undefined).toBe(true)
  const ps: Map<string, ProviderConfig> = new Map()
  ps.set("p", { injected_tools: [it] })
  expect(injectedNames({ providers: ps }).includes("forecast")).toBe(true)
  expect(injectedChatName({ providers: ps }, "forecast")).toBe("weather-get_weather")
  expect(injectedChatName({ providers: ps }, "other") === undefined).toBe(true)
})

test("x-bf-mcp-include-tools: a list of client-tool names, client-* wildcards, and an empty list", () => {
  const search = `{"type":"function","function":{"name":"search-find","parameters":{"type":"object"}}}`
  const fetchTool = `{"type":"function","function":{"name":"search-fetch","parameters":{"type":"object"}}}`
  const weather = `{"type":"function","function":{"name":"weather-get","parameters":{"type":"object"}}}`
  expect(includeToolNames(" search-find, weather-* ,").join("|")).toBe("search-find|weather-*")
  expect(includeToolNames("").length).toBe(0)
  const one = ["search-find"]
  expect(try toolInList(search, one)).toBe(true)
  expect(try toolInList(fetchTool, one)).toBe(false)
  expect(try toolInList(weather, ["weather-*"])).toBe(true)
  expect(try toolInList(search, ["weather-*"])).toBe(false)
  expect(try toolInList(search, ["search"])).toBe(false)
  expect(try toolInList(search, [])).toBe(false)
})
