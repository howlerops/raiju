          }
        }
        last = { ok: false, status: status === 0 ? 502 : status, body: text.startsWith("{") ? text : errorJson(text === "" ? `${ref.provider} returned HTTP ${status}` : text, "api_error", undefined), contentType: "application/json", provider: ref.provider, model: ref.model, promptTokens: 0, completionTokens: 0, attempts: attempts, upstreamMs: upstreamMs }
        last.retryMs = hintMs
        // the body of a large request was consumed by this attempt: it cannot be sent again
        if (ctx.large !== undefined) return last
        const d = status === 0 ? "retry" : try classify(status)
        if (d === "fail") return last
        if (d === "fallback") break
        if (d === "rotate") {
          if (sel.keyIndex < 0 || pinned !== undefined) break
          metrics.observeRotation(ref.provider, ref.model, t.key.id ?? "", t.key.name ?? "", metrics.errorTypeForStatus(status))
          if (soft !== undefined) {
            // the sticky key stopped working: drop the binding and pick normally
            soft = undefined
            const sid = sessionId(h)
            if (aff !== undefined && sid !== undefined) aff.forget(sid)
          }
          tried.add(sel.keyIndex)
          continue
        }
        // retry
        if (retry >= retries) break
        await sleep(backoffMs(p, retry, retryAfter))
        retry += 1
      }
    }
    last.attempts = attempts
    last.upstreamMs = upstreamMs
    return last
  }

  // Downloads the plugin URLs a config names that have no local copy, and applies the config again when any arrived.
  async fetchPluginsThenReload(cfg: Config): Promise<void> {
    const r = await fetchPluginUrls(pluginPaths(cfg), cfg.server?.plugin_download_private_allowlist ?? [], true)
    for (const e of r.errors) console.error(`raiju: plugin: ${e}`)
    if (r.fetched > 0 && missingPluginUrls(pluginPaths(this.cfg)).length === 0) this.reload(this.cfg)
  }

  // Applies a changed config (from the management API) without dropping state:
  // budget and rate-limit usage, key health, the response cache, the request log,
  // the tracer and MCP connections all carry over.
  reload(cfg: Config): void {
    // a plugin URL this process has no copy of (a config saved by another node) is downloaded, then the config is
    // applied again with it (plugindl.tov); a download that fails leaves the plugin out, as at the start
    const missing = missingPluginUrls(pluginPaths(cfg))
    if (missing.length > 0) this.fetchPluginsThenReload(cfg)
    const fresh = new Engine(cfg)
    fresh.gov.carryUsage(this.gov)
    if (this.sharedWindows) fresh.gov.alignWindows()
    this.cfg = cfg
    this.gov = fresh.gov
    this.pricing = fresh.pricing
    // a datasheet fetched at runtime carries over
    const rows = this.catalogRows
    if (rows !== undefined) this.pricing.replaceCatalog(rows)
    this.rules = fresh.rules
    // the breakers keep their state; the policies follow the config
    this.health.replacePolicies(fresh.health.policyList())
    // holds exist only under adaptive load balancing: turning it off drops the holds kept here
    if (cfg.health?.adaptive !== true) this.health.holds.forget(Date.now())
    // the MCP clients follow the config too: a client added since the start gets a session (main connects it)
    const fm = fresh.mcp
    if (fm === undefined) this.mcp = undefined
    else if (this.mcp === undefined) this.mcp = fm
    else {
      const cur = this.mcp
      cur.follow(fm.sessions)
      cur.setInstructionCaps(cfg.mcp?.max_instructions_per_client ?? 0, cfg.mcp?.max_instructions_total ?? 0)
    }
    this.large = fresh.large
    this.guard = fresh.guard
    this.guardInput = fresh.guardInput
    this.guardOutput = fresh.guardOutput
    this.autoPromptCache = fresh.autoPromptCache
    this.plugins = fresh.plugins
    this.jsonStreamOn = fresh.jsonStreamOn
    this.logRequests = fresh.logRequests
    this.complexity = fresh.complexity
    this.cxStore = fresh.cxStore
    this.guardProviders = fresh.guardProviders
    this.localRules = fresh.localRules
    this.logRules = fresh.logRules
    this.logGuard = fresh.logGuard
    this.toolGuards = fresh.toolGuards
    this.agent = fresh.agent
    this.limiters = carryLimiters(fresh.limiters, this.limiters)
    if (fresh.affinity === undefined) this.affinity = undefined
    else if (this.affinity === undefined) this.affinity = fresh.affinity
    if (this.cache === undefined) this.cache = fresh.cache
    if (this.semantic === undefined) {
      this.semantic = fresh.semantic
      this.semanticCfg = fresh.semanticCfg
    }
    if (this.vstore === undefined) {
      this.vstore = fresh.vstore
      this.vsNs = fresh.vsNs
    }
  }

  // Embeds text with the semantic cache's embedding provider and model.
  async embed(text: string): Promise<f64[]> throws Error {
    const sc = this.cfg.semantic_cache!
    const none: Set<int> = new Set()
    const sel = target(this.cfg, { provider: sc.provider, model: sc.embedding_model }, none, undefined)
    if (sel === undefined) throw new Error(`no key for the embedding model ${sc.provider}/${sc.embedding_model}`)
    const up = try providers.embeddingsUpstream(sel.t, try fields(`{"model":${quote(sc.embedding_model)},"input":${quote(text)}}`))
    const hs: Record<string, string> = up.headers
    const dl = deadline(10000)
    const res = try await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal, proxy: proxyOf(sel.t.cfg), tls: tlsOf(sel.t.cfg), pool: poolOf(sel.t.cfg) })
    const body = try await res.text()
    dl.finish()
    if (!res.ok) throw new Error(`embedding request failed with HTTP ${res.status}`)
    return try parseEmbedding(body)
  }

  // Adds the connected MCP servers' tools to a chat request. x-bf-mcp-include-clients
  // (comma-separated server names) narrows them; "none" leaves the request alone.
  // Bifrost's injected_tools: the provider's MCP tools join each chat request it serves, under their configured names.
  // A client tool with an injected name is replaced. Unchanged when nothing can be injected.
  // Whether a target's request gets the prompt cache breakpoints: the gateway's prompt_cache.auto_inject, the
  // request's x-bf-prompt-cache-auto-inject, or the provider's own prompt_cache.auto_inject.
  cacheAutoFor(req: Request): (t: Target) => bool {
    const on = this.autoPromptCache || req.headers.get("x-bf-prompt-cache-auto-inject") === "true"
    return (t: Target): bool => on || (t.cfg.prompt_cache?.auto_inject ?? false)
  }

  withInjected(t: Target, body: Field[]): Field[] throws SyntaxError {
    const inj = t.cfg.injected_tools ?? []
    const m = this.mcp
    if (inj.length === 0 || m === undefined) return body
    const all = m.allTools()
    const defs: string[] = []
    for (const it of inj) {
      const d = try injectedDef(all, it)
      if (d !== undefined) defs.push(d)
    }
    if (defs.length === 0) return body
    const names: string[] = inj.map((x) => x.name)
    const out: string[] = []
    const existing = find(body, "tools")
    if (existing !== undefined && !isNull(existing)) {
      for (const el of try elements(existing)) {
        const n = try toolFnName(el)
        if (n === undefined || !names.includes(n)) out.push(el)
      }
    }
    for (const d of defs) out.push(d)
    let fs = body
    setField(&fs, "tools", "[" + out.join(",") + "]")
    return fs
  }

  withMcpTools(text: string, h: Hdrs): string throws SyntaxError {
    const m = this.mcp
    if (m === undefined) return text
    const tools = try this.mcpToolsFor(m, h)
    if (tools.length === 0) return text
    const withTools = try injectTools(text, tools)
    return try this.withMcpInstructions(withTools, m, h, tools)
  }

  // A Responses request with the MCP tools in the Responses shape (a tool the request already names stays as it
  // is) and the servers' instructions appended to its own instructions, as Bifrost's ParseAndAddToolsToRequest.
  withMcpResponses(text: string, h: Hdrs): string throws SyntaxError {
    const m = this.mcp
    if (m === undefined) return text
    const tools = try this.mcpToolsFor(m, h)
    if (tools.length === 0) return text
    let fs = try fields(text)
    const names: string[] = []
    const out: string[] = []
    const existing = find(fs, "tools")
    if (existing !== undefined && !isNull(existing)) {
      for (const el of try elements(existing)) {
        out.push(el)
        const ef = try fields(el)
        const n = rawStr(ef, "name") ?? rawStr(try fields(find(ef, "function") ?? "{}"), "name")
        if (n !== undefined) names.push(n)
      }
    }
    for (const t of tools) {
      const tf = try fields(t)
      const fn = try fields(find(tf, "function") ?? "{}")
      const n = rawStr(fn, "name") ?? ""
      if (n === "" || names.includes(n)) continue
      names.push(n)
      let rt: Field[] = [{ key: "type", raw: find(tf, "type") ?? "\"function\"" }, { key: "name", raw: quote(n) }]
      const d = find(fn, "description")
      if (d !== undefined && !isNull(d)) rt.push({ key: "description", raw: d })
      const p = find(fn, "parameters")
      if (p !== undefined && !isNull(p)) rt.push({ key: "parameters", raw: p })
      const st = find(fn, "strict")
      if (st !== undefined && !isNull(st)) rt.push({ key: "strict", raw: st })
      out.push(build(rt))
    }
    setField(&fs, "tools", "[" + out.join(",") + "]")
    const parts = m.instructionParts(this.gov.policyFor(h)?.mcpTools, this.keyMcp(h), this.projectMcp(h)).filter((p) => tools.some((t) => t.includes(`"name":"${p.name}-`)))
    const block = parts.length === 0 ? "" : m.renderInstructions(parts)
    if (block !== "") {
      const own = rawStr(fs, "instructions") ?? ""
      setField(&fs, "instructions", quote(own === "" ? block : own + "\n\n" + block))
    }
    return build(fs)
  }

  // The MCP tools a request is offered (chat tool definitions): the key's rules, then x-bf-mcp-include-clients and
  // x-bf-mcp-include-tools; the code mode meta-tools stand in for the code mode clients' tools.
  mcpToolsFor(m: McpManager, h: Hdrs): string[] throws SyntaxError {
    // Bifrost's client.mcp_disable_auto_tool_inject: tools are added only when the request names its clients or tools
    const named = h.get("x-bf-mcp-include-clients") !== undefined || h.get("x-bf-mcp-include-tools") !== undefined
    if (this.cfg.client?.mcp_disable_auto_tool_inject === true && !named) return []
    // a key's access profile may limit the MCP tools it gets; clients it doesn't name
    // count only with allow_by_default
    let tools = m.allToolsFor(this.gov.policyFor(h)?.mcpTools, this.keyMcp(h), this.projectMcp(h))
    const only = h.get("x-bf-mcp-include-clients")
    if (only !== undefined) {
      if (only.trim() === "none") return []
      const names = only.split(",").map((n) => n.trim() + "-")
      tools = tools.filter((t) => names.some((n) => t.includes(`"name":"${n}`)))
    }
    // x-bf-mcp-include-tools: "<client>-<tool>" or "<client>-*" entries; the request's tool list
    // is narrowed to them (Bifrost's MCPContextKeyIncludeTools; an empty list includes no tool)
    const onlyTools = h.get("x-bf-mcp-include-tools")
    if (onlyTools !== undefined) {
      const want = includeToolNames(onlyTools)
      const kept: string[] = []
      for (const t of tools) {
        const listed = try toolInList(t, want)
        if (listed) kept.push(t)
      }
      tools = kept
    }
    // code mode: the four meta-tools stand in for the code mode clients' tools (not when the request narrows them)
    if (only === undefined && onlyTools === undefined && this.codeEntriesFor(m, h).length > 0) {
      for (const d of metaToolDefs()) tools.push(d)
    }
    return tools
  }

  // The instructions the connected MCP servers sent (capped as mcp.max_instructions_* say) go to the model
  // as a system message ahead of the caller's own, for the servers that still offer a tool in this request.
  withMcpInstructions(text: string, m: McpManager, h: Hdrs, tools: string[]): string throws SyntaxError {
    const parts = m.instructionParts(this.gov.policyFor(h)?.mcpTools, this.keyMcp(h), this.projectMcp(h)).filter((p) => tools.some((t) => t.includes(`"name":"${p.name}-`)))
    if (parts.length === 0) return text
    const block = m.renderInstructions(parts)
    if (block === "") return text
    let fs = try fields(text)
    const mraw = find(fs, "messages")
    if (mraw === undefined || isNull(mraw)) return text
    const items = try elements(mraw)
    items.unshift(`{"role":"system","content":${quote(block)}}`)
    setField(&fs, "messages", "[" + items.join(",") + "]")
    return build(fs)
  }

  // The code mode servers a caller may reach, as the stubs and the runner name them.
  codeEntriesFor(m: McpManager, h: Hdrs): CodeEntry[] {
    return codeEntries(m.codeToolsFor(this.gov.policyFor(h)?.mcpTools, this.keyMcp(h), this.projectMcp(h)))
  }

  // One MCP tool call for a request, with the gates a direct call gets: the guardrails on the call, the
  // key's MCP rules and budgets, and per-user auth. auto is the agent's auto-execute list when the call runs
  // unattended (a code mode program in the agent loop); undefined for a call a client made.
  async mcpCall(m: McpManager, h: Hdrs, real: string, args: string, auto: string[] | undefined): Promise<ToolText> throws Error {
    const tv = checkToolCall(this.toolGuards, real, args)
    if (!tv.allowed) return { text: `blocked by guardrails: ${tv.reason}`, isError: true }
    if (auto !== undefined && !autoListed(auto, real)) return { text: `tool ${real} is not auto-executed`, isError: true }
    const gate = this.toolGate(m, h, real)
    if (gate.kind === "denial") return { text: gate.message, isError: true }
    const ua = try await this.userAuth(real, h, false)
    if (ua.kind === "denial") return { text: ua.message, isError: true }
    const t0 = performance.now()
    const r = try await this.runUser(m, real, args, h, ua)
    this.chargeTool(m, gate, real)
    timedMcp(m, real, t0, r.isError)
    metrics.inc("raiju_mcp_tool_calls_total", metrics.labels("", real, r.isError ? "error" : "success"), 1.0)
    return { text: r.text, isError: r.isError }
  }

  // A code mode meta-tool call: listToolFiles, readToolFile, getToolDocs or executeToolCode. The tool calls a
  // program makes run through mcpCall, so they are gated, budgeted, guarded and logged like direct calls.
  async codeMetaTool(m: McpManager, h: Hdrs, name: string, argsJson: string, auto: string[] | undefined): Promise<ToolText> throws Error {
    const entries = this.codeEntriesFor(m, h)
    const level = bindingLevelOf(this.cfg.mcp?.code_mode_binding_level)
    const lim = limitsOf(this.cfg.mcp?.code_mode_limits)
    // tool_execution_timeout bounds the whole program, as Bifrost's per-execution timeout does
    const deadline = Date.now() + 1000.0 * (this.cfg.mcp?.tool_execution_timeout_seconds ?? 30)
    const host = async (server: string, tool: string, args: string): Promise<ToolText, Error> => {
      return try await this.mcpCall(m, h, chatToolName(server, tool), args, auto)
    }
    return await runMeta(name, argsJson, entries, level, lim, deadline, host)
  }

  // The gate of one MCP tool call: the key's MCP rules (access profile patterns and mcp_configs) must
  // allow the tool, and the key's budgets must have room. A tool the gateway does not expose is left to
  // execution, which reports it as unknown.
  toolGate(m: McpManager, h: Hdrs, name: string, via?: string): Grant | Denial {
    if (m.hasTool(name) && !m.mayRun(this.gov.policyFor(h)?.mcpTools, this.keyMcp(h, via), name, this.projectMcp(h, via))) {
      return { kind: "denial", status: 403, type: "permission_error", message: `tool ${name} is not allowed for this key` }
    }
    const client = this.perUserClient(name)
    if (client !== undefined && this.userHeaders(name, h) === undefined) {
      // the caller is sent the submission page of a flow opened for its identity (Bifrost's inline 401 with the link)
      const id = this.headersIdentity(h)
      if (id.vk === "" && id.session === "" && id.user === "") {
        return { kind: "denial", status: 401, type: "authentication_error", message: `per-user headers for ${client} requires an identity: send a Virtual Key (x-bf-vk), authenticate as a user, or set x-bf-mcp-session-id to any opaque string you'll re-send on subsequent calls` }
      }
      const open = this.headersAuth
      const link = open === undefined ? "" : open(client, id.vk, id.session, id.user, originOf(h))
      if (link !== "") return { kind: "denial", status: 401, type: "authentication_error", message: link }
      return { kind: "denial", status: 401, type: "authentication_error", message: `the per-user headers of MCP client ${client} are not submitted for this caller: open a submission with POST /api/mcp/per-user-headers/flows` }
    }
    return this.gov.admitTool(h)
  }

  // The MCP tool rules of the request's virtual key, as mcp.tov judges them (undefined: not limited). A key with no
  // mcp_configs gets no tools but those of allow_by_default clients, as in Bifrost (an empty grant), unless its access
  // profiles name tools (they decide then) or the call comes through a virtual MCP the key was given (via: the
  // virtual MCP's own allowed keys decide). A request without a virtual key is not limited here.
  keyMcp(h: Hdrs, via?: string): McpKeyConfig[] | undefined {
    const vk = this.gov.findKey(h)
    if (vk === undefined) return undefined
    const own = vk.mcp_configs
    if (own !== undefined) return own
    if (via !== undefined || this.gov.policyFor(h)?.mcpTools !== undefined) return undefined
    return []
  }

  // The MCP access of the project the request names (its mcp_configs and access_rule); undefined when it names
  // none. via is the virtual MCP a call comes through: one the project is assigned lets the project's part pass.
  projectMcp(h: Hdrs, via?: string): ProjectMcp | undefined {
    const p = this.gov.projectFor(h)
    if (p === undefined) return undefined
    const v = via !== undefined && (p.virtual_mcps ?? []).includes(via)
    return { rule: p.access_rule ?? "union", keys: p.mcp_configs ?? [], via: v ? true : undefined }
  }

  // The per_user_headers client a tool belongs to; undefined for the tools of any other client.
  perUserClient(name: string): string | undefined {
    const hit = splitToolName(name, perUserClientNames(this.cfg.mcp?.client_configs))
    return hit === undefined ? undefined : hit.server
  }

  // The header values the calling key submitted for the tool's per_user_headers client; undefined when the
  // tool belongs to no such client or the key has submitted none.
  userHeaders(name: string, h: Hdrs): Map<string, string> | undefined {
    const client = this.perUserClient(name)
    if (client === undefined) return undefined
    const id = this.headersIdentity(h)
    return userHeadersFor(this.cfg.mcp?.user_credentials, client, id.vk, id.session, id.user)
  }

  // The identity per-user headers are kept under, as per-user OAuth tokens are (identityOf): the x-bf-mcp-session-id
  // header, else the user of a user-mode MCP token, else the virtual key.
  headersIdentity(h: Hdrs): { vk: string, session: string, user: string } {
    return identityOf(h.get("x-bf-mcp-session-id"), this.gov.findKey(h)?.id ?? "", userOfMark(h.get(USER_HEADER)))
  }

  // The caller's token for a tool of a per_user_oauth client. "none" for other tools; "bearer" with the token to
  // call with (an expiring token is refreshed first and saved); "denial" with the consent link the caller must
  // open. force refreshes the token whatever its expiry (used after the server answered 401).
  async userAuth(name: string, h: Hdrs, force: bool): Promise<UserAuth> {
    const te = splitToolName(name, tokenExchangeNames(this.cfg.mcp?.client_configs))
    if (te !== undefined) return await this.exchangeAuth(te.server, h, force)
    const hit = splitToolName(name, perUserOAuthNames(this.cfg.mcp?.client_configs))
    if (hit === undefined) return userAuthOf("none", "", 0, "", "")
    const client = hit.server
    const vk = this.gov.findKey(h)?.id ?? ""
    // a user-mode MCP token names its user (ops.tov mcp); the session header and the key come after it (identityOf)
    const ident = identityOf(h.get("x-bf-mcp-session-id"), vk, userOfMark(h.get(USER_HEADER)))
    if (ident.vk === "" && ident.session === "" && ident.user === "") return userAuthOf("denial", "", 401, "authentication_error", `per-user OAuth for MCP client ${client} needs a virtual key (x-bf-vk) or an x-bf-mcp-session-id header`)
    const now = Date.now()
    const row = userTokenOf(this.cfg.mcp?.user_tokens, client, ident.vk, ident.session, ident.user)
    const act = force && row !== undefined && row.refresh_token !== "" ? "refresh" : tokenAction(row, now)
    const a = authOfClient(this.cfg, client)
    if (act === "valid" && row !== undefined) return userAuthOf("bearer", row.access_token, 0, "", "")
    if (act === "refresh" && a !== undefined && row !== undefined) {
      try {
        const fresh = try await refreshUserRow(a, row, now)
        this.saveUserRow(fresh)
        return userAuthOf("bearer", fresh.access_token, 0, "", "")
      } catch (e) {
        // the refresh failed: the caller has to consent again
      }
    }
    const base = originOf(h)
    const tempOn = this.cfg.client?.mcp_enable_temp_token_auth === true
    const start: McpAuthConfig = a ?? { type: "oauth" }
    const r = startUserFlow(start, client, ident.vk, ident.session, base, tempOn, now, ident.user)
    if (r.flow === undefined) return userAuthOf("denial", "", 401, "authentication_error", r.error)
    const f = r.flow!
    // a user-mode flow carries no temp token: the user opens it signed in
    return userAuthOf("denial", "", 401, "authentication_error", consentMessage(client, consentLink(base, f.id, f.temp_token), f.temp_token !== ""))
  }

  // The caller's identity-provider token: the Authorization bearer, when it is a JWT (an identity provider's
  // access token) and not the caller's virtual key. Provider keys and the admin secret are not JWTs, so they
  // never reach the identity provider. "" when the request carries no such token.
  subjectOf(h: Hdrs): string {
    const a = h.get("authorization") ?? ""
    if (!a.startsWith("Bearer ")) return ""
    const t = a.slice(7).trim()
    if (t.split(".").length !== 3 || t.includes(" ")) return ""
    const only: Hdrs = new Map()
    only.set("authorization", a)
    if (this.gov.findKey(only) !== undefined) return ""
    return t
  }

  // The token for a tool of a token_exchange client: the caller's identity-provider token exchanged for one
  // scoped to the client's audience. Cached per client, caller and subject until shortly before it expires;
  // force drops the cached token (after the server answered 401).
  async exchangeAuth(client: string, h: Hdrs, force: bool): Promise<UserAuth> {
    let te: McpTokenExchange | undefined = undefined
    for (const c of this.cfg.mcp?.client_configs ?? []) {
      if (c.name === client) te = c.token_exchange
    }
    if (te === undefined) return userAuthOf("denial", "", 401, "authentication_error", `MCP client ${client} has no token_exchange settings`)
    const subject = this.subjectOf(h)
    if (subject === "") return userAuthOf("denial", "", 401, "authentication_error", `MCP client ${client} exchanges the caller's identity-provider token: send it as the Authorization bearer, with the virtual key in x-bf-vk`)
    const vk = this.gov.findKey(h)?.id ?? ""
    const now = Date.now()
    const key = exchangeKey(client, vk, subject)
    if (force) this.exchanges.drop(key)
    const hit = this.exchanges.get(key, now)
    if (hit !== undefined) return userAuthOf("bearer", hit, 0, "", "")
    const oc = this.cfg.oidc
    const r = await exchangeToken(te, subject, this.idp, oc?.issuer ?? "", oc?.client_id ?? "", oc?.client_secret ?? "")
    if (r.error !== "") return userAuthOf("denial", "", 401, "authentication_error", `token exchange for MCP client ${client} failed: ${r.error}`)
    this.exchanges.put(key, r.token, r.expiresIn, now)
    return userAuthOf("bearer", r.token, 0, "", "")
  }

  // Keeps a token row the gateway obtained; the server's saver writes it to the config file.
  saveUserRow(row: McpUserToken): void {
    const f = this.userTokenSaved
    if (f !== undefined) f(row)
  }

  // When a retained admin credential is due for renewal, in epoch milliseconds (0: never). A node that does not own
  // the client's renewal waits ADMIN_TAKEOVER_MS more, so the owner's renewal comes first.
  adminDueAt(r: McpUserToken): f64 {
    const at = renewAt(r)
    if (at <= 0.0) return 0.0
    const owns = this.adminOwns
    return owns === undefined || owns(r.mcp_client_name) ? at : at + ADMIN_TAKEOVER_MS
  }

  // Whether a retained admin credential is due now: its time has come and no retry holds it.
  private adminDue(r: McpUserToken, nowMs: f64): bool {
    const at = this.adminDueAt(r)
    return at > 0.0 && at <= nowMs && (this.adminRetry.get(r.mcp_client_name) ?? 0.0) <= nowMs
  }

  // The retained admin credential of a client as this process holds it.
  private adminRowNow(client: string): McpUserToken | undefined {
    return adminRowOf(this.cfg.mcp?.exchange_admin, client)
  }

  // Takes the credential the config file holds for a client when it is newer than the one held here: a worker of
  // this node, or a node, renewed it and saved it.
  private adoptStored(client: string): void {
    const read = this.adminStored
    if (read === undefined) return
    const stored = read(client)
    if (stored === undefined) return
    const cur = this.adminRowNow(client)
    if (cur !== undefined) {
      // a marked credential keeps its renewal time, so a mark is a change of its own
      if (stored.last_refreshed_at < cur.last_refreshed_at) return
      if (stored.last_refreshed_at === cur.last_refreshed_at && needsReverify(stored) === needsReverify(cur)) return
    }
    this.setAdminRow(stored, false)
  }

  // Puts a credential in place of the one held for its client, in the config in memory and in the running session,
  // and saves it (adminSaved). publish sends it to the other nodes (a renewal does; a credential from them does not).
  private setAdminRow(row: McpUserToken, publish: boolean): void {
    let c = this.cfg
    if (!tokenExchangeNames(c.mcp?.client_configs).includes(row.mcp_client_name)) return
    let m = c.mcp ?? {}
    let next: McpUserToken[] = []
    let found = false
    for (const r of m.exchange_admin ?? []) {
      if (r.mcp_client_name === row.mcp_client_name) {
        next.push(row)
        found = true
      } else {
        next.push(r)
      }
    }
    if (!found) next.push(row)
    m.exchange_admin = next
    c.mcp = m
    this.cfg = c
    const live = this.mcp
    if (live !== undefined) live.setAdmin(row)
    const f = this.adminSaved
    if (f !== undefined) f(row)
    if (publish) {
      const p = this.adminPublish
      if (p !== undefined) p(row)
    }
    this.scheduleAdminRenewal()
  }

  // A credential another node renewed or verified arrives through the cluster state (clusterstate.tov, last writer
  // wins): it takes the place of the one held here, unless that one is the same.
  adoptRemoteAdmin(row: McpUserToken): void {
    const cur = this.adminRowNow(row.mcp_client_name)
    if (cur !== undefined && cur.access_token === row.access_token && cur.refresh_token === row.refresh_token && needsReverify(cur) === needsReverify(row)) return
    this.setAdminRow(row, false)
  }

  // Renews a token_exchange client's retained admin credential with its refresh token. used is the access token the
  // server refused (after a 401), or "" when the renewal is due. A due credential is renewed by its owner node (and by
  // another once ADMIN_TAKEOVER_MS have passed). Within a node the renewal runs under adminLease: a worker that finds
  // it held waits for the holder's result, which it reads from the config file, and renews only when that does not
  // come in ADMIN_WAIT_MS. Returns the token to use ("" when there is none).
  async renewAdminCredential(client: string, used: string): Promise<string> {
    const waitUntil = Date.now() + ADMIN_WAIT_MS
    const name = "mcp-admin:" + client
    for (;;) {
      this.adoptStored(client)
      const row = this.adminRowNow(client)
      if (row === undefined || needsReverify(row)) return ""
      const now = Date.now()
      if (used !== "") {
        if (row.access_token !== used) return row.access_token
      } else if (!this.adminDue(row, now)) {
        return row.access_token
      }
      // after a 401 the owner node is given the time to renew first; the others renew once it has had it
      const owns = this.adminOwns
      if (used !== "" && owns !== undefined && !owns(client) && now < waitUntil) {
        await sleep(ADMIN_POLL_MS)
        continue
      }
      const gen = this.adminLease.take(name, now)
      if (gen < 0) {
        if (now >= waitUntil) {
          this.adminRetry.set(client, now + RENEW_RETRY_MS)
          return ""
        }
        await sleep(ADMIN_POLL_MS)
        continue
      }
      try {
        return await this.renewHeld(client, used)
      } finally {
        this.adminLease.release(name, gen)
      }
    }
  }

  // The renewal itself, by the process that holds the lease: the credential as the config file holds it now, the
  // refresh, the save and the publication to the other nodes.
  private async renewHeld(client: string, used: string): Promise<string> {
    this.adoptStored(client)
    const row = this.adminRowNow(client)
    if (row === undefined || needsReverify(row)) return ""
    const now = Date.now()
    if (used !== "") {
      if (row.access_token !== used) return row.access_token
    } else if (!this.adminDue(row, now)) {
      return row.access_token
    }
    let te: McpTokenExchange | undefined = undefined
    for (const c of this.cfg.mcp?.client_configs ?? []) {
      if (c.name === client && c.auth_type === "token_exchange") te = c.token_exchange
    }
    if (te === undefined) return ""
    const oc = this.cfg.oidc
    const out = await renewAdmin(te, row, this.idp, oc?.issuer ?? "", oc?.client_id ?? "", oc?.client_secret ?? "", now)
    if (!out.changed) {
      this.adminRetry.set(client, Date.now() + RENEW_RETRY_MS)
      console.error(`raiju: mcp ${client}: the admin credential could not be renewed (${out.error}); trying again in ${Math.round(RENEW_RETRY_MS / 1000.0)}s`)
      return ""
    }
    // a refusal is believed only when nothing newer arrived meanwhile: a refresh token that another process has
    // already rotated is the one that counts. In a cluster two nodes can both own the renewal while the membership
    // changes; the other node's rotated credential reaches this one through the cluster state (adoptRemoteAdmin), so
    // a refusal waits up to ADMIN_WAIT_MS for it before the credential is marked needs_reauth.
    this.adoptStored(client)
    let latest = this.adminRowNow(client)
    if (needsReverify(out.row) && this.cfg.cluster !== undefined) {
      const until = Date.now() + ADMIN_WAIT_MS
      while ((latest === undefined || latest.refresh_token === row.refresh_token) && Date.now() < until) {
        await sleep(ADMIN_POLL_MS)
        this.adoptStored(client)
        latest = this.adminRowNow(client)
      }
    }
    if (needsReverify(out.row) && latest !== undefined && latest.refresh_token !== row.refresh_token) return needsReverify(latest) ? "" : latest.access_token
    this.adminRetry.delete(client)
    if (needsReverify(out.row)) console.error(`raiju: mcp ${client}: ${out.row.status_reason ?? ""}; verify the client again`)
    this.setAdminRow(out.row, true)
    return needsReverify(out.row) ? "" : out.row.access_token
  }

  // Sets the timer of the next admin credential renewal (from the config's retained credentials); a config
  // change calls it again.
  scheduleAdminRenewal(): void {
    if (this.adminTimer >= 0) clearTimeout(this.adminTimer)
    this.adminTimer = -1
    const names = tokenExchangeNames(this.cfg.mcp?.client_configs)
    let best: f64 = 0.0
    for (const r of this.cfg.mcp?.exchange_admin ?? []) {
      if (!names.includes(r.mcp_client_name)) continue
      let at = this.adminDueAt(r)
      if (at <= 0.0) continue
      const hold = this.adminRetry.get(r.mcp_client_name) ?? 0.0
      if (hold > at) at = hold
      if (best === 0.0 || at < best) best = at
    }
    if (best <= 0.0) return
    const wait: int = Math.max(0, Math.round(best - Date.now()))
    this.adminTimer = setTimeout(() => {
      this.renewDueAdmins()
    }, wait)
  }

  // Renews every credential that is due, then sets the next timer.
  async renewDueAdmins(): Promise<void> {
    if (this.adminTimer >= 0) clearTimeout(this.adminTimer)
    this.adminTimer = -1
    const names = tokenExchangeNames(this.cfg.mcp?.client_configs)
    for (const r of this.cfg.mcp?.exchange_admin ?? []) {
      if (!names.includes(r.mcp_client_name)) continue
      if (this.adminDue(r, Date.now())) await this.renewAdminCredential(r.mcp_client_name, "")
    }
    this.scheduleAdminRenewal()
  }

  // Runs one tool call with the caller's bearer. A 401 from the server on a per-user call refreshes the token once
  // and runs the call again.
  async runUser(m: McpManager, name: string, args: string, h: Hdrs, ua: UserAuth): Promise<ToolText> throws Error {
    const bearer = ua.kind === "bearer" ? ua.token : undefined
    try {
      return try await m.execute(name, args, h, this.userHeaders(name, h), bearer)
    } catch (e) {
      if (bearer === undefined || !e.message.includes("HTTP 401")) throw e
      const again = try await this.userAuth(name, h, true)
      if (again.kind !== "bearer") throw e
      return try await m.execute(name, args, h, this.userHeaders(name, h), again.token)
    }
  }

  // Debits the tool's tool_pricing cost from the grant's budgets after a call ran. Free tools, and calls
  // with no key, debit nothing.
  chargeTool(m: McpManager, g: Grant | Denial, name: string): void {
    const cost = m.priceOf(name)
    if (cost > 0 && g.kind === "grant") this.gov.record(g, 0, cost)
  }

  // POST /v1/mcp/tool/execute: runs one tool call and answers with the tool message.
  async executeTool(req: Request): Promise<Response> {
    const m = this.mcp
    if (m === undefined) return errorResponse(404, "no MCP servers are configured", "invalid_request_error", noHeaders())
    const text = await req.text()
    try {
      const call = executeEndpointBody(text)
      const tv = checkToolCall(this.toolGuards, call.name, call.argumentsJson)
      if (!tv.allowed) return errorResponse(400, `tool call blocked by guardrails: ${tv.reason}`, "guardrail_violation", noHeaders())
      const h = snapshot(req.headers)
      if (isMetaTool(call.name)) {
        // a code mode meta-tool a client executes itself: nothing is auto-executable here, so the program's
        // tool calls are checked against tools_to_execute only
        const mt = await this.codeMetaTool(m, h, call.name, call.argumentsJson, undefined)
        const mr: Record<string, string> = new Map()
        mr.set("content-type", "application/json")
        return new Response(toolMessage(call.callId ?? "", mt.isError ? "Error: " + mt.text : mt.text), { status: 200, headers: mr })
      }
      const gate = this.toolGate(m, h, call.name)
      if (gate.kind === "denial") return errorResponse(gate.status, gate.message, gate.type, noHeaders())
      const ua = try await this.userAuth(call.name, h, false)
      if (ua.kind === "denial") return errorResponse(ua.status, ua.message, ua.type, noHeaders())
      const t0 = performance.now()
      const result = try await this.runUser(m, call.name, call.argumentsJson, h, ua)
      this.chargeTool(m, gate, call.name)
      timedMcp(m, call.name, t0, result.isError)
      metrics.inc("raiju_mcp_tool_calls_total", metrics.labels("", call.name, result.isError ? "error" : "success"), 1.0)
      const r: Record<string, string> = new Map()
      r.set("content-type", "application/json")
      return new Response(toolMessage(call.callId ?? "", result.text), { status: 200, headers: r })
    } catch (e) {
      if (e instanceof SyntaxError) return errorResponse(400, e.message, "invalid_request_error", noHeaders())
      return errorResponse(502, e.message, "api_error", noHeaders())
    }
  }

  // A Vertex OAuth access token for the key's service account, from the cache
  // or from Google's token endpoint (a signed JWT exchanged for an hour-long token).
  // An IBM Cloud IAM token for a watsonx key, cached until a minute before it expires.
  async watsonxToken(t: Target): Promise<{ token: string, error: string }> {
    const wk = t.key.watsonx_key_config
    if (wk === undefined) return { token: "", error: "watsonx: the key needs watsonx_key_config" }
    const now = Math.floor(Date.now() / 1000)
    const c = this.iamTokens.get(wk.api_key)
    if (c !== undefined && c.expiresAtSec - 60 > now) return { token: c.token, error: "" }
    try {
      let up = watsonx.iamTokenRequest(wk.api_key)
      const iam = wk.iam_url
      if (iam !== undefined && iam !== "") up.url = iam
      const hs: Record<string, string> = up.headers
      const dl = deadline(10000)
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal })
      const text = await res.text()
      dl.finish()
      const tok = watsonx.parseIamToken(text)
      this.iamTokens.set(wk.api_key, tok)
      return { token: tok.token, error: "" }
    } catch (e) {
      return { token: "", error: `watsonx authentication failed: ${e.message}` }
    }
  }

  // A bearer token minted for a key with oauth_key_config, cached until it nears expiry.
  async oauthKeyToken(t: Target, oc: OAuthKeyConfig): Promise<{ token: string, error: string }> {
    return await this.oauthToken(oc, t.cfg)
  }

  // The bearer a key with oauth_key_config and no value sends, minted through the provider's proxy and TLS settings
  // and cached per credential (every field that changes the token) until it nears expiry. Every call the key serves
  // uses it: the routes, the raw passthrough, batches and files.
  async oauthToken(oc: OAuthKeyConfig, pc: ProviderConfig): Promise<{ token: string, error: string }> {
    const key = oauthKey.credentialKey(oc)
    const now = Date.now()
    const cached = this.oauthTokens.get(key, now)
    if (cached !== undefined) return { token: cached, error: "" }
    try {
      const up = oauthKey.tokenRequest(oc, Math.floor(now / 1000))
      const hs: Record<string, string> = up.headers
      const dl = deadline(10000)
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal, proxy: proxyOf(pc), tls: tlsOf(pc), pool: poolOf(pc) })
      const text = await res.text()
      dl.finish()
      const tok = oauthKey.parseOAuthToken(text, now)
      this.oauthTokens.put(key, tok.token, tok.expiresAtMs)
      return { token: tok.token, error: "" }
    } catch (e) {
      return { token: "", error: `oauth_key_config authentication failed: ${e.message}` }
    }
  }

  // A Databricks OAuth (machine-to-machine) token for a key's client_id and client_secret.
  async databricksToken(t: Target): Promise<{ token: string, error: string }> {
    const dk = t.key.databricks_key_config!
    try {
      const host = databricks.workspaceHost(t)
      const key = host + "|" + (dk.client_id ?? "")
      const now = Date.now()
      const cached = this.databricksTokens.get(key, now)
      if (cached !== undefined) return { token: cached, error: "" }
      const up = databricks.oauthTokenRequest(host, dk.client_id ?? "", dk.client_secret ?? "")
      const hs: Record<string, string> = up.headers
      const dl = deadline(10000)
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal, proxy: proxyOf(t.cfg), tls: tlsOf(t.cfg), pool: poolOf(t.cfg) })
      const text = await res.text()
      dl.finish()
      const tok = databricks.parseOAuthToken(text, now)
      this.databricksTokens.put(key, tok.token, tok.expiresAtMs)
      return { token: tok.token, error: "" }
    } catch (e) {
      return { token: "", error: `databricks authentication failed: ${e.message}` }
    }
  }

  // A GitHub Copilot token and the host to call, minted from a GitHub App installation.
  async copilotToken(t: Target): Promise<{ token: string, host: string, error: string }> {
    const gc = t.key.github_copilot_key_config!
    const key = gc.app_id + "|" + gc.installation_id + "|" + gc.repository_id
    const now = Date.now()
    const cached = this.copilotTokens.get(key, now)
    if (cached !== undefined) {
      const nl = cached.indexOf("\n")
      return { host: cached.slice(0, nl), token: cached.slice(nl + 1), error: "" }
    }
    try {
      const domain = gc.github_domain ?? ""
      const api = copilot.githubApiBase(domain)
      const jwt = copilot.appJwt(gc.app_id, gc.private_key, Math.floor(now / 1000))
      const iu = copilot.installationTokenRequest(api, gc.installation_id, gc.repository_id, jwt)
      const ih: Record<string, string> = iu.headers
      const dl = deadline(10000)
      const ir = await fetch(iu.url, { method: "POST", headers: ih, body: iu.body, signal: dl.controller.signal })
      const inst = copilot.parseInstallationToken(await ir.text())
      const cu = copilot.copilotTokenRequest(api, inst.token)
      const ch: Record<string, string> = cu.headers
      const cr = await fetch(cu.url, { method: "GET", headers: ch, signal: dl.controller.signal })
      const tok = copilot.parseCopilotToken(await cr.text(), domain, now / 1000.0)
      dl.finish()
      this.copilotTokens.put(key, tok.baseURL + "\n" + tok.token, tok.expiresAtSec * 1000.0)
      return { token: tok.token, host: tok.baseURL, error: "" }
    } catch (e) {
      return { token: "", host: "", error: `github copilot authentication failed: ${e.message}` }
    }
  }

  // An Entra ID access token for an Azure key with a service principal, cached until a minute before it expires.
  async entraToken(t: Target): Promise<{ token: string, error: string }> {
    const az = t.key.azure_key_config!
    const key = (az.tenant_id ?? "") + "/" + (az.client_id ?? "")
    const now = Date.now()
    const cached = this.entraTokens.get(key, now)
    if (cached !== undefined) return { token: cached, error: "" }
    try {
      const up = cloudAuth.entraTokenRequest(az.tenant_id ?? "", az.client_id ?? "", az.client_secret ?? "", az.scopes ?? [])
      const hs: Record<string, string> = up.headers
      const dl = deadline(10000)
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal })
      const text = await res.text()
      dl.finish()
      const tok = cloudAuth.parseTokenResponse(text, now)
      this.entraTokens.put(key, tok.token, tok.expiresAtMs)
      return { token: tok.token, error: "" }
    } catch (e) {
      return { token: "", error: `azure entra authentication failed: ${e.message}` }
    }
  }

  // Temporary credentials for a Bedrock key's role_arn (STS AssumeRole), cached until they near expiry.
  async assumeRole(bk: BedrockKeyConfig): Promise<{ creds?: cloudAuth.AssumedCreds, error: string }> {
    const role = bk.role_arn ?? ""
    const session = bk.session_name ?? "bifrost-session"
    const key = role + "|" + (bk.external_id ?? "") + "|" + session
    const now = Date.now()
    const cached = this.stsCreds.get(key, now)
    if (cached !== undefined) return { creds: cached, error: "" }
    try {
      const up = cloudAuth.assumeRoleRequest({ accessKey: bk.access_key ?? "", secretKey: bk.secret_key ?? "", sessionToken: bk.session_token }, bk.region ?? "us-east-1", role, bk.external_id, session, 3600, now)
      const hs: Record<string, string> = up.headers
      const dl = deadline(10000)
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal })
      const text = await res.text()
      dl.finish()
      const creds = cloudAuth.parseAssumeRole(text)
      this.stsCreds.put(key, creds, creds.expiresAtMs)
      return { creds: creds, error: "" }
    } catch (e) {
      return { error: `bedrock assume-role failed: ${e.message}` }
    }
  }

  async vertexToken(t: Target): Promise<{ token: string, error: string }> {
    // a token federated from the workload's AWS identity (vertexwif.tov), when the key asks for one
    let plan: vertexWif.WifPlan | undefined = undefined
    try {
      plan = vertexWif.planOf(t.key.vertex_key_config)
    } catch (e) {
      return { token: "", error: `vertex authentication failed: ${e.message}` }
    }
    if (plan !== undefined) return await vertexWif.federatedToken(plan)
    const now = Math.floor(Date.now() / 1000)
    try {
      const sa = parseServiceAccount(t.key.vertex_key_config?.auth_credentials)
      const cached = this.vertexTokens.get(sa.client_email, now)
      if (cached !== undefined) return { token: cached, error: "" }
      const up = this.vertexTokens.tokenRequest(sa, now)
      const hs: Record<string, string> = up.headers
      const res = await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: deadline(10000).controller.signal })
      const text = await res.text()
      this.vertexTokens.store(sa.client_email, text, now)
      return { token: this.vertexTokens.get(sa.client_email, now) ?? "", error: "" }
    } catch (e) {
      return { token: "", error: `vertex authentication failed: ${e.message}` }
    }
  }

  // Applies the first matching routing rule: its weighted target replaces the
  // requested model (keeping a pinned key), and its fallbacks come next.
  route(rules: RuleSet, op: string, refs: ModelRef[], inout h: Hdrs, body: Field[], tier: Tier | undefined): ModelRef[] | undefined {
    const first = refs[0]!
    const vk = this.gov.findKey(h)
    const params: Map<string, string> = new Map()
    for (const f of body) {
      if (!f.raw.startsWith("[") && !f.raw.startsWith("{")) params.set(f.key, f.raw)
    }
    const act: Activation = {
      model: first.model,
      provider: first.provider,
      request_type: op,
      virtual_key: vk?.id,
      team: vk?.team_id,
      customer: vk?.customer_id,
      // percentages, as Bifrost
      budget_used: this.gov.budgetFraction(vk) * 100.0,
      tokens_used: this.gov.rateFraction(vk, "token") * 100.0,
      request_used: this.gov.rateFraction(vk, "request") * 100.0,
      virtual_key_name: vk?.name,
      team_name: this.gov.teamName(vk),
      customer_name: this.gov.customerName(vk),
      complexity_tier: tier,
      headers: h,
      params: params,
    }
    // chain_rule: a matched rule with chain_rule sends its target back through the rules as the new
    // context. The chain ends on a terminal rule, at the depth limit, when nothing matches, or when a step
    // changes neither provider nor model. The last matched rule decides (Bifrost's accumulation).
    const maxDepth = this.cfg.client?.routing_chain_max_depth ?? 10
    let cur: ModelRef = first
    let decided: ModelRef[] | undefined = undefined
    let steps = 0
    while (true) {
      act.model = cur.model
      act.provider = cur.provider
      const m = rules.match(act, { virtual_key: vk?.id, team: vk?.team_id, customer: vk?.customer_id })
      if (m === undefined) break
      const i = pickTarget(m.targets, Math.random())
      if (i < 0) break
      const tg = m.targets[i]!
      const next: ModelRef = { provider: tg.provider, model: tg.model ?? cur.model }
      const out: ModelRef[] = [next]
      for (const f of m.fallbacks) out.push(parseModel(this.cfg, f))
      decided = out
      if (tg.key_id !== undefined) h.set("x-bf-api-key", tg.key_id)
      h.set("x-bf-routing-rule", m.rule)
      if (!m.chain || steps >= maxDepth) break
      steps += 1
      if (next.provider === cur.provider && next.model === cur.model) break
      cur = next
    }
    if (decided === undefined) return undefined
    for (const r of refs.slice(1)) decided.push(r)
    return decided
  }

  // Shared front half of every inference endpoint.
  // emulated: a decision answered by a chat or Responses call (compat's convert_decision_to_responses), billed as that call
  async serve(req: Request, op: string, modelName: string | undefined, body: Field[], text: string, build: Build, translate: Translate, streamed: bool, upstreamHeaders?: Map<string, string>, sink?: StreamSink, makeConverter?: ConverterFactory, compat?: CompatPlan, prompt?: Applied, emulated?: bool, large?: LargeBody, attemptHook?: AttemptPlugins): Promise<Response> {
    const h = snapshot(req.headers)
    const ctx = new ReqCtx(h.get("x-request-id") ?? newId("req_"), op, performance.now())
    ctx.large = large
    ctx.attemptHook = attemptHook
    // the plugin spans and logs: the chat request's plugin run, or the one a hooked route registered for this request
    if (attemptHook !== undefined) ctx.pluginTrace = attemptHook.run.ctx.trace
    else ctx.pluginTrace = this.pluginTraces.get(h.get(TRACE_HEADER) ?? "")
    // large_payload_optimization: a long answer to an ordinary request is not read whole either, unless something
    // here has to see it (output guardrails, plugins)
    const lps = this.large
    if (lps !== undefined && large === undefined && !streamed && (op === "chat" || op === "completions" || op === "embeddings") && !this.guardOutput && this.guardProviders.length === 0 && this.plugins === undefined) ctx.passAbove = lps.responseThreshold
    // a native decision is billed with the decision rates and the overrides that cover decisions
    ctx.decision = op === "decisions" && emulated !== true
    ctx.sink = sink
    ctx.makeConverter = makeConverter
    ctx.compat = compat
    if (prompt !== undefined && prompt.prompt_id !== undefined) {
      ctx.promptId = prompt.prompt_id
      ctx.promptName = prompt.prompt_name ?? ""
      ctx.promptVersion = prompt.version
    }
    ctx.meta = logMetadata(h, this.cfg.client?.logging_headers ?? [])
    const cids = correlationIds(h)
    ctx.parentId = cids.parent
    ctx.agentId = cids.agent
    const ma = maximAttrs(h)
    ctx.maximIds = ma?.ids
    ctx.maximTags = ma?.tags
    if (upstreamHeaders !== undefined) ctx.upstreamHeaders = upstreamHeaders
    const tracer = this.tracer
    if (tracer !== undefined) {
      const sid = sessionId(h)
      const rs = tracer.startRequest(op, h.get("traceparent"), Date.now(), sid)
      tracer.recordRequestHeaders(rs, h)
      if (sid !== undefined) rs.setStr("session.id", sid)
      ctx.span = rs
    }
    ctx.contentOff = this.contentOff(h)
    ctx.streamed = streamed
    // the queue is built at start (as the log store is); the live config can still switch the retention off
    ctx.hidden = ctx.contentOff && this.hiddenQueue !== undefined && this.cfg.client?.retain_content_in_object_storage === true
    ctx.userAgent = h.get("user-agent") ?? ""
    ctx.sessionId = sessionId(h) ?? ""
    if (this.logStore !== undefined && (!ctx.contentOff || ctx.hidden)) ctx.input = text
    // a crew/<pool> model: the task's crew picks the candidate, and the call is served as if that model had been named
    // (crew.tov); the refusals (missing task or role headers, unknown pool or role) are answered here
    const named = modelName ?? rawStr(body, "model") ?? ""
    const pick: CrewPick | undefined = named.startsWith("crew/") ? crewRoute(named, h, text, Date.now(), this.logStore, this.pricing) : undefined
    if (pick !== undefined && pick.status !== 0) return errorResponse(pick.status, pick.message, pick.status === 404 ? "not_found_error" : "invalid_request_error", noHeaders())
    if (pick !== undefined) ctx.crew = pick
    if (pick !== undefined && compat !== undefined) compat.crewEffort = pick.effort
    const callModel = pick === undefined ? modelName : pick.model
    // bifrost_active_requests: in flight from here until the answer (or the throw) is out
    const method = requestType(op, streamed)
    metrics.activeRequests(method, 1.0)
    let res: Response = new Response(undefined, { status: 500 })
    try {
      res = try await this.serveInner(req, h, ctx, callModel, body, text, build, translate, streamed, compat)
    } finally {
      metrics.activeRequests(method, -1.0)
    }
    ctx.status = res.status
    const lg = ctx.large
    if (lg !== undefined && !ctx.deferRecord) {
      // a large request is logged with the truncated copy of its body
      if (this.logStore !== undefined && !ctx.contentOff) ctx.input = lg.tap.previewText()
    }
    if (!ctx.deferRecord) this.record(ctx)
    return res
  }

  // A cached answer as the caller gets it: through the post hooks of the plugins before the cache, when a chat request's
  // plugins ran (an event stream stays as it was cached).
  hitThroughPlugins(ctx: ReqCtx, body: string, contentType: string): PostOutcome {
    const ah = ctx.attemptHook
    if (ah === undefined || contentType.startsWith("text/event-stream")) return { status: 200, body: body }
    return ah.onHit(body)
  }

  async serveInner(req: Request, h0: Hdrs, ctx: ReqCtx, modelName: string | undefined, body: Field[], text: string, build: Build, translate: Translate, streamed: bool, compat?: CompatPlan): Promise<Response> {
    const op = ctx.op
    const started = ctx.started
    let h = h0
    // a classifier's own call that is not charged (count_toward_budgets off): the marker is checked, then taken off
    const noCharge = this.classifierToken !== "" && h.get(NO_CHARGE_HEADER) === this.classifierToken
    h.delete(NO_CHARGE_HEADER)
    const rid = ctx.rid
    let out: Hdrs = new Map()
    out.set("x-bifrost-request-id", rid)
    // Bifrost's tracing middleware echoes the request id as x-request-id too
    out.set("x-request-id", rid)
    out.set("x-bifrost-request-type", requestType(op, streamed))
    // a crew/<pool> call says which candidate, class and attempt it was routed by (crew.tov)
    const crew = ctx.crew
    if (crew !== undefined) {
      out.set("x-raiju-crew-candidate", crew.candidate)
      out.set("x-raiju-crew-class", crew.taskClass)
      out.set("x-raiju-crew-attempt", "" + crew.attempt)
    }
    const span = ctx.span
    if (span !== undefined) out.set("x-bifrost-trace-id", span.traceId)
    const model = modelName ?? rawStr(body, "model")
    ctx.model = model ?? ""
    if (model === undefined) return errorResponse(400, "the request needs a model, e.g. \"openai/gpt-4o-mini\"", "invalid_request_error", out)
    // overhead components (bifrost_overhead_component_microseconds): routing starts here
    const tRoute = performance.now()
    // complexity tier: for routing rules (complexity_tier) and the tier map behind model "auto"
    let tier: Tier | undefined = undefined
    // how the tier was decided, for the request log: a classifier's name, "heuristic" or "override"
    let mechanism = ""
    const cx = this.complexity
    if (cx !== undefined && op === "chat" && ctx.large === undefined) {
      const forced = overrideTier(h)
      if (forced !== undefined) {
        tier = forced
        mechanism = "override"
      } else {
        const d = await this.sessionTier(req, h, text, cx)
        tier = d.tier
        mechanism = d.mechanism
        ctx.complexityScore = d.score
      }
      out.set("x-bf-complexity-tier", tier ?? "MEDIUM")
    }
    // a bare model name resolves through keys, then the catalog, preferring the SDK route's provider
    let refs = [this.refVia(model, routeOf(op))].concat(this.fallbacksOf(body))
    // whether the request named its provider (the model's prefix was taken off), for the provider level below
    let pinnedDir = refs[0]!.model !== model
    if (cx !== undefined && tier !== undefined && model === (cx.model ?? "auto")) {
      const tt = tierTarget(tier, cx.tiers ?? {})
      if (tt !== undefined) {
        refs = [this.refOf(tt)].concat(refs.slice(1))
        pinnedDir = refs[0]!.model !== tt
      }
    }
    if (refs[0]!.provider === "") {
      ctx.error = "no provider for " + model
      return errorResponse(400, "could not auto resolve a provider for the request, please specify a provider explicitly", "invalid_request_error", out)
    }
    // a circuit policy whose circuit is open sends the primary's requests to its fallback (the primary is not tried)
    const open = this.health.policyFallback(refs[0]!.provider, refs[0]!.model, Date.now())
    if (open !== undefined) {
      refs = [{ provider: open.fallback_provider, model: open.fallback_model }].concat(refs.slice(1))
      pinnedDir = true
    }
    const rules = this.rules
    if (rules !== undefined) {
      const routed = this.route(rules, op, refs, &h, body, tier)
      if (routed !== undefined) {
        refs = routed
        pinnedDir = true
        out.set("x-bf-routing-rule", h.get("x-bf-routing-rule") ?? "")
      }
    }
    // adaptive load balancing's provider level (load_balancer_config): healthy directions first, broken
    // fallbacks pruned, healthy providers appended (router.tov directRefs); a pinned key keeps its provider
    if (h.get("x-bf-api-key") === undefined && h.get("x-bf-api-key-id") === undefined) refs = this.directPlan(refs, pinnedDir)
    const routeUs = (performance.now() - tRoute) * 1000.0
    const primary = refs[0]!
    const tGov = performance.now()
    const admitted = this.gov.admit(h, primary.provider, primary.model)
    const govUs = (performance.now() - tGov) * 1000.0
    if (admitted.kind === "denial") {
      ctx.error = admitted.message
      return errorResponse(admitted.status, admitted.message, admitted.type, out)
    }
    // a classifier's uncharged call: its cost stays off the caller's budgets (its rate limits still count it)
    const grant: Grant = noCharge ? { kind: "grant", vk: admitted.vk, budgets: [], rateLimits: admitted.rateLimits, attr: admitted.attr } : admitted
    ctx.virtualKey = grant.vk?.id ?? ""
    ctx.userId = grant.vk?.user_id ?? ""
    ctx.provider = primary.provider
    let rl = metrics.newLabels(primary.provider, primary.model, requestType(op, streamed))
    const gvk = grant.vk
    if (gvk !== undefined) {
      rl.virtualKeyId = gvk.id
      rl.virtualKeyName = gvk.name ?? ""
    }
    // team, customer, business unit and project, as governance attributed them
    const at: Attribution = grant.attr ?? noAttribution()
    ctx.teamId = at.teamId
    ctx.customerId = at.customerId
    ctx.businessUnitId = at.businessUnitId
    ctx.projectId = at.projectId
    rl.teamId = at.teamId
    rl.teamName = at.teamName
    rl.customerId = at.customerId
    rl.customerName = at.customerName
    rl.businessUnitId = at.businessUnitId
    rl.businessUnitName = at.businessUnitName
    rl.projectId = at.projectId
    rl.projectName = at.projectName
    const ruleName = out.get("x-bf-routing-rule")
    if (ruleName !== undefined && ruleName !== "") {
      rl.routingRuleName = ruleName
      rl.routingRuleId = ruleName
      rl.routingEngineUsed = "routing_rule"
    }
    if (tier !== undefined) {
      rl.complexityTier = tier
      rl.complexityMechanism = mechanism
    }
    if (tier !== undefined || (ruleName !== undefined && ruleName !== "")) {
      metrics.observeRouting(ruleName !== undefined && ruleName !== "" ? "routing_rule" : "complexity", tier ?? "", ruleName ?? "")
    }
    if (model !== primary.provider + "/" + primary.model && model !== primary.model) rl.alias = model
    // the app: the caller's x-bf-app, else the one its User-Agent names (the operator's
    // user_agent_mappings first, then Bifrost's built-in identifiers)
    const xApp = h.get("x-bf-app") ?? ""
    rl.app = xApp !== "" ? xApp : appOf(h.get("user-agent") ?? "", this.cfg.user_agent_mappings ?? [])
    ctx.app = rl.app
    rl.userId = ctx.userId
    // the user's name from the admin users (telemetry's user_name; a user's id is its name here)
    rl.userName = this.userName(ctx.userId)
    rl.custom = metrics.customValues(h)
    ctx.labels = rl
    // Fallbacks the key may not use are dropped.
    const allowed: ModelRef[] = [primary]
    for (const r of refs.slice(1)) {
      if (this.gov.admit(h, r.provider, r.model).kind === "grant") allowed.push(r)
    }

    // Budgets cannot count the cost of a model with no price, so with client.refuse_unpriced_models
    // a budgeted request is refused for any unpriced model it may reach (fallbacks included).
    if (grant.budgets.length > 0 && this.cfg.client?.refuse_unpriced_models === true) {
      const no = this.pricing.unpriced(allowed, ctx.decision)
      if (no !== undefined) {
        const msg = `model ${no.provider}/${no.model} has no price, so the budget on this key cannot count it: add a pricing override, or turn off client.refuse_unpriced_models`
        ctx.error = msg
        return errorResponse(403, msg, "permission_error", out)
      }
    }

    const tCache = performance.now()
    // a request streamed to the provider has no text to key a cache on
    const cache = ctx.large === undefined ? this.cache : undefined
    let key = ""
    const noStore = h.get("x-bf-cache-no-store") === "true"
    if (cache !== undefined) {
      const scope = keyScope(op + (h.get("x-bf-cache-key") ?? ""), grant.vk?.id ?? "", this.cfg.cache?.scope_by_virtual_key !== false)
      key = cacheKey(scope, model, text)
      const hit = cache.get(key)
      if (hit !== undefined) {
        metrics.observeCacheHit(ctx.labels, "direct")
        out.set("x-bf-cache", "hit")
        cacheHeaders(&out, "direct", primary, undefined, undefined, cacheId(key), performance.now() - started)
        originHeaders(&out, hit.origin)
        out.set("content-type", hit.contentType)
        ctx.cached = true
        ctx.cacheType = "direct"
        // the post hooks of the plugins before the cache see the cached answer (a cached stream is replayed as it is)
        const hitBody = this.hitThroughPlugins(ctx, hit.body, hit.contentType)
        if (hitBody.status >= 400) {
          out.set("content-type", "application/json")
          return respond(hitBody.status, hitBody.body, out)
        }
        if (this.logStore !== undefined) {
          ctx.stopReason = stopReasonOf(hitBody.body)
          ctx.toolNames = toolNamesOfBody(hitBody.body)
        }
        ctx.output = hitBody.body
        // a cached stream sent to a streamed caller is replayed event by event, paced when a block-capable guard applies
        const pace = this.replayPace()
        const sink = ctx.sink
        if (streamed && sink !== undefined && pace > 0 && hit.contentType.startsWith("text/event-stream")) {
          await this.replayStream(sink, hit.body, out, pace)
          return respond(200, "", out)
        }
        return respond(200, hitBody.body, out)
      }
    }

    // Semantic cache: only for requests that name a cache key (header or config default).
    let semScope = ""
    let semVec: f64[] = []
    const sem = ctx.large === undefined ? this.semantic : undefined
    const semKey = h.get("x-bf-cache-key") ?? this.cfg.semantic_cache?.default_cache_key
    if (sem !== undefined && semKey !== undefined && op === "chat" && h.get("x-bf-cache-type") !== "direct") {
      try {
        const pt = promptText(text, this.semanticCfg)
        if (pt !== undefined) {
          semVec = await this.embed(pt)
          // entries stay with the virtual key that wrote them unless disable_identity_scoping
          semScope = identityScope(scopeKey(primary.provider, primary.model, semKey, this.semanticCfg), grant.vk?.id ?? "", this.semanticCfg)
          const th = h.get("x-bf-cache-threshold")
          const thr = th === undefined ? this.semanticCfg.threshold : (parseFloat(th) ?? this.semanticCfg.threshold)
          const hit = this.vstore !== undefined ? await this.vectorLookup(semScope, semVec, thr) : sem.lookup(semScope, semVec, Date.now(), th === undefined ? undefined : parseFloat(th))
          if (hit !== undefined) {
            metrics.observeCacheHit(ctx.labels, "semantic")
            out.set("x-bf-cache", "semantic-hit")
            out.set("x-bf-cache-similarity", hit.score.toFixed(4))
            cacheHeaders(&out, "semantic", primary, hit.score, th === undefined ? this.semanticCfg.threshold : (parseFloat(th) ?? this.semanticCfg.threshold), hit.id, performance.now() - started)
            originHeaders(&out, hit.origin)
            out.set("content-type", hit.contentType)
            ctx.cached = true
            ctx.cacheType = "semantic"
            const semBody = this.hitThroughPlugins(ctx, hit.body, hit.contentType)
            if (semBody.status >= 400) out.set("content-type", "application/json")
            return respond(semBody.status, semBody.body, out)
          }
        }
      } catch (e) {
        // an embedding failure only skips the semantic cache
        semVec = []
      }
    }

    // the cache plugin's time (lookups and the semantic embedding), for the overhead components
    const cacheUs = (performance.now() - tCache) * 1000.0
    if (cache !== undefined || semVec.length > 0) out.set("x-bifrost-cache-hit", "false")
    ctx.outHeaders = out
    ctx.requested = model
    if (compat !== undefined && compat.enabled) await this.compatLoad(compat, allowed)
    const tAtt = performance.now()
    const r = try await this.attempt(allowed, h, build, translate, streamed, ctx)
    // translation and retries: the attempt's time less the upstream calls
    const convertUs = Math.max(0.0, (performance.now() - tAtt) * 1000.0 - r.upstreamMs * 1000.0)
    out.set("x-bf-attempts", "" + r.attempts)
    if (r.shortCircuit === true) out.set("x-bf-plugin-short-circuit", "true")
    if (compat !== undefined && compat.enabled) {
      // Bifrost logs these as warnings: the fitted values and a dropped service tier (the compat plugin's logs)
      for (const w of compat.warnings) {
        console.error(`raiju: compat: ${w}`)
        ctx.pluginLogs.push({ plugin_name: "compat", level: "warn", message: w, timestamp: Date.now() })
      }
      compatHeaders(&out, compat)
    }
    if (!r.ok) {
      ctx.error = r.body.byteLength > 2000 ? r.body.slice(0, 2000) : r.body
      out.set("content-type", "application/json")
      const et = errorType(r.body)
      if (et !== "") out.set("x-bifrost-error-type", et)
      if (r.retryMs !== undefined) out.set("x-bifrost-retry-after-ms", "" + Math.round(r.retryMs))
      if (r.provider !== "") routedHeaders(&out, primary, r.provider, r.model, fallbackIndex(allowed, r.provider, r.model), model, r.upstreamMs, r.key ?? "", r.alias ?? "", r.aliasName ?? "", r.aliasFamily ?? "")
      return respond(r.status, r.body, out)
    }
    // a provider's billed cost (OpenRouter's usage.cost) replaces the datasheet estimate
    // an alias's model_name (Bifrost's canonical name) is the model priced when it is set
    const priced = r.aliasName !== undefined && r.aliasName !== "" ? r.aliasName : r.model
    ctx.canonicalModel = r.aliasName !== undefined ? r.aliasName : ""
    if (grant.budgets.length > 0 && this.pricing.priceFor(r.provider, priced, ctx.decision) === undefined && !this.unpriced.has(r.provider + "/" + priced)) {
      this.unpriced.add(r.provider + "/" + priced)
      console.error(`raiju: no price for ${r.provider}/${priced}: budgets don't count its requests; add a pricing override`)
    }
    // what the tokens cost, debited from the key's budgets and token limits and counted in the metrics and the log row;
    // an answer that streams back is counted when it ends (settle, called by passThrough)
    const rProvider = r.provider
    const rModel = r.model
    const settle = (pt: int, ct: int, billed: f64 | undefined): f64 => {
      const c = billed !== undefined && billed > 0 ? billed : ctx.decision ? this.pricing.decisionCost(rProvider, priced, pt, ct) : this.pricing.cost(rProvider, priced, pt, ct)
      // the price table's input and output parts (Bifrost's input_cost and output_cost); a billed difference is the additional cost
      const parts = this.pricing.costParts(rProvider, priced, pt, ct)
      ctx.inputCost = parts.input
      ctx.outputCost = parts.output
      ctx.additionalCost = Math.max(0.0, c - parts.input - parts.output)
      this.gov.record(grant, pt + ct, c)
      let sl = ctx.labels
      sl.provider = rProvider
      sl.model = rModel
      metrics.observeUsage(sl, { input: pt, output: ct, cost: c, cacheRead: 0.0, cacheWrite: 0.0, cacheWrite5m: 0.0, cacheWrite1h: 0.0 })
      return c
    }
    const passed = r.pass !== undefined
    const keepBilled = r.noBilled !== true
    const cost = passed ? 0.0 : settle(r.promptTokens, r.completionTokens, r.billed)
    let ul = ctx.labels
    ul.provider = r.provider
    ul.model = r.model
    if (r.direct === true) {
      // already streamed to the client; nothing to cache or send
      ctx.provider = r.provider
      ctx.promptTokens = r.promptTokens
      ctx.completionTokens = r.completionTokens
      ctx.cost = cost
      return respond(200, "", out)
    }
    // a body with raw fields is for this caller only: it never enters a cache
    // a response with tool calls is replayed into someone else's agent loop, so it is kept only when opted in
    // the answer as the cache keeps it: before the post hooks of the plugins before the cache (AttemptPlugins)
    const ahc = ctx.attemptHook
    const plugNoStore = ahc !== undefined && ahc.noStore
    const cachedBody = ahc !== undefined && ahc.cachedBody !== undefined ? ahc.cachedBody! : r.body
    if (sem !== undefined && semVec.length > 0 && !noStore && !plugNoStore && r.raw !== true && (this.semanticCfg.cache_tool_call_responses || !hasToolCalls(cachedBody))) {
      const ttlHeader = h.get("x-bf-cache-ttl")
      const ttl = ttlHeader === undefined ? undefined : parseTtl(ttlHeader)
      const origin: CacheOrigin = { provider: r.provider, model: r.model, inputTokens: r.promptTokens }
      if (this.vstore !== undefined) await this.vectorStore(semScope, semVec, cachedBody, r.contentType, ttl ?? this.semanticCfg.ttl_ms, origin, semKey ?? "")
      else sem.store(semScope, semVec, cachedBody, r.contentType, Date.now(), ttl, origin, semKey)
    }
    if (cache !== undefined && !noStore && !plugNoStore && r.raw !== true) {
      const ttlHeader = h.get("x-bf-cache-ttl")
      const ttl = ttlHeader === undefined ? this.cacheTtlMs : parseTtl(ttlHeader) ?? this.cacheTtlMs
      cache.set(key, cachedBody, r.contentType, ttl, { provider: r.provider, model: r.model, inputTokens: r.promptTokens }, h.get("x-bf-cache-key") ?? "")
    }
    if (r.provider !== primary.provider || r.model !== primary.model) out.set("x-bf-fallback-used", r.provider + "/" + r.model)
    const idx = fallbackIndex(allowed, r.provider, r.model)
    routedHeaders(&out, primary, r.provider, r.model, idx, model, r.upstreamMs, r.key ?? "", r.alias ?? "", r.aliasName ?? "", r.aliasFamily ?? "")
    // the model a provider's server-side fallback answered with (Anthropic usage iterations)
    const served = r.served ?? ""
    if (served !== "") out.set("x-bifrost-routing-info-server-side-fallback-model", served)
    // a semantic lookup that missed still says which upstream answered and what it counted
    if (sem !== undefined && semVec.length > 0) {
      out.set("x-bifrost-cache-provider-used", r.provider)
      out.set("x-bifrost-cache-model-used", r.model)
      out.set("x-bifrost-cache-input-tokens", "" + r.promptTokens)
    }
    out.set("x-bifrost-latency-ms", "" + Math.round(performance.now() - started))
    out.set("content-type", r.contentType)
    if (r.contentType === "text/event-stream") out.set("cache-control", "no-cache")
    if (r.pass !== undefined) {
      ctx.settle = (pt: int, ct: int, billed: f64 | undefined): void => {
        ctx.promptTokens = pt
        ctx.completionTokens = ct
        ctx.cost = settle(pt, ct, keepBilled ? billed : undefined)
      }
      return this.passThrough(ctx, r, out)
    }
    // Time spent in the gateway itself, upstream calls excluded (Bifrost's "overhead").
    const overheadUs = (performance.now() - started - r.upstreamMs) * 1000.0
    metrics.observeOverheadFor(ul, overheadUs)
    // Bifrost's components: governance and the cache are plugins there; the rest of the overhead is
    // miscellaneous, so the components sum to the overhead
    metrics.observeOverheadComponent(ul, "plugins", govUs + cacheUs)
    metrics.observeOverheadComponent(ul, "routing", routeUs)
    metrics.observeOverheadComponent(ul, "conversion", convertUs)
    metrics.observeOverheadComponent(ul, "miscellaneous", Math.max(0.0, overheadUs - (govUs + cacheUs + routeUs + convertUs)))
    out.set("x-bf-overhead-us", "" + Math.round(overheadUs))
    // the same measurements as spans for the otel plugin: the request span's overhead, and each stage
    const epochAt = (p: f64): f64 => Date.now() - (performance.now() - p)
    ctx.overheadUs = overheadUs
    ctx.stages = [
      { name: "plugin.routing.prehook", startMs: epochAt(tRoute), durUs: routeUs },
      { name: "plugin.governance.prehook", startMs: epochAt(tGov), durUs: govUs },
      { name: "convertor", startMs: epochAt(tAtt), durUs: convertUs },
    ]
    if (cache !== undefined) ctx.stages.push({ name: "plugin.semantic_cache.prehook", startMs: epochAt(tCache), durUs: cacheUs })
    ctx.provider = r.provider
    ctx.promptTokens = r.promptTokens
    ctx.completionTokens = r.completionTokens
    ctx.cost = cost
    if (this.logStore !== undefined) {
      ctx.output = r.body
      ctx.stopReason = stopReasonOf(r.body)
      ctx.toolNames = toolNamesOfBody(r.body)
    }
    return respond(200, r.body, out)
  }

  // Reads the datasheet row of each target into the plan. A failed read leaves the row unknown.
  async compatLoad(cp: CompatPlan, refs: ModelRef[]): Promise<void> {
    const look = this.paramsLookup
    for (const r of refs) {
      const key = r.provider + "/" + r.model
      if (cp.has(key)) continue
      let rec: string | undefined = undefined
      if (look !== undefined) {
        try {
          rec = await look(r.model)
        } catch (e) {
          rec = undefined
        }
      }
      cp.put(key, rec)
    }
  }

  // The best vector-store entry for a scope; a store error is a miss.
  async vectorLookup(scope: string, v: f64[], threshold: f64): Promise<{ id: string, body: string, contentType: string, score: f64, origin?: CacheOrigin } | undefined> {
    const vs = this.vstore
    if (vs === undefined) return undefined
    try {
      if (!this.vsReady) {
        await vs.ensure(this.vsNs, this.cfg.semantic_cache?.dimension ?? v.length, ["scope", "cache_key"])
        this.vsReady = true
      }
      const hit = await vs.search(this.vsNs, v, threshold, [{ key: "scope", eq: scopeTag(scope) }])
      if (hit === undefined) return undefined
      const pl = hit.payload
      const provider = pl.get("origin_provider") ?? ""
      const origin: CacheOrigin | undefined = provider === "" ? undefined : { provider: provider, model: pl.get("origin_model") ?? "", inputTokens: parseInt(pl.get("origin_input_tokens") ?? "") ?? 0 }
      return { id: hit.id, body: pl.get("body") ?? "", contentType: pl.get("contentType") ?? "application/json", score: hit.score, origin: origin }
    } catch (e) {
      console.error(`raiju: vector_store search: ${e.message}`)
      return undefined
    }
  }

  async vectorStore(scope: string, v: f64[], body: string, contentType: string, ttlMs: int, origin?: CacheOrigin, cacheKey?: string): Promise<void> {
    const vs = this.vstore
    if (vs === undefined || !this.vsReady) return
    const payload: Map<string, string> = new Map()
    payload.set("scope", scopeTag(scope))
    // the x-bf-cache-key, so DELETE /api/cache/clear-by-key can find the entries (Bifrost's cache_key field)
    if (cacheKey !== undefined && cacheKey !== "") payload.set("cache_key", cacheKey)
    payload.set("body", body)
    payload.set("contentType", contentType)
    if (origin !== undefined) {
      payload.set("origin_provider", origin.provider)
      payload.set("origin_model", origin.model)
      payload.set("origin_input_tokens", "" + origin.inputTokens)
    }
    try {
      await vs.add(this.vsNs, newId("sc-"), v, payload, ttlMs)
    } catch (e) {
      console.error(`raiju: vector_store add: ${e.message}`)
    }
  }

  // Clears semantic cache entries from the vector store: the entry with id (the x-bifrost-cache-id of a hit),
  // or every entry stored under cacheKey. Returns how many went. The namespace is opened first when no
  // request has used it yet, which needs semantic_cache.dimension. Throws what the store reports.
  async vectorClear(id: string, cacheKey: string): Promise<int, Error> {
    const vs = this.vstore
    if (vs === undefined) return 0
    if (!this.vsReady) {
      const dim = this.cfg.semantic_cache?.dimension ?? 0
      if (dim <= 0) return 0
      try await vs.ensure(this.vsNs, dim, ["scope", "cache_key"])
      this.vsReady = true
    }
    if (id !== "") {
      try await vs.delete(this.vsNs, id)
      return 1
    }
    return try await vs.deleteWhere(this.vsNs, [{ key: "cache_key", eq: cacheKey }])
  }

  // Whether a request's bodies stay out of the log store and exporters: the
  // x-bf-disable-content-logging header (when allowed), then the key's setting, then the client's.
  contentOff(h: Hdrs): bool {
    const cl = this.cfg.client
    const hv = h.get("x-bf-disable-content-logging")
    if (hv !== undefined && cl?.allow_per_request_content_storage_override === true) return hv === "true" || hv === "1"
    const vk = this.gov.findKey(h)
    if (vk !== undefined && vk.disable_content_logging !== undefined) return vk.disable_content_logging
    return cl?.disable_content_logging === true
  }

  // The raw upstream bodies that logs and log exports keep get the guardrail redaction too, as the
  // content fields do (Bifrost: stored log fields and exports carry the redacted payload). A response
  // also gets the local output rules that redact, the same rules that rewrite a streamed answer.
  redactRaw(raw: string, response: bool): string {
    let body = raw
    const g = this.guard
    if (g !== undefined && g.mode === "redact") body = applyToText(body, g).body
    if (response) {
      for (const p of this.guardProviders) {
        if (!appliesTo(p, "output") || !(p.kind === "regex" || p.kind === "secrets")) continue
        body = applyRegex(body, this.localRules.get(p.id) ?? []).body
      }
    }
    return body
  }

  record(c: ReqCtx): void {
    // logs_only: the answer is out; what is stored from here on carries placeholders instead of the findings
    // the placeholders' originals stay with the stored row for a caller holding Logs:Reveal (Bifrost's reveal), unless
    // content logging is off for the request (there is then nothing to reveal)
    let mapping = ""
    if (this.logGuard !== undefined || this.logRules.size > 0) {
      const vault = new Vault()
      const rs = this.logRules.values()
      c.input = logsOnlyText(c.input, this.logGuard, rs, vault)
      c.output = logsOnlyText(c.output, this.logGuard, rs, vault)
      c.error = logsOnlyText(c.error, this.logGuard, rs, vault)
      c.rawRequest = logsOnlyText(c.rawRequest, this.logGuard, rs, vault)
      c.rawResponse = logsOnlyText(c.rawResponse, this.logGuard, rs, vault)
      if (vault.count > 0 && !c.contentOff) mapping = phaseMapping(vault.items, [c.input, c.rawRequest], [c.output, c.rawResponse, c.error])
    }
    const ms = performance.now() - c.started
    const ok = c.status >= 200 && c.status < 300
    if (this.logRequests) {
      process.stdout.write(JSON.stringify({ ts: Date.now(), request_id: c.rid, op: c.op, provider: c.provider, model: c.model, status: c.status, prompt_tokens: c.promptTokens, completion_tokens: c.completionTokens, cost: c.cost, latency_ms: Math.round(ms), cache_hit: c.cached }) + "\n")
    }
    const ring = this.samples
    if (ring !== undefined) ring.push({ ts: Date.now(), provider: c.provider, model: c.model, status: c.status, latency_ms: ms, cost: c.cost })
    const store = this.logStore
    // a content-off request with retention: its bodies go to object storage as a hidden object; the row keeps none
    const hq = this.hiddenQueue
    const now = Date.now()
    if (c.hidden && hq !== undefined) {
      const p: HiddenPayload = { id: c.rid, timestamp: isoMs(now), object: c.op, provider: c.provider, model: c.model, status: c.status, input: c.input === "" ? undefined : c.input, output: c.output === "" ? undefined : c.output, error: c.error === "" ? undefined : c.error }
      hq.add(now, c.rid, JSON.stringify(p))
    }
    if (this.exportQueues.length > 0) {
      const e: LogEntry = {
        id: c.rid, ts: Date.now(), request_id: c.rid, op: c.op, provider: c.provider, model: c.model, status: c.status,
        latency_ms: ms, prompt_tokens: c.promptTokens, completion_tokens: c.completionTokens, cost: c.cost, cache_hit: c.cached,
        virtual_key: c.virtualKey === "" ? undefined : c.virtualKey, team_id: c.teamId === "" ? undefined : c.teamId,
        customer_id: c.customerId === "" ? undefined : c.customerId, business_unit_id: c.businessUnitId === "" ? undefined : c.businessUnitId,
        project_id: c.projectId === "" ? undefined : c.projectId, error: c.error === "" ? undefined : c.error,
        input: c.input === "" || c.contentOff ? undefined : c.input, output: c.output === "" || c.contentOff ? undefined : c.output,
        metadata: c.meta, parent_request_id: c.parentId === "" ? undefined : c.parentId, agent_correlation_id: c.agentId === "" ? undefined : c.agentId,
        app: c.app === "" ? undefined : c.app, user_agent: c.userAgent === "" ? undefined : c.userAgent, maxim: c.maximIds, maxim_tags: c.maximTags,
        overhead_ms: c.overheadUs === undefined ? undefined : c.overheadUs / 1000.0, input_cost: c.inputCost, output_cost: c.outputCost,
        additional_cost: c.additionalCost, canonical_model_name: c.canonicalModel === "" ? undefined : c.canonicalModel,
      }
      for (const q of this.exportQueues) q.add(e)
    }
    if (store !== undefined) {
      // the routing the request took (the labels hold the key, the rule and the tier; the engine is the rule's
      // when one matched, else the key picked by weight)
      const lb = c.labels
      // a key configured without an id is recorded by its name
      const keyRef = lb.selectedKeyId !== "" ? lb.selectedKeyId : lb.selectedKeyName
      const engine = lb.routingRuleId !== "" ? "routing-rule" : keyRef !== "" ? "loadbalancing" : ""
      store.add({
        redaction_mapping: mapping === "" ? undefined : this.sealLog(mapping),
        plugin_logs: pluginLogsOf(c),
        content_hidden: c.hidden ? true : undefined,
        selected_key_id: keyRef === "" ? undefined : keyRef,
        selected_key_name: lb.selectedKeyName === "" ? undefined : lb.selectedKeyName,
        routing_rule_id: lb.routingRuleId === "" ? undefined : lb.routingRuleId,
        routing_engine_used: engine === "" ? undefined : engine,
        alias: lb.alias === "" ? undefined : lb.alias,
        complexity_tier: lb.complexityTier === "" ? undefined : lb.complexityTier,
        complexity_mechanism: lb.complexityMechanism === "" ? undefined : lb.complexityMechanism,
        cache_hit_type: c.cacheType === "" ? undefined : c.cacheType,
        stop_reason: c.stopReason === "" ? undefined : c.stopReason,
        tool_call_names: c.toolNames.length === 0 ? undefined : c.toolNames,
        streamed: c.streamed ? true : undefined,
        complexity_score: c.complexityScore,
        selected_prompt_id: c.promptId === "" ? undefined : c.promptId,
        selected_prompt_name: c.promptName === "" ? undefined : c.promptName,
        selected_prompt_version: c.promptVersion,
        task_id: c.crew === undefined ? undefined : c.crew.taskId,
        crew_pool: c.crew === undefined ? undefined : c.crew.pool,
        crew_role: c.crew === undefined ? undefined : c.crew.role,
        crew_class: c.crew === undefined ? undefined : c.crew.taskClass,
        crew_candidate: c.crew === undefined ? undefined : c.crew.candidate,
        crew_attempt: c.crew === undefined ? undefined : c.crew.attempt,
        raw_request: c.contentOff || c.rawRequest === "" ? undefined : this.redactRaw(c.rawRequest, false),
        raw_response: c.contentOff || c.rawResponse === "" ? undefined : this.redactRaw(c.rawResponse, true),
        id: c.rid, ts: now, request_id: c.rid, op: c.op, provider: c.provider, model: c.model, status: c.status,
        latency_ms: ms, prompt_tokens: c.promptTokens, completion_tokens: c.completionTokens, cost: c.cost, cache_hit: c.cached,
        virtual_key: c.virtualKey === "" ? undefined : c.virtualKey, team_id: c.teamId === "" ? undefined : c.teamId,
        customer_id: c.customerId === "" ? undefined : c.customerId, business_unit_id: c.businessUnitId === "" ? undefined : c.businessUnitId,
        project_id: c.projectId === "" ? undefined : c.projectId, error: c.error === "" ? undefined : c.error,
        session_id: c.sessionId === "" ? undefined : c.sessionId, user_id: c.userId === "" ? undefined : c.userId,
        input: c.input === "" || c.contentOff ? undefined : c.input, output: c.output === "" || c.contentOff ? undefined : c.output,
        metadata: c.meta, parent_request_id: c.parentId === "" ? undefined : c.parentId, agent_correlation_id: c.agentId === "" ? undefined : c.agentId,
        app: c.app === "" ? undefined : c.app, user_agent: c.userAgent === "" ? undefined : c.userAgent, maxim: c.maximIds, maxim_tags: c.maximTags,
        overhead_ms: c.overheadUs === undefined ? undefined : c.overheadUs / 1000.0, input_cost: c.inputCost, output_cost: c.outputCost,
        additional_cost: c.additionalCost, canonical_model_name: c.canonicalModel === "" ? undefined : c.canonicalModel,
      })
    }
    const tracer = this.tracer
    const span = c.span
    if (tracer !== undefined && span !== undefined) {
      genAiAttributes(span, { system: c.provider, operation: c.op, requestModel: c.model, inputTokens: c.promptTokens, outputTokens: c.completionTokens })
      span.setInt("http.response.status_code", c.status)
      span.setBool("raiju.cache_hit", c.cached)
      const ov = c.overheadUs
      if (ov !== undefined) span.setNum("bifrost.overhead.duration_ms", ov / 1000.0)
      if (!ok) span.fail(c.error === "" ? `HTTP ${c.status}` : c.error)
      span.end(Date.now())
      // a hooked route whose post hooks are still to run exports the trace once they have (PluginTrace.done), with
      // their spans
      const pt = c.pluginTrace
      const baseStages = c.stages
      // (the trace reaches the callback as its argument: a closure held by pt that held pt would never be freed)
      const finishTrace = (tr: PluginTrace | undefined): void => {
        tracer.addStages(span, baseStages.concat(traceStages(tr)))
        tracer.finish(span)
        if (tracer.shouldFlush(Date.now())) this.flushTraces(tracer)
      }
      if (pt !== undefined && pt.defer) pt.onDone = finishTrace
      else finishTrace(pt)
    }
  }

  // Whether anything guards the text of a live session's events (the built-in guard, or a provider).
  liveGuarded(): bool {
    return (this.guard !== undefined && (this.guardInput || this.guardOutput)) || this.guardProviders.length > 0
  }

  // Checks a piece of a live session's text, as the request path checks a prompt (source "input") or an
  // answer (source "output"): the built-in guard first (block, or redact and go on), then each provider
  // that covers the source. action is "pass", "redact" (text is the replacement) or "block".
  async liveGuard(text: string, source: string): Promise<{ action: string, text: string, reason: string }> {
    const src: "input" | "output" = source === "output" ? "output" : "input"
    let cur = text
    let action = "pass"
    const g = this.guard
    if (g !== undefined && (src === "input" ? this.guardInput : this.guardOutput)) {
      const r = applyToText(cur, g)
      for (const f of r.findings) metrics.inc("raiju_guardrail_findings_total", metrics.labels("", f.kind, g.mode), 1.0)
      if (r.blocked) {
        const kinds: string[] = []
        for (const f of r.findings) {
          if (!kinds.includes(f.kind)) kinds.push(f.kind)
        }
        return { action: "block", text: cur, reason: `found ${kinds.join(", ")}` }
      }
      if (g.mode === "redact" && r.findings.length > 0) {
        cur = r.body
        action = "redact"
      }
    }
    if (this.guardProviders.length > 0) {
      const v = await this.externalGuard(cur, src)
      if (v.action === "block") return { action: "block", text: cur, reason: v.reason }
      const red = v.text
      if (v.action === "redact" && red !== undefined) {
        cur = red
        action = "redact"
      }
    }
    return { action: action, text: cur, reason: "" }
  }

  // One billing unit of a live or realtime session (over WebRTC or a WebSocket) in the request log, the
  // exporters, the spans and the governance usage, as one request (op "live" or "realtime"): a window of
  // voice time, a delegated response or a realtime turn, as Bifrost logs them. It carries the model, its
  // duration as the latency, its tokens, what it cost, and its voice seconds in the row's metadata; its
  // cost and tokens are charged to the budgets and token limits now. requestId is the row's own, parentId
  // the session's (the caller's x-bf-parent-request-id wins).
  recordLive(op: string, h: Hdrs, grant: Grant, provider: string, model: string, status: int, durationMs: f64, promptTokens: int, completionTokens: int, input: string, output: string, error: string, extra: Record<string, string>, cost: LiveCost, requestId: string, parentId: string): void {
    const c = new ReqCtx(requestId, op, performance.now() - durationMs)
    c.provider = provider
    c.model = model
    c.status = status
    c.promptTokens = promptTokens
    c.completionTokens = completionTokens
    c.cost = cost.total
    c.inputCost = cost.input
    c.outputCost = cost.output
    c.error = error
    c.requested = model
    c.contentOff = this.contentOff(h)
    if (!c.contentOff) {
      c.input = input
      c.output = output
    }
    c.virtualKey = grant.vk?.id ?? ""
    c.userId = grant.vk?.user_id ?? ""
    const at: Attribution = grant.attr ?? noAttribution()
    c.teamId = at.teamId
    c.customerId = at.customerId
    c.businessUnitId = at.businessUnitId
    c.projectId = at.projectId
    c.userAgent = h.get("user-agent") ?? ""
    c.sessionId = sessionId(h) ?? ""
    const xApp = h.get("x-bf-app") ?? ""
    c.app = xApp !== "" ? xApp : appOf(h.get("user-agent") ?? "", this.cfg.user_agent_mappings ?? [])
    const meta: Record<string, string> = {}
    const base = logMetadata(h, this.cfg.client?.logging_headers ?? [])
    if (base !== undefined) {
      for (const k of base.keys()) meta.set(k, base.get(k)!)
    }
    for (const k of extra.keys()) meta.set(k, extra.get(k)!)
    c.meta = meta
    const cids = correlationIds(h)
    c.parentId = cids.parent !== "" ? cids.parent : parentId
    c.agentId = cids.agent
    this.record(c)
    this.gov.record(grant, promptTokens + completionTokens, c.cost)
  }

  // The billing of an audio request (speech, transcription, translation): the gate admits its model under the
  // caller's key before the upstream call, and the grant it was admitted under takes the charge (mediaAnswer).
  mediaBill(h: Hdrs): MediaBill {
    const bill = new MediaBill()
    const gov = this.gov
    // (the gate reaches its bill through a weak link: a closure on the bill that held the bill would never be freed)
    const link = new BillLink()
    link.bill = bill
    bill.gate = (provider: string, model: string): Response | undefined => {
      const a = gov.admit(h, provider, model)
      if (a.kind === "denial") return errorResponse(a.status, a.message, a.type, noHeaders())
      const b = link.bill
      if (b !== undefined) b.grant = a
      return undefined
    }
    return bill
  }

  // Charges an audio answer as a chat answer is (settle): a log row, the budgets and token limits, and the metrics.
  // Speech is billed by its input characters, a transcription or translation by the usage its answer reports
  // (media.tov transcriptionUsage); a streamed transcription goes to the caller as it arrives and is charged when it
  // ends, from the usage of its events. Only a 200 answer of an admitted request is charged. A request refused by
  // governance or failed at the provider is logged with its status and error, and charged nothing; one that named no
  // model or provider the gateway serves never reached one, and is not logged (as Bifrost answers it before its core).
  async mediaAnswer(route: MediaRoute, bill: MediaBill, res: Response, h: Hdrs, started: f64, rid: string): Promise<Response> {
    const grant = bill.grant
    if (bill.provider === "") return res
    if (grant === undefined || res.status !== 200) return await this.mediaFailed(route, bill, res, h, started, rid)
    const speech = route.op === "audio.speech"
    let out = res
    let usage: SttUsage = { prompt: 0, completion: 0, inputAudio: 0, inputText: 0, seconds: undefined }
    let parts: CostParts = { input: 0.0, output: 0.0 }
    const ct = res.headers.get("content-type") ?? "application/json"
    const st = res.body
    if (!speech && isEventStream(ct) && st !== undefined) {
      // a streamed transcription: its events pass as they come, and its last usage is charged when it ends
      const tap = new StreamUsage()
      const me = this
      const body = pump(st, (c: u8[]): u8[] => {
        tap.push(c)
        return c
      }, (ok: bool): u8[] => {
        const none: SttUsage = { prompt: 0, completion: 0, inputAudio: 0, inputText: 0, seconds: undefined }
        const u: SttUsage = tap.end() ?? none
        me.chargeMedia(route, bill, grant, u, me.pricing.transcriptionCost(bill.provider, bill.model, u), h, started, rid)
        return []
      })
      const hs: Record<string, string> = new Map()
      hs.set("content-type", ct)
      hs.set("cache-control", "no-cache")
      return new Response(body, { status: 200, headers: hs })
    }
    if (speech) {
      // the speech answer is the audio itself: nothing to read, the characters of the request are the usage
      parts = this.pricing.speechCost(bill.provider, bill.model, bill.chars, 0, 0)
    } else {
      try {
        const bytes = try await res.bytes()
        // a body that is not text reports no usage
        let text = ""
        try {
          text = new TextDecoder().decode(bytes)
        } catch (e) {
          text = ""
        }
        // (a native answer whose body cannot carry its usage, Gemini's plain text, leaves it on the bill)
        usage = transcriptionUsage(text) ?? bill.usage ?? usage
        out = new Response(bytes, { status: 200, headers: { "content-type": res.headers.get("content-type") ?? "application/json" } })
      } catch (e) {
        return errorResponse(502, `the answer could not be read: ${e.message}`, "api_error", noHeaders())
      }
      parts = this.pricing.transcriptionCost(bill.provider, bill.model, usage)
    }
    this.chargeMedia(route, bill, grant, usage, parts, h, started, rid)
    return out
  }

  // The log row, the charge to the key's budgets and token limits, and the usage metrics of an audio answer.
  chargeMedia(route: MediaRoute, bill: MediaBill, grant: Grant, usage: SttUsage, parts: CostParts, h: Hdrs, started: f64, rid: string): void {
    const op = route.op === "audio.speech" ? "speech" : "transcription"
    const c = parts.input + parts.output
    const ctx = new ReqCtx(rid, op, started)
    ctx.provider = bill.provider
    ctx.model = bill.model
    ctx.requested = bill.model
    ctx.status = 200
    ctx.promptTokens = usage.prompt
    ctx.completionTokens = usage.completion
    ctx.cost = c
    ctx.inputCost = parts.input
    ctx.outputCost = parts.output
    ctx.virtualKey = grant.vk?.id ?? ""
    ctx.userId = grant.vk?.user_id ?? ""
    const at: Attribution = grant.attr ?? noAttribution()
    ctx.teamId = at.teamId
    ctx.customerId = at.customerId
    ctx.businessUnitId = at.businessUnitId
    ctx.projectId = at.projectId
    ctx.userAgent = h.get("user-agent") ?? ""
    ctx.sessionId = sessionId(h) ?? ""
    this.record(ctx)
    this.gov.record(grant, usage.prompt + usage.completion, c)
    if (grant.budgets.length > 0 && this.pricing.priceFor(bill.provider, bill.model, false) === undefined) {
      const key = bill.provider + "/" + bill.model
      if (!this.unpriced.has(key)) {
        this.unpriced.add(key)
        console.error(`raiju: no price for ${key}: budgets don't count its requests; add a pricing override`)
      }
    }
    const rl = metrics.newLabels(bill.provider, bill.model, requestType(op, false))
    const gvk = grant.vk
    if (gvk !== undefined) {
      rl.virtualKeyId = gvk.id
      rl.virtualKeyName = gvk.name ?? ""
    }
    rl.userId = ctx.userId
    rl.userName = userNameOf(this.cfg, ctx.userId)
    metrics.observeUsage(rl, { input: usage.prompt, output: usage.completion, cost: c, cacheRead: 0.0, cacheWrite: 0.0, cacheWrite5m: 0.0, cacheWrite1h: 0.0 })
  }

  // A refused or failed audio request (Bifrost logs these as errors): a row with the status and the error, charged nothing.
  // The answer is returned as it came.
  async mediaFailed(route: MediaRoute, bill: MediaBill, res: Response, h: Hdrs, started: f64, rid: string): Promise<Response> {
    let bytes: u8[] = []
    try {
      bytes = await res.bytes()
    } catch (e) {
      bytes = []
    }
    let text = ""
    try {
      text = new TextDecoder().decode(bytes)
    } catch (e) {
      text = ""
    }
    const ctx = new ReqCtx(rid, route.op === "audio.speech" ? "speech" : "transcription", started)
    ctx.provider = bill.provider
    ctx.model = bill.model
    ctx.requested = bill.model
    ctx.status = res.status
    ctx.error = text.byteLength > 2000 ? text.slice(0, 2000) : text
    const grant = bill.grant
    if (grant !== undefined) {
      ctx.virtualKey = grant.vk?.id ?? ""
      ctx.userId = grant.vk?.user_id ?? ""
      const at: Attribution = grant.attr ?? noAttribution()
      ctx.teamId = at.teamId
      ctx.customerId = at.customerId
      ctx.businessUnitId = at.businessUnitId
      ctx.projectId = at.projectId
    }
    ctx.userAgent = h.get("user-agent") ?? ""
    ctx.sessionId = sessionId(h) ?? ""
    this.record(ctx)
    const hs: Record<string, string> = new Map()
    hs.set("content-type", res.headers.get("content-type") ?? "application/json")
    return new Response(bytes, { status: res.status, headers: hs })
  }

  // An audio request is billed (mediaBill, mediaAnswer); the other media routes pass through as they did.
  async media(req: Request, route: MediaRoute): Promise<Response> throws TypeError {
    const mint = async (oc: OAuthKeyConfig, pc: ProviderConfig): Promise<{ token: string, error: string }> => await this.oauthToken(oc, pc)
    if (!billedMedia(route.op)) return try await handleMedia(this.cfg, req, route, undefined, mint)
    const h = snapshot(req.headers)
    const started = performance.now()
    const rid = h.get("x-request-id") ?? newId("req_")
    const bill = this.mediaBill(h)
    const res = try await handleMedia(this.cfg, req, route, bill, mint)
    return await this.mediaAnswer(route, bill, res, h, started, rid)
  }

  // Sends queued spans to the collector in the background; export failures are logged, never raised.
  flushTraces(tracer: Tracer): void {
    if (usesGrpc(tracer.cfg)) {
      exportSpansGrpc(tracer)
      return
    }
    const payload = tracer.flushPayload()
    if (payload === undefined) return
    const up = exportRequest(tracer.cfg, payload)
    sendSpans(up.url, up.headers, up.body, tracer.tls, up.timeoutMs)
  }

  // Chat completions. With MCP agent mode on (client.mcp_auto_execute), tool calls to
  // the listed MCP tools run here and the model is called again, up to mcp_agent_depth
  // rounds; streamed requests and x-bf-mcp-agent: off skip it.
  async chat(req: Request, sink?: StreamSink): Promise<Response> {
    const ag = this.agent
    const m = this.mcp
    if (ag === undefined || m === undefined || req.method !== "POST" || req.headers.get("x-bf-mcp-agent") === "off") return try await this.chatOnce(req, sink)
    const text = await req.text()
    const hs: Record<string, string> = snapshot(req.headers)
    let streamed = false
    try {
      streamed = rawBool(fields(text), "stream") ?? false
    } catch (e) {
      streamed = false
    }
    if (streamed) return try await this.chatOnce(new Request(req.url, { method: "POST", headers: hs, body: text }), sink)
    const url = req.url
    const last = new LastHeaders()
    const call = async (b: string): Promise<{ status: int, body: string }> => {
      const r = try await this.chatOnce(new Request(url, { method: "POST", headers: hs, body: b }), undefined)
      const kept: Map<string, string> = new Map()
      r.headers.forEach((v, k) => {
        if (k !== "content-length") kept.set(k, v)
      })
      last.h = kept
      return { status: r.status, body: try await r.text() }
    }
    const hdr = snapshot(req.headers)
    const entries = this.codeEntriesFor(m, hdr)
    const exec = this.agentExec(m, hdr, ag)
    const names = this.agentNames(m, entries)
    const codeOk = (a: string): bool => execAutoAllowed(a, entries, ag.auto_execute)
    try {
      const r = await runAgent(text, call, exec, ag, names, codeOk)
      // the last model call's headers (request id, cache, attempts), plus the agent's counts
      const out: Record<string, string> = last.h
      if (!out.has("content-type")) out.set("content-type", "application/json")
      out.set("x-bf-agent-steps", "" + r.steps)
      out.set("x-bf-agent-tool-calls", "" + r.toolCalls)
      return new Response(r.body, { status: r.status, headers: out })
    } catch (e) {
      return errorResponse(502, `agent mode failed: ${e.message}`, "api_error", noHeaders())
    }
  }

  // How the agent loop runs one tool call: a code mode meta-tool, or an MCP tool (an injected tool by its real name).
  agentExec(m: McpManager, hdr: Hdrs, ag: AgentConfig): (name: string, args: string) => Promise<{ text: string, isError: bool }, Error> {
    return async (name: string, args: string): Promise<{ text: string, isError: bool }, Error> => {
      if (isMetaTool(name)) return try await this.codeMetaTool(m, hdr, name, args, ag.auto_execute)
      const real = this.injectedName(name) ?? name
      return try await this.mcpCall(m, hdr, real, args, undefined)
    }
  }

  // The names the agent loop may run: the MCP tools, the injected ones, and the code mode meta-tools when the
  // caller reaches code mode clients (executeToolCode then runs when its program calls only auto-executable tools).
  agentNames(m: McpManager, entries: CodeEntry[]): string[] {
    const names = m.toolNames().concat(this.injectedAll())
    if (entries.length > 0) {
      for (const n of META_TOOLS) names.push(n)
    }
    return names
  }

  // Agent mode on a Responses request, as Bifrost's CheckAndExecuteAgentForResponsesRequest: the answer's
  // auto-executable MCP calls (code mode's meta-tools included) run and the model is asked again, each call
  // served by `once` (the whole Responses route: log, fallbacks, caches). undefined when agent mode does not
  // apply (no auto-execute list, no MCP, a stream, x-bf-mcp-agent: off): the caller serves the request itself.
  async responsesAgent(req: Request, text: string, stream: bool, once: (r: Request, body: string) => Promise<Response>): Promise<Response | undefined> {
    const ag = this.agent
    const m = this.mcp
    if (ag === undefined || m === undefined || stream || req.method !== "POST" || req.headers.get("x-bf-mcp-agent") === "off") return undefined
    const hs: Record<string, string> = new Map()
    req.headers.forEach((v, k) => {
      if (k !== "content-length" && k !== "transfer-encoding") hs.set(k, v)
    })
    const url = req.url
    const last = new LastHeaders()
    const call = async (b: string): Promise<{ status: int, body: string }, Error> => {
      const r = await once(new Request(url, { method: "POST", headers: hs, body: b }), b)
      const kept: Map<string, string> = new Map()
      r.headers.forEach((v, k) => {
        if (k !== "content-length") kept.set(k, v)
      })
      last.h = kept
      return { status: r.status, body: try await r.text() }
    }
    const hdr = snapshot(req.headers)
    const entries = this.codeEntriesFor(m, hdr)
    const codeOk = (a: string): bool => execAutoAllowed(a, entries, ag.auto_execute)
    try {
      const r = await runResponsesAgent(text, call, this.agentExec(m, hdr, ag), ag, this.agentNames(m, entries), codeOk)
      const out: Record<string, string> = last.h
      if (!out.has("content-type")) out.set("content-type", "application/json")
      out.set("x-bf-agent-steps", "" + r.steps)
      out.set("x-bf-agent-tool-calls", "" + r.toolCalls)
      return new Response(r.body, { status: r.status, headers: out })
    } catch (e) {
      return errorResponse(502, `agent mode failed: ${e.message}`, "api_error", noHeaders())
    }
  }


  // ---- large_payload_optimization (largepayload.tov) ----

  // The answer to a request whose body may be large: undefined when it is an ordinary request (the caller
  // goes on with `req` as it is), else the Request to go on with (the body was small after all, or this route's
  // provider needs it whole) or the Response (refused, or served with the body streamed to the provider).
  // `route` is largeRoute's kind. The body is read only as far as it must be: the first prefetch_size_bytes
  // to find the model, or (no Content-Length) up to request_threshold_bytes to see whether it is big at all.
  async largeRequest(req: Request, route: string, path: string): Promise<Response | Request | undefined> {
    const lp = this.large
    if (lp === undefined || req.method !== "POST") return undefined
    const dtext = req.headers.get("content-length")
    const declared = dtext === undefined ? -1 : (parseInt(dtext) ?? -1)
    if (declared >= 0 && declared <= lp.requestThreshold) return undefined
    if (declared > lp.maxPayload) return errorResponse(413, `request body of ${declared} bytes is over the maximum payload size of ${lp.maxPayload} bytes (large_payload_optimization.max_payload_bytes)`, "invalid_request_error", noHeaders())
    const src = req.body
    if (src === undefined) return undefined
    // read ahead: the prefix, or the whole body when it ends within the threshold
    const want = declared >= 0 ? lp.prefetch : Math.max(lp.prefetch, lp.requestThreshold + 1)
    const head: u8[] = []
    let ended = false
    try {
      while (head.length < want) {
        const r = await src.pull()
        const v = r.value
        if (r.done || v === undefined) {
          ended = true
          break
        }
        for (const b of v) head.push(b)
      }
    } catch (e) {
      return errorResponse(400, `the request body could not be read: ${e.message}`, "invalid_request_error", noHeaders())
    }
    if (ended && declared < 0 && head.length <= lp.requestThreshold) {
      // a body with no declared length that turned out small: an ordinary request
      return new Request(req.url, { method: "POST", headers: snapshot(req.headers), body: head })
    }
    const meta = scanPrefix(head)
    const hs = snapshot(req.headers)
    if (!meta.hasModel) {
      await src.cancel()
      return errorResponse(400, `could not find the model in the first ${head.length} bytes of the request (large_payload_optimization.prefetch_size_bytes is ${lp.prefetch}); put "model" first in large request bodies`, "invalid_request_error", noHeaders())
    }
    // the provider must take the body as it is: one whose wire format for this route is the caller's (the other
    // formats are converted, and the converters need the whole body)
    const op = route === "embeddings" ? "embeddings" : route === "completions" ? "completions" : route === "responses" ? "responses" : route === "messages" ? "anthropic.messages" : "chat"
    const first = parseModelVia(this.cfg, meta.model, routeOf(op))
    const p = first.provider === "" ? undefined : providerOf(this.cfg, first.provider)
    const kind = p === undefined ? "" : kindOf(first.provider, p)
    const stream = meta.hasStream ? meta.stream : false
    // A provider whose format differs gets the body converted while it streams in (largeconv.tov), when this route
    // has a converter for it. Bedrock signs the payload, so one model id must serve every key.
    const limit = (this.cfg.client?.max_request_body_size_mb ?? 100) * 1048576
    let family = ""
    let convModel = first.model
    // a text completion that compat sends as chat (the model's datasheet row serves chat but not text completions)
    // becomes the chat body as it streams in (textconv.tov), for any provider whose chat it can reach
    let textChat = false
    // compat on a large text completion: the endpoint change, and the drops and fits on its parameters (applied when
    // the body has streamed past them, CompatPlan.shapeParams)
    let cpl: CompatPlan | undefined = undefined
    if (route === "completions" && p !== undefined) {
      const cp = new CompatPlan(withHeader(settingsOf(this.cfg.client?.compat), hs.get("x-bf-compat") ?? undefined), "completions", stream)
      if (cp.enabled) {
        await this.compatLoad(cp, [first])
        textChat = cp.routeFor(first.provider, kind, first.model) === "chat"
        cpl = cp
      }
    }
    if (p !== undefined && (textChat || !takesBodyAsIs(route, kind))) {
      family = familyFor(textChat ? "text-chat" : route, kind, first.model, p, stream)
      if (family !== "" && needsHash(family)) {
        const ks = p.keys ?? []
        for (let i = 0; i < ks.length; i++) {
          const m = resolveAlias(ks[i]!, first.model, this.cfg.client?.routing_chain_max_depth).model
          if (i === 0) convModel = m
          else if (m !== convModel) family = ""
        }
      }
    }
    // a text completion that goes as it is, but whose parameters compat may drop or fit: written again as it streams in,
    // its prompt as it comes and its parameters through the shape at the end (textconv.tov TextShaper)
    if (route === "completions" && family === "" && p !== undefined && takesBodyAsIs(route, kind) && cpl !== undefined && cpl.mayShape(first.provider, first.model)) family = "text-shaped"
    // compat's shape on the parameters of a text completion: one sent as chat, or one shaped as it is (Replicate's own
    // text route takes the caller's parameters, as the whole-body route sends them)
    const shapePlan: CompatPlan | undefined = textChat || family === "text-shaped" ? cpl : undefined
    if (!takesBodyAsIs(route, kind) && family === "") {
      // buffered after all, up to client.max_request_body_size_mb: the ordinary path converts it
      if (declared > limit) {
        await src.cancel()
        return errorResponse(413, `request body too large: ${first.provider === "" ? "this model" : first.provider} needs the whole body in memory and it is over client.max_request_body_size_mb`, "invalid_request_error", noHeaders())
      }
      const all: u8[] = head.slice()
      try {
        while (!ended) {
          const r = await src.pull()
          const v = r.value
          if (r.done || v === undefined) break
          for (const b of v) all.push(b)
          if (all.length > limit) return errorResponse(413, "request body too large", "invalid_request_error", noHeaders())
        }
      } catch (e) {
        return errorResponse(400, `the request body could not be read: ${e.message}`, "invalid_request_error", noHeaders())
      }
      return new Request(req.url, { method: "POST", headers: hs, body: all })
    }
    const lg = new LargeBody(lp, head, meta, ended ? undefined : src, declared)
    // a chat or text stream that goes as it is asks for its usage chunk, as Bifrost asks every OpenAI-format stream
    // (the budgets and the log read it from the answer's tail)
    lg.askUsage = family === "" && stream && (route === "chat" || route === "completions")
    const tiny: Field[] = [{ key: "model", raw: quote(meta.model) }]
    // A chat stream to a converted provider is called as a stream and its events are converted as they arrive (Bedrock's
    // binary event-stream frames too, from ConverseStream). A Messages stream passes through.
    // (a Messages stream converted to chat, Gemini, Cohere or Bedrock Converse is converted as it arrives, as a chat
    // stream is, and so is a text completion sent as chat, in text_completion chunks)
    const msgLive = route === "messages" && (family === "messages-chat" || family === "messages-gemini" || family === "messages-cohere" || family === "messages-converse")
    // (Replicate answers a prediction whole; a shaped text completion's answer is the provider's own, passed back as it is)
    const textLive = route === "completions" && family.startsWith("text-") && family !== "text-replicate" && family !== "text-shaped"
    // a Responses stream converted to chat is called as a stream too, and its chat chunks become Responses events as they arrive
    const respLive = route === "responses"
    const live = family !== "" && stream && (route === "chat" || msgLive || textLive || respLive)
    const wire = live || (route === "messages" && stream)
    const holder = new ConvRef()
    const autoCache = this.autoPromptCache || hs.get("x-bf-prompt-cache-auto-inject") === "true" || (p?.prompt_cache?.auto_inject ?? false)
    if (family !== "") {
      // the answer is converted back (a chat or embeddings answer), or passes as the provider's own Messages answer
      // (Bedrock and Vertex Claude)
      lg.passAnswer = family === "messages-bedrock" || family === "messages-vertex" || family === "text-shaped"
      if (needsHash(family)) {
        if (this.gov.enforce && this.gov.findKey(hs) === undefined) {
          if (!ended) await src.cancel()
          return errorResponse(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", noHeaders())
        }
        // converted into a spool on disk and hashed, so the request can be signed before its first byte goes out
        const c = newConv(family, convModel, p!, autoCache, wire, limit, 4096)
        if (shapePlan !== undefined) {
          const cps: CompatPlan = shapePlan
          c.setShape((fs) => try cps.shapeParams(first.provider, kind, convModel, fs))
        }
        holder.conv = c
        const sp = family === EMB_TITAN ? await spoolTitan(lg, c) : await spoolConverted(lg, c)
        if (!sp.ok) {
          const rel = lg.release
          if (rel !== undefined) rel()
          if (sp.over) return errorResponse(413, `request body is over the maximum payload size of ${lp.maxPayload} bytes (large_payload_optimization.max_payload_bytes)`, "invalid_request_error", noHeaders())
          return errorResponse(sp.bad ? 400 : 500, sp.bad ? `invalid request: ${sp.message}` : `could not convert the request: ${sp.message}`, sp.bad ? "invalid_request_error" : "api_error", noHeaders())
        }
      }
    }
    const build: Build = (t) => {
      if (family !== "") {
        if (t.kind !== kind) throw new SyntaxError(`${t.provider}: this large request is being converted for ${first.provider} and cannot go to a provider with another format`)
        if (needsHash(family)) {
          if (t.model !== convModel) throw new SyntaxError(`${t.provider}: the keys of this provider name the model differently, which a large request converted for Bedrock cannot follow`)
        } else {
          // (a fresh converter for each target: a model alias is per key, and nothing has been read yet)
          // (a shaped text completion that streams asks for its usage, as the body sent as it is asks)
          const c = convFor(family, t, autoCache, family === "text-shaped" ? stream : wire, limit, 4096)
          const sp = shapePlan
          if (sp !== undefined) c.setShape((fs) => try sp.shapeParams(t.provider, t.kind, t.model, fs))
          holder.conv = c
          lg.converted = convertedStream(lg, c)
        }
        const cu = try upstreamFor(family, t, wire, lg.payloadHash)
        // Titan: one more signed call per further input, each with its own spooled body
        if (family !== EMB_TITAN || lg.extras.length === 0) return cu
        return { url: cu.url, headers: cu.headers, body: cu.body, extra: titanExtras(t, lg) }
      }
      if (!takesBodyAsIs(route, t.kind)) throw new SyntaxError(`${t.provider} needs the whole request body in memory, which large_payload_optimization does not allow: a large ${route} request goes only to a provider that takes its format as it is`)
      // openai_config.disable_store: store false ends the chat or Responses body, as the whole-body requests force it
      const ns: bool = t.cfg.openai_config?.disable_store ?? false
      lg.noStore = ns && (route === "chat" || route === "responses")
      const up = route === "embeddings" ? try providers.embeddingsUpstream(t, tiny) : route === "completions" ? openai.completionsRequest(t, tiny) : route === "responses" ? openai.responsesRequest(t, tiny) : route === "messages" ? anthropicNative.nativeRequest(t, tiny) : openai.chatRequest(t, tiny)
      return { url: up.url, headers: up.headers, body: "" }
    }
    // the answer of a request that streams on is a small one here (a big one is passed through): its usage is read from the text
    const translate: Translate = (t, text, requested) => {
      if (route === "responses" && family !== "") {
        // a Responses request converted to chat: its chat answer is converted back as the whole-request path does it
        const hc = holder.conv
        const echo = hc === undefined ? "{}" : hc.echo()
        let o: Translated = { body: "", promptTokens: 0, completionTokens: 0 }
        if (stream && providers.streamsNatively(t.kind)) o = openai.streamResponse(text, requested)
        else o = try providers.chatTranslate(t.kind, t.model, text, requested, false)
        if (stream) {
          const sse = o.body.startsWith("{") ? try completionToSse(o.body, true) : o.body
          return { body: toResponseStream(sse, meta.model), promptTokens: o.promptTokens, completionTokens: o.completionTokens }
        }
        return { body: try toResponse(o.body, meta.model, echo), promptTokens: o.promptTokens, completionTokens: o.completionTokens }
      }
      if (route === "responses" || (route === "messages" && lg.passAnswer)) {
        const u = usageOfText(text)
        return { body: text, promptTokens: u.promptTokens, completionTokens: u.completionTokens }
      }
      if (route === "messages") {
        // a provider's chat answer, in Messages format (a stream is converted as it arrives, in largeLive)
        const tr = try providers.chatTranslate(t.kind, t.model, text, requested, false)
        return { body: try toMessage(tr.body, meta.model), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
      }
      if (route === "embeddings") return try providers.embeddingsTranslate(t.kind, t.model, text, requested)
      if (route === "completions" && family !== "" && family !== "text-shaped") {
        // a text completion sent as chat: the chat answer as a text completion, as the whole-body route converts it
        // (a stream is converted as it arrives, in largeLive)
        if (stream && providers.streamsNatively(t.kind)) {
          const sr = openai.streamResponse(text, requested)
          return { body: chatSseToText(sr.body), promptTokens: sr.promptTokens, completionTokens: sr.completionTokens }
        }
        const tc = try providers.chatTranslate(t.kind, t.model, text, requested, false)
        if (!stream) return { body: try chatToText(tc.body), promptTokens: tc.promptTokens, completionTokens: tc.completionTokens }
        const hc = holder.conv
        return { body: chatSseToText(try completionToSse(tc.body, hc !== undefined && hc.wantsUsage())), promptTokens: tc.promptTokens, completionTokens: tc.completionTokens }
      }
      if (route === "completions") return try openai.chatResponse(text, requested)
      const tr = try providers.chatTranslate(t.kind, t.model, text, requested, false)
      if (family !== "" && stream) {
        // a converted provider is called without streaming: its answer is replayed as the stream the caller asked for
        const hc = holder.conv
        return { body: try completionToSse(tr.body, hc !== undefined && hc.wantsUsage()), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens, served: tr.served, billed: tr.billed }
      }
      return tr
    }
    const modelBody: Field[] = [{ key: "model", raw: quote(meta.model) }]
    if (meta.hasStream) modelBody.push({ key: "stream", raw: stream ? "true" : "false" })
    if (live) return await this.largeLive(req, op, modelBody, build, translate, stream, lg, holder, cpl)
    return await this.largeRun(req, op, modelBody, build, translate, stream, lg, undefined, undefined, cpl)
  }

  // serve() for a large request, and what follows it: the spool removed, a body the converter refused, a body that grew
  // past max_payload_bytes.
  async largeRun(req: Request, op: string, modelBody: Field[], build: Build, translate: Translate, stream: bool, lg: LargeBody, sink?: StreamSink, mk?: ConverterFactory, compat?: CompatPlan): Promise<Response> {
    const res = try await this.serve(req, op, undefined, modelBody, "", build, translate, stream, undefined, sink, mk, compat, undefined, undefined, lg)
    const release = lg.release
    if (release !== undefined) release()
    // a body the converter refused
    if (lg.convError !== "" && !lg.tap.over) return errorResponse(400, `invalid request: ${lg.convError}`, "invalid_request_error", noHeaders())
    // a body with no declared length that grew past max_payload_bytes cut its own upload short
    if (lg.tap.over && res.status !== 413) return errorResponse(413, `request body is over the maximum payload size of ${lg.settings.maxPayload} bytes (large_payload_optimization.max_payload_bytes)`, "invalid_request_error", noHeaders())
    return res
  }

  // A large chat request that asks for a stream, to a provider whose format differs: the provider streams its events and
  // they are converted to chat chunks as they arrive, as for an ordinary request. The Response is given at the first event.
  async largeLive(req: Request, op: string, modelBody: Field[], build: Build, translate: Translate, stream: bool, lg: LargeBody, holder: ConvRef, compat?: CompatPlan): Promise<Response> {
    const head = new LiveHead()
    const sink = headSink(head)
    // (the body has been read by the time the answer starts, so include_usage is known)
    const mk: ConverterFactory = (t, requested) => {
      if (!streamable(t)) return undefined
      const hc = holder.conv
      // a Messages stream is answered as Messages events (with usage, as the whole-body route asks the provider for it)
      const messages = op === "anthropic.messages"
      // a Responses stream ends with response.completed, which carries the usage, so the chat stream is asked for it
      const responses = op === "responses"
      const conv = new StreamConverter(converterKind(t), requested, messages || responses || (hc !== undefined && hc.wantsUsage()))
      // a text completion sent as chat streams as text_completion chunks
      conv.txt = op === "completions"
      if (messages) conv.asAnthropic(rawStr(modelBody, "model") ?? "")
      if (responses) conv.asResponses(rawStr(modelBody, "model") ?? "")
      conv.stopAtFinish = quirkStopsAtFinish(t)
      return conv
    }
    const p = new Promise<Response>((resolve) => {
      head.resolve = resolve
    })
    this.largeBackground(req, op, modelBody, build, translate, stream, lg, sink, mk, head, compat)
    return await p
  }

  async largeBackground(req: Request, op: string, modelBody: Field[], build: Build, translate: Translate, stream: bool, lg: LargeBody, sink: StreamSink, mk: ConverterFactory, head: LiveHead, compat?: CompatPlan): Promise<void> {
    try {
      const r = await this.largeRun(req, op, modelBody, build, translate, stream, lg, sink, mk, compat)
      if (!sink.started) head.give(r)
    } catch (e) {
      head.give(errorResponse(500, "internal error", "api_error", noHeaders()))
    }
    if (!sink.started) head.release()
  }

  // The answer of a large request that is streamed back: the upstream's bytes as they come, with a truncated
  // copy for the request log. The request is logged when the stream ends.
  passThrough(ctx: ReqCtx, r: Outcome, out: Hdrs): Response {
    const src = r.pass!
    const lg = ctx.large
    const lps = this.large
    ctx.deferRecord = true
    ctx.status = r.status
    ctx.provider = r.provider
    const reader = src.body
    const keep = new BodyTap(lg !== undefined ? lg.settings.truncatedLog : (lps === undefined ? 0 : lps.truncatedLog), 9007199254740991)
    // the two ends of the answer, read for its usage when it is over
    const seen = new UsageTap(16384, 65536)
    let finished = false
    const fin = (): void => {
      if (finished) return
      finished = true
      const f = r.finish
      if (f !== undefined) f()
      const settle = ctx.settle
      // (settle captures ctx: dropped once used, or the pair would never be freed)
      ctx.settle = undefined
      if (settle !== undefined) {
        const u = seen.usage()
        settle(u.promptTokens, u.completionTokens, u.billed)
      }
      // a streamed answer's stop reason, from its last events (the kept tail, or the whole answer when it fit the head)
      if (this.logStore !== undefined) ctx.stopReason = stopReasonOfTail(tailText(seen.total > seen.head.length ? seen.tail() : seen.head))
      if (this.logStore !== undefined && !ctx.contentOff) {
        if (lg !== undefined) ctx.input = lg.tap.previewText()
        ctx.output = keep.previewText()
      }
      this.record(ctx)
    }
    const body = new ReadableStream({
      async pull(c) {
        if (reader === undefined) {
          c.close()
          fin()
          return
        }
        let chunk: u8[] | undefined = undefined
        // only the wait for the upstream counts as idle, not a client that reads slowly
        const iw = r.idle
        try {
          if (iw !== undefined) iw.arm()
          const x = await reader.pull()
          if (iw !== undefined) iw.disarm()
          chunk = x.value
          if (x.done) chunk = undefined
        } catch (e) {
          c.error(e)
          fin()
          return
        }
        const v = chunk
        if (v === undefined) {
          c.close()
          fin()
          return
        }
        keep.see(v)
        seen.see(v)
        c.enqueue(v)
      },
      cancel() {
        if (reader !== undefined) reader.cancel()
        fin()
      },
    })
    const hs: Record<string, string> = out
    hs.set("content-type", r.contentType)
    if (r.contentType.startsWith("text/event-stream")) hs.set("cache-control", "no-cache")
    // (the request type as the answer showed it: a stream whose flag lay past a large body's prefix)
    if (ctx.streamed) hs.set("x-bifrost-request-type", requestType(ctx.op, true))
    return new Response(body, { status: r.status, headers: hs })
  }

  async chatOnce(req: Request, sink?: StreamSink, skipGuards?: bool): Promise<Response> {
    let text = await req.text()
    let body: Field[] = []
    const guardOn = skipGuards !== true
    const guard = guardOn ? this.guard : undefined
    // reversible redaction: one vault per request, so the response restores to this request's values
    const vault = new Vault()
    const reversible = guard !== undefined && guard.mode === "redact" && this.cfg.guardrails?.reversible === true
    // the prompt the request named and the version it got, for the request log
    let promptUsed: Applied | undefined = undefined
    try {
      if (guard !== undefined && this.guardInput && reversible) {
        text = try tokenizeChatRequest(text, guard, vault)
      } else if (guard !== undefined && this.guardInput) {
        const g = applyToChatRequest(text, guard)
        for (const f of g.findings) metrics.inc("raiju_guardrail_findings_total", metrics.labels("", f.kind, guard.mode), 1.0)
        if (g.blocked) {
          const kinds: string[] = []
          for (const f of g.findings) {
            if (!kinds.includes(f.kind)) kinds.push(f.kind)
          }
          return errorResponse(400, `request blocked by guardrails: found ${kinds.join(", ")}`, "guardrail_violation", noHeaders())
        }
        text = g.body
      }
      if (guardOn && this.guardProviders.length > 0) {
        const v = await this.externalGuard(extractText(text), "input")
        if (v.action === "block") return errorResponse(400, `request blocked by guardrails: ${v.reason}`, "guardrail_violation", noHeaders())
        const red = v.text
        // a redaction replaces the prompt when it is a single text message; otherwise it can't be placed
        if (red !== undefined) {
          const one = singleTextMessage(text, red)
          if (one === undefined) return errorResponse(400, `request blocked by guardrails: ${v.reason} (redaction needs a single text message)`, "guardrail_violation", noHeaders())
          text = one
        }
      }
      text = try this.withMcpTools(text, snapshot(req.headers))
      body = fields(text)
      // the prompt named by x-bf-prompt-id goes before the messages (prompts.tov)
      const ph = snapshot(req.headers)
      if (ph.get("x-bf-prompt-id") !== undefined) {
        const vk = this.gov.findKey(ph)
        const applied = try applyPrompt(this.cfg.prompt_repo, ph, text, { budgetPercent: this.gov.budgetFraction(vk) * 100.0, tokensPercent: this.gov.rateFraction(vk, "token") * 100.0, requestsPercent: this.gov.rateFraction(vk, "request") * 100.0 })
        if (applied.prompt_id !== undefined) {
          text = applied.text
          body = try fields(text)
          promptUsed = applied
        }
      }
      // a key's access profile may cap max_tokens
      const cap = this.gov.policyFor(snapshot(req.headers))?.maxTokens
      if (cap !== undefined) {
        let changed = false
        for (const k of ["max_tokens", "max_completion_tokens"]) {
          const raw = find(body, k)
          const n = raw === undefined ? undefined : parseInt(raw)
          if (n === undefined || n > cap) {
            if (raw !== undefined || k === "max_tokens") {
              setField(&body, k, "" + cap)
              changed = true
            }
          }
        }
        if (changed) text = build(body)
      }
      // x-bf-passthrough-extra-params: true merges the body's extra_params object into the request, so
      // provider fields that are not in the chat schema reach the provider (Bifrost's SDK gate)
      if (req.headers.get("x-bf-passthrough-extra-params") === "true") {
        const ep = find(body, "extra_params")
        if (ep !== undefined && ep.startsWith("{")) {
          for (const f of try fields(ep)) setField(&body, f.key, f.raw)
          body = without(body, ["extra_params"])
          text = build(body)
        }
      }
    } catch (e) {
      return errorResponse(400, `invalid chat request: ${e.message}`, "invalid_request_error", noHeaders())
    }
    const chain = this.plugins
    let run: PluginRun | undefined = undefined
    let hook: AttemptPlugins | undefined = undefined
    if (chain !== undefined) {
      // the context of the transport hooks, when they ran for this request
      const shared = this.pluginRuns.get(req.headers.get(RUN_HEADER) ?? "")
      const r = shared ?? new PluginRun({ requestId: req.headers.get("x-request-id") ?? newId("req_"), op: "chat", model: "", provider: "", headers: new Map(), values: new Map(), trace: new PluginTrace() })
      r.ctx.op = "chat"
      r.ctx.model = rawStr(body, "model") ?? ""
      // the provider the model resolves to (a bare model's default one), as Bifrost's request carries it
      r.ctx.provider = this.refOf(r.ctx.model).provider
      // the request as it came, for the pre hooks of each fallback
      const original = text
      // the plugins before the cache now; the post_builtin ones once the cache missed (AttemptPlugins.afterCache)
      const pre = chain.runPreBeforeCache(&r.ctx, text)
      let primaryFail: { status: int, body: string } | undefined = undefined
      if (pre.kind === "short_circuit") {
        const delay = parseInt(r.ctx.values.get("mock_latency_ms") ?? "0") ?? 0
        if (delay > 0) await sleep(delay)
        // an error that lets the fallbacks be tried (Bifrost's AllowFallbacks unset or true) is the primary attempt's: the
        // fallbacks run, each with the pre hooks again (AttemptPlugins)
        if (pre.status >= 400 && pre.allowFallbacks !== false && this.fallbacksOf(body).length > 0) {
          primaryFail = { status: pre.status, body: pre.body }
        } else {
          const post = chain.runPost(&r.ctx, pre.status, pre.body)
          const hs: Record<string, string> = new Map()
          hs.set("content-type", post.status === pre.status ? pre.contentType : "application/json")
          hs.set("x-bf-plugin-short-circuit", "true")
          return new Response(post.body, { status: post.status, headers: hs })
        }
      }
      run = r
      if (pre.kind === "continue" && pre.body !== text) {
        text = pre.body
        try {
          body = fields(text)
        } catch (e) {
          return errorResponse(500, `a plugin produced an invalid request: ${e.message}`, "api_error", noHeaders())
        }
      }
      const ah = new AttemptPlugins(chain, r, original, body, text)
      ah.primaryFail = primaryFail
      ah.late = pre.kind === "continue" && chain.hasAfterCache("chat")
      hook = ah
    }
    // The typed request is only needed to translate for non-OpenAI providers.
    const typed = new LazyChat(text)
    const stream = rawBool(body, "stream") ?? false
    let wantUsage = false
    const so = find(body, "stream_options")
    if (so !== undefined && so.startsWith("{")) {
      try {
        wantUsage = rawBool(fields(so), "include_usage") ?? false
      } catch (e) {
        wantUsage = false
      }
    }
    const autoCache = this.autoPromptCache || req.headers.get("x-bf-prompt-cache-auto-inject") === "true"
    // a streamed answer goes through the plugins' post hooks chunk by chunk
    const pipeSink = stream && sink !== undefined && chain !== undefined && run !== undefined ? llmStreamSink(chain, run, sink) : sink
    const canPipe = stream && pipeSink !== undefined
    // a provider's own prompt_cache.auto_inject turns the breakpoints on for its requests
    const autoFor = (t: Target): bool => autoCache || (t.cfg.prompt_cache?.auto_inject ?? false)
    // compat: the request for each target, shaped in build (drops and fits, and Responses when the model needs it)
    const cp = new CompatPlan(withHeader(settingsOf(this.cfg.client?.compat), req.headers.get("x-bf-compat") ?? undefined), "chat", stream)
    const sendChat: ChatSender = (t, b, tc) => {
      // Usage is always requested from streaming upstreams, for budgets and metrics.
      let streamBody = b.slice()
      if (stream) setField(&streamBody, "stream_options", `{"include_usage":true}`)
      if (stream && providers.streamsNatively(t.kind)) return openai.chatRequest(t, try this.withInjected(t, streamBody))
      if (stream) {
        const plain = try this.withInjected(t, streamBody.filter((f) => f.key !== "stream" && f.key !== "stream_options"))
        // with a streaming client, Anthropic, Gemini and Bedrock stream too and are converted as they go
        if (canPipe) {
          const su = try providers.streamUpstream(t, try tc.get(), plain, autoFor(t))
          if (su !== undefined) return su
        }
        // otherwise called without streaming and replayed as SSE below
        return try providers.chatUpstream(t, try tc.get(), plain, autoFor(t))
      }
      if (providers.streamsNatively(t.kind)) return openai.chatRequest(t, try this.withInjected(t, b))
      return try providers.chatUpstream(t, try tc.get(), try this.withInjected(t, b), autoFor(t))
    }
    // the plugins across the attempts: each fallback sends the request its own pre hooks made (AttemptPlugins)
    const plugHook = hook
    const build: Build = (t) => {
      const cur = plugHook === undefined ? body : plugHook.body
      const curTyped = plugHook === undefined ? typed : plugHook.typed
      // a routed crew/<pool> candidate's reasoning effort goes on the body (crew.tov)
      const eff = cp.crewEffort
      const sh = try cp.shape(t.provider, t.kind, t.model, eff === "" ? cur : withReasoningEffort(cur, eff))
      if (sh.route === "responses") return openai.responsesRequest(t, streamedBody(sh.body, canPipe))
      if (eff !== "" && !sh.changed) return try sendChat(t, sh.body, new LazyChat(reasoningEffortText(cur, eff)))
      return try sendChat(t, sh.body, sh.changed ? new LazyChat(sh.text) : curTyped)
    }
    const outGuard = this.guardOutput ? guard : undefined
    const pluginRun = run
    const pluginChain = chain
    // an answer as the caller gets it: the reversible redaction restored, then the output guards
    const finishAnswer: AnswerStep = (out0) => {
      let out = out0
      if (reversible) out = try restoreCompletion(out, vault)
      if (outGuard === undefined) return out
      const g = try applyToCompletion(out, outGuard)
      for (const f of g.findings) metrics.inc("raiju_guardrail_findings_total", metrics.labels("", f.kind, outGuard.mode), 1.0)
      if (g.blocked) throw new SyntaxError("the response was blocked by guardrails")
      return g.body
    }
    const translate: Translate = (t, text, requested) => {
      if (!stream) {
        const sh = try cp.shape(t.provider, t.kind, t.model, plugHook === undefined ? body : plugHook.body)
        let src = text
        if (sh.route === "responses") {
          const rc = try responseToChat(text, requested)
          src = rc.body
        }
        const tr = try providers.chatTranslate(t.kind, t.model, src, requested, false)
        let out = tr.body
        // the answer as the cache keeps it, when the plugins before the cache change it after
        let cachedRaw: string | undefined = undefined
        if (pluginChain !== undefined && pluginRun !== undefined) {
          if (plugHook !== undefined) {
            plugHook.cachedBody = undefined
            plugHook.noStore = false
          }
          const sp = pluginChain.runPostSplit(&pluginRun.ctx, 200, out)
          if (sp.out.status >= 400) throw new SyntaxError(pluginErrorMessage(sp.out.status, sp.out.body))
          out = sp.out.body
          if (sp.cached.status < 400 && sp.cached.body !== sp.out.body) cachedRaw = sp.cached.body
        }
        const final = try finishAnswer(out)
        if (cachedRaw !== undefined && plugHook !== undefined) {
          try {
            plugHook.cachedBody = finishAnswer(cachedRaw)
          } catch (e) {
            plugHook.noStore = true
          }
        }
        return { body: final, promptTokens: tr.promptTokens, completionTokens: tr.completionTokens, served: tr.served, billed: tr.billed }
      }
      // a chat request converted to Responses, answered whole (not piped): its chat completion, as SSE
      const shs = try cp.shape(t.provider, t.kind, t.model, plugHook === undefined ? body : plugHook.body)
      if (shs.route === "responses") {
        const rc = try responseToChat(text, requested)
        return { body: try this.guardWhole(try completionToSse(rc.body, wantUsage), "chat", guardOn), promptTokens: rc.promptTokens, completionTokens: rc.completionTokens }
      }
      if (providers.streamsNatively(t.kind)) {
        const tr = openai.streamResponse(text, requested)
        return { body: try this.guardWhole(wantUsage ? tr.body : dropUsageChunks(tr.body), "chat", guardOn), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens, billed: tr.billed }
      }
      const tr = try providers.chatTranslate(t.kind, t.model, text, requested, false)
      return { body: try this.guardWhole(try completionToSse(tr.body, wantUsage), "chat", guardOn), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
    }
    // With a sink, OpenAI-format upstreams stream straight through as chunks arrive.
    const dropUsage = !wantUsage
    // the output guards (local rules and the built-in guard) check the stream as it accumulates (guard_stream.tov)
    const jsonOn = stream && this.jsonStreamOn
    const guardedConv = (c: StreamConverter): StreamConverter => {
      if (stream) c.guard = this.streamGuard("chat", guardOn, true)
      if (jsonOn) c.jsonFix = new JsonStreamFixer()
      return c
    }
    const mk: ConverterFactory = (t, requested) => {
      if (!streamable(t)) return undefined
      // a chat request converted to Responses: the Responses events come out as chat chunks
      if (cp.routeFor(t.provider, t.kind, t.model) === "responses") return guardedConv(new StreamConverter("responses", requested, wantUsage))
      const conv = new StreamConverter(converterKind(t), requested, !dropUsage)
      conv.stopAtFinish = quirkStopsAtFinish(t)
      return guardedConv(conv)
    }
    let res = try await this.serve(req, "chat", undefined, body, text, build, translate, stream, run === undefined ? undefined : run.ctx.headers, stream ? pipeSink : undefined, mk, cp, promptUsed, undefined, undefined, plugHook)
    // post hooks on an error answer (they may recover from it or change it); a stream's hooks ran per chunk
    if (chain !== undefined && run !== undefined) {
      if (pipeSink !== undefined && pipeSink.started) chain.finish(&run.ctx)
      else if (res.status >= 400) res = await errorPost(chain, run, res)
    }
    // external output guardrails see the whole answer, so they apply to non-streamed answers
    if (!guardOn || this.guardProviders.length === 0 || stream || res.status !== 200) return res
    let answer = ""
    try {
      answer = await res.text()
    } catch (e) {
      return errorResponse(502, `could not read the answer: ${e.message}`, "api_error", noHeaders())
    }
    const v = await this.externalGuard(completionText(answer), "output")
    if (v.action === "block") return errorResponse(400, `response blocked by guardrails: ${v.reason}`, "guardrail_violation", noHeaders())
    let out = answer
    const red = v.text
    if (red !== undefined) out = replaceFirstContent(answer, red)
    const hs: Record<string, string> = new Map()
    res.headers.forEach((value, key) => {
      if (key !== "content-length") hs.set(key, value)
    })
    return new Response(out, { status: 200, headers: hs })
  }

  async embeddings(req: Request): Promise<Response> {
    const text = await req.text()
    let body: Field[] = []
    try {
      body = fields(text)
    } catch (e) {
      return errorResponse(400, `invalid embeddings request: ${e.message}`, "invalid_request_error", noHeaders())
    }
    const build: Build = (t) => {
      if (!providers.supportsEmbeddings(t.kind)) throw new SyntaxError(`${t.provider} does not serve embeddings through this gateway yet`)
      return try providers.embeddingsUpstream(t, body)
    }
    const translate: Translate = (t, text, requested) => try providers.embeddingsTranslate(t.kind, t.model, text, requested)
    return try await this.serve(req, "embeddings", undefined, body, text, build, translate, false)
  }

  async completions(req: Request, sink?: StreamSink): Promise<Response> {
    const text = await req.text()
    let body: Field[] = []
    try {
      body = fields(text)
    } catch (e) {
      return errorResponse(400, `invalid completions request: ${e.message}`, "invalid_request_error", noHeaders())
    }
    const stream = rawBool(body, "stream") ?? false
    const wantUsage = streamUsage(body)
    const canPipe = stream && sink !== undefined
    const cp = new CompatPlan(withHeader(settingsOf(this.cfg.client?.compat), req.headers.get("x-bf-compat") ?? undefined), "completions", stream)
    const build: Build = (t) => {
      const sh = try cp.shape(t.provider, t.kind, t.model, body)
      if (sh.route === "chat") return try textAsChat(t, sh, stream, canPipe)
      if (t.kind === "replicate") return try replicateText(t, body)
      // Anthropic's legacy complete API answers whole, as in Bifrost (which has no Anthropic text stream). Bedrock's
      // InvokeModel text models stream on InvokeModelWithResponseStream, as Bifrost's TextCompletionStream; a stream
      // that cannot be piped is asked whole and sent as one frame.
      if (t.kind === "anthropic") {
        if (stream) throw new SyntaxError(`text_completion_stream is not supported by ${t.provider} provider`)
        return try anthropicNative.textRequest(t, sh.body)
      }
      if (t.kind === "bedrock") return canPipe ? try bedrockNative.textStreamRequest(t, sh.body) : try bedrockNative.textRequest(t, sh.body)
      // Sarvam's OpenAI-compatible API has chat only (Bifrost refuses its text completions)
      if (!providers.streamsNatively(t.kind) || t.kind === "sarvam") throw new SyntaxError(`${t.provider} does not serve text completions`)
      return openai.completionsRequest(t, sh.body)
    }
    const translate: Translate = (t, text, requested) => {
      const sh = try cp.shape(t.provider, t.kind, t.model, body)
      if (sh.route === "chat" || t.kind === "replicate") {
        // a chat answer read whole: a stream was sent as SSE (not piped), or a call made without streaming
        if (text.startsWith("data:")) {
          const sr = openai.streamResponse(text, requested)
          return { body: try this.guardWhole(chatSseToText(sr.body), "text", stream), promptTokens: sr.promptTokens, completionTokens: sr.completionTokens }
        }
        const tr = try providers.chatTranslate(t.kind, t.model, text, requested, false)
        if (!stream) return { body: try chatToText(tr.body), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
        return { body: try this.guardWhole(chatSseToText(try completionToSse(tr.body, wantUsage)), "text", true), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
      }
      if (t.kind === "anthropic") return try anthropicNative.textResponse(text, requested)
      if (t.kind === "bedrock") {
        const tr = try bedrockNative.textResponse(text, t.model, requested)
        if (!stream) return tr
        return { body: try this.guardWhole(try textAnswerSse(tr.body, wantUsage), "text", true), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
      }
      if (stream) {
        const sr = openai.streamResponse(text, requested)
        return { body: try this.guardWhole(sr.body, "text", true), promptTokens: sr.promptTokens, completionTokens: sr.completionTokens }
      }
      if (sh.route !== "chat") return try openai.chatResponse(text, requested)
      const tr = try providers.chatTranslate(t.kind, t.model, text, requested, false)
      return { body: try chatToText(tr.body), promptTokens: tr.promptTokens, completionTokens: tr.completionTokens }
    }
    // a text completion sent to a chat model streams as text_completion chunks, converted as they arrive
    // the local output guards check the streamed text (guard_stream.tov), in the text completion frames
    const mk: ConverterFactory = (t, requested) => {
      if (!streamable(t)) return undefined
      const conv = new StreamConverter(converterKind(t), requested, wantUsage)
      const chat = cp.routeFor(t.provider, t.kind, t.model) === "chat"
      // Bedrock's invoke stream of a text model is read as chat chunks, then framed as text completions
      if (!chat && t.kind === "bedrock") conv.invokeText()
      conv.txt = chat || t.kind === "bedrock"
      if (stream) conv.guard = this.streamGuard("text", true, true)
      return conv
    }
    return try await this.serve(req, "completions", undefined, body, text, build, translate, stream, undefined, canPipe ? sink : undefined, mk, cp)
  }
}

async function sendSpans(url: string, headers: Map<string, string>, body: string, tls: TlsOpts | undefined, timeoutMs: int): Promise<void> {
  try {
    const hs: Record<string, string> = headers
    const res = await fetch(url, { method: "POST", headers: hs, body: body, tls: tls, signal: deadline(timeoutMs).controller.signal })
    await res.text()
    if (!res.ok) console.error(`raiju: trace export returned HTTP ${res.status}`)
  } catch (e) {
    console.error(`raiju: trace export failed: ${e.message}`)
  }
}

// A whole text completion answer as a text completion stream: one frame with the choices, the usage frame when
// the caller asked for it (stream_options.include_usage), and [DONE].
export function textAnswerSse(answer: string, includeUsage: bool): string throws SyntaxError {
  const fs = try fields(answer)
  const usage = find(fs, "usage")
  let out = `data: ${build(without(fs, ["usage"]))}\n\n`
  if (includeUsage && usage !== undefined) {
    const head = fs.filter((f) => f.key === "id" || f.key === "object" || f.key === "created" || f.key === "model")
    head.push({ key: "choices", raw: "[]" })
    head.push({ key: "usage", raw: usage })
    out += `data: ${build(head)}\n\n`
  }
  return out + "data: [DONE]\n\n"
}

test("a whole text answer as a text stream", () => {
  const a = `{"id":"c1","object":"text_completion","created":1,"model":"m","choices":[{"index":0,"text":"hi","finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":2,"total_tokens":3}}`
  expect(try textAnswerSse(a, false)).toBe(`data: {"id":"c1","object":"text_completion","created":1,"model":"m","choices":[{"index":0,"text":"hi","finish_reason":"stop"}]}\n\ndata: [DONE]\n\n`)
  expect((try textAnswerSse(a, true)).includes(`data: {"id":"c1","object":"text_completion","created":1,"model":"m","choices":[],"usage":{"prompt_tokens":1,"completion_tokens":2,"total_tokens":3}}\n\n`)).toBe(true)
})

// Removes the trailing usage-only chunk the gateway asked for but the caller didn't.
export function dropUsageChunks(sse: string): string {
  return sse.split("\n\n").filter((e) => !(e.startsWith("data: ") && e.includes(`"choices":[]`) && e.includes(`"usage":`))).join("\n\n")
}

test("drops usage-only chunks", () => {
  const s = `data: {"choices":[{"delta":{}}]}\n\ndata: {"choices":[],"usage":{"prompt_tokens":1}}\n\ndata: [DONE]\n\n`
  expect(dropUsageChunks(s)).toBe(`data: {"choices":[{"delta":{}}]}\n\ndata: [DONE]\n\n`)
})

test("raw fields go into extra_fields, JSON bodies embedded and others quoted", () => {
  expect(withRawFields(`{"id":"x"}`, `{"model":"m"}`, `{"a":1}`)).toBe(`{"id":"x","extra_fields":{"raw_request":{"model":"m"},"raw_response":{"a":1}}}`)
  expect(withRawFields(`{}`, undefined, `{"a":1}`)).toBe(`{"extra_fields":{"raw_response":{"a":1}}}`)
  expect(withRawFields(`{"id":"x"}`, `not json`, undefined)).toBe(`{"id":"x","extra_fields":{"raw_request":"not json"}}`)
  // nothing to add, or not a JSON object: unchanged
  expect(withRawFields(`{"id":"x"}`, undefined, undefined)).toBe(`{"id":"x"}`)
  expect(withRawFields(`[1]`, `{}`, undefined)).toBe(`[1]`)
})

test("send-back-raw: the provider setting, overridden per request only when allowed", () => {
  const p: ProviderConfig = { send_back_raw_response: true }
  const cfg: Config = { client: { allow_per_request_raw_override: true } }
  const off: Config = { client: { allow_per_request_raw_override: false } }
  expect(sendBackRaw(hdrs([]), off, p, "response")).toBe(true)
  expect(sendBackRaw(hdrs([]), off, p, "request")).toBe(false)
  expect(sendBackRaw(hdrs([["x-bf-send-back-raw-response", "false"]]), cfg, p, "response")).toBe(false)
  expect(sendBackRaw(hdrs([["x-bf-send-back-raw-request", "true"]]), cfg, p, "request")).toBe(true)
  // the override is ignored unless allowed
  expect(sendBackRaw(hdrs([["x-bf-send-back-raw-response", "false"]]), off, p, "response")).toBe(true)
  expect(sendBackRaw(hdrs([["x-bf-send-back-raw-response", "garbage"]]), cfg, p, "response")).toBe(true)
})

test("direct key target: the caller's key replaces the pool", () => {
  const cfg: Config = { providers: new Map() }
  cfg.providers!.set("anthropic", { keys: [{ value: "pool-key" }] })
  const sel = directTarget(cfg, { provider: "anthropic", model: "claude-x" }, "caller-key")
  expect(sel.t.key.value).toBe("caller-key")
  expect(sel.t.kind).toBe("anthropic")
  expect(sel.keyIndex).toBe(-1)
})

test("store_raw_request_response: the header overrides the provider setting only when allowed", () => {
  const p: ProviderConfig = { store_raw_request_response: true }
  const off: ProviderConfig = {}
  const allow: Config = { client: { allow_per_request_content_storage_override: true } }
  const deny: Config = { client: {} }
  expect(storeRawOn(hdrs([]), deny, p)).toBe(true)
  expect(storeRawOn(hdrs([["x-bf-store-raw-request-response", "false"]]), deny, p)).toBe(true)
  expect(storeRawOn(hdrs([["x-bf-store-raw-request-response", "false"]]), allow, p)).toBe(false)
  expect(storeRawOn(hdrs([["x-bf-store-raw-request-response", "TRUE"]]), allow, off)).toBe(true)
  expect(storeRawOn(hdrs([]), allow, off)).toBe(false)
  expect(storeRawOn(hdrs([["x-bf-store-raw-request-response", "maybe"]]), allow, p)).toBe(true)
})

test("allowed_requests admits only the request types set to true", () => {
  const m: Map<string, bool> = new Map()
  m.set("chat_completion", true)
  m.set("embedding", false)
  const p: ProviderConfig = { custom_provider_config: { base_provider_type: "openai", allowed_requests: m } }
  expect(allowedRequest(p, "chat_completion")).toBe(true)
  expect(allowedRequest(p, "embedding")).toBe(false)
  expect(allowedRequest(p, "chat_completion_stream")).toBe(false)
  expect(allowedRequest({}, "embedding")).toBe(true)
})

test("does_not_send_done_marker without wait_for_usage ends at finish_reason", () => {
  const stop: Target = { provider: "x", kind: "openai", model: "m", key: { value: "" }, cfg: { custom_provider_config: { base_provider_type: "openai", does_not_send_done_marker: true } } }
  const wait: Target = { provider: "x", kind: "openai", model: "m", key: { value: "" }, cfg: { custom_provider_config: { base_provider_type: "openai", does_not_send_done_marker: true, wait_for_usage: true } } }
  expect(quirkStopsAtFinish(stop)).toBe(true)
  expect(quirkStopsAtFinish(wait)).toBe(false)
  const enc = new TextEncoder()
  const conv = new StreamConverter("openai", "openai/m", true)
  conv.stopAtFinish = true
  const a = conv.push(enc.encode(`data: {"model":"x","choices":[{"index":0,"delta":{"content":"hi"},"finish_reason":null}]}\n\ndata: {"model":"x","choices":[{"index":0,"delta":{},"finish_reason":"stop"}]}\n\ndata: {"model":"x","choices":[],"usage":{"prompt_tokens":3,"completion_tokens":4,"total_tokens":7}}\n\n`))
  const b = conv.end()
  const all = a + b
  expect(all.includes(`"content":"hi"`)).toBe(true)
  expect(all.includes("prompt_tokens")).toBe(false)
  expect(all.endsWith("data: [DONE]\n\n")).toBe(true)
  expect(conv.promptTokens()).toBe(0)
})

test("a Responses stream and a chat stream answering a text completion come out as their chunks", () => {
  const rc = new StreamConverter("responses", "openai/m", false)
  const rsse = "event: response.output_text.delta\ndata: {\"delta\":\"hi\"}\n\nevent: response.completed\ndata: {\"response\":{}}\n\n"
  const rout = rc.push(new TextEncoder().encode(rsse)) + rc.end()
  expect(rout.includes(`"delta":{"content":"hi"}`)).toBe(true)
  expect(rout.endsWith("data: [DONE]\n\n")).toBe(true)
  const tc = new StreamConverter("openai", "openai/m", false)
  tc.txt = true
  const csse = `data: {"id":"c","object":"chat.completion.chunk","created":1,"model":"m","choices":[{"index":0,"delta":{"content":"yo"},"finish_reason":null}]}\n\n`
  const tout = tc.push(new TextEncoder().encode(csse)) + tc.end()
  expect(tout.includes(`"text":"yo"`) && tout.includes(`"object":"text_completion"`)).toBe(true)
  expect(tout.endsWith("data: [DONE]\n\n")).toBe(true)
})

test("finishes sees a non-null finish_reason only", () => {
  expect(finishes(`{"choices":[{"delta":{},"finish_reason":"stop"}]}`)).toBe(true)
  expect(finishes(`{"choices":[{"delta":{"content":"a"},"finish_reason":null}]}`)).toBe(false)
  expect(finishes(`{"choices":[],"usage":{"prompt_tokens":1}}`)).toBe(false)
  expect(finishes("not json finish_reason")).toBe(false)
})

test("per-provider limiters follow concurrency_and_buffer_size and carry over unchanged", () => {
  const off: Map<string, ProviderConfig> = new Map()
  off.set("plain", {})
  expect(limitersFor({ providers: off, client: { drop_excess_requests: true } }).size).toBe(1)
  expect(limitersFor({ providers: off }).size).toBe(0)
  const ps: Map<string, ProviderConfig> = new Map()
  ps.set("slow", { concurrency_and_buffer_size: { concurrency: 2, buffer_size: 4 } })
  ps.set("plain", {})
  const cfg: Config = { providers: ps, client: { drop_excess_requests: true } }
  const made = limitersFor(cfg)
  // with drop on, the provider without a queue gets Bifrost's default one
  expect(made.size).toBe(2)
  expect(made.get("plain")!.limit).toBe(1000)
  expect(made.get("plain")!.buffer).toBe(5000)
  expect(made.get("slow")!.limit).toBe(2)
  expect(made.get("slow")!.buffer).toBe(4)
  expect(made.get("slow")!.drop).toBe(true)
  const again = limitersFor(cfg)
  const kept = carryLimiters(again, made)
  expect(kept.get("slow") === made.get("slow")).toBe(true)
  const changed: Map<string, ProviderConfig> = new Map()
  changed.set("slow", { concurrency_and_buffer_size: { concurrency: 3, buffer_size: 4 } })
  const moved = carryLimiters(limitersFor({ providers: changed }), made)
  expect(moved.get("slow")!.limit).toBe(3)
  expect(moved.get("slow") === made.get("slow")).toBe(false)
})

test("injected tools are named as configured and point at their MCP tool", () => {
  const all = [`{"type":"function","function":{"name":"weather-get_weather","description":"d","parameters":{"type":"object"}}}`]
  const it: InjectedTool = { name: "forecast", mcp_client_name: "weather", tool_name: "get_weather" }
  const def = try injectedDef(all, it)
  expect(def !== undefined).toBe(true)
  expect(def!.includes(`"name":"forecast"`)).toBe(true)
  expect(def!.includes("weather-get_weather")).toBe(false)
  const missing = try injectedDef(all, { name: "x", mcp_client_name: "nope", tool_name: "y" })
  expect(missing === undefined).toBe(true)
  const ps: Map<string, ProviderConfig> = new Map()
  ps.set("p", { injected_tools: [it] })
  expect(injectedNames({ providers: ps }).includes("forecast")).toBe(true)
  expect(injectedChatName({ providers: ps }, "forecast")).toBe("weather-get_weather")
  expect(injectedChatName({ providers: ps }, "other") === undefined).toBe(true)
})

test("x-bf-mcp-include-tools: a list of client-tool names, client-* wildcards, and an empty list", () => {
  const search = `{"type":"function","function":{"name":"search-find","parameters":{"type":"object"}}}`
  const fetchTool = `{"type":"function","function":{"name":"search-fetch","parameters":{"type":"object"}}}`
  const weather = `{"type":"function","function":{"name":"weather-get","parameters":{"type":"object"}}}`
  expect(includeToolNames(" search-find, weather-* ,").join("|")).toBe("search-find|weather-*")
  expect(includeToolNames("").length).toBe(0)
  const one = ["search-find"]
  expect(try toolInList(search, one)).toBe(true)
  expect(try toolInList(fetchTool, one)).toBe(false)
  expect(try toolInList(weather, ["weather-*"])).toBe(true)
  expect(try toolInList(search, ["weather-*"])).toBe(false)
  expect(try toolInList(search, ["search"])).toBe(false)
  expect(try toolInList(search, [])).toBe(false)
})

test("logs_only: moved local rules and the built-in guard put placeholders in the stored copy only", () => {
  const providers: GuardrailProvider[] = [
    { id: "sec", kind: "secrets", action: "redact", redaction_mode: "logs_only" },
    { id: "rx", kind: "regex", patterns: [{ pattern: "PROJ-\\d+", description: "Project code", action: "redact", redaction_mode: "logs_only" }, { pattern: "ACME-\\d+", description: "Acme code", action: "redact" }] },
  ]
  let live = compileLocalRules(providers)
  const moved = splitLogsOnly(providers, &live)
  expect((live.get("sec") ?? []).length).toBe(0)
  expect((moved.get("sec") ?? []).length > 0).toBe(true)
  expect((live.get("rx") ?? []).length).toBe(1)
  expect((moved.get("rx") ?? []).length).toBe(1)
  const g: GuardConfig = { detect: ["email"], mode: "redact" }
  const vault = new Vault()
  const out = logsOnlyText(`{"content":"mail a@b.io about PROJ-12 and ACME-3, then a@b.io again"}`, g, moved.values(), vault)
  expect(out).toBe(`{"content":"mail [EMAIL-1] about [PROJECT_CODE-1] and ACME-3, then [EMAIL-1] again"}`)
  expect(logsOnlyText("", g, moved.values(), vault)).toBe("")
})

// ---- the plugins across attempts (AttemptPlugins) ----

// A plugin that records its hooks in ctx.values "trace", stamps the model it saw into the request, short-circuits a
// model named mock-ok (an answer), mock-final (an error with no fallbacks) or mock-soft (an error the fallbacks may
// take), and recovers an error of status 599.
class AttemptProbe extends BasePlugin {
  name(): string {
    return "probe"
  }

  preRequest(inout ctx: PluginContext, body: string): PreResult throws Error {
    const prev = ctx.values.get("trace") ?? ""
    ctx.values.set("trace", prev + " pre:" + ctx.model)
    if (ctx.model.endsWith("mock-ok")) return { kind: "short_circuit", status: 200, body: `{"mock":true}`, contentType: "application/json" }
    if (ctx.model.endsWith("mock-final")) return { kind: "short_circuit", status: 503, body: `{"error":{"message":"final"}}`, contentType: "application/json", allowFallbacks: false }
    if (ctx.model.endsWith("mock-soft")) return { kind: "short_circuit", status: 503, body: `{"error":{"message":"soft"}}`, contentType: "application/json" }
    let fs = try fields(body)
    setField(&fs, "seen", quote(ctx.model))
    return { kind: "continue", body: build(fs) }
  }

  postResponse(inout ctx: PluginContext, status: int, body: string): PostResult {
    const prev = ctx.values.get("trace") ?? ""
    ctx.values.set("trace", prev + " post:" + status)
    if (status === 599) return { kind: "status", status: 200, body: `{"recovered":true}` }
    return { kind: "continue", body: body + "!" }
  }
}

function attemptHookFor(model: string): AttemptPlugins {
  const chain = new PluginChain([new AttemptProbe()])
  const run = new PluginRun({ requestId: "r", op: "chat", model: model, provider: "", headers: new Map(), values: new Map() })
  const original = `{"model":${quote(model)},"messages":[]}`
  const pre = chain.runPre(&run.ctx, original)
  const text = pre.kind === "continue" ? pre.body : original
  let body: Field[] = []
  try {
    body = fields(text)
  } catch (e) {
    body = []
  }
  return new AttemptPlugins(chain, run, original, body, text)
}

test("a fallback runs the pre hooks again on the request as it came, after the failed attempt's post hooks", () => {
  const ah = attemptHookFor("openai/a")
  expect(ah.text.includes(`"seen":"openai/a"`)).toBe(true)
  expect(ah.stepAt(0, { provider: "openai", model: "a" }, { status: 404, body: "" }).kind).toBe("go")
  const s = ah.stepAt(1, { provider: "anthropic", model: "b" }, { status: 503, body: `{"error":{"message":"down"}}` })
  expect(s.kind).toBe("go")
  expect(ah.run.ctx.values.get("trace")).toBe(" pre:openai/a post:503 pre:anthropic/b")
  expect(ah.text.includes(`"model":"anthropic/b"`) && ah.text.includes(`"seen":"anthropic/b"`)).toBe(true)
  expect(rawStr(ah.body, "seen")).toBe("anthropic/b")
  expect(ah.run.ctx.provider).toBe("anthropic")
})

test("a failed attempt a post hook recovers is the answer, and a fallback's short circuit answers or moves on", () => {
  const ah = attemptHookFor("openai/a")
  const rec = ah.stepAt(1, { provider: "openai", model: "b" }, { status: 599, body: `{"error":{"message":"x"}}` })
  expect(rec.kind === "answer" && rec.body === `{"recovered":true}`).toBe(true)
  const ok = attemptHookFor("openai/a")
  const answered = ok.stepAt(1, { provider: "openai", model: "mock-ok" }, { status: 503, body: "{}" })
  expect(answered.kind === "answer" && answered.status === 200 && answered.body === `{"mock":true}!`).toBe(true)
  const fin = attemptHookFor("openai/a")
  expect(fin.stepAt(1, { provider: "openai", model: "mock-final" }, { status: 503, body: "{}" }).kind).toBe("final")
  const soft = attemptHookFor("openai/a")
  const f = soft.stepAt(1, { provider: "openai", model: "mock-soft" }, { status: 503, body: "{}" })
  expect(f.kind === "fail" && f.status === 503).toBe(true)
  // the soft error's post hooks ran already: the next attempt does not run them again
  const next = soft.stepAt(2, { provider: "openai", model: "c" }, { status: 503, body: "{}" })
  expect(next.kind).toBe("go")
  expect(soft.run.ctx.values.get("trace")).toBe(" pre:openai/a post:503 pre:openai/mock-soft post:503 pre:openai/c")
})

test("the primary's short-circuit error goes through the post hooks and on to the fallbacks", () => {
  const ah = attemptHookFor("openai/mock-soft")
  ah.primaryFail = { status: 503, body: `{"error":{"message":"soft"}}` }
  const s = ah.stepAt(0, { provider: "openai", model: "mock-soft" }, { status: 0, body: "" })
  expect(s.kind === "fail" && s.status === 503).toBe(true)
  expect(ah.primaryFail === undefined).toBe(true)
  expect(ah.stepAt(1, { provider: "openai", model: "d" }, { status: 503, body: "{}" }).kind).toBe("go")
})

test("a cache hit goes through the post hooks of the plugins before the cache only", () => {
  const before = attemptHookFor("openai/a")
  before.chain.ranks = [0]
  expect(before.onHit(`{"cached":1}`).body).toBe(`{"cached":1}!`)
  const after = attemptHookFor("openai/a")
  expect(after.onHit(`{"cached":1}`).body).toBe(`{"cached":1}`)
})

test("a post_builtin plugin's pre hook runs at the primary attempt, after the cache lookup, and its post hook still runs", () => {
  // the probe is post_builtin (rank 2): the pre hooks before the cache run none, the primary attempt runs it
  const chain = new PluginChain([new AttemptProbe()])
  chain.ranks = [2]
  const run = new PluginRun({ requestId: "r", op: "chat", model: "openai/a", provider: "", headers: new Map(), values: new Map() })
  const original = `{"model":"openai/a","messages":[]}`
  const first = chain.runPreBeforeCache(&run.ctx, original)
  expect(first.kind === "continue" && first.body === original).toBe(true)
  expect(run.ctx.values.get("trace") ?? "").toBe("")
  expect(chain.hasAfterCache("chat")).toBe(true)
  const ah = new AttemptPlugins(chain, run, original, try fields(original), original)
  ah.late = true
  expect(ah.stepAt(0, { provider: "openai", model: "a" }, { status: 0, body: "" }).kind).toBe("go")
  expect(rawStr(ah.body, "seen")).toBe("openai/a")
  expect(ah.late).toBe(false)
  expect(chain.runPost(&run.ctx, 200, "{}").body).toBe("{}!")
  // its short circuit answers the primary attempt, through the post hooks
  const run2 = new PluginRun({ requestId: "r2", op: "chat", model: "openai/mock-ok", provider: "", headers: new Map(), values: new Map() })
  chain.runPreBeforeCache(&run2.ctx, `{}`)
  const ah2 = new AttemptPlugins(chain, run2, `{}`, [], `{}`)
  ah2.late = true
  const s = ah2.stepAt(0, { provider: "openai", model: "mock-ok" }, { status: 0, body: "" })
  expect(s.kind === "answer" && s.body === `{"mock":true}!`).toBe(true)
})

test("the user a key is assigned to is named from the admin users", () => {
  const cfg: Config = { governance: { users: [{ name: "ada", role: "viewer" }] } }
  expect(userNameOf(cfg, "ada")).toBe("ada")
  expect(userNameOf(cfg, "nobody")).toBe("")
  expect(userNameOf(cfg, "")).toBe("")
})

// Weak links to what one streamed answer allocates: they read undefined once it is freed.
class FreedProbe {
  weak head: LiveHead | undefined = undefined
  weak sink: StreamSink | undefined = undefined
  weak bill: MediaBill | undefined = undefined
}

function streamOnce(p: FreedProbe, opened: bool): void {
  const head = new LiveHead()
  const sink = headSink(head)
  p.head = head
  p.sink = sink
  if (opened) {
    sink.open(200, new Map())
    sink.write("data: {}\n\n")
    sink.close()
  } else {
    // a run that answered without streaming (an error, a cache hit)
    head.give(new Response("{}"))
    head.release()
  }
}

test("a streamed answer's head and sink are freed when the stream closes, or when it never opened", () => {
  const p = new FreedProbe()
  streamOnce(p, true)
  expect(p.head === undefined).toBe(true)
  expect(p.sink === undefined).toBe(true)
  const q = new FreedProbe()
  streamOnce(q, false)
  expect(q.head === undefined).toBe(true)
  expect(q.sink === undefined).toBe(true)
})

function hookedOnce(p: FreedProbe): void {
  const real = new StreamSink((status, headers) => {}, (chunk) => {}, () => {})
  const s = eventSink(real, (block) => ({ kind: "send", block: block }))
  p.sink = s
  s.write("data: {}\n\n")
  s.close()
}

test("an event sink is freed with its stream (its callbacks reach it through a weak link)", () => {
  const p = new FreedProbe()
  hookedOnce(p)
  expect(p.sink === undefined).toBe(true)
})

function billOnce(e: Engine, p: FreedProbe): void {
  const bill = e.mediaBill(new Map())
  p.bill = bill
  expect(bill.gate("openai", "tts-1")).toBeUndefined()
  expect(bill.grant !== undefined).toBe(true)
}

test("an audio request's bill is freed after the request (its gate reaches it through a weak link)", () => {
  const e = new Engine({})
  const p = new FreedProbe()
  billOnce(e, p)
  expect(p.bill === undefined).toBe(true)
})

test("a virtual key with no mcp_configs gets no MCP tools but allow_by_default ones, as in Bifrost", () => {
  const e = new Engine({ governance: { virtual_keys: [
    { id: "vk-none", value: "sk-bf-none" },
    { id: "vk-some", value: "sk-bf-some", mcp_configs: [{ mcp_client_name: "fs", tools_to_execute: ["read"] }] },
  ] } })
  const h: Hdrs = new Map()
  h.set("x-bf-vk", "sk-bf-none")
  // an empty grant (before, a key without the list was not limited at all)
  const none = e.keyMcp(h)
  expect(none?.length).toBe(0)
  expect(keyRuleAllows(none, "fs", "read", false)).toBe(false)
  expect(keyRuleAllows(none, "open", "anything", true)).toBe(true)
  // a virtual MCP the key was given decides by its own allowed keys
  expect(e.keyMcp(h, "my-vmcp")).toBeUndefined()
  const some: Hdrs = new Map()
  some.set("x-bf-vk", "sk-bf-some")
  expect(e.keyMcp(some)?.length).toBe(1)
  // a request without a virtual key is not limited by key rules
  expect(e.keyMcp(new Map())).toBeUndefined()
})
