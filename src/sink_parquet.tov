// A minimal Parquet writer for the log export: one file, one row group, one
// data page per column, PLAIN values, every column OPTIONAL with RLE
// definition levels, and no compression (or GZIP pages, for the hybrid log
// payloads). It writes the log entry columns (a null is a missing field). The
// format is the parquet-format spec, checked by reading the files back with
// pyarrow. parquetRow reads the first row of a file's string columns back
// (the hybrid log store's payload objects, hybrid.tov).
import { utf8 } from "./crypto"
import { LogEntry } from "./logstore"
import { gzipBytes, gunzip } from "./gzip"

const T_BOOL = 0
const T_INT32 = 1
const T_INT64 = 2
const T_DOUBLE = 5
const T_BYTE_ARRAY = 6

const ENC_PLAIN = 0
const ENC_RLE = 3
const REP_OPTIONAL = 1
const CT_UTF8 = 0
const CODEC_NONE = 0
const CODEC_GZIP = 2
const PAGE_DATA = 0

export type PqKind = "string" | "double" | "int32" | "int64" | "bool"

// One value. Only the field for the column's kind is read; a null cell is
// undefined in the column.
export type PqCell = { s: string, n: f64, b: bool }

export type PqColumn = { name: string, kind: PqKind, cells: (PqCell | undefined)[] }

// ---- little-endian values ----

function le32(v: int): u8[] {
  return [u8(v & 0xff), u8((v >> 8) & 0xff), u8((v >> 16) & 0xff), u8((v >> 24) & 0xff)]
}

// The 8 bytes of an IEEE 754 double, little-endian. Subnormals are written as
// zero; the log's numbers (costs, latencies) are never that small.
export function f64Bytes(x: f64): u8[] {
  let a = Math.abs(x)
  let e = 0
  if (a > 0.0) {
    while (a >= 2.0) {
      a = a / 2.0
      e += 1
    }
    while (a < 1.0) {
      a = a * 2.0
      e -= 1
    }
  }
  let biased = 0
  let mant = 0
  if (a > 0.0) {
    biased = e + 1023
    mant = Math.round((a - 1.0) * 4503599627370496.0)
  }
  if (biased >= 2047) {
    biased = 2047
    mant = 0
  }
  const hiMant = Math.floor(mant / 4294967296.0)
  const loMant = mant - hiMant * 4294967296.0
  const hi = (x < 0.0 ? 2147483648 : 0) + biased * 1048576 + hiMant
  return le32(Math.floor(loMant)).concat(le32(Math.floor(hi)))
}

function le64(v: f64): u8[] {
  const hi = Math.floor(v / 4294967296.0)
  const lo = v - hi * 4294967296.0
  return le32(Math.floor(lo)).concat(le32(Math.floor(hi)))
}

// ---- RLE definition levels, bit width 1, as bit-packed groups of 8 ----

function levels(present: bool[]): u8[] {
  const n = present.length
  const groups = Math.floor((n + 7) / 8)
  const out: u8[] = uvarintOf((groups << 1) | 1)
  for (let g = 0; g < groups; g++) {
    let byte = 0
    for (let i = 0; i < 8; i++) {
      const k = g * 8 + i
      if (k < n && present[k] === true) byte |= 1 << i
    }
    out.push(u8(byte))
  }
  // the data page prefixes the levels with their byte length
  return le32(out.length).concat(out)
}

function uvarintOf(v: int): u8[] {
  const out: u8[] = []
  let n = v
  while (n >= 128) {
    out.push(u8((n & 0x7f) | 0x80))
    n = n >> 7
  }
  out.push(u8(n))
  return out
}

function appendAll(inout dst: u8[], src: u8[]): void {
  for (const x of src) dst.push(x)
}

function zz(v: int): int {
  return v >= 0 ? v * 2 : -v * 2 - 1
}

// ---- thrift compact protocol, the encoding of the footer and page headers ----

class Tw {
  buf: u8[] = []
  private last: int = 0
  private saved: int[] = []

  private head(id: int, type: int): void {
    const delta = id - this.last
    if (delta > 0 && delta <= 15) {
      this.buf.push(u8((delta << 4) | type))
    } else {
      this.buf.push(u8(type))
      this.raw(uvarintOf(zz(id)))
    }
    this.last = id
  }

  private raw(b: u8[]): void {
    for (const x of b) this.buf.push(x)
  }

  i32(id: int, v: int): void {
    this.head(id, 5)
    this.raw(uvarintOf(zz(v)))
  }

  i64(id: int, v: f64): void {
    this.head(id, 6)
    this.raw(uvarintOf(zz(Math.floor(v))))
  }

  binary(id: int, b: u8[]): void {
    this.head(id, 8)
    this.raw(uvarintOf(b.length))
    this.raw(b)
  }

  str(id: int, s: string): void {
    this.binary(id, utf8(s))
  }

  // A field holding a list: its header, then the elements written by the caller.
  listOf(id: int, elem: int, n: int): void {
    this.head(id, 9)
    if (n < 15) {
      this.buf.push(u8((n << 4) | elem))
    } else {
      this.buf.push(u8(0xf0 | elem))
      this.raw(uvarintOf(n))
    }
  }

  // A field holding a struct, or a list element that is a struct (no header).
  beginStruct(id: int): void {
    this.head(id, 12)
    this.saved.push(this.last)
    this.last = 0
  }

  beginElem(): void {
    this.saved.push(this.last)
    this.last = 0
  }

  endStruct(): void {
    this.buf.push(0)
    const back = this.saved.pop()
    this.last = back ?? 0
  }

  elemI32(v: int): void {
    this.raw(uvarintOf(zz(v)))
  }

  elemStr(s: string): void {
    const b = utf8(s)
    this.raw(uvarintOf(b.length))
    this.raw(b)
  }
}

// ---- pages and the file ----

// One non-null value, PLAIN. Booleans collect into boolBits and are packed later.
function encodeCell(kind: PqKind, c: PqCell, inout values: u8[], inout boolBits: bool[]): void {
  if (kind === "string") {
    const b = utf8(c.s)
    appendAll(&values, le32(b.length))
    appendAll(&values, b)
  } else if (kind === "double") {
    appendAll(&values, f64Bytes(c.n))
  } else if (kind === "int32") {
    appendAll(&values, le32(Math.floor(c.n)))
  } else if (kind === "int64") {
    appendAll(&values, le64(c.n))
  } else {
    boolBits.push(c.b)
  }
}

// A data page: the page header, then the definition levels and the PLAIN values.
function pageOf(col: PqColumn): { bytes: u8[], typ: int } {
  const present: bool[] = []
  let values: u8[] = []
  let boolBits: bool[] = []
  for (const cell of col.cells) {
    if (cell === undefined) {
      present.push(false)
    } else {
      present.push(true)
      encodeCell(col.kind, cell, &values, &boolBits)
    }
  }
  if (col.kind === "bool") {
    // booleans are bit-packed, least significant bit first
    const groups = Math.floor((boolBits.length + 7) / 8)
    for (let g = 0; g < groups; g++) {
      let byte = 0
      for (let i = 0; i < 8; i++) {
        const k = g * 8 + i
        if (k < boolBits.length && boolBits[k] === true) byte |= 1 << i
      }
      values.push(u8(byte))
    }
  }
  const typ = col.kind === "string" ? T_BYTE_ARRAY : col.kind === "double" ? T_DOUBLE : col.kind === "int32" ? T_INT32 : col.kind === "int64" ? T_INT64 : T_BOOL
  const data = levels(present).concat(values)
  return { bytes: data, typ: typ }
}

function pageHeader(numValues: int, size: int, stored: int): u8[] {
  const t = new Tw()
  t.beginElem()
  t.i32(1, PAGE_DATA)
  t.i32(2, size)
  t.i32(3, stored)
  t.beginStruct(5)
  t.i32(1, numValues)
  t.i32(2, ENC_PLAIN)
  t.i32(3, ENC_RLE)
  t.i32(4, ENC_RLE)
  t.endStruct()
  t.endStruct()
  return t.buf
}

// A Parquet file for the columns, which must all have the same length.
export function parquetFile(cols: PqColumn[]): u8[] {
  return parquetFileWith(cols, false)
}

// parquetFile, with each page GZIP-compressed when gz (the column chunks then name the GZIP codec).
export function parquetFileWith(cols: PqColumn[], gz: bool): u8[] {
  const rows = cols.length === 0 ? 0 : cols[0]!.cells.length
  const body: u8[] = utf8("PAR1")
  const chunks: { off: int, typ: int, size: int, raw: int, name: string }[] = []
  for (const col of cols) {
    const p = pageOf(col)
    const data = gz ? gzipBytes(p.bytes) : p.bytes
    const hdr = pageHeader(rows, p.bytes.length, data.length)
    chunks.push({ off: body.length, typ: p.typ, size: hdr.length + data.length, raw: hdr.length + p.bytes.length, name: col.name })
    for (const x of hdr) body.push(x)
    for (const x of data) body.push(x)
  }
  const t = new Tw()
  t.i32(1, 1)
  // schema: the root, then one leaf per column
  t.listOf(2, 12, cols.length + 1)
  t.beginElem()
  t.str(4, "schema")
  t.i32(5, cols.length)
  t.endStruct()
  for (const col of cols) {
    t.beginElem()
    t.i32(1, typeOfKind(col.kind))
    t.i32(3, REP_OPTIONAL)
    t.str(4, col.name)
    if (col.kind === "string") t.i32(6, CT_UTF8)
    t.endStruct()
  }
  t.i64(3, rows)
  // one row group holding a column chunk per column
  t.listOf(4, 12, 1)
  t.beginElem()
  t.listOf(1, 12, chunks.length)
  let total = 0
  for (let i = 0; i < chunks.length; i++) {
    const c = chunks[i]!
    total += c.size
    t.beginElem()
    t.i64(2, c.off)
    t.beginStruct(3)
    t.i32(1, c.typ)
    t.listOf(2, 5, 2)
    t.elemI32(ENC_PLAIN)
    t.elemI32(ENC_RLE)
    t.listOf(3, 8, 1)
    t.elemStr(c.name)
    t.i32(4, gz ? CODEC_GZIP : CODEC_NONE)
    t.i64(5, rows)
    t.i64(6, c.raw)
    t.i64(7, c.size)
    t.i64(9, c.off)
    t.endStruct()
    t.endStruct()
  }
  t.i64(2, total)
  t.i64(3, rows)
  t.endStruct()
  t.str(6, "raiju")
  t.endStruct()
  const footer = t.buf
  const out = body.concat(footer).concat(le32(footer.length)).concat(utf8("PAR1"))
  return out
}

function typeOfKind(k: PqKind): int {
  if (k === "string") return T_BYTE_ARRAY
  if (k === "double") return T_DOUBLE
  if (k === "int32") return T_INT32
  if (k === "int64") return T_INT64
  return T_BOOL
}

// ---- the log entry columns ----

function strCells(vals: (string | undefined)[]): (PqCell | undefined)[] {
  return vals.map((v) => (v === undefined ? undefined : { s: v, n: 0.0, b: false }))
}

function numCells(vals: (f64 | undefined)[]): (PqCell | undefined)[] {
  return vals.map((v) => (v === undefined ? undefined : { s: "", n: v, b: false }))
}

function boolCells(vals: (bool | undefined)[]): (PqCell | undefined)[] {
  return vals.map((v) => (v === undefined ? undefined : { s: "", n: 0.0, b: v }))
}

// One row per entry, the fields Raiju logs. Content columns are null unless
// the entry carries content.
export function logColumns(rows: LogEntry[]): PqColumn[] {
  return [
    { name: "id", kind: "string", cells: strCells(rows.map((e) => e.id)) },
    { name: "ts", kind: "double", cells: numCells(rows.map((e) => e.ts)) },
    { name: "request_id", kind: "string", cells: strCells(rows.map((e) => e.request_id)) },
    { name: "op", kind: "string", cells: strCells(rows.map((e) => e.op)) },
    { name: "provider", kind: "string", cells: strCells(rows.map((e) => e.provider)) },
    { name: "model", kind: "string", cells: strCells(rows.map((e) => e.model)) },
    { name: "status", kind: "int32", cells: numCells(rows.map((e) => e.status * 1.0)) },
    { name: "latency_ms", kind: "double", cells: numCells(rows.map((e) => e.latency_ms)) },
    { name: "prompt_tokens", kind: "int64", cells: numCells(rows.map((e) => e.prompt_tokens * 1.0)) },
    { name: "completion_tokens", kind: "int64", cells: numCells(rows.map((e) => e.completion_tokens * 1.0)) },
    { name: "cost", kind: "double", cells: numCells(rows.map((e) => e.cost)) },
    { name: "cache_hit", kind: "bool", cells: boolCells(rows.map((e) => e.cache_hit)) },
    { name: "virtual_key", kind: "string", cells: strCells(rows.map((e) => e.virtual_key)) },
    { name: "error", kind: "string", cells: strCells(rows.map((e) => e.error)) },
    { name: "input", kind: "string", cells: strCells(rows.map((e) => e.input)) },
    { name: "output", kind: "string", cells: strCells(rows.map((e) => e.output)) },
  ]
}

// The export body for a batch of entries, as a Parquet file.
export function logParquet(rows: LogEntry[]): u8[] {
  return parquetFile(logColumns(rows))
}

// ---- reading the first row of a file's string columns ----

// The thrift compact protocol, read: field headers, the values Parquet's footer uses, and skipping the rest.
class Tr {
  pos: int
  private last: int = 0
  private saved: int[] = []
  constructor(readonly b: u8[], start: int) {
    this.pos = start
  }

  byte(): int throws Error {
    if (this.pos >= this.b.length) throw new Error("parquet footer ends early")
    const v = int(this.b[this.pos]!)
    this.pos += 1
    return v
  }

  uvarint(): int throws Error {
    let v = 0
    let shift = 0
    for (;;) {
      const x = try this.byte()
      v = v | ((x & 0x7f) << shift)
      if ((x & 0x80) === 0) return v
      shift += 7
      if (shift > 63) throw new Error("bad varint in parquet footer")
    }
  }

  zigzag(): int throws Error {
    const v = try this.uvarint()
    return (v & 1) === 1 ? -((v >> 1) + 1) : v >> 1
  }

  bytes(): u8[] throws Error {
    const n = try this.uvarint()
    if (this.pos + n > this.b.length) throw new Error("parquet footer ends early")
    const out = this.b.slice(this.pos, this.pos + n)
    this.pos += n
    return out
  }

  // The next field of the current struct: its id and type, or type 0 at the struct's end.
  field(): { id: int, type: int } throws Error {
    const h = try this.byte()
    if (h === 0) return { id: 0, type: 0 }
    const type = h & 0x0f
    const delta = h >> 4
    const id = delta === 0 ? (try this.zigzag()) : this.last + delta
    this.last = id
    return { id: id, type: type }
  }

  enter(): void {
    this.saved.push(this.last)
    this.last = 0
  }

  leave(): void {
    const back = this.saved.pop()
    this.last = back ?? 0
  }

  // A list header: its element type and size.
  list(): { elem: int, n: int } throws Error {
    const h = try this.byte()
    const n = (h >> 4) === 15 ? (try this.uvarint()) : h >> 4
    return { elem: h & 0x0f, n: n }
  }

  skip(type: int): void throws Error {
    if (type === 1 || type === 2) return
    if (type === 3) {
      try this.byte()
      return
    }
    if (type === 4 || type === 5 || type === 6) {
      try this.uvarint()
      return
    }
    if (type === 7) {
      this.pos += 8
      return
    }
    if (type === 8) {
      try this.bytes()
      return
    }
    if (type === 9 || type === 10) {
      const l = try this.list()
      for (let i = 0; i < l.n; i++) try this.skip(l.elem)
      return
    }
    if (type === 11) {
      const n = try this.uvarint()
      if (n === 0) return
      const kv = try this.byte()
      for (let i = 0; i < n; i++) {
        try this.skip(kv >> 4)
        try this.skip(kv & 0x0f)
      }
      return
    }
    if (type === 12) {
      this.enter()
      for (;;) {
        const f = try this.field()
        if (f.type === 0) break
        try this.skip(f.type)
      }
      this.leave()
      return
    }
    throw new Error(`unknown thrift type ${type} in parquet footer`)
  }
}

function rd32(b: u8[], at: int): int throws Error {
  if (at < 0 || at + 4 > b.length) throw new Error("parquet data ends early")
  return int(b[at]!) | (int(b[at + 1]!) << 8) | (int(b[at + 2]!) << 16) | (int(b[at + 3]!) << 24)
}

type PqLeaf = { name: string, type: int, optional: bool }
type PqChunk = { name: string, codec: int, offset: int }

function readSchema(t: Tr): PqLeaf[] throws Error {
  const out: PqLeaf[] = []
  const l = try t.list()
  for (let i = 0; i < l.n; i++) {
    t.enter()
    let name = ""
    let type = -1
    let rep = 0
    let children = 0
    for (;;) {
      const f = try t.field()
      if (f.type === 0) break
      if (f.id === 1 && f.type === 5) type = try t.zigzag()
      else if (f.id === 3 && f.type === 5) rep = try t.zigzag()
      else if (f.id === 4 && f.type === 8) name = try new TextDecoder().decode(try t.bytes())
      else if (f.id === 5 && f.type === 5) children = try t.zigzag()
      else try t.skip(f.type)
    }
    t.leave()
    // the root (and any group) has children and no type
    if (children === 0 && type >= 0) out.push({ name: name, type: type, optional: rep === 1 })
  }
  return out
}

function readChunks(t: Tr): PqChunk[] throws Error {
  const out: PqChunk[] = []
  const groups = try t.list()
  for (let g = 0; g < groups.n; g++) {
    t.enter()
    for (;;) {
      const f = try t.field()
      if (f.type === 0) break
      if (f.id !== 1 || f.type !== 9) {
        try t.skip(f.type)
        continue
      }
      const cols = try t.list()
      for (let c = 0; c < cols.n; c++) {
        t.enter()
        let chunk: PqChunk = { name: "", codec: 0, offset: -1 }
        for (;;) {
          const cf = try t.field()
          if (cf.type === 0) break
          if (cf.id !== 3 || cf.type !== 12) {
            try t.skip(cf.type)
            continue
          }
          t.enter()
          for (;;) {
            const mf = try t.field()
            if (mf.type === 0) break
            if (mf.id === 3 && mf.type === 9) {
              const pl = try t.list()
              const parts: string[] = []
              for (let k = 0; k < pl.n; k++) parts.push(try new TextDecoder().decode(try t.bytes()))
              chunk.name = parts.join(".")
            } else if (mf.id === 4 && mf.type === 5) chunk.codec = try t.zigzag()
            else if (mf.id === 9 && mf.type === 6) chunk.offset = try t.zigzag()
            else try t.skip(mf.type)
          }
          t.leave()
        }
        t.leave()
        // only the first row group is read: one row is all a payload object holds
        if (g === 0) out.push(chunk)
      }
    }
    t.leave()
  }
  return out
}

// The first row of a file's string (BYTE_ARRAY) columns, by column name; a null leaves its column out. Pages may be
// uncompressed or GZIP, data pages (v1) with PLAIN values; anything else (dictionary pages, snappy, zstd) is refused.
export function parquetRow(file: u8[]): Map<string, string> throws Error {
  const n = file.length
  if (n < 12 || try new TextDecoder().decode(file.slice(0, 4)) !== "PAR1" || try new TextDecoder().decode(file.slice(n - 4, n)) !== "PAR1") throw new Error("not a parquet file")
  const flen = try rd32(file, n - 8)
  const t = new Tr(file, n - 8 - flen)
  let leaves: PqLeaf[] = []
  let chunks: PqChunk[] = []
  t.enter()
  for (;;) {
    const f = try t.field()
    if (f.type === 0) break
    if (f.id === 2 && f.type === 9) leaves = try readSchema(t)
    else if (f.id === 4 && f.type === 9) chunks = try readChunks(t)
    else try t.skip(f.type)
  }
  const out: Map<string, string> = new Map()
  for (const c of chunks) {
    let leaf: PqLeaf | undefined = undefined
    for (const l of leaves) {
      if (l.name === c.name) leaf = l
    }
    if (leaf === undefined || leaf.type !== T_BYTE_ARRAY || c.offset < 0) continue
    if (c.codec !== CODEC_NONE && c.codec !== CODEC_GZIP) throw new Error(`parquet codec ${c.codec} is not supported`)
    // the page header
    const ph = new Tr(file, c.offset)
    ph.enter()
    let ptype = -1
    let stored = -1
    for (;;) {
      const f = try ph.field()
      if (f.type === 0) break
      if (f.id === 1 && f.type === 5) ptype = try ph.zigzag()
      else if (f.id === 3 && f.type === 5) stored = try ph.zigzag()
      else try ph.skip(f.type)
    }
    if (ptype !== PAGE_DATA || stored < 0 || ph.pos + stored > n) throw new Error(`column ${c.name}: unsupported page`)
    const raw = file.slice(ph.pos, ph.pos + stored)
    const page = c.codec === CODEC_GZIP ? try gunzip(raw) : raw
    let at = 0
    if (leaf.optional) {
      // definition levels: a length, then the RLE/bit-packed hybrid; the first level says whether row 0 is there
      const len = try rd32(page, 0)
      if (len < 2 || 4 + len > page.length) throw new Error(`column ${c.name}: bad levels`)
      const header = int(page[4]!)
      const first = (header & 1) === 1 ? int(page[5]!) & 1 : int(page[5]!)
      at = 4 + len
      if (first === 0) continue
    }
    const vlen = try rd32(page, at)
    if (vlen < 0 || at + 4 + vlen > page.length) throw new Error(`column ${c.name}: bad value`)
    out.set(c.name, try new TextDecoder().decode(page.slice(at + 4, at + 4 + vlen)))
  }
  return out
}

// ---- tests ----

function hexOf(b: u8[]): string {
  const H = "0123456789abcdef"
  let s = ""
  for (const x of b) s += H.slice(int(x) >> 4, (int(x) >> 4) + 1) + H.slice(int(x) & 15, (int(x) & 15) + 1)
  return s
}

test("f64 bytes match the IEEE 754 little-endian encoding", () => {
  expect(hexOf(f64Bytes(1.0))).toBe("000000000000f03f")
  expect(hexOf(f64Bytes(-2.5))).toBe("00000000000004c0")
  expect(hexOf(f64Bytes(0.1))).toBe("9a9999999999b93f")
  expect(hexOf(f64Bytes(0.0))).toBe("0000000000000000")
  expect(hexOf(f64Bytes(1791979200000.0))).toBe("0000e089a4137a42")
})

test("levels: bit-packed groups with a byte length prefix", () => {
  // 3 values: one group, bits 1,0,1
  expect(hexOf(levels([true, false, true]))).toBe("02000000" + "03" + "05")
  expect(hexOf(levels([]))).toBe("01000000" + "01")
})

test("zigzag and uvarint for thrift fields", () => {
  expect(hexOf(uvarintOf(zz(-1)))).toBe("01")
  expect(hexOf(uvarintOf(zz(1)))).toBe("02")
  expect(hexOf(uvarintOf(300))).toBe("ac02")
})

test("a file starts and ends with the PAR1 magic, and the footer length is before the end", () => {
  const f = parquetFile([{ name: "a", kind: "int32", cells: [{ s: "", n: 7.0, b: false }, undefined] }])
  expect(hexOf(f.slice(0, 4))).toBe("50415231")
  expect(hexOf(f.slice(f.length - 4))).toBe("50415231")
  const flen = int(f[f.length - 8]!) + int(f[f.length - 7]!) * 256
  expect(flen > 0).toBe(true)
})

test("an int32 column stores the present value as little-endian bytes after the levels", () => {
  const f = parquetFile([{ name: "a", kind: "int32", cells: [{ s: "", n: 7.0, b: false }, undefined] }])
  // the page follows the magic: levels are a 2-byte run (header 03: one bit-packed group) with row 0 present (01), then the value 7
  expect(hexOf(f).includes("02000000" + "0301" + "07000000")).toBe(true)
})

test("log columns: 16 columns, nulls where content is off", () => {
  const e: LogEntry = { id: "a", ts: 1000.0, request_id: "r", op: "chat", provider: "p", model: "m", status: 200, latency_ms: 1.5, prompt_tokens: 2, completion_tokens: 3, cost: 0.25, cache_hit: true, input: "in" }
  const cols = logColumns([e])
  expect(cols.length).toBe(16)
  expect(cols[0]!.name).toBe("id")
  expect(isNullCell(cols[13]!.cells[0])).toBe(true)
  expect(isNullCell(cols[14]!.cells[0])).toBe(false)
  expect(isNullCell(cols[15]!.cells[0])).toBe(true)
  const f = logParquet([e])
  expect(hexOf(f.slice(0, 4))).toBe("50415231")
})

test("parquetRow reads back the first row's strings, plain and with GZIP pages; nulls are left out", () => {
  const cols: PqColumn[] = [
    { name: "id", kind: "string", cells: [{ s: "log-1", n: 0.0, b: false }] },
    { name: "n", kind: "double", cells: [{ s: "", n: 2.5, b: false }] },
    { name: "input", kind: "string", cells: [{ s: `{"messages":[{"role":"user","content":"héllo"}]}`, n: 0.0, b: false }] },
    { name: "output", kind: "string", cells: [undefined] },
  ]
  for (const gz of [false, true]) {
    const row = try parquetRow(parquetFileWith(cols, gz))
    expect(row.get("id")).toBe("log-1")
    expect(row.get("input")).toBe(`{"messages":[{"role":"user","content":"héllo"}]}`)
    expect(row.has("output")).toBe(false)
    expect(row.has("n")).toBe(false)
  }
  let bad = 0
  try {
    parquetRow(utf8("not parquet at all"))
  } catch (e) {
    bad += 1
  }
  expect(bad).toBe(1)
})

function isNullCell(c: PqCell | undefined): bool {
  return c === undefined
}
