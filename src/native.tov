// Drop-in SDK routes: requests in a provider's own format, forwarded with
// governance, retries, fallbacks across keys, metrics and cost tracking.
import { Field, fields, find, quote, build, isNull, rawStr, rawBool, setField } from "./json"
import { Engine, Build, Translate, StreamSink, StreamConverter, ConverterFactory, streamable, converterKind, errorResponse, noHeaders } from "./gateway"
import { Target, Translated } from "./providers/types"
import { ChatRequest, snapshot } from "./schemas"
import * as cohereIn from "./cohere_in"
import * as genaiIn from "./genai_in"
import * as bedrockIn from "./bedrock_in"
import { estimateChatTokens, estimateTokens } from "./jobs"
import { rerank } from "./extras"
import { completionToSse } from "./sse"
import * as providers from "./providers/index"
import * as openai from "./providers/openai"
import * as anthropicIn from "./providers/anthropic_in"
import * as responses from "./responses"
import * as anthropic from "./providers/anthropic"
import * as gemini from "./providers/gemini"
import * as bedrock from "./providers/bedrock"

type AUsage = { input_tokens?: int, output_tokens?: int, cache_read_input_tokens?: int, cache_creation_input_tokens?: int }
type AUsageHolder = { usage?: AUsage, message?: { usage?: AUsage } }

// Token counts from a Messages response, or from its SSE events.
export function anthropicUsage(text: string, streamed: bool): Translated {
  let pt = 0
  let ct = 0
  const payloads: string[] = []
  if (streamed) {
    for (const line of text.split("\n")) {
      if (line.startsWith("data: ") && line.includes("usage")) payloads.push(line.slice(6))
    }
  } else payloads.push(text)
  for (const p of payloads) {
    try {
      const h = JSON.parse(p) as AUsageHolder
      const u = h.usage ?? h.message?.usage
      if (u !== undefined) {
        const input = (u.input_tokens ?? 0) + (u.cache_read_input_tokens ?? 0) + (u.cache_creation_input_tokens ?? 0)
        if (input > 0) pt = input
        if ((u.output_tokens ?? 0) > 0) ct = u.output_tokens ?? 0
      }
    } catch (e) {
      // events without usage are skipped
    }
  }
  return { body: text, promptTokens: pt, completionTokens: ct }
}

type GUsage = { usageMetadata?: { promptTokenCount?: int, candidatesTokenCount?: int, thoughtsTokenCount?: int } }

export function geminiUsage(text: string, streamed: bool): Translated {
  let pt = 0
  let ct = 0
  const payloads: string[] = streamed ? text.split("\n").filter((l) => l.startsWith("data: ")).map((l) => l.slice(6)) : [text]
  for (const p of payloads) {
    try {
      const u = (JSON.parse(p) as GUsage).usageMetadata
      if (u !== undefined) {
        pt = u.promptTokenCount ?? pt
        ct = (u.candidatesTokenCount ?? 0) + (u.thoughtsTokenCount ?? 0)
      }
    } catch (e) {
      // skipped
    }
  }
  return { body: text, promptTokens: pt, completionTokens: ct }
}

type BUsage = { usage?: { inputTokens?: int, outputTokens?: int }, input_tokens?: int }

export function bedrockUsage(text: string): Translated {
  try {
    const u = (JSON.parse(text) as BUsage).usage
    if (u !== undefined) return { body: text, promptTokens: u.inputTokens ?? 0, completionTokens: u.outputTokens ?? 0 }
  } catch (e) {
    // not JSON with usage
  }
  return anthropicUsage(text, false)
}

// An OpenAI chat request (JSON text) that can be sent to any provider. toOpenAI
// gives back an OpenAI completion, or SSE when the provider streamed natively;
// callers convert that into their own wire format.
type Bridge = { build: Build, toOpenAI: Translate }

function chatBridge(chatText: string, stream: bool, autoCache: bool, pipe: bool): Bridge throws SyntaxError {
  let fs = try fields(chatText)
  if (stream) setField(&fs, "stream_options", `{"include_usage":true}`)
  const streamFields = fs
  const plain = fs.filter((f) => f.key !== "stream" && f.key !== "stream_options")
  const req = try JSON.parse(chatText) as ChatRequest
  const b: Build = (t) => {
    if (providers.streamsNatively(t.kind)) return openai.chatRequest(t, stream ? streamFields : plain)
    // with a streaming client, providers that stream are converted as they go
    if (stream && pipe) {
      const su = try providers.streamUpstream(t, req, plain, autoCache)
      if (su !== undefined) return su
    }
    return try providers.chatUpstream(t, req, plain, autoCache)
  }
  const tr: Translate = (t, text, requested) => {
    if (stream && providers.streamsNatively(t.kind)) return openai.streamResponse(text, requested)
    return try providers.chatTranslate(t.kind, t.model, text, requested, false)
  }
  return { build: b, toOpenAI: tr }
}

// SSE from either kind of bridge result.
function asSse(body: string): string throws SyntaxError {
  if (body.startsWith("{")) return try completionToSse(body, true)
  return body
}

// Bedrock's InvokeModel takes Anthropic's body without model or stream, plus a version.
function bedrockAnthropicBody(body: Field[]): string {
  const fs = body.filter((f) => f.key !== "model" && f.key !== "stream" && f.key !== "anthropic_version")
  fs.unshift({ key: "anthropic_version", raw: quote("bedrock-2023-05-31") })
  return build(fs)
}

export async function anthropicMessages(engine: Engine, req: Request, sink?: StreamSink): Promise<Response> {
  const text = await req.text()
  let body: Field[] = []
  let bridge: Bridge | undefined = undefined
  try {
    body = fields(text)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const stream = find(body, "stream") === "true"
  const clientModel = rawStr(body, "model") ?? ""
  try {
    // Every provider other than Anthropic (and non-streaming Bedrock) is reached through OpenAI chat.
    bridge = chatBridge(anthropicIn.toChatRequest(text, clientModel), stream, false, stream && sink !== undefined)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const br = bridge!
  const native = (t: Target) => t.kind === "anthropic" || (t.kind === "bedrock" && !stream)
  const b: Build = (t) => {
    if (t.kind === "anthropic") return anthropic.nativeRequest(t, body)
    if (t.kind === "bedrock" && !stream) return bedrock.signedRequest(t, "invoke", bedrockAnthropicBody(body))
    return try br.build(t)
  }
  const tr: Translate = (t, text, requested) => {
    if (t.kind === "anthropic") return anthropicUsage(text, stream)
    if (native(t)) return bedrockUsage(text)
    const o = try br.toOpenAI(t, text, requested)
    const out = stream ? anthropicIn.toMessageStream(try asSse(o.body), clientModel) : try anthropicIn.toMessage(o.body, clientModel)
    return { body: out, promptTokens: o.promptTokens, completionTokens: o.completionTokens }
  }
  // With a sink, events reach the client as the upstream produces them: Anthropic's own
  // pass through, every other provider's are converted to Messages events.
  const mk: ConverterFactory = (t, requested) => {
    if (t.kind === "anthropic") {
      const c = new StreamConverter("anthropic", requested, true)
      c.raw = true
      return c
    }
    if (!streamable(t)) return undefined
    const c = new StreamConverter(converterKind(t), requested, true)
    c.asAnthropic(clientModel)
    return c
  }
  return await engine.serve(req, "anthropic.messages", undefined, body, text, b, tr, stream, undefined, stream ? sink : undefined, mk)
}

type RUsage = { usage?: { input_tokens?: int, output_tokens?: int }, response?: { usage?: { input_tokens?: int, output_tokens?: int } } }

// Token counts from a Responses API body, or from its response.completed event.
function responsesUsage(text: string, stream: bool): Translated {
  const payloads: string[] = stream ? text.split("\n").filter((l) => l.startsWith("data: ") && l.includes("usage")).map((l) => l.slice(6)) : [text]
  let pt = 0
  let ct = 0
  for (const p of payloads) {
    try {
      const h = JSON.parse(p) as RUsage
      const u = h.usage ?? h.response?.usage
      if (u !== undefined) {
        pt = u.input_tokens ?? pt
        ct = u.output_tokens ?? ct
      }
    } catch (e) {
      // skipped
    }
  }
  return { body: text, promptTokens: pt, completionTokens: ct }
}

// /v1/responses: passed through to OpenAI; translated through chat for everyone else.
export async function responsesApi(engine: Engine, req: Request): Promise<Response> {
  const reqText = await req.text()
  let body: Field[] = []
  let bridge: Bridge | undefined = undefined
  try {
    body = fields(reqText)
    bridge = chatBridge(responses.toChatRequest(reqText, rawStr(body, "model") ?? ""), rawBool(body, "stream") ?? false, false, false)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const br = bridge!
  const stream = rawBool(body, "stream") ?? false
  const clientModel = rawStr(body, "model") ?? ""
  const b: Build = (t) => {
    if (t.kind === "openai") return openai.responsesRequest(t, body)
    return try br.build(t)
  }
  const tr: Translate = (t, text, requested) => {
    if (t.kind === "openai") return responsesUsage(text, stream)
    const o = try br.toOpenAI(t, text, requested)
    const out = stream ? responses.toResponseStream(try asSse(o.body), clientModel) : try responses.toResponse(o.body, clientModel, reqText)
    return { body: out, promptTokens: o.promptTokens, completionTokens: o.completionTokens }
  }
  return await engine.serve(req, "responses", undefined, body, reqText, b, tr, stream)
}

function jsonBody(body: string): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", "application/json")
  return new Response(body, { headers: h })
}

// An internal POST to the gateway's own route, with the caller's headers (so its virtual key).
function internalRequest(req: Request, path: string, body: string): Request {
  const u = URL.parse(req.url)
  const origin = u === undefined ? "http://localhost" : u.origin
  return new Request(origin + path, { method: "POST", headers: snapshot(req.headers), body: body })
}

// /cohere/v2/chat: Cohere's chat API, served by any provider through OpenAI chat.
export async function cohereChat(engine: Engine, req: Request, sink?: StreamSink): Promise<Response> {
  const text = await req.text()
  let body: Field[] = []
  let bridge: Bridge | undefined = undefined
  try {
    body = fields(text)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const stream = find(body, "stream") === "true"
  const clientModel = rawStr(body, "model") ?? ""
  try {
    bridge = chatBridge(cohereIn.chatToOpenAI(text, clientModel), stream, false, stream && sink !== undefined)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const br = bridge!
  const b: Build = (t) => try br.build(t)
  const tr: Translate = (t, out, requested) => {
    const o = try br.toOpenAI(t, out, requested)
    const res = stream ? cohereIn.toCohereStream(try asSse(o.body), clientModel) : try cohereIn.openAIToChat(o.body)
    return { body: res, promptTokens: o.promptTokens, completionTokens: o.completionTokens }
  }
  const mk: ConverterFactory = (t, requested) => {
    if (!streamable(t)) return undefined
    const c = new StreamConverter(converterKind(t), requested, true)
    c.asCohere(clientModel)
    return c
  }
  return await engine.serve(req, "cohere.chat", undefined, body, text, b, tr, stream, undefined, stream ? sink : undefined, mk)
}

// /cohere/v2/embed: the embeddings of any provider that serves them, in Cohere's shape.
export async function cohereEmbed(engine: Engine, req: Request): Promise<Response> {
  const text = await req.text()
  let conv = ""
  let texts: string[] = []
  try {
    conv = cohereIn.embedToOpenAI(text, rawStr(fields(text), "model") ?? "")
    texts = cohereIn.embedTexts(text)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const r = await engine.embeddings(internalRequest(req, "/v1/embeddings", conv))
  if (r.status !== 200) return r
  try {
    return jsonBody(cohereIn.openAIToEmbed(await r.text(), texts))
  } catch (e) {
    return errorResponse(502, `invalid upstream answer: ${e.message}`, "api_error", noHeaders())
  }
}

// /cohere/v2/rerank: Raiju's rerank (Cohere's own, or the local lexical one), in Cohere's shape.
export async function cohereRerank(engine: Engine, req: Request): Promise<Response> {
  const text = await req.text()
  let conv = ""
  try {
    conv = cohereIn.rerankToRaiju(text)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const r = await rerank(engine, internalRequest(req, "/v1/rerank", conv))
  if (r.status !== 200) return r
  try {
    return jsonBody(cohereIn.raijuToRerank(await r.text()))
  } catch (e) {
    return errorResponse(502, `invalid upstream answer: ${e.message}`, "api_error", noHeaders())
  }
}

// /cohere/v1/tokenize: an estimate (no provider tokenizer is called).
export async function cohereTokenize(engine: Engine, req: Request): Promise<Response> {
  const text = await req.text()
  let t = ""
  try {
    t = cohereIn.tokenizeText(text)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  if (engine.gov.enforce && engine.gov.findKey(snapshot(req.headers)) === undefined) {
    return errorResponse(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", noHeaders())
  }
  return jsonBody(cohereIn.tokenizeResponse(t, estimateTokens(t)))
}

// /genai/v1beta/models/{model}:{method}. Gemini targets are passed through natively; other
// targets are reached through OpenAI chat (generate) or embeddings and converted back.
export async function genai(engine: Engine, req: Request, modelAction: string, sink?: StreamSink): Promise<Response> {
  const parts = modelAction.split(":")
  if (parts.length < 2) return errorResponse(404, "expected models/{model}:{method}", "invalid_request_error", noHeaders())
  const method = parts[parts.length - 1]!
  const model = parts.slice(0, parts.length - 1).join(":")
  const full = model.includes("/") ? model : "gemini/" + model
  const text = await req.text()
  if (method === "embedContent" || method === "batchEmbedContents") return await genaiEmbed(engine, req, method, full, text)
  if (method === "countTokens") return genaiCount(text, full)
  if (method !== "generateContent" && method !== "streamGenerateContent") return errorResponse(404, `${method} isn't supported`, "invalid_request_error", noHeaders())
  const stream = method === "streamGenerateContent"
  let bridge: Bridge | undefined = undefined
  try {
    bridge = chatBridge(genaiIn.generateToOpenAI(text, full, stream), stream, false, stream && sink !== undefined)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const br = bridge!
  const b: Build = (t) => {
    if (t.kind === "gemini") {
      const up = gemini.nativeRequest(t, method, text)
      if (stream) up.url = up.url + "?alt=sse"
      return up
    }
    return try br.build(t)
  }
  const tr: Translate = (t, out, requested) => {
    if (t.kind === "gemini") return geminiUsage(out, stream)
    const o = try br.toOpenAI(t, out, requested)
    const body = stream ? genaiIn.toGenAIStream(try asSse(o.body), full) : try genaiIn.openAIToGenerate(o.body, full)
    return { body: body, promptTokens: o.promptTokens, completionTokens: o.completionTokens }
  }
  // Gemini streams stay buffered; other providers' streams are converted as they arrive.
  const mk: ConverterFactory = (t, requested) => {
    if (t.kind === "gemini" || !streamable(t)) return undefined
    const c = new StreamConverter(converterKind(t), requested, true)
    c.asGenAI(full)
    return c
  }
  return await engine.serve(req, "genai." + method, full, [], text, b, tr, stream, undefined, stream ? sink : undefined, mk)
}

// :countTokens is an estimate of the request's text; no provider is called.
function genaiCount(text: string, full: string): Response {
  try {
    return jsonBody(genaiIn.countTokensResponse(estimateChatTokens(genaiIn.generateToOpenAI(text, full, false))))
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
}

// :embedContent and :batchEmbedContents. Gemini answers natively; other targets through their embeddings.
async function genaiEmbed(engine: Engine, req: Request, method: string, full: string, text: string): Promise<Response> {
  const batch = method === "batchEmbedContents"
  let body: Field[] = []
  try {
    body = fields(genaiIn.embedToOpenAI(text, full))
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const b: Build = (t) => {
    if (t.kind === "gemini") return gemini.nativeRequest(t, method, text)
    if (!providers.supportsEmbeddings(t.kind)) throw new SyntaxError(`${t.provider} does not serve embeddings through this gateway yet`)
    return try providers.embeddingsUpstream(t, body)
  }
  const tr: Translate = (t, out, requested) => {
    if (t.kind === "gemini") return { body: out, promptTokens: 0, completionTokens: 0 }
    const o = try providers.embeddingsTranslate(t.kind, t.model, out, requested)
    return { body: try genaiIn.openAIToEmbed(o.body, batch), promptTokens: o.promptTokens, completionTokens: o.completionTokens }
  }
  return await engine.serve(req, "genai." + method, full, [], text, b, tr, false)
}

const BEDROCK_ACTIONS = ["converse", "converse-stream", "invoke", "invoke-with-response-stream", "count-tokens"]

// Bedrock's event-stream answer (binary frames) from frames built here.
function eventStreamResponse(frames: u8[]): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", "application/vnd.amazon.eventstream")
  return new Response(frames, { headers: h })
}

// /bedrock/model/{modelId}/{action}: Bedrock's SDK routes, served by any provider. The
// streaming actions stream frames when the server can (sink), else answer the frames whole.
export async function bedrockModel(engine: Engine, req: Request, modelId: string, action: string, sink?: StreamSink): Promise<Response> {
  if (!BEDROCK_ACTIONS.includes(action)) return errorResponse(404, `${action} isn't supported`, "invalid_request_error", noHeaders())
  const text = await req.text()
  // percent-decoded through URLSearchParams (model ids never contain "+")
  const id = new URLSearchParams("id=" + modelId).get("id") ?? modelId
  if (action === "count-tokens") {
    try {
      return jsonBody(bedrockIn.countTokensResponse(estimateChatTokens(bedrockIn.countTokensToRaiju(text))))
    } catch (e) {
      return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
    }
  }
  const stream = action.endsWith("-stream")
  const invoke = action.startsWith("invoke")
  // "provider/model" names pass through; a bare Bedrock id is a Bedrock model
  const full = id.includes("/") && !id.startsWith("arn:") ? id : "bedrock/" + id
  let bridge: Bridge | undefined = undefined
  try {
    const chat = invoke ? (stream ? bedrockIn.invokeStreamToOpenAI(text, id) : bedrockIn.invokeToOpenAI(text, id)) : bedrockIn.converseToOpenAI(text, id, stream)
    bridge = chatBridge(chat, stream, false, stream && sink !== undefined)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const br = bridge!
  // a Bedrock target gets the native call for the non-streaming actions, as Anthropic's route does
  const native = (t: Target) => t.kind === "bedrock" && !stream
  const b: Build = (t) => {
    if (native(t)) return bedrock.signedRequest(t, action, text)
    return try br.build(t)
  }
  const tr: Translate = (t, out, requested) => {
    if (native(t)) return bedrockUsage(out)
    const o = try br.toOpenAI(t, out, requested)
    if (stream) return { body: try asSse(o.body), promptTokens: o.promptTokens, completionTokens: o.completionTokens }
    const body = invoke ? try anthropicIn.toMessage(o.body, id) : try bedrockIn.openAIToConverse(o.body)
    return { body: body, promptTokens: o.promptTokens, completionTokens: o.completionTokens }
  }
  const mk: ConverterFactory = (t, requested) => {
    if (!streamable(t)) return undefined
    const c = new StreamConverter(converterKind(t), requested, true)
    if (invoke) c.asInvoke(id)
    else c.asConverse()
    return c
  }
  const r = await engine.serve(req, "bedrock." + action, full, [], text, b, tr, stream, undefined, stream ? sink : undefined, mk)
  // a buffered streaming answer: its SSE, turned into the frames the client reads
  if (!stream || r.status !== 200 || (sink !== undefined && sink.started)) return r
  let sse = ""
  try {
    sse = await r.text()
  } catch (e) {
    return errorResponse(502, `invalid upstream answer: ${e.message}`, "api_error", noHeaders())
  }
  return eventStreamResponse(invoke ? bedrockIn.invokeFramesFromSse(sse, id) : bedrockIn.converseFramesFromSse(sse))
}
