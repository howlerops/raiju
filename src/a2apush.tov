// A2A push notifications through the gateway (Bifrost's core/agent/push.go).
//
// A caller registers a callback for a task through the gateway. The agent is told a callback of the gateway's
// own instead, with a token the gateway made for that config (ingress); the caller's callback, its token and
// its credentials stay here. When the agent pushes an event, the gateway checks the token and that the event
// is about the config's task, queues the event (202), and a relay sends it on to the caller's callback with the
// caller's own token and credentials. A delivery that fails is retried with a doubling delay, up to six
// attempts, and then given up. Delivery is at least once; a push the agent repeats is queued once.
//
// Configs and queued deliveries are kept in memory and as one file each in a directory (a2a-push in the logs_store
// folder, or the workers' share directory when there is no logs store), so they survive a restart and are shared by
// every worker of a node: a push may reach any worker, and a queued push is relayed by whichever worker takes its
// lease first (see PushStore). The secrets in the files are sealed when the config has an encryption key. Bifrost
// keeps this state in its config database, which every node of a cluster shares; Raiju shares it per node (or among
// the nodes that use one logs_store folder on a shared file system).
import { readFileSync, writeFileSync, existsSync, readdirSync, mkdirSync, unlinkSync, rmSync, statSync } from "node:fs"
import { writeFileAtomic } from "./atomicfile"
import { sha256, toHex, utf8, secureHex } from "./crypto"
import { fields, find, rawStr, rawNum, quote } from "./json"
import { isPrivateHost, isMetadataHost, urlVerdict, policyOf } from "./netguard"
import { deadline } from "./deadline"
import { pushEventTaskId } from "./a2a"
import { isoMs } from "./exports"
import { FileLease } from "./filelease"

export const INGRESS_SUFFIX = "/push/callback"
export const TOKEN_HEADER = "a2a-notification-token"
export const MAX_ATTEMPTS = 6
const BATCH = 16
const LEASE_MS = 60000
const SEND_TIMEOUT_MS = 30000
const BASE_BACKOFF_MS = 1000
const MAX_BACKOFF_MS = 300000
const RETENTION_MS = 7 * 86400000
const PENDING_TTL_MS = 3600000
const MAX_PAYLOAD = 1048576
export const PENDING_PREFIX = "__pending__:"

// One registered callback. ingress is the SHA-256 of the token the agent was given for it.
export type PushConfig = {
  agent: string,
  task: string,
  id: string,
  url: string,
  token: string,
  scheme: string,
  credentials: string,
  ingress: string,
  created_at: int,
  updated_at: int,
}

// One queued push. id is a digest of the agent, the config and the payload, so a repeat is not queued twice.
export type PushDelivery = {
  id: string,
  agent: string,
  task: string,
  config: string,
  payload: string,
  status: string, // pending, delivered or dead
  attempts: int,
  next_at: int,
  last_error: string,
  created_at: int,
  updated_at: int,
}

export type PushQuery = { agents: string[], task: string, config: string, url: string, limit: int, offset: int }

function has(hay: string, needle: string): bool {
  return needle === "" || hay.toLowerCase().includes(needle.toLowerCase())
}

function order(a: string, b: string): int {
  if (a < b) return -1
  if (a > b) return 1
  return 0
}

// Newest update first; ties by agent, task and config id.
function newestFirst(a: PushConfig, b: PushConfig): int {
  if (a.updated_at !== b.updated_at) return b.updated_at - a.updated_at
  const x = order(a.agent, b.agent)
  if (x !== 0) return x
  const y = order(a.task, b.task)
  if (y !== 0) return y
  return order(a.id, b.id)
}

// The key a config travels under on the cluster state (a2ashare.tov): its agent, task and config id as a JSON array.
export function pushKey(agent: string, task: string, id: string): string {
  return JSON.stringify([agent, task, id])
}

// The file a config is kept in, and the file a queued push is kept in (its id is a hex digest).
function configFile(agent: string, task: string, id: string): string {
  return "c-" + toHex(sha256(utf8(agent + "\u0000" + task + "\u0000" + id))) + ".json"
}

function deliveryFile(id: string): string {
  return "d-" + id + ".json"
}

// Configs and queued pushes live in memory and, with a directory (persistTo or useDir), as one file per item, so
// every process that uses the directory (the workers of a node) sees the others' changes: each method first reads
// the directory (sync) and then writes only the files it changes, one write per file, so two processes that change
// different items never lose each other's writes. Two processes changing the same item is last writer wins, as with
// any PUT. A file that cannot be parsed (it is being written) keeps the copy already in memory.
//
// A queued push is relayed by one process at a time: claim takes a lease on it (a FileLease in the directory, see
// filelease.tov), the holder sends and writes the outcome, and release gives the lease up. A lease whose holder died
// is taken over after leaseMs, as a new generation, so there is still one owner.
export class PushStore {
  configs: PushConfig[] = []
  deliveries: PushDelivery[] = []
  dir = ""
  made = false
  leaseMs = LEASE_MS
  // the leases on queued pushes, in the directory (none without one)
  lease: FileLease = new FileLease("", LEASE_MS)
  // deliveries this instance holds a lease on: id to the lease generation
  held: Map<string, int> = new Map()
  // seals and opens the secrets kept in the files (identity when there is no key)
  seal: (v: string) => string = (v: string): string => v
  open: (v: string) => string = (v: string): string => v
  // opens a sealed secret, undefined when it cannot be opened here (the cluster state applies no such config)
  openSecret: (v: string) => string | undefined = (v: string): string | undefined => v
  // told of each config this process writes or removes (the cluster state takes them up, a2ashare.tov); not of the
  // ones it reads from the directory
  changed: ((c: PushConfig, gone: bool) => void) | undefined = undefined

  // Keeps the items in a directory (named like the old single file, without its .jsonl) and reads what is there. A
  // single-file store left by an earlier version is moved in once.
  persistTo(path: string): void {
    const dir = path.endsWith(".jsonl") ? path.slice(0, path.byteLength - 6) : path
    this.useDir(dir)
    if (path.endsWith(".jsonl") && existsSync(path)) this.importLegacy(path)
  }

  // Uses dir for the items: what is in memory is written there first (where no file has it yet), then the
  // directory is read. The directory is made by the first write, so a gateway that never sees a push leaves none.
  useDir(dir: string): void {
    const mem = this.configs
    const memD = this.deliveries
    this.dir = dir
    this.made = false
    this.lease = new FileLease(dir, this.leaseMs)
    for (const c of mem) {
      if (!existsSync(dir + "/" + configFile(c.agent, c.task, c.id))) this.writeConfig(c)
    }
    for (const d of memD) {
      if (!existsSync(dir + "/" + deliveryFile(d.id))) this.writeDelivery(d)
    }
    this.sync()
  }

  importLegacy(path: string): void {
    try {
      for (const line of try readFileSync(path, "utf8").split("\n")) {
        if (line === "") continue
        try {
          const fs = try fields(line)
          const t = rawStr(fs, "t") ?? ""
          const v = find(fs, "v") ?? ""
          if (t === "c") {
            const c = try JSON.parse(v) as PushConfig
            const own: PushConfig = { agent: c.agent, task: c.task, id: c.id, url: c.url, token: this.open(c.token), scheme: c.scheme, credentials: this.open(c.credentials), ingress: c.ingress, created_at: c.created_at, updated_at: c.updated_at }
            if (!existsSync(this.dir + "/" + configFile(own.agent, own.task, own.id))) this.writeConfig(own)
          } else if (t === "d") {
            const d = try JSON.parse(v) as PushDelivery
            if (!existsSync(this.dir + "/" + deliveryFile(d.id))) this.writeDelivery(d)
          }
        } catch (e) {
          continue
        }
      }
      try writeFileSync(path, "")
    } catch (e) {
      console.error(`raiju: a2a push: could not read ${path}: ${e.message}`)
    }
    this.sync()
  }

  readConfig(name: string): PushConfig | undefined {
    try {
      const fs = try fields(try readFileSync(this.dir + "/" + name, "utf8"))
      const c = try JSON.parse(find(fs, "v") ?? "") as PushConfig
      return { agent: c.agent, task: c.task, id: c.id, url: c.url, token: this.open(c.token), scheme: c.scheme, credentials: this.open(c.credentials), ingress: c.ingress, created_at: c.created_at, updated_at: c.updated_at }
    } catch (e) {
      return undefined
    }
  }

  readDelivery(name: string): PushDelivery | undefined {
    try {
      const fs = try fields(try readFileSync(this.dir + "/" + name, "utf8"))
      return try JSON.parse(find(fs, "v") ?? "") as PushDelivery
    } catch (e) {
      return undefined
    }
  }

  // Tells the changed hook of a write (gone for a removal).
  private note(c: PushConfig, gone: bool): void {
    const f = this.changed
    if (f !== undefined) f(c, gone)
  }

  // Makes the directory (once) before a write.
  ensureDir(): void {
    if (this.made) return
    try {
      mkdirSync(this.dir, { recursive: true })
      this.made = true
    } catch (e) {
      console.error(`raiju: a2a push: could not create ${this.dir}: ${e.message}`)
    }
  }

  writeConfig(c: PushConfig): void {
    if (this.dir === "") return
    this.ensureDir()
    const sealed: PushConfig = { agent: c.agent, task: c.task, id: c.id, url: c.url, token: this.seal(c.token), scheme: c.scheme, credentials: this.seal(c.credentials), ingress: c.ingress, created_at: c.created_at, updated_at: c.updated_at }
    try {
      try writeFileAtomic(this.dir + "/" + configFile(c.agent, c.task, c.id), `{"by":${process.pid},"v":${JSON.stringify(sealed)}}\n`)
    } catch (e) {
      this.made = false
      console.error(`raiju: a2a push: could not write in ${this.dir}: ${e.message}`)
    }
  }

  writeDelivery(d: PushDelivery): void {
    if (this.dir === "") return
    this.ensureDir()
    try {
      try writeFileAtomic(this.dir + "/" + deliveryFile(d.id), `{"by":${process.pid},"v":${JSON.stringify(d)}}\n`)
    } catch (e) {
      this.made = false
      console.error(`raiju: a2a push: could not write in ${this.dir}: ${e.message}`)
    }
  }

  dropFile(name: string): void {
    if (this.dir === "") return
    try {
      unlinkSync(this.dir + "/" + name)
    } catch (e) {
      // another process removed it first
    }
  }

  // Reads the directory: the items in memory become what the files say. A finished delivery is not read again.
  sync(): void {
    if (this.dir === "") return
    let names: string[] = []
    try {
      names = readdirSync(this.dir)
    } catch (e) {
      return
    }
    const oldC = new Map<string, PushConfig>()
    for (const c of this.configs) oldC.set(configFile(c.agent, c.task, c.id), c)
    const oldD = new Map<string, PushDelivery>()
    for (const d of this.deliveries) oldD.set(d.id, d)
    const nc: PushConfig[] = []
    const nd: PushDelivery[] = []
    for (const f of names) {
      if (f.startsWith("c-") && f.endsWith(".json")) {
        const c = this.readConfig(f)
        if (c !== undefined) {
          nc.push(c)
        } else {
          const o = oldC.get(f)
          if (o !== undefined) nc.push(o)
        }
      } else if (f.startsWith("d-") && f.endsWith(".json")) {
        const o = oldD.get(f.slice(2, f.byteLength - 5))
        if (o !== undefined && o.status !== "pending") {
          nd.push(o)
          continue
        }
        const d = this.readDelivery(f)
        if (d !== undefined) {
          nd.push(d)
        } else if (o !== undefined) {
          nd.push(o)
        }
      }
    }
    this.configs = nc
    this.deliveries = nd
  }

  indexOfConfig(agent: string, task: string, id: string): int {
    for (let i = 0; i < this.configs.length; i++) {
      const c = this.configs[i]!
      if (c.agent === agent && c.task === task && c.id === id) return i
    }
    return -1
  }

  // Adds a config, or replaces the one with the same agent, task and id (keeping when it was created).
  saveConfig(c: PushConfig): void {
    this.sync()
    const i = this.indexOfConfig(c.agent, c.task, c.id)
    let next = c
    if (i >= 0) {
      const old = this.configs[i]!
      next = { agent: c.agent, task: c.task, id: c.id, url: c.url, token: c.token, scheme: c.scheme, credentials: c.credentials, ingress: c.ingress, created_at: old.created_at, updated_at: c.updated_at }
      this.configs[i] = next
    } else {
      this.configs.push(c)
    }
    this.writeConfig(next)
    this.note(next, false)
  }

  config(agent: string, task: string, id: string): PushConfig | undefined {
    this.sync()
    const i = this.indexOfConfig(agent, task, id)
    return i < 0 ? undefined : this.configs[i]!
  }

  byIngress(agent: string, hash: string): PushConfig | undefined {
    this.sync()
    for (const c of this.configs) {
      if (c.agent === agent && c.ingress === hash) return c
    }
    return undefined
  }

  forTask(agent: string, task: string): PushConfig[] {
    this.sync()
    return this.configs.filter((c) => c.agent === agent && c.task === task)
  }

  // Removes a config. Whether one was there.
  remove(agent: string, task: string, id: string): bool {
    this.sync()
    const i = this.indexOfConfig(agent, task, id)
    if (i < 0) return false
    const old = this.configs[i]!
    this.configs = this.configs.filter((c) => !(c.agent === agent && c.task === task && c.id === id))
    this.dropFile(configFile(agent, task, id))
    this.note(old, true)
    return true
  }

  // Removes an embedded config that no push has bound to a task yet.
  removePending(agent: string, hash: string, pendingTask: string): bool {
    this.sync()
    const gone = this.configs.filter((c) => c.agent === agent && c.ingress === hash && c.task === pendingTask)
    if (gone.length === 0) return false
    this.configs = this.configs.filter((c) => !(c.agent === agent && c.ingress === hash && c.task === pendingTask))
    for (const c of gone) {
      this.dropFile(configFile(c.agent, c.task, c.id))
      this.note(c, true)
    }
    return true
  }

  // Binds an embedded config to the task its first push (or its send) named. A config of the same id
  // already on that task is replaced.
  bind(agent: string, hash: string, pendingTask: string, task: string): void {
    this.sync()
    let id = ""
    for (const c of this.configs) {
      if (c.agent === agent && c.ingress === hash && c.task === pendingTask) id = c.id
    }
    if (id === "") return
    this.configs = this.configs.filter((c) => !(c.agent === agent && c.task === task && c.id === id))
    for (let i = 0; i < this.configs.length; i++) {
      const c = this.configs[i]!
      if (c.agent === agent && c.ingress === hash && c.task === pendingTask) {
        const moved: PushConfig = { agent: c.agent, task: task, id: c.id, url: c.url, token: c.token, scheme: c.scheme, credentials: c.credentials, ingress: c.ingress, created_at: c.created_at, updated_at: Math.floor(Date.now()) }
        this.configs[i] = moved
        this.writeConfig(moved)
        this.dropFile(configFile(c.agent, c.task, c.id))
        this.note(c, true)
        this.note(moved, false)
      }
    }
  }

  // The configs a management page shows, newest update first, and how many match before the page is cut.
  page(q: PushQuery): { rows: PushConfig[], total: int } {
    this.sync()
    const hits = this.configs.filter((c) => (q.agents.length === 0 || q.agents.includes(c.agent)) && has(c.task, q.task) && has(c.id, q.config) && has(c.url, q.url))
    hits.sort(newestFirst)
    return { rows: hits.slice(q.offset, q.offset + q.limit), total: hits.length }
  }

  agentNames(): string[] {
    this.sync()
    const out: string[] = []
    for (const c of this.configs) {
      if (!out.includes(c.agent)) out.push(c.agent)
    }
    out.sort(order)
    return out
  }

  // Queues a delivery unless one with the same id is there. Whether it was new.
  addDelivery(d: PushDelivery): bool {
    this.sync()
    for (const x of this.deliveries) {
      if (x.id === d.id) return false
    }
    this.deliveries.push(d)
    this.writeDelivery(d)
    return true
  }

  delivery(id: string): PushDelivery | undefined {
    this.sync()
    for (const d of this.deliveries) {
      if (d.id === id) return d
    }
    return undefined
  }

  // The deliveries due now, oldest first. A delivery another process is sending is still listed: claim decides.
  due(now: int, limit: int): PushDelivery[] {
    this.sync()
    const hits = this.deliveries.filter((d) => d.status === "pending" && d.next_at <= now)
    hits.sort((a, b) => a.next_at - b.next_at)
    return hits.slice(0, limit)
  }

  setDelivery(d: PushDelivery): void {
    let found = false
    for (let i = 0; i < this.deliveries.length; i++) {
      if (this.deliveries[i]!.id === d.id) {
        this.deliveries[i] = d
        found = true
      }
    }
    if (!found) this.deliveries.push(d)
    this.writeDelivery(d)
  }

  // Takes the lease on a queued push so that this process alone sends it. The delivery is read again once the lease
  // is held, so a push another process just finished (and released) is not sent twice. undefined when the push is not
  // due, is finished, or another process holds the lease.
  claim(id: string, now: int): PushDelivery | undefined {
    if (this.held.has(id)) return undefined
    if (this.dir === "") {
      const m = this.delivery(id)
      if (m === undefined || m.status !== "pending" || m.next_at > now) return undefined
      this.held.set(id, 0)
      return m
    }
    const gen = this.lease.take(id, now * 1.0)
    if (gen < 0) return undefined
    const fresh = this.readDelivery(deliveryFile(id))
    if (fresh === undefined || fresh.status !== "pending" || fresh.next_at > now) {
      this.lease.release(id, gen)
      return undefined
    }
    this.held.set(id, gen)
    return fresh
  }

  // Whether this instance still owns the lease it took (a stalled holder is overtaken by a higher generation).
  holds(id: string): bool {
    const gen = this.held.get(id)
    if (gen === undefined) return false
    return this.lease.holds(id, gen)
  }

  // Gives the lease up (after the outcome is written). A holder that was overtaken leaves the new holder's lease alone.
  release(id: string): void {
    const gen = this.held.get(id)
    if (gen === undefined) return
    this.held.delete(id)
    this.lease.release(id, gen)
  }

  // Drops finished deliveries after a week, embedded configs no push ever bound after an hour, and the
  // configs of agents that are no longer registered; leases whose holder died long ago go too.
  prune(now: int, agents: string[]): void {
    this.sync()
    const goneD = this.deliveries.filter((d) => !(d.status === "pending" || now - d.updated_at < RETENTION_MS))
    const goneC = this.configs.filter((c) => !(agents.includes(c.agent) && !(c.task.startsWith(PENDING_PREFIX) && now - c.created_at > PENDING_TTL_MS)))
    if (goneD.length > 0) this.deliveries = this.deliveries.filter((d) => d.status === "pending" || now - d.updated_at < RETENTION_MS)
    if (goneC.length > 0) this.configs = this.configs.filter((c) => agents.includes(c.agent) && !(c.task.startsWith(PENDING_PREFIX) && now - c.created_at > PENDING_TTL_MS))
    for (const d of goneD) this.dropFile(deliveryFile(d.id))
    for (const c of goneC) this.dropFile(configFile(c.agent, c.task, c.id))
    // the cluster state learns of the drops too, or it would send them back
    for (const c of goneC) this.note(c, true)
    if (this.dir === "") return
    try {
      for (const f of readdirSync(this.dir)) {
        if (!f.startsWith("l-")) continue
        try {
          if (now - Math.floor(statSync(this.dir + "/" + f).mtimeMs) > 10 * this.leaseMs) rmSync(this.dir + "/" + f, { recursive: true, force: true })
        } catch (e) {
          continue
        }
      }
    } catch (e) {
      return
    }
  }
}

let storeInstance: PushStore | undefined = undefined

// The process's push store (created on first use: top-level statements in imported modules do not run).
export function pushStore(): PushStore {
  let s = storeInstance
  if (s === undefined) {
    s = new PushStore()
    storeInstance = s
  }
  return s
}

// A token for one config, and the digest that is kept in its place.
export function mintToken(): { token: string, hash: string } throws Error {
  const token = try secureHex(32)
  return { token: token, hash: hashToken(token) }
}

export function hashToken(token: string): string {
  return toHex(sha256(utf8(token)))
}

// Why a callback URL is refused ("" when it is fine): it must be an absolute http(s) URL without credentials,
// and not a private or metadata address unless private callbacks are allowed.
export function callbackProblem(raw: string, allowPrivate: bool): string {
  const u = URL.parse(raw)
  if (u === undefined || (u.protocol !== "http:" && u.protocol !== "https:") || u.hostname === "") return "push config url must be an absolute HTTP(S) URL without user info"
  const authority = u.href.slice(u.protocol.byteLength + 2).split("/")[0] ?? ""
  if (authority.includes("@")) return "push config url must be an absolute HTTP(S) URL without user info"
  if (isMetadataHost(u.hostname)) return "push config url points at a link-local or metadata address"
  if (!allowPrivate && isPrivateHost(u.hostname)) return "push config url points at a private address; set server.a2a_allow_private_push_callbacks to allow it"
  return ""
}

// callbackProblem at connect time (when a config is set and before each send): the host is resolved and every
// address it names must pass, as Bifrost's SSRF-safe push client dials (netguard.tov).
export async function callbackConnectProblem(raw: string, allowPrivate: bool): Promise<string> {
  const p = callbackProblem(raw, allowPrivate)
  if (p !== "") return p
  const v = await urlVerdict(raw, policyOf(allowPrivate))
  if (v.kind === "blocked") return `push config url points at a link-local or metadata address (${v.detail})`
  if (v.kind === "private") return `push config url points at a private address (${v.detail}); set server.a2a_allow_private_push_callbacks to allow it`
  if (v.kind === "dns") return `push config url host cannot be resolved: ${v.detail}`
  return ""
}

export type Accepted = { status: int, error: string, deliveryId: string }

function refuse(status: int, error: string): Accepted {
  return { status: status, error: error, deliveryId: "" }
}

// The ingress: one event pushed by an agent. The token authenticates it (nothing else does), the event must be
// about the config's task, and an embedded config that no event has bound yet is bound to the task of its first.
// 202 means queued, not delivered.
export function acceptPush(store: PushStore, agent: string, token: string, body: string, now: int): Accepted {
  if (body.byteLength > MAX_PAYLOAD) return refuse(413, "push payload exceeds size limit")
  if (token === "") return refuse(401, "push ingress token is required")
  const hash = hashToken(token)
  const cfg = store.byIngress(agent, hash)
  if (cfg === undefined) return refuse(401, "push ingress token is not recognized")
  const task = pushEventTaskId(body)
  if (task === "" && !cfg.task.startsWith(PENDING_PREFIX)) return refuse(400, "push payload is not a valid A2A event")
  let taskId = cfg.task
  if (taskId.startsWith(PENDING_PREFIX)) {
    if (task === "") return refuse(400, "pushed event does not carry a task id")
    store.bind(agent, hash, taskId, task)
    taskId = task
  } else if (task !== taskId) {
    return refuse(400, "pushed event does not address the configured task")
  }
  const id = toHex(sha256(utf8(agent + "\u0000" + cfg.id + "\u0000" + body)))
  store.addDelivery({ id: id, agent: agent, task: taskId, config: cfg.id, payload: body, status: "pending", attempts: 0, next_at: now, last_error: "", created_at: now, updated_at: now })
  return { status: 202, error: "", deliveryId: id }
}

// The delay before attempt number n+1, after n failed attempts.
export function backoffMs(attempts: int): int {
  let wait = BASE_BACKOFF_MS
  for (let i = 1; i < attempts && wait < MAX_BACKOFF_MS; i++) wait = wait * 2
  return wait > MAX_BACKOFF_MS ? MAX_BACKOFF_MS : wait
}

// One send to the caller's callback: the event as application/a2a+json, with the caller's own token and
// credentials. Redirects are not followed. "" on a 2xx, else the reason.
async function sendOnce(cfg: PushConfig, payload: string, allowPrivate: bool): Promise<string> {
  const bad = await callbackConnectProblem(cfg.url, allowPrivate)
  if (bad !== "") return bad
  const h: Record<string, string> = new Map()
  h.set("content-type", "application/a2a+json")
  if (cfg.token !== "") h.set(TOKEN_HEADER, cfg.token)
  if (cfg.credentials !== "") {
    const s = cfg.scheme.toLowerCase()
    if (s === "bearer") h.set("authorization", "Bearer " + cfg.credentials)
    else if (s === "basic") h.set("authorization", "Basic " + cfg.credentials)
  }
  const dl = deadline(SEND_TIMEOUT_MS)
  try {
    const r = await fetch(cfg.url, { method: "POST", headers: h, body: payload, signal: dl.controller.signal, redirect: "manual" })
    try {
      await r.text()
    } catch (e) {
      // the answer's body does not matter
    }
    dl.finish()
    if (r.status < 200 || r.status >= 300) return `push delivery endpoint returned HTTP status ${r.status}`
    return ""
  } catch (e) {
    dl.finish()
    return `send push delivery: ${e.message}`
  }
}

function clip(s: string): string {
  return s.byteLength > 512 ? s.slice(0, 512) : s
}

// Sends what is due. Each delivery is claimed first (a lease, so that of all the processes sharing the store only one
// sends it) and released once its outcome is written. After the attempt it is delivered, set to try again later,
// or dead (six attempts, or its config is gone). seen is told about each attempt (the delivery, the error or "",
// and how long the send took).
export async function deliverDue(store: PushStore, allowPrivate: bool, now: int, seen: (d: PushDelivery, err: string, ms: int) => void): Promise<int> {
  const due = store.due(now, BATCH)
  let done = 0
  for (const listed of due) {
    const d = store.claim(listed.id, now)
    if (d === undefined) continue
    const cfg = store.config(d.agent, d.task, d.config)
    let err = ""
    let gone = false
    const t0 = Date.now()
    if (cfg === undefined) {
      err = "push configuration no longer exists"
      gone = true
    } else {
      err = await sendOnce(cfg, d.payload, allowPrivate)
    }
    const at = Math.floor(Date.now())
    const attempts = d.attempts + 1
    let status = "pending"
    let next = at
    if (err === "") status = "delivered"
    else if (gone || attempts >= MAX_ATTEMPTS) status = "dead"
    else next = at + backoffMs(attempts)
    if (status === "dead") console.error(`raiju: a2a push delivery ${d.id} (agent ${d.agent}) gave up after ${attempts} attempts: ${err}`)
    seen(d, err, Math.floor(Date.now() - t0))
    // a holder that stalled past its lease and was overtaken must not overwrite the new holder's outcome
    if (store.holds(d.id)) store.setDelivery({ id: d.id, agent: d.agent, task: d.task, config: d.config, payload: d.payload, status: status, attempts: attempts, next_at: next, last_error: clip(err), created_at: d.created_at, updated_at: at })
    store.release(d.id)
    done += 1
  }
  return done
}

// A config as the management API lists it: no token, no credentials.
export function configView(c: PushConfig): string {
  return `{"agent_name":${quote(c.agent)},"task_id":${quote(c.task)},"config_id":${quote(c.id)},"url":${quote(c.url)},"created_at":${quote(isoOf(c.created_at))},"updated_at":${quote(isoOf(c.updated_at))}}`
}

function isoOf(ms: int): string {
  return isoMs(ms)
}

// ---- tests ----

function cfg(agent: string, task: string, id: string, hash: string): PushConfig {
  return { agent: agent, task: task, id: id, url: "https://cb.example/h", token: "t", scheme: "", credentials: "", ingress: hash, created_at: 1000, updated_at: 1000 }
}

test("a pushed event is queued once for the config its token names", () => {
  const s = new PushStore()
  const m = try mintToken()
  s.saveConfig(cfg("echo", "t1", "c1", m.hash))
  const body = `{"task":{"id":"t1","status":{"state":"completed"}}}`
  const a = acceptPush(s, "echo", m.token, body, 5000)
  expect(a.status).toBe(202)
  expect(s.deliveries.length).toBe(1)
  expect(s.deliveries[0]!.task).toBe("t1")
  expect(s.deliveries[0]!.config).toBe("c1")
  // the agent repeating itself queues nothing new
  const b = acceptPush(s, "echo", m.token, body, 5001)
  expect(b.status).toBe(202)
  expect(b.deliveryId).toBe(a.deliveryId)
  expect(s.deliveries.length).toBe(1)
  // another event is another delivery
  acceptPush(s, "echo", m.token, `{"statusUpdate":{"taskId":"t1"}}`, 5002)
  expect(s.deliveries.length).toBe(2)
})

test("the ingress refuses a missing or wrong token, a wrong task, a bad event and a big body", () => {
  const s = new PushStore()
  const m = try mintToken()
  s.saveConfig(cfg("echo", "t1", "c1", m.hash))
  expect(acceptPush(s, "echo", "", `{"task":{"id":"t1"}}`, 1).status).toBe(401)
  expect(acceptPush(s, "echo", "nope", `{"task":{"id":"t1"}}`, 1).status).toBe(401)
  expect(acceptPush(s, "other", m.token, `{"task":{"id":"t1"}}`, 1).status).toBe(401)
  expect(acceptPush(s, "echo", m.token, `{"task":{"id":"t2"}}`, 1).status).toBe(400)
  expect(acceptPush(s, "echo", m.token, "not json", 1).status).toBe(400)
  expect(acceptPush(s, "echo", m.token, "x".repeat(1048577), 1).status).toBe(413)
  expect(s.deliveries.length).toBe(0)
})

test("an embedded config is bound to the task of the first push", () => {
  const s = new PushStore()
  const m = try mintToken()
  s.saveConfig(cfg("echo", PENDING_PREFIX + "abc", "c1", m.hash))
  expect(acceptPush(s, "echo", m.token, `{"message":{"messageId":"x"}}`, 1).status).toBe(400)
  expect(acceptPush(s, "echo", m.token, `{"task":{"id":"t7"}}`, 2).status).toBe(202)
  expect(s.config("echo", "t7", "c1")!.id).toBe("c1")
  expect(s.config("echo", PENDING_PREFIX + "abc", "c1")).toBeUndefined()
  expect(s.deliveries[0]!.task).toBe("t7")
  // a send that made no task drops its pending config
  const m2 = try mintToken()
  s.saveConfig(cfg("echo", PENDING_PREFIX + "def", "c2", m2.hash))
  expect(s.removePending("echo", m2.hash, PENDING_PREFIX + "def")).toBe(true)
  expect(s.removePending("echo", m2.hash, PENDING_PREFIX + "def")).toBe(false)
  // a send that made a task binds it
  const m3 = try mintToken()
  s.saveConfig(cfg("echo", PENDING_PREFIX + "ghi", "c3", m3.hash))
  s.bind("echo", m3.hash, PENDING_PREFIX + "ghi", "t9")
  expect(s.config("echo", "t9", "c3")!.url).toBe("https://cb.example/h")
})

test("a config is replaced by one with the same ids, and removed once", () => {
  const s = new PushStore()
  s.saveConfig(cfg("echo", "t1", "c1", "h1"))
  const moved = cfg("echo", "t1", "c1", "h2")
  moved.updated_at = 2000
  moved.created_at = 2000
  s.saveConfig(moved)
  expect(s.configs.length).toBe(1)
  expect(s.configs[0]!.ingress).toBe("h2")
  expect(s.configs[0]!.created_at).toBe(1000)
  expect(s.forTask("echo", "t1").length).toBe(1)
  expect(s.remove("echo", "t1", "c1")).toBe(true)
  expect(s.remove("echo", "t1", "c1")).toBe(false)
})

test("the management page filters, sorts and counts", () => {
  const s = new PushStore()
  const a = cfg("alpha", "task-1", "c1", "h1")
  a.updated_at = 3000
  const b = cfg("beta", "task-2", "c2", "h2")
  b.updated_at = 2000
  b.url = "https://other.example/x"
  const c = cfg("alpha", "task-3", "c3", "h3")
  c.updated_at = 1000
  s.saveConfig(a)
  s.saveConfig(b)
  s.saveConfig(c)
  const all = s.page({ agents: [], task: "", config: "", url: "", limit: 25, offset: 0 })
  expect(all.total).toBe(3)
  expect(all.rows.map((r) => r.id).join(",")).toBe("c1,c2,c3")
  expect(s.page({ agents: ["alpha"], task: "", config: "", url: "", limit: 25, offset: 0 }).total).toBe(2)
  expect(s.page({ agents: [], task: "TASK-2", config: "", url: "", limit: 25, offset: 0 }).rows[0]!.id).toBe("c2")
  expect(s.page({ agents: [], task: "", config: "", url: "other", limit: 25, offset: 0 }).total).toBe(1)
  const cut = s.page({ agents: [], task: "", config: "", url: "", limit: 1, offset: 1 })
  expect(cut.total).toBe(3)
  expect(cut.rows[0]!.id).toBe("c2")
  expect(s.agentNames().join(",")).toBe("alpha,beta")
  expect(configView(a).includes("token")).toBe(false)
  expect(configView(a).includes(`"config_id":"c1"`)).toBe(true)
})

test("retries wait twice as long each time, up to five minutes", () => {
  expect(backoffMs(1)).toBe(1000)
  expect(backoffMs(2)).toBe(2000)
  expect(backoffMs(5)).toBe(16000)
  expect(backoffMs(12)).toBe(300000)
})

test("callbacks must be http or https without credentials, and public unless allowed", () => {
  expect(callbackProblem("https://cb.example/hook", false)).toBe("")
  expect(callbackProblem("http://cb.example/hook", false)).toBe("")
  expect(callbackProblem("ftp://cb.example/hook", false).includes("HTTP(S)")).toBe(true)
  expect(callbackProblem("https://user:pw@cb.example/hook", false).includes("user info")).toBe(true)
  expect(callbackProblem("http://127.0.0.1:9/hook", false).includes("private")).toBe(true)
  expect(callbackProblem("http://127.0.0.1:9/hook", true)).toBe("")
  expect(callbackProblem("http://169.254.169.254/latest", true).includes("metadata")).toBe(true)
  expect(callbackProblem("nope", false).includes("HTTP(S)")).toBe(true)
})

test("finished deliveries, unbound embedded configs and configs of removed agents are pruned", () => {
  const s = new PushStore()
  const base = 100000000000
  s.saveConfig(cfg("echo", "t1", "c1", "h1"))
  s.saveConfig(cfg("gone", "t1", "c1", "h2"))
  const late = cfg("echo", PENDING_PREFIX + "x", "c2", "h3")
  late.created_at = base
  s.saveConfig(late)
  s.addDelivery({ id: "old", agent: "echo", task: "t1", config: "c1", payload: "{}", status: "delivered", attempts: 1, next_at: 0, last_error: "", created_at: 0, updated_at: 0 })
  s.addDelivery({ id: "wait", agent: "echo", task: "t1", config: "c1", payload: "{}", status: "pending", attempts: 0, next_at: 0, last_error: "", created_at: 0, updated_at: 0 })
  s.prune(base + 2 * 3600000, ["echo"])
  expect(s.configs.length).toBe(1)
  expect(s.configs[0]!.id).toBe("c1")
  expect(s.deliveries.length).toBe(1)
  expect(s.deliveries[0]!.id).toBe("wait")
})

let tmpSeq = 0

function tmpDir(): string {
  tmpSeq += 1
  return "/tmp/raiju-a2apush-test-" + process.pid + "-" + Math.floor(Date.now()) + "-" + tmpSeq
}

function pending(id: string): PushDelivery {
  return { id: id, agent: "echo", task: "t1", config: "c1", payload: `{"task":{"id":"t1"}}`, status: "pending", attempts: 0, next_at: 0, last_error: "", created_at: 0, updated_at: 0 }
}

test("secrets are sealed in the files and opened on load", () => {
  const dir = tmpDir()
  const s = new PushStore()
  s.seal = (v: string): string => (v === "" ? v : "sealed:" + v)
  s.open = (v: string): string => (v.startsWith("sealed:") ? v.slice(7) : v)
  s.persistTo(dir + ".jsonl")
  const c = cfg("echo", "t1", "c1", "h1")
  c.token = "cb-token"
  c.credentials = "cb-cred"
  s.saveConfig(c)
  s.addDelivery(pending("d1"))
  const text = try readFileSync(dir + "/" + configFile("echo", "t1", "c1"), "utf8")
  expect(text.includes("sealed:cb-token")).toBe(true)
  expect(text.includes(`"token":"cb-token"`)).toBe(false)
  const back = new PushStore()
  back.seal = s.seal
  back.open = s.open
  back.persistTo(dir + ".jsonl")
  expect(back.configs.length).toBe(1)
  expect(back.configs[0]!.token).toBe("cb-token")
  expect(back.configs[0]!.credentials).toBe("cb-cred")
  expect(back.deliveries.length).toBe(1)
  try rmSync(dir, { recursive: true, force: true })
})

test("a single-file store of an earlier version is moved into the directory once", () => {
  const dir = tmpDir()
  const file = dir + ".jsonl"
  const c = cfg("echo", "t1", "c1", "h1")
  try writeFileSync(file, `{"t":"c","v":${JSON.stringify(c)}}\n{"t":"d","v":${JSON.stringify(pending("d1"))}}\nnot json\n`)
  const s = new PushStore()
  s.persistTo(file)
  expect(s.configs.length).toBe(1)
  expect(s.deliveries.length).toBe(1)
  expect(try readFileSync(file, "utf8")).toBe("")
  const again = new PushStore()
  again.persistTo(file)
  expect(again.configs.length).toBe(1)
  expect(again.deliveries.length).toBe(1)
  try rmSync(dir, { recursive: true, force: true })
  try rmSync(file, { force: true })
})

test("two stores on one directory see each other's configs, replacements and removals", () => {
  const dir = tmpDir()
  const a = new PushStore()
  const b = new PushStore()
  a.useDir(dir)
  b.useDir(dir)
  // registrations on different workers are all kept
  a.saveConfig(cfg("echo", "t1", "c1", "h1"))
  b.saveConfig(cfg("echo", "t2", "c2", "h2"))
  a.saveConfig(cfg("echo", "t3", "c3", "h3"))
  expect(a.page({ agents: [], task: "", config: "", url: "", limit: 25, offset: 0 }).total).toBe(3)
  expect(b.page({ agents: [], task: "", config: "", url: "", limit: 25, offset: 0 }).total).toBe(3)
  expect(b.byIngress("echo", "h1")!.task).toBe("t1")
  expect(a.config("echo", "t2", "c2")!.ingress).toBe("h2")
  // a replacement keeps when the config was created
  const moved = cfg("echo", "t1", "c1", "h9")
  moved.created_at = 5
  moved.updated_at = 5
  b.saveConfig(moved)
  expect(a.config("echo", "t1", "c1")!.ingress).toBe("h9")
  expect(a.config("echo", "t1", "c1")!.created_at).toBe(1000)
  // a removal on one is a removal on the other, and happens once
  expect(a.remove("echo", "t2", "c2")).toBe(true)
  expect(b.remove("echo", "t2", "c2")).toBe(false)
  expect(b.config("echo", "t2", "c2")).toBeUndefined()
  // an embedded config bound on one worker is bound on the other
  a.saveConfig(cfg("echo", PENDING_PREFIX + "p", "c4", "h4"))
  b.bind("echo", "h4", PENDING_PREFIX + "p", "t4")
  expect(a.config("echo", "t4", "c4")!.id).toBe("c4")
  expect(a.config("echo", PENDING_PREFIX + "p", "c4")).toBeUndefined()
  try rmSync(dir, { recursive: true, force: true })
})

test("a push accepted by one store is queued once and relayed by the store that takes its lease", () => {
  const dir = tmpDir()
  const a = new PushStore()
  const b = new PushStore()
  a.useDir(dir)
  b.useDir(dir)
  const m = try mintToken()
  a.saveConfig(cfg("echo", "t1", "c1", m.hash))
  const body = `{"task":{"id":"t1","status":{"state":"completed"}}}`
  const x = acceptPush(b, "echo", m.token, body, 5000)
  expect(x.status).toBe(202)
  // the same event arriving on the other worker is the same delivery
  const y = acceptPush(a, "echo", m.token, body, 5001)
  expect(y.deliveryId).toBe(x.deliveryId)
  expect(a.deliveries.length).toBe(1)
  expect(a.due(6000, 16).length).toBe(1)
  expect(b.due(6000, 16).length).toBe(1)
  // one of them gets the lease; the other is told no, whoever asks first
  const got = a.claim(x.deliveryId, 6000)
  expect(got === undefined).toBe(false)
  expect(b.claim(x.deliveryId, 6000) === undefined).toBe(true)
  expect(a.claim(x.deliveryId, 6000) === undefined).toBe(true)
  // the outcome is written, then the lease released
  const d = got!
  a.setDelivery({ id: d.id, agent: d.agent, task: d.task, config: d.config, payload: d.payload, status: "delivered", attempts: 1, next_at: 6000, last_error: "", created_at: d.created_at, updated_at: 6001 })
  a.release(d.id)
  // a delivery that is finished is not claimed again, and neither is one that waits for its backoff
  expect(b.claim(d.id, 7000) === undefined).toBe(true)
  expect(b.due(7000, 16).length).toBe(0)
  expect(b.delivery(d.id)!.status).toBe("delivered")
  try rmSync(dir, { recursive: true, force: true })
})

test("a claim made after another store finished the push finds it finished, even from an old list", () => {
  const dir = tmpDir()
  const a = new PushStore()
  const b = new PushStore()
  a.useDir(dir)
  b.useDir(dir)
  a.addDelivery(pending("d1"))
  // b listed it as due before a took it
  const listed = b.due(10, 16)
  expect(listed.length).toBe(1)
  const got = a.claim("d1", 10)!
  a.setDelivery({ id: got.id, agent: got.agent, task: got.task, config: got.config, payload: got.payload, status: "pending", attempts: 1, next_at: 100000, last_error: "x", created_at: 0, updated_at: 11 })
  a.release("d1")
  expect(b.claim(listed[0]!.id, 11) === undefined).toBe(true)
  // once the backoff has passed it can be claimed again, by either
  expect(b.claim("d1", 100000) === undefined).toBe(false)
  b.release("d1")
  try rmSync(dir, { recursive: true, force: true })
})

test("a lease whose holder died is taken over after it expires, by one store only", () => {
  const dir = tmpDir()
  const a = new PushStore()
  const b = new PushStore()
  const c = new PushStore()
  a.useDir(dir)
  b.useDir(dir)
  c.useDir(dir)
  a.addDelivery(pending("d1"))
  expect(a.claim("d1", 10) === undefined).toBe(false)
  // a never releases (it died); within the lease nobody else can
  expect(b.claim("d1", 10 + 1000) === undefined).toBe(true)
  const later = Math.floor(Date.now()) + 120000
  expect(b.claim("d1", later) === undefined).toBe(false)
  expect(c.claim("d1", Math.floor(Date.now())) === undefined).toBe(true)
  // a is no longer the owner: its outcome would be dropped
  expect(a.holds("d1")).toBe(false)
  expect(b.holds("d1")).toBe(true)
  a.release("d1")
  expect(c.claim("d1", Math.floor(Date.now())) === undefined).toBe(true)
  b.release("d1")
  expect(c.claim("d1", Math.floor(Date.now())) === undefined).toBe(false)
  c.release("d1")
  try rmSync(dir, { recursive: true, force: true })
})

test("one store in memory claims a delivery once at a time", () => {
  const s = new PushStore()
  s.addDelivery(pending("d1"))
  expect(s.claim("d1", 5) === undefined).toBe(false)
  expect(s.claim("d1", 5) === undefined).toBe(true)
  s.release("d1")
  expect(s.claim("d1", 5) === undefined).toBe(false)
  s.release("d1")
  expect(s.claim("nope", 5) === undefined).toBe(true)
})

test("a file being written (unreadable) keeps the copy in memory; a finished delivery is not read again", () => {
  const dir = tmpDir()
  const a = new PushStore()
  a.useDir(dir)
  a.saveConfig(cfg("echo", "t1", "c1", "h1"))
  a.addDelivery(pending("d1"))
  try writeFileSync(dir + "/" + configFile("echo", "t1", "c1"), `{"by":1,"v":{"agent":`)
  try writeFileSync(dir + "/" + deliveryFile("d1"), "")
  a.sync()
  expect(a.configs.length).toBe(1)
  expect(a.configs[0]!.ingress).toBe("h1")
  expect(a.deliveries.length).toBe(1)
  a.setDelivery({ id: "d1", agent: "echo", task: "t1", config: "c1", payload: "{}", status: "delivered", attempts: 1, next_at: 0, last_error: "", created_at: 0, updated_at: 1 })
  try writeFileSync(dir + "/" + deliveryFile("d1"), "garbage")
  a.sync()
  expect(a.deliveries[0]!.status).toBe("delivered")
  try rmSync(dir, { recursive: true, force: true })
})

test("pruning removes the files of what it drops", () => {
  const dir = tmpDir()
  const a = new PushStore()
  const b = new PushStore()
  a.useDir(dir)
  b.useDir(dir)
  a.saveConfig(cfg("gone", "t1", "c1", "h1"))
  a.addDelivery({ id: "old", agent: "gone", task: "t1", config: "c1", payload: "{}", status: "delivered", attempts: 1, next_at: 0, last_error: "", created_at: 0, updated_at: 0 })
  b.prune(100000000000, [])
  a.sync()
  expect(a.configs.length).toBe(0)
  expect(a.deliveries.length).toBe(0)
  try rmSync(dir, { recursive: true, force: true })
})
