// The MCP authorization server (Bifrost's discovery documents, /oauth2/register, /oauth2/authorize,
// /oauth2/token and the consent page), on when client.mcp_server_auth_mode is "both" or "oauth". An MCP
// client registers (RFC 7591), sends its user to the consent page, and the user approves the request with a
// virtual key. The client then trades the one-time code (PKCE S256) for an access token and a refresh token.
// The access token is an RS256 JWT whose sub is the virtual key's id and whose bf_mode is "vk", so a /mcp call
// that carries it runs as that key (Bifrost's vk mode). A session-mode grant (a dashboard user consents, no key)
// signs a token with bf_mode "session": the request runs anonymously, as Bifrost's session mode does. A user-mode
// grant (an identity-provider user signed in through the gateway's OIDC sign-in, oidc.tov) signs bf_mode "user"
// with the user's subject: the request runs as that user (Bifrost's user mode, on Raiju's own identity provider).
//
// The signing key is the operator's PEM (client.oauth2_server_config.signing_key). Without one, a key is generated
// at the first start and kept in the state file beside config.json (openIssuerState), so a restart and every worker
// of the node sign with the same key. The grants (refresh tokens and the clients they belong to) and the consented
// requests (their codes as hashes) are kept there too, and read back when one is not held in memory, so a restart and
// a second worker see them. Only a consent, a token request, a refresh or a revoke writes that file.
//
// The two routes anyone may call store little. /oauth2/authorize stores nothing: the pending request is sealed into
// the consent link's token (AES-256-GCM under a key derived from the signing key), so any worker, and any node with the
// same signing key, opens it. /oauth2/register appends one line to the client registry (<state>-clients.jsonl) under
// the file's lock; that file is rewritten only when it holds twice as many lines as live clients. Registration is
// bounded (Raiju's limits; Bifrost has none, only an hourly sweep of clients with no grant): per address, a number of
// registrations a minute and of unused clients (clients with no grant yet); in all, a number of unused clients, the
// oldest dropped past it; and an unused client lives an hour (Bifrost's sweep grace), as does a client whose grants
// have all aged out.
import { Config, OAuth2ServerConfig, VirtualKeyConfig } from "./config"
import { pkceChallenge } from "./mcpauth"
import { secureHex, sha256, utf8, toHex, hmacSha256 } from "./crypto"
import { gcmSeal, gcmOpen } from "./aesgcm"
import { encodeUrl, decode } from "./base64"
import { signRs256, verifyRs256, publicKeyId, publicJwk, generateRsaPem } from "./jwt"
import { Field, fields, elements, find, rawStr, rawNum, decodeString, isNull } from "./json"
import { Hdrs, errorJson } from "./schemas"
import { rfc3339Ms } from "./vkexpiry"
import { rfc3339 } from "./anthropic_batch"
import { connectPageHtml, consentPageHtml } from "./mcpconsent"
import { ConfigCipher, sealStored, openStored } from "./store"
import { existsSync, readFileSync, unlinkSync, writeFileSync, rmSync, statSync } from "node:fs"
import { writeFileAtomic, appendPrivate } from "./atomicfile"
import { readState, stateVersion } from "./statever"
import { FileLock, lockFile, lockFileAsync, unlockFile } from "./filelock"
import { parseIP, formatIP } from "./netguard"
import { CLIENT_IP_HEADER } from "./clientip"

// The lifetimes and limits of Bifrost's defaults (mcpoauth2issuance.go and the table constants).
const DEFAULT_CODE_TTL_S: f64 = 300.0
const MAX_CODE_TTL_S: f64 = 900.0
const DEFAULT_ACCESS_TTL_S: f64 = 600.0
const MAX_CLIENT_NAME = 2048
const MAX_SCOPE = 4096
const MAX_STATE = 8192
const MAX_CHALLENGE = 128
const MAX_REDIRECTS = 32
const MAX_REDIRECT = 2048
// Revoked refresh rows are kept this long (so a replayed token still revokes its family), then dropped from the file.
const REVOKED_KEEP_MS = 30 * 86400000.0
// The signing key the generated one is sized to (Bifrost's size).
const GENERATED_KEY_BITS = 2048
// Session list paging (Bifrost's oauth2SessionsDefaultLimit and oauth2SessionsMaxLimit).
const SESSIONS_DEFAULT_LIMIT = 50
const SESSIONS_MAX_LIMIT = 500
// The registration limits' defaults (client.oauth2_server_config; Raiju's own, Bifrost has none). An unused client is
// one with no grant yet: no refresh token and no consented request.
const DEFAULT_MAX_UNUSED_CLIENTS = 1000
const DEFAULT_MAX_UNUSED_PER_ADDRESS = 20
const DEFAULT_REGISTRATIONS_PER_MINUTE = 10
// How long a client with no grant lives (Bifrost's orphanClientGrace, one hour). It must outlive a code (MAX_CODE_TTL_S),
// so a client mid-handshake is not dropped before its first token.
const DEFAULT_UNUSED_CLIENT_TTL_S = 3600
const MIN_UNUSED_CLIENT_TTL_S = 1200
// The unused clients held in memory and in the registry stay under this many bytes too (a client may be 70 KB).
const MAX_UNUSED_BYTES = 8 * 1048576
// The addresses whose registrations this process counts (the window of the last minute), at most.
const MAX_THROTTLED_ADDRESSES = 10000
// How long a read that is not forced trusts the files as last read while their size and time are unchanged.
const RECHECK_MS: f64 = 1000.0
// A consent link's token: this prefix, then base64url of a 12-byte nonce and the AES-256-GCM sealed request.
const FLOW_PREFIX = "f1."
const FLOW_AAD = "raiju-mcp-consent-v1"
// The registry's first line: its format version and a generation that changes when the file is rewritten.
const REGISTRY_VERSION = 1

// A registered client (RFC 7591) and what a request needs from it. ah names the address it registered from (a hash of
// the address, an IPv6 one by its /64; "" or absent when unknown), for the per-address limits.
export type OAuthClientRow = { client_id: string, client_name: string, redirect_uris: string[], grant_types: string[], scope: string, created_at: f64, ah?: string }

// An authorization request: pending until the consent page approves it ("consented", with the identity it names),
// then "used" once its code is exchanged. mode is "vk" (sub is the key's id), "session" (sub is a random id) or
// "user" (sub is the identity-provider user). code_hash is the SHA-256 of the code, which is never stored.
// consented_at is when the consent named the identity (a key rotated after it voids the code).
export type AuthRequest = { id: string, client_id: string, redirect_uri: string, state: string, scope: string, resource: string, challenge: string, expires_at: f64, status: string, mode: string, sub: string, code_hash: string, consented_at?: f64 }

// A refresh token by its SHA-256. Rotation marks the old row revoked and issues a row of the same family; a
// revoked row presented again revokes the whole family (RFC 9700, section 2.2.2). created_at is when the grant
// was first issued and used_at when its token was last refreshed (0 before the first refresh).
export type RefreshRow = { hash: string, family: string, client_id: string, mode: string, sub: string, scope: string, resource: string, created_at: f64, used_at: f64, revoked: bool }

// The registration limits (client.oauth2_server_config): per address, registrations a minute and unused clients; in
// all, unused clients; and how long an unused client lives (ms). 0 turns a count limit off.
export type ClientLimits = { perMinute: int, perAddress: int, maxUnused: int, unusedTtlMs: f64 }

// The settings the endpoints read. kid names the signing key in the token headers; flowKey seals the consent links.
export type Issuer = { issuer: string, resource: string, pem: string, kid: string, codeTtl: f64, accessTtl: f64, allowed: string[], flowKey: u8[], limits: ClientLimits }

// What an endpoint answers. The headers that differ by route are optional.
export type Answer = { status: int, body: string, contentType: string, location?: string, challenge?: string, retryAfter?: int }

// What a request's Bearer token names: a virtual key, a session (no verified identity), an identity-provider user,
// a rejected token, or nothing (no JWT was sent).
export type Caller = { kind: "none" } | { kind: "vk", vk: string } | { kind: "session", sub: string } | { kind: "user", sub: string } | { kind: "error", message: string }

// A pending authorization request as its consent link carries it (sealed): the flow id, client, redirect URI, state,
// scope, resource, PKCE challenge and expiry.
type Flow = { i: string, c: string, r: string, s: string, sc: string, rs: string, ch: string, e: f64 }

// The state file: the signing key (sealed with the config's cipher when there is one), the clients that hold a grant,
// the refresh rows, and the consented requests not yet expired. (Files of earlier versions also hold every registered
// client, the pending requests and their consent tokens: the clients are taken, the rest is not.)
type StateFile = { version?: int, signing_key?: string, clients?: OAuthClientRow[], refresh?: RefreshRow[], requests?: AuthRequest[] }
// The registry's first line.
type RegistryHead = { version?: int, gen?: string }
// The state file's version (statever.tov): a file from a newer Raiju is neither read nor written over.
const ISSUER_STATE_VERSION = 1

// Who is consenting, as the request's credentials show it (Bifrost's identity resolver and consent checks).
// signedIn: a dashboard sign-in (a session token or admin credentials) or an identity-provider user is on the
// request. enforce: inference auth is enforced. userAvailable: the gateway's OIDC sign-in is on, so user mode can
// be offered. disableVk: oauth2_server_config.disable_vk_identity. user and userName: the signed-in identity-provider
// user ("" when none). userActive tells whether a user may still use a user-mode grant.
export type ConsentContext = { signedIn: bool, enforce: bool, userAvailable: bool, disableVk: bool, user: string, userName: string, userActive: (sub: string) => bool }

const CLIENTS: Map<string, OAuthClientRow> = new Map()
// The requests past consent (consented, used or revoked), by flow id: a pending one lives in its consent link only.
const REQUESTS: Map<string, AuthRequest> = new Map()
const REFRESH: Map<string, RefreshRow> = new Map()
// The registrations this process admitted in the current minute, by address: [the minute's start, the count].
const RECENT: Map<string, f64[]> = new Map()

// The key this node signs with when the config names none: the PEM, and its sealed form for the state file.
let generatedPem = ""
let sealedKey = ""
// The state file the grants and the generated key live in, or "" to keep them in memory only (tests).
let stateFile = ""
let stateCipher: ConfigCipher | undefined = undefined
// The state file's size and time when last read or written ("" before), and when that was.
let stateStamp = ""
let stateReadAt: f64 = -1.0e15
// The client registry beside the state file ("" with no state file): its generation and the bytes, lines and stamp
// already taken into memory, and when it was last read.
let registryFile = ""
let registryGen = ""
let registryAt = 0
let registryLines = 0
let registryStamp = ""
let registryReadAt: f64 = -1.0e15

// Whether the problem note has been printed for the current misconfiguration.
let warned = false

// client.mcp_server_auth_mode: "headers" (default), "both" or "oauth". Any other value is refused.
export function serverAuthMode(c: Config): string {
  return c.client?.mcp_server_auth_mode ?? "headers"
}

// The PEM that signs the tokens: the configured signing_key, else the key generated for this node ("" if none).
function signingPemOf(oc: OAuth2ServerConfig): string {
  const configured = oc.signing_key ?? ""
  return configured !== "" ? configured : generatedPem
}

// Why the authorization server cannot run with this config, or "" when it can (or when it is off).
export function issuerProblem(c: Config): string {
  const mode = serverAuthMode(c)
  if (mode !== "headers" && mode !== "both" && mode !== "oauth") return `client.mcp_server_auth_mode is ${mode}, not headers, both or oauth`
  if (mode === "headers") return ""
  const oc: OAuth2ServerConfig = c.client?.oauth2_server_config ?? {}
  const iss = trimSlash(oc.issuer_url ?? "")
  if (iss === "") return "client.oauth2_server_config.issuer_url is required when MCP OAuth is on"
  if (!iss.startsWith("https://") && !iss.startsWith("http://")) return "client.oauth2_server_config.issuer_url must be an http or https URL"
  const pem = signingPemOf(oc)
  if (pem === "") return "there is no signing key: set client.oauth2_server_config.signing_key (an RSA private key in PEM), or start with a writable config folder so one is generated"
  try {
    const kid = try publicKeyId(pem)
    if (kid === "") return "signing_key is not usable"
  } catch (e) {
    return "the signing key is not an RSA private key in PEM"
  }
  return ""
}

// The client registry beside a state file: mcp-oauth-state.json keeps it in mcp-oauth-state-clients.jsonl.
export function registryOf(file: string): string {
  if (file === "") return ""
  return (file.endsWith(".json") ? file.slice(0, file.byteLength - 5) : file) + "-clients.jsonl"
}

// Opens the state file beside config.json and takes the signing key from it. When the authorization server is on
// and the config names no signing_key, the key is generated at the first start and saved there, so every later
// start (and every worker, which all start after this) signs with it. A configured key always wins. The client
// registry beside it is read too; with the server on, both are written back once, so a file of an earlier version
// (every registered client and the pending requests in the state file) is split, and the clients past their limits
// dropped. Returns a note to print, or "" when all is well.
export function openIssuerState(c: Config, file: string, cipher: ConfigCipher | undefined): string {
  stateFile = file
  stateCipher = cipher
  stateStamp = ""
  stateReadAt = -1.0e15
  registryFile = registryOf(file)
  registryGen = ""
  registryAt = 0
  registryLines = 0
  registryStamp = ""
  registryReadAt = -1.0e15
  generatedPem = ""
  sealedKey = ""
  let st: StateFile = {}
  if (existsSync(file)) {
    try {
      const r = readState(file, try readFileSync(file, "utf8"), ISSUER_STATE_VERSION, [])
      if (!r.ok && r.from > ISSUER_STATE_VERSION) {
        // nothing is written over it either
        stateFile = ""
        registryFile = ""
        return `${r.problem}: it is not written over, and the MCP authorization server is off until it is moved aside or removed`
      }
      st = try JSON.parse(r.text) as StateFile
    } catch (e) {
      return `the state file ${file} cannot be read; the MCP authorization server is off until it is fixed or removed`
    }
  }
  adoptGrants(st)
  readRegistry(true, Date.now())
  if (serverAuthMode(c) === "headers") return ""
  const oc: OAuth2ServerConfig = c.client?.oauth2_server_config ?? {}
  trimClients(limitsOf(oc), Date.now())
  if ((oc.signing_key ?? "") !== "") {
    tidyFiles(limitsOf(oc))
    return ""
  }
  const stored = st.signing_key ?? ""
  const opened = openStored(cipher, stored)
  if (opened === undefined) return `the signing key in ${file} is sealed and cannot be opened: check encryption_key`
  let pem: string = opened
  if (pem === "") {
    try {
      pem = try generateRsaPem(GENERATED_KEY_BITS)
    } catch (e) {
      return `could not generate the MCP signing key: ${e.message}`
    }
    try {
      sealedKey = try sealStored(cipher, pem)
    } catch (e) {
      return `could not seal the MCP signing key: ${e.message}`
    }
    generatedPem = pem
    tidyFiles(limitsOf(oc))
    return ""
  }
  generatedPem = pem
  sealedKey = stored
  tidyFiles(limitsOf(oc))
  return ""
}

// Writes the state file and the registry once, with what memory holds (at the start, before the workers fork).
function tidyFiles(lim: ClientLimits): void {
  if (stateFile === "") return
  const lock = lockFile(stateFile)
  if (!lock.ok) {
    console.error(`raiju: mcp oauth: ${stateFile} is locked by another process; it is tidied at a later start`)
    return
  }
  // the state file keeps the clients that hold a grant; the others, within their limits, go to the registry
  writeGrants()
  trimClients(lim, Date.now())
  rewriteRegistry()
  unlockFile(lock)
}

// How far a request has gone: a later status written by another worker wins.
function statusRank(s: string): int {
  if (s === "revoked") return 3
  if (s === "used") return 2
  if (s === "consented") return 1
  return 0
}

// Takes what the state file holds into memory: clients, refresh rows and requests past consent not known yet, a row
// another worker revoked, and a request another worker took further. Nothing is removed, so a row this worker has
// revoked stays revoked. Pending requests of earlier versions are not taken (their links no longer open).
function adoptGrants(st: StateFile): void {
  for (const r of st.requests ?? []) {
    if (r.status === "pending") continue
    const have = REQUESTS.get(r.id)
    if (have === undefined || statusRank(r.status) > statusRank(have.status)) REQUESTS.set(r.id, r)
  }
  for (const cl of st.clients ?? []) {
    if (!CLIENTS.has(cl.client_id)) CLIENTS.set(cl.client_id, cl)
  }
  for (const r of st.refresh ?? []) {
    const have = REFRESH.get(r.hash)
    if (have === undefined) {
      REFRESH.set(r.hash, r)
    } else if (r.revoked && !have.revoked) {
      REFRESH.set(r.hash, { hash: have.hash, family: have.family, client_id: have.client_id, mode: have.mode, sub: have.sub, scope: have.scope, resource: have.resource, created_at: have.created_at, used_at: have.used_at, revoked: true })
    }
  }
}

// A file's size and time, or "" when it is not there.
function stampOf(file: string): string {
  try {
    const s = statSync(file)
    return `${s.size}:${s.mtimeMs}`
  } catch (e) {
    return ""
  }
}

// Reads the state file into memory (another worker may have written it since). Unless forced, a file whose size and
// time are as last read, at most RECHECK_MS ago, is not read again: a request naming an unknown code, token or flow
// then costs no read. A read that must see another worker's latest write (before a code is spent, a refresh rotated,
// a consent recorded, or under the lock before a write) is forced.
function syncGrants(force: bool): void {
  if (stateFile === "") return
  const now = Date.now()
  const stamp = stampOf(stateFile)
  if (stamp === "") return
  if (!force && stamp === stateStamp && now - stateReadAt < RECHECK_MS) return
  stateStamp = stamp
  stateReadAt = now
  try {
    const text = try readFileSync(stateFile, "utf8")
    // a newer Raiju wrote it since: its rows are not taken (persistGrants does not write over it either)
    if (stateVersion(text) > ISSUER_STATE_VERSION) return
    const st = try JSON.parse(text) as StateFile
    adoptGrants(st)
  } catch (e) {
    return
  }
}

// Writes the grants and the signing key to the state file. The file is read first, under its lock (filelock.tov), so
// the rows another worker wrote are kept too. Refresh rows revoked long ago are dropped. Without a state file this
// does nothing. A route that writes holds the lock already (issuerRoute), so this take does not wait.
function persistGrants(): void {
  if (stateFile === "") return
  const lock = lockFile(stateFile)
  if (!lock.ok) {
    // nothing is written without the lock; the grants stay in memory and the next change writes them
    console.error(`raiju: mcp oauth: ${stateFile} is locked by another process; grants not saved this time`)
    return
  }
  writeGrants()
  unlockFile(lock)
}

// The clients that hold a grant: a refresh row (live, or revoked and kept for reuse detection) or a request past
// consent that has not expired.
function heldClients(nowMs: f64): Map<string, bool> {
  const held: Map<string, bool> = new Map()
  for (const r of REFRESH.values()) held.set(r.client_id, true)
  for (const r of REQUESTS.values()) {
    if (r.expires_at > nowMs) held.set(r.client_id, true)
  }
  return held
}

function writeGrants(): void {
  syncGrants(true)
  const now = Date.now()
  const cutoff = now - REVOKED_KEEP_MS
  const refresh: RefreshRow[] = []
  for (const r of REFRESH.values()) {
    if (!r.revoked || r.created_at >= cutoff) refresh.push(r)
  }
  // requests live until their expiry
  const requests: AuthRequest[] = []
  for (const r of REQUESTS.values()) {
    if (r.expires_at > now) requests.push(r)
  }
  // the clients of these grants; the unused ones live in the registry
  const held = heldClients(now)
  const clients: OAuthClientRow[] = []
  for (const cl of CLIENTS.values()) {
    if (held.has(cl.client_id)) clients.push(cl)
  }
  const st: StateFile = { version: ISSUER_STATE_VERSION, clients: clients, refresh: refresh, requests: requests }
  if (sealedKey !== "") st.signing_key = sealedKey
  try {
    if (existsSync(stateFile) && stateVersion(try readFileSync(stateFile, "utf8")) > ISSUER_STATE_VERSION) {
      console.error(`raiju: mcp oauth: ${stateFile} was written by a newer Raiju; it is not written over`)
      return
    }
    writeFileAtomic(stateFile, JSON.stringify(st) + "\n", { mode: 384 })
    // what was just written is what memory holds: it is not read back
    stateStamp = stampOf(stateFile)
    stateReadAt = now
  } catch (e) {
    console.error(`raiju: mcp oauth: could not write ${stateFile}: ${e.message}`)
  }
}

// ---- the client registry ----

// Reads the clients another worker registered since the last read: only the lines past what was read, or the whole
// file when it was rewritten since (a new generation). Unless forced, a file as last read (size and time), at most
// RECHECK_MS ago, is not read.
function readRegistry(force: bool, nowMs: f64): void {
  if (registryFile === "") return
  const stamp = stampOf(registryFile)
  if (stamp === "") return
  if (!force && stamp === registryStamp && nowMs - registryReadAt < RECHECK_MS) return
  registryStamp = stamp
  registryReadAt = nowMs
  let text = ""
  try {
    text = try readFileSync(registryFile, "utf8")
  } catch (e) {
    return
  }
  const nl = text.indexOf("\n")
  if (nl < 0) return
  const head = text.slice(0, nl)
  let from = registryAt
  if (head !== registryGen || text.byteLength < registryAt) {
    try {
      const h = try JSON.parse(head) as RegistryHead
      // a registry from a newer Raiju is not read (nor written over: rewriteRegistry checks too)
      if ((h.version ?? 0) > REGISTRY_VERSION) return
    } catch (e) {
      return
    }
    registryGen = head
    registryLines = 0
    from = nl + 1
  }
  const lines = text.slice(from).split("\n")
  // the last piece is "" or a line still being written
  let at = from
  for (let i = 0; i + 1 < lines.length; i++) {
    const line = lines[i]!
    at += line.byteLength + 1
    if (line === "") continue
    registryLines += 1
    try {
      const cl = try JSON.parse(line) as OAuthClientRow
      if (cl.client_id !== "" && !CLIENTS.has(cl.client_id)) CLIENTS.set(cl.client_id, cl)
    } catch (e) {
      // a damaged line is skipped
    }
  }
  registryAt = at
}

// Appends one client to the registry (the caller holds the lock and has read the registry to its end).
function appendRegistry(cl: OAuthClientRow): void throws Error {
  if (registryFile === "") return
  if (!existsSync(registryFile) || registryGen === "") rewriteRegistry()
  const line = JSON.stringify(cl) + "\n"
  try appendPrivate(registryFile, line)
  registryAt += line.byteLength
  registryLines += 1
  registryStamp = stampOf(registryFile)
}

// Rewrites the registry with the unused clients memory holds, under a new generation (the caller holds the lock).
function rewriteRegistry(): void {
  if (registryFile === "") return
  try {
    if (existsSync(registryFile)) {
      const text = try readFileSync(registryFile, "utf8")
      const nl = text.indexOf("\n")
      if (nl > 0) {
        const h = try JSON.parse(text.slice(0, nl)) as RegistryHead
        if ((h.version ?? 0) > REGISTRY_VERSION) {
          console.error(`raiju: mcp oauth: ${registryFile} was written by a newer Raiju; it is not written over`)
          return
        }
      }
    }
    const held = heldClients(Date.now())
    const head = JSON.stringify({ version: REGISTRY_VERSION, gen: try secureHex(8) })
    const out: string[] = [head]
    let n = 0
    for (const cl of CLIENTS.values()) {
      if (held.has(cl.client_id)) continue
      out.push(JSON.stringify(cl))
      n += 1
    }
    const text = out.join("\n") + "\n"
    writeFileAtomic(registryFile, text, { mode: 384, durable: false })
    registryGen = head
    registryAt = text.byteLength
    registryLines = n
    registryStamp = stampOf(registryFile)
    registryReadAt = Date.now()
  } catch (e) {
    console.error(`raiju: mcp oauth: could not write ${registryFile}: ${e.message}`)
  }
}

// The size a client takes, roughly (its registry line).
function clientBytes(cl: OAuthClientRow): int {
  let n = 160 + cl.client_name.byteLength + cl.scope.byteLength
  for (const u of cl.redirect_uris) n += u.byteLength + 3
  return n
}

// Drops the clients past their limits, the same way on every worker: a client with no grant older than the unused
// lifetime, then, past maxUnused unused clients (or MAX_UNUSED_BYTES), the oldest unused ones. A client that holds a
// grant is never dropped. Returns how many unused clients are left.
function trimClients(lim: ClientLimits, nowMs: f64): int {
  const held = heldClients(nowMs)
  const born = nowMs - lim.unusedTtlMs
  const unused: OAuthClientRow[] = []
  let bytes = 0
  for (const k of CLIENTS.keys()) {
    const cl = CLIENTS.get(k)!
    if (held.has(k)) continue
    if (cl.created_at <= born) {
      CLIENTS.delete(k)
      continue
    }
    unused.push(cl)
    bytes += clientBytes(cl)
  }
  const cap = lim.maxUnused
  if ((cap > 0 && unused.length > cap) || bytes > MAX_UNUSED_BYTES) {
    // newest first; the order is the same on every worker
    unused.sort((a: OAuthClientRow, b: OAuthClientRow): int => a.created_at !== b.created_at ? (a.created_at > b.created_at ? -1 : 1) : (a.client_id < b.client_id ? -1 : 1))
    let kept = 0
    let size = 0
    for (const cl of unused) {
      size += clientBytes(cl)
      if ((cap > 0 && kept >= cap) || size > MAX_UNUSED_BYTES) {
        CLIENTS.delete(cl.client_id)
      } else {
        kept += 1
      }
    }
    return kept
  }
  return unused.length
}

// The limits client.oauth2_server_config sets, with Raiju's defaults (a negative count turns that limit off).
export function limitsOf(oc: OAuth2ServerConfig): ClientLimits {
  const pm = oc.registrations_per_minute ?? DEFAULT_REGISTRATIONS_PER_MINUTE
  const pa = oc.max_unused_clients_per_address ?? DEFAULT_MAX_UNUSED_PER_ADDRESS
  const mu = oc.max_unused_clients ?? DEFAULT_MAX_UNUSED_CLIENTS
  const ttl = oc.unused_client_ttl_seconds ?? DEFAULT_UNUSED_CLIENT_TTL_S
  return {
    perMinute: pm < 0 ? 0 : (pm === 0 ? DEFAULT_REGISTRATIONS_PER_MINUTE : pm),
    perAddress: pa < 0 ? 0 : (pa === 0 ? DEFAULT_MAX_UNUSED_PER_ADDRESS : pa),
    maxUnused: mu < 0 ? 0 : (mu === 0 ? DEFAULT_MAX_UNUSED_CLIENTS : mu),
    unusedTtlMs: (ttl <= 0 ? DEFAULT_UNUSED_CLIENT_TTL_S : Math.max(ttl, MIN_UNUSED_CLIENT_TTL_S)) * 1000.0,
  }
}

// The address a client registers from, as the limits count it: an IPv6 address by its /64 (one host may hold a whole
// /64), hashed so the registry keeps no address. "" when unknown.
export function addressHash(addr: string): string {
  const a = addr.trim()
  if (a === "") return ""
  let key = a
  const b = parseIP(a)
  if (b !== undefined) {
    const v4 = b[0]! === 0 && b[8]! === 0 && b[10]! === 255 && b[11]! === 255
    if (v4) {
      key = formatIP(b)
    } else {
      const net: int[] = []
      for (let i = 0; i < 16; i++) net.push(i < 8 ? b[i]! : 0)
      key = formatIP(net) + "/64"
    }
  }
  return toHex(sha256(utf8("raiju-dcr:" + key))).slice(0, 24)
}

// The seconds an address must wait before this process admits another registration from it (0: it may register now),
// counting the current minute only. take counts the registration when it is admitted.
function minuteWait(ah: string, perMinute: int, nowMs: f64, take: bool): int {
  if (ah === "" || perMinute <= 0) return 0
  const w = RECENT.get(ah)
  if (w !== undefined && nowMs - w[0]! < 60000.0) {
    if (w[1]! >= perMinute * 1.0) return Math.max(1, Math.ceil((w[0]! + 60000.0 - nowMs) / 1000.0))
    if (take) RECENT.set(ah, [w[0]!, w[1]! + 1.0])
    return 0
  }
  if (!take) return 0
  if (RECENT.size >= MAX_THROTTLED_ADDRESSES) {
    for (const k of RECENT.keys()) {
      if (nowMs - RECENT.get(k)![0]! >= 60000.0) RECENT.delete(k)
    }
    if (RECENT.size >= MAX_THROTTLED_ADDRESSES) RECENT.clear()
  }
  RECENT.set(ah, [nowMs, 1.0])
  return 0
}

function slowDown(seconds: int, desc: string): Answer {
  let a = oauthErr(429, "temporarily_unavailable", desc)
  a.retryAfter = seconds
  return a
}

// ---- consent links ----

// The key that seals consent links: derived from the signing key, so every worker, a restart, and every node that signs
// with the same key opens a link another one made.
export function flowKeyOf(pem: string): u8[] {
  return hmacSha256(utf8(pem), utf8(FLOW_AAD))
}

const HEXD = "0123456789abcdef"

function randomBytes(n: int): u8[] throws Error {
  const h = try secureHex(n * 2)
  const out: u8[] = []
  for (let i = 0; i + 1 < h.byteLength; i += 2) out.push(u8(HEXD.indexOf(h.slice(i, i + 1)) * 16 + HEXD.indexOf(h.slice(i + 1, i + 2))))
  return out
}

function sealFlow(key: u8[], f: Flow): string throws Error {
  const nonce = try randomBytes(12)
  return FLOW_PREFIX + encodeUrl(nonce.concat(gcmSeal(key, nonce, utf8(JSON.stringify(f)), utf8(FLOW_AAD))))
}

// The request a consent link's token carries, or undefined when it was not sealed with this key or was changed.
function openFlow(key: u8[], token: string): Flow | undefined {
  if (!token.startsWith(FLOW_PREFIX) || token.byteLength > 65536 || key.length !== 32) return undefined
  try {
    const raw = try decode(token.slice(FLOW_PREFIX.byteLength))
    if (raw.length < 28) return undefined
    const pt = gcmOpen(key, raw.slice(0, 12), raw.slice(12), utf8(FLOW_AAD))
    if (pt === undefined) return undefined
    return try JSON.parse(try new TextDecoder().decode(pt)) as Flow
  } catch (e) {
    return undefined
  }
}

// The authorization server's settings, or undefined when it is off or cannot run (the problem is printed once).
export function issuerOf(c: Config): Issuer | undefined {
  if (serverAuthMode(c) === "headers") return undefined
  const problem = issuerProblem(c)
  if (problem !== "") {
    if (!warned) {
      warned = true
      console.error(`raiju: mcp oauth: ${problem}; the MCP authorization server is off`)
    }
    return undefined
  }
  warned = false
  const oc: OAuth2ServerConfig = c.client?.oauth2_server_config ?? {}
  const base = trimSlash(oc.issuer_url ?? "")
  const pem = signingPemOf(oc)
  let kid = ""
  try {
    kid = try publicKeyId(pem)
  } catch (e) {
    return undefined
  }
  const codeTtl = oc.auth_code_ttl ?? 0
  const accessTtl = oc.access_token_ttl ?? 0
  return {
    issuer: base,
    resource: base + "/mcp",
    pem: pem,
    kid: kid,
    codeTtl: codeTtl <= 0 ? DEFAULT_CODE_TTL_S : Math.min(codeTtl * 1.0, MAX_CODE_TTL_S),
    accessTtl: accessTtl <= 0 ? DEFAULT_ACCESS_TTL_S : accessTtl * 1.0,
    allowed: oc.allowed_redirect_uris ?? [],
    flowKey: flowKeyOf(pem),
    limits: limitsOf(oc),
  }
}

// The virtual key with this id in the config, or undefined.
export function keyById(c: Config, id: string): VirtualKeyConfig | undefined {
  for (const vk of c.governance?.virtual_keys ?? []) {
    if (vk.id === id) return vk
  }
  return undefined
}

// Whether a virtual key can still be used: active, and not past its expiry.
export function keyUsable(vk: VirtualKeyConfig | undefined, nowMs: f64): bool {
  if (vk === undefined || vk.is_active === false) return false
  const exp = rfc3339Ms(vk.expires_at ?? "")
  return exp === undefined || nowMs < exp
}

// The WWW-Authenticate value that points a client at the protected resource's metadata (RFC 9728, section 5).
export function challengeOf(iss: Issuer): string {
  return `Bearer resource_metadata="${iss.issuer}/.well-known/oauth-protected-resource/mcp"`
}

// What a request's Authorization header names. A token that is not a JWT is left to the virtual-key path.
export function callerOf(iss: Issuer | undefined, authorization: string | undefined, nowMs: f64): Caller {
  if (iss === undefined) return { kind: "none" }
  const auth = (authorization ?? "").trim()
  if (!auth.toLowerCase().startsWith("bearer ")) return { kind: "none" }
  const tok = auth.slice(7).trim()
  if (!tok.startsWith("eyJ")) return { kind: "none" }
  return verifyBearer(tok, iss, nowMs)
}

function bad(message: string): Caller {
  return { kind: "error", message: message }
}

// Checks an access token: the RS256 signature under our key, the issuer, the audience (this resource), the
// expiry, and that it is a virtual-key token. Its sub is the key's id.
function verifyBearer(tok: string, iss: Issuer, nowMs: f64): Caller {
  const parts = tok.split(".")
  if (parts.length !== 3) return bad("invalid token: not a JWS compact serialization")
  let header: Field[] = []
  let claims: Field[] = []
  try {
    header = try fields(try b64text(parts[0]!))
    claims = try fields(try b64text(parts[1]!))
  } catch (e) {
    return bad("invalid token: malformed")
  }
  if (rawStr(header, "alg") !== "RS256") return bad("invalid token: alg is not RS256")
  if (rawStr(header, "kid") !== iss.kid) return bad("invalid token: unknown key id")
  let ok = false
  try {
    ok = try verifyRs256(iss.pem, parts[0]! + "." + parts[1]!, parts[2]!)
  } catch (e) {
    ok = false
  }
  if (!ok) return bad("invalid token: signature")
  if (rawStr(claims, "iss") !== iss.issuer) return bad("invalid token: issuer does not match")
  if (!audienceIs(find(claims, "aud"), iss.resource)) return bad("invalid token: audience does not match this resource")
  const exp = rawNum(claims, "exp")
  if (exp === undefined || nowMs / 1000.0 >= exp) return bad("invalid token: expired")
  if (rawNum(claims, "iat") === undefined) return bad("invalid token: missing iat")
  const nbf = rawNum(claims, "nbf")
  if (nbf !== undefined && nowMs / 1000.0 < nbf) return bad("invalid token: not valid yet")
  const sub = rawStr(claims, "sub") ?? ""
  if (sub === "") return bad("invalid token: missing sub")
  const mode = rawStr(claims, "bf_mode") ?? ""
  if (mode === "vk") return { kind: "vk", vk: sub }
  if (mode === "session") return { kind: "session", sub: sub }
  if (mode === "user") return { kind: "user", sub: sub }
  return bad(`invalid token: bf_mode ${mode} is not accepted`)
}

// Whether an aud claim (a string, or an array of strings) names the resource.
function audienceIs(raw: string | undefined, want: string): bool {
  if (raw === undefined || isNull(raw)) return false
  try {
    if (raw.startsWith("[")) {
      for (const e of try elements(raw)) {
        if (try decodeString(e) === want) return true
      }
      return false
    }
    return (try decodeString(raw)) === want
  } catch (e) {
    return false
  }
}

// A base64url segment of a JWT as text.
function b64text(s: string): string throws Error {
  const bytes = try decode(s)
  return try new TextDecoder().decode(bytes)
}

// ---- endpoints ----

// The protected resource metadata (RFC 9728): /mcp and the server it names.
export function resourceMetadata(iss: Issuer): string {
  return JSON.stringify({ resource: iss.resource, authorization_servers: [iss.issuer], scopes_supported: ["mcp"], bearer_methods_supported: ["header"] })
}

// The authorization server metadata (RFC 8414).
export function authServerMetadata(iss: Issuer): string {
  return JSON.stringify({
    issuer: iss.issuer,
    authorization_endpoint: iss.issuer + "/oauth2/authorize",
    token_endpoint: iss.issuer + "/oauth2/token",
    registration_endpoint: iss.issuer + "/oauth2/register",
    jwks_uri: iss.issuer + "/.well-known/jwks.json",
    response_types_supported: ["code"],
    grant_types_supported: ["authorization_code", "refresh_token"],
    code_challenge_methods_supported: ["S256"],
    token_endpoint_auth_methods_supported: ["none"],
    scopes_supported: ["mcp"],
    authorization_response_iss_parameter_supported: true,
  })
}

// POST /oauth2/register (RFC 7591): a public client with its redirect URIs, answered with its client_id. addr is the
// client's address ("" when unknown; server.trusted_proxies decide whether a forwarding header counts): an address past
// its registrations of the minute, or holding too many unused clients, is answered 429 with Retry-After. The client is
// appended to the registry (one line, under the lock), and the oldest unused clients past max_unused_clients dropped.
export function register(body: string, iss: Issuer, nowMs: f64, addr?: string): Answer {
  const fs = objectOf(body)
  if (fs === undefined) return oauthErr(400, "invalid_request", "malformed request body")
  let uris: string[] = []
  let grants: string[] = []
  let responses: string[] = []
  try {
    uris = try strsOf(find(fs, "redirect_uris"))
    grants = try strsOf(find(fs, "grant_types"))
    responses = try strsOf(find(fs, "response_types"))
  } catch (e) {
    return oauthErr(400, "invalid_request", "malformed request body")
  }
  const name = rawStr(fs, "client_name") ?? ""
  const scope = rawStr(fs, "scope") ?? ""
  const method = rawStr(fs, "token_endpoint_auth_method") ?? ""
  if (uris.length === 0) return oauthErr(400, "invalid_redirect_uri", "redirect_uris is required")
  if (uris.length > MAX_REDIRECTS) return oauthErr(400, "invalid_redirect_uri", `at most ${MAX_REDIRECTS} redirect_uris are allowed`)
  if (name.byteLength > MAX_CLIENT_NAME) return oauthErr(400, "invalid_client_metadata", `client_name exceeds ${MAX_CLIENT_NAME} bytes`)
  if (scope.byteLength > MAX_SCOPE) return oauthErr(400, "invalid_client_metadata", `scope exceeds ${MAX_SCOPE} bytes`)
  for (const u of uris) {
    if (!redirectAllowed(u, iss.allowed)) return oauthErr(400, "invalid_redirect_uri", "redirect_uri must be a valid local callback or an administrator-approved remote callback")
  }
  if (method !== "" && method !== "none") return oauthErr(400, "invalid_client_metadata", "only token_endpoint_auth_method=none is supported")
  const gs: string[] = grants.length === 0 ? ["authorization_code"] : grants
  for (const g of gs) {
    if (g !== "authorization_code" && g !== "refresh_token") return oauthErr(400, "invalid_client_metadata", "unsupported grant_type")
  }
  const rs: string[] = responses.length === 0 ? ["code"] : responses
  for (const r of rs) {
    if (r !== "code") return oauthErr(400, "invalid_client_metadata", "unsupported response_type")
  }
  const granted = scope === "" ? "mcp" : scope
  const lim = iss.limits
  const ah = addressHash(addr ?? "")
  // this process's count first: a flood from one address is refused here, before any file is touched
  const early = minuteWait(ah, lim.perMinute, nowMs, false)
  if (early > 0) return slowDown(early, "too many client registrations from this address; try again later")
  const lock: FileLock = stateFile === "" ? { path: "", ok: true } : lockFile(stateFile)
  if (!lock.ok) return oauthErr(503, "temporarily_unavailable", "the client registry is busy; try again")
  // the clients the other workers registered, then the limits over all of them
  readRegistry(true, nowMs)
  trimClients(lim, nowMs)
  if (ah !== "") {
    const held = heldClients(nowMs)
    let recent = 0
    let oldestRecent = nowMs
    let unused = 0
    let oldestUnused = nowMs
    for (const cl of CLIENTS.values()) {
      if ((cl.ah ?? "") !== ah) continue
      if (nowMs - cl.created_at < 60000.0) {
        recent += 1
        if (cl.created_at < oldestRecent) oldestRecent = cl.created_at
      }
      if (!held.has(cl.client_id)) {
        unused += 1
        if (cl.created_at < oldestUnused) oldestUnused = cl.created_at
      }
    }
    if (lim.perMinute > 0 && recent >= lim.perMinute) {
      unlockFile(lock)
      return slowDown(Math.max(1, Math.ceil((oldestRecent + 60000.0 - nowMs) / 1000.0)), "too many client registrations from this address; try again later")
    }
    if (lim.perAddress > 0 && unused >= lim.perAddress) {
      unlockFile(lock)
      return slowDown(Math.max(1, Math.ceil((oldestUnused + lim.unusedTtlMs - nowMs) / 1000.0)), "too many unused clients registered from this address; finish or abandon a sign-in first")
    }
  }
  let id = ""
  try {
    id = try secureHex(16)
  } catch (e) {
    unlockFile(lock)
    return oauthErr(500, "server_error", "failed to register client")
  }
  let row: OAuthClientRow = { client_id: id, client_name: name, redirect_uris: uris, grant_types: gs, scope: granted, created_at: nowMs }
  if (ah !== "") row.ah = ah
  try {
    appendRegistry(row)
  } catch (e) {
    unlockFile(lock)
    console.error(`raiju: mcp oauth: could not write ${registryFile}: ${e.message}`)
    return oauthErr(500, "server_error", "failed to register client")
  }
  minuteWait(ah, lim.perMinute, nowMs, true)
  CLIENTS.set(id, row)
  const live = trimClients(lim, nowMs)
  // the registry is rewritten once it holds twice the live clients (plus slack), so its size stays bounded
  if (registryFile !== "" && registryLines > 2 * live + 64) rewriteRegistry()
  unlockFile(lock)
  return {
    status: 201,
    body: JSON.stringify({ client_id: id, client_id_issued_at: Math.floor(nowMs / 1000.0), grant_types: gs, response_types: rs, redirect_uris: uris, token_endpoint_auth_method: "none", scope: granted }),
    contentType: "application/json",
  }
}

// GET /oauth2/authorize: checks the request, seals it into the consent link's token, and answers with the consent
// page's address. A problem the client can act on is sent to its redirect URI; a bad client or redirect URI is answered
// here.
export function authorize(q: URLSearchParams, iss: Issuer, nowMs: f64): Answer {
  const clientId = q.get("client_id") ?? ""
  const redirect = q.get("redirect_uri") ?? ""
  const state = q.get("state") ?? ""
  const scope = q.get("scope") ?? ""
  const challenge = q.get("code_challenge") ?? ""
  if (state.byteLength > MAX_STATE || scope.byteLength > MAX_SCOPE || challenge.byteLength > MAX_CHALLENGE) {
    return oauthErr(400, "invalid_request", "state, scope or code_challenge exceeds the maximum length")
  }
  const client = clientById(clientId, nowMs)
  if (client === undefined) return oauthErr(400, "invalid_client", "unknown client_id")
  if (!redirectAllowed(redirect, iss.allowed) || !registeredRedirect(client, redirect)) {
    return oauthErr(400, "invalid_redirect_uri", "redirect_uri not registered for this client")
  }
  const refuse = (code: string, desc: string): Answer => {
    return { status: 302, body: "", contentType: "text/plain; charset=utf-8", location: withParams(redirect, [["error", code], ["error_description", desc], ["state", state]]) }
  }
  const registered = client.scope === "" ? "mcp" : client.scope
  let want = scope
  if (want === "") {
    want = registered
  } else if (!scopeWithin(want, registered)) {
    return refuse("invalid_scope", "requested scope exceeds the scope registered for this client")
  }
  if ((q.get("response_type") ?? "") !== "code") return refuse("unsupported_response_type", "only response_type=code is supported")
  if ((q.get("code_challenge_method") ?? "") !== "S256") return refuse("invalid_request", "code_challenge_method must be S256")
  if (challenge === "") return refuse("invalid_request", "code_challenge is required")
  const resource = q.get("resource") ?? ""
  if (resource !== "" && resource !== iss.resource) return refuse("invalid_target", "resource does not identify this MCP server")
  const expires = nowMs + iss.codeTtl * 1000.0
  let id = ""
  let tok = ""
  try {
    id = try secureHex(16)
    // nothing is stored: the request rides in the link's token, sealed, so the page works on any worker and after a restart
    tok = try sealFlow(iss.flowKey, { i: id, c: client.client_id, r: redirect, s: state, sc: want, rs: iss.resource, ch: challenge, e: expires })
  } catch (e) {
    return refuse("server_error", "failed to create authorization request")
  }
  return { status: 302, body: "", contentType: "text/plain; charset=utf-8", location: iss.issuer + "/oauth/consent?flow=" + id + "#t=" + tok }
}

// The client a request names: from memory, else from the registry or the state file when another worker wrote it since.
function clientById(id: string, nowMs: f64): OAuthClientRow | undefined {
  if (id === "") return undefined
  const have = CLIENTS.get(id)
  if (have !== undefined) return have
  readRegistry(false, nowMs)
  syncGrants(false)
  return CLIENTS.get(id)
}

// The identity modes a consent page offers (Bifrost's availableModes). "vk" is offered unless disable_vk_identity is
// set while user mode is available (so a flow always keeps a usable mode). "session" is offered to a signed-in
// dashboard user while auth is not enforced for inference: that grant carries no key. "user" is offered while the
// gateway's OIDC sign-in is on: the grant names the signed-in identity-provider user.
export function consentModes(signedIn: bool, enforce: bool, userAvailable?: bool, disableVk?: bool): string[] {
  const users = userAvailable ?? false
  const modes: string[] = []
  if (!(users && (disableVk ?? false))) modes.push("vk")
  if (signedIn && !enforce) modes.push("session")
  if (users) modes.push("user")
  return modes
}

// GET /api/oauth2/consent/flows/{id}: what the consent page shows for a pending request. loggedIn names the signed-in
// identity-provider user ("" when none), so the page can offer to continue as that user.
export function consentDetail(id: string, token: string, iss: Issuer, nowMs: f64, modes: string[], loggedIn?: string, loggedInName?: string): Answer {
  const r = consentRequest(id, token, iss, nowMs, false)
  if (r === undefined) return apiErr(401, "this consent link is invalid or has expired")
  const client = clientById(r.client_id, nowMs)
  const name = client === undefined ? "" : client.client_name
  const user = loggedIn ?? ""
  if (user !== "") {
    const display = loggedInName ?? ""
    const who = display === "" ? `{"id":${JSON.stringify(user)}}` : `{"id":${JSON.stringify(user)},"name":${JSON.stringify(display)}}`
    const head = JSON.stringify({ redirect_uri: r.redirect_uri, client_name: name, available_modes: modes })
    return okJson(head.slice(0, head.byteLength - 1) + `,"logged_in_user":${who},"expires_at":${JSON.stringify(rfc3339(r.expires_at / 1000.0))}}`)
  }
  return okJson(JSON.stringify({ redirect_uri: r.redirect_uri, client_name: name, available_modes: modes, expires_at: rfc3339(r.expires_at / 1000.0) }))
}

// PUT /api/oauth2/consent/flows/{id}: approves the request, mints the one-time code and answers the redirect URL
// with it. In mode "vk" the key is the one the token will name; in mode "session" (a signed-in dashboard user) the
// token names a new random session id instead; in mode "user" it names the signed-in identity-provider user (user).
// A key that belongs to a user (its user_id) grants user mode for that user while user mode is available, and then
// only to that user signed in (Bifrost's VK user upgrade).
export function consentSubmit(id: string, token: string, body: string, iss: Issuer, nowMs: f64, lookup: (value: string) => VirtualKeyConfig | undefined, modes: string[], signedIn: bool, user?: string, userAvailable?: bool): Answer {
  // read through: a consent another worker recorded a moment ago is seen
  const r = consentRequest(id, token, iss, nowMs, true)
  if (r === undefined) return apiErr(401, "this consent link is invalid or has expired")
  const fs = objectOf(body)
  if (fs === undefined) return apiErr(400, "invalid request body")
  const mode = rawStr(fs, "mode") ?? ""
  // a session grant names the signed-in user, so it needs the dashboard sign-in on this request
  if (mode === "session" && !signedIn) return apiErr(401, "session mode requires an authenticated consenting user: sign in to the dashboard first, or authorize with a virtual key")
  if (!modes.includes(mode)) return apiErr(400, `mode "${mode}" is not available`)
  const signedUser = user ?? ""
  let sub = ""
  let granted = mode
  if (mode === "session") {
    try {
      sub = try secureHex(32)
    } catch (e) {
      return apiErr(500, "failed to generate session token")
    }
  } else if (mode === "user") {
    if (signedUser === "") return apiErr(400, "no active session; please sign in first")
    sub = signedUser
  } else if (mode === "vk") {
    const value = (rawStr(fs, "value") ?? "").trim()
    if (value === "") return apiErr(400, "virtual key value is required")
    const vk = lookup(value)
    if (vk === undefined) return apiErr(400, "virtual key not found")
    if (vk.value !== value) return apiErr(400, "this virtual key value has been rotated; use the key's current value")
    if (!keyUsable(vk, nowMs)) return apiErr(400, "virtual key is inactive or expired")
    sub = vk.id
    const owner = vk.user_id ?? ""
    if (owner !== "" && (userAvailable ?? false)) {
      // a user's key: holding it is not proof of being that user while the user can sign in
      if (signedUser === "") return apiErr(400, "this key belongs to a specific user; please sign in to continue")
      if (signedUser !== owner) return apiErr(400, "this key belongs to a different user than the currently signed-in user")
      granted = "user"
      sub = owner
    }
  } else {
    return apiErr(400, `unknown mode "${mode}"`)
  }
  let code = ""
  try {
    code = try secureHex(32)
  } catch (e) {
    return apiErr(500, "failed to generate authorization code")
  }
  const hash = toHex(sha256(utf8(code)))
  // requests past their time are dropped from memory (the state file keeps only live ones)
  for (const k of REQUESTS.keys()) {
    if (REQUESTS.get(k)!.expires_at <= nowMs) REQUESTS.delete(k)
  }
  // the link ends with the pending state: once this is recorded, the page cannot be submitted twice, on any worker
  REQUESTS.set(id, { id: r.id, client_id: r.client_id, redirect_uri: r.redirect_uri, state: r.state, scope: r.scope, resource: r.resource, challenge: r.challenge, expires_at: r.expires_at, status: "consented", mode: granted, sub: sub, code_hash: hash, consented_at: nowMs })
  persistGrants()
  const url = withParams(r.redirect_uri, [["code", code], ["state", r.state], ["iss", iss.issuer]])
  return { status: 200, body: JSON.stringify({ redirect_url: url }), contentType: "application/json" }
}

// The identity checks of a refresh (Bifrost's bf_sub liveness): vkCut refuses vk-mode grants (disable_vk_identity
// while user mode is available), and userActive tells whether a user-mode grant's user may still refresh.
export type RefreshChecks = { vkCut: bool, userActive: (sub: string) => bool }

function noChecks(): RefreshChecks {
  return { vkCut: false, userActive: (sub: string): bool => true }
}

// POST /oauth2/token: the authorization_code grant (PKCE, bound to the request's client, redirect URI and
// resource) and the refresh_token grant (rotation, with family revocation on reuse).
export function tokenEndpoint(form: URLSearchParams, iss: Issuer, nowMs: f64, byId: (id: string) => VirtualKeyConfig | undefined, checks?: RefreshChecks): Answer {
  const grant = form.get("grant_type") ?? ""
  try {
    if (grant === "authorization_code") return codeGrant(form, iss, nowMs, byId)
    if (grant === "refresh_token") return refreshGrant(form, iss, nowMs, byId, checks ?? noChecks())
  } catch (e) {
    return oauthErr(500, "server_error", "failed to issue token")
  }
  return oauthErr(400, "unsupported_grant_type", `grant_type ${grant} not supported`)
}

function codeGrant(form: URLSearchParams, iss: Issuer, nowMs: f64, byId: (id: string) => VirtualKeyConfig | undefined): Answer throws Error {
  const code = form.get("code") ?? ""
  const verifier = form.get("code_verifier") ?? ""
  const clientId = form.get("client_id") ?? ""
  if (code === "" || verifier === "" || clientId === "") return oauthErr(400, "invalid_request", "code, code_verifier and client_id are required")
  const hash = toHex(sha256(utf8(code)))
  let r = requestByCode(hash)
  if (r === undefined) {
    // another worker may have consented it since this one last read the state file (an unknown code reads nothing
    // while the file is unchanged)
    syncGrants(false)
    r = requestByCode(hash)
  }
  if (r !== undefined && r.status === "consented") {
    // a code another worker spent a moment ago is seen spent: the route holds the lock, so no two spend it
    syncGrants(true)
    r = requestByCode(hash)
  }
  if (r === undefined || r.status !== "consented") return oauthErr(400, "invalid_grant", "authorization code not found or already used")
  if (nowMs >= r.expires_at) return oauthErr(400, "invalid_grant", "authorization code expired")
  if (r.client_id !== clientId) return oauthErr(400, "invalid_grant", "client_id mismatch")
  if (r.redirect_uri !== (form.get("redirect_uri") ?? "")) return oauthErr(400, "invalid_grant", "redirect_uri mismatch")
  const resource = form.get("resource") ?? ""
  if (resource !== "" && resource !== r.resource) return oauthErr(400, "invalid_grant", "resource mismatch")
  if (verifier.byteLength < 43 || verifier.byteLength > 128 || pkceChallenge(verifier) !== r.challenge) return oauthErr(400, "invalid_grant", "PKCE verification failed")
  if (r.mode === "vk" && !keyUsable(byId(r.sub), nowMs)) return oauthErr(400, "invalid_grant", "virtual key is no longer active")
  if (r.mode === "vk" && rotatedSince(byId(r.sub), r.consented_at ?? 0.0)) return oauthErr(400, "invalid_grant", "virtual key was rotated after the consent")
  // single use: the code is spent before the tokens leave
  REQUESTS.set(r.id, { id: r.id, client_id: r.client_id, redirect_uri: r.redirect_uri, state: r.state, scope: r.scope, resource: r.resource, challenge: r.challenge, expires_at: r.expires_at, status: "used", mode: r.mode, sub: r.sub, code_hash: hash })
  const family = try secureHex(16)
  return try issuePair(iss, family, clientId, r.mode, r.sub, r.scope, r.resource, nowMs, nowMs, 0.0)
}

// The request a code's hash names, or undefined.
function requestByCode(hash: string): AuthRequest | undefined {
  for (const r of REQUESTS.values()) {
    if (r.code_hash === hash) return r
  }
  return undefined
}

function refreshGrant(form: URLSearchParams, iss: Issuer, nowMs: f64, byId: (id: string) => VirtualKeyConfig | undefined, checks: RefreshChecks): Answer throws Error {
  const rt = form.get("refresh_token") ?? ""
  const clientId = form.get("client_id") ?? ""
  if (rt === "" || clientId === "") return oauthErr(400, "invalid_request", "refresh_token and client_id are required")
  const hash = toHex(sha256(utf8(rt)))
  // another worker may have issued or rotated this grant since this one last read the state file: a known token is
  // read through, an unknown one only when the file changed
  syncGrants(REFRESH.has(hash))
  const row = REFRESH.get(hash)
  if (row === undefined) return oauthErr(400, "invalid_grant", "refresh token not found or revoked")
  if (row.revoked) {
    revokeFamily(row.family)
    return oauthErr(400, "invalid_grant", "refresh token not found or revoked")
  }
  if (row.client_id !== clientId) return oauthErr(400, "invalid_grant", "client_id mismatch")
  if (row.mode === "vk" && checks.vkCut) return oauthErr(400, "invalid_grant", "virtual-key identity is no longer accepted; re-authenticate")
  if (row.mode === "vk" && !keyUsable(byId(row.sub), nowMs)) return oauthErr(400, "invalid_grant", "virtual key is no longer active")
  // a grant from before the key's rotation is void on every worker and node, even one that missed the revoke
  if (row.mode === "vk" && rotatedSince(byId(row.sub), row.created_at)) {
    revokeFamily(row.family)
    return oauthErr(400, "invalid_grant", "refresh token not found or revoked")
  }
  if (row.mode === "user" && !checks.userActive(row.sub)) return oauthErr(400, "invalid_grant", "user is no longer active")
  const resource = form.get("resource") ?? ""
  if (resource !== "" && resource !== row.resource) return oauthErr(400, "invalid_grant", "resource mismatch")
  REFRESH.set(hash, { hash: row.hash, family: row.family, client_id: row.client_id, mode: row.mode, sub: row.sub, scope: row.scope, resource: row.resource, created_at: row.created_at, used_at: row.used_at, revoked: true })
  return try issuePair(iss, row.family, clientId, row.mode, row.sub, row.scope, row.resource, row.created_at, nowMs, nowMs)
}

// Mints an access token and a refresh token for one grant, and records the refresh token (written to the state
// file before the tokens leave, so a restart after this answer keeps the grant).
function issuePair(iss: Issuer, family: string, clientId: string, mode: string, sub: string, scope: string, resource: string, createdAt: f64, nowMs: f64, usedAt: f64): Answer throws Error {
  const refresh = try secureHex(32)
  const hash = toHex(sha256(utf8(refresh)))
  REFRESH.set(hash, { hash: hash, family: family, client_id: clientId, mode: mode, sub: sub, scope: scope, resource: resource, created_at: createdAt, used_at: usedAt, revoked: false })
  persistGrants()
  const access = try accessToken(iss, mode, sub, scope, resource, nowMs)
  return { status: 200, body: JSON.stringify({ access_token: access, token_type: "Bearer", expires_in: iss.accessTtl, refresh_token: refresh, scope: scope }), contentType: "application/json" }
}

// An RS256 JWT: iss, aud (the resource), sub (the virtual key's id, the session id or the user), bf_mode (vk, session or user),
// scope, iat, nbf, exp.
function accessToken(iss: Issuer, mode: string, sub: string, scope: string, resource: string, nowMs: f64): string throws SyntaxError {
  const now = Math.floor(nowMs / 1000.0)
  const header = encodeUrl(utf8(JSON.stringify({ alg: "RS256", typ: "JWT", kid: iss.kid })))
  const claims = JSON.stringify({ iss: iss.issuer, aud: resource, sub: sub, bf_mode: mode, scope: scope, iat: now, nbf: now, exp: now + iss.accessTtl })
  const input = header + "." + encodeUrl(utf8(claims))
  const sig = try signRs256(iss.pem, input)
  return input + "." + sig
}

// Marks every refresh token of a family revoked, and writes the change to the state file.
function revokeFamily(family: string): void {
  for (const k of REFRESH.keys()) {
    const x = REFRESH.get(k)
    if (x !== undefined && x.family === family && !x.revoked) REFRESH.set(k, { hash: x.hash, family: x.family, client_id: x.client_id, mode: x.mode, sub: x.sub, scope: x.scope, resource: x.resource, created_at: x.created_at, used_at: x.used_at, revoked: true })
  }
  persistGrants()
}

// The pending request a consent link's token carries, bound to its flow id, or undefined: a token that was not sealed
// with this issuer's key, names another flow or has expired, or a flow already consented here, on another worker or
// before a restart (the state file records it). force reads the state file whatever its stamp (before a consent is
// recorded).
function consentRequest(id: string, token: string, iss: Issuer, nowMs: f64, force: bool): AuthRequest | undefined {
  if (token === "" || id === "") return undefined
  const f = openFlow(iss.flowKey, token)
  if (f === undefined || f.i !== id || nowMs >= f.e) return undefined
  if (force || !REQUESTS.has(id)) syncGrants(force)
  // the link ends with the pending state (Bifrost deletes its token at consent): a used link is refused as unknown
  if (REQUESTS.has(id)) return undefined
  return { id: f.i, client_id: f.c, redirect_uri: f.r, state: f.s, scope: f.sc, resource: f.rs, challenge: f.ch, expires_at: f.e, status: "pending", mode: "", sub: "", code_hash: "" }
}

// ---- the grants: GET and DELETE /api/oauth2/sessions ----

// A live grant as the sessions list shows it (Bifrost's OAuth2SessionRow). Its id is the SHA-256 of the grant's
// current refresh token, which the list never shows.
type GrantRow = { id: string, client_id: string, client_name: string, bf_mode: string, bf_sub: string, bf_sub_display: string, scope: string, created_at: string, last_used_at?: string }

const GRANT_MODES = ["user", "vk", "session"]

// The comma-separated values of a query parameter, without the empty ones.
function listOf(raw: string): string[] {
  const out: string[] = []
  for (const part of raw.split(",")) {
    const v = part.trim()
    if (v !== "") out.push(v)
  }
  return out
}

// GET /api/oauth2/sessions: the live grants (refresh rows not revoked), newest first. q matches the client's name or
// id and the bound identity, bf_mode, virtual_key_id and user_id are comma lists, and limit (default 50, at most
// 500) and offset page the result. nameOf gives a virtual key's name, the display of a vk grant.
export function grantsList(query: URLSearchParams, nameOf: (vkId: string) => string): Answer {
  const search = (query.get("q") ?? "").trim().toLowerCase()
  const modes = listOf(query.get("bf_mode") ?? "")
  for (const m of modes) {
    if (!GRANT_MODES.includes(m)) return apiErr(400, "Invalid bf_mode parameter: must be one or more of user, vk, session")
  }
  const vkIds = listOf(query.get("virtual_key_id") ?? "")
  const userIds = listOf(query.get("user_id") ?? "")
  let limit = SESSIONS_DEFAULT_LIMIT
  const ls = query.get("limit") ?? ""
  if (ls !== "") {
    const n = parseInt(ls)
    if (n === undefined) return apiErr(400, "Invalid limit parameter: must be a number")
    if (n <= 0) return apiErr(400, "Invalid limit parameter: must be greater than zero")
    limit = n > SESSIONS_MAX_LIMIT ? SESSIONS_MAX_LIMIT : n
  }
  let offset = 0
  const os = query.get("offset") ?? ""
  if (os !== "") {
    const n = parseInt(os)
    if (n === undefined) return apiErr(400, "Invalid offset parameter: must be a number")
    if (n < 0) return apiErr(400, "Invalid offset parameter: must be non-negative")
    offset = n
  }
  syncGrants(true)
  const live: RefreshRow[] = []
  for (const r of REFRESH.values()) {
    if (!r.revoked) live.push(r)
  }
  live.sort((a, b) => b.created_at - a.created_at)
  const rows: GrantRow[] = []
  for (const r of live) {
    const cl = CLIENTS.get(r.client_id)
    const name = cl === undefined ? "" : cl.client_name
    if (modes.length > 0 && !modes.includes(r.mode)) continue
    if (vkIds.length > 0 && !(r.mode === "vk" && vkIds.includes(r.sub))) continue
    if (userIds.length > 0 && !(r.mode === "user" && userIds.includes(r.sub))) continue
    if (search !== "" && !(name.toLowerCase().includes(search) || r.client_id.includes(search) || r.sub.toLowerCase().includes(search))) continue
    let row: GrantRow = { id: r.hash, client_id: r.client_id, client_name: name, bf_mode: r.mode, bf_sub: r.sub, bf_sub_display: r.mode === "vk" ? nameOf(r.sub) : "", scope: r.scope, created_at: rfc3339(r.created_at / 1000.0) }
    if (r.used_at > 0) row.last_used_at = rfc3339(r.used_at / 1000.0)
    rows.push(row)
  }
  const page = rows.slice(offset, offset + limit)
  return okJson(JSON.stringify({ sessions: page, count: page.length, total_count: rows.length, limit: limit, offset: offset }))
}

// DELETE /api/oauth2/sessions/{id}: revokes the grant of a live refresh row, so its client can no longer refresh it.
// Access tokens already issued last until they expire, as in Bifrost.
export function grantRevoke(id: string): Answer {
  syncGrants(true)
  const r = REFRESH.get(id)
  if (r === undefined || r.revoked) return apiErr(404, "session not found or already revoked")
  revokeFamily(r.family)
  return { status: 204, body: "", contentType: "application/json" }
}

// Whether the key was rotated after the moment given (epoch ms): what was minted from its old value is void.
function rotatedSince(vk: VirtualKeyConfig | undefined, sinceMs: f64): bool {
  if (vk === undefined) return false
  const at = rfc3339Ms(vk.rotated_at ?? "")
  return at !== undefined && at > sinceMs
}

// Revokes everything minted for one identity (Bifrost's RevokeOAuth2GrantsBySubject): its live refresh tokens, and
// the consented requests whose codes are not exchanged yet, so none of them can mint a token later. A virtual key's
// rotation calls this for the key (mode "vk"), since a grant is bound to the key's id, not to its value. Access
// tokens already issued last until they expire, as in Bifrost. Returns how many grants and codes were revoked.
export function revokeSubject(mode: string, sub: string): int {
  syncGrants(true)
  let n = 0
  for (const k of REFRESH.keys()) {
    const x = REFRESH.get(k)
    if (x === undefined || x.revoked || x.mode !== mode || x.sub !== sub) continue
    REFRESH.set(k, { hash: x.hash, family: x.family, client_id: x.client_id, mode: x.mode, sub: x.sub, scope: x.scope, resource: x.resource, created_at: x.created_at, used_at: x.used_at, revoked: true })
    n += 1
  }
  for (const id of REQUESTS.keys()) {
    const r = REQUESTS.get(id)
    if (r === undefined || r.status !== "consented" || r.mode !== mode || r.sub !== sub) continue
    REQUESTS.set(id, { id: r.id, client_id: r.client_id, redirect_uri: r.redirect_uri, state: r.state, scope: r.scope, resource: r.resource, challenge: r.challenge, expires_at: r.expires_at, status: "revoked", mode: r.mode, sub: r.sub, code_hash: r.code_hash })
    n += 1
  }
  if (n > 0) persistGrants()
  return n
}

// ---- helpers ----

// Whether a redirect URI may be used at all (Bifrost's oauth2RedirectAllowed). The scheme must be on the allowlist
// first: https; http for a loopback host; or a private-use scheme with an authority (cursor://...). Then the URI
// is accepted when it is a loopback callback, the cursor client's callback, an exact entry of
// allowed_redirect_uris, or any https callback when "*" is among them.
export function redirectAllowed(uri: string, allowed: string[]): bool {
  if (uri === "" || uri.byteLength > MAX_REDIRECT) return false
  const u = URL.parse(uri)
  if (u === undefined || !schemeAllowed(uri, u)) return false
  if ((u.protocol === "http:" || u.protocol === "https:") && loopbackHost(u.hostname)) return true
  if (u.protocol === "cursor:" && u.host === "anysphere.cursor-mcp") return true
  if (allowed.includes(uri)) return true
  return u.protocol === "https:" && allowed.includes("*")
}

// The default-deny scheme check of a redirect URI: a host is required, no userinfo, no fragment and no backslash.
function schemeAllowed(uri: string, u: URL): bool {
  if (u.hostname === "" || uri.includes("#") || uri.includes("\\") || hasUserinfo(uri)) return false
  if (u.protocol === "https:") return true
  if (u.protocol === "http:") return loopbackHost(u.hostname)
  // private-use schemes need an authority (scheme://host/...), so an opaque form is refused
  return u.protocol === "cursor:" && u.host !== ""
}

// Whether a request's redirect URI is one the client registered. A loopback callback matches on any port (RFC 8252, section 7.3).
function registeredRedirect(c: OAuthClientRow, uri: string): bool {
  if (c.redirect_uris.includes(uri)) return true
  const u = URL.parse(uri)
  if (u === undefined || !(u.protocol === "http:" || u.protocol === "https:") || !loopbackHost(u.hostname)) return false
  for (const r of c.redirect_uris) {
    const v = URL.parse(r)
    if (v === undefined) continue
    if (v.protocol === u.protocol && v.hostname === u.hostname && v.pathname === u.pathname) return true
  }
  return false
}

// localhost, the IPv6 loopback, or an IPv4 address in 127.0.0.0/8 (Bifrost's isLoopbackRedirectHost).
function loopbackHost(host: string): bool {
  if (host === "localhost" || host === "[::1]" || host === "::1") return true
  const parts = host.split(".")
  if (parts.length !== 4 || parts[0] !== "127") return false
  for (const p of parts) {
    const v = parseInt(p)
    if (v === undefined || v < 0 || v > 255) return false
  }
  return true
}

// Whether a URI has userinfo (user:password@ before the host). An "@" later on, in a path or query, does not count.
function hasUserinfo(uri: string): bool {
  const at = uri.indexOf("://")
  if (at < 0) return false
  let rest = uri.slice(at + 3)
  for (const stop of ["/", "?"]) {
    const i = rest.indexOf(stop)
    if (i >= 0) rest = rest.slice(0, i)
  }
  return rest.includes("@")
}

// Whether every scope a request asks for is one the client registered.
function scopeWithin(requested: string, registered: string): bool {
  const have = registered.split(" ")
  for (const s of requested.split(" ")) {
    if (s !== "" && !have.includes(s)) return false
  }
  return true
}

// The URL with these parameters added to its query (set, not appended to the same name).
function withParams(base: string, pairs: string[][]): string {
  const sp = new URLSearchParams("")
  for (const p of pairs) sp.set(p[0]!, p[1]!)
  const q = sp.toString()
  return base + (base.includes("?") ? "&" : "?") + q
}

// A JSON object from a request body, or undefined when it is not one.
function objectOf(text: string): Field[] | undefined {
  try {
    const fs = try fields(text)
    return fs
  } catch (e) {
    return undefined
  }
}

// The strings of a JSON array field, or none when the field is absent.
function strsOf(raw: string | undefined): string[] throws SyntaxError {
  const out: string[] = []
  if (raw === undefined || isNull(raw)) return out
  for (const e of try elements(raw)) out.push(try decodeString(e))
  return out
}

function trimSlash(s: string): string {
  let t = s.trim()
  while (t.endsWith("/")) t = t.slice(0, t.byteLength - 1)
  return t
}

function oauthErr(status: int, code: string, desc: string): Answer {
  return { status: status, body: JSON.stringify({ error: code, error_description: desc }), contentType: "application/json" }
}

function apiErr(status: int, message: string): Answer {
  return { status: status, body: errorJson(message, "invalid_request_error", undefined), contentType: "application/json" }
}

function page(html: string): Answer {
  return { status: 200, body: html, contentType: "text/html; charset=utf-8" }
}

function okJson(body: string): Answer {
  return { status: 200, body: body, contentType: "application/json" }
}

// The HTTP response of an answer: no-store on every one, and the page headers on HTML.
function respond(a: Answer): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", a.contentType)
  h.set("cache-control", "no-store")
  if (a.contentType.startsWith("text/html")) {
    h.set("content-security-policy", "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
    h.set("referrer-policy", "no-referrer")
  }
  const loc = a.location
  if (loc !== undefined) h.set("location", loc)
  const ch = a.challenge
  if (ch !== undefined) h.set("www-authenticate", ch)
  const ra = a.retryAfter
  if (ra !== undefined) h.set("retry-after", `${ra}`)
  return new Response(a.status === 302 ? undefined : a.body, { status: a.status, headers: h })
}

// Whether vk-mode grants are cut off: disable_vk_identity, only while user mode is available (so vk is never cut
// where it is still the offered path).
export function vkIdentityCut(c: Config, userAvailable: bool): bool {
  return userAvailable && c.client?.oauth2_server_config?.disable_vk_identity === true
}

// The routes of the authorization server and its pages, or undefined for any other path. lookup finds the
// virtual key a value names (the rotation cooldown included); byId finds a key by its id. cc says who is consenting
// (the dashboard sign-in, the identity-provider user, whether inference auth is enforced): it decides the identity
// modes the consent page offers.
export async function issuerRoute(c: Config, req: Request, path: string, lookup: (value: string) => VirtualKeyConfig | undefined, byId: (id: string) => VirtualKeyConfig | undefined, nowMs: f64, cc: ConsentContext): Promise<Response | undefined> {
  const m = req.method
  if (path === "/workspace/mcp-sessions/auth" && m === "GET") return respond(page(connectPageHtml()))
  const consentPrefix = "/api/oauth2/consent/flows/"
  if (path.startsWith(consentPrefix) && (m === "GET" || m === "PUT")) {
    const id = path.slice(consentPrefix.byteLength)
    const iss = issuerOf(c)
    if (id === "" || id.includes("/")) return undefined
    // the route is always registered, as in Bifrost: it answers 404 while the authorization server is off
    if (iss === undefined) return respond(apiErr(404, "the MCP authorization server is off: set client.mcp_server_auth_mode to both or oauth"))
    const token = req.headers.get("x-bifrost-temp-token") ?? ""
    const modes = consentModes(cc.signedIn, cc.enforce, cc.userAvailable, cc.disableVk)
    if (m === "GET") return respond(consentDetail(id, token, iss, nowMs, modes, cc.user, cc.userName))
    const body = await req.text()
    // a consent writes the state file: under its lock, waited for without pausing the worker
    const lock = await stateLock()
    if (!lock.ok) return respond(apiErr(503, "the MCP authorization state is busy; try again"))
    const done = consentSubmit(id, token, body, iss, Date.now(), lookup, modes, cc.signedIn, cc.user, cc.userAvailable)
    unlockFile(lock)
    return respond(done)
  }
  const wellKnown = path === "/.well-known/oauth-protected-resource" || path.startsWith("/.well-known/oauth-protected-resource/") || path === "/.well-known/oauth-authorization-server" || path.startsWith("/.well-known/oauth-authorization-server/") || path === "/.well-known/jwks.json"
  const oauth = path === "/oauth2/register" || path === "/oauth2/authorize" || path === "/oauth2/token" || path === "/oauth/consent"
  if (!wellKnown && !oauth) return undefined
  if (m !== "GET" && m !== "POST") return undefined
  const iss = issuerOf(c)
  if (iss === undefined) return undefined
  if (path.startsWith("/.well-known/oauth-protected-resource")) return respond(okJson(resourceMetadata(iss)))
  if (path.startsWith("/.well-known/oauth-authorization-server")) return respond(okJson(authServerMetadata(iss)))
  if (path === "/.well-known/jwks.json") {
    try {
      const jwk = try publicJwk(iss.pem, iss.kid)
      return respond(okJson(`{"keys":[${jwk}]}`))
    } catch (e) {
      return respond(oauthErr(500, "server_error", "failed to load signing key"))
    }
  }
  if (path === "/oauth/consent" && m === "GET") return respond(page(consentPageHtml()))
  if (path === "/oauth2/register" && m === "POST") {
    const body = await req.text()
    const addr = req.headers.get(CLIENT_IP_HEADER) ?? ""
    // an address past its registrations of the minute is refused before the lock is waited for
    const early = minuteWait(addressHash(addr), iss.limits.perMinute, Date.now(), false)
    if (early > 0) return respond(slowDown(early, "too many client registrations from this address; try again later"))
    const lock = await stateLock()
    if (!lock.ok) return respond(oauthErr(503, "temporarily_unavailable", "the client registry is busy; try again"))
    const reg = register(body, iss, Date.now(), addr)
    unlockFile(lock)
    return respond(reg)
  }
  if (path === "/oauth2/authorize" && m === "GET") {
    const u = URL.parse(req.url)
    return respond(authorize(u === undefined ? new URLSearchParams("") : u.searchParams, iss, Date.now()))
  }
  if (path === "/oauth2/token" && m === "POST") {
    const form = new URLSearchParams(await req.text())
    // a code is spent and a refresh token rotated under the state file's lock, so no two workers spend one twice
    const lock = await stateLock()
    if (!lock.ok) return respond(oauthErr(503, "temporarily_unavailable", "the MCP authorization state is busy; try again"))
    const tok = tokenEndpoint(form, iss, Date.now(), byId, { vkCut: cc.userAvailable && cc.disableVk, userActive: cc.userActive })
    unlockFile(lock)
    return respond(tok)
  }
  return undefined
}

// How long a route waits for the state file's lock (a holder writes in milliseconds).
const ROUTE_LOCK_WAIT_MS: f64 = 5000.0

// The state file's lock for a route that writes, waited for while the worker serves other requests (an ok lock that
// guards nothing without a state file). The writes under it take it again without waiting.
async function stateLock(): Promise<FileLock> {
  if (stateFile === "") return { path: "", ok: true }
  return await lockFileAsync(stateFile, ROUTE_LOCK_WAIT_MS)
}

test("a registration needs redirect URIs that are loopback, https or approved, and answers a client_id", () => {
  const iss = testIssuer()
  expect(register("{\"client_name\":\"c\"}", iss, 1000.0).status).toBe(400)
  expect(register("{\"redirect_uris\":[\"http://example.com/cb\"]}", iss, 1000.0).status).toBe(400)
  expect(register("{\"redirect_uris\":[\"javascript:alert(1)\"]}", iss, 1000.0).status).toBe(400)
  const ok = register("{\"client_name\":\"c\",\"redirect_uris\":[\"http://127.0.0.1:8080/cb\"]}", iss, 1000.0)
  expect(ok.status).toBe(201)
  expect(ok.body.includes("\"token_endpoint_auth_method\":\"none\"")).toBe(true)
  expect(register("{\"redirect_uris\":[\"https://app.example/cb\"],\"token_endpoint_auth_method\":\"client_secret_basic\"}", iss, 1000.0).status).toBe(400)
  expect(register("{\"redirect_uris\":[\"https://app.example/cb\"],\"grant_types\":[\"client_credentials\"]}", iss, 1000.0).status).toBe(400)
  expect(register("{\"redirect_uris\":[\"https://app.example/cb\"],\"response_types\":[\"token\"]}", iss, 1000.0).status).toBe(400)
  expect(redirectAllowed("https://app.example/cb", [])).toBe(false)
  expect(redirectAllowed("https://app.example/cb", ["https://app.example/cb"])).toBe(true)
  expect(redirectAllowed("https://app.example/cb", ["*"])).toBe(true)
  expect(redirectAllowed("http://app.example/cb", ["*"])).toBe(false)
  expect(redirectAllowed("http://localhost:9/cb", [])).toBe(true)
})

test("an authorization request is checked, and approved with a key into a code that exchanges once with PKCE", () => {
  const iss = testIssuer()
  const reg = register("{\"client_name\":\"c\",\"redirect_uris\":[\"http://127.0.0.1:8080/cb\"]}", iss, 1000.0)
  const cid = try clientIdOf(reg.body)
  const verifier = "v".repeat(50)
  const challenge = pkceChallenge(verifier)
  const q = (extra: string[][]): URLSearchParams => {
    const sp = new URLSearchParams("")
    sp.set("client_id", cid)
    sp.set("redirect_uri", "http://127.0.0.1:8080/cb")
    sp.set("response_type", "code")
    sp.set("state", "st-1")
    sp.set("code_challenge", challenge)
    sp.set("code_challenge_method", "S256")
    for (const p of extra) sp.set(p[0]!, p[1]!)
    return sp
  }
  expect(authorize(q([["code_challenge_method", "plain"]]), iss, 2000.0).location!.includes("error=invalid_request")).toBe(true)
  expect(authorize(q([["scope", "admin"]]), iss, 2000.0).location!.includes("error=invalid_scope")).toBe(true)
  expect(authorize(q([["resource", "https://elsewhere.example/mcp"]]), iss, 2000.0).location!.includes("error=invalid_target")).toBe(true)
  expect(authorize(q([["redirect_uri", "http://127.0.0.1:8080/other"]]), iss, 2000.0).status).toBe(400)
  const go = authorize(q([]), iss, 2000.0)
  expect(go.status).toBe(302)
  const loc = go.location!
  const hashAt = loc.indexOf("#t=")
  const flow = loc.slice(loc.indexOf("flow=") + 5, loc.indexOf("#t="))
  const tok = loc.slice(hashAt + 3)
  const vkOnly: string[] = ["vk"]
  expect(consentDetail(flow, "wrong", iss, 2500.0, vkOnly).status).toBe(401)
  expect(consentDetail(flow, tok, iss, 2500.0, vkOnly).status).toBe(200)
  const key: VirtualKeyConfig = { id: "vk-x", value: "sk-bf-test-x" }
  const lookup = (v: string): VirtualKeyConfig | undefined => v === "sk-bf-test-x" ? key : undefined
  // no dashboard sign-in on this request, so session mode is refused
  const bad = consentSubmit(flow, tok, "{\"mode\":\"session\",\"value\":\"\"}", iss, 2500.0, lookup, vkOnly, false)
  expect(bad.status).toBe(401)
  const done = consentSubmit(flow, tok, "{\"mode\":\"vk\",\"value\":\"sk-bf-test-x\"}", iss, 2500.0, lookup, vkOnly, false)
  expect(done.status).toBe(200)
  const url = try JSON.parse(done.body) as { redirect_url: string }
  const code = url.redirect_url.slice(url.redirect_url.indexOf("code=") + 5, url.redirect_url.indexOf("&state="))
  expect(consentSubmit(flow, tok, "{\"mode\":\"vk\",\"value\":\"sk-bf-test-x\"}", iss, 2500.0, lookup, vkOnly, false).status).toBe(401)
  const byId = (id: string): VirtualKeyConfig | undefined => id === "vk-x" ? key : undefined
  const badVerifier = tokenEndpoint(new URLSearchParams(`grant_type=authorization_code&code=${code}&code_verifier=${"w".repeat(50)}&client_id=${cid}&redirect_uri=http%3A%2F%2F127.0.0.1%3A8080%2Fcb`), iss, 3000.0, byId)
  expect(badVerifier.body.includes("PKCE verification failed")).toBe(true)
  const form = `grant_type=authorization_code&code=${code}&code_verifier=${verifier}&client_id=${cid}&redirect_uri=http%3A%2F%2F127.0.0.1%3A8080%2Fcb`
  const t = tokenEndpoint(new URLSearchParams(form), iss, 3000.0, byId)
  expect(t.status).toBe(200)
  const access = (try JSON.parse(t.body) as { access_token: string }).access_token
  expect(callerOf(iss, "Bearer " + access, 3000.0)).toEqual({ kind: "vk", vk: "vk-x" })
  expect(tokenEndpoint(new URLSearchParams(form), iss, 3000.0, byId).status).toBe(400)
})

test("a key that is inactive or past its expiry is not usable", () => {
  expect(keyUsable({ id: "a", value: "v", is_active: false }, 1000.0)).toBe(false)
  expect(keyUsable({ id: "a", value: "v", expires_at: "2000-01-01T00:00:00Z" }, 1000000000000.0)).toBe(false)
  expect(keyUsable({ id: "a", value: "v", expires_at: "2100-01-01T00:00:00Z" }, 1000000000000.0)).toBe(true)
  expect(keyUsable({ id: "a", value: "v" }, 1000.0)).toBe(true)
  expect(keyUsable(undefined, 1000.0)).toBe(false)
})

test("a token with another audience, another key or a bad signature is refused", () => {
  const iss = testIssuer()
  expect(callerOf(iss, undefined, 0.0).kind).toBe("none")
  expect(callerOf(iss, "Bearer sk-bf-plain", 0.0).kind).toBe("none")
  expect(callerOf(undefined, "Bearer eyJhbGciOiJSUzI1NiJ9.a.b", 0.0).kind).toBe("none")
  expect(callerOf(iss, "Bearer eyJhbGciOiJSUzI1NiJ9.a.b", 0.0).kind).toBe("error")
})

test("a signed token is accepted for this resource while it lives, and refused for another audience or after expiry", () => {
  const iss = testIssuer()
  const mine = try accessToken(iss, "vk", "vk-x", "mcp", iss.resource, 3000.0)
  expect(callerOf(iss, "Bearer " + mine, 3000.0)).toEqual({ kind: "vk", vk: "vk-x" })
  expect(callerOf(iss, "bearer " + mine, 3000.0)).toEqual({ kind: "vk", vk: "vk-x" })
  expect(callerOf(iss, "Bearer " + mine, 3000.0 + 700000.0).kind).toBe("error")
  const other = try accessToken(iss, "vk", "vk-x", "mcp", "https://other.example/mcp", 3000.0)
  expect(callerOf(iss, "Bearer " + other, 3000.0).kind).toBe("error")
  const forged = mine.slice(0, mine.byteLength - 4) + "AAAA"
  expect(callerOf(iss, "Bearer " + forged, 3000.0).kind).toBe("error")
})

test("a session-mode token names a session, a user-mode token a user, and another mode is refused", () => {
  const iss = testIssuer()
  const sess = try accessToken(iss, "session", "a1b2c3", "mcp", iss.resource, 3000.0)
  const got = callerOf(iss, "Bearer " + sess, 3000.0)
  expect(got.kind).toBe("session")
  if (got.kind === "session") expect(got.sub).toBe("a1b2c3")
  expect(callerOf(iss, "Bearer " + try accessToken(iss, "user", "u-1", "mcp", iss.resource, 3000.0), 3000.0)).toEqual({ kind: "user", sub: "u-1" })
  expect(callerOf(iss, "Bearer " + try accessToken(iss, "admin", "u-1", "mcp", iss.resource, 3000.0), 3000.0).kind).toBe("error")
})

test("consent offers session mode only to a signed-in user while auth is not enforced", () => {
  expect(consentModes(false, false)).toEqual(["vk"])
  expect(consentModes(true, false)).toEqual(["vk", "session"])
  expect(consentModes(true, true)).toEqual(["vk"])
})

test("user mode is offered with the identity provider, and disable_vk_identity drops vk only then", () => {
  expect(consentModes(false, false, true, false)).toEqual(["vk", "user"])
  expect(consentModes(true, false, true, true)).toEqual(["session", "user"])
  expect(consentModes(false, false, false, true)).toEqual(["vk"])
  const on: Config = { client: { oauth2_server_config: { disable_vk_identity: true } } }
  expect(vkIdentityCut(on, true)).toBe(true)
  expect(vkIdentityCut(on, false)).toBe(false)
  expect(vkIdentityCut({}, true)).toBe(false)
})

// Runs the virtual-key consent and token exchange for a new client, and returns its client id, refresh token and
// access token. The key is "k-<client name>" so each test gets its own.
function vkGrant(iss: Issuer, name: string, port: string, nowMs: f64): string[] throws Error {
  const reg = register(`{"client_name":"${name}","redirect_uris":["http://127.0.0.1:${port}/cb"]}`, iss, nowMs)
  const cid = try clientIdOf(reg.body)
  const verifier = "g".repeat(50)
  const sp = new URLSearchParams("")
  sp.set("client_id", cid)
  sp.set("redirect_uri", `http://127.0.0.1:${port}/cb`)
  sp.set("response_type", "code")
  sp.set("state", "st-" + name)
  sp.set("code_challenge", pkceChallenge(verifier))
  sp.set("code_challenge_method", "S256")
  const loc = authorize(sp, iss, nowMs).location!
  const flow = loc.slice(loc.indexOf("flow=") + 5, loc.indexOf("#t="))
  const tok = loc.slice(loc.indexOf("#t=") + 3)
  const keyValue = "sk-bf-" + name
  const key: VirtualKeyConfig = { id: "vk-" + name, value: keyValue }
  const lookup = (v: string): VirtualKeyConfig | undefined => v === keyValue ? key : undefined
  const done = consentSubmit(flow, tok, `{"mode":"vk","value":"${keyValue}"}`, iss, nowMs, lookup, ["vk"], false)
  const url = try JSON.parse(done.body) as { redirect_url: string }
  const code = url.redirect_url.slice(url.redirect_url.indexOf("code=") + 5, url.redirect_url.indexOf("&state="))
  const form = `grant_type=authorization_code&code=${code}&code_verifier=${verifier}&client_id=${cid}&redirect_uri=http%3A%2F%2F127.0.0.1%3A${port}%2Fcb`
  const byId = (id: string): VirtualKeyConfig | undefined => id === "vk-" + name ? key : undefined
  const t = tokenEndpoint(new URLSearchParams(form), iss, nowMs, byId)
  const body = try JSON.parse(t.body) as { access_token: string, refresh_token: string }
  return [cid, body.refresh_token, body.access_token]
}

test("a session grant issues a session token with a random id", () => {
  const iss = testIssuer()
  const reg = register("{\"client_name\":\"sess-client\",\"redirect_uris\":[\"http://127.0.0.1:8081/cb\"]}", iss, 1000.0)
  const cid = try clientIdOf(reg.body)
  const verifier = "s".repeat(50)
  const sp = new URLSearchParams("")
  sp.set("client_id", cid)
  sp.set("redirect_uri", "http://127.0.0.1:8081/cb")
  sp.set("response_type", "code")
  sp.set("state", "st-s")
  sp.set("code_challenge", pkceChallenge(verifier))
  sp.set("code_challenge_method", "S256")
  const loc = authorize(sp, iss, 2000.0).location!
  const flow = loc.slice(loc.indexOf("flow=") + 5, loc.indexOf("#t="))
  const tok = loc.slice(loc.indexOf("#t=") + 3)
  const none = (v: string): VirtualKeyConfig | undefined => undefined
  // without a dashboard sign-in the session mode is refused, and the request stays pending
  expect(consentSubmit(flow, tok, "{\"mode\":\"session\"}", iss, 2500.0, none, consentModes(false, false), false).status).toBe(401)
  const done = consentSubmit(flow, tok, "{\"mode\":\"session\"}", iss, 2500.0, none, consentModes(true, false), true)
  expect(done.status).toBe(200)
  const url = try JSON.parse(done.body) as { redirect_url: string }
  const code = url.redirect_url.slice(url.redirect_url.indexOf("code=") + 5, url.redirect_url.indexOf("&state="))
  const form = `grant_type=authorization_code&code=${code}&code_verifier=${verifier}&client_id=${cid}&redirect_uri=http%3A%2F%2F127.0.0.1%3A8081%2Fcb`
  const t = tokenEndpoint(new URLSearchParams(form), iss, 3000.0, none)
  expect(t.status).toBe(200)
  const access = (try JSON.parse(t.body) as { access_token: string }).access_token
  const got = callerOf(iss, "Bearer " + access, 3000.0)
  expect(got.kind).toBe("session")
  if (got.kind === "session") expect(got.sub.byteLength).toBe(32)
})

test("the grants list shows a live grant, and a revoke ends it", () => {
  const iss = testIssuer()
  const g = try vkGrant(iss, "grant-list-client", "8082", 5000.0)
  const q = new URLSearchParams("q=grant-list-client")
  const names = (id: string): string => id === "vk-grant-list-client" ? "the key" : ""
  const listed = grantsList(q, names)
  expect(listed.status).toBe(200)
  const body = try JSON.parse(listed.body) as { total_count: int, sessions: { id: string, bf_mode: string, bf_sub_display: string, client_name: string }[] }
  expect(body.total_count).toBe(1)
  expect(body.sessions[0]!.bf_mode).toBe("vk")
  expect(body.sessions[0]!.bf_sub_display).toBe("the key")
  expect(body.sessions[0]!.client_name).toBe("grant-list-client")
  expect(grantRevoke(body.sessions[0]!.id).status).toBe(204)
  expect(grantRevoke(body.sessions[0]!.id).status).toBe(404)
  expect(grantsList(q, names).body.includes("\"total_count\":0")).toBe(true)
  // a revoked grant does not refresh
  const form = `grant_type=refresh_token&refresh_token=${g[1]}&client_id=${g[0]}`
  const byId = (id: string): VirtualKeyConfig | undefined => id === "vk-grant-list-client" ? { id: id, value: "sk-bf-grant-list-client" } : undefined
  expect(tokenEndpoint(new URLSearchParams(form), iss, 6000.0, byId).status).toBe(400)
})

test("the grants list checks its parameters", () => {
  const names = (id: string): string => ""
  expect(grantsList(new URLSearchParams("bf_mode=user,nope"), names).status).toBe(400)
  expect(grantsList(new URLSearchParams("limit=0"), names).status).toBe(400)
  expect(grantsList(new URLSearchParams("limit=x"), names).status).toBe(400)
  expect(grantsList(new URLSearchParams("offset=-1"), names).status).toBe(400)
  expect(grantsList(new URLSearchParams("bf_mode=vk&limit=5&offset=0"), names).status).toBe(200)
  expect(grantRevoke("no-such-row").status).toBe(404)
})

test("redirect URIs need an allowed scheme, and no userinfo or fragment", () => {
  expect(redirectAllowed("javascript:alert(1)", ["*"])).toBe(false)
  expect(redirectAllowed("data:text/html,x", ["data:text/html,x"])).toBe(false)
  expect(redirectAllowed("myapp://callback/x", ["myapp://callback/x"])).toBe(false)
  expect(redirectAllowed("cursor:opaque", [])).toBe(false)
  expect(redirectAllowed("cursor://anysphere.cursor-mcp/oauth/callback", [])).toBe(true)
  expect(redirectAllowed("https://user:pw@app.example/cb", ["*"])).toBe(false)
  expect(redirectAllowed("https://app.example/cb#frag", ["*"])).toBe(false)
  expect(redirectAllowed("https://app.example/cb?next=a@b", ["*"])).toBe(true)
  expect(redirectAllowed("http://127.0.0.2:9/cb", [])).toBe(true)
  expect(redirectAllowed("http://127.evil.example/cb", [])).toBe(false)
  expect(redirectAllowed("http://[::1]:9/cb", [])).toBe(true)
})

test("the state file keeps the generated key and the grants across a restart", () => {
  const file = "raiju-mcp-state-test.json"
  const iss0 = testIssuer()
  const cfg: Config = { client: { mcp_server_auth_mode: "both", oauth2_server_config: { issuer_url: "https://gw.example" } } }
  expect(openIssuerState(cfg, file, undefined)).toBe("")
  const first = issuerOf(cfg)!
  expect(first.kid.byteLength).toBe(32)
  const g = try vkGrant(iss0, "persist-client", "8083", 7000.0)
  expect(existsSync(file)).toBe(true)
  // the file carries its state version
  expect(stateVersion(try readFileSync(file, "utf8"))).toBe(ISSUER_STATE_VERSION)
  // a second start reads the same key, and the grant is still there to refresh
  expect(openIssuerState(cfg, file, undefined)).toBe("")
  expect(issuerOf(cfg)!.kid).toBe(first.kid)
  const form = `grant_type=refresh_token&refresh_token=${g[1]}&client_id=${g[0]}`
  const byId = (id: string): VirtualKeyConfig | undefined => id === "vk-persist-client" ? { id: id, value: "sk-bf-persist-client" } : undefined
  expect(tokenEndpoint(new URLSearchParams(form), first, 8000.0, byId).status).toBe(200)
  // a configured key wins over the generated one
  const configured: Config = { client: { mcp_server_auth_mode: "both", oauth2_server_config: { issuer_url: "https://gw.example", signing_key: TEST_KEY } } }
  expect(issuerOf(configured)!.kid).toBe(try publicKeyId(TEST_KEY))
  // and the state file is cleared from the module, so later tests keep their memory-only grants
  openIssuerState(off(), "", undefined)
  try unlinkSync(file)
  try rmSync(file + ".flock", { force: true })
  try rmSync(registryOf(file), { force: true })
})

function off(): Config {
  return { client: { mcp_server_auth_mode: "headers" } }
}

test("a state file from a newer Raiju is neither read nor written over, and one from before versions is read", () => {
  const file = "raiju-mcp-state-newer-test.json"
  const cfg: Config = { client: { mcp_server_auth_mode: "both", oauth2_server_config: { issuer_url: "https://gw.example" } } }
  const newer = `{"version":99,"signing_key":"from-the-future","clients":[]}\n`
  try writeFileSync(file, newer)
  const note = openIssuerState(cfg, file, undefined)
  expect(note.includes("newer Raiju")).toBe(true)
  expect(issuerOf(cfg)).toBe(undefined)
  persistGrants()
  expect(try readFileSync(file, "utf8")).toBe(newer)
  // a file written before state versions (no "version") is read as version 0 and written back at the current one
  try writeFileSync(file, `{"clients":[{"client_id":"old-client","client_name":"old","redirect_uris":["http://127.0.0.1/cb"],"grant_types":["authorization_code"],"scope":"","created_at":${Date.now()}}]}`)
  expect(openIssuerState(cfg, file, undefined)).toBe("")
  expect(CLIENTS.has("old-client")).toBe(true)
  expect(stateVersion(try readFileSync(file, "utf8"))).toBe(ISSUER_STATE_VERSION)
  openIssuerState(off(), "", undefined)
  try unlinkSync(file)
  try rmSync(file + ".flock", { force: true })
  try rmSync(registryOf(file), { force: true })
})

test("the metadata names the endpoints and the protected resource", () => {
  const iss = testIssuer()
  expect(authServerMetadata(iss).includes("\"token_endpoint\":\"https://gw.example/oauth2/token\"")).toBe(true)
  expect(resourceMetadata(iss).includes("\"resource\":\"https://gw.example/mcp\"")).toBe(true)
  expect(challengeOf(iss)).toBe("Bearer resource_metadata=\"https://gw.example/.well-known/oauth-protected-resource/mcp\"")
})

test("the issuer is off without a usable config", () => {
  const off: Config = { client: { mcp_server_auth_mode: "headers" } }
  expect(issuerOf(off)).toBe(undefined)
  const noIssuer: Config = { client: { mcp_server_auth_mode: "both", oauth2_server_config: { signing_key: TEST_KEY } } }
  expect(issuerProblem(noIssuer).includes("issuer_url")).toBe(true)
  expect(issuerOf(noIssuer)).toBe(undefined)
  const good: Config = { client: { mcp_server_auth_mode: "oauth", oauth2_server_config: { issuer_url: "https://gw.example/", signing_key: TEST_KEY, auth_code_ttl: 99999 } } }
  expect(issuerProblem(good)).toBe("")
  const iss = issuerOf(good)!
  expect(iss.issuer).toBe("https://gw.example")
  expect(iss.codeTtl).toBe(900.0)
  expect(iss.accessTtl).toBe(600.0)
  expect(issuerOf({ client: { mcp_server_auth_mode: "nope" } })).toBe(undefined)
})

// Registers a client and opens an authorization request; returns the client id, the flow id, the consent token
// and the PKCE verifier.
function openRequest(iss: Issuer, name: string, port: string, nowMs: f64): string[] throws Error {
  const reg = register(`{"client_name":"${name}","redirect_uris":["http://127.0.0.1:${port}/cb"]}`, iss, nowMs)
  const cid = try clientIdOf(reg.body)
  const verifier = "u".repeat(50)
  const sp = new URLSearchParams("")
  sp.set("client_id", cid)
  sp.set("redirect_uri", `http://127.0.0.1:${port}/cb`)
  sp.set("response_type", "code")
  sp.set("state", "st-" + name)
  sp.set("code_challenge", pkceChallenge(verifier))
  sp.set("code_challenge_method", "S256")
  const loc = authorize(sp, iss, nowMs).location!
  return [cid, loc.slice(loc.indexOf("flow=") + 5, loc.indexOf("#t=")), loc.slice(loc.indexOf("#t=") + 3), verifier]
}

// The code of a consent answer's redirect URL.
function codeOf(body: string): string throws SyntaxError {
  const url = (try JSON.parse(body) as { redirect_url: string }).redirect_url
  return url.slice(url.indexOf("code=") + 5, url.indexOf("&state="))
}

test("user mode grants a token that names the signed-in user, and the user's key upgrades to user mode", () => {
  const iss = testIssuer()
  const now = Date.now()
  const o = try openRequest(iss, "user-client", "8091", now)
  const modes = consentModes(true, false, true, false)
  const detail = consentDetail(o[1]!, o[2]!, iss, now, modes, "alice", "alice@example.com")
  expect(detail.body.includes("\"logged_in_user\":{\"id\":\"alice\",\"name\":\"alice@example.com\"}")).toBe(true)
  expect(detail.body.includes("\"available_modes\":[\"vk\",\"session\",\"user\"]")).toBe(true)
  const none = (v: string): VirtualKeyConfig | undefined => undefined
  expect(consentSubmit(o[1]!, o[2]!, "{\"mode\":\"user\"}", iss, now, none, modes, true, "", true).status).toBe(400)
  const done = consentSubmit(o[1]!, o[2]!, "{\"mode\":\"user\"}", iss, now, none, modes, true, "alice", true)
  expect(done.status).toBe(200)
  const form = `grant_type=authorization_code&code=${try codeOf(done.body)}&code_verifier=${o[3]!}&client_id=${o[0]!}&redirect_uri=http%3A%2F%2F127.0.0.1%3A8091%2Fcb`
  const t = tokenEndpoint(new URLSearchParams(form), iss, now, (id: string): VirtualKeyConfig | undefined => undefined)
  expect(t.status).toBe(200)
  const body = try JSON.parse(t.body) as { access_token: string, refresh_token: string }
  expect(callerOf(iss, "Bearer " + body.access_token, now)).toEqual({ kind: "user", sub: "alice" })
  // a user who is no longer active cannot refresh, and an active one can
  const rf = `grant_type=refresh_token&refresh_token=${body.refresh_token}&client_id=${o[0]!}`
  const gone: RefreshChecks = { vkCut: false, userActive: (sub: string): bool => false }
  expect(tokenEndpoint(new URLSearchParams(rf), iss, now, (id: string): VirtualKeyConfig | undefined => undefined, gone).body.includes("user is no longer active")).toBe(true)
  expect(tokenEndpoint(new URLSearchParams(rf), iss, now, (id: string): VirtualKeyConfig | undefined => undefined).status).toBe(200)

  // a key that belongs to bob: refused to alice, and granted to bob as user mode
  const o2 = try openRequest(iss, "owned-key-client", "8092", now)
  const bobKey: VirtualKeyConfig = { id: "vk-bob", value: "sk-bf-bob-key", user_id: "bob" }
  const lookup = (v: string): VirtualKeyConfig | undefined => v === "sk-bf-bob-key" ? bobKey : undefined
  const vkBody = "{\"mode\":\"vk\",\"value\":\"sk-bf-bob-key\"}"
  expect(consentSubmit(o2[1]!, o2[2]!, vkBody, iss, now, lookup, modes, false, "", true).body.includes("please sign in")).toBe(true)
  expect(consentSubmit(o2[1]!, o2[2]!, vkBody, iss, now, lookup, modes, true, "alice", true).body.includes("different user")).toBe(true)
  const asBob = consentSubmit(o2[1]!, o2[2]!, vkBody, iss, now, lookup, modes, true, "bob", true)
  expect(asBob.status).toBe(200)
  const f2 = `grant_type=authorization_code&code=${try codeOf(asBob.body)}&code_verifier=${o2[3]!}&client_id=${o2[0]!}&redirect_uri=http%3A%2F%2F127.0.0.1%3A8092%2Fcb`
  const t2 = tokenEndpoint(new URLSearchParams(f2), iss, now, (id: string): VirtualKeyConfig | undefined => undefined)
  const a2 = (try JSON.parse(t2.body) as { access_token: string }).access_token
  expect(callerOf(iss, "Bearer " + a2, now)).toEqual({ kind: "user", sub: "bob" })
})

test("disable_vk_identity stops a vk grant from refreshing", () => {
  const iss = testIssuer()
  const g = try vkGrant(iss, "vk-cut-client", "8093", Date.now())
  const form = `grant_type=refresh_token&refresh_token=${g[1]}&client_id=${g[0]}`
  const byId = (id: string): VirtualKeyConfig | undefined => id === "vk-vk-cut-client" ? { id: id, value: "sk-bf-vk-cut-client" } : undefined
  const cut: RefreshChecks = { vkCut: true, userActive: (sub: string): bool => true }
  const r = tokenEndpoint(new URLSearchParams(form), iss, Date.now(), byId, cut)
  expect(r.status).toBe(400)
  expect(r.body.includes("virtual-key identity is no longer accepted")).toBe(true)
})

test("a pending request and a consented code survive a restart through the state file", () => {
  const file = "/tmp/raiju-mcp-requests-test.json"
  const cfg: Config = { client: { mcp_server_auth_mode: "both", oauth2_server_config: { issuer_url: "https://gw.example", signing_key: TEST_KEY } } }
  expect(openIssuerState(cfg, file, undefined)).toBe("")
  const iss = testIssuer()
  const now = Date.now()
  const before = try readFileSync(file, "utf8")
  const o = try openRequest(iss, "restart-client", "8094", now)
  // the registration is one line of the registry; the authorization request is stored nowhere (its link carries it)
  expect(try readFileSync(file, "utf8")).toBe(before)
  const reg = try readFileSync(registryOf(file), "utf8")
  expect(reg.includes(o[0]!)).toBe(true)
  expect(reg.includes(o[1]!)).toBe(false)
  // a restart between authorize and consent: the memory is gone, the link still opens, the client read from the registry
  restartMemory()
  const detail = consentDetail(o[1]!, o[2]!, iss, now, ["vk"])
  expect(detail.status).toBe(200)
  expect(detail.body.includes("restart-client")).toBe(true)
  // a link with another flow id, or changed, does not open
  expect(consentDetail("other-flow", o[2]!, iss, now, ["vk"]).status).toBe(401)
  expect(consentDetail(o[1]!, o[2]!.slice(0, o[2]!.byteLength - 2) + "AA", iss, now, ["vk"]).status).toBe(401)
  // nor under another signing key, nor after the code lifetime
  const otherKey: Issuer = { issuer: iss.issuer, resource: iss.resource, pem: iss.pem, kid: iss.kid, codeTtl: iss.codeTtl, accessTtl: iss.accessTtl, allowed: [], flowKey: flowKeyOf("another key"), limits: iss.limits }
  expect(consentDetail(o[1]!, o[2]!, otherKey, now, ["vk"]).status).toBe(401)
  expect(consentDetail(o[1]!, o[2]!, iss, now + 301000.0, ["vk"]).status).toBe(401)
  const key: VirtualKeyConfig = { id: "vk-r", value: "sk-bf-restart" }
  const lookup = (v: string): VirtualKeyConfig | undefined => v === "sk-bf-restart" ? key : undefined
  const done = consentSubmit(o[1]!, o[2]!, "{\"mode\":\"vk\",\"value\":\"sk-bf-restart\"}", iss, now, lookup, ["vk"], false)
  expect(done.status).toBe(200)
  // the consented client now holds a grant: it is kept in the state file
  expect((try readFileSync(file, "utf8")).includes(o[0]!)).toBe(true)
  // and a restart between consent and the token request: the link is spent, the code still exchanges, once
  restartMemory()
  expect(consentDetail(o[1]!, o[2]!, iss, now, ["vk"]).status).toBe(401)
  expect(consentSubmit(o[1]!, o[2]!, "{\"mode\":\"vk\",\"value\":\"sk-bf-restart\"}", iss, now, lookup, ["vk"], false).status).toBe(401)
  const form = `grant_type=authorization_code&code=${try codeOf(done.body)}&code_verifier=${o[3]!}&client_id=${o[0]!}&redirect_uri=http%3A%2F%2F127.0.0.1%3A8094%2Fcb`
  const byId = (id: string): VirtualKeyConfig | undefined => id === "vk-r" ? key : undefined
  expect(tokenEndpoint(new URLSearchParams(form), iss, now, byId).status).toBe(200)
  restartMemory()
  expect(tokenEndpoint(new URLSearchParams(form), iss, now, byId).status).toBe(400)
  openIssuerState(off(), "", undefined)
  try unlinkSync(file)
  try rmSync(registryOf(file), { force: true })
  try rmSync(file + ".flock", { force: true })
})

// Forgets what was read from the files, as a new process would.
function forgetReads(): void {
  stateStamp = ""
  stateReadAt = -1.0e15
  registryStamp = ""
  registryReadAt = -1.0e15
  registryGen = ""
  registryAt = 0
  registryLines = 0
}

// Forgets everything in memory (a restart, or another worker that has read nothing yet).
function restartMemory(): void {
  REQUESTS.clear()
  CLIENTS.clear()
  REFRESH.clear()
  RECENT.clear()
  forgetReads()
}

test("registration is bounded per address (a minute's count, unused clients) and in all, and unused clients expire", () => {
  restartMemory()
  const base = testIssuer()
  const lim: ClientLimits = { perMinute: 3, perAddress: 5, maxUnused: 8, unusedTtlMs: 1200000.0 }
  const iss: Issuer = { issuer: base.issuer, resource: base.resource, pem: base.pem, kid: base.kid, codeTtl: base.codeTtl, accessTtl: base.accessTtl, allowed: [], flowKey: base.flowKey, limits: lim }
  const body = "{\"client_name\":\"flood\",\"redirect_uris\":[\"http://127.0.0.1:9/cb\"]}"
  const t0 = 1.0e12
  // three a minute from one address, then 429 with the seconds to wait
  for (let i = 0; i < 3; i++) expect(register(body, iss, t0 + i * 1.0, "10.1.1.1").status).toBe(201)
  const slow = register(body, iss, t0 + 10.0, "10.1.1.1")
  expect(slow.status).toBe(429)
  expect(slow.retryAfter!).toBe(60)
  // another address is not held back, and an unknown address is not counted
  expect(register(body, iss, t0 + 11.0, "10.1.1.2").status).toBe(201)
  expect(register(body, iss, t0 + 12.0, "").status).toBe(201)
  // a minute later the address registers again, until it holds five unused clients
  expect(register(body, iss, t0 + 61000.0, "10.1.1.1").status).toBe(201)
  expect(register(body, iss, t0 + 61001.0, "10.1.1.1").status).toBe(201)
  const full = register(body, iss, t0 + 122000.0, "10.1.1.1")
  expect(full.status).toBe(429)
  expect(full.body.includes("unused clients")).toBe(true)
  // one IPv6 host is one address over its /64
  expect(addressHash("2001:db8:1:2::5")).toBe(addressHash("2001:db8:1:2:ffff::9"))
  expect(addressHash("2001:db8:1:3::5") === addressHash("2001:db8:1:2::5")).toBe(false)
  expect(addressHash("::ffff:10.1.1.1")).toBe(addressHash("10.1.1.1"))
  // in all, past eight unused clients the oldest are dropped (seven so far, then four more)
  let last = ""
  for (let i = 0; i < 4; i++) {
    const r = register(body, iss, t0 + 130000.0 + i * 1.0, `10.2.0.${i}`)
    expect(r.status).toBe(201)
    last = try clientIdOf(r.body)
  }
  let unused = 0
  for (const cl of CLIENTS.values()) unused += cl.client_name === "flood" ? 1 : 0
  expect(unused).toBe(8)
  expect(CLIENTS.has(last)).toBe(true)
  // a client with a grant is never dropped: it outlives the unused lifetime and the cap
  const g = try vkGrant(iss, "kept-grant", "8096", t0 + 131000.0)
  for (let i = 0; i < 9; i++) register(body, iss, t0 + 140000.0 + i * 1.0, `10.3.0.${i}`)
  expect(CLIENTS.has(g[0]!)).toBe(true)
  // an unused client expires after its lifetime; the granted one stays
  register(body, iss, t0 + 140000.0 + 1300000.0, "10.4.0.1")
  unused = 0
  for (const cl of CLIENTS.values()) unused += cl.client_name === "flood" ? 1 : 0
  expect(unused).toBe(1)
  expect(CLIENTS.has(g[0]!)).toBe(true)
  // the limits' defaults and bounds
  const d = limitsOf({})
  expect(d).toEqual({ perMinute: 10, perAddress: 20, maxUnused: 1000, unusedTtlMs: 3600000.0 })
  const c = limitsOf({ registrations_per_minute: -1, max_unused_clients_per_address: 3, max_unused_clients: 50, unused_client_ttl_seconds: 60 })
  expect(c).toEqual({ perMinute: 0, perAddress: 3, maxUnused: 50, unusedTtlMs: 1200000.0 })
  restartMemory()
})

test("the registry is appended to, read by another worker from where it left off, and rewritten when it grows", () => {
  const file = "/tmp/raiju-mcp-registry-test.json"
  try rmSync(file, { force: true })
  try rmSync(registryOf(file), { force: true })
  const cfg: Config = { client: { mcp_server_auth_mode: "both", oauth2_server_config: { issuer_url: "https://gw.example", signing_key: TEST_KEY, max_unused_clients: 20, registrations_per_minute: -1, max_unused_clients_per_address: -1 } } }
  restartMemory()
  expect(openIssuerState(cfg, file, undefined)).toBe("")
  const iss = issuerOf(cfg)!
  const now = Date.now()
  const stateBefore = try readFileSync(file, "utf8")
  const ids: string[] = []
  for (let i = 0; i < 5; i++) ids.push(try clientIdOf(register(`{"client_name":"r${i}","redirect_uris":["http://127.0.0.1:9/cb"]}`, iss, now + i * 1.0, "10.9.0.1").body))
  // the state file is not touched by a registration
  expect(try readFileSync(file, "utf8")).toBe(stateBefore)
  expect((try readFileSync(registryOf(file), "utf8")).split("\n").length).toBe(7)
  // another worker (nothing in memory) finds a client on authorize
  restartMemory()
  const sp = new URLSearchParams("")
  sp.set("client_id", ids[3]!)
  sp.set("redirect_uri", "http://127.0.0.1:9/cb")
  sp.set("response_type", "code")
  sp.set("code_challenge", pkceChallenge("w".repeat(50)))
  sp.set("code_challenge_method", "S256")
  expect(authorize(sp, iss, now + 10.0).status).toBe(302)
  expect(CLIENTS.size).toBe(5)
  // past twice the live clients the registry is rewritten with the live ones only (twenty, the oldest dropped)
  for (let i = 0; i < 120; i++) register(`{"client_name":"m${i}","redirect_uris":["http://127.0.0.1:9/cb"]}`, iss, now + 100.0 + i * 1.0, "10.9.0.2")
  const lines = (try readFileSync(registryOf(file), "utf8")).split("\n").length - 2
  expect(lines <= 2 * 20 + 64 + 1).toBe(true)
  expect(lines >= 20).toBe(true)
  // a worker that read the old generation reads the new one whole
  restartMemory()
  readRegistry(true, now + 1000.0)
  trimClients(iss.limits, now + 1000.0)
  expect(CLIENTS.size).toBe(20)
  openIssuerState(off(), "", undefined)
  restartMemory()
  try rmSync(file, { force: true })
  try rmSync(registryOf(file), { force: true })
  try rmSync(file + ".flock", { force: true })
})

test("a state file of the earlier format is split at the start: unused clients to the registry, pending requests dropped", () => {
  const file = "/tmp/raiju-mcp-split-test.json"
  try rmSync(registryOf(file), { force: true })
  const now = Date.now()
  const old = `{"version":1,"clients":[{"client_id":"kept-c","client_name":"granted","redirect_uris":["http://127.0.0.1/cb"],"grant_types":["authorization_code"],"scope":"mcp","created_at":1},{"client_id":"fresh-c","client_name":"fresh","redirect_uris":["http://127.0.0.1/cb"],"grant_types":["authorization_code"],"scope":"mcp","created_at":${now}},{"client_id":"stale-c","client_name":"stale","redirect_uris":["http://127.0.0.1/cb"],"grant_types":["authorization_code"],"scope":"mcp","created_at":1}],"refresh":[{"hash":"h1","family":"f1","client_id":"kept-c","mode":"vk","sub":"vk-1","scope":"mcp","resource":"https://gw.example/mcp","created_at":${now},"used_at":0,"revoked":false}],"requests":[{"id":"p1","client_id":"fresh-c","redirect_uri":"http://127.0.0.1/cb","state":"","scope":"mcp","resource":"","challenge":"x","expires_at":${now + 100000.0},"status":"pending","mode":"","sub":"","code_hash":""}],"consent":[{"hash":"t1","id":"p1","expires_at":${now + 100000.0}}]}`
  try writeFileSync(file, old)
  restartMemory()
  const cfg: Config = { client: { mcp_server_auth_mode: "both", oauth2_server_config: { issuer_url: "https://gw.example", signing_key: TEST_KEY } } }
  expect(openIssuerState(cfg, file, undefined)).toBe("")
  const st = try readFileSync(file, "utf8")
  expect(st.includes("kept-c")).toBe(true)
  expect(st.includes("fresh-c")).toBe(false)
  expect(st.includes("stale-c")).toBe(false)
  expect(st.includes("\"consent\"")).toBe(false)
  expect(st.includes("pending")).toBe(false)
  const reg = try readFileSync(registryOf(file), "utf8")
  expect(reg.includes("fresh-c")).toBe(true)
  expect(reg.includes("stale-c")).toBe(false)
  openIssuerState(off(), "", undefined)
  restartMemory()
  try rmSync(file, { force: true })
  try rmSync(registryOf(file), { force: true })
  try rmSync(file + ".flock", { force: true })
})

// The test issuer: the throwaway key the jwt tests use, under a fixed issuer.
function testIssuer(): Issuer {
  return { issuer: "https://gw.example", resource: "https://gw.example/mcp", pem: TEST_KEY, kid: "test-kid", codeTtl: 300.0, accessTtl: 600.0, allowed: [], flowKey: flowKeyOf(TEST_KEY), limits: limitsOf({}) }
}

function clientIdOf(body: string): string throws SyntaxError {
  return rawStr(try fields(body), "client_id") ?? ""
}

