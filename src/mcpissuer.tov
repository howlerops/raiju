test("revoking a key's grants ends its refresh tokens and its consented codes", () => {
  const iss = testIssuer()
  const g = try vkGrant(iss, "rot-client", "8091", 7000.0)
  const other = try vkGrant(iss, "rot-other", "8092", 7000.0)
  // a second request for the same key, consented but not exchanged yet
  const reg = register(`{"client_name":"rot-late","redirect_uris":["http://127.0.0.1:8093/cb"]}`, iss, 7000.0)
  const cid = try clientIdOf(reg.body)
  const verifier = "r".repeat(50)
  const sp = new URLSearchParams("")
  sp.set("client_id", cid)
  sp.set("redirect_uri", "http://127.0.0.1:8093/cb")
  sp.set("response_type", "code")
  sp.set("state", "st-late")
  sp.set("code_challenge", pkceChallenge(verifier))
  sp.set("code_challenge_method", "S256")
  const loc = authorize(sp, iss, 7000.0).location!
  const flow = loc.slice(loc.indexOf("flow=") + 5, loc.indexOf("#t="))
  const tok = loc.slice(loc.indexOf("#t=") + 3)
  const key: VirtualKeyConfig = { id: "vk-rot-client", value: "sk-bf-rot-client" }
  const lookup = (v: string): VirtualKeyConfig | undefined => v === key.value ? key : undefined
  const done = consentSubmit(flow, tok, `{"mode":"vk","value":"sk-bf-rot-client"}`, iss, 7000.0, lookup, ["vk"], false)
  const url = try JSON.parse(done.body) as { redirect_url: string }
  const code = url.redirect_url.slice(url.redirect_url.indexOf("code=") + 5, url.redirect_url.indexOf("&state="))
  expect(revokeSubject("vk", "vk-rot-client")).toBe(2)
  const byId = (id: string): VirtualKeyConfig | undefined => key
  const refresh = new URLSearchParams(`grant_type=refresh_token&refresh_token=${g[1]!}&client_id=${g[0]!}`)
  expect(tokenEndpoint(refresh, iss, 7100.0, byId).status).toBe(400)
  const form = `grant_type=authorization_code&code=${code}&code_verifier=${verifier}&client_id=${cid}&redirect_uri=http%3A%2F%2F127.0.0.1%3A8093%2Fcb`
  expect(tokenEndpoint(new URLSearchParams(form), iss, 7100.0, byId).status).toBe(400)
  // another key's grant is untouched, and a second revoke finds nothing
  const keep = new URLSearchParams(`grant_type=refresh_token&refresh_token=${other[1]!}&client_id=${other[0]!}`)
  const otherKey: VirtualKeyConfig = { id: "vk-rot-other", value: "sk-bf-rot-other" }
  expect(tokenEndpoint(keep, iss, 7100.0, (id: string): VirtualKeyConfig | undefined => otherKey).status).toBe(200)
  expect(revokeSubject("vk", "vk-rot-client")).toBe(0)
})

test("a grant from before the key's rotation does not refresh, even where the revoke was not seen", () => {
  const iss = testIssuer()
  const g = try vkGrant(iss, "rot-late-client", "8094", 8000.0)
  const rotated: VirtualKeyConfig = { id: "vk-rot-late-client", value: "sk-bf-new", rotated_at: "1970-01-01T00:00:09Z" }
  const refresh = new URLSearchParams(`grant_type=refresh_token&refresh_token=${g[1]!}&client_id=${g[0]!}`)
  expect(tokenEndpoint(refresh, iss, 9500.0, (id: string): VirtualKeyConfig | undefined => rotated).status).toBe(400)
  // a key rotated before the grant was made does not void it
  const g2 = try vkGrant(iss, "rot-early-client", "8095", 12000.0)
  const early: VirtualKeyConfig = { id: "vk-rot-early-client", value: "sk-bf-rot-early-client", rotated_at: "1970-01-01T00:00:09Z" }
  const r2 = new URLSearchParams(`grant_type=refresh_token&refresh_token=${g2[1]!}&client_id=${g2[0]!}`)
  expect(tokenEndpoint(r2, iss, 12500.0, (id: string): VirtualKeyConfig | undefined => early).status).toBe(200)
})
