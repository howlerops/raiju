// Turns "provider/model" plus fallbacks into attempts: picks a provider config
// and a weighted key for each, and decides what to retry.
import { Config, KeyConfig, ProviderConfig, AliasTarget, providerOf, resolveEnv } from "./config"
import { Target } from "./providers/types"
import { isOpenAICompatible } from "./providers/openai"
import { Health, pickAdaptive } from "./health"
import { datasheetProviders } from "./pricing"
import { aliasLookup, aliasEntry, aliasProblem, resolveKeyAlias, AliasResult } from "./aliases"

export type ModelRef = { provider: string, model: string }

const NATIVE_KINDS = ["azure", "anthropic", "gemini", "bedrock", "vertex", "cohere", "watsonx", "bedrock_mantle", "cloudflare", "databricks", "github-copilot", "replicate", "typesafe"]

export function isKnownKind(kind: string): bool {
  return NATIVE_KINDS.includes(kind) || isOpenAICompatible(kind)
}

// The catalog's name for a provider, where Raiju names it differently.
function configName(catalogName: string): string {
  if (catalogName === "vertex_ai") return "vertex"
  return catalogName
}

// The canonical provider of an integration route, preferred among catalog matches.
export function routeProvider(route: string): string {
  if (route === "openai") return "openai"
  if (route === "anthropic") return "anthropic"
  if (route === "genai") return "gemini"
  if (route === "bedrock") return "bedrock"
  if (route === "cohere") return "cohere"
  return ""
}

// "openai/gpt-4o" → openai + gpt-4o. A bare model resolves, in order, to: a
// provider whose key lists it (as a model or an alias); a configured provider
// that the datasheet lists for it (the route's provider if it is one of them,
// else the first by name); the claude/gemini prefix rule. Otherwise provider is
// "" and the caller answers with ProviderAutoResolveErrorMessage.
export function parseModel(cfg: Config, s: string): ModelRef {
  return parseModelVia(cfg, s, "")
}

// parseModel for a request on an integration route: "openai", "anthropic",
// "genai", "bedrock", "cohere", or "" for none.
export function parseModelVia(cfg: Config, s: string, route: string): ModelRef {
  const i = s.indexOf("/")
  if (i > 0) {
    const p = s.slice(0, i)
    const ps = cfg.providers
    if ((ps !== undefined && ps.has(p)) || isKnownKind(p)) return { provider: p, model: s.slice(i + 1) }
  }
  const ps = cfg.providers
  if (ps !== undefined) {
    for (const name of ps.keys()) {
      for (const k of ps.get(name)!.keys ?? []) {
        if ((k.models ?? []).includes(s)) return { provider: name, model: s }
      }
    }
    for (const name of ps.keys()) {
      for (const k of ps.get(name)!.keys ?? []) {
        const a = k.aliases
        if (a !== undefined && aliasLookup(a, s) !== undefined) return { provider: name, model: s }
      }
    }
    // the model family's own provider, when configured, before the catalog (whose bare
    // claude-* names are often Bedrock's or Vertex's)
    if (s.startsWith("claude") && ps.has("anthropic")) return { provider: "anthropic", model: s }
    if (s.startsWith("gemini") && ps.has("gemini")) return { provider: "gemini", model: s }
    const names: string[] = []
    for (const c of datasheetProviders(s)) {
      const n = configName(c)
      if (ps.has(n) && !names.includes(n)) names.push(n)
    }
    if (names.length > 0) {
      const hinted = routeProvider(route)
      if (hinted !== "" && names.includes(hinted)) return { provider: hinted, model: s }
      return { provider: names[0]!, model: s }
    }
  }
  return { provider: "", model: s }
}

export function kindOf(name: string, p: ProviderConfig): string {
  const custom = p.custom_provider_config
  if (custom !== undefined) return custom.base_provider_type
  return name
}

// The alias entry a key matches for a request model, in object form (undefined when none).
// Its model_name and model_family are the canonical name and family the answer is priced and
// reported under.
export function matchedAlias(k: KeyConfig, model: string): AliasTarget | undefined {
  const a = k.aliases
  if (a === undefined) return undefined
  return aliasEntry(a, model)
}

// The model name this key sends upstream: its alias chain followed to the end.
// error is set when the chain loops or is longer than the depth limit.
export function resolveAlias(k: KeyConfig, model: string, maxDepth?: int): AliasResult {
  const a = k.aliases
  if (a === undefined) return { model: model, error: "" }
  return resolveKeyAlias(a, model, maxDepth)
}

// Problems in the aliases of every key of every provider, one line each ("" when
// none). Meant for config load, so a bad chain is reported before a request uses it.
export function aliasProblems(cfg: Config): string[] {
  const out: string[] = []
  const ps = cfg.providers
  if (ps === undefined) return out
  for (const name of ps.keys()) {
    const keys = ps.get(name)!.keys ?? []
    for (let i = 0; i < keys.length; i++) {
      const a = keys[i]!.aliases
      if (a === undefined) continue
      const p = aliasProblem(a, cfg.client?.routing_chain_max_depth)
      if (p !== "") out.push(name + " key " + (keys[i]!.name ?? ("" + i)) + ": " + p)
    }
  }
  return out
}

export function keyAllows(k: KeyConfig, model: string): bool {
  const ms = k.models
  if (ms === undefined || ms.length === 0) return true
  const a = k.aliases
  if (a !== undefined && aliasLookup(a, model) !== undefined) return true
  for (const m of ms) {
    if (m === "*" || m === model) return true
  }
  return false
}

// Weighted random choice among keys that serve the model, skipping excluded ones.
export function pickKey(keys: KeyConfig[], model: string, exclude: Set<int>, pinned: string | undefined): int {
  if (pinned !== undefined) {
    for (let i = 0; i < keys.length; i++) {
      const k = keys[i]!
      if (k.name === pinned || k.id === pinned) return i
    }
    return -1
  }
  let total = 0.0
  const eligible: int[] = []
  for (let i = 0; i < keys.length; i++) {
    if (exclude.has(i) || !keyAllows(keys[i]!, model)) continue
    eligible.push(i)
    total += keys[i]!.weight ?? 1.0
  }
  if (eligible.length === 0) return -1
  let r = Math.random() * total
  for (const i of eligible) {
    r -= keys[i]!.weight ?? 1.0
    if (r <= 0.0) return i
  }
  return eligible[eligible.length - 1]!
}

// The id health tracking uses for a key: "<provider>#<key name or id or index>".
export function healthId(provider: string, k: KeyConfig, index: int): string {
  return provider + "#" + (k.name ?? k.id ?? ("" + index))
}

// Breaker-aware choice: keys whose breaker is open are skipped, the rest are
// weighted by measured health when `adaptive` is set, else by static weight. Under adaptive load
// balancing a key held by a provider's refusal (holds.tov) is skipped too.
function pickHealthy(provider: string, keys: KeyConfig[], model: string, exclude: Set<int>, health: Health, adaptive: bool): int {
  const now = Date.now()
  const tried: Set<int> = new Set()
  for (const i of exclude.values()) tried.add(i)
  while (true) {
    const idx: int[] = []
    const ids: string[] = []
    const ws: f64[] = []
    // the held key a request goes to when every key is held: one this node owns the check for, else the one
    // whose next check is soonest (Bifrost sends the request anyway; its answer settles the hold)
    let heldIdx = -1
    let heldOwned = false
    let heldSoon = 0.0
    for (let i = 0; i < keys.length; i++) {
      if (tried.has(i) || !keyAllows(keys[i]!, model)) continue
      const hid = healthId(provider, keys[i]!, i)
      if (adaptive) {
        // a refused key is out of rotation until its check; a key whose check is in flight is skipped too
        const hs = health.holds.state(hid, model, now)
        if (hs === "held" || hs === "checking") {
          const owned = health.holds.ownsHold(hid, model)
          const soon = health.holds.nextCheckOf(hid, model)
          if (heldIdx < 0 || (owned && !heldOwned) || (owned === heldOwned && soon < heldSoon)) {
            heldIdx = i
            heldOwned = owned
            heldSoon = soon
          }
          continue
        }
      }
      idx.push(i)
      ids.push(hid)
      ws.push(keys[i]!.weight ?? 1.0)
    }
    if (idx.length === 0) {
      // every key is held: the request is sent to the best of them without a check, so the scheduled check
      // (startCheck, on the owner) is still the only one sent cluster-wide
      return heldIdx
    }
    let j = -1
    if (adaptive) j = pickAdaptive(ids, ws, health, now, Math.random())
    else {
      // static weights; open breakers, held keys and keys already tried are skipped
      const open: Set<int> = new Set()
      for (let k = 0; k < idx.length; k++) {
        if (!health.wouldAllow(ids[k]!, now)) open.add(idx[k]!)
      }
      const all: Set<int> = new Set()
      for (const t of tried.values()) all.add(t)
      for (const o of open.values()) all.add(o)
      for (let k = 0; k < keys.length; k++) {
        if (!idx.includes(k)) all.add(k)
      }
      const i = pickKey(keys, model, all, undefined)
      j = idx.indexOf(i)
    }
    if (j < 0) return -1
    // allow() starts a half-open probe; if another request took the only probe slot, pick again
    if (health.allow(ids[j]!, now)) {
      // a key due for its check gets this request as the check
      if (adaptive) health.holds.startCheck(ids[j]!, model, now)
      return idx[j]!
    }
    tried.add(idx[j]!)
  }
}

export function target(cfg: Config, ref: ModelRef, exclude: Set<int>, pinned: string | undefined, health?: Health): { t: Target, keyIndex: int } | undefined {
  const p = providerOf(cfg, ref.provider)
  if (p === undefined) return undefined
  const kind = kindOf(ref.provider, p)
  const keys = p.keys ?? []
  const keyless = p.custom_provider_config?.is_key_less ?? false
  if (keys.length === 0) {
    if (!keyless && kind !== "ollama" && kind !== "vllm" && kind !== "sgl" && kind !== "lmstudio") return undefined
    return { t: { provider: ref.provider, kind: kind, model: ref.model, key: { value: "" }, cfg: p }, keyIndex: -1 }
  }
  const hc = cfg.health
  const useHealth = health !== undefined && pinned === undefined && hc !== undefined && (hc.circuit_breaker === true || hc.adaptive === true)
  let i: int = -1
  if (useHealth) i = pickHealthy(ref.provider, keys, ref.model, exclude, health!, hc!.adaptive === true)
  else i = pickKey(keys, ref.model, exclude, pinned)
  if (i < 0) return undefined
  const up = resolveAlias(keys[i]!, ref.model, cfg.client?.routing_chain_max_depth)
  if (up.error !== "") return undefined
  const key = aliasOverrides(keys[i]!, matchedAlias(keys[i]!, ref.model), kind)
  return { t: { provider: ref.provider, kind: kind, model: up.model, key: key, cfg: p }, keyIndex: i }
}

// The key a request to an alias is sent with: the alias's provider overrides replace the key's own settings, as
// Bifrost's per-alias AliasConfig overrides the key-level defaults. Each applies to its provider's keys only:
// api_version and endpoint (Azure), region and project_id (Vertex), region, inference_profile_arn and
// use_openai_endpoints (Bedrock; region also on Bedrock Mantle) and use_deployments_endpoint (Replicate). Values
// written "env.NAME" are read from the environment.
export function aliasOverrides(k: KeyConfig, a: AliasTarget | undefined, kind: string): KeyConfig {
  if (a === undefined) return k
  let n = k
  if (kind === "azure") {
    let az = n.azure_key_config ?? { endpoint: "" }
    const ver = a.api_version
    if (ver !== undefined && ver !== "") az.api_version = ver
    const ep = a.endpoint
    if (ep !== undefined && ep !== "") az.endpoint = resolveEnv(ep)
    if ((ver !== undefined && ver !== "") || (ep !== undefined && ep !== "")) n.azure_key_config = az
  }
  if (kind === "vertex") {
    const rg = a.region
    const proj = a.project_id
    if ((rg !== undefined && rg !== "") || (proj !== undefined && proj !== "")) {
      let vk = n.vertex_key_config ?? { project_id: "", region: "" }
      if (rg !== undefined && rg !== "") vk.region = resolveEnv(rg)
      if (proj !== undefined && proj !== "") vk.project_id = resolveEnv(proj)
      n.vertex_key_config = vk
    }
  }
  if (kind === "bedrock" || kind === "bedrock_mantle") {
    const rg = a.region
    const arn = kind === "bedrock" ? a.inference_profile_arn : undefined
    const oai = kind === "bedrock" ? a.use_openai_endpoints : undefined
    if ((rg !== undefined && rg !== "") || (arn !== undefined && arn !== "") || oai !== undefined) {
      let bk = n.bedrock_key_config ?? {}
      if (rg !== undefined && rg !== "") bk.region = resolveEnv(rg)
      if (arn !== undefined && arn !== "") bk.arn = resolveEnv(arn)
      if (oai !== undefined) bk.use_openai_endpoints = oai
      n.bedrock_key_config = bk
    }
  }
  if (kind === "replicate") {
    const dep = a.use_deployments_endpoint
    if (dep !== undefined) {
      let rk = n.replicate_key_config ?? {}
      rk.use_deployments_endpoint = dep
      n.replicate_key_config = rk
    }
  }
  return n
}

// ---- directions (Bifrost's load_balancer_config, Level 1) ----

// The switches of the provider (direction) level, from health: select is direction_selection (on unless false);
// append, reroute and prune are append_fallbacks_to_pinned, reroute_failed_directions and prune_failed_fallbacks.
export type DirectionOpts = { select: bool, append: bool, reroute: bool, prune: bool }

// The direction switches in force: none unless adaptive load balancing is on.
export function directionOpts(cfg: Config): DirectionOpts {
  const hc = cfg.health
  const on = hc?.adaptive === true && hc?.direction_selection !== false
  return { select: on, append: on && hc?.append_fallbacks_to_pinned === true, reroute: on && hc?.reroute_failed_directions === true, prune: on && hc?.prune_failed_fallbacks === true }
}

// The configured providers that can serve a model: one with a key that lists it (or lists no models, or aliases
// it), in the config's order. A provider with no keys serves whatever it is asked (keyless).
export function eligibleProviders(cfg: Config, model: string): string[] {
  const out: string[] = []
  const ps = cfg.providers
  if (ps === undefined) return out
  for (const name of ps.keys()) {
    const keys = ps.get(name)!.keys ?? []
    if (keys.length === 0 || keys.some((k) => keyAllows(k, model) && ((k.models ?? []).length > 0 || datasheetProviders(model).some((c) => configName(c) === name)))) out.push(name)
  }
  return out
}

// Whether a direction (provider and model) is healthy: some key that serves the model has a closed breaker and is
// not held. A provider with no keys, or one not configured, counts as healthy (nothing says otherwise).
export function directionHealthy(cfg: Config, ref: ModelRef, health: Health, now: f64): bool {
  const p = providerOf(cfg, ref.provider)
  if (p === undefined) return true
  const keys = p.keys ?? []
  if (keys.length === 0) return true
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i]!
    if (!keyAllows(k, ref.model)) continue
    const hid = healthId(ref.provider, k, i)
    const hs = health.holds.state(hid, ref.model, now)
    if (hs === "held" || hs === "checking") continue
    if (health.wouldAllow(hid, now)) return true
  }
  return false
}

// A request's directions after the provider level (Bifrost's adaptive load balancing, Level 1). refs[0] is the
// primary and the rest its configured fallbacks; pinned says the request (or a routing rule) named the provider.
// A request that names none takes a healthy provider for its model, the one it resolved to when that is healthy,
// with the other healthy ones behind its fallbacks. A pinned request is left as it is, unless append adds the
// healthy providers for its model behind its fallbacks, or reroute replaces a broken primary with a healthy
// provider for the same model (kept when there is none; reroute appends as append does). prune drops broken
// directions from the fallbacks wherever the list is rebuilt.
export function directRefs(cfg: Config, refs: ModelRef[], pinned: bool, health: Health, o: DirectionOpts, now: f64): ModelRef[] {
  if (!o.select || refs.length === 0) return refs
  const first = refs[0]!
  const ok = (r: ModelRef): bool => directionHealthy(cfg, r, health, now)
  const broken = !ok(first)
  if (pinned && !o.append && !(o.reroute && broken)) return refs
  const candidates = eligibleProviders(cfg, first.model).filter((n) => n !== first.provider).map((n) => ({ provider: n, model: first.model }))
  let primary = first
  if (broken && (!pinned || o.reroute)) {
    for (const c of candidates) {
      if (ok(c)) {
        primary = c
        break
      }
    }
  }
  const out: ModelRef[] = [primary]
  const has = (r: ModelRef): bool => out.some((x) => x.provider === r.provider && x.model === r.model)
  for (const f of refs.slice(1)) {
    if (o.prune && !ok(f)) continue
    if (!has(f)) out.push(f)
  }
  for (const c of candidates) {
    if (ok(c) && !has(c)) out.push(c)
  }
  return out
}

// How an upstream failure is handled.
export type Disposition = "retry" | "rotate" | "fallback" | "fail"

export function classify(status: int): Disposition {
  if (status === 429 || status === 408 || status >= 500) return "retry"
  if (status === 401 || status === 403 || status === 402) return "rotate"
  if (status === 400 || status === 422 || status === 413) return "fail"
  return "fallback"
}

export function backoffMs(p: ProviderConfig, attempt: int, retryAfter: string | undefined): int {
  if (retryAfter !== undefined) {
    const secs = parseFloat(retryAfter)
    if (secs !== undefined && secs >= 0.0) return Math.min(Math.round(secs * 1000), 60000)
  }
  const initial = p.network_config?.retry_backoff_initial ?? 500
  const max = p.network_config?.retry_backoff_max ?? 5000
  let d = initial
  for (let i = 0; i < attempt; i++) d = d * 2
  if (d > max) d = max
  // 0.8 to 1.2 jitter, as Bifrost does
  return Math.round(d * (0.8 + Math.random() * 0.4))
}

export function maxRetries(p: ProviderConfig): int {
  return p.network_config?.max_retries ?? 0
}

export function timeoutMs(p: ProviderConfig): int {
  return (p.network_config?.default_request_timeout_in_seconds ?? 30) * 1000
}

test("an alias's provider overrides replace the key's settings for its requests", () => {
  const al: Map<string, string | AliasTarget> = new Map()
  al.set("east", { model_id: "gpt-4o", api_version: "2025-01-01-preview", endpoint: "https://east.openai.azure.com" })
  al.set("plain", "gpt-4o")
  const cfg: Config = { providers: new Map() }
  cfg.providers!.set("azure", { keys: [{ value: "k", models: ["east", "plain"], aliases: al, azure_key_config: { endpoint: "https://main.openai.azure.com", api_version: "2024-10-21" } }] })
  const t = target(cfg, { provider: "azure", model: "east" }, new Set<int>(), undefined)!.t
  expect(t.model).toBe("gpt-4o")
  expect(t.key.azure_key_config!.endpoint).toBe("https://east.openai.azure.com")
  expect(t.key.azure_key_config!.api_version).toBe("2025-01-01-preview")
  const p = target(cfg, { provider: "azure", model: "plain" }, new Set<int>(), undefined)!.t
  expect(p.key.azure_key_config!.endpoint).toBe("https://main.openai.azure.com")
  // the stored key is not changed
  expect(cfg.providers!.get("azure")!.keys![0]!.azure_key_config!.endpoint).toBe("https://main.openai.azure.com")
  const bk = aliasOverrides({ value: "", bedrock_key_config: { region: "us-east-1" } }, { model_id: "m", region: "eu-west-1", inference_profile_arn: "arn:aws:bedrock:eu-west-1:1:application-inference-profile/x", use_openai_endpoints: true }, "bedrock")
  expect(bk.bedrock_key_config!.region).toBe("eu-west-1")
  expect(bk.bedrock_key_config!.arn).toBe("arn:aws:bedrock:eu-west-1:1:application-inference-profile/x")
  expect(bk.bedrock_key_config!.use_openai_endpoints).toBe(true)
  const vk = aliasOverrides({ vertex_key_config: { project_id: "p1", region: "us-central1" } }, { model_id: "m", project_id: "p2", region: "europe-west4" }, "vertex")
  expect(vk.vertex_key_config!.project_id).toBe("p2")
  expect(vk.vertex_key_config!.region).toBe("europe-west4")
  const rk = aliasOverrides({ value: "r" }, { model_id: "acme/dep", use_deployments_endpoint: true }, "replicate")
  expect(rk.replicate_key_config!.use_deployments_endpoint).toBe(true)
  // an override for another provider is not applied
  const other = aliasOverrides({ value: "k" }, { model_id: "m", api_version: "x", use_deployments_endpoint: true }, "openai")
  expect(other.azure_key_config).toBeUndefined()
  expect(other.replicate_key_config).toBeUndefined()
})

test("parses provider-prefixed and bare models", () => {
  const cfg: Config = { providers: new Map() }
  cfg.providers!.set("anthropic", { keys: [{ value: "k" }] })
  cfg.providers!.set("mygw", { keys: [{ value: "k", models: ["special-1"] }], custom_provider_config: { base_provider_type: "openai" } })
  expect(parseModel(cfg, "openai/gpt-4o")).toEqual({ provider: "openai", model: "gpt-4o" })
  expect(parseModel(cfg, "mygw/x/y")).toEqual({ provider: "mygw", model: "x/y" })
  expect(parseModel(cfg, "special-1")).toEqual({ provider: "mygw", model: "special-1" })
  expect(parseModel(cfg, "claude-sonnet-4")).toEqual({ provider: "anthropic", model: "claude-sonnet-4" })
  expect(parseModel(cfg, "meta-llama/Llama-3")).toEqual({ provider: "", model: "meta-llama/Llama-3" })
})

test("bare models resolve through the catalog to a configured provider", () => {
  const cfg: Config = { providers: new Map() }
  cfg.providers!.set("openai", { keys: [{ value: "k" }] })
  cfg.providers!.set("anthropic", { keys: [{ value: "k" }] })
  cfg.providers!.set("gemini", { keys: [{ value: "k" }] })
  expect(parseModel(cfg, "gpt-4o")).toEqual({ provider: "openai", model: "gpt-4o" })
  expect(parseModel(cfg, "claude-sonnet-4-5")).toEqual({ provider: "anthropic", model: "claude-sonnet-4-5" })
  expect(parseModel(cfg, "gemini-2.5-flash")).toEqual({ provider: "gemini", model: "gemini-2.5-flash" })
  expect(parseModel(cfg, "gpt-4o-2024-08-06")).toEqual({ provider: "openai", model: "gpt-4o-2024-08-06" })
  expect(parseModel(cfg, "no-such-model")).toEqual({ provider: "", model: "no-such-model" })
  // the datasheet names a provider, but none is configured for it
  const only: Config = { providers: new Map() }
  only.providers!.set("anthropic", { keys: [{ value: "k" }] })
  expect(parseModel(only, "gpt-4o")).toEqual({ provider: "", model: "gpt-4o" })
})

test("a model two configured providers serve goes to the route's provider, else the first by name", () => {
  const cfg: Config = { providers: new Map() }
  cfg.providers!.set("openai", { keys: [{ value: "k" }] })
  cfg.providers!.set("azure", { keys: [{ value: "k" }] })
  expect(parseModel(cfg, "gpt-4o")).toEqual({ provider: "azure", model: "gpt-4o" })
  expect(parseModelVia(cfg, "gpt-4o", "openai")).toEqual({ provider: "openai", model: "gpt-4o" })
  expect(parseModelVia(cfg, "gpt-4o", "genai")).toEqual({ provider: "azure", model: "gpt-4o" })
})

test("a key's alias name counts as a model for bare-name resolution", () => {
  const aliases: Map<string, string | AliasTarget> = new Map()
  aliases.set("house-model", "mystery-7")
  const cfg: Config = { providers: new Map() }
  cfg.providers!.set("mygw", { keys: [{ value: "k", aliases: aliases }], custom_provider_config: { base_provider_type: "openai" } })
  expect(parseModel(cfg, "House-Model")).toEqual({ provider: "mygw", model: "House-Model" })
})

test("chained key aliases resolve to the final name; cycles fail the key", () => {
  const chain: Map<string, string | AliasTarget> = new Map()
  chain.set("a", "b")
  chain.set("b", "c")
  const loop: Map<string, string | AliasTarget> = new Map()
  loop.set("x", "y")
  loop.set("y", "x")
  const cfg: Config = { providers: new Map() }
  cfg.providers!.set("openai", { keys: [{ value: "k", models: ["c"], aliases: chain }] })
  const none: Set<int> = new Set()
  expect(target(cfg, { provider: "openai", model: "a" }, none, undefined)!.t.model).toBe("c")
  expect(target(cfg, { provider: "openai", model: "c" }, none, undefined)!.t.model).toBe("c")
  expect(aliasProblems(cfg)).toEqual([])
  const bad: Config = { providers: new Map() }
  bad.providers!.set("openai", { keys: [{ name: "k1", value: "k", models: ["x"], aliases: loop }] })
  expect(target(bad, { provider: "openai", model: "x" }, none, undefined)).toBeUndefined()
  expect(aliasProblems(bad)).toEqual(["openai key k1: alias cycle: x -> y -> x"])
})

test("weighted key choice respects models and exclusions", () => {
  const keys: KeyConfig[] = [{ value: "a", models: ["m1"], weight: 1.0 }, { value: "b", weight: 3.0 }, { value: "c", name: "pin", weight: 0.0 }]
  const none: Set<int> = new Set()
  let b = 0
  for (let i = 0; i < 2000; i++) {
    const k = pickKey(keys, "m1", none, undefined)
    if (k === 1) b += 1
  }
  // b has 3/4 of the weight for m1
  expect(b > 1300 && b < 1700).toBe(true)
  expect(pickKey(keys, "m2", none, undefined)).toBe(1)
  const ex: Set<int> = new Set()
  ex.add(1)
  expect(pickKey(keys, "m2", ex, undefined)).toBe(2)
  expect(pickKey(keys, "m2", none, "pin")).toBe(2)
})

test("aliases map a request model to each key's own name", () => {
  const aliases: Map<string, string | AliasTarget> = new Map()
  aliases.set("fast", "gpt-4o-mini-2024-07-18")
  const cfg: Config = { providers: new Map() }
  cfg.providers!.set("openai", { keys: [{ value: "k", models: ["gpt-4o"], aliases: aliases }] })
  const none: Set<int> = new Set()
  const sel = target(cfg, { provider: "openai", model: "fast" }, none, undefined)
  expect(sel!.t.model).toBe("gpt-4o-mini-2024-07-18")
  expect(target(cfg, { provider: "openai", model: "gpt-4o" }, none, undefined)!.t.model).toBe("gpt-4o")
  expect(target(cfg, { provider: "openai", model: "other" }, none, undefined)).toBeUndefined()
})

test("open breakers take keys out of rotation", () => {
  const cfg: Config = { providers: new Map(), health: { circuit_breaker: true } }
  cfg.providers!.set("openai", { keys: [{ name: "a", value: "1" }, { name: "b", value: "2" }] })
  const h = new Health()
  for (let i = 0; i < 5; i++) h.record("openai#a", false, 0.0, Date.now())
  const none: Set<int> = new Set()
  for (let i = 0; i < 50; i++) expect(target(cfg, { provider: "openai", model: "m" }, none, undefined, h)!.t.key.name).toBe("b")
  for (let i = 0; i < 5; i++) h.record("openai#b", false, 0.0, Date.now())
  expect(target(cfg, { provider: "openai", model: "m" }, none, undefined, h)).toBeUndefined()
  // pinning bypasses health
  expect(target(cfg, { provider: "openai", model: "m" }, none, "a", h)!.t.key.name).toBe("a")
})

test("adaptive weights favor the faster key", () => {
  const cfg: Config = { providers: new Map(), health: { adaptive: true } }
  cfg.providers!.set("openai", { keys: [{ name: "fast", value: "1" }, { name: "slow", value: "2" }] })
  const h = new Health()
  const now = Date.now()
  for (let i = 0; i < 20; i++) {
    h.record("openai#fast", true, 100.0, now)
    h.record("openai#slow", true, 1000.0, now)
  }
  const none: Set<int> = new Set()
  let fast = 0
  for (let i = 0; i < 1000; i++) {
    if (target(cfg, { provider: "openai", model: "m" }, none, undefined, h)!.t.key.name === "fast") fast += 1
  }
  // weights 1.0 vs 0.1: about 91% fast
  expect(fast > 850).toBe(true)
})

test("classifies failures and backs off", () => {
  expect(classify(429)).toBe("retry")
  expect(classify(503)).toBe("retry")
  expect(classify(401)).toBe("rotate")
  expect(classify(400)).toBe("fail")
  expect(classify(404)).toBe("fallback")
  const p: ProviderConfig = { network_config: { retry_backoff_initial: 100, retry_backoff_max: 300 } }
  const d = backoffMs(p, 3, undefined)
  expect(d >= 240 && d <= 360).toBe(true)
  expect(backoffMs(p, 0, "2")).toBe(2000)
})

test("directions: a broken pinned provider is rerouted, healthy ones are appended, broken fallbacks pruned", () => {
  const cfg: Config = { providers: new Map(), health: { adaptive: true, reroute_failed_directions: true, prune_failed_fallbacks: true } }
  cfg.providers!.set("openai", { keys: [{ name: "o", value: "1", models: ["gpt-x"] }] })
  cfg.providers!.set("groq", { keys: [{ name: "g", value: "2", models: ["gpt-x"] }] })
  cfg.providers!.set("mistral", { keys: [{ name: "m", value: "3", models: ["other"] }] })
  cfg.providers!.set("azure", { keys: [{ name: "a", value: "4", models: ["gpt-x"] }] })
  const h = new Health()
  const now = Date.now()
  const pin: ModelRef[] = [{ provider: "openai", model: "gpt-x" }]
  expect(eligibleProviders(cfg, "gpt-x").join(",")).toBe("openai,groq,azure")
  const o = directionOpts(cfg)
  expect(o.select && o.reroute && o.prune && !o.append).toBe(true)
  // healthy and pinned, append off: untouched
  expect(directRefs(cfg, pin, true, h, o, now).length).toBe(1)
  // the pinned provider's only key opens its breaker: rerouted, and the healthy ones follow
  for (let i = 0; i < 5; i++) h.record("openai#o", false, 0.0, now)
  expect(directionHealthy(cfg, pin[0]!, h, now)).toBe(false)
  const r = directRefs(cfg, pin, true, h, o, now)
  expect(r.map((x) => x.provider).join(",")).toBe("groq,azure")
  // a broken fallback is pruned
  for (let i = 0; i < 5; i++) h.record("azure#a", false, 0.0, now)
  const withFb: ModelRef[] = [{ provider: "groq", model: "gpt-x" }, { provider: "azure", model: "gpt-x" }]
  const pruned = directRefs(cfg, withFb, true, h, { select: true, append: true, reroute: false, prune: true }, now)
  expect(pruned.map((x) => x.provider).join(",")).toBe("groq")
  // with nothing healthy the pinned provider is kept
  for (let i = 0; i < 5; i++) h.record("groq#g", false, 0.0, now)
  expect(directRefs(cfg, pin, true, h, o, now).map((x) => x.provider).join(",")).toBe("openai")
  // adaptive off: nothing changes
  const off: Config = { providers: cfg.providers, health: { adaptive: false, reroute_failed_directions: true } }
  expect(directionOpts(off).select).toBe(false)
  expect(directRefs(cfg, pin, true, h, directionOpts(off), now).length).toBe(1)
})

test("directions: an unpinned request takes a healthy provider, and append gives a pinned one fallbacks", () => {
  const cfg: Config = { providers: new Map(), health: { adaptive: true, append_fallbacks_to_pinned: true } }
  cfg.providers!.set("openai", { keys: [{ name: "o", value: "1", models: ["gpt-x"] }] })
  cfg.providers!.set("groq", { keys: [{ name: "g", value: "2", models: ["gpt-x"] }] })
  const h = new Health()
  const now = Date.now()
  const pin: ModelRef[] = [{ provider: "openai", model: "gpt-x" }]
  expect(directRefs(cfg, pin, true, h, directionOpts(cfg), now).map((x) => x.provider).join(",")).toBe("openai,groq")
  h.holds.settle("openai#o", "gpt-x", "refused", "credential", "bad key", undefined, now, 0.5)
  const un = directRefs(cfg, pin, false, h, { select: true, append: false, reroute: false, prune: false }, now)
  expect(un.map((x) => x.provider).join(",")).toBe("groq")
})
