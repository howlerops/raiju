// HTTP/2 (RFC 9113) on raw sockets: a client for unary gRPC, over plaintext with prior
// knowledge (h2c), or over TLS with ALPN "h2" (the server must pick it), and the server
// side that serves h2c. Tov's fetch speaks HTTP/1.1 only, so both run on Bun.connect and
// Bun.listen. HPACK is in hpack.tov.

import { HpackDecoder, HpackEncoder, HpackField, hpackEncode } from "./hpack"

export type H2Header = { name: string, value: string }

export type H2Response = { headers: H2Header[], trailers: H2Header[], body: u8[] }

// TLS for a connection: the CA certificate (PEM, "" for the system roots) and whether the
// server's certificate is checked.
export type H2Tls = { ca: string, verify: bool }

const PREFACE = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

const T_DATA: int = 0
const T_HEADERS: int = 1
const T_RST_STREAM: int = 3
const T_SETTINGS: int = 4
const T_PUSH_PROMISE: int = 5
const T_PING: int = 6
const T_GOAWAY: int = 7
const T_WINDOW_UPDATE: int = 8
const T_CONTINUATION: int = 9

const F_END_STREAM: int = 1
const F_ACK: int = 1
const F_END_HEADERS: int = 4
const F_PADDED: int = 8
const F_PRIORITY: int = 0x20

const ERR_CANCEL: int = 8
const DEFAULT_WINDOW: int = 65535
const DEFAULT_FRAME: int = 16384
const MAX_FRAME: int = 16777215

// ---- frames ----

// One frame: the 9-byte header, then the payload.
export function frameBytes(type: int, flags: int, sid: int, payload: u8[]): u8[] {
  const n = payload.length
  const out: u8[] = [
    u8((n >> 16) & 255), u8((n >> 8) & 255), u8(n & 255),
    u8(type), u8(flags),
    u8((sid >> 24) & 127), u8((sid >> 16) & 255), u8((sid >> 8) & 255), u8(sid & 255),
  ]
  for (const b of payload) out.push(b)
  return out
}

// A 32-bit big-endian value (window increments, error codes, ping data).
function be32(v: int): u8[] {
  return [u8((v >> 24) & 255), u8((v >> 16) & 255), u8((v >> 8) & 255), u8(v & 255)]
}

function read32(p: u8[], at: int): int {
  return (int(p[at]!) << 24) | (int(p[at + 1]!) << 16) | (int(p[at + 2]!) << 8) | int(p[at + 3]!)
}

// ---- the connection ----

// One request waiting for its response. The socket's events resolve it.
class H2Stream {
  headers: H2Header[] | undefined = undefined
  trailers: H2Header[] | undefined = undefined
  body: u8[] = []
  window: int = DEFAULT_WINDOW
  block: u8[] = []
  endStream: bool = false

  constructor(readonly id: int, readonly resolve: (r: H2Response) => void, readonly reject: (e: Error) => void) {}
}

// A single HTTP/2 connection to host:port. Requests run concurrently, one stream each.
// The connection opens on first use, and reopens after the peer closes it.
export class H2Conn {
  private sock: Socket<undefined> | undefined = undefined
  private connecting: Promise<void, Error> | undefined = undefined
  private rbuf: u8[] = []
  private dec: HpackDecoder = new HpackDecoder()
  private streams: Map<int, H2Stream> = new Map()
  private nextId: int = 1
  private connWindow: int = DEFAULT_WINDOW
  private initWindow: int = DEFAULT_WINDOW
  private maxFrame: int = DEFAULT_FRAME
  private waiters: (() => void)[] = []
  private contId: int = 0
  // the header block of a cancelled stream, until its END_HEADERS
  private orphan: u8[] = []
  // set when the server did not pick h2 in ALPN: the connection is refused
  private alpnRefused: bool = false

  constructor(readonly host: string, readonly port: int, readonly tls: H2Tls | undefined) {}

  // Sends one request and waits for its response. timeoutMs covers the whole call; past
  // it the stream is cancelled and the call fails with a deadline error.
  async request(headers: H2Header[], body: u8[], timeoutMs: int): Promise<H2Response, Error> {
    try await this.ensure()
    const sid = this.nextId
    this.nextId = this.nextId + 2
    const self = this
    const done = new Promise<H2Response, Error>((resolve, reject) => {
      const st = new H2Stream(sid, resolve, reject)
      st.window = self.initWindow
      self.streams.set(sid, st)
    })
    const timer = setTimeout(() => {
      self.cancel(sid, new Error("grpc: deadline exceeded"))
    }, timeoutMs)
    try {
      this.sendHeaders(sid, headers, body.length === 0)
      if (body.length > 0) {
        try await this.sendBody(sid, body)
      }
      const r = try await done
      clearTimeout(timer)
      return r
    } catch (e) {
      clearTimeout(timer)
      throw e
    }
  }

  // Ends the connection; in-flight requests fail.
  close(): void {
    this.onClose(new Error("grpc: connection closed by client"))
  }

  // Concurrent first callers share one connect.
  private async ensure(): Promise<void, Error> {
    if (this.sock !== undefined) return
    if (this.connecting === undefined) this.connecting = this.open()
    const c = this.connecting
    if (c === undefined) return
    try {
      await c
    } catch (e) {
      this.connecting = undefined
      throw e
    }
  }

  // The preface and our SETTINGS go out as soon as the socket is open. Over TLS the socket
  // must have picked h2 in ALPN, or it is closed and the connect fails.
  private async open(): Promise<void, Error> {
    const self = this
    const t = this.tls
    this.alpnRefused = false
    try await Bun.connect({
      hostname: this.host,
      port: this.port,
      tls: t === undefined ? false : { rejectUnauthorized: t.verify, ca: t.ca, alpn: ["h2"] },
      socket: {
        open(s) {
          if (t !== undefined && s.alpnProtocol !== "h2") {
            self.alpnRefused = true
            s.terminate()
            return
          }
          self.sock = s
          const pre = new TextEncoder().encode(PREFACE)
          const out: u8[] = []
          for (const b of pre) out.push(b)
          // SETTINGS: ENABLE_PUSH (2) = 0, since this client takes no pushed streams
          for (const b of frameBytes(T_SETTINGS, 0, 0, [u8(0), u8(2), u8(0), u8(0), u8(0), u8(0)])) out.push(b)
          self.write(out)
        },
        data(s, bytes) {
          if (s === self.sock) self.onData(bytes)
        },
        close(s) {
          if (s === self.sock) self.onClose(new Error("grpc: connection closed by peer"))
        },
        error(s, e) {
          if (s === self.sock) self.onClose(e)
        },
      },
    })
    if (this.alpnRefused) throw new Error("grpc: the collector did not pick h2 over TLS (ALPN)")
  }

  private write(bytes: u8[]): void {
    const s = this.sock
    if (s !== undefined) s.write(bytes)
  }

  private sendHeaders(sid: int, headers: H2Header[], endStream: bool): void {
    const block = hpackEncode(headers)
    if (block.length > this.maxFrame) throw new Error("grpc: request headers too large")
    const flags = F_END_HEADERS | (endStream ? F_END_STREAM : 0)
    this.write(frameBytes(T_HEADERS, flags, sid, block))
  }

  // The body in DATA frames, within both send windows and the peer's frame size.
  private async sendBody(sid: int, body: u8[]): Promise<void, Error> {
    let off: int = 0
    while (off < body.length) {
      const st = this.streams.get(sid)
      if (st === undefined) throw new Error("grpc: stream closed before the body was sent")
      let room: int = this.connWindow
      if (st.window < room) room = st.window
      if (this.maxFrame < room) room = this.maxFrame
      if (room <= 0) {
        try await this.waitWindow()
        continue
      }
      let n: int = body.length - off
      if (room < n) n = room
      const last = off + n === body.length
      this.connWindow = this.connWindow - n
      st.window = st.window - n
      this.write(frameBytes(T_DATA, last ? F_END_STREAM : 0, sid, body.slice(off, off + n)))
      off = off + n
    }
  }

  private waitWindow(): Promise<void, Error> {
    return new Promise<void, Error>((resolve) => {
      this.waiters.push(() => resolve())
    })
  }

  private wake(): void {
    const ws = this.waiters
    this.waiters = []
    for (const f of ws) f()
  }

  // Ends one stream: its own failure, or a cancellation (RST_STREAM tells the peer).
  private cancel(sid: int, e: Error): void {
    const st = this.streams.get(sid)
    if (st === undefined) return
    this.streams.delete(sid)
    if (this.sock !== undefined) this.write(frameBytes(T_RST_STREAM, 0, sid, be32(ERR_CANCEL)))
    st.reject(e)
    this.wake()
  }

  private onData(bytes: u8[]): void {
    for (const b of bytes) this.rbuf.push(b)
    while (this.rbuf.length >= 9) {
      const n = (int(this.rbuf[0]!) << 16) | (int(this.rbuf[1]!) << 8) | int(this.rbuf[2]!)
      if (this.rbuf.length < 9 + n) return
      const type = int(this.rbuf[3]!)
      const flags = int(this.rbuf[4]!)
      const sid = read32(this.rbuf, 5) & 2147483647
      const payload = this.rbuf.slice(9, 9 + n)
      this.rbuf = this.rbuf.slice(9 + n)
      try {
        this.frame(type, flags, sid, payload)
      } catch (e) {
        this.onClose(e)
        return
      }
      if (this.sock === undefined) return
    }
  }

  // Dispatches one frame. A connection error (throw) closes the connection.
  private frame(type: int, flags: int, sid: int, p: u8[]): void throws Error {
    if (this.contId !== 0 && (type !== T_CONTINUATION || sid !== this.contId)) {
      throw new Error("h2: CONTINUATION expected")
    }
    if (type === T_SETTINGS) {
      if ((flags & F_ACK) !== 0) return
      let at = 0
      while (at + 6 <= p.length) {
        const id = (int(p[at]!) << 8) | int(p[at + 1]!)
        const val = read32(p, at + 2)
        if (id === 4) {
          // a new INITIAL_WINDOW_SIZE moves every open stream's window by the difference
          const delta = val - this.initWindow
          this.initWindow = val
          for (const k of this.streams.keys()) {
            const st = this.streams.get(k)!
            st.window = st.window + delta
          }
        } else if (id === 5) {
          if (val < DEFAULT_FRAME || val > MAX_FRAME) throw new Error("h2: bad SETTINGS_MAX_FRAME_SIZE")
          this.maxFrame = val
        }
        at = at + 6
      }
      this.write(frameBytes(T_SETTINGS, F_ACK, 0, []))
      this.wake()
    } else if (type === T_PING) {
      if ((flags & F_ACK) === 0) this.write(frameBytes(T_PING, F_ACK, 0, p))
    } else if (type === T_GOAWAY) {
      throw new Error("grpc: the peer closed the connection (GOAWAY)")
    } else if (type === T_WINDOW_UPDATE) {
      const inc = read32(p, 0) & 2147483647
      if (sid === 0) {
        this.connWindow = this.connWindow + inc
      } else {
        const st = this.streams.get(sid)
        if (st !== undefined) st.window = st.window + inc
      }
      this.wake()
    } else if (type === T_RST_STREAM) {
      const st = this.streams.get(sid)
      if (st !== undefined) {
        this.streams.delete(sid)
        st.reject(new Error(`h2: stream reset by the peer (code ${read32(p, 0)})`))
        this.wake()
      }
    } else if (type === T_HEADERS) {
      let start: int = 0
      let end: int = p.length
      if ((flags & F_PADDED) !== 0) {
        if (p.length < 1) throw new Error("h2: bad padding")
        start = 1
        end = p.length - int(p[0]!)
      }
      if ((flags & F_PRIORITY) !== 0) start = start + 5
      if (end < start) throw new Error("h2: bad header block")
      const st = this.streams.get(sid)
      const block = p.slice(start, end)
      if (st === undefined) {
        // a cancelled stream's block still updates the table, so it is decoded and dropped
        this.orphan = block
        if ((flags & F_END_HEADERS) !== 0) {
          this.orphan = []
          try this.dec.decode(block)
        } else {
          this.contId = sid
        }
        return
      }
      st.block = block
      st.endStream = (flags & F_END_STREAM) !== 0
      if ((flags & F_END_HEADERS) !== 0) {
        try this.finishBlock(st)
      } else {
        this.contId = sid
      }
    } else if (type === T_CONTINUATION) {
      const st = this.streams.get(sid)
      if (st === undefined) {
        for (const b of p) this.orphan.push(b)
        if ((flags & F_END_HEADERS) !== 0) {
          this.contId = 0
          const blk = this.orphan
          this.orphan = []
          try this.dec.decode(blk)
        }
        return
      }
      for (const b of p) st.block.push(b)
      if ((flags & F_END_HEADERS) !== 0) {
        this.contId = 0
        try this.finishBlock(st)
      }
    } else if (type === T_DATA) {
      let start: int = 0
      let end: int = p.length
      if ((flags & F_PADDED) !== 0) {
        if (p.length < 1) throw new Error("h2: bad padding")
        start = 1
        end = p.length - int(p[0]!)
      }
      if (end < start) throw new Error("h2: bad padding")
      const st = this.streams.get(sid)
      if (st !== undefined) {
        for (let i = start; i < end; i++) st.body.push(p[i]!)
      }
      // the received bytes return to the windows, so the peer keeps sending
      if (p.length > 0) {
        this.write(frameBytes(T_WINDOW_UPDATE, 0, 0, be32(p.length)))
        this.write(frameBytes(T_WINDOW_UPDATE, 0, sid, be32(p.length)))
      }
      if (st !== undefined && (flags & F_END_STREAM) !== 0) this.complete(st)
    } else if (type === T_PUSH_PROMISE) {
      throw new Error("h2: PUSH_PROMISE, though push is off")
    }
    // PRIORITY and unknown frame types are ignored (RFC 9113 4.1)
  }

  // A complete header block: the response headers first, then the trailers.
  private finishBlock(st: H2Stream): void throws Error {
    const fields = try this.dec.decode(st.block)
    st.block = []
    if (st.headers === undefined) {
      st.headers = fields
    } else {
      st.trailers = fields
    }
    if (st.endStream) this.complete(st)
  }

  private complete(st: H2Stream): void {
    this.streams.delete(st.id)
    st.resolve({ headers: st.headers ?? [], trailers: st.trailers ?? [], body: st.body })
    this.wake()
  }

  // The connection is gone: every stream fails with e, and the next request reconnects.
  private onClose(e: Error): void {
    const s = this.sock
    this.sock = undefined
    this.connecting = undefined
    this.rbuf = []
    this.contId = 0
    this.orphan = []
    this.dec = new HpackDecoder()
    for (const id of this.streams.keys()) {
      const st = this.streams.get(id)!
      st.reject(e)
    }
    this.streams = new Map()
    this.wake()
    if (s !== undefined) s.end()
  }
}

// ---- the server ----

// Error codes (RFC 9113 7). A connection error ends the connection with GOAWAY; a stream
// error ends one stream with RST_STREAM.
export const H2_NO_ERROR: int = 0
export const H2_PROTOCOL_ERROR: int = 1
export const H2_INTERNAL_ERROR: int = 2
export const H2_FLOW_CONTROL_ERROR: int = 3
export const H2_STREAM_CLOSED: int = 5
export const H2_FRAME_SIZE_ERROR: int = 6
export const H2_REFUSED_STREAM: int = 7
export const H2_CANCEL: int = 8
export const H2_COMPRESSION_ERROR: int = 9
export const H2_ENHANCE_YOUR_CALM: int = 11

const MAX_WINDOW: int = 2147483647
// queued response bytes above which a write waits for the peer
const OUT_HIGH: int = 65536
// a header block (HEADERS with its CONTINUATIONs) larger than this is refused
const MAX_BLOCK: int = 262144

// A protocol error found while reading a frame: stream 0 is a connection error, any other
// id a stream error.
class H2Fault extends Error {
  constructor(readonly code: int, readonly stream: int, message: string) {
    super(message)
  }
}

// What the server hands a handler for one request.
export type H2Request = { method: string, path: string, scheme: string, authority: string, headers: H2Header[], body: H2Body }

// The handler runs once per request, when its headers are in. It answers through res.
export type H2Handler = (req: H2Request, res: H2Reply) => void throws Error

// The request body of one stream, in the pieces DATA frames brought. next() hands the
// pieces out one at a time and gives the window back as it goes, so a handler that is
// behind holds the peer back: the windows bound what is held.
export class H2Body {
  private chunks: u8[][] = []
  private queued: int = 0
  private done: bool = false
  private failed: string = ""
  private dropping: bool = false
  private waiter: ((n: int) => void) | undefined = undefined
  weak sess: H2Session | undefined

  constructor(sess: H2Session, readonly sid: int) {
    this.sess = sess
  }

  // The next piece, or undefined at the end. Throws when the stream is reset or the
  // connection is lost before the end.
  async next(): Promise<u8[] | undefined> throws Error {
    while (true) {
      const c = this.chunks.shift()
      if (c !== undefined) {
        this.queued = this.queued - c.length
        const s = this.sess
        if (s !== undefined) s.credit(this.sid, c.length)
        return c
      }
      if (this.failed !== "") throw new Error(this.failed)
      if (this.done) return undefined
      await new Promise<int>((resolve) => {
        this.waiter = resolve
      })
    }
  }

  // A DATA payload from the peer. False when the body was discarded: the caller gives the
  // window back then.
  push(b: u8[]): bool {
    if (this.dropping) return false
    this.chunks.push(b)
    this.queued = this.queued + b.length
    this.wake()
    return true
  }

  // The peer's end of the body.
  finish(): void {
    this.done = true
    this.wake()
  }

  // The stream is reset or the connection lost.
  fail(msg: string): void {
    if (this.done || this.failed !== "") return
    this.failed = msg
    this.wake()
  }

  // The handler has no use for the rest. What is held is dropped; the bytes given back are
  // returned so the caller can credit them.
  discard(): int {
    const n = this.queued
    this.dropping = true
    this.chunks = []
    this.queued = 0
    if (!this.done && this.failed === "") this.failed = "h2: the request body was discarded"
    this.wake()
    return n
  }

  private wake(): void {
    const w = this.waiter
    if (w !== undefined) {
      this.waiter = undefined
      w(0)
    }
  }
}

// The response of one stream. Writes queue on the stream and go out as the windows allow;
// write() waits while more than OUT_HIGH bytes are queued.
export class H2Reply {
  weak sess: H2Session | undefined

  constructor(sess: H2Session, readonly sid: int) {
    this.sess = sess
  }

  // The response head. Without :status it is 200. Sent once.
  headers(hs: H2Header[]): void {
    const s = this.sess
    if (s !== undefined) s.respond(this.sid, hs, false)
  }

  // A piece of the response body (the head goes first if it has not).
  async write(b: u8[]): Promise<void, Error> {
    const s = this.sess
    if (s === undefined) throw new Error("h2: the connection is gone")
    s.respond(this.sid, [], false)
    try s.queue(this.sid, b)
    try await s.drained(this.sid)
  }

  // Ends the response; trailers are sent after the body when given.
  end(trailers: H2Header[] | undefined): void {
    const s = this.sess
    if (s !== undefined) s.endResponse(this.sid, trailers)
  }

  // A head that is also the end of the response (a trailers-only response).
  trailersOnly(hs: H2Header[]): void {
    const s = this.sess
    if (s !== undefined) s.respond(this.sid, hs, true)
  }

  // Resets the stream with a code.
  reset(code: int): void {
    const s = this.sess
    if (s !== undefined) s.resetStream(this.sid, code)
  }
}

// One stream: the request's header block while it arrives, its body, its reply, and the
// flow-control windows both ways.
class SrvStream {
  body: H2Body
  reply: H2Reply
  // the peer's window for our DATA, and our window for the peer's DATA
  sendWindow: int
  recvWindow: int
  block: u8[] = []
  endStream: bool = false
  headersDone: bool = false
  // refused by the stream limit or a GOAWAY: the block is decoded and the stream reset
  refused: bool = false
  responded: bool = false
  endPending: bool = false
  finished: bool = false
  ended: bool = false
  trailers: H2Header[] | undefined = undefined
  out: u8[] = []
  off: int = 0
  waiters: (() => void)[] = []

  constructor(readonly id: int, sess: H2Session, sendWindow: int, recvWindow: int) {
    this.body = new H2Body(sess, id)
    this.reply = new H2Reply(sess, id)
    this.sendWindow = sendWindow
    this.recvWindow = recvWindow
  }

  queued(): int {
    return this.out.length - this.off
  }
}

// The payload without its padding (flag PADDED). Padding longer than the rest is a
// connection error.
function unpad(p: u8[], flags: int): u8[] throws H2Fault {
  if ((flags & F_PADDED) === 0) return p
  if (p.length < 1 || int(p[0]!) >= p.length) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: bad padding")
  return p.slice(1, p.length - int(p[0]!))
}

// One HTTP/2 connection on the server side. Frames are read as the socket delivers them;
// the streams run their handlers as their headers complete.
cyclic class H2Session {
  sock: Socket<H2Session> | undefined = undefined
  closed: bool = false
  private pre: u8[] = []
  private preLeft: int = 24
  private rbuf: u8[] = []
  private settingsSeen: bool = false
  private dec: HpackDecoder = new HpackDecoder()
  private enc: HpackEncoder = new HpackEncoder()
  private streams: Map<int, SrvStream> = new Map()
  private lastId: int = 0
  // the peer's SETTINGS_INITIAL_WINDOW_SIZE and SETTINGS_MAX_FRAME_SIZE
  private peerInit: int = DEFAULT_WINDOW
  private peerMaxFrame: int = DEFAULT_FRAME
  // the connection's windows: for our DATA to the peer, and for the peer's DATA to us
  private connWindow: int = DEFAULT_WINDOW
  private recvWindow: int = DEFAULT_WINDOW
  // the stream whose header block continues in CONTINUATION frames, or 0
  private contId: int = 0
  // the peer sent GOAWAY: no new streams, and the connection closes when the last one ends
  private goneAway: bool = false

  constructor(readonly handler: H2Handler, readonly maxStreams: int) {
    this.pre = new TextEncoder().encode(PREFACE)
  }

  // The server's SETTINGS: the stream limit. The rest stays at the protocol's defaults.
  start(): void {
    const st: u8[] = [u8(0), u8(3)]
    for (const b of be32(this.maxStreams)) st.push(b)
    this.write(frameBytes(T_SETTINGS, 0, 0, st))
  }

  // Bytes from the socket: the client preface first, then frames.
  feed(bytes: u8[]): void {
    if (this.closed) return
    let i: int = 0
    while (this.preLeft > 0 && i < bytes.length) {
      if (int(bytes[i]!) !== int(this.pre[this.pre.length - this.preLeft]!)) {
        this.goaway(H2_PROTOCOL_ERROR, "h2: bad client preface")
        return
      }
      this.preLeft = this.preLeft - 1
      i = i + 1
    }
    for (let j = i; j < bytes.length; j++) this.rbuf.push(bytes[j]!)
    this.parse()
  }

  // Credits n bytes of the request body that the handler took: the peer may send n more on
  // the connection and on the stream.
  credit(sid: int, n: int): void {
    if (n <= 0 || this.closed) return
    this.recvWindow = this.recvWindow + n
    this.write(frameBytes(T_WINDOW_UPDATE, 0, 0, be32(n)))
    const st = this.streams.get(sid)
    if (st !== undefined) {
      st.recvWindow = st.recvWindow + n
      this.write(frameBytes(T_WINDOW_UPDATE, 0, sid, be32(n)))
    }
  }

  // The response head for stream sid, once. endStream makes it the whole response.
  respond(sid: int, hs: H2Header[], endStream: bool): void {
    const st = this.streams.get(sid)
    if (st === undefined || st.responded) return
    st.responded = true
    const fields: HpackField[] = []
    let hasStatus = false
    for (const h of hs) {
      if (h.name === ":status") hasStatus = true
    }
    if (!hasStatus) fields.push({ name: ":status", value: "200" })
    for (const h of hs) fields.push(h)
    this.sendBlock(sid, this.enc.encode(fields), endStream)
    if (endStream) {
      st.finished = true
      this.afterEnd(st)
    } else {
      this.pump(st)
    }
  }

  // Queues response body bytes. Throws when the response is already ended or the stream is gone.
  queue(sid: int, b: u8[]): void throws Error {
    const st = this.streams.get(sid)
    if (st === undefined || st.finished || st.endPending) throw new Error("h2: the response is finished")
    if (st.off > 0) {
      st.out = st.out.slice(st.off)
      st.off = 0
    }
    for (const x of b) st.out.push(x)
    this.pump(st)
  }

  // Waits until the stream's queue is under OUT_HIGH. Throws when the stream is gone.
  async drained(sid: int): Promise<void, Error> {
    while (true) {
      const st = this.streams.get(sid)
      if (st === undefined) throw new Error("h2: the stream is closed")
      if (st.queued() <= OUT_HIGH) return
      await new Promise<void, Error>((resolve) => {
        st.waiters.push(() => resolve())
      })
    }
  }

  // The end of the response, with trailers when given.
  endResponse(sid: int, trailers: H2Header[] | undefined): void {
    const st = this.streams.get(sid)
    if (st === undefined || st.finished || st.endPending) return
    if (!st.responded) this.respond(sid, [], false)
    st.endPending = true
    st.trailers = trailers
    this.pump(st)
  }

  // Resets a stream: RST_STREAM goes out and its request body fails.
  resetStream(sid: int, code: int): void {
    if (this.streams.get(sid) === undefined) return
    this.streamError(sid, code)
  }

  // The socket closed: every stream fails.
  detach(): void {
    this.closed = true
    this.sock = undefined
    this.failAll("h2: the connection closed")
  }

  // Reads the frames that are whole in rbuf.
  private parse(): void {
    const b = this.rbuf
    let pos: int = 0
    while (!this.closed && b.length - pos >= 9) {
      const n = (int(b[pos]!) << 16) | (int(b[pos + 1]!) << 8) | int(b[pos + 2]!)
      if (n > DEFAULT_FRAME) {
        this.goaway(H2_FRAME_SIZE_ERROR, "h2: frame too large")
        break
      }
      if (b.length - pos < 9 + n) break
      const type = int(b[pos + 3]!)
      const flags = int(b[pos + 4]!)
      const sid = read32(b, pos + 5) & 2147483647
      const payload = b.slice(pos + 9, pos + 9 + n)
      pos = pos + 9 + n
      try {
        this.frame(type, flags, sid, payload)
      } catch (e) {
        if (e instanceof H2Fault) {
          if (e.stream === 0) this.goaway(e.code, e.message)
          else this.streamError(e.stream, e.code)
        } else {
          this.goaway(H2_INTERNAL_ERROR, "h2: internal error")
        }
      }
    }
    if (!this.closed) this.rbuf = b.slice(pos)
  }

  private frame(type: int, flags: int, sid: int, p: u8[]): void throws H2Fault {
    if (this.contId !== 0 && (type !== T_CONTINUATION || sid !== this.contId)) {
      throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: CONTINUATION expected")
    }
    if (!this.settingsSeen && type !== T_SETTINGS) {
      throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: SETTINGS expected first")
    }
    if (type === T_DATA) {
      try this.onData(flags, sid, p)
    } else if (type === T_HEADERS) {
      try this.onHeaders(flags, sid, p)
    } else if (type === T_CONTINUATION) {
      try this.onContinuation(flags, sid, p)
    } else if (type === T_SETTINGS) {
      try this.onSettings(flags, sid, p)
    } else if (type === T_PING) {
      if (sid !== 0) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: PING on a stream")
      if (p.length !== 8) throw new H2Fault(H2_FRAME_SIZE_ERROR, 0, "h2: PING length")
      if ((flags & F_ACK) === 0) this.write(frameBytes(T_PING, F_ACK, 0, p))
    } else if (type === T_WINDOW_UPDATE) {
      try this.onWindowUpdate(sid, p)
    } else if (type === T_RST_STREAM) {
      if (sid === 0) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: RST_STREAM on stream 0")
      if (p.length !== 4) throw new H2Fault(H2_FRAME_SIZE_ERROR, 0, "h2: RST_STREAM length")
      this.dropStream(sid, `h2: the stream was reset by the client (code ${read32(p, 0)})`)
    } else if (type === T_GOAWAY) {
      if (sid !== 0) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: GOAWAY on a stream")
      this.goneAway = true
      this.maybeClose()
    } else if (type === T_PUSH_PROMISE) {
      throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: a client cannot send PUSH_PROMISE")
    }
    // PRIORITY and unknown frame types are ignored (RFC 9113 4.1)
  }

  private onData(flags: int, sid: int, p: u8[]): void throws H2Fault {
    if (sid === 0) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: DATA on stream 0")
    // the whole payload, padding included, counts against the connection window
    this.recvWindow = this.recvWindow - p.length
    if (this.recvWindow < 0) throw new H2Fault(H2_FLOW_CONTROL_ERROR, 0, "h2: the connection window is overrun")
    const data = try unpad(p, flags)
    const st = this.streams.get(sid)
    if (st === undefined) {
      // a stream that is gone: its bytes are given back at once
      this.credit(sid, p.length)
      return
    }
    st.recvWindow = st.recvWindow - p.length
    if (st.recvWindow < 0) throw new H2Fault(H2_FLOW_CONTROL_ERROR, sid, "h2: the stream window is overrun")
    if (st.ended) throw new H2Fault(H2_STREAM_CLOSED, sid, "h2: DATA after END_STREAM")
    const pad = p.length - data.length
    if (pad > 0) this.credit(sid, pad)
    if (data.length > 0 && !st.body.push(data)) this.credit(sid, data.length)
    if ((flags & F_END_STREAM) !== 0) this.endRequest(st)
  }

  private onHeaders(flags: int, sid: int, p: u8[]): void throws H2Fault {
    if (sid === 0) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: HEADERS on stream 0")
    let block = try unpad(p, flags)
    if ((flags & F_PRIORITY) !== 0) {
      if (block.length < 5) throw new H2Fault(H2_FRAME_SIZE_ERROR, 0, "h2: short PRIORITY fields")
      block = block.slice(5)
    }
    const old = this.streams.get(sid)
    if (old !== undefined) {
      // trailers of a request whose headers are in
      if (old.ended) throw new H2Fault(H2_STREAM_CLOSED, sid, "h2: HEADERS after END_STREAM")
      if ((flags & F_END_STREAM) === 0) throw new H2Fault(H2_PROTOCOL_ERROR, sid, "h2: trailers without END_STREAM")
      old.block = block
      old.endStream = true
      if ((flags & F_END_HEADERS) !== 0) try this.finishBlock(old)
      else this.contId = sid
      return
    }
    if (sid <= this.lastId) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: stream id out of order")
    this.lastId = sid
    const st = new SrvStream(sid, this, this.peerInit, DEFAULT_WINDOW)
    st.refused = this.goneAway || this.streams.size >= this.maxStreams
    st.endStream = (flags & F_END_STREAM) !== 0
    st.block = block
    this.streams.set(sid, st)
    if ((flags & F_END_HEADERS) !== 0) try this.finishBlock(st)
    else this.contId = sid
  }

  private onContinuation(flags: int, sid: int, p: u8[]): void throws H2Fault {
    const st = this.streams.get(sid)
    if (this.contId === 0 || st === undefined) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: unexpected CONTINUATION")
    for (const b of p) st.block.push(b)
    if (st.block.length > MAX_BLOCK) throw new H2Fault(H2_ENHANCE_YOUR_CALM, 0, "h2: header block too large")
    if ((flags & F_END_HEADERS) !== 0) {
      this.contId = 0
      try this.finishBlock(st)
    }
  }

  private onSettings(flags: int, sid: int, p: u8[]): void throws H2Fault {
    if (sid !== 0) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: SETTINGS on a stream")
    if ((flags & F_ACK) !== 0) {
      if (p.length !== 0) throw new H2Fault(H2_FRAME_SIZE_ERROR, 0, "h2: SETTINGS ACK with a payload")
      return
    }
    if (p.length % 6 !== 0) throw new H2Fault(H2_FRAME_SIZE_ERROR, 0, "h2: SETTINGS length")
    let at: int = 0
    while (at + 6 <= p.length) {
      const id = (int(p[at]!) << 8) | int(p[at + 1]!)
      const val = read32(p, at + 2)
      if (id === 1) {
        // the table our encoder may fill is the one the peer's decoder allows
        this.enc.setMaxSize(val)
      } else if (id === 4) {
        if (val > MAX_WINDOW) throw new H2Fault(H2_FLOW_CONTROL_ERROR, 0, "h2: INITIAL_WINDOW_SIZE too large")
        const delta = val - this.peerInit
        this.peerInit = val
        for (const st of this.streams.values()) {
          st.sendWindow = st.sendWindow + delta
          if (st.sendWindow > MAX_WINDOW) throw new H2Fault(H2_FLOW_CONTROL_ERROR, 0, "h2: stream window overflow")
        }
      } else if (id === 5) {
        if (val < DEFAULT_FRAME || val > MAX_FRAME) throw new H2Fault(H2_PROTOCOL_ERROR, 0, "h2: bad MAX_FRAME_SIZE")
        this.peerMaxFrame = val
      }
      at = at + 6
    }
    this.settingsSeen = true
    this.write(frameBytes(T_SETTINGS, F_ACK, 0, []))
    this.pumpAll()
  }

  private onWindowUpdate(sid: int, p: u8[]): void throws H2Fault {
    if (p.length !== 4) throw new H2Fault(H2_FRAME_SIZE_ERROR, 0, "h2: WINDOW_UPDATE length")
    const inc = read32(p, 0) & 2147483647
    if (inc === 0) throw new H2Fault(H2_PROTOCOL_ERROR, sid, "h2: WINDOW_UPDATE of 0")
    if (sid === 0) {
      this.connWindow = this.connWindow + inc
      if (this.connWindow > MAX_WINDOW) throw new H2Fault(H2_FLOW_CONTROL_ERROR, 0, "h2: connection window overflow")
      this.pumpAll()
      return
    }
    const st = this.streams.get(sid)
    if (st === undefined) return
    st.sendWindow = st.sendWindow + inc
    if (st.sendWindow > MAX_WINDOW) throw new H2Fault(H2_FLOW_CONTROL_ERROR, sid, "h2: stream window overflow")
    this.pump(st)
  }

  // A complete header block: a new request's headers, or the trailers of one.
  private finishBlock(st: SrvStream): void throws H2Fault {
    const block = st.block
    st.block = []
    let fields: HpackField[] = []
    try {
      fields = this.dec.decode(block)
    } catch (e) {
      throw new H2Fault(H2_COMPRESSION_ERROR, 0, "h2: bad header block")
    }
    if (st.headersDone) {
      st.trailers = fields
      if (!st.endStream) throw new H2Fault(H2_PROTOCOL_ERROR, st.id, "h2: trailers without END_STREAM")
      this.endRequest(st)
      return
    }
    st.headersDone = true
    if (st.refused) {
      this.streams.delete(st.id)
      st.body.discard()
      this.write(frameBytes(T_RST_STREAM, 0, st.id, be32(H2_REFUSED_STREAM)))
      this.maybeClose()
      return
    }
    let method = ""
    let path = ""
    let scheme = ""
    let authority = ""
    const hs: H2Header[] = []
    for (const f of fields) {
      if (f.name === ":method") method = f.value
      else if (f.name === ":path") path = f.value
      else if (f.name === ":scheme") scheme = f.value
      else if (f.name === ":authority") authority = f.value
      else if (!f.name.startsWith(":")) hs.push({ name: f.name, value: f.value })
    }
    if (method === "" || path === "") throw new H2Fault(H2_PROTOCOL_ERROR, st.id, "h2: a request needs :method and :path")
    if (st.endStream) this.endRequest(st)
    const req: H2Request = { method: method, path: path, scheme: scheme, authority: authority, headers: hs, body: st.body }
    try {
      this.handler(req, st.reply)
    } catch (e) {
      st.reply.reset(H2_INTERNAL_ERROR)
    }
  }

  // The peer's end of the request body.
  private endRequest(st: SrvStream): void {
    st.ended = true
    st.body.finish()
    this.maybeRemove(st)
  }

  // Sends what the windows allow of a stream's queued response, then its end.
  private pump(st: SrvStream): void {
    if (st.responded && !st.finished) {
      while (st.off < st.out.length && this.connWindow > 0 && st.sendWindow > 0) {
        let n: int = st.out.length - st.off
        if (n > this.connWindow) n = this.connWindow
        if (n > st.sendWindow) n = st.sendWindow
        if (n > this.peerMaxFrame) n = this.peerMaxFrame
        this.write(frameBytes(T_DATA, 0, st.id, st.out.slice(st.off, st.off + n)))
        st.off = st.off + n
        this.connWindow = this.connWindow - n
        st.sendWindow = st.sendWindow - n
      }
      if (st.off >= st.out.length) {
        st.out = []
        st.off = 0
      }
      if (st.endPending && st.off >= st.out.length) {
        st.finished = true
        st.endPending = false
        const tr = st.trailers
        if (tr !== undefined) this.sendBlock(st.id, this.enc.encode(tr), true)
        else this.write(frameBytes(T_DATA, F_END_STREAM, st.id, []))
        this.afterEnd(st)
      }
    }
    this.wakeAll(st)
  }

  // The response has ended. The request body is given up (what comes of it is credited as
  // it arrives), and a request the peer has not ended is reset with NO_ERROR.
  private afterEnd(st: SrvStream): void {
    const freed = st.body.discard()
    this.credit(st.id, freed)
    if (!st.ended) {
      st.ended = true
      this.write(frameBytes(T_RST_STREAM, 0, st.id, be32(H2_NO_ERROR)))
    }
    this.maybeRemove(st)
  }

  private pumpAll(): void {
    for (const st of this.streams.values()) this.pump(st)
  }

  private maybeRemove(st: SrvStream): void {
    if (st.finished && st.ended) {
      this.streams.delete(st.id)
      this.wakeAll(st)
      this.maybeClose()
    }
  }

  // A stream error: the stream is dropped and reset.
  private streamError(sid: int, code: int): void {
    this.dropStream(sid, `h2: the stream failed (code ${code})`)
    this.write(frameBytes(T_RST_STREAM, 0, sid, be32(code)))
  }

  // Forgets a stream; its request body fails with msg.
  private dropStream(sid: int, msg: string): void {
    const st = this.streams.get(sid)
    if (st === undefined) return
    this.streams.delete(sid)
    st.finished = true
    st.body.fail(msg)
    this.wakeAll(st)
    this.maybeClose()
  }

  // Connection error: GOAWAY with the last stream the peer opened, then the socket closes
  // once that is out.
  private goaway(code: int, msg: string): void {
    if (this.closed) return
    const body: u8[] = be32(this.lastId)
    for (const x of be32(code)) body.push(x)
    for (const x of new TextEncoder().encode(msg)) body.push(x)
    this.write(frameBytes(T_GOAWAY, 0, 0, body))
    this.shut()
  }

  // The peer's GOAWAY was answered and no stream is left: the connection closes.
  private maybeClose(): void {
    if (this.goneAway && this.streams.size === 0 && !this.closed) this.goaway(H2_NO_ERROR, "")
  }

  private shut(): void {
    this.closed = true
    const s = this.sock
    this.sock = undefined
    if (s !== undefined) s.end()
    this.failAll("h2: the connection closed")
  }

  private failAll(msg: string): void {
    for (const id of this.streams.keys()) {
      const st = this.streams.get(id)!
      st.body.fail(msg)
      this.wakeAll(st)
    }
    this.streams = new Map()
  }

  // Sends a header block (CONTINUATION frames when it is larger than a frame).
  private sendBlock(sid: int, block: u8[], endStream: bool): void {
    let off: int = 0
    let first = true
    while (true) {
      let n: int = block.length - off
      if (n > this.peerMaxFrame) n = this.peerMaxFrame
      const last = off + n >= block.length
      let flags: int = 0
      if (last) flags = flags | F_END_HEADERS
      if (first && endStream) flags = flags | F_END_STREAM
      this.write(frameBytes(first ? T_HEADERS : T_CONTINUATION, flags, sid, block.slice(off, off + n)))
      off = off + n
      first = false
      if (last) break
    }
  }

  private wakeAll(st: SrvStream): void {
    const ws = st.waiters
    st.waiters = []
    for (const f of ws) f()
  }

  private write(bytes: u8[]): void {
    const s = this.sock
    if (s !== undefined && !this.closed) s.write(bytes)
  }
}

// Listens on a port and serves HTTP/2 with prior knowledge (h2c), as grpc-go does without
// TLS. handler answers each request.
export function listen(opts: { hostname: string, port: int, maxStreams?: int }, handler: H2Handler): TCPSocketListener<H2Session> {
  const maxStreams = opts.maxStreams ?? 100
  return Bun.listen<H2Session>({
    hostname: opts.hostname,
    port: opts.port,
    socket: {
      open(socket) {
        const s = new H2Session(handler, maxStreams)
        s.sock = socket
        socket.data = s
        s.start()
      },
      data(socket, bytes) {
        const s = socket.data
        if (s === undefined || s.closed) return
        s.feed(bytes)
      },
      close(socket) {
        const s = socket.data
        if (s !== undefined) s.detach()
        socket.data = undefined
      },
      error(socket) {
        socket.terminate()
      },
    },
  })
}

// ---- tests ----

test("frame header: length, type, flags and stream id", () => {
  const f = frameBytes(T_HEADERS, 5, 3, [u8(1), u8(2)])
  expect(f.length).toBe(11)
  expect(f[0]).toBe(u8(0))
  expect(f[1]).toBe(u8(0))
  expect(f[2]).toBe(u8(2))
  expect(f[3]).toBe(u8(1))
  expect(f[4]).toBe(u8(5))
  expect(f[8]).toBe(u8(3))
  expect(f[9]).toBe(u8(1))
})
