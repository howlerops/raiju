// Per-user OAuth for MCP clients of auth_type per_user_oauth (Bifrost's per-user consent). Each caller
// (a virtual key, an x-bf-mcp-session-id in session mode, or an identity-provider user through a user-mode MCP
// token) holds its own token row per client. A caller without a usable token is sent a consent link; the flow it
// opens is held here until the callback returns, and the callback saves the row. The admin's own verification of
// an oauth client (initiate-verification, reauthorize) is a flow of mode "admin" in the same table. Temp tokens
// (client.mcp_enable_temp_token_auth) let the link's owner open the flow's routes without a dashboard session,
// until the flow ends.
//
// The flows and temp tokens are kept in a state file beside config.json (openFlowState), with each flow's PKCE
// verifier sealed like the config's secrets and the temp tokens kept only as their SHA-256, so a restart between
// the consent link and the callback keeps the flow, and every worker of the node sees the flows the others opened.
import { McpAuthConfig, authorizeUrl, pkceVerifier, pkceChallenge, codeTokenRequest, tokenRequest, tokenFields } from "./mcpauth"
import { secureHex, sha256, utf8, toHex } from "./crypto"
import { deadline } from "./deadline"
import { existsSync, readFileSync, unlinkSync } from "node:fs"
import { writeFileAtomic } from "./atomicfile"
import { readState, stateVersion } from "./statever"
import { lockFile, unlockFile } from "./filelock"
import { resolvedTargetProblem, peerOf, strictPolicy } from "./netguard"

// One caller's tokens for one per_user_oauth client. At most one of virtual_key_id, session_id and user_id is set:
// user_id for a user-mode token, else virtual_key_id, else session_id in session mode (the x-bf-mcp-session-id header
// of a request without a key; identityOf). The tokens are sealed
// in the saved file.
export type McpUserToken = {
  id: string,
  mcp_client_name: string,
  virtual_key_id: string,
  session_id: string,
  access_token: string,
  refresh_token: string,
  // when the access token stops being valid, in epoch milliseconds
  token_expires_at: f64,
  scopes: string[],
  created_at: f64,
  last_refreshed_at: f64,
  // a token_exchange admin credential only: "needs_reauth" once its renewal was refused (unset reads as active),
  // with the reason
  status?: string,
  status_reason?: string,
  // user mode: the identity-provider user the row belongs to (virtual_key_id and session_id are then "")
  user_id?: string,
}

// A consent flow a caller opened: its state is the authorize request's state, and the link it was given
// names its id. It lives FLOW_TTL_MS, as Bifrost's does.
export type UserFlow = {
  id: string,
  state: string,
  client: string,
  virtual_key_id: string,
  session_id: string,
  verifier: string,
  redirect: string,
  authorize_url: string,
  temp_token: string,
  expires_at: f64,
  created_at: f64,
  // "admin" for an admin's verification of an oauth client; unset for a caller's consent
  mode?: string,
  // user mode: the identity-provider user who opened the flow (virtual_key_id and session_id are then "")
  user_id?: string,
  // an admin flow: "pending" until its callback, "failed" when the authorization server refused it or the token
  // request failed (the row is kept so the status route can say so)
  status?: string,
  updated_at?: f64,
}

// A temp token by its SHA-256: the flow it opens and the routes of its scope ("mcp_auth": the per-user OAuth
// flow's detail and start; "mcp_headers_auth": the per-user headers flow's detail and submission).
export type TempRow = { hash: string, flow: string, scope: string, expires_at: f64 }

// A token this close to its expiry counts as expired, as TokenCache does (60 s).
const USER_EXPIRY_MARGIN_MS: f64 = 60000.0
const FLOW_TTL_MS: f64 = 900000.0
const TEMP_TTL_MS: f64 = 900000.0
const FLOW_TIMEOUT_MS: int = 10000

// Flows by state (the callback's key), temp tokens by hash, and the flows and tokens that ended (by flow id or
// token hash, with the time), so a worker that still holds one does not write it back to the state file.
const USER_FLOWS: Map<string, UserFlow> = new Map()
const TEMP: Map<string, TempRow> = new Map()
const GONE: Map<string, f64> = new Map()

// The state file the flows are kept in ("" keeps them in memory only), and how a verifier is sealed and opened.
type FlowFile = { version?: int, flows?: UserFlow[], temp?: TempRow[], gone?: { key: string, at: f64 }[] }
// The flow file's version (statever.tov): a file from a newer Raiju is neither read nor written over.
const FLOW_STATE_VERSION = 1
let flowFile = ""
let flowSeal: ((v: string) => string) | undefined = undefined
let flowOpen: ((v: string) => string | undefined) | undefined = undefined

// Opens the flow state file (beside config.json) and takes the flows it holds. seal and open are the config's
// secret sealing (store.tov sealStored and openStored with the config's cipher). Returns a note to print, or "".
export function openFlowState(file: string, seal: (v: string) => string, open: (v: string) => string | undefined): string {
  flowFile = file
  flowSeal = seal
  flowOpen = open
  if (file === "" || !existsSync(file)) return ""
  try {
    const r = readState(file, try readFileSync(file, "utf8"), FLOW_STATE_VERSION, [])
    if (!r.ok && r.from > FLOW_STATE_VERSION) {
      // kept in memory only: nothing is written over it
      flowFile = ""
      return `${r.problem}: it is not written over, and consent flows are kept in memory only`
    }
    adoptFlows(try JSON.parse(r.text) as FlowFile)
  } catch (e) {
    return `the MCP flow state ${file} cannot be read; pending consent flows start over`
  }
  return ""
}

// Takes what the state file holds: ended flows and tokens are dropped here too, a flow not known yet is added
// (its verifier opened), and a flow another worker changed later replaces this one.
function adoptFlows(st: FlowFile): void {
  for (const g of st.gone ?? []) {
    if (!GONE.has(g.key)) GONE.set(g.key, g.at)
    TEMP.delete(g.key)
    for (const k of USER_FLOWS.keys()) {
      const f = USER_FLOWS.get(k)
      if (f !== undefined && f.id === g.key) USER_FLOWS.delete(k)
    }
  }
  for (const f of st.flows ?? []) {
    if (GONE.has(f.id)) continue
    const have = USER_FLOWS.get(f.state)
    if (have !== undefined && (have.updated_at ?? have.created_at) >= (f.updated_at ?? f.created_at)) continue
    const open = flowOpen
    const v = open === undefined ? f.verifier : open(f.verifier)
    if (v === undefined) continue
    const key = f.state
    let n = f
    n.verifier = v
    USER_FLOWS.set(key, n)
  }
  for (const t of st.temp ?? []) {
    if (!GONE.has(t.hash) && !TEMP.has(t.hash)) TEMP.set(t.hash, t)
  }
}

// Reads the state file again (another worker may have written it).
function syncFlows(): void {
  if (flowFile === "" || !existsSync(flowFile)) return
  try {
    const text = try readFileSync(flowFile, "utf8")
    // written by a newer Raiju since: not taken, and saveFlows does not write over it
    if (stateVersion(text) > FLOW_STATE_VERSION) return
    adoptFlows(try JSON.parse(text) as FlowFile)
  } catch (e) {
    return
  }
}

// Writes the live flows (verifiers sealed, no temp token in clear), the live temp tokens and the recent ends to
// the state file, after reading it so the other workers' flows are kept.
function saveFlows(nowMs: f64): void {
  if (flowFile === "") return
  // under the file's lock (filelock.tov), so a flow another worker writes between the read and the write is kept
  const lock = lockFile(flowFile)
  if (!lock.ok) {
    // nothing is written without the lock; the flows stay in memory and the next change writes them
    console.error(`raiju: mcp oauth: ${flowFile} is locked by another process; flows not saved this time`)
    return
  }
  writeFlows(nowMs)
  unlockFile(lock)
}

function writeFlows(nowMs: f64): void {
  syncFlows()
  const flows: UserFlow[] = []
  const seal = flowSeal
  for (const f of USER_FLOWS.values()) {
    if (f.expires_at <= nowMs) continue
    // a verifier that could not be sealed ("") is not written: that flow lives in this process only
    const sv = seal === undefined ? f.verifier : seal(f.verifier)
    if (sv === "") continue
    let n = f
    n.verifier = sv
    n.temp_token = ""
    flows.push(n)
  }
  const temp: TempRow[] = []
  for (const t of TEMP.values()) {
    if (t.expires_at > nowMs) temp.push(t)
  }
  const gone: { key: string, at: f64 }[] = []
  for (const k of GONE.keys()) {
    const at = GONE.get(k)!
    if (at > nowMs - 2.0 * FLOW_TTL_MS) gone.push({ key: k, at: at })
    else GONE.delete(k)
  }
  const st: FlowFile = { version: FLOW_STATE_VERSION, flows: flows, temp: temp, gone: gone }
  try {
    if (existsSync(flowFile) && stateVersion(try readFileSync(flowFile, "utf8")) > FLOW_STATE_VERSION) {
      console.error(`raiju: mcp flows: ${flowFile} was written by a newer Raiju; it is not written over`)
      return
    }
    writeFileAtomic(flowFile, JSON.stringify(st) + "\n", { mode: 384 })
  } catch (e) {
    console.error(`raiju: mcp flows: could not write ${flowFile}: ${e.message}`)
  }
}

// Ends a flow: it and its temp tokens are dropped, and the end is recorded so no worker brings them back.
function endFlow(id: string, nowMs: f64): void {
  for (const k of USER_FLOWS.keys()) {
    const f = USER_FLOWS.get(k)
    if (f !== undefined && f.id === id) USER_FLOWS.delete(k)
  }
  GONE.set(id, nowMs)
  for (const k of TEMP.keys()) {
    const t = TEMP.get(k)
    if (t !== undefined && t.flow === id) {
      TEMP.delete(k)
      GONE.set(k, nowMs)
    }
  }
}

// Mints a temp token for a flow: the plaintext goes into the link's fragment, and only its hash is kept.
export function mintTempToken(scope: string, flowId: string, expiresAt: f64): string throws Error {
  const plain = try secureHex(32)
  const hash = toHex(sha256(utf8(plain)))
  TEMP.set(hash, { hash: hash, flow: flowId, scope: scope, expires_at: expiresAt })
  saveFlows(Date.now())
  return plain
}

// Ends the temp tokens of a flow (a per-user headers submission that completed), as Bifrost deletes them by resource.
export function endTempTokens(flowId: string): void {
  syncFlows()
  const now = Date.now()
  let any = false
  for (const k of TEMP.keys()) {
    const t = TEMP.get(k)
    if (t !== undefined && t.flow === flowId) {
      TEMP.delete(k)
      GONE.set(k, now)
      any = true
    }
  }
  if (any) saveFlows(now)
}

// What a tool call needs from its caller's token at time nowMs.
// "valid": use access_token. "refresh": expired or about to expire, and a refresh_token exists.
// "consent": no row, or expired with no refresh_token; the caller must complete a consent flow.
export function tokenAction(t: McpUserToken | undefined, nowMs: number): string {
  if (t === undefined) return "consent"
  if (t.access_token !== "" && t.token_expires_at - nowMs > USER_EXPIRY_MARGIN_MS) return "valid"
  if (t.refresh_token !== "") return "refresh"
  return "consent"
}

// The index of a caller's row for a client in the list, or -1. Session mode keys by session_id when it is
// set; user mode by user_id; otherwise by virtual key.
export function userTokenIndex(list: McpUserToken[], client: string, vk: string, sessionId: string, userId?: string): int {
  const user = userId ?? ""
  for (let i = 0; i < list.length; i++) {
    const t = list[i]!
    if (t.mcp_client_name !== client) continue
    if (sessionId !== "") {
      if (t.session_id === sessionId) return i
      continue
    }
    if (user !== "") {
      if ((t.user_id ?? "") === user) return i
      continue
    }
    if (t.session_id === "" && (t.user_id ?? "") === "" && vk !== "" && t.virtual_key_id === vk) return i
  }
  return -1
}

// The row of one caller for one client, or undefined.
export function userTokenOf(list: McpUserToken[] | undefined, client: string, vk: string, sessionId: string, userId?: string): McpUserToken | undefined {
  const all = list ?? []
  const i = userTokenIndex(all, client, vk, sessionId, userId)
  return i < 0 ? undefined : all[i]
}

// The identity a request is keyed by, in Bifrost's order (BifrostContext.MCPAuthMode): the user of a user-mode token,
// else the virtual key, else the x-bf-mcp-session-id header. A request with a key and a session header is the key's.
// A session id over 255 characters is ignored, as Bifrost's NormalizeSessionID ignores it.
export function identityOf(sessionHeader: string | undefined, vk: string, user?: string): { vk: string, session: string, user: string } {
  const u = user ?? ""
  if (u !== "") return { vk: "", session: "", user: u }
  if (vk !== "") return { vk: vk, session: "", user: "" }
  const s = (sessionHeader ?? "").trim()
  if (s !== "" && s.chars().length <= MAX_SESSION_ID) return { vk: "", session: s, user: "" }
  return { vk: "", session: "", user: "" }
}

// Bifrost's MaxSessionIDLength (runes).
const MAX_SESSION_ID = 255

// A request header that carries the user of a user-mode MCP token from the /mcp handler to the tool calls it makes.
// The value is bound to a secret of this process, so a header a caller sends never names a user.
export const USER_HEADER = "x-raiju-mcp-user"
const USER_MARK = makeMark()

function makeMark(): string {
  try {
    return secureHex(16)
  } catch (e) {
    return ""
  }
}

// The header value that names a user.
export function markUser(user: string): string {
  return USER_MARK + ":" + user
}

// The user a header value names, or "" when it was not made by markUser in this process.
export function userOfMark(v: string | undefined): string {
  const s = v ?? ""
  if (USER_MARK === "" || !s.startsWith(USER_MARK + ":")) return ""
  return s.slice(USER_MARK.byteLength + 1)
}

// The consent wording of a tool call that needs the caller's login. The link is the flow's start URL;
// when temp tokens are on, the link carries the #t= fragment and the reminder to keep it.
export function consentMessage(client: string, link: string, tempToken: bool): string {
  let m = `Authentication required for ${client}. Visit ${link} to connect your account.`
  if (tempToken) m += " IMPORTANT: this link includes a required fragment after the '#' character (a one-time auth token). Copy and share the ENTIRE URL exactly as given, including everything after the '#' — the link will not work without it."
  return m
}

// The consent link of a per-user flow: Bifrost's auth page for the flow (src/mcpconsent.tov), which reads the
// flow and opens its start route. The temp token rides in the fragment, which the page reads.
export function consentLink(base: string, flowId: string, tempToken: string): string {
  const u = `${base}/workspace/mcp-sessions/auth?flow=${flowId}`
  return tempToken === "" ? u : `${u}#t=${tempToken}`
}

// The link of a per-user headers submission: the same auth page with kind=headers, which reads the flow and
// submits the values (Bifrost's frontend URL). The temp token rides in the fragment.
export function headersLink(base: string, flowId: string, tempToken: string): string {
  const u = `${base}/workspace/mcp-sessions/auth?flow=${flowId}&kind=headers`
  return tempToken === "" ? u : `${u}#t=${tempToken}`
}

// Drops the flows and temp tokens whose time is up.
function prune(nowMs: f64): void {
  for (const k of USER_FLOWS.keys()) {
    const f = USER_FLOWS.get(k)
    if (f !== undefined && f.expires_at <= nowMs) USER_FLOWS.delete(k)
  }
  for (const k of TEMP.keys()) {
    const t = TEMP.get(k)
    if (t !== undefined && t.expires_at <= nowMs) TEMP.delete(k)
  }
}

// Opens a consent flow for a caller of a per_user_oauth client. a is the client's registration (its
// authorize endpoint and client_id, set by the admin's verification). The flow's temp token is minted when
// tempOn is set, except for a user-mode flow, which the user's own dashboard sign-in opens (as Bifrost). error
// says why no flow was opened.
export function startUserFlow(a: McpAuthConfig, client: string, vk: string, sessionId: string, base: string, tempOn: bool, nowMs: f64, userId?: string): { flow: UserFlow | undefined, error: string } {
  if ((a.client_id ?? "") === "" || (a.authorize_url ?? "") === "") return { flow: undefined, error: `MCP client ${client} is not verified yet: an admin runs initiate-verification first` }
  syncFlows()
  prune(nowMs)
  const user = userId ?? ""
  try {
    const state = secureHex(32)
    const id = secureHex(16)
    const verifier = pkceVerifier()
    const redirect = base + "/api/oauth/callback"
    const url = authorizeUrl(a, redirect, state, pkceChallenge(verifier))
    let flow: UserFlow = { id: id, state: state, client: client, virtual_key_id: vk, session_id: sessionId, verifier: verifier, redirect: redirect, authorize_url: url, temp_token: "", expires_at: nowMs + FLOW_TTL_MS, created_at: nowMs, updated_at: nowMs }
    if (user !== "") flow.user_id = user
    USER_FLOWS.set(state, flow)
    if (tempOn && user === "") {
      const plain = try secureHex(32)
      const hash = toHex(sha256(utf8(plain)))
      TEMP.set(hash, { hash: hash, flow: id, scope: "mcp_auth", expires_at: nowMs + TEMP_TTL_MS })
      flow.temp_token = plain
    }
    saveFlows(nowMs)
    return { flow: flow, error: "" }
  } catch (e) {
    return { flow: undefined, error: `could not start the flow: ${e.message}` }
  }
}

// Opens an admin's verification flow of an oauth client (initiate-verification or reauthorize): the state, the
// verifier and redirect URI the callback needs, and the authorize URL. No temp token: an admin opens it from the
// dashboard. Returns the flow.
export function startAdminFlow(client: string, state: string, verifier: string, redirect: string, url: string, nowMs: f64): UserFlow throws Error {
  syncFlows()
  prune(nowMs)
  const id = try secureHex(16)
  const flow: UserFlow = { id: id, state: state, client: client, virtual_key_id: "", session_id: "", verifier: verifier, redirect: redirect, authorize_url: url, temp_token: "", expires_at: nowMs + FLOW_TTL_MS, created_at: nowMs, mode: "admin", status: "pending", updated_at: nowMs }
  USER_FLOWS.set(state, flow)
  saveFlows(nowMs)
  return flow
}

// An admin flow by id (any status, expired included while the file keeps it), or undefined.
export function adminFlowById(id: string): UserFlow | undefined {
  for (let pass = 0; pass < 2; pass++) {
    for (const f of USER_FLOWS.values()) {
      if (f.id === id && f.mode === "admin") return f
    }
    if (pass === 0) syncFlows()
  }
  return undefined
}

// The admin flows of a client that the table holds, newest first.
export function adminFlowsOf(client: string): UserFlow[] {
  syncFlows()
  const out: UserFlow[] = []
  for (const f of USER_FLOWS.values()) {
    if (f.mode === "admin" && f.client === client) out.push(f)
  }
  out.sort((a, b) => b.created_at - a.created_at)
  return out
}

// The flow of a callback's state without taking it (a callback that carries an error: a per-user flow stays
// pending so its link can be retried, as in Bifrost). undefined when unknown.
export function peekFlow(state: string): UserFlow | undefined {
  let f = USER_FLOWS.get(state)
  if (f === undefined) {
    syncFlows()
    f = USER_FLOWS.get(state)
  }
  return f
}

// Marks an admin flow failed (the authorization server refused it, or the token request failed). The row stays,
// so the status route can report it, until it expires.
export function failAdminFlow(f: UserFlow, nowMs: f64): void {
  let n = f
  n.status = "failed"
  n.updated_at = nowMs
  USER_FLOWS.set(n.state, n)
  saveFlows(nowMs)
}

// The live per-user flow with this id, or undefined. Admin flows are not per-user flows.
export function userFlowById(id: string, nowMs: f64): UserFlow | undefined {
  for (let pass = 0; pass < 2; pass++) {
    for (const f of USER_FLOWS.values()) {
      if (f.id === id && f.mode !== "admin" && f.expires_at > nowMs) return f
    }
    if (pass === 0) syncFlows()
  }
  return undefined
}

// All live per-user flows, for the sessions list.
export function userFlowsLive(nowMs: f64): UserFlow[] {
  syncFlows()
  const out: UserFlow[] = []
  for (const f of USER_FLOWS.values()) {
    if (f.mode !== "admin" && f.expires_at > nowMs) out.push(f)
  }
  return out
}

// Takes the flow of a callback's state (single use): a per-user flow ends here with its temp tokens. An admin flow
// is answered as it is; the callback ends it on success (endAdminFlow) or marks it failed. undefined when unknown,
// expired or already failed.
export function takeUserFlow(state: string, nowMs: f64): UserFlow | undefined {
  let f = USER_FLOWS.get(state)
  if (f === undefined) {
    syncFlows()
    f = USER_FLOWS.get(state)
  }
  if (f === undefined || f.expires_at <= nowMs || f.status === "failed") return undefined
  if (f.mode !== "admin") {
    endFlow(f.id, nowMs)
    saveFlows(nowMs)
  }
  return f
}

// Ends an admin flow whose callback completed: the client is authorized now, so its row goes (as Bifrost removes it).
export function endAdminFlow(id: string, nowMs: f64): void {
  endFlow(id, nowMs)
  saveFlows(nowMs)
}

// Drops one pending flow by id (a revoked session's flow), with its temp tokens.
export function dropUserFlow(id: string): void {
  const now = Date.now()
  endFlow(id, now)
  saveFlows(now)
}

// Drops the pending flows of one caller for one client (revoke, or a new flow replacing them).
export function forgetUserFlows(client: string, vk: string, sessionId: string, userId?: string): void {
  syncFlows()
  const user = userId ?? ""
  const now = Date.now()
  const ids: string[] = []
  for (const f of USER_FLOWS.values()) {
    if (f.mode === "admin" || f.client !== client) continue
    const fu = f.user_id ?? ""
    if (sessionId !== "") {
      if (f.session_id === sessionId) ids.push(f.id)
    } else if (user !== "") {
      if (fu === user) ids.push(f.id)
    } else if (f.session_id === "" && fu === "" && f.virtual_key_id === vk) {
      ids.push(f.id)
    }
  }
  for (const id of ids) endFlow(id, now)
  if (ids.length > 0) saveFlows(now)
}

// Whether a dashboard caller may open a flow (Bifrost's canAccessUserFlow): a user-mode flow only by its own user;
// any other flow by anyone who passed the gate.
export function mayOpenFlow(f: UserFlow, callerUser: string): bool {
  const u = f.user_id ?? ""
  if (u === "") return true
  return callerUser !== "" && callerUser === u
}

// Whether a temp token may call a route: it must be live, and the route must be one of its scope's routes for the
// flow it was minted for ("mcp_auth": GET the per-user OAuth flow or its start; "mcp_headers_auth": GET or PUT the
// per-user headers flow). The temp token is only honoured when client.mcp_enable_temp_token_auth is on (checked by
// the caller).
export function tempTokenAllows(token: string, method: string, path: string, nowMs: f64): bool {
  if (token === "") return false
  const hash = toHex(sha256(utf8(token)))
  let t = TEMP.get(hash)
  if (t === undefined) {
    syncFlows()
    t = TEMP.get(hash)
  }
  if (t === undefined || t.expires_at <= nowMs) return false
  if (t.scope === "mcp_auth") return method === "GET" && flowIdOfPath(path) === t.flow
  if (t.scope === "mcp_headers_auth") return (method === "GET" || method === "PUT") && headersFlowIdOfPath(path) === t.flow
  return false
}

// The flow id of /api/oauth/per-user/flows/{id} and /api/oauth/per-user/flows/{id}/start, else "".
export function flowIdOfPath(path: string): string {
  const q = path.indexOf("?")
  const p = q < 0 ? path : path.slice(0, q)
  const segs = p.split("/").filter((s) => s !== "")
  if (segs.length < 5 || segs[0] !== "api" || segs[1] !== "oauth" || segs[2] !== "per-user" || segs[3] !== "flows") return ""
  if (segs.length === 5) return segs[4]!
  if (segs.length === 6 && segs[5] === "start") return segs[4]!
  return ""
}

// The flow id of /api/mcp/per-user-headers/flows/{id}, else "".
export function headersFlowIdOfPath(path: string): string {
  const q = path.indexOf("?")
  const p = q < 0 ? path : path.slice(0, q)
  const segs = p.split("/").filter((s) => s !== "")
  if (segs.length !== 5 || segs[0] !== "api" || segs[1] !== "mcp" || segs[2] !== "per-user-headers" || segs[3] !== "flows") return ""
  return segs[4]!
}

// Issues a token response's tokens as a row for the caller (a fresh id, or the given row's id).
export function rowFromTokens(json: string, nowMs: f64, client: string, vk: string, sessionId: string, id: string, oldRefresh: string, userId?: string): McpUserToken throws SyntaxError {
  const t = try tokenFields(json, nowMs)
  const refresh = t.refresh !== "" ? t.refresh : oldRefresh
  let row: McpUserToken = { id: id, mcp_client_name: client, virtual_key_id: vk, session_id: sessionId, access_token: t.access, refresh_token: refresh, token_expires_at: t.expiresAt, scopes: [], created_at: nowMs, last_refreshed_at: nowMs }
  const u = userId ?? ""
  if (u !== "") row.user_id = u
  return row
}

// Trades a callback's code for the caller's tokens, with the flow's PKCE verifier. allow is mcp.oauth_private_allowlist.
export async function exchangeUserCode(a: McpAuthConfig, code: string, verifier: string, redirect: string, nowMs: f64, allow: string[]): Promise<string> throws Error {
  const tr = try codeTokenRequest(a, code, verifier, redirect)
  return try await postForm(tr.url, tr.headers, tr.body, allow)
}

// Refreshes a caller's access token with its refresh token. The result is the new row (same id).
export async function refreshUserRow(a: McpAuthConfig, row: McpUserToken, nowMs: f64, allow: string[]): Promise<McpUserToken> throws Error {
  if (row.refresh_token === "") throw new Error("no refresh token")
  let req = a
  req.refresh_token = row.refresh_token
  const tr = try tokenRequest(req)
  const text = try await postForm(tr.url, tr.headers, tr.body, allow)
  return try rowFromTokens(text, nowMs, row.mcp_client_name, row.virtual_key_id, row.session_id, row.id, row.refresh_token, row.user_id)
}

// One form POST to an authorization server under a deadline: the body of a 2xx answer, else an error. The token
// endpoint must be a public address, or one oauth_private_allowlist names (allow), checked on the addresses its host
// resolves to before the request and again by the runtime when it connects; a redirect is not followed, as Bifrost's
// OAuth client does not replay a credential-bearing POST elsewhere.
async function postForm(url: string, headers: Map<string, string>, body: string, allow: string[]): Promise<string> throws Error {
  const pr = await resolvedTargetProblem(url, allow)
  if (pr !== "") throw new Error(`${url}: ${pr} (add the host to oauth_private_allowlist to allow it)`)
  const dl = deadline(FLOW_TIMEOUT_MS)
  try {
    const hs: Record<string, string> = headers
    const r = await fetch(url, { method: "POST", headers: hs, body: body, signal: dl.controller.signal, redirect: "manual", peer: peerOf(strictPolicy(allow)) })
    const text = await r.text()
    if (r.status < 200 || r.status >= 300) throw new Error(`HTTP ${r.status} from ${url}`)
    dl.finish()
    return text
  } catch (e) {
    dl.finish()
    throw new Error(`${url}: ${e.message}`)
  }
}

// The list with the row of the same id replaced, or the row appended when it is new.
export function upsertUserRow(list: McpUserToken[], row: McpUserToken): McpUserToken[] {
  const out: McpUserToken[] = []
  let done = false
  for (const t of list) {
    if (t.id === row.id) {
      out.push(row)
      done = true
    } else {
      out.push(t)
    }
  }
  if (!done) out.push(row)
  return out
}

// The list without the row of this id.
export function dropUserRow(list: McpUserToken[], id: string): McpUserToken[] {
  const out: McpUserToken[] = []
  for (const t of list) {
    if (t.id !== id) out.push(t)
  }
  return out
}

test("a valid token is used, an expiring one is refreshed, and a missing one needs consent", () => {
  const now = 1000000.0
  expect(tokenAction(rowOf("u1", "vk1", "", now + 3600000.0, "r"), now)).toBe("valid")
  expect(tokenAction(rowOf("u1", "vk1", "", now + 30000.0, "r"), now)).toBe("refresh")
  expect(tokenAction(rowOf("u1", "vk1", "", now - 1.0, ""), now)).toBe("consent")
  expect(tokenAction(undefined, now)).toBe("consent")
})

test("rows are keyed by virtual key, or by session id in session mode", () => {
  const list = [rowOf("u1", "vk1", "", 0.0, ""), rowOf("u2", "", "s-9", 0.0, "")]
  expect(userTokenOf(list, "m", "vk1", "")!.id).toBe("u1")
  expect(userTokenOf(list, "m", "vk2", "")).toBe(undefined)
  expect(userTokenOf(list, "m", "vk1", "s-9")!.id).toBe("u2")
  expect(userTokenOf(list, "other", "vk1", "")).toBe(undefined)
  expect(userTokenIndex(list, "m", "vk1", "")).toBe(0)
  expect(userTokenIndex(list, "m", "", "s-9")).toBe(1)
  expect(userTokenIndex(list, "m", "", "s-x")).toBe(-1)
})

test("the virtual key takes precedence over the session header (Bifrost's order), and blank headers are ignored", () => {
  expect(identityOf("abc", "vk1")).toEqual({ vk: "vk1", session: "", user: "" })
  expect(identityOf("abc", "")).toEqual({ vk: "", session: "abc", user: "" })
  expect(identityOf("  ", "vk1").vk).toBe("vk1")
  expect(identityOf("  ", "")).toEqual({ vk: "", session: "", user: "" })
  expect(identityOf(undefined, "vk1").session).toBe("")
  let long = ""
  for (let i = 0; i < 256; i++) long += "s"
  expect(identityOf(long, "").session).toBe("")
  expect(identityOf(long.slice(1), "").session).toBe(long.slice(1))
})

test("the consent message and link carry the flow and the temp-token fragment when on", () => {
  expect(consentLink("http://gw.example", "f1", "")).toBe("http://gw.example/workspace/mcp-sessions/auth?flow=f1")
  expect(consentLink("http://gw.example", "f1", "tk")).toBe("http://gw.example/workspace/mcp-sessions/auth?flow=f1#t=tk")
  expect(consentMessage("m", "http://gw.example/x", false)).toBe("Authentication required for m. Visit http://gw.example/x to connect your account.")
  expect(consentMessage("m", "http://gw.example/x#t=tk", true).includes("ENTIRE URL")).toBe(true)
})

test("a flow needs a verified client, and an opened flow answers its start URL with PKCE", () => {
  const unverified: McpAuthConfig = { type: "oauth" }
  expect(startUserFlow(unverified, "m", "vk1", "", "http://gw", false, 1000.0).error.includes("initiate-verification")).toBe(true)
  const a: McpAuthConfig = { type: "oauth", client_id: "cid", authorize_url: "https://auth.example/authorize" }
  const r = startUserFlow(a, "m", "vk1", "", "http://gw", true, 1000.0)
  expect(r.error).toBe("")
  const f = r.flow!
  expect(f.redirect).toBe("http://gw/api/oauth/callback")
  expect(f.authorize_url.includes("code_challenge_method=S256")).toBe(true)
  expect(f.authorize_url.includes("state=" + f.state)).toBe(true)
  expect(userFlowById(f.id, 2000.0)!.state).toBe(f.state)
  expect(userFlowById(f.id, 1000.0 + FLOW_TTL_MS + 1.0)).toBe(undefined)
  expect(tempTokenAllows(f.temp_token, "GET", "/api/oauth/per-user/flows/" + f.id + "/start", 2000.0)).toBe(true)
  expect(tempTokenAllows(f.temp_token, "GET", "/api/oauth/per-user/flows/other/start", 2000.0)).toBe(false)
  expect(tempTokenAllows(f.temp_token, "PUT", "/api/oauth/per-user/flows/" + f.id, 2000.0)).toBe(false)
  expect(tempTokenAllows("", "GET", "/api/oauth/per-user/flows/" + f.id, 2000.0)).toBe(false)
  const taken = takeUserFlow(f.state, 2000.0)
  expect(taken!.id).toBe(f.id)
  expect(takeUserFlow(f.state, 2000.0)).toBe(undefined)
})

test("the flow id is read from the flow routes only", () => {
  expect(flowIdOfPath("/api/oauth/per-user/flows/abc")).toBe("abc")
  expect(flowIdOfPath("/api/oauth/per-user/flows/abc/start?x=1")).toBe("abc")
  expect(flowIdOfPath("/api/oauth/per-user/flows/abc/other")).toBe("")
  expect(flowIdOfPath("/api/oauth/callback")).toBe("")
})

test("rows are replaced by id and dropped by id", () => {
  const a = rowOf("u1", "vk1", "", 0.0, "")
  const b = rowOf("u2", "vk2", "", 0.0, "")
  const a2 = rowOf("u1", "vk1", "", 5.0, "r2")
  expect(upsertUserRow([a, b], a2).length).toBe(2)
  expect(upsertUserRow([a, b], a2)[0]!.refresh_token).toBe("r2")
  expect(upsertUserRow([a], b).length).toBe(2)
  expect(dropUserRow([a, b], "u1").length).toBe(1)
  expect(dropUserRow([a, b], "u1")[0]!.id).toBe("u2")
})

// A row for the tests, with the given expiry, refresh token and identity.
function rowOf(id: string, vk: string, sid: string, expires: f64, refresh: string): McpUserToken {
  return { id: id, mcp_client_name: "m", virtual_key_id: vk, session_id: sid, access_token: "a", refresh_token: refresh, token_expires_at: expires, scopes: [], created_at: 0.0, last_refreshed_at: 0.0 }
}

test("user-mode rows are keyed by user, apart from the key and session rows", () => {
  let u = rowOf("u3", "", "", 0.0, "")
  u.user_id = "alice"
  const list = [rowOf("u1", "vk1", "", 0.0, ""), u]
  expect(userTokenOf(list, "m", "", "", "alice")!.id).toBe("u3")
  expect(userTokenOf(list, "m", "", "", "bob")).toBe(undefined)
  expect(userTokenOf(list, "m", "vk1", "")!.id).toBe("u1")
  expect(identityOf(undefined, "vk1", "alice")).toEqual({ vk: "", session: "", user: "alice" })
  expect(identityOf("s-1", "vk1", "alice")).toEqual({ vk: "", session: "", user: "alice" })
  expect(userOfMark(markUser("alice"))).toBe("alice")
  expect(userOfMark("forged:alice")).toBe("")
  expect(userOfMark(undefined)).toBe("")
})

test("a user-mode flow gets no temp token and opens for its own user only", () => {
  const a: McpAuthConfig = { type: "oauth", client_id: "cid", authorize_url: "https://auth.example/authorize" }
  const f = startUserFlow(a, "m", "", "", "http://gw", true, 1000.0, "alice").flow!
  expect(f.temp_token).toBe("")
  expect(mayOpenFlow(f, "alice")).toBe(true)
  expect(mayOpenFlow(f, "bob")).toBe(false)
  expect(mayOpenFlow(f, "")).toBe(false)
  const v = startUserFlow(a, "m", "vk1", "", "http://gw", true, 1000.0).flow!
  expect(mayOpenFlow(v, "")).toBe(true)
  forgetUserFlows("m", "", "", "alice")
  expect(userFlowById(f.id, 2000.0)).toBe(undefined)
  expect(userFlowById(v.id, 2000.0) !== undefined).toBe(true)
})

test("a temp token ends with its flow, and a headers token opens only its submission", () => {
  const a: McpAuthConfig = { type: "oauth", client_id: "cid", authorize_url: "https://auth.example/authorize" }
  const f = startUserFlow(a, "m", "vk1", "", "http://gw", true, 1000.0).flow!
  expect(tempTokenAllows(f.temp_token, "GET", "/api/oauth/per-user/flows/" + f.id, 2000.0)).toBe(true)
  takeUserFlow(f.state, 2000.0)
  expect(tempTokenAllows(f.temp_token, "GET", "/api/oauth/per-user/flows/" + f.id, 2000.0)).toBe(false)
  const h = try mintTempToken("mcp_headers_auth", "hf-1", Date.now() + 60000.0)
  expect(tempTokenAllows(h, "PUT", "/api/mcp/per-user-headers/flows/hf-1", Date.now())).toBe(true)
  expect(tempTokenAllows(h, "GET", "/api/mcp/per-user-headers/flows/hf-1", Date.now())).toBe(true)
  expect(tempTokenAllows(h, "DELETE", "/api/mcp/per-user-headers/flows/hf-1", Date.now())).toBe(false)
  expect(tempTokenAllows(h, "GET", "/api/oauth/per-user/flows/hf-1", Date.now())).toBe(false)
  endTempTokens("hf-1")
  expect(tempTokenAllows(h, "PUT", "/api/mcp/per-user-headers/flows/hf-1", Date.now())).toBe(false)
  expect(headersLink("http://gw", "hf-1", "tk")).toBe("http://gw/workspace/mcp-sessions/auth?flow=hf-1&kind=headers#t=tk")
})

test("an admin flow is found by id, marked failed, and ended on success", () => {
  const f = try startAdminFlow("gh", "st-admin-1", "v".repeat(50), "http://gw/api/oauth/callback", "https://auth.example/authorize", Date.now())
  expect(adminFlowById(f.id)!.status).toBe("pending")
  expect(userFlowById(f.id, Date.now())).toBe(undefined)
  const taken = takeUserFlow("st-admin-1", Date.now())!
  expect(taken.mode).toBe("admin")
  failAdminFlow(taken, Date.now())
  expect(adminFlowById(f.id)!.status).toBe("failed")
  expect(takeUserFlow("st-admin-1", Date.now())).toBe(undefined)
  endAdminFlow(f.id, Date.now())
  expect(adminFlowById(f.id)).toBe(undefined)
})

test("flows and temp tokens survive a restart through the state file, with the verifier sealed", () => {
  const file = "/tmp/raiju-mcpflows-test-" + makeMark() + ".json"
  // a stand-in seal: reversed and marked, so the clear value is not in the file
  const seal = (v: string): string => "sealed:" + v.split("").reverse().join("")
  const open = (v: string): string | undefined => v.startsWith("sealed:") ? v.slice(7).split("").reverse().join("") : undefined
  openFlowState(file, seal, open)
  const a: McpAuthConfig = { type: "oauth", client_id: "cid", authorize_url: "https://auth.example/authorize" }
  const now = Date.now()
  const f = startUserFlow(a, "m", "vk-restart", "", "http://gw", true, now).flow!
  const text = try readFileSync(file, "utf8")
  expect(text.includes(f.verifier)).toBe(false)
  expect(text.includes(f.temp_token)).toBe(false)
  expect(stateVersion(text)).toBe(FLOW_STATE_VERSION)
  // a restart: the memory is gone, and the file brings the flow and its temp token back
  USER_FLOWS.clear()
  TEMP.clear()
  GONE.clear()
  openFlowState(file, seal, open)
  const back = userFlowById(f.id, now + 1000.0)!
  expect(back.verifier).toBe(f.verifier)
  expect(tempTokenAllows(f.temp_token, "GET", "/api/oauth/per-user/flows/" + f.id + "/start", now + 1000.0)).toBe(true)
  // the callback ends it, and a worker that still held it does not bring it back
  const taken = takeUserFlow(f.state, now + 2000.0)!
  expect(taken.verifier).toBe(f.verifier)
  USER_FLOWS.set(f.state, f)
  saveFlows(now + 3000.0)
  expect(userFlowById(f.id, now + 3000.0)).toBe(undefined)
  openFlowState("", seal, open)
  try unlinkSync(file)
  // a flow file from a newer Raiju is not read, and a new flow does not write over it
  const newer = `{"version":99,"flows":[],"temp":[],"gone":[]}\n`
  try writeFileAtomic(file, newer)
  expect(openFlowState(file, seal, open).includes("newer Raiju")).toBe(true)
  const extra = startUserFlow(a, "m", "vk-newer", "", "http://gw", true, now).flow!
  expect(try readFileSync(file, "utf8")).toBe(newer)
  // (the flow is ended so the tests after this one see none)
  endFlow(extra.id, now)
  GONE.clear()
  openFlowState("", seal, open)
  try unlinkSync(file)
})
