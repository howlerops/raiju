// Gateway configuration. The file format follows Bifrost's config.json, so an
// existing Bifrost config loads unchanged. Values written "env.NAME" are read
// from the environment when the config loads.
import { readFileSync, existsSync } from "node:fs"
import { RoutingRule } from "./cel"
import { OtelConfig } from "./otel"
import { McpConfig } from "./mcp"
import { AlertRule, Channel } from "./alerts"
import { TierMap } from "./complexity"
import { ClusterConfig } from "./cluster"
import { OidcConfig } from "./oidc"
import { VirtualMcp } from "./vmcp"
import { VectorStoreSettings } from "./vectorstore"
import { fields, elements, find, rawStr, rawBool, isNull } from "./json"
import { normalize } from "./config_compat"

export type AzureKeyConfig = { endpoint: string, deployments?: Map<string, string>, api_version?: string }
// iam_url overrides IBM Cloud IAM (https://iam.cloud.ibm.com), e.g. for private endpoints
export type WatsonxKeyConfig = { api_key: string, project_id: string, url: string, iam_url?: string }
export type VertexKeyConfig = { project_id: string, region: string, auth_credentials?: string }
export type BedrockKeyConfig = { access_key?: string, secret_key?: string, session_token?: string, region?: string, deployments?: Map<string, string> }

export type KeyConfig = {
  id?: string,
  name?: string,
  value?: string,
  models?: string[],
  weight?: f64,
  // request model name → the name this key's provider knows it by
  aliases?: Map<string, string>,
  azure_key_config?: AzureKeyConfig,
  vertex_key_config?: VertexKeyConfig,
  bedrock_key_config?: BedrockKeyConfig,
  watsonx_key_config?: WatsonxKeyConfig,
}

export type NetworkConfig = {
  base_url?: string,
  extra_headers?: Map<string, string>,
  default_request_timeout_in_seconds?: int,
  max_retries?: int,
  retry_backoff_initial?: int,
  retry_backoff_max?: int,
}

export type ProxyConfig = { type?: string, url?: string, username?: string, password?: string }

export type CustomProviderConfig = { base_provider_type: string, is_key_less?: bool }

export type ProviderConfig = {
  keys?: KeyConfig[],
  network_config?: NetworkConfig,
  proxy_config?: ProxyConfig,
  custom_provider_config?: CustomProviderConfig,
  send_back_raw_response?: bool,
}

export type ClientConfig = {
  drop_excess_requests?: bool,
  enable_logging?: bool,
  enable_governance?: bool,
  enforce_governance_header?: bool,
  // Bifrost: require a virtual key (or admin credentials) on inference. When omitted it is on
  // if the config has any credentials to use (virtual keys, admin users or auth_config).
  enforce_auth_on_inference?: bool,
  // headers every inference request must carry (lower-case names), e.g. ["x-team"]
  required_headers?: string[],
  allow_direct_keys?: bool,
  allowed_origins?: string[],
  max_request_body_size_mb?: int,
  prometheus_labels?: string[],
  async_job_result_ttl?: int, // seconds
  // MCP agent mode: tool calls to these chat tool names ("<server>-<tool>", or "*") run in the gateway
  mcp_agent_depth?: int,
  mcp_auto_execute?: string[],
}

export type BudgetConfig = { id: string, max_limit: f64, reset_duration: string, current_usage?: f64 }
export type RateLimitConfig = {
  id: string,
  token_max_limit?: int,
  token_reset_duration?: string,
  request_max_limit?: int,
  request_reset_duration?: string,
}
export type ProviderConfigRef = { provider: string, weight?: f64, allowed_models?: string[], budget_id?: string, rate_limit_id?: string }
export type VirtualKeyConfig = {
  id: string,
  name?: string,
  value: string,
  description?: string,
  is_active?: bool,
  team_id?: string,
  customer_id?: string,
  budget_id?: string,
  rate_limit_id?: string,
  provider_configs?: ProviderConfigRef[],
  key_ids?: string[],
  access_profile_ids?: string[],
}
// A reusable permission set that virtual keys reference (access_profile_ids); see profiles.tov.
export type AccessProfile = {
  id: string,
  name?: string,
  description?: string,
  provider_configs?: ProviderConfigRef[],
  // "provider/model", "provider/*" or "*"
  allowed_models?: string[],
  denied_models?: string[],
  budget_id?: string,
  rate_limit_id?: string,
  mcp_tools?: string[],
  required_headers?: string[],
  max_tokens?: int,
  is_active?: bool,
}

export type PricingOverrideConfig = {
  id?: string,
  name?: string,
  scope_kind: string,
  provider_id?: string,
  provider_key_id?: string,
  virtual_key_id?: string,
  user_id?: string,
  request_types?: string[],
  match_type: string,
  pattern: string,
  pricing_patch: string, // JSON text, as Bifrost stores it
}

// Bifrost's governance.model_configs: budgets and a rate limit for one model (or "*" for every
// model) on one provider (or every provider). Budgets and the rate limit are named by id, as the
// config file has them; the management API takes them inline and stores them under derived ids.
export type ModelConfigGovernance = {
  id: string,
  model_name: string,
  provider?: string,
  scope?: string, // "global" (default) or "virtual_key"
  scope_id?: string,
  calendar_aligned?: bool,
  budget_id?: string, // deprecated: one budget
  budget_ids?: string[],
  rate_limit_id?: string,
}

// Bifrost's governance.providers: a budget and a rate limit for every model of one provider.
export type ProviderGovernance = { id?: string, name: string, description?: string, budget_id?: string, budget_ids?: string[], rate_limit_id?: string }

// Where the price datasheet comes from (Bifrost's framework.pricing): fetched at start and
// every interval_seconds (at least an hour); the built-in copy is used until then.
export type PricingSyncConfig = { url?: string, interval_seconds?: int, enabled?: bool }

export type TeamConfig = { id: string, name: string, customer_id?: string, budget_id?: string }
export type CustomerConfig = { id: string, name: string, budget_id?: string }

// Credentials for the management API and UI (Bifrost's governance.auth_config, or its
// deprecated top-level auth_config): admin_username/admin_password/is_enabled as Bifrost
// writes them, or username/password/token.
export type AdminAuthConfig = { username?: string, password?: string, token?: string, admin_username?: string, admin_password?: string, is_enabled?: bool, disable_auth_on_inference?: bool }

export type AdminUserConfig = {
  name: string,
  role: "admin" | "editor" | "viewer" | "auditor",
  token_sha256?: string,
  password_sha256?: string,
  salt?: string,
  disabled?: bool,
}

export type GovernanceConfig = {
  auth_config?: AdminAuthConfig,
  users?: AdminUserConfig[],
  access_profiles?: AccessProfile[],
  // Bifrost's custom pricing (docs/providers/custom-pricing): rates patched over the datasheet
  pricing_overrides?: PricingOverrideConfig[],
  budgets?: BudgetConfig[],
  rate_limits?: RateLimitConfig[],
  virtual_keys?: VirtualKeyConfig[],
  teams?: TeamConfig[],
  customers?: CustomerConfig[],
  routing_rules?: RoutingRule[],
  model_configs?: ModelConfigGovernance[],
  providers?: ProviderGovernance[],
}

export type CacheConfig = { enabled?: bool, ttl_seconds?: int, max_entries?: int, cache_by_model?: bool, cache_by_provider?: bool }

// Circuit breakers and adaptive load balancing across keys.
export type HealthConfig = {
  circuit_breaker?: bool,
  adaptive?: bool,
  failure_threshold?: int,
  failure_rate_threshold?: f64,
  min_requests?: int,
  window_seconds?: int,
  open_seconds?: int,
}

// Native guardrails: which detectors run, what happens on a finding, and where.
// An external guardrail service checked before (input) or after (output) the model.
export type PatronusEvaluatorConfig = { evaluator: string, criteria?: string }

export type GuardrailProviderConfig = {
  id: string,
  kind: "bedrock" | "azure_content_safety" | "patronus" | "webhook",
  apply_to?: "input" | "output" | "both",
  on_error?: "allow" | "block",
  // bedrock
  guardrail_id?: string,
  guardrail_version?: string,
  region?: string,
  access_key?: string,
  secret_key?: string,
  session_token?: string,
  // azure_content_safety
  endpoint?: string,
  api_key?: string,
  threshold?: number,
  categories?: string[],
  // patronus
  evaluators?: PatronusEvaluatorConfig[],
  base_url?: string,
  // webhook
  url?: string,
  headers?: Map<string, string>,
}

export type GuardrailsConfig = {
  enabled?: bool,
  // external services (AWS Bedrock Guardrails, Azure AI Content Safety, Patronus, a webhook)
  providers?: GuardrailProviderConfig[],
  detect?: string[],
  mode?: string, // "redact" (default), "block" or "log"
  custom?: string[],
  apply_to?: string, // "input" (default), "output" or "both"
}

// Request logs: JSONL files with retention, plus an in-memory index for /api/logs.
// Bifrost's logs_store block (enabled, type, config) also turns this on.
export type LogsStoreConfig = {
  enabled?: bool,
  dir?: string,
  retention_days?: int,
  max_memory_entries?: int,
  content_logging?: bool,
}

// A plugin from the config's plugins list. Its "config" object can hold any JSON,
// which typed parsing can't, so it's kept as raw text in config_json.
export type PluginSpec = { name: string, enabled?: bool, config_json?: string }

// Semantic caching (Bifrost's semantic_cache plugin): on an exact-cache miss the
// prompt is embedded and a stored answer to a similar prompt is returned.
export type SemanticCacheSettings = {
  enabled?: bool,
  provider: string, // embedding provider, e.g. "openai"
  embedding_model: string,
  threshold?: f64,
  ttl?: int, // seconds
  max_entries?: int,
  conversation_history_threshold?: int,
  exclude_system_prompt?: bool,
  cache_by_model?: bool,
  cache_by_provider?: bool,
  default_cache_key?: string,
  // Bifrost's vector_store_namespace (the store's collection or index name) and dimension
  vector_store_namespace?: string,
  dimension?: int,
}

export type PromptCacheConfig = { auto_inject?: bool }

export type PricingEntry = { input_cost_per_token: f64, output_cost_per_token: f64 }

// vault.<path>#<field> and aws-sm.<id>[#<field>] values are fetched at load and on reload.
export type SecretsConfig = {
  vault?: { address: string, token?: string, namespace?: string, mount?: string },
  aws?: { region: string, access_key?: string, secret_key?: string, session_token?: string },
}

export type AuditConfig = { enabled?: bool, dir?: string, key?: string, max_memory?: int }

export type AlertsConfig = { enabled?: bool, interval_seconds?: int, rules?: AlertRule[], channels?: Channel[] }

// Request logs shipped to S3-compatible storage (S3, MinIO, GCS interoperability keys).
export type LogExportsConfig = {
  enabled: bool,
  kind: "s3" | "gcs",
  bucket: string,
  prefix?: string,
  region?: string,
  endpoint?: string,
  access_key_id: string,
  secret_access_key: string,
  session_token?: string,
  interval_seconds?: int,
  path_style?: bool,
}

// Request logs sent in batches to Datadog, Splunk HEC, Elasticsearch or any HTTP endpoint (exporters.tov).
export type LogExporterConfig = {
  id: string,
  kind: "datadog" | "splunk" | "elasticsearch" | "http",
  enabled?: bool,
  batch_size?: int,
  interval_seconds?: int,
  include_content?: bool,
  api_key?: string, // datadog; elasticsearch (ApiKey auth)
  site?: string, // datadog host suffix, default datadoghq.com
  service?: string, // datadog, default raiju
  tags?: string[], // datadog
  hostname?: string, // datadog
  url?: string, // splunk HEC base; elasticsearch; http
  token?: string, // splunk
  index?: string, // splunk; elasticsearch, may hold %Y.%m.%d
  sourcetype?: string, // splunk, default raiju:request
  username?: string, // elasticsearch basic auth
  password?: string, // elasticsearch basic auth
  headers?: Map<string, string>, // http
  format?: "json" | "ndjson", // http, default json
}

export type AffinitySettings = { enabled?: bool, ttl_seconds?: int, max_sessions?: int }

export type ComplexitySettings = { enabled?: bool, model?: string, simple_max_score?: f64, complex_min_score?: f64, tiers?: TierMap }

export type Config = {
  client?: ClientConfig,
  providers?: Map<string, ProviderConfig>,
  governance?: GovernanceConfig,
  cache?: CacheConfig,
  pricing?: Map<string, PricingEntry>,
  prompt_cache?: PromptCacheConfig,
  health?: HealthConfig,
  guardrails?: GuardrailsConfig,
  logs_store?: LogsStoreConfig,
  otel?: OtelConfig,
  mcp?: McpConfig,
  plugins?: PluginSpec[],
  semantic_cache?: SemanticCacheSettings,
  // Where semantic cache entries go when not in memory (Bifrost's top-level vector_store)
  vector_store?: VectorStoreSettings,
  pricing_sync?: PricingSyncConfig,
  // Bifrost's deprecated top-level auth_config; governance.auth_config wins
  auth_config?: AdminAuthConfig,
  secrets?: SecretsConfig,
  audit?: AuditConfig,
  alerts?: AlertsConfig,
  session_affinity?: AffinitySettings,
  complexity_router?: ComplexitySettings,
  mcp_server?: { enabled?: bool },
  // named tool sets from several MCP servers, served at /mcp/{name}
  virtual_mcps?: VirtualMcp[],
  log_exports?: LogExportsConfig,
  exporters?: LogExporterConfig[],
  cluster?: ClusterConfig,
  oidc?: OidcConfig,
}

// The process environment by name. Tov's process.env takes only names written
// in the source, so names that come from the config are looked up here.
let envCache: Map<string, string> | undefined = undefined

export function getEnv(name: string): string | undefined {
  let m = envCache
  if (m === undefined) {
    const fresh: Map<string, string> = new Map()
    try {
      const text = readFileSync("/proc/self/environ", "utf8")
      for (const entry of text.split("\u0000")) {
        const i = entry.indexOf("=")
        if (i > 0) fresh.set(entry.slice(0, i), entry.slice(i + 1))
      }
    } catch (e) {
      // no /proc: only names known at compile time resolve
    }
    envCache = fresh
    m = fresh
  }
  return m.get(name)
}

// Lookups that avoid `?.get(...)` chains (a Tov compiler bug with them).
export function providerOf(cfg: Config, name: string): ProviderConfig | undefined {
  const ps = cfg.providers
  if (ps === undefined) return undefined
  return ps.get(name)
}

export function providerNames(cfg: Config): string[] {
  const ps = cfg.providers
  if (ps === undefined) return []
  return ps.keys()
}

// Resolves "env.NAME" to the variable's value ("" when unset).
export function resolveEnv(v: string): string {
  if (!v.startsWith("env.")) return v
  return getEnv(v.slice(4)) ?? ""
}

function opt(v: string | undefined): string | undefined {
  return v === undefined ? undefined : resolveEnv(v)
}

function resolveKey(k: KeyConfig): KeyConfig {
  const value = opt(k.value)
  const az = k.azure_key_config
  const br = k.bedrock_key_config
  const vx = k.vertex_key_config
  // copy the whole key and replace the secret-bearing fields, so new fields survive
  let n = k
  n.value = value
  if (az !== undefined) {
    const endpoint = resolveEnv(az.endpoint)
    let a = az
    a.endpoint = endpoint
    n.azure_key_config = a
  }
  if (br !== undefined) {
    const ak = opt(br.access_key)
    const sk = opt(br.secret_key)
    const st = opt(br.session_token)
    const rg = opt(br.region)
    let b = br
    b.access_key = ak
    b.secret_key = sk
    b.session_token = st
    b.region = rg
    n.bedrock_key_config = b
  }
  if (vx !== undefined) {
    const proj = resolveEnv(vx.project_id)
    const rg = resolveEnv(vx.region)
    const creds = opt(vx.auth_credentials)
    let v = vx
    v.project_id = proj
    v.region = rg
    v.auth_credentials = creds
    n.vertex_key_config = v
  }
  return n
}

// Replaces every "env.NAME" value in the config with the variable's value.
export function resolveConfig(inout c: Config): void {
  const ps = c.providers
  if (ps !== undefined) {
    const resolved: Map<string, ProviderConfig> = new Map()
    for (const name of ps.keys()) {
      const p = ps.get(name)!
      const keys = p.keys
      const rk = keys === undefined ? undefined : keys.map((k) => resolveKey(k))
      let np = p
      np.keys = rk
      resolved.set(name, np)
    }
    c.providers = resolved
  }
  // One effective admin credential set: Bifrost's field names, env references resolved,
  // and nothing when is_enabled is false.
  const auth = c.governance?.auth_config ?? c.auth_config
  if (auth !== undefined) {
    const u = auth.username ?? auth.admin_username
    const pw = auth.password ?? auth.admin_password
    const eff: AdminAuthConfig = auth.is_enabled === false ? {} : { username: opt(u), password: opt(pw), token: opt(auth.token) }
    let g: GovernanceConfig = c.governance ?? {}
    g.auth_config = eff
    c.governance = g
  }
  const au = c.audit
  if (au !== undefined && au.key !== undefined) {
    const k = resolveEnv(au.key)
    let a2 = au
    a2.key = k
    c.audit = a2
  }
  const gr = c.guardrails
  const gps = gr?.providers
  if (gr !== undefined && gps !== undefined) {
    const resolved = gps.map((p) => {
      const ak = opt(p.api_key)
      const ac = opt(p.access_key)
      const sk = opt(p.secret_key)
      const st = opt(p.session_token)
      let q = p
      q.api_key = ak
      q.access_key = ac
      q.secret_key = sk
      q.session_token = st
      return q
    })
    let g2 = gr
    g2.providers = resolved
    c.guardrails = g2
  }
  const gov = c.governance
  if (gov !== undefined) {
    const vks = gov.virtual_keys
    if (vks !== undefined) {
      const out: VirtualKeyConfig[] = []
      for (const vk of vks) {
        const value = resolveEnv(vk.value)
        let n = vk
        n.value = value
        out.push(n)
      }
      c.governance!.virtual_keys = out
    }
  }
}

export function parseConfig(text: string): Config throws SyntaxError {
  let c = try JSON.parse(text) as Config
  resolveConfig(&c)
  return c
}

// Loads the config from a file, or builds one from well-known provider
// environment variables when there is no file.
export function loadConfig(path: string): Config throws Error {
  let c = try loadRawConfig(path)
  resolveConfig(&c)
  return c
}

// The config as written, with "env.NAME" references kept: what the config store
// saves back, so secrets never land in the file.
export function loadRawConfig(path: string): Config throws Error {
  if (!existsSync(path)) return fromEnv()
  // Bifrost's section names read as Raiju's (config_compat.tov); the file itself is untouched
  const text = (try normalize(try readFileSync(path, "utf8"))).text
  let c = try JSON.parse(text) as Config
  c.plugins = try pluginSpecs(text)
  return c
}

// Each plugin with its config object as raw JSON text.
export function pluginSpecs(configText: string): PluginSpec[] throws SyntaxError {
  const raw = find(try fields(configText), "plugins")
  const out: PluginSpec[] = []
  if (raw === undefined || !raw.startsWith("[")) return out
  for (const el of try elements(raw)) {
    const f = try fields(el)
    const name = rawStr(f, "name")
    if (name === undefined) continue
    const conf = find(f, "config")
    const saved = rawStr(f, "config_json")
    out.push({ name: name, enabled: rawBool(f, "enabled"), config_json: conf !== undefined && !isNull(conf) ? conf : saved })
  }
  return out
}

const ENV_PROVIDERS: { name: string, env: string }[] = [
  { name: "openai", env: "OPENAI_API_KEY" },
  { name: "anthropic", env: "ANTHROPIC_API_KEY" },
  { name: "gemini", env: "GEMINI_API_KEY" },
  { name: "groq", env: "GROQ_API_KEY" },
  { name: "mistral", env: "MISTRAL_API_KEY" },
  { name: "cohere", env: "COHERE_API_KEY" },
  { name: "openrouter", env: "OPENROUTER_API_KEY" },
  { name: "cerebras", env: "CEREBRAS_API_KEY" },
  { name: "xai", env: "XAI_API_KEY" },
  { name: "perplexity", env: "PERPLEXITY_API_KEY" },
  { name: "deepseek", env: "DEEPSEEK_API_KEY" },
  { name: "together", env: "TOGETHER_API_KEY" },
  { name: "fireworks", env: "FIREWORKS_API_KEY" },
]

export function fromEnv(): Config {
  const ps: Map<string, ProviderConfig> = new Map()
  for (const p of ENV_PROVIDERS) {
    const v = getEnv(p.env)
    if (v !== undefined && v !== "") ps.set(p.name, { keys: [{ name: "env", value: "env." + p.env, models: [], weight: 1.0 }] })
  }
  const ollama = process.env.OLLAMA_BASE_URL
  if (ollama !== undefined && ollama !== "") ps.set("ollama", { keys: [{ value: "", models: [], weight: 1.0 }], network_config: { base_url: ollama } })
  return { providers: ps }
}

test("parses a Bifrost config and resolves env values", () => {
  const c = try parseConfig(`{
    "client": { "drop_excess_requests": false, "enable_logging": true },
    "providers": {
      "openai": {
        "keys": [{ "value": "env.HOME", "models": ["gpt-4o-mini"], "weight": 1.0 }],
        "network_config": { "max_retries": 2, "extra_headers": { "x-team": "core" } }
      },
      "azure": {
        "keys": [{ "value": "k", "azure_key_config": { "endpoint": "https://x.openai.azure.com", "deployments": { "gpt-4o": "prod-4o" }, "api_version": "2024-10-21" } }]
      }
    },
    "governance": { "virtual_keys": [{ "id": "vk1", "value": "sk-bf-test", "budget_id": "b1" }], "budgets": [{ "id": "b1", "max_limit": 10.5, "reset_duration": "1M" }] }
  }`)
  const openai = c.providers!.get("openai")!
  expect(openai.keys![0]!.value).toBe(process.env.HOME ?? "")
  expect(openai.network_config!.max_retries).toBe(2)
  expect(openai.network_config!.extra_headers!.get("x-team")).toBe("core")
  expect(c.providers!.get("azure")!.keys![0]!.azure_key_config!.deployments!.get("gpt-4o")).toBe("prod-4o")
  expect(c.governance!.budgets![0]!.max_limit).toBe(10.5)
})
