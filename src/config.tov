// Gateway configuration. The file format follows Bifrost's config.json, so an
// existing Bifrost config loads unchanged. Values written "env.NAME" are read
// from the environment when the config loads.
import { readFileSync, existsSync } from "node:fs"
import { RoutingRule } from "./cel"
import { OtelConfig } from "./otel"
import { PushGatewayConfig } from "./pushgateway"
import { McpConfig, McpKeyConfig } from "./mcp"
import { AlertRule, CelRule, Channel } from "./alerts"
import { TierMap } from "./complexity"
import { ClusterConfig } from "./cluster"
import { AuthProxyConfig } from "./authproxy"
import { OidcConfig } from "./oidc"
import { VirtualMcp } from "./vmcp"
import { VectorStoreSettings } from "./vectorstore"
import { fields, elements, find, rawStr, rawBool, rawNum, isNull } from "./json"
import { normalize } from "./config_compat"
import { PromptRepoConfig } from "./prompts"
import { FeatureFlagsConfig, FlagOverride } from "./flags"

// client_id, client_secret and tenant_id: Entra ID (service principal) instead of an API key
export type AzureKeyConfig = { endpoint: string, deployments?: Map<string, string>, api_version?: string, client_id?: string, client_secret?: string, tenant_id?: string, scopes?: string[] }
// iam_url overrides IBM Cloud IAM (https://iam.cloud.ibm.com), e.g. for private endpoints
export type WatsonxKeyConfig = { api_key: string, project_id: string, url: string, iam_url?: string }
// account_id: the Cloudflare account whose Workers AI endpoints serve the key
export type CloudflareKeyConfig = { account_id: string }
// workspace_url: the workspace host (a scheme or trailing path is tolerated). api_format:
// "model_serving" or "ai_gateway", else chosen from the model name. client_id and client_secret:
// OAuth M2M service principal, used when the key value is empty.
export type DatabricksKeyConfig = { workspace_url: string, api_format?: string, client_id?: string, client_secret?: string }
// GitHub App credentials that mint Copilot tokens (see githubcopilot.tov)
export type GithubCopilotKeyConfig = { app_id: string, installation_id: string, repository_id: string, private_key: string, github_domain?: string }
// project_number: the project's number, which a fine-tuned model's endpoint (an all-digit model id) is addressed by.
// force_single_region: keep the configured region for a model Bifrost's catalog marks multi-region only (Raiju
// does not promote such models to the us/eu pool, so it changes nothing yet).
export type VertexKeyConfig = { project_id: string, region: string, auth_credentials?: string, project_number?: string, force_single_region?: bool }
// role_arn (with external_id and session_name): assume that role with STS using the keys above
// arn: an inference profile ARN joined to the model in the URL path. use_openai_endpoints: OpenAI and xAI
// models chat through bedrock-runtime's OpenAI-compatible route instead of Converse (non-streaming only).
// A bucket for batch jobs: its name, the prefix its files go under, and whether it is the default.
export type BatchS3Bucket = { bucket_name: string, prefix?: string, is_default?: bool }
// batch_role_arn: the service role batch jobs run as (it wins over a role_arn sent with a request).
// batch_s3_config: the buckets batch input and output live in; the default one is used when a request names none.
export type BedrockKeyConfig = { access_key?: string, secret_key?: string, session_token?: string, region?: string, deployments?: Map<string, string>, role_arn?: string, external_id?: string, session_name?: string, arn?: string, use_openai_endpoints?: bool, batch_role_arn?: string, batch_s3_config?: { buckets?: BatchS3Bucket[] } }

// Bifrost's alias object form: model_id is the wire name; model_name is the canonical name that
// pricing and logs use; model_family is the family enum (aliases.tov ALIAS_FAMILIES).
// The rest are Bifrost's per-alias provider overrides (router.tov aliasOverrides puts them on the key for a request
// to the alias): region and project_id (Vertex, Bedrock), use_openai_endpoints (Bedrock), api_version and endpoint
// (Azure), inference_profile_arn (Bedrock), use_deployments_endpoint (Replicate), and project_number and
// force_single_region (Vertex). anthropic_version and use_anthropic_endpoints are read and have no Raiju counterpart.
export type AliasTarget = {
  model_id: string,
  model_name?: string,
  model_family?: string,
  description?: string,
  region?: string,
  project_id?: string,
  use_anthropic_endpoints?: bool,
  use_openai_endpoints?: bool,
  api_version?: string,
  anthropic_version?: string,
  endpoint?: string,
  project_number?: string,
  force_single_region?: bool,
  inference_profile_arn?: string,
  use_deployments_endpoint?: bool,
}

// Bifrost's replicate_key_config: use_deployments_endpoint sends predictions to /v1/deployments/{model}/predictions.
export type ReplicateKeyConfig = { use_deployments_endpoint?: bool }

export type KeyConfig = {
  id?: string,
  name?: string,
  value?: string,
  models?: string[],
  weight?: f64,
  // request model name → the name this key's provider knows it by: a plain model id, or
  // Bifrost's object form (aliases.tov AliasTarget)
  aliases?: Map<string, string | AliasTarget>,
  azure_key_config?: AzureKeyConfig,
  vertex_key_config?: VertexKeyConfig,
  bedrock_key_config?: BedrockKeyConfig,
  // Bifrost's bedrock_mantle keys; read as bedrock_key_config
  bedrock_mantle_key_config?: BedrockKeyConfig,
  watsonx_key_config?: WatsonxKeyConfig,
  cloudflare_key_config?: CloudflareKeyConfig,
  databricks_key_config?: DatabricksKeyConfig,
  github_copilot_key_config?: GithubCopilotKeyConfig,
  replicate_key_config?: ReplicateKeyConfig,
  // Bifrost: a key with this set to false is skipped by the batch API (read, not applied: see config_compat.tov)
  use_for_batch_api?: bool,
  // Bifrost's oauth_key_config: with no value, the key's bearer token is minted from a token endpoint (oauth_key.tov)
  oauth_key_config?: OAuthKeyConfig,
}

// Bifrost's oauth_key_config. grant_type is client_credentials (client_id and client_secret, sent as HTTP Basic
// auth unless auth_style is "body") or jwt_bearer (an assertion signed with private_key, an RSA or EC PEM, by
// signing_algorithm RS256 or ES256; iss is issuer, sub is subject or the issuer, aud is audience, kid is key_id,
// and it lasts assertion_lifetime_seconds, 300 by default).
export type OAuthKeyConfig = { grant_type?: string, token_url?: string, client_id?: string, client_secret?: string, private_key?: string, scopes?: string[], audience?: string, issuer?: string, subject?: string, key_id?: string, signing_algorithm?: string, auth_style?: string, assertion_lifetime_seconds?: int, extra_params?: Map<string, string> }

export type NetworkConfig = {
  base_url?: string,
  extra_headers?: Map<string, string>,
  default_request_timeout_in_seconds?: int,
  max_retries?: int,
  retry_backoff_initial?: int,
  retry_backoff_max?: int,
  // TLS to the provider: skip certificate checks, or trust these PEM certificates as well
  insecure_skip_verify?: bool,
  ca_cert_pem?: string,
  // Bifrost's network_config extras. Raiju does not guard provider addresses, so private
  // addresses are always reachable and allow_private_network has no effect.
  allow_private_network?: bool,
  // Bifrost's stream_idle_timeout_in_seconds: a streamed answer with no chunk for this long is cut (absent or 0: 120 s)
  stream_idle_timeout_in_seconds?: int,
  // Bifrost's beta_header_overrides: support per anthropic-beta prefix for this provider (anthropic_beta.tov)
  beta_header_overrides?: Map<string, bool>,
  // Bifrost's connection pool and HTTP/2 keys, applied through the fetch pool options (providers/types.tov poolOf):
  // idle connections close after keep_alive_timeout_in_seconds (default 30), at most max_conns_per_host connections to the
  // provider's host at once (default 5000; more requests wait), enforce_http2 offers h2 and uses it where the server picks
  // it (HTTP/1.1 otherwise, as Go's ForceAttemptHTTP2), and http2_ping_interval_in_seconds sends a PING after that long
  // without a frame (only with enforce_http2; 0 off).
  keep_alive_timeout_in_seconds?: int,
  max_conns_per_host?: int,
  enforce_http2?: bool,
  http2_ping_interval_in_seconds?: int,
}

// Bifrost's websocket section. max_connections_per_user caps the open sessions of each WebSocket route
// (ws.tov SocketGate). Raiju does not act on pool or transcript_buffer_size (config_compat notes them).
export type WebSocketConfig = { max_connections_per_user?: int, transcript_buffer_size?: int, pool?: { max_idle_per_key?: int, max_total_connections?: int, idle_timeout_seconds?: int, max_connection_lifetime_seconds?: int } }

// Bifrost's large_payload_optimization (largepayload.tov): request bodies over request_threshold_bytes are
// streamed to the provider (the routing fields are read from the first prefetch_size_bytes), bodies over
// max_payload_bytes are refused, answers over response_threshold_bytes are streamed back, and the request log
// keeps truncated_log_bytes of each. Defaults: 10 MiB, 10 MiB, 64 KiB, 500 MiB and 1 MiB.
export type LargePayloadConfig = { enabled?: bool, request_threshold_bytes?: int, response_threshold_bytes?: int, prefetch_size_bytes?: int, max_payload_bytes?: int, truncated_log_bytes?: int }

// ca_cert_pem: the proxy's certificate authority, for a TLS-intercepting proxy
export type ProxyConfig = { type?: string, url?: string, username?: string, password?: string, ca_cert_pem?: string }

// The global outbound proxy (Bifrost's top-level proxy_config, GET/PUT /api/proxy-config). A
// provider without its own proxy_config uses it when enabled and enable_for_inference is set.
export type GlobalProxyConfig = { enabled?: bool, type?: string, url?: string, username?: string, password?: string, no_proxy?: string, timeout?: int, skip_tls_verify?: bool, enable_for_scim?: bool, enable_for_inference?: bool, enable_for_api?: bool }

// request_path_overrides: request type (chat_completion, embedding, ...) to the path that replaces the default
// allowed_requests: when set, only the request types marked true are served (Bifrost's gating)
// does_not_send_done_marker / wait_for_usage: stream quirks of an upstream that ends on finish_reason
export type CustomProviderConfig = {
  base_provider_type: string,
  is_key_less?: bool,
  request_path_overrides?: Map<string, string>,
  allowed_requests?: Map<string, bool>,
  does_not_send_done_marker?: bool,
  wait_for_usage?: bool,
}

// One MCP tool the gateway runs for every chat request to its provider. name is what the model sees.
export type InjectedTool = { name: string, mcp_client_name: string, tool_name: string }

// Bifrost's concurrency_and_buffer_size: at most concurrency upstream calls at once, and up to buffer_size waiting.
export type ConcurrencyConfig = { concurrency: int, buffer_size: int }

export type OpenAIProviderConfig = { disable_store?: bool }

// Provider-level prompt cache: auto_inject turns on the gateway's cache breakpoints for this provider.
// ttl sets the breakpoints' lifetime; cache_control_injection_points mark the messages they name on Anthropic, Claude on
// Vertex and Bedrock Mantle, and Bedrock Converse (anthropic.tov injectedIndexes, bedrock.tov converseBody).
export type ProviderPromptCacheConfig = { auto_inject?: bool, ttl?: string, cache_control_injection_points?: { location?: string, role?: string, index?: int }[] }

export type ProviderConfig = {
  keys?: KeyConfig[],
  network_config?: NetworkConfig,
  proxy_config?: ProxyConfig,
  custom_provider_config?: CustomProviderConfig,
  // echo the raw upstream request / response body in the answer (extra_fields.raw_*)
  send_back_raw_request?: bool,
  send_back_raw_response?: bool,
  // keep the raw upstream request and response in the log store (never in the answer unless sent back)
  store_raw_request_response?: bool,
  concurrency_and_buffer_size?: ConcurrencyConfig,
  openai_config?: OpenAIProviderConfig,
  prompt_cache?: ProviderPromptCacheConfig,
  injected_tools?: InjectedTool[],
  // Bifrost: when true, cost comes from the pricing table even if the provider reports usage.cost
  ignore_provider_cost?: bool,
}

export type ClientConfig = {
  drop_excess_requests?: bool,
  // how long a rotated virtual key's old value keeps working, as a duration ("0" or unset: at once)
  vk_rotation_cooldown?: string,
  // "body" (default) or "headers": where Bifrost's extra_fields (raw request/response) go
  extra_fields_placement?: string,
  // Bifrost's content-logging controls: keep request and response bodies out of the log
  // store and exporters; the x-bf-disable-content-logging header counts only when
  // allow_per_request_content_storage_override is on
  disable_content_logging?: bool,
  allow_per_request_content_storage_override?: bool,
  // keep the bodies of a content-off request in logs_store.object_storage, as hidden objects (retained.tov)
  retain_content_in_object_storage?: bool,
  enable_logging?: bool,
  enable_governance?: bool,
  enforce_governance_header?: bool,
  // Bifrost: require a virtual key (or admin credentials) on inference. When omitted it is on
  // if the config has any credentials to use (virtual keys, admin users or auth_config).
  enforce_auth_on_inference?: bool,
  // headers every inference request must carry (lower-case names), e.g. ["x-team"]
  required_headers?: string[],
  // callers may send their own provider key (x-bf-direct-key: true + Authorization / x-api-key)
  allow_direct_keys?: bool,
  // Raiju only: refuse a request that is subject to a budget when its model has no price
  // (no datasheet row, override or config price). Off, the request passes and its cost is 0,
  // as in Bifrost.
  refuse_unpriced_models?: bool,
  // x-bf-send-back-raw-request / -response headers override the provider's send_back_raw_* settings
  allow_per_request_raw_override?: bool,
  allowed_origins?: string[],
  max_request_body_size_mb?: int,
  prometheus_labels?: string[],
  async_job_result_ttl?: int, // seconds
  // MCP agent mode: tool calls to these chat tool names ("<server>-<tool>", or "*") run in the gateway
  mcp_agent_depth?: int,
  mcp_auto_execute?: string[],
  // Bifrost: MCP tools are not added to chat requests unless a request names its clients (x-bf-mcp-include-clients)
  mcp_disable_auto_tool_inject?: bool,
  // Bifrost's a2a_external_client_url: the public base URL the A2A gateway's agent cards advertise (agents.tov)
  a2a_external_client_url?: string,
  // Raiju's: how often the cards of the registered agents are fetched again, in seconds (default 300; 0 turns
  // the timer off). A card is also fetched again, at most once a minute, when the agent answers HTTP 404, 405, 410 or 426.
  a2a_card_refresh_seconds?: int,
  // Bifrost's a2a_store_raw_request_response: each A2A call's log row keeps the bytes sent to the agent and the bytes it
  // answered (base64, at most 1 MiB each way), shown by GET /api/agents/history/{id} (ops.tov a2aCall)
  a2a_store_raw_request_response?: bool,
  // request headers copied into each log row's metadata: exact names, or prefixes ending in "*" (reqlog.tov)
  logging_headers?: string[],
  // Bifrost's compat plugin settings (src/compat.tov); absent means the plugin is off unless a request's x-bf-compat turns features on
  compat?: CompatConfig,
  // Bifrost's header controls. header_filter_config filters the x-bf-eh-* headers sent upstream
  // (an allowlist, when set, is the only way in; the denylist always blocks). allowed_headers adds
  // to the CORS allow list. whitelisted_routes skip the admin login (exact paths).
  header_filter_config?: HeaderFilterConfig,
  allowed_headers?: string[],
  whitelisted_routes?: string[],
  // Bifrost: an inference request with both an identity token and x-bf-vk: "error" (400),
  // "prefer_vk" (the token is dropped) or "prefer_idp" (default). Raiju's identity is OIDC (oidc.tov).
  dual_credential_conflict_behavior?: string,
  // Bifrost: full error details go to the server console (never to the client)
  dump_errors_in_console_logs?: bool,
  // Bifrost: the deepest model alias chain a key may follow (default 10)
  routing_chain_max_depth?: int,
  // Bifrost: request types left out of the log and dashboard reads (logs are still stored)
  hidden_request_types?: string[],
  // Bifrost's virtual key lifecycle settings (read and kept; vk_rotation_cooldown is above)
  hide_deleted_virtual_keys_in_filters?: bool,
  delete_expired_virtual_keys?: bool,
  enforce_vk_object_ownership?: bool,
  // Bifrost: scoped temp tokens may open the per-user MCP consent flows (src/mcpuser.tov)
  mcp_enable_temp_token_auth?: bool,
  // Bifrost's MCP server auth for /mcp: "headers" (default; virtual keys only), "both" (keys and
  // Bifrost-issued JWTs) or "oauth" (JWTs only). Raiju is the authorization server (src/mcpissuer.tov).
  mcp_server_auth_mode?: string,
  oauth2_server_config?: OAuth2ServerConfig,
  // Bifrost's webhook settings: deliveries older than this many days are dropped (default 30)
  webhook_config?: WebhookConfigSettings,
}

// Bifrost's oauth2_server_config. issuer_url is the authorization server's identity (the iss claim and the
// discovery documents) and is required when client.mcp_server_auth_mode is "both" or "oauth". signing_key is
// the RS256 private key (PEM, PKCS#1 or PKCS#8) that signs the tokens. When it is not set, Raiju generates one at the
// first start and keeps it in mcp-oauth-state.json beside config.json (as Bifrost stores its own), and a configured
// key always wins. issuer_url and signing_key may be env.NAME references.
export type OAuth2ServerConfig = {
  issuer_url?: string,
  auth_code_ttl?: int,
  access_token_ttl?: int,
  allowed_redirect_uris?: string[],
  disable_vk_identity?: bool,
  signing_key?: string,
}

export type HeaderFilterConfig = { allowlist?: string[], denylist?: string[] }
export type WebhookConfigSettings = { delivery_history_retention_days?: int }

// Bifrost's compat features. A section that is there turns every feature on, except convert_decision_to_responses.
export type CompatConfig = {
  convert_text_to_chat?: bool,
  convert_chat_to_responses?: bool,
  should_drop_params?: bool,
  should_convert_params?: bool,
  azure_deepseek?: bool,
  force_reasoning_only_models_to_responses?: bool,
  convert_decision_to_responses?: bool,
}

// A budget override adds amount to max_limit while it is set. Raiju keeps the "forever" mode only:
// it stays until it is cleared (Bifrost's budget override, PUT and DELETE .../budgets/{id}/override).
// mode "forever" adds amount to the limit; "cycles" adds it for cycles reset windows (the current one counts).
// started_at (RFC 3339, set when a cycles override is saved) is when its cycles begin: a restart counts the
// windows that have passed since then, so the cycles left survive it (governance.tov).
export type BudgetOverride = { amount: f64, mode: string, cycles?: int, started_at?: string }
export type BudgetConfig = { id: string, max_limit: f64, reset_duration: string, current_usage?: f64, override?: BudgetOverride }
export type RateLimitConfig = {
  id: string,
  token_max_limit?: int,
  token_reset_duration?: string,
  request_max_limit?: int,
  request_reset_duration?: string,
}
export type ProviderConfigRef = { provider: string, weight?: f64, allowed_models?: string[], budget_id?: string, rate_limit_id?: string }
export type VirtualKeyConfig = {
  id: string,
  name?: string,
  value: string,
  // per-key override of client.disable_content_logging
  disable_content_logging?: bool,
  description?: string,
  is_active?: bool,
  team_id?: string,
  customer_id?: string,
  budget_id?: string,
  rate_limit_id?: string,
  provider_configs?: ProviderConfigRef[],
  key_ids?: string[],
  access_profile_ids?: string[],
  // RFC 3339; the key is refused from this time on (Bifrost's expires_at)
  expires_at?: string,
  // the value a rotation retired, accepted until previous_value_expires_at (client.vk_rotation_cooldown)
  previous_value?: string,
  previous_value_expires_at?: string,
  rotated_at?: string,
  // Bifrost's virtual_key_mcp_config list: the MCP tools this key may run, per client. Absent means
  // no list (the key is not limited); a list, even an empty one, is judged as Bifrost judges it.
  mcp_configs?: McpKeyConfig[],
  // the user this key is assigned to (Bifrost's governance user); recorded on the key's log entries
  user_id?: string,
  // Bifrost's agent_grants: the registered A2A agents (by name) this key may call, besides the agents' own virtual_key_ids
  agent_grants?: AgentGrant[],
  // Bifrost's delete_after_expire: the cleanup deletes the key once it has expired. Absent inherits
  // client.delete_expired_virtual_keys.
  delete_after_expire?: bool,
}
// A reusable permission set that virtual keys reference (access_profile_ids); see profiles.tov.
// roles are the roles (built-in or custom, by id) the profile is attached to (Bifrost's role attachments): the
// users of a role an attachment reaches hold the profile (govapi.tov heldProfileIds, bindingReaches).
// An attachment made through the API records who it reaches (Bifrost provisions the profile per user):
// users lists those given it when it was attached (apply_to_existing), and except those in the role then who
// were not; with is_default, everyone else who holds the role later holds it too. An attachment without users
// (from the config file, or saved before this) reaches every user of the role.
export type ProfileRole = { role_id: int, is_default?: bool, users?: string[], except?: string[] }
export type AccessProfile = {
  id: string,
  name?: string,
  description?: string,
  roles?: ProfileRole[],
  provider_configs?: ProviderConfigRef[],
  // "provider/model", "provider/*" or "*"
  allowed_models?: string[],
  denied_models?: string[],
  budget_id?: string,
  rate_limit_id?: string,
  mcp_tools?: string[],
  // the MCP tools per client, and the virtual MCPs (by name) the profile grants
  mcp_configs?: McpKeyConfig[],
  virtual_mcps?: string[],
  // the A2A agents the profile grants its holders (Bifrost Enterprise's profile agent_grants)
  agent_grants?: AgentGrant[],
  required_headers?: string[],
  max_tokens?: int,
  is_active?: bool,
  // the change history, oldest first (Bifrost's versions); see profiles.tov
  versions?: ProfileVersion[],
}

// One entry of a profile's history: the change (create, update, activate, deactivate or clone), when it
// was made, and the profile as JSON text without its own versions.
export type ProfileVersion = { version: int, action: string, at: string, snapshot: string }

export type PricingOverrideConfig = {
  id?: string,
  name?: string,
  scope_kind: string,
  provider_id?: string,
  provider_key_id?: string,
  virtual_key_id?: string,
  user_id?: string,
  request_types?: string[],
  match_type: string,
  pattern: string,
  pricing_patch: string, // JSON text, as Bifrost stores it
}

// Bifrost's governance.model_configs: budgets and a rate limit for one model (or "*" for every
// model) on one provider (or every provider). Budgets and the rate limit are named by id, as the
// config file has them; the management API takes them inline and stores them under derived ids.
export type ModelConfigGovernance = {
  id: string,
  model_name: string,
  provider?: string,
  scope?: string, // "global" (default) or "virtual_key"
  scope_id?: string,
  calendar_aligned?: bool,
  budget_id?: string, // deprecated: one budget
  budget_ids?: string[],
  rate_limit_id?: string,
}

// Bifrost's governance.providers: a budget and a rate limit for every model of one provider.
export type ProviderGovernance = { id?: string, name: string, description?: string, budget_id?: string, budget_ids?: string[], rate_limit_id?: string }

// Where the price datasheet comes from (Bifrost's framework.pricing): fetched at start and
// every interval_seconds (at least an hour); the built-in copy is used until then. The MCP server library
// (src/mcplibrary.tov) syncs from mcp_library_url (Bifrost's default when unset) every
// mcp_library_sync_interval seconds (a day when unset, 0 never); enabled false leaves the prices alone but not
// a library that names its URL.
export type PricingSyncConfig = { url?: string, interval_seconds?: int, enabled?: bool, mcp_library_url?: string, mcp_library_sync_interval?: int }

export type TeamConfig = { id: string, name: string, customer_id?: string, budget_id?: string, business_unit_id?: string }
export type CustomerConfig = { id: string, name: string, budget_id?: string }

// Bifrost's governance.business_units: a group of teams and customers with its own budget and rate
// limit. A team's spend also counts against its business unit (team_ids or the team's business_unit_id).
export type BusinessUnitConfig = { id: string, name: string, budget_id?: string, rate_limit_id?: string, team_ids?: string[], customer_ids?: string[] }

// Bifrost's governance.projects: a scope a request opts into with x-bf-project-id or x-bf-project-name.
// access_rule "union" (default) adds the project's provider configs to the caller's own access;
// "intersect" allows only what both allow. accounting_mode "both" (default) charges the project and
// the caller, "project_only" charges only the project, "principal_only" only the caller.
// membership_mode "explicit" (default) admits the virtual keys in virtual_key_ids; "open" admits any caller.
export type ProjectConfig = {
  id: string,
  name: string,
  description?: string,
  is_active?: bool,
  access_rule?: string,
  accounting_mode?: string,
  membership_mode?: string,
  virtual_key_ids?: string[],
  budget_id?: string,
  rate_limit_id?: string,
  provider_configs?: ProviderConfigRef[],
  // the MCP tools the project may run, per client, and the virtual MCPs (by name) it is assigned
  mcp_configs?: McpKeyConfig[],
  virtual_mcps?: string[],
  // the A2A agents the project grants, combined with the caller's by access_rule (Bifrost Enterprise's project agent_grants)
  agent_grants?: AgentGrant[],
  // "none" (default) holds the members together in the project's caps; "equal" gives each member an equal
  // slice of every budget the project holds (governance.tov addMemberCaps)
  split_policy?: string,
  members?: ProjectMember[],
}

// A member of a project (Bifrost's project member, here a user by name). budget_shares and rate_limit_shares
// are the member's own caps under split_policy none: a percent or an amount of a budget or rate limit the
// project holds.
export type MemberShare = { source_budget_id: string, share_value: f64, share_type: string }
// A member's own cap on a rate limit the project holds (Bifrost's rate_limit_shares): a token share and a
// request share, each a percent or an amount ("amount" when the type is left out). Under split none only.
export type RateLimitShare = { source_rate_limit_id: string, token_share?: int, token_share_type?: string, request_share?: int, request_share_type?: string }
export type ProjectMember = { id: string, user_id: string, budget_shares?: MemberShare[], rate_limit_shares?: RateLimitShare[] }

// Bifrost's governance.roles entry: a named set of resource and operation permissions, and the data
// access scope (dac) of its users. The built-in roles admin, editor, viewer and auditor are not listed here.
export type PermissionPair = { resource: string, operation: string }
// entity_dac: a data access scope for one resource, overriding the role's dac on that resource (Bifrost's
// entity_dac object, kept as a list here; the management API reads and writes it as an object).
export type EntityDac = { resource: string, dac: string }
// id is Bifrost's role id (the number the RBAC routes and access profile attachments use). A role saved
// without one gets the next free id when the roles are next written (rbac.tov withRoleIds).
export type RoleConfig = { id?: int, name: string, description?: string, dac?: string, permissions?: PermissionPair[], entity_dac?: EntityDac[] }

// Credentials for the management API and UI (Bifrost's governance.auth_config, or its
// deprecated top-level auth_config): admin_username/admin_password/is_enabled as Bifrost
// writes them, or username/password/token.
export type AdminAuthConfig = { username?: string, password?: string, token?: string, admin_username?: string, admin_password?: string, is_enabled?: bool, disable_auth_on_inference?: bool }

// Bifrost's scim_config: enabled switches /scim/v2 on, and config.provisioningToken is the bearer token the
// identity provider sends (env.NAME allowed). Other Bifrost keys under scim_config are not read.
export type ScimConfig = { enabled?: bool, config?: { provisioningToken?: string } }

export type AdminUserConfig = {
  name: string,
  // the user's email address (Bifrost's users carry one; unique, compared without case)
  email?: string,
  // a built-in role (admin, editor, viewer, auditor) or the name of a custom role under governance.roles
  role: string,
  token_sha256?: string,
  password_sha256?: string,
  salt?: string,
  disabled?: bool,
  // the teams, business units and projects the user belongs to: the data they may see (see governance.tov)
  teams?: string[],
  business_units?: string[],
  projects?: string[],
  // the access profiles the user holds, the first ranked highest (Bifrost's user access profiles)
  access_profile_ids?: string[],
}

export type GovernanceConfig = {
  auth_config?: AdminAuthConfig,
  users?: AdminUserConfig[],
  access_profiles?: AccessProfile[],
  // Bifrost's custom pricing (docs/providers/custom-pricing): rates patched over the datasheet
  pricing_overrides?: PricingOverrideConfig[],
  budgets?: BudgetConfig[],
  rate_limits?: RateLimitConfig[],
  virtual_keys?: VirtualKeyConfig[],
  teams?: TeamConfig[],
  customers?: CustomerConfig[],
  business_units?: BusinessUnitConfig[],
  projects?: ProjectConfig[],
  roles?: RoleConfig[],
  routing_rules?: RoutingRule[],
  model_configs?: ModelConfigGovernance[],
  providers?: ProviderGovernance[],
  // management API keys (Bifrost's /api/api-keys): only the SHA-256 of each value is kept
  api_keys?: ApiKeyConfig[],
}

// A management API key. Its value is shown once, when it is created; key_sha256 is what authenticates it.
// permissions are the RBAC (resource, operation) pairs the key holds; the API lists them by id (see govapi.tov).
export type ApiKeyConfig = {
  id: int,
  name: string,
  description?: string,
  key_sha256: string,
  key_prefix: string,
  permissions: PermissionPair[],
  created_by_user_id?: string,
  expires_at?: string,
  created_at: string,
  updated_at: string,
}

// scope_by_virtual_key (Raiju only, on unless false): the exact-match cache keeps each virtual
// key's entries apart, as the semantic cache does; false lets keys share exact entries.
export type CacheConfig = { enabled?: bool, ttl_seconds?: int, max_entries?: int, cache_by_model?: bool, cache_by_provider?: bool, scope_by_virtual_key?: bool }

// Circuit breakers and adaptive load balancing across keys.
export type HealthConfig = {
  circuit_breaker?: bool,
  adaptive?: bool,
  // the provider level of adaptive load balancing (Bifrost's load_balancer_config; router.tov directRefs):
  // direction_selection (on unless false) picks a healthy provider for a request that names none, and the three
  // opt-in switches act on requests that name one
  direction_selection?: bool,
  append_fallbacks_to_pinned?: bool,
  reroute_failed_directions?: bool,
  prune_failed_fallbacks?: bool,
  failure_threshold?: int,
  failure_rate_threshold?: f64,
  min_requests?: int,
  window_seconds?: int,
  open_seconds?: int,
}

// A circuit policy as the config file keeps it: Bifrost's circuit_breaker_config.policies entry.
// default_cooldown is a Go duration ("30s"); health.tov reads it and writes it back.
export type CircuitSignalConfig = { source: string, header_name: string, header_value?: string, header_contains?: string }
export type CircuitPolicyConfig = {
  name: string,
  enabled?: bool,
  primary_provider: string,
  primary_model: string,
  primary_key_ids?: string[],
  fallback_provider: string,
  fallback_model: string,
  condition: { operator?: string, signals: CircuitSignalConfig[] },
  default_cooldown?: string,
  cooldown_header?: string,
}

// Native guardrails: which detectors run, what happens on a finding, and where.
// An external guardrail service checked before (input) or after (output) the model.
export type PatronusEvaluatorConfig = { evaluator: string, criteria?: string }

// A regex guardrail pattern (Bifrost's custom regex provider). action is block,
// redact or detect_only; allowed_values are exact matches to ignore.
export type RegexRuleConfig = {
  pattern: string,
  description?: string,
  entity_type?: string,
  flags?: string,
  action?: string,
  allowed_values?: string[],
  // a redact rule with "logs_only" leaves live traffic raw and redacts the stored log copy (Bifrost's mode)
  redaction_mode?: string,
}

export type GuardrailProviderConfig = {
  id: string,
  kind: "bedrock" | "azure_content_safety" | "patronus" | "webhook" | "regex" | "secrets" | "prompt_judge" | "presidio" | "azure_language_pii" | "google_model_armor" | "crowdstrike_aidr",
  apply_to?: "input" | "output" | "both",
  on_error?: "allow" | "block",
  // where the provider runs: "llm" (default) and/or "mcp" (tool calls; regex and secrets only)
  targets?: string[],
  // with the "mcp" target: a regex on the tool name (anchored); empty means every tool
  tool_pattern?: string,
  // presidio, azure_language_pii: block, redact or detect_only (default detect_only)
  action?: string,
  // redact actions: runtime (default), logs_only or runtime_reversible
  redaction_mode?: string,
  // bedrock
  guardrail_id?: string,
  guardrail_version?: string,
  region?: string,
  access_key?: string,
  secret_key?: string,
  session_token?: string,
  // azure_content_safety
  endpoint?: string,
  api_key?: string,
  threshold?: number,
  categories?: string[],
  // patronus
  evaluators?: PatronusEvaluatorConfig[],
  base_url?: string,
  // webhook
  url?: string,
  headers?: Map<string, string>,
  // regex
  patterns?: RegexRuleConfig[],
  // secrets (Gitleaks rules)
  ignored_secret_keywords?: string[],
  // prompt_judge: judge_provider and judge_model name the model the gateway calls
  judge_provider?: string,
  judge_model?: string,
  rule?: string,
  system_prompt?: string,
  max_output_tokens?: int,
  // presidio
  analyzer_url?: string,
  language?: string,
  score_threshold?: number,
  entities?: string[],
  // azure_language_pii (endpoint and api_key above)
  api_version?: string,
  model_version?: string,
  domain?: string,
  pii_categories?: string[],
  // google_model_armor: a bearer token for the Model Armor REST API
  project_id?: string,
  location?: string,
  template_id?: string,
  access_token?: string,
  // crowdstrike_aidr (api_key and base_url above)
  app_id?: string,
  collector_instance_id?: string,
}

export type GuardrailsConfig = {
  enabled?: bool,
  // external services (AWS Bedrock Guardrails, Azure AI Content Safety, Patronus, a webhook)
  // and local or HTTP providers (regex, secrets, prompt_judge, Presidio, Azure Language PII, Model Armor, AIDR)
  providers?: GuardrailProviderConfig[],
  detect?: string[],
  mode?: string, // "redact" (default), "block" or "log"
  custom?: string[],
  apply_to?: string, // "input" (default), "output" or "both"
  // redact by placeholder and restore the placeholders in the response (runtime_reversible)
  reversible?: bool,
  // Bifrost's redaction_mode logs_only for the built-in detectors in redact mode: the live request and response
  // stay raw, and the request log, its raw payloads, log exports and retained content get numbered
  // placeholders ([EMAIL-1]). A secrets or regex provider's own logs_only rules work the same way.
  logs_only?: bool,
  // delay in ms between the events of a cached stream replayed while a block-capable output guard is on
  // (Bifrost's rule key of the same name; 0 sends the events at once, at most 1000)
  stream_replay_event_interval_ms?: int,
  // a live stream under a block-capable output guard is held until the guards pass (Bifrost's behaviour).
  // Raiju bounds the hold: at most stream_hold_max_bytes held (default 8388608) for at most
  // stream_hold_max_ms (default 300000); 0 lifts a bound. Past a bound the stream is blocked, or with
  // stream_hold_on_limit "release" the held events go out and the stream continues live.
  stream_hold_max_bytes?: int,
  stream_hold_max_ms?: int,
  stream_hold_on_limit?: string, // "block" (default) or "release"
}

// Request logs: JSONL files with retention, plus an in-memory index for /api/logs.
// Bifrost's logs_store block (enabled, type, config) also turns this on.
export type LogsStoreConfig = {
  enabled?: bool,
  dir?: string,
  retention_days?: int,
  max_memory_entries?: int,
  content_logging?: bool,
  // where retained content goes (client.retain_content_in_object_storage); Bifrost's logs_store.object_storage
  object_storage?: LogsObjectStorage,
}

// The bucket that holds retained content: S3, or GCS through its S3-compatible interop API. Keys may be
// env.NAME references, as the log export keys are.
export type LogsObjectStorage = {
  type: "s3" | "gcs",
  bucket: string,
  prefix?: string, // default "bifrost"
  region?: string,
  endpoint?: string,
  access_key_id: string,
  secret_access_key: string,
  session_token?: string,
  path_style?: bool,
  compress?: bool, // gzip each object (keys end in .json.gz)
}

// A plugin from the config's plugins list. Its "config" object can hold any JSON,
// which typed parsing can't, so it's kept as raw text in config_json.
// placement and order are Bifrost's sequencing fields: the placement group (pre_builtin, builtin or
// post_builtin, default post_builtin) and the position within it (lower runs first, default 0).
// path names a .wasm file (Bifrost's custom plugin path; only WebAssembly plugins load, see wasmplugin.tov)
// and wasm_limits caps that plugin: pages of memory, bytes of operand stack, instructions per hook call.
export type WasmLimitsSpec = { max_memory_pages?: int, max_stack_bytes?: int, max_instructions?: int, max_time_ms?: int }
export type PluginSpec = { name: string, enabled?: bool, config_json?: string, placement?: string, order?: int, path?: string, wasm_limits?: WasmLimitsSpec }

// Semantic caching (Bifrost's semantic_cache plugin): on an exact-cache miss the
// prompt is embedded and a stored answer to a similar prompt is returned.
export type SemanticCacheSettings = {
  enabled?: bool,
  provider: string, // embedding provider, e.g. "openai"
  embedding_model: string,
  threshold?: f64,
  ttl?: int, // seconds
  max_entries?: int,
  conversation_history_threshold?: int,
  exclude_system_prompt?: bool,
  cache_by_model?: bool,
  cache_by_provider?: bool,
  cache_tool_call_responses?: bool, // store responses that carry tool calls (Bifrost default: no)
  disable_identity_scoping?: bool, // share entries across virtual keys (Bifrost default: scoped per key)
  default_cache_key?: string,
  // Bifrost's vector_store_namespace (the store's collection or index name) and dimension
  vector_store_namespace?: string,
  dimension?: int,
}

export type PromptCacheConfig = { auto_inject?: bool }

// A model's price in the config (config.pricing, per token). The optional rates are Bifrost's datasheet
// fields: the cache read rate, the audio token rates of realtime models and the voice rate of a live
// session per second.
export type PricingEntry = {
  input_cost_per_token: f64,
  output_cost_per_token: f64,
  cache_read_input_token_cost?: f64,
  input_cost_per_audio_token?: f64,
  output_cost_per_audio_token?: f64,
  input_cost_per_second?: f64,
  input_cost_per_audio_per_second?: f64,
}

// vault.<path>#<field> and aws-sm.<id>[#<field>] values are fetched at load and on reload.
export type SecretsConfig = {
  vault?: { address: string, token?: string, namespace?: string, mount?: string },
  aws?: { region: string, access_key?: string, secret_key?: string, session_token?: string },
}

// retention_days deletes events older than that (0 or unset keeps them); omit_ip_addresses stops recording
// client IPs; archive copies the events to object storage (LogExportsConfig's S3 or GCS fields) one window
// at a time, a window ending archive_grace_seconds before now. Each window is written as parts of at most
// archive_max_object_bytes, gzipped when archive_compress is set, then a manifest that commits it.
export type AuditConfig = { enabled?: bool, dir?: string, key?: string, max_memory?: int, retention_days?: int, omit_ip_addresses?: bool, archive?: LogExportsConfig, archive_grace_seconds?: int, archive_max_object_bytes?: int, archive_compress?: bool }

// rules are metric thresholds; cel_rules are Bifrost's CEL alert rules (alertapi.tov).
export type AlertsConfig = { enabled?: bool, interval_seconds?: int, rules?: AlertRule[], cel_rules?: CelRule[], channels?: Channel[] }

// Request logs shipped to S3-compatible storage (S3, MinIO, GCS interoperability keys).
export type LogExportsConfig = {
  enabled: bool,
  kind: "s3" | "gcs",
  bucket: string,
  prefix?: string,
  region?: string,
  endpoint?: string,
  access_key_id: string,
  secret_access_key: string,
  session_token?: string,
  interval_seconds?: int,
  path_style?: bool,
  format?: "jsonl" | "parquet", // default jsonl; parquet writes one file per batch (sink_parquet.tov)
  retention_days?: int, // delete export objects whose day is older than this many days; unset keeps them
}

// Request logs sent in batches to Datadog, Splunk HEC, Elasticsearch, any HTTP endpoint,
// or the Google (BigQuery, Pub/Sub), Kafka and Maxim sinks (exporters.tov, sink_*.tov).
export type LogExporterConfig = {
  id: string,
  kind: "datadog" | "splunk" | "elasticsearch" | "http" | "bigquery" | "pubsub" | "kafka" | "maxim",
  enabled?: bool,
  batch_size?: int,
  interval_seconds?: int,
  include_content?: bool,
  api_key?: string, // datadog; elasticsearch (ApiKey auth)
  site?: string, // datadog host suffix, default datadoghq.com
  service?: string, // datadog, default raiju
  tags?: string[], // datadog
  hostname?: string, // datadog
  url?: string, // splunk HEC base; elasticsearch; http
  token?: string, // splunk
  index?: string, // splunk; elasticsearch, may hold %Y.%m.%d
  sourcetype?: string, // splunk, default raiju:request
  username?: string, // elasticsearch basic auth
  password?: string, // elasticsearch basic auth
  headers?: Map<string, string>, // http
  format?: "json" | "ndjson", // http, default json
  project_id?: string, // bigquery, pubsub: the GCP project
  dataset_id?: string, // bigquery, default raiju_logs
  table_id?: string, // bigquery, default requests
  topic_id?: string, // pubsub
  service_account_key?: string, // bigquery, pubsub: service-account JSON; unset uses the metadata server (ADC)
  brokers?: string[], // kafka: host:port list, the first is the bootstrap
  topic?: string, // kafka
  tls?: bool, // kafka: TLS with the system CA pool
  sasl_username?: string, // kafka SASL/PLAIN; sasl_password is required with it
  sasl_password?: string, // kafka SASL/PLAIN
  log_repo_id?: string, // maxim: the log repository the entries go to
  base_url?: string, // maxim: default https://app.getmaxim.ai; bigquery and pubsub: the API host (default Google's)
}

export type AffinitySettings = { enabled?: bool, ttl_seconds?: int, max_sessions?: int }

// The complexity classifier: "heuristic" (the default), or "decision", "llm" or "semantic" (or "embedding"),
// which ask a model. Timeouts are in milliseconds. See complexity.tov.
export type ComplexityDecisionSettings = { provider?: string, model?: string, timeout_ms?: int, previous_message_count?: int }
export type ComplexityLLMSettings = { provider?: string, model?: string, timeout_ms?: int, prompt?: string, message_history_count?: int }
export type ComplexityExemplars = { simple?: string[], medium?: string[], complex?: string[] }
export type ComplexitySemanticSettings = { provider?: string, embedding_model?: string, timeout_ms?: int, min_similarity?: f64, message_history_count?: int, exemplars?: ComplexityExemplars }

export type ComplexitySettings = { enabled?: bool, model?: string, simple_max_score?: f64, complex_min_score?: f64, tiers?: TierMap, classifier?: string, decision?: ComplexityDecisionSettings, llm?: ComplexityLLMSettings, semantic?: ComplexitySemanticSettings }

export type Config = {
  // Bifrost's encryption_key: saved provider key values are encrypted with it (env.NAME allowed)
  encryption_key?: string,
  // Bifrost's setup_token: the operator's secret for the first admin account (env.NAME allowed);
  // while no admin exists, POST /api/users needs it in the X-Bifrost-Setup-Token header
  setup_token?: string,
  client?: ClientConfig,
  providers?: Map<string, ProviderConfig>,
  governance?: GovernanceConfig,
  cache?: CacheConfig,
  pricing?: Map<string, PricingEntry>,
  prompt_cache?: PromptCacheConfig,
  health?: HealthConfig,
  // circuit breaker policies: a primary's circuit opens on response headers and reroutes to a fallback
  circuit_breaker_policies?: CircuitPolicyConfig[],
  guardrails?: GuardrailsConfig,
  logs_store?: LogsStoreConfig,
  otel?: OtelConfig,
  // Bifrost's telemetry plugin config (push_gateway; mapped from plugins[telemetry] by config_compat)
  telemetry?: { push_gateway?: PushGatewayConfig, overhead_breakdown_enabled?: bool, user_labels_enabled?: bool },
  mcp?: McpConfig,
  plugins?: PluginSpec[],
  semantic_cache?: SemanticCacheSettings,
  // Where semantic cache entries go when not in memory (Bifrost's top-level vector_store)
  vector_store?: VectorStoreSettings,
  pricing_sync?: PricingSyncConfig,
  // Bifrost's deprecated top-level auth_config; governance.auth_config wins
  auth_config?: AdminAuthConfig,
  secrets?: SecretsConfig,
  audit?: AuditConfig,
  alerts?: AlertsConfig,
  session_affinity?: AffinitySettings,
  complexity_router?: ComplexitySettings,
  mcp_server?: { enabled?: bool },
  // named tool sets from several MCP servers, served at /mcp/{name}
  virtual_mcps?: VirtualMcp[],
  log_exports?: LogExportsConfig,
  exporters?: LogExporterConfig[],
  cluster?: ClusterConfig,
  oidc?: OidcConfig,
  // identity-aware proxy in front of the API (Bifrost's authProxy under scim_config)
  auth_proxy?: AuthProxyConfig,
  // inbound SCIM 2.0 provisioning at /scim/v2 (scim.tov)
  scim_config?: ScimConfig,
  proxy_config?: GlobalProxyConfig,
  // Bifrost-style prompt repository (prompts.tov): prompts with their versions, and deployments
  prompt_repo?: PromptRepoConfig,
  // Bifrost's POST /api/config/metadata: UI and admin preferences (string, number or bool values)
  metadata?: Map<string, string | f64 | bool>,
  // Bifrost's webhooks: endpoints that get signed async-job outcomes (webhooks.tov)
  webhooks?: WebhookEndpoint[],
  // Bifrost's agents: registered A2A agents, served at /agents/a2a/{name} (agents.tov)
  agents?: AgentConfig[],
  // Bifrost's server section; Raiju reads a2a_allow_private_push_callbacks (push callbacks may be private addresses) and
  // the A2A gRPC keys (see ServerSectionConfig)
  server?: ServerSectionConfig,
  // Bifrost's feature_flags: boot-time overrides of the flags in flags.tov
  feature_flags?: FeatureFlagsConfig,
  // User-Agent to app mappings for the request logs (logapi.tov); edited through /api/logs/user-agent-mappings
  user_agent_mappings?: UserAgentMapping[],
  // Bifrost's websocket section: the session cap per WebSocket route (see WebSocketConfig)
  websocket?: WebSocketConfig,
  // Bifrost's large_payload_optimization: big request bodies stream to the provider (see LargePayloadConfig)
  large_payload_optimization?: LargePayloadConfig,
  // Raiju-only crew routing (crew.tov, docs/crew-routing.md): pools whose model is crew/<pool>
  crews?: CrewsConfig,
}

// Crew routing (docs/crew-routing.md). A pool names its roles, task classes and candidate models; the
// priors and classifier are files (relative to the config file's folder) or inline objects.
export type CrewCandidate = { id: string, model: string, route?: string, roles?: string[], subscription?: string, reasoning_effort?: string }
export type CrewSubscription = { name: string, window_hours: number, limit_usd: number, free_until_fraction?: number }
export type CrewCallProfile = { calls: number, input_tokens: number, output_tokens: number }
export type CrewOperatingPoint = { mode?: string, lambda?: number, budget_usd?: number, step?: number }
export type CrewSequential = { enabled?: bool, max_attempts?: int, per_candidate?: int, verifier_accuracy?: Map<string, number>, tau?: number, omega?: number, omega_base?: number }
export type CrewPool = {
  name: string,
  roles: string[],
  classes: string[],
  uncertain_class?: string,
  candidates: CrewCandidate[],
  subscriptions?: CrewSubscription[],
  profiles?: Map<string, Map<string, CrewCallProfile>>,
  priors?: string | CrewPriorsFile,
  classifier?: string | CrewClassifierFile,
  operating_point?: CrewOperatingPoint,
  sequential?: CrewSequential,
  credibility?: { prior_scale?: number },
}
export type CrewsConfig = { task_ttl_seconds?: int, pools?: CrewPool[] }

// The priors file (version 1; see docs/crew-routing.md, Priors file).
export type CrewPriorCell = { class: string, role: string, candidate: string, delta: number, n?: number, info?: number }
export type CrewPriorInteraction = { class: string, roles: string[], a: string, b: string, value: number }
export type CrewPriorsFile = { version?: int, baseline?: Map<string, number>, cells?: CrewPriorCell[], interactions?: CrewPriorInteraction[], irt?: Map<string, Map<string, { l: number, kappa: number }>> }

// The classifier file (version 1; see docs/crew-routing.md, Classifier file, and taskclass.tov).
export type CrewClassifierFile = { version?: int, buckets?: int, hash?: string, classes?: string[], prior?: Map<string, number>, temperature?: number, floor?: number, uncertain_below?: number, uncertain_class?: string, bias?: Map<string, number>, scale?: Map<string, number>, weights?: Map<string, number[][]>, named?: Map<string, Map<string, number>> }

// A rule that names the app a request's User-Agent belongs to. match_type is contains, starts_with or exact.
export type UserAgentMapping = { id: string, pattern: string, match_type: string, app: string, is_active?: bool, created_at?: string, updated_at?: string }

// One registered A2A agent. agent_card_url is the upstream card; card is the card as last fetched (its raw
// JSON), which the gateway serves and proxies to. discovery_auth authenticates the card fetch, runtime_auth
// the proxied calls. Header values may be env.NAME references. allow_private_network lets the card URL and
// the agent's endpoint be on a private address (the SSRF guard otherwise refuses them, as for webhooks).
// An auth is type none, headers or oauth (a client-credentials grant the gateway fetches a token with). tls
// sets how the card and the agent are reached over https; the client certificate and key are kept but not
// used (Tov's fetch has no client certificates). security_schemes and advanced record the form's choices.
// a2a_grpc_base_domain and a2a_grpc_port enable the A2A gRPC binding (a2agrpc.tov): agents are served at
// <name>.<base domain>, the port is the advertised one (RAIJU_A2A_GRPC_LISTEN_PORT overrides the bind port).
// Both must be set; read at start.
// plugin_download_private_allowlist: hosts a plugin URL may name although they are private (plugindl.tov), as Bifrost reads it.
export type ServerSectionConfig = { a2a_allow_private_push_callbacks?: bool, a2a_grpc_base_domain?: string, a2a_grpc_port?: int, plugin_download_private_allowlist?: string[] }
export type AgentOAuth = { provider_url?: string, discovery_url?: string, token_url?: string, client_id: string, client_secret: string, scopes?: string[], resource?: string }
export type AgentTls = { insecure_skip_verify?: bool, ca_cert_pem?: string, client_cert_pem?: string, client_key_pem?: string }
export type AgentAuth = { type: string, headers?: Map<string, string>, oauth?: AgentOAuth, security_schemes?: string[], advanced?: bool, tls?: AgentTls }
// A grant to call one registered A2A agent, by its name (Bifrost's agent_grants entries).
export type AgentGrant = { agent_name: string }

export type AgentConfig = {
  name: string,
  agent_card_url: string,
  enabled?: bool,
  allow_by_default?: bool,
  virtual_key_ids?: string[],
  discovery_auth?: AgentAuth,
  runtime_auth?: AgentAuth,
  // the caller's accepted gateway credential (its header and value) goes to the agent on each call; with
  // _overrides_auth it also replaces a configured header of the same name
  forward_accepted_credential?: bool,
  forward_accepted_credential_overrides_auth?: bool,
  allow_private_network?: bool,
  // Bifrost's tenant: kept with the registration and shown by the API (Bifrost does not send it on either)
  tenant?: string,
  // Bifrost's extension_uris: the A2A extensions of the agent's card the gateway relays (a2aext.tov)
  extension_uris?: string[],
  card?: string,
  card_fetched_at?: int,
  created_at?: int,
  updated_at?: int,
}

// One endpoint. name is unique; id is assigned when the API creates one, and config entries
// may leave it out (the API then matches them by name). secret is "whsec_" plus base64 of
// the signing key; config may give it as env.NAME.
export type WebhookEndpoint = {
  id?: string,
  name: string,
  url: string,
  events: string[],
  secret?: string,
  headers?: Map<string, string>,
  include_response?: bool,
  allow_private_network?: bool,
  disabled?: bool,
  max_retries?: int,
  retry_backoff_initial_seconds?: int,
  retry_backoff_max_seconds?: int,
  attempt_timeout_seconds?: int,
  max_response_payload_kbs?: int,
  created_at?: int,
  updated_at?: int,
}

// The process environment by name. Tov's process.env takes only names written
// in the source, so names that come from the config are looked up here.
let envCache: Map<string, string> | undefined = undefined

export function getEnv(name: string): string | undefined {
  let m = envCache
  if (m === undefined) {
    const fresh: Map<string, string> = new Map()
    try {
      const text = readFileSync("/proc/self/environ", "utf8")
      for (const entry of text.split("\u0000")) {
        const i = entry.indexOf("=")
        if (i > 0) fresh.set(entry.slice(0, i), entry.slice(i + 1))
      }
    } catch (e) {
      // no /proc: only names known at compile time resolve
    }
    envCache = fresh
    m = fresh
  }
  return m.get(name)
}

// Lookups that avoid `?.get(...)` chains (a Tov compiler bug with them).
export function providerOf(cfg: Config, name: string): ProviderConfig | undefined {
  const ps = cfg.providers
  if (ps === undefined) return undefined
  return ps.get(name)
}

export function providerNames(cfg: Config): string[] {
  const ps = cfg.providers
  if (ps === undefined) return []
  return ps.keys()
}

// Resolves "env.NAME" to the variable's value ("" when unset).
export function resolveEnv(v: string): string {
  if (!v.startsWith("env.")) return v
  return getEnv(v.slice(4)) ?? ""
}

function opt(v: string | undefined): string | undefined {
  return v === undefined ? undefined : resolveEnv(v)
}

function resolveKey(k: KeyConfig): KeyConfig {
  const value = opt(k.value)
  const az = k.azure_key_config
  const br = k.bedrock_key_config ?? k.bedrock_mantle_key_config
  const vx = k.vertex_key_config
  const cf = k.cloudflare_key_config
  const db = k.databricks_key_config
  const gc = k.github_copilot_key_config
  const oc = k.oauth_key_config
  // copy the whole key and replace the secret-bearing fields, so new fields survive
  let n = k
  n.value = value
  if (az !== undefined) {
    const endpoint = resolveEnv(az.endpoint)
    const cid = opt(az.client_id)
    const csec = opt(az.client_secret)
    const tid = opt(az.tenant_id)
    let a = az
    a.endpoint = endpoint
    a.client_id = cid
    a.client_secret = csec
    a.tenant_id = tid
    n.azure_key_config = a
  }
  if (br !== undefined) {
    const ak = opt(br.access_key)
    const sk = opt(br.secret_key)
    const st = opt(br.session_token)
    const rg = opt(br.region)
    const role = opt(br.role_arn)
    const ext = opt(br.external_id)
    const sess = opt(br.session_name)
    const brole = opt(br.batch_role_arn)
    let b = br
    b.role_arn = role
    b.external_id = ext
    b.session_name = sess
    b.batch_role_arn = brole
    b.access_key = ak
    b.secret_key = sk
    b.session_token = st
    b.region = rg
    n.bedrock_key_config = b
  }
  if (vx !== undefined) {
    const proj = resolveEnv(vx.project_id)
    const rg = resolveEnv(vx.region)
    const creds = opt(vx.auth_credentials)
    const num = opt(vx.project_number)
    let v = vx
    v.project_id = proj
    v.region = rg
    v.auth_credentials = creds
    v.project_number = num
    n.vertex_key_config = v
  }
  if (cf !== undefined) {
    const acct = resolveEnv(cf.account_id)
    let c = cf
    c.account_id = acct
    n.cloudflare_key_config = c
  }
  if (db !== undefined) {
    const ws = resolveEnv(db.workspace_url)
    const cid = opt(db.client_id)
    const csec = opt(db.client_secret)
    let d = db
    d.workspace_url = ws
    d.client_id = cid
    d.client_secret = csec
    n.databricks_key_config = d
  }
  if (gc !== undefined) {
    const app = resolveEnv(gc.app_id)
    const inst = resolveEnv(gc.installation_id)
    const repo = resolveEnv(gc.repository_id)
    const pk = resolveEnv(gc.private_key)
    let g = gc
    g.app_id = app
    g.installation_id = inst
    g.repository_id = repo
    g.private_key = pk
    n.github_copilot_key_config = g
  }
  // oauth_key_config: token_url and the credentials may be env.NAME (Bifrost's SecretVar fields)
  if (oc !== undefined) {
    const tu = opt(oc.token_url)
    const cid = opt(oc.client_id)
    const csec = opt(oc.client_secret)
    const pk = opt(oc.private_key)
    let o = oc
    o.token_url = tu
    o.client_id = cid
    o.client_secret = csec
    o.private_key = pk
    n.oauth_key_config = o
  }
  return n
}

// Replaces every "env.NAME" value in the config with the variable's value.
// Why a declared agent is not served ("" when it is), as Bifrost's AgentRegistrationFileConfig.validate judges a file
// declaration: a lowercase slug name of at most 255 bytes, and an absolute http(s) card URL without user info.
export function agentDeclarationProblem(a: AgentConfig): string {
  const name = a.name.trim()
  let slug = name !== "" && name.byteLength <= 255 && !name.startsWith("-") && !name.endsWith("-") && !name.includes("--")
  for (let i = 0; slug && i < name.byteLength; i++) {
    const ch = name.slice(i, i + 1)
    if (!(("a" <= ch && ch <= "z") || ("0" <= ch && ch <= "9") || ch === "-")) slug = false
  }
  if (!slug) return "name must be 1-255 lowercase ASCII letters, numbers, or single hyphens, and must start and end with a letter or number"
  const u = URL.parse(a.agent_card_url)
  const userInfo = u !== undefined && (u.href.slice(u.protocol.byteLength + 2).split("/")[0] ?? "").includes("@")
  if (u === undefined || (u.protocol !== "http:" && u.protocol !== "https:") || u.hostname === "" || userInfo) return "agent_card_url must be an absolute HTTP(S) URL without user info"
  return ""
}

// The declared agents the gateway serves, reconciled as Bifrost reconciles a config file's declarations with its store:
// a name declared twice is skipped (every copy of it), and a declaration that fails the checks above is skipped, with a
// warning at start (config_compat.tov warnings). Raiju's config file is its store, so nothing else is merged: a
// registration made through the API is a declaration in the file, under either source_of_truth.
export function servedAgents(list: AgentConfig[]): AgentConfig[] {
  const counts: Map<string, int> = new Map()
  for (const a of list) counts.set(a.name.trim(), (counts.get(a.name.trim()) ?? 0) + 1)
  const out: AgentConfig[] = []
  for (const a of list) {
    if ((counts.get(a.name.trim()) ?? 0) > 1) continue
    if (agentDeclarationProblem(a) !== "") continue
    out.push(a)
  }
  return out
}

// The warnings for the declarations servedAgents skips.
export function agentDeclarationNotes(list: AgentConfig[]): string[] {
  const counts: Map<string, int> = new Map()
  for (const a of list) counts.set(a.name.trim(), (counts.get(a.name.trim()) ?? 0) + 1)
  const out: string[] = []
  const told: string[] = []
  for (const a of list) {
    const n = a.name.trim()
    if ((counts.get(n) ?? 0) > 1) {
      if (!told.includes(n)) out.push(`config: skipping duplicate agent registration "${n}"`)
      told.push(n)
      continue
    }
    const p = agentDeclarationProblem(a)
    if (p !== "") out.push(`config: skipping agent registration "${a.name}": ${p}`)
  }
  return out
}

export function resolveConfig(inout c: Config): void {
  resolveWebhooksAndFlags(&c)
  const declared = c.agents
  if (declared !== undefined) c.agents = servedAgents(declared)
  if (c.setup_token !== undefined) c.setup_token = resolveEnv(c.setup_token)
  const ps = c.providers
  if (ps !== undefined) {
    const resolved: Map<string, ProviderConfig> = new Map()
    for (const name of ps.keys()) {
      const p = ps.get(name)!
      const keys = p.keys
      const rk = keys === undefined ? undefined : keys.map((k) => resolveKey(k))
      let np = p
      np.keys = rk
      resolved.set(name, np)
    }
    c.providers = resolved
  }
  // Proxy settings that name secrets or addresses may come from the environment, as elsewhere.
  if (c.auth_proxy !== undefined) {
    let ap = c.auth_proxy
    ap.expected_signer = opt(ap.expected_signer)
    ap.issuer_url = opt(ap.issuer_url)
    ap.audience = opt(ap.audience)
    ap.jwks_url = opt(ap.jwks_url)
    ap.public_key_base_url = opt(ap.public_key_base_url)
    ap.ca_cert_pem = opt(ap.ca_cert_pem)
    c.auth_proxy = ap
  }
  // One effective admin credential set: Bifrost's field names, env references resolved,
  // and nothing when is_enabled is false.
  const auth = c.governance?.auth_config ?? c.auth_config
  if (auth !== undefined) {
    const u = auth.username ?? auth.admin_username
    const pw = auth.password ?? auth.admin_password
    const eff: AdminAuthConfig = auth.is_enabled === false ? {} : { username: opt(u), password: opt(pw), token: opt(auth.token) }
    // disable_auth_on_inference: admin auth guards the management API only, unless the
    // client section says otherwise (as Bifrost)
    if (auth.disable_auth_on_inference === true && c.client?.enforce_auth_on_inference === undefined) {
      let cl: ClientConfig = c.client ?? {}
      cl.enforce_auth_on_inference = false
      c.client = cl
    }
    let g: GovernanceConfig = c.governance ?? {}
    g.auth_config = eff
    c.governance = g
  }
  // the MCP authorization server's settings may name the environment (issuer_url, signing_key)
  const oc = c.client?.oauth2_server_config
  if (oc !== undefined) {
    let o: OAuth2ServerConfig = oc
    o.issuer_url = opt(o.issuer_url)
    o.signing_key = opt(o.signing_key)
    let cl: ClientConfig = c.client ?? {}
    cl.oauth2_server_config = o
    c.client = cl
  }
  const au = c.audit
  if (au !== undefined && au.key !== undefined) {
    const k = resolveEnv(au.key)
    let a2 = au
    a2.key = k
    c.audit = a2
  }
  const gr = c.guardrails
  const gps = gr?.providers
  if (gr !== undefined && gps !== undefined) {
    const resolved = gps.map((p) => {
      const ak = opt(p.api_key)
      const ac = opt(p.access_key)
      const sk = opt(p.secret_key)
      const st = opt(p.session_token)
      const at = opt(p.access_token)
      let q = p
      q.api_key = ak
      q.access_key = ac
      q.secret_key = sk
      q.session_token = st
      q.access_token = at
      return q
    })
    let g2 = gr
    g2.providers = resolved
    c.guardrails = g2
  }
  const gov = c.governance
  if (gov !== undefined) {
    const vks = gov.virtual_keys
    if (vks !== undefined) {
      const out: VirtualKeyConfig[] = []
      for (const vk of vks) {
        const value = resolveEnv(vk.value)
        let n = vk
        n.value = value
        out.push(n)
      }
      c.governance!.virtual_keys = out
    }
  }
  // exporter and log export secrets may be env references (env.NAME), as the sink docs show
  const exs = c.exporters ?? []
  for (let i = 0; i < exs.length; i++) {
    const x = exs[i]!
    x.api_key = opt(x.api_key)
    x.token = opt(x.token)
    x.password = opt(x.password)
    x.service_account_key = opt(x.service_account_key)
    x.sasl_username = opt(x.sasl_username)
    x.sasl_password = opt(x.sasl_password)
    exs[i] = x
  }
  if (c.exporters !== undefined) c.exporters = exs
  const lx = c.log_exports
  if (lx !== undefined) {
    lx.access_key_id = resolveEnv(lx.access_key_id)
    lx.secret_access_key = resolveEnv(lx.secret_access_key)
    lx.session_token = opt(lx.session_token)
    c.log_exports = lx
  }
  const ls = c.logs_store
  const ob = ls?.object_storage
  if (ls !== undefined && ob !== undefined) {
    ob.bucket = resolveEnv(ob.bucket)
    ob.access_key_id = resolveEnv(ob.access_key_id)
    ob.secret_access_key = resolveEnv(ob.secret_access_key)
    ob.session_token = opt(ob.session_token)
    ls.object_storage = ob
    c.logs_store = ls
  }
}

// The header values of an agent's auth may be env.NAME references.
export function resolveAuth(a: AgentAuth | undefined): AgentAuth | undefined {
  if (a === undefined) return undefined
  const hs = a.headers
  let headers: Map<string, string> | undefined = undefined
  if (hs !== undefined) {
    const m: Map<string, string> = new Map()
    for (const k of hs.keys()) m.set(k, resolveEnv(hs.get(k) ?? ""))
    headers = m
  }
  const oa = a.oauth
  let oauth: AgentOAuth | undefined = undefined
  if (oa !== undefined) oauth = { provider_url: oa.provider_url, discovery_url: oa.discovery_url, token_url: oa.token_url, client_id: resolveEnv(oa.client_id), client_secret: resolveEnv(oa.client_secret), scopes: oa.scopes, resource: oa.resource }
  const t = a.tls
  let tls: AgentTls | undefined = undefined
  if (t !== undefined) tls = { insecure_skip_verify: t.insecure_skip_verify, ca_cert_pem: opt(t.ca_cert_pem), client_cert_pem: opt(t.client_cert_pem), client_key_pem: opt(t.client_key_pem) }
  return { type: a.type, headers: headers, oauth: oauth, security_schemes: a.security_schemes, advanced: a.advanced, tls: tls }
}

// Webhook secrets and header values, and feature flag values, may be env.NAME references.
function resolveWebhooksAndFlags(inout c: Config): void {
  const ags = c.agents
  if (ags !== undefined) {
    const out: AgentConfig[] = []
    for (const a of ags) {
      let n = a
      n.discovery_auth = resolveAuth(n.discovery_auth)
      n.runtime_auth = resolveAuth(n.runtime_auth)
      out.push(n)
    }
    c.agents = out
  }
  const wh = c.webhooks
  if (wh !== undefined) {
    const out: WebhookEndpoint[] = []
    for (const w of wh) {
      let n = w
      if (n.secret !== undefined) n.secret = resolveEnv(n.secret)
      const hs = n.headers
      if (hs !== undefined) {
        const m: Map<string, string> = new Map()
        for (const k of hs.keys()) m.set(k, resolveEnv(hs.get(k) ?? ""))
        n.headers = m
      }
      out.push(n)
    }
    c.webhooks = out
  }
  const ff = c.feature_flags
  const fl = ff === undefined ? undefined : ff.flags
  if (fl !== undefined) {
    const m: Map<string, FlagOverride> = new Map()
    for (const id of fl.keys()) {
      const o = fl.get(id)!
      const v = o.enabled
      const enabled: bool | string = typeof v === "string" ? resolveEnv(v) : v
      m.set(id, { enabled: enabled, source: o.source, updated_at: o.updated_at })
    }
    c.feature_flags = { flags: m }
  }
}

export function parseConfig(text: string): Config throws SyntaxError {
  let c = try JSON.parse(text) as Config
  resolveConfig(&c)
  return c
}

// Loads the config from a file, or builds one from well-known provider
// environment variables when there is no file.
export function loadConfig(path: string): Config throws Error {
  let c = try loadRawConfig(path)
  resolveConfig(&c)
  return c
}

// The config as written, with "env.NAME" references kept: what the config store
// saves back, so secrets never land in the file.
export function loadRawConfig(path: string): Config throws Error {
  if (!existsSync(path)) return fromEnv()
  // Bifrost's section names read as Raiju's (config_compat.tov); the file itself is untouched
  const text = (try normalize(try readFileSync(path, "utf8"))).text
  let c = try JSON.parse(text) as Config
  c.plugins = try pluginSpecs(text)
  return c
}

// Each plugin with its config object as raw JSON text.
export function pluginSpecs(configText: string): PluginSpec[] throws SyntaxError {
  const raw = find(try fields(configText), "plugins")
  const out: PluginSpec[] = []
  if (raw === undefined || !raw.startsWith("[")) return out
  for (const el of try elements(raw)) {
    const f = try fields(el)
    const name = rawStr(f, "name")
    if (name === undefined) continue
    const conf = find(f, "config")
    const saved = rawStr(f, "config_json")
    const ord = rawNum(f, "order")
    const lim = find(f, "wasm_limits")
    let wl: WasmLimitsSpec | undefined = undefined
    if (lim !== undefined && lim.startsWith("{")) wl = try JSON.parse(lim) as WasmLimitsSpec
    out.push({
      name: name,
      enabled: rawBool(f, "enabled"),
      config_json: conf !== undefined && !isNull(conf) ? conf : saved,
      placement: rawStr(f, "placement"),
      order: ord === undefined ? undefined : Math.trunc(ord),
      path: rawStr(f, "path"),
      wasm_limits: wl,
    })
  }
  return out
}

const ENV_PROVIDERS: { name: string, env: string }[] = [
  { name: "openai", env: "OPENAI_API_KEY" },
  { name: "anthropic", env: "ANTHROPIC_API_KEY" },
  { name: "gemini", env: "GEMINI_API_KEY" },
  { name: "groq", env: "GROQ_API_KEY" },
  { name: "mistral", env: "MISTRAL_API_KEY" },
  { name: "cohere", env: "COHERE_API_KEY" },
  { name: "openrouter", env: "OPENROUTER_API_KEY" },
  { name: "cerebras", env: "CEREBRAS_API_KEY" },
  { name: "xai", env: "XAI_API_KEY" },
  { name: "perplexity", env: "PERPLEXITY_API_KEY" },
  { name: "deepseek", env: "DEEPSEEK_API_KEY" },
  { name: "together", env: "TOGETHER_API_KEY" },
  { name: "fireworks", env: "FIREWORKS_API_KEY" },
]

export function fromEnv(): Config {
  const ps: Map<string, ProviderConfig> = new Map()
  for (const p of ENV_PROVIDERS) {
    const v = getEnv(p.env)
    if (v !== undefined && v !== "") ps.set(p.name, { keys: [{ name: "env", value: "env." + p.env, models: [], weight: 1.0 }] })
  }
  const ollama = process.env.OLLAMA_BASE_URL
  if (ollama !== undefined && ollama !== "") ps.set("ollama", { keys: [{ value: "", models: [], weight: 1.0 }], network_config: { base_url: ollama } })
  return { providers: ps }
}

test("the owner switches parse; unset leaves them to their defaults", () => {
  const on = try parseConfig(`{ "client": { "refuse_unpriced_models": true }, "cache": { "enabled": true, "scope_by_virtual_key": true } }`)
  expect(on.client!.refuse_unpriced_models).toBe(true)
  expect(on.cache!.scope_by_virtual_key).toBe(true)
  const off = try parseConfig(`{ "cache": { "enabled": true } }`)
  expect(off.client?.refuse_unpriced_models === true).toBe(false)
  expect(off.cache?.scope_by_virtual_key === undefined).toBe(true)
})

test("parses a Bifrost config and resolves env values", () => {
  const c = try parseConfig(`{
    "client": { "drop_excess_requests": false, "enable_logging": true },
    "providers": {
      "openai": {
        "keys": [{ "value": "env.HOME", "models": ["gpt-4o-mini"], "weight": 1.0 }],
        "network_config": { "max_retries": 2, "extra_headers": { "x-team": "core" } }
      },
      "azure": {
        "keys": [{ "value": "k", "azure_key_config": { "endpoint": "https://x.openai.azure.com", "deployments": { "gpt-4o": "prod-4o" }, "api_version": "2024-10-21" } }]
      }
    },
    "governance": { "virtual_keys": [{ "id": "vk1", "value": "sk-bf-test", "budget_id": "b1" }], "budgets": [{ "id": "b1", "max_limit": 10.5, "reset_duration": "1M" }] }
  }`)
  const openai = c.providers!.get("openai")!
  expect(openai.keys![0]!.value).toBe(process.env.HOME ?? "")
  expect(openai.network_config!.max_retries).toBe(2)
  expect(openai.network_config!.extra_headers!.get("x-team")).toBe("core")
  expect(c.providers!.get("azure")!.keys![0]!.azure_key_config!.deployments!.get("gpt-4o")).toBe("prod-4o")
  expect(c.governance!.budgets![0]!.max_limit).toBe(10.5)
})

test("auth_config: is_enabled false clears the credentials; disable_auth_on_inference opens inference", () => {
  let off: Config = { auth_config: { admin_username: "root", admin_password: "pw", is_enabled: false } }
  resolveConfig(&off)
  expect(off.governance!.auth_config!.username).toBeUndefined()
  let open: Config = { auth_config: { admin_username: "root", admin_password: "pw", disable_auth_on_inference: true } }
  resolveConfig(&open)
  expect(open.governance!.auth_config!.username).toBe("root")
  expect(open.client!.enforce_auth_on_inference).toBe(false)
  let kept: Config = { client: { enforce_auth_on_inference: true }, auth_config: { admin_username: "root", admin_password: "pw", disable_auth_on_inference: true } }
  resolveConfig(&kept)
  expect(kept.client!.enforce_auth_on_inference).toBe(true)
})

test("exporter and log export secrets resolve env references, plain values stay", () => {
  let c = try parseConfig(`{"exporters":[{"id":"k","kind":"kafka","brokers":["b:9092"],"topic":"t","sasl_username":"env.RAIJU_NO_SUCH_USER","sasl_password":"plain"}],"log_exports":{"enabled":true,"kind":"s3","bucket":"b","access_key_id":"env.RAIJU_NO_SUCH_AK","secret_access_key":"sk"}}`)
  resolveConfig(&c)
  const ex = c.exporters ?? []
  expect(ex[0]!.sasl_username).toBe("")
  expect(ex[0]!.sasl_password).toBe("plain")
  expect(c.log_exports!.access_key_id).toBe("")
  expect(c.log_exports!.secret_access_key).toBe("sk")
})

