// The app a request came from, as Bifrost's logs label it from the User-Agent
// (core/schemas/useragents.go). Used when the caller sends no x-bf-app. Identifiers
// match as substrings, case-insensitively, and the first matching app wins, so the
// more specific ones come first. A non-empty User-Agent with no match is "Other".

type AppMatcher = { app: string, ids: string[] }

// Built by a function: top-level statements in an imported module do not run.
function makeMatchers(): AppMatcher[] {
  return [
    { app: "Claude Chat Web", ids: ["claude-chat-web", "claude-web"] },
    { app: "Claude Desktop", ids: ["claude-desktop", "claude/"] },
    { app: "Claude Cowork", ids: ["claude-cowork"] },
    { app: "Claude Code", ids: ["claude-cli", "claude-code", "claude-vscode"] },
    // ahead of API: Warp reaches the gateway over fasthttp, so the generic matcher would claim it
    { app: "Warp", ids: ["bifrost-warp"] },
    { app: "API", ids: ["fasthttp"] },
    { app: "Codex CLI", ids: ["codex-cli", "codex-tui"] },
    { app: "Codex Desktop", ids: ["codex-desktop", "codex desktop/", "codex/"] },
    { app: "Cursor", ids: ["cursor"] },
    { app: "Kilo Code", ids: ["kilo"] },
    { app: "Roo Code", ids: ["roo"] },
    { app: "Cline", ids: ["cline"] },
    { app: "OpenCode", ids: ["opencode"] },
    { app: "Windsurf", ids: ["windsurf"] },
    { app: "Antigravity CLI", ids: ["antigravity-cli"] },
    { app: "Antigravity Desktop", ids: ["antigravity-desktop", "antigravity/"] },
    { app: "Gemini CLI", ids: ["gemini-cli", "geminicli", "gemini"] },
    { app: "Qwen Code", ids: ["qwen-code", "qwencode", "qwen"] },
  ]
}

const MATCHERS = makeMatchers()

// The app label for a User-Agent: "" when it is absent or blank, "Other" when no app matches.
export function appFromUserAgent(userAgent: string): string {
  if (userAgent.trim() === "") return ""
  const ua = userAgent.toLowerCase()
  for (const m of MATCHERS) {
    for (const id of m.ids) {
      if (ua.includes(id)) return m.app
    }
  }
  return "Other"
}

test("app from user agent: versioned client strings match their app", () => {
  expect(appFromUserAgent("claude-cli/2.1.168 (external, cli)")).toBe("Claude Code")
  expect(appFromUserAgent("claude-desktop/1.0")).toBe("Claude Desktop")
  expect(appFromUserAgent("Cursor/0.50.1")).toBe("Cursor")
  expect(appFromUserAgent("codex_cli_rs/0.40 (codex-tui)")).toBe("Codex CLI")
  expect(appFromUserAgent("gemini-cli/0.5.0")).toBe("Gemini CLI")
})

test("app from user agent: order decides, and Warp is not claimed by the API matcher", () => {
  expect(appFromUserAgent("bifrost-warp/1.0 fasthttp")).toBe("Warp")
  expect(appFromUserAgent("fasthttp")).toBe("API")
  expect(appFromUserAgent("Mozilla/5.0 (X11; Linux x86_64)")).toBe("Other")
})

test("app from user agent: blank is empty, not Other", () => {
  expect(appFromUserAgent("")).toBe("")
  expect(appFromUserAgent("   ")).toBe("")
})
