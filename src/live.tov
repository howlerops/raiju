// GPT Live over WebSockets, as Bifrost's wslive.go and livecontrol.go: /v1/live/sessions takes a
// session.start frame that names the model, and relays the session to OpenAI's live endpoint.
// The provider's session.started event gives the session's id, which is recorded under the
// virtual key that opened it. An attach (/v1/live/sessions/{id}/attach) and the recording
// (/v1/live/sessions/{id}/content) are refused to any other virtual key, as not found.
//
// POST /v1/live/sessions (the WebRTC create) makes this gateway the WebRTC peer, as Bifrost's webrtclive.go
// does (liveCreate, with src/webrtc.tov): it answers the browser's SDP offer on a peer connection of its own,
// offers to OpenAI on a second, and relays the audio and the "oai-events" data channel, metering, guarding
// and logging every event. The session stays on the node (the worker process) that took it: the UDP
// sockets of its peer connections are that process's.
//
// The WebSocket path (LiveSocket) is metered the same way: a primary session runs through the same LiveCore
// (webrtc.tov) as the WebRTC one, so its voice seconds are billed in 30 s windows that governance admits
// again, its text is guarded, and it ends as one log row with its cost (livehooks.tov). It has no minimum:
// only a created WebRTC session bills one. An attach (a sideband) bills nothing, the primary does, and
// relays frames untouched. The delegated-responses model of a start, a create and each session.update is checked as
// Bifrost's liveUpdatePolicy checks it (checkDelegation) and goes up bare. Not here: forks. Bifrost's live sessions are OpenAI only,
// and so are these. The registry is shared by the workers of one node through a directory (share).
import { existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from "node:fs"
import { writeFileAtomic } from "./atomicfile"
import { sha256, toHex, utf8 } from "./crypto"
import { Engine, errorResponse, noHeaders } from "./gateway"
import { parseModel, target, keyAllows, resolveAlias, isKnownKind, ModelRef } from "./router"
import { Target, peerOf } from "./providers/types"
import { Peer, providerPeer } from "./netguard"
import { trimSlash } from "./providers/types"
import { Field, fields, find, rawStr, setField, build, quote } from "./json"
import { Hdrs, snapshot } from "./schemas"
import { Config, KeyConfig, AliasTarget } from "./config"
import { SocketExt, upstreamFor, wsBase, openUpstream, UpCell, unhook } from "./realtime"
import { Grant } from "./governance"
import { SessionSpec, sessionHooks, sessionGuard } from "./livehooks"
import { deadline } from "./deadline"

// how long a live session control call and a recording download may take upstream
const LIVE_CONTROL_MS = 30000
const LIVE_CONTENT_MS = 120000
import { Relay, Leg, Exchange, Refusal, UpdateCheck, establish, prepareServerEvents, startClock, withOffer, strAt, withJsonAt, eventType } from "./webrtc"

// How many sessions the registry holds. Past that the record of an ended session nearest its expiry makes room;
// with every record a running session, a new one is refused, not left unrecorded.
const MAX_RECORDS = 10000
// How long a session's record stays once the session has ended, so its recording (/content) and a late attach stay
// its owner's; then it goes, with its share-dir folder (re-audit 7 P1-4: records were never removed, and past
// MAX_RECORDS every new live session was refused until a restart).
export const LIVE_ENDED_KEEP_MS = 3600000.0
// A record whose end this worker never sees (a session the worker did not run, or one whose relay never reported)
// goes this long after it was made.
export const LIVE_RECORD_TTL_MS = 86400000.0
// how often expired records are looked for
const SWEEP_MS = 60000.0

// The hash a session's owner is recorded by: the owner's virtual key is not kept on disk.
function ownerHash(owner: string): string {
  return toHex(sha256(utf8(owner)))
}

// The virtual key that opened each live session, by the provider's session id.
export class LiveRegistry {
  owners: Map<string, string> = new Map()
  // when each record goes (ms since the epoch): LIVE_RECORD_TTL_MS after it was made, LIVE_ENDED_KEEP_MS after its
  // session ended
  expires: Map<string, f64> = new Map()
  // the records whose session has ended
  ended: Set<string> = new Set()
  // the records whose share-dir folder this worker made (and removes when the record goes)
  private claimed: Set<string> = new Set()
  private nextSweep: f64 = 0.0
  // With several workers, a directory of the node's: each session is a folder named by its id's hash,
  // holding its owner's hash. mkdir claims the folder atomically, so the first worker to open a
  // session records it for all of them. The worker that made a folder removes it with its record.
  shareDir = ""

  share(dir: string): void {
    try {
      mkdirSync(dir, { recursive: true })
      this.shareDir = dir
    } catch (e) {
      this.shareDir = ""
    }
  }

  private folder(id: string): string {
    return this.shareDir + "/" + toHex(sha256(utf8(id)))
  }

  // Whether the session's recorded owner is the one with this hash.
  private sharedOwnerIs(id: string, hash: string): bool {
    try {
      return readFileSync(this.folder(id) + "/owner", "utf8") === hash
    } catch (e) {
      return false
    }
  }

  private keep(id: string, owner: string, nowMs: f64): void {
    this.owners.set(id, owner)
    this.expires.set(id, nowMs + LIVE_RECORD_TTL_MS)
  }

  // Records the owner of a session. False when the registry is full of running sessions, or the session belongs
  // to another owner. A session opened with no virtual key is not recorded, and anyone may reach it.
  bind(id: string, owner: string): bool {
    return this.bindAt(id, owner, Date.now())
  }

  bindAt(id: string, owner: string, nowMs: f64): bool {
    if (owner === "" || id === "") return true
    this.sweep(nowMs, false)
    if (this.owners.has(id)) return this.owners.get(id) === owner
    if (!this.roomAt(nowMs)) return false
    if (this.shareDir === "") {
      this.keep(id, owner, nowMs)
      return true
    }
    const dir = this.folder(id)
    const hash = ownerHash(owner)
    try {
      mkdirSync(dir)
    } catch (e) {
      // another worker claimed the session: its owner is the record
      if (!this.sharedOwnerIs(id, hash)) return false
      this.keep(id, owner, nowMs)
      return true
    }
    try {
      writeFileAtomic(dir + "/owner", hash, { durable: false })
    } catch (e) {
      // a claim without its owner would be reachable by every key: it is not kept
      try {
        rmSync(dir, { recursive: true, force: true })
      } catch (e2) {
        // the folder stays unclaimed by any owner: attaches to it are refused below
      }
      return false
    }
    this.keep(id, owner, nowMs)
    this.claimed.add(id)
    return true
  }

  // The session ended: its record (when it is this owner's) stays LIVE_ENDED_KEEP_MS more, then goes.
  release(id: string, owner: string): void {
    this.releaseAt(id, owner, Date.now())
  }

  releaseAt(id: string, owner: string, nowMs: f64): void {
    if (id === "" || owner === "" || this.owners.get(id) !== owner) return
    this.ended.add(id)
    this.expires.set(id, nowMs + LIVE_ENDED_KEEP_MS)
  }

  // Whether a new record fits: when full, the ended session's record nearest its expiry makes room.
  room(): bool {
    return this.roomAt(Date.now())
  }

  roomAt(nowMs: f64): bool {
    if (this.owners.size < MAX_RECORDS) return true
    this.sweep(nowMs, true)
    if (this.owners.size < MAX_RECORDS) return true
    let victim = ""
    let soonest = 0.0
    for (const id of this.ended.values()) {
      const at = this.expires.get(id) ?? 0.0
      if (victim === "" || at < soonest) {
        victim = id
        soonest = at
      }
    }
    if (victim === "") return false
    this.remove(victim)
    return true
  }

  // Removes the records past their time (at most once every SWEEP_MS unless forced).
  sweep(nowMs: f64, force: bool): void {
    if (!force && nowMs < this.nextSweep) return
    this.nextSweep = nowMs + SWEEP_MS
    const gone: string[] = []
    for (const id of this.expires.keys()) {
      if ((this.expires.get(id) ?? 0.0) <= nowMs) gone.push(id)
    }
    for (const id of gone) this.remove(id)
  }

  // Forgets a record, and removes its share-dir folder when this worker made it.
  private remove(id: string): void {
    this.owners.delete(id)
    this.expires.delete(id)
    this.ended.delete(id)
    if (!this.claimed.has(id)) return
    this.claimed.delete(id)
    if (this.shareDir === "") return
    try {
      rmSync(this.folder(id), { recursive: true, force: true })
    } catch (e) {
      // left for the directory's removal
    }
  }

  // Whether a caller with this virtual key ("" for none) may use the session.
  allowed(id: string, caller: string): bool {
    if (caller === "") return true
    const o = this.owners.get(id)
    if (o !== undefined) return o === caller
    if (this.shareDir === "") return true
    // a session no worker recorded is open, as one with no owner
    if (!existsSync(this.folder(id))) return true
    return this.sharedOwnerIs(id, ownerHash(caller))
  }
}

// The session id and SDP answer of a WebRTC create's reply, or undefined when either is missing.
export function liveAnswer(text: string): { id: string, sdp: string } | undefined {
  try {
    const fs = fields(text)
    const s = find(fs, "session")
    const tr = find(fs, "transport")
    if (s === undefined || tr === undefined) return undefined
    const id = rawStr(fields(s), "id") ?? ""
    const sdp = rawStr(fields(tr), "sdp") ?? ""
    if (id === "" || sdp === "") return undefined
    return { id: id, sdp: sdp }
  } catch (e) {
    return undefined
  }
}

// Where a live session names the model of its delegated responses.
const DELEGATION_MODEL = ["session", "delegation", "responses", "model"]

// The provider and model a delegated-responses model names: "provider/model" when its prefix is a provider, else the
// session's provider (Bifrost's ParseModelString with the session's provider as the default).
export function delegationRef(cfg: Config, provider: string, sent: string): ModelRef {
  const s = sent.trim()
  const i = s.indexOf("/")
  if (i > 0) {
    const p = s.slice(0, i)
    const ps = cfg.providers
    if ((ps !== undefined && ps.has(p)) || isKnownKind(p)) return { provider: p, model: s.slice(i + 1) }
  }
  return { provider: provider, model: s }
}

// Whether a start frame (or a WebRTC create body) delegates to the Responses API: a delegation of type responses with
// its responses settings (Bifrost's liveBackendModel reads a backend model only then).
export function delegatesResponses(frame: string): bool {
  if (strAt(frame, ["session", "delegation", "type"]) !== "responses") return false
  try {
    const s = find(fields(frame), "session")
    if (s === undefined) return false
    const d = find(fields(s), "delegation")
    if (d === undefined) return false
    const r = find(fields(d), "responses")
    return r !== undefined && r.startsWith("{")
  } catch (e) {
    return false
  }
}

function refusal(status: int, type: string, message: string): UpdateCheck {
  return { frame: "", model: "", status: status, type: type, message: message }
}

// The check of a live frame's delegated-responses model before it reaches the provider (Bifrost's liveUpdatePolicy.check,
// and liveBackendModel for a start with required set): it must be served by the session's provider and by the session's
// key, and governance must admit it (admit, when given); the frame then names it as the provider knows it (bare, its alias
// resolved). A frame that names none passes as it is, unless the model is required.
export function checkDelegation(cfg: Config, provider: string, key: KeyConfig, frame: string, admit: ((provider: string, model: string) => Refusal | undefined) | undefined, required: bool): UpdateCheck {
  const sent = strAt(frame, DELEGATION_MODEL)
  const ref = delegationRef(cfg, provider, sent)
  if (ref.model.trim() === "") {
    if (required) return refusal(400, "invalid_request_error", "session.delegation.responses.model is required for responses delegation")
    return { frame: frame, model: "", status: 0, type: "", message: "" }
  }
  if (ref.provider !== provider) return refusal(400, "invalid_request_error", `session.delegation.responses.model must be served by ${provider}, the provider of session.model`)
  if (!keyAllows(key, ref.model)) return refusal(400, "invalid_request_error", `the key serving this session does not support model ${ref.model}`)
  if (admit !== undefined) {
    const why = admit(ref.provider, ref.model)
    if (why !== undefined) return refusal(why.status, why.type, why.message)
  }
  const alias = resolveAlias(key, ref.model, cfg.client?.routing_chain_max_depth)
  const wire = alias.error === "" ? alias.model : ref.model
  if (wire === sent) return { frame: frame, model: ref.model, status: 0, type: "", message: "" }
  try {
    return { frame: try withJsonAt(frame, DELEGATION_MODEL, quote(wire)), model: ref.model, status: 0, type: "", message: "" }
  } catch (e) {
    return refusal(500, "server_error", "failed to prepare session.update: " + e.message)
  }
}

// Governance's admission of a delegated model for the caller, as a refusal or undefined. It is a peek: the delegated
// responses are admitted and charged as each one closes (webrtc.tov LiveCore), so the check takes no request of its own.
function admitFor(engine: Engine, h: Hdrs): (provider: string, model: string) => Refusal | undefined {
  return (provider: string, model: string): Refusal | undefined => {
    const a = engine.gov.admit(h, provider, model, true)
    if (a.kind === "denial") return { status: a.status, type: a.type, message: a.message }
    return undefined
  }
}

// POST /v1/live/sessions: Bifrost's WebRTC create. This gateway is the WebRTC peer on both sides: it answers
// the browser's SDP offer with a peer connection of its own, offers to the provider on a second (the
// provider is sent the gateway's offer, not the browser's), and relays the audio packets and the data
// channel between them (src/webrtc.tov). Every event on the channel is metered, guarded and logged: the
// session's usage is billed in 30 s windows with a 15 s minimum, and its row goes to the request log when it
// ends. The checks run first, as Bifrost's do (the body, the transport, the model, the credential, the
// governance admission), and the provider's session id is recorded for the virtual key, so attach and content
// stay with its owner.
export async function liveCreate(engine: Engine, reg: LiveRegistry, req: Request): Promise<Response> {
  const off = webrtcRefusal(engine.cfg)
  if (off !== undefined) return off
  let webrtc = false
  let model = ""
  let body = ""
  let offer = ""
  try {
    body = await req.text()
    const fs = fields(body)
    const tr = find(fs, "transport")
    if (tr !== undefined) {
      const tf = fields(tr)
      offer = rawStr(tf, "sdp") ?? ""
      webrtc = rawStr(tf, "type") === "webrtc" && offer.trim() !== ""
    }
    const sf = find(fs, "session")
    if (sf !== undefined) model = rawStr(fields(sf), "model") ?? ""
  } catch (e) {
    return errorReply400("the request body must be JSON with session and transport")
  }
  if (!webrtc) return errorReply400(`transport must be {"type": "webrtc", "sdp": "<SDP offer>"}`)
  if (model.trim() === "") return errorReply400("session.model is required")
  const h = snapshot(req.headers)
  if (!credentialOk(engine, h)) return errorResponse(401, "authentication is required for live sessions", "authentication_error", noHeaders())
  const ref = parseModel(engine.cfg, model)
  if (ref.provider !== "openai") return errorReply400("this provider has no live API this gateway can relay")
  const admitted = engine.gov.admit(h, ref.provider, ref.model)
  if (admitted.kind === "denial") return errorResponse(admitted.status, admitted.message, admitted.type, noHeaders())
  const grant: Grant = admitted
  if (!reg.room()) return errorResponse(503, "the live session registry is full", "server_error", noHeaders())
  const sel = target(engine.cfg, ref, new Set<int>(), h.get("x-bf-api-key") ?? undefined)
  if (sel === undefined || sel.t.kind !== "openai") return errorResponse(404, "no OpenAI key is configured for live sessions", "invalid_request_error", noHeaders())
  const t = sel.t
  let upstreamBody = ""
  try {
    upstreamBody = rewriteStart(body, t.model)
  } catch (e) {
    return errorReply400("the request body must be JSON with session and transport")
  }
  // the delegated-responses model: the session's provider and key must serve it, governance admits it, and it goes up bare
  const admitBackend = admitFor(engine, h)
  let backend = ""
  if (delegatesResponses(body)) {
    const d = checkDelegation(engine.cfg, ref.provider, t.key, upstreamBody, admitBackend, true)
    if (d.message !== "") return errorResponse(d.status, d.message, d.type, noHeaders())
    upstreamBody = d.frame
    backend = d.model
  }
  const sessionProvider = ref.provider
  const sessionKey = t.key
  // the browser's own list of server events is widened for the provider and kept for the browser
  const events = prepareServerEvents(upstreamBody)
  if (events.error !== "") return errorReply400(events.error)
  const up = upstreamFor(t, undefined)
  const hs: Record<string, string> = {}
  for (const k of up.headers.keys()) hs.set(k, up.headers.get(k)!)
  hs.set("content-type", "application/json")
  const url = liveBase(t) + "/v1/live/sessions"
  const owner = ownerOf(engine, h)
  const provider = ref.provider
  const modelName = ref.model

  // the provider's side of the handshake, with the gateway's offer
  const exchange = async (gatewayOffer: string): Promise<Exchange> => {
    let b = ""
    try {
      b = try withOffer(events.body, gatewayOffer)
    } catch (e) {
      return { status: 500, type: "server_error", message: "failed to prepare the session: " + e.message, sdp: "", sessionId: "", body: "", contentType: "" }
    }
    const res = await postLive(url, hs, b, peerOf(t.cfg))
    if (res === undefined) return { status: 502, type: "api_error", message: "failed to create the live session at the provider", sdp: "", sessionId: "", body: "", contentType: "" }
    if (res.status < 200 || res.status >= 300) return { status: res.status, type: "api_error", message: "the provider refused the live session", sdp: "", sessionId: "", body: res.text, contentType: res.type }
    const answer = liveAnswer(res.text)
    if (answer === undefined) return { status: 502, type: "api_error", message: "live session create response has no session id or SDP answer", sdp: "", sessionId: "", body: "", contentType: "" }
    return { status: 0, type: "", message: "", sdp: answer.sdp, sessionId: answer.id, body: "", contentType: "" }
  }

  // each window of voice time is admitted again, as Bifrost's meter does for its next billing unit
  const spec: SessionSpec = { op: "live", transport: "webrtc", provider: provider, model: modelName }
  const hooks = sessionHooks(engine, h, grant, spec, (id) => reg.bind(id, owner), (id) => {
    reg.release(id, owner)
  })
  const est = await establish({
    offer: offer,
    exchange: exchange,
    hooks: hooks,
    guard: sessionGuard(engine),
    filter: events.filter,
    iceServers: iceServers(),
    bindAddress: process.env.RAIJU_WEBRTC_BIND ?? "",
    realtime: false,
    model: modelName,
    backendModel: backend,
    checkUpdate: (m: string): UpdateCheck => checkDelegation(engine.cfg, sessionProvider, sessionKey, m, admitBackend, false),
  })
  if (est.status !== 0) {
    if (est.body !== "") {
      // the provider's own refusal
      const out: Record<string, string> = {}
      out.set("content-type", est.contentType)
      return new Response(est.body, { status: est.status, headers: out })
    }
    return errorResponse(est.status, est.message, est.type, noHeaders())
  }
  const reply = JSON.stringify({ session: { id: est.sessionId }, transport: { type: "webrtc", sdp: est.answer } })
  const out: Record<string, string> = {}
  out.set("content-type", "application/json")
  return new Response(reply, { status: 201, headers: out })
}

// The answer to a WebRTC call while server.webrtc_enabled is off (the default), undefined when it is on. The calls are
// refused before the body is read, so no SDP reaches the peer's parsers.
export function webrtcRefusal(cfg: Config): Response | undefined {
  if (cfg.server?.webrtc_enabled === true) return undefined
  return errorResponse(403, "WebRTC calls are turned off on this gateway; set server.webrtc_enabled to true to allow them (WebSocket realtime at GET /v1/realtime is not affected)", "permission_error", noHeaders())
}

// The STUN and TURN servers the gateway's peer connections use (RAIJU_WEBRTC_ICE_SERVERS, comma separated).
// Bifrost uses none: the connections offer the host's own addresses.
export function iceServers(): string[] {
  const out: string[] = []
  for (const u of (process.env.RAIJU_WEBRTC_ICE_SERVERS ?? "").split(",")) {
    const t = u.trim()
    if (t !== "") out.push(t)
  }
  return out
}

function errorReply400(message: string): Response {
  return errorResponse(400, message, "invalid_request_error", noHeaders())
}

// The provider's reply to a POST: its status, content type and body. undefined when it can't be reached.
async function postLive(url: string, hs: Record<string, string>, body: string, peer: Peer): Promise<{ status: int, type: string, text: string } | undefined> {
  try {
    const dl = deadline(LIVE_CONTROL_MS)
    try {
      const res = await fetch(url, { method: "POST", headers: hs, body: body, signal: dl.controller.signal, peer: peer })
      const text = await res.text()
      dl.finish()
      return { status: res.status, type: res.headers.get("content-type") ?? "application/json", text: text }
    } catch (e) {
      dl.finish()
      throw e
    }
  } catch (e) {
    console.error(`raiju: ${e.message}`)
    return undefined
  }
}

// The virtual key of a request, "" when it has none.
export function ownerOf(engine: Engine, h: Hdrs): string {
  return engine.gov.findKey(h)?.id ?? ""
}

// Whether the request presents a credential the gateway accepts, when governance is enforced.
// A provider key sent directly satisfies it too, as it does for inference.
export function credentialOk(engine: Engine, h: Hdrs): bool {
  if (!engine.gov.enforce) return true
  if (engine.gov.findKey(h) !== undefined || h.get("x-bf-api-key") !== undefined) return true
  const alt = engine.gov.altAuth
  return alt !== undefined && alt(h)
}

// Session ids are the provider's: letters, digits, "_" and "-". Anything else is refused before it
// reaches an upstream path.
export function validId(id: string): bool {
  if (id === "" || id.byteLength > 200) return false
  const ok = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"
  for (let i = 0; i < id.byteLength; i++) {
    if (!ok.includes(id.slice(i, i + 1))) return false
  }
  return true
}

// The id of a route /v1/live/sessions/{id}/attach, or "".
export function attachId(p: string): string {
  if (!p.startsWith("/v1/live/sessions/") || !p.endsWith("/attach")) return ""
  return p.slice(18, p.byteLength - 7)
}

// The id of a route /v1/live/sessions/{id}/content, or "".
export function contentId(p: string): string {
  if (!p.startsWith("/v1/live/sessions/") || !p.endsWith("/content")) return ""
  return p.slice(18, p.byteLength - 8)
}

// The OpenAI target the control routes use (attach and content name no model, so the openai
// provider's key serves them, as in Bifrost).
function controlTarget(engine: Engine, h: Hdrs): Target | undefined {
  const sel = target(engine.cfg, { provider: "openai", model: "" }, new Set<int>(), h.get("x-bf-api-key") ?? undefined)
  if (sel === undefined || sel.t.kind !== "openai") return undefined
  return sel.t
}

function liveBase(t: Target): string {
  return trimSlash(t.cfg.network_config?.base_url ?? "https://api.openai.com")
}

// The upstream URL and headers for an attach to a session, or undefined without an OpenAI key.
export function attachUpstream(engine: Engine, h: Hdrs, id: string): { url: string, headers: Map<string, string> } | undefined {
  const t = controlTarget(engine, h)
  if (t === undefined) return undefined
  const up = upstreamFor(t, undefined)
  return { url: wsBase(liveBase(t)) + "/v1/live/sessions/" + id + "/attach", headers: up.headers }
}

// The type and message of a session's refusal, as Bifrost's realtime error event.
function refusalEvent(type: string, message: string): string {
  return JSON.stringify({ type: "error", error: { type: type, code: type, message: message } })
}

// Sets the session's model to the provider's name for it, leaving the rest of the frame as it is.
export function rewriteStart(m: string, model: string): string throws SyntaxError {
  let fs = try fields(m)
  let sf: Field[] = []
  const s = find(fs, "session")
  if (s !== undefined) sf = try fields(s)
  setField(&sf, "model", quote(model))
  setField(&fs, "session", build(sf))
  return build(fs)
}

// The session id of a session.started event, or "" for any other event.
export function startedId(m: string): string {
  if (!m.includes("session.started")) return ""
  try {
    const fs = fields(m)
    if (rawStr(fs, "type") !== "session.started") return ""
    const s = find(fs, "session")
    if (s === undefined) return ""
    return rawStr(fields(s), "id") ?? ""
  } catch (e) {
    return ""
  }
}

// One live WebSocket: a primary (session.start first, then the session) or an attach (joined at
// once, to a session another connection runs). Frames pass through unchanged.
// Closes an upstream socket that is open. One still connecting is left to its onopen, which closes
// it: closing a socket mid-connect crashed the process on the http1 server.
function closeUpstream(up: WebSocket | undefined): void {
  if (up !== undefined && up.readyState === 1) up.close()
}

export class LiveSocket extends SocketExt {
  started = false
  upstream: WebSocket | undefined = undefined
  // a primary's relay: the metered path between the client and the provider (an attach has none)
  relay: Relay | undefined = undefined
  constructor(readonly engine: Engine, readonly reg: LiveRegistry, readonly headers: Map<string, string>, readonly owner: string, readonly attachUrl: string, readonly attachHeaders: Map<string, string>) {
    super()
  }

  onOpen(): void {
    if (this.attachUrl !== "") {
      this.started = true
      this.attach(this.attachUrl, this.attachHeaders)
    }
  }

  onMessage(m: string): void {
    if (this.closed || this.ended) return
    const r = this.relay
    if (r !== undefined) {
      r.fromBrowser(m)
      return
    }
    const up = this.upstream
    if (up !== undefined) {
      // a sideband's session.update is checked as the primary's is, against the key the attach runs on (Bifrost's
      // sideband relay applies the same policy); it opens no billing unit of its own
      let out = m
      if (eventType(m) === "session.update") {
        const t = controlTarget(this.engine, this.headers)
        if (t !== undefined) {
          const d = checkDelegation(this.engine.cfg, t.provider, t.key, m, undefined, false)
          if (d.message !== "") {
            this.send(refusalEvent(d.type, d.message))
            return
          }
          out = d.frame
        }
      }
      up.send(out)
      return
    }
    if (!this.started) this.start(m)
  }

  // The client left: a primary asks the provider to close and is billed what it reports; an attach just ends.
  onClose(): void {
    this.closed = true
    const r = this.relay
    if (r !== undefined) {
      r.browserGone()
      return
    }
    closeUpstream(this.upstream)
  }

  // The first frame of a primary: resolves the model, admits the session and dials the provider.
  private start(m: string): void {
    const cfg = this.engine.cfg
    let model = ""
    let frame = ""
    try {
      const fs = fields(m)
      if (rawStr(fs, "type") !== "session.start") {
        this.refuse("invalid_request_error", "the first event of a live session must be session.start")
        return
      }
      const s = find(fs, "session")
      if (s !== undefined) model = rawStr(fields(s), "model") ?? ""
    } catch (e) {
      this.refuse("invalid_request_error", "failed to parse session.start JSON")
      return
    }
    if (model.trim() === "") {
      this.refuse("invalid_request_error", "session.start requires session.model")
      return
    }
    const ref = parseModel(cfg, model)
    const admitted = this.engine.gov.admit(this.headers, ref.provider, ref.model)
    if (admitted.kind === "denial") {
      this.refuse(admitted.type, admitted.message)
      return
    }
    const sel = target(cfg, ref, new Set<int>(), this.headers.get("x-bf-api-key") ?? undefined)
    if (sel === undefined) {
      this.refuse("invalid_request_error", `no key is configured for ${ref.provider}/${ref.model}`)
      return
    }
    if (sel.t.kind !== "openai") {
      this.refuse("invalid_request_error", `${ref.provider} has no live API this gateway can relay`)
      return
    }
    const up = upstreamFor(sel.t, undefined)
    try {
      frame = rewriteStart(m, sel.t.model)
    } catch (e) {
      this.refuse("invalid_request_error", "failed to parse session.start JSON")
      return
    }
    // the delegated-responses model: the session's provider and key must serve it, governance admits it, and it goes up bare
    const admitBackend = admitFor(this.engine, this.headers)
    let backend = ""
    if (delegatesResponses(m)) {
      const d = checkDelegation(cfg, ref.provider, sel.t.key, frame, admitBackend, true)
      if (d.message !== "") {
        this.refuse(d.type, d.message)
        return
      }
      frame = d.frame
      backend = d.model
    }
    this.started = true
    this.session(admitted, ref.provider, ref.model, backend, wsBase(liveBase(sel.t)) + "/v1/live/sessions", up.headers, frame, peerOf(sel.t.cfg))
    const r = this.relay
    const engine = this.engine
    const provider = ref.provider
    const key = sel.t.key
    if (r !== undefined) r.core.checkUpdate = (u: string): UpdateCheck => checkDelegation(engine.cfg, provider, key, u, admitBackend, false)
  }

  // A sideband: frames pass between the client and the session another connection runs, untouched. It bills
  // nothing, the primary does.
  private attach(url: string, headers: Map<string, string>): void {
    const hs: Record<string, string> = {}
    for (const k of headers.keys()) hs.set(k, headers.get(k)!)
    // the address policy of the OpenAI provider the attach goes to (attachUpstream picked it the same way)
    const t = controlTarget(this.engine, this.headers)
    const up = openUpstream(url, hs, t === undefined ? providerPeer(false) : peerOf(t.cfg))
    if (up === undefined) {
      this.refuse("server_error", "failed to open the live connection at the provider")
      return
    }
    this.upstream = up
    const cell = new UpCell()
    cell.up = up
    // a client that left while the dial was connecting: the upstream is closed once it opens
    up.onopen = () => {
      const u = cell.up
      if ((this.closed || this.ended) && u !== undefined) u.close()
    }
    up.onmessage = (ev) => {
      const d = ev.data
      if (this.closed || this.ended || typeof d !== "string") return
      this.send(d)
    }
    up.onclose = (ev) => {
      this.endWith(ev.code === 1005 || ev.code === 1006 ? 1011 : ev.code, ev.reason)
      // (the handlers hold this socket, which holds the upstream)
      unhook(cell)
    }
    up.onerror = (ev) => {
      this.endWith(1011, "upstream live connection failed")
    }
  }

  // A primary session, admitted: the client and the provider are joined by a relay that meters, guards and
  // logs it (webrtc.tov). The start frame goes first; the client's later frames queue behind it, and wait for
  // the provider's socket to open.
  private session(grant: Grant, provider: string, model: string, backend: string, url: string, headers: Map<string, string>, first: string, peer: Peer): void {
    const spec: SessionSpec = { op: "live", transport: "websocket", provider: provider, model: model }
    const reg = this.reg
    const owner = this.owner
    const relay = new Relay(sessionHooks(this.engine, this.headers, grant, spec, (id) => reg.bind(id, owner), (id) => {
      reg.release(id, owner)
    }), sessionGuard(this.engine), Date.now())
    // only a created WebRTC session bills a minimum
    relay.core.minimum = 0.0
    relay.core.model = model
    relay.core.backendModel = backend
    relay.clientOpen = true
    relay.setupDone = true
    const me = this
    relay.client = new Leg((t) => {
      me.send(t)
      return true
    }, (p) => false, () => 0, (code, why) => {
      if (!me.closed) me.endWith(code, why)
    })
    this.relay = relay
    const hs: Record<string, string> = {}
    for (const k of headers.keys()) hs.set(k, headers.get(k)!)
    const up = openUpstream(url, hs, peer)
    if (up === undefined) {
      const msg = "failed to open the live connection at the provider"
      this.send(refusalEvent("server_error", msg))
      relay.core.abort(502, msg, Date.now())
      relay.close()
      return
    }
    this.upstream = up
    relay.provider = new Leg((t) => {
      up.send(t)
      return true
    }, (p) => false, () => 0, (code, why) => {
      closeUpstream(up)
    })
    const cell = new UpCell()
    cell.up = up
    up.onopen = () => {
      // a client that left while the dial was connecting: the relay is over, so the socket is closed
      const u = cell.up
      if (relay.closed) {
        if (u !== undefined) u.close()
      } else relay.channelOpened(false)
    }
    up.onmessage = (ev) => {
      const d = ev.data
      if (typeof d === "string") relay.fromProvider(d)
    }
    up.onclose = (ev) => {
      if (ev.code === 1000 || ev.code === 1001 || ev.code === 1005) relay.providerGone()
      else relay.providerBroke()
      unhook(cell)
    }
    up.onerror = (ev) => {
      relay.providerBroke()
    }
    relay.fromBrowser(first)
    startClock(relay)
  }

  // Tells the client why the session ends, then ends it. The upstream, if dialed, is closed too.
  private refuse(type: string, message: string): void {
    this.send(refusalEvent(type, message))
    closeUpstream(this.upstream)
    this.endWith(1008, "refused")
  }
}

// GET /v1/live/sessions/{id}/content: the recording the provider kept, streamed as it sends it.
export async function liveContent(engine: Engine, reg: LiveRegistry, req: Request, id: string): Promise<Response> {
  const h = snapshot(req.headers)
  if (!validId(id)) return errorResponse(400, "a session id is required", "invalid_request_error", noHeaders())
  if (!credentialOk(engine, h)) return errorResponse(401, "authentication is required for live sessions", "authentication_error", noHeaders())
  if (!reg.allowed(id, ownerOf(engine, h))) return errorResponse(404, "live session not found", "invalid_request_error", noHeaders())
  const t = controlTarget(engine, h)
  if (t === undefined) return errorResponse(404, "no OpenAI key is configured for live sessions", "invalid_request_error", noHeaders())
  const up = upstreamFor(t, undefined)
  const hs: Record<string, string> = {}
  for (const k of up.headers.keys()) hs.set(k, up.headers.get(k)!)
  try {
    // buffered, as media.tov's files are: a streamed upstream body doesn't survive the Bun.serve path
    const dl = deadline(LIVE_CONTENT_MS)
    let res: Response | undefined = undefined
    let bytes: u8[] = []
    try {
      const r = await fetch(liveBase(t) + "/v1/live/sessions/" + id + "/content", { method: "GET", headers: hs, signal: dl.controller.signal, peer: peerOf(t.cfg) })
      bytes = await r.bytes()
      res = r
    } finally {
      dl.finish()
    }
    if (res === undefined) return errorResponse(502, "failed to fetch the live session's recording", "api_error", noHeaders())
    const out: Record<string, string> = {}
    out.set("content-type", res.headers.get("content-type") ?? "application/octet-stream")
    return new Response(bytes, { status: res.status, headers: out })
  } catch (e) {
    console.error(`raiju: ${e.message}`)
    return errorResponse(502, "failed to fetch the live session's recording", "api_error", noHeaders())
  }
}

test("live session ids", () => {
  expect(validId("sess_9aB-x")).toBe(true)
  expect(validId("")).toBe(false)
  expect(validId("a/b")).toBe(false)
  expect(validId("a?x=1")).toBe(false)
  expect(attachId("/v1/live/sessions/sess_1/attach")).toBe("sess_1")
  expect(attachId("/v1/live/sessions/attach")).toBe("")
  expect(contentId("/v1/live/sessions/sess_1/content")).toBe("sess_1")
  expect(contentId("/v1/live/sessions/sess_1/attach")).toBe("")
})

test("live registry", () => {
  const reg = new LiveRegistry()
  expect(reg.bind("sess_a", "vk1")).toBe(true)
  expect(reg.bind("sess_a", "vk2")).toBe(false)
  expect(reg.allowed("sess_a", "vk1")).toBe(true)
  expect(reg.allowed("sess_a", "vk2")).toBe(false)
  expect(reg.allowed("sess_a", "")).toBe(true)
  expect(reg.allowed("sess_unknown", "vk2")).toBe(true)
  expect(reg.bind("sess_none", "")).toBe(true)
  expect(reg.allowed("sess_none", "vk2")).toBe(true)
})

test("live create replies", () => {
  const a = liveAnswer(`{"session":{"id":"sess_9","type":"realtime"},"transport":{"type":"webrtc","sdp":"v=0\\r\\n"}}`)
  expect(a === undefined).toBe(false)
  expect(a!.id).toBe("sess_9")
  expect(a!.sdp).toBe("v=0\r\n")
  expect(liveAnswer(`{"session":{"id":"sess_9"}}`) === undefined).toBe(true)
  expect(liveAnswer(`{"session":{"id":""},"transport":{"sdp":"v=0"}}`) === undefined).toBe(true)
  expect(liveAnswer("not json") === undefined).toBe(true)
})

test("live start frames and ids", () => {
  expect(try rewriteStart(`{"type":"session.start","session":{"model":"openai/gpt-live","voice":"alloy"}}`, "gpt-live")).toBe(`{"type":"session.start","session":{"model":"gpt-live","voice":"alloy"}}`)
  expect(startedId(`{"type":"session.started","session":{"id":"sess_42"}}`)).toBe("sess_42")
  expect(startedId(`{"type":"session.updated","session":{"id":"sess_42"}}`)).toBe("")
  expect(startedId(`{"type":"response.audio.delta"}`)).toBe("")
})

test("the model a live start names for its delegated responses: checked, and sent bare", () => {
  const cfg: Config = {}
  const key: KeyConfig = { value: "sk" }
  const start = `{"type":"session.start","session":{"model":"gpt-live","delegation":{"type":"responses","responses":{"model":"openai/gpt-5.4","instructions":"x"}}}}`
  expect(delegatesResponses(start)).toBe(true)
  const d = checkDelegation(cfg, "openai", key, start, undefined, true)
  expect(d.message).toBe("")
  expect(d.model).toBe("gpt-5.4")
  expect(d.frame).toBe(`{"type":"session.start","session":{"model":"gpt-live","delegation":{"type":"responses","responses":{"model":"gpt-5.4","instructions":"x"}}}}`)
  // a bare name is the session's provider's, and goes as it is
  const bare = `{"session":{"model":"gpt-live","delegation":{"type":"responses","responses":{"model":"gpt-5.4-mini"}}}}`
  const b = checkDelegation(cfg, "openai", key, bare, undefined, true)
  expect(b.frame).toBe(bare)
  expect(b.model).toBe("gpt-5.4-mini")
  // only a responses delegation with its settings has a backend model, and then it must name one
  expect(delegatesResponses(`{"session":{"model":"gpt-live"}}`)).toBe(false)
  expect(delegatesResponses(`{"session":{"delegation":{"type":"client"}}}`)).toBe(false)
  expect(delegatesResponses(`{"session":{"delegation":{"type":"responses"}}}`)).toBe(false)
  expect(delegatesResponses("not json")).toBe(false)
  expect(checkDelegation(cfg, "openai", key, `{"session":{"delegation":{"type":"responses","responses":{"model":"  "}}}}`, undefined, true).message).toBe("session.delegation.responses.model is required for responses delegation")
})

test("a live session.update's delegated model: the session's provider, the key's models, governance, and the alias", () => {
  const cfg: Config = {}
  const upd = (m: string): string => `{"type":"session.update","session":{"delegation":{"type":"responses","responses":{"model":"${m}"}}}}`
  const any: KeyConfig = { value: "sk" }
  // another provider's model is refused
  const other = checkDelegation(cfg, "openai", any, upd("anthropic/claude-sonnet"), undefined, false)
  expect(other.status).toBe(400)
  expect(other.type).toBe("invalid_request_error")
  expect(other.message).toBe("session.delegation.responses.model must be served by openai, the provider of session.model")
  // a model the key does not serve is refused
  const narrow: KeyConfig = { value: "sk", models: ["gpt-5.4"] }
  expect(checkDelegation(cfg, "openai", narrow, upd("openai/gpt-4o"), undefined, false).message).toBe("the key serving this session does not support model gpt-4o")
  expect(checkDelegation(cfg, "openai", narrow, upd("openai/gpt-5.4"), undefined, false).message).toBe("")
  // governance's refusal is the client's error
  const denied = checkDelegation(cfg, "openai", any, upd("gpt-5.4"), (p: string, m: string): Refusal | undefined => ({ status: 403, type: "permission_error", message: `model ${p}/${m} is not allowed` }), false)
  expect(denied.status).toBe(403)
  expect(denied.message).toBe("model openai/gpt-5.4 is not allowed")
  // an alias goes up as the provider's model
  const aliases: Map<string, string | AliasTarget> = new Map()
  aliases.set("fast", "gpt-5.4-mini")
  const aliased = checkDelegation(cfg, "openai", { value: "sk", aliases: aliases }, upd("openai/fast"), undefined, false)
  expect(aliased.model).toBe("fast")
  expect(aliased.frame).toBe(upd("gpt-5.4-mini"))
  // an update that names no delegated model passes untouched
  const voice = `{"type":"session.update","session":{"voice":"alloy"}}`
  const v = checkDelegation(cfg, "openai", narrow, voice, undefined, false)
  expect(v.frame).toBe(voice)
  expect(v.model).toBe("")
  expect(delegationRef(cfg, "openai", "nope/x").model).toBe("nope/x")
})

test("WebRTC calls are refused unless server.webrtc_enabled is set", () => {
  const off = webrtcRefusal({})
  expect(off?.status).toBe(403)
  expect(webrtcRefusal({ server: { webrtc_enabled: false } })?.status).toBe(403)
  expect(webrtcRefusal({ server: { webrtc_enabled: true } })).toBeUndefined()
})

test("a live session's record goes after its session ends, and a full registry makes room from ended ones (re-audit 7 P1-4)", () => {
  const reg = new LiveRegistry()
  const t0 = 1000000.0
  expect(reg.bindAt("sess_a", "vk1", t0)).toBe(true)
  // only its owner's end counts
  reg.releaseAt("sess_a", "vk2", t0)
  expect(reg.ended.has("sess_a")).toBe(false)
  reg.releaseAt("sess_a", "vk1", t0)
  // kept for the recording and late attaches, then gone
  reg.sweep(t0 + LIVE_ENDED_KEEP_MS - 1.0, true)
  expect(reg.allowed("sess_a", "vk2")).toBe(false)
  reg.sweep(t0 + LIVE_ENDED_KEEP_MS, true)
  expect(reg.owners.has("sess_a")).toBe(false)
  expect(reg.expires.size).toBe(0)
  expect(reg.ended.size).toBe(0)
  // a record whose end is never seen goes after the TTL
  expect(reg.bindAt("sess_b", "vk1", t0)).toBe(true)
  reg.sweep(t0 + LIVE_RECORD_TTL_MS, true)
  expect(reg.owners.has("sess_b")).toBe(false)
  // full of running sessions: a new one is refused; once one has ended, its record makes room at once
  for (let i = 0; i < 10000; i++) expect(reg.bindAt(`sess_${i}`, "vk1", t0)).toBe(true)
  expect(reg.bindAt("sess_new", "vk1", t0)).toBe(false)
  expect(reg.roomAt(t0)).toBe(false)
  reg.releaseAt("sess_7", "vk1", t0)
  expect(reg.bindAt("sess_new", "vk1", t0)).toBe(true)
  expect(reg.owners.has("sess_7")).toBe(false)
  expect(reg.owners.size).toBe(10000)
  // more sessions that each end, past the cap: never refused
  reg.releaseAt("sess_new", "vk1", t0)
  for (let i = 0; i < 500; i++) {
    const id = `sess_more_${i}`
    expect(reg.bindAt(id, "vk2", t0 + 1.0)).toBe(true)
    reg.releaseAt(id, "vk2", t0 + 1.0)
  }
  expect(reg.owners.size).toBe(10000)
})

test("a shared live record's folder goes with its record", () => {
  const dir = "/tmp/raiju-live-share-test"
  try {
    rmSync(dir, { recursive: true, force: true })
  } catch (e) {}
  const reg = new LiveRegistry()
  reg.share(dir)
  const other = new LiveRegistry()
  other.share(dir)
  const t0 = 5000000.0
  expect(reg.bindAt("sess_s", "vk1", t0)).toBe(true)
  // another worker sees the owner through the folder
  expect(other.allowed("sess_s", "vk2")).toBe(false)
  expect(other.allowed("sess_s", "vk1")).toBe(true)
  reg.releaseAt("sess_s", "vk1", t0)
  reg.sweep(t0 + LIVE_ENDED_KEEP_MS, true)
  expect(reg.owners.has("sess_s")).toBe(false)
  // the folder is gone with it
  expect(other.allowed("sess_s", "vk2")).toBe(true)
  try {
    rmSync(dir, { recursive: true, force: true })
  } catch (e) {}
})
