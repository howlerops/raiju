// OpenAI chat.completion.chunk events built from a complete chat.completion,
// for providers the gateway calls without streaming.
import { fields, find, elements, quote, rawStr, isNull } from "./json"

export function completionToSse(completion: string, includeUsage: bool): string throws SyntaxError {
  const fs = try fields(completion)
  const id = find(fs, "id") ?? `"chatcmpl"`
  const created = find(fs, "created") ?? "0"
  const model = find(fs, "model") ?? `""`
  const head = `{"id":${id},"object":"chat.completion.chunk","created":${created},"model":${model},`
  const out: string[] = []
  const choicesRaw = find(fs, "choices")
  if (choicesRaw !== undefined && !isNull(choicesRaw)) {
    for (const ch of try elements(choicesRaw)) {
      const c = try fields(ch)
      const index = find(c, "index") ?? "0"
      const finish = find(c, "finish_reason") ?? `"stop"`
      out.push(`data: ${head}"choices":[{"index":${index},"delta":{"role":"assistant","content":""},"finish_reason":null}]}`)
      const msgRaw = find(c, "message")
      if (msgRaw !== undefined && !isNull(msgRaw)) {
        const m = try fields(msgRaw)
        const content = find(m, "content")
        if (content !== undefined && !isNull(content) && content !== `""`) {
          out.push(`data: ${head}"choices":[{"index":${index},"delta":{"content":${content}},"finish_reason":null}]}`)
        }
        const calls = find(m, "tool_calls")
        if (calls !== undefined && !isNull(calls)) {
          const els = try elements(calls)
          for (let i = 0; i < els.length; i++) {
            const tc = try fields(els[i]!)
            const fnRaw = find(tc, "function") ?? "{}"
            const fn = try fields(fnRaw)
            out.push(`data: ${head}"choices":[{"index":${index},"delta":{"tool_calls":[{"index":${i},"id":${find(tc, "id") ?? `""`},"type":"function","function":{"name":${quote(rawStr(fn, "name") ?? "")},"arguments":${find(fn, "arguments") ?? `""`}}}]},"finish_reason":null}]}`)
          }
        }
      }
      out.push(`data: ${head}"choices":[{"index":${index},"delta":{},"finish_reason":${finish}}]}`)
    }
  }
  const usage = find(fs, "usage")
  if (includeUsage && usage !== undefined && !isNull(usage)) out.push(`data: ${head}"choices":[],"usage":${usage}}`)
  out.push("data: [DONE]")
  return out.join("\n\n") + "\n\n"
}

test("synthesizes chunks from a completion", () => {
  const sse = try completionToSse(`{"id":"c1","object":"chat.completion","created":7,"model":"m","choices":[{"index":0,"message":{"role":"assistant","content":"hi","tool_calls":[{"id":"t1","type":"function","function":{"name":"f","arguments":"{}"}}]},"finish_reason":"tool_calls"}],"usage":{"prompt_tokens":1,"completion_tokens":1,"total_tokens":2}}`, true)
  const events = sse.split("\n\n").filter((e) => e !== "")
  expect(events.length).toBe(6)
  expect(events[1]).toBe(`data: {"id":"c1","object":"chat.completion.chunk","created":7,"model":"m","choices":[{"index":0,"delta":{"content":"hi"},"finish_reason":null}]}`)
  expect(events[2]!.includes(`"tool_calls":[{"index":0,"id":"t1","type":"function","function":{"name":"f","arguments":"{}"}}]`)).toBe(true)
  expect(events[3]!.includes(`"finish_reason":"tool_calls"`)).toBe(true)
  expect(events[5]).toBe("data: [DONE]")
})
