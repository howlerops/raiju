// The request-body bytes one process holds at once, across requests (server.max_buffered_body_mb). A body is read
// whole before it is parsed, and parsing a big one costs several times its size, so a few large bodies sent at once
// could take a worker past its memory limit. A body that has not been read yet (over UNREAD_ABOVE, or chunked) is
// charged here (a declared length when the body is admitted, a chunked body as its bytes arrive) and given back when
// its request is done; a declared length that cannot fit beside what is held is refused with 503 unread, and a chunked
// body whose next bytes do not fit is refused with 503 there. A small body the server has read already is charged
// too, but never refused: turning it away would save no memory.
//
// Bodies come in two kinds (production re-audit 3, P1-D). A checked body is one whose credential the gateway verified
// from the headers before reading it (a virtual key, a direct provider key that matches a configured one, a management
// sign-in, the SCIM token, a signed peer request). An unchecked body is one nobody vouched for: inference with auth off
// or behind the plugins' HTTP hooks (they may add the credential), and the routes that read their credential from the
// body. Unchecked bodies share a small part of the cap (server.unchecked_body_mb, an eighth by default), and the bytes
// one of them holds past that share do not count against the checked bodies: an unauthenticated client cannot turn the
// authenticated big POSTs away. An unchecked body must arrive whole within server.body_deadline_seconds (30).
//
// A checked body must keep server.body_min_kb_per_second (32) after server.body_rate_grace_seconds (10), counted over
// each recent server.body_rate_window_seconds (30), and arrive whole within server.body_max_seconds (600): a slow but
// steady authenticated upload is served (P2-B), and one that sends a lot at once and then trickles is cut a window
// later (re-audit 4 P1-E: an average from the start let the early bytes buy about 26 minutes).
//
// The cap is a hard bound on the bytes in hand (re-audit 5 P1-A: a per-credential discount let them reach twice the
// cap, and three ordinary uploads took the chart's 512Mi pod past its limit). Under contention the tenant decides who
// is refused first (re-audit 5 P1-B): bodies count per tenant (a virtual key's customer, else its team, else the key;
// else the credential's name), and a new body that keeps its tenant within server.credential_body_mb (a quarter of
// the cap) may use the last server.body_reserve_mb (a quarter) of the cap. The reserve is kept from tenants that hold
// bytes already (re-audit 6 P1-B): a tenant's first body may fill the cap, and so may the next bodies of a tenant that
// holds every big body while no other tenant waits (one was refused within WAITING_MS); a tenant holding bytes beside
// others, or a chunked body that keeps growing, fills the cap only up to the reserve, so an idle tenant's body within
// its share is admitted while others hold the budget, and the tenant past its share is the one refused.
//
// A declared length is reserved whole when the body is admitted (re-audit 5 P2-A), so a body that cannot fit is 503
// before its client sends anything and an admitted one that arrives briskly is never refused part way; a chunked body
// is charged as its bytes arrive. Under contention a reservation whose body fell behind its pace is cut to what it has
// received plus a look-ahead (re-audit 6 P1-A), so tenants that declare big lengths and send slowly or nothing do not
// hold the cap.
//
// A body is always admitted when the process holds no other big body (small ones, read already, do not count), so a
// single request up to client.max_request_body_size_mb is still served (Bifrost's limit keeps its meaning); the cap
// decides how many big bodies are read at once. Beside such a lone body bigger than the cap, tenants within their
// share may still use the reserve past it. The peer routes and the broker have a budget of their own (peerBudget).
import { ServerSectionConfig } from "./config"

// Sized for the chart's 512Mi pod: a chat body costs about eight times its size while it is parsed and sent on
// (bench/body_memory.py), so 48 MB of bodies in hand stays near 400 MB.
export const DEFAULT_BUFFERED_BODY_MB = 48

// Bodies with a declared length up to this reach the gateway already read (the servers' stream threshold); bigger
// and chunked ones reach it as a stream, so their credentials are checked and their bytes charged before they are read.
export const UNREAD_ABOVE = 65536

// What a body is charged as: "small" (read by the server already), "checked" (its credential was verified from the
// headers), "unchecked" (it was not).
export type BodyClass = "small" | "checked" | "unchecked"

// server.max_buffered_body_mb in bytes: unset or 0 is the default, a negative number is no cap (0 returned).
export function bufferedCap(s: ServerSectionConfig | undefined): int {
  const mb = s?.max_buffered_body_mb ?? 0
  if (mb < 0) return 0
  return (mb === 0 ? DEFAULT_BUFFERED_BODY_MB : mb) * 1048576
}

// The unchecked bodies' share of the cap when server.unchecked_body_mb is unset: an eighth.
export const UNCHECKED_SHARE_DIVISOR = 8

// server.unchecked_body_mb in bytes, given the cap (bufferedCap): unset or 0 is an eighth of the cap, a negative
// number is no separate share (0 returned: unchecked bodies count like checked ones), and it is never above the cap.
export function uncheckedShare(s: ServerSectionConfig | undefined, cap: int): int {
  if (cap <= 0) return 0
  const mb = s?.unchecked_body_mb ?? 0
  if (mb < 0) return 0
  if (mb === 0) return Math.max(1, Math.floor(cap / UNCHECKED_SHARE_DIVISOR))
  return Math.min(cap, mb * 1048576)
}

// The share of the cap one tenant's bodies may hold before they give way to other tenants when
// server.credential_body_mb is unset: a quarter.
export const CREDENTIAL_SHARE_DIVISOR = 4

// server.credential_body_mb in bytes, given the cap (bufferedCap): unset or 0 is a quarter of the cap, a negative
// number is no per-tenant share (0 returned), and it is never above the cap.
export function credentialShare(s: ServerSectionConfig | undefined, cap: int): int {
  if (cap <= 0) return 0
  const mb = s?.credential_body_mb ?? 0
  if (mb < 0) return 0
  if (mb === 0) return Math.max(1, Math.floor(cap / CREDENTIAL_SHARE_DIVISOR))
  return Math.min(cap, mb * 1048576)
}

// The part of the cap tenants past their share may not fill when server.body_reserve_mb is unset: a quarter, so an
// idle tenant's first body up to its share fits whatever the others hold.
export const BODY_RESERVE_DIVISOR = 4

// server.body_reserve_mb in bytes, given the cap (bufferedCap): unset or 0 is a quarter of the cap, a negative number
// is no reserve (0 returned), and it is never above the cap.
export function bodyReserve(s: ServerSectionConfig | undefined, cap: int): int {
  if (cap <= 0) return 0
  const mb = s?.body_reserve_mb ?? 0
  if (mb < 0) return 0
  if (mb === 0) return Math.max(1, Math.floor(cap / BODY_RESERVE_DIVISOR))
  return Math.min(cap, mb * 1048576)
}

// server.body_deadline_seconds: an unchecked body that reaches the gateway unread must arrive whole within this
// (Raiju's own; Bifrost's server has no read deadline). The body timeout limits only the gap between bytes, so without
// it a client could hold a charged body for as long as it sends a byte a minute.
export const DEFAULT_BODY_DEADLINE_SECONDS = 30.0

// server.body_deadline_seconds in ms: unset is the default, 0 or less is none (0 returned).
export function bodyDeadlineMs(s: ServerSectionConfig | undefined): int {
  const v = s?.body_deadline_seconds
  if (v === undefined) return Math.round(DEFAULT_BODY_DEADLINE_SECONDS * 1000)
  return v > 0 ? Math.max(1, Math.round(v * 1000)) : 0
}

// server.body_min_kb_per_second, server.body_rate_grace_seconds and server.body_rate_window_seconds: in its first
// window after the grace a checked body must have sent rate x (elapsed - grace) bytes in all, and from then on rate x
// window bytes in every recent window, so bytes sent early buy no more than a window.
export const DEFAULT_BODY_MIN_KB_PER_SECOND = 32.0
export const DEFAULT_BODY_RATE_GRACE_SECONDS = 10.0
export const DEFAULT_BODY_RATE_WINDOW_SECONDS = 30.0

// server.body_max_seconds: a checked body (or a signed peer body) must arrive whole within this, so no credential
// holds its part of the cap for longer (Raiju's own, like body_deadline_seconds for the unchecked bodies). 100 MB in
// ten minutes is about 170 KB/s.
export const DEFAULT_BODY_MAX_SECONDS = 600.0

// The timing rules of checked bodies, in ms: bytes per second (0: none), the grace, the window the rate is counted
// over (0: an average from the start, as before re-audit 4) and the hard ceiling (0: none).
export type BodyRate = { bytesPerSecond: f64, graceMs: f64, windowMs: f64, maxMs: f64 }

export function bodyRate(s: ServerSectionConfig | undefined): BodyRate {
  const kb = s?.body_min_kb_per_second ?? DEFAULT_BODY_MIN_KB_PER_SECOND
  const grace = s?.body_rate_grace_seconds ?? DEFAULT_BODY_RATE_GRACE_SECONDS
  const win = s?.body_rate_window_seconds ?? DEFAULT_BODY_RATE_WINDOW_SECONDS
  const most = s?.body_max_seconds ?? DEFAULT_BODY_MAX_SECONDS
  return {
    bytesPerSecond: kb > 0 ? kb * 1024.0 : 0.0,
    graceMs: grace > 0 ? grace * 1000.0 : 0.0,
    windowMs: win > 0 ? Math.max(1000.0, win * 1000.0) : 0.0,
    maxMs: most > 0 ? most * 1000.0 : 0.0,
  }
}

// When (ms after the body's start) a checked body that has sent got bytes falls behind the average rate: in its first
// window it is cut once that moment passes without more bytes.
export function rateDue(got: int, r: BodyRate): f64 {
  if (r.bytesPerSecond <= 0) return 1.0e18
  return r.graceMs + (got * 1.0) / r.bytesPerSecond * 1000.0
}

// How often a checked body's pace is looked at, at most (ms).
export const PACE_STEP_MS = 1000.0

// A pace check: late is "" (keep reading and look again in waitMs), "rate" (behind body_min_kb_per_second) or
// "ceiling" (past body_max_seconds).
export type PaceVerdict = { late: string, waitMs: f64 }

// The pace of one checked body. check takes the ms since the body's start and the bytes it has sent so far, and keeps a
// mark of them at each look; the bytes of the last window are those sent since the newest mark a window old. The first
// window after the grace is judged by the average since the start (rateDue).
export class BodyPace {
  private at: f64[] = [0.0]
  private sent: int[] = [0]

  constructor(public r: BodyRate) {}

  // Whether any rule applies (a body with none is not timed).
  timed(): bool {
    return this.r.bytesPerSecond > 0 || this.r.maxMs > 0
  }

  // When to look first (ms after the start).
  firstWait(): f64 {
    let w = PACE_STEP_MS
    if (this.r.bytesPerSecond > 0) w = Math.min(w, this.r.graceMs)
    if (this.r.maxMs > 0) w = Math.min(w, this.r.maxMs)
    return Math.max(1.0, w)
  }

  check(t: f64, got: int): PaceVerdict {
    const r = this.r
    if (r.maxMs > 0 && t >= r.maxMs) return { late: "ceiling", waitMs: 0.0 }
    let wait = PACE_STEP_MS
    if (r.bytesPerSecond > 0) {
      // the newest mark a window old; the marks before it are not needed again
      let i = 0
      while (r.windowMs > 0 && i + 1 < this.at.length && this.at[i + 1]! <= t - r.windowMs) i += 1
      if (i > 0) {
        this.at = this.at.slice(i)
        this.sent = this.sent.slice(i)
      }
      if (r.windowMs <= 0 || t < r.graceMs + r.windowMs) {
        const due = rateDue(got, r)
        if (t >= due) return { late: "rate", waitMs: 0.0 }
        wait = Math.min(wait, due - t)
      } else {
        const inWindow = got - this.sent[0]!
        if ((inWindow * 1.0) * 1000.0 < r.bytesPerSecond * r.windowMs) return { late: "rate", waitMs: 0.0 }
      }
      if (r.windowMs > 0) {
        this.at.push(t)
        this.sent.push(got)
      }
    } else {
      wait = r.maxMs - t
    }
    if (r.maxMs > 0) wait = Math.min(wait, r.maxMs - t)
    return { late: "", waitMs: Math.max(1.0, wait) }
  }

  // The marks kept (about a window's worth of looks).
  marks(): int {
    return this.at.length
  }
}

// A declared length is reserved whole while its body is on pace to arrive soon. Under contention a body that does not
// fit cuts the reservations of other tenants furthest behind their pace (re-audit 6 P1-A: tenants that declared big
// lengths and sent slowly or nothing held the whole cap, and other tenants' 1-4 MB bodies got 503 for minutes): such a
// body keeps what it has received plus a look-ahead (reserveLookahead) and is charged as its bytes arrive from then on, like a
// chunked body. A body is cut only RESERVE_GRACE_MS after it was admitted, and only when at its rate so far the rest
// would take longer than RESERVE_HORIZON_MS, so bodies that arrive briskly are never refused part way (re-audit 5 P2-A).
// A body that has received nothing at all may be cut after RESERVE_EMPTY_GRACE_MS (a client sends its body right after
// the head), and a tenant's grace is counted once (L213, re-audit 6's open item: tenants that reconnected at once kept
// a fresh, uncuttable reservation and outsiders got about 4% 503): a reservation admitted while the same tenant held
// another, or within RESERVE_GRACE_MS after one ended, has its grace counted from the first of that run.
export const RESERVE_GRACE_MS = 1000.0
export const RESERVE_EMPTY_GRACE_MS = 200.0
export const RESERVE_HORIZON_MS = 10000.0
export const RESERVE_LOOKAHEAD = 1048576

// The look-ahead a cut reservation keeps beyond the bytes received: a 48th of the cap, between 64 KB and
// RESERVE_LOOKAHEAD (1 MB at the default cap).
export function reserveLookahead(cap: int): int {
  return Math.min(RESERVE_LOOKAHEAD, Math.max(UNREAD_ABOVE, Math.floor(cap / 48)))
}

// A tenant refused a body counts as waiting for this long (ms): meanwhile no other tenant fills the reserve.
export const WAITING_MS = 3000.0

// What a request holds of a body budget until it is done: release gives it back (once).
export class BodyHold {
  held = 0
  cls: BodyClass = "small"
  peer = false
  // the tenant its bytes are counted for ("" none)
  who = ""
  // a declared length reserved whole (BodyBudget.track): its size, the bytes received so far, when it was admitted (ms)
  // and its id in the budget (0: not reserved, or cut)
  declared = 0
  got = 0
  start = 0.0
  id = 0

  release(): void {
    const b = this.peer ? peerBudget() : bodyBudget()
    b.untrack(this)
    const n = this.held
    this.held = 0
    if (n <= 0) return
    b.give(n, this.cls, this.who)
  }
}

// A tenant's run of reservations (BodyBudget.runs): its grace counts from `since` while it holds one (`live`) or
// ended one less than RESERVE_GRACE_MS ago (`ended`).
type TenantRun = { since: f64, live: int, ended: f64 }

export class BodyBudget {
  // every byte charged, the small bodies' part of it, and the unchecked bodies' part
  held = 0
  small = 0
  unchecked = 0
  refused = 0
  // reservations cut (re-audit 6 P1-A)
  cuts = 0
  // the clock (ms); a test sets it
  clock = -1.0
  // the bytes each tenant's bodies hold (BodyHold.who), for server.credential_body_mb
  private byWho: Map<string, int> = new Map()
  // the declared lengths reserved whole, by id
  private reserved: Map<int, BodyHold> = new Map()
  private nextId = 0
  // the tenants refused a body lately, and until when they count as waiting
  private waiting: Map<string, f64> = new Map()
  // per tenant with reservations lately: when its run of reservations began (the grace counts from it), how many it
  // holds, and when its last one ended
  private runs: Map<string, TenantRun> = new Map()

  now(): f64 {
    return this.clock >= 0 ? this.clock : performance.now()
  }

  // What the checked bodies see as held: the bytes a lone unchecked body holds past the unchecked share do not count.
  private seen(share: int): int {
    if (share <= 0 || this.unchecked <= share) return this.held
    return this.held - (this.unchecked - share)
  }

  // The most bytes one tenant other than who holds.
  private biggest(who: string): int {
    let n = 0
    for (const k of this.byWho.keys()) {
      if (k === who) continue
      n = Math.max(n, this.byWho.get(k) ?? 0)
    }
    return n
  }

  // The bytes tenant who holds now.
  heldBy(who: string): int {
    return this.byWho.get(who) ?? 0
  }

  // Records h, whose declared length of n bytes was just charged whole, as a reservation that may be cut.
  track(h: BodyHold, n: int): void {
    this.nextId += 1
    h.id = this.nextId
    h.declared = n
    h.got = 0
    h.start = this.now()
    this.reserved.set(h.id, h)
    if (h.who !== "") this.runStart(h.who, h.start)
  }

  // h no longer holds a reservation (its body is read, refused or cut).
  untrack(h: BodyHold): void {
    if (h.id > 0) {
      this.reserved.delete(h.id)
      if (h.who !== "") this.runEnd(h.who, this.now())
    }
    h.id = 0
  }

  // A reservation of tenant who begins at t: it joins the tenant's run when one holds a reservation or ended one less
  // than RESERVE_GRACE_MS ago, else starts a new run. Runs that ended long ago are forgotten here, so the map stays as
  // small as the tenants reserving lately.
  private runStart(who: string, t: f64): void {
    for (const k of this.runs.keys()) {
      const r = this.runs.get(k)
      if (r !== undefined && r.live <= 0 && t - r.ended >= RESERVE_GRACE_MS) this.runs.delete(k)
    }
    const r = this.runs.get(who)
    if (r === undefined) {
      this.runs.set(who, { since: t, live: 1, ended: 0.0 })
      return
    }
    this.runs.set(who, { since: r.since, live: r.live + 1, ended: r.ended })
  }

  private runEnd(who: string, t: f64): void {
    const r = this.runs.get(who)
    if (r === undefined) return
    this.runs.set(who, { since: r.since, live: Math.max(0, r.live - 1), ended: t })
  }

  // When the grace of h's reservation began: its own start, or its tenant's run's when that began earlier.
  private graceFrom(h: BodyHold): f64 {
    if (h.who === "") return h.start
    const r = this.runs.get(h.who)
    if (r === undefined) return h.start
    return Math.min(h.start, r.since)
  }

  // The reservations held now.
  reservations(): int {
    return this.reserved.size
  }

  // How long (ms) the rest of a reserved body would take at its rate so far when that is past RESERVE_HORIZON_MS, else
  // -1 (it keeps its reservation): a body that has sent nothing after the grace is as late as can be.
  private behind(h: BodyHold, t: f64): f64 {
    const age = t - h.start
    const rest = h.declared - h.got
    if (rest <= 0) return -1.0
    // a body that has sent nothing: past its short grace, as late as can be
    if (h.got <= 0) return t - h.start >= RESERVE_EMPTY_GRACE_MS || t - this.graceFrom(h) >= RESERVE_GRACE_MS ? 1.0e15 + rest * 1.0 : -1.0
    if (t - this.graceFrom(h) < RESERVE_GRACE_MS) return -1.0
    const need = (rest * 1.0) * age / (h.got * 1.0)
    return need > RESERVE_HORIZON_MS ? need : -1.0
  }

  // Cuts the reservation furthest behind its pace among other tenants' (any, for who ""): it keeps what it received
  // plus the look-ahead (reserveLookahead of cap). false when no reservation is behind.
  private cutOne(who: string, cap: int): bool {
    const t = this.now()
    let worst = -1.0
    let id = 0
    for (const h of this.reserved.values()) {
      if (who !== "" && h.who === who) continue
      const late = this.behind(h, t)
      if (late > worst) {
        worst = late
        id = h.id
      }
    }
    if (id === 0) return false
    const h = this.reserved.get(id)
    if (h === undefined) return false
    this.untrack(h)
    const keep = Math.min(h.held, h.got + reserveLookahead(cap))
    if (h.held > keep) {
      this.give(h.held - keep, h.cls, h.who)
      h.held = keep
    }
    this.cuts += 1
    return true
  }

  // Whether a tenant other than who was refused a body lately (it waits for the reserve).
  private contested(who: string): bool {
    if (this.waiting.size === 0) return false
    const t = this.now()
    let yes = false
    for (const k of this.waiting.keys()) {
      if ((this.waiting.get(k) ?? 0.0) <= t) this.waiting.delete(k)
      else if (k !== who) yes = true
    }
    return yes
  }

  private refuse(own: int, who: string): void {
    this.refused += 1
    if (own <= 0 && who !== "") this.waiting.set(who, this.now() + WAITING_MS)
  }

  // Whether a body of n bytes of kind cls would fit beside what is held now (nothing is charged). share is the
  // unchecked bodies' (uncheckedShare; 0 none), who the tenant ("" none), whoShare the tenants' share
  // (credentialShare; 0 none) and reserve the room kept from tenants that hold bytes already (bodyReserve; 0 none).
  fits(n: int, cap: int, cls: BodyClass, share: int, who?: string, whoShare?: int, reserve?: int): bool {
    const w = who ?? ""
    if (this.admits(n, 0, cap, cls, share, w, whoShare ?? 0, reserve ?? 0)) return true
    this.refuse(0, w)
    return false
  }

  // Charges n more bytes to a request of kind cls that already holds `own` of them (a declared length is charged
  // whole when its body is admitted). true when they fit under cap (0: no cap), or when no other request holds a big
  // body. A checked body that does not fit first cuts other tenants' reservations that fell behind their pace.
  take(n: int, own: int, cap: int, cls: BodyClass, share: int, who?: string, whoShare?: int, reserve?: int): bool {
    if (n <= 0) return true
    const w = who ?? ""
    const ws = whoShare ?? 0
    const rs = reserve ?? 0
    while (!this.admits(n, own, cap, cls, share, w, ws, rs)) {
      if (cls !== "checked" || !this.cutOne(w, cap)) {
        this.refuse(own, w)
        return false
      }
    }
    this.held += n
    if (cls === "unchecked") this.unchecked += n
    if (cls === "small") this.small += n
    if (w !== "") this.byWho.set(w, (this.byWho.get(w) ?? 0) + n)
    return true
  }

  private admits(n: int, own: int, cap: int, cls: BodyClass, share: int, who: string, whoShare: int, reserve: int): bool {
    if (n <= 0 || cap <= 0) return true
    if (cls === "unchecked" && share > 0) {
      // alone among the big bodies it may pass the share (the request limit decides its size); beside others it
      // stays within the share and the cap
      const others = this.held - this.small - own
      if (others <= 0) return true
      return this.unchecked + n <= share && this.held + n <= cap
    }
    const seen = this.seen(share)
    // alone among the big bodies it is admitted; small bodies, read already, are not big ones (re-audit 6 P1-B: a
    // 100-byte chat in flight turned 40 MB bodies away)
    if (seen - this.small - own <= 0) return true
    // no tenants: the cap alone
    if (who === "" || whoShare <= 0 || reserve <= 0) return seen + n <= cap
    if (own <= 0) {
      const mine = this.heldBy(who)
      // a new body (a declared length, or a chunked body's first bytes) that keeps its tenant within its share may use
      // the reserve: up to the cap, or beside a lone body bigger than the cap up to the reserve past it
      if (mine + n <= whoShare) return seen + n <= Math.max(cap, this.biggest(who) + reserve)
      // the reserve is kept from tenants that hold bytes already (re-audit 6 P1-B): a tenant's first body may fill the
      // cap, and so may a new body of a tenant that holds every big body while no other tenant waits
      if (mine <= 0) return seen + n <= cap
      if (seen - this.small - mine <= 0 && !this.contested(who)) return seen + n <= cap
    }
    // a tenant holding bytes beside others (or with another waiting), or a chunked body growing, leaves the reserve to
    // the others: under contention it is the one refused
    return seen + n <= cap - reserve
  }

  // Charges n bytes that are in memory already (a small body the server has read): always admitted.
  hold(n: int): void {
    if (n <= 0) return
    this.held += n
    this.small += n
  }

  // Gives back what a request of kind cls (of tenant who) held.
  give(n: int, cls: BodyClass, who?: string): void {
    if (n <= 0) return
    this.held = Math.max(0, this.held - n)
    if (cls === "unchecked") this.unchecked = Math.max(0, this.unchecked - n)
    if (cls === "small") this.small = Math.max(0, this.small - n)
    const w = who ?? ""
    if (w !== "") {
      const left = (this.byWho.get(w) ?? 0) - n
      if (left > 0) this.byWho.set(w, left)
      else this.byWho.delete(w)
    }
  }
}

const budget = new BodyBudget()
const peers = new BodyBudget()

// This process's budget.
export function bodyBudget(): BodyBudget {
  return budget
}

// The peer routes' budget (/api/cluster/*, signed with cluster.secret, and the broker's routes): their bodies neither
// wait for the clients' nor turn them away. Its cap is cluster.max_body_mb.
export function peerBudget(): BodyBudget {
  return peers
}

// How a body stream is read and charged: the most bytes (413 past it), the budget's cap and the unchecked share, the
// tenant, its share and the reserve, an unchecked body's fixed deadline (ms, 0 none) and a checked body's pace.
export type ReadPlan = { max: int, cap: int, cls: BodyClass, share: int, who: string, whoShare: int, reserve: int, deadlineMs: int, rate: BodyRate }

// What reading a body came to: stop is "" (read whole), "large" (past max), "busy" (its bytes do not fit), "deadline"
// (an unchecked body past its deadline), "rate" (a checked body behind body_min_kb_per_second) or "ceiling" (past
// body_max_seconds); body holds the bytes read.
export type ReadResult = { stop: string, body: u8[] }

// One read of a body stream, or late (why) when a timer fired first.
type BodyRead = { late: string, done: bool, value: u8[] | undefined }

async function readChunk(st: ReadableStream): Promise<BodyRead> {
  try {
    const r = await st.pull()
    return { late: "", done: r.done, value: r.value }
  } catch (e) {
    // a body cut off reads as what arrived
    return { late: "", done: true, value: undefined }
  }
}

// A body's clock: the bytes it has sent, its timer, why a timer found it late ("" not yet), and how to wake the read
// that waits for its next bytes.
class BodyClock {
  got = 0
  timer = -1
  start = 0.0
  why = ""
  wake: (r: BodyRead) => void = (r) => {}
}

// A timer found the body late: the read waiting for it ends with why.
function lateNow(clock: BodyClock, why: string): void {
  clock.timer = -1
  clock.why = why
  clock.wake({ late: why, done: true, value: undefined })
}

// Arms the next look at a checked body's pace: a body behind the rate or past the ceiling is late.
function armPace(clock: BodyClock, pace: BodyPace, waitMs: f64): void {
  clock.timer = setTimeout(() => {
    const v = pace.check(performance.now() - clock.start, clock.got)
    if (v.late !== "") {
      lateNow(clock, v.late)
      return
    }
    armPace(clock, pace, v.waitMs)
  }, Math.max(1, Math.ceil(waitMs)))
}

// The next read of a timed body, or the timer's verdict when it comes first. Each read races a promise of its own that
// is settled as soon as the race is over: a promise that never settles keeps every value raced against it alive
// (re-audit 6 P0-A: one promise per body, settled only by its timer, kept every chunk of every body over 64 KB, and a
// loop of 200 KB chats took a worker from 20 to 557 MB in 30 s).
async function nextRead(st: ReadableStream, clock: BodyClock): Promise<BodyRead> {
  const tick: Promise<BodyRead> = new Promise<BodyRead>((resolve) => {
    clock.wake = resolve
  })
  const r = await Promise.race([readChunk(st), tick])
  clock.wake({ late: "", done: true, value: undefined })
  clock.wake = (x) => {}
  return r
}

// Reads a body stream whole, charging its bytes to budget b for hold as they arrive (plan); bytes hold has reserved
// already (a declared length) are not charged again. On any stop the stream is cancelled and hold released.
export async function readCharged(st: ReadableStream, b: BodyBudget, hold: BodyHold, plan: ReadPlan): Promise<ReadResult> {
  const clock = new BodyClock()
  clock.start = performance.now()
  const pace = new BodyPace(plan.rate)
  // an unchecked body has a fixed deadline; a checked one a pace and a ceiling
  const unchecked = plan.cls === "unchecked"
  const timed = unchecked ? plan.deadlineMs > 0 : pace.timed()
  if (unchecked) {
    if (plan.deadlineMs > 0) clock.timer = setTimeout(() => lateNow(clock, "deadline"), plan.deadlineMs)
  } else if (timed) {
    armPace(clock, pace, pace.firstWait())
  }
  const body: u8[] = []
  let stop = ""
  while (true) {
    if (clock.why !== "") {
      stop = clock.why
      break
    }
    const r = timed ? await nextRead(st, clock) : await readChunk(st)
    if (r.late !== "") {
      stop = r.late
      break
    }
    const v = r.value
    if (r.done || v === undefined) break
    if (body.length + v.length > plan.max) {
      stop = "large"
      break
    }
    const more = body.length + v.length - hold.held
    if (more > 0) {
      if (!b.take(more, hold.held, plan.cap, plan.cls, plan.share, plan.who, plan.whoShare, plan.reserve)) {
        stop = "busy"
        break
      }
      hold.held += more
    }
    clock.got += v.length
    hold.got = clock.got
    for (const x of v) body.push(x)
  }
  if (clock.timer >= 0) clearTimeout(clock.timer)
  clock.timer = -1
  b.untrack(hold)
  if (stop !== "") {
    try {
      await st.cancel()
    } catch (e) {
      // the stream is gone already
    }
    hold.release()
  }
  return { stop: stop, body: body }
}

test("the cap: bodies are admitted while they fit, a lone body always", () => {
  const b = new BodyBudget()
  const cap = 100
  // a lone body over the cap is admitted (the request limit decides its size)
  expect(b.take(250, 0, cap, "checked", 0)).toBe(true)
  expect(b.take(1, 0, cap, "checked", 0)).toBe(false)
  b.give(250, "checked")
  expect(b.held).toBe(0)
  expect(b.take(60, 0, cap, "checked", 0)).toBe(true)
  expect(b.take(40, 0, cap, "checked", 0)).toBe(true)
  expect(b.take(1, 0, cap, "checked", 0)).toBe(false)
  expect(b.refused).toBe(2)
  b.give(40, "checked")
  expect(b.take(30, 0, cap, "checked", 0)).toBe(true)
  expect(b.held).toBe(90)
  // no cap
  expect(b.take(1000000, 0, 0, "checked", 0)).toBe(true)
  // an empty body costs nothing
  expect(b.take(0, 0, cap, "checked", 0)).toBe(true)
  // give never goes below zero
  b.give(5000000, "checked")
  expect(b.held).toBe(0)
})

test("a chunked body is charged as it arrives: its own bytes do not count against it", () => {
  const b = new BodyBudget()
  const cap = 100
  expect(b.take(80, 0, cap, "checked", 0)).toBe(true)
  // alone, it may grow past the cap
  expect(b.take(80, 80, cap, "checked", 0)).toBe(true)
  expect(b.held).toBe(160)
  // a second request now does not fit, and the first one cannot grow while the second holds bytes
  b.give(160, "checked")
  expect(b.take(30, 0, cap, "checked", 0)).toBe(true)
  expect(b.take(50, 0, cap, "checked", 0)).toBe(true)
  expect(b.take(30, 30, cap, "checked", 0)).toBe(false)
})

test("a declared length is checked against what is held, without being charged", () => {
  const b = new BodyBudget()
  const cap = 100
  // alone: a declared length over the cap fits (it is charged as it arrives)
  expect(b.fits(1000, cap, "checked", 0)).toBe(true)
  expect(b.held).toBe(0)
  // a slow body that has sent little holds little: the next one fits
  expect(b.take(5, 0, cap, "checked", 0)).toBe(true)
  expect(b.fits(90, cap, "checked", 0)).toBe(true)
  expect(b.fits(96, cap, "checked", 0)).toBe(false)
  expect(b.refused).toBe(1)
  expect(b.fits(1000, 0, "checked", 0)).toBe(true)
})

test("a body in memory already is charged and always admitted", () => {
  const b = new BodyBudget()
  const cap = 100
  expect(b.take(150, 0, cap, "checked", 0)).toBe(true)
  b.hold(10)
  expect(b.held).toBe(160)
  expect(b.small).toBe(10)
  b.hold(0)
  expect(b.held).toBe(160)
  b.give(10, "small")
  expect(b.held).toBe(150)
  expect(b.small).toBe(0)
})

test("an unchecked body that holds the cap does not turn checked bodies away (re-audit 3 P1-D)", () => {
  const b = new BodyBudget()
  const cap = 80
  const share = 10
  // a lone unchecked body may pass its share (48 MB sent fast to /mcp, say)
  expect(b.take(80, 0, cap, "unchecked", share)).toBe(true)
  expect(b.unchecked).toBe(80)
  // a checked body sees only the share of it: it fits
  expect(b.fits(60, cap, "checked", share)).toBe(true)
  expect(b.take(60, 0, cap, "checked", share)).toBe(true)
  expect(b.take(10, 60, cap, "checked", share)).toBe(true)
  expect(b.take(1, 70, cap, "checked", share)).toBe(false)
  // and the unchecked body, beside a checked one now, cannot grow past its share: its next byte is refused
  expect(b.take(1, 80, cap, "unchecked", share)).toBe(false)
  // another unchecked body does not fit beside it either
  expect(b.fits(5, cap, "unchecked", share)).toBe(false)
  b.give(80, "unchecked")
  expect(b.unchecked).toBe(0)
  expect(b.held).toBe(70)
  // unchecked bodies beside others share `share`
  expect(b.take(6, 0, cap, "unchecked", share)).toBe(true)
  expect(b.take(4, 0, cap, "unchecked", share)).toBe(true)
  expect(b.take(1, 0, cap, "unchecked", share)).toBe(false)
  // and the cap as a whole
  b.give(70, "checked")
  b.give(10, "unchecked")
  expect(b.held).toBe(0)
  expect(b.take(75, 0, cap, "checked", share)).toBe(true)
  expect(b.take(6, 0, cap, "unchecked", share)).toBe(false)
  expect(b.take(5, 0, cap, "unchecked", share)).toBe(true)
})

test("small bodies do not count as another big body for an unchecked one", () => {
  const b = new BodyBudget()
  b.hold(1000)
  expect(b.take(50, 0, 100, "unchecked", 10)).toBe(true)
  // with no separate share, unchecked bodies count like checked ones
  const c = new BodyBudget()
  expect(c.take(90, 0, 100, "unchecked", 0)).toBe(true)
  expect(c.take(20, 0, 100, "checked", 0)).toBe(false)
  expect(c.take(10, 0, 100, "checked", 0)).toBe(true)
})

test("server.body_deadline_seconds: the default, a value, off", () => {
  expect(bodyDeadlineMs(undefined)).toBe(30000)
  expect(bodyDeadlineMs({})).toBe(30000)
  expect(bodyDeadlineMs({ body_deadline_seconds: 2.5 })).toBe(2500)
  expect(bodyDeadlineMs({ body_deadline_seconds: 0.0 })).toBe(0)
  expect(bodyDeadlineMs({ body_deadline_seconds: -1.0 })).toBe(0)
})

test("server.max_buffered_body_mb: the default, a value, no cap", () => {
  expect(bufferedCap(undefined)).toBe(48 * 1048576)
  expect(bufferedCap({ max_buffered_body_mb: 0 })).toBe(48 * 1048576)
  expect(bufferedCap({ max_buffered_body_mb: 200 })).toBe(200 * 1048576)
  expect(bufferedCap({ max_buffered_body_mb: -1 })).toBe(0)
})

test("server.unchecked_body_mb: an eighth by default, a value within the cap, none", () => {
  const cap = 48 * 1048576
  expect(uncheckedShare(undefined, cap)).toBe(6 * 1048576)
  expect(uncheckedShare({ unchecked_body_mb: 0 }, cap)).toBe(6 * 1048576)
  expect(uncheckedShare({ unchecked_body_mb: 12 }, cap)).toBe(12 * 1048576)
  expect(uncheckedShare({ unchecked_body_mb: 100 }, cap)).toBe(cap)
  expect(uncheckedShare({ unchecked_body_mb: -1 }, cap)).toBe(0)
  expect(uncheckedShare(undefined, 0)).toBe(0)
})

test("server.body_min_kb_per_second: the rate a checked body keeps after the grace", () => {
  const r = bodyRate(undefined)
  expect(r.bytesPerSecond).toBe(32768.0)
  expect(r.graceMs).toBe(10000.0)
  // nothing sent: due when the grace ends; 32 KB sent buys one more second
  expect(rateDue(0, r)).toBe(10000.0)
  expect(rateDue(32768, r)).toBe(11000.0)
  // 100 MB at exactly the rate
  expect(rateDue(100 * 1048576, r)).toBe(10000.0 + 3200000.0)
  const off = bodyRate({ body_min_kb_per_second: 0.0 })
  expect(off.bytesPerSecond).toBe(0.0)
  expect(rateDue(0, off) > 1.0e17).toBe(true)
  const fast = bodyRate({ body_min_kb_per_second: 1.0, body_rate_grace_seconds: 0.0 })
  expect(rateDue(2048, fast)).toBe(2000.0)
})

test("server.body_rate_window_seconds and server.body_max_seconds: defaults, values, off", () => {
  const r = bodyRate(undefined)
  expect(r.windowMs).toBe(30000.0)
  expect(r.maxMs).toBe(600000.0)
  const set = bodyRate({ body_rate_window_seconds: 5.0, body_max_seconds: 60.0 })
  expect(set.windowMs).toBe(5000.0)
  expect(set.maxMs).toBe(60000.0)
  const off = bodyRate({ body_rate_window_seconds: 0.0, body_max_seconds: 0.0 })
  expect(off.windowMs).toBe(0.0)
  expect(off.maxMs).toBe(0.0)
  // a window under a second is a second
  expect(bodyRate({ body_rate_window_seconds: 0.1 }).windowMs).toBe(1000.0)
})

test("BodyPace: early bytes buy one window, not the average (re-audit 4 P1-E)", () => {
  // 32 KB/s after 10 s, over 30 s windows; no ceiling
  const r: BodyRate = { bytesPerSecond: 32768.0, graceMs: 10000.0, windowMs: 30000.0, maxMs: 0.0 }
  const p = new BodyPace(r)
  const big = 48 * 1048576
  // 48 MB at once, then 1 byte every 2 s: the old average rule kept it until about 1,546 s
  let got = big
  let cut = -1.0
  for (let s = 1; s <= 2000; s++) {
    if (s % 2 === 0) got += 1
    const v = p.check(s * 1000.0, got)
    if (v.late !== "") {
      expect(v.late).toBe("rate")
      cut = s * 1.0
      break
    }
  }
  // cut once the first window after the grace is over (40 s), with a look's slack
  expect(cut >= 40.0 && cut <= 41.0).toBe(true)
  expect(rateDue(big, r) > 1500000.0).toBe(true)
})

test("BodyPace: a steady upload at the rate is served whatever its size, and the marks stay bounded", () => {
  const r: BodyRate = { bytesPerSecond: 32768.0, graceMs: 10000.0, windowMs: 30000.0, maxMs: 0.0 }
  const p = new BodyPace(r)
  let got = 0
  for (let s = 1; s <= 3600; s++) {
    got += 40000
    const v = p.check(s * 1000.0, got)
    expect(v.late).toBe("")
    expect(v.waitMs > 0.0 && v.waitMs <= 1000.0).toBe(true)
  }
  expect(p.marks() <= 33).toBe(true)
  // a body that stops for a whole window is cut, whatever it sent before
  let cut = 0
  for (let s = 3601; s <= 3700; s++) {
    if (p.check(s * 1000.0, got).late !== "") {
      cut = s
      break
    }
  }
  expect(cut > 3601 && cut <= 3632).toBe(true)
})

test("BodyPace: the first window keeps the average rule, and nothing sent by the end of the grace is late", () => {
  const r: BodyRate = { bytesPerSecond: 1024.0, graceMs: 2000.0, windowMs: 30000.0, maxMs: 0.0 }
  const p = new BodyPace(r)
  expect(p.firstWait()).toBe(1000.0)
  expect(p.check(1000.0, 0).late).toBe("")
  expect(p.check(2000.0, 0).late).toBe("rate")
  const q = new BodyPace(r)
  // 4 KB sent: the average holds until 2 + 4 = 6 s
  expect(q.check(5000.0, 4096).late).toBe("")
  expect(q.check(5000.0, 4096).waitMs).toBe(1000.0)
  expect(q.check(5500.0, 4096).waitMs).toBe(500.0)
  expect(q.check(6000.0, 4096).late).toBe("rate")
  // window 0: the average from the start, as before (a big early body earns credit)
  const avg = new BodyPace({ bytesPerSecond: 1024.0, graceMs: 2000.0, windowMs: 0.0, maxMs: 0.0 })
  expect(avg.check(100000.0, 1048576).late).toBe("")
  expect(avg.marks()).toBe(1)
})

test("BodyPace: server.body_max_seconds cuts a body that keeps the rate", () => {
  const r: BodyRate = { bytesPerSecond: 1024.0, graceMs: 0.0, windowMs: 1000.0, maxMs: 5000.0 }
  const p = new BodyPace(r)
  let got = 0
  for (let s = 1; s <= 4; s++) {
    got += 100000
    const v = p.check(s * 1000.0, got)
    expect(v.late).toBe("")
  }
  expect(p.check(4500.0, got + 100000).waitMs).toBe(500.0)
  expect(p.check(5000.0, got + 200000).late).toBe("ceiling")
  // only the ceiling: one look when it is due
  const only = new BodyPace({ bytesPerSecond: 0.0, graceMs: 0.0, windowMs: 0.0, maxMs: 5000.0 })
  expect(only.timed()).toBe(true)
  expect(only.check(1.0, 0).waitMs).toBe(4999.0)
  expect(only.check(5000.0, 0).late).toBe("ceiling")
  expect(new BodyPace({ bytesPerSecond: 0.0, graceMs: 0.0, windowMs: 0.0, maxMs: 0.0 }).timed()).toBe(false)
})

test("server.credential_body_mb: a quarter by default, a value within the cap, none", () => {
  const cap = 48 * 1048576
  expect(credentialShare(undefined, cap)).toBe(12 * 1048576)
  expect(credentialShare({ credential_body_mb: 0 }, cap)).toBe(12 * 1048576)
  expect(credentialShare({ credential_body_mb: 20 }, cap)).toBe(20 * 1048576)
  expect(credentialShare({ credential_body_mb: 100 }, cap)).toBe(cap)
  expect(credentialShare({ credential_body_mb: -1 }, cap)).toBe(0)
  expect(credentialShare(undefined, 0)).toBe(0)
})

test("the cap is a hard bound: a tenant's share no longer lets the bodies in hand pass it (re-audit 5 P1-A)", () => {
  const cap = 48
  const ws = 12
  const rs = 12
  // 46 then 24 + 24 from three keys: wave 28 admitted all three (94 in hand); now the two past their share are refused
  const b = new BodyBudget()
  expect(b.take(46, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  expect(b.fits(24, cap, "checked", 0, "vk:b", ws, rs)).toBe(false)
  expect(b.take(24, 0, cap, "checked", 0, "vk:b", ws, rs)).toBe(false)
  expect(b.take(24, 0, cap, "checked", 0, "vk:c", ws, rs)).toBe(false)
  expect(b.held).toBe(46)
  // a body within its share still fits beside the lone one, up to the reserve past it
  expect(b.take(12, 0, cap, "checked", 0, "vk:c", ws, rs)).toBe(true)
  expect(b.take(1, 0, cap, "checked", 0, "vk:d", ws, rs)).toBe(false)
  expect(b.held).toBe(58)
  // with no reserve the cap alone decides
  const n = new BodyBudget()
  expect(n.take(40, 0, cap, "checked", 0, "vk:a", ws, 0)).toBe(true)
  expect(n.take(8, 0, cap, "checked", 0, "vk:b", ws, 0)).toBe(true)
  expect(n.take(1, 0, cap, "checked", 0, "vk:c", ws, 0)).toBe(false)
  // 3 x 24 from three keys: the first two fill the cap (a tenant's first body may, re-audit 6 P1-B), the third is
  // refused
  const t = new BodyBudget()
  expect(t.take(24, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  expect(t.take(24, 0, cap, "checked", 0, "vk:b", ws, rs)).toBe(true)
  expect(t.take(24, 0, cap, "checked", 0, "vk:c", ws, rs)).toBe(false)
  expect(t.take(1, 0, cap, "checked", 0, "vk:d", ws, rs)).toBe(false)
  expect(t.held).toBe(cap)
})

test("a tenant past its share leaves the reserve to the tenants within theirs (re-audit 5 P1-B)", () => {
  const b = new BodyBudget()
  const cap = 48
  const ws = 12
  const rs = 12
  // several keys of one customer count as one tenant: past its share, beside another tenant's body, it fills only
  // cap - reserve
  expect(b.take(2, 0, cap, "checked", 0, "vk:o", ws, rs)).toBe(true)
  expect(b.take(12, 0, cap, "checked", 0, "customer:x", ws, rs)).toBe(true)
  expect(b.take(12, 0, cap, "checked", 0, "customer:x", ws, rs)).toBe(true)
  expect(b.take(10, 0, cap, "checked", 0, "customer:x", ws, rs)).toBe(true)
  expect(b.take(1, 0, cap, "checked", 0, "customer:x", ws, rs)).toBe(false)
  expect(b.take(1, 12, cap, "checked", 0, "customer:x", ws, rs)).toBe(false)
  expect(b.heldBy("customer:x")).toBe(34)
  // idle tenants' bodies are admitted while it holds the rest
  expect(b.fits(2, cap, "checked", 0, "vk:o", ws, rs)).toBe(true)
  expect(b.take(2, 0, cap, "checked", 0, "vk:o", ws, rs)).toBe(true)
  expect(b.take(10, 0, cap, "checked", 0, "vk:p", ws, rs)).toBe(true)
  // the cap still bounds them
  expect(b.take(1, 0, cap, "checked", 0, "vk:q", ws, rs)).toBe(false)
  expect(b.held).toBe(cap)
  // a second body that keeps the tenant within its share may use the reserve too; one past it may not
  b.give(10, "checked", "vk:p")
  expect(b.take(9, 0, cap, "checked", 0, "vk:o", ws, rs)).toBe(false)
  expect(b.take(8, 0, cap, "checked", 0, "vk:o", ws, rs)).toBe(true)
  expect(b.held).toBe(46)
  // counted per key (as before), four keys of one customer each stayed within a share, took the whole cap and turned
  // the idle tenant away
  const old = new BodyBudget()
  for (const k of ["vk:1", "vk:2", "vk:3", "vk:4"]) expect(old.take(12, 0, cap, "checked", 0, k, ws, 0)).toBe(true)
  expect(old.fits(1, cap, "checked", 0, "vk:o", ws, 0)).toBe(false)
})

test("under contention the tenant past its share is the one refused, and a lone body leaves the reserve open", () => {
  const b = new BodyBudget()
  const cap = 48
  const ws = 12
  const rs = 12
  // a lone chunked body grows past the cap (the request limit bounds it)
  expect(b.take(46, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  expect(b.take(2, 46, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  // another tenant's first body fits within the reserve past it
  expect(b.take(4, 0, cap, "checked", 0, "vk:b", ws, rs)).toBe(true)
  // and the tenant past its share is refused its next bytes
  expect(b.take(1, 48, cap, "checked", 0, "vk:a", ws, rs)).toBe(false)
  b.give(48, "checked", "vk:a")
  expect(b.held).toBe(4)
  // a single tenant on its own may fill the cap with its bodies while no other tenant waits (re-audit 6 P1-B; L208 kept
  // it to cap - reserve)
  const s = new BodyBudget()
  expect(s.take(20, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  expect(s.take(20, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  expect(s.take(9, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(false)
})

test("chunked bodies grow only into cap - reserve, whatever their tenants' shares", () => {
  const b = new BodyBudget()
  const cap = 48
  const ws = 12
  const rs = 12
  // four keys with no customer, each within its share, trickling chunked bodies
  expect(b.take(11, 0, cap, "checked", 0, "vk:1", ws, rs)).toBe(true)
  expect(b.take(1, 0, cap, "checked", 0, "vk:2", ws, rs)).toBe(true)
  expect(b.take(10, 1, cap, "checked", 0, "vk:2", ws, rs)).toBe(true)
  expect(b.take(1, 0, cap, "checked", 0, "vk:3", ws, rs)).toBe(true)
  expect(b.take(13, 1, cap, "checked", 0, "vk:3", ws, rs)).toBe(true)
  expect(b.held).toBe(36)
  // a new body's first bytes may use the reserve, its growth may not
  expect(b.take(1, 0, cap, "checked", 0, "vk:4", ws, rs)).toBe(true)
  expect(b.take(1, 1, cap, "checked", 0, "vk:4", ws, rs)).toBe(false)
  expect(b.take(1, 11, cap, "checked", 0, "vk:1", ws, rs)).toBe(false)
  // so an idle tenant's declared body is admitted
  expect(b.take(4, 0, cap, "checked", 0, "vk:o", ws, rs)).toBe(true)
  expect(b.held).toBe(41)
})

test("declared lengths reserved at admission: of 8 x 12 the ones admitted fit together (re-audit 5 P2-A)", () => {
  const b = new BodyBudget()
  const cap = 48
  let admitted = 0
  for (const k of ["1", "2", "3", "4", "5", "6", "7", "8"]) {
    if (b.take(12, 0, cap, "checked", 0, "vk:" + k, 12, 12)) admitted += 1
  }
  expect(admitted).toBe(4)
  expect(b.held).toBe(48)
  expect(b.refused).toBe(4)
})

test("a single credential with several bodies keeps the whole cap when there is no reserve", () => {
  const b = new BodyBudget()
  const cap = 48
  const ws = 12
  expect(b.take(20, 0, cap, "checked", 0, "a", ws)).toBe(true)
  expect(b.take(20, 0, cap, "checked", 0, "a", ws)).toBe(true)
  expect(b.take(8, 20, cap, "checked", 0, "a", ws)).toBe(true)
  expect(b.take(1, 0, cap, "checked", 0, "a", ws)).toBe(false)
})

test("server.body_reserve_mb: a quarter by default, a value within the cap, none", () => {
  const cap = 48 * 1048576
  expect(bodyReserve(undefined, cap)).toBe(12 * 1048576)
  expect(bodyReserve({ body_reserve_mb: 0 }, cap)).toBe(12 * 1048576)
  expect(bodyReserve({ body_reserve_mb: 4 }, cap)).toBe(4 * 1048576)
  expect(bodyReserve({ body_reserve_mb: 100 }, cap)).toBe(cap)
  expect(bodyReserve({ body_reserve_mb: -1 }, cap)).toBe(0)
  expect(bodyReserve(undefined, 0)).toBe(0)
})

test("an unchecked body beside checked ones keeps within its share and the cap", () => {
  const u = new BodyBudget()
  const cap = 48
  expect(u.take(42, 0, cap, "checked", 6, "a", 12, 12)).toBe(true)
  expect(u.take(6, 0, cap, "unchecked", 6, "", 12, 12)).toBe(true)
  expect(u.take(1, 0, cap, "unchecked", 6, "", 12, 12)).toBe(false)
  expect(u.held).toBe(cap)
})

test("small bodies in flight do not count against the lone-body rule (re-audit 6 P1-B)", () => {
  const b = new BodyBudget()
  const cap = 48
  // a 100-byte chat in flight (read by the server already)
  b.hold(1)
  // 40 and 46 beside it: alone among the big bodies (both were 503 while any small request was in flight)
  expect(b.take(40, 0, cap, "checked", 0, "vk:a", 12, 12)).toBe(true)
  b.give(40, "checked", "vk:a")
  expect(b.take(46, 0, cap, "checked", 0, "vk:a", 12, 12)).toBe(true)
  // and a lone chunked body grows past the cap beside small ones
  expect(b.take(10, 46, cap, "checked", 0, "vk:a", 12, 12)).toBe(true)
  expect(b.held).toBe(57)
})

test("the reserve applies only to a tenant that holds bytes: a first body may fill the cap (re-audit 6 P1-B)", () => {
  const cap = 48
  const ws = 12
  const rs = 12
  const b = new BodyBudget()
  expect(b.take(4, 0, cap, "checked", 0, "vk:o", ws, rs)).toBe(true)
  // another tenant's first body, past its share, may use the reserve (L208 kept it to cap - reserve)
  expect(b.take(40, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  // its next body, beside another tenant's, may not
  expect(b.take(4, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(false)
  expect(b.held).toBe(44)
  // one key's 30 + 12 on their own are both served (the 12 was 503)
  const one = new BodyBudget()
  expect(one.take(30, 0, cap, "checked", 0, "vk:k", ws, rs)).toBe(true)
  expect(one.take(12, 0, cap, "checked", 0, "vk:k", ws, rs)).toBe(true)
  expect(one.held).toBe(42)
  // a chunked body growing still leaves the reserve free
  const g = new BodyBudget()
  expect(g.take(30, 0, cap, "checked", 0, "vk:k", ws, rs)).toBe(true)
  expect(g.take(1, 0, cap, "checked", 0, "vk:k", ws, rs)).toBe(true)
  expect(g.take(6, 1, cap, "checked", 0, "vk:k", ws, rs)).toBe(false)
  expect(g.take(5, 1, cap, "checked", 0, "vk:k", ws, rs)).toBe(true)
})

test("a tenant refused a body keeps the reserve from a tenant that holds every big body", () => {
  const cap = 48
  const ws = 12
  const rs = 12
  const b = new BodyBudget()
  b.clock = 1000.0
  expect(b.take(30, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  // b's first body does not fit: b waits
  expect(b.take(20, 0, cap, "checked", 0, "vk:b", ws, rs)).toBe(false)
  // so a's next body keeps within cap - reserve
  expect(b.take(12, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(false)
  expect(b.take(6, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  // a tenant's own refusal does not count against it
  expect(b.take(13, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(false)
  // once b has stopped waiting, a may fill the cap again
  b.clock = 1000.0 + WAITING_MS + 1.0
  expect(b.take(12, 0, cap, "checked", 0, "vk:a", ws, rs)).toBe(true)
  expect(b.held).toBe(48)
})

// A declared body admitted to b at the budget's clock: charged whole and tracked, as heldBody does (shares of a quarter).
function declared(b: BodyBudget, n: int, cap: int, who: string): BodyHold {
  const h = new BodyHold()
  const q = Math.max(1, Math.floor(cap / 4))
  if (!b.take(n, 0, cap, "checked", 0, who, q, q)) return h
  h.held = n
  h.cls = "checked"
  h.who = who
  b.track(h, n)
  return h
}

test("reservations that fell behind their pace are cut for other tenants' bodies (re-audit 6 P1-A)", () => {
  const M = 1048576
  const cap = 48 * M
  const b = new BodyBudget()
  b.clock = 0.0
  // four tenants declare 12 MB each and send nothing: the whole cap is reserved
  const hs: BodyHold[] = []
  for (const k of ["vk:1", "vk:2", "vk:3", "vk:4"]) hs.push(declared(b, 12 * M, cap, k))
  expect(b.held).toBe(cap)
  expect(b.reservations()).toBe(4)
  // an outsider's 4 MB body a tenth of a second later: the reservations are young, nothing is cut, it is refused
  // (L213: half a second was within the grace; an empty reservation's grace is now RESERVE_EMPTY_GRACE_MS)
  b.clock = 100.0
  expect(b.take(4 * M, 0, cap, "checked", 0, "vk:o", 12 * M, 12 * M)).toBe(false)
  expect(b.cuts).toBe(0)
  // two seconds in, with nothing sent: one reservation is cut to its look-ahead and the outsider is served
  b.clock = 2000.0
  expect(b.take(4 * M, 0, cap, "checked", 0, "vk:o", 12 * M, 12 * M)).toBe(true)
  expect(b.cuts).toBe(1)
  expect(b.reservations()).toBe(3)
  expect(b.held).toBe(36 * M + reserveLookahead(cap) + 4 * M)
  // its next 1 MB body fits beside them without another cut
  expect(b.take(1 * M, 0, cap, "checked", 0, "vk:o", 12 * M, 12 * M)).toBe(true)
  expect(b.cuts).toBe(1)
  // the cut body keeps its look-ahead and is charged as its bytes arrive from now on
  let held = 0
  for (const h of hs) if (h.id === 0) held = h.held
  expect(held).toBe(RESERVE_LOOKAHEAD)
  expect(reserveLookahead(4 * M)).toBe(87381)
  expect(reserveLookahead(M)).toBe(UNREAD_ABOVE)
  // a tenant's own body never cuts its reservations
  const own = new BodyBudget()
  own.clock = 0.0
  const mine = declared(own, 40 * M, cap, "vk:a")
  own.clock = 5000.0
  expect(mine.held).toBe(40 * M)
  expect(own.take(12 * M, 0, cap, "checked", 0, "vk:a", 12 * M, 12 * M)).toBe(false)
  expect(own.cuts).toBe(0)
})

test("a body on pace keeps its reservation; the one furthest behind is cut first", () => {
  const M = 1048576
  const cap = 24 * M
  const b = new BodyBudget()
  b.clock = 0.0
  const fast = declared(b, 12 * M, cap, "vk:f")
  const slow = declared(b, 12 * M, cap, "vk:s")
  expect(b.held).toBe(cap)
  // two seconds in: fast has sent half (the rest in 2 s), slow 100 KB (the rest in about 4 minutes)
  b.clock = 2000.0
  fast.got = 6 * M
  slow.got = 100000
  expect(b.take(4 * M, 0, cap, "checked", 0, "vk:o", 6 * M, 6 * M)).toBe(true)
  expect(slow.held).toBe(100000 + reserveLookahead(cap))
  expect(fast.held).toBe(12 * M)
  expect(fast.id > 0).toBe(true)
  expect(slow.id).toBe(0)
  // with only bodies on pace left, a body that does not fit is refused (they complete: re-audit 5 P2-A)
  expect(b.take(8 * M, 0, cap, "checked", 0, "vk:p", 6 * M, 6 * M)).toBe(false)
  expect(b.cuts).toBe(1)
  expect(fast.held).toBe(12 * M)
  // a reservation that has all its bytes is not behind
  fast.got = 12 * M
  b.clock = 60000.0
  expect(b.take(8 * M, 0, cap, "checked", 0, "vk:p", 6 * M, 6 * M)).toBe(false)
  expect(b.cuts).toBe(1)
  // an unchecked body never cuts checked reservations
  const u = new BodyBudget()
  u.clock = 0.0
  declared(u, 20 * M, cap, "vk:s")
  u.clock = 5000.0
  expect(u.take(5 * M, 0, cap, "unchecked", 3 * M)).toBe(false)
  expect(u.cuts).toBe(0)
})

// Lets go of a test budget's reservation (BodyHold.release works on the process's budget).
function letGo(b: BodyBudget, h: BodyHold): void {
  b.untrack(h)
  b.give(h.held, h.cls, h.who)
  h.held = 0
}

test("an empty reservation is cut after its short grace, and a reconnecting tenant's grace counts once (L213)", () => {
  const M = 1048576
  const cap = 4 * M
  const b = new BodyBudget()
  b.clock = 0.0
  // four tenants declare 1 MB each and send nothing
  const hs: BodyHold[] = []
  for (const k of ["vk:1", "vk:2", "vk:3", "vk:4"]) hs.push(declared(b, M, cap, k))
  expect(b.held).toBe(cap)
  // within the empty grace nothing is cut
  b.clock = RESERVE_EMPTY_GRACE_MS - 1.0
  expect(b.take(M, 0, cap, "checked", 0, "vk:o", M, M)).toBe(false)
  // past it (well within the second-long grace) they are cut (two: each keeps its look-ahead) and the outsider served
  b.clock = RESERVE_EMPTY_GRACE_MS + 1.0
  expect(b.take(M, 0, cap, "checked", 0, "vk:o", M, M)).toBe(true)
  expect(b.cuts).toBe(2)
  // a body that has started sending keeps the full grace
  const g = new BodyBudget()
  g.clock = 0.0
  const sending = declared(g, 3 * M, cap, "vk:s")
  sending.got = 1000
  g.clock = 500.0
  expect(g.take(2 * M, 0, cap, "checked", 0, "vk:o", M, M)).toBe(false)
  g.clock = RESERVE_GRACE_MS + 1.0
  expect(g.take(2 * M, 0, cap, "checked", 0, "vk:o", M, M)).toBe(true)
  // a tenant that reconnects at once (its request ended, a new one sent): the new reservation's grace counts from the
  // first of the run, so it is cut as soon as it is needed, however young
  const r = new BodyBudget()
  r.clock = 0.0
  const first = declared(r, 3 * M, cap, "vk:r")
  first.got = 1000
  r.clock = 900.0
  letGo(r, first)
  const again = declared(r, 3 * M, cap, "vk:r")
  again.got = 1000
  r.clock = RESERVE_GRACE_MS + 50.0
  expect(r.take(2 * M, 0, cap, "checked", 0, "vk:o", M, M)).toBe(true)
  expect(again.id).toBe(0)
  // after a quiet second its next reservation has a grace of its own again
  const q = new BodyBudget()
  q.clock = 0.0
  const one = declared(q, 3 * M, cap, "vk:q")
  q.clock = 500.0
  letGo(q, one)
  q.clock = 500.0 + RESERVE_GRACE_MS
  const two = declared(q, 3 * M, cap, "vk:q")
  two.got = 1000
  q.clock = 500.0 + RESERVE_GRACE_MS + 500.0
  expect(q.take(2 * M, 0, cap, "checked", 0, "vk:o", M, M)).toBe(false)
  expect(two.id > 0).toBe(true)
})

test("a reservation is let go when its request is done", () => {
  const b = bodyBudget()
  const before = b.reservations()
  const h = new BodyHold()
  expect(b.take(100, 0, 1000, "checked", 0)).toBe(true)
  h.held = 100
  h.cls = "checked"
  b.track(h, 100)
  expect(b.reservations()).toBe(before + 1)
  h.release()
  expect(b.reservations()).toBe(before)
  expect(h.held).toBe(0)
})
