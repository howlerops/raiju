// HTTP routes: the OpenAI-shaped /v1 API, drop-in SDK routes, models,
// metrics, health and a read-only management API.
import { Config, providerOf, providerNames } from "./config"
import { Engine, StreamSink, errorResponse, noHeaders } from "./gateway"
import { anthropicMessages, genai, bedrockModel, responsesApi } from "./native"
import { kindOf } from "./router"
import { Target, Upstream } from "./providers/types"
import * as openai from "./providers/openai"
import * as anthropic from "./providers/anthropic"
import * as gemini from "./providers/gemini"
import { fields, find, elements, rawStr, rawBool } from "./json"
import * as metrics from "./metrics"
import { Session, prepare, onOpen, onMessage, onClose } from "./realtime"
import { parseQuery } from "./logstore"
import { matchRoute, handleMedia } from "./media"
import { snapshot } from "./schemas"
import { handleApi } from "./store"
import { Ops, Reply } from "./ops"
import { rerank, countTokens, asyncSubmit, asyncGet, Dispatch } from "./extras"
import { asyncPoll } from "./jobs"
import { INDEX_HTML } from "./ui_assets"

type ModelEntry = { id: string, object: string, created: int, owned_by: string }

class ModelCache {
  ids: Map<string, string[]> = new Map()
  fetchedAt: Map<string, f64> = new Map()
}

const modelCache = new ModelCache()

function upstreamModels(provider: string, kind: string, t: Target): Upstream | undefined {
  if (openai.isOpenAICompatible(kind)) return openai.modelsRequest(t)
  if (kind === "anthropic") {
    const base = t.cfg.network_config?.base_url ?? "https://api.anthropic.com"
    return { url: base + "/v1/models?limit=1000", headers: anthropic.upstreamHeaders(t), body: "" }
  }
  if (kind === "gemini") {
    const base = t.cfg.network_config?.base_url ?? "https://generativelanguage.googleapis.com"
    return { url: base + "/v1beta/models?pageSize=1000", headers: gemini.upstreamHeaders(t), body: "" }
  }
  return undefined
}

async function providerModels(cfg: Config, provider: string): Promise<string[]> {
  const p = providerOf(cfg, provider)
  if (p === undefined) return []
  const listed: string[] = []
  for (const k of p.keys ?? []) {
    for (const m of k.models ?? []) {
      if (m !== "*" && !listed.includes(provider + "/" + m)) listed.push(provider + "/" + m)
    }
  }
  if (listed.length > 0) return listed
  const cachedAt = modelCache.fetchedAt.get(provider) ?? 0.0
  if (Date.now() - cachedAt < 300000.0) return modelCache.ids.get(provider) ?? []
  const kind = kindOf(provider, p)
  const key = (p.keys ?? [])[0] ?? { value: "" }
  const up = upstreamModels(provider, kind, { provider: provider, kind: kind, model: "", key: key, cfg: p })
  if (up === undefined) return []
  let ids: string[] = []
  try {
    const hs = new Headers()
    for (const k of up.headers.keys()) hs.set(k, up.headers.get(k)!)
    const res = await fetch(up.url, { headers: hs, signal: AbortSignal.timeout(5000) })
    const text = await res.text()
    if (res.ok) ids = openai.modelIds(text, provider).map((id) => id.replace(provider + "/models/", provider + "/"))
  } catch (e) {
    ids = []
  }
  modelCache.ids.set(provider, ids)
  modelCache.fetchedAt.set(provider, Date.now())
  return ids
}

// GET /v1/models/{model}: the entry from the provider's list, or for a configured provider a
// minimal entry (some providers list only part of what they serve).
async function retrieveModel(engine: Engine, req: Request, id: string): Promise<Response> {
  const slash = id.indexOf("/")
  if (slash <= 0) return errorResponse(404, `model ${id} not found: use provider/model`, "invalid_request_error", noHeaders())
  const provider = id.slice(0, slash)
  if (!providerNames(engine.cfg).includes(provider)) return errorResponse(404, `no provider ${provider}`, "invalid_request_error", noHeaders())
  const known = await providerModels(engine.cfg, provider)
  const listed = known.includes(id) || known.includes(id.slice(slash + 1))
  return Response.json({ id: id, object: "model", created: 0, owned_by: provider, listed: listed })
}

async function listModels(engine: Engine, req: Request): Promise<Response> {
  const only = req.headers.get("x-bf-list-models-provider") ?? req.headers.get("x-bf-model-provider") ?? "all"
  const names = providerNames(engine.cfg).filter((n) => only === "all" || n === only)
  const lists = await Promise.all(names.map((n) => providerModels(engine.cfg, n)))
  const data: ModelEntry[] = []
  for (let i = 0; i < names.length; i++) {
    for (const id of lists[i]!) data.push({ id: id, object: "model", created: 0, owned_by: names[i]! })
  }
  return Response.json({ object: "list", data: data })
}


// Bifrost's http_* metrics for one request. A streamed body counts as 0 bytes.
async function timed(path: string, method: string, t0: f64, reqBytes: f64, p: Promise<Response, TypeError>): Promise<Response, TypeError> {
  const res = try await p
  const len = parseFloat(res.headers.get("content-length") ?? "0") ?? 0.0
  metrics.observeHttp(pathLabel(path), method, res.status, (performance.now() - t0) / 1000.0, reqBytes, len)
  return res
}

// A bounded path label: ids (segments with digits, or past the fourth) become {id}.
export function pathLabel(path: string): string {
  const segs = path.split("/")
  const out: string[] = []
  for (let i = 0; i < segs.length; i++) {
    const s = segs[i]!
    let id = i > 4
    for (const ch of s.chars()) {
      if (ch >= "0" && ch <= "9") id = true
    }
    // version segments such as v1 and v1beta stay
    if (i <= 2 && s.startsWith("v") && s.byteLength <= 7) id = false
    out.push(id && s !== "" ? "{id}" : s)
  }
  return out.join("/")
}

test("path labels hide ids", () => {
  expect(pathLabel("/v1/chat/completions")).toBe("/v1/chat/completions")
  expect(pathLabel("/api/governance/virtual-keys/vk-1")).toBe("/api/governance/virtual-keys/{id}")
  expect(pathLabel("/genai/v1beta/models/gemini-2.5-flash:generateContent")).toBe("/genai/v1beta/models/{id}")
  expect(pathLabel("/bedrock/model/a/b/c/converse")).toBe("/bedrock/model/a/b/{id}/{id}")
})

// Runs an internal request (an async job) through the same handlers as live traffic.
function dispatcher(engine: Engine): Dispatch {
  return async (req) => {
    const u = URL.parse(req.url)
    const p = u === undefined ? "" : u.pathname
    if (p === "/v1/chat/completions") return await engine.chat(req)
    if (p === "/v1/completions") return await engine.completions(req)
    if (p === "/v1/embeddings") return await engine.embeddings(req)
    if (p === "/v1/responses") return await responsesApi(engine, req)
    if (p === "/anthropic/v1/messages") return await anthropicMessages(engine, req)
    if (p === "/v1/rerank") return try await rerank(engine, req)
    const media = matchRoute("POST", p)
    if (media !== undefined) return try await handleMedia(engine.cfg, req, media)
    return errorResponse(404, `no route for ${p}`, "invalid_request_error", noHeaders())
  }
}

// The management API, behind RBAC; every change lands in the audit log.
async function manage(ops: Ops, req: Request, path: string): Promise<Response> {
  const gate = ops.gate(req, path)
  if (gate.kind === "deny") return gate.res
  const body = req.method === "GET" || req.method === "DELETE" ? "" : await req.text()
  let r: Reply = { status: 404, body: "", contentType: "application/json" }
  if (path === "/api/users" || path.startsWith("/api/users/")) r = ops.users(req.method, path, body)
  else if (path === "/api/audit-logs" || path.startsWith("/api/audit-logs/")) r = ops.auditRoute(req, path)
  else if (path === "/api/mcp/virtual") r = ops.virtualView()
  else if (path === "/api/governance/access-profiles" || path.startsWith("/api/governance/access-profiles/")) r = ops.profiles(req.method, path, body)
  else if (path === "/api/alerts") r = req.method === "GET" ? ops.alertsView() : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  else {
    const a = handleApi(ops.store, req.method, path, body)
    r = { status: a.status, body: a.body, contentType: "application/json" }
  }
  ops.recordChange(gate.actor, req, path, r.status, body)
  const h: Record<string, string> = new Map()
  h.set("content-type", r.contentType)
  return new Response(r.body, { status: r.status, headers: h })
}

function mcpView(engine: Engine): Response {
  const m = engine.mcp
  if (m === undefined) return new Response(`{"clients":[]}`, { headers: { "content-type": "application/json" } })
  return Response.json({ clients: m.status() })
}

function logsView(engine: Engine, req: Request, stats: bool): Response {
  const store = engine.logStore
  if (store === undefined) return errorResponse(404, "request logs are off; enable logs_store in the config", "invalid_request_error", noHeaders())
  const u = URL.parse(req.url)
  const params = u === undefined ? new URLSearchParams("") : u.searchParams
  if (stats) {
    const since = parseFloat(params.get("since") ?? "0") ?? 0.0
    return Response.json(store.stats(since))
  }
  return Response.json(store.query(parseQuery(params)))
}

function cacheView(engine: Engine): Response {
  const c = engine.cache
  if (c === undefined) return Response.json({ enabled: false, entries: 0, hits: 0, misses: 0 })
  return Response.json({ enabled: true, entries: c.entries.size, hits: c.hits, misses: c.misses })
}

// What browsers may read cross-origin: the gateway's own headers (Bifrost's list).
const EXPOSED = "x-bifrost-request-id, x-bifrost-trace-id, x-request-id, x-bifrost-provider, x-bifrost-original-model, x-bifrost-resolved-model, x-bifrost-fallback-index, x-bifrost-request-type, x-bifrost-upstream-latency-ms, x-bifrost-routing-info-provider, x-bifrost-routing-info-model, x-bifrost-routing-info-is-fallback, x-bifrost-routing-info-primary-provider, x-bifrost-routing-info-primary-model, x-bifrost-routing-info-requested-provider, x-bifrost-routing-info-requested-model, x-bifrost-cache-hit, x-bifrost-cache-hit-type, x-bifrost-cache-requested-provider, x-bifrost-cache-requested-model, x-bifrost-cache-similarity, x-bifrost-cache-threshold, x-bifrost-latency-ms, x-bifrost-error-type, x-bf-cache, x-bf-attempts, x-bf-fallback-used, x-bf-overhead-us"

// Adds the CORS headers for an allowed origin. Response headers are a copy in Tov, so the
// response is rebuilt: a streamed body stays a stream, any other body is carried as bytes.
async function cors(cfg: Config, req: Request, res: Response): Promise<Response> {
  const origins = cfg.client?.allowed_origins ?? []
  const origin = req.headers.get("origin")
  if (origin === undefined || origins.length === 0) return res
  if (!origins.includes("*") && !origins.includes(origin)) return res
  const h: Record<string, string> = new Map()
  res.headers.forEach((v, k) => {
    if (k !== "content-length") h.set(k, v)
  })
  h.set("access-control-allow-origin", origin)
  h.set("access-control-expose-headers", EXPOSED)
  h.set("vary", "origin")
  const st = res.body
  if (st !== undefined && st.pushed) return new Response(st, { status: res.status, headers: h })
  let bytes: u8[] = []
  try {
    bytes = await res.bytes()
  } catch (e) {
    bytes = []
  }
  return new Response(res.status === 204 ? undefined : bytes, { status: res.status, headers: h })
}

export type ServeOptions = { port: int, hostname: string, workers: int }

function textResponse(body: string, contentType: string): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", contentType)
  return new Response(body, { headers: h })
}

const CHAT_PATHS = ["/v1/chat/completions", "/openai/v1/chat/completions", "/openai/chat/completions"]

// LiteLLM and LangChain clients pointed at the gateway: /litellm/... and /langchain/...
// are the same routes without the prefix.
export function compatPath(p: string): string {
  if (p.startsWith("/litellm/")) return compatPath(p.slice(8))
  if (p.startsWith("/langchain/")) return compatPath(p.slice(10))
  if (p.startsWith("/pydanticai/")) return compatPath(p.slice(11))
  // the OpenAI SDK pointed at /openai: every /v1 route under /openai/v1
  if (p.startsWith("/openai/v1/") && p !== "/openai/v1/realtime") return p.slice(7)
  return p
}

async function unprefixed(req: Request, p: string): Promise<Request> {
  const q = req.url.indexOf("?")
  const u = URL.parse(req.url)
  const origin = u === undefined ? "http://localhost" : u.origin
  const url = origin + p + (q < 0 ? "" : req.url.slice(q))
  const hs: Record<string, string> = snapshot(req.headers)
  if (req.method === "GET" || req.method === "HEAD") return new Request(url, { method: req.method, headers: hs })
  // bytes, so multipart uploads (audio files, images) pass intact
  let body: u8[] = []
  try {
    body = await req.bytes()
  } catch (e) {
    body = []
  }
  return new Request(url, { method: req.method, headers: hs, body: body })
}

// Every HTTP route except the WebSocket upgrade, in one function so both
// servers (http1 for streaming, Bun.serve as the fallback) share it.
export async function dispatch(engine: Engine, ops: Ops, req: Request): Promise<Response> throws TypeError {
  const u = URL.parse(req.url)
  const p = u === undefined ? "" : u.pathname
  const m = req.method
  const cp = compatPath(p)
  if (cp !== p) return try await dispatch(engine, ops, await unprefixed(req, cp))
  const segs = p.split("/")
  if (p === "/mcp") return await ops.mcp(req, undefined)
  if (p.startsWith("/mcp/") && segs.length === 3) return await ops.mcp(req, segs[2]!)
  if (m === "GET" || m === "HEAD") {
    if (p === "/health") return Response.json({ status: "ok" })
    if (p === "/") return textResponse(INDEX_HTML, "text/html; charset=utf-8")
    if (p === "/metrics") return textResponse(ops.metricsText(), "text/plain; version=0.0.4")
    if (p === "/v1/models" || p === "/openai/v1/models") return await cors(engine.cfg, req, await listModels(engine, req))
    if (p.startsWith("/v1/models/")) return await cors(engine.cfg, req, await retrieveModel(engine, req, p.slice(11)))
    const poll = asyncPoll(p)
    if (poll !== undefined) return asyncGet(engine.jobs, poll.op, poll.id)
    if (p === "/api/cache") return ops.check(req, p) ?? cacheView(engine)
    if (p === "/api/logs") return ops.check(req, p) ?? logsView(engine, req, false)
    if (p === "/api/logs/stats") return ops.check(req, p) ?? logsView(engine, req, true)
    if (p === "/api/governance/usage") return ops.check(req, p) ?? Response.json({ budgets: engine.gov.budgetUsage() })
    if (p === "/api/mcp") return ops.check(req, p) ?? mcpView(engine)
    if (p === "/api/health") return ops.check(req, p) ?? Response.json({ targets: engine.health.snapshot(Date.now()) })
  }
  if (m === "POST") {
    if (CHAT_PATHS.includes(p) || (p.startsWith("/openai/deployments/") && p.endsWith("/chat/completions"))) return await cors(engine.cfg, req, await engine.chat(req))
    if (p === "/v1/embeddings" || p === "/openai/v1/embeddings") return await cors(engine.cfg, req, await engine.embeddings(req))
    if (p === "/v1/completions" || p === "/openai/v1/completions") return await cors(engine.cfg, req, await engine.completions(req))
    if (p === "/v1/responses" || p === "/openai/v1/responses") return await cors(engine.cfg, req, await responsesApi(engine, req))
    if (p === "/v1/rerank") return await cors(engine.cfg, req, await rerank(engine, req))
    if (p === "/v1/count_tokens") return await cors(engine.cfg, req, await countTokens(engine, req, false))
    if (p === "/anthropic/v1/messages/count_tokens") return await cors(engine.cfg, req, await countTokens(engine, req, true))
    if (p === "/anthropic/v1/messages") return await cors(engine.cfg, req, await anthropicMessages(engine, req))
    if (p === "/v1/mcp/tool/execute") return await cors(engine.cfg, req, await engine.executeTool(req))
    if (p.startsWith("/genai/v1beta/models/") && segs.length === 5) return await cors(engine.cfg, req, await genai(engine, req, segs[4]!))
    if (p.startsWith("/bedrock/model/") && segs.length === 5) return await cors(engine.cfg, req, await bedrockModel(engine, req, segs[3]!, segs[4]!))
    if (p.startsWith("/v1/async/")) return await asyncSubmit(engine.jobs, req, p, dispatcher(engine))
  }
  // the management API: providers, keys, virtual keys, budgets, rate limits, teams, customers
  if (p === "/api/cluster/sync" && m === "POST") return await ops.clusterSync(req)
  if (p.startsWith("/api/oidc/") && m === "GET") return await ops.oidcRoute(req, p)
  if (p.startsWith("/api/")) return await manage(ops, req, p)
  // audio, images, files and batches: passed through to OpenAI-compatible providers
  const media = matchRoute(m, p)
  if (media !== undefined) {
    if (engine.gov.enforce && engine.gov.findKey(snapshot(req.headers)) === undefined) {
      return errorResponse(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", noHeaders())
    }
    return try await handleMedia(engine.cfg, req, media)
  }
  if (m === "OPTIONS") {
    const res = new Response(undefined, { status: 204, headers: { "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS", "access-control-allow-headers": "*", "access-control-max-age": "86400" } })
    return await cors(engine.cfg, req, res)
  }
  return errorResponse(404, `no route for ${m} ${p}`, "invalid_request_error", noHeaders())
}

// Holds what a streamed chat answer needs before its head is known.
class StreamHead {
  resolve: ((r: Response) => void) | undefined = undefined
  ctl: ReadableStreamDefaultController | undefined = undefined
  body: ReadableStream | undefined = undefined
  sent = false

  give(r: Response): void {
    if (this.sent) return
    this.sent = true
    const f = this.resolve
    if (f !== undefined) f(r)
  }
}

async function runChat(engine: Engine, req: Request, sink: StreamSink, head: StreamHead, anthropic: bool): Promise<void> {
  try {
    const r = anthropic ? await anthropicMessages(engine, req, sink) : await engine.chat(req, sink)
    // never started streaming (an error, a cache hit, a non-streaming provider): the whole answer
    if (!sink.started) head.give(r)
  } catch (e) {
    head.give(errorResponse(500, "internal error", "api_error", noHeaders()))
  }
}

// A chat request with "stream": true on Bun.serve: the answer is a ReadableStream body that
// gets each SSE event as the upstream produces it (needs Tov's stream bodies; see tov-patches/).
async function chatStreamed(engine: Engine, req: Request, anthropic: bool): Promise<Response> {
  const text = await req.text()
  const hs: Record<string, string> = snapshot(req.headers)
  const again = new Request(req.url, { method: "POST", headers: hs, body: text })
  let wants = false
  try {
    wants = text.includes("\"stream\"") && (rawBool(fields(text), "stream") ?? false)
  } catch (e) {
    wants = false
  }
  if (!wants) return await cors(engine.cfg, req, anthropic ? await anthropicMessages(engine, again) : await engine.chat(again))
  const head = new StreamHead()
  const sink = new StreamSink(
    (status, headers) => {
      const b = head.body
      const h: Record<string, string> = headers
      if (b !== undefined) head.give(new Response(b, { status: status, headers: h }))
    },
    (chunk) => {
      const c = head.ctl
      if (c !== undefined) c.enqueue(chunk)
    },
    () => {
      const c = head.ctl
      if (c !== undefined) c.close()
    },
  )
  head.body = new ReadableStream({
    start: (c) => {
      head.ctl = c
    },
    cancel: () => {
      sink.cancelled = true
    },
  })
  const p = new Promise<Response>((resolve) => {
    head.resolve = resolve
  })
  runChat(engine, again, sink, head, anthropic)
  return await cors(engine.cfg, req, await p)
}

// The Bun.serve server (the default): streamed chat answers, Tov's multi-process workers,
// native WebSockets.
export function start(engine: Engine, ops: Ops, opts: ServeOptions): string {
  const server = Bun.serve<Session>({
    port: opts.port,
    hostname: opts.hostname,
    workers: opts.workers,
    fetch(req, server) {
      const u = URL.parse(req.url)
      const p = u === undefined ? "" : u.pathname
      if (p === "/v1/realtime" || p === "/openai/v1/realtime") {
        const up = prepare(engine, req)
        if (up.kind === "refused") return errorResponse(up.status, up.message, "invalid_request_error", noHeaders())
        if (server.upgrade(req, { data: up.session })) return
        return errorResponse(426, "connect with a WebSocket upgrade", "invalid_request_error", noHeaders())
      }
      const cp = compatPath(p)
      const t0 = performance.now()
      const reqBytes = parseFloat(req.headers.get("content-length") ?? "0") ?? 0.0
      if (req.method === "POST" && CHAT_PATHS.includes(cp)) return timed(p, req.method, t0, reqBytes, chatStreamed(engine, req, false))
      if (req.method === "POST" && cp === "/anthropic/v1/messages") return timed(p, req.method, t0, reqBytes, chatStreamed(engine, req, true))
      return timed(p, req.method, t0, reqBytes, dispatch(engine, ops, req))
    },
    websocket: {
      open: (ws) => onOpen(ws),
      message: (ws, m) => onMessage(ws, m),
      close: (ws) => onClose(ws),
    },
  })
  return server.url.href
}
