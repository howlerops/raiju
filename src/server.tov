type ModelEntry = { id: string, object: string, created: int, owned_by: string }

class ModelCache {
  ids: Map<string, string[]> = new Map()
  fetchedAt: Map<string, f64> = new Map()
}

const modelCache = new ModelCache()

function upstreamModels(provider: string, kind: string, t: Target): Upstream | undefined {
  if (openai.isOpenAICompatible(kind)) return openai.modelsRequest(t)
  if (kind === "anthropic") {
    const base = t.cfg.network_config?.base_url ?? "https://api.anthropic.com"
    return { url: base + "/v1/models?limit=1000", headers: anthropic.upstreamHeaders(t), body: "" }
  }
  if (kind === "gemini") {
    const base = t.cfg.network_config?.base_url ?? "https://generativelanguage.googleapis.com"
    return { url: base + "/v1beta/models?pageSize=1000", headers: gemini.upstreamHeaders(t), body: "" }
  }
  if (kind === "cohere") return cohere.modelsRequest(t)
  return undefined
}

// The kinds whose listing is not OpenAI's shape, read by nativeModelIds. Databricks lists nothing, as
// Bifrost's does: its workspace inventory does not match the inference ids (databricks/models.go).
// GitHub Copilot, Bedrock Mantle and Azure answer in OpenAI's shape, but their requests are their own (editor headers
// and a minted token; the regional host and SigV4; the resource endpoint and api-key or Entra token).
function nativeList(kind: string): bool {
  return kind === "bedrock" || kind === "vertex" || kind === "cloudflare" || kind === "databricks" || kind === "replicate" || kind === "github-copilot" || kind === "bedrock_mantle" || kind === "azure" || kind === "watsonx"
}

// One GET on a provider listing: the body when the answer is 2xx, else undefined.
async function getListing(up: Upstream): Promise<string | undefined> throws Error {
  const hs = new Headers()
  for (const k of up.headers.keys()) hs.set(k, up.headers.get(k)!)
  const res = try await fetch(up.url, { headers: hs, signal: AbortSignal.timeout(5000) })
  const text = try await res.text()
  return res.ok ? text : undefined
}

// OpenRouter's /v1/models leaves out its decision models, which are listed under the root at
// /v1/models?output_modalities=decisions (Bifrost's openRouterDecisionModelsPath). Best-effort, as
// Bifrost's: a failed read adds nothing, and an id already listed is not repeated.
async function withDecisionModels(provider: string, t: Target, ids: string[]): Promise<string[]> {
  if (t.kind !== "openrouter") return ids
  const req = openai.modelsRequest(t)
  const up: Upstream = { url: openrouter.rootOf(t) + "/v1/models?output_modalities=decisions", headers: req.headers, body: "" }
  try {
    const text = try await getListing(up)
    if (text === undefined) return ids
    const out = ids.slice()
    for (const id of try openai.modelIds(text, provider)) {
      const name = id.replace(provider + "/models/", provider + "/")
      if (!out.includes(name)) out.push(name)
    }
    return out
  } catch (e) {
    return ids
  }
}

// The model ids (as provider/model) of a provider whose listing nativeList names. undefined when the
// listing could not be read. Bedrock: the foundation models and the inference profiles, signed as
// Bedrock's control plane takes them. Vertex: the Model Garden publishers google, anthropic and
// mistralai, every page, with a bearer token (Bifrost's list: vertex/vertex.go). Cloudflare: the
// Workers AI search, every page, keeping the text generation and embeddings models (cloudflare/models.go).
// Every page of a Bedrock control-plane listing: each answer's nextToken is sent back as the next
// page's query until none is left (capped, so a provider that never ends cannot hold the listing).
// undefined when the first page cannot be read; a later page that fails keeps the ids read so far.
async function bedrockPages(t: Target, path: string, field: string, idKey: string): Promise<string[] | undefined> {
  const out: string[] = []
  let token = ""
  for (let page = 0; page < 50; page++) {
    const query = token === "" ? "" : "nextToken=" + bedrock.encodeSegment(token)
    let body: string | undefined = undefined
    try {
      body = await getListing(bedrock.listRequest(t, path, query))
      if (body === undefined) return page === 0 ? undefined : out
      for (const id of try bedrockIds(body, field, idKey)) out.push(id)
      token = rawStr(try fields(body), "nextToken") ?? ""
    } catch (e) {
      return page === 0 ? undefined : out
    }
    if (token === "") break
  }
  return out
}

// GitHub Copilot's, Bedrock Mantle's and Azure's listings: OpenAI's list shape from their own requests. A Copilot key
// with GitHub App credentials gets its token and host minted (and cached) as for chat, and so does an Entra ID key.
async function ownListingIds(engine: Engine | undefined, provider: string, t: Target): Promise<string[] | undefined> throws SyntaxError | Error {
  let lt = t
  if (lt.kind === "github-copilot" && (lt.key.value ?? "") === "" && lt.key.github_copilot_key_config !== undefined) {
    if (engine === undefined) return undefined
    const tok = await engine.copilotToken(lt)
    if (tok.error !== "") return undefined
    lt.key.value = tok.token
    let nc = lt.cfg.network_config ?? {}
    nc.base_url = tok.host
    let pc = lt.cfg
    pc.network_config = nc
    lt.cfg = pc
  }
  if (lt.kind === "azure" && (lt.key.value ?? "") === "" && lt.key.azure_key_config?.tenant_id !== undefined) {
    // an Entra ID service principal: its token, minted (and cached) as for chat
    if (engine === undefined) return undefined
    const tok = await engine.entraToken(lt)
    if (tok.error !== "") return undefined
    lt.key.value = tok.token
  }
  const bk = lt.key.bedrock_key_config
  if (lt.kind === "bedrock_mantle" && (lt.key.value ?? "") === "" && bk !== undefined && (bk.role_arn ?? "") !== "") {
    // a key with role_arn lists with the role's temporary credentials (STS AssumeRole, cached), as its calls do
    if (engine === undefined) return undefined
    const ar = await engine.assumeRole(bk)
    if (ar.error !== "") return undefined
    let nb = bk
    nb.access_key = ar.creds!.accessKey
    nb.secret_key = ar.creds!.secretKey
    nb.session_token = ar.creds!.sessionToken
    nb.role_arn = undefined
    lt.key.bedrock_key_config = nb
  }
  let up = bedrockMantle.modelsRequest(lt)
  if (lt.kind === "github-copilot") up = try copilot.modelsRequest(lt)
  else if (lt.kind === "azure") up = openai.azureModelsRequest(lt)
  const text = try await getListing(up)
  if (text === undefined) return undefined
  return try openai.modelIds(text, provider)
}

async function nativeModelIds(engine: Engine | undefined, provider: string, t: Target): Promise<string[] | undefined> {
  const ids: string[] = []
  try {
    if (t.kind === "databricks") return ids
    if (t.kind === "github-copilot" || t.kind === "bedrock_mantle" || t.kind === "azure") return await ownListingIds(engine, provider, t)
    if (t.kind === "watsonx") {
      // the instance's foundation model specs (chat models), every page, with the key's IAM token
      const wk = t.key.watsonx_key_config
      if (wk === undefined) return undefined
      let token = ""
      if (engine !== undefined) {
        const tok = await engine.watsonxToken(t)
        if (tok.error !== "") return undefined
        token = tok.token
      }
      let next = ""
      let any = false
      for (let page = 0; page < 20; page++) {
        const text = await getListing(watsonx.modelsRequest(wk, token, next))
        if (text === undefined) break
        any = true
        const pg = try watsonx.modelsPage(text)
        for (const id of pg.ids) ids.push(provider + "/" + id)
        if (pg.next === "" || pg.next === next) break
        next = pg.next
      }
      return any ? ids : undefined
    }
    if (t.kind === "replicate") {
      // Replicate has no model catalog to list: without use_deployments_endpoint the listing is empty, and the
      // listing pipeline adds the key's aliases back (listingPipeline), as Bifrost's
      if (t.key.replicate_key_config?.use_deployments_endpoint !== true) return ids
      // the account's deployments, every page: each answer's next is the full URL of the following page
      const first = replicate.deploymentsRequest(t)
      let next = first.url
      let any = false
      for (let page = 0; page < 20; page++) {
        const text = await getListing({ url: next, headers: first.headers, body: "" })
        if (text === undefined) break
        any = true
        const pp = try replicate.deploymentsPage(text)
        for (const id of pp.ids) ids.push(provider + "/" + id)
        if (pp.next === "") break
        next = pp.next
      }
      return any ? ids : undefined
    }
    if (t.kind === "bedrock") {
      const fm = await bedrockPages(t, "/foundation-models", "modelSummaries", "modelId")
      if (fm === undefined) return undefined
      for (const id of fm) ids.push(provider + "/" + id)
      const ip = await bedrockPages(t, "/inference-profiles", "inferenceProfileSummaries", "inferenceProfileId")
      if (ip !== undefined) {
        for (const id of ip) ids.push(provider + "/" + id)
      }
      return ids
    }
    if (t.kind === "vertex") {
      // the gateway's token cache when there is one, so a listing and a chat call share a token
      let token = ""
      if (engine !== undefined) {
        const tok = await engine.vertexToken(t)
        if (tok.error !== "") return undefined
        token = tok.token
      } else {
        token = try await vertexBearer(t)
      }
      const hdr = new Map<string, string>()
      hdr.set("authorization", "Bearer " + token)
      let any = false
      for (const pub of ["google", "anthropic", "mistralai"]) {
        let page = ""
        for (let i = 0; i < 20; i++) {
          const text = try await getListing({ url: try vertex.publisherListUrl(t, pub, page), headers: hdr, body: "" })
          if (text === undefined) break
          any = true
          const pp = try publisherPage(text)
          for (const id of pp.ids) ids.push(provider + "/" + id)
          if (pp.next === "") break
          page = pp.next
        }
      }
      return any ? ids : undefined
    }
    if (t.kind === "cloudflare") {
      const base = try cloudflare.accountBase(t)
      let hs = new Map<string, string>()
      hs.set("authorization", "Bearer " + (t.key.value ?? ""))
      addExtraHeaders(&hs, t.cfg)
      let any = false
      for (let page = 1; page <= 20; page++) {
        const text = try await getListing({ url: base + cloudflareSearchPath(page), headers: hs, body: "" })
        if (text === undefined) break
        any = true
        const cp = try cloudflarePage(text)
        for (const id of cp.ids) ids.push(provider + "/" + id)
        if (!cp.full) break
      }
      return any ? ids : undefined
    }
  } catch (e) {
    return undefined
  }
  return undefined
}

// A provider's models for GET /v1/models: each key's model list, or the provider's own listing read with that key,
// through the key's aliases and blacklist, the keys' results joined (router.tov listingPipeline, Bifrost's
// ListModelsPipeline run by HandleMultipleListModelsRequests). A key whose model list is plain names lists those
// names without asking the provider.
async function providerModels(engine: Engine | undefined, cfg: Config, provider: string): Promise<string[]> {
  const p = providerOf(cfg, provider)
  if (p === undefined) return []
  const keys = p.keys ?? []
  if (keys.length === 0) return await upstreamModelIds(engine, provider, p, 0, { value: "" })
  const byKey = await Promise.all(keys.map((k, i) => listingNeedsUpstream(k) ? upstreamModelIds(engine, provider, p, i, k) : Promise.resolve([] as string[])))
  return listingPipeline(provider, [], keys, byKey)
}

// The cache slot of one key's listing.
function listingSlot(provider: string, index: int): string {
  return provider + "#" + index
}

// The provider's own listing read with one key (cached for five minutes per key), as its API names the models.
async function upstreamModelIds(engine: Engine | undefined, provider: string, p: ProviderConfig, index: int, key: KeyConfig): Promise<string[]> {
  const slot = listingSlot(provider, index)
  const cachedAt = modelCache.fetchedAt.get(slot) ?? 0.0
  if (Date.now() - cachedAt < 300000.0) return modelCache.ids.get(slot) ?? []
  const kind = kindOf(provider, p)
  const t: Target = { provider: provider, kind: kind, model: "", key: key, cfg: p }
  let ids: string[] = []
  if (nativeList(kind)) {
    ids = (await nativeModelIds(engine, provider, t)) ?? []
  } else {
    const up = upstreamModels(provider, kind, t)
    if (up === undefined) return []
    try {
      const hs = new Headers()
      for (const k of up.headers.keys()) hs.set(k, up.headers.get(k)!)
      const res = await fetch(up.url, { headers: hs, signal: AbortSignal.timeout(5000) })
      const text = await res.text()
      if (res.ok) ids = await withDecisionModels(provider, t, openai.modelIds(text, provider).map((id) => id.replace(provider + "/models/", provider + "/")))
    } catch (e) {
      ids = []
    }
  }
  modelCache.ids.set(slot, ids)
  modelCache.fetchedAt.set(slot, Date.now())
  return ids
}

// POST /api/providers/{p}/refresh-models (and .../keys/{id}/refresh-models): lists the models live
// from the provider, trying each key (or the one named) until one answers, and refreshes the list
// GET /v1/models serves from. Bifrost returns the keys with their discovery status; Raiju returns
// the list, as {provider, models, total}.
async function refreshModels(engine: Engine | undefined, cfg: Config, provider: string, keyId: string | undefined): Promise<Reply> {
  const p = providerOf(cfg, provider)
  if (p === undefined) return { status: 404, body: JSON.stringify({ error: { message: `no provider ${provider}`, type: "invalid_request_error" } }), contentType: "application/json" }
  const kind = kindOf(provider, p)
  const keys = p.keys ?? []
  for (let i = 0; i < keys.length; i++) {
    const key = keys[i]!
    if (keyId !== undefined && key.id !== keyId) continue
    const t: Target = { provider: provider, kind: kind, model: "", key: key, cfg: p }
    if (nativeList(kind)) {
      const nids = await nativeModelIds(engine, provider, t)
      if (nids === undefined) continue
      modelCache.ids.set(listingSlot(provider, i), nids)
      modelCache.fetchedAt.set(listingSlot(provider, i), Date.now())
      return { status: 200, body: JSON.stringify({ provider: provider, models: nids, total: nids.length }), contentType: "application/json" }
    }
    const up = upstreamModels(provider, kind, t)
    if (up === undefined) continue
    try {
      const hs = new Headers()
      for (const k of up.headers.keys()) hs.set(k, up.headers.get(k)!)
      const res = await fetch(up.url, { headers: hs, signal: AbortSignal.timeout(5000) })
      const text = await res.text()
      if (!res.ok) continue
      const ids = await withDecisionModels(provider, t, openai.modelIds(text, provider).map((id) => id.replace(provider + "/models/", provider + "/")))
      modelCache.ids.set(listingSlot(provider, i), ids)
      modelCache.fetchedAt.set(listingSlot(provider, i), Date.now())
      return { status: 200, body: JSON.stringify({ provider: provider, models: ids, total: ids.length }), contentType: "application/json" }
    } catch (e) {
      continue
    }
  }
  return { status: 502, body: JSON.stringify({ error: { message: `no key of ${provider} could list its models`, type: "api_error" } }), contentType: "application/json" }
}

// GET /v1/models/{model}: the provider's own model object where the provider has a retrieve API
// (model_retrieve.tov), as Bifrost's modelRetrieve reads it. Other providers, and a retrieve that
// cannot reach the provider, answer with the entry from the list: some providers list only part of
// what they serve, so a configured provider gets a minimal entry.
async function retrieveModel(engine: Engine, req: Request, id: string): Promise<Response> {
  const slash = id.indexOf("/")
  if (slash <= 0) return errorResponse(404, `model ${id} not found: use provider/model`, "invalid_request_error", noHeaders())
  const provider = id.slice(0, slash)
  if (!providerNames(engine.cfg).includes(provider)) return errorResponse(404, `no provider ${provider}`, "invalid_request_error", noHeaders())
  const model = id.slice(slash + 1)
  const known = await providerModels(engine, engine.cfg, provider)
  const listed = known.includes(id) || known.includes(model)
  const p = providerOf(engine.cfg, provider)
  if (p !== undefined) {
    const kind = kindOf(provider, p)
    const key = (p.keys ?? [])[0] ?? { value: "" }
    const up = retrieveRequest({ provider: provider, kind: kind, model: model, key: key, cfg: p }, model)
    if (up !== undefined) {
      const hs = new Headers()
      for (const k of up.headers.keys()) hs.set(k, up.headers.get(k)!)
      try {
        const res = await fetch(up.url, { headers: hs, signal: AbortSignal.timeout(5000) })
        const text = await res.text()
        // a 404 is the answer for a model the provider does not have; a listed model whose server has no
        // retrieve route (some OpenAI-compatible servers) keeps the list entry
        if (res.status === 404) {
          if (listed) return Response.json({ id: id, object: "model", created: 0, owned_by: provider, listed: listed })
          return errorResponse(404, `model ${model} not found at ${provider}`, "invalid_request_error", noHeaders())
        }
        if (!res.ok) return new Response(text, { status: res.status, headers: { "content-type": "application/json" } })
        const body = try retrieveBody(provider, kind, text, listed)
        return new Response(body, { headers: { "content-type": "application/json" } })
      } catch (e) {
        return errorResponse(502, `${provider} could not return model ${model}: ${e.message}`, "api_error", noHeaders())
      }
    }
  }
  return Response.json({ id: id, object: "model", created: 0, owned_by: provider, listed: listed })
}

const GENAI = "/genai/v1beta/models/"

// GET /genai/v1beta/models and /models/{id}: the configured models, in GenAI's shape.
async function genaiModels(engine: Engine, id: string): Promise<Response> {
  const ids: string[] = []
  for (const n of providerNames(engine.cfg)) {
    for (const m of await providerModels(engine, engine.cfg, n)) ids.push(m)
  }
  if (id === "") return new Response(genaiIn.modelsList(ids), { headers: { "content-type": "application/json" } })
  const name = new URLSearchParams("id=" + id).get("id") ?? id
  if (!ids.includes(name)) return errorResponse(404, `models/${name} not found`, "invalid_request_error", noHeaders())
  return new Response(genaiIn.modelInfo(name), { headers: { "content-type": "application/json" } })
}

async function listModels(engine: Engine, req: Request): Promise<Response> {
  const only = req.headers.get("x-bf-list-models-provider") ?? req.headers.get("x-bf-model-provider") ?? "all"
  const names = providerNames(engine.cfg).filter((n) => only === "all" || n === only)
  const lists = await Promise.all(names.map((n) => providerModels(engine, engine.cfg, n)))
  const data: ModelEntry[] = []
  for (let i = 0; i < names.length; i++) {
    for (const id of lists[i]!) data.push({ id: id, object: "model", created: 0, owned_by: names[i]! })
  }
  return Response.json({ object: "list", data: data })
}


// Bifrost's http_* metrics for one request. A streamed body counts as 0 bytes.
async function timed(path: string, method: string, t0: f64, reqBytes: f64, headers: Headers, p: Promise<Response, TypeError>): Promise<Response, TypeError> {
  const res = try await p
  const len = parseFloat(res.headers.get("content-length") ?? "0") ?? 0.0
  metrics.observeHttp(pathLabel(path), method, res.status, (performance.now() - t0) / 1000.0, reqBytes, len, metrics.httpCustomValues(headers))
  return res
}

// A bounded path label: ids (segments with digits, or past the fourth) become {id}.
export function pathLabel(path: string): string {
  const segs = path.split("/")
  const out: string[] = []
  for (let i = 0; i < segs.length; i++) {
    const s = segs[i]!
    let id = i > 4
    for (const ch of s.chars()) {
      if (ch >= "0" && ch <= "9") id = true
    }
    // version segments such as v1 and v1beta stay
    if (i <= 2 && s.startsWith("v") && s.byteLength <= 7) id = false
    out.push(id && s !== "" ? "{id}" : s)
  }
  return out.join("/")
}

test("path labels hide ids", () => {
  expect(pathLabel("/v1/chat/completions")).toBe("/v1/chat/completions")
  expect(pathLabel("/api/governance/virtual-keys/vk-1")).toBe("/api/governance/virtual-keys/{id}")
  expect(pathLabel("/genai/v1beta/models/gemini-2.5-flash:generateContent")).toBe("/genai/v1beta/models/{id}")
  expect(pathLabel("/bedrock/model/a/b/c/converse")).toBe("/bedrock/model/a/b/{id}/{id}")
})

// Runs an internal request (an async job) through the same handlers as live traffic.
function dispatcher(engine: Engine): Dispatch {
  return async (req) => {
    const u = URL.parse(req.url)
    const p = u === undefined ? "" : u.pathname
    if (p === "/v1/chat/completions") return await engine.chat(req)
    if (p === "/v1/completions") return try await llmHooked(engine, req, "completions", async (r, s) => await engine.completions(r), undefined)
    if (p === "/v1/embeddings") return try await llmHooked(engine, req, "embeddings", async (r, s) => await engine.embeddings(r), undefined)
    if (p === "/v1/responses") return try await llmHooked(engine, req, "responses", async (r, s) => await responsesApi(engine, r), undefined)
    if (p === "/anthropic/v1/messages") return await anthropicMessages(engine, req)
    if (p === "/v1/rerank") return try await llmHooked(engine, req, "rerank", async (r, s) => try await rerank(engine, r), undefined)
    const media = matchRoute("POST", p)
    if (media !== undefined) {
      const lk = kindOfPath("POST", p)
      if (lk !== undefined) return try await llmHooked(engine, req, lk.op, async (r, s) => try await engine.media(r, media), undefined)
      return try await engine.media(req, media)
    }
    return errorResponse(404, `no route for ${p}`, "invalid_request_error", noHeaders())
  }
}

// Reconnects an MCP client, or refreshes its tools, on the live manager.
async function mcpAction(ops: Ops, action: string, id: string, ok: Reply): Promise<Reply> {
  const m = ops.engine.mcp
  const ss: McpSession[] = m === undefined ? [] : m.sessions.filter((x) => x.cfg.name === id)
  if (ss.length === 0) return { status: 404, body: `{"error":{"message":"MCP client not found","type":"not_found_error"}}`, contentType: "application/json" }
  const s = ss[0]!
  await s.connect()
  const what = action === "refresh" ? "refresh MCP client tools" : "reconnect MCP client"
  if (!s.connected) return { status: 500, body: JSON.stringify({ error: { message: `Failed to ${what}: ${s.lastError}`, type: "api_error" } }), contentType: "application/json" }
  if (action === "refresh") return { status: 200, body: JSON.stringify({ status: "success", message: "MCP client tools refreshed successfully", tool_count: s.exposedCount() }), contentType: "application/json" }
  return ok
}

// The /api/logs routes that ops.logsRoute answers (histograms, rankings, dashboard, filterdata, dropped),
// and the MCP logs. The other /api/logs routes are not these.
function logsAnalyticsPath(path: string): bool {
  return path === "/api/logs" || path.startsWith("/api/logs/") || path.startsWith("/api/mcp-logs")
}

// The users routes' path: Bifrost's /api/governance/users[/...] (its current home for them) is /api/users[/...].
export function usersPath(path: string): string {
  const g = "/api/governance/users"
  if (path === g || path.startsWith(g + "/")) return "/api/users" + path.slice(g.byteLength)
  return path
}

// The audit trail's path, with the alias (governance/audit-logs) mapped onto audit-logs; "" for any other path.
function auditTarget(path: string): string {
  const segs = path.split("/")
  if (segs[1] === "api" && segs[2] === "audit-logs") return path
  if (segs[1] === "api" && segs[2] === "governance" && segs[3] === "audit-logs") return ["", "api", "audit-logs"].concat(segs.slice(4)).join("/")
  return ""
}

// A route's reply. A section it changed is saved first, and a failed save is the reply instead.
function savedReply(status: int, body: string, saved: Result | undefined): Reply {
  if (saved !== undefined && saved.kind !== "ok") return { status: saved.status, body: JSON.stringify({ error: { message: saved.message, type: "api_error" } }), contentType: "application/json" }
  return { status: status, body: body, contentType: "application/json" }
}

// The SCIM reply: the body with the SCIM media type.
function scimReply(status: int, body: string): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", SCIM_CONTENT_TYPE)
  return new Response(body, { status: status, headers: h })
}

// The virtual keys' teams: a group in use by one is not deleted over SCIM.
function keyTeamIds(vks: VirtualKeyConfig[] | undefined): string[] {
  const out: string[] = []
  for (const vk of vks ?? []) {
    const t = vk.team_id
    if (t !== undefined) out.push(t)
  }
  return out
}

// /scim/v2: the identity provider's SCIM requests, behind scim_config's provisioning token. The users and
// teams a request changes are saved as one change and audited under the actor "scim".
async function scimRoute(ops: Ops, req: Request, path: string): Promise<Response> {
  const sc = ops.store.cfg.scim_config
  if (sc?.enabled !== true) return scimReply(404, errorBody(404, "", "SCIM provisioning is not enabled"))
  const token = resolveEnv(sc?.config?.provisioningToken ?? "")
  if (!scimAuthorized(req.headers.get("authorization") ?? "", token)) return scimReply(401, errorBody(401, "", "the SCIM provisioning token is missing or wrong"))
  const body = req.method === "GET" ? "" : await req.text()
  const u = URL.parse(req.url)
  const origin = u === undefined ? "" : u.origin
  const params = u === undefined ? new URLSearchParams("") : u.searchParams
  const g = ops.store.cfg.governance
  const st: ScimState = { users: g?.users ?? [], teams: g?.teams ?? [], roles: g?.roles ?? [], keyTeams: keyTeamIds(g?.virtual_keys) }
  const r = scimHandle(st, req.method, path.slice("/scim/v2".byteLength), params, body, origin + "/scim/v2", () => randomId("team-"))
  if (r.changed && r.status < 300) {
    const saved = ops.store.setScim(r.state.users, r.state.teams)
    if (saved.kind !== "ok") return scimReply(saved.status, errorBody(saved.status, "", saved.message))
    ops.storeUpdated("/api/users")
    ops.storeUpdated("/api/governance/teams")
  }
  if (req.method !== "GET") ops.recordChange("scim", req, path, r.status, body)
  return scimReply(r.status, r.body)
}

// The management API, behind RBAC; every change lands in the audit log.
async function manage(ops: Ops, req: Request, path: string): Promise<Response> {
  const gate = ops.gate(req, path)
  if (gate.kind === "deny") return gate.res
  // what this caller may see and change (data access scope)
  const sc = ops.scopeOfActorFor(gate.actor, resourceOf(req.method, path).resource)
  // DELETE reads its body too: DELETE /api/mcp-logs names its ids there
  const body = req.method === "GET" ? "" : await req.text()
  // a change saved by this request is answered once the node's other workers run it (ops.settleConfig)
  const genBefore = ops.store.fileSha
  let r: Reply = { status: 404, body: "", contentType: "application/json" }
  if (path === "/api/users/me/permissions") r = req.method === "GET" ? ops.mePermissions(gate.actor) : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  else if (path === "/api/governance/users/me/permissions") r = req.method === "GET" ? ops.mePermissionMap(gate.actor) : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  // a user by email address (Bifrost's MDM lookups), on the old and the governance path
  else if (path.startsWith("/api/users/email/") || path.startsWith("/api/governance/users/email/")) r = ops.userByEmailRoute(req.method, path)
  else if (usersPath(path) === "/api/users/me/vk-creation-policy") r = req.method === "GET" ? ops.vkCreationPolicy(gate.actor) : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  else if (usersPath(path).startsWith("/api/users/") && usersPath(path).split("/")[4] === "access-profiles") r = ops.userProfiles(req.method, usersPath(path), body)
  else if (usersPath(path) === "/api/users" || usersPath(path).startsWith("/api/users/")) r = ops.users(req.method, usersPath(path), body, req.headers.get("x-bifrost-setup-token") ?? "", cookieValue(req.headers.get("cookie") ?? "", SETUP_COOKIE))
  else if (auditTarget(path) !== "") r = ops.auditRoute(req, auditTarget(path))
  else if (path === "/api/api-keys" || path.startsWith("/api/api-keys/")) r = ops.apiKeysRoute(req.method, path, req.url, body, gate.actor)
  // the cache clears (DELETE) and the read-only plugin listings
  else if (path.startsWith("/api/cache/")) r = await ops.cacheClear(req.method, path)
  else if (path === "/api/plugins" || path.startsWith("/api/plugins/")) r = await ops.pluginsRouteAsync(req.method, path, body)
  else if (path === "/api/mcp/virtual") r = req.method === "GET" ? ops.virtualView() : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  // one project member's usage: its slices with their counters and its requests by provider and model
  else if (req.method === "GET" && path.startsWith("/api/governance/projects/") && path.endsWith("/usage") && path.split("/").length === 8 && path.split("/")[5] === "members") r = ops.memberUsage(path, sc)
  // the access-profile audit lists (Bifrost serves them on both paths)
  else if (req.method === "GET" && (path.startsWith("/api/governance/access-profiles/") || path.startsWith("/api/access-profiles/")) && path.endsWith("/audit-logs") && path.split("/").length <= 6) r = ops.profileAudit(req, path)
  else if (path === "/api/governance/access-profiles" || path.startsWith("/api/governance/access-profiles/")) r = ops.profiles(req.method, path, body)
  else if (path.startsWith("/api/alerting/")) {
    const ar = alertingRoute(ops.store.cfg.alerts ?? {}, { usage: (t, id) => ops.engine.gov.scopeUsage(t, id, Date.now()), history: () => ops.cel?.history() ?? [] }, req.method, req.url.slice(req.url.indexOf("/api/")), body)
    const next = ar.next
    r = { status: ar.status, body: ar.body, contentType: "application/json" }
    if (next !== undefined) {
      const saved = ops.store.setAlerts(next)
      if (saved.kind !== "ok") r = { status: saved.status, body: JSON.stringify({ error: { message: saved.message, type: "api_error" } }), contentType: "application/json" }
    }
  }
  // the MCP grants of the authorization server: the live grants (GET) and the revoke of one (DELETE)
  else if (path === "/api/oauth2/sessions" || path.startsWith("/api/oauth2/sessions/")) {
    const gu = URL.parse(req.url)
    const gq = gu === undefined ? new URLSearchParams("") : gu.searchParams
    const vkName = (vk: string): string => keyById(ops.engine.cfg, vk)?.name ?? ""
    const ga = path === "/api/oauth2/sessions" && req.method === "GET" ? grantsList(gq, vkName) : path !== "/api/oauth2/sessions" && req.method === "DELETE" ? grantRevoke(path.slice("/api/oauth2/sessions/".byteLength)) : undefined
    if (ga !== undefined) r = { status: ga.status, body: ga.body, contentType: ga.contentType }
    else r = { status: 405, body: `{"error":{"message":"method ${req.method} is not allowed on this route","type":"invalid_request_error"}}`, contentType: "application/json" }
  }
  // crew routing (crew.tov): the pools with their classes and crews, the assign route and a task's detail
  else if (path === "/api/crews" || path.startsWith("/api/crews/")) {
    const cr = crewsRoute(req.method, req.url.slice(req.url.indexOf("/api/")), body, ops.engine.logStore, ops.engine.pricing, Date.now())
    r = { status: cr.status, body: cr.body, contentType: "application/json" }
  }
  else if (path === "/api/alerts") r = req.method === "GET" ? ops.alertsView() : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  else if (path === "/api/models/base" || path === "/api/models/details") r = ops.catalogView(req, path)
  else if (path === "/api/circuit-breaker/state") r = req.method === "GET" ? ops.circuitView() : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  // the request-log analytics and the MCP logs (ops.logsRoute)
  else if (logsAnalyticsPath(path)) r = ops.logsRoute(req, path, body, sc)
  else if (path === "/api/circuit-breaker/policies" || path.startsWith("/api/circuit-breaker/policies/")) r = ops.circuitPoliciesRoute(req.method, path, body)
  else if (path === "/api/circuit-breaker/reset") r = req.method === "POST" ? ops.circuitReset(body) : { status: 405, body: `{"error":{"message":"use POST","type":"invalid_request_error"}}`, contentType: "application/json" }
  // adaptive load balancing: the keys held out of rotation, their incidents, and releasing them
  else if (path === "/api/adaptive-routing/held-keys") r = req.method === "GET" ? ops.adaptiveHeldKeys() : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  else if (path === "/api/adaptive-routing/incidents") r = req.method === "GET" ? ops.adaptiveIncidents() : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  else if (path === "/api/adaptive-routing/history/issues") r = req.method === "GET" ? ops.adaptiveHistory(req) : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  else if (path === "/api/adaptive-routing/conditions/clear") r = req.method === "POST" ? ops.adaptiveRelease(body) : { status: 405, body: `{"error":{"message":"use POST","type":"invalid_request_error"}}`, contentType: "application/json" }
  else if (path === "/api/vault/flush-cache") r = req.method === "POST" ? ops.vaultFlush() : { status: 405, body: `{"error":{"message":"use POST","type":"invalid_request_error"}}`, contentType: "application/json" }
  else if (path === "/api/models/parameters") r = req.method === "GET" ? await ops.modelParameters(req) : { status: 405, body: `{"error":{"message":"use GET","type":"invalid_request_error"}}`, contentType: "application/json" }
  else if (path === "/api/models/catalog") r = ops.catalogUpsert(req, body)
  // changing the global proxy's URL, or turning skip_tls_verify on, needs a real admin session
  else if (path === "/api/proxy-config" && req.method === "PUT" && !ops.authOn && proxyWidening(ops.store.cfg.proxy_config, body).length > 0) {
    r = { status: 403, body: `{"error":{"message":"Changing the global proxy (url or skip_tls_verify) requires an authenticated admin session; dashboard auth is currently disabled or unconfigured. Enable dashboard authentication first.","type":"permission_error"}}`, contentType: "application/json" }
  }
  else if (path.startsWith("/api/providers/") && path.endsWith("/refresh-models")) {
    // /api/providers/{p}/refresh-models or /api/providers/{p}/keys/{id}/refresh-models
    const parts = path.split("/")
    const isKey = parts.length === 7 && parts[4] === "keys"
    if (req.method !== "POST") r = { status: 405, body: `{"error":{"message":"use POST","type":"invalid_request_error"}}`, contentType: "application/json" }
    else if (!(parts.length === 5 || isKey)) r = { status: 404, body: `{"error":{"message":"no such route","type":"invalid_request_error"}}`, contentType: "application/json" }
    else r = await refreshModels(undefined, ops.store.cfg, parts[3] ?? "", isKey ? parts[5] : undefined)
  }
  // the MCP server library (ops.libraryRoute, src/mcplibrary.tov)
  else if (path === "/api/mcp/library" || path.startsWith("/api/mcp/library/")) r = await ops.libraryRoute(req, path, body)
  else if (path === "/api/pricing/force-sync") {
    if (req.method === "POST") r = await ops.forcePricing()
    else r = { status: 405, body: `{"error":{"message":"use POST","type":"invalid_request_error"}}`, contentType: "application/json" }
  }
  // prompt repository, webhooks, feature flags and notifications (their modules hold the logic)
  else if (path.startsWith("/api/prompt-repo/")) {
    const pr = promptRoute(ops.store.cfg.prompt_repo, req.method, req.url.slice(req.url.indexOf("/api/")), body)
    r = savedReply(pr.status, pr.body, pr.next === undefined ? undefined : ops.store.setPromptRepo(pr.next))
  }
  else if (path === "/api/webhooks" || path.startsWith("/api/webhooks/")) {
    const wr = await webhookApi(ops.store.cfg.webhooks, req.method, req.url.slice(req.url.indexOf("/api/")), body)
    r = savedReply(wr.status, wr.body, wr.next === undefined ? undefined : ops.store.setWebhooks(wr.next))
  }
  // registered A2A agents (agents.tov); the call history is ops.tov's
  else if (path === "/api/agents" || path.startsWith("/api/agents/")) {
    if (path === "/api/agents/push-configs" || path.startsWith("/api/agents/push-configs/")) {
      const pu = URL.parse(req.url)
      r = ops.pushConfigsRoute(req.method, path, pu === undefined ? new URLSearchParams("") : pu.searchParams)
    } else if (path === "/api/agents/history" || path.startsWith("/api/agents/history/")) {
      const hu = URL.parse(req.url)
      r = ops.agentHistoryRoute(req.method, path, hu === undefined ? new URLSearchParams("") : hu.searchParams, body, sc)
    } else {
      const ar = await agentApi(ops.store.cfg.agents, req.method, req.url.slice(req.url.indexOf("/api/")), body, publicBase(ops.store.cfg.client?.a2a_external_client_url, req.url))
      const saved = ar.next === undefined ? undefined : ops.store.setAgents(ar.next)
      // a card fetched here reaches the other workers before this answer (ops.publishCards)
      if (saved !== undefined && saved.kind === "ok") ops.publishCards()
      r = savedReply(ar.status, ar.body, saved)
    }
  }
  else if (path === "/api/feature-flags" || path.startsWith("/api/feature-flags/")) {
    const fr = flagRoute(ops.store.cfg.feature_flags, req.method, req.url.slice(req.url.indexOf("/api/")), body)
    r = savedReply(fr.status, fr.body, fr.next === undefined ? undefined : ops.store.setFeatureFlags(fr.next))
  }
  else if (path === "/api/notifications") {
    const nr = notifyRoute(req.method, req.url.slice(req.url.indexOf("/api/")), body)
    r = { status: nr.status, body: nr.body, contentType: "application/json" }
  }
  else {
    // the OAuth routes of auth type oauth clients need the gateway's origin (the callback's redirect URI)
    const mu = URL.parse(req.url)
    // the status route reads ?flow_id=
    let oa: McpReply | undefined = oauthConfigRoute(ops.store, req.method, mu === undefined ? path : path + mu.search)
    if (oa === undefined) oa = await oauthRoute(ops.store, req.method, path, body, mu === undefined ? "" : mu.origin)
    // a user-mode flow opens for the identity-provider user of the caller's single sign-on session only
    const ssoUser = gate.actor.startsWith("sso:") ? gate.actor.slice(4) : ""
    if (oa === undefined) oa = perUserApi(ops.store, req.method, mu === undefined ? path : path + mu.search, body, mu === undefined ? "" : mu.origin, ssoUser)
    if (oa === undefined) oa = await headersRouteAsync(ops.store, req.method, path, body, ssoUser)
    if (oa === undefined) oa = await exchangeRouteAsync(ops.store, ops.engine.idp, req.method, path, body)
    if (oa === undefined) oa = await openapiRoute(req.method, path, body, !ops.authOn)
    // an openapi client sent with a spec_url keeps the document it names (fetched now, as Bifrost stores it)
    let mbody = body
    if (oa === undefined) {
      const il = await inlineSpecUrl(req.method, path, body, !ops.authOn)
      if (il.error !== undefined) oa = il.error
      mbody = il.body
    }
    // with dashboard auth off, clients registered here must reach public addresses only
    const mr = oa ?? mcpApi(ops.store, req.method, path, mbody, !ops.authOn, sc)
    if (mr !== undefined) {
      r = { status: mr.status, body: mr.body, contentType: mr.contentType ?? "application/json" }
      if (mr.status === 200 && mr.action !== undefined) r = await mcpAction(ops, mr.action, mr.id ?? "", r)
    } else {
      // the query (search, paging, is_active) reaches the handlers that read it
      const qu = URL.parse(req.url)
      // a provider's base_url, with its host resolved now (Bifrost's ValidateExternalURL)
      const bu = await providerBaseUrlProblem(req.method, path, body)
      const a = bu !== "" ? { status: 400, body: JSON.stringify({ error: { message: bu } }) } : handleApi(ops.store, req.method, qu === undefined ? path : path + qu.search, body, sc)
      r = { status: a.status, body: a.body, contentType: "application/json" }
      // a rotated key's MCP OAuth grants go with its old value (Bifrost revokes them in the rotation)
      if (a.status === 200 && isRotatePath(path)) {
        for (const id of rotatedKeyIds(a.body)) revokeSubject("vk", id)
      }
    }
  }
  ops.recordChange(gate.actor, req, path, r.status, body)
  if (req.method !== "GET" && r.status < 300) ops.storeUpdated(path)
  if (ops.store.fileSha !== genBefore) await ops.settleConfig()
  const h: Record<string, string> = new Map()
  h.set("content-type", r.contentType)
  // a 204 has no body (a response with one would be refused)
  return new Response(r.status === 204 ? undefined : r.body, { status: r.status, headers: h })
}

function mcpView(engine: Engine): Response {
  const m = engine.mcp
  if (m === undefined) return new Response(`{"clients":[]}`, { headers: { "content-type": "application/json" } })
  return Response.json({ clients: m.status() })
}

// A handler's reply as an HTTP response.
function replyResponse(r: Reply): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", r.contentType)
  return new Response(r.body, { status: r.status, headers: h })
}

function cacheView(engine: Engine): Response {
  const c = engine.cache
  if (c === undefined) return Response.json({ enabled: false, entries: 0, hits: 0, misses: 0 })
  return Response.json({ enabled: true, entries: c.entries.size, hits: c.hits, misses: c.misses })
}

// What browsers may read cross-origin: the gateway's own headers (Bifrost's list).
const EXPOSED = "x-bifrost-request-id, x-bifrost-trace-id, x-request-id, x-bifrost-provider, x-bifrost-original-model, x-bifrost-resolved-model, x-bifrost-fallback-index, x-bifrost-request-type, x-bifrost-upstream-latency-ms, x-bifrost-routing-info-provider, x-bifrost-routing-info-model, x-bifrost-routing-info-key, x-bifrost-routing-info-alias-model-id, x-bifrost-routing-info-alias-model-name, x-bifrost-routing-info-alias-model-family, x-bifrost-routing-info-is-fallback, x-bifrost-routing-info-primary-provider, x-bifrost-routing-info-primary-model, x-bifrost-routing-info-server-side-fallback-model, x-bifrost-routing-info-requested-provider, x-bifrost-routing-info-requested-model, x-bifrost-cache-hit, x-bifrost-cache-id, x-bifrost-cache-hit-type, x-bifrost-cache-hit-latency-ms, x-bifrost-cache-requested-provider, x-bifrost-cache-requested-model, x-bifrost-cache-similarity, x-bifrost-cache-threshold, x-bifrost-cache-provider-used, x-bifrost-cache-model-used, x-bifrost-cache-input-tokens, x-bifrost-latency-ms, x-bifrost-pricing-request-type, x-bifrost-converted-request-type, x-bifrost-dropped-compat-params, x-bifrost-dropped-unsupported-tools, x-bifrost-passthrough-path, x-bifrost-error-type, x-bifrost-retry-after-ms, x-bf-cache, x-bf-attempts, x-bf-fallback-used, x-bf-overhead-us"

// Adds the CORS headers for an allowed origin. Response headers are a copy in Tov, so the
// response is rebuilt: a streamed body stays a stream, any other body is carried as bytes.
async function cors(engine: Engine, req: Request, res: Response): Promise<Response> {
  const origins = engine.cfg.client?.allowed_origins ?? []
  const origin = req.headers.get("origin")
  if (origin === undefined || origins.length === 0) return res
  if (!origins.includes("*") && !origins.includes(origin)) return res
  const h: Record<string, string> = new Map()
  res.headers.forEach((v, k) => {
    if (k !== "content-length") h.set(k, v)
  })
  h.set("access-control-allow-origin", origin)
  h.set("access-control-expose-headers", EXPOSED)
  h.set("vary", "origin")
  const st = res.body
  if (st !== undefined && st.pushed) return new Response(st, { status: res.status, headers: h })
  let bytes: u8[] = []
  try {
    bytes = await res.bytes()
  } catch (e) {
    bytes = []
  }
  return new Response(res.status === 204 ? undefined : bytes, { status: res.status, headers: h })
}

export type ServeOptions = { port: int, hostname: string, workers: int, maxBodyBytes?: int, limits: ServerLimits }

// A running server, for the graceful stop (lifecycle.tov): its address, closing its listener, and the connections
// this process still holds.
export type Served = { url: string, stopListener: () => void, open: () => int }

// GET /ready: 503 while this process drains for a stop, or when a store that is on could not open; /health stays
// the liveness answer (always ok while the process serves).
function readyResponse(engine: Engine, ops: Ops): Response {
  const cfg = engine.cfg
  const saveError = ops.store.saveError
  const r = readyReport(readyInput(lifecycle().draining, saveError === "" ? "" : `save failed: ${saveError}`, cfg.logs_store?.enabled === true, engine.logStore !== undefined, cfg.audit?.enabled === true, ops.audit !== undefined))
  return new Response(r.body, { status: r.status, headers: { "content-type": "application/json" } })
}

// The servers' own cap, so the gateway's checks (which follow the config) decide.
export const NO_BODY_LIMIT = 1099511627776

// The request-body limits of the current config, read per request or connection so a reload moves them:
// client.max_request_body_size_mb, and the size over which a body reaches the gateway as a stream
// (large_payload_optimization's request threshold; the limit itself while the feature is off, so a body over it
// is refused unread).
export function bodyLimits(engine: Engine): { limit: int, threshold: int } {
  const limit = (engine.cfg.client?.max_request_body_size_mb ?? 100) * 1048576
  const lp = engine.large
  return { limit: limit, threshold: lp === undefined ? Math.max(1, limit) : Math.max(1, lp.requestThreshold) }
}

// client.max_request_body_size_mb is checked here, not by the server: a declared length over the
// limit is refused unread, and a body with no length is read as far as the limit and refused when it
// is over. undefined means refused; otherwise the request to dispatch (rebuilt around its bytes when
// they were read here).
export async function limitedBody(req: Request, maxBytes: int): Promise<Request | undefined> {
  if (req.method === "GET" || req.method === "HEAD") return req
  const declared = req.headers.get("content-length")
  if (declared !== undefined) {
    const n = parseFloat(declared) ?? 0.0
    return n > maxBytes ? undefined : req
  }
  const st = req.body
  if (st === undefined) return req
  const body: u8[] = []
  try {
    while (true) {
      const r = await st.pull()
      const v = r.value
      if (r.done || v === undefined) break
      for (const b of v) body.push(b)
      if (body.length > maxBytes) {
        await st.cancel()
        return undefined
      }
    }
  } catch (e) {
    // a body cut off reads as what arrived
  }
  return new Request(req.url, { method: req.method, headers: snapshot(req.headers), body: body })
}

// large_payload_optimization (largepayload.tov) at the front of a server: the Response that refuses or
// serves a request whose body is big, the Request to go on with (its body was read, or is small), or
// undefined for a request the feature does not touch.
export async function largeFront(engine: Engine, req: Request): Promise<Response | Request | undefined> {
  const lp = engine.large
  if (lp === undefined || req.method !== "POST" || (req.headers.get("x-bf-async") ?? "") !== "") return undefined
  const u = URL.parse(req.url)
  const p = u === undefined ? "" : u.pathname
  // a deployment path names its model in the URL, not in the body: it is read whole
  if (deploymentRoute(p) !== undefined) return undefined
  const cp = compatPath(p)
  const route = largeRoute(cp)
  if (route !== "") {
    const r = await engine.largeRequest(req, route, p)
    if (r instanceof Response) return await echoRequestId(req, await cors(engine, req, r))
    return r
  }
  // a multipart upload: audio, image edits and variations, files
  if (!(req.headers.get("content-type") ?? "").toLowerCase().includes("multipart/form-data")) return undefined
  const mr = matchRoute("POST", cp)
  if (mr === undefined || (mr.modelIn !== "form" && mr.op !== "files.create")) return undefined
  if (engine.gov.enforce && engine.gov.findKey(snapshot(req.headers)) === undefined) {
    return await echoRequestId(req, await cors(engine, req, errorResponse(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", noHeaders())))
  }
  // an audio upload is billed as its answer comes back (mediaAnswer); a request handed on whole is billed there
  const bill = billedMedia(mr.op) ? engine.mediaBill(snapshot(req.headers)) : undefined
  const started = performance.now()
  const m = await handleMediaLarge(engine.cfg, req, mr, lp, bill, async (oc: OAuthKeyConfig, pc: ProviderConfig) => await engine.oauthToken(oc, pc))
  if (m instanceof Response) {
    const answered = bill === undefined ? m : await engine.mediaAnswer(mr, bill, m, snapshot(req.headers), started, req.headers.get("x-request-id") ?? newId("req_"))
    return await echoRequestId(req, await cors(engine, req, answered))
  }
  return m
}

function textResponse(body: string, contentType: string): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", contentType)
  return new Response(body, { headers: h })
}

// A file of the web UI (the embedded build, or the directory RAIJU_UI_DIR names). The page
// is revalidated on each load; the hashed files under /assets/ are cached for good.
function uiResponse(p: string, req: Request): Response | undefined {
  const r = serveUi(p, req.headers.get("if-none-match") ?? "", req.headers.get("accept-encoding") ?? "", process.env.RAIJU_UI_DIR ?? "")
  if (r === undefined) return undefined
  const h: Record<string, string> = new Map()
  h.set("content-type", r.contentType)
  h.set("cache-control", r.cache)
  h.set("etag", r.etag)
  h.set("vary", "accept-encoding")
  h.set("x-content-type-options", "nosniff")
  if (r.encoding !== "") h.set("content-encoding", r.encoding)
  if (r.contentType.startsWith("text/html")) {
    h.set("content-security-policy", UI_CSP)
    h.set("referrer-policy", "no-referrer")
    h.set("x-frame-options", "DENY")
  }
  if (r.status === 304) return new Response(undefined, { status: 304, headers: h })
  if (r.binary) return new Response(r.bytes, { headers: h })
  return new Response(r.text, { headers: h })
}

const CHAT_PATHS = ["/v1/chat/completions", "/openai/v1/chat/completions", "/openai/chat/completions"]

// LiteLLM and LangChain clients pointed at the gateway: /litellm/... and /langchain/...
// are the same routes without the prefix.
export function compatPath(p: string): string {
  if (p.startsWith("/litellm/")) return sdkPath(p.slice(8))
  if (p.startsWith("/langchain/")) return sdkPath(p.slice(10))
  if (p.startsWith("/pydanticai/")) return sdkPath(p.slice(11))
  // Cursor's routes are the same families under /cursor (its chat is served by dispatch: cursorChat)
  if (p.startsWith("/cursor/") && !isCursorChat(p)) return compatPath(p.slice(7))
  // the OpenAI SDK pointed at /openai: every /v1 route under /openai/v1
  if (p.startsWith("/openai/v1/") && p !== "/openai/v1/realtime") return p.slice(7)
  // Azure-style deployments: the /v1 route of the operation (dispatch sets the model)
  const dep = deploymentRoute(p)
  if (dep !== undefined) return dep.path
  // the same family mounted without the version segment (Bifrost mounts both): /openai/responses is /v1/responses
  if (isUnversionedOpenAI(p)) return "/v1" + p.slice(7)
  return p
}

// The SDK prefixes mount the decisions route without the version segment too (Bifrost's /litellm/decisions),
// so /decisions under a prefix is /v1/decisions. A bare /decisions is not a route, as in Bifrost.
function sdkPath(p: string): string {
  const cp = compatPath(p)
  return cp === "/decisions" ? "/v1/decisions" : cp
}

function isCursorChat(p: string): bool {
  return p === "/cursor/v1/chat/completions" || p === "/cursor/chat/completions"
}

// /openai/{responses, embeddings, completions, models, files, batches, realtime, ...} with no /v1 segment.
function isUnversionedOpenAI(p: string): bool {
  return p.startsWith("/openai/") && p.byteLength > 8 && !p.startsWith("/openai/v1/") && !p.startsWith("/openai/deployments/")
}

async function unprefixed(req: Request, p: string): Promise<Request> {
  const q = req.url.indexOf("?")
  const u = URL.parse(req.url)
  const origin = u === undefined ? "http://localhost" : u.origin
  const url = origin + p + (q < 0 ? "" : req.url.slice(q))
  const hs: Record<string, string> = snapshot(req.headers)
  if (req.method === "GET" || req.method === "HEAD") return new Request(url, { method: req.method, headers: hs })
  // bytes, so multipart uploads (audio files, images) pass intact
  let body: u8[] = []
  try {
    body = await req.bytes()
  } catch (e) {
    body = []
  }
  return new Request(url, { method: req.method, headers: hs, body: body })
}

// Every HTTP route except the WebSocket upgrade, in one function so both
// servers (http1 for streaming, Bun.serve as the fallback) share it.
// Bifrost's tracing middleware answers with the caller's x-request-id. Inference routes set it from the
// id they log under; every other route echoes the caller's id here.
async function echoRequestId(req: Request, res: Response): Promise<Response> {
  const id = req.headers.get("x-request-id") ?? ""
  if (id === "" || (res.headers.get("x-request-id") ?? "") !== "") return res
  const h: Record<string, string> = new Map()
  res.headers.forEach((v, k) => {
    if (k !== "content-length") h.set(k, v)
  })
  h.set("x-request-id", id)
  const st = res.body
  if (st !== undefined && st.pushed) return new Response(st, { status: res.status, headers: h })
  let bytes: u8[] = []
  try {
    bytes = await res.bytes()
  } catch (e) {
    bytes = []
  }
  return new Response(res.status === 204 ? undefined : bytes, { status: res.status, headers: h })
}

export async function dispatch(engine: Engine, ops: Ops, req: Request): Promise<Response> throws TypeError {
  const res = try await routes(engine, ops, req)
  return await echoRequestId(req, await markAgentRejection(engine, req, res))
}

// The CLI that signs in with an identity credential sends it as a bearer token, with x-bf-agent-vk-id
// when it has picked a key. When the gateway refuses that credential (a 401), x-bf-agent-auth tells the
// client to sign in again; a refusal for any other reason (a 403 for a model, a budget) carries no mark.
export async function markAgentRejection(engine: Engine, req: Request, res: Response): Promise<Response> {
  if (res.status !== 401) return res
  if ((res.headers.get("x-bf-agent-auth") ?? "") !== "") return res
  const h = snapshot(req.headers)
  const auth = h.get("authorization") ?? ""
  if (!auth.startsWith("Bearer ")) return res
  const agentClient = h.get("x-bf-agent-vk-id") !== undefined || h.get("x-bifrost-agent") !== undefined || auth.startsWith("Bearer ck-bf-agent-")
  if (!agentClient) return res
  // a credential the gateway accepts (a key, or an identity) was not what it refused
  if (engine.gov.findKey(h) !== undefined) return res
  const alt = engine.gov.altAuth
  if (alt !== undefined && alt(h)) return res
  const st = res.body
  if (st !== undefined && st.pushed) return res
  const hs: Record<string, string> = new Map()
  res.headers.forEach((v, k) => {
    if (k !== "content-length") hs.set(k, v)
  })
  hs.set("x-bf-agent-auth", "rejected")
  let bytes: u8[] = []
  try {
    bytes = await res.bytes()
  } catch (e) {
    bytes = []
  }
  return new Response(bytes, { status: res.status, headers: hs })
}

async function routes(engine: Engine, ops: Ops, req0: Request): Promise<Response> throws TypeError {
  const req = await withExtraParams(req0)
  // the compat plugin reads a model's datasheet row through the same handler as GET /api/models/parameters
  if (engine.paramsLookup === undefined) {
    engine.paramsLookup = async (model: string): Promise<string | undefined> => {
      const sp = new URLSearchParams("")
      sp.set("model", model)
      const r = await ops.modelParameters(new Request("http://raiju.internal/api/models/parameters?" + sp.toString()))
      return r.status === 200 ? r.body : undefined
    }
  }
  const u = URL.parse(req.url)
  const p = u === undefined ? "" : u.pathname
  const m = req.method
  // x-bf-async on an inference route: the request runs as a job, and the caller polls it (Bifrost's integration routes).
  // The A2A gateway is not an inference route: its JSON-RPC calls are answered directly.
  if (m === "POST" && (req.headers.get("x-bf-async") ?? "") !== "" && !p.startsWith("/api/") && !p.startsWith("/v1/async/") && p !== "/mcp" && !p.startsWith("/agents/a2a/")) {
    const again: Dispatch = async (r) => try await dispatch(engine, ops, r)
    const route = compatPath(p)
    return await sdkAsyncSubmit(engine.jobs, req, again, route.slice(1, route.byteLength))
  }
  const dep = deploymentRoute(p)
  if (dep !== undefined && m === "POST") return try await dispatch(engine, ops, await deploymentRequest(req, dep))
  // OpenAI's own decisions route (under /openai and the SDK prefixes) answers in OpenAI's shape, so it is told apart
  // before the path loses its prefix
  if (m === "POST" && openaiDecisionPath(p)) return await cors(engine, req, await decisionRoute(engine, req, "/openai/v1/decisions"))
  const cp = compatPath(p)
  if (cp !== p) return try await dispatch(engine, ops, await unprefixed(req, cp))
  const segs = p.split("/")
  // SCIM 2.0 provisioning from the identity provider, behind its own bearer token (scim.tov)
  if (p === "/scim/v2" || p.startsWith("/scim/v2/")) return await scimRoute(ops, req, p)
  // the A2A gateway: an agent's card and its JSON-RPC endpoint (agents.tov); the caller's virtual key is checked there
  if (p === "/agents/a2a" || p === "/agents/a2a/" || p === "/agents/a2a" + CARD_PATH) return await ops.a2aAggregate(req, publicBase(engine.cfg.client?.a2a_external_client_url, req.url))
  if (p.startsWith("/agents/a2a/") && segs.length >= 5) return await ops.a2aRoute(req, segs[3]!, "/" + segs.slice(4).join("/"), publicBase(engine.cfg.client?.a2a_external_client_url, req.url))
  if (p === "/mcp") return await ops.mcp(req, undefined)
  if (p.startsWith("/mcp/") && segs.length === 3) return await ops.mcp(req, segs[2]!)
  // the Anthropic SDK's batch, file and model routes: before the generic media routes
  const sr = sdkRoute(m, p)
  if (sr !== undefined) {
    if (engine.gov.enforce && engine.gov.findKey(snapshot(req.headers)) === undefined) {
      return errorResponse(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", noHeaders())
    }
    // a batch's creation runs the plugins' LLM hooks (Bifrost's batch_create), and so do the other batch and file calls
    if (sr.op === "batches.create") return await cors(engine, req, try await llmHooked(engine, req, "batch_create", async (r, s) => await anthropicSdk(engine.cfg, r), undefined))
    const aop = storageOp(sr.op)
    if (aop !== "") {
      const call: StorageCall = { op: aop, provider: headerOr(req, "x-model-provider", "anthropic"), idKey: idKeyOf(aop), id: sr.id, pathFor: (nid: string): string => pathWithId(p, sr.id, nid) }
      return await cors(engine, req, try await storageHooked(engine, req, call, async (r, s) => await anthropicSdk(engine.cfg, r)))
    }
    return await cors(engine, req, await outOfLine(anthropicSdk(engine.cfg, req)))
  }
  // the GenAI SDK's files, batches, cached contents, operations, :predict and rank
  const gop = genaiIn.genaiRoute(m, p)
  if (gop !== undefined) {
    // the batch and file calls run the plugins' LLM hooks (a resumable upload's protocol does not)
    const gsop = gop.op === "files.upload" ? "" : storageOp(gop.op)
    if (gsop !== "" && gsop !== "batch_create") {
      const call: StorageCall = { op: gsop, provider: headerOr(req, "x-model-provider", "gemini"), idKey: idKeyOf(gsop), id: gop.id, pathFor: (nid: string): string => pathWithId(p, gop.id, nid) }
      return await cors(engine, req, try await storageHooked(engine, req, call, async (r, s) => {
        const rp = pathOfReq(r)
        const g2 = genaiIn.genaiRoute(r.method, rp)
        if (g2 === undefined) return errorResponse(404, `no route for ${r.method} ${rp}`, "invalid_request_error", noHeaders())
        return await genaiSdk(engine, r, g2.op, g2.model, g2.id)
      }))
    }
    return await cors(engine, req, await outOfLine(genaiSdk(engine, req, gop.op, gop.model, gop.id)))
  }
  // Bedrock's jobs and S3 files, and Vertex's regional batch and cache paths: the provider's own bodies
  const nr = nativeRoute(m, p)
  if (nr !== undefined) {
    if (engine.gov.enforce && engine.gov.findKey(snapshot(req.headers)) === undefined) {
      return errorResponse(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", noHeaders())
    }
    if (nr.kind === "bedrock.create") {
      // a model invocation job's creation runs the plugins' LLM hooks (Bifrost's batch_create)
      const hookedJob = try await llmHooked(engine, req, "batch_create", async (r, s) => {
        try {
          return try await nativeCloud(engine.cfg, r, nr)
        } catch (e) {
          return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
        }
      }, undefined)
      return await cors(engine, req, hookedJob)
    }
    // the other job, file and batch calls run the plugins' LLM hooks as Bifrost's batch_* and file_* requests
    const ns = nativeStorage(nr)
    if (ns !== undefined) {
      const call: StorageCall = { op: ns.op, provider: ns.provider, idKey: idKeyOf(ns.op), id: ns.id, pathFor: (nid: string): string => ns.s3 ? s3Path(nid) : pathWithId(p, ns.id, nid) }
      return await cors(engine, req, try await storageHooked(engine, req, call, async (r, s) => {
        const rp = pathOfReq(r)
        const n2 = nativeRoute(r.method, rp)
        if (n2 === undefined) return errorResponse(404, `no route for ${r.method} ${rp}`, "invalid_request_error", noHeaders())
        try {
          return try await nativeCloud(engine.cfg, r, n2)
        } catch (e) {
          return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
        }
      }))
    }
    return try await cors(engine, req, try await nativeCloud(engine.cfg, req, nr))
  }
  const lc = contentId(p)
  if (lc !== "" && m === "GET") return await liveContent(engine, ops.liveSessions, req, lc)
  if (m === "POST" && (p === "/v1/live/sessions" || p === "/openai/live/sessions")) return await cors(engine, req, await liveCreate(engine, ops.liveSessions, req))
  if (m === "GET" || m === "HEAD") {
    // x-bf-async-id on an inference route: poll the job that route created
    const aid = req.headers.get("x-bf-async-id") ?? ""
    if (aid !== "" && !p.startsWith("/api/")) return sdkAsyncPoll(engine.jobs, p.slice(1, p.byteLength), aid)
    if (p === "/health") return Response.json({ status: "ok" })
    if (p === "/ready") return readyResponse(engine, ops)
    if (uiPath(p)) {
      const ui = uiResponse(p, req)
      if (ui !== undefined) return ui
    }
    if (p === "/metrics") return textResponse(ops.metricsText(), "text/plain; version=0.0.4")
    if (p === "/v1/models" || p === "/openai/v1/models") return await cors(engine, req, await listModels(engine, req))
    if (p.startsWith("/v1/models/")) return await cors(engine, req, await outOfLine(retrieveModel(engine, req, p.slice(11))))
    if (p === "/typesafe/v1/models") return await cors(engine, req, await decisionRoute(engine, req, p))
    if (p === "/genai/v1beta/models") return await cors(engine, req, await outOfLine(genaiModels(engine, "")))
    if (p.startsWith(GENAI)) return await cors(engine, req, await outOfLine(genaiModels(engine, p.slice(GENAI.byteLength))))
    const poll = asyncPoll(p)
    if (poll !== undefined) return asyncGet(engine.jobs, poll.op, poll.id)
    if (p === "/api/cache") return ops.check(req, p) ?? cacheView(engine)
    if (p === "/api/logs" || p === "/api/logs/stats") {
      const cs = ops.checkScope(req, p)
      return cs.res ?? replyResponse(ops.logsRoute(req, p, "", cs.scope))
    }
    // self-service: the virtual key in the request is the credential, so no admin session is checked
    if (p === "/api/governance/virtual-keys/quota") return replyResponse(ops.vkQuota(req))
    if (p === "/api/governance/usage") return ops.check(req, p) ?? Response.json({ budgets: engine.gov.budgetUsage() })
    if (p === "/api/mcp") return ops.check(req, p) ?? mcpView(engine)
    if (p === "/api/health") return ops.check(req, p) ?? Response.json({ targets: engine.health.snapshot(Date.now()) })
  }
  if (m === "POST") {
    if (CHAT_PATHS.includes(p)) return await cors(engine, req, await engine.chat(req))
    // the plugins' LLM hooks run on each of these request types (pluginroute.tov llmHooked)
    if (p === "/v1/embeddings" || p === "/openai/v1/embeddings") return await cors(engine, req, try await llmHooked(engine, req, "embeddings", async (r, s) => await engine.embeddings(r), undefined))
    if (p === "/v1/completions" || p === "/openai/v1/completions") return await cors(engine, req, try await llmHooked(engine, req, "completions", async (r, s) => await engine.completions(r), undefined))
    if (p === "/v1/responses" || p === "/openai/v1/responses") return await cors(engine, req, try await llmHooked(engine, req, "responses", async (r, s) => await responsesApi(engine, r), undefined))
    if (p === "/v1/rerank") return await cors(engine, req, try await llmHooked(engine, req, "rerank", async (r, s) => await rerank(engine, r), undefined))
    if (p === "/v1/decisions" || p === "/openai/v1/decisions" || p === "/typesafe/v1/systemone") return await cors(engine, req, await decisionRoute(engine, req, p))
    if (p === "/bedrock/rerank") return await cors(engine, req, await bedrockRerank(engine, req))
    if (p === "/v1/count_tokens") return await cors(engine, req, await countTokens(engine, req, false))
    if (p === "/anthropic/v1/messages/count_tokens") return await cors(engine, req, await countTokens(engine, req, true))
    if (p === "/anthropic/v1/messages") return await cors(engine, req, await anthropicMessages(engine, req))
    if (p === "/anthropic/v1/complete") return await cors(engine, req, await anthropicLegacy(engine, req))
    if (isCursorChat(p)) return await cors(engine, req, await cursorChat(engine, req))
    // a WebRTC realtime call is terminated on the gateway's own peer (realtimecalls.tov)
    if (p === "/v1/realtime/calls") return await cors(engine, req, await realtimeCall(engine, req, true))
    if (p === "/v1/realtime" || p === "/openai/v1/realtime") return await cors(engine, req, await realtimeCall(engine, req, false))
    // a realtime client secret is minted under the caller's virtual key and handed back as the gateway's own (rtsession.tov)
    if (MINT_ROUTES.includes(p)) return await cors(engine, req, await realtimeMint(engine, req, p))
    if (p === "/v1/mcp/tool/execute") return await cors(engine, req, await engine.executeTool(req))
    if (p === "/cohere/v2/chat") return await cors(engine, req, await cohereChat(engine, req))
    if (p === "/cohere/v2/embed") return await cors(engine, req, await cohereEmbed(engine, req))
    if (p === "/cohere/v2/rerank") return await cors(engine, req, await cohereRerank(engine, req))
    if (p === "/cohere/v1/tokenize") return await cors(engine, req, await cohereTokenize(engine, req))
    if (p.startsWith(GENAI)) return await cors(engine, req, await genai(engine, req, p.slice(GENAI.byteLength)))
    if (p.startsWith("/bedrock/model/") && segs.length === 5) return await cors(engine, req, await bedrockModel(engine, req, segs[3]!, segs[4]!))
    if (p.startsWith("/v1/async/")) return await asyncSubmitHooked(engine.cfg.webhooks, engine.jobs, req, p, dispatcher(engine), (engine.cfg.client?.async_job_result_ttl ?? 3600) * 1000)
  }
  // the management API: providers, keys, virtual keys, budgets, rate limits, teams, customers
  if (p === "/api/cluster/sync" && m === "POST") return await ops.clusterSync(req)
  if (p === "/api/cluster/feed" && m === "POST") return await ops.clusterFeed(req)
  if (p === "/api/cluster/leader" && m === "GET") return ops.clusterLeader(req)
  if (p === "/api/cluster/config" && m === "POST") return await ops.clusterConfig(req)
  if (p.startsWith("/api/oidc/") && m === "GET") return await ops.oidcRoute(req, p)
  // the MCP OAuth callback: the browser comes back here from the authorization server, with no session
  if (p === "/api/oauth/callback" && m === "GET") {
    const cu = URL.parse(req.url)
    const cb = await oauthCallback(ops.store, cu === undefined ? new URLSearchParams("") : cu.searchParams)
    return new Response(cb.html, { status: cb.status, headers: { "content-type": "text/html; charset=utf-8" } })
  }
  // the MCP authorization server (client.mcp_server_auth_mode both or oauth): discovery, registration, the
  // authorize and token endpoints, the consent pages, and the per-user connect page
  // the consent page offers session mode to a signed-in dashboard user and user mode to a signed-in identity-provider
  // user (read only on the consent routes and the token endpoint)
  const cc = ops.consentContext(req, p.startsWith("/api/oauth2/consent/flows/") || p === "/oauth2/token")
  const ia = await issuerRoute(engine.cfg, req, p, (v) => keyByValue(engine, v), (id) => keyById(engine.cfg, id), Date.now(), cc)
  if (ia !== undefined) return ia
  // login and logout come before the gate: they are how a caller gets past it
  if (p.startsWith("/api/session/")) return await ops.sessionRoute(req, p)
  if (p.startsWith("/api/")) return await outOfLine(manage(ops, req, p))
  // a provider's own API, raw: the key's auth, the rest as the caller sent it (passthrough.tov)
  if (passthroughPath(p)) {
    if (engine.gov.enforce && engine.gov.findKey(snapshot(req.headers)) === undefined) {
      return errorResponse(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", noHeaders())
    }
    return try await passthroughRoute(engine.cfg, req, async (oc: OAuthKeyConfig, pc: ProviderConfig) => await engine.oauthToken(oc, pc))
  }
  // audio, images, files and batches: passed through to OpenAI-compatible providers
  const media = matchRoute(m, p)
  if (media !== undefined) {
    if (engine.gov.enforce && engine.gov.findKey(snapshot(req.headers)) === undefined) {
      return errorResponse(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", noHeaders())
    }
    if (media.op === "responses.input_tokens") {
      // another provider's model is counted with that provider's count (extras.tov); an OpenAI-format one goes on
      const text = await req.text()
      const counted = await responsesInputTokens(engine, req, text)
      if (counted !== undefined) return await cors(engine, req, counted)
      const hs: Record<string, string> = new Map()
      req.headers.forEach((v, key) => {
        if (key !== "content-length" && key !== "transfer-encoding") hs.set(key, v)
      })
      return try await engine.media(new Request(req.url, { method: "POST", headers: hs, body: text }), media)
    }
    const lk = kindOfPath(m, p)
    if (lk !== undefined) return try await llmHooked(engine, req, lk.op, async (r, s) => try await engine.media(r, media), undefined)
    // the OpenAI files and batches calls run the plugins' LLM hooks as Bifrost's file_* and batch_* requests
    const mop = storageOp(media.op)
    if (mop !== "") {
      const u0 = URL.parse(req.url)
      const id = mop.endsWith("_list") || mop === "file_upload" || mop === "batch_create" ? "" : segmentId(p, 3)
      const call: StorageCall = { op: mop, provider: providerFor(snapshot(req.headers), u0 === undefined ? new URLSearchParams("") : u0.searchParams), idKey: idKeyOf(mop), id: id, pathFor: (nid: string): string => pathWithId(p, id, nid) }
      return try await storageHooked(engine, req, call, async (r, s) => {
        const rp = pathOfReq(r)
        const mr = matchRoute(r.method, rp)
        if (mr === undefined) return errorResponse(404, `no route for ${r.method} ${rp}`, "invalid_request_error", noHeaders())
        return try await engine.media(r, mr)
      })
    }
    return try await engine.media(req, media)
  }
  if (m === "OPTIONS") {
    const res = new Response(undefined, { status: 204, headers: { "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS", "access-control-allow-headers": "*", "access-control-max-age": "86400" } })
    return await cors(engine, req, res)
  }
  return errorResponse(404, `no route for ${m} ${p}`, "invalid_request_error", noHeaders())
}

// ---- the batch and file calls through the plugins' LLM hooks (pluginroute.tov storageHooked) ----

// A request header, or a default when it is absent or empty.
function headerOr(r: Request, name: string, dflt: string): string {
  const v = r.headers.get(name) ?? ""
  return v === "" ? dflt : v
}

// The member a batch or file request's id goes in.
function idKeyOf(op: string): string {
  return op.startsWith("file_") ? "file_id" : "batch_id"
}

// A request's path.
function pathOfReq(r: Request): string {
  const u = URL.parse(r.url)
  return u === undefined ? "" : u.pathname
}

// The path segment at i, its %XX escapes undone ("" when there is none).
function segmentId(p: string, i: int): string {
  const s = p.split("/")[i] ?? ""
  if (!s.includes("%")) return s
  return new URLSearchParams("s=" + s.replaceAll("+", "%2B")).get("s") ?? s
}

// The S3 object of an s3://bucket/key file id as its /bedrock/files path.
function s3Path(id: string): string {
  const rest = id.startsWith("s3://") ? id.slice(5) : id
  const i = rest.indexOf("/")
  if (i < 0) return "/bedrock/files/" + bedrock.encodeSegment(rest)
  const keyParts: string[] = []
  for (const part of rest.slice(i + 1).split("/")) keyParts.push(bedrock.encodeSegment(part))
  return "/bedrock/files/" + bedrock.encodeSegment(rest.slice(0, i)) + "/" + keyParts.join("/")
}

// The Bifrost request a native cloud call is (Bedrock's model invocation jobs and S3 files, Vertex's batch prediction
// jobs; Vertex's cached contents are not batch or file calls), or undefined. s3: the id is the object's s3:// URI.
function nativeStorage(nr: NativeRoute): { op: string, provider: string, id: string, s3: bool } | undefined {
  if (nr.kind === "bedrock.list") return { op: "batch_list", provider: "bedrock", id: "", s3: false }
  if (nr.kind === "bedrock.get") return { op: "batch_retrieve", provider: "bedrock", id: nr.id, s3: false }
  if (nr.kind === "bedrock.stop") return { op: "batch_cancel", provider: "bedrock", id: nr.id, s3: false }
  if (nr.kind === "bedrock.files.list") return { op: "file_list", provider: "bedrock", id: "", s3: false }
  if (nr.kind === "bedrock.files.object") {
    const uri = `s3://${nr.bucket}/${nr.key}`
    if (nr.method === "PUT") return { op: "file_upload", provider: "bedrock", id: uri, s3: true }
    if (nr.method === "GET") return { op: "file_content", provider: "bedrock", id: uri, s3: true }
    if (nr.method === "HEAD") return { op: "file_retrieve", provider: "bedrock", id: uri, s3: true }
    if (nr.method === "DELETE") return { op: "file_delete", provider: "bedrock", id: uri, s3: true }
    return undefined
  }
  if (nr.kind === "vertex.create") return { op: "batch_create", provider: "vertex", id: "", s3: false }
  if (nr.kind === "vertex.list") return { op: "batch_list", provider: "vertex", id: "", s3: false }
  if (nr.kind === "vertex.get") return { op: "batch_retrieve", provider: "vertex", id: nr.id, s3: false }
  if (nr.kind === "vertex.cancel") return { op: "batch_cancel", provider: "vertex", id: nr.id, s3: false }
  if (nr.kind === "vertex.delete") return { op: "batch_delete", provider: "vertex", id: nr.id, s3: false }
  return undefined
}

// The virtual key a value names, its rotation cooldown included (the governance lookup of a header value).
function keyByValue(engine: Engine, value: string): VirtualKeyConfig | undefined {
  const h: Hdrs = new Map()
  h.set("x-bf-vk", value)
  return engine.gov.findKey(h)
}

// The routes that can stream, by kind: the kind picks the handler (routeStream).
export function streamKind(p: string): string {
  if (CHAT_PATHS.includes(p)) return "openai"
  if (p === "/v1/completions") return "completions"
  if (p === "/v1/responses") return "responses"
  if (p === "/anthropic/v1/messages") return "anthropic"
  if (p === "/cohere/v2/chat") return "cohere"
  if (p.startsWith(GENAI) && p.endsWith(":streamGenerateContent")) return "genai"
  if (p.startsWith("/bedrock/model/") && (p.endsWith("/converse-stream") || p.endsWith("/invoke-with-response-stream"))) return "bedrock"
  if (p === "/anthropic/v1/complete") return "legacy"
  if (isCursorChat(p)) return "cursor"
  return ""
}

// Whether a streamed route streams this request: GenAI and Bedrock stream routes are named by
// their path; the others take "stream": true in the body.
export function streamsRequest(kind: string, text: string): bool {
  if (kind === "") return false
  if (kind === "genai" || kind === "bedrock") return true
  if (!text.includes("\"stream\"")) return false
  try {
    return rawBool(fields(text), "stream") ?? false
  } catch (e) {
    return false
  }
}

// The answer of a route kind; streamed into sink when there is one.
export async function routeStream(engine: Engine, req: Request, kind: string, sink?: StreamSink): Promise<Response> {
  return await markAgentRejection(engine, req, await routeStreamInner(engine, req, kind, sink))
}

// x-bf-passthrough-extra-params: true on an inference route (not a raw passthrough, not a large body, which never
// gets here): the body's extra_params object is merged into the request before any route reads it (extraparams.tov),
// and rides along (EXTRA_PARAMS_CARRY) to be merged into the provider's converted body as well, as Bifrost merges it.
export async function withExtraParams(req: Request): Promise<Request> {
  if (req.method !== "POST" || req.headers.get(EXTRA_PARAMS_HEADER) !== "true") return req
  if ((req.headers.get("content-type") ?? "").toLowerCase().includes("multipart/")) return req
  const u = URL.parse(req.url)
  const p = u === undefined ? "" : u.pathname
  if (!isInferencePath(p) || passthroughPath(p)) return req
  let text = ""
  try {
    text = await req.text()
  } catch (e) {
    return req
  }
  const hs: Record<string, string> = new Map()
  req.headers.forEach((v, k) => {
    if (k !== "content-length" && k !== "transfer-encoding" && k !== EXTRA_PARAMS_CARRY) hs.set(k, v)
  })
  const carry = extraParamsCarry(text)
  if (carry !== undefined) hs.set(EXTRA_PARAMS_CARRY, carry)
  return new Request(req.url, { method: "POST", headers: hs, body: mergeExtraParams(text) })
}

async function routeStreamInner(engine: Engine, req0: Request, kind: string, sink?: StreamSink): Promise<Response> {
  const req = await withExtraParams(req0)
  const u = URL.parse(req.url)
  const dep = deploymentRoute(u === undefined ? "" : u.pathname)
  if (dep !== undefined) return await routeStream(engine, await deploymentRequest(req, dep), kind, sink)
  const p = compatPath(u === undefined ? "" : u.pathname)
  if (kind === "anthropic") return await anthropicMessages(engine, req, sink)
  if (kind === "legacy") return await anthropicLegacy(engine, req, sink)
  if (kind === "cursor") return await cursorChat(engine, req, sink)
  if (kind === "cohere") return await cohereChat(engine, req, sink)
  if (kind === "genai") return await genai(engine, req, p.slice(GENAI.byteLength), sink)
  if (kind === "bedrock") {
    const segs = p.split("/")
    return await bedrockModel(engine, req, segs[3]!, segs[4]!, sink)
  }
  if (kind === "completions" || kind === "responses") {
    try {
      if (kind === "completions") return try await llmHooked(engine, req, "completions", async (r, s) => await engine.completions(r, s), sink)
      return try await llmHooked(engine, req, "responses", async (r, s) => await responsesApi(engine, r, s), sink)
    } catch (e) {
      return errorResponse(500, "internal error", "api_error", noHeaders())
    }
  }
  return await engine.chat(req, sink)
}

async function runChat(engine: Engine, req: Request, sink: StreamSink, head: LiveHead, kind: string, tr: TransportRun | undefined): Promise<void> {
  try {
    const r = await routeStream(engine, req, kind, sink)
    // never started streaming (an error, a cache hit, a non-streaming provider): the whole answer, through the HTTP post hooks
    if (!sink.started) head.give(await transportEnd(engine, tr, r))
  } catch (e) {
    head.give(errorResponse(500, "internal error", "api_error", noHeaders()))
  }
  // a stream that never opened: its body is unused (an opened one releases the head when it closes)
  if (!sink.started) head.release()
}

// A streamed route on Bun.serve: the answer is a ReadableStream body that gets each SSE event
// (or binary Bedrock frame) as the upstream produces it (needs Tov's stream bodies; see tov-patches/).
async function chatStreamed(engine: Engine, req: Request, kind: string, tr: TransportRun | undefined): Promise<Response> {
  const text = await req.text()
  const hs: Record<string, string> = snapshot(req.headers)
  const again = new Request(req.url, { method: "POST", headers: hs, body: text })
  if (!streamsRequest(kind, text)) return await cors(engine, req, await transportEnd(engine, tr, await routeStream(engine, again, kind)))
  const head = new LiveHead()
  const sink = headSink(head)
  const p = new Promise<Response>((resolve) => {
    head.resolve = resolve
  })
  // the plugins' chunk hooks see each event on its way to the client
  runChat(engine, again, transportSink(tr, sink), head, kind, tr)
  return await cors(engine, req, await p)
}

// One request through dispatch, with the plugins' HTTP post hooks on the answer.
async function hookedDispatch(engine: Engine, ops: Ops, req: Request, tr: TransportRun | undefined): Promise<Response, TypeError> {
  const res = try await dispatch(engine, ops, req)
  return await transportEnd(engine, tr, res)
}

// The base path of a WebSocket route. The OpenAI integration prefixes Bifrost registers for these
// routes map to the base path: /openai/v1/..., /openai/live/... and the Responses aliases.
export function wsBasePath(p: string): string {
  if (p.startsWith("/openai/v1/")) return p.slice(7)
  if (p.startsWith("/openai/live/")) return "/v1" + p.slice(7)
  if (p === "/openai/responses" || p === "/openai/openai/responses") return "/v1/responses"
  // the rest of the unversioned /openai family (/openai/realtime and the others)
  if (isUnversionedOpenAI(p)) return "/v1" + p.slice(7)
  return p
}

// What a WebSocket upgrade becomes: the session to open, a refusal (an HTTP answer), or no
// WebSocket route at all.
export type WsUpgrade = { kind: "none" } | { kind: "refused", status: int, message: string } | { kind: "session", session: Session }

function wsSession(req: Request, ext: SocketExt): Session {
  const s = new Session(req.url, snapshot(req.headers), "", "")
  s.ext = ext
  return s
}

// The route's session cap (websocket.max_connections_per_user) for a socket that counts against it.
function gated(ext: SocketExt, g: SocketGate): SocketExt {
  ext.gate = g
  return ext
}

// The WebSocket routes, for both servers: the realtime relay, the Responses API (GET /v1/responses),
// GPT Live (/v1/live/sessions and its attach) and the UI socket (/ws). A refusal is decided before
// the upgrade, so the client gets an HTTP status.
export function wsUpgrade(engine: Engine, ops: Ops, req: Request): WsUpgrade {
  const u = URL.parse(req.url)
  const p0 = u === undefined ? "" : u.pathname
  const p = wsBasePath(p0)
  if (p === "/v1/realtime" && req.method === "GET") {
    const up = prepare(engine, req)
    if (up.kind === "refused") return { kind: "refused", status: up.status, message: up.message }
    return { kind: "session", session: up.session }
  }
  if (req.method !== "GET") return { kind: "none" }
  const att = attachId(p)
  if (p !== "/v1/responses" && p !== "/v1/live/sessions" && p !== "/ws" && att === "") return { kind: "none" }
  const h = snapshot(req.headers)
  if (p === "/v1/responses") return { kind: "session", session: wsSession(req, gated(new ResponsesSocket(engine, h), engine.wsResponses)) }
  if (p === "/v1/live/sessions") return { kind: "session", session: wsSession(req, gated(new LiveSocket(engine, ops.liveSessions, h, ownerOf(engine, h), "", new Map()), engine.wsLive)) }
  if (att !== "") {
    if (!validId(att)) return { kind: "refused", status: 400, message: "a session id is required" }
    if (!credentialOk(engine, h)) return { kind: "refused", status: 401, message: "authentication is required for live sessions" }
    const owner = ownerOf(engine, h)
    if (!ops.liveSessions.allowed(att, owner)) return { kind: "refused", status: 404, message: "live session not found" }
    const up = attachUpstream(engine, h, att)
    if (up === undefined) return { kind: "refused", status: 404, message: "no OpenAI key is configured for live sessions" }
    return { kind: "session", session: wsSession(req, gated(new LiveSocket(engine, ops.liveSessions, h, owner, up.url, up.headers), engine.wsLive)) }
  }
  if (p === "/ws") {
    // the resume cursor (since=node:seq,...) and the batch flag (batch=1) ride on the URL; a bad cursor is refused
    // before the ticket is spent
    const sinceText = u === undefined ? "" : u.searchParams.get("since") ?? ""
    const cursor: Map<string, int> | undefined = sinceText === "" ? undefined : parseCursor(sinceText)
    if (sinceText !== "" && cursor === undefined) return { kind: "refused", status: 400, message: "since must be node:seq pairs" }
    const bt = u === undefined ? "" : u.searchParams.get("batch") ?? ""
    const batch = bt === "1" || bt === "true"
    // a ticket from POST /api/session/ws-ticket stands for the caller's credentials, once and briefly
    const tk = u === undefined ? "" : u.searchParams.get("ticket") ?? ""
    if (tk !== "") {
      const actor = ops.wsTickets.consume(tk, Date.now())
      if (actor === undefined) return { kind: "refused", status: 401, message: "the WebSocket ticket is invalid, used or expired" }
      return { kind: "session", session: wsSession(req, new UiSocket(ops.ui, ops.scopeOfActor(actor), batch, cursor)) }
    }
    // the live feed is log data: whoever may read /api/logs may open it, and sees its own data scope
    const g = ops.gate(req, "/api/logs")
    if (g.kind === "deny") return { kind: "refused", status: g.res.status, message: g.res.status === 401 ? "authentication is required" : "this role may not open the UI socket" }
    return { kind: "session", session: wsSession(req, new UiSocket(ops.ui, ops.scopeOfActor(g.actor), batch, cursor)) }
  }
  return { kind: "none" }
}

// The same routes on the http1 server (front.tov): an accepted socket runs its route's state, and a
// refusal is answered over HTTP. False for a path that is no WebSocket route.
export function http1Upgrade(engine: Engine, ops: Ops, req: Request, accept: (protocol: string) => WsConnection | undefined, reject: (status: int, body: string) => void): bool {
  const wu = wsUpgrade(engine, ops, req)
  if (wu.kind === "none") return false
  if (wu.kind === "refused") {
    reject(wu.status, errorJson(wu.message, "invalid_request_error", undefined))
    return true
  }
  const client = accept(wu.session.protocol)
  const ext = wu.session.ext
  if (client !== undefined && ext !== undefined) attachHttp1(ext, client)
  return true
}

// One HTTP request on the Bun.serve server: the body limit, then the streamed or whole route.
// The promise as it is. An async call awaited in place has its frame laid out inside the caller's frame, which
// lives as long as the request (a stream's whole length); a call passed through here is its own allocation,
// freed when it is done.
function outOfLine<T>(p: Promise<T>): Promise<T> {
  return p
}

async function bunHttp(engine: Engine, ops: Ops, req00: Request, limit: int): Promise<Response, TypeError> {
  let req0 = req00
  const lf = await outOfLine(largeFront(engine, req00))
  if (lf instanceof Response) return lf
  if (lf instanceof Request) req0 = lf
  const within = try await limitedBody(req0, limit)
  if (within === undefined) return errorResponse(413, "request body too large", "invalid_request_error", noHeaders())
  // the plugins' HTTP pre hooks, before the request is routed
  const th = await transportStart(engine, within)
  if (th.response !== undefined) return th.response
  const req = th.request
  const tr = th.tr
  const u = URL.parse(req.url)
  const p = u === undefined ? "" : u.pathname
  const cp = compatPath(p)
  const t0 = performance.now()
  const reqBytes = parseFloat(req.headers.get("content-length") ?? "0") ?? 0.0
  // an x-bf-async request runs as a job through dispatch, not as a stream
  const asyncReq = (req.headers.get("x-bf-async") ?? "") !== ""
  const kind = req.method === "POST" && !asyncReq ? streamKind(cp) : ""
  try {
    if (kind !== "") return try await timed(p, req.method, t0, reqBytes, req.headers, chatStreamed(engine, req, kind, tr))
    return try await timed(p, req.method, t0, reqBytes, req.headers, hookedDispatch(engine, ops, req, tr))
  } finally {
    transportDone(engine, tr)
  }
}

// The Bun.serve server (the default): streamed chat answers, Tov's multi-process workers,
// native WebSockets.
export function start(engine: Engine, ops: Ops, opts: ServeOptions): Served {
  const lim = opts.limits
  const server = Bun.serve<Session>({
    port: opts.port,
    hostname: opts.hostname,
    workers: opts.workers,
    // slow or silent clients (lifecycle.tov): a head within header_timeout_seconds, a body that keeps arriving, an
    // idle keep-alive connection closed after idle_timeout_seconds, and at most max_connections per process
    headerTimeout: lim.headerSeconds,
    idleTimeout: lim.idleSeconds,
    bodyTimeout: lim.bodySeconds,
    maxConnections: lim.maxConnections,
    // bodies over the request threshold arrive as a stream (large_payload_optimization's, or the body limit when the
    // feature is off), and the sizes are checked by the gateway against the current config, so a reload moves them
    // (client.max_request_body_size_mb, large_payload_optimization.max_payload_bytes). The server's own threshold is
    // the one at start: a lower one set later applies to the bodies over it.
    bodyStreamThreshold: bodyLimits(engine).threshold,
    maxRequestBodySize: NO_BODY_LIMIT,
    fetch(req0, server) {
      const wu = wsUpgrade(engine, ops, req0)
      if (wu.kind === "refused") return errorResponse(wu.status, wu.message, "invalid_request_error", noHeaders())
      if (wu.kind === "session") {
        // the subprotocol the route chose from the client's offer goes out with the 101 (the realtime relay's "realtime")
        const uh: Record<string, string> = {}
        if (wu.session.protocol !== "") uh.set("sec-websocket-protocol", wu.session.protocol)
        if (server.upgrade(req0, { data: wu.session, headers: uh })) return
        return errorResponse(426, "connect with a WebSocket upgrade", "invalid_request_error", noHeaders())
      }
      return bunHttp(engine, ops, req0, bodyLimits(engine).limit)
    },
    websocket: {
      open: (ws) => {
        extOpen(ws)
      },
      message: (ws, m) => {
        extMessage(ws, m)
      },
      close: (ws) => {
        extClose(ws)
      },
      pong: (ws) => {
        extPong(ws)
      },
    },
  })
  return {
    url: server.url.href,
    stopListener: () => {
      server.stop()
    },
    open: (): int => server.openConnections,
  }
}

test("compat paths: the unversioned OpenAI family and the Cursor prefix", () => {
  expect(compatPath("/openai/responses")).toBe("/v1/responses")
  expect(compatPath("/openai/responses/resp_1/cancel")).toBe("/v1/responses/resp_1/cancel")
  expect(compatPath("/openai/embeddings")).toBe("/v1/embeddings")
  expect(compatPath("/openai/models/openai/gpt-4o")).toBe("/v1/models/openai/gpt-4o")
  expect(compatPath("/openai/files")).toBe("/v1/files")
  expect(compatPath("/openai/batches/b1")).toBe("/v1/batches/b1")
  expect(compatPath("/openai/realtime/calls")).toBe("/v1/realtime/calls")
  expect(compatPath("/openai/v1/responses")).toBe("/v1/responses")
  expect(compatPath("/openai/v1/realtime")).toBe("/openai/v1/realtime")
  expect(compatPath("/openai/deployments/d/completions")).toBe("/v1/completions")
  expect(compatPath("/cursor/v1/models")).toBe("/v1/models")
  expect(compatPath("/cursor/anthropic/v1/messages")).toBe("/anthropic/v1/messages")
  expect(compatPath("/cursor/v1/chat/completions")).toBe("/cursor/v1/chat/completions")
  expect(compatPath("/v1/chat/completions")).toBe("/v1/chat/completions")
  // decisions: the version segment is optional under the OpenAI family and the SDK prefixes
  expect(compatPath("/openai/decisions")).toBe("/v1/decisions")
  expect(compatPath("/openai/v1/decisions")).toBe("/v1/decisions")
  expect(compatPath("/litellm/decisions")).toBe("/v1/decisions")
  expect(compatPath("/langchain/v1/decisions")).toBe("/v1/decisions")
  expect(compatPath("/pydanticai/decisions")).toBe("/v1/decisions")
  expect(compatPath("/decisions")).toBe("/decisions")
})

test("the Responses route streams through the sink when the request asks for a stream", () => {
  expect(streamKind("/v1/responses")).toBe("responses")
  expect(streamsRequest("responses", `{"model":"m","stream":true}`)).toBe(true)
  expect(streamsRequest("responses", `{"model":"m"}`)).toBe(false)
})

test("the governance users path is the users path", () => {
  expect(usersPath("/api/governance/users")).toBe("/api/users")
  expect(usersPath("/api/governance/users/ann/role")).toBe("/api/users/ann/role")
  expect(usersPath("/api/governance/usersx")).toBe("/api/governance/usersx")
  expect(usersPath("/api/users/ann")).toBe("/api/users/ann")
})
