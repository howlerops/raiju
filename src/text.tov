// The length of a string in the unit its positions are counted in: what `indexOf` returns and what
// `slice` takes. Positions are bytes on the pinned compiler and UTF-16 units on Tov v0.1.0, so code
// that walks or cuts a string measures it with strLen, and keeps `byteLength` for sizes in bytes
// (limits, Content-Length, buffers).

export function strLen(s: string): int {
  return s.byteLength
}

test("strLen is the end position of the string", () => {
  expect(strLen("")).toBe(0)
  expect(strLen("abc")).toBe(3)
  const s = "é日🙂x"
  expect(s.slice(strLen(s) - 1)).toBe("x")
  expect(s.slice(0, strLen(s))).toBe(s)
  expect(s.indexOf("x")).toBe(strLen(s) - 1)
  expect(s.slice(strLen(s))).toBe("")
})
