// Request timeouts without a timer per request. AbortSignal.timeout costs a
// timer that lives for its whole duration even after the request finished,
// and Tov's timer bookkeeping is linear in live timers; at thousands of
// requests per second that dominates. Instead every timeout duration gets a
// FIFO of deadlines (they are added in time order, so the queue stays sorted)
// and one interval aborts the expired ones.

export class Deadline {
  done = false
  readonly controller = new AbortController()
  constructor(readonly at: f64) {}
  finish(): void {
    this.done = true
  }
}

class Queue {
  items: Deadline[] = []
  head = 0
}

const queues: Map<int, Queue> = new Map()
let sweeping = false

export function sweep(): void {
  const now = performance.now()
  for (const ms of queues.keys()) {
    const q = queues.get(ms)!
    while (q.head < q.items.length) {
      const d = q.items[q.head]!
      if (!d.done && d.at > now) break
      if (!d.done) d.controller.abort(new DOMException(`the upstream took longer than ${ms} ms`, "TimeoutError"))
      q.head += 1
    }
    // compact once the consumed prefix dominates
    if (q.head > 1024 && q.head * 2 > q.items.length) {
      q.items = q.items.slice(q.head)
      q.head = 0
    }
  }
}

// A deadline `ms` from now; call finish() when the request completes.
export function deadline(ms: int): Deadline {
  if (!sweeping) {
    sweeping = true
    // One interval for the whole process; it only runs while a server keeps the loop alive.
    setInterval(() => sweep(), 50)
  }
  let q = queues.get(ms)
  if (q === undefined) {
    const nq = new Queue()
    queues.set(ms, nq)
    q = nq
  }
  const d = new Deadline(performance.now() + ms)
  q.items.push(d)
  return d
}

// network_config.stream_idle_timeout_in_seconds: a streamed answer whose upstream sends nothing for this long is
// cut (Bifrost's default when it is unset or 0).
export const DEFAULT_STREAM_IDLE_SECONDS = 120

// The idle limit of a provider's streams, in seconds: the configured value, or Bifrost's default of 120.
export function streamIdleSeconds(configured: int | undefined): int {
  const v = configured ?? 0
  return v > 0 ? v : DEFAULT_STREAM_IDLE_SECONDS
}

// The idle guard of one upstream stream. It counts only while a read is waiting (arm to the next chunk, then
// disarm), so a slow client that holds back the reads is not taken for a silent upstream. One interval checks
// every live guard, so a chunk costs two field writes instead of a timer.
export class IdleWatch {
  waiting = false
  since = 0.0
  stopped = false
  fired = false
  constructor(readonly ms: f64, readonly onIdle: () => void) {}
  arm(): void {
    this.waiting = true
    this.since = performance.now()
  }
  disarm(): void {
    this.waiting = false
  }
  stop(): void {
    this.stopped = true
    this.waiting = false
  }
}

let watches: IdleWatch[] = []
let watching = false

// Fires the guards whose wait is over and drops the stopped ones.
export function sweepIdle(): void {
  const now = performance.now()
  const keep: IdleWatch[] = []
  for (const w of watches) {
    if (w.stopped) continue
    if (w.waiting && now - w.since >= w.ms) {
      w.stopped = true
      w.fired = true
      w.onIdle()
      continue
    }
    keep.push(w)
  }
  watches = keep
}

// A guard that calls onIdle once a read has waited `seconds`; stop() it when the stream ends.
export function idleWatch(seconds: int, onIdle: () => void): IdleWatch {
  if (!watching) {
    watching = true
    setInterval(() => sweepIdle(), 250)
  }
  const w = new IdleWatch(seconds * 1000.0, onIdle)
  watches.push(w)
  return w
}

test("expired deadlines abort, finished ones don't", () => {
  const a = deadline(-1)
  const b = deadline(-1)
  const c = deadline(60000)
  b.finish()
  sweep()
  expect(a.controller.signal.aborted).toBe(true)
  expect(b.controller.signal.aborted).toBe(false)
  expect(c.controller.signal.aborted).toBe(false)
})

test("the idle limit defaults to Bifrost's 120 seconds", () => {
  expect(streamIdleSeconds(undefined)).toBe(120)
  expect(streamIdleSeconds(0)).toBe(120)
  expect(streamIdleSeconds(5)).toBe(5)
})

test("an idle guard fires only while a read waits past its limit", () => {
  let hits = 0
  const a = idleWatch(0, () => {
    hits += 1
  })
  // not waiting: nothing fires
  sweepIdle()
  expect(hits).toBe(0)
  a.arm()
  sweepIdle()
  expect(hits).toBe(1)
  expect(a.fired).toBe(true)
  // fired once only
  a.arm()
  sweepIdle()
  expect(hits).toBe(1)
  const b = idleWatch(60, () => {
    hits += 10
  })
  b.arm()
  sweepIdle()
  expect(hits).toBe(1)
  b.disarm()
  b.stop()
  sweepIdle()
  expect(b.fired).toBe(false)
})
