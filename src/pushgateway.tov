// Prometheus Push Gateway (Bifrost's telemetry plugin push_gateway). Every push_interval seconds the
// /metrics text is PUT to <url>/metrics/job/<job>/instance/<instance>, which replaces that group.
// Tov has no percent-encoding, so job and instance names must use plain characters.
import { encode } from "./base64"
import { utf8 } from "./crypto"

export type PushBasicAuth = { username?: string, password?: string }
export type PushGatewayConfig = {
  enabled?: bool,
  push_gateway_url?: string,
  job_name?: string,
  instance_id?: string,
  push_interval?: int,
  basic_auth?: PushBasicAuth,
}

const PLAIN = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.:"

function plain(s: string): bool {
  if (s === "") return false
  for (let i = 0; i < s.byteLength; i++) {
    if (PLAIN.indexOf(s.slice(i, i + 1)) < 0) return false
  }
  return true
}

// Bifrost's defaults: job "bifrost", and the host name as the instance (the container's HOSTNAME here).
export function jobOf(c: PushGatewayConfig): string {
  return c.job_name !== undefined && c.job_name !== "" ? c.job_name : "bifrost"
}

export function instanceOf(c: PushGatewayConfig): string {
  if (c.instance_id !== undefined && c.instance_id !== "") return c.instance_id
  const h = process.env.HOSTNAME
  return h !== undefined && h !== "" ? h : "unknown"
}

// Why the settings cannot push, or undefined when they can.
export function pushProblem(c: PushGatewayConfig): string | undefined {
  const url = c.push_gateway_url ?? ""
  if (url === "") return "push_gateway_url is required"
  if (!url.startsWith("http://") && !url.startsWith("https://")) return "push_gateway_url must be an http or https URL"
  if (!plain(jobOf(c)) || !plain(instanceOf(c))) return "job_name and instance_id may use letters, digits, '-', '_', '.' and ':' only"
  return undefined
}

// Seconds between pushes: Bifrost's 15 by default, kept to 1 to 300.
export function pushInterval(c: PushGatewayConfig): int {
  const v = c.push_interval ?? 15
  if (v < 1) return 1
  if (v > 300) return 300
  return v
}

export function pushUrl(c: PushGatewayConfig): string {
  let base = c.push_gateway_url ?? ""
  while (base.endsWith("/")) base = base.slice(0, base.byteLength - 1)
  return base + "/metrics/job/" + jobOf(c) + "/instance/" + instanceOf(c)
}

// Request headers for a push: the text format and, when both are set, basic auth.
export function pushHeaders(c: PushGatewayConfig): Map<string, string> {
  const h: Map<string, string> = new Map()
  h.set("content-type", "text/plain; version=0.0.4")
  const u = c.basic_auth?.username ?? ""
  const p = c.basic_auth?.password ?? ""
  if (u !== "" && p !== "") h.set("authorization", "Basic " + encode(utf8(u + ":" + p)))
  return h
}

test("push gateway needs an http URL and plain job and instance names", () => {
  expect(pushProblem({ enabled: true })).toBe("push_gateway_url is required")
  expect(pushProblem({ push_gateway_url: "pushgateway:9091" })).toBe("push_gateway_url must be an http or https URL")
  expect(pushProblem({ push_gateway_url: "http://pushgateway:9091", job_name: "a/b", instance_id: "n1" })).toBe("job_name and instance_id may use letters, digits, '-', '_', '.' and ':' only")
  expect(pushProblem({ push_gateway_url: "http://pushgateway:9091", job_name: "bifrost", instance_id: "node-1" })).toBe(undefined)
})

test("push URL has the job and instance grouping, and interval defaults and clamps", () => {
  const c: PushGatewayConfig = { push_gateway_url: "http://pushgateway:9091/", job_name: "raiju", instance_id: "node-1" }
  expect(pushUrl(c)).toBe("http://pushgateway:9091/metrics/job/raiju/instance/node-1")
  expect(pushUrl({ push_gateway_url: "http://pg", instance_id: "n" })).toBe("http://pg/metrics/job/bifrost/instance/n")
  expect(pushInterval({})).toBe(15)
  expect(pushInterval({ push_interval: 0 })).toBe(1)
  expect(pushInterval({ push_interval: 900 })).toBe(300)
  expect(pushInterval({ push_interval: 30 })).toBe(30)
})

test("push headers carry the text format and basic auth when both credentials are set", () => {
  const h = pushHeaders({ basic_auth: { username: "metrics", password: "example-pass" } })
  expect(h.get("content-type")).toBe("text/plain; version=0.0.4")
  expect(h.get("authorization")).toBe("Basic " + encode(utf8("metrics:example-pass")))
  expect(pushHeaders({ basic_auth: { username: "metrics" } }).has("authorization")).toBe(false)
})
