// openssl dgst -sha256 -sign over "hello", base64url without padding
const SIG_HELLO = "BCL82sCsrUeBOrj2lIUB-2thcudrQl0jIsodmaiyVKATNrssMwjGzNskettZchQag0imkVC-CE2jvQ9VTwn0AlRAXtUGYRr5is6YB7_l8lluIyaPx5QUvoyOAzLwsGCF7jZdx-yD7snaju8XfZPBchCQGIInOMpIEABo326C27OWraPhQ0DvqFsFkaxyk1b-wdKGsW0ke42hmtRBCsU_a6xQzenZ7DxlmFKxMVc0ErZayw7aywUAB4VBLfR6RVLZ-cqjzq4v2S5oi-ducGT97ccIEqgu4aKUPwrHou7KgCKl6ByaLP-kadbysqYyaV4lPjpjxjvaxuIb6vj96eG6UA"

test("modPow matches known values", () => {
  expect(modPow(4n, 13n, 497n)).toBe(445n)
  expect(modPow(2n, 10n, 1000n)).toBe(24n)
  expect(modPow(7n, 0n, 13n)).toBe(1n)
})

test("parses PKCS#8 and PKCS#1 keys to the same numbers", () => {
  const a = try parseKey(TEST_PKCS8)
  const b = try parseKey(TEST_PKCS1)
  expect(a.n).toBe(b.n)
  expect(a.d).toBe(b.d)
  expect(a.e).toBe(65537n)
  expect(a.p * a.q).toBe(a.n)
})

test("RS256 signature matches openssl", () => {
  expect(try signRs256(TEST_PKCS8, "hello")).toBe(SIG_HELLO)
  expect(try signRs256(TEST_PKCS1, "hello")).toBe(SIG_HELLO)
})

test("service account JWT matches an openssl reference", () => {
  const jwt = try serviceAccountJwt("test-sa@example.iam.gserviceaccount.com", TEST_PKCS8, "https://www.googleapis.com/auth/cloud-platform", "https://oauth2.googleapis.com/token", 1700000000)
  expect(jwt).toBe("eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJ0ZXN0LXNhQGV4YW1wbGUuaWFtLmdzZXJ2aWNlYWNjb3VudC5jb20iLCJzY29wZSI6Imh0dHBzOi8vd3d3Lmdvb2dsZWFwaXMuY29tL2F1dGgvY2xvdWQtcGxhdGZvcm0iLCJhdWQiOiJodHRwczovL29hdXRoMi5nb29nbGVhcGlzLmNvbS90b2tlbiIsImlhdCI6MTcwMDAwMDAwMCwiZXhwIjoxNzAwMDAzNjAwfQ.GOqovJ2pcvsDm_akNndplIIYwmsKvGQworqqYOfV16_OY0ZcLaltIFHIfvZtDDq2yQ6XEhDazLMR_-NlwYk8fM6XHIhuR7FWMTmQ_csOrIXRqrH13-JNoX4Prle-zM-iAPBpJowiOIC8GSMuxqglGPxf--QHpho8ACYtSSLNJf3bRtBuPI9wy1ijdaVYXcTwRsZpzcm8ZVzlilW8xa-SSwFvxTPZjy_OxtbeuO_mEAt1-7DF8d7oW3K4RwPvg1qPqa1KxgK_hwI73EZEL9OxubYeBLVDJmcp49oeR8ZHZIPkjAvof9vacG6Luaolss51aRivYx4tzbr0ahfvzH1ZKQ")
  expect(jwt.split(".").length).toBe(3)
})

test("RS256 signatures verify with the key's public half, and reject other input", () => {
  const sig = try signRs256(TEST_PKCS8, "hello")
  expect(try verifyRs256(TEST_PKCS8, "hello", sig)).toBe(true)
  expect(try verifyRs256(TEST_PKCS1, "hello", sig)).toBe(true)
  expect(try verifyRs256(TEST_PKCS8, "hellO", sig)).toBe(false)
  expect(try verifyRs256(TEST_PKCS8, "hello", "AAAA")).toBe(false)
})

test("the public JWK carries the modulus and the exponent 65537 under the kid", () => {
  const jwk = try publicJwk(TEST_PKCS8, "k1")
  expect(jwk.includes("\"kid\":\"k1\"")).toBe(true)
  expect(jwk.includes("\"e\":\"AQAB\"")).toBe(true)
  expect(jwk.includes("\"alg\":\"RS256\"")).toBe(true)
})

test("the key id is stable and the same for both encodings of a key", () => {
  const id = try publicKeyId(TEST_PKCS8)
  expect(id.byteLength).toBe(32)
  expect(try publicKeyId(TEST_PKCS1)).toBe(id)
})

test("rejects bad keys", () => {
  let threw = false
  try {
    signRs256("not a key", "x")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  threw = false
  try {
    signRs256("-----BEGIN PRIVATE KEY-----\nAAAA\n-----END PRIVATE KEY-----", "x")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})
