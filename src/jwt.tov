// RS256 service-account JWTs (RFC 7519 and RFC 7523) for Google OAuth. Tov has
// no RSA library, so the RSASSA-PKCS1-v1_5 signature (RFC 8017) is computed
// here with bigint: parse the PEM key, then one modular exponentiation.
import { quote } from "./json"
import { sha256, sha384, sha512, utf8, toHex, secureHex } from "./crypto"
import { encodeUrl, decode, encode } from "./base64"

// ---- DER ----

// One ASN.1 TLV: its tag, its content bytes, and the offset just after it.
type Tlv = { tag: int, value: u8[], next: int }

function readTlv(der: u8[], pos: int): Tlv throws SyntaxError {
  if (pos + 2 > der.length) throw new SyntaxError("der: truncated")
  const tag = int(der[pos]!)
  let len = int(der[pos + 1]!)
  let p = pos + 2
  if (len >= 0x80) {
    const n = len - 0x80
    if (n < 1 || n > 4) throw new SyntaxError("der: unsupported length")
    len = 0
    for (let i = 0; i < n; i++) {
      if (p >= der.length) throw new SyntaxError("der: truncated")
      len = len * 256 + int(der[p]!)
      p++
    }
  }
  if (p + len > der.length) throw new SyntaxError("der: truncated")
  return { tag: tag, value: der.slice(p, p + len), next: p + len }
}

function child(der: u8[], pos: int, tag: int): Tlv throws SyntaxError {
  const t = try readTlv(der, pos)
  if (t.tag !== tag) throw new SyntaxError(`der: expected tag ${tag}, found ${t.tag}`)
  return t
}

// An INTEGER's content bytes as a non-negative bigint.
function bigOf(b: u8[]): bigint {
  let v = 0n
  for (const x of b) v = v * 256n + BigInt(int(x))
  return v
}

// Big-endian bytes of x, left-padded to len.
function bytesOf(x: bigint, len: int): u8[] {
  const out: u8[] = []
  for (let i = 0; i < len; i++) out.push(u8(0))
  let v = x
  for (let i = len - 1; i >= 0; i--) {
    out[i] = u8(int(v & 0xffn))
    v = v >> 8n
  }
  return out
}

function byteLen(x: bigint): int {
  let n = 0
  let v = x
  while (v > 0n) {
    v = v >> 8n
    n++
  }
  return n
}

// ---- keys ----

type RsaKey = { n: bigint, e: bigint, d: bigint, p: bigint, q: bigint, dP: bigint, dQ: bigint, qInv: bigint }

// PKCS#1 RSAPrivateKey: SEQUENCE { version, n, e, d, p, q, dP, dQ, qInv }.
function rsaFromPkcs1(der: u8[]): RsaKey throws SyntaxError {
  const body = (try child(der, 0, 0x30)).value
  const v: bigint[] = []
  let pos = 0
  for (let i = 0; i < 9; i++) {
    const t = try child(body, pos, 0x02)
    v.push(bigOf(t.value))
    pos = t.next
  }
  if (v[0]! !== 0n) throw new SyntaxError("rsa: unsupported key version")
  return { n: v[1]!, e: v[2]!, d: v[3]!, p: v[4]!, q: v[5]!, dP: v[6]!, dQ: v[7]!, qInv: v[8]! }
}

// rsaEncryption OID (1.2.840.113549.1.1.1) as the AlgorithmIdentifier starts it.
const RSA_ALG: int[] = [0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01]

// PKCS#8 PrivateKeyInfo: SEQUENCE { version, AlgorithmIdentifier, OCTET STRING }.
// The octet string holds the PKCS#1 key.
function pkcs8Inner(der: u8[]): u8[] throws SyntaxError {
  const body = (try child(der, 0, 0x30)).value
  const ver = try child(body, 0, 0x02)
  const alg = try child(body, ver.next, 0x30)
  for (let i = 0; i < RSA_ALG.length; i++) {
    const b = alg.value[i]
    if (b === undefined || int(b) !== RSA_ALG[i]!) throw new SyntaxError("pkcs8: not an RSA key")
  }
  const key = try child(body, alg.next, 0x04)
  return key.value
}

// Reads a PEM private key, PKCS#8 (BEGIN PRIVATE KEY) or PKCS#1 (BEGIN RSA PRIVATE KEY).
function parseKey(pem: string): RsaKey throws SyntaxError {
  const pkcs1 = pem.includes("-----BEGIN RSA PRIVATE KEY-----")
  const pkcs8 = pem.includes("-----BEGIN PRIVATE KEY-----")
  if (!pkcs1 && !pkcs8) throw new SyntaxError("pem: no unencrypted RSA private key")
  const lines: string[] = []
  for (const line of pem.split("\n")) {
    const l = line.trim()
    if (l === "" || l.startsWith("-----")) continue
    lines.push(l)
  }
  const der = try decode(lines.join(""))
  if (pkcs1) return try rsaFromPkcs1(der)
  return try rsaFromPkcs1(try pkcs8Inner(der))
}

// ---- RSASSA-PKCS1-v1_5 with SHA-256 ----

// DigestInfo prefix for SHA-256 (RFC 8017, section 9.2 note 1).
const SHA256_DIGEST_INFO: int[] = [0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20]

// base^exp mod m, square and multiply, most significant bit first.
export function modPow(base: bigint, exp: bigint, mod: bigint): bigint {
  let result = 1n % mod
  let b = base % mod
  let e = exp
  while (e > 0n) {
    if ((e & 1n) === 1n) result = (result * b) % mod
    b = (b * b) % mod
    e = e >> 1n
  }
  return result
}

// The padded message EM = 00 01 FF..FF 00 || DigestInfo || hash, k bytes long.
function encodeEmsa(hash: u8[], k: int): bigint throws SyntaxError {
  const tLen = SHA256_DIGEST_INFO.length + hash.length
  if (k < tLen + 11) throw new SyntaxError("rsa: key too small for SHA-256 signatures")
  const em: u8[] = [u8(0), u8(1)]
  for (let i = 0; i < k - tLen - 3; i++) em.push(u8(0xff))
  em.push(u8(0))
  for (const b of SHA256_DIGEST_INFO) em.push(u8(b))
  for (const b of hash) em.push(b)
  return bigOf(em)
}

// m^d mod n by the Chinese remainder theorem: two half-size exponentiations.
function rsaSign(key: RsaKey, m: bigint): bigint throws SyntaxError {
  const m1 = modPow(m, key.dP, key.p)
  const m2 = modPow(m, key.dQ, key.q)
  let h = (m1 - m2) % key.p
  if (h < 0n) h += key.p
  h = (key.qInv * h) % key.p
  const s = m2 + h * key.q
  // A faulty CRT result would leak the key; check it against the public key.
  if (modPow(s, key.e, key.n) !== m) throw new SyntaxError("rsa: key is inconsistent")
  return s
}

// Base64url RS256 signature of signingInput under a PEM private key.
export function signRs256(pem: string, signingInput: string): string throws SyntaxError {
  const key = try parseKey(pem)
  const k = byteLen(key.n)
  const m = try encodeEmsa(sha256(utf8(signingInput)), k)
  const s = try rsaSign(key, m)
  return encodeUrl(bytesOf(s, k))
}

// Whether a base64url RS256 signature verifies under a PEM private key's public half: s^e mod n must be the
// padded SHA-256 encoding of signingInput. A signature of another length, or a value at or above n, is refused.
export function verifyRs256(pem: string, signingInput: string, sigB64: string): bool throws SyntaxError {
  const key = try parseKey(pem)
  const k = byteLen(key.n)
  const sig = try decode(sigB64)
  if (sig.length !== k) return false
  const s = bigOf(sig)
  if (s >= key.n) return false
  const want = try encodeEmsa(sha256(utf8(signingInput)), k)
  return modPow(s, key.e, key.n) === want
}

// ---- RS384, RS512 and PS256 to PS512 (RFC 7518 sections 3.3 and 3.5) ----

// DigestInfo prefixes for SHA-384 and SHA-512 (RFC 8017, section 9.2 note 1)
const SHA384_DIGEST_INFO: int[] = [0x30, 0x41, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02, 0x05, 0x00, 0x04, 0x30]
const SHA512_DIGEST_INFO: int[] = [0x30, 0x51, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03, 0x05, 0x00, 0x04, 0x40]

// The hash an RS or PS algorithm names by its number (256, 384 or 512).
function hashFor(bits: string, data: u8[]): u8[] {
  if (bits === "384") return sha384(data)
  if (bits === "512") return sha512(data)
  return sha256(data)
}

// EMSA-PKCS1-v1_5 with the DigestInfo of the hash.
function encodePkcs1(hash: u8[], k: int): bigint throws SyntaxError {
  const info = hash.length === 48 ? SHA384_DIGEST_INFO : (hash.length === 64 ? SHA512_DIGEST_INFO : SHA256_DIGEST_INFO)
  const tLen = info.length + hash.length
  if (k < tLen + 11) throw new SyntaxError("rsa: key too small for this hash")
  const em: u8[] = [u8(0), u8(1)]
  for (let i = 0; i < k - tLen - 3; i++) em.push(u8(0xff))
  em.push(u8(0))
  for (const b of info) em.push(u8(b))
  for (const b of hash) em.push(b)
  return bigOf(em)
}

// MGF1 (RFC 8017, B.2.1) over the algorithm's hash.
function mgf1(bits: string, seed: u8[], len: int): u8[] {
  const out: u8[] = []
  let c = 0
  while (out.length < len) {
    const block = hashFor(bits, seed.concat([u8((c >> 24) & 0xff), u8((c >> 16) & 0xff), u8((c >> 8) & 0xff), u8(c & 0xff)]))
    for (const b of block) {
      if (out.length < len) out.push(b)
    }
    c++
  }
  return out
}

function bitLen(x: bigint): int {
  let n = 0
  let v = x
  while (v > 0n) {
    v = v >> 1n
    n++
  }
  return n
}

// EMSA-PSS-ENCODE (RFC 8017, 9.1.1) with MGF1 and a salt as long as the hash, as JWS PS* signs.
function encodePss(bits: string, mHash: u8[], salt: u8[], emBits: int): u8[] throws SyntaxError {
  const hLen = mHash.length
  const emLen: int = Math.ceil(emBits / 8)
  if (emLen < hLen + salt.length + 2) throw new SyntaxError("rsa: key too small for this hash")
  const mp: u8[] = []
  for (let i = 0; i < 8; i++) mp.push(u8(0))
  const h = hashFor(bits, mp.concat(mHash).concat(salt))
  const db: u8[] = []
  for (let i = 0; i < emLen - salt.length - hLen - 2; i++) db.push(u8(0))
  db.push(u8(1))
  for (const b of salt) db.push(b)
  const mask = mgf1(bits, h, emLen - hLen - 1)
  const masked: u8[] = []
  for (let i = 0; i < db.length; i++) masked.push(u8(int(db[i]!) ^ int(mask[i]!)))
  masked[0] = u8(int(masked[0]!) & (0xff >> (8 * emLen - emBits)))
  return masked.concat(h).concat([u8(0xbc)])
}

function decodeHex(h: string): u8[] throws SyntaxError {
  const out: u8[] = []
  for (let i = 0; i + 1 < h.byteLength; i += 2) {
    const v = parseInt(h.slice(i, i + 2), 16)
    if (v === undefined) throw new SyntaxError("hex: bad digit")
    out.push(u8(v))
  }
  return out
}

// Base64url signature of signingInput by RS256, RS384, RS512, PS256, PS384 or PS512 under a PEM private key.
export function signRsa(alg: string, pem: string, signingInput: string): string throws SyntaxError {
  const family = alg.slice(0, 2)
  const bits = alg.slice(2)
  if ((family !== "RS" && family !== "PS") || (bits !== "256" && bits !== "384" && bits !== "512")) throw new SyntaxError(`rsa: unknown algorithm ${alg}`)
  const key = try parseKey(pem)
  const k = byteLen(key.n)
  const mHash = hashFor(bits, utf8(signingInput))
  let m = 0n
  if (family === "RS") {
    m = try encodePkcs1(mHash, k)
  } else {
    let hex = ""
    try {
      hex = secureHex(mHash.length * 2)
    } catch (e) {
      throw new SyntaxError(`rsa: no random salt: ${e.message}`)
    }
    const salt = try decodeHex(hex)
    m = bigOf(try encodePss(bits, mHash, salt, bitLen(key.n) - 1))
  }
  const s = try rsaSign(key, m)
  return encodeUrl(bytesOf(s, k))
}

// Whether a PS* signature verifies (EMSA-PSS-VERIFY with the hash-length salt), for the tests.
function verifyPss(alg: string, pem: string, signingInput: string, sigB64: string): bool throws SyntaxError {
  const bits = alg.slice(2)
  const key = try parseKey(pem)
  const k = byteLen(key.n)
  const emBits = bitLen(key.n) - 1
  const emLen: int = Math.ceil(emBits / 8)
  const sig = try decode(sigB64)
  if (sig.length !== k) return false
  const em = bytesOf(modPow(bigOf(sig), key.e, key.n), emLen)
  const mHash = hashFor(bits, utf8(signingInput))
  const hLen = mHash.length
  if (int(em[emLen - 1]!) !== 0xbc) return false
  const masked = em.slice(0, emLen - hLen - 1)
  const h = em.slice(emLen - hLen - 1, emLen - 1)
  const mask = mgf1(bits, h, emLen - hLen - 1)
  const db: u8[] = []
  for (let i = 0; i < masked.length; i++) db.push(u8(int(masked[i]!) ^ int(mask[i]!)))
  db[0] = u8(int(db[0]!) & (0xff >> (8 * emLen - emBits)))
  const salt = db.slice(db.length - hLen)
  const want = try encodePss(bits, mHash, salt, emBits)
  return toHex(want) === toHex(em)
}

// A public identifier of a PEM key: the first 32 hex digits of the SHA-256 of its modulus. It is the kid of
// the tokens signed with the key, so the kid names the key without exposing it.
export function publicKeyId(pem: string): string throws SyntaxError {
  const key = try parseKey(pem)
  return toHex(sha256(bytesOf(key.n, byteLen(key.n)))).slice(0, 32)
}

// The public half of a PEM key as a JWK (RFC 7517, section 6.3), under the kid the tokens name.
export function publicJwk(pem: string, kid: string): string throws SyntaxError {
  const key = try parseKey(pem)
  const n = encodeUrl(bytesOf(key.n, byteLen(key.n)))
  const e = encodeUrl(bytesOf(key.e, byteLen(key.e)))
  return JSON.stringify({ kty: "RSA", use: "sig", kid: kid, alg: "RS256", n: n, e: e })
}

// A signed JWT for a Google service account: header.claims.signature.
export function serviceAccountJwt(clientEmail: string, privateKeyPem: string, scope: string, audience: string, nowSeconds: int): string throws SyntaxError {
  const header = encodeUrl(utf8(`{"alg":"RS256","typ":"JWT"}`))
  const claims = `{"iss":${quote(clientEmail)},"scope":${quote(scope)},"aud":${quote(audience)},"iat":${nowSeconds},"exp":${nowSeconds + 3600}}`
  const input = header + "." + encodeUrl(utf8(claims))
  const sig = try signRs256(privateKeyPem, input)
  return input + "." + sig
}

// ---- key generation ----

// A random number of exactly `bits` bits, from the kernel CSPRNG. The two top bits are set, so the product of
// two such primes has the full 2 * bits length.
function randomBits(bits: int): bigint throws Error {
  const x = try BigInt("0x" + (try secureHex(Math.ceil(bits / 4))))
  return (x & ((1n << BigInt(bits)) - 1n)) | (1n << BigInt(bits - 1)) | (1n << BigInt(bits - 2))
}

// A random number in [2, n - 2], for a Miller-Rabin base. The extra 64 bits make the bias negligible.
function randomBase(n: bigint): bigint throws Error {
  const bits = byteLen(n) * 8 + 64
  return 2n + ((try randomBits(bits)) % (n - 3n))
}

// Trial division bound for candidate primes: most composites fall to these before any modular exponentiation.
const SMALL_PRIME_BOUND = 1000

function smallPrimes(): bigint[] {
  const out: bigint[] = []
  for (let k = 3; k < SMALL_PRIME_BOUND; k += 2) {
    let prime = true
    for (let d = 3; d * d <= k; d += 2) {
      if (k % d === 0) {
        prime = false
        break
      }
    }
    if (prime) out.push(BigInt(k))
  }
  return out
}

// Miller-Rabin with random bases (FIPS 186-5, Appendix B.3). A composite is never reported as prime.
function probablyPrime(n: bigint, rounds: int): bool throws Error {
  if (n < 3n || (n & 1n) === 0n) return false
  let d = n - 1n
  let r = 0
  while ((d & 1n) === 0n) {
    d = d >> 1n
    r++
  }
  for (let i = 0; i < rounds; i++) {
    const base = try randomBase(n)
    let x = modPow(base, d, n)
    if (x === 1n || x === n - 1n) continue
    let witness = true
    for (let j = 1; j < r; j++) {
      x = (x * x) % n
      if (x === n - 1n) {
        witness = false
        break
      }
    }
    if (witness) return false
  }
  return true
}

// A prime of `bits` bits whose predecessor is not a multiple of e, so e stays invertible modulo p - 1.
function randomPrime(bits: int, e: bigint): bigint throws Error {
  const small = smallPrimes()
  while (true) {
    const c = (try randomBits(bits)) | 1n
    if (c % e === 1n) continue
    let hit = false
    for (const sp of small) {
      if (c % sp === 0n && c !== sp) {
        hit = true
        break
      }
    }
    if (hit) continue
    const isPrime = try probablyPrime(c, 20)
    if (isPrime) return c
  }
}

// The inverse of a modulo m (extended Euclid), or a throw when they share a factor.
function modInverse(a: bigint, m: bigint): bigint throws SyntaxError {
  let r0 = m
  let r1 = a % m
  let s0 = 0n
  let s1 = 1n
  while (r1 !== 0n) {
    const q = r0 / r1
    const r2 = r0 - q * r1
    r0 = r1
    r1 = r2
    const s2 = s0 - q * s1
    s0 = s1
    s1 = s2
  }
  if (r0 !== 1n) throw new SyntaxError("rsa: no inverse")
  let x = s0 % m
  if (x < 0n) x += m
  return x
}

// A DER TLV with the given tag and content.
function derTlv(tag: int, content: u8[]): u8[] {
  const len = content.length
  const head: u8[] = [u8(tag)]
  if (len < 0x80) {
    head.push(u8(len))
  } else {
    const lb = bytesOf(BigInt(len), byteLen(BigInt(len)))
    head.push(u8(0x80 | lb.length))
    for (const b of lb) head.push(b)
  }
  return head.concat(content)
}

// A non-negative INTEGER: a leading zero byte keeps a high bit from reading as a sign.
function derInt(x: bigint): u8[] {
  let b = bytesOf(x, byteLen(x))
  if (b.length === 0 || int(b[0]!) >= 0x80) b = [u8(0)].concat(b)
  return derTlv(0x02, b)
}

// PKCS#1 RSAPrivateKey (RFC 8017, A.1.2) as a PEM block, the form parseKey reads.
function pkcs1Pem(k: RsaKey): string {
  let body: u8[] = derInt(0n)
  for (const v of [k.n, k.e, k.d, k.p, k.q, k.dP, k.dQ, k.qInv]) body = body.concat(derInt(v))
  const der = derTlv(0x30, body)
  const b64 = encode(der)
  const lines: string[] = []
  for (let i = 0; i < b64.byteLength; i += 64) lines.push(b64.slice(i, i + 64))
  return "-----BEGIN RSA PRIVATE KEY-----\n" + lines.join("\n") + "\n-----END RSA PRIVATE KEY-----\n"
}

// A new RSA key of `bits` modulus bits (2048 is the usual size) as a PKCS#1 PEM. The primes come from the
// kernel CSPRNG and pass Miller-Rabin; the key is checked by a sign-and-verify round trip before it is returned.
export function generateRsaPem(bits: int): string throws Error {
  if (bits < 512 || bits % 16 !== 0) throw new Error("rsa: key size must be a multiple of 16 and at least 512 bits")
  const e = 65537n
  const half: int = Math.floor(bits / 2)
  const p = try randomPrime(half, e)
  let q = try randomPrime(half, e)
  while (q === p) q = try randomPrime(half, e)
  const n = p * q
  const d = try modInverse(e, (p - 1n) * (q - 1n))
  const k: RsaKey = { n: n, e: e, d: d, p: p, q: q, dP: d % (p - 1n), dQ: d % (q - 1n), qInv: try modInverse(q, p) }
  // the key must invert the public operation on a test value, or it is never handed out
  if (modPow(modPow(2n, e, n), d, n) !== 2n) throw new Error("rsa: generated key failed the round trip")
  return pkcs1Pem(k)
}

