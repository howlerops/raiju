// External guardrail services: request builders and verdict parsers for AWS
// Bedrock Guardrails, Azure AI Content Safety, Patronus and a generic webhook.
// Nothing here does I/O. The gateway sends checkRequest's output, then feeds the
// status and body back to parseVerdict. A failed call follows on_error.

import { Field, fields, elements, find, rawStr, rawNum, rawBool, quote, decodeString, isNull } from "./json"
import { sign, encodeSegment, Credentials } from "./providers/bedrock"
import { GuardrailProviderConfig, PatronusEvaluatorConfig } from "./config"

export type PatronusEvaluator = PatronusEvaluatorConfig
export type GuardrailProvider = GuardrailProviderConfig

export type GuardrailRequest = { url: string, method: string, headers: Map<string, string>, body: string }

export type Verdict = { action: "allow" | "block" | "redact", reason: string, text?: string }

const enc = new TextEncoder()
const BEDROCK_REGION = "us-east-1"
const AZURE_API_VERSION = "2024-09-01"
const AZURE_CATEGORIES = ["Hate", "SelfHarm", "Sexual", "Violence"]
const AZURE_DEFAULT_THRESHOLD = 4
const PATRONUS_BASE = "https://api.patronus.ai"

// Whether the provider runs on this side of the exchange.
export function appliesTo(p: GuardrailProvider, source: "input" | "output"): bool {
  const a = p.apply_to ?? "both"
  return a === "both" || a === source
}

function need(v: string | undefined, what: string): string throws Error {
  if (v === undefined || v === "") throw new Error(`guardrail provider needs ${what}`)
  return v
}

function trimSlashes(s: string): string {
  let out = s
  while (out.endsWith("/")) out = out.slice(0, out.byteLength - 1)
  return out
}

// ---- requests ----

// ApplyGuardrail. The path is signed like the other Bedrock calls: SigV4 with
// service "bedrock" and the segments encoded as the signer expects.
function bedrockRequest(p: GuardrailProvider, text: string, source: string, nowMs: f64): GuardrailRequest throws Error {
  const id = try need(p.guardrail_id, "guardrail_id")
  const ver = try need(p.guardrail_version, "guardrail_version")
  const ak = try need(p.access_key, "access_key")
  const sk = try need(p.secret_key, "secret_key")
  const region = p.region ?? BEDROCK_REGION
  const host = `bedrock-runtime.${region}.amazonaws.com`
  const path = `/guardrail/${encodeSegment(id)}/version/${encodeSegment(ver)}/apply`
  const src = source === "input" ? "INPUT" : "OUTPUT"
  const body = `{"source":"${src}","content":[{"text":{"text":${quote(text)}}}]}`
  const creds: Credentials = { accessKey: ak, secretKey: sk, sessionToken: p.session_token, region: region }
  const hs = sign(creds, "bedrock", host, path, body, nowMs)
  return { url: `https://${host}${path}`, method: "POST", headers: hs, body: body }
}

function azureRequest(p: GuardrailProvider, text: string): GuardrailRequest throws Error {
  const endpoint = trimSlashes(try need(p.endpoint, "endpoint"))
  const key = try need(p.api_key, "api_key")
  const cats = p.categories ?? AZURE_CATEGORIES
  for (const c of cats) {
    if (!AZURE_CATEGORIES.includes(c)) throw new Error(`unknown azure content safety category: ${c}`)
  }
  const hs: Map<string, string> = new Map()
  hs.set("content-type", "application/json")
  hs.set("Ocp-Apim-Subscription-Key", key)
  const catJson = cats.map((c) => quote(c)).join(",")
  const body = `{"text":${quote(text)},"categories":[${catJson}],"outputType":"FourSeverityLevels"}`
  return { url: `${endpoint}/contentsafety/text:analyze?api-version=${AZURE_API_VERSION}`, method: "POST", headers: hs, body: body }
}

function evaluatorJson(e: PatronusEvaluator): string {
  const c = e.criteria
  if (c === undefined || c === "") return `{"evaluator":${quote(e.evaluator)}}`
  return `{"evaluator":${quote(e.evaluator)},"criteria":${quote(c)}}`
}

function patronusRequest(p: GuardrailProvider, text: string, source: string): GuardrailRequest throws Error {
  const base = trimSlashes(p.base_url ?? PATRONUS_BASE)
  const key = try need(p.api_key, "api_key")
  const evs = p.evaluators ?? []
  if (evs.length === 0) throw new Error("patronus needs at least one evaluator")
  const field = source === "input" ? "evaluated_model_input" : "evaluated_model_output"
  const evJson = evs.map((e) => evaluatorJson(e)).join(",")
  const body = `{"evaluators":[${evJson}],${quote(field)}:${quote(text)}}`
  const hs: Map<string, string> = new Map()
  hs.set("content-type", "application/json")
  hs.set("X-API-KEY", key)
  return { url: `${base}/v1/evaluate`, method: "POST", headers: hs, body: body }
}

// The webhook receives {"source","text"}. Custom headers are added after the
// defaults, so a configured Content-Type wins.
function webhookRequest(p: GuardrailProvider, text: string, source: string): GuardrailRequest throws Error {
  const url = try need(p.url, "url")
  const hs: Map<string, string> = new Map()
  hs.set("content-type", "application/json")
  const extra = p.headers
  if (extra !== undefined) {
    for (const k of extra.keys()) hs.set(k.toLowerCase(), extra.get(k)!)
  }
  const body = `{"source":${quote(source)},"text":${quote(text)}}`
  return { url: url, method: "POST", headers: hs, body: body }
}

// Kinds that run in-process (regex, secrets) or through the gateway's chat path
// (prompt_judge). They make no HTTP request, so checkRequest refuses them.
export function isLocal(p: GuardrailProvider): bool {
  return p.kind === "regex" || p.kind === "secrets" || p.kind === "prompt_judge"
}

// Presidio's /analyze. The analyzer does the detection; the redaction is done
// from its offsets in parseVerdictFor.
function presidioRequest(p: GuardrailProvider, text: string): GuardrailRequest throws Error {
  const base = trimSlashes(try need(p.analyzer_url, "analyzer_url"))
  const hs: Map<string, string> = new Map()
  hs.set("content-type", "application/json")
  const key = p.api_key
  if (key !== undefined && key !== "") hs.set("authorization", `Bearer ${key}`)
  const lang = p.language ?? "en"
  const thr = p.score_threshold ?? 0.5
  let body = `{"text":${quote(text)},"language":${quote(lang)},"score_threshold":${thr}`
  const ents = p.entities ?? []
  if (ents.length > 0) body += `,"entities":[${ents.map((e: string) => quote(e)).join(",")}]`
  body += "}"
  return { url: `${base}/analyze`, method: "POST", headers: hs, body: body }
}

// Azure AI Language PII (entity recognition). The service returns the redacted
// text itself, so no offsets are needed here.
function azurePiiRequest(p: GuardrailProvider, text: string): GuardrailRequest throws Error {
  const endpoint = trimSlashes(try need(p.endpoint, "endpoint"))
  const key = try need(p.api_key, "api_key")
  const ver = p.api_version ?? "2026-05-01"
  let params = `"modelVersion":${quote(p.model_version ?? "latest")},"domain":${quote(p.domain ?? "none")},"stringIndexType":"UnicodeCodePoint"`
  const cats = p.pii_categories ?? []
  if (cats.length > 0) params += `,"piiCategories":[${cats.map((c: string) => quote(c)).join(",")}]`
  const lang = p.language ?? "en"
  const body = `{"kind":"PiiEntityRecognition","parameters":{${params}},"analysisInput":{"documents":[{"id":"1","language":${quote(lang)},"text":${quote(text)}}]}}`
  const hs: Map<string, string> = new Map()
  hs.set("content-type", "application/json")
  hs.set("Ocp-Apim-Subscription-Key", key)
  return { url: `${endpoint}/language/:analyze-text?api-version=${ver}`, method: "POST", headers: hs, body: body }
}

// Google Model Armor sanitizeUserPrompt (input) or sanitizeModelResponse (output).
function modelArmorRequest(p: GuardrailProvider, text: string, source: string): GuardrailRequest throws Error {
  const loc = try need(p.location, "location")
  const proj = try need(p.project_id, "project_id")
  const tmpl = try need(p.template_id, "template_id")
  const tok = try need(p.access_token, "access_token")
  const input = source === "input"
  const op = input ? "sanitizeUserPrompt" : "sanitizeModelResponse"
  const data = input ? `{"userPromptData":{"text":${quote(text)}}}` : `{"modelResponseData":{"text":${quote(text)}}}`
  const hs: Map<string, string> = new Map()
  hs.set("content-type", "application/json")
  hs.set("authorization", `Bearer ${tok}`)
  const host = trimSlashes(p.base_url ?? `https://modelarmor.${loc}.rep.googleapis.com`)
  return { url: `${host}/v1/projects/${proj}/locations/${loc}/templates/${tmpl}:${op}`, method: "POST", headers: hs, body: data }
}

// CrowdStrike AIDR guard_chat_completions: one message carrying the text.
const AIDR_BASE = "https://api.crowdstrike.com/aidr/aiguard"
const AIDR_PATH = "/v1/guard_chat_completions"

function aidrRequest(p: GuardrailProvider, text: string, source: string): GuardrailRequest throws Error {
  const key = try need(p.api_key, "api_key")
  let base = trimSlashes(p.base_url ?? AIDR_BASE)
  if (base.endsWith(AIDR_PATH)) base = base.slice(0, base.byteLength - AIDR_PATH.byteLength)
  const role = source === "input" ? "user" : "assistant"
  let body = `{"event_type":${quote(source)},"guard_input":{"messages":[{"role":${quote(role)},"content":${quote(text)}}]}`
  const app = p.app_id
  if (app !== undefined && app !== "") body += `,"app_id":${quote(app)}`
  const coll = p.collector_instance_id
  if (coll !== undefined && coll !== "") body += `,"collector_instance_id":${quote(coll)}`
  body += "}"
  const hs: Map<string, string> = new Map()
  hs.set("content-type", "application/json")
  hs.set("authorization", `Bearer ${key}`)
  return { url: `${base}${AIDR_PATH}`, method: "POST", headers: hs, body: body }
}

// The HTTP request for checking one text. Throws when the provider config is
// missing a field the kind needs. Presidio's verdict needs the text too; see parseVerdictFor.
export function checkRequest(p: GuardrailProvider, text: string, source: "input" | "output", nowMs: f64): GuardrailRequest throws Error {
  if (p.kind === "bedrock") return try bedrockRequest(p, text, source, nowMs)
  if (p.kind === "azure_content_safety") return try azureRequest(p, text)
  if (p.kind === "patronus") return try patronusRequest(p, text, source)
  if (p.kind === "webhook") return try webhookRequest(p, text, source)
  if (p.kind === "presidio") return try presidioRequest(p, text)
  if (p.kind === "azure_language_pii") return try azurePiiRequest(p, text)
  if (p.kind === "google_model_armor") return try modelArmorRequest(p, text, source)
  if (p.kind === "crowdstrike_aidr") return try aidrRequest(p, text, source)
  if (isLocal(p)) throw new Error("local guardrail kinds run in-process, not over HTTP")
  throw new Error("unknown guardrail kind")
}

// ---- verdicts ----

// Applies on_error. Allow is the default: a guardrail outage does not stop traffic.
function onError(p: GuardrailProvider, why: string): Verdict {
  const reason = `${p.id} guardrail error: ${why}`
  if (p.on_error === "block") return { action: "block", reason: reason }
  return { action: "allow", reason: reason }
}

// ApplyGuardrail response. Each assessment holds policy objects, and each
// policy holds lists of items with an action. A BLOCKED item anywhere blocks.
// When the only actions are ANONYMIZED PII items, the response's output text is
// the redacted replacement.
function bedrockVerdict(body: string): Verdict throws Error {
  const fs = try fields(body)
  const action = rawStr(fs, "action")
  if (action === "NONE") return { action: "allow", reason: "" }
  if (action !== "GUARDRAIL_INTERVENED") throw new Error("unknown bedrock action")
  const blocked: string[] = []
  let anonymized = 0
  const assessments = find(fs, "assessments") ?? "[]"
  for (const a of try elements(assessments)) {
    for (const pol of try fields(a)) {
      if (!pol.raw.startsWith("{")) continue
      for (const list of try fields(pol.raw)) {
        if (!list.raw.startsWith("[")) continue
        for (const item of try elements(list.raw)) {
          const f = try fields(item)
          const act = rawStr(f, "action")
          // name before type: a topic has both. match is left out, it can be the PII itself
          const label = rawStr(f, "name") ?? rawStr(f, "type") ?? pol.key
          if (act === "BLOCKED") blocked.push(label)
          else if (act === "ANONYMIZED") anonymized += 1
        }
      }
    }
  }
  let outText: string | undefined = undefined
  const outputs = find(fs, "outputs")
  if (outputs !== undefined) {
    const first = try elements(outputs)[0]
    if (first !== undefined) outText = rawStr(try fields(first), "text")
  }
  if (blocked.length === 0 && anonymized > 0 && outText !== undefined) {
    return { action: "redact", reason: "bedrock guardrail redacted PII", text: outText }
  }
  const labels = blocked.length > 0 ? blocked.join(", ") : "no policy detail"
  return { action: "block", reason: `bedrock guardrail intervened: ${labels}` }
}

// Azure returns one severity per category. Any severity at or above the
// threshold blocks.
function azureVerdict(p: GuardrailProvider, body: string): Verdict throws Error {
  const thr = p.threshold ?? AZURE_DEFAULT_THRESHOLD
  const list = find(try fields(body), "categoriesAnalysis")
  if (list === undefined || isNull(list)) throw new Error("no categoriesAnalysis in response")
  const hits: string[] = []
  for (const el of try elements(list)) {
    const f = try fields(el)
    const cat = rawStr(f, "category") ?? "unknown"
    const sev = rawNum(f, "severity")
    if (sev === undefined) throw new Error("category without severity")
    if (sev >= thr) hits.push(`${cat} severity ${sev}`)
  }
  if (hits.length > 0) {
    return { action: "block", reason: `azure content safety blocked: ${hits.join(", ")} (threshold ${thr})` }
  }
  return { action: "allow", reason: "" }
}

// Patronus returns one result per evaluator. Any result with pass false blocks.
function patronusVerdict(body: string): Verdict throws Error {
  const list = find(try fields(body), "results")
  if (list === undefined || isNull(list)) throw new Error("no results in response")
  const failed: string[] = []
  for (const el of try elements(list)) {
    const f = try fields(el)
    if (rawBool(f, "pass") !== false) continue
    failed.push(rawStr(f, "evaluator_id") ?? rawStr(f, "evaluator") ?? rawStr(f, "criteria_name") ?? rawStr(f, "criteria") ?? "evaluator")
  }
  if (failed.length > 0) return { action: "block", reason: `patronus evaluator failed: ${failed.join(", ")}` }
  return { action: "allow", reason: "" }
}

// The webhook answers {"allowed", "reason"?, "text"?}. A text on an allowed
// result is the redacted replacement.
function webhookVerdict(body: string): Verdict throws Error {
  const f = try fields(body)
  const allowed = rawBool(f, "allowed")
  if (allowed === undefined) throw new Error("no allowed flag in response")
  const reason = rawStr(f, "reason") ?? ""
  if (!allowed) return { action: "block", reason: reason !== "" ? reason : "webhook guardrail denied" }
  const text = rawStr(f, "text")
  if (text !== undefined) return { action: "redact", reason: reason, text: text }
  return { action: "allow", reason: reason }
}

// Presidio returns entities with codepoint offsets. Offsets go to byte offsets
// before the text is rewritten.
function cpToByte(b: u8[], cp: f64): int {
  let seen = 0.0
  for (let i = 0; i < b.length; i++) {
    const c = int(b[i]!)
    if (c >= 128 && c < 192) continue
    if (seen === cp) return i
    seen += 1.0
  }
  return b.length
}

// Presidio's verdict. Entities below score_threshold are ignored. action block
// stops the request, redact replaces each entity with <TYPE>, detect_only only reports.
function presidioVerdict(p: GuardrailProvider, text: string, body: string): Verdict throws Error {
  const thr = p.score_threshold ?? 0.5
  const found: { type: string, start: f64, end: f64 }[] = []
  for (const el of try elements(body)) {
    const f = try fields(el)
    const score = rawNum(f, "score") ?? 1.0
    if (score < thr) continue
    const s = rawNum(f, "start")
    const e = rawNum(f, "end")
    if (s === undefined || e === undefined) throw new Error("presidio result without offsets")
    found.push({ type: rawStr(f, "entity_type") ?? "PII", start: s, end: e })
  }
  if (found.length === 0) return { action: "allow", reason: "" }
  const types = found.map((x) => x.type).join(", ")
  const action = p.action ?? "detect_only"
  if (action === "block") return { action: "block", reason: `presidio found ${types}` }
  if (action !== "redact") return { action: "allow", reason: `presidio found ${types}` }
  const b = enc.encode(text)
  found.sort((x: { type: string, start: f64, end: f64 }, y: { type: string, start: f64, end: f64 }) => x.start - y.start)
  let out = ""
  let pos = 0
  for (const f of found) {
    const s = cpToByte(b, f.start)
    const e = cpToByte(b, f.end)
    if (s < pos || e <= s) continue
    out += text.slice(pos, s) + `<${f.type}>`
    pos = e
  }
  return { action: "redact", reason: `presidio redacted ${types}`, text: out + text.slice(pos, text.byteLength) }
}

// Azure AI Language PII: any entity counts. redact uses Azure's redactedText.
function azurePiiVerdict(p: GuardrailProvider, body: string): Verdict throws Error {
  const results = find(try fields(body), "results")
  if (results === undefined || !results.startsWith("{")) throw new Error("no results in response")
  const docsRaw = find(try fields(results), "documents")
  if (docsRaw === undefined || !docsRaw.startsWith("[")) throw new Error("no documents in response")
  const docs = try elements(docsRaw)
  if (docs.length === 0) throw new Error("no documents in response")
  const doc = try fields(docs[0]!)
  const entRaw = find(doc, "entities")
  const ents = entRaw !== undefined && entRaw.startsWith("[") ? try elements(entRaw) : []
  if (ents.length === 0) return { action: "allow", reason: "" }
  const cats: string[] = []
  for (const e of ents) cats.push(rawStr(try fields(e), "category") ?? "PII")
  const action = p.action ?? "detect_only"
  if (action === "block") return { action: "block", reason: `azure language pii found ${cats.join(", ")}` }
  if (action === "redact") {
    const red = rawStr(doc, "redactedText")
    if (red === undefined) throw new Error("no redactedText in response")
    return { action: "redact", reason: `azure language pii redacted ${cats.join(", ")}`, text: red }
  }
  return { action: "allow", reason: `azure language pii found ${cats.join(", ")}` }
}

// The Fields of an object-valued key, or undefined.
// A value that is not an object, or does not parse, reads as undefined.
function objectAt(fs: Field[], key: string): Field[] | undefined {
  const raw = find(fs, key)
  if (raw === undefined || !raw.startsWith("{")) return undefined
  try {
    return fields(raw)
  } catch (e) {
    return undefined
  }
}

// Model Armor: NO_MATCH_FOUND allows. A match with SDP de-identified text
// redacts to that text; a match without it blocks (the template's result is final).
function modelArmorVerdict(body: string): Verdict throws Error {
  const sr = objectAt(try fields(body), "sanitizationResult")
  if (sr === undefined) throw new Error("no sanitizationResult in response")
  const state = rawStr(sr, "filterMatchState") ?? ""
  if (state === "NO_MATCH_FOUND") return { action: "allow", reason: "" }
  if (state !== "MATCH_FOUND") throw new Error("unknown filterMatchState")
  const fr = objectAt(sr, "filterResults")
  const sdp = fr === undefined ? undefined : objectAt(fr, "sdp")
  const dr = sdp === undefined ? undefined : objectAt(sdp, "sdpDeidentifyResult")
  const data = dr === undefined ? undefined : objectAt(dr, "data")
  const deid = data === undefined ? undefined : rawStr(data, "text")
  if (deid !== undefined) return { action: "redact", reason: "model armor de-identified sensitive data", text: deid }
  return { action: "block", reason: "model armor matched the template" }
}

// CrowdStrike AIDR: blocked stops the request (display_message or summary as the
// reason); transformed replaces the text with guard_output. Otherwise allow.
function aidrVerdict(body: string): Verdict throws Error {
  const top = try fields(body)
  const res = objectAt(top, "result")
  if (res === undefined) throw new Error("no result in response")
  const blocked = rawBool(res, "blocked") ?? false
  const transformed = rawBool(res, "transformed") ?? false
  if (blocked) {
    const why = rawStr(res, "display_message") ?? rawStr(top, "display_message") ?? rawStr(top, "summary") ?? rawStr(res, "summary") ?? "CrowdStrike AIDR policy"
    return { action: "block", reason: `blocked by CrowdStrike AIDR policy: ${why}` }
  }
  if (transformed) {
    const go = objectAt(res, "guard_output")
    const msgRaw = go === undefined ? undefined : find(go, "messages")
    if (msgRaw === undefined || !msgRaw.startsWith("[")) throw new Error("transformed without guard_output")
    const msgs = try elements(msgRaw)
    if (msgs.length !== 1) throw new Error("transformed output count does not match")
    const t = rawStr(try fields(msgs[0]!), "content")
    if (t === undefined) throw new Error("transformed output has no content")
    return { action: "redact", reason: "CrowdStrike AIDR transformed the text", text: t }
  }
  return { action: "allow", reason: "" }
}

// The verdict for a response. A non-2xx status or an unparsable body follows
// on_error, and the reason says why. Presidio needs the request text; use parseVerdictFor.
export function parseVerdict(p: GuardrailProvider, status: int, body: string): Verdict {
  if (status < 200 || status > 299) return onError(p, `HTTP ${status}`)
  try {
    if (p.kind === "bedrock") return bedrockVerdict(body)
    if (p.kind === "azure_content_safety") return azureVerdict(p, body)
    if (p.kind === "patronus") return patronusVerdict(body)
    if (p.kind === "azure_language_pii") return azurePiiVerdict(p, body)
    if (p.kind === "google_model_armor") return modelArmorVerdict(body)
    if (p.kind === "crowdstrike_aidr") return aidrVerdict(body)
    if (p.kind === "webhook") return webhookVerdict(body)
    throw new Error("no HTTP verdict for this kind")
  } catch (e) {
    return onError(p, `unparsable response: ${e.message}`)
  }
}

// parseVerdict with the request text, which Presidio's redaction needs.
export function parseVerdictFor(p: GuardrailProvider, text: string, status: int, body: string): Verdict {
  if (p.kind !== "presidio") return parseVerdict(p, status, body)
  if (status < 200 || status > 299) return onError(p, `HTTP ${status}`)
  try {
    return presidioVerdict(p, text, body)
  } catch (e) {
    return onError(p, `unparsable response: ${e.message}`)
  }
}

// ---- chat text ----

// Text of a message's content: a plain string, or the text parts of an array.
function contentText(raw: string | undefined): string {
  if (raw === undefined || isNull(raw)) return ""
  if (raw.startsWith("[")) {
    const parts: string[] = []
    try {
      for (const el of elements(raw)) {
        const t = rawStr(fields(el), "text")
        if (t !== undefined) parts.push(t)
      }
    } catch (e) {
      return parts.join("\n")
    }
    return parts.join("\n")
  }
  if (!raw.startsWith("\"")) return ""
  try {
    return decodeString(raw)
  } catch (e) {
    return ""
  }
}

// All message text of a chat request, one message per line. A body that is not
// valid JSON yields "", so callers should check the body parses before scanning.
export function extractText(chatBody: string): string {
  try {
    const msgs = find(fields(chatBody), "messages")
    if (msgs === undefined || isNull(msgs)) return ""
    const out: string[] = []
    for (const m of elements(msgs)) {
      const t = contentText(find(fields(m), "content"))
      if (t !== "") out.push(t)
    }
    return out.join("\n")
  } catch (e) {
    return ""
  }
}

// The content of the first choice of a chat completion. Empty when there is no
// text, for example a tool call.
export function completionText(completion: string): string {
  try {
    const choices = find(fields(completion), "choices")
    if (choices === undefined || isNull(choices)) return ""
    const first = elements(choices)[0]
    if (first === undefined) return ""
    const msg = find(fields(first), "message")
    if (msg === undefined || isNull(msg)) return ""
    return contentText(find(fields(msg), "content"))
  } catch (e) {
    return ""
  }
}

// ---- tests ----

function bedrockProvider(): GuardrailProvider {
  return {
    id: "pii-guard",
    kind: "bedrock",
    guardrail_id: "gr-abc123",
    guardrail_version: "1",
    region: "eu-west-1",
    access_key: "AKIDEXAMPLE",
    secret_key: "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY",
  }
}

function azureProvider(): GuardrailProvider {
  return { id: "azure", kind: "azure_content_safety", endpoint: "https://safety.example.cognitiveservices.azure.com/", api_key: "k1" }
}

function patronusProvider(): GuardrailProvider {
  return { id: "pat", kind: "patronus", api_key: "pk", evaluators: [{ evaluator: "toxicity" }, { evaluator: "custom", criteria: "no-pii" }] }
}

function webhookProvider(): GuardrailProvider {
  const h: Map<string, string> = new Map()
  h.set("Authorization", "Bearer t")
  h.set("Content-Type", "application/vnd.custom+json")
  return { id: "hook", kind: "webhook", url: "https://guard.example.com/check", headers: h }
}

test("bedrock request is a signed ApplyGuardrail call", () => {
  const r = try checkRequest(bedrockProvider(), "my card is 4111", "input", 1440938160000.0)
  expect(r.method).toBe("POST")
  expect(r.url).toBe("https://bedrock-runtime.eu-west-1.amazonaws.com/guardrail/gr-abc123/version/1/apply")
  expect(r.body).toBe(`{"source":"INPUT","content":[{"text":{"text":"my card is 4111"}}]}`)
  expect(r.headers.get("x-amz-date")).toBe("20150830T123600Z")
  expect(r.headers.get("content-type")).toBe("application/json")
  expect(r.headers.get("x-amz-security-token")).toBeUndefined()
  const auth = r.headers.get("authorization")!
  expect(auth.startsWith("AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20150830/eu-west-1/bedrock/aws4_request, SignedHeaders=content-type;host;x-amz-date, Signature=")).toBe(true)
  // signature from an independent Python hmac/hashlib computation over the same canonical request
  expect(auth.endsWith("Signature=8995a45fb444ebc79c4c018b6a34f76a3ed5a2a34ef6b9f1759498051640b7bb")).toBe(true)
})

test("bedrock output source and session token", () => {
  const p = bedrockProvider()
  p.session_token = "tok"
  p.region = undefined
  const r = try checkRequest(p, "x", "output", 1440938160000.0)
  expect(r.body.includes(`"source":"OUTPUT"`)).toBe(true)
  expect(r.url.startsWith("https://bedrock-runtime.us-east-1.amazonaws.com/")).toBe(true)
  expect(r.headers.get("x-amz-security-token")).toBe("tok")
})

test("bedrock guardrail id is percent-encoded and the signature is stable", () => {
  const p = bedrockProvider()
  p.guardrail_id = "a b"
  const r = try checkRequest(p, "x", "input", 1440938160000.0)
  expect(r.url.endsWith("/guardrail/a%20b/version/1/apply")).toBe(true)
  const again = try checkRequest(p, "x", "input", 1440938160000.0)
  expect(again.headers.get("authorization")).toBe(r.headers.get("authorization"))
})

test("bedrock missing fields throw", () => {
  const p = bedrockProvider()
  p.access_key = undefined
  let msg = ""
  try {
    checkRequest(p, "x", "input", 0.0)
  } catch (e) {
    msg = e.message
  }
  expect(msg).toBe("guardrail provider needs access_key")
  p.access_key = "AK"
  p.guardrail_id = undefined
  msg = ""
  try {
    checkRequest(p, "x", "input", 0.0)
  } catch (e) {
    msg = e.message
  }
  expect(msg).toBe("guardrail provider needs guardrail_id")
})

test("bedrock verdicts", () => {
  const p = bedrockProvider()
  expect(parseVerdict(p, 200, `{"action":"NONE","outputs":[],"assessments":[]}`)).toEqual({ action: "allow", reason: "" })
  // a denied topic blocks and names the topic
  const topic = `{"action":"GUARDRAIL_INTERVENED","outputs":[{"text":"blocked"}],"assessments":[{"topicPolicy":{"topics":[{"name":"Weapons","type":"DENY","action":"BLOCKED"}]}}]}`
  const v = parseVerdict(p, 200, topic)
  expect(v.action).toBe("block")
  expect(v.reason).toBe("bedrock guardrail intervened: Weapons")
  // only ANONYMIZED PII redacts to the output text
  const pii = `{"action":"GUARDRAIL_INTERVENED","outputs":[{"text":"mail me at {EMAIL}"}],"assessments":[{"sensitiveInformationPolicy":{"piiEntities":[{"type":"EMAIL","match":"a@b.co","action":"ANONYMIZED"}]}}]}`
  const rv = parseVerdict(p, 200, pii)
  expect(rv.action).toBe("redact")
  expect(rv.text).toBe("mail me at {EMAIL}")
  // a BLOCKED PII entity in the same assessment blocks even with anonymized ones
  const mixed = `{"action":"GUARDRAIL_INTERVENED","outputs":[{"text":"x"}],"assessments":[{"sensitiveInformationPolicy":{"piiEntities":[{"type":"EMAIL","match":"a@b.co","action":"ANONYMIZED"},{"type":"US_SSN","match":"123","action":"BLOCKED"}]}}]}`
  expect(parseVerdict(p, 200, mixed).action).toBe("block")
  expect(parseVerdict(p, 200, mixed).reason).toBe("bedrock guardrail intervened: US_SSN")
  // intervened with nothing listed blocks
  expect(parseVerdict(p, 200, `{"action":"GUARDRAIL_INTERVENED","outputs":[{"text":"x"}],"assessments":[]}`).action).toBe("block")
  // an unknown action is an unparsable response, so on_error applies
  expect(parseVerdict(p, 200, `{"action":"WHATEVER"}`).action).toBe("allow")
})

test("azure request shape", () => {
  const r = try checkRequest(azureProvider(), "hello", "input", 0.0)
  expect(r.url).toBe("https://safety.example.cognitiveservices.azure.com/contentsafety/text:analyze?api-version=2024-09-01")
  expect(r.headers.get("Ocp-Apim-Subscription-Key")).toBe("k1")
  expect(r.headers.get("content-type")).toBe("application/json")
  expect(r.body).toBe(`{"text":"hello","categories":["Hate","SelfHarm","Sexual","Violence"],"outputType":"FourSeverityLevels"}`)
  const p = azureProvider()
  p.categories = ["Violence"]
  expect((try checkRequest(p, "hi", "output", 0.0)).body).toBe(`{"text":"hi","categories":["Violence"],"outputType":"FourSeverityLevels"}`)
  p.categories = ["Profanity"]
  let msg = ""
  try {
    checkRequest(p, "hi", "output", 0.0)
  } catch (e) {
    msg = e.message
  }
  expect(msg).toBe("unknown azure content safety category: Profanity")
})

test("azure verdicts use the threshold", () => {
  const p = azureProvider()
  const ok = `{"categoriesAnalysis":[{"category":"Hate","severity":0},{"category":"Violence","severity":2}]}`
  expect(parseVerdict(p, 200, ok)).toEqual({ action: "allow", reason: "" })
  const bad = `{"categoriesAnalysis":[{"category":"Hate","severity":0},{"category":"Violence","severity":4},{"category":"Sexual","severity":6}]}`
  const v = parseVerdict(p, 200, bad)
  expect(v.action).toBe("block")
  expect(v.reason.includes("Violence severity 4")).toBe(true)
  expect(v.reason.includes("Sexual severity 6")).toBe(true)
  expect(v.reason.includes("Hate")).toBe(false)
  p.threshold = 6
  expect(parseVerdict(p, 200, bad).reason.includes("Sexual")).toBe(true)
  expect(parseVerdict(p, 200, bad).reason.includes("Violence")).toBe(false)
})

test("patronus request shape", () => {
  const r = try checkRequest(patronusProvider(), "reply text", "output", 0.0)
  expect(r.url).toBe("https://api.patronus.ai/v1/evaluate")
  expect(r.headers.get("X-API-KEY")).toBe("pk")
  expect(r.body).toBe(`{"evaluators":[{"evaluator":"toxicity"},{"evaluator":"custom","criteria":"no-pii"}],"evaluated_model_output":"reply text"}`)
  const i = try checkRequest(patronusProvider(), "q", "input", 0.0)
  expect(i.body.endsWith(`"evaluated_model_input":"q"}`)).toBe(true)
  const p = patronusProvider()
  p.base_url = "https://eu.example.com/"
  expect((try checkRequest(p, "q", "input", 0.0)).url).toBe("https://eu.example.com/v1/evaluate")
  p.evaluators = []
  let msg = ""
  try {
    checkRequest(p, "q", "input", 0.0)
  } catch (e) {
    msg = e.message
  }
  expect(msg).toBe("patronus needs at least one evaluator")
})

test("patronus verdicts", () => {
  const p = patronusProvider()
  expect(parseVerdict(p, 200, `{"results":[{"evaluator_id":"toxicity","pass":true},{"evaluator_id":"custom","pass":true}]}`)).toEqual({ action: "allow", reason: "" })
  const v = parseVerdict(p, 200, `{"results":[{"evaluator_id":"toxicity","pass":false},{"evaluator_id":"custom","pass":true}]}`)
  expect(v).toEqual({ action: "block", reason: "patronus evaluator failed: toxicity" })
  // a missing results array is not a clean pass
  expect(parseVerdict(p, 200, `{}`).action).toBe("allow")
  expect(parseVerdict(p, 200, `{}`).reason.startsWith("pat guardrail error: unparsable response")).toBe(true)
})

test("webhook request shape and headers", () => {
  const r = try checkRequest(webhookProvider(), "hi \"there\"", "input", 0.0)
  expect(r.url).toBe("https://guard.example.com/check")
  expect(r.method).toBe("POST")
  expect(r.body).toBe(`{"source":"input","text":"hi \\"there\\""}`)
  expect(r.headers.get("authorization")).toBe("Bearer t")
  // a configured Content-Type overrides the default
  expect(r.headers.get("content-type")).toBe("application/vnd.custom+json")
  const p = webhookProvider()
  p.url = undefined
  let msg = ""
  try {
    checkRequest(p, "x", "input", 0.0)
  } catch (e) {
    msg = e.message
  }
  expect(msg).toBe("guardrail provider needs url")
})

test("webhook verdicts", () => {
  const p = webhookProvider()
  expect(parseVerdict(p, 200, `{"allowed":true}`)).toEqual({ action: "allow", reason: "" })
  expect(parseVerdict(p, 200, `{"allowed":false,"reason":"leaks keys"}`)).toEqual({ action: "block", reason: "leaks keys" })
  expect(parseVerdict(p, 200, `{"allowed":false}`).reason).toBe("webhook guardrail denied")
  expect(parseVerdict(p, 200, `{"allowed":true,"text":"my key is [REDACTED]"}`)).toEqual({ action: "redact", reason: "", text: "my key is [REDACTED]" })
  expect(parseVerdict(p, 200, `{"text":"x"}`).action).toBe("allow")
  expect(parseVerdict(p, 200, `{"text":"x"}`).reason.startsWith("hook guardrail error")).toBe(true)
})

test("non-2xx and unparsable responses follow on_error", () => {
  const p = webhookProvider()
  const allow = parseVerdict(p, 503, "upstream down")
  expect(allow.action).toBe("allow")
  expect(allow.reason).toBe("hook guardrail error: HTTP 503")
  p.on_error = "block"
  expect(parseVerdict(p, 503, "").action).toBe("block")
  expect(parseVerdict(p, 200, "not json").action).toBe("block")
  expect(parseVerdict(p, 199, `{"allowed":true}`).action).toBe("block")
  p.on_error = "allow"
  expect(parseVerdict(p, 200, "not json").action).toBe("allow")
  const az = azureProvider()
  expect(parseVerdict(az, 401, `{"error":{}}`).reason.includes("HTTP 401")).toBe(true)
  expect(parseVerdict(az, 200, `{"categoriesAnalysis":[{"category":"Hate"}]}`).reason.includes("without severity")).toBe(true)
})

test("applies_to", () => {
  const p = webhookProvider()
  expect(appliesTo(p, "input")).toBe(true)
  p.apply_to = "output"
  expect(appliesTo(p, "input")).toBe(false)
  expect(appliesTo(p, "output")).toBe(true)
  p.apply_to = "both"
  expect(appliesTo(p, "input")).toBe(true)
})

test("extract text from chat bodies", () => {
  const body = `{"model":"x","messages":[{"role":"system","content":"be brief"},{"role":"user","content":[{"type":"text","text":"hi"},{"type":"image_url","image_url":{"url":"data:image/png;base64,AA"}},{"type":"text","text":"there"}]},{"role":"assistant","content":null,"tool_calls":[]},{"role":"tool","tool_call_id":"t","content":"42 \\"quoted\\""}]}`
  expect(extractText(body)).toBe("be brief\nhi\nthere\n42 \"quoted\"")
  expect(extractText(`{"messages":[]}`)).toBe("")
  expect(extractText(`{"nope":1}`)).toBe("")
  expect(extractText("[oops")).toBe("")
})

test("completion text is the first choice", () => {
  const c = `{"id":"1","choices":[{"index":0,"message":{"role":"assistant","content":"yes \\u00e9"}},{"index":1,"message":{"content":"no"}}]}`
  expect(completionText(c)).toBe("yes é")
  expect(completionText(`{"choices":[{"message":{"content":null,"tool_calls":[]}}]}`)).toBe("")
  expect(completionText(`{"choices":[]}`)).toBe("")
  expect(completionText(`{"usage":{}}`)).toBe("")
})

function presidioProvider(): GuardrailProvider {
  return { id: "pres", kind: "presidio", analyzer_url: "https://presidio.example.com/", api_key: "pk", action: "redact", score_threshold: 0.6 }
}

test("presidio request posts the text to /analyze", () => {
  const p = presidioProvider()
  const r = try checkRequest(p, "mail a@b.co", "input", 0.0)
  expect(r.url).toBe("https://presidio.example.com/analyze")
  expect(r.headers.get("authorization")).toBe("Bearer pk")
  expect(r.body).toBe(`{"text":"mail a@b.co","language":"en","score_threshold":0.6}`)
  p.entities = ["EMAIL_ADDRESS"]
  expect((try checkRequest(p, "x", "input", 0.0)).body.endsWith(`,"entities":["EMAIL_ADDRESS"]}`)).toBe(true)
})

test("presidio redacts by codepoint offsets, after multibyte text", () => {
  const p = presidioProvider()
  // "é" is two bytes but one codepoint, so the offsets count it once
  const text = "é mail a@b.co now"
  const body = `[{"entity_type":"EMAIL_ADDRESS","start":7,"end":13,"score":0.95}]`
  const v = parseVerdictFor(p, text, 200, body)
  expect(v.action).toBe("redact")
  expect(v.text).toBe("é mail <EMAIL_ADDRESS> now")
  expect(v.reason).toBe("presidio redacted EMAIL_ADDRESS")
})

test("presidio thresholds, block and detect_only", () => {
  const p = presidioProvider()
  const low = `[{"entity_type":"PERSON","start":0,"end":4,"score":0.3}]`
  expect(parseVerdictFor(p, "Anna went", 200, low)).toEqual({ action: "allow", reason: "" })
  expect(parseVerdictFor(p, "Anna went", 200, "[]")).toEqual({ action: "allow", reason: "" })
  p.action = "block"
  const hit = `[{"entity_type":"PERSON","start":0,"end":4,"score":0.9}]`
  expect(parseVerdictFor(p, "Anna went", 200, hit)).toEqual({ action: "block", reason: "presidio found PERSON" })
  p.action = "detect_only"
  expect(parseVerdictFor(p, "Anna went", 200, hit).action).toBe("allow")
  expect(parseVerdictFor(p, "Anna went", 503, hit).reason).toBe("pres guardrail error: HTTP 503")
  // an offset past the text is clamped, not a crash
  p.action = "redact"
  expect(parseVerdictFor(p, "hi", 200, `[{"entity_type":"X","start":1,"end":40,"score":0.9}]`).text).toBe("h<X>")
})

test("azure language pii request and verdicts", () => {
  const p: GuardrailProvider = { id: "az", kind: "azure_language_pii", endpoint: "https://lang.example.com", api_key: "k", action: "redact", pii_categories: ["Email"] }
  const r = try checkRequest(p, "a@b.co", "input", 0.0)
  expect(r.url).toBe("https://lang.example.com/language/:analyze-text?api-version=2026-05-01")
  expect(r.headers.get("Ocp-Apim-Subscription-Key")).toBe("k")
  expect(r.body.includes(`"piiCategories":["Email"]`)).toBe(true)
  expect(r.body.includes(`"stringIndexType":"UnicodeCodePoint"`)).toBe(true)
  const hit = `{"kind":"PiiEntityRecognitionResults","results":{"documents":[{"id":"1","redactedText":"***","entities":[{"text":"a@b.co","category":"Email","offset":0,"length":6,"confidenceScore":0.9}]}],"errors":[]}}`
  expect(parseVerdict(p, 200, hit)).toEqual({ action: "redact", reason: "azure language pii redacted Email", text: "***" })
  const clean = `{"results":{"documents":[{"id":"1","redactedText":"hi","entities":[]}],"errors":[]}}`
  expect(parseVerdict(p, 200, clean)).toEqual({ action: "allow", reason: "" })
  p.action = "block"
  expect(parseVerdict(p, 200, hit).action).toBe("block")
  expect(parseVerdict(p, 200, `{"results":{"documents":[]}}`).reason.includes("unparsable")).toBe(true)
})

function armorProvider(): GuardrailProvider {
  return { id: "arm", kind: "google_model_armor", project_id: "proj", location: "us", template_id: "tmpl", access_token: "tok" }
}

test("model armor request uses the template and the token", () => {
  const r = try checkRequest(armorProvider(), "ignore rules", "input", 0.0)
  expect(r.url).toBe("https://modelarmor.us.rep.googleapis.com/v1/projects/proj/locations/us/templates/tmpl:sanitizeUserPrompt")
  expect(r.body).toBe(`{"userPromptData":{"text":"ignore rules"}}`)
  expect(r.headers.get("authorization")).toBe("Bearer tok")
  const o = try checkRequest(armorProvider(), "answer", "output", 0.0)
  expect(o.url.endsWith(":sanitizeModelResponse")).toBe(true)
  expect(o.body).toBe(`{"modelResponseData":{"text":"answer"}}`)
})

test("model armor verdicts: no match, match, de-identified match", () => {
  const p = armorProvider()
  expect(parseVerdict(p, 200, `{"sanitizationResult":{"filterMatchState":"NO_MATCH_FOUND"}}`)).toEqual({ action: "allow", reason: "" })
  expect(parseVerdict(p, 200, `{"sanitizationResult":{"filterMatchState":"MATCH_FOUND","filterResults":{"pi_and_jailbreak":{}}}}`)).toEqual({ action: "block", reason: "model armor matched the template" })
  const sdp = `{"sanitizationResult":{"filterMatchState":"MATCH_FOUND","filterResults":{"sdp":{"sdpDeidentifyResult":{"data":{"text":"my card is [CREDIT_CARD]"}}}}}}`
  expect(parseVerdict(p, 200, sdp)).toEqual({ action: "redact", reason: "model armor de-identified sensitive data", text: "my card is [CREDIT_CARD]" })
  expect(parseVerdict(p, 200, `{"sanitizationResult":{"filterMatchState":"WHAT"}}`).reason.startsWith("arm guardrail error: unparsable")).toBe(true)
})

test("crowdstrike aidr request and verdicts", () => {
  const p: GuardrailProvider = { id: "cs", kind: "crowdstrike_aidr", api_key: "tk", base_url: "https://api.eu-1.crowdstrike.com/aidr/aiguard/v1/guard_chat_completions", app_id: "bifrost", collector_instance_id: "c1" }
  const r = try checkRequest(p, "hello", "input", 0.0)
  expect(r.url).toBe("https://api.eu-1.crowdstrike.com/aidr/aiguard/v1/guard_chat_completions")
  expect(r.headers.get("authorization")).toBe("Bearer tk")
  expect(r.body).toBe(`{"event_type":"input","guard_input":{"messages":[{"role":"user","content":"hello"}]},"app_id":"bifrost","collector_instance_id":"c1"}`)
  const o = try checkRequest({ id: "cs", kind: "crowdstrike_aidr", api_key: "tk" }, "x", "output", 0.0)
  expect(o.url).toBe("https://api.crowdstrike.com/aidr/aiguard/v1/guard_chat_completions")
  expect(o.body.includes(`"role":"assistant"`)).toBe(true)
  const blocked = `{"result":{"blocked":true,"display_message":"Malicious Prompt was detected and blocked."}}`
  expect(parseVerdict(p, 200, blocked)).toEqual({ action: "block", reason: "blocked by CrowdStrike AIDR policy: Malicious Prompt was detected and blocked." })
  const tr = `{"result":{"blocked":false,"transformed":true,"guard_output":{"messages":[{"role":"user","content":"my key is [X]"}]}}}`
  expect(parseVerdict(p, 200, tr)).toEqual({ action: "redact", reason: "CrowdStrike AIDR transformed the text", text: "my key is [X]" })
  expect(parseVerdict(p, 200, `{"result":{"blocked":false,"transformed":false}}`)).toEqual({ action: "allow", reason: "" })
  // a transform without its output is a failed call, so on_error applies
  expect(parseVerdict(p, 200, `{"result":{"blocked":false,"transformed":true}}`).action).toBe("allow")
  expect(parseVerdict(p, 200, `{"nope":1}`).reason.startsWith("cs guardrail error: unparsable")).toBe(true)
})

test("local kinds are not sent over HTTP", () => {
  const rx: GuardrailProvider = { id: "rx", kind: "regex", patterns: [] }
  expect(isLocal(rx)).toBe(true)
  expect(isLocal(webhookProvider())).toBe(false)
  let msg = ""
  try {
    checkRequest(rx, "x", "input", 0.0)
  } catch (e) {
    msg = e.message
  }
  expect(msg).toBe("local guardrail kinds run in-process, not over HTTP")
})
