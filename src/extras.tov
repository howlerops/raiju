// Rerank, token counting and async jobs: endpoints built on the jobs.tov helpers.
import { Field, fields, rawStr, rawBool, setField, build, quote } from "./json"
import { Engine, Build, Translate, errorResponse, noHeaders } from "./gateway"
import { ChatRequest, snapshot, errorJson } from "./schemas"
import { parseModel, kindOf } from "./router"
import { providerOf } from "./config"
import { JobStore, jobJson, resultTtlMs, asyncOp, estimateChatTokens, anthropicCountRequest, geminiCountRequest, countResponse, countTokensJson, parseRerank, rerankJson, lexicalRerank } from "./jobs"
import * as cohere from "./providers/cohere"
import * as openai from "./providers/openai"
import * as anthropic from "./providers/anthropic"
import * as gemini from "./providers/gemini"
import * as anthropicIn from "./providers/anthropic_in"
import * as bedrock from "./providers/bedrock"
import * as bedrockIn from "./bedrock_in"
import { Translated, Target } from "./providers/types"
import * as typesafe from "./providers/typesafe"
import * as providers from "./providers/index"
import { DecisionReq, parseDecision } from "./decisions"
import { emulationBody, emulatedDecision } from "./decision_emulate"
import { settingsOf, withHeader, responseToChat } from "./compat"
import * as responses from "./responses"

function json(status: int, body: string): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", "application/json")
  return new Response(body, { status: status, headers: h })
}

function kindFor(engine: Engine, model: string): { provider: string, model: string, kind: string } {
  const ref = parseModel(engine.cfg, model)
  const p = providerOf(engine.cfg, ref.provider)
  return { provider: ref.provider, model: ref.model, kind: p === undefined ? ref.provider : kindOf(ref.provider, p) }
}

// POST /v1/rerank: the provider's rerank API (Cohere, vLLM, Bedrock). Providers without one are
// an error, as in Bifrost; model "raiju/lexical" (any name under "raiju/") asks for a local
// lexical (BM25) ranking instead.
export async function rerank(engine: Engine, req: Request): Promise<Response> {
  return await rerankText(engine, req, await req.text(), false)
}

// POST /bedrock/rerank: Bedrock Agent Runtime's rerank body, served by Bedrock or by any
// rerank provider, and answered in Bedrock's shape.
export async function bedrockRerank(engine: Engine, req: Request): Promise<Response> {
  let cohere = ""
  try {
    cohere = bedrock.rerankFromWire(await req.text())
  } catch (e) {
    return errorResponse(400, `invalid rerank request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  return await rerankText(engine, req, cohere, true)
}

// The reply in the route's shape: Bedrock's when wire is set.
function rerankShape(o: Translated, wire: bool): Translated throws SyntaxError {
  if (!wire) return o
  return { body: try bedrock.rerankWire(o.body), promptTokens: o.promptTokens, completionTokens: o.completionTokens }
}

// The rerank route for a body in Raiju's own shape (query, documents, top_n).
async function rerankText(engine: Engine, req: Request, text: string, wire: bool): Promise<Response> {
  let body: Field[] = []
  let model = ""
  let query = ""
  let docs: string[] = []
  let topN = 0
  try {
    body = fields(text)
    model = parseRerank(text).model
    query = parseRerank(text).query
    docs = parseRerank(text).documents
    topN = parseRerank(text).topN
  } catch (e) {
    return errorResponse(400, `invalid rerank request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const k = kindFor(engine, model)
  if (k.kind === "cohere") {
    const b: Build = (t) => cohere.rerankRequest(t, body)
    const tr: Translate = (t, out, requested) => try rerankShape(try cohere.rerankResponse(out, requested), wire)
    return await engine.serve(req, "rerank", undefined, body, text, b, tr, false)
  }
  if (k.kind === "vllm") {
    const b: Build = (t) => openai.rerankRequest(t, body)
    const tr: Translate = (t, out, requested) => try rerankShape(try cohere.rerankResponse(out, requested), wire)
    return await engine.serve(req, "rerank", undefined, body, text, b, tr, false)
  }
  if (k.kind === "bedrock") {
    const ret = !wire && (rawBool(body, "return_documents") ?? true)
    const b: Build = (t) => try bedrock.rerankUpstream(t, query, docs, topN)
    const tr: Translate = (t, out, requested) => {
      const scored = try bedrock.rerankResults(out)
      const units = Math.ceil(docs.length / 100)
      return try rerankShape({ body: rerankJson(scored, docs, ret, requested, units), promptTokens: 0, completionTokens: 0 }, wire)
    }
    return await engine.serve(req, "rerank", undefined, body, text, b, tr, false)
  }
  if (!model.startsWith("raiju/")) {
    return errorResponse(400, `rerank is not supported by provider ${k.provider}; use a provider with a rerank API (cohere, vllm, bedrock), or model "raiju/lexical" for a local lexical ranking`, "unsupported_operation", noHeaders())
  }
  if (engine.gov.enforce && engine.gov.findKey(snapshot(req.headers)) === undefined) {
    return errorResponse(401, "a virtual key is required", "authentication_error", noHeaders())
  }
  try {
    const scored = lexicalRerank(query, docs)
    scored.sort((a, b) => b.score - a.score)
    const top = scored.slice(0, topN)
    const out = rerankJson(top, docs, rawBool(body, "return_documents") ?? true, model, 0)
    return json(200, (try rerankShape({ body: out, promptTokens: 0, completionTokens: 0 }, wire)).body)
  } catch (e) {
    return errorResponse(400, `invalid rerank request: ${e.message}`, "invalid_request_error", noHeaders())
  }
}

// POST /v1/count_tokens (an OpenAI chat body) and /anthropic/v1/messages/count_tokens
// (an Anthropic Messages body). Anthropic and Gemini count exactly through their
// APIs; everyone else gets an estimate, marked "exact": false.
export async function countTokens(engine: Engine, req: Request, anthropicShape: bool): Promise<Response> {
  const text = await req.text()
  let body: Field[] = []
  try {
    body = fields(text)
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const model = rawStr(body, "model") ?? ""
  const k = kindFor(engine, model)
  try {
    if (anthropicShape) {
      if (k.kind === "anthropic") {
        const b: Build = (t) => try anthropicCountRequest(t, text)
        const tr: Translate = (t, text, requested) => ({ body: text, promptTokens: 0, completionTokens: 0 })
        return await engine.serve(req, "count_tokens", undefined, body, text, b, tr, false)
      }
      const n = estimateChatTokens(anthropicIn.toChatRequest(text, model))
      return json(200, `{"input_tokens":${n}}`)
    }
    if (k.kind === "anthropic" || k.kind === "gemini") {
      const typed = JSON.parse(text) as ChatRequest
      const b: Build = (t) => {
        if (t.kind === "gemini") return try geminiCountRequest(t, try gemini.generateBody(typed, body))
        return try anthropicCountRequest(t, try anthropic.messagesBody(typed, body, t.model, false, false))
      }
      const tr: Translate = (t, text, requested) => ({ body: countTokensJson(try countResponse(t.kind, text), model, true), promptTokens: 0, completionTokens: 0 })
      return await engine.serve(req, "count_tokens", undefined, body, text, b, tr, false)
    }
    return json(200, countTokensJson(estimateChatTokens(text), model, false))
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
}

// POST /bedrock/model/{id}/count-tokens. A Bedrock model is counted by Bedrock's CountTokens,
// exactly. Another provider, or a model Bedrock cannot count, gets the estimate, marked
// "exact": false.
export async function bedrockCountTokens(engine: Engine, req: Request, id: string, text: string): Promise<Response> {
  let est = 0
  try {
    est = estimateChatTokens(bedrockIn.countTokensToRaiju(text))
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const estimate = json(200, bedrockIn.countTokensResponse(est, false))
  const full = id.includes("/") && !id.startsWith("arn:") ? id : "bedrock/" + id
  if (kindFor(engine, full).kind !== "bedrock") return estimate
  const b: Build = (t) => bedrock.signedRequest(t, "count-tokens", text)
  const tr: Translate = (t, out, requested) => {
    const u = try JSON.parse(out) as { inputTokens?: int }
    return { body: bedrockIn.countTokensResponse(u.inputTokens ?? 0, true), promptTokens: 0, completionTokens: 0 }
  }
  const r = await engine.serve(req, "bedrock.count-tokens", full, [], text, b, tr, false)
  if (r.status === 200) return r
  let msg = ""
  try {
    msg = await r.text()
  } catch (e) {
    return errorResponse(502, `invalid upstream answer: ${e.message}`, "api_error", noHeaders())
  }
  // a model Bedrock cannot count: the estimate, as the other providers get
  if (msg.includes("counting tokens")) return estimate
  return json(r.status, msg)
}

// Bifrost's decision API and TypeSafe's native routes. POST /v1/decisions (and /openai/v1/decisions) answers the
// canonical decision request from TypeSafe and the custom providers on its base format; any other provider is
// refused, as Bifrost refuses it. POST /typesafe/v1/systemone passes TypeSafe's own body through, and
// GET /typesafe/v1/models lists its catalog in its own shape.
export async function decisionRoute(engine: Engine, req: Request, p: string): Promise<Response> {
  if (p === "/typesafe/v1/models") return await typesafeModels(engine, req)
  if (p === "/typesafe/v1/systemone") return await typesafeSystemOne(engine, req)
  const text = await req.text()
  let d: DecisionReq = { model: "", state: "null", questions: [] }
  let body: Field[] = []
  try {
    d = try parseDecision(text)
    body = try fields(text)
  } catch (e) {
    return errorResponse(400, `invalid decision request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const decision: DecisionReq = d
  const k = kindFor(engine, decision.model)
  if (!providers.supportsDecisions(k.kind)) {
    // compat's convert_decision_to_responses (off by default): the model answers the question itself
    const settings = withHeader(settingsOf(engine.cfg.client?.compat), req.headers.get("x-bf-compat") ?? undefined)
    if (!settings.decisions) return json(400, errorJson(`decisions is not supported by ${k.provider} provider`, "invalid_request_error", "unsupported_operation"))
    return await decisionByEmulation(engine, req, decision, k.kind, body, text)
  }
  const mk: Build = (t) => try typesafe.systemoneUpstream(t, decision)
  const tr: Translate = (t, out, requested) => try typesafe.translateDecision(out, decision, requested)
  return await engine.serve(req, "decisions", undefined, body, text, mk, tr, false)
}

// A decision asked of a model with no decisions endpoint: the questions go as one forced function call
// (decision_emulate.tov). An OpenAI model is asked through Responses, any other through its chat call; the
// answer is rendered as the canonical decision, and the header says which request type the call was.
async function decisionByEmulation(engine: Engine, req: Request, d: DecisionReq, kind: string, body: Field[], text: string): Promise<Response> {
  const mk: Build = (t) => {
    const eb = try emulationBody(d, t.model)
    if (t.kind === "openai") return openai.responsesRequest(t, try fields(eb))
    const chat = try responses.toChatRequest(eb, t.model)
    return try providers.chatUpstream(t, try JSON.parse(chat) as ChatRequest, try fields(chat), false)
  }
  const tr: Translate = (t, out, requested) => {
    const ch: Translated = t.kind === "openai" ? try responseToChat(out, requested) : try providers.chatTranslate(t.kind, t.model, out, requested, false)
    return try emulatedDecision(ch.body, d, requested, ch.promptTokens, ch.completionTokens)
  }
  const r = await engine.serve(req, "decisions", undefined, body, text, mk, tr, false)
  if (r.status !== 200) return r
  let answer = ""
  try {
    answer = await r.text()
  } catch (e) {
    return errorResponse(502, `could not read the answer: ${e.message}`, "api_error", noHeaders())
  }
  const hs: Record<string, string> = new Map()
  r.headers.forEach((v, key) => {
    if (key !== "content-length") hs.set(key, v)
  })
  hs.set("x-bifrost-converted-request-type", kind === "openai" ? "responses" : "chat_completion")
  return new Response(answer, { status: 200, headers: hs })
}

async function typesafeSystemOne(engine: Engine, req: Request): Promise<Response> {
  const text = await req.text()
  const provider = req.headers.get("x-bf-model-provider") ?? "typesafe"
  let body: Field[] = []
  let model = ""
  try {
    body = fields(text)
    model = rawStr(body, "model") ?? ""
  } catch (e) {
    return errorResponse(400, `invalid request: ${e.message}`, "invalid_request_error", noHeaders())
  }
  const bare = model.startsWith("typesafe/") ? model.slice(9) : model
  const k = kindFor(engine, provider + "/" + bare)
  if (!providers.supportsDecisions(k.kind)) return errorResponse(400, `${provider} is not a TypeSafe provider`, "invalid_request_error", noHeaders())
  setField(&body, "model", quote(provider + "/" + bare))
  const text2 = build(body)
  const b: Build = (t) => try typesafe.nativeUpstream(t, text2)
  const tr: Translate = (t, out, requested) => ({ body: out, promptTokens: 0, completionTokens: 0 })
  return await engine.serve(req, "decisions", undefined, body, text2, b, tr, false)
}

// GET /typesafe/v1/models: the provider's native catalog. On the default endpoint the pinned jev catalog is merged
// into the live listing, and it stands in when the live call fails there; a custom endpoint's failure is reported.
async function typesafeModels(engine: Engine, req: Request): Promise<Response> {
  if (engine.gov.enforce && engine.gov.findKey(snapshot(req.headers)) === undefined) {
    return errorResponse(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", noHeaders())
  }
  const name = req.headers.get("x-bf-model-provider") ?? "typesafe"
  const p = providerOf(engine.cfg, name)
  if (p === undefined) return errorResponse(404, `no provider ${name}`, "invalid_request_error", noHeaders())
  const kind = kindOf(name, p)
  if (!typesafe.isTypesafeKind(kind)) return errorResponse(400, `${name} is not a TypeSafe provider`, "invalid_request_error", noHeaders())
  const key = (p.keys ?? [])[0] ?? { value: "" }
  const t: Target = { provider: name, kind: kind, model: "", key: key, cfg: p }
  const up = typesafe.modelsUpstream(t)
  const dflt = typesafe.usesDefaultBase(t)
  let live: string | undefined = undefined
  try {
    const hs = new Headers()
    for (const k of up.headers.keys()) hs.set(k, up.headers.get(k)!)
    const res = await fetch(up.url, { headers: hs, signal: AbortSignal.timeout(5000) })
    const text = await res.text()
    if (res.ok) live = text
  } catch (e) {
    live = undefined
  }
  if (live === undefined) {
    if (!dflt) return errorResponse(502, `${name} did not list its models`, "api_error", noHeaders())
    return json(200, JSON.stringify({ models: typesafe.TYPESAFE_PINNED }))
  }
  if (!dflt) return json(200, live)
  try {
    const listing = try JSON.parse(live) as { models: typesafe.TypesafeModel[] }
    const seen = listing.models.map((m) => m.name)
    const merged = listing.models.concat(typesafe.TYPESAFE_PINNED.filter((m) => !seen.includes(m.name)))
    return json(200, JSON.stringify({ models: merged }))
  } catch (e) {
    return errorResponse(502, `invalid model listing from ${name}: ${e.message}`, "api_error", noHeaders())
  }
}

export type Dispatch = (req: Request) => Promise<Response, Error>

async function runJob(jobs: JobStore, id: string, inner: Request, dispatch: Dispatch): Promise<void> {
  jobs.start(id)
  try {
    const res = await dispatch(inner)
    const text = await res.text()
    jobs.finish(id, res.status, text, Math.floor(Date.now()))
  } catch (e) {
    jobs.finish(id, 500, errorJson(e.message, "api_error", undefined), Math.floor(Date.now()))
  }
}

// POST /v1/async/<op>: answers 202 with a job at once and runs the request in the background.
export async function asyncSubmit(jobs: JobStore, req: Request, path: string, dispatch: Dispatch): Promise<Response> {
  const target = asyncOp(path)
  if (target === undefined) return errorResponse(404, `no async operation for ${path}`, "invalid_request_error", noHeaders())
  // the op as Bifrost names it ("chat/completions"), which its poll path repeats
  const job = jobs.create(path.slice("/v1/async/".byteLength, path.byteLength), Math.floor(Date.now()), resultTtlMs(snapshot(req.headers)))
  if (job === undefined) return errorResponse(503, "too many async jobs are running; retry later", "api_error", noHeaders())
  const text = await req.text()
  const h: Record<string, string> = snapshot(req.headers)
  const inner = new Request("http://raiju.internal" + target, { method: "POST", headers: h, body: text })
  // not awaited: runs as its own task after this response goes out
  runJob(jobs, job.id, inner, dispatch)
  return json(202, jobJson(job, jobs.ttlMs))
}

// GET /v1/async/<op>/{id} (Bifrost's poll path; the job must be of that op) and
// GET /v1/async/jobs/{id} (any op).
export function asyncGet(jobs: JobStore, op: string, id: string): Response {
  const j = jobs.get(id, Math.floor(Date.now()))
  if (j === undefined || (op !== "jobs" && j.op !== op)) return errorResponse(404, `no job ${id} (it may have expired)`, "invalid_request_error", noHeaders())
  return json(200, jobJson(j, jobs.ttlMs))
}

// x-bf-async on an SDK route (Bifrost's integration routes): the same request runs as a job, and the
// caller gets the job at once. op is the route's path without its leading slash (the prefix-free route),
// which a poll on that route repeats.
export async function sdkAsyncSubmit(jobs: JobStore, req: Request, dispatch: Dispatch, op: string): Promise<Response> {
  const job = jobs.create(op, Math.floor(Date.now()), resultTtlMs(snapshot(req.headers)))
  if (job === undefined) return errorResponse(503, "too many async jobs are running; retry later", "api_error", noHeaders())
  const text = await req.text()
  // the job runs the plain request: the async flag and its poll id are not forwarded
  const h: Record<string, string> = snapshot(req.headers)
  h.delete("x-bf-async")
  h.delete("x-bf-async-id")
  const inner = new Request(req.url, { method: "POST", headers: h, body: text })
  // not awaited: runs as its own task after this response goes out
  runJob(jobs, job.id, inner, dispatch)
  return json(202, jobJson(job, jobs.ttlMs))
}

// GET on an SDK route with x-bf-async-id: the job while it runs (202), then the route's own answer
// or error once it is done. undefined when the id is not a job of that route.
export function sdkAsyncPoll(jobs: JobStore, op: string, id: string): Response {
  const j = jobs.get(id, Math.floor(Date.now()))
  if (j === undefined || j.op !== op) return errorResponse(404, `job not found or expired`, "invalid_request_error", noHeaders())
  if (j.status === "pending" || j.status === "processing") return json(202, jobJson(j, jobs.ttlMs))
  const st = j.http_status ?? (j.status === "failed" ? 500 : 200)
  return new Response(j.raw ?? "", { status: st, headers: { "content-type": "application/json" } })
}
