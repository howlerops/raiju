// Exact-match response cache (Bifrost's "direct" semantic-cache mode). The key
// is the routed model plus the request body; x-bf-cache-key scopes entries,
// x-bf-cache-ttl overrides the TTL and x-bf-cache-no-store skips storing.
// With shareDir set (the workers of one node), entries are also files there,
// so a response cached by one worker is a hit in the others.
import { existsSync, readFileSync, writeFileSync, readdirSync, unlinkSync, mkdirSync, rmSync } from "node:fs"
import { writeFileAtomic } from "./atomicfile"
import { sha256, toHex, utf8 } from "./crypto"

// Where a cached answer came from: the provider and model that served it and the prompt tokens it
// counted. A hit answers x-bifrost-cache-provider-used, -model-used and -input-tokens with them.
export type CacheOrigin = { provider: string, model: string, inputTokens: int }

// nameHex is the hex of the x-bf-cache-key the entry was stored under ("" for none).
type Entry = { body: string, contentType: string, expires: f64, origin?: CacheOrigin, nameHex: string }

export class ResponseCache {
  entries: Map<string, Entry> = new Map()
  hits = 0
  misses = 0
  shareDir = ""

  constructor(readonly ttlMs: int, readonly maxEntries: int) {}

  share(dir: string): void {
    try {
      mkdirSync(dir, { recursive: true })
      this.shareDir = dir
    } catch (e) {
      this.shareDir = ""
    }
  }

  private file(key: string): string {
    return this.shareDir + "/" + toHex(sha256(utf8(key)))
  }

  // A shared entry: "<expires>\t<body bytes>\t<provider>\t<model>\t<input tokens>\t<content type>\t<key name hex>\n<body>".
  // A file being written (no atomic rename in node:fs) has a short body and reads as a miss.
  private readShared(key: string): Entry | undefined {
    if (this.shareDir === "") return undefined
    let text = ""
    try {
      text = readFileSync(this.file(key), "utf8")
    } catch (e) {
      return undefined
    }
    const nl = text.indexOf("\n")
    if (nl < 0) return undefined
    const head = text.slice(0, nl).split("\t")
    const expires = parseFloat(head[0] ?? "")
    const len = parseInt(head[1] ?? "")
    const body = text.slice(nl + 1)
    if (expires === undefined || len === undefined || head.length < 7 || body.byteLength !== len) return undefined
    if (expires < Date.now()) return undefined
    const provider = head[2] ?? ""
    const tokens = parseInt(head[4] ?? "") ?? 0
    const origin: CacheOrigin | undefined = provider === "" ? undefined : { provider: provider, model: head[3] ?? "", inputTokens: tokens }
    return { body: body, contentType: head.slice(5, head.length - 1).join("\t"), expires: expires, origin: origin, nameHex: head[head.length - 1] ?? "" }
  }

  // Removes expired shared files; returns how many went.
  sweepShared(now: f64): int {
    if (this.shareDir === "") return 0
    let n = 0
    try {
      for (const f of readdirSync(this.shareDir)) {
        const p = this.shareDir + "/" + f
        try {
          const t = readFileSync(p, "utf8")
          const tab = t.indexOf("\t")
          const exp = tab < 0 ? undefined : parseFloat(t.slice(0, tab))
          if (exp !== undefined && exp < now) {
            unlinkSync(p)
            n += 1
          }
        } catch (e) {
          continue
        }
      }
    } catch (e) {
      return n
    }
    return n
  }

  get(key: string): Entry | undefined {
    let e = this.entries.get(key)
    // with several workers every entry is also a shared file, and a clear on any worker removes the file:
    // a copy in memory whose file is gone was cleared, so it is dropped here
    if (e !== undefined && this.shareDir !== "" && !existsSync(this.file(key))) {
      this.entries.delete(key)
      e = undefined
    }
    if (e === undefined) {
      const shared = this.readShared(key)
      if (shared !== undefined) {
        this.entries.set(key, shared)
        e = shared
      }
    }
    if (e === undefined) {
      this.misses += 1
      return undefined
    }
    if (e.expires < Date.now()) {
      this.entries.delete(key)
      this.misses += 1
      return undefined
    }
    this.hits += 1
    return e
  }

  // name is the request's x-bf-cache-key ("" for none), kept so the entries can be cleared by key.
  set(key: string, body: string, contentType: string, ttlMs: int, origin?: CacheOrigin, name?: string): void {
    if (this.entries.size >= this.maxEntries) this.evict()
    const expires = Date.now() + ttlMs
    const nameHex = toHex(utf8(name ?? ""))
    this.entries.set(key, { body: body, contentType: contentType, expires: expires, origin: origin, nameHex: nameHex })
    if (this.shareDir !== "") {
      const o = origin
      const prov = o === undefined ? "" : o.provider
      const model = o === undefined ? "" : o.model
      const tokens = o === undefined ? 0 : o.inputTokens
      try {
        writeFileAtomic(this.file(key), `${expires}\t${body.byteLength}\t${prov}\t${model}\t${tokens}\t${contentType}\t${nameHex}\n${body}`, { durable: false })
      } catch (e) {
        // the shared copy is a bonus; this worker still has the entry
      }
    }
  }

  // Removes the entry whose cache id is id (the hash of its key, the name of its shared file), here and
  // as a shared file. Returns how many went. The id must be 64 hex digits: it becomes a file name.
  clearId(id: string): int {
    if (!isCacheId(id)) return 0
    let n = 0
    for (const k of this.entries.keys()) {
      if (toHex(sha256(utf8(k))) !== id) continue
      this.entries.delete(k)
      n += 1
    }
    if (this.shareDir !== "") {
      try {
        unlinkSync(this.shareDir + "/" + id)
        n += 1
      } catch (e) {
        // no shared copy
      }
    }
    return n
  }

  // Removes the entries stored under an x-bf-cache-key, here and as shared files. Returns how many went.
  // Other workers' copies in memory last until they expire.
  clearKey(name: string): int {
    const want = toHex(utf8(name))
    let n = 0
    for (const k of this.entries.keys()) {
      const e = this.entries.get(k)
      if (e === undefined || e.nameHex !== want) continue
      this.entries.delete(k)
      n += 1
    }
    if (this.shareDir !== "") {
      let files: string[] = []
      try {
        files = readdirSync(this.shareDir)
      } catch (e) {
        files = []
      }
      for (const f of files) {
        const p = this.shareDir + "/" + f
        let first = ""
        try {
          first = readFileSync(p, "utf8").split("\n")[0] ?? ""
        } catch (e) {
          continue
        }
        const parts = first.split("\t")
        if (parts.length < 7 || parts[parts.length - 1] !== want) continue
        try {
          unlinkSync(p)
          n += 1
        } catch (e) {
          continue
        }
      }
    }
    return n
  }

  // Drops expired entries, then the oldest tenth if still full.
  evict(): void {
    const now = Date.now()
    const keys = this.entries.keys()
    for (const k of keys) {
      const e = this.entries.get(k)
      if (e !== undefined && e.expires < now) this.entries.delete(k)
    }
    if (this.entries.size < this.maxEntries) return
    const drop = Math.max(1, Math.floor(this.maxEntries / 10))
    let n = 0
    for (const k of this.entries.keys()) {
      if (n >= drop) break
      this.entries.delete(k)
      n += 1
    }
  }
}

// Whether s is a cache id: 64 lowercase hex digits (the SHA-256 of a cache key).
export function isCacheId(s: string): bool {
  if (s.byteLength !== 64) return false
  for (let i = 0; i < 64; i++) {
    const c = s.slice(i, i + 1)
    const hex = (c >= "0" && c <= "9") || (c >= "a" && c <= "f")
    if (!hex) return false
  }
  return true
}

// "30s", "5m", "1h" or plain seconds.
export function parseTtl(s: string): int | undefined {
  let unit = 1000.0
  let num = s.trim()
  if (num.endsWith("ms")) {
    unit = 1.0
    num = num.slice(0, num.byteLength - 2)
  } else if (num.endsWith("s")) {
    num = num.slice(0, num.byteLength - 1)
  } else if (num.endsWith("m")) {
    unit = 60000.0
    num = num.slice(0, num.byteLength - 1)
  } else if (num.endsWith("h")) {
    unit = 3600000.0
    num = num.slice(0, num.byteLength - 1)
  }
  const n = parseFloat(num)
  if (n === undefined) return undefined
  return Math.round(n * unit)
}

export function cacheKey(scope: string, model: string, body: string): string {
  return scope + "\u0000" + model + "\u0000" + body
}

// The scope with the virtual key's id added unless scope_by_virtual_key is false, so two keys
// never share an entry. Shared files are named by a hash of the key, so they follow it.
export function keyScope(scope: string, vk: string, byKey: bool): string {
  if (!byKey) return scope
  return scope + "\u0001vk=" + vk
}

test("stores, expires and evicts", () => {
  const c = new ResponseCache(1000, 10)
  c.set("a", "A", "application/json", 1000)
  expect(c.get("a")!.body).toBe("A")
  c.set("old", "x", "application/json", -1)
  expect(c.get("old")).toBeUndefined()
  for (let i = 0; i < 25; i++) c.set("k" + i, "v", "application/json", 1000)
  expect(c.entries.size <= 10).toBe(true)
  expect(parseTtl("5m")).toBe(300000)
  expect(parseTtl("30")).toBe(30000)
})

test("the exact-cache scope includes the virtual key only when asked", () => {
  expect(keyScope("chat", "vk-a", false)).toBe("chat")
  expect(keyScope("chat", "vk-a", false) === keyScope("chat", "vk-b", false)).toBe(true)
  expect(keyScope("chat", "vk-a", true) === keyScope("chat", "vk-b", true)).toBe(false)
  expect(keyScope("chat", "", true) === keyScope("chat", "vk-a", true)).toBe(false)
  expect(cacheKey(keyScope("chat", "vk-a", true), "m", "{}") === cacheKey(keyScope("chat", "vk-b", true), "m", "{}")).toBe(false)
  const a = new ResponseCache(1000, 10)
  a.set(cacheKey(keyScope("chat", "vk-a", true), "m", "{}"), "A", "application/json", 1000)
  expect(a.get(cacheKey(keyScope("chat", "vk-b", true), "m", "{}"))).toBeUndefined()
  expect(a.get(cacheKey(keyScope("chat", "vk-a", true), "m", "{}"))!.body).toBe("A")
})

test("a shared cache directory serves entries across instances", () => {
  const dir = "/tmp/raiju-cache-test-" + Math.floor(Math.random() * 1000000000)
  const a = new ResponseCache(1000, 10)
  const b = new ResponseCache(1000, 10)
  a.share(dir)
  b.share(dir)
  a.set("k", "{\"x\":1}", "application/json", 60000)
  const got = b.get("k")
  expect(got?.body).toBe("{\"x\":1}")
  expect(got?.contentType).toBe("application/json")
  b.set("old", "gone", "text/plain", -1000)
  expect(a.sweepShared(Date.now())).toBe(1)
  expect(a.get("old")).toBeUndefined()
  // cleared by key: the memory copy and the shared file both go
  a.set("kk", "tagged", "text/plain", 60000, undefined, "team-a")
  expect(a.clearKey("team-a")).toBe(2)
  expect(b.get("kk")).toBeUndefined()
  expect(a.clearKey("team-a")).toBe(0)
  // cleared by id: the id is the hash of the key, and the shared file has that name
  a.set("kid", "by id", "text/plain", 60000)
  const id = toHex(sha256(utf8("kid")))
  expect(isCacheId(id)).toBe(true)
  // b holds a copy in memory; the clear on a removes the shared file, so b drops its copy too
  expect(b.get("kid")?.body).toBe("by id")
  expect(a.clearId(id)).toBe(2)
  expect(b.get("kid")).toBeUndefined()
  // an id that is not a hash is refused: it would name a file
  expect(a.clearId("../" + id)).toBe(0)
  try {
    rmSync(dir, { recursive: true, force: true })
  } catch (e) {}
})

test("a cached answer keeps its origin, in memory and in a shared directory", () => {
  const dir = "/tmp/raiju-cache-origin-" + Math.floor(Math.random() * 1000000000)
  const a = new ResponseCache(1000, 10)
  const b = new ResponseCache(1000, 10)
  a.share(dir)
  b.share(dir)
  a.set("k", "{}", "application/json", 60000, { provider: "openai", model: "gpt-4o", inputTokens: 12 })
  a.set("plain", "{}", "application/json", 60000)
  const mem = a.get("k")!
  expect(mem.origin!.provider).toBe("openai")
  expect(mem.origin!.model).toBe("gpt-4o")
  expect(mem.origin!.inputTokens).toBe(12)
  const shared = b.get("k")!
  expect(shared.body).toBe("{}")
  expect(shared.origin!.provider).toBe("openai")
  expect(shared.origin!.inputTokens).toBe(12)
  expect(b.get("plain")!.origin === undefined).toBe(true)
  try {
    rmSync(dir, { recursive: true, force: true })
  } catch (e) {}
})

test("clearing by id and by key in memory", () => {
  const c = new ResponseCache(60000, 10)
  c.set("one", "1", "text/plain", 60000, undefined, "k1")
  c.set("two", "2", "text/plain", 60000, undefined, "k1")
  c.set("three", "3", "text/plain", 60000)
  expect(c.clearKey("k1")).toBe(2)
  expect(c.get("one")).toBeUndefined()
  expect(c.get("three")?.body).toBe("3")
  c.set("four", "4", "text/plain", 60000)
  expect(c.clearId(toHex(sha256(utf8("four"))))).toBe(1)
  expect(c.get("four")).toBeUndefined()
  expect(isCacheId("abc")).toBe(false)
  expect(isCacheId("A".repeat(64))).toBe(false)
})
