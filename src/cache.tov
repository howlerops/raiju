// Exact-match response cache (Bifrost's "direct" semantic-cache mode). The key
// is the routed model plus the request body; x-bf-cache-key scopes entries,
// x-bf-cache-ttl overrides the TTL and x-bf-cache-no-store skips storing.

type Entry = { body: string, contentType: string, expires: f64 }

export class ResponseCache {
  entries: Map<string, Entry> = new Map()
  hits = 0
  misses = 0
  constructor(readonly ttlMs: int, readonly maxEntries: int) {}

  get(key: string): Entry | undefined {
    const e = this.entries.get(key)
    if (e === undefined) {
      this.misses += 1
      return undefined
    }
    if (e.expires < Date.now()) {
      this.entries.delete(key)
      this.misses += 1
      return undefined
    }
    this.hits += 1
    return e
  }

  set(key: string, body: string, contentType: string, ttlMs: int): void {
    if (this.entries.size >= this.maxEntries) this.evict()
    this.entries.set(key, { body: body, contentType: contentType, expires: Date.now() + ttlMs })
  }

  // Drops expired entries, then the oldest tenth if still full.
  evict(): void {
    const now = Date.now()
    const keys = this.entries.keys()
    for (const k of keys) {
      const e = this.entries.get(k)
      if (e !== undefined && e.expires < now) this.entries.delete(k)
    }
    if (this.entries.size < this.maxEntries) return
    const drop = Math.max(1, Math.floor(this.maxEntries / 10))
    let n = 0
    for (const k of this.entries.keys()) {
      if (n >= drop) break
      this.entries.delete(k)
      n += 1
    }
  }
}

// "30s", "5m", "1h" or plain seconds.
export function parseTtl(s: string): int | undefined {
  let unit = 1000.0
  let num = s.trim()
  if (num.endsWith("ms")) {
    unit = 1.0
    num = num.slice(0, num.byteLength - 2)
  } else if (num.endsWith("s")) {
    num = num.slice(0, num.byteLength - 1)
  } else if (num.endsWith("m")) {
    unit = 60000.0
    num = num.slice(0, num.byteLength - 1)
  } else if (num.endsWith("h")) {
    unit = 3600000.0
    num = num.slice(0, num.byteLength - 1)
  }
  const n = parseFloat(num)
  if (n === undefined) return undefined
  return Math.round(n * unit)
}

export function cacheKey(scope: string, model: string, body: string): string {
  return scope + "\u0000" + model + "\u0000" + body
}

test("stores, expires and evicts", () => {
  const c = new ResponseCache(1000, 10)
  c.set("a", "A", "application/json", 1000)
  expect(c.get("a")!.body).toBe("A")
  c.set("old", "x", "application/json", -1)
  expect(c.get("old")).toBeUndefined()
  for (let i = 0; i < 25; i++) c.set("k" + i, "v", "application/json", 1000)
  expect(c.entries.size <= 10).toBe(true)
  expect(parseTtl("5m")).toBe(300000)
  expect(parseTtl("30")).toBe(30000)
})
