// Short-lived, single-use tickets for /ws: a browser cannot set an Authorization
// header on a WebSocket, so the dashboard exchanges credentials for a ticket via
// POST /api/session/ws-ticket, then opens /ws?ticket=... The ticket identifies
// the actor that obtained it.
import { secureHex, sha256, utf8, toHex } from "./crypto"
import { readFileSync, readdirSync, unlinkSync, rmSync, statSync } from "node:fs"
import { mkdirPrivate, writeFileAtomic, syncDir, PRIVATE_FILE } from "./atomicfile"

// Ticket lifetime.
export const WS_TICKET_TTL_MS = 30000.0

// role: the role the gate gave the caller when the ticket was issued ("" when it gave none), so the socket gets the
// same data scope as the request that asked for it.
type Ticket = { actor: string, expires: f64, role?: string }

export type TicketHolder = { actor: string, role: string }

export class WsTickets {
  private tickets: Map<string, Ticket> = new Map()
  private dir = ""
  private ready = false
  private sweptAt: f64 = -1.0e15

  // Regional replicas that share configuration must redeem tickets through the same
  // directory. Never put these in the per-pod share folder or replicate them across regions.
  useDir(dir: string): void {
    this.dir = dir
    this.ready = false
  }

  private path(ticket: string): string {
    return this.dir + "/" + toHex(sha256(utf8(ticket))) + ".json"
  }

  // A new ticket for an actor (the name the gate returned for the caller).
  issue(actor: string, nowMs: f64, role?: string): string throws Error {
    const t = "wst_" + (try secureHex(24))
    const row: Ticket = { actor: actor, expires: nowMs + WS_TICKET_TTL_MS, role: role ?? "" }
    if (this.dir !== "") {
      if (!this.ready) {
        try mkdirPrivate(this.dir)
        this.ready = true
      }
      this.sweepFiles(nowMs)
      try writeFileAtomic(this.path(t), JSON.stringify(row), { mode: PRIVATE_FILE, exact: true })
    } else {
      this.sweep(nowMs)
      this.tickets.set(t, row)
    }
    return t
  }

  // The actor the ticket was issued to. A ticket works once: it is gone after this call, whatever
  // the answer. undefined for an unknown, used or expired ticket.
  consume(ticket: string, nowMs: f64): string | undefined {
    return this.redeem(ticket, nowMs)?.actor
  }

  // As consume, with the role the ticket was issued under.
  redeem(ticket: string, nowMs: f64): TicketHolder | undefined {
    if (this.dir !== "") {
      // Read then unlink, returning the actor ONLY after a successful unlink. The
      // atomic directory operation has one winner even if several workers read the
      // same row. Permission/storage failures deny rather than falling back to memory.
      const path = this.path(ticket)
      try {
        const row = try JSON.parse(try readFileSync(path, "utf8")) as Ticket
        try unlinkSync(path)
        syncDir(this.dir)
        return row.expires <= nowMs ? undefined : { actor: row.actor, role: row.role ?? "" }
      } catch (e) {
        return undefined
      }
    }
    const t = this.tickets.get(ticket)
    this.tickets.delete(ticket)
    if (t === undefined || t.expires <= nowMs) return undefined
    return { actor: t.actor, role: t.role ?? "" }
  }


  private sweepFiles(nowMs: f64): void {
    if (nowMs - this.sweptAt < 1000.0) return
    this.sweptAt = nowMs
    try {
      for (const name of try readdirSync(this.dir)) {
        if (name.byteLength !== 69 || !name.endsWith(".json")) continue
        const path = this.dir + "/" + name
        try {
          const row = try JSON.parse(try readFileSync(path, "utf8")) as Ticket
          if (row.expires <= nowMs) try unlinkSync(path)
        } catch (e) {}
      }
    } catch (e) {}
  }
  // Drops the expired tickets.
  private sweep(nowMs: f64): void {
    const dead: string[] = []
    for (const k of this.tickets.keys()) {
      const t = this.tickets.get(k)
      if (t !== undefined && t.expires <= nowMs) dead.push(k)
    }
    for (const k of dead) this.tickets.delete(k)
  }
}

test("a ticket names its actor once, within its lifetime", () => {
  const w = new WsTickets()
  const t = try w.issue("alice", 1000.0)
  expect(t.startsWith("wst_")).toBe(true)
  expect(w.consume(t, 1000.0 + 5000.0)).toBe("alice")
  const withRole = try w.issue("sso:dana", 1000.0, "analyst")
  const holder = w.redeem(withRole, 2000.0)
  expect(holder?.actor).toBe("sso:dana")
  expect(holder?.role).toBe("analyst")
  expect(w.redeem(withRole, 2000.0)).toBeUndefined()
  // single use
  expect(w.consume(t, 1000.0 + 6000.0)).toBeUndefined()
})

test("an expired or unknown ticket is refused", () => {
  const w = new WsTickets()
  const t = try w.issue("bob", 0.0)
  expect(w.consume(t, WS_TICKET_TTL_MS)).toBeUndefined()
  expect(w.consume("wst_nope", 0.0)).toBeUndefined()
  const u = try w.issue("carol", 0.0)
  expect(u === t).toBe(false)
})

test("shared regional ticket stores redeem once across independent workers and replicas", () => {
  const dir = "/tmp/raiju-ws-tickets-" + process.pid + "-" + (try secureHex(8))
  const a = new WsTickets()
  const b = new WsTickets()
  a.useDir(dir)
  b.useDir(dir)
  try {
    const ticket = try a.issue("alice", 1000.0)
    const names = try readdirSync(dir)
    const file = dir + "/" + names[0]!
    expect((try statSync(file)).mode & 511).toBe(PRIVATE_FILE)
    expect((try readFileSync(file, "utf8")).includes(ticket)).toBe(false)
    expect(b.consume(ticket, 2000.0)).toBe("alice")
    expect(a.consume(ticket, 2000.0)).toBeUndefined()
    const next = try b.issue("bob", 3000.0)
    expect(a.consume(next, 3000.0 + WS_TICKET_TTL_MS)).toBeUndefined()
    expect(b.consume(next, 3001.0)).toBeUndefined()
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("shared ticket storage errors never fall back to a process-local grant", () => {
  const file = "/tmp/raiju-ws-tickets-blocked-" + process.pid + "-" + (try secureHex(8))
  try writeFileAtomic(file, "not a directory")
  const w = new WsTickets()
  w.useDir(file)
  let failed = false
  try {
    w.issue("alice", 1000.0)
  } catch (e) {
    failed = true
  }
  expect(failed).toBe(true)
  expect(w.consume("unknown", 1000.0)).toBeUndefined()
  try rmSync(file, { force: true })
})
