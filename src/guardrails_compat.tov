// Reads Bifrost's guardrails_config and translates what Raiju can enforce into
// Raiju's own GuardrailsConfig. Bifrost describes checks as rules that link to
// provider profiles by id; Raiju runs one set of built-in detectors plus a list
// of external providers, each with one scope. Anything without a Raiju
// equivalent comes back as a warning, so no part of a Bifrost config is dropped
// silently.

import { GuardrailsConfig, GuardrailProviderConfig, PatronusEvaluatorConfig, RegexRuleConfig, getEnv } from "./config"
import { Field, fields, elements, find, rawStr, rawNum, rawBool, isNull, decodeString } from "./json"

type Scope = "input" | "output" | "both"

// A Bifrost rule after the rule-level checks; providerIds are the raw id texts.
// target is "llm" or "mcp" (tool calls).
type BRule = { label: string, scope: Scope, target: string, providerIds: string[], replayMs: int }

// A Bifrost provider profile: top-level fields and the config object's fields.
type BProvider = { id: string, label: string, kind: string, enabled: bool, top: Field[], cfg: Field[] }

// Collects the output: Raiju providers, built-in detectors, detector modes and warnings.
class Build {
  notes: string[] = []
  providers: GuardrailProviderConfig[] = []
  detect: string[] = []
  modes: string[] = []
  reversible: bool = false
  // the largest replay interval of the output rules (Bifrost uses the largest of the matched ones)
  replayMs: int = 0

  warn(msg: string): void {
    this.notes.push(msg)
  }

  addDetect(name: string): void {
    if (!this.detect.includes(name)) this.detect.push(name)
  }
}

// Keys that are present with a value. Used for settings Raiju cannot honour.
function setKeys(fs: Field[], keys: string[]): string[] {
  const out: string[] = []
  for (const k of keys) {
    if (!isNull(find(fs, k))) out.push(k)
  }
  return out
}

// Like setKeys, but false counts as off, for switches that default to off.
function onKeys(fs: Field[], keys: string[]): string[] {
  const out: string[] = []
  for (const k of keys) {
    const v = find(fs, k)
    if (!isNull(v) && v !== "false") out.push(k)
  }
  return out
}

function ignoreNote(b: Build, label: string, keys: string[]): void {
  if (keys.length > 0) b.warn(`${label}: ${keys.join(", ")} not supported by Raiju and ignored`)
}

// A string setting, or a number written as one (guardrail_version may be either).
function strField(fs: Field[], key: string): string | undefined {
  const s = rawStr(fs, key)
  if (s !== undefined) return s
  const n = rawNum(fs, key)
  if (n === undefined) return undefined
  return `${n}`
}

// Resolves an "env.NAME" reference now. An unset variable is reported and yields
// undefined, so the provider is left out rather than failing on every request.
function envValue(b: Build, label: string, key: string, v: string | undefined): string | undefined {
  if (v === undefined) return undefined
  if (!v.startsWith("env.")) return v
  const got = getEnv(v.slice(4))
  if (got === undefined || got === "") {
    b.warn(`${label}: ${key} refers to ${v}, which is not set`)
    return undefined
  }
  return got
}

function envStr(b: Build, label: string, cfg: Field[], key: string): string | undefined {
  return envValue(b, label, key, strField(cfg, key))
}

// A required setting. Without it the provider cannot run, so it is left out.
function need(b: Build, label: string, key: string, v: string | undefined): string | undefined {
  if (v === undefined || v === "") {
    b.warn(`${label} has no ${key}, so it is not loaded`)
    return undefined
  }
  return v
}

// Bifrost actions: detect_only only logs, block stops the request, redact rewrites it.
function actionMode(b: Build, label: string, action: string): string {
  if (action === "detect_only") return "log"
  if (action === "block") return "block"
  if (action === "redact") return "redact"
  b.warn(`${label}: unknown action "${action}", treated as block`)
  return "block"
}

// Raiju redacts live content and writes [REDACTED:KIND]; other Bifrost choices differ.
function redactNotes(b: Build, label: string, cfg: Field[], action: string): void {
  if (action !== "redact") return
  const rm = rawStr(cfg, "redaction_mode") ?? "runtime"
  if (rm !== "runtime") b.warn(`${label}: redaction_mode "${rm}" is not supported; Raiju redacts the live request and response`)
  const rs = rawStr(cfg, "redaction_strategy") ?? "replace"
  if (rs !== "replace") b.warn(`${label}: redaction_strategy "${rs}" is not supported; Raiju replaces matches with [REDACTED:KIND]`)
}

// The strictest mode wins, since Raiju has one mode for all detectors.
function strictest(modes: string[]): string | undefined {
  let best: string | undefined = undefined
  let rank = 0
  for (const m of modes) {
    const r = m === "block" ? 3 : m === "redact" ? 2 : 1
    if (r > rank) {
      rank = r
      best = m
    }
  }
  return best
}

// Bifrost regex patterns that describe a built-in PII type, by their description
// or entity type. Any other pattern is a custom regex, which Raiju cannot run.
function builtinFor(text: string): string | undefined {
  if (text.includes("email")) return "email"
  if (text.includes("ssn") || text.includes("social security")) return "ssn"
  if (text.includes("credit")) return "credit_card"
  if (text.includes("phone")) return "phone"
  if (text.includes("ipv4") || text.includes("ip address")) return "ipv4"
  return undefined
}

// ---- Bifrost rules and providers ----

function parseRules(raw: string | undefined, b: Build): BRule[] throws SyntaxError {
  const out: BRule[] = []
  if (raw === undefined || !raw.startsWith("[")) return out
  for (const el of try elements(raw)) {
    const f = try fields(el)
    const name = rawStr(f, "name")
    const label = name !== undefined ? `rule "${name}"` : `rule ${find(f, "id") ?? "?"}`
    // a missing enabled reads as on; the Bifrost schema requires it anyway
    if (rawBool(f, "enabled") === false) {
      b.warn(`${label} is disabled, so it is not loaded`)
      continue
    }
    const target = rawStr(f, "target") ?? "llm"
    if (target !== "llm" && target !== "mcp") {
      b.warn(`${label} targets ${target}, which Raiju does not know, so it is not loaded`)
      continue
    }
    const cel = (rawStr(f, "cel_expression") ?? "true").trim()
    if (cel !== "true" && cel !== "") {
      b.warn(`${label}: the condition ${cel} is not evaluated by Raiju, so its checks apply to all traffic`)
    }
    const ign = setKeys(f, ["timeout", "evaluation_mode", "send_all_conversation_turns", "max_turns_to_send"])
    const sr = rawNum(f, "sampling_rate")
    if (sr !== undefined && sr !== 100) ign.push("sampling_rate")
    ignoreNote(b, label, ign)
    // the replay interval of a block-capable output rule (Bifrost caps it at 1000 ms)
    const sri = rawNum(f, "stream_replay_event_interval_ms") ?? 0
    const replay = Math.min(Math.max(Math.floor(sri), 0), 1000)
    const at = rawStr(f, "apply_to") ?? "both"
    let scope: Scope = "both"
    if (at === "input") scope = "input"
    else if (at === "output") scope = "output"
    else if (at !== "both") b.warn(`${label}: unknown apply_to "${at}", treated as both`)
    const providerIds: string[] = []
    const pci = find(f, "provider_config_ids")
    if (pci !== undefined && pci.startsWith("[")) {
      for (const e of try elements(pci)) providerIds.push(e.trim())
    }
    if (providerIds.length === 0) b.warn(`${label} links no providers, so it enforces nothing`)
    out.push({ label: label, scope: scope, target: target, providerIds: providerIds, replayMs: replay })
  }
  return out
}

function parseProviders(raw: string | undefined): BProvider[] throws SyntaxError {
  const out: BProvider[] = []
  if (raw === undefined || !raw.startsWith("[")) return out
  for (const el of try elements(raw)) {
    const f = try fields(el)
    const id = find(f, "id") ?? ""
    const kind = rawStr(f, "provider_name") ?? ""
    const policy = rawStr(f, "policy_name") ?? id
    const cfgRaw = find(f, "config") ?? "{}"
    let cfg: Field[] = []
    if (cfgRaw.startsWith("{")) cfg = try fields(cfgRaw)
    out.push({ id: id, label: `${kind} provider "${policy}"`, kind: kind, enabled: rawBool(f, "enabled") !== false, top: f, cfg: cfg })
  }
  return out
}

// ---- external providers ----

function bedrock(b: Build, label: string, pid: string, scope: Scope, cfg: Field[]): GuardrailProviderConfig | undefined {
  const auth = rawStr(cfg, "auth_type") ?? "inferred"
  if (auth !== "keys" && auth !== "inferred") {
    b.warn(`${label}: auth_type "${auth}" is not supported (Raiju signs with static keys), so it is not loaded`)
    return undefined
  }
  if (setKeys(cfg, ["role_arn"]).length > 0) {
    b.warn(`${label}: role_arn is not supported (Raiju signs with the static keys), so it is not loaded`)
    return undefined
  }
  const arn = need(b, label, "guardrail_arn", rawStr(cfg, "guardrail_arn"))
  if (arn === undefined) return undefined
  // a full ARN carries the region and the id after "guardrail/"
  const at = arn.indexOf("guardrail/")
  const gid = at >= 0 ? arn.slice(at + "guardrail/".byteLength) : arn
  const parts = arn.split(":")
  const arnRegion = parts.length >= 6 ? parts[3] : undefined
  const region = envValue(b, label, "region", strField(cfg, "region")) ?? arnRegion
  const ver = need(b, label, "guardrail_version", strField(cfg, "guardrail_version"))
  if (ver === undefined) return undefined
  const ak = need(b, label, "access_key", envStr(b, label, cfg, "access_key"))
  if (ak === undefined) return undefined
  const sk = need(b, label, "secret_key", envStr(b, label, cfg, "secret_key"))
  if (sk === undefined) return undefined
  const ign = setKeys(cfg, ["bedrock_api_key", "external_id", "session_name"])
  for (const k of onKeys(cfg, ["images_enabled"])) ign.push(k)
  ignoreNote(b, label, ign)
  if (onKeys(cfg, ["images_enabled"]).length > 0) b.warn(`${label}: image content is not checked by Raiju, only text`)
  return {
    id: pid,
    kind: "bedrock",
    apply_to: scope,
    guardrail_id: gid,
    guardrail_version: ver,
    region: region,
    access_key: ak,
    secret_key: sk,
    session_token: envStr(b, label, cfg, "session_token"),
  }
}

// Bifrost's "azure" kind is Azure AI Content Safety (azure-pii is a different service).
function azure(b: Build, label: string, pid: string, scope: Scope, cfg: Field[]): GuardrailProviderConfig | undefined {
  const auth = rawStr(cfg, "auth_type") ?? "api_key"
  if (auth !== "api_key") {
    b.warn(`${label}: auth_type "${auth}" is not supported (Raiju uses an API key), so it is not loaded`)
    return undefined
  }
  if (rawBool(cfg, "analyze_enabled") === false) {
    b.warn(`${label}: analyze_enabled is false, so there is no content analysis to run; not loaded`)
    return undefined
  }
  const endpoint = need(b, label, "endpoint", envStr(b, label, cfg, "endpoint"))
  if (endpoint === undefined) return undefined
  const key = need(b, label, "api_key", envStr(b, label, cfg, "api_key"))
  if (key === undefined) return undefined
  // same severity cut-offs as Bifrost's table: low 2, medium 4, high 6
  const sev = rawStr(cfg, "analyze_severity_threshold") ?? "medium"
  let thr: number = 4
  if (sev === "low") thr = 2
  else if (sev === "high") thr = 6
  else if (sev !== "medium") b.warn(`${label}: unknown analyze_severity_threshold "${sev}", using medium`)
  const ign = onKeys(cfg, ["jailbreak_shield_enabled", "indirect_attack_shield_enabled", "copyright_enabled", "text_blocklist_enabled"])
  for (const k of setKeys(cfg, ["blocklist_names"])) ign.push(k)
  ignoreNote(b, label, ign)
  return { id: pid, kind: "azure_content_safety", apply_to: scope, endpoint: endpoint, api_key: key, threshold: thr }
}

function patronus(b: Build, label: string, pid: string, scope: Scope, cfg: Field[]): GuardrailProviderConfig | undefined {
  const key = need(b, label, "api_key", envStr(b, label, cfg, "api_key"))
  if (key === undefined) return undefined
  const evs: PatronusEvaluatorConfig[] = []
  let explain = false
  const raw = find(cfg, "evaluators")
  if (raw !== undefined && raw.startsWith("[")) {
    for (const el of try elements(raw)) {
      const ef = try fields(el)
      const name = rawStr(ef, "evaluator")
      if (name === undefined) {
        b.warn(`${label}: an evaluator has no name, so it is skipped`)
        continue
      }
      evs.push({ evaluator: name, criteria: rawStr(ef, "criteria") })
      if (!isNull(find(ef, "explain_strategy"))) explain = true
    }
  }
  if (evs.length === 0) {
    b.warn(`${label} has no evaluators, so it is not loaded`)
    return undefined
  }
  if (explain) b.warn(`${label}: explain_strategy is not supported and ignored`)
  const cap = rawStr(cfg, "capture")
  if (cap !== undefined && cap !== "none") b.warn(`${label}: capture "${cap}" is not supported; Raiju does not store evaluation results`)
  ignoreNote(b, label, setKeys(cfg, ["timeout"]))
  return { id: pid, kind: "patronus", apply_to: scope, api_key: key, base_url: envStr(b, label, cfg, "base_url"), evaluators: evs }
}

// Bifrost defines no webhook kind. A "webhook" provider is mapped on the
// assumption that its endpoint speaks Raiju's webhook protocol.
function webhook(b: Build, label: string, pid: string, scope: Scope, cfg: Field[]): GuardrailProviderConfig | undefined {
  const url = need(b, label, "url", envStr(b, label, cfg, "url"))
  if (url === undefined) return undefined
  const headers: Map<string, string> = new Map()
  const hraw = find(cfg, "headers")
  if (hraw !== undefined && hraw.startsWith("{")) {
    for (const h of try fields(hraw)) {
      if (!h.raw.startsWith("\"")) {
        b.warn(`${label}: header ${h.key} is not a string, so it is skipped`)
        continue
      }
      const hv = try decodeString(h.raw)
      headers.set(h.key, hv)
    }
  }
  b.warn(`${label}: the endpoint must answer in Raiju's webhook format ({"allowed", "reason", "text"})`)
  return { id: pid, kind: "webhook", apply_to: scope, url: url, headers: headers }
}

// ---- built-in detectors ----

// Raiju's secret detectors cover API keys with known prefixes, AWS access keys,
// JWTs and private keys. Gitleaks, which Bifrost uses, covers far more formats.
// Bifrost's action names as Raiju's per-rule actions. detect_only stays detect_only.
function ruleAction(b: Build, label: string, action: string): string {
  if (action === "detect_only" || action === "block" || action === "redact") return action
  b.warn(`${label}: unknown action "${action}", treated as block`)
  return "block"
}

// Flags a Bifrost redaction_mode: runtime_reversible turns on placeholders for the
// request and their restoration in the response. logs_only is not supported.
function reversibleMode(b: Build, label: string, cfg: Field[]): string {
  const rm = rawStr(cfg, "redaction_mode") ?? "runtime"
  if (rm === "runtime_reversible") {
    b.reversible = true
    return rm
  }
  if (rm === "logs_only") b.warn(`${label}: redaction_mode logs_only is not supported; Raiju redacts the live request and response`)
  return rm
}

// The Gitleaks rule set (a curated subset in Raiju), run as a secrets provider on the
// targets it is linked to. The built-in key and JWT detectors still run on LLM traffic.
function secrets(b: Build, label: string, pid: string, scope: Scope, targets: string[], top: Field[], cfg: Field[]): GuardrailProviderConfig throws SyntaxError {
  const action = ruleAction(b, label, rawStr(cfg, "action") ?? "block")
  reversibleMode(b, label, cfg)
  const kw: string[] = []
  const raw = find(cfg, "ignored_secret_keywords")
  if (raw !== undefined && raw.startsWith("[")) {
    for (const el of try elements(raw)) kw.push(try decodeString(el))
  }
  if (targets.includes("llm")) {
    for (const d of ["private_key", "jwt", "api_key", "aws_key"]) b.addDetect(d)
    b.modes.push(actionMode(b, label, action))
    redactNotes(b, label, cfg, action)
  }
  ignoreNote(b, label, setKeys(top, ["timeout"]))
  return { id: pid, kind: "secrets", apply_to: scope, targets: targets, action: action, redaction_mode: rawStr(cfg, "redaction_mode") ?? "runtime", ignored_secret_keywords: kw }
}

// Bifrost's custom regex provider. A pattern that is one of Raiju's built-in PII
// detectors (by its description or entity type) uses that detector; any other pattern
// runs as a regex rule.
function regex(b: Build, label: string, pid: string, scope: Scope, targets: string[], top: Field[], cfg: Field[]): GuardrailProviderConfig | undefined {
  const raw = find(cfg, "patterns")
  if (raw === undefined || !raw.startsWith("[")) {
    b.warn(`${label} has no patterns, so nothing is enforced`)
    return undefined
  }
  const custom: RegexRuleConfig[] = []
  for (const el of try elements(raw)) {
    const pf = try fields(el)
    const pattern = rawStr(pf, "pattern") ?? ""
    const desc = rawStr(pf, "description") ?? pattern
    const hint = (rawStr(pf, "description") ?? "") + " " + (rawStr(pf, "entity_type") ?? "")
    const action = ruleAction(b, `${label} pattern "${desc}"`, rawStr(pf, "action") ?? "block")
    reversibleMode(b, label, pf)
    const name = builtinFor(hint.toLowerCase())
    if (name !== undefined && pattern.includes("\\b")) {
      if (targets.includes("llm")) {
        b.addDetect(name)
        b.modes.push(actionMode(b, `${label} pattern "${desc}"`, action))
        redactNotes(b, label, pf, action)
        ignoreNote(b, `${label} pattern "${desc}"`, setKeys(pf, ["allowed_values"]))
      }
      continue
    }
    const av: string[] = []
    const avRaw = find(pf, "allowed_values")
    if (avRaw !== undefined && avRaw.startsWith("[")) {
      for (const el2 of try elements(avRaw)) av.push(try decodeString(el2))
    }
    const flags = rawStr(pf, "flags") ?? ""
    custom.push({ pattern: pattern, description: desc, entity_type: rawStr(pf, "entity_type"), flags: flags, action: action, allowed_values: av })
  }
  ignoreNote(b, label, setKeys(top, ["timeout"]))
  if (custom.length === 0) return undefined
  return { id: pid, kind: "regex", apply_to: scope, targets: targets, patterns: custom }
}

// Presidio's analyzer. action defaults to detect_only, as in Bifrost.
function presidio(b: Build, label: string, pid: string, scope: Scope, targets: string[], cfg: Field[]): GuardrailProviderConfig | undefined throws SyntaxError {
  const url = need(b, label, "analyzer_url", envStr(b, label, cfg, "analyzer_url"))
  if (url === undefined) return undefined
  const action = ruleAction(b, label, rawStr(cfg, "action") ?? "detect_only")
  reversibleMode(b, label, cfg)
  const ents: string[] = []
  const raw = find(cfg, "entities")
  if (raw !== undefined && raw.startsWith("[")) {
    for (const el of try elements(raw)) ents.push(try decodeString(el))
  }
  const thr = rawNum(cfg, "score_threshold")
  ignoreNote(b, label, setKeys(cfg, ["timeout"]))
  return {
    id: pid,
    kind: "presidio",
    apply_to: scope,
    targets: targets,
    analyzer_url: url,
    api_key: envStr(b, label, cfg, "api_key"),
    language: rawStr(cfg, "language") ?? "en",
    score_threshold: thr ?? 0.5,
    entities: ents,
    action: action,
    redaction_mode: rawStr(cfg, "redaction_mode") ?? "runtime",
  }
}

// Azure AI Language PII. Only API-key auth is supported.
function azurePii(b: Build, label: string, pid: string, scope: Scope, targets: string[], cfg: Field[]): GuardrailProviderConfig | undefined throws SyntaxError {
  const auth = rawStr(cfg, "auth_type") ?? "api_key"
  if (auth !== "api_key") {
    b.warn(`${label}: auth_type "${auth}" is not supported (Raiju uses an API key), so it is not loaded`)
    return undefined
  }
  const endpoint = need(b, label, "endpoint", envStr(b, label, cfg, "endpoint"))
  if (endpoint === undefined) return undefined
  const key = need(b, label, "api_key", envStr(b, label, cfg, "api_key"))
  if (key === undefined) return undefined
  const action = ruleAction(b, label, rawStr(cfg, "action") ?? "detect_only")
  reversibleMode(b, label, cfg)
  const cats: string[] = []
  const raw = find(cfg, "pii_categories")
  if (raw !== undefined && raw.startsWith("[")) {
    for (const el of try elements(raw)) cats.push(try decodeString(el))
  }
  ignoreNote(b, label, setKeys(cfg, ["client_id", "client_secret", "tenant_id", "scopes", "logging_opt_out", "string_index_type"]))
  return {
    id: pid,
    kind: "azure_language_pii",
    apply_to: scope,
    targets: targets,
    endpoint: endpoint,
    api_key: key,
    api_version: rawStr(cfg, "api_version"),
    model_version: rawStr(cfg, "model_version") ?? "latest",
    domain: rawStr(cfg, "domain") ?? "none",
    language: rawStr(cfg, "language") ?? "en",
    pii_categories: cats,
    action: action,
    redaction_mode: rawStr(cfg, "redaction_mode") ?? "runtime",
  }
}

// Google Model Armor. Bifrost authenticates with ADC or a service account key; Raiju
// takes a bearer token (access_token), so a profile without one is not loaded.
function modelArmor(b: Build, label: string, pid: string, scope: Scope, targets: string[], cfg: Field[]): GuardrailProviderConfig | undefined {
  const auth = rawStr(cfg, "auth_type") ?? "default_credential"
  const project = need(b, label, "project_id", envStr(b, label, cfg, "project_id"))
  const loc = need(b, label, "location", envStr(b, label, cfg, "location"))
  const tmpl = need(b, label, "template_id", envStr(b, label, cfg, "template_id"))
  if (project === undefined || loc === undefined || tmpl === undefined) return undefined
  const tok = envStr(b, label, cfg, "access_token")
  if (tok === undefined) {
    b.warn(`${label}: auth_type "${auth}" needs ADC or a service account, which Raiju does not use; set access_token to a bearer token, or the profile is not loaded`)
    return undefined
  }
  if (onKeys(cfg, ["images_enabled"]).length > 0) b.warn(`${label}: image screening is not supported by Raiju; text only`)
  ignoreNote(b, label, setKeys(cfg, ["service_account_json"]))
  return { id: pid, kind: "google_model_armor", apply_to: scope, targets: targets, project_id: project, location: loc, template_id: tmpl, access_token: tok }
}

// CrowdStrike AIDR: the collector token is required; the policy decides the action.
function crowdstrike(b: Build, label: string, pid: string, scope: Scope, targets: string[], cfg: Field[]): GuardrailProviderConfig | undefined {
  const key = need(b, label, "api_key", envStr(b, label, cfg, "api_key"))
  if (key === undefined) return undefined
  ignoreNote(b, label, setKeys(cfg, ["timeout"]))
  return {
    id: pid,
    kind: "crowdstrike_aidr",
    apply_to: scope,
    targets: targets,
    api_key: key,
    base_url: envStr(b, label, cfg, "base_url"),
    app_id: strField(cfg, "app_id"),
    collector_instance_id: strField(cfg, "collector_instance_id"),
  }
}

// Prompt guardrails: an LLM judge with a natural-language rule. judge_provider and
// judge_model name the model the gateway calls.
function promptJudge(b: Build, label: string, pid: string, scope: Scope, targets: string[], cfg: Field[]): GuardrailProviderConfig | undefined {
  const rule = need(b, label, "rule", rawStr(cfg, "rule"))
  if (rule === undefined) return undefined
  const prov = need(b, label, "judge_provider", rawStr(cfg, "judge_provider"))
  if (prov === undefined) return undefined
  const model = need(b, label, "judge_model", rawStr(cfg, "judge_model"))
  if (model === undefined) return undefined
  if (targets.includes("mcp")) b.warn(`${label}: the judge runs on LLM traffic only, not on tool calls`)
  ignoreNote(b, label, setKeys(cfg, ["timeout"]))
  return {
    id: pid,
    kind: "prompt_judge",
    apply_to: scope,
    targets: ["llm"],
    rule: rule,
    judge_provider: prov,
    judge_model: model,
    system_prompt: rawStr(cfg, "system_prompt"),
    max_output_tokens: Math.floor(rawNum(cfg, "max_output_tokens") ?? 1000.0),
  }
}

// ---- entry points ----

// Translates the guardrails_config object of a Bifrost config (its raw JSON text).
// Rules with a CEL condition keep their checks but lose the condition, and each
// detector runs on the union of the scopes that use it.
export function fromBifrost(guardrailsConfigJson: string): { config: GuardrailsConfig, warnings: string[] } throws SyntaxError {
  const text = guardrailsConfigJson.trim()
  if (text === "" || text === "null") return { config: { enabled: false }, warnings: [] }
  const top = try fields(text)
  const b = new Build()
  const rules = try parseRules(find(top, "guardrail_rules"), b)
  const provs = try parseProviders(find(top, "guardrail_providers"))

  const known: Set<string> = new Set()
  for (const p of provs) known.add(p.id)
  const inputOf: Set<string> = new Set()
  const outputOf: Set<string> = new Set()
  const mcpOf: Set<string> = new Set()
  for (const r of rules) {
    for (const pid of r.providerIds) {
      if (!known.has(pid)) b.warn(`${r.label} links provider ${pid}, which is not defined`)
      if (r.target === "mcp") {
        // tool arguments are input
        mcpOf.add(pid)
        continue
      }
      if (r.scope !== "output") inputOf.add(pid)
      if (r.scope !== "input") outputOf.add(pid)
      if (r.scope !== "input" && r.replayMs > b.replayMs) b.replayMs = r.replayMs
    }
  }

  let detIn = false
  let detOut = false
  const detScopes: Scope[] = []
  for (const p of provs) {
    if (!p.enabled) {
      b.warn(`${p.label} is disabled, so it is not loaded`)
      continue
    }
    const inp = inputOf.has(p.id)
    const outp = outputOf.has(p.id)
    const mcp = mcpOf.has(p.id)
    if (!inp && !outp && !mcp) {
      b.warn(`${p.label} is not linked to any enabled rule, so it is not loaded`)
      continue
    }
    const scope: Scope = inp && outp ? "both" : inp || (mcp && !outp) ? "input" : "output"
    const targets: string[] = []
    if (inp || outp) targets.push("llm")
    if (mcp) targets.push("mcp")
    const pid = "bifrost-" + p.id
    const local = p.kind === "secrets" || p.kind === "regex"
    if (!local && !(inp || outp)) {
      b.warn(`${p.label} is linked only to MCP rules, and Raiju runs it on LLM traffic only; not enforced on tool calls`)
      continue
    }
    if (!local && mcp) b.warn(`${p.label} is also linked to MCP rules, but Raiju runs it on LLM traffic only; the tool-call link is not enforced`)
    if (p.kind === "bedrock") {
      const g = bedrock(b, p.label, pid, scope, p.cfg)
      if (g !== undefined) b.providers.push(g)
    } else if (p.kind === "azure") {
      const g = azure(b, p.label, pid, scope, p.cfg)
      if (g !== undefined) b.providers.push(g)
    } else if (p.kind === "patronus-ai") {
      const g = try patronus(b, p.label, pid, scope, p.cfg)
      if (g !== undefined) b.providers.push(g)
    } else if (p.kind === "webhook") {
      const g = try webhook(b, p.label, pid, scope, p.cfg)
      if (g !== undefined) b.providers.push(g)
    } else if (p.kind === "secrets") {
      b.providers.push(try secrets(b, p.label, pid, scope, targets, p.top, p.cfg))
      if (targets.includes("llm")) {
        detScopes.push(scope)
        if (scope !== "output") detIn = true
        if (scope !== "input") detOut = true
      }
    } else if (p.kind === "regex") {
      const g = try regex(b, p.label, pid, scope, targets, p.top, p.cfg)
      if (g !== undefined) b.providers.push(g)
      if (targets.includes("llm")) {
        detScopes.push(scope)
        if (scope !== "output") detIn = true
        if (scope !== "input") detOut = true
      }
    } else if (p.kind === "presidio") {
      const g = try presidio(b, p.label, pid, scope, targets, p.cfg)
      if (g !== undefined) b.providers.push(g)
    } else if (p.kind === "azure-pii") {
      const g = try azurePii(b, p.label, pid, scope, targets, p.cfg)
      if (g !== undefined) b.providers.push(g)
    } else if (p.kind === "model-armor") {
      const g = modelArmor(b, p.label, pid, scope, targets, p.cfg)
      if (g !== undefined) b.providers.push(g)
    } else if (p.kind === "crowdstrike-aidr") {
      const g = crowdstrike(b, p.label, pid, scope, targets, p.cfg)
      if (g !== undefined) b.providers.push(g)
    } else if (p.kind === "prompt-guardrail") {
      const g = promptJudge(b, p.label, pid, scope, targets, p.cfg)
      if (g !== undefined) b.providers.push(g)
    } else {
      b.warn(`${p.label}: provider "${p.kind}" has no Raiju equivalent, so it is not enforced`)
    }
  }

  const detApply: Scope | undefined = detIn && detOut ? "both" : detIn ? "input" : detOut ? "output" : undefined
  if (detApply !== undefined) {
    for (const s of detScopes) {
      if (s !== detApply) {
        b.warn(`built-in detectors apply to ${detApply} traffic as a whole; some were scoped more narrowly in Bifrost`)
        break
      }
    }
  }
  const mode = strictest(b.modes)
  if (mode !== undefined && b.modes.some((m) => m !== mode)) {
    b.warn(`built-in detectors use the strictest Bifrost action (${mode}) for every detector`)
  }
  const config: GuardrailsConfig = {
    enabled: b.detect.length > 0 || b.providers.length > 0,
    providers: b.providers,
    detect: b.detect,
    mode: mode,
    apply_to: detApply,
    reversible: b.reversible,
  }
  if (b.replayMs > 0) config.stream_replay_event_interval_ms = b.replayMs
  return { config: config, warnings: b.notes }
}

// Combines the config file's own guardrails with the translated Bifrost ones.
// Providers are concatenated (a clashing id from Bifrost is prefixed), detector
// and custom lists are unioned, and scalar settings take the own value.
export function merge(own: GuardrailsConfig | undefined, fromBifrost: GuardrailsConfig | undefined): GuardrailsConfig | undefined {
  if (own === undefined) return fromBifrost
  if (fromBifrost === undefined) return own
  const providers: GuardrailProviderConfig[] = []
  const ids: Set<string> = new Set()
  for (const p of own.providers ?? []) {
    ids.add(p.id)
    providers.push(p)
  }
  for (const p of fromBifrost.providers ?? []) {
    let q = p
    if (ids.has(q.id)) q.id = `bifrost-${q.id}`
    ids.add(q.id)
    providers.push(q)
  }
  const detect: string[] = []
  for (const d of (own.detect ?? []).concat(fromBifrost.detect ?? [])) {
    if (!detect.includes(d)) detect.push(d)
  }
  const custom: string[] = []
  for (const c of (own.custom ?? []).concat(fromBifrost.custom ?? [])) {
    if (!custom.includes(c)) custom.push(c)
  }
  return {
    enabled: own.enabled ?? fromBifrost.enabled,
    providers: providers,
    detect: detect,
    mode: own.mode ?? fromBifrost.mode,
    custom: custom,
    apply_to: own.apply_to ?? fromBifrost.apply_to,
    reversible: own.reversible === true || fromBifrost.reversible === true,
    stream_replay_event_interval_ms: own.stream_replay_event_interval_ms ?? fromBifrost.stream_replay_event_interval_ms,
  }
}

// ---- tests ----

function warned(ws: string[], part: string): bool {
  return ws.some((w) => w.includes(part))
}

// Bifrost's config.json example: bedrock on input, azure content safety on output.
const DOCS_BEDROCK_AZURE = `{"guardrail_rules":[
  {"id":1,"name":"Block PII in Prompts","enabled":true,"target":"llm","cel_expression":"true","apply_to":"input","sampling_rate":100,"timeout":5000,"provider_config_ids":[3]},
  {"id":2,"name":"Content Filter for Responses","enabled":true,"target":"llm","cel_expression":"true","apply_to":"output","sampling_rate":100,"timeout":3000,"send_all_conversation_turns":false,"max_turns_to_send":8,"evaluation_mode":"per_turn","provider_config_ids":[4]}
],"guardrail_providers":[
  {"id":3,"provider_name":"bedrock","policy_name":"PII Detection Profile","enabled":true,"config":{"access_key":"AKIDEXAMPLE","secret_key":"wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY","guardrail_arn":"arn:aws:bedrock:us-east-1:123456789:guardrail/abc123","guardrail_version":"1","region":"us-east-1"}},
  {"id":4,"provider_name":"azure","policy_name":"Content Safety Profile","enabled":true,"config":{"endpoint":"https://your-resource.cognitiveservices.azure.com/","api_key":"key-123","analyze_enabled":true,"analyze_severity_threshold":"medium","jailbreak_shield_enabled":true,"indirect_attack_shield_enabled":true}}
]}`

test("bedrock and azure providers map to Raiju fields", () => {
  const r = try fromBifrost(DOCS_BEDROCK_AZURE)
  expect(r.config.enabled).toBe(true)
  const ps = r.config.providers ?? []
  expect(ps.length).toBe(2)
  const bd = ps[0]!
  expect(bd.kind).toBe("bedrock")
  expect(bd.id).toBe("bifrost-3")
  expect(bd.apply_to).toBe("input")
  expect(bd.guardrail_id).toBe("abc123")
  expect(bd.guardrail_version).toBe("1")
  expect(bd.region).toBe("us-east-1")
  expect(bd.access_key).toBe("AKIDEXAMPLE")
  expect(bd.secret_key).toBe("wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY")
  const az = ps[1]!
  expect(az.kind).toBe("azure_content_safety")
  expect(az.apply_to).toBe("output")
  expect(az.endpoint).toBe("https://your-resource.cognitiveservices.azure.com/")
  expect(az.api_key).toBe("key-123")
  expect(az.threshold).toBe(4.0)
  expect(warned(r.warnings, "jailbreak_shield_enabled")).toBe(true)
  expect(warned(r.warnings, "send_all_conversation_turns")).toBe(true)
  expect(warned(r.warnings, "timeout")).toBe(true)
  expect(warned(r.warnings, "evaluation_mode")).toBe(true)
  expect(r.warnings.length).toBe(3)
})

test("bedrock region comes from the ARN when unset, and a bare id is accepted", () => {
  const text = `{"guardrail_rules":[{"id":1,"name":"r","enabled":true,"cel_expression":"true","apply_to":"both","provider_config_ids":[1]}],
    "guardrail_providers":[{"id":1,"provider_name":"bedrock","policy_name":"p","enabled":true,"config":{"access_key":"AK","secret_key":"SK","guardrail_arn":"arn:aws:bedrock:eu-west-1:111122223333:guardrail/gr-9","guardrail_version":2}}]}`
  const r = try fromBifrost(text)
  const p = r.config.providers![0]!
  expect(p.region).toBe("eu-west-1")
  expect(p.guardrail_id).toBe("gr-9")
  expect(p.guardrail_version).toBe("2")
  expect(r.warnings.length).toBe(0)
  const bare = try fromBifrost(`{"guardrail_rules":[{"id":1,"name":"r","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[1]}],"guardrail_providers":[{"id":1,"provider_name":"bedrock","policy_name":"p","enabled":true,"config":{"access_key":"AK","secret_key":"SK","guardrail_arn":"gr-7","guardrail_version":"DRAFT"}}]}`)
  expect(bare.config.providers![0]!.guardrail_id).toBe("gr-7")
  expect(bare.config.providers![0]!.region).toBeUndefined()
})

test("secrets and PII regex patterns map to built-in detectors", () => {
  const text = `{"guardrail_rules":[{"id":1,"name":"Block secrets","enabled":true,"cel_expression":"true","apply_to":"both","provider_config_ids":[1,2]}],
  "guardrail_providers":[
    {"id":1,"provider_name":"secrets","policy_name":"block-leaked-credentials","enabled":true,"timeout":5,"config":{"ignored_secret_keywords":["example","dummy"],"action":"redact","redaction_strategy":"replace","redaction_mode":"logs_only"}},
    {"id":2,"provider_name":"regex","policy_name":"pii-detection","enabled":true,"config":{"patterns":[
      {"pattern":"\\\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\\\.[A-Z]{2,}\\\\b","description":"Email address","flags":"i","action":"redact","allowed_values":["support@example.com"]},
      {"pattern":"\\\\b\\\\d{3}-\\\\d{2}-\\\\d{4}\\\\b","description":"US Social Security Number","action":"block"},
      {"pattern":"PROJ-\\\\d+","description":"Internal project code","action":"block"}]}}
  ]}`
  const r = try fromBifrost(text)
  expect(r.config.detect).toEqual(["private_key", "jwt", "api_key", "aws_key", "email", "ssn"])
  expect(r.config.apply_to).toBe("both")
  // redact and block are both present, so the strictest, block, applies to every detector
  expect(r.config.mode).toBe("block")
  // the Gitleaks set and the custom pattern run as providers; the PII template pattern stays built in
  const ps = r.config.providers ?? []
  expect(ps.length).toBe(2)
  expect(ps[0]!.kind).toBe("secrets")
  expect(ps[0]!.ignored_secret_keywords).toEqual(["example", "dummy"])
  expect(ps[0]!.targets).toEqual(["llm"])
  expect(ps[1]!.kind).toBe("regex")
  expect(ps[1]!.patterns!.length).toBe(1)
  expect(ps[1]!.patterns![0]!.pattern).toBe("PROJ-\\d+")
  expect(ps[1]!.patterns![0]!.action).toBe("block")
  expect(warned(r.warnings, "Internal project code")).toBe(false)
  expect(warned(r.warnings, "redaction_mode")).toBe(true)
  expect(warned(r.warnings, "allowed_values")).toBe(true)
  expect(warned(r.warnings, "strictest")).toBe(true)
})

test("detect_only maps to log and secrets alone keeps its mode", () => {
  const text = `{"guardrail_rules":[{"id":1,"name":"r","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[1]}],
  "guardrail_providers":[{"id":1,"provider_name":"secrets","policy_name":"s","enabled":true,"config":{"action":"detect_only"}}]}`
  const r = try fromBifrost(text)
  expect(r.config.mode).toBe("log")
  expect(r.config.detect!.includes("jwt")).toBe(true)
  expect(r.config.apply_to).toBe("input")
})

test("unsupported providers, MCP rules and disabled items are warned, not dropped silently", () => {
  const text = `{"guardrail_rules":[
    {"id":1,"name":"Protect GitHub issue creation","enabled":true,"target":"mcp","cel_expression":"mcp_client == 'github'","apply_to":"input","provider_config_ids":[6]},
    {"id":2,"name":"Armor prompts","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[5,6,7]},
    {"id":3,"name":"Judge","enabled":false,"cel_expression":"true","apply_to":"output","provider_config_ids":[8]},
    {"id":4,"name":"Scoped","enabled":true,"cel_expression":"headers[\\"x-env\\"] == \\"prod\\"","apply_to":"output","provider_config_ids":[9]}
  ],"guardrail_providers":[
    {"id":5,"provider_name":"bedrock","policy_name":"Bedrock Guard","enabled":true,"config":{"guardrail_arn":"arn:aws:bedrock:us-east-1:123456789:guardrail/g1","guardrail_version":"1","access_key":"env.RAIJU_COMPAT_TEST_UNSET_VAR","secret_key":"sk"}},
    {"id":6,"provider_name":"crowdstrike-aidr","policy_name":"CrowdStrike AIDR Production","enabled":true,"config":{"api_key":"x"}},
    {"id":7,"provider_name":"presidio","policy_name":"Presidio PII","enabled":true,"config":{}},
    {"id":8,"provider_name":"prompt-guardrail","policy_name":"no-medical","enabled":true,"config":{}},
    {"id":9,"provider_name":"patronus-ai","policy_name":"Quality","enabled":true,"config":{"api_key":"pk","evaluators":[{"evaluator":"pii","explain_strategy":"on-fail"},{"evaluator":"judge","criteria":"patronus:is-concise"}],"capture":"none"}},
    {"id":10,"provider_name":"grayswan","policy_name":"Unlinked","enabled":true,"config":{}}
  ]}`
  const r = try fromBifrost(text)
  expect(warned(r.warnings, "the tool-call link is not enforced")).toBe(true)
  expect(warned(r.warnings, "access_key refers to env.RAIJU_COMPAT_TEST_UNSET_VAR")).toBe(true)
  expect(warned(r.warnings, "CrowdStrike AIDR Production")).toBe(true)
  expect(warned(r.warnings, "Presidio PII")).toBe(true)
  expect(warned(r.warnings, "no-medical")).toBe(true)
  expect(warned(r.warnings, 'rule "Judge" is disabled')).toBe(true)
  expect(warned(r.warnings, "condition headers")).toBe(true)
  expect(warned(r.warnings, "explain_strategy")).toBe(true)
  expect(warned(r.warnings, "grayswan")).toBe(true)
  // the scoped rule still runs its patronus check, widened to all traffic
  const ps = r.config.providers ?? []
  expect(ps.length).toBe(2)
  expect(ps[0]!.kind).toBe("crowdstrike_aidr")
  expect(ps[1]!.kind).toBe("patronus")
  expect(ps[1]!.apply_to).toBe("output")
  expect(ps[1]!.evaluators!.length).toBe(2)
  expect(ps[1]!.evaluators![1]!.criteria).toBe("patronus:is-concise")
})

test("a rule with no providers and an undefined provider link are warned", () => {
  const text = `{"guardrail_rules":[
    {"id":1,"name":"Empty","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[]},
    {"id":2,"name":"Dangling","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[42]}
  ],"guardrail_providers":[]}`
  const r = try fromBifrost(text)
  expect(warned(r.warnings, 'rule "Empty" links no providers')).toBe(true)
  expect(warned(r.warnings, "provider 42, which is not defined")).toBe(true)
  expect(r.config.enabled).toBe(false)
})

test("azure severity maps to Raiju thresholds and disabled analysis is left out", () => {
  const mk = (sev: string): string =>
    `{"guardrail_rules":[{"id":1,"name":"r","enabled":true,"cel_expression":"true","apply_to":"output","provider_config_ids":[1]}],"guardrail_providers":[{"id":1,"provider_name":"azure","policy_name":"a","enabled":true,"config":{"endpoint":"https://x.example/","api_key":"k","analyze_severity_threshold":"${sev}"}}]}`
  expect((try fromBifrost(mk("low"))).config.providers![0]!.threshold).toBe(2.0)
  expect((try fromBifrost(mk("high"))).config.providers![0]!.threshold).toBe(6.0)
  const off = try fromBifrost(`{"guardrail_rules":[{"id":1,"name":"r","enabled":true,"cel_expression":"true","apply_to":"output","provider_config_ids":[1]}],"guardrail_providers":[{"id":1,"provider_name":"azure","policy_name":"a","enabled":true,"config":{"endpoint":"https://x.example/","api_key":"k","analyze_enabled":false}}]}`)
  expect(off.config.providers!.length).toBe(0)
  expect(warned(off.warnings, "analyze_enabled is false")).toBe(true)
})

test("webhook provider keeps its url and headers", () => {
  const text = `{"guardrail_rules":[{"id":1,"name":"r","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[1]}],"guardrail_providers":[{"id":1,"provider_name":"webhook","policy_name":"hook","enabled":true,"config":{"url":"https://guard.example.com/check","headers":{"Authorization":"Bearer t"}}}]}`
  const r = try fromBifrost(text)
  const p = r.config.providers![0]!
  expect(p.kind).toBe("webhook")
  expect(p.url).toBe("https://guard.example.com/check")
  expect(p.headers!.get("Authorization")).toBe("Bearer t")
})

test("empty input and malformed JSON", () => {
  const none = try fromBifrost("null")
  expect(none.config.enabled).toBe(false)
  expect(none.warnings.length).toBe(0)
  let threw = false
  try {
    fromBifrost("{")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("merge keeps both sides, unions detectors and lets own settings win", () => {
  expect(merge(undefined, undefined)).toBeUndefined()
  const bif: GuardrailsConfig = { enabled: true, detect: ["email", "ssn"], mode: "block", apply_to: "input", providers: [{ id: "bifrost-3", kind: "bedrock", apply_to: "input" }] }
  const own: GuardrailsConfig = { enabled: true, detect: ["email", "phone"], mode: "redact", providers: [{ id: "bifrost-3", kind: "patronus", apply_to: "both", api_key: "k" }] }
  const only = merge(undefined, bif)
  expect(only!.mode).toBe("block")
  const m = merge(own, bif)!
  expect(m.detect).toEqual(["email", "phone", "ssn"])
  expect(m.mode).toBe("redact")
  expect(m.apply_to).toBe("input")
  const ps = m.providers ?? []
  expect(ps.length).toBe(2)
  expect(ps[0]!.kind).toBe("patronus")
  expect(ps[1]!.id).toBe("bifrost-bifrost-3")
  expect(ps[1]!.kind).toBe("bedrock")
  expect(merge(own, undefined)!.mode).toBe("redact")
})

test("presidio, azure pii, model armor and aidr map to Raiju providers", () => {
  const text = `{"guardrail_rules":[
    {"id":1,"name":"in","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[1,2,3,4]},
    {"id":2,"name":"out","enabled":true,"cel_expression":"true","apply_to":"output","provider_config_ids":[4]}
  ],"guardrail_providers":[
    {"id":1,"provider_name":"presidio","policy_name":"pres","enabled":true,"config":{"analyzer_url":"https://presidio.example.com","language":"en","score_threshold":0.75,"entities":["EMAIL_ADDRESS","PERSON"],"action":"redact","redaction_mode":"runtime_reversible"}},
    {"id":2,"provider_name":"azure-pii","policy_name":"azpii","enabled":true,"config":{"endpoint":"https://lang.example.com","api_key":"k","pii_categories":["Email"],"action":"block"}},
    {"id":3,"provider_name":"model-armor","policy_name":"armor","enabled":true,"config":{"project_id":"p","location":"us","template_id":"t","access_token":"tok"}},
    {"id":4,"provider_name":"crowdstrike-aidr","policy_name":"aidr","enabled":true,"config":{"api_key":"tk","app_id":"bifrost"}}
  ]}`
  const r = try fromBifrost(text)
  const ps = r.config.providers ?? []
  expect(ps.length).toBe(4)
  expect(ps[0]!.kind).toBe("presidio")
  expect(ps[0]!.analyzer_url).toBe("https://presidio.example.com")
  expect(ps[0]!.score_threshold).toBe(0.75)
  expect(ps[0]!.entities).toEqual(["EMAIL_ADDRESS", "PERSON"])
  expect(ps[0]!.action).toBe("redact")
  expect(ps[0]!.apply_to).toBe("input")
  expect(ps[1]!.kind).toBe("azure_language_pii")
  expect(ps[1]!.action).toBe("block")
  expect(ps[1]!.pii_categories).toEqual(["Email"])
  expect(ps[1]!.model_version).toBe("latest")
  expect(ps[2]!.kind).toBe("google_model_armor")
  expect(ps[2]!.access_token).toBe("tok")
  expect(ps[2]!.apply_to).toBe("input")
  expect(ps[3]!.kind).toBe("crowdstrike_aidr")
  expect(ps[3]!.app_id).toBe("bifrost")
  expect(ps[3]!.apply_to).toBe("both")
  // runtime_reversible turns the reversible restore on for the whole config
  expect(r.config.reversible).toBe(true)
  expect(r.warnings.length).toBe(0)
})

test("model armor without a token is not loaded, and an unknown kind is warned", () => {
  const text = `{"guardrail_rules":[{"id":1,"name":"r","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[1,2]}],"guardrail_providers":[
    {"id":1,"provider_name":"model-armor","policy_name":"adc","enabled":true,"config":{"project_id":"p","location":"us","template_id":"t","auth_type":"default_credential"}},
    {"id":2,"provider_name":"prompt-guardrail","policy_name":"judge","enabled":true,"config":{"judge_provider":"openai","judge_model":"gpt-4o-mini","rule":"No diagnoses.","max_output_tokens":300}}
  ]}`
  const r = try fromBifrost(text)
  expect(warned(r.warnings, "needs ADC or a service account")).toBe(true)
  const ps = r.config.providers ?? []
  expect(ps.length).toBe(1)
  expect(ps[0]!.kind).toBe("prompt_judge")
  expect(ps[0]!.judge_model).toBe("gpt-4o-mini")
  expect(ps[0]!.max_output_tokens).toBe(300)
  expect(ps[0]!.targets).toEqual(["llm"])
})

test("mcp rules turn their regex and secrets providers on for tool calls", () => {
  const text = `{"guardrail_rules":[
    {"id":1,"name":"tool args","enabled":true,"target":"mcp","cel_expression":"true","apply_to":"input","provider_config_ids":[1,2]},
    {"id":2,"name":"prompt","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[1]}
  ],"guardrail_providers":[
    {"id":1,"provider_name":"regex","policy_name":"no-internal","enabled":true,"config":{"patterns":[{"pattern":"PROJ-\\\\d+","description":"Project","action":"block"}]}},
    {"id":2,"provider_name":"secrets","policy_name":"mcp-only-keys","enabled":true,"config":{"action":"block"}}
  ]}`
  const r = try fromBifrost(text)
  const ps = r.config.providers ?? []
  expect(ps.length).toBe(2)
  expect(ps[0]!.kind).toBe("regex")
  expect(ps[0]!.targets).toEqual(["llm", "mcp"])
  expect(ps[0]!.apply_to).toBe("input")
  // the secrets provider is linked only to the MCP rule, so it has no LLM detectors
  expect(ps[1]!.kind).toBe("secrets")
  expect(ps[1]!.targets).toEqual(["mcp"])
  expect(r.config.detect!.includes("jwt")).toBe(false)
  const r2 = try fromBifrost(`{"guardrail_rules":[{"id":1,"name":"t","enabled":true,"target":"mcp","cel_expression":"true","apply_to":"input","provider_config_ids":[1]}],"guardrail_providers":[{"id":1,"provider_name":"secrets","policy_name":"k","enabled":true,"config":{"action":"block"}}]}`)
  expect(r2.config.providers!.length).toBe(1)
  expect(r2.config.providers![0]!.targets).toEqual(["mcp"])
  expect(r2.config.detect!.includes("jwt")).toBe(false)
  expect(r2.config.enabled).toBe(true)
})

test("a rule's stream_replay_event_interval_ms carries to the output replay pacing, the largest of the output rules", () => {
  const providers = `"guardrail_providers":[{"id":1,"provider_name":"secrets","policy_name":"k","enabled":true,"config":{"action":"block"}},{"id":2,"provider_name":"secrets","policy_name":"k2","enabled":true,"config":{"action":"block"}}]`
  const rules = `"guardrail_rules":[{"id":1,"name":"a","enabled":true,"cel_expression":"true","apply_to":"output","provider_config_ids":[1],"stream_replay_event_interval_ms":25},{"id":2,"name":"b","enabled":true,"cel_expression":"true","apply_to":"both","provider_config_ids":[2],"stream_replay_event_interval_ms":40},{"id":3,"name":"c","enabled":true,"cel_expression":"true","apply_to":"input","provider_config_ids":[2],"stream_replay_event_interval_ms":900}]`
  const r = try fromBifrost(`{${rules},${providers}}`)
  expect(r.config.stream_replay_event_interval_ms).toBe(40)
  expect(r.warnings.some((w: string) => w.includes("stream_replay_event_interval_ms"))).toBe(false)
  const none = try fromBifrost(`{"guardrail_rules":[{"id":1,"name":"a","enabled":true,"cel_expression":"true","apply_to":"output","provider_config_ids":[1]}],${providers}}`)
  expect(none.config.stream_replay_event_interval_ms).toBe(undefined)
  const capped = try fromBifrost(`{"guardrail_rules":[{"id":1,"name":"a","enabled":true,"cel_expression":"true","apply_to":"output","provider_config_ids":[1],"stream_replay_event_interval_ms":5000}],${providers}}`)
  expect(capped.config.stream_replay_event_interval_ms).toBe(1000)
})
