  expect(nativeRoute("GET", "/bedrock/model-invocation-jobs")?.kind).toBe("bedrock.list")
  expect(nativeRoute("GET", "/bedrock/model-invocation-job/arn%3Aaws%3Ajob-1")?.id).toBe("arn:aws:job-1")
  expect(nativeRoute("POST", "/bedrock/model-invocation-job/job-1/stop")?.kind).toBe("bedrock.stop")
  expect(nativeRoute("PUT", "/bedrock/files/b1/jobs/in.jsonl")?.key).toBe("jobs/in.jsonl")
  expect(nativeRoute("GET", "/bedrock/files/b1")?.kind).toBe("bedrock.files.list")
  expect(nativeRoute("PUT", "/bedrock/files/b1")).toBe(undefined)
  expect(nativeRoute("POST", "/genai/v1/projects/p/locations/us/batchPredictionJobs")?.kind).toBe("vertex.create")
  expect(nativeRoute("GET", "/genai/v1/projects/p/locations/us/batchPredictionJobs/123")?.id).toBe("123")
  expect(nativeRoute("POST", "/genai/v1/projects/p/locations/us/batchPredictionJobs/123:cancel")?.kind).toBe("vertex.cancel")
  expect(nativeRoute("POST", "/genai/v1beta/projects/p/locations/us/cachedContents")?.kind).toBe("vertex.cache.create")
  expect(nativeRoute("PATCH", "/genai/v1beta/projects/p/locations/us/cachedContents/c1")?.kind).toBe("vertex.cache.update")
  expect(nativeRoute("POST", "/genai/v1beta/projects/p/locations/us/cachedContents/c1")).toBe(undefined)
  expect(nativeRoute("GET", "/genai/v1/projects/p/locations/us/endpoints")).toBe(undefined)
})

test("wafer file objects read as OpenAI's: ready is processed, dates are seconds", () => {
  const f = try waferFileToOpenAI(`{"id":"file_1","purpose":"fine-tune","filename":"a.jsonl","mime_type":"application/jsonl","bytes":12,"status":"ready","created_at":"2026-10-14T13:00:00.123Z","expires_at":"2026-11-14T13:00:00Z"}`)
  expect(f).toBe(`{"id":"file_1","object":"file","bytes":12,"created_at":1791982800,"filename":"a.jsonl","purpose":"fine-tune","status":"processed","expires_at":1794661200}`)
  expect(try waferFileToOpenAI(`{"id":"file_2","status":"pending"}`).includes(`"status":"uploaded"`)).toBe(true)
})

test("a character is a UTF-8 lead byte, as Bifrost counts runes", () => {
  expect(charCount("say ping")).toBe(8)
  expect(charCount("héllo")).toBe(5)
  expect(charCount("日本")).toBe(2)
  expect(charCount("")).toBe(0)
  expect(billedMedia("audio.speech") && billedMedia("audio.transcriptions") && billedMedia("audio.translations")).toBe(true)
  expect(billedMedia("images.generations") || billedMedia("audio.other")).toBe(false)
})

test("a transcription reports its duration or its tokens, else its verbose duration", () => {
  const d = transcriptionUsage(`{"text":"hi","usage":{"type":"duration","seconds":12.5}}`)!
  expect(d.seconds!).toBeCloseTo(12.5)
  expect(d.prompt).toBe(0)
  const t = transcriptionUsage(`{"text":"hi","usage":{"type":"tokens","input_tokens":14,"output_tokens":6,"total_tokens":20,"input_token_details":{"audio_tokens":10,"text_tokens":4}}}`)!
  expect(t.prompt).toBe(14)
  expect(t.completion).toBe(6)
  expect(t.inputAudio).toBe(10)
  expect(t.inputText).toBe(4)
  expect(t.seconds).toBeUndefined()
  // no usage, or a usage with no tokens: the verbose answer's duration
  expect(transcriptionUsage(`{"text":"hi","duration":7.5}`)!.seconds!).toBeCloseTo(7.5)
  expect(transcriptionUsage(`{"text":"hi","duration":7.5,"usage":{"type":"tokens","total_tokens":0}}`)!.seconds!).toBeCloseTo(7.5)
  expect(transcriptionUsage(`{"text":"hi"}`)).toBeUndefined()
  expect(transcriptionUsage("{")).toBeUndefined()
})

test("a streamed transcription's usage is on its last event that has one", () => {
  const s = "data: {\"type\":\"transcript.text.delta\",\"delta\":\"hi\"}\n\n" +
    "data: {\"type\":\"transcript.text.done\",\"text\":\"hi\",\"usage\":{\"type\":\"tokens\",\"input_tokens\":3,\"output_tokens\":1,\"total_tokens\":4}}\n\n" +
    "data: [DONE]\n\n"
  const u = transcriptionUsage(s)!
  expect(u.prompt).toBe(3)
  expect(u.completion).toBe(1)
  expect(transcriptionUsage("data: {\"type\":\"transcript.text.delta\",\"delta\":\"hi\"}\n\ndata: [DONE]\n\n")).toBeUndefined()
})

test("a streamed transcription's usage is read as its events pass, whatever the chunks", () => {
  const s = "data: {\"type\":\"transcript.text.delta\",\"delta\":\"hé\"}\n\n" +
    "data: {\"type\":\"transcript.text.done\",\"text\":\"hé\",\"usage\":{\"type\":\"tokens\",\"input_tokens\":3,\"output_tokens\":1,\"total_tokens\":4}}\n\n" +
    "data: [DONE]"
  const bytes = new TextEncoder().encode(s)
  // fed three bytes at a time: lines and characters split across chunks
  const su = new StreamUsage()
  let i = 0
  while (i < bytes.length) {
    su.push(bytes.slice(i, Math.min(i + 3, bytes.length)))
    i += 3
  }
  const u = su.end()!
  expect(u.prompt).toBe(3)
  expect(u.completion).toBe(1)
  const none = new StreamUsage()
  none.push(new TextEncoder().encode("event: x\ndata: {\"type\":\"transcript.text.delta\"}\n"))
  expect(none.end()).toBeUndefined()
  expect(isEventStream("text/event-stream; charset=utf-8")).toBe(true)
  expect(isEventStream("application/json")).toBe(false)
})

