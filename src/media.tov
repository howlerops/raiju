// Pass-through endpoints for OpenAI's audio, image, file and batch APIs. Model
// endpoints find the provider from the model ("provider/model" in a JSON field
// or a form field). File and batch endpoints have no model, so the provider
// comes from the x-bf-provider header or the provider query parameter. The
// rest of each request goes upstream unchanged. Anthropic, Gemini, Vertex and Bedrock
// have their own APIs: media_native.tov and media_cloud.tov build those requests and the answers
// are converted to OpenAI's shapes here.
import { Config, KeyConfig, ProviderConfig, providerOf } from "./config"
import { Target, headers, addExtraHeaders, trimSlash, proxyOf, tlsOf } from "./providers/types"
import { isOpenAICompatible, modelsRequest } from "./providers/openai"
import { parseModel, target, kindOf, pickKey, timeoutMs } from "./router"
import { Field, fields, find, rawStr, setField, build, quote } from "./json"
import { errorJson, snapshot } from "./schemas"
import { deadline } from "./deadline"
import * as native from "./media_native"
import * as cloud from "./media_cloud"
import * as cloudAuth from "./cloud_auth"
import { S3Creds, awsCall } from "./exports"
import { parseServiceAccount } from "./providers/vertex"

export type MediaRoute = { op: string, method: string, upstreamPath: string, modelIn: "json" | "form" | "none" }

// Azure's api-version when the key does not set one (as in openai.tov).
const API_VERSION = "2024-10-21"

// Path patterns after "/v1". "{id}" matches one non-empty segment.
type Pattern = { method: string, pattern: string, op: string, modelIn: "json" | "form" | "none" }

function patterns(): Pattern[] {
  return [
    { method: "POST", pattern: "/v1/audio/speech", op: "audio.speech", modelIn: "json" },
    { method: "POST", pattern: "/v1/images/generations", op: "images.generations", modelIn: "json" },
    { method: "POST", pattern: "/v1/audio/transcriptions", op: "audio.transcriptions", modelIn: "form" },
    { method: "POST", pattern: "/v1/audio/translations", op: "audio.translations", modelIn: "form" },
    { method: "POST", pattern: "/v1/images/edits", op: "images.edits", modelIn: "form" },
    { method: "POST", pattern: "/v1/images/variations", op: "images.variations", modelIn: "form" },
    { method: "POST", pattern: "/v1/files", op: "files.create", modelIn: "none" },
    { method: "GET", pattern: "/v1/files", op: "files.list", modelIn: "none" },
    { method: "GET", pattern: "/v1/files/{id}", op: "files.retrieve", modelIn: "none" },
    { method: "DELETE", pattern: "/v1/files/{id}", op: "files.delete", modelIn: "none" },
    { method: "GET", pattern: "/v1/files/{id}/content", op: "files.content", modelIn: "none" },
    { method: "POST", pattern: "/v1/batches", op: "batches.create", modelIn: "none" },
    { method: "GET", pattern: "/v1/batches", op: "batches.list", modelIn: "none" },
    { method: "GET", pattern: "/v1/batches/{id}", op: "batches.retrieve", modelIn: "none" },
    { method: "POST", pattern: "/v1/batches/{id}/cancel", op: "batches.cancel", modelIn: "none" },
    { method: "GET", pattern: "/v1/batches/{id}/results", op: "batches.results", modelIn: "none" },
    // the Responses lifecycle (provider from x-bf-provider or ?provider=, default OpenAI, as Bifrost)
    { method: "POST", pattern: "/v1/responses/input_tokens", op: "responses.input_tokens", modelIn: "json" },
    { method: "POST", pattern: "/v1/responses/compact", op: "responses.compact", modelIn: "json" },
    { method: "GET", pattern: "/v1/responses/{id}", op: "responses.retrieve", modelIn: "none" },
    { method: "DELETE", pattern: "/v1/responses/{id}", op: "responses.delete", modelIn: "none" },
    { method: "POST", pattern: "/v1/responses/{id}/cancel", op: "responses.cancel", modelIn: "none" },
    { method: "GET", pattern: "/v1/responses/{id}/input_items", op: "responses.input_items", modelIn: "none" },
    // Realtime over REST and WebRTC: ephemeral client secrets, sessions, and SDP calls
    { method: "POST", pattern: "/v1/realtime/client_secrets", op: "realtime.client_secrets", modelIn: "none" },
    { method: "POST", pattern: "/v1/realtime/sessions", op: "realtime.sessions", modelIn: "json" },
    { method: "POST", pattern: "/v1/realtime/calls", op: "realtime.calls", modelIn: "none" },
    // Mistral's OCR (and OpenAI-compatible providers that offer it)
    { method: "POST", pattern: "/v1/ocr", op: "ocr", modelIn: "json" },
  ]
}

const PATTERNS: Pattern[] = patterns()

function segmentsMatch(pattern: string, path: string): bool {
  const ps = pattern.split("/")
  const xs = path.split("/")
  if (ps.length !== xs.length) return false
  for (let i = 0; i < ps.length; i++) {
    const p = ps[i]!
    const x = xs[i]!
    if (p === "{id}") {
      if (x === "") return false
    } else if (p !== x) return false
  }
  return true
}

// The route for a request path (no query string), or undefined.
export function matchRoute(method: string, path: string): MediaRoute | undefined {
  const m = method.toUpperCase()
  for (const p of PATTERNS) {
    if (p.method === m && segmentsMatch(p.pattern, path)) {
      // The path minus "/v1" is the upstream path, with the ids as the caller sent them.
      return { op: p.op, method: m, upstreamPath: path.slice(3), modelIn: p.modelIn }
    }
  }
  return undefined
}

// Azure-style deployment paths under the OpenAI integration, as Bifrost mounts them:
// /openai/deployments/{deployment}/{op}. The deployment is the model: "azure/{deployment}",
// or "{provider}/{deployment}" when the deployment has a provider segment first.
const DEPLOYMENT_OPS = ["/chat/completions", "/completions", "/embeddings", "/responses/input_tokens", "/responses/compact", "/responses", "/images/generations", "/images/edits", "/images/variations", "/audio/speech", "/audio/transcriptions"]

export type Deployment = { path: string, model: string }

// The /v1 route and model of a deployment path (no query string), or undefined.
export function deploymentRoute(p: string): Deployment | undefined {
  const pre = "/openai/deployments/"
  if (!p.startsWith(pre)) return undefined
  const rest = p.slice(pre.byteLength)
  for (const op of DEPLOYMENT_OPS) {
    if (rest.endsWith(op)) {
      const dep = rest.slice(0, rest.byteLength - op.byteLength)
      if (dep === "") return undefined
      return { path: "/v1" + op, model: dep.includes("/") ? dep : "azure/" + dep }
    }
  }
  return undefined
}

// The request on its /v1 route: the model is the deployment's, the caller's api-version is
// dropped (Bifrost ignores it), and the body's model field is replaced (JSON, or a form field).
// A body that cannot be read is passed on as it came.
export async function deploymentRequest(req: Request, d: Deployment): Promise<Request> {
  const u = URL.parse(req.url)
  const origin = u === undefined ? "http://localhost" : u.origin
  const sp = new URLSearchParams(u === undefined ? "" : u.search)
  sp.delete("api-version")
  const qs = sp.toString()
  const url = origin + d.path + (qs === "" ? "" : "?" + qs)
  const hs: Map<string, string> = snapshot(req.headers)
  const ct = req.headers.get("content-type") ?? ""
  try {
    if (ct.includes("multipart/form-data")) {
      const fd = try await req.formData()
      // the new form brings its own boundary
      hs.delete("content-type")
      return new Request(url, { method: req.method, headers: hs, body: formWithModel(fd, d.model) })
    }
    const text = try await req.text()
    hs.delete("content-length")
    let body = text
    try {
      body = try rewriteJsonModel(text, d.model)
    } catch (e) {
      body = text
    }
    return new Request(url, { method: req.method, headers: hs, body: body })
  } catch (e) {
    return req
  }
}

// The OpenAI-compatible base (".../v1" or the provider's prefix), taken from
// openai.tov so base_url overrides and default endpoints stay in one place.
function openaiBase(t: Target): string {
  const u = modelsRequest(t).url
  return u.slice(0, u.byteLength - "/models".byteLength)
}

// The upstream URL. `query` is the raw query string without "?"; for Azure the
// api-version is added to it.
export function upstreamUrl(t: Target, route: MediaRoute, query: string): string {
  const modelBased = route.modelIn !== "none"
  if (t.kind === "azure") {
    const az = t.key.azure_key_config
    const endpointUrl = trimSlash(az?.endpoint ?? t.cfg.network_config?.base_url ?? "")
    let prefix = "/openai" + route.upstreamPath
    if (modelBased) {
      let deployment = t.model
      const deps = az?.deployments
      if (deps !== undefined) deployment = deps.get(t.model) ?? t.model
      prefix = "/openai/deployments/" + deployment + route.upstreamPath
    }
    const sp = new URLSearchParams(query)
    sp.set("api-version", az?.api_version ?? API_VERSION)
    return endpointUrl + prefix + "?" + sp.toString()
  }
  const url = openaiBase(t) + route.upstreamPath
  return query === "" ? url : url + "?" + query
}

// Auth and provider headers. The content type is left to the caller: a
// multipart body needs the boundary that fetch adds.
export function authHeaders(t: Target): Map<string, string> {
  let h = headers([])
  const v = t.key.value ?? ""
  if (t.kind === "azure") {
    if (v !== "") h.set("api-key", v)
  } else if (v !== "") h.set("authorization", "Bearer " + v)
  addExtraHeaders(&h, t.cfg)
  return h
}

// Replaces the top-level "model" field and keeps the other fields' values as
// they were sent. Throws SyntaxError when the body is not a JSON object.
export function rewriteJsonModel(body: string, model: string): string throws SyntaxError {
  let fs = try fields(body)
  setField(&fs, "model", quote(model))
  return build(fs)
}

// The provider for a file or batch request: the x-bf-provider header, then the
// provider query parameter, then OpenAI.
export function providerFor(hs: Map<string, string>, query: URLSearchParams): string {
  const h = hs.get("x-bf-provider") ?? ""
  if (h !== "") return h
  const q = query.get("provider") ?? ""
  if (q !== "") return q
  return "openai"
}

// Providers that serve these endpoints: OpenAI-compatible ones and Azure.
function supported(kind: string): bool {
  return kind === "azure" || isOpenAICompatible(kind)
}

// The target for a model endpoint: the model's provider and key, as chat uses.
function modelTarget(cfg: Config, model: string): Target | undefined {
  const sel = target(cfg, parseModel(cfg, model), new Set<int>(), undefined)
  if (sel === undefined) return undefined
  return sel.t
}

// The target for a file or batch request. These have no model, so keys that
// are limited to certain models are used only when no unrestricted key exists.
// As Bifrost, only keys with use_for_batch_api serve these; when a provider has keys but
// none is flagged, it has no target (the route answers 404).
export function providerTarget(cfg: Config, provider: string): Target | undefined {
  const p = providerOf(cfg, provider)
  if (p === undefined) return undefined
  const kind = kindOf(provider, p)
  const all = p.keys ?? []
  const ks = all.filter((k) => k.use_for_batch_api === true)
  if (all.length > 0 && ks.length === 0) return undefined
  let key: KeyConfig = { value: "" }
  if (ks.length > 0) {
    const pool = ks.filter((k) => (k.models ?? []).length === 0)
    const i = pool.length > 0 ? pickKey(pool, "", new Set<int>(), undefined) : -1
    if (i >= 0) key = pool[i]!
    else key = ks[0]!
  } else {
    const keyless = p.custom_provider_config?.is_key_less ?? false
    const local = kind === "ollama" || kind === "vllm" || kind === "sgl" || kind === "lmstudio"
    if (!keyless && !local) return undefined
  }
  return { provider: provider, kind: kind, model: "", key: key, cfg: p }
}

function errorReply(status: int, message: string, type: string): Response {
  return new Response(errorJson(message, type, undefined), { status: status, headers: { "content-type": "application/json" } })
}

// The multipart body with its model field rewritten; every other field and
// file is appended in order.
function formWithModel(fd: FormData, model: string): FormData {
  const out = new FormData()
  let replaced = false
  fd.forEach((value, key) => {
    if (key === "model") {
      if (!replaced) out.append("model", model)
      replaced = true
    } else out.append(key, value)
  })
  return out
}

// Sends one request upstream and returns the answer as it came. A failed call
// is a 502 in the OpenAI error shape.
export async function send(t: Target, mr: native.MediaRequest): Promise<Response> {
  const r: Record<string, string> = mr.headers
  const body = mr.body
  const dl = deadline(timeoutMs(t.cfg))
  const signal = dl.controller.signal
  try {
    let res: Response
    const px = proxyOf(t.cfg)
    const tls = tlsOf(t.cfg)
    if (body === undefined) res = try await fetch(mr.url, { method: mr.method, headers: r, signal: signal, proxy: px, tls: tls })
    else res = try await fetch(mr.url, { method: mr.method, headers: r, body: body, signal: signal, proxy: px, tls: tls })
    const bytes = try await res.bytes()
    dl.finish()
    const ct = res.headers.get("content-type") ?? "application/json"
    return new Response(bytes, { status: res.status, headers: { "content-type": ct } })
  } catch (e) {
    dl.finish()
    return errorReply(502, `${t.provider} request failed: ${e.message}`, "api_connection_error")
  }
}

// Serves one media, file or batch request: picks the provider, rewrites the
// model when the body carries one, and returns the upstream response as it came.
export async function handleMedia(cfg: Config, req: Request, route: MediaRoute): Promise<Response> throws TypeError {
  const url = try new URL(req.url)
  const sp = new URLSearchParams(url.search)
  const provider = providerFor(snapshot(req.headers), sp)
  // "provider" is for the gateway only; the rest of the query goes upstream.
  sp.delete("provider")
  const qs = sp.toString()

  let t: Target | undefined = undefined
  let body: string | FormData | undefined = undefined
  let contentType: string | undefined = undefined
  try {
    if (route.modelIn === "json") {
      const text = try await req.text()
      const model = rawStr(try fields(text), "model")
      if (model === undefined) return errorReply(400, "the request needs a \"model\" field", "invalid_request_error")
      const mt = modelTarget(cfg, model)
      if (mt === undefined) return errorReply(404, `no provider or key serves model "${model}"`, "invalid_request_error")
      t = mt
      if (isNative(mt.kind)) return await nativeMedia(mt, route, qs, text, undefined)
      body = try rewriteJsonModel(text, mt.model)
      contentType = "application/json"
    } else if (route.modelIn === "form") {
      const fd = try await req.formData()
      const model = fd.get("model")
      if (typeof model !== "string") return errorReply(400, "the request needs a \"model\" field", "invalid_request_error")
      t = modelTarget(cfg, model)
      if (t === undefined) return errorReply(404, `no provider or key serves model "${model}"`, "invalid_request_error")
      if (isNative(t.kind)) return await nativeMedia(t, route, qs, "", fd)
      body = formWithModel(fd, t.model)
    } else {
      const pt = providerTarget(cfg, provider)
      if (pt === undefined) return errorReply(404, `provider "${provider}" is not configured or has no key`, "invalid_request_error")
      t = pt
      let text = ""
      let form: FormData | undefined = undefined
      if (route.op === "files.create") form = try await req.formData()
      else if (route.method === "POST") text = try await req.text()
      if (isNative(pt.kind)) return await nativeMedia(pt, route, qs, text, form)
      if (form !== undefined) body = form
      else if (text !== "") {
        body = text
        // an SDP offer goes up as the caller sent it (application/sdp, or the multipart boundary)
        contentType = route.op === "realtime.calls" ? (req.headers.get("content-type") ?? "application/sdp") : "application/json"
      }
    }
  } catch (e) {
    return errorReply(400, `invalid request body: ${e.message}`, "invalid_request_error")
  }
  const tt: Target = t === undefined ? { provider: provider, kind: "", model: "", key: { value: "" }, cfg: {} } : t
  if (!supported(tt.kind)) return errorReply(400, `provider "${tt.provider}" does not support ${route.op}`, "invalid_request_error")
  if (route.op === "batches.results") {
    try {
      return try await openaiBatchResults(tt, routeId(route))
    } catch (e) {
      return errorReply(502, `${tt.provider} batch results could not be read: ${e.message}`, "api_error")
    }
  }
  const hs = authHeaders(tt)
  if (contentType !== undefined) hs.set("content-type", contentType)
  return await send(tt, { method: route.method, url: upstreamUrl(tt, route, qs), headers: hs, body: body })
}

// ---- Native cloud routes: the provider's own job, file and cache APIs ----
// Bedrock's model-invocation jobs and S3-style files (/bedrock/...), and Vertex's regional
// batchPredictionJobs and cachedContents (/genai/v1/projects/... and /genai/v1beta/projects/...).
// The body goes up as the caller sent it; the key picks the account, region and project.

// A native route: kind is "bedrock.*" or "vertex.*"; id is the job or cache id (raw), and bucket
// and key are the S3 object's.
export type NativeRoute = { kind: string, method: string, id: string, bucket: string, key: string }

function nativeOf(kind: string, method: string, id: string, bucket: string, key: string): NativeRoute {
  return { kind: kind, method: method, id: id, bucket: bucket, key: key }
}

// The native route of a request (no query string), or undefined.
export function nativeRoute(method: string, path: string): NativeRoute | undefined {
  const m = method.toUpperCase()
  if (path === "/bedrock/model-invocation-job") return m === "POST" ? nativeOf("bedrock.create", m, "", "", "") : undefined
  if (path === "/bedrock/model-invocation-jobs") return m === "GET" ? nativeOf("bedrock.list", m, "", "", "") : undefined
  const jobPre = "/bedrock/model-invocation-job/"
  if (path.startsWith(jobPre)) {
    const rest = path.slice(jobPre.byteLength)
    if (m === "POST" && rest.endsWith("/stop")) {
      const id = cloud.pctDecode(rest.slice(0, rest.byteLength - 5))
      return id === "" ? undefined : nativeOf("bedrock.stop", m, id, "", "")
    }
    if (m === "GET" && rest !== "" && !rest.includes("/")) return nativeOf("bedrock.get", m, cloud.pctDecode(rest), "", "")
    return undefined
  }
  const filePre = "/bedrock/files/"
  if (path.startsWith(filePre)) {
    const rest = path.slice(filePre.byteLength)
    const i = rest.indexOf("/")
    if (i < 0) return m === "GET" && rest !== "" ? nativeOf("bedrock.files.list", m, "", cloud.pctDecode(rest), "") : undefined
    const bucket = cloud.pctDecode(rest.slice(0, i))
    const key = cloud.pctDecode(rest.slice(i + 1))
    if (bucket === "" || key === "") return undefined
    if (m === "PUT" || m === "GET" || m === "HEAD" || m === "DELETE") return nativeOf("bedrock.files.object", m, "", bucket, key)
    return undefined
  }
  const bp = "/genai/v1/projects/"
  const cp = "/genai/v1beta/projects/"
  if (path.startsWith(bp) || path.startsWith(cp)) {
    const cache = path.startsWith(cp)
    const segs = path.slice(cache ? cp.byteLength : bp.byteLength).split("/")
    // project/locations/location/<collection>[/id]
    if (segs.length < 4 || segs.length > 5 || segs[1] !== "locations") return undefined
    if (segs[3] !== (cache ? "cachedContents" : "batchPredictionJobs")) return undefined
    const v = cache ? "vertex.cache." : "vertex."
    if (segs.length === 4) {
      if (m === "POST") return nativeOf(v + "create", m, "", "", "")
      if (m === "GET") return nativeOf(v + "list", m, "", "", "")
      return undefined
    }
    const id = segs[4] ?? ""
    if (id === "") return undefined
    if (!cache && m === "POST" && id.endsWith(":cancel")) return nativeOf("vertex.cancel", m, id.slice(0, id.byteLength - 7), "", "")
    if (m === "GET") return nativeOf(v + "get", m, id, "", "")
    if (m === "DELETE") return nativeOf(v + "delete", m, id, "", "")
    if (cache && m === "PATCH") return nativeOf("vertex.cache.update", m, id, "", "")
    return undefined
  }
  return undefined
}

// Serves a native cloud route for the key's account: Bedrock (jobs and S3 files) or Vertex (jobs and
// cached contents). The provider is the x-model-provider header, else bedrock or vertex.
export async function nativeCloud(cfg: Config, req: Request, nr: NativeRoute): Promise<Response> throws TypeError {
  const url = try new URL(req.url)
  const sp = new URLSearchParams(url.search)
  const qs = sp.toString()
  const isBedrock = nr.kind.startsWith("bedrock.")
  const provider = req.headers.get("x-model-provider") ?? (isBedrock ? "bedrock" : "vertex")
  const t = providerTarget(cfg, provider)
  if (t === undefined) return errorReply(404, `provider "${provider}" is not configured or has no key`, "invalid_request_error")
  if (t.kind !== (isBedrock ? "bedrock" : "vertex")) return errorReply(400, `provider "${t.provider}" does not serve ${nr.kind}`, "invalid_request_error")
  const text = nr.method === "POST" || nr.method === "PATCH" || nr.method === "PUT" ? try await req.text() : ""
  if (isBedrock) {
    let c: S3Creds = { accessKey: "", secretKey: "", region: "" }
    try {
      c = try await bedrockCreds(t)
    } catch (e) {
      return errorReply(502, `bedrock authentication failed: ${e.message}`, "authentication_error")
    }
    const mr = bedrockNativeRequest(t, c, nr, sp, text, req.headers.get("content-type") ?? "application/octet-stream")
    if (mr === undefined) return errorReply(400, "the request could not be built", "invalid_request_error")
    return await send(t, mr)
  }
  let token = ""
  try {
    token = try await vertexBearer(t)
  } catch (e) {
    return errorReply(502, `vertex authentication failed: ${e.message}`, "authentication_error")
  }
  let mr: native.MediaRequest | undefined = undefined
  try {
    mr = try vertexNativeRequest(t, token, nr, qs, text)
  } catch (e) {
    return errorReply(400, e.message, "invalid_request_error")
  }
  if (mr === undefined) return errorReply(400, "the request could not be built", "invalid_request_error")
  return await send(t, mr)
}

// The Bedrock request for a native route. Jobs are AWS calls to the account's Bedrock endpoint; S3
// files go to the key's S3 endpoint.
function bedrockNativeRequest(t: Target, c: S3Creds, nr: NativeRoute, sp: URLSearchParams, text: string, contentType: string): native.MediaRequest | undefined {
  const now = Date.now()
  const o = cloud.bedrockOrigin(t, "bedrock", c.region)
  if (nr.kind === "bedrock.files.list") return cloud.s3List(c, cloud.s3Endpoint(t), nr.bucket, sp.get("prefix") ?? "", sp.get("continuation-token") ?? "", sp.get("max-keys") ?? "", now)
  if (nr.kind === "bedrock.files.object") return cloud.s3Object(c, cloud.s3Endpoint(t), nr.bucket, nr.key, nr.method, text, contentType, now)
  if (nr.kind === "bedrock.create") return cloud.sendable(awsCall(c, "bedrock", o.scheme, o.host, "POST", "/model-invocation-job", [], text, now))
  if (nr.kind === "bedrock.list") {
    const pairs: string[][] = []
    sp.forEach((v, k) => {
      pairs.push([k, v])
    })
    return cloud.sendable(awsCall(c, "bedrock", o.scheme, o.host, "GET", "/model-invocation-jobs", pairs, "", now))
  }
  if (nr.kind === "bedrock.get") return cloud.bedrockJobGet(o, c, nr.id, now)
  if (nr.kind === "bedrock.stop") return cloud.bedrockJobStop(o, c, nr.id, now)
  return undefined
}

// The Vertex request for a native route: the key's project and region, the body as sent.
function vertexNativeRequest(t: Target, token: string, nr: NativeRoute, qs: string, text: string): native.MediaRequest | undefined throws SyntaxError {
  const cache = nr.kind.startsWith("vertex.cache.")
  let base = ""
  if (cache) base = try cloud.vertexCacheUrl(t)
  else base = try cloud.vertexLocation(t) + "/batchPredictionJobs"
  const item = nr.id === "" ? "" : "/" + nr.id
  const q = qs === "" ? "" : "?" + qs
  let method = "GET"
  let url = base + q
  let body: string | undefined = undefined
  if (nr.kind.endsWith(".create")) {
    method = "POST"
    url = base
    body = text
  } else if (nr.kind.endsWith(".list")) {
    method = "GET"
  } else if (nr.kind.endsWith(".get")) {
    url = base + item
  } else if (nr.kind.endsWith(".delete")) {
    method = "DELETE"
    url = base + item
  } else if (nr.kind === "vertex.cancel") {
    method = "POST"
    url = base + item + ":cancel"
    body = "{}"
  } else if (nr.kind === "vertex.cache.update") {
    method = "PATCH"
    url = base + item + q
    body = text
  } else return undefined
  let hs = headers([["authorization", "Bearer " + token]])
  if (body !== undefined) hs.set("content-type", "application/json")
  addExtraHeaders(&hs, t.cfg)
  return { method: method, url: url, headers: hs, body: body }
}

// POST /v1/realtime with a WebRTC SDP offer (Bifrost accepts it at the base path as well as at
// /realtime/calls). The model is the session's (the multipart "session" field, or ?model=), and it picks
// the provider; the call goes up as /v1/realtime/calls of that provider with the model's bare name.
export async function realtimeSdp(cfg: Config, req: Request): Promise<Response> throws TypeError {
  const url = try new URL(req.url)
  const sp = new URLSearchParams(url.search)
  const ct = req.headers.get("content-type") ?? ""
  let model = sp.get("model") ?? ""
  let form: FormData | undefined = undefined
  let sdp = ""
  let session = ""
  try {
    if (ct.includes("multipart/form-data")) {
      const fd = try await req.formData()
      form = fd
      const s = fd.get("session")
      if (typeof s === "string") {
        session = s
        if (model === "") model = rawStr(try fields(s), "model") ?? ""
      }
    } else {
      sdp = try await req.text()
    }
  } catch (e) {
    return errorReply(400, `invalid request body: ${e.message}`, "invalid_request_error")
  }
  if (model === "") return errorReply(400, "session.model is required", "invalid_request_error")
  const mt = modelTarget(cfg, model)
  if (mt === undefined) return errorReply(404, `no provider or key serves model "${model}"`, "invalid_request_error")
  if (!supported(mt.kind)) return errorReply(400, `provider "${mt.provider}" does not support realtime calls`, "invalid_request_error")
  sp.delete("provider")
  sp.set("model", mt.model)
  const origin = url.origin
  const hs: Map<string, string> = snapshot(req.headers)
  hs.set("x-bf-provider", mt.provider)
  let next: Request
  try {
    if (form !== undefined) {
      // the session with its model replaced by the bare name (Bifrost strips the provider prefix)
      const newSession = session === "" ? "" : try rewriteJsonModel(session, mt.model)
      const out = new FormData()
      form.forEach((value, key) => {
        if (key === "session" && typeof value === "string") out.append(key, newSession === "" ? value : newSession)
        else out.append(key, value)
      })
      hs.delete("content-type")
      next = new Request(origin + "/v1/realtime/calls?" + sp.toString(), { method: "POST", headers: hs, body: out })
    } else {
      next = new Request(origin + "/v1/realtime/calls?" + sp.toString(), { method: "POST", headers: hs, body: sdp })
    }
  } catch (e) {
    return errorReply(400, `invalid session: ${e.message}`, "invalid_request_error")
  }
  const route = matchRoute("POST", "/v1/realtime/calls") ?? { op: "realtime.calls", method: "POST", upstreamPath: "/realtime/calls", modelIn: "none" }
  return try await handleMedia(cfg, next, route)
}

// ---- Anthropic and Gemini ----
// Their answers are converted to OpenAI's shapes (media_native.tov builds the
// requests). An upstream error comes back as the upstream sent it.

// Batch output files have the ids "raiju-batch-output-<batch id>".
const OUTPUT_PREFIX = "raiju-batch-output-"

// Gateway-side copies of uploaded files, by the id the upstream returned. Anthropic
// and Gemini do not serve an upload's bytes back, but a batch reads its input from
// here. Kept in memory: a restart forgets them, and only the newest UPLOAD_CAP stay.
const UPLOAD_CAP = 256
const uploads: Map<string, string> = new Map()
const uploadOrder: string[] = []
// The model of each batch made here, which its results are converted with.
const batchModels: Map<string, string> = new Map()

function isNative(kind: string): bool {
  return kind === "anthropic" || kind === "gemini" || kind === "vertex" || kind === "bedrock"
}

function remember(id: string, content: string): void {
  if (id === "") return
  if (!uploads.has(id)) uploadOrder.push(id)
  uploads.set(id, content)
  while (uploadOrder.length > UPLOAD_CAP) {
    const old = uploadOrder.shift() ?? ""
    uploads.delete(old)
  }
}

function jsonReply(body: string): Response {
  return new Response(body, { headers: { "content-type": "application/json" } })
}

function jsonlReply(body: string): Response {
  return new Response(body, { headers: { "content-type": "application/x-jsonl" } })
}

// The last part of a slash path: "batches/abc" gives "abc".
function lastPart(s: string): string {
  const parts = s.split("/")
  return parts[parts.length - 1] ?? ""
}

// The id in a route's path: "/files/{id}/content" and "/batches/{id}" both give it.
function routeId(route: MediaRoute): string {
  const parts = route.upstreamPath.split("/")
  return cloud.pctDecode(parts[2] ?? "")
}

// The model of the first request in a batch input file, without its provider prefix.
function firstModel(jsonl: string): string throws SyntaxError {
  const line = jsonl.split("\n")[0] ?? ""
  const body = try fields(find(try fields(line), "body") ?? "{}")
  return lastPart(rawStr(body, "model") ?? "")
}

// The results file a finished Gemini batch names, or "" when its results are inline.
function responsesFileOf(raw: string): string throws SyntaxError {
  const fs = try fields(raw)
  const file = rawStr(try fields(find(fs, "response") ?? "{}"), "responsesFile") ?? ""
  if (file !== "") return file
  return rawStr(try fields(find(fs, "dest") ?? "{}"), "fileName") ?? ""
}

// The uploaded file of a files.create form, or undefined when there is none.
function filePart(form: FormData | undefined): File | undefined {
  if (form === undefined) return undefined
  const f = form.get("file") ?? undefined
  if (f === undefined || typeof f === "string") return undefined
  return f
}

// Serves a media, file or batch call for an Anthropic, Gemini, Vertex or Bedrock provider.
async function nativeMedia(t: Target, route: MediaRoute, qs: string, text: string, form: FormData | undefined): Promise<Response> {
  try {
    if (t.kind === "anthropic") return await anthropicMedia(t, route, qs, text, form)
    if (t.kind === "vertex") return await vertexMedia(t, route, qs, text, form)
    if (t.kind === "bedrock") return await bedrockMedia(t, route, qs, text, form)
    return await geminiMedia(t, route, qs, text, form)
  } catch (e) {
    return errorReply(502, `${t.provider} answer could not be converted: ${e.message}`, "api_error")
  }
}

// A form field's text, or "" when it is absent or a file.
function formText(form: FormData | undefined, key: string): string {
  if (form === undefined) return ""
  const v = form.get(key)
  return typeof v === "string" ? v : ""
}

// A form field's integer, undefined when absent. A value that is not an integer is a SyntaxError.
function formInt(form: FormData, key: string): int | undefined throws SyntaxError {
  const s = formText(form, key)
  if (s === "") return undefined
  const v = parseInt(s)
  if (v === undefined) throw new SyntaxError(`${key} must be an integer`)
  return v
}

// A form field's number, undefined when absent. A value that is not a number is a SyntaxError.
function formNum(form: FormData, key: string): f64 | undefined throws SyntaxError {
  const s = formText(form, key)
  if (s === "") return undefined
  const v = parseFloat(s)
  if (v === undefined) throw new SyntaxError(`${key} must be a number`)
  return v
}

// The file under a form key, or undefined.
function formFile(form: FormData, key: string): File | undefined {
  const f = form.get(key) ?? undefined
  if (f === undefined || typeof f === "string") return undefined
  return f
}

// The files under a form key, in the order sent (the image[] key, then image when image[] is absent,
// as Bifrost reads them).
function formFiles(form: FormData, key: string): File[] {
  const out: File[] = []
  form.forEach((value, k) => {
    if (k === key && typeof value !== "string") out.push(value)
  })
  return out
}

// The images of an images/edits or images/variations form, as bytes.
async function imageBytes(form: FormData): Promise<u8[][]> throws TypeError {
  let files = formFiles(form, "image[]")
  if (files.length === 0) files = formFiles(form, "image")
  const out: u8[][] = []
  for (const f of files) out.push(try await f.bytes())
  return out
}

// An images/edits form for the native builders: the images, the mask and the options.
async function readEdit(form: FormData): Promise<native.EditInput> throws SyntaxError | TypeError {
  const images = try await imageBytes(form)
  const m = formFile(form, "mask")
  let mask: u8[] | undefined = undefined
  if (m !== undefined) mask = try await m.bytes()
  return {
    prompt: formText(form, "prompt"),
    images: images,
    mask: mask,
    n: try formInt(form, "n"),
    size: formText(form, "size"),
    editType: formText(form, "type"),
    outputFormat: formText(form, "output_format"),
    compression: try formInt(form, "output_compression"),
    quality: formText(form, "quality"),
    negative: formText(form, "negative_prompt"),
    seed: try formInt(form, "seed"),
    maskPrompt: formText(form, "mask_prompt"),
  }
}

// An images/variations form for Bedrock: the images (the first is the primary one) and the values
// Bifrost takes from the form (prompt, negativeText, similarityStrength, cfgScale, quality, n, size).
async function readVariation(form: FormData): Promise<native.VariationInput> throws SyntaxError | TypeError {
  return {
    images: try await imageBytes(form),
    prompt: formText(form, "prompt"),
    negative: formText(form, "negativeText"),
    similarity: try formNum(form, "similarityStrength"),
    n: try formInt(form, "n"),
    size: formText(form, "size"),
    quality: formText(form, "quality"),
    cfgScale: try formNum(form, "cfgScale"),
  }
}

// Sends an image request on a native provider and converts the answer to OpenAI's images body:
// Imagen's predictions or a Gemini image model's inline data (by the model name), or Bedrock's images.
async function imageReply(t: Target, mr: native.MediaRequest, bedrockAnswer: bool): Promise<Response> throws SyntaxError | Error {
  const up = await send(t, mr)
  if (!up.ok) return up
  const raw = try await up.text()
  if (bedrockAnswer) return jsonReply(try cloud.bedrockImagesToOpenAI(raw))
  if (t.model.toLowerCase().includes("imagen")) return jsonReply(try native.imagenToOpenAI(raw))
  return jsonReply(try native.geminiImageToOpenAI(raw))
}

// A GET to the upstream URL of a route, with the provider's auth.
function getRequest(t: Target, route: MediaRoute): native.MediaRequest {
  return { method: "GET", url: upstreamUrl(t, route, ""), headers: authHeaders(t), body: undefined }
}

// GET /v1/batches/{id}/results for an OpenAI-format provider or Azure: the batch's
// output file, as Bifrost's results body.
async function openaiBatchResults(t: Target, bid: string): Promise<Response> throws SyntaxError | Error {
  const got = await send(t, getRequest(t, { op: "batches.retrieve", method: "GET", upstreamPath: "/batches/" + bid, modelIn: "none" }))
  if (!got.ok) return got
  const outId = rawStr(try fields(try await got.text()), "output_file_id") ?? ""
  if (outId === "") return errorReply(400, `batch results not available: output_file_id is empty (batch ${bid} may not be completed)`, "invalid_request_error")
  const res = await send(t, getRequest(t, { op: "files.content", method: "GET", upstreamPath: "/files/" + outId + "/content", modelIn: "none" }))
  if (!res.ok) return res
  return jsonReply(try native.batchResultsDoc(bid, try await res.text()))
}

// The bearer token for a Vertex call: the cached one for its service account, else a
// new one from its token endpoint (as gateway.tov's vertexToken fetches it).
export async function vertexBearer(t: Target): Promise<string> throws SyntaxError | Error {
  const sa = try parseServiceAccount(t.key.vertex_key_config?.auth_credentials)
  const now = Math.floor(Date.now() / 1000)
  const cached = cloud.VERTEX_TOKENS.get(sa.client_email, now)
  if (cached !== undefined) return cached
  const up = try cloud.VERTEX_TOKENS.tokenRequest(sa, now)
  const hs: Record<string, string> = up.headers
  const dl = deadline(10000)
  let text = ""
  try {
    const res = try await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal, proxy: proxyOf(t.cfg), tls: tlsOf(t.cfg) })
    text = try await res.text()
  } catch (e) {
    dl.finish()
    throw e
  }
  dl.finish()
  try cloud.VERTEX_TOKENS.store(sa.client_email, text, now)
  return cloud.VERTEX_TOKENS.get(sa.client_email, now) ?? ""
}

// Vertex's files are Cloud Storage objects (gs://bucket/object) and its batches are Batch
// Prediction jobs. A batch's input is read from its bucket, converted to Vertex's instances and
// written beside it; the job writes its predictions under output_folder. gcs_bucket and
// gcs_prefix name the bucket of a new file or of a listing.
async function vertexStore(t: Target, route: MediaRoute, qs: string, text: string, form: FormData | undefined): Promise<Response> throws SyntaxError | Error {
  const id = routeId(route)
  const sp = new URLSearchParams(qs)
  try {
    const base = try cloud.vertexLocation(t)
    if (base === "") return errorReply(400, "vertex: batch jobs need a location", "invalid_request_error")
  } catch (e) {
    return errorReply(400, e.message, "invalid_request_error")
  }
  let token = ""
  try {
    token = try await vertexBearer(t)
  } catch (e) {
    return errorReply(502, `vertex authentication failed: ${e.message}`, "authentication_error")
  }
  if (route.op === "files.create") {
    const f = filePart(form)
    if (f === undefined) return errorReply(400, "the request needs a \"file\" part", "invalid_request_error")
    const bucket = formText(form, "gcs_bucket")
    if (bucket === "") return errorReply(400, "gcs_bucket is required to store a Vertex file", "invalid_request_error")
    const name = cloud.gcsObjectName(formText(form, "gcs_prefix"), f.name)
    const up = await send(t, cloud.gcsUpload(t, token, bucket, name, try await f.text(), "application/jsonl"))
    if (!up.ok) return up
    return jsonReply(try cloud.gcsFileToOpenAI(try await up.text(), bucket))
  }
  if (route.op === "files.list") {
    const bucket = sp.get("gcs_bucket") ?? ""
    if (bucket === "") return errorReply(400, "gcs_bucket is required to list Vertex files", "invalid_request_error")
    const up = await send(t, cloud.gcsList(t, token, bucket, sp.get("gcs_prefix") ?? "", sp.get("limit") ?? "", sp.get("after") ?? ""))
    if (!up.ok) return up
    return jsonReply(try cloud.gcsFileListToOpenAI(try await up.text(), bucket))
  }
  if (route.op === "files.content" && id.startsWith(OUTPUT_PREFIX)) return try await vertexBatchOutput(t, token, id.slice(OUTPUT_PREFIX.byteLength))
  if (route.op === "files.retrieve" || route.op === "files.delete" || route.op === "files.content") {
    let loc = { bucket: "", key: "" }
    try {
      loc = try cloud.gsParse(id)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (route.op === "files.content") return await send(t, cloud.gcsObject(t, token, loc.bucket, loc.key, "GET", true))
    if (route.op === "files.delete") {
      const del = await send(t, cloud.gcsObject(t, token, loc.bucket, loc.key, "DELETE", false))
      if (!del.ok) return del
      return jsonReply(cloud.deletedToOpenAI(id))
    }
    const meta = await send(t, cloud.gcsObject(t, token, loc.bucket, loc.key, "GET", false))
    if (!meta.ok) return meta
    return jsonReply(try cloud.gcsFileToOpenAI(try await meta.text(), loc.bucket))
  }
  if (route.op === "batches.create") return try await vertexBatchCreate(t, token, text)
  if (route.op === "batches.list") {
    const up = await send(t, try cloud.vertexJobList(t, token, sp.get("limit") ?? "", sp.get("after") ?? ""))
    if (!up.ok) return up
    return jsonReply(try cloud.vertexJobListToOpenAI(try await up.text()))
  }
  if (route.op === "batches.retrieve") {
    const up = await send(t, try cloud.vertexJobGet(t, token, id))
    if (!up.ok) return up
    return jsonReply(try cloud.vertexJobToOpenAI(try await up.text(), OUTPUT_PREFIX + id))
  }
  if (route.op === "batches.cancel") {
    const cancel = await send(t, try cloud.vertexJobCancel(t, token, id))
    if (!cancel.ok) return cancel
    const up = await send(t, try cloud.vertexJobGet(t, token, id))
    if (!up.ok) return up
    return jsonReply(try cloud.vertexJobToOpenAI(try await up.text(), OUTPUT_PREFIX + id))
  }
  if (route.op === "batches.results") {
    const out = try await vertexBatchOutput(t, token, id)
    if (!out.ok) return out
    return jsonReply(try native.batchResultsDoc(id, try await out.text()))
  }
  return errorReply(400, `provider "${t.provider}" does not support ${route.op}`, "invalid_request_error")
}

// POST /v1/batches on Vertex: the input file's lines become Vertex instances, which are written to
// the input's bucket, and a Batch Prediction job reads them and writes to output_folder.
async function vertexBatchCreate(t: Target, token: string, text: string): Promise<Response> throws SyntaxError | Error {
  let fs: Field[] = []
  try {
    fs = try fields(text)
  } catch (e) {
    return errorReply(400, "the request body must be a JSON object", "invalid_request_error")
  }
  let inLoc = { bucket: "", key: "" }
  try {
    inLoc = try cloud.gsParse(rawStr(fs, "input_file_id") ?? "")
  } catch (e) {
    return errorReply(400, `input_file_id must be a gs:// file: ${e.message}`, "invalid_request_error")
  }
  const outputUri = rawStr(try fields(find(fs, "output_folder") ?? "{}"), "url") ?? ""
  if (outputUri === "") return errorReply(400, "output_folder.url (a gs:// prefix) is required", "invalid_request_error")
  try {
    const checked = try cloud.gsParse(outputUri)
    if (checked.bucket === "") return errorReply(400, "output_folder.url must be a gs:// prefix", "invalid_request_error")
  } catch (e) {
    return errorReply(400, `output_folder.url must be a gs:// prefix: ${e.message}`, "invalid_request_error")
  }
  const got = await send(t, cloud.gcsObject(t, token, inLoc.bucket, inLoc.key, "GET", true))
  if (!got.ok) return got
  const jsonl = try await got.text()
  let model = ""
  let instances = ""
  try {
    model = try firstModel(jsonl)
    instances = try cloud.vertexInstances(jsonl, "")
  } catch (e) {
    return errorReply(400, e.message, "invalid_request_error")
  }
  if (model === "") return errorReply(400, "the batch input has no model", "invalid_request_error")
  const inName = cloud.vertexInputName()
  const put = await send(t, cloud.gcsUpload(t, token, inLoc.bucket, inName, instances, "application/jsonl"))
  if (!put.ok) return put
  const mr = try cloud.vertexJobCreate(t, token, cloud.jobName(rawStr(fs, "display_name") ?? ""), model, "gs://" + inLoc.bucket + "/" + inName, outputUri)
  const up = await send(t, mr)
  if (!up.ok) return up
  const created = try await up.text()
  const bid = lastPart(rawStr(try fields(created), "name") ?? "")
  batchModels.set(bid, model)
  return jsonReply(try cloud.vertexJobToOpenAI(created, OUTPUT_PREFIX + bid))
}

// The OpenAI output lines of a finished Vertex job: its prediction files, read in order.
async function vertexBatchOutput(t: Target, token: string, bid: string): Promise<Response> throws SyntaxError | Error {
  const got = await send(t, try cloud.vertexJobGet(t, token, bid))
  if (!got.ok) return got
  const raw = try await got.text()
  const ended = try cloud.vertexJobEnded(raw)
  if (!ended) return errorReply(400, `batch ${bid} has not ended`, "invalid_request_error")
  const dir = try cloud.gsParse(try cloud.vertexOutputDir(raw))
  let model = batchModels.get(bid) ?? ""
  if (model === "") model = lastPart(rawStr(try fields(raw), "model") ?? "")
  const prefix = dir.key === "" || dir.key.endsWith("/") ? dir.key : dir.key + "/"
  const lst = await send(t, cloud.gcsList(t, token, dir.bucket, prefix, "", ""))
  if (!lst.ok) return lst
  let all = ""
  for (const name of try cloud.gcsNames(try await lst.text())) {
    if (!cloud.predictionName(name)) continue
    const part = await send(t, cloud.gcsObject(t, token, dir.bucket, name, "GET", true))
    if (!part.ok) return part
    all += (try await part.text()) + "\n"
  }
  return jsonlReply(try cloud.vertexResultsToOpenAI(all, model))
}

// The Bedrock credentials of a key: its static keys, or temporary ones from AssumeRole when
// the key has a role_arn (cached until they near expiry).
async function bedrockCreds(t: Target): Promise<S3Creds> throws SyntaxError | Error {
  const bk = t.key.bedrock_key_config
  if (bk === undefined) throw new SyntaxError("bedrock: key has no bedrock_key_config")
  const base = try cloud.staticCreds(bk)
  const role = bk.role_arn ?? ""
  if (role === "") return base
  const session = bk.session_name ?? "bifrost-session"
  const key = role + "|" + (bk.external_id ?? "") + "|" + session
  const now = Date.now()
  const cached = cloud.STS_CREDS.get(key, now)
  if (cached !== undefined) return cloud.assumedCreds(cached, base.region)
  const up = try cloudAuth.assumeRoleRequest({ accessKey: base.accessKey, secretKey: base.secretKey, sessionToken: base.sessionToken }, base.region, role, bk.external_id, session, 3600, now)
  const hs: Record<string, string> = up.headers
  const dl = deadline(10000)
  let text = ""
  try {
    const res = try await fetch(up.url, { method: "POST", headers: hs, body: up.body, signal: dl.controller.signal, proxy: proxyOf(t.cfg), tls: tlsOf(t.cfg) })
    text = try await res.text()
  } catch (e) {
    dl.finish()
    throw e
  }
  dl.finish()
  const creds = try cloudAuth.parseAssumeRole(text)
  cloud.STS_CREDS.put(key, creds, creds.expiresAtMs)
  return cloud.assumedCreds(creds, base.region)
}

// Bedrock's files are S3 objects (s3://bucket/key) and its batches are model invocation jobs
// that read a converted input from S3 and write results under output_s3_uri. s3_bucket and
// s3_prefix name the bucket of a new file or a listing; the key's batch bucket is the default.
async function bedrockStore(t: Target, route: MediaRoute, qs: string, text: string, form: FormData | undefined): Promise<Response> throws SyntaxError | Error {
  const id = routeId(route)
  const sp = new URLSearchParams(qs)
  let c: S3Creds = { accessKey: "", secretKey: "", region: "" }
  try {
    c = try await bedrockCreds(t)
  } catch (e) {
    return errorReply(502, `bedrock authentication failed: ${e.message}`, "authentication_error")
  }
  const bk = t.key.bedrock_key_config
  const def = bk === undefined ? undefined : cloud.batchBucket(bk)
  const endpoint = cloud.s3Endpoint(t)
  const origin = cloud.bedrockOrigin(t, "bedrock", c.region)
  const now = Date.now()
  if (route.op === "files.create") {
    const f = filePart(form)
    if (f === undefined) return errorReply(400, "the request needs a \"file\" part", "invalid_request_error")
    let bucket = formText(form, "s3_bucket")
    let prefix = formText(form, "s3_prefix")
    if (bucket === "" && def !== undefined) {
      bucket = def.bucket
      if (prefix === "") prefix = def.prefix
    }
    if (bucket === "") return errorReply(400, "s3_bucket is required to store a Bedrock file", "invalid_request_error")
    const body = try await f.text()
    const key = cloud.s3KeyFor(prefix, f.name)
    const up = await send(t, cloud.s3Object(c, endpoint, bucket, key, "PUT", body, "application/jsonl", now))
    if (!up.ok) return up
    return jsonReply(cloud.s3FileToOpenAI(bucket, key, body.byteLength, now / 1000.0))
  }
  if (route.op === "files.list") {
    let bucket = sp.get("s3_bucket") ?? ""
    let prefix = sp.get("s3_prefix") ?? ""
    if (bucket === "" && def !== undefined) {
      bucket = def.bucket
      if (prefix === "") prefix = def.prefix
    }
    if (bucket === "") return errorReply(400, "s3_bucket is required to list Bedrock files", "invalid_request_error")
    const up = await send(t, cloud.s3List(c, endpoint, bucket, prefix, sp.get("after") ?? "", sp.get("limit") ?? "", now))
    if (!up.ok) return up
    return jsonReply(cloud.s3ListToOpenAI(try await up.text(), bucket))
  }
  if (route.op === "files.content" && id.startsWith(OUTPUT_PREFIX)) return try await bedrockBatchOutput(t, c, id.slice(OUTPUT_PREFIX.byteLength))
  if (route.op === "files.retrieve" || route.op === "files.delete" || route.op === "files.content") {
    let loc = { bucket: "", key: "" }
    try {
      loc = try cloud.s3Parse(id)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (route.op === "files.content") return await send(t, cloud.s3Object(c, endpoint, loc.bucket, loc.key, "GET", "", "", now))
    if (route.op === "files.delete") {
      const del = await send(t, cloud.s3Object(c, endpoint, loc.bucket, loc.key, "DELETE", "", "", now))
      if (!del.ok) return del
      return jsonReply(cloud.deletedToOpenAI(id))
    }
    const up = await send(t, cloud.s3List(c, endpoint, loc.bucket, loc.key, "", "", now))
    if (!up.ok) return up
    const found = cloud.s3FileFromList(try await up.text(), loc.bucket, loc.key)
    if (found === undefined) return errorReply(404, `no such file ${id}`, "invalid_request_error")
    return jsonReply(found)
  }
  if (route.op === "batches.create") return try await bedrockBatchCreate(t, c, def, text)
  if (route.op === "batches.list") {
    const up = await send(t, cloud.bedrockJobList(origin, c, sp.get("limit") ?? "", sp.get("after") ?? "", now))
    if (!up.ok) return up
    return jsonReply(try cloud.bedrockJobListToOpenAI(try await up.text()))
  }
  if (route.op === "batches.retrieve") {
    const up = await send(t, cloud.bedrockJobGet(origin, c, id, now))
    if (!up.ok) return up
    return jsonReply(try cloud.bedrockJobToOpenAI(try await up.text(), OUTPUT_PREFIX + id))
  }
  if (route.op === "batches.cancel") {
    const stop = await send(t, cloud.bedrockJobStop(origin, c, id, now))
    if (!stop.ok) return stop
    const up = await send(t, cloud.bedrockJobGet(origin, c, id, now))
    if (!up.ok) return up
    return jsonReply(try cloud.bedrockJobToOpenAI(try await up.text(), OUTPUT_PREFIX + id))
  }
  if (route.op === "batches.results") {
    const out = try await bedrockBatchOutput(t, c, id)
    if (!out.ok) return out
    return jsonReply(try native.batchResultsDoc(id, try await out.text()))
  }
  return errorReply(400, `provider "${t.provider}" does not support ${route.op}`, "invalid_request_error")
}

// POST /v1/batches on Bedrock: the input file's lines become Bedrock records, written to the
// input's bucket, and a model invocation job reads them and writes under output_s3_uri (or
// the key's default batch bucket). The job's role is batch_role_arn, else the request's role_arn.
async function bedrockBatchCreate(t: Target, c: S3Creds, def: { bucket: string, prefix: string } | undefined, text: string): Promise<Response> throws SyntaxError | Error {
  let fs: Field[] = []
  try {
    fs = try fields(text)
  } catch (e) {
    return errorReply(400, "the request body must be a JSON object", "invalid_request_error")
  }
  let inLoc = { bucket: "", key: "" }
  try {
    inLoc = try cloud.s3Parse(rawStr(fs, "input_file_id") ?? "")
  } catch (e) {
    return errorReply(400, `input_file_id must be an s3:// file: ${e.message}`, "invalid_request_error")
  }
  const endpoint = cloud.s3Endpoint(t)
  const now = Date.now()
  const got = await send(t, cloud.s3Object(c, endpoint, inLoc.bucket, inLoc.key, "GET", "", "", now))
  if (!got.ok) return got
  const jsonl = try await got.text()
  let model = ""
  let records = ""
  try {
    model = try firstModel(jsonl)
    records = try cloud.bedrockInputJsonl(jsonl, "")
  } catch (e) {
    return errorReply(400, e.message, "invalid_request_error")
  }
  if (model === "") return errorReply(400, "the batch input has no model", "invalid_request_error")
  let outputUri = rawStr(fs, "output_s3_uri") ?? ""
  if (outputUri === "" && def !== undefined) outputUri = cloud.defaultOutputUri(def.bucket, def.prefix)
  if (outputUri === "") return errorReply(400, "output_s3_uri is required (or a default batch bucket in the key)", "invalid_request_error")
  try {
    const checked = try cloud.s3Parse(outputUri)
    if (checked.bucket === "") return errorReply(400, "output_s3_uri must be an s3:// prefix", "invalid_request_error")
  } catch (e) {
    return errorReply(400, `output_s3_uri must be an s3:// prefix: ${e.message}`, "invalid_request_error")
  }
  const bk = t.key.bedrock_key_config
  const role = cloud.bedrockRole(bk?.batch_role_arn, rawStr(fs, "role_arn") ?? "", bk?.role_arn)
  if (role === "") return errorReply(400, "role_arn is required for Bedrock batch jobs (or batch_role_arn in the key)", "invalid_request_error")
  const inKey = cloud.bedrockInputName()
  const put = await send(t, cloud.s3Object(c, endpoint, inLoc.bucket, inKey, "PUT", records, "application/jsonl", now))
  if (!put.ok) return put
  const jobIn = rawStr(try fields(find(fs, "metadata") ?? "{}"), "job_name") ?? ""
  const origin = cloud.bedrockOrigin(t, "bedrock", c.region)
  const job = { name: cloud.jobName(jobIn), model: model, role: role, inputUri: "s3://" + inLoc.bucket + "/" + inKey, outputUri: outputUri, hours: cloud.windowHours(rawStr(fs, "completion_window") ?? "24h") }
  const created = await send(t, cloud.bedrockJobCreate(origin, c, job, now))
  if (!created.ok) return created
  const bid = lastPart(rawStr(try fields(try await created.text()), "jobArn") ?? "")
  batchModels.set(bid, model)
  const back = await send(t, cloud.bedrockJobGet(origin, c, bid, now))
  if (!back.ok) return back
  return jsonReply(try cloud.bedrockJobToOpenAI(try await back.text(), OUTPUT_PREFIX + bid))
}

// The OpenAI output lines of a finished Bedrock job: the .jsonl.out files under its output
// location (those named for the job first), converted record by record.
async function bedrockBatchOutput(t: Target, c: S3Creds, bid: string): Promise<Response> throws SyntaxError | Error {
  const endpoint = cloud.s3Endpoint(t)
  const origin = cloud.bedrockOrigin(t, "bedrock", c.region)
  const now = Date.now()
  const got = await send(t, cloud.bedrockJobGet(origin, c, bid, now))
  if (!got.ok) return got
  const raw = try await got.text()
  const ended = try cloud.bedrockJobEnded(raw)
  if (!ended) return errorReply(400, `batch ${bid} has not ended`, "invalid_request_error")
  const outUri = try cloud.bedrockOutputUri(raw)
  if (outUri === "") return errorReply(400, `batch ${bid} has no output location`, "invalid_request_error")
  const loc = try cloud.s3Parse(outUri)
  const lst = await send(t, cloud.s3List(c, endpoint, loc.bucket, loc.key, "", "", now))
  if (!lst.ok) return lst
  const keys = cloud.s3Keys(try await lst.text())
  const mine: string[] = []
  for (const k of keys) {
    if (k.endsWith(".jsonl.out") && k.includes(bid)) mine.push(k)
  }
  if (mine.length === 0) {
    for (const k of keys) {
      if (k.endsWith(".jsonl.out")) mine.push(k)
    }
  }
  let all = ""
  for (const k of mine) {
    const part = await send(t, cloud.s3Object(c, endpoint, loc.bucket, k, "GET", "", "", now))
    if (!part.ok) return part
    all += (try await part.text()) + "\n"
  }
  let model = batchModels.get(bid) ?? ""
  if (model === "") model = try cloud.bedrockJobModel(raw)
  return jsonlReply(try cloud.bedrockResultsToOpenAI(all, model))
}

// Vertex: image generation and edits here, and its files and batches (vertexStore).
async function vertexMedia(t: Target, route: MediaRoute, qs: string, text: string, form: FormData | undefined): Promise<Response> throws SyntaxError | Error {
  if (route.op.startsWith("files.") || route.op.startsWith("batches.")) return try await vertexStore(t, route, qs, text, form)
  if (route.op === "images.edits") return try await vertexEdit(t, form)
  if (route.op !== "images.generations") return errorReply(400, `provider "${t.provider}" does not support ${route.op}`, "invalid_request_error")
  const fs = try fields(text)
  if ((rawStr(fs, "prompt") ?? "") === "") return errorReply(400, "the request needs a prompt", "invalid_request_error")
  let token = ""
  try {
    token = try await vertexBearer(t)
  } catch (e) {
    return errorReply(502, `vertex authentication failed: ${e.message}`, "authentication_error")
  }
  let mr: native.MediaRequest | undefined = undefined
  try {
    mr = try cloud.vertexImage(t, fs, token)
  } catch (e) {
    return errorReply(400, e.message, "invalid_request_error")
  }
  if (mr === undefined) return errorReply(400, "the request could not be built", "invalid_request_error")
  const up = await send(t, mr)
  if (!up.ok) return up
  const raw = try await up.text()
  if (t.model.toLowerCase().includes("imagen")) return jsonReply(try native.imagenToOpenAI(raw))
  return jsonReply(try native.geminiImageToOpenAI(raw))
}

// Vertex's image edit: the form read, then the Gemini or Imagen body on the publisher path with the bearer token.
async function vertexEdit(t: Target, form: FormData | undefined): Promise<Response> throws SyntaxError | Error {
  if (form === undefined) return errorReply(400, "the request needs image files", "invalid_request_error")
  let ed: native.EditInput | undefined = undefined
  try {
    ed = try await readEdit(form)
  } catch (e) {
    return errorReply(400, e.message, "invalid_request_error")
  }
  if (ed === undefined) return errorReply(400, "the request needs image files", "invalid_request_error")
  let token = ""
  try {
    token = try await vertexBearer(t)
  } catch (e) {
    return errorReply(502, `vertex authentication failed: ${e.message}`, "authentication_error")
  }
  let mr: native.MediaRequest | undefined = undefined
  try {
    mr = try cloud.vertexImageEdit(t, ed, token)
  } catch (e) {
    return errorReply(400, e.message, "invalid_request_error")
  }
  if (mr === undefined) return errorReply(400, "the request could not be built", "invalid_request_error")
  return try await imageReply(t, mr, false)
}

// Bedrock: image generation, edits and variations here (InvokeModel), and its files and batches (bedrockStore).
async function bedrockMedia(t: Target, route: MediaRoute, qs: string, text: string, form: FormData | undefined): Promise<Response> throws SyntaxError | Error {
  if (route.op.startsWith("files.") || route.op.startsWith("batches.")) return try await bedrockStore(t, route, qs, text, form)
  if (route.op === "images.edits" || route.op === "images.variations") return try await bedrockImageForm(t, route, form)
  if (route.op !== "images.generations") return errorReply(400, `provider "${t.provider}" does not support ${route.op}`, "invalid_request_error")
  let mr: native.MediaRequest | undefined = undefined
  try {
    mr = try cloud.bedrockImage(t, try fields(text))
  } catch (e) {
    return errorReply(400, e.message, "invalid_request_error")
  }
  if (mr === undefined) return errorReply(400, "the request could not be built", "invalid_request_error")
  return try await imageReply(t, mr, true)
}

// Bedrock's image edit (inpainting, outpainting, background removal) or variation: the form read, then
// the InvokeModel request built and its answer converted.
async function bedrockImageForm(t: Target, route: MediaRoute, form: FormData | undefined): Promise<Response> throws SyntaxError | Error {
  if (form === undefined) return errorReply(400, "the request needs image files", "invalid_request_error")
  let mr: native.MediaRequest | undefined = undefined
  if (route.op === "images.edits") {
    let ed: native.EditInput | undefined = undefined
    try {
      ed = try await readEdit(form)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (ed === undefined) return errorReply(400, "the request needs image files", "invalid_request_error")
    try {
      mr = try cloud.bedrockImageEdit(t, ed)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
  } else {
    let v: native.VariationInput | undefined = undefined
    try {
      v = try await readVariation(form)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (v === undefined) return errorReply(400, "the request needs image files", "invalid_request_error")
    try {
      mr = try cloud.bedrockImageVariation(t, v)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
  }
  if (mr === undefined) return errorReply(400, "the request could not be built", "invalid_request_error")
  return try await imageReply(t, mr, true)
}

async function anthropicMedia(t: Target, route: MediaRoute, qs: string, text: string, form: FormData | undefined): Promise<Response> throws SyntaxError | Error {
  const id = routeId(route)
  if (route.op === "files.create") {
    const f = filePart(form)
    if (f === undefined) return errorReply(400, "the request needs a \"file\" part", "invalid_request_error")
    const up = await send(t, native.anthropicFileUpload(t, f))
    if (!up.ok) return up
    const meta = try native.anthropicFileToOpenAI(try await up.text())
    remember(rawStr(try fields(meta), "id") ?? "", try await f.text())
    return jsonReply(meta)
  }
  if (route.op === "files.list") {
    const up = await send(t, native.anthropicFileList(t, qs))
    if (!up.ok) return up
    return jsonReply(try native.anthropicFileListToOpenAI(try await up.text()))
  }
  if (route.op === "files.retrieve") {
    const up = await send(t, native.anthropicFileGet(t, id))
    if (!up.ok) return up
    return jsonReply(try native.anthropicFileToOpenAI(try await up.text()))
  }
  if (route.op === "files.delete") {
    const up = await send(t, native.anthropicFileDelete(t, id))
    if (!up.ok) return up
    uploads.delete(id)
    return jsonReply(try native.anthropicFileDeletedToOpenAI(try await up.text()))
  }
  if (route.op === "files.content") {
    if (id.startsWith(OUTPUT_PREFIX)) return try await anthropicBatchOutput(t, id.slice(OUTPUT_PREFIX.byteLength))
    return await send(t, native.anthropicFileContent(t, id))
  }
  if (route.op === "batches.create") {
    let input = ""
    try {
      input = rawStr(try fields(text), "input_file_id") ?? ""
    } catch (e) {
      return errorReply(400, "the request body must be a JSON object", "invalid_request_error")
    }
    const jsonl = uploads.get(input)
    if (jsonl === undefined) return errorReply(404, `no uploaded file ${input}`, "invalid_request_error")
    let mr: native.MediaRequest | undefined = undefined
    let model = ""
    try {
      mr = try native.anthropicBatchCreate(t, jsonl)
      model = try firstModel(jsonl)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (mr === undefined) return errorReply(400, "the batch input has no requests", "invalid_request_error")
    const up = await send(t, mr)
    if (!up.ok) return up
    const created = try await up.text()
    const bid = rawStr(try fields(created), "id") ?? ""
    batchModels.set(bid, model)
    return jsonReply(try native.anthropicBatchToOpenAI(created, OUTPUT_PREFIX + bid))
  }
  if (route.op === "batches.list") {
    const up = await send(t, native.anthropicBatchList(t, qs))
    if (!up.ok) return up
    return jsonReply(try native.anthropicBatchListToOpenAI(try await up.text()))
  }
  if (route.op === "batches.retrieve") {
    const up = await send(t, native.anthropicBatchGet(t, id))
    if (!up.ok) return up
    return jsonReply(try native.anthropicBatchToOpenAI(try await up.text(), OUTPUT_PREFIX + id))
  }
  if (route.op === "batches.results") {
    const out = try await anthropicBatchOutput(t, id)
    if (!out.ok) return out
    return jsonReply(try native.batchResultsDoc(id, try await out.text()))
  }
  if (route.op === "batches.cancel") {
    const up = await send(t, native.anthropicBatchCancel(t, id))
    if (!up.ok) return up
    return jsonReply(try native.anthropicBatchToOpenAI(try await up.text(), OUTPUT_PREFIX + id))
  }
  return errorReply(400, `provider "${t.provider}" does not support ${route.op}`, "invalid_request_error")
}

// The OpenAI output lines of a finished Anthropic batch.
async function anthropicBatchOutput(t: Target, bid: string): Promise<Response> throws SyntaxError | Error {
  const got = await send(t, native.anthropicBatchGet(t, bid))
  if (!got.ok) return got
  const status = rawStr(try fields(try await got.text()), "processing_status") ?? ""
  if (status !== "ended") return errorReply(400, `batch ${bid} has not ended`, "invalid_request_error")
  const res = await send(t, native.anthropicBatchResults(t, bid))
  if (!res.ok) return res
  return jsonlReply(try native.anthropicResultsToOpenAI(try await res.text(), batchModels.get(bid) ?? ""))
}

async function geminiMedia(t: Target, route: MediaRoute, qs: string, text: string, form: FormData | undefined): Promise<Response> throws SyntaxError | Error {
  const id = routeId(route)
  if (route.op === "files.create") {
    const f = filePart(form)
    if (f === undefined) return errorReply(400, "the request needs a \"file\" part", "invalid_request_error")
    const up = await send(t, native.geminiFileUpload(t, f, f.name))
    if (!up.ok) return up
    const meta = try native.geminiFileToOpenAI(try await up.text())
    remember(rawStr(try fields(meta), "id") ?? "", try await f.text())
    return jsonReply(meta)
  }
  if (route.op === "files.list") {
    const up = await send(t, native.geminiFileList(t, qs))
    if (!up.ok) return up
    return jsonReply(try native.geminiFileListToOpenAI(try await up.text()))
  }
  if (route.op === "files.retrieve") {
    const up = await send(t, native.geminiFileGet(t, id))
    if (!up.ok) return up
    return jsonReply(try native.geminiFileToOpenAI(try await up.text()))
  }
  if (route.op === "files.delete") {
    const up = await send(t, native.geminiFileDelete(t, id))
    if (!up.ok) return up
    uploads.delete(id)
    return jsonReply(native.geminiFileDeletedToOpenAI(id))
  }
  if (route.op === "files.content") {
    if (id.startsWith(OUTPUT_PREFIX)) return try await geminiBatchOutput(t, id.slice(OUTPUT_PREFIX.byteLength))
    return errorReply(400, "Gemini does not serve uploaded files; only batch output can be read", "invalid_request_error")
  }
  if (route.op === "batches.create") {
    let input = ""
    try {
      input = rawStr(try fields(text), "input_file_id") ?? ""
    } catch (e) {
      return errorReply(400, "the request body must be a JSON object", "invalid_request_error")
    }
    const jsonl = uploads.get(input)
    if (jsonl === undefined) return errorReply(404, `no uploaded file ${input}`, "invalid_request_error")
    let mr: native.MediaRequest | undefined = undefined
    let model = ""
    try {
      mr = try native.geminiBatchCreate(t, jsonl)
      model = try firstModel(jsonl)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (mr === undefined) return errorReply(400, "the batch input has no requests", "invalid_request_error")
    const up = await send(t, mr)
    if (!up.ok) return up
    const created = try await up.text()
    const bid = lastPart(rawStr(try fields(created), "name") ?? "")
    batchModels.set(bid, model)
    return jsonReply(try native.geminiBatchToOpenAI(created, OUTPUT_PREFIX + bid))
  }
  if (route.op === "batches.list") {
    const up = await send(t, native.geminiBatchList(t, qs))
    if (!up.ok) return up
    return jsonReply(try native.geminiBatchListToOpenAI(try await up.text()))
  }
  if (route.op === "batches.retrieve") {
    const up = await send(t, native.geminiBatchGet(t, id))
    if (!up.ok) return up
    return jsonReply(try native.geminiBatchToOpenAI(try await up.text(), OUTPUT_PREFIX + id))
  }
  if (route.op === "batches.results") {
    const out = try await geminiBatchOutput(t, id)
    if (!out.ok) return out
    return jsonReply(try native.batchResultsDoc(id, try await out.text()))
  }
  if (route.op === "batches.cancel") {
    const cancel = await send(t, native.geminiBatchCancel(t, id))
    if (!cancel.ok) return cancel
    const up = await send(t, native.geminiBatchGet(t, id))
    if (!up.ok) return up
    return jsonReply(try native.geminiBatchToOpenAI(try await up.text(), OUTPUT_PREFIX + id))
  }
  if (route.op === "images.generations") {
    let mr: native.MediaRequest | undefined = undefined
    try {
      mr = try native.geminiImageGeneration(t, try fields(text))
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (mr === undefined) return errorReply(400, "the request needs a prompt", "invalid_request_error")
    const up = await send(t, mr)
    if (!up.ok) return up
    const raw = try await up.text()
    if (t.model.toLowerCase().includes("imagen")) return jsonReply(try native.imagenToOpenAI(raw))
    return jsonReply(try native.geminiImageToOpenAI(raw))
  }
  if (route.op === "images.edits") {
    // Gemini's image edit: the images inline in generateContent, or Imagen's edit through :predict
    if (form === undefined) return errorReply(400, "the request needs image files", "invalid_request_error")
    let ed: native.EditInput | undefined = undefined
    try {
      ed = try await readEdit(form)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (ed === undefined) return errorReply(400, "the request needs image files", "invalid_request_error")
    let mr: native.MediaRequest | undefined = undefined
    try {
      mr = try native.geminiImageEdit(t, ed)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (mr === undefined) return errorReply(400, "the request needs image files", "invalid_request_error")
    return try await imageReply(t, mr, false)
  }
  if (route.op === "audio.transcriptions") {
    // Gemini's speech-to-text: the audio inline in generateContent (as Bifrost does)
    let format = "json"
    try {
      format = native.transcriptionFormat(formText(form, "response_format"))
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    const f = filePart(form)
    if (f === undefined) return errorReply(400, "the request needs a \"file\" part", "invalid_request_error")
    const mime = native.audioMime(f.type, f.name)
    if (mime === "") return errorReply(400, "the audio type is not one Gemini takes (wav, mp3, aiff, aac, ogg or flac)", "invalid_request_error")
    const audio = try await f.bytes()
    const up = await send(t, native.geminiTranscription(t, formText(form, "prompt"), mime, audio))
    if (!up.ok) return up
    const transcript = try native.transcriptText(try await up.text())
    if (format === "text") return new Response(transcript, { headers: { "content-type": "text/plain; charset=utf-8" } })
    return jsonReply(native.transcriptionJson(transcript))
  }
  if (route.op === "audio.speech") {
    let format = "wav"
    let mr: native.MediaRequest | undefined = undefined
    try {
      const fs = try fields(text)
      format = try native.speechFormat(fs)
      mr = try native.geminiSpeech(t, fs)
    } catch (e) {
      return errorReply(400, e.message, "invalid_request_error")
    }
    if (mr === undefined) return errorReply(400, "the request needs input", "invalid_request_error")
    const up = await send(t, mr)
    if (!up.ok) return up
    const audio = try native.geminiSpeechToAudio(try await up.text(), format)
    return new Response(audio.bytes, { headers: { "content-type": audio.contentType } })
  }
  return errorReply(400, `provider "${t.provider}" does not support ${route.op}`, "invalid_request_error")
}

// The OpenAI output lines of a finished Gemini batch: from its results file when it
// has one, else from the inline responses.
async function geminiBatchOutput(t: Target, bid: string): Promise<Response> throws SyntaxError | Error {
  const got = await send(t, native.geminiBatchGet(t, bid))
  if (!got.ok) return got
  const raw = try await got.text()
  if (find(try fields(raw), "done") !== "true") return errorReply(400, `batch ${bid} has not ended`, "invalid_request_error")
  const model = batchModels.get(bid) ?? ""
  const file = try responsesFileOf(raw)
  if (file !== "") {
    const res = await send(t, native.geminiBatchResultsFile(t, file))
    if (!res.ok) return res
    return jsonlReply(try native.geminiResultsJsonl(try await res.text(), model))
  }
  return jsonlReply(try native.geminiInlinedToOpenAI(raw, model))
}

test("batch and file targets use only keys flagged use_for_batch_api", () => {
  const ps: Map<string, ProviderConfig> = new Map()
  ps.set("openai", { keys: [{ value: "plain" }, { value: "batch", use_for_batch_api: true }] })
  ps.set("anthropic", { keys: [{ value: "unflagged" }] })
  const cfg: Config = { providers: ps }
  expect(providerTarget(cfg, "openai")!.key.value).toBe("batch")
  expect(providerTarget(cfg, "anthropic")).toBeUndefined()
})

test("matches every media route", () => {
  const speech = matchRoute("POST", "/v1/audio/speech")
  expect(speech).toEqual({ op: "audio.speech", method: "POST", upstreamPath: "/audio/speech", modelIn: "json" })
  expect(matchRoute("post", "/v1/images/generations")!.modelIn).toBe("json")
  expect(matchRoute("POST", "/v1/audio/transcriptions")!.modelIn).toBe("form")
  expect(matchRoute("POST", "/v1/audio/translations")!.upstreamPath).toBe("/audio/translations")
  expect(matchRoute("POST", "/v1/images/edits")!.modelIn).toBe("form")
  expect(matchRoute("POST", "/v1/images/variations")!.modelIn).toBe("form")
  expect(matchRoute("POST", "/v1/files")).toEqual({ op: "files.create", method: "POST", upstreamPath: "/files", modelIn: "none" })
  expect(matchRoute("GET", "/v1/files")!.op).toBe("files.list")
  const one = matchRoute("GET", "/v1/files/file-abc")
  expect(one).toEqual({ op: "files.retrieve", method: "GET", upstreamPath: "/files/file-abc", modelIn: "none" })
  expect(matchRoute("DELETE", "/v1/files/file-abc")!.upstreamPath).toBe("/files/file-abc")
  expect(matchRoute("GET", "/v1/files/file-abc/content")!.upstreamPath).toBe("/files/file-abc/content")
  expect(matchRoute("POST", "/v1/batches")!.op).toBe("batches.create")
  expect(matchRoute("GET", "/v1/batches")!.op).toBe("batches.list")
  expect(matchRoute("GET", "/v1/batches/batch_1")!.upstreamPath).toBe("/batches/batch_1")
  expect(matchRoute("POST", "/v1/batches/batch_1/cancel")!.op).toBe("batches.cancel")
})

test("rejects unknown paths, wrong methods and empty ids", () => {
  expect(matchRoute("GET", "/v1/models")).toBeUndefined()
  expect(matchRoute("GET", "/v1/audio/speech")).toBeUndefined()
  expect(matchRoute("POST", "/v1/files/")).toBeUndefined()
  expect(matchRoute("GET", "/v1/files//content")).toBeUndefined()
  expect(matchRoute("POST", "/v1/files/a/b")).toBeUndefined()
  expect(matchRoute("GET", "/v1/batches/b1/cancel")).toBeUndefined()
  expect(matchRoute("POST", "/v2/files")).toBeUndefined()
  expect(matchRoute("GET", "/files")).toBeUndefined()
})

test("upstream urls for openai-compatible providers", () => {
  const speech = matchRoute("POST", "/v1/audio/speech")!
  const openai: Target = { provider: "openai", kind: "openai", model: "tts-1", key: { value: "k" }, cfg: {} }
  expect(upstreamUrl(openai, speech, "")).toBe("https://api.openai.com/v1/audio/speech")
  const groq: Target = { provider: "groq", kind: "groq", model: "whisper", key: { value: "k" }, cfg: {} }
  expect(upstreamUrl(groq, matchRoute("POST", "/v1/audio/transcriptions")!, "")).toBe("https://api.groq.com/openai/v1/audio/transcriptions")
  const list = matchRoute("GET", "/v1/files")!
  expect(upstreamUrl(openai, list, "limit=2&after=file-1")).toBe("https://api.openai.com/v1/files?limit=2&after=file-1")
  const over: Target = { provider: "openai", kind: "openai", model: "tts-1", key: { value: "k" }, cfg: { network_config: { base_url: "http://gw.local:9000/" } } }
  expect(upstreamUrl(over, matchRoute("GET", "/v1/batches/b_1")!, "")).toBe("http://gw.local:9000/v1/batches/b_1")
  const ollama: Target = { provider: "ollama", kind: "ollama", model: "x", key: { value: "" }, cfg: { network_config: { base_url: "http://gpu:11434" } } }
  expect(upstreamUrl(ollama, speech, "")).toBe("http://gpu:11434/v1/audio/speech")
})

test("upstream urls for azure deployments and files", () => {
  const deps: Map<string, string> = new Map()
  deps.set("whisper", "prod-whisper")
  const az: Target = { provider: "azure", kind: "azure", model: "whisper", key: { value: "ak", azure_key_config: { endpoint: "https://x.openai.azure.com/", deployments: deps, api_version: "2025-01-01" } }, cfg: {} }
  expect(upstreamUrl(az, matchRoute("POST", "/v1/audio/transcriptions")!, "")).toBe("https://x.openai.azure.com/openai/deployments/prod-whisper/audio/transcriptions?api-version=2025-01-01")
  expect(upstreamUrl(az, matchRoute("POST", "/v1/images/generations")!, "")).toBe("https://x.openai.azure.com/openai/deployments/prod-whisper/images/generations?api-version=2025-01-01")
  const noDeps: Target = { provider: "azure", kind: "azure", model: "gpt-4o", key: { value: "ak", azure_key_config: { endpoint: "https://y.openai.azure.com" } }, cfg: {} }
  expect(upstreamUrl(noDeps, matchRoute("POST", "/v1/audio/speech")!, "")).toBe("https://y.openai.azure.com/openai/deployments/gpt-4o/audio/speech?api-version=2024-10-21")
  expect(upstreamUrl(noDeps, matchRoute("GET", "/v1/files/file-1")!, "")).toBe("https://y.openai.azure.com/openai/files/file-1?api-version=2024-10-21")
  expect(upstreamUrl(noDeps, matchRoute("GET", "/v1/files")!, "purpose=batch")).toBe("https://y.openai.azure.com/openai/files?purpose=batch&api-version=2024-10-21")
  expect(upstreamUrl(noDeps, matchRoute("POST", "/v1/batches/b_1/cancel")!, "")).toBe("https://y.openai.azure.com/openai/batches/b_1/cancel?api-version=2024-10-21")
})

test("deployment paths: the /v1 route and the model from the deployment", () => {
  expect(deploymentRoute("/openai/deployments/prod-4o/chat/completions")).toEqual({ path: "/v1/chat/completions", model: "azure/prod-4o" })
  expect(deploymentRoute("/openai/deployments/openai/gpt-4o/chat/completions")).toEqual({ path: "/v1/chat/completions", model: "openai/gpt-4o" })
  expect(deploymentRoute("/openai/deployments/d/images/generations")).toEqual({ path: "/v1/images/generations", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/audio/transcriptions")).toEqual({ path: "/v1/audio/transcriptions", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/audio/speech")).toEqual({ path: "/v1/audio/speech", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/completions")).toEqual({ path: "/v1/completions", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/embeddings")).toEqual({ path: "/v1/embeddings", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/responses")).toEqual({ path: "/v1/responses", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/responses/input_tokens")).toEqual({ path: "/v1/responses/input_tokens", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/responses/compact")).toEqual({ path: "/v1/responses/compact", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/images/edits")).toEqual({ path: "/v1/images/edits", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/images/variations")).toEqual({ path: "/v1/images/variations", model: "azure/d" })
  expect(deploymentRoute("/openai/deployments/d/models")).toBe(undefined)
  expect(deploymentRoute("/openai/deployments//chat/completions")).toBe(undefined)
  expect(deploymentRoute("/openai/v1/chat/completions")).toBe(undefined)
})

test("auth headers", () => {
  const extra: Map<string, string> = new Map()
  extra.set("x-org", "o1")
  const t: Target = { provider: "openai", kind: "openai", model: "m", key: { value: "sk" }, cfg: { network_config: { extra_headers: extra } } }
  const h = authHeaders(t)
  expect(h.get("authorization")).toBe("Bearer sk")
  expect(h.get("x-org")).toBe("o1")
  expect(h.has("content-type")).toBe(false)
  const az: Target = { provider: "azure", kind: "azure", model: "m", key: { value: "ak" }, cfg: {} }
  expect(authHeaders(az).get("api-key")).toBe("ak")
  expect(authHeaders(az).has("authorization")).toBe(false)
  const keyless: Target = { provider: "vllm", kind: "vllm", model: "m", key: { value: "" }, cfg: {} }
  expect(authHeaders(keyless).has("authorization")).toBe(false)
})

test("rewrites only the model field", () => {
  const body = '{"input":"hi \\u00e9 ☃","model":"openai/tts-1","voice":"alloy","speed":1.0,"extra":{"a":[1,"}"]}}'
  expect(try rewriteJsonModel(body, "tts-1")).toBe('{"input":"hi \\u00e9 ☃","model":"tts-1","voice":"alloy","speed":1.0,"extra":{"a":[1,"}"]}}')
  expect(try rewriteJsonModel('{"input":"x"}', "tts-1")).toBe('{"input":"x","model":"tts-1"}')
  let threw = false
  try {
    rewriteJsonModel("[1,2]", "m")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("provider precedence: header, query, default", () => {
  const h: Map<string, string> = new Map()
  const q = new URLSearchParams("")
  expect(providerFor(h, q)).toBe("openai")
  expect(providerFor(h, new URLSearchParams("provider=together"))).toBe("together")
  h.set("x-bf-provider", "groq")
  expect(providerFor(h, new URLSearchParams("provider=together"))).toBe("groq")
  h.set("x-bf-provider", "")
  expect(providerFor(h, new URLSearchParams("provider=together"))).toBe("together")
  expect(providerFor(h, new URLSearchParams("provider="))).toBe("openai")
})

test("native routes: batch and file ids, first model, upload copies", () => {
  expect(routeId(matchRoute("GET", "/v1/batches/b_1")!)).toBe("b_1")
  expect(routeId(matchRoute("GET", "/v1/files/raiju-batch-output-b_1/content")!)).toBe("raiju-batch-output-b_1")
  expect(routeId(matchRoute("GET", "/v1/files")!)).toBe("")
  expect(isNative("anthropic")).toBe(true)
  expect(isNative("openai")).toBe(false)
  expect(try firstModel(`{"custom_id":"a","method":"POST","url":"/v1/chat/completions","body":{"model":"openai/gpt-4o"}}\n`)).toBe("gpt-4o")
  let threw = false
  try {
    firstModel("not json")
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  for (let i = 0; i < UPLOAD_CAP + 2; i++) remember("f" + i, "x" + i)
  expect(uploads.has("f0")).toBe(false)
  expect(uploads.get("f" + (UPLOAD_CAP + 1))).toBe("x" + (UPLOAD_CAP + 1))
})

test("batch results route: matched, id kept, upstream url", () => {
  const r = matchRoute("GET", "/v1/batches/b_1/results")
  expect(r).toEqual({ op: "batches.results", method: "GET", upstreamPath: "/batches/b_1/results", modelIn: "none" })
  expect(routeId(r!)).toBe("b_1")
  expect(matchRoute("POST", "/v1/batches/b_1/results")).toBeUndefined()
  expect(matchRoute("GET", "/v1/batches//results")).toBeUndefined()
  const openai: Target = { provider: "openai", kind: "openai", model: "", key: { value: "k" }, cfg: {} }
  expect(upstreamUrl(openai, r!, "")).toBe("https://api.openai.com/v1/batches/b_1/results")
})

