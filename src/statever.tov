// State files (mcp-oauth-state.json, mcp-flow-state.json, <config>.adaptive.json, the A2A push item files) carry a
// top-level "version". A reader brings an older file up to date through its module's migrations, one step per
// version, and refuses a file from a newer Raiju: its fields may mean something this build does not know, and
// writing it back would drop them. A file written before versions existed reads as version 0.
import { Field, fields, find, build, without } from "./json"

// One step of a migration: the text of a version n file in, the text of a version n+1 file out.
export type Migration = (text: string) => string

export type StateRead = {
  // false: the file is from a newer Raiju (or not a JSON object); problem says why, text is unchanged
  ok: bool,
  // the text at the current version (migrated when it was older)
  text: string,
  // the version the file was written at
  from: int,
  problem: string,
}

// The version a state file was written at: its top-level "version" (0 when absent, or when the text is not an object).
export function stateVersion(text: string): int {
  try {
    const raw = find(try fields(text), "version")
    if (raw === undefined) return 0
    const n = parseInt(raw)
    return n === undefined || n < 0 ? 0 : n
  } catch (e) {
    return 0
  }
}

// The object text with "version" set to v, first (any "version" it had is replaced).
export function withVersion(text: string, v: int): string {
  try {
    const rest = without(try fields(text), ["version"])
    const fs: Field[] = [{ key: "version", raw: `${v}` }]
    for (const f of rest) fs.push(f)
    return build(fs)
  } catch (e) {
    return text
  }
}

// Reads a state file's text for a reader at version current. steps[n] turns version n into n+1, so steps holds
// current entries; a missing step leaves the text as it is (the shape did not change) and only the version moves.
// name names the file in the problem.
export function readState(name: string, text: string, current: int, steps: Migration[]): StateRead {
  try {
    try fields(text)
  } catch (e) {
    return { ok: false, text: text, from: 0, problem: `${name} is not a JSON object` }
  }
  const from = stateVersion(text)
  if (from > current) return { ok: false, text: text, from: from, problem: newerProblem(name, from, current) }
  let t = text
  for (let v = from; v < current; v++) {
    const step = steps[v]
    if (step !== undefined) t = step(t)
  }
  if (from < current) t = withVersion(t, current)
  return { ok: true, text: t, from: from, problem: "" }
}

// The problem for a file written at version have by a newer Raiju, read by one that knows up to reads.
export function newerProblem(name: string, have: int, reads: int): string {
  return `${name} was written by a newer Raiju (state version ${have}; this build reads up to ${reads})`
}

test("stateVersion reads the top-level version, 0 without one", () => {
  expect(stateVersion(`{"version":3,"a":1}`)).toBe(3)
  expect(stateVersion(`{"a":{"version":9}}`)).toBe(0)
  expect(stateVersion(`{}`)).toBe(0)
  expect(stateVersion(`not json`)).toBe(0)
  expect(stateVersion(`{"version":"x"}`)).toBe(0)
})

test("withVersion puts the version first and replaces an old one", () => {
  expect(withVersion(`{"a":1}`, 1)).toBe(`{"version":1,"a":1}`)
  expect(withVersion(`{}`, 2)).toBe(`{"version":2}`)
  expect(withVersion(`{"a":1,"version":1}`, 2)).toBe(`{"version":2,"a":1}`)
})

test("readState migrates older files step by step and refuses newer ones", () => {
  const steps: Migration[] = [
    (t: string): string => t.replace(`"old"`, `"mid"`),
    (t: string): string => t.replace(`"mid"`, `"new"`),
  ]
  const v0 = readState("s.json", `{"k":"old"}`, 2, steps)
  expect(v0.ok).toBe(true)
  expect(v0.from).toBe(0)
  expect(v0.text).toBe(`{"version":2,"k":"new"}`)
  const v1 = readState("s.json", `{"version":1,"k":"mid"}`, 2, steps)
  expect(v1.text).toBe(`{"version":2,"k":"new"}`)
  const same = readState("s.json", `{"version":2,"k":"new"}`, 2, steps)
  expect(same.ok).toBe(true)
  expect(same.text).toBe(`{"version":2,"k":"new"}`)
  const newer = readState("s.json", `{"version":3,"k":"x"}`, 2, steps)
  expect(newer.ok).toBe(false)
  expect(newer.from).toBe(3)
  expect(newer.problem.includes("newer Raiju")).toBe(true)
  expect(readState("s.json", "garbage", 2, steps).ok).toBe(false)
  // no steps at all: only the version moves
  expect(readState("s.json", `{"k":1}`, 1, []).text).toBe(`{"version":1,"k":1}`)
})
