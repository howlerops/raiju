  expect(rawBool(vs, "enabled")).toBe(true)
  expect(rawStr(vs, "type")).toBe("qdrant")
  const c = try fields(find(vs, "config")!)
  expect(rawStr(c, "host")).toBe("q.internal")
  expect(rawStr(c, "api_key")).toBe("k")
  expect(rawBool(c, "use_tls")).toBe(true)
  expect(find(c, "port")).toBeUndefined()
  expect(find(c, "max_recv_msg_size_mb")).toBeUndefined()
  expect(r.notes.includes(`config: "vector_store.config.port" is the gRPC port in Bifrost, and Raiju uses Qdrant's REST API; the REST port is "vector_store.config.rest_port" (default 6333)`)).toBe(true)
  expect(r.notes.includes(`config: "vector_store.config.max_recv_msg_size_mb" is not supported by Raiju and is ignored`)).toBe(true)
