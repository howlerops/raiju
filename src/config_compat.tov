  expect(find(try fields(find(try fields(r.text), "mcp")!), "tool_groups")).toBeUndefined()
  expect(r.notes.includes(`config: "mcp.tool_groups" read as "virtual_mcps" (deprecated in Bifrost)`)).toBe(true)
})

test("maps the semantic_cache plugin and keeps the other plugins", () => {
  const r = try normalize(`{
    "plugins": [
      { "enabled": true, "name": "semantic_cache", "config": { "provider": "openai", "embedding_model": "text-embedding-3-small", "ttl": "5m", "threshold": 0.9, "dimension": 1536, "cache_by_model": false } },
      { "enabled": true, "name": "maxtokens", "config": { "default_max_tokens": 100 } }
    ]
  }`)
  const sc = try fields(find(try fields(r.text), "semantic_cache")!)
  expect(rawStr(sc, "provider")).toBe("openai")
  expect(rawStr(sc, "embedding_model")).toBe("text-embedding-3-small")
  expect(find(sc, "ttl")).toBe("300")
  expect(find(sc, "threshold")).toBe("0.9")
  expect(find(sc, "cache_by_model")).toBe("false")
  const plugins = try elements(find(try fields(r.text), "plugins")!)
  expect(plugins.length).toBe(1)
  expect(find(sc, "dimension")).toBe("1536")
  expect(find(sc, "cache_tool_call_responses")).toBeUndefined()
  expect(r.notes.includes(`config: "plugins[semantic_cache].config.dimension" is not supported by Raiju and is ignored`)).toBe(false)
  const numTtl = try normalize(`{ "plugins": [ { "enabled": true, "name": "semanticcache", "config": { "provider": "openai", "embedding_model": "e", "ttl": 90 } } ] }`)
  const nsc = find(try fields(numTtl.text), "semantic_cache")!
  expect(find(try fields(nsc), "ttl")).toBe("90")
})

test("maps vector_store for qdrant and the semantic plugin's namespace and dimension", () => {
  const r = try normalize(`{
    "vector_store": { "enabled": true, "type": "qdrant", "config": { "host": "q.internal", "port": 6334, "api_key": "k", "use_tls": true, "max_recv_msg_size_mb": 64 } },
    "plugins": [ { "enabled": true, "name": "semantic_cache", "config": { "provider": "openai", "embedding_model": "e", "vector_store_namespace": "mycache", "dimension": 1536, "disable_identity_scoping": true } } ]
  }`)
  const vs = try fields(find(try fields(r.text), "vector_store")!)
  expect(rawBool(vs, "enabled")).toBe(true)
  expect(rawStr(vs, "type")).toBe("qdrant")
  const c = try fields(find(vs, "config")!)
  expect(rawStr(c, "host")).toBe("q.internal")
  expect(rawStr(c, "api_key")).toBe("k")
  expect(rawBool(c, "use_tls")).toBe(true)
  expect(find(c, "port")).toBeUndefined()
  expect(find(c, "max_recv_msg_size_mb")).toBeUndefined()
  expect(r.notes.includes(`config: "vector_store.config.port" is the gRPC port in Bifrost, and Raiju uses Qdrant's REST API; the REST port is "vector_store.config.rest_port" (default 6333)`)).toBe(true)
  expect(r.notes.includes(`config: "vector_store.config.max_recv_msg_size_mb" is not supported by Raiju and is ignored`)).toBe(true)
  const sc = try fields(find(try fields(r.text), "semantic_cache")!)
  expect(rawStr(sc, "vector_store_namespace")).toBe("mycache")
  expect(find(sc, "dimension")).toBe("1536")
  expect(r.notes.includes(`config: "plugins[semantic_cache].config.disable_identity_scoping" is not supported by Raiju and is ignored`)).toBe(true)
})

test("maps a redis vector_store and drops types Raiju has no client for", () => {
  const rr = try normalize(`{ "vector_store": { "enabled": true, "type": "redis", "config": { "addr": "r:6379", "password": "p", "db": 1, "cluster_mode": true, "pool_size": 10, "insecure_skip_verify": true } } }`)
  const c = try fields(find(try fields(find(try fields(rr.text), "vector_store")!), "config")!)
  expect(rawStr(c, "addr")).toBe("r:6379")
  expect(find(c, "db")).toBe("1")
  expect(find(c, "pool_size")).toBeUndefined()
  expect(rr.notes.includes(`config: "vector_store.config.pool_size" is not supported by Raiju and is ignored`)).toBe(true)
  expect(rr.notes.includes(`config: "vector_store.config.cluster_mode" is not supported by Raiju and is ignored: the store is read as a single node`)).toBe(true)
  const wv = try normalize(`{ "vector_store": { "enabled": true, "type": "weaviate", "config": { "scheme": "http", "host": "w" } } }`)
  expect(find(try fields(wv.text), "vector_store")).toBeUndefined()
  expect(wv.notes.includes(`config: "vector_store.type" "weaviate" is not supported by Raiju; the semantic cache keeps its entries in memory`)).toBe(true)
})

test("existing Raiju sections win over Bifrost ones, with a note", () => {
  const r = try normalize(`{
    "alerts": { "enabled": false },
    "alerting": { "channels": [] },
    "audit": { "enabled": true, "dir": "logs/x" },
    "audit_logs": { "disabled": true },
    "plugins": [ { "enabled": true, "name": "semantic_cache", "config": { "provider": "openai", "embedding_model": "e" } } ],
    "semantic_cache": { "enabled": false, "provider": "openai", "embedding_model": "mine" }
  }`)
  expect(find(try fields(r.text), "alerting")).toBeUndefined()
  expect(find(try fields(r.text), "alerts")).toBe(`{ "enabled": false }`)
  expect(find(try fields(r.text), "audit")).toBe(`{ "enabled": true, "dir": "logs/x" }`)
  expect(r.notes.includes(`config: "alerting" is ignored: "alerts" is set, and it wins`)).toBe(true)
  expect(r.notes.includes(`config: "audit_logs" is ignored: "audit" is set, and it wins`)).toBe(true)
  expect(r.notes.includes(`config: plugin "semantic_cache" is ignored: "semantic_cache" is set, and it wins`)).toBe(true)
  expect(find(try fields(r.text), "semantic_cache")).toBe(`{ "enabled": false, "provider": "openai", "embedding_model": "mine" }`)
})

test("maps client keys and top-level auth into Raiju's sections", () => {
  const r = try normalize(`{
    "client": { "mcp_tool_execution_timeout": 45, "log_retention_days": 14, "enforce_auth_on_inference": true, "max_request_body_size_mb": 10 },
    "logs_store": { "enabled": true },
    "auth_config": { "admin_username": "root", "admin_password": "env.ADMIN_PW", "is_enabled": true }
  }`)
  const cl = try fields(find(try fields(r.text), "client")!)
  expect(find(cl, "mcp_tool_execution_timeout")).toBeUndefined()
  expect(find(cl, "log_retention_days")).toBeUndefined()
  expect(find(cl, "max_request_body_size_mb")).toBe("10")
  const mcp = try fields(find(try fields(r.text), "mcp")!)
  expect(find(mcp, "tool_execution_timeout_seconds")).toBe("45")
  const ls = try fields(find(try fields(r.text), "logs_store")!)
  expect(find(ls, "retention_days")).toBe("14")
  const gov = try fields(find(try fields(r.text), "governance")!)
  const ga = try fields(find(gov, "auth_config")!)
  expect(rawStr(ga, "username")).toBe("root")
  expect(rawStr(ga, "password")).toBe("env.ADMIN_PW")
  expect(find(try fields(r.text), "auth_config")).toBeUndefined()
  expect(r.notes.includes(`config: "auth_config.is_enabled" is not supported by Raiju and is ignored`)).toBe(true)
  const none = try normalize(`{ "client": { "log_retention_days": 14 } }`)
  expect(none.notes.includes(`config: "client.log_retention_days" is not applied: it needs a "logs_store" section`)).toBe(true)
})

test("unknownKeys lists ignored keys and the accepted-but-unused ones", () => {
  const keys = try unknownKeys(`{
    "$schema": "x",
    "server": { "port": 8080 },
    "guardrails_config": {},
    "guardrails": { "enabled": true },
    "client": { "enforce_auth_on_inference": true, "drop_excess_requests": false, "allow_direct_keys": false, "prometheus_labels": [], "enable_logging": true },
    "providers": { "openai": { "keys": [], "send_back_raw_response": false, "prompt_cache": {} } },
    "governance": { "business_units": [], "budgets": [] },
    "mcp": { "tool_manager_config": {}, "client_configs": [] },
    "pricing_sync": { "url": "x" }
  }`)
  expect(keys).toEqual([
    "server",
    "client.drop_excess_requests",
    "client.allow_direct_keys",
    "client.prometheus_labels",
    "providers.openai.send_back_raw_response",
    "providers.openai.prompt_cache",
    "governance.business_units",
    "mcp.tool_manager_config",
  ])
})

test("warnings formats renames and unknown keys", () => {
  const w = try warnings(`{ "alerting": { "channels": [] }, "server": {}, "client": { "drop_excess_requests": true } }`)
  expect(w.includes(`config: "alerting" read as "alerts"`)).toBe(true)
  expect(w.includes(`config: unknown key "server" is ignored`)).toBe(true)
  expect(w.includes(`config: "client.drop_excess_requests" is accepted but not implemented`)).toBe(true)
  expect(w.includes(`config: unknown key "alerting" is ignored`)).toBe(false)
  expect(w.length).toBe(3)
  const clean = try warnings(`{ "client": { "enable_logging": true }, "providers": {} }`)
  expect(clean.length).toBe(0)
})

// The shape Raiju reads from the normalized text, as the lead's typed parse sees it.
type Probe = {
  health?: { circuit_breaker?: bool, adaptive?: bool, open_seconds?: int },
  alerts?: { channels?: { id: string, type: "webhook" | "slack", url: string }[], rules?: string[] },
  semantic_cache?: { provider: string, embedding_model: string, ttl?: int },
  pricing_sync?: { url?: string, interval_seconds?: int },
}

test("normalized text parses into the typed shape Raiju reads", () => {
  const r = try normalize(`{
    "alerting": { "channels": [ { "id": "ops", "type": "slack", "enabled": true, "config": { "webhook_url": "https://hooks.example/s" } } ] },
    "circuit_breaker_config": { "policies": [ { "name": "p", "enabled": true, "default_cooldown": "1m" } ] },
    "load_balancer_config": { "enabled": true },
    "framework": { "pricing": { "pricing_url": "https://prices.example/p.json", "pricing_sync_interval": 3600 } },
    "plugins": [ { "enabled": true, "name": "semantic_cache", "config": { "provider": "openai", "embedding_model": "e", "ttl": "1h" } } ]
  }`)
  const p = try JSON.parse(r.text) as Probe
  expect(p.alerts!.channels![0]!.url).toBe("https://hooks.example/s")
  expect(p.alerts!.rules!.length).toBe(0)
  expect(p.health!.circuit_breaker).toBe(true)
  expect(p.health!.adaptive).toBe(true)
  expect(p.health!.open_seconds).toBe(60)
  expect(p.semantic_cache!.provider).toBe("openai")
  expect(p.semantic_cache!.ttl).toBe(3600)
  expect(p.pricing_sync!.interval_seconds).toBe(3600)
})

// A trimmed copy of Bifrost's withpostgresmcpclientsinconfig example.
test("a whole Bifrost example: what is mapped and what is left", () => {
  const text = `{
    "$schema": "https://www.getbifrost.ai/schema",
    "client": { "enable_logging": true, "enforce_auth_on_inference": true, "log_retention_days": 30, "initial_pool_size": 300, "max_request_body_size_mb": 100 },
    "config_store": { "enabled": true, "type": "postgres", "config": { "host": "localhost" } },
    "logs_store": { "enabled": true, "type": "postgres", "config": { "host": "localhost" } },
    "mcp": {
      "tool_manager_config": { "server_instructions_mode": "gateway" },
      "client_configs": [ { "name": "WeatherService", "connection_type": "http", "client_id": "weather", "connection_string": "http://localhost:8080/mcp" } ]
    },
    "governance": {
      "auth_config": { "admin_username": "env.ADMIN_USER", "admin_password": "env.ADMIN_PW" },
      "virtual_keys": [ { "id": "vk-1", "name": "portal", "value": "env.VK", "mcp_configs": [ { "mcp_client_name": "WeatherService", "tools_to_execute": ["*"] } ] } ]
    },
    "plugins": [ { "enabled": true, "name": "governance", "config": { "is_vk_mandatory": true } } ],
    "providers": { "openai": { "keys": [ { "name": "k", "value": "env.OPENAI_API_KEY", "models": ["*"], "weight": 1 } ] } }
  }`
  const r = try normalize(text)
  const p = try JSON.parse(r.text) as { logs_store?: { retention_days?: int }, governance?: { auth_config?: { username?: string, password?: string } } }
  expect(p.logs_store!.retention_days).toBe(30)
  expect(p.governance!.auth_config!.username).toBe("env.ADMIN_USER")
  expect(p.governance!.auth_config!.password).toBe("env.ADMIN_PW")
  expect(r.notes.length).toBe(3)
  const w = try warnings(text)
  expect(w.includes(`config: unknown key "config_store" is ignored`)).toBe(true)
  expect(w.includes(`config: unknown key "client.initial_pool_size" is ignored`)).toBe(true)
  expect(w.includes(`config: unknown key "mcp.tool_manager_config" is ignored`)).toBe(true)
  expect(w.includes(`config: unknown key "$schema" is ignored`)).toBe(false)
  expect(w.length).toBe(3 + 3)
})

test("invalid JSON throws SyntaxError", () => {
  let threw = false
  try {
    normalize(`{ "alerting": `)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})
