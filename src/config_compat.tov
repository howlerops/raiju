// Reads a Bifrost config.json the way Raiju reads its own. Bifrost names some
// sections differently, and some of its keys have no Raiju counterpart.
// normalize() rewrites the sections Raiju has under another name, so the typed
// parse picks them up. warnings() lists what is still ignored, so nothing is
// dropped silently. Both work on the raw text, and fields this module does not
// model stay as they are.

import { Field, fields, elements, find, rawStr, rawBool, rawNum, decodeString, build, quote, setField, without, isNull } from "./json"
import { durationMsOf } from "./mcp"

// Raiju's top-level keys (the Config type in config.tov), plus the Bifrost
// sections this module reads and the pricing_sync key it writes.
function topKeys(): string[] {
  return ["version", "source_of_truth", "env_label", "server", "setup_token", "encryption_key", "proxy_config", "client", "providers", "governance", "cache", "pricing", "prompt_cache", "health", "guardrails", "logs_store", "otel", "mcp", "plugins", "semantic_cache", "vector_store", "secrets", "audit", "alerts", "session_affinity", "complexity_router", "mcp_server", "virtual_mcps", "log_exports", "exporters", "cluster", "oidc", "framework", "auth_config", "alerting", "audit_logs", "cluster_config", "circuit_breaker_config", "load_balancer_config", "pricing_sync", "guardrails_config", "$schema", "auth_proxy", "circuit_breaker_policies", "scim_config", "prompt_repo", "webhooks", "feature_flags"]
}

// Raiju's keys one level down. client also takes the two keys normalize maps.
function clientKeys(): string[] {
  return ["drop_excess_requests", "mcp_server_auth_mode", "oauth2_server_config", "mcp_enable_temp_token_auth","enable_logging", "enable_governance", "enforce_governance_header", "required_headers", "allow_direct_keys", "refuse_unpriced_models", "allowed_origins", "max_request_body_size_mb", "prometheus_labels", "async_job_result_ttl", "mcp_agent_depth", "mcp_auto_execute", "mcp_tool_execution_timeout", "log_retention_days", "enforce_auth_on_inference", "allow_per_request_raw_override", "disable_content_logging", "allow_per_request_content_storage_override", "mcp_disable_auto_tool_inject", "extra_fields_placement", "logging_headers", "compat", "header_filter_config", "allowed_headers", "whitelisted_routes", "dual_credential_conflict_behavior", "dump_errors_in_console_logs", "routing_chain_max_depth", "hidden_request_types", "hide_deleted_virtual_keys_in_filters", "delete_expired_virtual_keys", "vk_rotation_cooldown", "enforce_vk_object_ownership", "webhook_config"]
}

function providerKeys(): string[] {
  return ["keys", "network_config", "proxy_config", "custom_provider_config", "send_back_raw_response", "send_back_raw_request", "store_raw_request_response", "concurrency_and_buffer_size", "openai_config", "prompt_cache", "injected_tools", "ignore_provider_cost"]
}

function governanceKeys(): string[] {
  return ["auth_config", "users", "access_profiles", "budgets", "rate_limits", "virtual_keys", "teams", "customers", "business_units", "projects", "roles", "routing_rules", "pricing_overrides", "model_configs", "providers"]
}

function mcpKeys(): string[] {
  return ["client_configs", "tool_execution_timeout_seconds", "virtual_mcps", "tool_groups", "tool_manager_config", "tool_sync_interval", "oauth_private_allowlist"]
}

// The mcp.tool_manager_config keys Raiju reads (mapToolManager in mapMcp, and the notes for the rest).
function toolManagerKeys(): string[] {
  return ["tool_execution_timeout", "oauth_private_allowlist", "max_agent_depth", "disable_auto_tool_inject", "max_instructions_per_client", "max_instructions_total", "code_mode_binding_level", "code_mode_limits"]
}

// Keys of the provider sections Raiju reads one level down (checked as providers.<name>.<section>).
function providerChildKeys(section: string): string[] {
  if (section === "network_config") return ["base_url", "extra_headers", "default_request_timeout_in_seconds", "max_retries", "retry_backoff_initial", "retry_backoff_max", "insecure_skip_verify", "ca_cert_pem", "allow_private_network"]
  if (section === "prompt_cache") return ["auto_inject", "ttl", "cache_control_injection_points"]
  if (section === "openai_config") return ["disable_store"]
  if (section === "concurrency_and_buffer_size") return ["concurrency", "buffer_size"]
  if (section === "custom_provider_config") return ["is_key_less", "does_not_send_done_marker", "wait_for_usage", "base_provider_type", "request_path_overrides", "allowed_requests"]
  return []
}

// Keys of one entry in providers.<name>.keys that Raiju reads.
function keyChildKeys(): string[] {
  return ["id", "name", "value", "models", "weight", "aliases", "azure_key_config", "vertex_key_config", "bedrock_key_config", "bedrock_mantle_key_config", "watsonx_key_config", "cloudflare_key_config", "databricks_key_config", "github_copilot_key_config", "use_for_batch_api", "oauth_key_config"]
}

const GEN = "is not implemented by Raiju and is ignored"

// Why each Bifrost key that Raiju does not act on is ignored, as the startup note says it.
// Keys are paths; a provider's name is written as "*" (providers.*.keys.use_for_batch_api).
// A key Raiju reads but does not apply is listed too, so it is never dropped silently.
function noteTable(): Map<string, string> {
  const m: Map<string, string> = new Map()
  const pairs: string[][] = [
    // top level
    ["websocket", "is accepted but not applied: Raiju's WebSocket limits are fixed in src/ws.tov"],
    ["large_payload_optimization", "is not implemented: Raiju buffers request bodies up to client.max_request_body_size_mb"],
    ["agents", "is not implemented: Raiju has no agent gateway (A2A)"],
    ["config_store", "is not used: Raiju saves its config to the file given by -config"],
    ["skills_registry", GEN],
    ["scim_config", "is out of scope: SCIM (SCOPE.md)"],
    ["access_profiles", "is not read: Raiju's access profiles are governance.access_profiles, with a different shape"],
    // client
    ["client.initial_pool_size", "is a Go connection-pool setting that Raiju does not use"],
    ["client.retain_content_in_object_storage", "is not used: Raiju has no object storage"],
    ["client.disable_db_pings_in_health", "is not used: Raiju has no database"],
    ["client.dual_credential_conflict_behavior", GEN],
    ["client.enforce_scim_auth", "is out of scope: SCIM (SCOPE.md)"],
    ["client.hidden_request_types", GEN],
    ["client.hide_deleted_virtual_keys_in_filters", "has no effect: Raiju deletes a virtual key outright, so no deleted keys appear in the filters"],
    ["client.enforce_vk_object_ownership", GEN],
    ["client.mcp_code_mode_binding_level", GEN],
    ["client.mcp_code_mode_limits", GEN],
    ["client.mcp_external_client_url", GEN],
    ["client.skills_external_client_url", GEN],
    ["client.a2a_external_client_url", GEN],
    ["client.a2a_store_raw_request_response", "is not implemented: Raiju has no A2A gateway"],
    // governance and mcp
    ["governance.complexity_analyzer_config", "is not read: Raiju's complexity router is the top-level complexity_router"],
    // providers, written as providers.*
    ["providers.*.keys.oauth_key_config", GEN],
    ["providers.*.network_config.enforce_http2", GEN],
    ["providers.*.network_config.http2_ping_interval_in_seconds", GEN],
    ["providers.*.network_config.stream_idle_timeout_in_seconds", GEN],
    ["providers.*.network_config.keep_alive_timeout_in_seconds", GEN],
    ["providers.*.network_config.max_conns_per_host", GEN],
    ["providers.*.network_config.beta_header_overrides", GEN],
    ["providers.*.network_config.allow_private_network", "is accepted but has no effect: Raiju never blocks private provider addresses"],
  ]
  for (const p of pairs) m.set(p[0]!, p[1]!)
  return m
}

const NOTES: Map<string, string> = noteTable()

// The NOTES key for a config path: a provider's name becomes "*".
function noteKey(p: string): string {
  if (!p.startsWith("providers.")) return p
  const rest = p.slice(10)
  const dot = rest.indexOf(".")
  return dot < 0 ? p : "providers.*" + rest.slice(dot)
}

// A key is flagged when Raiju does not read it, or when it has a note: a key Raiju reads
// and does not apply is flagged so the note says so.
function flagged(path: string, known: bool): bool {
  return !known || NOTES.has(noteKey(path))
}

// The members of a JSON object given as raw text. Anything else has none.
function members(raw: string | undefined): Field[] throws SyntaxError {
  const r = raw ?? ""
  if (!r.startsWith("{")) return []
  return try fields(r)
}

// The elements of a JSON array given as raw text. Anything else has none.
function items(raw: string | undefined): string[] throws SyntaxError {
  const r = raw ?? ""
  if (!r.startsWith("[")) return []
  return try elements(r)
}

// The values of a JSON array of strings; other elements are skipped.
function strings(raw: string | undefined): string[] throws SyntaxError {
  const out: string[] = []
  for (const el of try items(raw)) {
    if (el.startsWith("\"")) out.push(try decodeString(el))
  }
  return out
}

// The raw text of a string value, or undefined when the value is not a string.
function strRaw(fs: Field[], key: string): string | undefined {
  const r = find(fs, key)
  if (r === undefined) return undefined
  if (!r.startsWith("\"")) return undefined
  return r
}

function add(inout fs: Field[], key: string, raw: string | undefined): void {
  if (raw !== undefined) fs.push({ key: key, raw: raw })
}

function put(inout top: Field[], key: string, fs: Field[]): void {
  setField(&top, key, build(fs))
}

// One "not supported" note for each of keys that is present in fs.
function ignored(path: string, fs: Field[], keys: string[], inout notes: string[]): void {
  for (const k of keys) {
    if (find(fs, k) !== undefined) notes.push(`config: "${path}.${k}" is not supported by Raiju and is ignored`)
  }
}

// Seconds in a Go duration such as "30s", "5m" or "1h". undefined for anything else.
function goSeconds(s: string): f64 | undefined {
  // "ms" and "us" come before "m" and "s", which they end with
  const units: { suffix: string, factor: f64 }[] = [
    { suffix: "ns", factor: 0.000000001 },
    { suffix: "us", factor: 0.000001 },
    { suffix: "µs", factor: 0.000001 },
    { suffix: "ms", factor: 0.001 },
    { suffix: "h", factor: 3600.0 },
    { suffix: "m", factor: 60.0 },
    { suffix: "s", factor: 1.0 },
  ]
  for (const u of units) {
    if (s.endsWith(u.suffix)) {
      const n = parseFloat(s.slice(0, s.byteLength - u.suffix.byteLength))
      if (n === undefined || n < 0.0) return undefined
      return n * u.factor
    }
  }
  return undefined
}

// Bifrost's top-level auth_config (deprecated there) and governance.auth_config
// become Raiju's governance.auth_config, with admin_username and admin_password
// read as username and password.
function adminFields(src: Field[], path: string, inout notes: string[]): Field[] {
  if (path === "governance.auth_config") {
    if (find(src, "admin_username") !== undefined) notes.push(`config: "governance.auth_config.admin_username" read as "governance.auth_config.username"`)
    if (find(src, "admin_password") !== undefined) notes.push(`config: "governance.auth_config.admin_password" read as "governance.auth_config.password"`)
  }
  let out: Field[] = []
  add(&out, "username", strRaw(src, "admin_username") ?? strRaw(src, "username"))
  add(&out, "password", strRaw(src, "admin_password") ?? strRaw(src, "password"))
  add(&out, "token", strRaw(src, "token"))
  // is_enabled: false keeps the credentials in the file but turns admin auth off, as Bifrost
  add(&out, "is_enabled", find(src, "is_enabled"))
  add(&out, "disable_auth_on_inference", find(src, "disable_auth_on_inference"))
  return out
}

function mapAuth(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const topRaw = find(top, "auth_config")
  let gov = try members(find(top, "governance"))
  if (topRaw !== undefined) {
    top = without(top, ["auth_config"])
    if (find(gov, "auth_config") !== undefined) {
      notes.push(`config: "auth_config" is ignored: "governance.auth_config" is set, and it wins`)
    } else {
      notes.push(`config: "auth_config" read as "governance.auth_config"`)
      setField(&gov, "auth_config", build(adminFields(try members(topRaw), "auth_config", &notes)))
    }
  }
  const cur = find(gov, "auth_config")
  if (cur === undefined) return
  setField(&gov, "auth_config", build(adminFields(try members(cur), "governance.auth_config", &notes)))
  put(&top, "governance", gov)
}

// Bifrost's client keys that Raiju keeps elsewhere.
function mapClient(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const raw = find(top, "client")
  if (raw === undefined) return
  let cf = try members(raw)
  let mcp = try members(find(top, "mcp"))
  let mcpChanged = false
  let clientChanged = false

  const timeout = find(cf, "mcp_tool_execution_timeout")
  if (timeout !== undefined) {
    cf = without(cf, ["mcp_tool_execution_timeout"])
    clientChanged = true
    if (find(mcp, "tool_execution_timeout_seconds") === undefined) {
      setField(&mcp, "tool_execution_timeout_seconds", timeout)
      mcpChanged = true
      notes.push(`config: "client.mcp_tool_execution_timeout" read as "mcp.tool_execution_timeout_seconds"`)
    } else {
      notes.push(`config: "client.mcp_tool_execution_timeout" is ignored: "mcp.tool_execution_timeout_seconds" is set, and it wins`)
    }
  }

  // the older client-level MCP keys: the global sync interval and the private-host allowlist
  for (const pair of [["mcp_tool_sync_interval", "tool_sync_interval"], ["mcp_oauth_private_allowlist", "oauth_private_allowlist"]]) {
    const v = find(cf, pair[0]!)
    if (v === undefined) continue
    cf = without(cf, [pair[0]!])
    clientChanged = true
    if (find(mcp, pair[1]!) === undefined && !isNull(v)) {
      setField(&mcp, pair[1]!, v)
      mcpChanged = true
      notes.push(`config: "client.${pair[0]}" read as "mcp.${pair[1]}"`)
    } else {
      notes.push(`config: "client.${pair[0]}" is ignored: "mcp.${pair[1]}" is set, and it wins`)
    }
  }

  const retention = find(cf, "log_retention_days")
  if (retention !== undefined) {
    cf = without(cf, ["log_retention_days"])
    clientChanged = true
    const lsRaw = find(top, "logs_store")
    if (lsRaw === undefined) {
      // Raiju's request log is on only with logs_store.enabled, so the retention waits for it
      put(&top, "logs_store", [{ key: "retention_days", raw: retention }])
      notes.push(`config: "client.log_retention_days" read as "logs_store.retention_days"; request logs stay off until "logs_store.enabled" is true`)
    } else {
      let ls = try members(lsRaw)
      if (find(ls, "retention_days") === undefined) {
        setField(&ls, "retention_days", retention)
        put(&top, "logs_store", ls)
        notes.push(`config: "client.log_retention_days" read as "logs_store.retention_days"`)
      } else {
        notes.push(`config: "client.log_retention_days" is ignored: "logs_store.retention_days" is set, and it wins`)
      }
    }
  }

  if (clientChanged) put(&top, "client", cf)
  if (mcpChanged) put(&top, "mcp", mcp)
}

// The name each Bifrost MCP client id goes by. Raiju's tool names start with it.
function clientNames(mf: Field[]): Map<string, string> throws SyntaxError {
  const out: Map<string, string> = new Map()
  for (const el of try items(find(mf, "client_configs"))) {
    const cf = try members(el)
    const id = rawStr(cf, "client_id")
    const name = rawStr(cf, "name")
    if (id !== undefined && name !== undefined) out.set(id, name)
  }
  return out
}

// One Bifrost virtual MCP as a Raiju VirtualMcp (src/vmcp.tov), or undefined when it is not loaded.
function virtualMcp(el: string, names: Map<string, string>, extraKeys: string[], inout notes: string[]): string | undefined throws SyntaxError {
  const f = try members(el)
  const name = rawStr(f, "endpoint_slug") ?? rawStr(f, "name")
  if (name === undefined || name === "") {
    notes.push(`config: a virtual MCP with no endpoint_slug or name is not loaded`)
    return undefined
  }
  if (rawBool(f, "enabled") === false) {
    notes.push(`config: virtual MCP "${name}" is disabled in Bifrost and is not loaded`)
    return undefined
  }
  let vf: Field[] = [{ key: "name", raw: quote(name) }]
  add(&vf, "description", strRaw(f, "description"))
  let tools: string[] = []
  for (const t of try items(find(f, "tools"))) {
    const tf = try members(t)
    let client: string | undefined = rawStr(tf, "mcp_client_name")
    if (client === undefined) {
      const id = rawStr(tf, "mcp_client_id")
      if (id !== undefined) client = names.get(id)
    }
    if (client === undefined) {
      notes.push(`config: virtual MCP "${name}" has a tool entry for an unknown MCP client, which is skipped`)
      continue
    }
    for (const tn of try strings(find(tf, "tool_names"))) {
      // "*" in Bifrost means every tool of the client, so it becomes Raiju's "<client>-*" pattern
      const src = tn === "*" ? `${client}-*` : `${client}-${tn}`
      tools.push(build([{ key: "source", raw: quote(src) }]))
    }
  }
  vf.push({ key: "tools", raw: "[" + tools.join(",") + "]" })
  // the keys the entry names, plus those its governance associations reach (tool groups)
  const ids = try strings(find(f, "virtual_key_ids"))
  for (const k of extraKeys) {
    if (!ids.includes(k)) ids.push(k)
  }
  if (find(f, "virtual_key_ids") !== undefined || extraKeys.length > 0) vf.push({ key: "allowed_keys", raw: "[" + ids.map((x: string): string => quote(x)).join(",") + "]" })
  return build(vf)
}

// A Go duration or a bare number of seconds, as Bifrost's tool_execution_timeout and tool_sync_interval
// take them, as whole seconds (a number of nanoseconds, the legacy form of tool_sync_interval, is
// converted too when nanos is set).
function secondsOf(raw: string, nanos: bool): int throws SyntaxError {
  if (raw.startsWith("\"")) return Math.floor(durationMsOf(try decodeString(raw)) / 1000)
  const n = parseFloat(raw) ?? 0.0
  return Math.floor(nanos ? n / 1000000000.0 : n)
}

// The client_configs entries with their durations as Go duration strings ("45s"): a bare
// tool_execution_timeout is seconds, and a tool_sync_interval number is nanoseconds.
function clientItems(raw: string | undefined): string[] throws SyntaxError {
  const out: string[] = []
  for (const el of try items(raw)) {
    let f = try members(el)
    const to = find(f, "tool_execution_timeout")
    if (to !== undefined && !to.startsWith("\"") && !isNull(to)) {
      const toSecs = try secondsOf(to, false)
      setField(&f, "tool_execution_timeout", quote(`${toSecs}s`))
    }
    const ts = find(f, "tool_sync_interval")
    if (ts !== undefined && !ts.startsWith("\"") && !isNull(ts)) {
      const tsSecs = try secondsOf(ts, true)
      setField(&f, "tool_sync_interval", quote(`${tsSecs}s`))
    }
    out.push(build(f))
  }
  return out
}

// The keys a tool group's governance associations reach (Bifrost's deprecated team_ids, customer_ids and
// provider_names): every virtual key of those teams, customers or providers.
function groupKeyIds(f: Field[], top: Field[]): string[] throws SyntaxError {
  const teams = try strings(find(f, "team_ids"))
  const customers = try strings(find(f, "customer_ids"))
  const providers = try strings(find(f, "provider_names"))
  const out: string[] = []
  if (teams.length === 0 && customers.length === 0 && providers.length === 0) return out
  const gov = try members(find(top, "governance"))
  for (const vr of try items(find(gov, "virtual_keys"))) {
    const vf = try members(vr)
    const id = rawStr(vf, "id")
    if (id === undefined) continue
    const team = rawStr(vf, "team_id") ?? ""
    const cust = rawStr(vf, "customer_id") ?? ""
    let hit = (team !== "" && teams.includes(team)) || (cust !== "" && customers.includes(cust))
    for (const pc of try items(find(vf, "provider_configs"))) {
      const p = rawStr(try members(pc), "provider")
      if (p !== undefined && providers.includes(p)) hit = true
    }
    if (hit) out.push(id)
  }
  return out
}

// mcp.tool_manager_config: Bifrost's runtime settings. Each one Raiju keeps under its own name is moved
// there when that name is unset; the rest are reported.
function mapToolManager(inout top: Field[], inout mf: Field[], inout notes: string[]): void throws SyntaxError {
  const tm = find(mf, "tool_manager_config")
  if (tm === undefined) return
  mf = without(mf, ["tool_manager_config"])
  const tf = try members(tm)
  const to = find(tf, "tool_execution_timeout")
  if (to !== undefined && !isNull(to)) {
    if (find(mf, "tool_execution_timeout_seconds") === undefined) {
      const toSecs = try secondsOf(to, false)
      setField(&mf, "tool_execution_timeout_seconds", `${toSecs}`)
      notes.push(`config: "mcp.tool_manager_config.tool_execution_timeout" read as "mcp.tool_execution_timeout_seconds"`)
    } else {
      notes.push(`config: "mcp.tool_manager_config.tool_execution_timeout" is ignored: "mcp.tool_execution_timeout_seconds" is set, and it wins`)
    }
  }
  const allow = find(tf, "oauth_private_allowlist")
  if (allow !== undefined && !isNull(allow)) {
    if (find(mf, "oauth_private_allowlist") === undefined) setField(&mf, "oauth_private_allowlist", allow)
  }
  const depth = find(tf, "max_agent_depth")
  const dis = find(tf, "disable_auto_tool_inject")
  if (depth !== undefined || dis !== undefined) {
    let cl = try members(find(top, "client"))
    let changed = false
    if (depth !== undefined && !isNull(depth) && find(cl, "mcp_agent_depth") === undefined) {
      setField(&cl, "mcp_agent_depth", depth)
      changed = true
    }
    if (dis !== undefined && !isNull(dis) && find(cl, "mcp_disable_auto_tool_inject") === undefined) {
      setField(&cl, "mcp_disable_auto_tool_inject", dis)
      changed = true
    }
    if (changed) put(&top, "client", cl)
    notes.push(`config: "mcp.tool_manager_config" max_agent_depth and disable_auto_tool_inject are read as "client.mcp_agent_depth" and "client.mcp_disable_auto_tool_inject"`)
  }
  for (const k of ["max_instructions_per_client", "max_instructions_total"]) {
    if (find(tf, k) !== undefined) notes.push(`config: "mcp.tool_manager_config.${k}" is not implemented: Raiju does not forward MCP server instructions`)
  }
  for (const k of ["code_mode_binding_level", "code_mode_limits"]) {
    if (find(tf, k) !== undefined) notes.push(`config: "mcp.tool_manager_config.${k}" is out of scope: MCP code mode (SCOPE.md)`)
  }
  const known = toolManagerKeys()
  for (const f of tf) {
    if (!known.includes(f.key)) notes.push(`config: "mcp.tool_manager_config.${f.key}" is not implemented: Raiju has no such tool manager setting`)
  }
}

// mcp.virtual_mcps becomes the top-level virtual_mcps list. mcp.tool_groups is the deprecated Bifrost
// name for the same list (enterprise tool groups): each group also reaches the virtual keys of the teams,
// customers and providers it names, as its governance associations do.
function mapMcp(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const raw = find(top, "mcp")
  if (raw === undefined) return
  let mf = try members(raw)
  let changed = false
  const cc = find(mf, "client_configs")
  if (cc !== undefined) {
    const citems = try clientItems(cc)
    setField(&mf, "client_configs", "[" + citems.join(",") + "]")
    changed = true
  }
  const ts = find(mf, "tool_sync_interval")
  if (ts !== undefined && !ts.startsWith("\"") && !isNull(ts)) {
    const tsSecs = try secondsOf(ts, true)
    setField(&mf, "tool_sync_interval", quote(`${tsSecs}s`))
    changed = true
  }
  if (find(mf, "tool_manager_config") !== undefined) changed = true
  try mapToolManager(&top, &mf, &notes)
  const vraw = find(mf, "virtual_mcps")
  const graw = find(mf, "tool_groups")
  if (vraw !== undefined || graw !== undefined) {
    mf = without(mf, ["virtual_mcps", "tool_groups"])
    changed = true
    if (find(top, "virtual_mcps") !== undefined) {
      notes.push(`config: "mcp.virtual_mcps" is ignored: "virtual_mcps" is set, and it wins`)
    } else {
      if (vraw !== undefined) {
        notes.push(`config: "mcp.virtual_mcps" read as "virtual_mcps"`)
        if (graw !== undefined) notes.push(`config: "mcp.tool_groups" is ignored: "mcp.virtual_mcps" is set, and it wins`)
      } else {
        notes.push(`config: "mcp.tool_groups" read as "virtual_mcps" (deprecated in Bifrost)`)
      }
      const names = try clientNames(try members(raw))
      let vms: string[] = []
      for (const el of try items(vraw ?? graw)) {
        const f = try members(el)
        let extra: string[] = []
        if (vraw === undefined) {
          extra = try groupKeyIds(f, top)
          for (const u of ["user_ids", "api_key_ids"]) {
            const uv = find(f, u)
            if (uv !== undefined && !isNull(uv)) notes.push(`config: "mcp.tool_groups" ${u} is not applied: Raiju's virtual keys have no ${u === "user_ids" ? "user" : "API key"} ids`)
          }
        }
        const vm = try virtualMcp(el, names, extra, &notes)
        if (vm !== undefined) vms.push(vm)
      }
      setField(&top, "virtual_mcps", "[" + vms.join(",") + "]")
    }
  }
  if (changed) put(&top, "mcp", mf)
}

// alerting becomes alerts. Raiju's metric rules are separate, so Bifrost's CEL rules
// load as cel_rules; channels carry over when Raiju can send to them.
function mapAlerting(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const raw = find(top, "alerting")
  if (raw === undefined) return
  top = without(top, ["alerting"])
  if (find(top, "alerts") !== undefined) {
    notes.push(`config: "alerting" is ignored: "alerts" is set, and it wins`)
    return
  }
  notes.push(`config: "alerting" read as "alerts"`)
  const af = try members(raw)
  let channels: string[] = []
  let skipped = 0
  for (const el of try items(find(af, "channels"))) {
    const cf = try members(el)
    const kind = rawStr(cf, "type") ?? ""
    const conf = try members(find(cf, "config"))
    const url = strRaw(conf, "url") ?? strRaw(conf, "webhook_url")
    const key = strRaw(conf, "routing_key") ?? strRaw(conf, "integration_key")
    const known = kind === "slack" || kind === "webhook" || kind === "microsoft_teams" || kind === "pagerduty"
    if (rawBool(cf, "enabled") === false || !known || (kind === "pagerduty" ? key === undefined : url === undefined)) {
      skipped += 1
      continue
    }
    let ch: Field[] = []
    add(&ch, "id", strRaw(cf, "id") ?? quote(`channel-${channels.length + 1}`))
    add(&ch, "name", strRaw(cf, "name"))
    add(&ch, "type", quote(kind))
    add(&ch, "url", url ?? quote(""))
    if (kind === "webhook") add(&ch, "headers", find(conf, "headers"))
    if (kind === "pagerduty") add(&ch, "routing_key", key)
    add(&ch, "cooldown_seconds", find(cf, "cooldown_seconds"))
    channels.push(build(ch))
  }
  if (skipped > 0) notes.push(`config: ${skipped} alerting channel(s) skipped: a channel needs to be enabled, of a known type, and have a url (a routing_key for pagerduty)`)
  let celRules: string[] = []
  let badRules = 0
  for (const el of try items(find(af, "rules"))) {
    const rf = try members(el)
    const id = strRaw(rf, "id")
    const scopeType = strRaw(rf, "scope_type")
    const scopeId = strRaw(rf, "scope_id")
    const expr = strRaw(rf, "cel_expression")
    const chans = find(rf, "channel_ids")
    const chanIds = try items(chans)
    if (id === undefined || scopeId === undefined || expr === undefined || !scopeKindRaw(scopeType) || chanIds.length === 0) {
      badRules += 1
      continue
    }
    let rl: Field[] = []
    add(&rl, "id", id)
    add(&rl, "name", strRaw(rf, "name") ?? id)
    add(&rl, "description", strRaw(rf, "description"))
    add(&rl, "enabled", find(rf, "enabled"))
    add(&rl, "scope_type", scopeType)
    add(&rl, "scope_id", scopeId)
    add(&rl, "cel_expression", expr)
    add(&rl, "channel_ids", chans)
    add(&rl, "cooldown_seconds", find(rf, "cooldown_seconds"))
    add(&rl, "notify_once_per_reset_cycle", find(rf, "notify_once_per_reset_cycle"))
    add(&rl, "target_type", strRaw(rf, "target_type"))
    add(&rl, "target_id", strRaw(rf, "target_id"))
    celRules.push(build(rl))
  }
  if (badRules > 0) notes.push(`config: ${badRules} alerting rule(s) skipped: a rule needs an id, a scope_type of virtual_key, team or customer, a scope_id, a cel_expression and channel_ids`)
  ignored("alerting", af, ["history_retention_days", "webhook_network"], &notes)
  let out: Field[] = []
  add(&out, "channels", "[" + channels.join(",") + "]")
  add(&out, "rules", "[]")
  add(&out, "cel_rules", "[" + celRules.join(",") + "]")
  put(&top, "alerts", out)
}

// Bifrost's scope_type values, as quoted JSON text.
function scopeKindRaw(raw: string | undefined): bool {
  return raw === "\"virtual_key\"" || raw === "\"team\"" || raw === "\"customer\""
}

// audit_logs becomes audit. Bifrost's disabled flag is the inverse of Raiju's enabled.
function mapAudit(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const raw = find(top, "audit_logs")
  if (raw === undefined) return
  top = without(top, ["audit_logs"])
  if (find(top, "audit") !== undefined) {
    notes.push(`config: "audit_logs" is ignored: "audit" is set, and it wins`)
    return
  }
  notes.push(`config: "audit_logs" read as "audit"`)
  const af = try members(raw)
  let out: Field[] = []
  add(&out, "enabled", rawBool(af, "disabled") === true ? "false" : "true")
  const key = strRaw(af, "hmac_key")
  add(&out, "key", key)
  if (key === undefined || key === "\"\"") notes.push(`config: "audit_logs.hmac_key" is not set, so audit entries are signed with an empty key`)
  add(&out, "retention_days", find(af, "retention_days"))
  add(&out, "omit_ip_addresses", find(af, "omit_ip_addresses"))
  const grace = try durationSecondsRaw(find(af, "archive_grace_period"))
  add(&out, "archive_grace_seconds", grace)
  // object_storage archives the events (archive_interval is the window): the S3 or GCS fields as LogExportsConfig reads them
  const os = find(af, "object_storage")
  if (os !== undefined) {
    const of = try members(os)
    let ar: Field[] = []
    add(&ar, "enabled", "true")
    add(&ar, "kind", find(of, "type") ?? "\"s3\"")
    add(&ar, "bucket", find(of, "bucket"))
    add(&ar, "prefix", find(of, "prefix"))
    add(&ar, "region", find(of, "region"))
    add(&ar, "endpoint", find(of, "endpoint"))
    add(&ar, "access_key_id", find(of, "access_key_id"))
    add(&ar, "secret_access_key", find(of, "secret_access_key"))
    add(&ar, "session_token", find(of, "session_token"))
    add(&ar, "path_style", find(of, "path_style"))
    const interval = try durationSecondsRaw(find(af, "archive_interval"))
    add(&ar, "interval_seconds", interval)
    add(&out, "archive", build(ar))
    if (find(of, "compress") !== undefined) notes.push(`config: "audit_logs.object_storage.compress" is ignored: archive objects are plain JSONL`)
  }
  ignored("audit_logs", af, ["archive_max_object_bytes"], &notes)
  put(&top, "audit", out)
}

// A Go duration (a JSON string) as a raw number of seconds; undefined when it is not one.
function durationSecondsRaw(raw: string | undefined): string | undefined throws SyntaxError {
  if (raw === undefined || !raw.startsWith("\"")) return undefined
  const ms = durationMsOf(try decodeString(raw))
  if (ms <= 0) return undefined
  return `${Math.floor(ms / 1000)}`
}

// cluster_config becomes cluster. Raiju signs cluster sync with cluster.secret, which Bifrost
// does not have, so the cluster stays off until a secret is set. In broker mode the secret is the
// broker's auth_token (Bifrost's shared secret), and the nodes sync through the broker, not peers.
function mapCluster(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const raw = find(top, "cluster_config")
  if (raw === undefined) return
  top = without(top, ["cluster_config"])
  if (find(top, "cluster") !== undefined) {
    notes.push(`config: "cluster_config" is ignored: "cluster" is set, and it wins`)
    return
  }
  notes.push(`config: "cluster_config" read as "cluster"`)
  const cf = try members(raw)
  let enabled = rawBool(cf, "enabled") === true
  const broker = rawStr(cf, "type") === "broker"
  const bf = try members(find(cf, "broker"))
  let secret: string | undefined = undefined
  if (enabled && broker) {
    for (const f of bf) {
      if (!["address", "tls", "auth_token", "listen_port"].includes(f.key)) notes.push(`config: "cluster_config.broker.${f.key}" is not supported by Raiju and is ignored`)
    }
    const token = rawStr(bf, "auth_token")
    if (token !== undefined && token !== "") {
      secret = quote(token)
      notes.push(`config: "cluster_config.broker.auth_token" is read as "cluster.secret"`)
    }
    if (strRaw(bf, "address") === undefined) {
      notes.push(`config: "cluster_config.broker.address" is not set; cluster sync is off`)
      enabled = false
    }
  }
  if (enabled && secret === undefined) {
    notes.push(`config: "cluster_config" has no shared secret, which Raiju needs for cluster sync; cluster sync is off until "cluster.secret" is set`)
    enabled = false
  }
  ignored("cluster_config", cf, ["region", "gossip", "grpc"], &notes)
  if (!broker) ignored("cluster_config", cf, ["broker"], &notes)
  let out: Field[] = []
  add(&out, "enabled", enabled ? "true" : "false")
  add(&out, "peers", find(cf, "peers") ?? "[]")
  if (enabled && broker) {
    add(&out, "type", quote("broker"))
    let bo: Field[] = []
    add(&bo, "address", strRaw(bf, "address"))
    add(&bo, "tls", find(bf, "tls"))
    add(&bo, "listen_port", find(bf, "listen_port"))
    add(&out, "broker", build(bo))
  }
  add(&out, "secret", secret)
  // the discovery block has the same names in both (kubernetes, dns, consul, etcd, udp, mdns)
  add(&out, "discovery", find(cf, "discovery"))
  put(&top, "cluster", out)
}

// scim_config's authProxy becomes auth_proxy: Bifrost's camelCase names, Raiju's snake_case.
// The rest of scim_config (the SCIM and SSO provider settings) is not read by Raiju.
function mapAuthProxy(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const raw = find(top, "scim_config")
  if (raw === undefined) return
  top = without(top, ["scim_config"])
  const sf = try members(raw)
  if (rawBool(sf, "enabled") !== true) {
    if (find(sf, "config") !== undefined) notes.push(`config: "scim_config" is off, so its authProxy is off too`)
    return
  }
  notes.push(`config: "scim_config" is read for its authProxy only; SCIM and SSO provider settings are not supported by Raiju`)
  const apRaw = find(try members(find(sf, "config")), "authProxy")
  if (apRaw === undefined) return
  const pf = try members(apRaw)
  let out: Field[] = []
  add(&out, "enabled", rawBool(pf, "enabled") === true ? "true" : "false")
  add(&out, "provider", strRaw(pf, "provider") ?? "\"cloudflare-access\"")
  add(&out, "mode", strRaw(pf, "mode") ?? "\"login_only\"")
  const renames: string[][] = [["expectedSigner", "expected_signer"], ["region", "region"], ["publicKeyBaseUrl", "public_key_base_url"], ["issuerUrl", "issuer_url"], ["audience", "audience"], ["allowedAudiences", "allowed_audiences"], ["headerName", "header_name"], ["jwksUrl", "jwks_url"], ["userIdClaim", "user_id_claim"]]
  for (const r of renames) {
    const v = find(pf, r[0]!)
    if (v === undefined) continue
    if (v.includes("vault.") || v.includes("aws-sm.")) {
      notes.push(`config: "authProxy.${r[0]}" uses a secret reference, which Raiju does not resolve; use env.VAR_NAME`)
      continue
    }
    add(&out, r[1]!, v)
  }
  for (const f of pf) {
    if (f.key === "enabled" || f.key === "provider" || f.key === "mode") continue
    if (!renames.some((r) => r[0] === f.key)) notes.push(`config: "scim_config.config.authProxy.${f.key}" is not supported by Raiju and is ignored`)
  }
  put(&top, "auth_proxy", out)
}

// circuit_breaker_config.policies is Raiju's circuit_breaker_policies, the same shape: the header
// signals, the cooldowns and the fallbacks are read by health.tov. load_balancer_config feeds the
// health section as health.adaptive.
function mapHealth(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const cbRaw = find(top, "circuit_breaker_config")
  const lbRaw = find(top, "load_balancer_config")
  if (cbRaw === undefined && lbRaw === undefined) return
  top = without(top, ["circuit_breaker_config", "load_balancer_config"])
  if (cbRaw !== undefined) {
    const pols = find(try members(cbRaw), "policies")
    if (pols !== undefined && find(top, "circuit_breaker_policies") === undefined) {
      notes.push(`config: "circuit_breaker_config" read as "circuit_breaker_policies"`)
      setField(&top, "circuit_breaker_policies", pols)
    }
  }
  if (lbRaw === undefined) return
  if (find(top, "health") !== undefined) {
    notes.push(`config: "load_balancer_config" is ignored: "health" is set, and it wins`)
    return
  }
  let hc: Field[] = []
  notes.push(`config: "load_balancer_config" read as "health.adaptive"`)
  const lf = try members(lbRaw)
  const on = rawBool(lf, "enabled") === true && rawBool(lf, "route_selection_enabled") !== false
  add(&hc, "adaptive", on ? "true" : "false")
  ignored("load_balancer_config", lf, ["direction_selection_enabled", "append_fallbacks_to_pinned", "reroute_failed_directions", "prune_failed_fallbacks", "tracker_config", "bootstrap"], &notes)
  put(&top, "health", hc)
}

// framework.pricing's pricing_url and pricing_sync_interval become pricing_sync.
// framework itself stays as written.
function mapPricing(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const fw = try members(find(top, "framework"))
  const praw = find(fw, "pricing")
  if (praw === undefined) return
  const pf = try members(praw)
  ignored("framework.pricing", pf, ["model_parameters_url", "mcp_library_url", "mcp_library_sync_interval", "live_models_sync_interval"], &notes)
  const url = strRaw(pf, "pricing_url")
  const iv = find(pf, "pricing_sync_interval")
  if (url === undefined && iv === undefined) return
  if (find(top, "pricing_sync") !== undefined) {
    notes.push(`config: "framework.pricing" is ignored: "pricing_sync" is set, and it wins`)
    return
  }
  notes.push(`config: "framework.pricing" read as "pricing_sync"`)
  let out: Field[] = []
  add(&out, "url", url)
  add(&out, "interval_seconds", iv)
  put(&top, "pricing_sync", out)
}

// A semantic_cache plugin entry becomes the top-level semantic_cache section.
// Bifrost's ttl may be a duration string; Raiju's is seconds.
function semanticCache(f: Field[], pname: string, inout top: Field[], inout notes: string[]): void throws SyntaxError {
  if (find(top, "semantic_cache") !== undefined) {
    notes.push(`config: plugin "${pname}" is ignored: "semantic_cache" is set, and it wins`)
    return
  }
  const cf = try members(find(f, "config"))
  const provider = strRaw(cf, "provider")
  const model = strRaw(cf, "embedding_model")
  if (provider === undefined || model === undefined) {
    notes.push(`config: plugin "${pname}" needs both provider and embedding_model; it is not loaded`)
    return
  }
  notes.push(`config: plugin "${pname}" read as "semantic_cache"`)
  let out: Field[] = []
  add(&out, "enabled", find(f, "enabled"))
  add(&out, "provider", provider)
  add(&out, "embedding_model", model)
  for (const k of ["threshold", "conversation_history_threshold", "exclude_system_prompt", "cache_by_model", "cache_by_provider", "cache_tool_call_responses", "disable_identity_scoping", "default_cache_key", "vector_store_namespace", "dimension"]) {
    add(&out, k, find(cf, k))
  }
  const ttl = find(cf, "ttl")
  if (ttl !== undefined) {
    if (ttl.startsWith("\"")) {
      const secs = goSeconds(try decodeString(ttl))
      if (secs === undefined) notes.push(`config: plugin "${pname}" has an unreadable ttl; Raiju's default is used`)
      else add(&out, "ttl", `${secs}`)
    } else {
      add(&out, "ttl", ttl)
    }
  }
  put(&top, "semantic_cache", out)
}

// The top-level vector_store section, read for the stores Raiju has a client for: qdrant
// (over REST), redis (over RESP), weaviate, pinecone, and chromem (in process). Any other
// type is dropped, and the semantic cache keeps its entries in memory.
function mapVectorStore(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const raw = find(top, "vector_store")
  if (raw === undefined) return
  const vf = try members(raw)
  const type = rawStr(vf, "type") ?? ""
  const cf = try members(find(vf, "config"))
  let out: Field[] = []
  add(&out, "enabled", find(vf, "enabled"))
  if (type !== "qdrant" && type !== "redis" && type !== "weaviate" && type !== "pinecone" && type !== "chromem") {
    notes.push(`config: "vector_store.type" ${quote(type)} is not supported by Raiju; the semantic cache keeps its entries in memory`)
    top = without(top, ["vector_store"])
    return
  }
  add(&out, "type", find(vf, "type"))
  let c: Field[] = []
  if (type === "qdrant") {
    add(&c, "host", strRaw(cf, "host"))
    add(&c, "api_key", strRaw(cf, "api_key"))
    add(&c, "rest_port", find(cf, "rest_port"))
    add(&c, "use_tls", find(cf, "use_tls"))
    if (find(cf, "port") !== undefined) notes.push(`config: "vector_store.config.port" is the gRPC port in Bifrost, and Raiju uses Qdrant's REST API; the REST port is "vector_store.config.rest_port" (default 6333)`)
    ignored("vector_store.config", cf, ["max_recv_msg_size_mb"], &notes)
  } else if (type === "weaviate") {
    add(&c, "scheme", strRaw(cf, "scheme"))
    add(&c, "host", strRaw(cf, "host"))
    add(&c, "api_key", strRaw(cf, "api_key"))
    ignored("vector_store.config", cf, ["grpc_config", "headers", "timeout"], &notes)
  } else if (type === "pinecone") {
    add(&c, "api_key", strRaw(cf, "api_key"))
    add(&c, "index_host", strRaw(cf, "index_host"))
  } else if (type === "chromem") {
    add(&c, "path", strRaw(cf, "path"))
    ignored("vector_store.config", cf, ["compress"], &notes)
  } else {
    add(&c, "addr", strRaw(cf, "addr"))
    add(&c, "username", strRaw(cf, "username"))
    add(&c, "password", strRaw(cf, "password"))
    add(&c, "db", find(cf, "db"))
    add(&c, "use_tls", find(cf, "use_tls"))
    if (rawBool(cf, "cluster_mode") === true) notes.push(`config: "vector_store.config.cluster_mode" is not supported by Raiju and is ignored: the store is read as a single node`)
    if (rawBool(cf, "insecure_skip_verify") === true || find(cf, "ca_cert_pem") !== undefined) notes.push(`config: TLS for the vector store checks the server certificate against the system CA bundle; "vector_store.config.ca_cert_pem" and "insecure_skip_verify" are not supported and are ignored`)
    ignored("vector_store.config", cf, ["pool_size", "max_active_conns", "min_idle_conns", "max_idle_conns", "conn_max_lifetime", "conn_max_idle_time", "dial_timeout", "read_timeout", "write_timeout"], &notes)
  }
  out.push({ key: "config", raw: build(c) })
  put(&top, "vector_store", out)
}

// A collector address as the otel section takes it. An OTLP/HTTP URL: a bare host:port
// gets http://, and a trace URL with no path gets /v1/traces. A gRPC collector (protocol
// "grpc") keeps its host:port as written, since its address has no scheme or path.
function otelUrl(raw: string, grpc: bool, tracePath: bool, label: string, inout notes: string[]): string {
  if (grpc) return raw
  let u = raw
  if (!u.includes("://")) {
    u = "http://" + u
    notes.push(`config: "${label}" has no scheme; http:// is assumed`)
  }
  const parts = u.split("/")
  const noPath = parts.length <= 3 || (parts.length === 4 && parts[3] === "")
  let out = u
  if (tracePath && noPath) {
    if (out.endsWith("/")) out = out.slice(0, out.byteLength - 1)
    out = out + "/v1/traces"
  }
  return out
}

// The Bifrost otel plugin entry becomes the top-level otel section. Its config is a
// profiles wrapper or one flat profile; the first enabled profile is read. Bifrost's
// trace and metrics headers, timeout, TLS and request header settings carry over.
function mapOtelPlugin(f: Field[], pname: string, inout top: Field[], inout notes: string[]): void throws SyntaxError {
  if (rawBool(f, "enabled") === false) {
    notes.push(`config: plugin "${pname}" is disabled in Bifrost and is not loaded`)
    return
  }
  if (find(top, "otel") !== undefined) {
    notes.push(`config: plugin "${pname}" is ignored: "otel" is set, and it wins`)
    return
  }
  const path = `plugins[${pname}].config`
  const cf = try members(find(f, "config"))
  let prof: Field[] = cf
  if (find(cf, "profiles") !== undefined) {
    let en: Field[][] = []
    for (const el of try items(find(cf, "profiles"))) {
      const pf = try members(el)
      if (rawBool(pf, "enabled") !== false) en.push(pf)
    }
    if (en.length === 0) {
      notes.push(`config: plugin "${pname}" has no enabled profile; it is not loaded`)
      return
    }
    if (en.length > 1) notes.push(`config: plugin "${pname}" has ${en.length - 1} more enabled profile(s); Raiju exports the first only`)
    prof = en[0]!
  }
  // trace_type has no effect in Bifrost either (only the genai_extension value exists)
  ignored(path, prof, ["trace_type", "export_raw_payloads"], &notes)

  const traces = rawBool(prof, "traces_enabled") !== false
  const grpc = rawStr(prof, "protocol") === "grpc"
  const https = (strRaw(prof, "collector_url") ?? "").includes("https://")
  let out: Field[] = []
  let endpoint = ""
  const coll = strRaw(prof, "collector_url")
  if (traces) {
    if (coll === undefined) notes.push(`config: plugin "${pname}" has traces on and no collector_url; traces are not exported`)
    else endpoint = otelUrl(try decodeString(coll), grpc, true, "collector_url", &notes)
  }
  add(&out, "endpoint", quote(endpoint))
  if (grpc) add(&out, "protocol", quote("grpc"))
  if (!traces) add(&out, "traces_enabled", "false")
  add(&out, "service_name", strRaw(prof, "service_name") ?? quote("bifrost"))
  add(&out, "headers", find(prof, "headers"))
  add(&out, "trace_headers", find(prof, "trace_headers"))
  add(&out, "metrics_headers", find(prof, "metrics_headers"))
  // Bifrost's default trace export timeout is 5 seconds
  add(&out, "export_timeout", find(prof, "export_timeout") ?? "5")
  add(&out, "metrics_enabled", find(prof, "metrics_enabled"))
  add(&out, "metrics_push_interval", find(prof, "metrics_push_interval"))
  const mep = strRaw(prof, "metrics_endpoint")
  if (mep !== undefined) add(&out, "metrics_endpoint", quote(otelUrl(try decodeString(mep), grpc, false, "metrics_endpoint", &notes)))
  add(&out, "request_headers", find(prof, "request_headers"))
  add(&out, "excluded_attributes", find(prof, "excluded_attributes"))
  add(&out, "disable_content_logging", find(prof, "disable_content_logging"))
  // Bifrost reads the span filter and export_overhead_spans from the wrapper, or hoists them from the profile
  add(&out, "plugin_span_filter", find(cf, "plugin_span_filter") ?? find(prof, "plugin_span_filter"))
  add(&out, "export_overhead_spans", find(cf, "export_overhead_spans") ?? find(prof, "export_overhead_spans"))
  add(&out, "group_traces_by_session", find(prof, "group_traces_by_session"))
  add(&out, "disable_root_span_content", find(prof, "disable_root_span_content"))
  add(&out, "overhead_breakdown_enabled", find(prof, "overhead_breakdown_enabled"))
  add(&out, "tls_ca_cert", strRaw(prof, "tls_ca_cert"))
  const ins = find(prof, "insecure")
  if (ins !== undefined) {
    add(&out, "insecure", ins)
  } else if (https) {
    notes.push(`config: plugin "${pname}" has no "insecure"; Raiju verifies the collector's certificate, where Bifrost skips verification when it is omitted`)
  }
  put(&top, "otel", out)
  notes.push(`config: plugin "${pname}" read as "otel"`)
}

// The Bifrost log sink plugins (bigquery, pubsub, kafka, maxim) become entries in
// Raiju's exporters list. Bifrost sends content unless disable_content_logging is
// set, so include_content follows that. The Kafka plugin's SCRAM and custom CA
// settings have no Raiju counterpart, so such a plugin is not loaded.
function mapSinkPlugin(f: Field[], pname: string, inout top: Field[], inout notes: string[]): void throws SyntaxError {
  if (offPlugin(f, pname, &notes)) return
  const path = `plugins[${pname}].config`
  const cf = try members(find(f, "config"))
  let out: Field[] = []
  add(&out, "id", quote(pname))
  add(&out, "kind", quote(pname))
  add(&out, "include_content", rawBool(cf, "disable_content_logging") === true ? "false" : "true")
  if (pname === "bigquery") {
    add(&out, "project_id", strRaw(cf, "project_id"))
    add(&out, "dataset_id", strRaw(cf, "dataset_id"))
    add(&out, "table_id", strRaw(cf, "table_id"))
    add(&out, "service_account_key", strRaw(cf, "service_account_key"))
    add(&out, "batch_size", find(cf, "buffer_size"))
    add(&out, "interval_seconds", find(cf, "flush_interval_seconds"))
    ignored(path, cf, ["location", "create_table_if_not_exists", "excluded_attributes", "export_raw_payloads", "request_headers", "custom_labels", "plugin_span_filter"], &notes)
  } else if (pname === "pubsub") {
    add(&out, "project_id", strRaw(cf, "project_id"))
    add(&out, "topic_id", strRaw(cf, "topic_id"))
    add(&out, "service_account_key", strRaw(cf, "service_account_key"))
    ignored(path, cf, ["auto_create_topic", "excluded_attributes", "request_headers", "plugin_span_filter"], &notes)
  } else if (pname === "kafka") {
    const sasl = try members(find(cf, "sasl"))
    if (rawBool(cf, "sasl_enabled") === true) {
      const mech = rawStr(sasl, "mechanism") ?? ""
      if (mech !== "PLAIN") {
        notes.push(`config: plugin "${pname}" uses SASL ${mech}; Raiju supports PLAIN only, so the plugin is not loaded`)
        return
      }
      add(&out, "sasl_username", strRaw(sasl, "username"))
      add(&out, "sasl_password", strRaw(sasl, "password"))
    }
    if (rawBool(cf, "tls_enabled") === true) add(&out, "tls", "true")
    const comp = rawStr(cf, "compression")
    if (comp !== undefined && comp !== "\"none\"") notes.push(`config: "${path}.compression" is not supported by Raiju (records are sent uncompressed)`)
    if (find(cf, "ca_cert") !== undefined) notes.push(`config: "${path}.ca_cert" is not supported by Raiju; the system CA pool is used`)
    add(&out, "brokers", find(cf, "brokers"))
    add(&out, "topic", strRaw(cf, "topic"))
    add(&out, "batch_size", find(cf, "batch_size"))
    const ms = rawNum(cf, "flush_interval_ms")
    if (ms !== undefined) {
      const secs = Math.max(1, Math.ceil(ms / 1000))
      add(&out, "interval_seconds", `${secs}`)
      if (ms % 1000 !== 0) notes.push(`config: "${path}.flush_interval_ms" is rounded up to ${secs} second(s)`)
    }
    ignored(path, cf, ["auto_create_topic", "excluded_attributes", "request_headers", "plugin_span_filter"], &notes)
  } else {
    add(&out, "api_key", strRaw(cf, "api_key"))
    add(&out, "log_repo_id", strRaw(cf, "log_repo_id"))
    ignored(path, cf, ["request_headers"], &notes)
  }
  ignored(path, cf, ["disable_content_logging"], &notes)
  const cur = try items(find(top, "exporters"))
  cur.push(build(out))
  setField(&top, "exporters", "[" + cur.join(",") + "]")
  notes.push(`config: plugin "${pname}" read as exporter "${pname}"`)
}

// True when the plugin entry is off in Bifrost; the note says it is not loaded.
function offPlugin(f: Field[], pname: string, inout notes: string[]): bool {
  if (rawBool(f, "enabled") !== false) return false
  notes.push(`config: plugin "${pname}" is disabled in Bifrost and is not loaded`)
  return true
}

// Sets client.<target> from a plugin config field, unless the client section already sets it.
// A value that is taken goes into applied, for the note on the plugin.
function toClient(inout cl: Field[], path: string, src: string, target: string, raw: string | undefined, inout applied: string[], inout notes: string[]): void {
  if (raw === undefined) return
  if (find(cl, target) !== undefined) {
    notes.push(`config: "${path}.${src}" is ignored: "client.${target}" is set, and it wins`)
    return
  }
  setField(&cl, target, raw)
  applied.push(target)
}

// Bifrost's logging plugin: its content settings go to the client section, and an enabled
// plugin turns request logging on (Raiju's default too).
function mapLogging(f: Field[], pname: string, inout top: Field[], inout notes: string[]): void throws SyntaxError {
  if (offPlugin(f, pname, &notes)) return
  const path = `plugins[${pname}].config`
  const cf = try members(find(f, "config"))
  let cl = try members(find(top, "client"))
  let applied: string[] = []
  if (find(cl, "enable_logging") === undefined) {
    setField(&cl, "enable_logging", "true")
    applied.push("enable_logging")
  }
  toClient(&cl, path, "disable_content_logging", "disable_content_logging", find(cf, "disable_content_logging"), &applied, &notes)
  toClient(&cl, path, "allow_per_request_content_storage_override", "allow_per_request_content_storage_override", find(cf, "allow_per_request_content_storage_override"), &applied, &notes)
  ignored(path, cf, ["retain_content_in_object_storage", "logging_headers"], &notes)
  if (applied.length > 0) {
    put(&top, "client", cl)
    notes.push(`config: plugin "${pname}" read into "client": ${applied.join(", ")}`)
  }
}

// Bifrost's telemetry plugin: custom_labels become client.prometheus_labels. Raiju always
// serves /metrics and has no overhead breakdown, user labels or Push Gateway.
function mapTelemetry(f: Field[], pname: string, inout top: Field[], inout notes: string[]): void throws SyntaxError {
  if (offPlugin(f, pname, &notes)) return
  const path = `plugins[${pname}].config`
  const cf = try members(find(f, "config"))
  let cl = try members(find(top, "client"))
  let applied: string[] = []
  toClient(&cl, path, "custom_labels", "prometheus_labels", find(cf, "custom_labels"), &applied, &notes)
  if (rawBool(cf, "metrics_enabled") === false) notes.push(`config: "${path}.metrics_enabled" is not supported by Raiju and is ignored: Raiju always serves /metrics`)
  // push_gateway keeps Bifrost's shape under telemetry.push_gateway (pushgateway.tov)
  // the overhead split and user labels are telemetry's own switches (metrics.tov setTelemetry)
  const pg = find(cf, "push_gateway")
  const ob = find(cf, "overhead_breakdown_enabled")
  const ul = find(cf, "user_labels_enabled")
  if (pg !== undefined || ob !== undefined || ul !== undefined) {
    let tel = try members(find(top, "telemetry"))
    if (pg !== undefined) setField(&tel, "push_gateway", pg)
    if (ob !== undefined) setField(&tel, "overhead_breakdown_enabled", ob)
    if (ul !== undefined) setField(&tel, "user_labels_enabled", ul)
    put(&top, "telemetry", tel)
  }
  if (applied.length > 0) {
    put(&top, "client", cl)
    notes.push(`config: plugin "${pname}" read into "client": ${applied.join(", ")}`)
  }
}

// Bifrost's governance plugin: is_vk_mandatory becomes client.enforce_auth_on_inference, and
// required_headers becomes client.required_headers.
function mapGovernancePlugin(f: Field[], pname: string, inout top: Field[], inout notes: string[]): void throws SyntaxError {
  if (offPlugin(f, pname, &notes)) return
  const path = `plugins[${pname}].config`
  const cf = try members(find(f, "config"))
  let cl = try members(find(top, "client"))
  let applied: string[] = []
  const vk = find(cf, "is_vk_mandatory")
  if (vk !== undefined) {
    if (find(cl, "enforce_auth_on_inference") !== undefined || find(cl, "enforce_governance_header") !== undefined) {
      notes.push(`config: "${path}.is_vk_mandatory" is ignored: "client.enforce_auth_on_inference" is set, and it wins`)
    } else {
      setField(&cl, "enforce_auth_on_inference", vk)
      applied.push("enforce_auth_on_inference")
    }
  }
  toClient(&cl, path, "required_headers", "required_headers", find(cf, "required_headers"), &applied, &notes)
  ignored(path, cf, ["is_enterprise", "disable_auto_tool_inject"], &notes)
  if (applied.length > 0) {
    put(&top, "client", cl)
    notes.push(`config: plugin "${pname}" read into "client": ${applied.join(", ")}`)
  }
}

// Bifrost's routing plugin has no Raiju counterpart. Its chain depth and complexity analyzer
// are noted. The analyzer's tier boundaries are on a 0 to 1 scale, and Raiju's complexity
// router thresholds are on its own score scale, so they are not copied.
function mapRouting(f: Field[], pname: string, inout top: Field[], inout notes: string[]): void throws SyntaxError {
  if (offPlugin(f, pname, &notes)) return
  const path = `plugins[${pname}].config`
  const cf = try members(find(f, "config"))
  notes.push(`config: plugin "${pname}" is not loaded: Raiju's routing rules do not chain (chain_rule), and its complexity router is set under "complexity_router"`)
  ignored(path, cf, ["routing_chain_max_depth"], &notes)
  const ca = `${path}.complexity_analyzer_config`
  const af = try members(find(cf, "complexity_analyzer_config"))
  ignored(ca, af, ["tier_boundaries", "keywords", "semantic", "session"], &notes)
  if (find(af, "tier_boundaries") !== undefined) notes.push(`config: "${ca}.tier_boundaries" is not copied to "complexity_router": they are on a 0 to 1 scale, and Raiju's simple_max_score and complex_min_score are on its own score scale`)
  try mapComplexityAnalyzer(af, ca, &top, &notes)
}

// A Bifrost duration as Raiju's milliseconds: a duration string ("1.5s"), or a number of
// milliseconds. Raw JSON, or undefined when it is neither.
function millisRaw(raw: string | undefined): string | undefined throws SyntaxError {
  if (raw === undefined) return undefined
  if (raw.startsWith("\"")) {
    const secs = goSeconds(try decodeString(raw))
    if (secs === undefined) return undefined
    return `${Math.round(secs * 1000.0)}`
  }
  const n = parseFloat(raw) ?? -1.0
  if (n < 0.0) return undefined
  return raw
}

// The analyzer's classifier, decision model and LLM classifier, read into complexity_router. A decision classifier
// takes the decision block; without one, an llm block is the classifier, since Bifrost uses it as the fallback of
// the semantic classifier, which Raiju does not map. The semantic block and session retention are noted only.
function mapComplexityAnalyzer(af: Field[], path: string, inout top: Field[], inout notes: string[]): void throws SyntaxError {
  let classifier = ""
  const craw = strRaw(af, "classifier")
  if (craw !== undefined) classifier = try decodeString(craw)
  if (classifier !== "" && classifier !== "decision") notes.push(`config: "${path}.classifier" is not supported by Raiju and is ignored`)
  const decision = find(af, "decision")
  const llm = find(af, "llm")
  const useDecision = classifier === "decision" && decision !== undefined
  const useLLM = !useDecision && llm !== undefined
  if (decision !== undefined && !useDecision) notes.push(`config: "${path}.decision" is not used: Raiju reads it only when classifier is "decision"`)
  if (!useDecision && !useLLM) return
  if (find(top, "complexity_router") !== undefined) {
    notes.push(`config: "${path}" is not copied: "complexity_router" is already set`)
    return
  }
  let cr: Field[] = []
  add(&cr, "enabled", "true")
  if (useDecision) {
    add(&cr, "classifier", quote("decision"))
    const dm = try mappedModel(try members(decision), `${path}.decision`, true, &notes)
    add(&cr, "decision", dm)
  } else {
    add(&cr, "classifier", quote("llm"))
    const lm = try mappedModel(try members(llm), `${path}.llm`, false, &notes)
    add(&cr, "llm", lm)
  }
  put(&top, "complexity_router", cr)
  notes.push(`config: plugin "routing" complexity analyzer read into "complexity_router": classifier ${useDecision ? "decision" : "llm"}`)
}

// A decision or llm block as Raiju's: provider, model, timeout (ms), and the settings of that block. Criteria are
// noted: Raiju uses its own tier definitions. Returns the object text.
function mappedModel(bf: Field[], path: string, decisionBlock: bool, inout notes: string[]): string throws SyntaxError {
  let out: Field[] = []
  add(&out, "provider", strRaw(bf, "provider"))
  add(&out, "model", strRaw(bf, "model"))
  add(&out, "timeout_ms", try millisRaw(find(bf, "timeout")))
  if (decisionBlock) {
    add(&out, "previous_message_count", find(bf, "previous_message_count"))
    ignored(path, bf, ["criteria"], &notes)
  } else {
    add(&out, "prompt", strRaw(bf, "prompt"))
    add(&out, "message_history_count", find(bf, "message_history_count"))
  }
  return build(out)
}

// Bifrost's compat plugin: its features are read into client.compat (src/compat.tov), which the
// client section wins over. Decision emulation is read but Raiju has no decisions API, so it is noted.
function mapCompat(f: Field[], pname: string, inout top: Field[], inout notes: string[]): void throws SyntaxError {
  if (offPlugin(f, pname, &notes)) return
  const path = `plugins[${pname}].config`
  const cf = try members(find(f, "config"))
  const keys = ["convert_text_to_chat", "convert_chat_to_responses", "should_drop_params", "should_convert_params", "azure_deepseek", "force_reasoning_only_models_to_responses", "convert_decision_to_responses"]
  let cl = try members(find(top, "client"))
  if (find(cl, "compat") !== undefined) {
    notes.push(`config: plugin "${pname}" is ignored: "client.compat" is set, and it wins`)
    return
  }
  let sub: Field[] = []
  for (const k of keys) {
    const v = find(cf, k)
    if (v !== undefined) sub.push({ key: k, raw: v })
  }
  for (const k of cf) {
    if (!keys.includes(k.key)) notes.push(`config: "${path}.${k.key}" is not supported by Raiju and is ignored`)
  }
  if (rawBool(cf, "convert_decision_to_responses") === true) notes.push(`config: "${path}.convert_decision_to_responses" is read, but Raiju has no decisions API, so no decision is emulated`)
  setField(&cl, "compat", build(sub))
  put(&top, "client", cl)
  notes.push(`config: plugin "${pname}" read into "client": compat`)
}

// Bifrost's prompts plugin is Raiju's prompt repository (prompt_repo, prompts.tov), which is always on
// for chat requests. The plugin's own config keys are not read, and each is noted.
function mapPrompts(f: Field[], pname: string, inout notes: string[]): void throws SyntaxError {
  if (offPlugin(f, pname, &notes)) return
  notes.push(`config: plugin "${pname}" is not loaded as a plugin: Raiju's prompt repository is always on (prompt_repo) and applies to chat requests only`)
  for (const k of try members(find(f, "config"))) {
    notes.push(`config: "plugins[${pname}].config.${k.key}" is not supported by Raiju and is ignored`)
  }
}

// Takes the Bifrost plugins Raiju reads out of plugins[]: the semantic cache and otel become
// their top-level sections, and logging, telemetry, governance, routing, compat and prompts
// map to client settings or are noted. The other plugins stay in place.
// jsonparser keeps its place: usage all_requests completes the JSON of streams (plugins.tov JsonStreamFixer).
// per_request needs a per-request context key, which Raiju does not have; cleanup_interval and max_age
// have nothing to clean up, since Raiju keeps the accumulated text per stream.
function noteJsonParser(f: Field[], pname: string, inout notes: string[]): void throws SyntaxError {
  const path = `plugins[${pname}].config`
  const cf = try members(find(f, "config"))
  if (rawStr(cf, "usage") === "per_request") notes.push(`config: "${path}.usage" per_request is not supported by Raiju (it has no per-request context key), so streamed JSON completion stays off`)
  ignored(path, cf, ["cleanup_interval", "max_age"], &notes)
}

function mapPlugins(inout top: Field[], inout notes: string[]): void throws SyntaxError {
  const raw = find(top, "plugins")
  if (raw === undefined || !raw.startsWith("[")) return
  let keep: string[] = []
  let found = false
  for (const el of try elements(raw)) {
    const f = try members(el)
    const name = rawStr(f, "name") ?? ""
    if (name === "otel") {
      try mapOtelPlugin(f, name, &top, &notes)
      continue
    }
    if (name === "logging") {
      try mapLogging(f, name, &top, &notes)
      continue
    }
    if (name === "bigquery" || name === "pubsub" || name === "kafka" || name === "maxim") {
      try mapSinkPlugin(f, name, &top, &notes)
      continue
    }
    if (name === "telemetry") {
      try mapTelemetry(f, name, &top, &notes)
      continue
    }
    if (name === "governance") {
      try mapGovernancePlugin(f, name, &top, &notes)
      continue
    }
    if (name === "routing") {
      try mapRouting(f, name, &top, &notes)
      continue
    }
    if (name === "compat") {
      try mapCompat(f, name, &top, &notes)
      continue
    }
    if (name === "prompts") {
      try mapPrompts(f, name, &notes)
      continue
    }
    if (name === "jsonparser") {
      try noteJsonParser(f, name, &notes)
    }
    if (name !== "semantic_cache" && name !== "semanticcache") {
      keep.push(el)
      continue
    }
    if (found) {
      notes.push(`config: plugin "${name}" is ignored: only one semantic cache plugin is read`)
      continue
    }
    found = true
    try semanticCache(f, name, &top, &notes)
  }
  setField(&top, "plugins", "[" + keep.join(",") + "]")
}

// Rewrites a Bifrost config.json into the names Raiju reads. The returned text
// is for parsing only: it drops the Bifrost sections it consumed, so keep the
// original text for anything written back to the config store. notes says what
// was renamed, what was kept because Raiju already had the section, and what
// could not be mapped.
// A webhook secret or header value in Bifrost's object form ({value, env_var, from_env}) as the
// string Raiju reads: an env reference becomes "env.NAME", anything else its value. undefined when
// the raw value is already a string.
function plainValue(raw: string): string | undefined throws SyntaxError {
  if (!raw.startsWith("{")) return undefined
  const sf = try fields(raw)
  const envVar = rawStr(sf, "env_var") ?? ""
  if (rawBool(sf, "from_env") === true && envVar !== "") return quote("env." + envVar)
  return quote(rawStr(sf, "value") ?? "")
}

// The webhooks section with its secrets and header values in the string form (see plainValue).
function mapWebhooks(inout top: Field[]): void throws SyntaxError {
  const raw = find(top, "webhooks")
  if (raw === undefined || !raw.startsWith("[")) return
  let out: string[] = []
  for (const el of try items(raw)) {
    let ef = try members(el)
    const sec = find(ef, "secret")
    if (sec !== undefined) {
      const plain = try plainValue(sec)
      if (plain !== undefined) setField(&ef, "secret", plain)
    }
    const hraw = find(ef, "headers")
    if (hraw !== undefined && hraw.startsWith("{")) {
      const orig = try members(hraw)
      let hf = orig
      for (const h of orig) {
        const plain = try plainValue(h.raw)
        if (plain !== undefined) setField(&hf, h.key, plain)
      }
      setField(&ef, "headers", build(hf))
    }
    out.push(build(ef))
  }
  setField(&top, "webhooks", "[" + out.join(",") + "]")
}

// governance.roles[].entity_dac: Bifrost's object form ({"Logs": "own-data"}) becomes the list Raiju keeps
// ([{"resource": "Logs", "dac": "own-data"}]). Any other shape is left for the typed read to refuse.
function mapRoleDac(inout top: Field[]): void throws SyntaxError {
  const gRaw = find(top, "governance")
  if (gRaw === undefined) return
  let gov = try members(gRaw)
  const rRaw = find(gov, "roles")
  if (rRaw === undefined || !rRaw.startsWith("[")) return
  const roles = try elements(rRaw)
  let outRoles: string[] = []
  for (const role of roles) {
    if (!role.startsWith("{")) {
      outRoles.push(role)
      continue
    }
    let rf = try members(role)
    const ed = find(rf, "entity_dac")
    if (ed === undefined || !ed.startsWith("{")) {
      outRoles.push(role)
      continue
    }
    let list: string[] = []
    for (const f of try members(ed)) {
      list.push(build([{ key: "resource", raw: quote(f.key) }, { key: "dac", raw: f.raw }]))
    }
    setField(&rf, "entity_dac", "[" + list.join(",") + "]")
    outRoles.push(build(rf))
  }
  setField(&gov, "roles", "[" + outRoles.join(",") + "]")
  put(&top, "governance", gov)
}

export function normalize(configText: string): { text: string, notes: string[] } throws SyntaxError {
  let top = try fields(configText)
  let notes: string[] = []
  try mapWebhooks(&top)
  try mapAuth(&top, &notes)
  try mapRoleDac(&top)
  try mapClient(&top, &notes)
  try mapMcp(&top, &notes)
  try mapAlerting(&top, &notes)
  try mapAudit(&top, &notes)
  try mapCluster(&top, &notes)
  try mapAuthProxy(&top, &notes)
  try mapHealth(&top, &notes)
  try mapPricing(&top, &notes)
  try mapPlugins(&top, &notes)
  try mapVectorStore(&top, &notes)
  return { text: build(top), notes: notes }
}

function checkChildren(path: string, raw: string, known: string[], inout out: string[]): void throws SyntaxError {
  for (const f of try members(raw)) {
    const p = `${path}.${f.key}`
    if (flagged(p, known.includes(f.key))) out.push(p)
  }
}

// Dotted paths of keys Raiju does not understand, for top-level sections and one
// level down in client, providers.<name>, governance and mcp. Keys Raiju parses
// but never acts on are listed too; warnings() tells the two kinds apart.
export function unknownKeys(configText: string): string[] throws SyntaxError {
  const top = try fields(configText)
  let out: string[] = []
  for (const f of top) {
    if (flagged(f.key, topKeys().includes(f.key))) {
      out.push(f.key)
      continue
    }
    if (f.key === "client") try checkChildren("client", f.raw, clientKeys(), &out)
    if (f.key === "governance") try checkChildren("governance", f.raw, governanceKeys(), &out)
    if (f.key === "mcp") {
      try checkChildren("mcp", f.raw, mcpKeys(), &out)
      const tmRaw = find(try members(f.raw), "tool_manager_config")
      if (tmRaw !== undefined) try checkChildren("mcp.tool_manager_config", tmRaw, toolManagerKeys(), &out)
    }
    if (f.key === "providers") {
      for (const p of try members(f.raw)) {
        const base = `providers.${p.key}`
        try checkChildren(base, p.raw, providerKeys(), &out)
        const pf = try members(p.raw)
        for (const sec of ["network_config", "prompt_cache", "openai_config", "concurrency_and_buffer_size", "custom_provider_config"]) {
          const raw = find(pf, sec)
          if (raw !== undefined) try checkChildren(`${base}.${sec}`, raw, providerChildKeys(sec), &out)
        }
        const ks = find(pf, "keys")
        if (ks !== undefined) {
          for (const k of try items(ks)) {
            for (const kf of try members(k)) {
              const kp = `${base}.keys.${kf.key}`
              if (flagged(kp, keyChildKeys().includes(kf.key))) out.push(kp)
            }
          }
        }
      }
    }
  }
  return out
}

// Human-readable startup warnings: the notes from normalize, then a line for each
// key that is ignored or accepted but not implemented. Unknown keys are checked on
// the normalized text, so the Bifrost sections already read do not show up again.
export function warnings(configText: string): string[] throws SyntaxError {
  const n = try normalize(configText)
  let out: string[] = n.notes
  for (const p of try unknownKeys(n.text)) {
    const why = NOTES.get(noteKey(p))
    if (why !== undefined) out.push(`config: "${p}" ${why}`)
    else out.push(`config: unknown key "${p}" is ignored`)
  }
  return out
}

test("the owner switches are known keys, not unknown ones", () => {
  const text = `{ "client": { "refuse_unpriced_models": true }, "cache": { "enabled": true, "scope_by_virtual_key": true } }`
  const unknown = try unknownKeys(text)
  expect(unknown.includes("client.refuse_unpriced_models")).toBe(false)
  expect(unknown.includes("cache.scope_by_virtual_key")).toBe(false)
  const typo = try unknownKeys(`{ "client": { "refuse_unpriced_model": true } }`)
  expect(typo.includes("client.refuse_unpriced_model")).toBe(true)
  const w = try warnings(text)
  expect(w.join("\n").includes("refuse_unpriced_models")).toBe(false)
})

test("renames alerting to alerts and maps channels", () => {
  const r = try normalize(`{
    "alerting": {
      "history_retention_days": 90,
      "channels": [
        { "id": "ops", "name": "ops", "type": "slack", "enabled": true, "config": { "webhook_url": "https://hooks.example/slack" } },
        { "id": "hook", "name": "hook", "type": "webhook", "enabled": true, "config": { "url": "https://hooks.example/h", "headers": { "X-Token": "t" } } },
        { "id": "pd", "name": "pd", "type": "pagerduty", "enabled": true, "cooldown_seconds": 30, "config": { "integration_key": "k" } },
        { "id": "ms", "name": "ms", "type": "microsoft_teams", "enabled": true, "config": { "webhook_url": "https://hooks.example/t" } },
        { "id": "off", "name": "off", "type": "pagerduty", "enabled": false, "config": { "routing_key": "k" } }
      ],
      "rules": [ { "id": "r1", "name": "spend", "enabled": true, "scope_type": "virtual_key", "scope_id": "vk1", "cel_expression": "budget_usage_percent > 90", "channel_ids": ["ops"] } ]
    }
  }`)
  expect(find(try fields(r.text), "alerting")).toBeUndefined()
  const al = try fields(find(try fields(r.text), "alerts")!)
  expect(find(al, "rules")).toBe("[]")
  const chans = try elements(find(al, "channels")!)
  expect(chans.length).toBe(4)
  expect(chans[2]).toBe(`{"id":"pd","name":"pd","type":"pagerduty","url":"","routing_key":"k","cooldown_seconds":30}`)
  expect(chans[3]).toBe(`{"id":"ms","name":"ms","type":"microsoft_teams","url":"https://hooks.example/t"}`)
  expect(chans[0]).toBe(`{"id":"ops","name":"ops","type":"slack","url":"https://hooks.example/slack"}`)
  expect(chans[1]).toBe(`{"id":"hook","name":"hook","type":"webhook","url":"https://hooks.example/h","headers":{ "X-Token": "t" }}`)
  expect(find(al, "cel_rules")).toBe(`[{"id":"r1","name":"spend","enabled":true,"scope_type":"virtual_key","scope_id":"vk1","cel_expression":"budget_usage_percent > 90","channel_ids":["ops"]}]`)
  expect(r.notes.includes(`config: "alerting" read as "alerts"`)).toBe(true)
  expect(r.notes.includes(`config: 1 alerting channel(s) skipped: a channel needs to be enabled, of a known type, and have a url (a routing_key for pagerduty)`)).toBe(true)
  expect(r.notes.some((n) => n.includes("alerting rule(s) use CEL"))).toBe(false)
  expect(r.notes.includes(`config: "alerting.history_retention_days" is not supported by Raiju and is ignored`)).toBe(true)
})

test("alerting rules load as cel_rules; a rule without a valid scope or channels is skipped", () => {
  const r = try normalize(`{
    "alerting": {
      "rules": [
        { "id": "ok", "name": "Budget", "enabled": true, "scope_type": "team", "scope_id": "t1", "cel_expression": "budget_usage_percent >= 80.0", "channel_ids": ["ops"], "cooldown_seconds": 300, "notify_once_per_reset_cycle": true, "target_type": "budget", "target_id": "b1", "description": "d" },
        { "id": "bad-scope", "enabled": true, "scope_type": "widget", "scope_id": "w1", "cel_expression": "true", "channel_ids": ["ops"] },
        { "id": "no-channel", "enabled": true, "scope_type": "customer", "scope_id": "c1", "cel_expression": "true", "channel_ids": [] }
      ]
    }
  }`)
  const al = try fields(find(try fields(r.text), "alerts")!)
  expect(find(al, "cel_rules")).toBe(`[{"id":"ok","name":"Budget","description":"d","enabled":true,"scope_type":"team","scope_id":"t1","cel_expression":"budget_usage_percent >= 80.0","channel_ids":["ops"],"cooldown_seconds":300,"notify_once_per_reset_cycle":true,"target_type":"budget","target_id":"b1"}]`)
  expect(r.notes.includes(`config: 2 alerting rule(s) skipped: a rule needs an id, a scope_type of virtual_key, team or customer, a scope_id, a cel_expression and channel_ids`)).toBe(true)
})

test("maps audit_logs to audit and flags an empty signing key", () => {
  const r = try normalize(`{ "audit_logs": { "disabled": false, "hmac_key": "env.AUDIT_KEY", "retention_days": 30, "archive_interval": "24h" } }`)
  const au = try fields(find(try fields(r.text), "audit")!)
  expect(rawBool(au, "enabled")).toBe(true)
  expect(rawStr(au, "key")).toBe("env.AUDIT_KEY")
  expect(rawNum(au, "retention_days")).toBe(30)
  expect(r.notes.includes(`config: "audit_logs.retention_days" is not supported by Raiju and is ignored`)).toBe(false)
  const off = try normalize(`{ "audit_logs": { "disabled": true } }`)
  const af = try fields(find(try fields(off.text), "audit")!)
  expect(rawBool(af, "enabled")).toBe(false)
  expect(off.notes.includes(`config: "audit_logs.hmac_key" is not set, so audit entries are signed with an empty key`)).toBe(true)
})

test("governance roles: entity_dac in Bifrost's object form is read as the list Raiju keeps", () => {
  const r = try normalize(`{ "governance": { "roles": [ { "name": "acct", "dac": "team-data", "entity_dac": { "Logs": "own-data" } }, { "name": "plain" } ] } }`)
  const roles = try elements(find(try members(find(try fields(r.text), "governance")), "roles") ?? "[]")
  expect(roles.length).toBe(2)
  const acct = try fields(roles[0]!)
  const list = try elements(find(acct, "entity_dac") ?? "[]")
  expect(list.length).toBe(1)
  const e = try fields(list[0]!)
  expect(rawStr(e, "resource")).toBe("Logs")
  expect(rawStr(e, "dac")).toBe("own-data")
})

test("audit_logs: omit_ip_addresses, the grace period and object_storage map to audit, and are no longer ignored", () => {
  const r = try normalize(`{ "audit_logs": { "hmac_key": "k", "omit_ip_addresses": true, "archive_grace_period": "15m", "archive_interval": "6h", "archive_max_object_bytes": 1048576,
    "object_storage": { "type": "s3", "bucket": "audit-bkt", "prefix": "acme", "region": "eu-west-1", "access_key_id": "AKIA", "secret_access_key": "s", "compress": true } } }`)
  const au = try fields(find(try fields(r.text), "audit")!)
  expect(rawBool(au, "omit_ip_addresses")).toBe(true)
  expect(rawNum(au, "archive_grace_seconds")).toBe(900)
  const ar = try fields(find(au, "archive")!)
  expect(rawBool(ar, "enabled")).toBe(true)
  expect(rawStr(ar, "kind")).toBe("s3")
  expect(rawStr(ar, "bucket")).toBe("audit-bkt")
  expect(rawNum(ar, "interval_seconds")).toBe(21600)
  expect(r.notes.includes(`config: "audit_logs.archive_max_object_bytes" is not supported by Raiju and is ignored`)).toBe(true)
  expect(r.notes.includes(`config: "audit_logs.object_storage.compress" is ignored: archive objects are plain JSONL`)).toBe(true)
  expect(r.notes.includes(`config: "audit_logs.omit_ip_addresses" is not supported by Raiju and is ignored`)).toBe(false)
})

test("keeps the cluster off without a secret, and says why", () => {
  const r = try normalize(`{ "cluster_config": { "enabled": true, "type": "mesh", "region": "eu", "peers": ["https://n2.example"], "gossip": { "port": 4001, "config": { "timeout_seconds": 3, "success_threshold": 1, "failure_threshold": 3 } } } }`)
  const cl = try fields(find(try fields(r.text), "cluster")!)
  expect(rawBool(cl, "enabled")).toBe(false)
  expect(find(cl, "peers")).toBe(`["https://n2.example"]`)
  expect(r.notes.includes(`config: "cluster_config" has no shared secret, which Raiju needs for cluster sync; cluster sync is off until "cluster.secret" is set`)).toBe(true)
  const b = try normalize(`{ "cluster_config": { "enabled": true, "type": "broker", "broker": { "address": "b.example:50051" } } }`)
  const bl = try fields(find(try fields(b.text), "cluster")!)
  expect(rawBool(bl, "enabled")).toBe(false)
  expect(b.notes.includes(`config: "cluster_config" has no shared secret, which Raiju needs for cluster sync; cluster sync is off until "cluster.secret" is set`)).toBe(true)
})

test("maps a broker cluster_config to broker mode, with its auth_token as the secret", () => {
  const r = try normalize(`{ "cluster_config": { "enabled": true, "type": "broker", "region": "us-east-1",
    "broker": { "address": "broker.example.run.app:443", "tls": true, "auth_token": "b-secret", "listen_port": 50051, "futureKey": 1 } } }`)
  const cl = try fields(find(try fields(r.text), "cluster")!)
  expect(rawBool(cl, "enabled")).toBe(true)
  expect(rawStr(cl, "type")).toBe("broker")
  expect(rawStr(cl, "secret")).toBe("b-secret")
  expect(find(cl, "peers")).toBe("[]")
  const br = try fields(find(cl, "broker")!)
  expect(rawStr(br, "address")).toBe("broker.example.run.app:443")
  expect(rawBool(br, "tls")).toBe(true)
  expect(find(br, "auth_token")).toBe(undefined)
  expect(r.notes.includes(`config: "cluster_config.broker.auth_token" is read as "cluster.secret"`)).toBe(true)
  expect(r.notes.includes(`config: "cluster_config.broker.futureKey" is not supported by Raiju and is ignored`)).toBe(true)
  const noaddr = try normalize(`{ "cluster_config": { "enabled": true, "type": "broker", "broker": { "auth_token": "t" } } }`)
  expect(rawBool(try fields(find(try fields(noaddr.text), "cluster")!), "enabled")).toBe(false)
  expect(noaddr.notes.includes(`config: "cluster_config.broker.address" is not set; cluster sync is off`)).toBe(true)
})

test("passes cluster discovery through and maps scim_config's authProxy", () => {
  const r = try normalize(`{
    "cluster_config": { "enabled": true, "discovery": { "enabled": true, "type": "consul", "service_name": "bifrost", "consul_address": "consul:8500" } },
    "scim_config": { "enabled": true, "provider": "okta", "config": { "clientId": "x", "authProxy": {
      "enabled": true, "provider": "aws-alb", "mode": "full", "expectedSigner": "arn:aws:elasticloadbalancing:us-east-1:1:loadbalancer/app/a/1",
      "headerName": "x-amzn-oidc-data", "userIdClaim": "email", "futureKey": 1 } } } }`)
  const cl = try fields(find(try fields(r.text), "cluster")!)
  expect(find(cl, "discovery")).toBe(`{ "enabled": true, "type": "consul", "service_name": "bifrost", "consul_address": "consul:8500" }`)
  const ap = try fields(find(try fields(r.text), "auth_proxy")!)
  expect(rawBool(ap, "enabled")).toBe(true)
  expect(rawStr(ap, "provider")).toBe("aws-alb")
  expect(rawStr(ap, "mode")).toBe("full")
  expect(rawStr(ap, "expected_signer")).toBe("arn:aws:elasticloadbalancing:us-east-1:1:loadbalancer/app/a/1")
  expect(rawStr(ap, "user_id_claim")).toBe("email")
  expect(find(ap, "clientId")).toBe(undefined)
  expect(r.notes.includes(`config: "scim_config.config.authProxy.futureKey" is not supported by Raiju and is ignored`)).toBe(true)
  expect(find(try fields(r.text), "scim_config")).toBe(undefined)
  const off = try normalize(`{ "scim_config": { "enabled": false, "config": { "authProxy": { "enabled": true, "provider": "generic" } } } }`)
  expect(find(try fields(off.text), "auth_proxy")).toBe(undefined)
})

test("maps circuit_breaker_config to circuit_breaker_policies and load_balancer_config to health", () => {
  const r = try normalize(`{
    "circuit_breaker_config": { "policies": [
      { "name": "spill", "enabled": true, "primary_provider": "azure", "primary_model": "gpt-4o", "fallback_provider": "azure", "fallback_model": "gpt-4o-paygo",
        "condition": { "operator": "OR", "signals": [ { "source": "response_header", "header_name": "X-Spill", "header_value": "true" } ] },
        "default_cooldown": "30s" },
      { "name": "off", "enabled": false, "primary_provider": "openai", "primary_model": "gpt-4o" }
    ] },
    "load_balancer_config": { "enabled": true, "direction_selection_enabled": true, "route_selection_enabled": true, "prune_failed_fallbacks": true }
  }`)
  const top = try fields(r.text)
  const h = try fields(find(top, "health")!)
  expect(rawBool(h, "adaptive")).toBe(true)
  expect(find(h, "circuit_breaker")).toBeUndefined()
  expect(find(top, "circuit_breaker_config")).toBeUndefined()
  expect(find(top, "load_balancer_config")).toBeUndefined()
  const pols = try elements(find(top, "circuit_breaker_policies")!)
  expect(pols.length).toBe(2)
  expect(r.notes.includes(`config: "circuit_breaker_config" read as "circuit_breaker_policies"`)).toBe(true)
  expect(r.notes.includes(`config: "load_balancer_config.direction_selection_enabled" is not supported by Raiju and is ignored`)).toBe(true)
  const lb = try normalize(`{ "load_balancer_config": { "enabled": true, "route_selection_enabled": false } }`)
  expect(rawBool(try fields(find(try fields(lb.text), "health")!), "adaptive")).toBe(false)
})

