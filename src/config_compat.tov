  expect(rawStr(sc, "vector_store_namespace")).toBe("mycache")
  expect(find(sc, "dimension")).toBe("1536")
  expect(r.notes.includes(`config: "plugins[semantic_cache].config.disable_identity_scoping" is not supported by Raiju and is ignored`)).toBe(false)
  const scf = try fields(find(try fields(r.text), "semantic_cache")!)
  expect(find(scf, "disable_identity_scoping")).toBe("true")
})

