test("maps weaviate, pinecone and chromem vector stores", () => {
  const w = try normalize(`{ "vector_store": { "enabled": true, "type": "weaviate", "config": { "scheme": "https", "host": "w.internal:443", "api_key": "wk", "grpc_config": { "host": "w:50051" } } } }`)
  const wc = try fields(find(try fields(find(try fields(w.text), "vector_store")!), "config")!)
  expect(rawStr(wc, "scheme")).toBe("https")
  expect(rawStr(wc, "host")).toBe("w.internal:443")
  expect(rawStr(wc, "api_key")).toBe("wk")
  expect(find(wc, "grpc_config")).toBeUndefined()
  expect(w.notes.includes(`config: "vector_store.config.grpc_config" is not supported by Raiju and is ignored`)).toBe(true)
  expect(w.notes.some((n) => n.includes("vector_store.type"))).toBe(false)
  const p = try normalize(`{ "vector_store": { "enabled": true, "type": "pinecone", "config": { "api_key": "pk", "index_host": "idx.svc.pinecone.io" } } }`)
  const pc = try fields(find(try fields(find(try fields(p.text), "vector_store")!), "config")!)
  expect(rawStr(pc, "index_host")).toBe("idx.svc.pinecone.io")
  expect(rawStr(pc, "api_key")).toBe("pk")
  const ch = try normalize(`{ "vector_store": { "enabled": true, "type": "chromem", "config": { "path": "/var/lib/raiju/vec", "compress": true } } }`)
  const cc = try fields(find(try fields(find(try fields(ch.text), "vector_store")!), "config")!)
  expect(rawStr(cc, "path")).toBe("/var/lib/raiju/vec")
  expect(ch.notes.includes(`config: "vector_store.config.compress" is not supported by Raiju and is ignored`)).toBe(true)
})

test("maps a redis vector_store and drops types Raiju has no client for", () => {
  const rr = try normalize(`{ "vector_store": { "enabled": true, "type": "redis", "config": { "addr": "r:6379", "password": "p", "db": 1, "cluster_mode": true, "pool_size": 10, "insecure_skip_verify": true } } }`)
  const c = try fields(find(try fields(find(try fields(rr.text), "vector_store")!), "config")!)
  expect(rawStr(c, "addr")).toBe("r:6379")
  expect(find(c, "db")).toBe("1")
  expect(find(c, "pool_size")).toBeUndefined()
  expect(rr.notes.includes(`config: "vector_store.config.pool_size" is not supported by Raiju and is ignored`)).toBe(true)
  expect(rr.notes.includes(`config: "vector_store.config.cluster_mode" is not supported by Raiju and is ignored: the store is read as a single node`)).toBe(true)
  const wv = try normalize(`{ "vector_store": { "enabled": true, "type": "milvus", "config": { "address": "m" } } }`)
  expect(find(try fields(wv.text), "vector_store")).toBeUndefined()
  expect(wv.notes.includes(`config: "vector_store.type" "milvus" is not supported by Raiju; the semantic cache keeps its entries in memory`)).toBe(true)
})

test("existing Raiju sections win over Bifrost ones, with a note", () => {
  const r = try normalize(`{
    "alerts": { "enabled": false },
    "alerting": { "channels": [] },
    "audit": { "enabled": true, "dir": "logs/x" },
    "audit_logs": { "disabled": true },
    "plugins": [ { "enabled": true, "name": "semantic_cache", "config": { "provider": "openai", "embedding_model": "e" } } ],
    "semantic_cache": { "enabled": false, "provider": "openai", "embedding_model": "mine" }
  }`)
  expect(find(try fields(r.text), "alerting")).toBeUndefined()
  expect(find(try fields(r.text), "alerts")).toBe(`{ "enabled": false }`)
  expect(find(try fields(r.text), "audit")).toBe(`{ "enabled": true, "dir": "logs/x" }`)
  expect(r.notes.includes(`config: "alerting" is ignored: "alerts" is set, and it wins`)).toBe(true)
  expect(r.notes.includes(`config: "audit_logs" is ignored: "audit" is set, and it wins`)).toBe(true)
  expect(r.notes.includes(`config: plugin "semantic_cache" is ignored: "semantic_cache" is set, and it wins`)).toBe(true)
  expect(find(try fields(r.text), "semantic_cache")).toBe(`{ "enabled": false, "provider": "openai", "embedding_model": "mine" }`)
})

test("maps client keys and top-level auth into Raiju's sections", () => {
  const r = try normalize(`{
    "client": { "mcp_tool_execution_timeout": 45, "log_retention_days": 14, "enforce_auth_on_inference": true, "max_request_body_size_mb": 10 },
    "logs_store": { "enabled": true },
    "auth_config": { "admin_username": "root", "admin_password": "env.ADMIN_PW", "is_enabled": true }
  }`)
  const cl = try fields(find(try fields(r.text), "client")!)
  expect(find(cl, "mcp_tool_execution_timeout")).toBeUndefined()
  expect(find(cl, "log_retention_days")).toBeUndefined()
  expect(find(cl, "max_request_body_size_mb")).toBe("10")
  const mcp = try fields(find(try fields(r.text), "mcp")!)
  expect(find(mcp, "tool_execution_timeout_seconds")).toBe("45")
  const ls = try fields(find(try fields(r.text), "logs_store")!)
  expect(find(ls, "retention_days")).toBe("14")
  const gov = try fields(find(try fields(r.text), "governance")!)
  const ga = try fields(find(gov, "auth_config")!)
  expect(rawStr(ga, "username")).toBe("root")
  expect(rawStr(ga, "password")).toBe("env.ADMIN_PW")
  expect(find(try fields(r.text), "auth_config")).toBeUndefined()
  expect(r.notes.includes(`config: "auth_config.is_enabled" is not supported by Raiju and is ignored`)).toBe(false)
  const none = try normalize(`{ "client": { "log_retention_days": 14 } }`)
  expect(none.notes.includes(`config: "client.log_retention_days" read as "logs_store.retention_days"; request logs stay off until "logs_store.enabled" is true`)).toBe(true)
  const noStore = try fields(find(try fields(none.text), "logs_store")!)
  expect(find(noStore, "retention_days")).toBe("14")
})

test("the header, routing, webhook and key-batch settings are read, not flagged", () => {
  const text = `{
    "version": "1", "source_of_truth": "file", "env_label": "dev", "server": {}, "setup_token": "t",
    "client": { "header_filter_config": { "allowlist": ["x-team"] }, "allowed_headers": ["x"], "whitelisted_routes": ["/api/health"],
      "dump_errors_in_console_logs": true, "routing_chain_max_depth": 4, "webhook_config": { "delivery_history_retention_days": 7 } },
    "providers": { "openai": { "keys": [ { "value": "k", "use_for_batch_api": true } ], "prompt_cache": { "ttl": "1h", "cache_control_injection_points": [] } } }
  }`
  expect(try unknownKeys(text)).toEqual([])
  const w = try warnings(text)
  expect(w.length).toBe(0)
  const r = try normalize(`{ "access_profiles": [] }`)
  expect(r.notes.length).toBe(0)
})

test("unknownKeys lists ignored keys and the accepted-but-unused ones", () => {
  const keys = try unknownKeys(`{
    "$schema": "x",
    "server": { "port": 8080 },
    "guardrails_config": {},
    "guardrails": { "enabled": true },
    "client": { "enforce_auth_on_inference": true, "drop_excess_requests": false, "allow_direct_keys": false, "prometheus_labels": [], "enable_logging": true },
    "providers": { "openai": { "keys": [], "send_back_raw_response": false, "prompt_cache": {} } },
    "governance": { "business_units": [], "budgets": [] },
    "mcp": { "tool_manager_config": {}, "client_configs": [] },
    "pricing_sync": { "url": "x" }
  }`)
  // server is accepted silently (L97g) and mcp.tool_manager_config is read (L97d)
  expect(keys).toEqual([])
})

test("governance projects, business units and roles are read, not flagged", () => {
  const keys = try unknownKeys(`{ "governance": { "projects": [], "business_units": [], "roles": [], "teams": [] }, "client": { "bogus": 1 } }`)
  expect(keys).toEqual(["client.bogus"])
})

test("warnings formats renames and unknown keys", () => {
  const w = try warnings(`{ "alerting": { "channels": [] }, "server": {}, "client": { "drop_excess_requests": true } }`)
  expect(w.includes(`config: "alerting" read as "alerts"`)).toBe(true)
  expect(w.some((x) => x.includes(`"server"`))).toBe(false)
  expect(w.includes(`config: unknown key "alerting" is ignored`)).toBe(false)
  expect(w.length).toBe(1)
  const clean = try warnings(`{ "client": { "enable_logging": true }, "providers": {} }`)
  expect(clean.length).toBe(0)
})

// The shape Raiju reads from the normalized text, as the lead's typed parse sees it.
type Probe = {
  health?: { circuit_breaker?: bool, adaptive?: bool, open_seconds?: int },
  circuit_breaker_policies?: { name: string, default_cooldown?: string }[],
  alerts?: { channels?: { id: string, type: "webhook" | "slack", url: string }[], rules?: string[] },
  semantic_cache?: { provider: string, embedding_model: string, ttl?: int },
  pricing_sync?: { url?: string, interval_seconds?: int },
}

test("normalized text parses into the typed shape Raiju reads", () => {
  const r = try normalize(`{
    "alerting": { "channels": [ { "id": "ops", "type": "slack", "enabled": true, "config": { "webhook_url": "https://hooks.example/s" } } ] },
    "circuit_breaker_config": { "policies": [ { "name": "p", "enabled": true, "default_cooldown": "1m" } ] },
    "load_balancer_config": { "enabled": true },
    "framework": { "pricing": { "pricing_url": "https://prices.example/p.json", "pricing_sync_interval": 3600 } },
    "plugins": [ { "enabled": true, "name": "semantic_cache", "config": { "provider": "openai", "embedding_model": "e", "ttl": "1h" } } ]
  }`)
  const p = try JSON.parse(r.text) as Probe
  expect(p.alerts!.channels![0]!.url).toBe("https://hooks.example/s")
  expect(p.alerts!.rules!.length).toBe(0)
  expect(p.circuit_breaker_policies![0]!.name).toBe("p")
  expect(p.circuit_breaker_policies![0]!.default_cooldown).toBe("1m")
  expect(p.health!.adaptive).toBe(true)
  expect(p.semantic_cache!.provider).toBe("openai")
  expect(p.semantic_cache!.ttl).toBe(3600)
  expect(p.pricing_sync!.interval_seconds).toBe(3600)
})

// A trimmed copy of Bifrost's withpostgresmcpclientsinconfig example.
test("a whole Bifrost example: what is mapped and what is left", () => {
  const text = `{
    "$schema": "https://www.getbifrost.ai/schema",
    "client": { "enable_logging": true, "enforce_auth_on_inference": true, "log_retention_days": 30, "initial_pool_size": 300, "max_request_body_size_mb": 100 },
    "config_store": { "enabled": true, "type": "postgres", "config": { "host": "localhost" } },
    "logs_store": { "enabled": true, "type": "postgres", "config": { "host": "localhost" } },
    "mcp": {
      "tool_manager_config": { "server_instructions_mode": "gateway" },
      "client_configs": [ { "name": "WeatherService", "connection_type": "http", "client_id": "weather", "connection_string": "http://localhost:8080/mcp" } ]
    },
    "governance": {
      "auth_config": { "admin_username": "env.ADMIN_USER", "admin_password": "env.ADMIN_PW" },
      "virtual_keys": [ { "id": "vk-1", "name": "portal", "value": "env.VK", "mcp_configs": [ { "mcp_client_name": "WeatherService", "tools_to_execute": ["*"] } ] } ]
    },
    "plugins": [ { "enabled": true, "name": "governance", "config": { "is_vk_mandatory": true } } ],
    "providers": { "openai": { "keys": [ { "name": "k", "value": "env.OPENAI_API_KEY", "models": ["*"], "weight": 1 } ] } }
  }`
  const r = try normalize(text)
  const p = try JSON.parse(r.text) as { logs_store?: { retention_days?: int }, governance?: { auth_config?: { username?: string, password?: string } } }
  expect(p.logs_store!.retention_days).toBe(30)
  expect(p.governance!.auth_config!.username).toBe("env.ADMIN_USER")
  expect(p.governance!.auth_config!.password).toBe("env.ADMIN_PW")
  expect(r.notes.length).toBe(5)
  expect(r.notes.includes(`config: "plugins[governance].config.is_vk_mandatory" is ignored: "client.enforce_auth_on_inference" is set, and it wins`)).toBe(true)
  const w = try warnings(text)
  expect(w.includes(`config: "config_store" is not used: Raiju saves its config to the file given by -config`)).toBe(true)
  expect(w.includes(`config: "client.initial_pool_size" is a Go connection-pool setting that Raiju does not use`)).toBe(true)
  expect(w.includes(`config: "mcp.tool_manager_config.server_instructions_mode" is not implemented: Raiju has no such tool manager setting`)).toBe(true)
  expect(w.includes(`config: unknown key "$schema" is ignored`)).toBe(false)
  expect(w.length).toBe(4 + 3)
})

test("maps a flat otel plugin entry and drops it from plugins", () => {
  const r = try normalize(`{
    "plugins": [
      { "enabled": true, "name": "otel", "config": {
        "collector_url": "http://otel-collector:4318", "trace_type": "genai_extension", "protocol": "http", "service_name": "bifrost-gateway",
        "headers": { "x-key": "a" }, "trace_headers": { "x-trace": "t" }, "metrics_headers": { "x-metric": "m" },
        "export_timeout": 8, "request_headers": ["x-team", "x-custom-*"], "excluded_attributes": ["gen_ai.request.tools"],
        "disable_content_logging": true, "insecure": true,
        "metrics_enabled": true, "metrics_endpoint": "http://otel-collector:4318/v1/metrics", "metrics_push_interval": 30 } },
      { "enabled": true, "name": "maxtokens", "config": {} }
    ]
  }`)
  const o = try fields(find(try fields(r.text), "otel")!)
  expect(rawStr(o, "endpoint")).toBe("http://otel-collector:4318/v1/traces")
  expect(rawStr(o, "service_name")).toBe("bifrost-gateway")
  expect(find(o, "headers")).toBe(`{ "x-key": "a" }`)
  expect(find(o, "trace_headers")).toBe(`{ "x-trace": "t" }`)
  expect(find(o, "metrics_headers")).toBe(`{ "x-metric": "m" }`)
  expect(find(o, "export_timeout")).toBe("8")
  expect(find(o, "request_headers")).toBe(`["x-team", "x-custom-*"]`)
  expect(find(o, "excluded_attributes")).toBe(`["gen_ai.request.tools"]`)
  expect(find(o, "disable_content_logging")).toBe("true")
  expect(find(o, "insecure")).toBe("true")
  expect(rawStr(o, "metrics_endpoint")).toBe("http://otel-collector:4318/v1/metrics")
  expect(find(o, "metrics_push_interval")).toBe("30")
  expect(find(o, "trace_type")).toBeUndefined()
  const plugins = try elements(find(try fields(r.text), "plugins")!)
  expect(plugins.length).toBe(1)
  expect(r.notes.includes(`config: plugin "otel" read as "otel"`)).toBe(true)
  expect(r.notes.includes(`config: "plugins[otel].config.trace_type" is not supported by Raiju and is ignored`)).toBe(true)
})

test("otel span, session and overhead options map to Raiju keys; a profile-level filter is hoisted", () => {
  const r = try normalize(`{ "plugins": [ { "enabled": true, "name": "otel", "config": {
    "collector_url": "http://c:4318", "protocol": "http", "overhead_breakdown_enabled": true,
    "group_traces_by_session": true, "disable_root_span_content": true, "export_overhead_spans": true,
    "plugin_span_filter": { "mode": "include", "plugins": ["governance"] } } } ] }`)
  const o = try fields(find(try fields(r.text), "otel")!)
  expect(find(o, "plugin_span_filter")).toBe(`{ "mode": "include", "plugins": ["governance"] }`)
  expect(find(o, "export_overhead_spans")).toBe("true")
  expect(find(o, "group_traces_by_session")).toBe("true")
  expect(find(o, "disable_root_span_content")).toBe("true")
  expect(find(o, "overhead_breakdown_enabled")).toBe("true")
  expect(r.notes.some((n) => n.includes("plugin_span_filter") || n.includes("overhead"))).toBe(false)
})

test("otel defaults: bifrost service name, 5 second export timeout, and no insecure unless set", () => {
  const r = try normalize(`{ "plugins": [ { "enabled": true, "name": "otel", "config": { "collector_url": "https://c.example:4318/custom", "protocol": "http" } } ] }`)
  const o = try fields(find(try fields(r.text), "otel")!)
  expect(rawStr(o, "endpoint")).toBe("https://c.example:4318/custom")
  expect(rawStr(o, "service_name")).toBe("bifrost")
  expect(find(o, "export_timeout")).toBe("5")
  expect(find(o, "insecure")).toBeUndefined()
  expect(r.notes.some((n) => n.includes(`has no "insecure"`))).toBe(true)
})

test("otel grpc keeps the host:port and maps protocol; HTTP profiles get no protocol key", () => {
  const r = try normalize(`{ "plugins": [ { "enabled": true, "name": "otel", "config": { "collector_url": "collector:4317", "protocol": "grpc", "insecure": true, "metrics_enabled": true, "metrics_endpoint": "collector:4317" } } ] }`)
  const o = try fields(find(try fields(r.text), "otel")!)
  expect(rawStr(o, "endpoint")).toBe("collector:4317")
  expect(rawStr(o, "protocol")).toBe("grpc")
  expect(rawStr(o, "metrics_endpoint")).toBe("collector:4317")
  expect(r.notes.includes(`config: "collector_url" has no scheme; http:// is assumed`)).toBe(false)
  const http = try normalize(`{ "plugins": [ { "enabled": true, "name": "otel", "config": { "collector_url": "c:4318", "protocol": "http" } } ] }`)
  const h = try fields(find(try fields(http.text), "otel")!)
  expect(rawStr(h, "endpoint")).toBe("http://c:4318/v1/traces")
  expect(rawStr(h, "protocol")).toBeUndefined()
})

test("otel profiles: the first enabled profile is read and the rest are noted", () => {
  const r = try normalize(`{ "plugins": [ { "enabled": true, "name": "otel", "config": { "profiles": [
    { "enabled": false, "collector_url": "http://off:4318", "protocol": "http" },
    { "enabled": true, "collector_url": "http://first:4318/x", "protocol": "http", "service_name": "one", "plugin_span_filter": { "mode": "include", "plugins": [] } },
    { "enabled": true, "collector_url": "http://second:4318", "protocol": "http" }
  ], "plugin_span_filter": { "mode": "exclude", "plugins": ["governance"] } } } ] }`)
  const o = try fields(find(try fields(r.text), "otel")!)
  expect(rawStr(o, "endpoint")).toBe("http://first:4318/x")
  expect(rawStr(o, "service_name")).toBe("one")
  expect(r.notes.includes(`config: plugin "otel" has 1 more enabled profile(s); Raiju exports the first only`)).toBe(true)
  expect(find(o, "plugin_span_filter")).toBe(`{ "mode": "exclude", "plugins": ["governance"] }`)
  const none =try normalize(`{ "plugins": [ { "enabled": true, "name": "otel", "config": { "profiles": [ { "enabled": false, "collector_url": "http://x" } ] } } ] }`)
  expect(find(try fields(none.text), "otel")).toBeUndefined()
})

test("a metrics-only otel profile needs no collector_url, and a disabled or shadowed plugin is not loaded", () => {
  const m = try normalize(`{ "plugins": [ { "enabled": true, "name": "otel", "config": { "traces_enabled": false, "metrics_enabled": true, "metrics_endpoint": "http://m:4318/v1/metrics", "protocol": "http" } } ] }`)
  const mo = try fields(find(try fields(m.text), "otel")!)
  expect(rawStr(mo, "endpoint")).toBe("")
  expect(rawBool(mo, "traces_enabled")).toBe(false)
  expect(rawStr(mo, "metrics_endpoint")).toBe("http://m:4318/v1/metrics")
  expect(m.notes.some((n) => n.includes("no collector_url"))).toBe(false)

  const off = try normalize(`{ "plugins": [ { "enabled": false, "name": "otel", "config": { "collector_url": "http://c:4318" } } ] }`)
  expect(find(try fields(off.text), "otel")).toBeUndefined()
  expect(find(try fields(off.text), "plugins")).toBe("[]")
  expect(off.notes.includes(`config: plugin "otel" is disabled in Bifrost and is not loaded`)).toBe(true)

  const shadow = try normalize(`{ "otel": { "endpoint": "http://mine:4318/v1/traces" }, "plugins": [ { "enabled": true, "name": "otel", "config": { "collector_url": "http://c:4318" } } ] }`)
  expect(rawStr(try fields(find(try fields(shadow.text), "otel")!), "endpoint")).toBe("http://mine:4318/v1/traces")
  expect(shadow.notes.includes(`config: plugin "otel" is ignored: "otel" is set, and it wins`)).toBe(true)
})

test("invalid JSON throws SyntaxError", () => {
  let threw = false
  try {
    normalize(`{ "alerting": `)
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("auth_config.is_enabled: false is kept, so admin auth stays off", () => {
  const r = try normalize(`{ "auth_config": { "admin_username": "root", "admin_password": "pw", "is_enabled": false } }`)
  const au = try fields(find(try fields(find(try fields(r.text), "governance")!), "auth_config")!)
  expect(rawBool(au, "is_enabled")).toBe(false)
  const r2 = try normalize(`{ "auth_config": { "admin_username": "root", "admin_password": "pw", "disable_auth_on_inference": true } }`)
  const a2 = try fields(find(try fields(find(try fields(r2.text), "governance")!), "auth_config")!)
  expect(rawBool(a2, "disable_auth_on_inference")).toBe(true)
  expect(rawStr(au, "username")).toBe("root")
})

test("logging plugin: content settings and the on switch go to client, and the rest is noted", () => {
  const r = try normalize(`{
    "plugins": [ { "enabled": true, "name": "logging", "config": {
      "disable_content_logging": true,
      "allow_per_request_content_storage_override": true,
      "retain_content_in_object_storage": true,
      "logging_headers": ["X-Team"]
    } } ]
  }`)
  expect(find(try fields(r.text), "plugins")).toBe("[]")
  const p = try JSON.parse(r.text) as { client?: { enable_logging?: bool, disable_content_logging?: bool, allow_per_request_content_storage_override?: bool } }
  expect(p.client!.enable_logging).toBe(true)
  expect(p.client!.disable_content_logging).toBe(true)
  expect(p.client!.allow_per_request_content_storage_override).toBe(true)
  expect(r.notes.includes(`config: plugin "logging" read into "client": enable_logging, disable_content_logging, allow_per_request_content_storage_override`)).toBe(true)
  expect(r.notes.includes(`config: "plugins[logging].config.retain_content_in_object_storage" is not supported by Raiju and is ignored`)).toBe(true)
  expect(r.notes.includes(`config: "plugins[logging].config.logging_headers" is not supported by Raiju and is ignored`)).toBe(true)
})

test("logging plugin: a client setting already in the file wins, with a note", () => {
  const r = try normalize(`{
    "client": { "disable_content_logging": false },
    "plugins": [ { "enabled": true, "name": "logging", "config": { "disable_content_logging": true } } ]
  }`)
  const p = try JSON.parse(r.text) as { client?: { enable_logging?: bool, disable_content_logging?: bool } }
  expect(p.client!.disable_content_logging).toBe(false)
  expect(p.client!.enable_logging).toBe(true)
  expect(r.notes.includes(`config: "plugins[logging].config.disable_content_logging" is ignored: "client.disable_content_logging" is set, and it wins`)).toBe(true)
  expect(r.notes.includes(`config: plugin "logging" read into "client": enable_logging`)).toBe(true)
})

test("logging plugin that is off is not loaded and maps nothing", () => {
  const r = try normalize(`{ "plugins": [ { "enabled": false, "name": "logging", "config": { "disable_content_logging": true } } ] }`)
  expect(find(try fields(r.text), "client")).toBeUndefined()
  expect(find(try fields(r.text), "plugins")).toBe("[]")
  expect(r.notes.includes(`config: plugin "logging" is disabled in Bifrost and is not loaded`)).toBe(true)
})

test("telemetry plugin: custom_labels become client.prometheus_labels, and the Push Gateway and overhead settings are noted", () => {
  const r = try normalize(`{
    "plugins": [ { "enabled": true, "name": "telemetry", "config": {
      "custom_labels": ["team", "env"],
      "metrics_enabled": false,
      "overhead_breakdown_enabled": true,
      "user_labels_enabled": false,
      "push_gateway": { "enabled": true, "push_gateway_url": "http://pushgateway:9091", "job_name": "bifrost", "push_interval": 15 }
    } } ]
  }`)
  expect(find(try fields(r.text), "plugins")).toBe("[]")
  const p = try JSON.parse(r.text) as { client?: { prometheus_labels?: string[] } }
  expect(p.client!.prometheus_labels!.length).toBe(2)
  expect(p.client!.prometheus_labels![0]).toBe("team")
  expect(p.client!.prometheus_labels![1]).toBe("env")
  expect(r.notes.includes(`config: "plugins[telemetry].config.metrics_enabled" is not supported by Raiju and is ignored: Raiju always serves /metrics`)).toBe(true)
  const tel = try JSON.parse(r.text) as { telemetry?: { overhead_breakdown_enabled?: bool, user_labels_enabled?: bool } }
  expect(tel.telemetry!.overhead_breakdown_enabled).toBe(true)
  expect(tel.telemetry!.user_labels_enabled).toBe(false)
  expect(r.notes.some((n) => n.includes("overhead_breakdown_enabled") && n.includes("ignored"))).toBe(false)
  expect(r.notes.includes(`config: "plugins[telemetry].config.push_gateway" is not supported by Raiju and is ignored`)).toBe(false)
  const pgw = try JSON.parse(r.text) as { telemetry?: { push_gateway?: { push_gateway_url?: string, job_name?: string } } }
  expect(pgw.telemetry!.push_gateway!.push_gateway_url).toBe("http://pushgateway:9091")
  expect(pgw.telemetry!.push_gateway!.job_name).toBe("bifrost")
  expect(r.notes.includes(`config: "plugins[telemetry].config.custom_labels" is not supported by Raiju and is ignored`)).toBe(false)
})

test("telemetry plugin: metrics_enabled true is Raiju's behaviour, so it is not noted", () => {
  const r = try normalize(`{ "plugins": [ { "enabled": true, "name": "telemetry", "config": { "metrics_enabled": true } } ] }`)
  expect(r.notes.some((n) => n.includes("metrics_enabled"))).toBe(false)
  expect(find(try fields(r.text), "client")).toBeUndefined()
})

test("governance plugin: is_vk_mandatory enforces auth and required_headers carry over; the rest is noted", () => {
  const r = try normalize(`{
    "plugins": [ { "enabled": true, "name": "governance", "config": {
      "is_vk_mandatory": true,
      "required_headers": ["x-team", "x-cost-center"],
      "is_enterprise": false,
      "disable_auto_tool_inject": true
    } } ]
  }`)
  expect(find(try fields(r.text), "plugins")).toBe("[]")
  const p = try JSON.parse(r.text) as { client?: { enforce_auth_on_inference?: bool, required_headers?: string[] } }
  expect(p.client!.enforce_auth_on_inference).toBe(true)
  expect(p.client!.required_headers!.length).toBe(2)
  expect(p.client!.required_headers![1]).toBe("x-cost-center")
  expect(r.notes.includes(`config: plugin "governance" read into "client": enforce_auth_on_inference, required_headers`)).toBe(true)
  expect(r.notes.includes(`config: "plugins[governance].config.is_enterprise" is not supported by Raiju and is ignored`)).toBe(true)
  expect(r.notes.includes(`config: "plugins[governance].config.disable_auto_tool_inject" is not supported by Raiju and is ignored`)).toBe(true)
})

test("governance plugin: an enforce flag already in the client section wins, and is_vk_mandatory false is kept", () => {
  const taken = try normalize(`{ "client": { "enforce_governance_header": false }, "plugins": [ { "enabled": true, "name": "governance", "config": { "is_vk_mandatory": true } } ] }`)
  const tc = try JSON.parse(taken.text) as { client?: { enforce_governance_header?: bool, enforce_auth_on_inference?: bool } }
  expect(tc.client!.enforce_governance_header).toBe(false)
  expect(tc.client!.enforce_auth_on_inference).toBeUndefined()
  expect(taken.notes.includes(`config: "plugins[governance].config.is_vk_mandatory" is ignored: "client.enforce_auth_on_inference" is set, and it wins`)).toBe(true)
  const off = try normalize(`{ "plugins": [ { "enabled": true, "name": "governance", "config": { "is_vk_mandatory": false } } ] }`)
  const oc = try JSON.parse(off.text) as { client?: { enforce_auth_on_inference?: bool } }
  expect(oc.client!.enforce_auth_on_inference).toBe(false)
})

test("routing plugin: chain depth and the analyzer's tier boundaries are noted; nothing is copied to complexity_router", () => {
  const r = try normalize(`{
    "plugins": [ { "enabled": true, "name": "routing", "config": {
      "routing_chain_max_depth": 5,
      "complexity_analyzer_config": {
        "tier_boundaries": { "simple_medium": 0.2, "medium_complex": 0.4 },
        "keywords": { "simple_keywords": ["hi"] },
        "classifier": "semantic"
      }
    } } ]
  }`)
  expect(find(try fields(r.text), "plugins")).toBe("[]")
  expect(find(try fields(r.text), "complexity_router")).toBeUndefined()
  expect(r.notes.includes(`config: "plugins[routing].config.routing_chain_max_depth" is not supported by Raiju and is ignored`)).toBe(true)
  expect(r.notes.includes(`config: "plugins[routing].config.complexity_analyzer_config.tier_boundaries" is not supported by Raiju and is ignored`)).toBe(true)
  expect(r.notes.includes(`config: "plugins[routing].config.complexity_analyzer_config.keywords" is not supported by Raiju and is ignored`)).toBe(true)
  expect(r.notes.includes(`config: "plugins[routing].config.complexity_analyzer_config.classifier" is not supported by Raiju and is ignored`)).toBe(true)
  expect(r.notes.some((n) => n.includes("0 to 1 scale"))).toBe(true)
})

test("routing plugin: a decision classifier and its model are read into complexity_router", () => {
  const r = try normalize(`{
    "plugins": [ { "enabled": true, "name": "routing", "config": {
      "complexity_analyzer_config": {
        "classifier": "decision",
        "decision": { "provider": "typesafe", "model": "jev-latest", "timeout": "1.5s", "previous_message_count": 2, "criteria": {} }
      }
    } } ]
  }`)
  const cr = try fields(find(try fields(r.text), "complexity_router") ?? "{}")
  expect(rawStr(cr, "classifier")).toBe("decision")
  expect(rawBool(cr, "enabled")).toBe(true)
  const dm = try fields(find(cr, "decision") ?? "{}")
  expect(rawStr(dm, "provider")).toBe("typesafe")
  expect(rawStr(dm, "model")).toBe("jev-latest")
  expect(find(dm, "timeout_ms")).toBe("1500")
  expect(find(dm, "previous_message_count")).toBe("2")
  expect(r.notes.includes(`config: "plugins[routing].config.complexity_analyzer_config.decision.criteria" is not supported by Raiju and is ignored`)).toBe(true)
})

test("routing plugin: an llm block without a decision classifier is the llm classifier", () => {
  const r = try normalize(`{
    "plugins": [ { "enabled": true, "name": "routing", "config": {
      "complexity_analyzer_config": { "llm": { "provider": "openai", "model": "gpt-4o-mini", "timeout": 4000, "message_history_count": 3 } }
    } } ]
  }`)
  const cr = try fields(find(try fields(r.text), "complexity_router") ?? "{}")
  expect(rawStr(cr, "classifier")).toBe("llm")
  const lm = try fields(find(cr, "llm") ?? "{}")
  expect(find(lm, "timeout_ms")).toBe("4000")
  expect(find(lm, "message_history_count")).toBe("3")
})

test("the compat plugin's features are read into client.compat; prompts are noted and not loaded", () => {
  const r = try normalize(`{
    "plugins": [
      { "enabled": true, "name": "compat", "config": { "convert_text_to_chat": true, "should_drop_params": true, "convert_decision_to_responses": true, "retain_it": 1 } },
      { "enabled": true, "name": "prompts", "config": { "store_path": "/data/prompts" } }
    ]
  }`)
  expect(find(try fields(r.text), "plugins")).toBe("[]")
  const cl = try fields(find(try fields(r.text), "client") ?? "{}")
  expect(find(cl, "compat")).toBe(`{"convert_text_to_chat":true,"should_drop_params":true,"convert_decision_to_responses":true}`)
  expect(r.notes.includes(`config: plugin "compat" read into "client": compat`)).toBe(true)
  expect(r.notes.some((n) => n.includes("no decision is emulated"))).toBe(true)
  expect(r.notes.includes(`config: "plugins[compat].config.retain_it" is not supported by Raiju and is ignored`)).toBe(true)
  expect(r.notes.some((n) => n.includes(`"plugins[compat].config.convert_text_to_chat"`))).toBe(false)
  expect(r.notes.some((n) => n.startsWith(`config: plugin "prompts" is not loaded as a plugin: Raiju's prompt repository is always on`))).toBe(true)
  expect(r.notes.includes(`config: "plugins[prompts].config.store_path" is not supported by Raiju and is ignored`)).toBe(true)
})

test("a disabled governance plugin is not loaded, and an unknown plugin name is left in plugins", () => {
  const r = try normalize(`{
    "plugins": [
      { "enabled": false, "name": "governance", "config": { "is_vk_mandatory": true } },
      { "enabled": true, "name": "webhooks", "config": { "url": "https://h" } }
    ]
  }`)
  expect(find(try fields(r.text), "client")).toBeUndefined()
  const plugins = try elements(find(try fields(r.text), "plugins")!)
  expect(plugins.length).toBe(1)
  expect(rawStr(try fields(plugins[0]!), "name")).toBe("webhooks")
  expect(r.notes.includes(`config: plugin "governance" is disabled in Bifrost and is not loaded`)).toBe(true)
})

test("provider options Raiju applies are not flagged; the ones it does not apply are", () => {
  const w = try warnings(`{
    "encryption_key": "env.RAIJU_TEST_KEY",
    "providers": { "openai": {
      "keys": [ { "value": "sk-x", "use_for_batch_api": false } ],
      "prompt_cache": { "auto_inject": true, "ttl": "1h" },
      "openai_config": { "disable_store": true },
      "concurrency_and_buffer_size": { "concurrency": 2, "buffer_size": 5 },
      "injected_tools": [],
      "store_raw_request_response": true,
      "ignore_provider_cost": false,
      "custom_provider_config": { "base_provider_type": "openai", "allowed_requests": { "chat_completion": true }, "request_path_overrides": {}, "wait_for_usage": true }
    } }
  }`)
  expect(w.length).toBe(0)
  expect(w.some((x) => x.includes("use_for_batch_api") || x.includes("prompt_cache") || x.includes("ignore_provider_cost"))).toBe(false)
})

test("notes name each Bifrost section Raiju does not read", () => {
  const w = try warnings(`{ "setup_token": "x", "websocket": {}, "large_payload_optimization": {}, "feature_flags": {}, "version": "1", "access_profiles": [], "agents": [], "client": { "compat": {}, "mcp_disable_auto_tool_inject": true } }`)
  expect(w.some((x) => x.includes(`"setup_token"`))).toBe(false)
  expect(w.includes(`config: "websocket" is accepted but not applied: Raiju's WebSocket limits are fixed in src/ws.tov`)).toBe(true)
  expect(w.includes(`config: "large_payload_optimization" is not implemented: Raiju buffers request bodies up to client.max_request_body_size_mb`)).toBe(true)
  expect(w.some((x) => x.includes(`"feature_flags"`))).toBe(false)
  expect(w.some((x) => x.includes(`"version"`))).toBe(false)
  expect(w.some((x) => x.includes(`"client.compat"`))).toBe(false)
  expect(w.some((x) => x.includes(`"access_profiles" is not read`))).toBe(true)
  expect(w.some((x) => x.includes(`"encryption_key"`))).toBe(false)
})

test("webhook secrets and headers in Bifrost's object form become strings", () => {
  const r = try normalize(`{ "webhooks": [{ "name": "a", "url": "https://h.example.com", "events": ["async_job.completed"], "secret": { "from_env": true, "env_var": "HOOK_SECRET" }, "headers": { "X-Key": { "value": "plain-value" }, "X-Plain": "kept" } }] }`)
  expect(r.text.includes(`"secret":"env.HOOK_SECRET"`)).toBe(true)
  expect(r.text.includes(`"X-Key":"plain-value"`)).toBe(true)
  expect(r.text.includes(`"X-Plain":"kept"`)).toBe(true)
})

test("sink plugins become exporters: bigquery and pubsub fields, content, and the ignored rest", () => {
  const r = try normalize(`{
    "plugins": [
      { "enabled": true, "name": "bigquery", "config": { "project_id": "p", "dataset_id": "ds", "table_id": "tb",
        "service_account_key": "env.GCP_KEY", "buffer_size": 100, "flush_interval_seconds": 7, "location": "EU",
        "disable_content_logging": true, "custom_labels": {"a": "b"} } },
      { "enabled": true, "name": "pubsub", "config": { "project_id": "p", "topic_id": "t", "auto_create_topic": true } },
      { "enabled": true, "name": "maxtokens", "config": {} }
    ]
  }`)
  const ex = try elements(find(try fields(r.text), "exporters")!)
  expect(ex.length).toBe(2)
  const bq = try fields(ex[0]!)
  expect(rawStr(bq, "kind")).toBe("bigquery")
  expect(rawStr(bq, "project_id")).toBe("p")
  expect(rawStr(bq, "dataset_id")).toBe("ds")
  expect(rawStr(bq, "service_account_key")).toBe("env.GCP_KEY")
  expect(find(bq, "batch_size")).toBe("100")
  expect(find(bq, "interval_seconds")).toBe("7")
  expect(find(bq, "include_content")).toBe("false")
  const ps = try fields(ex[1]!)
  expect(rawStr(ps, "topic_id")).toBe("t")
  expect(find(ps, "include_content")).toBe("true")
  expect(r.notes.includes(`config: "plugins[bigquery].config.location" is not supported by Raiju and is ignored`)).toBe(true)
  expect(r.notes.includes(`config: "plugins[pubsub].config.auto_create_topic" is not supported by Raiju and is ignored`)).toBe(true)
  // the sink plugins are no longer in plugins; the unknown one stays
  expect(try elements(find(try fields(r.text), "plugins")!).length).toBe(1)
})

test("kafka plugin: brokers, PLAIN sasl and tls; SCRAM is refused with a note", () => {
  const r = try normalize(`{
    "plugins": [
      { "enabled": true, "name": "kafka", "config": { "brokers": ["k1:9093"], "topic": "logs", "tls_enabled": true,
        "sasl_enabled": true, "sasl": { "mechanism": "PLAIN", "username": "u", "password": "env.KP" },
        "compression": "zstd", "batch_size": 50, "flush_interval_ms": 2500 } }
    ]
  }`)
  const k = try fields(try elements(find(try fields(r.text), "exporters")!)[0]!)
  expect(find(k, "brokers")).toBe(`["k1:9093"]`)
  expect(rawStr(k, "topic")).toBe("logs")
  expect(find(k, "tls")).toBe("true")
  expect(rawStr(k, "sasl_username")).toBe("u")
  expect(rawStr(k, "sasl_password")).toBe("env.KP")
  expect(find(k, "interval_seconds")).toBe("3")
  expect(find(k, "batch_size")).toBe("50")
  expect(r.notes.includes(`config: "plugins[kafka].config.compression" is not supported by Raiju (records are sent uncompressed)`)).toBe(true)
  const scram = try normalize(`{ "plugins": [ { "enabled": true, "name": "kafka", "config": { "brokers": ["k"], "topic": "t", "sasl_enabled": true, "sasl": { "mechanism": "SCRAM-SHA-256", "username": "u", "password": "p" } } } ] }`)
  expect(scram.notes.includes(`config: plugin "kafka" uses SASL SCRAM-SHA-256; Raiju supports PLAIN only, so the plugin is not loaded`)).toBe(true)
  expect(find(try fields(scram.text), "exporters")).toBe(undefined)
})

test("maxim plugin: api key and log repo id; a disabled sink is not loaded", () => {
  const r = try normalize(`{
    "plugins": [
      { "enabled": true, "name": "maxim", "config": { "api_key": "mk", "log_repo_id": "repo" } },
      { "enabled": false, "name": "kafka", "config": { "brokers": ["k"], "topic": "t" } }
    ]
  }`)
  const ex = try elements(find(try fields(r.text), "exporters")!)
  expect(ex.length).toBe(1)
  const m = try fields(ex[0]!)
  expect(rawStr(m, "api_key")).toBe("mk")
  expect(rawStr(m, "log_repo_id")).toBe("repo")
  expect(rawStr(m, "kind")).toBe("maxim")
})

test("MCP client durations, tool manager settings and tool group associations", () => {
  const r = try normalize(`{
    "client": { "mcp_tool_sync_interval": 300000000000 },
    "mcp": {
      "tool_sync_interval": "5m",
      "tool_manager_config": { "tool_execution_timeout": 45, "max_agent_depth": 4, "disable_auto_tool_inject": true, "oauth_private_allowlist": ["10.0.0.1"] },
      "client_configs": [ { "name": "git", "connection_type": "http", "connection_string": "https://g.example/mcp", "tool_execution_timeout": 90, "tool_sync_interval": 90000000000 } ],
      "tool_groups": [ { "name": "ops", "enabled": true, "team_ids": ["t1"], "tools": [ { "mcp_client_name": "git", "tool_names": ["*"] } ] } ]
    },
    "governance": { "virtual_keys": [ { "id": "vk-a", "team_id": "t1", "value": "env.A" }, { "id": "vk-b", "team_id": "t2", "value": "env.B" } ] }
  }`)
  const mcp = try fields(find(try fields(r.text), "mcp")!)
  expect(find(mcp, "tool_sync_interval")).toBe('"5m"')
  expect(find(mcp, "tool_manager_config")).toBeUndefined()
  expect(find(mcp, "tool_execution_timeout_seconds")).toBe("45")
  expect(find(mcp, "oauth_private_allowlist")).toBe('["10.0.0.1"]')
  const cl = try fields(find(try fields(r.text), "client")!)
  expect(find(cl, "mcp_agent_depth")).toBe("4")
  expect(find(cl, "mcp_disable_auto_tool_inject")).toBe("true")
  expect(find(cl, "mcp_tool_sync_interval")).toBeUndefined()
  const cc = try elements(find(mcp, "client_configs")!)
  const g = try fields(cc[0]!)
  expect(rawStr(g, "tool_execution_timeout")).toBe("90s")
  expect(rawStr(g, "tool_sync_interval")).toBe("90s")
  const vm = try elements(find(try fields(r.text), "virtual_mcps")!)
  expect(vm.length).toBe(1)
  expect(find(try fields(vm[0]!), "allowed_keys")).toBe('["vk-a"]')
  expect(r.notes.includes(`config: "client.mcp_tool_sync_interval" is ignored: "mcp.tool_sync_interval" is set, and it wins`)).toBe(true)
})

test("the older client-level tool sync interval becomes the global default when mcp sets none", () => {
  const r = try normalize(`{ "client": { "mcp_tool_sync_interval": 300000000000 }, "mcp": { "client_configs": [] } }`)
  const mcp = try fields(find(try fields(r.text), "mcp")!)
  expect(find(mcp, "tool_sync_interval")).toBe('"300s"')
  expect(r.notes.includes(`config: "client.mcp_tool_sync_interval" read as "mcp.tool_sync_interval"`)).toBe(true)
})

