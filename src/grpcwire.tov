// gRPC on the HTTP/2 server (h2.tov): the server side of the wire format. Each message
// is a 5-byte prefix (a compressed flag and a 4-byte length) and the message bytes. Messages
// are raw bytes here; the service decodes them (protobuf is not in this module). A call
// answers with its status in the trailers, or in a trailers-only response when it fails
// before any message. The client side is grpc.tov.

import { H2Body, H2Header, H2Reply, H2Request, H2Handler } from "./h2"
import { grpcFrame, percentDecode, headerValue } from "./grpc"
import { detailsHeader } from "./grpcstatus"
import { gzipBytes } from "./gzip"

export const GRPC_OK: int = 0
export const GRPC_CANCELLED: int = 1
export const GRPC_UNKNOWN: int = 2
export const GRPC_INVALID_ARGUMENT: int = 3
export const GRPC_DEADLINE_EXCEEDED: int = 4
export const GRPC_NOT_FOUND: int = 5
export const GRPC_ALREADY_EXISTS: int = 6
export const GRPC_PERMISSION_DENIED: int = 7
export const GRPC_RESOURCE_EXHAUSTED: int = 8
export const GRPC_FAILED_PRECONDITION: int = 9
export const GRPC_ABORTED: int = 10
export const GRPC_OUT_OF_RANGE: int = 11
export const GRPC_UNIMPLEMENTED: int = 12
export const GRPC_INTERNAL: int = 13
export const GRPC_UNAVAILABLE: int = 14
export const GRPC_DATA_LOSS: int = 15
export const GRPC_UNAUTHENTICATED: int = 16

// A failure of a call with its status. Thrown by a method, it becomes the call's status. details, when set, is
// a google.rpc.Status (grpcstatus.tov), sent as grpc-status-details-bin.
export class GrpcError extends Error {
  details: u8[] = []

  constructor(readonly code: int, message: string) {
    super(message)
  }
}

// The HTTP status of a non-gRPC answer, as gRPC maps it (the spec's HTTP to gRPC table).
export function httpToGrpc(status: int): int {
  if (status === 400) return GRPC_INTERNAL
  if (status === 401) return GRPC_UNAUTHENTICATED
  if (status === 403) return GRPC_PERMISSION_DENIED
  if (status === 404) return GRPC_UNIMPLEMENTED
  if (status === 429 || status === 502 || status === 503 || status === 504) return GRPC_UNAVAILABLE
  return GRPC_UNKNOWN
}

// A grpc-timeout value (digits and a unit: H, M, S, m, u, n) in milliseconds, rounded down;
// -1 when it is malformed. At most 8 digits, as the spec allows.
export function parseTimeout(v: string): int {
  const b = new TextEncoder().encode(v)
  if (b.length < 2 || b.length > 9) return -1
  let n: int = 0
  for (let i = 0; i < b.length - 1; i++) {
    const d = int(b[i]!) - 48
    if (d < 0 || d > 9) return -1
    n = n * 10 + d
  }
  const unit = int(b[b.length - 1]!)
  if (unit === 72) return n * 3600000
  if (unit === 77) return n * 60000
  if (unit === 83) return n * 1000
  if (unit === 109) return n
  if (unit === 117) return Math.floor(n / 1000)
  if (unit === 110) return Math.floor(n / 1000000)
  return -1
}

// grpc-message: UTF-8 with every byte outside printable ASCII, and '%', written as %XX.
export function percentEncode(s: string): string throws Error {
  const digits = new TextEncoder().encode("0123456789ABCDEF")
  const out: u8[] = []
  for (const b of new TextEncoder().encode(s)) {
    const c = int(b)
    if (c >= 32 && c <= 126 && c !== 37) {
      out.push(b)
    } else {
      out.push(u8(37))
      out.push(digits[c >> 4]!)
      out.push(digits[c & 15]!)
    }
  }
  const d = try new TextDecoder()
  return try d.decode(out)
}

// The message encodings gRPC calls here may use besides identity: gzip, the one compressor Bifrost's gRPC server and
// client have (grpc-go's, registered by the OpenTelemetry exporters it links).
export const GRPC_ENCODINGS = "gzip"

// Whether a grpc-encoding value is one messages can be read in ("", identity or gzip).
export function knownEncoding(enc: string): bool {
  return enc === "" || enc === "identity" || enc === "gzip"
}

// A message compressed for grpc-encoding gzip, framed with the compressed flag.
export function gzipFrame(msg: u8[]): u8[] {
  const z = gzipBytes(msg)
  const n = z.length
  const out: u8[] = [u8(1), u8((n >> 24) & 255), u8((n >> 16) & 255), u8((n >> 8) & 255), u8(n & 255)]
  for (const b of z) out.push(b)
  return out
}

// Splits the request body into messages. Bytes come in pieces, as the body delivers them.
export class GrpcDeframer {
  private buf: u8[] = []
  // the stream's grpc-encoding: a message with the compressed flag is decoded with it (grpc-go's checks and messages)
  encoding: string = ""

  constructor(readonly maxRecv: int) {}

  push(b: u8[]): void {
    for (const x of b) this.buf.push(x)
  }

  // Bytes held that are not yet a message.
  pending(): int {
    return this.buf.length
  }

  // The next whole message, or undefined while it is incomplete. A compressed message is decoded with the stream's
  // grpc-encoding (gzip), and refused under identity or an encoding that is not known; a message over maxRecv is
  // refused, before and after it is decompressed.
  next(): u8[] | undefined throws GrpcError {
    if (this.buf.length < 5) return undefined
    const flag = int(this.buf[0]!)
    if (flag > 1) throw new GrpcError(GRPC_INTERNAL, `grpc: received unexpected payload format ${flag}`)
    const n = (int(this.buf[1]!) << 24) | (int(this.buf[2]!) << 16) | (int(this.buf[3]!) << 8) | int(this.buf[4]!)
    if (n > this.maxRecv) throw new GrpcError(GRPC_RESOURCE_EXHAUSTED, `grpc: received message larger than max (${n} vs. ${this.maxRecv})`)
    if (this.buf.length < 5 + n) return undefined
    const msg = this.buf.slice(5, 5 + n)
    this.buf = this.buf.slice(5 + n)
    if (flag === 0) return msg
    const enc = this.encoding
    if (enc === "" || enc === "identity") throw new GrpcError(GRPC_INTERNAL, "grpc: compressed flag set with identity or empty encoding")
    if (enc !== "gzip") throw new GrpcError(GRPC_UNIMPLEMENTED, `grpc: Decompressor is not installed for grpc-encoding "${enc}"`)
    let out: u8[] = []
    try {
      out = try Bun.gunzipSync(msg, { maxOutputLength: this.maxRecv })
    } catch (e) {
      if (e.message.includes("size limit")) throw new GrpcError(GRPC_RESOURCE_EXHAUSTED, `grpc: received message after decompression larger than max ${this.maxRecv}`)
      throw new GrpcError(GRPC_INTERNAL, `grpc: failed to decompress the received message: ${e.message}`)
    }
    return out
  }
}

// Metadata the transport owns: it is not passed to the method.
function transportHeader(name: string): bool {
  if (name.startsWith(":")) return true
  return name === "content-type" || name === "te" || name === "grpc-timeout" || name === "grpc-encoding" || name === "grpc-accept-encoding" || name === "user-agent" || name === "content-length"
}

// One call on the server: the request's metadata and deadline, its messages in and out, and
// its status. The head is sent with the first message, or with sendHeaders.
export class GrpcCall {
  // the request's metadata (without the transport's own fields)
  metadata: H2Header[] = []
  // the :authority the call was dialed with (host and port as sent)
  authority: string = ""
  // the deadline as Date.now() milliseconds, when the request set grpc-timeout
  deadlineMs: int | undefined = undefined
  // extra trailing metadata, sent with the status
  trailers: H2Header[] = []
  // the request's grpc-encoding when it is gzip: the answer's messages are compressed with it too, as grpc-go's server
  // answers in the encoding it was called with
  encoding: string = ""
  private headSent: bool = false
  private ended: bool = false
  private df: GrpcDeframer
  private body: H2Body
  private reply: H2Reply

  constructor(req: H2Request, reply: H2Reply, maxRecv: int) {
    this.body = req.body
    this.reply = reply
    this.authority = req.authority
    this.df = new GrpcDeframer(maxRecv)
    for (const h of req.headers) {
      if (!transportHeader(h.name)) this.metadata.push(h)
    }
  }

  // Sends the response head with metadata. Once; a message sends it when it has not gone.
  sendHeaders(md: H2Header[]): void {
    if (this.headSent) return
    this.headSent = true
    const hs: H2Header[] = [{ name: "content-type", value: "application/grpc" }]
    if (this.encoding === "gzip") hs.push({ name: "grpc-encoding", value: "gzip" })
    for (const h of md) hs.push(h)
    this.reply.headers(hs)
  }

  // The request's grpc-encoding: its compressed messages are read with it, and the answer is sent in it.
  setEncoding(enc: string): void {
    const e = enc === "identity" ? "" : enc
    this.encoding = e
    this.df.encoding = e
  }

  // The next request message, or undefined at the end of the request. A bad frame, or a
  // message over the limit, is a GrpcError.
  async recv(): Promise<u8[] | undefined, Error> {
    while (true) {
      const m = try this.df.next()
      if (m !== undefined) return m
      const piece = try await this.body.next()
      if (piece === undefined) {
        if (this.df.pending() === 0) return undefined
        throw new GrpcError(GRPC_INTERNAL, "the request ends inside a message")
      }
      this.df.push(piece)
    }
  }

  // Runs f when the client cancels the call (RST_STREAM) or its connection is lost, so the work behind it can stop.
  onCancel(f: () => void): void {
    this.body.onReset(f)
  }

  // Sends one response message.
  async send(msg: u8[]): Promise<void, Error> {
    this.sendHeaders([])
    try await this.reply.write(this.encoding === "gzip" ? gzipFrame(msg) : grpcFrame(msg))
  }

  // The status of the call, once. Before any head it is a trailers-only response; after
  // one, the status goes in the trailers.
  // details is a google.rpc.Status, sent in grpc-status-details-bin (unpadded base64).
  finish(status: int, message: string, details?: u8[]): void throws Error {
    if (this.ended) return
    this.ended = true
    const tr: H2Header[] = [{ name: "grpc-status", value: "" + status }]
    if (message !== "") tr.push({ name: "grpc-message", value: try percentEncode(message) })
    const d: u8[] = details ?? []
    if (d.length > 0) tr.push({ name: "grpc-status-details-bin", value: detailsHeader(d) })
    for (const h of this.trailers) tr.push(h)
    if (!this.headSent) {
      this.headSent = true
      const hs: H2Header[] = [{ name: "content-type", value: "application/grpc" }]
      for (const h of tr) hs.push(h)
      this.reply.trailersOnly(hs)
    } else {
      this.reply.end(tr)
    }
  }
}

// A method's body: it gets the call and sends its messages; a GrpcError is its status.
export type GrpcRun = (call: GrpcCall) => Promise<void, Error>

// A unary method: one request message, one response message.
export function unaryRun(fn: (req: u8[], call: GrpcCall) => Promise<u8[], Error>): GrpcRun {
  return async (call: GrpcCall): Promise<void, Error> => {
    const req = try await call.recv()
    if (req === undefined) throw new GrpcError(GRPC_INTERNAL, "no request message")
    const more = try await call.recv()
    if (more !== undefined) throw new GrpcError(GRPC_INTERNAL, "more than one request message")
    const out = try await fn(req, call)
    try await call.send(out)
  }
}

// A server-streaming method: one request message, then as many responses as fn sends.
export function serverRun(fn: (req: u8[], call: GrpcCall) => Promise<void, Error>): GrpcRun {
  return async (call: GrpcCall): Promise<void, Error> => {
    const req = try await call.recv()
    if (req === undefined) throw new GrpcError(GRPC_INTERNAL, "no request message")
    try await fn(req, call)
  }
}

// A client-streaming method: the request messages in, one response message out.
export function clientRun(fn: (call: GrpcCall) => Promise<u8[], Error>): GrpcRun {
  return async (call: GrpcCall): Promise<void, Error> => {
    const out = try await fn(call)
    try await call.send(out)
  }
}

// The method's run to the end, then its status. A GrpcError is its code; anything else is
// INTERNAL, with no detail sent.
async function runCall(run: GrpcRun, call: GrpcCall): Promise<void, Error> {
  let code: int = GRPC_OK
  let msg = ""
  let details: u8[] = []
  try {
    try await run(call)
  } catch (e) {
    if (e instanceof GrpcError) {
      code = e.code
      msg = e.message
      details = e.details
    } else {
      code = GRPC_INTERNAL
      msg = "internal error"
    }
  }
  try call.finish(code, msg, details)
}

// An h2 handler that serves gRPC: methods by path (/pkg.Service/Method), maxRecv the largest
// request message (grpc-go's default is 4 MiB). Anything else is answered as gRPC does: a
// non-POST is 405, a content type other than application/grpc is 415, an unknown method is
// UNIMPLEMENTED, and a malformed grpc-timeout is INTERNAL.
export function grpcServe(methods: Map<string, GrpcRun>, maxRecv: int): H2Handler {
  return (req: H2Request, res: H2Reply) => {
    if (req.method !== "POST") {
      res.trailersOnly([{ name: ":status", value: "405" }])
      return
    }
    const ct = headerValue(req.headers, "content-type") ?? ""
    if (!ct.startsWith("application/grpc")) {
      res.trailersOnly([{ name: ":status", value: "415" }])
      return
    }
    const call = new GrpcCall(req, res, maxRecv)
    // gzip messages are read (and the answer sent in gzip); another encoding is grpc-go's UNIMPLEMENTED, with the
    // encodings this server reads
    const enc = headerValue(req.headers, "grpc-encoding") ?? ""
    if (!knownEncoding(enc)) {
      call.trailers.push({ name: "grpc-accept-encoding", value: GRPC_ENCODINGS })
      try call.finish(GRPC_UNIMPLEMENTED, `grpc: Decompressor is not installed for grpc-encoding "${enc}"`)
      return
    }
    call.setEncoding(enc)
    const to = headerValue(req.headers, "grpc-timeout")
    if (to !== undefined) {
      const ms = parseTimeout(to)
      if (ms < 0) {
        try call.finish(GRPC_INTERNAL, "malformed time-out")
        return
      }
      call.deadlineMs = Math.trunc(Date.now()) + ms
    }
    const run = methods.get(req.path)
    if (run === undefined) {
      try call.finish(GRPC_UNIMPLEMENTED, "unknown method " + req.path)
      return
    }
    runCall(run, call)
  }
}

// ---- tests ----

test("gRPC status codes and the HTTP mapping table", () => {
  expect(GRPC_UNIMPLEMENTED).toBe(12)
  expect(GRPC_UNAUTHENTICATED).toBe(16)
  expect(httpToGrpc(401)).toBe(GRPC_UNAUTHENTICATED)
  expect(httpToGrpc(404)).toBe(GRPC_UNIMPLEMENTED)
  expect(httpToGrpc(429)).toBe(GRPC_UNAVAILABLE)
  expect(httpToGrpc(503)).toBe(GRPC_UNAVAILABLE)
  expect(httpToGrpc(500)).toBe(GRPC_UNKNOWN)
  expect(httpToGrpc(200)).toBe(GRPC_UNKNOWN)
})

test("grpc-timeout: each unit, and malformed values", () => {
  expect(parseTimeout("5S")).toBe(5000)
  expect(parseTimeout("100m")).toBe(100)
  expect(parseTimeout("2M")).toBe(120000)
  expect(parseTimeout("1H")).toBe(3600000)
  expect(parseTimeout("1500u")).toBe(1)
  expect(parseTimeout("2000000n")).toBe(2)
  expect(parseTimeout("")).toBe(-1)
  expect(parseTimeout("S")).toBe(-1)
  expect(parseTimeout("5x")).toBe(-1)
  expect(parseTimeout("1.5S")).toBe(-1)
  expect(parseTimeout("123456789S")).toBe(-1)
})

test("grpc-message percent-encodes what is not printable ASCII, and decodes back", () => {
  expect(try percentEncode("plain text")).toBe("plain text")
  expect(try percentEncode("100%")).toBe("100%25")
  expect(try percentEncode("wörld")).toBe("w%C3%B6rld")
  expect(try percentDecode(try percentEncode("wörld 100% \n"))).toBe("wörld 100% \n")
})

test("the deframer joins messages across pieces and refuses compressed or oversize ones", () => {
  const d = new GrpcDeframer(16)
  // one message of 3 bytes, cut into single bytes, then a second message whole
  const wire = grpcFrame([u8(1), u8(2), u8(3)]).concat(grpcFrame([u8(9)]))
  let got: u8[][] = []
  for (const b of wire) {
    d.push([b])
    const m = try d.next()
    if (m !== undefined) got.push(m)
  }
  expect(got).toEqual([[u8(1), u8(2), u8(3)], [u8(9)]])
  expect(d.pending()).toBe(0)

  // the compressed flag under identity is grpc-go's INTERNAL
  let compressed = false
  try {
    const c = new GrpcDeframer(16)
    c.push([u8(1), u8(0), u8(0), u8(0), u8(0)])
    const x = try c.next()
  } catch (e) {
    compressed = e instanceof GrpcError && e.code === GRPC_INTERNAL && e.message.includes("identity or empty encoding")
  }
  expect(compressed).toBe(true)

  let over = false
  try {
    const o = new GrpcDeframer(4)
    o.push([u8(0), u8(0), u8(0), u8(0), u8(5)])
    const y = try o.next()
  } catch (e) {
    over = e instanceof GrpcError && e.code === GRPC_RESOURCE_EXHAUSTED
  }
  expect(over).toBe(true)
})

test("gzip messages: read under grpc-encoding gzip, bounded after decompression, refused otherwise", () => {
  const text = new TextEncoder().encode("hello ".repeat(40))
  const d = new GrpcDeframer(1024)
  d.encoding = "gzip"
  // a compressed message, then a plain one on the same stream (the flag is per message)
  d.push(gzipFrame(text).concat(grpcFrame([u8(7)])))
  expect(try d.next()).toEqual(text)
  expect(try d.next()).toEqual([u8(7)])
  expect(d.pending()).toBe(0)
  const code = (enc: string, max: int, wire: u8[]): string => {
    try {
      const x = new GrpcDeframer(max)
      x.encoding = enc
      x.push(wire)
      const m = try x.next()
      return "ok"
    } catch (e) {
      return `${e.code} ${e.message}`
    }
  }
  // inflating past the limit is RESOURCE_EXHAUSTED, as grpc-go says it
  expect(code("gzip", 100, gzipFrame(text)).startsWith("8 grpc: received message after decompression larger than max 100")).toBe(true)
  // an encoding nobody registered is UNIMPLEMENTED, a broken stream INTERNAL, a flag above 1 INTERNAL
  expect(code("deflate", 1024, gzipFrame(text))).toBe(`12 grpc: Decompressor is not installed for grpc-encoding "deflate"`)
  expect(code("gzip", 1024, [u8(1), u8(0), u8(0), u8(0), u8(3), u8(1), u8(2), u8(3)]).startsWith("13 grpc: failed to decompress")).toBe(true)
  expect(code("gzip", 1024, [u8(2), u8(0), u8(0), u8(0), u8(0)])).toBe("13 grpc: received unexpected payload format 2")
  expect(knownEncoding("gzip")).toBe(true)
  expect(knownEncoding("identity")).toBe(true)
  expect(knownEncoding("snappy")).toBe(false)
})
