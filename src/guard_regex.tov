// Regex guardrails: each pattern has an action, block, redact or detect_only.
// Patterns run on regex.tov.
//
// The text is scanned in windows. A window of W bytes that tests as a match (gate,
// regex.tov's test()) is searched with exec(), which returns the leftmost-first match
// and its groups. Matches starting in the first STEP bytes and at most W - STEP (256)
// bytes long fit within the window and are found exactly; longer matches are cut there.
// A slice starts where searching resumes, so left-edge assertions (\b, ^) see no preceding
// text. wordB checks the actual bytes there. If a matching window's match cannot be located,
// a non-redacting rule blocks because the matching text cannot be replaced.
//
// A rule with a required literal (regex.tov's literals()) skips most windows: its gate tries
// only starts that could match through a literal occurrence in the window (windowStarts).
// scanRegions walks windows once for all rules, decoding each window once and holding only
// one window's text at a time.

import { compileRegex, Cset, Decoded, decodeText, hasBorder, LitCand, Regex } from "./regex"
import { Finding, GuardResult, redact } from "./guardrails"
import { bitShl, bitShr } from "./bits"

// A Gitleaks-style allowlist. target is "" (the secret), "match" (the whole match) or
// "line" (the line of the match). regexes and stopwords are alternatives, or, when
// all is set, every check present must hold.
export type AllowRule = {
  target?: string,
  all?: bool,
  regexes?: string[],
  stopwords?: string[],
}

export type RegexRule = {
  pattern: string,
  description?: string,
  entity_type?: string,
  flags?: string,
  action?: string,
  allowed_values?: string[],
  skip_containing?: string[],
  // Prefilter: the rule runs only on text containing one of these, ignoring case.
  keywords?: string[],
  // The span reported and redacted: a numbered group, or 0 for the first group that
  // took part (the whole match when the pattern has none).
  secret_group?: int,
  // A finding is kept only when the Shannon entropy of its secret is above this.
  entropy?: f64,
  allow?: AllowRule[],
  // A finding is dropped when its line (the line of the match) contains one of these,
  // as Gitleaks drops findings on a line with its gitleaks:allow comment.
  skip_line_containing?: string[],
}

// An Aho-Corasick automaton over lowercase ASCII literals: one pass over a lowercased text finds every occurrence of
// all of them, overlapping ones included. An allowlist pattern that is an alternation of many branches, each holding a
// literal (regex.tov wideLiterals), is tried only from the starts its literals' occurrences can reach.
export class LitMatcher {
  // the transitions (node * 128 + byte, the failure links folded in), and the literals that end at each node
  private next: int[] = []
  private outs: int[][] = []
  readonly lens: int[] = []

  constructor(lits: string[]) {
    this.addNode()
    for (const lit of lits) {
      const b = enc.encode(lit)
      let s = 0
      for (const x of b) {
        const c = int(x) & 127
        let t = this.next[s * 128 + c]!
        if (t <= 0) {
          t = this.addNode()
          this.next[s * 128 + c] = t
        }
        s = t
      }
      this.outs[s]!.push(this.lens.length)
      this.lens.push(b.length)
    }
    // breadth first: each node's missing transitions take its failure node's, and its outputs gain the failure node's
    const fail: int[] = []
    for (let i = 0; i < this.outs.length; i++) fail.push(0)
    const queue: int[] = []
    for (let c = 0; c < 128; c++) {
      const t = this.next[c]!
      if (t > 0) queue.push(t)
    }
    let head = 0
    while (head < queue.length) {
      const s = queue[head]!
      head += 1
      for (let c = 0; c < 128; c++) {
        const t = this.next[s * 128 + c]!
        const via = this.next[fail[s]! * 128 + c]!
        if (t > 0) {
          fail[t] = via
          for (const o of this.outs[via]!) this.outs[t]!.push(o)
          queue.push(t)
        } else {
          this.next[s * 128 + c] = via
        }
      }
    }
  }

  private addNode(): int {
    const id = this.outs.length
    this.outs.push([])
    for (let c = 0; c < 128; c++) this.next.push(0)
    return id
  }

  // Every occurrence in a lowercased text: its start byte and the literal's index, in pairs. A byte past ASCII
  // matches no literal.
  search(low: u8[]): int[] {
    const out: int[] = []
    let s = 0
    for (let i = 0; i < low.length; i++) {
      const c = int(low[i]!)
      if (c >= 128) {
        s = 0
        continue
      }
      s = this.next[s * 128 + c]!
      for (const o of this.outs[s]!) {
        out.push(i + 1 - this.lens[o]!)
        out.push(o)
      }
    }
    return out
  }
}

export type CompiledAllow = {
  target: string,
  all: bool,
  regexes: Regex[],
  // for each regex: the automaton of its wide literal set, when it has no narrow one (else undefined)
  matchers: (LitMatcher | undefined)[],
  stops: string[],
  // the stopwords as a set, and their lengths: an ASCII secret is tested by its substrings of those lengths
  stopSet: Set<string>,
  stopLens: int[],
}

// A rule ready to run. gate is the pattern alone: test() finds the windows, exec()
// the matches in them.
export type CompiledRule = {
  kind: string,
  action: string,
  allowed: string[],
  skip: string[],
  keys: string[],
  wordB: bool,
  secretGroup: int,
  entropy: f64,
  skipLine: string[],
  allow: CompiledAllow[],
  gate: Regex,
}

type Span = { start: int, end: int }

// One match: m is the whole match (newlines trimmed, as gitleaks trims them), s the
// span reported for it.
type Found = { m: Span, s: Span }

// The matches of one rule in the text, and whether the pattern matched a window at all.
// from is where the search stood after the last region (findSpans carries it from region to region).
type Scan = { found: Found[], placed: bool, from: int }

const enc = new TextEncoder()
const W = 512
const STEP = 256

function byteAt(b: u8[], i: int): int {
  const v = b[i]
  return v === undefined ? -1 : int(v)
}

function isCont(c: int): bool {
  return c >= 128 && c < 192
}

function isWord(c: int): bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c === 95
}

// Moves i forward to the next code point start (n counts as one).
function cpAlign(b: u8[], i: int): int {
  let j = i
  while (j < b.length && isCont(byteAt(b, j))) j += 1
  return j
}

// Flags accepted in a pattern: i, m, s. Anything else is an error.
function flagsOf(f: string): string throws SyntaxError {
  let out = ""
  for (const c of ["i", "m", "s"]) {
    if (f.includes(c)) out += c
  }
  if (out.byteLength !== f.byteLength) throw new SyntaxError(`regex flags "${f}" are not supported (use i, m or s)`)
  return out
}

function kindOf(r: RegexRule): string {
  const k = r.entity_type ?? r.description ?? "REGEX_MATCH"
  return k.split(" ").join("_").toUpperCase()
}

// Compiles one allowlist, or throws a SyntaxError naming the bad pattern.
function compileAllow(a: AllowRule): CompiledAllow throws SyntaxError {
  const res: Regex[] = []
  const ms: (LitMatcher | undefined)[] = []
  for (const s of a.regexes ?? []) {
    const re = try compileRegex(s)
    res.push(re)
    const wide = re.wideLiterals()
    ms.push(re.literals().length === 0 && wide.length > 0 ? new LitMatcher(wide.map((l: LitCand): string => l.lit)) : undefined)
  }
  const stops: string[] = []
  const set = new Set<string>()
  const lens: int[] = []
  for (const s of a.stopwords ?? []) {
    const w = s.toLowerCase()
    stops.push(w)
    set.add(w)
    if (!lens.includes(w.byteLength)) lens.push(w.byteLength)
  }
  return { target: a.target ?? "", all: a.all ?? false, regexes: res, matchers: ms, stops: stops, stopSet: set, stopLens: lens }
}

// Compiles rules, or throws a SyntaxError naming the bad pattern.
export function compileRules(rules: RegexRule[]): CompiledRule[] throws SyntaxError {
  const out: CompiledRule[] = []
  for (const r of rules) {
    const fl = try flagsOf(r.flags ?? "")
    const src = fl === "" ? r.pattern : `(?${fl})${r.pattern}`
    const gate = try compileRegex(src)
    const skip: string[] = []
    for (const s of r.skip_containing ?? []) skip.push(s.toLowerCase())
    const keys: string[] = []
    for (const s of r.keywords ?? []) keys.push(s.toLowerCase())
    const allow: CompiledAllow[] = []
    for (const a of r.allow ?? []) allow.push(try compileAllow(a))
    out.push({
      kind: kindOf(r),
      action: r.action ?? "block",
      allowed: (r.allowed_values ?? []).map((s: string) => s.toLowerCase()),
      skip: skip,
      keys: keys,
      wordB: r.pattern.includes("\\b"),
      secretGroup: r.secret_group ?? 0,
      entropy: r.entropy ?? 0,
      skipLine: r.skip_line_containing ?? [],
      allow: allow,
      gate: gate,
    })
  }
  return out
}

// The text with ASCII letters lowercased and every other byte kept, so byte offsets are
// those of the text. undefined when the result is not valid text (then nothing is filtered).
function asciiLower(b: u8[]): string | undefined {
  const out: u8[] = []
  for (const x of b) {
    const c = int(x)
    out.push(u8(c >= 65 && c <= 90 ? c + 32 : c))
  }
  try {
    return new TextDecoder().decode(out)
  } catch (e) {
    return undefined
  }
}

// The start offsets of every occurrence of lit in low, overlapping ones included, or
// undefined when there are too many to list (the rule is then not filtered).
function occurrences(low: string, lit: string, b: u8[]): int[] | undefined {
  const out: int[] = []
  if (!hasBorder(lit)) {
    // without a border no two occurrences overlap, so the pieces between them give every offset
    const pieces = low.split(lit)
    let at = 0
    for (let i = 0; i + 1 < pieces.length; i++) {
      at += pieces[i]!.byteLength
      out.push(at)
      at += lit.byteLength
    }
    return out
  }
  // searched in chunks that overlap by the literal's length, so no occurrence is missed and
  // the text is copied once in all
  if (lit.byteLength >= 1024) return undefined
  const n = low.byteLength
  const chunk = 4096
  let from = 0
  while (out.length <= 256) {
    // chunk ends are code point starts, so the slice is valid text
    const end = cpAlign(b, from + chunk < n ? from + chunk : n)
    const q = low.slice(from, end).indexOf(lit)
    if (q >= 0) {
      out.push(from + q)
      from = from + q + 1
      continue
    }
    if (end >= n) return out
    from = cpAlign(b, end - lit.byteLength + 1)
  }
  return undefined
}

// Whether a byte can be a character of the set: a byte of a multi-byte character is
// allowed when the set holds any non-ASCII character.
function byteFits(c: int, cs: Cset): bool {
  if (cs.any) return true
  if (c >= 128) return cs.high
  return ((bitShr(cs.bits[bitShr(c, 5)]!, c & 31)) & 1) === 1
}

// The earliest byte a match can start at, when the match holds the literal at byte p. Its
// bytes before the literal are at most lc.pre, and each is a character of lc.cls, so the
// start is the first byte of the run of such bytes that ends at p.
function earliestStart(b: u8[], p: int, lc: LitCand): int {
  const floor = lc.pre < 0 || p - lc.pre < 0 ? 0 : p - lc.pre
  let s = p
  while (s > floor && byteFits(byteAt(b, s - 1), lc.cls)) s -= 1
  return s
}

// One start a rule tries in window k: the starts in [from, p], where p is an occurrence of
// one of the rule's literals that lies in the window.
type Trip = { k: int, from: int, p: int }

// The starts to try, as a list sorted by window, or undefined when the rule has no literal
// (every start of every window is tried then). A match of the rule holds one of its literals
// at an occurrence q that lies in a window, and starts at or after the earliest start of
// regex.tov's literal bound, so only the starts from there to q are needed. An occurrence at
// byte p (of length len) can lie in window k (start k*STEP, end at most k*STEP + W + 3, since a
// window end moves forward to a code point start) only when k*STEP <= p and p + len <= k*STEP
// + W + 3; the list covers every such window.
function windowStarts(re: Regex, low: string | undefined, b: u8[]): Trip[] | undefined {
  const lits = re.literals()
  if (lits.length === 0 || low === undefined) return undefined
  const nwin = (bitShr(b.length - 1, 8)) + 1
  const out: Trip[] = []
  for (const lc of lits) {
    const at = occurrences(low, lc.lit, b)
    if (at === undefined) return undefined
    const len = lc.lit.byteLength
    for (const p of at) {
      const x = p + len - W - 3
      const lo = x <= 0 ? 0 : bitShr(x + STEP - 1, 8)
      const hi = bitShr(p, 8)
      const from = earliestStart(b, p, lc)
      for (let k = lo; k <= hi && k < nwin; k++) out.push({ k: k, from: from, p: p })
    }
  }
  out.sort((x, y) => x.k - y.k)
  return out
}

// Byte ranges that may hold a match, for each rule: the windows whose gate tests as a match.
// A match of up to W - STEP bytes starting in a window's first half lies inside that window.
// The windows are walked once, in order, so each is decoded once for the rules that need it
// and only the hit ranges are kept. A window tries only the starts windowStarts gives it,
// when the rule has literals. s0 (a multiple of STEP) is the start of the first window walked: 0, or
// STEP when the text is the tail of a longer one whose earlier windows are already decided (BlockCursor).
function scanRegions(rules: CompiledRule[], text: string, b: u8[], low: string | undefined, s0: int): Span[][] {
  const n = b.length
  const plans: (Trip[] | undefined)[] = []
  const next: int[] = []
  const out: Span[][] = []
  for (const r of rules) {
    plans.push(windowStarts(r.gate, low, b))
    next.push(0)
    out.push([])
  }
  let s = s0
  let k = bitShr(s0, 8)
  while (s < n) {
    const st = cpAlign(b, s)
    const e = cpAlign(b, s + W < n ? s + W : n)
    if (st >= e) break
    let dec = new Decoded([], [])
    let decodedNow = false
    for (let i = 0; i < rules.length; i++) {
      // the starts as offsets into the window; a start before the window is not in it
      const lo: int[] = []
      const hi: int[] = []
      const plan = plans[i]
      if (plan !== undefined) {
        // the list is sorted by window, so the entries of earlier windows are passed over
        let j = next[i]!
        while (j < plan.length && plan[j]!.k < k) j += 1
        while (j < plan.length && plan[j]!.k === k) {
          const t = plan[j]!
          const h = t.p - st
          if (h >= 0) {
            const l = t.from - st
            lo.push(l < 0 ? 0 : l)
            hi.push(h)
          }
          j += 1
        }
        next[i] = j
        if (lo.length === 0) continue
      }
      if (!decodedNow) {
        dec = decodeText(text.slice(st, e))
        decodedNow = true
      }
      if (rules[i]!.gate.testDecoded(dec, lo, hi)) out[i]!.push({ start: st, end: e })
    }
    if (e >= n) break
    s += STEP
    k += 1
  }
  return out
}

// Non-overlapping matches inside the regions, leftmost first. Each window is searched
// from where the last match ended; a match that starts in the second half of a window
// is left for the next window, which holds it in its first half. from0 is where an earlier
// call over the regions before these stopped (0 for the first): the two calls together do
// what one call over all the regions does.
function findSpans(r: CompiledRule, text: string, b: u8[], regions: Span[], from0: int): Scan {
  const n = b.length
  const out: Found[] = []
  let placed = false
  let from = from0
  for (const reg of regions) {
    let p = cpAlign(b, reg.start > from ? reg.start : from)
    while (p < reg.end && p < n) {
      const hi = cpAlign(b, p + W < n ? p + W : n)
      const m = r.gate.exec(text.slice(p, hi))
      if (m === undefined) {
        if (hi >= n) break
        p = cpAlign(b, p + STEP)
        continue
      }
      placed = true
      const ms = p + m[0]!
      if (ms >= p + STEP && hi < n) {
        p = cpAlign(b, p + STEP)
        continue
      }
      // a \b at the slice edge sees no text before it, so the real byte decides
      if (r.wordB && ms === p && p > 0 && isWord(byteAt(b, p - 1)) && isWord(byteAt(b, p))) {
        p = cpAlign(b, p + 1)
        continue
      }
      const me = p + m[1]!
      // gitleaks trims newlines from a match before anything else sees it
      let a = ms
      let z = me
      while (a < z && byteAt(b, a) === 10) a += 1
      while (z > a && byteAt(b, z - 1) === 10) z -= 1
      const whole: Span = { start: a, end: z }
      out.push({ m: whole, s: secretSpan(r, m, p, whole) })
      p = cpAlign(b, me > ms ? me : ms + 1)
    }
    from = p
  }
  return { found: out, placed: placed, from: from }
}

// The span of group g of a window match that starts at p (m holds offsets relative to p),
// or undefined when the group did not take part or matched nothing.
function groupSpan(m: int[], p: int, g: int): Span | undefined {
  const s = m[2 * g]
  const e = m[2 * g + 1]
  if (s === undefined || e === undefined || s < 0 || e <= s) return undefined
  return { start: p + s, end: p + e }
}

// The span reported for a match: the rule's secret group, or else the first group that
// took part (gitleaks), or else the whole match.
function secretSpan(r: CompiledRule, m: int[], p: int, whole: Span): Span {
  if (r.secretGroup > 0) {
    const g = groupSpan(m, p, r.secretGroup)
    return g === undefined ? whole : g
  }
  const groups = (bitShr(m.length, 1)) - 1
  for (let k = 1; k <= groups; k++) {
    const g = groupSpan(m, p, k)
    if (g !== undefined) return g
  }
  return whole
}

// A match is ignored when it equals an allowed value or contains a skip word, ignoring case.
function ignored(r: CompiledRule, t: string): bool {
  const low = t.toLowerCase()
  if (r.allowed.includes(low)) return true
  for (const s of r.skip) {
    if (low.includes(s)) return true
  }
  return false
}

// Shannon entropy in bits per character, as gitleaks computes it: the counts are per code
// point, and the frequencies divide by the byte length.
export function shannon(s: string): f64 {
  const n = s.byteLength
  if (n === 0) return 0
  const counts = new Map<string, int>()
  for (const c of s.chars()) {
    counts.set(c, (counts.get(c) ?? 0) + 1)
  }
  let e = 0.0
  for (const k of counts.values()) {
    const f = k / n
    e -= f * Math.log2(f)
  }
  return e
}

// The line of text that holds the byte span [s, e), without its newline. Built from
// native string operations: the text is not scanned byte by byte.
function lineOf(text: string, s: int, e: int): string {
  const parts = text.slice(0, s).split("\n")
  const head = parts[parts.length - 1]!
  const rest = text.slice(e)
  const k = rest.indexOf("\n")
  const tail = k < 0 ? rest : rest.slice(0, k)
  return head + text.slice(s, e) + tail
}

// True when the line of a match contains one of the marks. The check is case-sensitive
// and looks at the whole line, a comment or a string alike, as Gitleaks does.
function lineHas(text: string, m: Span, marks: string[]): bool {
  const line = lineOf(text, m.start, m.end)
  for (const k of marks) {
    if (line.includes(k)) return true
  }
  return false
}

// Whether an allowlist's regexes match a target text. Findings on one line share the line
// target, so the answer is memoized per text for the call (id names the allowlist). A
// target too long for a regex's step budget is not tested, so it does not allow.
function regexHit(a: CompiledAllow, target: string, inout memo: Map<string, bool>, id: string): bool {
  const key = id + "|" + target
  const seen = memo.get(key)
  if (seen !== undefined) return seen
  let hit = false
  let lowered: string | undefined = undefined
  for (let ri = 0; ri < a.regexes.length; ri++) {
    if (hit) break
    const re = a.regexes[ri]!
    if (!re.fits(target.byteLength)) continue
    // a pattern with required literals (an any-of set, lowercase) cannot match a target that holds none of them
    const lits = re.literals()
    if (lits.length > 0) {
      const lt = lowered ?? target.toLowerCase()
      lowered = lt
      if (!lits.some((lc: LitCand): bool => lt.includes(lc.lit))) continue
    }
    const m = a.matchers[ri]
    if (m !== undefined) {
      // an alternation of many literal branches: only the starts that reach an occurrence of a branch's literal
      if (allowStarts(re, m, target)) hit = true
      continue
    }
    if (re.test(target)) hit = true
  }
  memo.set(key, hit)
  return hit
}

// Whether re matches target, trying only the starts that can reach an occurrence of one of its wide literals: every
// match holds one of them at some byte p, and starts at or after the earliest start that literal's byte bound and
// character set allow (earliestStart), so the starts from there to p are the only ones needed.
function allowStarts(re: Regex, m: LitMatcher, target: string): bool {
  const b = enc.encode(target)
  const low: u8[] = []
  for (const x of b) {
    const c = int(x)
    low.push(u8(c >= 65 && c <= 90 ? c + 32 : c))
  }
  const occ = m.search(low)
  if (occ.length === 0) return false
  const wide = re.wideLiterals()
  const lo: int[] = []
  const hi: int[] = []
  for (let i = 0; i + 1 < occ.length; i += 2) {
    const p = occ[i]!
    lo.push(earliestStart(b, p, wide[occ[i + 1]!]!))
    hi.push(p)
  }
  return re.testDecoded(decodeText(target), lo, hi)
}

// Whether an allowlist's regexes match a target, through the same prefilters a scan uses (for the tests).
export function allowRegexMatches(a: CompiledAllow, target: string): bool {
  let memo: Map<string, bool> = new Map()
  return regexHit(a, target, &memo, "probe")
}

// Whether a lowercased secret contains one of the allowlist's stopwords (Gitleaks' strings.Contains test). An ASCII
// secret is checked by its substrings of the stopwords' lengths against the set (the generic rule has about 1,500
// stopwords and a secret has tens of bytes), anything else word by word.
function stopIn(a: CompiledAllow, low: string): bool {
  const b = enc.encode(low)
  let ascii = true
  for (const c of b) {
    if (int(c) >= 128) {
      ascii = false
      break
    }
  }
  if (!ascii) {
    for (const w of a.stops) {
      if (low.includes(w)) return true
    }
    return false
  }
  const n = b.length
  for (const len of a.stopLens) {
    if (len === 0) return true
    for (let i = 0; i + len <= n; i++) {
      if (a.stopSet.has(low.slice(i, i + len))) return true
    }
  }
  return false
}

// True when one allowlist covers a finding. Its regexes test the target: the secret, the
// whole match or the line. Its stopwords test the secret. With all set, every check the
// allowlist has must hold; otherwise one is enough.
function allowedBy(a: CompiledAllow, secret: string, match: string, line: string, inout memo: Map<string, bool>, id: string): bool {
  const target = a.target === "match" ? match : a.target === "line" ? line : secret
  const hitRe = target !== "" && regexHit(a, target, &memo, id)
  const hitStop = a.stops.length > 0 && stopIn(a, secret.toLowerCase())
  if (a.all) {
    if (a.regexes.length === 0 && a.stops.length === 0) return false
    if (a.regexes.length > 0 && !hitRe) return false
    if (a.stops.length > 0 && !hitStop) return false
    return true
  }
  return hitRe || hitStop
}

function allowedFinding(r: CompiledRule, secret: string, text: string, m: Span, inout memo: Map<string, bool>): bool {
  const match = text.slice(m.start, m.end)
  // the line is only needed by an allowlist that targets it
  let line = ""
  for (const a of r.allow) {
    if (a.target === "line") {
      line = lineOf(text, m.start, m.end)
      break
    }
  }
  for (let k = 0; k < r.allow.length; k++) {
    if (allowedBy(r.allow[k]!, secret, match, line, &memo, r.kind + "#" + k)) return true
  }
  return false
}

// Whether a match of a rule is a finding: its secret is above the rule's entropy floor, is not an
// allowed value, and no skip mark or allowlist covers it.
function keeps(r: CompiledRule, text: string, f: Found, inout memo: Map<string, bool>): bool {
  const t = text.slice(f.s.start, f.s.end)
  if (r.entropy !== 0 && shannon(t) <= r.entropy) return false
  if (ignored(r, t)) return false
  if (r.skipLine.length > 0 && lineHas(text, f.m, r.skipLine)) return false
  if (r.allow.length > 0 && allowedFinding(r, t, text, f.m, &memo)) return false
  return true
}

// Runs the rules over text. block rules set blocked; redact rules rewrite the body
// with [REDACTED:KIND]; detect_only rules only report. A finding is reported for the
// secret span of a match; with an entropy floor, a finding must be above it, and an
// allowlist that covers it drops it.
export function applyRegex(text: string, rules: CompiledRule[]): GuardResult {
  const b = enc.encode(text)
  const findings: Finding[] = []
  const redactions: Finding[] = []
  let blocked = false
  const low = text.toLowerCase()
  const ascii = asciiLower(b)
  let memo = new Map<string, bool>()
  // a rule with keywords runs only when one of them occurs, which is far cheaper than its regex
  const run: CompiledRule[] = []
  for (const r of rules) {
    if (r.keys.length > 0 && !r.keys.some((k: string) => low.includes(k))) continue
    run.push(r)
  }
  const regions = scanRegions(run, text, b, ascii, 0)
  for (let i = 0; i < run.length; i++) {
    const r = run[i]!
    const rg = regions[i]!
    if (rg.length === 0) continue
    const scan = findSpans(r, text, b, rg, 0)
    if (!scan.placed) {
      // the pattern matched but the span could not be placed
      findings.push({ kind: r.kind, start: 0, end: 0, text: "" })
      if (r.action !== "detect_only") blocked = true
      continue
    }
    for (const f of scan.found) {
      if (!keeps(r, text, f, &memo)) continue
      const t = text.slice(f.s.start, f.s.end)
      const fd: Finding = { kind: r.kind, start: f.s.start, end: f.s.end, text: t }
      findings.push(fd)
      if (r.action === "block") blocked = true
      else if (r.action === "redact") redactions.push(fd)
    }
  }
  if (blocked) return { body: text, findings: findings, blocked: true }
  if (redactions.length > 0) return { body: redact(text, redactions), findings: findings, blocked: false }
  return { body: text, findings: findings, blocked: false }
}

// How much of the text must lie after the first window a cursor leaves for its next scan, so that
// everything before that window is decided: the windows before it end at most W + 3 bytes after their
// start, a search in them starts before their end and reads at most W + 3 bytes (2 * (W + 3) - STEP = 774
// bytes past the window in all), and each of those reads must end before the end of the text.
const SETTLED = 1024

function isAscii(s: string): bool {
  for (const x of enc.encode(s)) {
    if (int(x) >= 128) return false
  }
  return true
}

// applyRegex(text, rules).blocked for a text that only grows (a streamed answer), without scanning the
// whole text each time. blocked(text) gives exactly that answer for every text that extends the one of
// the call before; a shorter text starts over.
//
// Why a scan of the tail is enough. applyRegex walks windows that start at multiples of STEP, then
// searches each rule's matching windows in order, carrying only where the last search stopped (from),
// whether any search matched (placed) and the matches. A window that ends before the end of the text,
// and a search slice that does, read the same bytes in every longer text. So once the text reaches
// SETTLED bytes past a window start B, the windows before B give the same regions, the same matches and
// the same carried values for good: the cursor keeps those per rule (from, placed, whether a window
// matched) and next time scans from one window before B (so the byte before a search start is the real
// one, for \b) with the walk starting at B. That reproduces the rest of applyRegex's walk: the windows
// are the same slices, a literal occurrence a window uses lies in the window, and an earliest start
// before the window is cut to the window start either way. (Like applyRegex, this takes the literal
// filter of windowStarts to be only a filter: over a longer text it may be off, over the tail on.)
// What is not local to the tail is handled apart:
// - keywords are looked for in the whole text, so they are tracked as the text grows (keywords are
//   ASCII, or the cursor scans the whole text each time), and a rule that becomes active starts the
//   scan over;
// - a kept match of a block rule in the decided part would have blocked when it was decided. One that
//   was dropped stays dropped (entropy, allowed values, skip words and allowlists on the secret or the
//   match read only the match; a line's skip mark stays on the line), except through an allowlist that
//   reads the line while the line is not finished: the cursor does not move past such a match;
// - the checks of a match read the whole text (the line of a match can start before the tail).
export class BlockCursor {
  // the tail scanned next starts here (a multiple of STEP and a code point start); the walk starts one
  // window later, unless this is 0
  private start = 0
  // per rule, for the windows before the walk's start: where the search stopped, whether a search
  // matched, whether a window matched
  private from: int[] = []
  private placed: bool[] = []
  private hit: bool[] = []
  // per rule: it has no keywords, or one of them has been seen
  private active: bool[] = []
  private len = 0
  // keyword search: text lengths (code point starts) at least reach bytes apart; occurrences before
  // keyLo were seen
  private keyLo = 0
  private keyMark = 0
  private reach = 0
  private keyed = false
  // false: every call scans the whole text (a keyword that is not ASCII)
  private local = true

  constructor(readonly rules: CompiledRule[]) {
    for (const r of rules) {
      this.from.push(0)
      this.placed.push(false)
      this.hit.push(false)
      this.active.push(r.keys.length === 0)
      for (const k of r.keys) {
        this.keyed = true
        if (!isAscii(k)) this.local = false
        // an ASCII keyword of n bytes in the lowercased text comes from at most n characters of the text
        if (k.byteLength * 4 > this.reach) this.reach = k.byteLength * 4
      }
    }
  }

  private restart(): void {
    this.start = 0
    for (let i = 0; i < this.rules.length; i++) {
      this.from[i] = 0
      this.placed[i] = false
      this.hit[i] = false
    }
  }

  blocked(text: string): bool {
    const n = text.byteLength
    if (n < this.len) {
      this.restart()
      for (let i = 0; i < this.rules.length; i++) this.active[i] = this.rules[i]!.keys.length === 0
      this.keyLo = 0
      this.keyMark = 0
    }
    this.len = n
    if (!this.local) this.restart()
    if (this.keyed) {
      const low = (this.local && this.keyLo > 0 ? text.slice(this.keyLo) : text).toLowerCase()
      let woke = false
      for (let i = 0; i < this.rules.length; i++) {
        if (this.active[i]!) continue
        if (this.rules[i]!.keys.some((k: string) => low.includes(k))) {
          this.active[i] = true
          woke = true
        }
      }
      if (n - this.keyMark >= this.reach) {
        this.keyLo = this.keyMark
        this.keyMark = n
      }
      // the rule has the whole text to scan
      if (woke) this.restart()
    }
    const base = this.start
    const part = base === 0 ? text : text.slice(base)
    const b = enc.encode(part)
    const idx: int[] = []
    const run: CompiledRule[] = []
    for (let i = 0; i < this.rules.length; i++) {
      if (!this.active[i]!) continue
      idx.push(i)
      run.push(this.rules[i]!)
    }
    const regions = scanRegions(run, part, b, asciiLower(b), base > 0 ? STEP : 0)
    // the next walk's first window (an offset in part), or -1 to stay: the last window start with SETTLED
    // bytes after it whose tail start, a window earlier, is a code point start
    let cut = -1
    if (this.local && n >= SETTLED) {
      let c = (bitShl(bitShr(n - SETTLED, 8), 8)) - base
      while (c - STEP > 0 && isCont(byteAt(b, c - STEP))) c -= STEP
      if (c - STEP > 0) cut = c
    }
    let memo = new Map<string, bool>()
    const froms: int[] = []
    const placeds: bool[] = []
    const hits: bool[] = []
    for (let j = 0; j < run.length; j++) {
      const r = run[j]!
      const i = idx[j]!
      const rg = regions[j]!
      const pre: Span[] = []
      const post: Span[] = []
      for (const reg of rg) {
        if (reg.start < cut) pre.push(reg)
        else post.push(reg)
      }
      const f0 = this.from[i]! - base
      const a = findSpans(r, part, b, pre, f0 > 0 ? f0 : 0)
      const z = findSpans(r, part, b, post, a.from)
      froms.push(a.from + base)
      placeds.push(this.placed[i]! || a.placed)
      hits.push(this.hit[i]! || pre.length > 0)
      if (!this.hit[i]! && rg.length === 0) continue
      if (!this.placed[i]! && !a.placed && !z.placed) {
        // the pattern matched but the span could not be placed
        if (r.action !== "detect_only") return true
        continue
      }
      if (r.action !== "block") continue
      let lineAllow = false
      for (const al of r.allow) {
        if (al.target === "line") lineAllow = true
      }
      for (const f of a.found) {
        if (keeps(r, text, { m: { start: f.m.start + base, end: f.m.end + base }, s: { start: f.s.start + base, end: f.s.end + base } }, &memo)) return true
        // its line can still grow, and an allowlist that reads the line may then let go of it
        if (lineAllow && !part.slice(f.m.end).includes("\n")) cut = -1
      }
      for (const f of z.found) {
        if (keeps(r, text, { m: { start: f.m.start + base, end: f.m.end + base }, s: { start: f.s.start + base, end: f.s.end + base } }, &memo)) return true
      }
    }
    if (cut < 0) return false
    for (let j = 0; j < idx.length; j++) {
      const i = idx[j]!
      this.from[i] = froms[j]!
      this.placed[i] = placeds[j]!
      this.hit[i] = hits[j]!
    }
    this.start = base + cut - STEP
    return false
  }
}

// ---- tests ----

test("email pattern redacts with its entity type", () => {
  const rules = try compileRules([{ pattern: "\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b", description: "Email address", entity_type: "EMAIL", flags: "i", action: "redact" }])
  const r = applyRegex("write to jane.doe@example.com or x@y.io today", rules)
  expect(r.body).toBe("write to [REDACTED:EMAIL] or [REDACTED:EMAIL] today")
  expect(r.findings.length).toBe(2)
  expect(r.findings[0]!.text).toBe("jane.doe@example.com")
  expect(r.blocked).toBe(false)
})

test("block action sets blocked and keeps the body", () => {
  const rules = try compileRules([{ pattern: "PROJ-\\d+", description: "Internal project code", action: "block" }])
  const r = applyRegex("ticket PROJ-4411 is private", rules)
  expect(r.blocked).toBe(true)
  expect(r.body).toBe("ticket PROJ-4411 is private")
  expect(r.findings[0]!.kind).toBe("INTERNAL_PROJECT_CODE")
  expect(applyRegex("nothing here", rules).blocked).toBe(false)
})

test("detect_only reports without changing anything", () => {
  const rules = try compileRules([{ pattern: "acme", flags: "i", action: "detect_only" }])
  const r = applyRegex("ACME and acme", rules)
  expect(r.blocked).toBe(false)
  expect(r.body).toBe("ACME and acme")
  expect(r.findings.length).toBe(2)
})

test("flags i and s and m", () => {
  const ci = try compileRules([{ pattern: "secret", flags: "i", action: "detect_only" }])
  expect(applyRegex("SeCrEt", ci).findings.length).toBe(1)
  const cs = try compileRules([{ pattern: "secret", action: "detect_only" }])
  expect(applyRegex("SeCrEt", cs).findings.length).toBe(0)
  const dotall = try compileRules([{ pattern: "a.b", flags: "s", action: "detect_only" }])
  expect(applyRegex("a\nb", dotall).findings.length).toBe(1)
  const dot = try compileRules([{ pattern: "a.b", action: "detect_only" }])
  expect(applyRegex("a\nb", dot).findings.length).toBe(0)
  let msg = ""
  try {
    compileRules([{ pattern: "x", flags: "q" }])
  } catch (e) {
    msg = e.message
  }
  expect(msg.includes("flags")).toBe(true)
})

test("ssn word boundaries reject longer digit runs", () => {
  const rules = try compileRules([{ pattern: "\\b\\d{3}-\\d{2}-\\d{4}\\b", entity_type: "SSN", action: "redact" }])
  expect(applyRegex("ssn 123-45-6789 ok", rules).body).toBe("ssn [REDACTED:SSN] ok")
  expect(applyRegex("id 123-45-67890", rules).findings.length).toBe(0)
  expect(applyRegex("id 9123-45-6789", rules).findings.length).toBe(0)
})

test("allowed values skip exact matches only", () => {
  const rules = try compileRules([{ pattern: "[a-z]+@[a-z.]+", entity_type: "EMAIL", action: "redact", allowed_values: ["support@acme.com"] }])
  const r = applyRegex("ask support@acme.com or nosupport@acme.com", rules)
  expect(r.body).toBe("ask support@acme.com or [REDACTED:EMAIL]")
  expect(applyRegex("SUPPORT@acme.com", rules).findings.length).toBe(0)
})

test("skip_containing suppresses matches with a keyword", () => {
  const rules = try compileRules([{ pattern: "tok_[a-z]{8}", entity_type: "TOKEN", action: "block", skip_containing: ["example"] }])
  expect(applyRegex("tok_examples", rules).blocked).toBe(false)
  expect(applyRegex("tok_realvals", rules).blocked).toBe(true)
})

test("matches in long text and after multibyte characters", () => {
  const filler = "é".repeat(300)
  const text = filler + " mail a@b.co " + "x".repeat(2000) + " and c@d.org"
  const rules = try compileRules([{ pattern: "[a-z]@[a-z]\\.[a-z]{2,3}", entity_type: "EMAIL", action: "redact" }])
  const r = applyRegex(text, rules)
  expect(r.findings.length).toBe(2)
  expect(r.findings[0]!.text).toBe("a@b.co")
  expect(r.findings[1]!.text).toBe("c@d.org")
  expect(r.body.includes("[REDACTED:EMAIL]")).toBe(true)
  expect(r.body.startsWith(filler + " mail [REDACTED:EMAIL] ")).toBe(true)
})

test("a bad pattern is a SyntaxError", () => {
  let threw = false
  try {
    compileRules([{ pattern: "(unclosed" }])
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
})

test("keywords gate a rule: its regex runs only when a keyword is present", () => {
  const rules = try compileRules([{ pattern: "zz[0-9]", keywords: ["Needle"], action: "block" }])
  expect(applyRegex("zz1 alone", rules).blocked).toBe(false)
  expect(applyRegex("a NEEDLE here, zz1", rules).blocked).toBe(true)
  expect(applyRegex("needle but no match", rules).findings.length).toBe(0)
})

test("secret_group: the finding and the redaction cover the named group", () => {
  const rules = try compileRules([{ pattern: "key=(\\w+);", secret_group: 1, action: "redact" }])
  const r = applyRegex("set key=abc123; ok", rules)
  expect(r.body).toBe("set key=[REDACTED:REGEX_MATCH]; ok")
  expect(r.findings[0]!.text).toBe("abc123")
})

test("secret_group 0 takes the first group that took part, else the whole match", () => {
  const first = try compileRules([{ pattern: "x(a)?(bb)", action: "detect_only" }])
  expect(applyRegex("xbb", first).findings[0]!.text).toBe("bb")
  expect(applyRegex("xabb", first).findings[0]!.text).toBe("a")
  const none = try compileRules([{ pattern: "xy+", action: "detect_only" }])
  expect(applyRegex("xyy", none).findings[0]!.text).toBe("xyy")
  // a named group that did not take part falls back to the whole match
  const unset = try compileRules([{ pattern: "x(a)?b", secret_group: 1, action: "detect_only" }])
  expect(applyRegex("xb", unset).findings[0]!.text).toBe("xb")
})

test("shannon entropy as gitleaks computes it", () => {
  expect(shannon("aabb")).toBe(1.0)
  expect(shannon("")).toBe(0.0)
  expect(shannon("abcdefgh")).toBe(3.0)
  // one code point of two bytes: the frequency divides by the byte length
  expect(shannon("é")).toBe(0.5)
})

test("entropy: a finding must be above the floor", () => {
  const rules = try compileRules([{ pattern: "tok_([a-z]+)", secret_group: 1, entropy: 3, action: "detect_only" }])
  // exactly 3 bits does not pass, as gitleaks skips an entropy at or below its floor
  expect(applyRegex("tok_abcdefgh", rules).findings.length).toBe(0)
  expect(applyRegex("tok_abcdefghi", rules).findings.length).toBe(1)
  expect(applyRegex("tok_aaaaaaaaaaaa", rules).findings.length).toBe(0)
})

test("allowlist stopwords drop a match that contains one", () => {
  const rules = try compileRules([{ pattern: "tok_[a-z0-9]{8}", action: "block", allow: [{ stopwords: ["DEMO"] }] }])
  expect(applyRegex("tok_demo1234", rules).blocked).toBe(false)
  expect(applyRegex("tok_real1234", rules).blocked).toBe(true)
})

test("allowlist regexTarget: secret, match or line", () => {
  const bySecret = try compileRules([{ pattern: "id=(\\w+)", secret_group: 1, action: "block", allow: [{ regexes: ["^abc"] }] }])
  expect(applyRegex("id=abc123", bySecret).blocked).toBe(false)
  expect(applyRegex("id=xyz123", bySecret).blocked).toBe(true)
  // the secret is "abc123", so a regex on the match "id=..." does not see it
  const byMatch = try compileRules([{ pattern: "id=(\\w+)", secret_group: 1, action: "block", allow: [{ target: "match", regexes: ["^id=abc"] }] }])
  expect(applyRegex("id=abc123", byMatch).blocked).toBe(false)
  expect(applyRegex("id=xyz123", byMatch).blocked).toBe(true)
  const byLine = try compileRules([{ pattern: "tok_[a-z]+", action: "block", allow: [{ target: "line", regexes: ["^note:"] }] }])
  expect(applyRegex("note: tok_abc", byLine).blocked).toBe(false)
  expect(applyRegex("tok_abc", byLine).blocked).toBe(true)
})

test("an AND allowlist needs every check it has", () => {
  const rules = try compileRules([{ pattern: "tok_[a-z0-9]{6}", action: "block", allow: [{ all: true, regexes: ["^tok_a"], stopwords: ["zz"] }] }])
  // the regex holds but the stopword does not
  expect(applyRegex("tok_abc123", rules).blocked).toBe(true)
  expect(applyRegex("tok_azz123", rules).blocked).toBe(false)
})

test("skip_line_containing drops a finding on a marked line only", () => {
  const rules = try compileRules([{ pattern: "tok_[a-z]{4}", action: "block", skip_line_containing: ["@keep"] }])
  expect(applyRegex("tok_abcd # @keep", rules).blocked).toBe(false)
  expect(applyRegex("tok_abcd\ntok_efgh @keep", rules).findings.length).toBe(1)
  expect(applyRegex("tok_abcd\ntok_efgh @keep", rules).findings[0]!.text).toBe("tok_abcd")
  expect(applyRegex("tok_abcd", rules).blocked).toBe(true)
})

test("a literal rule finds matches at every offset around the window seams", () => {
  const rules = try compileRules([{ pattern: "[a-z]{3}secret", action: "detect_only" }])
  // targets near the seams; each match goes at or after its target, so the starts are recorded
  const targets = [250, 251, 254, 255, 256, 257, 500, 508, 510, 511, 512, 513, 760, 1020, 1023, 1024]
  for (const lead of ["-", "é"]) {
    let text = ""
    const starts: int[] = []
    for (const t of targets) {
      if (lead === "é") {
        while (text.byteLength + 2 <= t) text += "é"
      }
      while (text.byteLength < t) text += "-"
      starts.push(text.byteLength)
      text += "abcsecret."
    }
    const r = applyRegex(text, rules)
    expect(r.findings.length).toBe(starts.length)
    for (let i = 0; i < starts.length; i++) {
      expect(r.findings[i]!.start).toBe(starts[i]!)
      expect(r.findings[i]!.text).toBe("abcsecret")
    }
  }
})

test("a literal that overlaps itself is still found at each occurrence", () => {
  // "a-a" can occur at 0, 2 and 4 of "a-a-a-a5"; only the one at 4 is followed by a digit
  const rules = try compileRules([{ pattern: "a-a[0-9]", action: "detect_only" }])
  const r = applyRegex("a-a-a-a5", rules)
  expect(r.findings.length).toBe(1)
  expect(r.findings[0]!.start).toBe(4)
  expect(r.findings[0]!.text).toBe("a-a5")
})

test("an overlapping literal is found past the search chunks, after multibyte text", () => {
  const rules = try compileRules([{ pattern: "a-a[0-9]", action: "detect_only" }])
  const text = "é".repeat(2500) + " a-a-a-a5 " + "x".repeat(9000) + " a-a5"
  const r = applyRegex(text, rules)
  expect(r.findings.length).toBe(2)
  const first = text.indexOf("a-a5")
  expect(r.findings[0]!.start).toBe(first)
  expect(r.findings[1]!.start).toBe(text.slice(first + 1).indexOf("a-a5") + first + 1)
})

test("the literal automaton finds every occurrence of every literal, overlapping ones included", () => {
  const m = new LitMatcher(["he", "she", "his", "hers", "aa"])
  const occ = m.search(enc.encode("ushers aaa hé"))
  const pairs: string[] = []
  for (let i = 0; i < occ.length; i += 2) pairs.push(`${occ[i]!}:${occ[i + 1]!}`)
  // "she" at 1, "he" at 2, "hers" at 2, "aa" at 7 and 8; "h" before a multibyte character starts nothing
  expect(pairs.join(" ")).toBe("1:1 2:0 2:3 7:4 8:4")
  expect(new LitMatcher([]).search(enc.encode("anything")).length).toBe(0)
})

test("stopwords of several lengths are found inside ASCII and non-ASCII secrets", () => {
  const rules = try compileRules([{ pattern: "tok_\\S{6,}", action: "block", allow: [{ stopwords: ["Demo", "sample", "xx"] }] }])
  expect(applyRegex("tok_abcdemo1", rules).blocked).toBe(false)
  expect(applyRegex("tok_SAMPLE99", rules).blocked).toBe(false)
  expect(applyRegex("tok_abxxcd", rules).blocked).toBe(false)
  expect(applyRegex("tok_abcdef12", rules).blocked).toBe(true)
  expect(applyRegex("tok_édemoé", rules).blocked).toBe(false)
  expect(applyRegex("tok_éabcdé", rules).blocked).toBe(true)
})

// "" when a cursor fed the text in steps of `step` bytes agrees with applyRegex on every prefix, else where not.
function cursorDiff(rules: CompiledRule[], text: string, step: int): string {
  const c = new BlockCursor(rules)
  const b = enc.encode(text)
  let n = 0
  while (n < b.length) {
    n = cpAlign(b, n + step < b.length ? n + step : b.length)
    const pre = text.slice(0, n)
    const want = applyRegex(pre, rules).blocked
    if (c.blocked(pre) !== want) return `step ${step} at ${n}: whole scan ${want}`
  }
  return ""
}

// n bytes of filler with the tokens written over it at their offsets
function laid(fill: string, n: int, at: int[], toks: string[]): string {
  let t = fill.repeat(Math.floor(n / fill.byteLength) + 1).slice(0, n)
  for (let i = 0; i < at.length; i++) {
    const tok = toks[i]!
    t = t.slice(0, at[i]!) + tok + t.slice(at[i]! + tok.byteLength)
  }
  return t
}

test("a block cursor agrees with the whole scan on every prefix: matches around the window seams", () => {
  const fill = "lorem ipsum dolor sit amet "
  const lit = try compileRules([{ pattern: "PROJ-\\d{4}", action: "block" }])
  for (const at of [3, 250, 1020, 1279, 1281, 2047, 2560, 3071, 4095, 5000]) {
    const text = laid(fill, 5600, [at], ["PROJ-1234"])
    expect(applyRegex(text, lit).blocked).toBe(true)
    for (const step of [7, 64, 257, 1500]) expect(cursorDiff(lit, text, step)).toBe("")
  }
  // byte by byte, across the first moves of the cursor
  expect(cursorDiff(lit, laid(fill, 2700, [2600], ["PROJ-1234"]), 1)).toBe("")
  // a pattern without a literal, and a text that never matches
  const plain = try compileRules([{ pattern: "\\d{3}-\\d{4}", action: "block" }])
  for (const at of [1279, 2815, 4000]) {
    for (const step of [61, 256]) expect(cursorDiff(plain, laid(fill, 4600, [at], ["555-1234"]), step)).toBe("")
  }
  expect(cursorDiff(lit, laid(fill, 6000, [], []), 100)).toBe("")
  expect(new BlockCursor(lit).blocked(laid(fill, 6000, [], []))).toBe(false)
})

test("a block cursor agrees with the whole scan: keywords, lines, word edges, entropy, many rules", () => {
  const fill = "lorem ipsum dolor sit amet "
  // the keyword comes long after the match it wakes
  const keyed = try compileRules([{ pattern: "zz[0-9]", keywords: ["Needle"], action: "block" }])
  const late = laid(fill, 5200, [500, 4000], ["zz7", "a nEEdle "])
  expect(applyRegex(late, keyed).blocked).toBe(true)
  expect(applyRegex(late.slice(0, 3900), keyed).blocked).toBe(false)
  for (const step of [5, 97, 512]) expect(cursorDiff(keyed, late, step)).toBe("")
  // an allowlist on the line lets go of an old match when the line, still growing, stops matching
  const byLine = try compileRules([{ pattern: "tok_[a-z]+", action: "block", allow: [{ target: "line", regexes: ["^note:[^!]*$"] }] }])
  // (a line too long for the allowlist's regex stops being allowed too, so the line here stays short of that)
  const line = laid("xxxx yyy ", 5000, [300, 301, 2500], ["\n", "note: tok_abc ", "!"])
  expect(applyRegex(line.slice(0, 2400), byLine).blocked).toBe(false)
  expect(applyRegex(line, byLine).blocked).toBe(true)
  for (const step of [9, 130, 700]) expect(cursorDiff(byLine, line, step)).toBe("")
  // the same with the line finished long before: the match stays allowed
  const done = laid("xxxx yyy ", 5000, [300, 301, 900, 2500], ["\n", "note: tok_abc ", "\n", "!"])
  expect(applyRegex(done, byLine).blocked).toBe(false)
  for (const step of [9, 700]) expect(cursorDiff(byLine, done, step)).toBe("")
  // a skip mark that arrives later on the line of an old match
  const marked = try compileRules([{ pattern: "tok_[a-z]{4}", action: "block", skip_line_containing: ["@keep"] }])
  const mk = laid("xxxx yyy ", 4000, [200, 3000], ["tok_abcd ", " @keep "])
  expect(applyRegex(mk.slice(0, 2900), marked).blocked).toBe(true)
  expect(applyRegex(mk, marked).blocked).toBe(false)
  for (const step of [11, 300]) expect(cursorDiff(marked, mk, step)).toBe("")
  // a word edge exactly where a search starts, with a word character before it
  const edge = try compileRules([{ pattern: "\\bkey[0-9]+", action: "block" }])
  for (const at of [1023, 1279, 1535, 2047, 2303]) {
    expect(applyRegex(laid(fill, 4000, [at], ["xkey12"]), edge).blocked).toBe(false)
    for (const step of [13, 256]) expect(cursorDiff(edge, laid(fill, 4000, [at], ["xkey12"]), step)).toBe("")
    for (const step of [13, 256]) expect(cursorDiff(edge, laid(fill, 4000, [at, 3500], ["xkey12", " key9 "]), step)).toBe("")
  }
  // an entropy floor, anchors, and a redact rule that matches in every window next to a block rule
  const mixed = try compileRules([
    { pattern: "[a-z]+ [a-z]+", action: "redact" },
    { pattern: "^amet\\b", flags: "m", action: "redact" },
    { pattern: "sit$", action: "redact" },
    { pattern: "tok_[a-z0-9]{12}", entropy: 3.0, action: "block" },
    { pattern: "acme", flags: "i", action: "detect_only" },
  ])
  const mx = laid(fill, 5200, [700, 2040, 4400], ["tok_aaaaaaaaaaaa", "\nACME\n", "tok_q8w3e7r5t1y9"])
  expect(applyRegex(mx.slice(0, 4300), mixed).blocked).toBe(false)
  expect(applyRegex(mx, mixed).blocked).toBe(true)
  for (const step of [23, 255, 1024]) expect(cursorDiff(mixed, mx, step)).toBe("")
  // multibyte text: window and tail starts fall inside characters
  const wide = "héllo wörld — 日本語 "
  const lit = try compileRules([{ pattern: "PROJ-\\d{4}", action: "block" }, { pattern: "\\bw\\S+", action: "redact" }])
  for (const reps of [40, 77, 131]) {
    const text = wide.repeat(reps) + "PROJ-1234" + wide.repeat(60)
    expect(applyRegex(text, lit).blocked).toBe(true)
    for (const step of [3, 100, 259]) expect(cursorDiff(lit, text, step)).toBe("")
  }
  // matches back to back through every window: where each search stops decides where the next match starts
  const dense = try compileRules([{ pattern: "tok_[a-z0-9]{12}", entropy: 3.0, action: "block" }])
  const dn = laid("tok_aaaaaaaaaaaa xx ", 5000, [4203], ["tok_q8w3e7r5t1y9"])
  expect(applyRegex(dn, dense).blocked).toBe(true)
  for (const step of [19, 256, 777]) expect(cursorDiff(dense, dn, step)).toBe("")
  const runs = try compileRules([{ pattern: "(?:[a-z0-9]{2} ){20,60}", entropy: 3.0, action: "block" }])
  for (const at of [1500, 2700, 3999]) {
    const rn = laid("ab ", 5000, [at], ["q8 w3 e7 r5 t1 y9 u2 i4 o6 p0 z5 x7 c1 v3 b9 n2 m4 k6 j8 h0 g1 f3 d5 s7 "])
    for (const step of [1, 19, 256, 777]) expect(cursorDiff(runs, rn, step)).toBe("")
  }
  // a shorter text starts the cursor over
  const c = new BlockCursor(lit)
  expect(c.blocked(wide.repeat(200))).toBe(false)
  expect(c.blocked("PROJ-1234")).toBe(true)
  expect(c.blocked("fine")).toBe(false)
})
