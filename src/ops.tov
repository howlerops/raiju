export type Gate = { kind: "ok", actor: string } | { kind: "deny", res: Response }

export type Reply = { status: int, body: string, contentType: string }

// The filters of POST /api/logs/recalculate-cost, in Bifrost's names.
export type RecalcFilters = { providers?: string[], models?: string[], virtual_key_ids?: string[], user_ids?: string[], team_ids?: string[], period?: string, start_time?: string, end_time?: string, missing_cost_only?: bool }

// An error reply for the plugin routes.
// The start warning and notice text for duplicate names: each one, and how to fix them.
function duplicateNamesText(dups: string[]): string {
  return `names are unique, but this config holds duplicates saved before they were (updates keeping such a name still pass; creates and renames onto one get 409): ${dups.join("; ")}. Rename all but one of each.`
}

function pluginError(status: int, message: string): Reply {
  return { status: status, body: errorJson(message, status === 404 ? "not_found_error" : "invalid_request_error", undefined), contentType: "application/json" }
}

// The raw config a body names, or dflt when it names none (or null).
function configOf(fs: Field[], dflt: string): string {
  const raw = find(fs, "config")
  return raw === undefined || isNull(raw) ? dflt : raw
}

// The plugin file a body names, or dflt when it names none.
function pathOf(fs: Field[], dflt: string | undefined): string | undefined {
  const raw = find(fs, "path")
  if (raw === undefined) return dflt
  const p = rawStr(fs, "path") ?? ""
  return p === "" ? undefined : p
}

// The sha256 pin a body names (lower case), dflt when it names none, undefined for null or "".
function pinOf(fs: Field[], dflt: string | undefined): string | undefined {
  const raw = find(fs, "sha256")
  if (raw === undefined) return dflt
  const p = normalPin(rawStr(fs, "sha256"))
  return p === "" ? undefined : p
}

// The wasm_limits a body names, or dflt when it names none.
function limitsOf(fs: Field[], dflt: WasmLimitsSpec | undefined): WasmLimitsSpec | undefined {
  const raw = find(fs, "wasm_limits")
  if (raw === undefined) return dflt
  if (!raw.startsWith("{")) return undefined
  try {
    return JSON.parse(raw) as WasmLimitsSpec
  } catch (e) {
    return dflt
  }
}

// The placement a body names: the default when it names none (or null), undefined for "" (Bifrost's nil, the
// default group). Bifrost's API takes pre_builtin and post_builtin only; any other value is refused.
function placementOf(fs: Field[], dflt: string | undefined): { ok: bool, value: string | undefined } {
  const raw = find(fs, "placement")
  if (raw === undefined || isNull(raw)) return { ok: true, value: dflt }
  const p = rawStr(fs, "placement")
  if (p === undefined) return { ok: false, value: undefined }
  if (p === "") return { ok: true, value: undefined }
  if (p !== "pre_builtin" && p !== "post_builtin") return { ok: false, value: undefined }
  return { ok: true, value: p }
}

// The order a body names (an integer), or the default when it names none (or null).
function orderOf(fs: Field[], dflt: int | undefined): { ok: bool, value: int | undefined } {
  const raw = find(fs, "order")
  if (raw === undefined || isNull(raw)) return { ok: true, value: dflt }
  const n = rawNum(fs, "order")
  if (n === undefined || n !== Math.floor(n)) return { ok: false, value: undefined }
  return { ok: true, value: Math.floor(n) }
}

// Why a plugin cannot be built from its config: "" when it can. Checked as enabled, so a disabled plugin is
// still checked for its name and config.
function badPlugin(spec: PluginSpec): string {
  const st = entryStatus({ name: spec.name, enabled: true, configJson: spec.config_json ?? "{}", path: spec.path, limits: spec.wasm_limits, sha256: spec.sha256 })
  return st.status === "error" ? st.error : ""
}

// One configured plugin as Bifrost's plugin response: its name, whether it is on, its config and its status.
function pluginJson(sp: PluginSpec, stats: string): string {
  const config = sp.config_json ?? ""
  const st = entryStatus({ name: sp.name, enabled: sp.enabled, configJson: config, path: sp.path, limits: sp.wasm_limits, sha256: sp.sha256 })
  const custom = (sp.path ?? "") !== ""
  const builtin = !custom && builtinPlugins().includes(sp.name)
  const pairs: string[] = [
    jkv("name", JSON.stringify(sp.name)),
    jkv("actualName", JSON.stringify(sp.name)),
    jkv("enabled", sp.enabled === false ? "false" : "true"),
    jkv("config", config.trim() === "" ? "{}" : config),
    jkv("isCustom", builtin ? "false" : "true"),
    jkv("path", custom ? JSON.stringify(sp.path) : "null"),
  ]
  // placement and order are left out when unset, as Bifrost's omitempty does
  const placement = sp.placement
  if (placement !== undefined) pairs.push(jkv("placement", JSON.stringify(placement)))
  const order = sp.order
  if (order !== undefined) pairs.push(jkv("order", `${order}`))
  const pin = sp.sha256
  if (pin !== undefined && pin !== "") pairs.push(jkv("sha256", JSON.stringify(pin)))
  // the live plugin's own counters (the mocker's GetStats, which Bifrost keeps in-process only), Raiju's addition
  if (stats !== "") pairs.push(jkv("stats", stats))
  pairs.push(jkv("status", jobj([jkv("name", JSON.stringify(sp.name)), jkv("status", JSON.stringify(st.status)), jkv("logs", jstrs(st.error === "" ? [] : [st.error])), jkv("types", jstrs(st.types))])))
  return jobj(pairs)
}

// The names under /api/logs/ that are routes rather than log ids.
const LOG_ROUTE_NAMES: string[] = ["stats", "histogram", "rankings", "dashboard", "filterdata", "dropped", "sessions", "recalculate-cost", "user-agent-mappings"]

// The plugins this gateway provides under Bifrost's names (the ones it implements as built-in features).
// Bifrost's 403 for a custom plugin path while dashboard auth is off (on create, or on update).
function pathAuthMessage(create: bool): string {
  const what = create ? "Creating a custom plugin with a path" : "Setting a custom plugin path"
  return `${what} requires genuine admin authentication; dashboard auth is currently disabled or unconfigured. Enable dashboard authentication first.`
}

function builtinPlugins(): string[] {
  return ["telemetry", "logging", "governance", "otel", "semanticcache", "routing"]
}

// The request body's filters as the query a list takes, so one filter reading serves both.
function recalcQuery(f: RecalcFilters | undefined): URLSearchParams {
  const sp = new URLSearchParams("")
  if (f === undefined) return sp
  if (f.providers !== undefined) sp.set("providers", f.providers.join(","))
  if (f.models !== undefined) sp.set("models", f.models.join(","))
  if (f.virtual_key_ids !== undefined) sp.set("virtual_key_ids", f.virtual_key_ids.join(","))
  if (f.user_ids !== undefined) sp.set("user_ids", f.user_ids.join(","))
  if (f.team_ids !== undefined) sp.set("team_ids", f.team_ids.join(","))
  if (f.period !== undefined) sp.set("period", f.period)
  if (f.start_time !== undefined) sp.set("start_time", f.start_time)
  if (f.end_time !== undefined) sp.set("end_time", f.end_time)
  if (f.missing_cost_only === true) sp.set("missing_cost_only", "true")
  return sp
}

// A cost recalculation job in Bifrost's status fields.
function recalcJson(s: RecalcStatus): string {
  return jobj([
    jkv("id", JSON.stringify(s.id)),
    jkv("status", JSON.stringify(s.status)),
    jkv("total", jn(s.total)),
    jkv("processed", jn(s.processed)),
    jkv("updated", jn(s.updated)),
    jkv("skipped", jn(s.skipped)),
    jkv("unpriceable", jn(s.unpriceable ?? 0)),
    jkv("message", JSON.stringify(s.message)),
    jkv("started_at", JSON.stringify(s.started_at)),
    jkv("updated_at", JSON.stringify(s.updated_at)),
  ])
}

// A query value as epoch milliseconds; the fallback when it is missing or not a number.
function epochParam(raw: string | undefined, fallback: f64): f64 {
  if (raw === undefined || raw === "") return fallback
  const v: f64 = Number(raw) ?? -1.0
  return v >= 0.0 && v < 1e15 ? v : fallback
}

// Ascending by name: the order of the model lists.
// The index of the circuit policy called name in the config's list, or -1.
function policyAt(list: CircuitPolicyConfig[], name: string): int {
  for (let i = 0; i < list.length; i++) {
    if (list[i]!.name === name) return i
  }
  return -1
}

function byName(a: string, b: string): int {
  if (a === b) return 0
  return a < b ? -1 : 1
}

// A virtual key a request names in a header other than Authorization (Bifrost's getVKFromRequest without the
// bearer): x-bf-vk as sent, or x-api-key, x-goog-api-key or api-key with the key prefix. "" when none.
export function headerKeyOf(h: Hdrs): string {
  const direct = (h.get("x-bf-vk") ?? "").trim()
  if (direct !== "") return direct
  for (const name of ["x-api-key", "x-goog-api-key", "api-key"]) {
    const v = (h.get(name) ?? "").trim()
    if (v.startsWith("sk-bf-")) return v
  }
  return ""
}

// Whether a path is a per-user OAuth flow route (its detail or start) of a user-mode flow that belongs to this user.
function ownUserFlow(path: string, sub: string): bool {
  const id = flowIdOfPath(path)
  if (id === "") return false
  const f = userFlowById(id, Date.now())
  return f !== undefined && (f.user_id ?? "") !== "" && f.user_id === sub
}

// The page a sign-in may return to: only the gateway's own MCP consent pages, as a path with its query.
export function returnPath(raw: string): string {
  if (raw.includes("//") || raw.includes("\\") || raw.includes("#")) return ""
  if (raw.startsWith("/oauth/consent?") || raw.startsWith("/workspace/mcp-sessions/auth?") || raw.startsWith("/api/agent/auth/authorize?")) return raw
  return ""
}

// The names a single sign-on identity is known by in governance: its subject and its email, lower-cased.
// The OIDC settings of one sign-in: a configured redirect URI as it is, else the gateway's own callback on the
// host the request came to (the oidc section scim_config's settings make carries none).
function withRedirect(oc: OidcConfig, reqUrl: string): OidcConfig {
  if ((oc.redirect_uri ?? "") !== "") return oc
  const u = URL.parse(reqUrl)
  let n = oc
  n.redirect_uri = (u === undefined ? "" : u.origin) + "/api/oidc/callback"
  return n
}

function ssoNames(sub: string, email: string | undefined): string[] {
  return [sub, (email ?? "").toLowerCase()]
}

function json(status: int, body: string): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", "application/json")
  return new Response(body, { status: status, headers: h })
}

// ---- the A2A gateway: what is not the Ops state ----

// The headers of a call that do not go on to the agent: the connection's own, cookies, and the gateway's
// credentials (the virtual key the caller logged in with is dropped by name where it came in).
// A2A-Version is the gateway's own to send: each interface is called in the version it speaks.
const A2A_NOT_FORWARDED: string[] = ["host", "content-length", "content-type", "content-encoding", "accept", "accept-encoding", "connection", "keep-alive", "proxy-connection", "proxy-authenticate", "proxy-authorization", "te", "trailer", "transfer-encoding", "upgrade", "cookie", "x-bf-vk", "x-bf-agent-vk-id", "x-bf-agent-auth", "a2a-version", CLIENT_WATCH_HEADER]

// The largest raw body a call's log row keeps, each way (Bifrost's capture bound).
const RAW_LIMIT: int = 1048576

// What the agent answered to one call. rpc says which binding it answered in; error is set when no answer came.
// binding is the interface's binding (JSONRPC, HTTP+JSON, GRPC), method the HTTP method, grpc the gRPC status (-1 for
// none); rawReq and rawResp are the bytes sent and received as text (tap gathers a stream's), for the log row.
type Fwd = { status: int, text: string, ct: string, stream: ReadableStream | undefined, rpc: bool, error: string, binding: string, method: string, grpc: int, rawReq: string, rawResp: string, tap: StreamTap | undefined }

function fwdFail(message: string): Fwd {
  return { status: 0, text: "", ct: "", stream: undefined, rpc: true, error: message, binding: "", method: "POST", grpc: -1, rawReq: "", rawResp: "", tap: undefined }
}

// An answer in the caller's version (a2aver.tov): a JSON-RPC answer's result, a REST answer's body, or each event of a
// stream.
function translatedFwd(f: Fwd, op: string, toV03: bool): Fwd {
  let stream = f.stream
  let text = f.text
  const st = f.stream
  if (st !== undefined) stream = f.rpc ? relayMapped(st, (d: string): string => rpcAnswerTo(op, d, toV03)) : relayMapped(st, (d: string): string => resultTo(op, d, toV03))
  else if (f.rpc) text = rpcAnswerTo(op, f.text, toV03)
  else if (f.status >= 200 && f.status < 300 && f.text.trim() !== "") text = resultTo(op, f.text, toV03)
  return { status: f.status, text: text, ct: f.ct, stream: stream, rpc: f.rpc, error: f.error, binding: f.binding, method: f.method, grpc: f.grpc, rawReq: f.rawReq, rawResp: f.rawResp, tap: f.tap }
}

// The binding's name in the call log (Bifrost's transports).
function transportOf(binding: string): string {
  if (binding === "rest") return "HTTP+JSON"
  if (binding === "grpc") return "GRPC"
  return "JSONRPC"
}

// A unary answer in the one shape both bindings use: failed, with the error's code and message, or the result.
type Unary = { failed: bool, result: string, code: int, message: string }

function unaryOf(f: Fwd): Unary {
  if (f.rpc) {
    try {
      const fs = fields(f.text)
      const er = find(fs, "error")
      if (er !== undefined && !isNull(er)) {
        const ef = fields(er)
        return { failed: true, result: "", code: Math.floor(rawNum(ef, "code") ?? -32603.0), message: rawStr(ef, "message") ?? "the agent failed" }
      }
      const res = find(fs, "result")
      if (res !== undefined && f.status < 400) return { failed: false, result: res, code: 0, message: "" }
    } catch (e) {
      // not a JSON-RPC answer
    }
    return { failed: true, result: "", code: -32603, message: f.status >= 400 ? `the agent answered HTTP ${f.status}` : "the agent's answer is not a JSON-RPC response" }
  }
  if (f.status >= 200 && f.status < 300) return { failed: false, result: f.text.trim() === "" ? "{}" : f.text, code: 0, message: "" }
  const e = codeOfRestError(f.status, f.text)
  return { failed: true, result: "", code: e.code, message: e.message }
}

// The agent's unary answer for a caller in a binding: as it came when the bindings are the same, else
// its result or its error in the caller's shape.
function a2aRender(rest: bool, rpcId: string, f: Fwd, u: Unary): Response {
  const hs: Record<string, string> = new Map()
  if (rest !== f.rpc) {
    hs.set("content-type", f.ct === "" ? "application/json" : f.ct)
    // a 204 has no body (a response with one would be refused)
    return new Response(f.status === 204 || f.status === 304 ? undefined : f.text, { status: f.status, headers: hs })
  }
  hs.set("content-type", "application/json")
  if (rest) {
    if (u.failed) return new Response(restErrorBody(u.code, u.message), { status: httpOfCode(u.code), headers: hs })
    return new Response(u.result, { status: 200, headers: hs })
  }
  if (u.failed) return new Response(rpcErrorBody(rpcId, u.code, u.message), { status: 200, headers: hs })
  return new Response(`{"jsonrpc":"2.0","id":${rpcId},"result":${u.result}}`, { status: 200, headers: hs })
}

// A refusal before the protocol starts (no agent, no key, no grant, a budget used up), in the caller's binding.
function a2aDeny(rest: bool, status: int, message: string, type: string): Response {
  if (!rest) return status === 401 ? denied(401, message) : json(status, errorJson(message, type, undefined))
  const h: Record<string, string> = new Map()
  h.set("content-type", "application/json")
  if (status === 401) h.set("www-authenticate", `ApiKey name="x-bf-vk", in="header"`)
  return new Response(restErrorOfStatus(status, message), { status: status, headers: h })
}

// What the gate decided (Ops.a2aGate): refusal is the answer when a check failed. grant marks a refusal by the agent's
// grants, which the protocol bindings answer as A2A's permission error (-31403) once the call is read.
type A2aGate = { refusal: Response | undefined, vk: VirtualKeyConfig | undefined, status: int, message: string, grant: bool }

// The refusal of a gate check: the answer in the caller's binding, with its status and message for the gRPC binding.
function gateRefusal(rest: bool, status: int, message: string, type: string, vk: VirtualKeyConfig | undefined): A2aGate {
  return { refusal: a2aDeny(rest, status, message, type), vk: vk, status: status, message: message, grant: false }
}

// The answer of the gRPC binding's gate (Ops.a2aGrpcGate): status 0 when the call may go on. grant: refused by the
// agent's grants (PERMISSION_DENIED with the UNAUTHORIZED ErrorInfo, as a2a-go sends ErrUnauthorized).
export type GrpcGate = { status: int, message: string, agent: AgentConfig | undefined, vk: VirtualKeyConfig | undefined, base: string, grant: bool }

// A refused grant on the agent's card: Bifrost's card handler answers http.Error with the status text.
function forbiddenText(): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", "text/plain; charset=utf-8")
  h.set("x-content-type-options", "nosniff")
  return new Response("Forbidden\n", { status: 403, headers: h })
}

// The RFC 3339 time (seconds, UTC) a2a-go stamps on an error's ErrorInfo.
function errorStamp(): string {
  return isoMs(Date.now()).slice(0, 19) + "Z"
}

// Whether an If-None-Match value names the tag.
function etagMatches(header: string, tag: string): bool {
  for (const v of header.split(",")) {
    const t = v.trim()
    if (t === "*" || t === tag || (t.startsWith("W/") && t.slice(2) === tag)) return true
  }
  return false
}

// A card as the gateway serves it: cacheable by the caller but to be checked again before each use, since
// the key that may read it can change; answered 304 when the caller's copy is current.
function a2aCardResponse(body: string, h: Hdrs): Response {
  const tag = "\"" + toHex(sha256(utf8(body))).slice(0, 32) + "\""
  const hs: Record<string, string> = new Map()
  hs.set("cache-control", "private, no-cache")
  hs.set("vary", "Authorization, x-bf-vk, api-key, x-api-key, x-goog-api-key")
  hs.set("etag", tag)
  if (etagMatches(h.get("if-none-match") ?? "", tag)) return new Response(undefined, { status: 304, headers: hs })
  hs.set("content-type", "application/json")
  return new Response(body, { status: 200, headers: hs })
}

// One A2A call that reached an agent (Ops.recordA2a). op is the A2A operation (SendMessage, GetTask, ...) when it
// differs from the wire method name. task is the A2A task it named or made; down and up the caller's
// binding and the agent's; rawReq and rawResp the bytes sent and received (kept when
// client.a2a_store_raw_request_response is on); input and output the request params and the result (kept unless
// content logging is off for the caller).
// requestId links a call's row to its stream's event rows; at is the call's governance attribution (team, customer,
// business unit and project), when the call had one.
type A2aCall = { agent: string, method: string, status: int, latencyMs: f64, context: string, vk: string | undefined, op?: string, error: string, task?: string, down?: string, up?: string, rawReq?: string, rawResp?: string, input?: string, output?: string, requestId?: string, at?: Attribution }

// How many events a call's stream has carried so far (the next event row's sequence).
class EventCount {
  n = 0
}

// One event of a call's stream (Ops.recordA2aEvent): the call's row fields it shares, its place in the stream, and what
// the event says (agenthistory.tov a2aEventOf). body is kept only when the call's content is.
type A2aEventRow = { agent: string, method: string, requestId: string, vk: string | undefined, at: Attribution, down: string, sequence: int, info: A2aEventInfo, body: string }

// Whether an agent's answer is a JSON-RPC error object (false for a body that is not JSON).
function rpcFailed(text: string): bool {
  try {
    return find(fields(text), "error") !== undefined
  } catch (e) {
    return false
  }
}

// The comma-separated names of a query parameter, without empty ones.
function listNames(v: string): string[] {
  const out: string[] = []
  for (const x of v.split(",")) {
    const t = x.trim()
    if (t !== "") out.push(t)
  }
  return out
}

// Model parameters by model key, each record as the JSON text it came in. The datasheet is keyed
// inconsistently (bare names and provider-qualified ones), so lookups go through resolveParams.
export function parseParams(text: string): Map<string, string> throws SyntaxError {
  const out: Map<string, string> = new Map()
  for (const f of try fields(text)) {
    if (f.raw.startsWith("{")) out.set(f.key, f.raw)
  }
  return out
}

// The record for a model: its exact key; else its name without provider segments; else a qualified
// key that ends in the bare name ("openrouter/openai/gpt-4o" for "gpt-4o"), the one with fewest segments.
export function resolveParams(m: Map<string, string>, model: string): string | undefined {
  const exact = m.get(model)
  if (exact !== undefined) return exact
  let bare = model
  while (bare.includes("/")) {
    bare = bare.slice(bare.indexOf("/") + 1)
    const hit = m.get(bare)
    if (hit !== undefined) return hit
  }
  let best = ""
  let bestSegs = 1000
  for (const k of m.keys()) {
    if (!k.endsWith("/" + bare)) continue
    const n = k.split("/").length
    if (n < bestSegs) {
      best = k
      bestSegs = n
    }
  }
  if (best === "") return undefined
  return m.get(best)
}

// The embedded fallback: the context and output limits of a few common models. The live datasheet
// (pricing_sync) replaces it. Values are the providers' published limits for these model names.
const FALLBACK_PARAMS = `{
  "gpt-4o": {"mode":"chat","max_input_tokens":128000,"max_output_tokens":16384,"supports_function_calling":true,"supports_vision":true},
  "gpt-4o-mini": {"mode":"chat","max_input_tokens":128000,"max_output_tokens":16384,"supports_function_calling":true,"supports_vision":true},
  "gpt-4.1": {"mode":"chat","max_input_tokens":1047576,"max_output_tokens":32768,"supports_function_calling":true,"supports_vision":true},
  "claude-3-5-sonnet-20241022": {"mode":"chat","max_input_tokens":200000,"max_output_tokens":8192,"supports_function_calling":true,"supports_vision":true},
  "claude-3-5-haiku-20241022": {"mode":"chat","max_input_tokens":200000,"max_output_tokens":8192,"supports_function_calling":true,"supports_vision":true},
  "claude-sonnet-4-20250514": {"mode":"chat","max_input_tokens":200000,"max_output_tokens":64000,"supports_function_calling":true,"supports_vision":true},
  "gemini-1.5-pro": {"mode":"chat","max_input_tokens":2097152,"max_output_tokens":8192,"supports_function_calling":true,"supports_vision":true},
  "gemini-2.0-flash": {"mode":"chat","max_input_tokens":1048576,"max_output_tokens":8192,"supports_function_calling":true,"supports_vision":true}
}`

function fallbackParams(): Map<string, string> {
  try {
    return parseParams(FALLBACK_PARAMS)
  } catch (e) {
    return new Map()
  }
}

function okJson(body: string): Reply {
  return { status: 200, body: body, contentType: "application/json" }
}

// A change refused because another process kept the config file's lock past LOCK_WAIT_MS: nothing ran, a retry may
// pass.
export function lockBusyReply(): Reply {
  return { status: 503, body: errorJson("another process kept the configuration file's lock too long; nothing was changed, retry", "api_error", undefined), contentType: "application/json" }
}

function badRequest(message: string): Reply {
  return { status: 400, body: errorJson(message, "invalid_request_error", undefined), contentType: "application/json" }
}

// The answer of a locked /api with no setup token configured (Bifrost's words, with Raiju's ways to set one).
export const LOCKED_MESSAGE = "dashboard auth is not configured and no setup token is set; set setup_token in config.json (or the BIFROST_SETUP_TOKEN env var) and restart the gateway"

// challenge is the WWW-Authenticate value of a 401 (the MCP authorization server's, when it is on).
// A sign-in the throttle held back (signinguard.tov): 429 with Retry-After in seconds, unchecked.
function throttled(seconds: int): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", "application/json")
  h.set("retry-after", `${seconds}`)
  return new Response(errorJson(THROTTLED, "rate_limit_error", undefined), { status: 429, headers: h })
}

// The client's address the server put on the request (clientip.tov), or "".
function clientIp(req: Request): string {
  return req.headers.get(CLIENT_IP_HEADER) ?? ""
}

function denied(status: int, message: string, challenge?: string): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", "application/json")
  if (status === 401) h.set("www-authenticate", challenge ?? `Bearer realm="raiju", Basic realm="raiju"`)
  return new Response(errorJson(message, status === 401 ? "authentication_error" : "permission_error", undefined), { status: status, headers: h })
}

// Ops.mcpCaller's answer: res refuses the call; otherwise h are the headers to go on with, and checked whether a
// credential was verified.
export type McpCaller = { res: Response | undefined, h: Hdrs, checked: bool }

function mcpRefused(res: Response): McpCaller {
  const none: Hdrs = new Map()
  return { res: res, h: none, checked: false }
}

function num(params: URLSearchParams, name: string): f64 | undefined {
  const v = params.get(name)
  if (v === undefined || v === "") return undefined
  return parseFloat(v)
}

// A window bound of the adaptive history: RFC 3339, or unix seconds. dflt when absent; undefined when unreadable.
function historyBound(raw: string | undefined, dflt: f64): f64 | undefined {
  if (raw === undefined || raw === "") return dflt
  if (raw.includes("T")) return timeOf(raw)
  const v = parseFloat(raw)
  if (v === undefined) return undefined
  return v * 1000.0
}

// The status an incident shows: resolved, recovering (its check is in flight) or attention.
function incidentStatus(inc: Incident): string {
  if (inc.resolvedAt > 0) return "resolved"
  return inc.recovering ? "recovering" : "attention"
}

// An incident as the adaptive routing routes show it.
function incidentRow(inc: Incident, now: number) {
  const end = inc.resolvedAt > 0 ? inc.resolvedAt : now
  return {
    id: inc.id, target: inc.target, provider: inc.provider, key_id: inc.keyId, model: inc.model,
    scope: inc.model === "" ? "key" : "route", failure_class: inc.cls, reason: inc.reason, status: incidentStatus(inc),
    opened_at: rfc3339Of(inc.openedAt), resolved_at: inc.resolvedAt > 0 ? rfc3339Of(inc.resolvedAt) : undefined,
    duration_seconds: Math.round((end - inc.openedAt) / 1000),
  }
}

// The tools of a chat tool definition list, as MCP tools.
function exposedTools(defs: string[]): ExposedTool[] {
  const out: ExposedTool[] = []
  for (const d of defs) {
    try {
      const fnRaw = find(fields(d), "function")
      if (fnRaw === undefined) continue
      const f = fields(fnRaw)
      const params = find(f, "parameters")
      out.push({ name: rawStr(f, "name") ?? "", description: rawStr(f, "description") ?? "", inputSchemaRaw: params === undefined || isNull(params) ? `{"type":"object"}` : params })
    } catch (e) {
      continue
    }
  }
  return out
}

// Secret references (vault.<path>#<field>, aws-sm.<id>) in a resolved config,
// fetched and substituted. Without any, the config comes back untouched.
export async function withSecrets(c: Config): Promise<Config> {
  const text = JSON.stringify(c)
  if (!text.includes("\"vault.") && !text.includes("\"aws-sm.")) return c
  const r = await resolveAll(text, c.secrets ?? {})
  for (const e of r.errors) console.error(`raiju: secret ${e}`)
  try {
    let out = JSON.parse(r.json) as Config
    out.plugins = c.plugins
    return out
  } catch (e) {
    console.error(`raiju: config after secret resolution: ${e.message}`)
    return c
  }
}

// The log entries since a time that a data scope may see.
function scopedView(store: LogStore, sc: DataScope, since: f64): LogEntry[] {
  return scopedEntries(store.viewSince(since), sc)
}

// client.hidden_request_types: request log reads leave out the LLM entries of these types (Bifrost's
// withHiddenRequestTypes); writes, deletes and the cost recalculation still see them.
export function withoutHidden(es: LogEntry[], hidden: string[] | undefined): LogEntry[] {
  const hs: string[] = []
  for (const h of hidden ?? []) {
    const t = h.trim()
    if (t !== "" && !hs.includes(t)) hs.push(t)
  }
  if (hs.length === 0) return es
  const out: LogEntry[] = []
  for (const e of es) {
    // Bifrost's request type names (chat_completion_stream, embedding, ...) and Raiju's op names both work
    if (kindOf(e) === "llm" && (hs.includes(e.op) || hs.includes(bifrostRequestType(e.op, e.streamed === true)))) continue
    out.push(e)
  }
  return out
}

async function getText(url: string): Promise<{ status: int, body: string }> {
  const dl = deadline(10000)
  try {
    const r = await fetch(url, { signal: dl.controller.signal })
    const b = await r.text()
    dl.finish()
    return { status: r.status, body: b }
  } catch (e) {
    dl.finish()
    return { status: 0, body: e.message }
  }
}

async function postText(url: string, headers: Map<string, string>, body: string, tls?: TlsOpts): Promise<{ status: int, body: string }> {
  const dl = deadline(10000)
  try {
    const hs: Record<string, string> = headers
    const r = await fetch(url, { method: "POST", headers: hs, body: body, tls: tls, signal: dl.controller.signal })
    const b = await r.text()
    dl.finish()
    return { status: r.status, body: b }
  } catch (e) {
    dl.finish()
    return { status: 0, body: e.message }
  }
}

// postText with its own time limit (ms).
async function postTextWithin(url: string, headers: Map<string, string>, body: string, ms: int): Promise<{ status: int, body: string }> {
  const dl = deadline(ms)
  try {
    const hs: Record<string, string> = headers
    const r = await fetch(url, { method: "POST", headers: hs, body: body, signal: dl.controller.signal })
    const b = await r.text()
    dl.finish()
    return { status: r.status, body: b }
  } catch (e) {
    dl.finish()
    return { status: 0, body: e.message }
  }
}

// A redivision job's progress, in Bifrost's redivision_progress data.
export type RedivisionProgress = { operation_id: string, project_id: string, phase: string, total: int, processed: int, succeeded: int, failed: int, message: string }

// What an equal-split project's division depends on: its roster and the budgets and rate limits it holds (its own and
// its provider configs'). "" for a project that is not split equally.
export function redivisionSig(g: GovernanceConfig, pj: ProjectConfig): string {
  if (pj.split_policy !== "equal") return ""
  const parts: string[] = [rosterKey(pj)]
  const bids: string[] = []
  const rids: string[] = []
  if (pj.budget_id !== undefined) bids.push(pj.budget_id)
  if (pj.rate_limit_id !== undefined) rids.push(pj.rate_limit_id)
  for (const pc of pj.provider_configs ?? []) {
    const b = pc.budget_id
    if (b !== undefined) bids.push(b)
    const r = pc.rate_limit_id
    if (r !== undefined) rids.push(r)
  }
  for (const id of bids) {
    for (const b of g.budgets ?? []) {
      if (b.id === id) parts.push(`b:${id}:${b.max_limit}:${b.reset_duration}`)
    }
  }
  for (const id of rids) {
    for (const r of g.rate_limits ?? []) {
      if (r.id === id) parts.push(`r:${id}:${r.token_max_limit ?? -1}:${r.request_max_limit ?? -1}:${r.token_reset_duration ?? ""}:${r.request_reset_duration ?? ""}`)
    }
  }
  return parts.join("|")
}

// A project's roster as one text (its members' user ids), "" for no project.
function rosterKey(pj: ProjectConfig | undefined): string {
  if (pj === undefined) return ""
  const us: string[] = []
  for (const m of pj.members ?? []) us.push(m.user_id)
  us.sort()
  return "members:" + us.join(",")
}

// The users routes' path: /api/governance/users[/...] is /api/users[/...] (server.tov usersPath).
function userRoute(path: string): string {
  const g = "/api/governance/users"
  if (path === g || path.startsWith(g + "/")) return "/api/users" + path.slice(g.byteLength)
  return path
}

function findProject(c: Config, pid: string): ProjectConfig | undefined {
  for (const pj of c.governance?.projects ?? []) {
    if (pj.id === pid) return pj
  }
  return undefined
}

// Cross-node log reads (Ops.logsRouteAll): the rows a log read needs from a node (see Ops.readWindow), how long a
// peer is waited for, and the most rows one peer sends for a read (its newest).
export type LogReadWindow = { since: f64, until: f64 | undefined, kind: string, id: string, session: string, lite: bool }
const PEER_LOG_MS = 5000
const PEER_LOG_ROWS = 20000

// how long a management API change waits for the other workers to apply it (settleConfig)
const SETTLE_MS = 2000

async function pause(ms: int): Promise<void> {
  await new Promise<void>((resolve) => {
    setTimeout(() => resolve(), ms)
  })
}

async function putText(url: string, headers: Map<string, string>, body: string): Promise<{ status: int, body: string }> {
  const dl = deadline(10000)
  try {
    const hs: Record<string, string> = headers
    const r = await fetch(url, { method: "PUT", headers: hs, body: body, signal: dl.controller.signal })
    const b = await r.text()
    dl.finish()
    return { status: r.status, body: b }
  } catch (e) {
    dl.finish()
    return { status: 0, body: e.message }
  }
}

function html(status: int, body: string, cookie?: string): Response {
  const h: Record<string, string> = new Map()
  h.set("content-type", "text/html; charset=utf-8")
  h.set("cache-control", "no-store")
  const c = cookie ?? ""
  if (c !== "") h.set("set-cookie", c)
  return new Response(body, { status: status, headers: h })
}

function trimPeer(p: string): string {
  return p.endsWith("/") ? p.slice(0, p.byteLength - 1) : p
}

// How often discovery runs, in ms: it registers this node where the mechanism needs it, then lists the others.
const DISCOVER_MS = 10000

// How often the UI socket's tick runs, in ms: it writes and reads the workers' share files, sends each batch
// client its queue, and runs the heartbeat.
const UI_TICK_MS = 100

// The UI socket's heartbeat, as Bifrost's: a ping every 30 s, and a client that has not answered for
// 60 s is dropped.
const UI_PING_MS = 30000
const UI_PONG_MS = 60000

// With several workers, a worker keeps its store updates in its share file; once the file grows past
// this many bytes the older lines go.
const UI_SHARE_MAX = 65536

// A batch client may leave this many messages unsent before it is closed (1013): it resumes with its cursor.
const UI_QUEUE_MAX = 5000

// A worker's feed share file is trimmed to its newest FEED_SHARE_KEEP lines once it passes FEED_SHARE_MAX bytes.
const FEED_SHARE_MAX = 262144
const FEED_SHARE_KEEP = 300

// One dashboard client on /ws. A client may ask for batches (batch=1): its messages then come as one JSON array
// per tick, instead of one message each. A client may resume (since=node:seq,...): the hub replays the events it
// missed before the live ones (feed.tov).
export class UiSocket extends SocketExt {
  // messages a batch client has not been sent yet
  private queue: string[] = []

  constructor(readonly hub: UiHub, readonly scope: DataScope, readonly batch: bool, readonly since: Map<string, int> | undefined) {
    super()
    // a graceful stop closes it first: the client resumes elsewhere with its cursor (drain.tov)
    this.uiFeed = true
  }

  onOpen(): void {
    this.hub.add(this)
  }

  onClose(): void {
    this.closed = true
    this.hub.remove(this)
  }

  // Sends a message now, or queues it for the next batch.
  emit(text: string): void {
    if (!this.batch) {
      this.send(text)
      return
    }
    if (this.queue.length >= UI_QUEUE_MAX) {
      this.queue = []
      this.endWith(1013, "send buffer full: reconnect with since")
      return
    }
    this.queue.push(text)
  }

  // Sends the queued messages of a batch client as one JSON array.
  flush(): void {
    if (this.queue.length === 0) return
    const xs = this.queue
    this.queue = []
    this.send("[" + xs.join(",") + "]")
  }
}

// The events /ws pushes, in Bifrost's envelope {"type": ..., "data": ...}: store_update after a
// successful management write (tags name the resource changed), and log for each request-log entry
// (Bifrost's socket at this version sends notifications and store updates only; the log events are Raiju's).
//
// Log events are the live feed (feed.tov). Each event has a producer (the node, or node/pid for one worker)
// and that producer's next sequence. A worker takes the events it writes from the request log (ingest,
// "local"); the other workers of its node write theirs to share files (ingest, "share"); events from peer
// nodes or the broker come in over the cluster ("peer"). Every event goes into this worker's ring and to the
// clients whose data scope covers it, so any node's /ws streams the merged feed.
export cyclic class UiHub {
  clients: UiSocket[] = []
  timer: int = -1
  lastPing: f64 = 0.0
  // the node's share directory, or "" for one process
  shareDir = ""
  // how far each other worker's store-update share file has been read, by file name
  offsets: Map<string, int> = new Map()
  // ... and its feed share file
  feedOffsets: Map<string, int> = new Map()
  // the newest events from every producer, for a client that resumes
  ring: FeedRing = new FeedRing(FEED_RING_SIZE, FEED_RING_SECONDS * 1000.0)
  // this worker's events, waiting for the relay to the peers or the broker (only when relayOn)
  outbox: FeedQueue = new FeedQueue(FEED_QUEUE_MAX)
  relayOn = false
  // the newest sequence this worker has given its events
  private seq: int = 0
  // this worker's feed lines not yet written to its share file, and the bytes written since the last trim
  private shareBuf: string[] = []
  private shareBytes: int = 0

  add(c: UiSocket): void {
    c.pongAt = Date.now()
    this.clients.push(c)
    this.wake()
    const since = c.since
    if (since !== undefined) this.replay(c, since)
  }

  remove(c: UiSocket): void {
    this.clients = this.clients.filter((x) => x !== c)
    this.wake()
  }

  // The tick runs while there are clients, or sibling workers to read from.
  private wake(): void {
    const need = this.clients.length > 0 || this.shareDir !== ""
    if (need && this.timer < 0) {
      this.lastPing = Date.now()
      this.timer = setInterval(() => {
        this.tick()
      }, UI_TICK_MS)
    } else if (!need && this.timer >= 0) {
      clearInterval(this.timer)
      this.timer = -1
    }
  }

  // Sizes the ring and the outbox from cluster.feed. A change starts them empty; the same sizes keep what they hold.
  configureRing(maxItems: int, maxAgeMs: f64, queueMax: int): void {
    if (this.ring.maxItems === maxItems && this.ring.maxAgeMs === maxAgeMs && this.outbox.max === queueMax) return
    this.ring = new FeedRing(maxItems, maxAgeMs)
    this.outbox = new FeedQueue(queueMax)
  }

  // The next sequence for this worker's events. It starts at the process's start time in ms, so it grows across restarts.
  nextSeq(): int {
    if (this.seq === 0) this.seq = Math.floor(Date.now())
    this.seq += 1
    return this.seq
  }

  // Sends a store update to this worker's clients, and through the share file to the others.
  send(text: string): void {
    for (const c of this.clients) c.emit(text)
    if (this.shareDir !== "") this.share(text)
  }

  // The share directory of the node's workers: each worker writes its own files there, and the feed's under feed/.
  setShare(dir: string): void {
    try {
      mkdirSync(dir + "/feed", { recursive: true })
      this.shareDir = dir
    } catch (e) {
      this.shareDir = ""
    }
    this.wake()
  }

  // An event into the ring, to the clients that may see it, and on to the other workers and the peers. from is
  // "local" (this worker wrote it: it goes to the peers and the siblings), "peer" (it came from another node: the
  // siblings get it) or "share" (a sibling already shared it). False for a repeat.
  ingest(it: FeedItem, from: string): bool {
    if (!this.ring.add(it, Date.now())) return false
    if (from === "local" && this.relayOn) {
      const d = this.outbox.push(it)
      if (d > 0) metrics.inc("raiju_feed_dropped_total", `reason="queue"`, d)
    }
    if (from !== "share" && this.shareDir !== "") this.shareBuf.push(JSON.stringify(it))
    const text = feedEnvelope(it)
    for (const c of this.clients) {
      if (feedVisible(it, c.scope)) c.emit(text)
    }
    return true
  }

  // Replays to a client that resumed: the events it missed and may see, its gaps, then a resumed message.
  private replay(c: UiSocket, cursor: Map<string, int>): void {
    const r = this.ring.resume(cursor)
    let n = 0
    for (const it of r.items) {
      if (!feedVisible(it, c.scope)) continue
      c.emit(feedEnvelope(it))
      n += 1
    }
    for (const g of r.gaps) {
      c.emit(gapEnvelope(g))
      metrics.inc("raiju_feed_gap_events_total", "", g.missing)
    }
    c.emit(resumedEnvelope(n, r.gaps.length))
    metrics.inc("raiju_feed_replayed_total", "", n)
  }

  private shareFile(): string {
    return this.shareDir + "/" + process.pid + ".jsonl"
  }

  private feedFile(): string {
    return this.shareDir + "/feed/" + process.pid + ".jsonl"
  }

  // Appends a store update to this worker's file, keeping its last lines once it is large.
  private share(text: string): void {
    let old = ""
    try {
      old = readFileSync(this.shareFile(), "utf8")
    } catch (e) {
      old = ""
    }
    let out = old + text + "\n"
    if (out.byteLength > UI_SHARE_MAX) {
      const lines = out.split("\n")
      out = lines.slice(Math.max(0, lines.length - 200)).join("\n")
    }
    try {
      writeFileAtomic(this.shareFile(), out, { durable: false })
    } catch (e) {
      // the other workers miss this update
    }
  }

  // Appends this worker's feed lines to its share file. Past FEED_SHARE_MAX bytes the file keeps its newest lines;
  // a reader that finds its file shorter than before reads it again, and the ring drops what it has already seen.
  private flushShare(): void {
    if (this.shareBuf.length === 0) return
    const text = this.shareBuf.join("\n") + "\n"
    this.shareBuf = []
    const f = this.feedFile()
    try {
      appendFileSync(f, text)
    } catch (e) {
      // the other workers miss these events
      return
    }
    this.shareBytes += text.byteLength
    if (this.shareBytes <= FEED_SHARE_MAX) return
    try {
      const lines = readFileSync(f, "utf8").split("\n")
      writeFileAtomic(f, lines.slice(Math.max(0, lines.length - FEED_SHARE_KEEP)).join("\n"), { durable: false })
      this.shareBytes = 0
    } catch (e) {
      // the file keeps growing until the next try
    }
  }

  // Sends the store updates the other workers wrote since the last tick: whole lines only, so a line
  // still being written waits for the next tick.
  private fromShares(): void {
    let names: string[] = []
    try {
      names = readdirSync(this.shareDir)
    } catch (e) {
      return
    }
    const mine = this.shareFile().slice(this.shareDir.byteLength + 1)
    for (const f of names) {
      if (f === mine || !f.endsWith(".jsonl")) continue
      let text = ""
      try {
        text = readFileSync(this.shareDir + "/" + f, "utf8")
      } catch (e) {
        continue
      }
      let from = this.offsets.get(f) ?? 0
      // a file rewritten shorter than it was is read again from its start
      if (from > text.byteLength) from = 0
      const parts = text.slice(from).split("\n")
      let used = 0
      for (let i = 0; i < parts.length - 1; i++) {
        const line = parts[i]!
        used += line.byteLength + 1
        if (line !== "") {
          for (const c of this.clients) c.emit(line)
        }
      }
      this.offsets.set(f, from + used)
    }
  }

  // Ingests the events the other workers wrote to their feed share files since the last tick (whole lines only).
  private fromFeedShares(): void {
    const dir = this.shareDir + "/feed"
    let names: string[] = []
    try {
      names = readdirSync(dir)
    } catch (e) {
      return
    }
    const mine = `${process.pid}.jsonl`
    for (const f of names) {
      if (f === mine || !f.endsWith(".jsonl")) continue
      let text = ""
      try {
        text = readFileSync(dir + "/" + f, "utf8")
      } catch (e) {
        continue
      }
      let from = this.feedOffsets.get(f) ?? 0
      if (from > text.byteLength) from = 0
      const parts = text.slice(from).split("\n")
      let used = 0
      for (let i = 0; i < parts.length - 1; i++) {
        const line = parts[i]!
        used += line.byteLength + 1
        if (line === "") continue
        let it: FeedItem | undefined = undefined
        try {
          it = parseItem(line)
        } catch (e) {
          // a line that is not an event is skipped
        }
        if (it !== undefined) this.ingest(it, "share")
      }
      this.feedOffsets.set(f, from + used)
    }
  }

  // Pings the clients every 30 s, and drops the ones that have not answered for 60 s.
  private beat(now: f64): void {
    if (now - this.lastPing < UI_PING_MS) return
    this.lastPing = now
    for (const c of this.clients) {
      if (now - c.pongAt > UI_PONG_MS) c.drop()
      else c.ping()
    }
  }

  // One tick: the share files, the heartbeat, then each batch client's queue.
  tick(): void {
    if (this.shareDir !== "") {
      this.flushShare()
      this.fromShares()
      this.fromFeedShares()
    }
    this.beat(Date.now())
    for (const c of this.clients) c.flush()
  }
}

// The fields of a request-log entry that a dashboard shows live (no bodies, no raw payloads).
type LogEvent = { id: string, ts: f64, request_id: string, op: string, provider: string, model: string, status: int, latency_ms: f64, prompt_tokens: int, completion_tokens: int, cost: f64, cache_hit: bool, virtual_key?: string, error?: string }

function logEventView(e: LogEntry): LogEvent {
  return { id: e.id, ts: e.ts, request_id: e.request_id, op: e.op, provider: e.provider, model: e.model, status: e.status, latency_ms: e.latency_ms, prompt_tokens: e.prompt_tokens, completion_tokens: e.completion_tokens, cost: e.cost, cache_hit: e.cache_hit, virtual_key: e.virtual_key, error: e.error }
}

// A change waiting in Ops.underLock for its group: done hands its reply back to the request that queued it.
class LockWaiter {
  done: (r: Reply) => void = (r: Reply) => {}
  constructor(readonly change: () => Reply) {}
}

// The reply that replaces a change's own when its group could not write the config file (ConfigStore.group).
function groupFailed(status: int, message: string): Reply {
  return { status: status, body: errorJson(message, "api_error", undefined), contentType: "application/json" }
}

export class Ops {
  rbac: RbacConfig = { users: [] }
  // group commit (underLock): the changes waiting for the next group, and whether a request is leading one
  private lockQueue: LockWaiter[] = []
  private lockLeading = false
  authOn = false
  // the A2A gRPC binding's domain and advertised port (server.a2a_grpc_base_domain, a2a_grpc_port), set at start when
  // both are configured: the served cards then list the gRPC interface (a2agrpc.tov)
  a2aGrpc: { domain: string, port: int } | undefined = undefined
  // the A2A push relay: a pass in progress, and the passes made (the housekeeping runs on the first of each hour's)
  relayBusy = false
  relayTicks = 0
  // the card timer runs in this process (so a card can be fetched again and saved), and when each agent's card was
  // last fetched again because its endpoint answered as if it had moved
  cardRefreshOn = false
  cardRefreshAt: Map<string, f64> = new Map()
  // when a card fetched on demand last failed, by agent (not asked for again for 5 s)
  cardMissAt: Map<string, f64> = new Map()
  // the interfaces that failed each agent's calls, tried last (a2agrpcup.tov Demotions)
  a2aDemoted = new Demotions()
  // when each management API key was last used, by name, as this worker saw it (apikeys.tov)
  private keyUsed: Map<string, string> = new Map()
  // model parameters (GET /api/models/parameters), loaded when first asked and then daily
  private params: Map<string, string> = new Map()
  private paramsAt: f64 = -1.0
  private paramsUrl = ""
  // catalog attributes (PUT /api/models/catalog): "provider/model" to the attributes' JSON text
  private catalogAttrs: Map<string, string> = new Map()
  audit: AuditLog | undefined = undefined
  // why the audit log could not open ("" when it opened or is off)
  auditError = ""
  alerts: AlertEngine | undefined = undefined
  // Bifrost-style alert rules (CEL over a governance scope's usage)
  cel: CelEngine | undefined = undefined
  alertsKey = ""
  alertTimer: int = -1
  mcpSessions = new SessionStore(1800000.0)
  nodeId = "node"
  counters: Counters | undefined = undefined
  clusterCfg: ClusterConfig | undefined = undefined
  // the cluster listener's port (cluster.listen_port) when it runs, 0 otherwise: the main listener then refuses /api/cluster/*
  clusterPort: int = 0
  // cluster.serve_metrics with the cluster listener running: /metrics is served there, not on the main listener
  metricsOnCluster: bool = false
  clusterTimer: int = -1
  // discovered peers (sync URLs), kept from the last good round
  discoverer: Discoverer | undefined = undefined
  discovered: string[] = []
  discoverTimer: int = -1
  discoverErr = ""
  // broker mode: the last error reported, so a down broker is logged once
  brokerErr = ""
  // lock-based leader election (cluster_config.leader_lock): the lease and its round timer
  lock: LockElection | undefined = undefined
  lockTimer: int = -1
  // identity-aware proxy: its settings and key cache, and the SSO settings its full mode maps roles with
  proxyCfg: AuthProxyConfig | undefined = undefined
  proxyKeys: ProxyKeys | undefined = undefined
  proxyKey = ""
  proxyRoles: OidcConfig | undefined = undefined
  pushed: Map<string, f64> = new Map()
  pushedWindow: Map<string, string> = new Map()
  exportCfg: LogExportsConfig | undefined = undefined
  exportTimer: int = -1
  // the retained-content uploads (retained.tov), and whether one pass is running
  retainTimer: int = -1
  retainSending = false
  exportKey = ""
  cursor = new ExportCursor(Date.now())
  exporting = false
  exportersKey = ""
  exportersTimer: int = -1
  // one sender per exporter id; closed and replaced when the exporters change
  exporterSenders: Map<string, SinkSender> = new Map()
  retentionTimer: int = -1
  sweeping = false
  sending = false
  oidcCfg: OidcConfig | undefined = undefined
  // the oidc section as configured (before env. references are read), to tell a changed one
  oidcKey: string = ""
  discovery: Discovery | undefined = undefined
  flows = new OidcFlows()
  sessions = new UiSessions(28800)
  // directory sync (provision.tov, directory.tov): its schedule (the settings it was made for, the timer, the next
  // run), the daily session sweep, and the provisioning jobs (sync, import, reconcile) by operation id
  dirKey = ""
  dirTimer: int = -1
  dirNextMs = 0.0
  dirIntervalMs = 0.0
  dirRunning = false
  provisionOn = false
  sweepTimer: int = -1
  provJobs: Map<string, string> = new Map()
  provOrder: string[] = []
  // the /ws clients, and the virtual key that opened each live session (/v1/live/sessions)
  ui: UiHub
  // the live feed's relay (feed.tov): one queue per peer (and one for the broker), the broker cursor, the relay
  // timer, the queue bound, and the last relay error reported
  feedQueues: Map<string, FeedQueue> = new Map()
  feedTimer: int = -1
  brokerAfter: int = 0
  feedMax: int = FEED_QUEUE_MAX
  feedErr = ""
  liveSessions = new LiveRegistry()
  // single-use tickets for /ws?ticket= (POST /api/session/ws-ticket)
  wsTickets = new WsTickets()
  // the last cost recalculation job (POST /api/logs/recalculate-cost); a job walks the logs between timer ticks
  recalc: CostRecalc | undefined = undefined
  // the redivision job queued and not yet started, by project (queueRedivision)
  redivPending: Map<string, string> = new Map()
  // the rows the peers sent for the log read being answered (logsRouteAll sets them around the synchronous logsRoute)
  peerRows: LogEntry[] = []
  // the offloaded row of the log detail being answered, with its payload object merged (hydratedRow)
  hydratedEntry: LogEntry | undefined = undefined
  // the last error of a peer's log read, by peer, so each is reported once
  peerLogErr: Map<string, string> = new Map()

  constructor(readonly engine: Engine, readonly store: ConfigStore) {
    this.ui = new UiHub()
    // every request-log entry this process writes becomes a feed event (feed.tov)
    const hook = (e: LogEntry): void => {
      this.feedPublish(e)
    }
    this.engine.logFeed = hook
    const ls = this.engine.logStore
    if (ls !== undefined) ls.onAdd = hook
    try {
      this.nodeId = secureHex(6)
    } catch (e) {
      this.nodeId = "node"
    }
    this.configure(engine.cfg)
    // a card another worker or node fetched arrives through the cluster state (a2ashare.tov)
    clusterState().onChange(CARD_NS, (name: string, value: string | undefined): void => {
      this.adoptRemoteCard(name, value)
    })
    // a config saved by another worker or node arrives as a generation (store.tov CONFIG_NS); a save made here is sent
    // at once instead of at the next tick
    clusterState().onChange(CONFIG_NS, (key: string, value: string | undefined): void => {
      if (key === CONFIG_KEY) this.takeConfigGen(value)
    })
    store.onSaved = () => {
      this.configSaved()
    }
    this.loadCatalogAttrs()
    // MCP tool executions go to the request log store (kind "mcp")
    setMcpToolLog((c: McpToolCall) => {
      this.recordMcp(c)
    })
  }

  // Applies the parts of a (resolved) config that live here.
  configure(cfg: Config): void {
    deliveryLog().setRetentionDays(cfg.client?.webhook_config?.delivery_history_retention_days)
    // deliveries survive restarts in the logs_store folder, when that store is on
    const lsw = cfg.logs_store
    if (lsw !== undefined && lsw.enabled === true) deliveryLog().persistTo(join(lsw.dir ?? "logs", "webhook-deliveries.jsonl"))
    // the A2A callbacks callers registered and the pushes waiting to reach them survive restarts the same way; their
    // secrets are sealed with the config's key
    const ps = pushStore()
    ps.seal = (v: string): string => {
      try {
        return sealStored(this.store.cipher, v)
      } catch (e) {
        return v
      }
    }
    ps.open = (v: string): string => openStored(this.store.cipher, v) ?? ""
    // a log row's logs_only reveal mapping is sealed the same way
    this.engine.sealLog = (v: string): string => {
      try {
        return sealStored(this.store.cipher, v)
      } catch (e) {
        return ""
      }
    }
    ps.openSecret = (v: string): string | undefined => openStored(this.store.cipher, v)
    // push configs and agent cards travel on the cluster state (a2ashare.tov); a card is sent when it changes
    pushShare()
    const cards = cardShare()
    for (const a of cfg.agents ?? []) cards.publish(a.name, a.agent_card_url, a.card ?? "", a.card_fetched_at ?? 0)
    if (ps.dir === "" && lsw !== undefined && lsw.enabled === true) ps.persistTo(join(lsw.dir ?? "logs", "a2a-push.jsonl"))
    // the virtual key that created each provider file and batch (client.enforce_vk_object_ownership), kept the same way
    const owners = objectOwners()
    if (owners.dir === "" && lsw !== undefined && lsw.enabled === true) owners.useDir(join(lsw.dir ?? "logs", "provider-objects"))
    const gov = cfg.governance
    const users: UserConfig[] = gov?.users ?? []
    const auth = gov?.auth_config
    let legacy: UserConfig[] = []
    try {
      legacy = fromLegacy(auth).users
    } catch (e) {
      console.error(`raiju: admin credentials: ${e.message}`)
    }
    this.rbac = { users: users.concat(legacy), roles: gov?.roles ?? [], api_keys: gov?.api_keys ?? [] }
    // admin credentials also count as inference auth, as in Bifrost
    const rb = this.rbac
    // an agent token from the CLI's sign-in (agentsignin.tov) names its user too
    this.engine.gov.altAuth = (h) => this.agentUserOf(h) !== undefined || (rb.users.length > 0 && authenticate(rb, h).kind === "user")
    this.engine.gov.userOf = (h) => {
      const agent = this.agentUserOf(h)
      if (agent !== undefined) return agent.user
      if (rb.users.length === 0) return undefined
      const who = authenticate(rb, h)
      return who.kind === "user" ? who.name : undefined
    }
    // auth_config with only part of a credential still locks the API, as before
    this.authOn = this.rbac.users.length > 0 || (gov?.api_keys ?? []).length > 0 || !checkAdmin(auth, new Map())
    const ac = cfg.audit
    if (this.audit === undefined && ac !== undefined && ac.enabled === true) {
      try {
        this.audit = new AuditLog(ac.dir ?? "logs/audit", ac.key ?? "", ac.max_memory ?? 10000)
        this.auditError = ""
      } catch (e) {
        this.auditError = e.message
        console.error(`raiju: audit log disabled: ${e.message}`)
      }
    }
    if (ac === undefined || ac.enabled !== true) this.auditError = ""
    for (const v of cfg.virtual_mcps ?? []) {
      const problem = vmcp.validate(v)
      if (problem !== "") console.error(`raiju: virtual MCP ${v.name}: ${problem}`)
    }
    this.configurePricing(cfg.pricing_sync)
    this.configureLibrary(cfg.pricing_sync)
    this.configureOtelMetrics(cfg.otel)
    this.configurePushGateway(cfg.telemetry?.push_gateway)
    this.configureAlerts(cfg.alerts)
    this.configureCluster(cfg.cluster)
    this.configureFeed(cfg.cluster)
    this.configureProxy(cfg.auth_proxy, cfg.oidc)
    // the sign-in throttle and the proxies whose forwarding headers are believed (server.sign_in_throttle, trusted_proxies)
    signInGuard().configure(cfg.server?.sign_in_throttle)
    const badProxies = badProxyEntries(trustedProxies(cfg.server?.trusted_proxies, process.env.RAIJU_TRUSTED_PROXIES ?? ""))
    if (badProxies.length > 0) console.error(`raiju: server.trusted_proxies: ${badProxies.join(", ")} is not an address or CIDR range and matches nothing`)
    this.configureExports(cfg.log_exports)
    this.configureRetained()
    this.configureExporters(cfg.exporters ?? [])
    const oc = cfg.oidc
    const key = oc === undefined ? "" : JSON.stringify(oc)
    const same = oc !== undefined && this.oidcCfg !== undefined && key === this.oidcKey
    if (!same) {
      this.discovery = undefined
      this.oidcKey = key
      // the issuer, client and secret may be env. references (scim_config's settings allow them)
      let ro = oc
      if (ro !== undefined) {
        ro.issuer = resolveEnv(ro.issuer)
        ro.client_id = resolveEnv(ro.client_id)
        const sec = ro.client_secret
        if (sec !== undefined) ro.client_secret = resolveEnv(sec)
        const auds = ro.audiences
        if (auds !== undefined) ro.audiences = auds.map((a) => resolveEnv(a))
      }
      this.oidcCfg = ro !== undefined && ro.enabled ? ro : undefined
      // the sessions themselves stay (they live in a file the workers share and a restart keeps, keepAuthState)
      if (ro !== undefined) this.sessions.ttlSeconds = ro.session_ttl_seconds ?? 28800
    }
    this.configureDirectory()
  }

  // ---- clustering: budget and rate-limit usage shared between nodes ----

  configureCluster(cc: ClusterConfig | undefined): void {
    if (this.clusterTimer >= 0) {
      clearInterval(this.clusterTimer)
      this.clusterTimer = -1
    }
    if (this.feedTimer >= 0) {
      clearInterval(this.feedTimer)
      this.feedTimer = -1
    }
    this.ui.relayOn = false
    if (this.discoverTimer >= 0) {
      clearInterval(this.discoverTimer)
      this.discoverTimer = -1
    }
    const old = this.discoverer
    if (old !== undefined) old.close()
    this.discoverer = undefined
    this.discovered = []
    if (this.lockTimer >= 0) {
      clearInterval(this.lockTimer)
      this.lockTimer = -1
    }
    this.lock = undefined
    if (cc === undefined || !cc.enabled) {
      this.clusterCfg = undefined
      return
    }
    // a weak or missing secret would let anyone sign the peer routes: clustering stays off (the start refuses it
    // already; this covers a config saved while running)
    const weak = cluster.secretProblem(cc.secret, cc.secret)
    if (weak !== "") {
      console.error(`raiju: cluster: ${weak}; clustering is off`)
      this.clusterCfg = undefined
      return
    }
    this.clusterCfg = cc
    const id = cc.node_id ?? ""
    if (id !== "") this.nodeId = id
    if (this.counters === undefined) this.counters = new Counters(this.nodeId)
    clusterState().setWriter(this.nodeId)
    this.engine.health.holds.setNode(this.nodeId)
    this.clusterTimer = setInterval(() => {
      this.syncCluster()
    }, Math.max(100, syncInterval(cc)))
    // the live feed goes to the other nodes unless cluster.feed.cluster_wide is off
    this.ui.relayOn = cc.feed?.cluster_wide ?? true
    this.feedTimer = setInterval(() => {
      this.feedRelay()
    }, Math.max(20, cc.feed?.batch_ms ?? FEED_BATCH_MS))
    // broker mode has no discovery: the broker is the rendezvous point
    if (cluster.isBroker(cc) && cc.broker === undefined) console.error(`raiju: cluster: type "broker" needs cluster.broker.address; no cluster traffic until it is set`)
    const dc0 = cc.discovery
    if (!cluster.isBroker(cc) && dc0 !== undefined && dc0.enabled === true) {
      // the peers serve the cluster routes on cluster.listen_port when it is set, so discovered hosts get that port
      let dc = dc0
      if (dc.bind_port === undefined && cc.listen_port !== undefined) dc.bind_port = cc.listen_port
      this.discoverer = new Discoverer(dc, this.nodeId, getEnv)
      this.discoverTimer = setInterval(() => {
        this.discover()
      }, DISCOVER_MS)
      this.discover()
    }
    const ll = cc.leader_lock
    if (ll !== undefined) {
      // the holder names this process, so the key shows which worker of which node leads
      const le = new LockElection(ll, `${this.nodeId}/${process.pid}`)
      this.lock = le
      this.lockTimer = setInterval(() => {
        this.electLock()
      }, le.roundMs())
      this.electLock()
    }
  }

  // One leader-lock round. Leadership is read from the lock by isLeader(), so a failed round only ends it when the lease runs out.
  async electLock(): Promise<void> {
    const le = this.lock
    if (le === undefined) return
    await le.tick()
  }

  // One discovery round. The peers it finds are synced with from then on; on failure the last good list stays.
  async discover(): Promise<void> {
    const d = this.discoverer
    if (d === undefined) return
    const r = await d.tick()
    if (!r.ok) {
      if (r.error !== this.discoverErr) console.error(`raiju: cluster discovery: ${r.error}`)
      this.discoverErr = r.error
      return
    }
    if (this.discoverErr !== "") console.error("raiju: cluster discovery: found peers again")
    this.discoverErr = ""
    this.discovered = r.peers
  }

  // The configured peers and the discovered ones, each once.
  peerUrls(cc: ClusterConfig): string[] {
    const out: string[] = []
    for (const p of cc.peers) {
      const u = trimPeer(p)
      if (!out.includes(u)) out.push(u)
    }
    for (const u of this.discovered) {
      if (!out.includes(u)) out.push(u)
    }
    return out
  }

  // Whether this node leads the cluster. Without clustering it always does. With leader_lock it holds the etcd
  // lock. Otherwise the lowest live node id leads (Bifrost's rule), and the workers of that node share the answer.
  isLeader(): bool {
    const c = this.counters
    const cc = this.clusterCfg
    if (c === undefined || cc === undefined) return true
    const lk = this.lock
    if (lk !== undefined) return lk.leading(Date.now())
    const me = cluster.nodeOf(this.nodeId)
    const ids: string[] = [me]
    for (const p of c.peers(Date.now() - cluster.LEADER_WINDOW_MS)) ids.push(cluster.nodeOf(p.id))
    return cluster.electLeader(ids) === me
  }

  // GET /metrics: with several workers, every worker's series summed.
  metricsText(): string {
    this.storeMetrics()
    if (this.shareDir === "") return metrics.render()
    const dir = this.shareDir + "/metrics"
    const mine = `${process.pid}.prom`
    const texts: string[] = [metrics.render()]
    try {
      for (const f of readdirSync(dir)) {
        if (f === mine || !f.endsWith(".prom")) continue
        try {
          texts.push(readFileSync(dir + "/" + f, "utf8"))
        } catch (e) {
          continue
        }
      }
    } catch (e) {
      return texts[0]!
    }
    return metrics.mergeRendered(texts)
  }

  // ---- the worker processes of one node share budgets, rate limits and the response cache ----

  shareDir = ""
  shareTimer: int = -1
  sweeps = 0

  // Called in each worker after the fork. Usage counters gossip through files in the node's share folder, which the
  // supervisor made before the fork (makeShareDir: private and unpredictable), with the same CRDT merge as clustering,
  // and the response cache keeps its entries there too. dir is "" when the folder could not be made.
  // The dashboard's sessions and the CLI's sign-in codes and tokens, in files beside the config file
  // (<config>.sessions.json and .agent-sessions.json, 0600): every worker of the node reads and writes them
  // (sharedtable.tov), so a session made on one works on all, and a restart keeps the sessions and the refresh tokens.
  // Tokens are kept by hash; the identity provider's refresh token is sealed with the config's encryption key when one
  // is set. Single sign-on logins in flight are kept nowhere: their state value carries them, sealed with stateKey
  // (oidc.tov OidcFlows), which every worker of the node holds.
  keepAuthState(configPath: string, sealer: Sealer, stateKey: u8[]): void {
    this.flows.setKey(stateKey)
    if (configPath === "") return
    this.sessions.setFile(configPath + ".sessions.json")
    this.sessions.sealer = sealer
    agentSignIn().setFile(configPath + ".agent-sessions.json")
    // the flow file of earlier versions is read no more
    try {
      rmSync(configPath + ".oidc-flows.json", { force: true })
    } catch (e) {
      // left as it is
    }
  }

  startLocalShare(dir: string): void {
    if (dir === "") return
    this.shareDir = dir
    try {
      mkdirSync(this.shareDir + "/counters", { recursive: true })
    } catch (e) {
      console.error(`raiju: can't share state between workers: ${e.message}`)
      return
    }
    // async jobs: the worker that runs one writes its state here, so a poll on any worker finds it (jobs.tov)
    this.engine.jobs.useDir(this.shareDir + "/jobs")
    // each worker is its own slot (inherited counters would collide)
    this.counters = new Counters(this.nodeId + "/" + process.pid)
    clusterState().setWriter(this.nodeId + "/" + process.pid)
    this.engine.health.holds.setNode(this.nodeId + "/" + process.pid)
    this.pushed = new Map()
    this.pushedWindow = new Map()
    this.engine.sharedWindows = true
    this.engine.gov.alignWindows()
    const cache = this.engine.cache
    if (cache !== undefined) cache.share(this.shareDir + "/cache")
    const sem = this.engine.semantic
    if (sem !== undefined && this.engine.vstore === undefined) sem.share(this.shareDir + "/semantic")
    const ls = this.engine.logStore
    if (ls !== undefined) ls.shared = true
    // A2A push configs and queued pushes: in the logs_store folder when there is one (already in use), else here
    const ps = pushStore()
    if (ps.dir === "") ps.useDir(this.shareDir + "/a2a-push")
    // live sessions (who opened each one) and the UI socket's store updates
    this.liveSessions.share(this.shareDir + "/live")
    // failed sign-ins, counted for the whole node
    signInGuard().share(this.shareDir + "/signin")
    this.ui.setShare(this.shareDir + "/ui")
    try {
      mkdirSync(this.shareDir + "/metrics", { recursive: true })
    } catch (e) {
      // metrics stay per worker
    }
    // the config generation each worker has applied (settleConfig reads them)
    try {
      mkdirSync(this.shareDir + "/gen", { recursive: true })
    } catch (e) {
      // a save then answers without waiting for the other workers
    }
    this.ackConfig()
    // A request counted in one worker reaches the others within two ticks; until then a
    // burst spread over several workers can pass a limit by a little (as across cluster nodes).
    this.shareTimer = setInterval(() => {
      this.shareTick()
    }, 100)
  }

  // Reads the node's share folder now, as the share tick does: the other workers' usage, holds and cluster state, so
  // the cards they fetched are adopted into this worker's configs before this returns. A process alone has no folder.
  syncShared(): void {
    if (this.shareDir === "") return
    this.shareTick()
  }

  // Puts the cards of the agents on the cluster state now and writes this worker's share file at once, so the other
  // workers of the node take them at their next share tick (every 100 ms, shareTimer): every worker holds a card
  // fetched by one of them within that interval. Called after a card is saved, by the timer's pass and by the agents
  // API, without waiting for the config change to be applied (configure publishes them as well, later).
  publishCards(): void {
    const cards = cardShare()
    for (const a of this.store.cfg.agents ?? []) {
      if ((a.card ?? "") !== "") cards.publish(a.name, a.agent_card_url, a.card ?? "", a.card_fetched_at ?? 0)
    }
    this.syncShared()
  }

  shareTick(): void {
    const c = this.counters
    if (c === undefined) return
    this.pushLocal(c)
    const dir = this.shareDir + "/counters"
    const mine = `${process.pid}.json`
    try {
      writeFileAtomic(dir + "/" + mine, c.encode(), { durable: false })
      for (const f of readdirSync(dir)) {
        if (f === mine || !f.endsWith(".json")) continue
        try {
          c.merge(readFileSync(dir + "/" + f, "utf8"))
        } catch (e) {
          // a file another worker removed; the next tick reads it again
          continue
        }
      }
    } catch (e) {
      return
    }
    this.applyRemote(c)
    this.sweeps += 1
    const cache = this.engine.cache
    if (cache !== undefined && this.sweeps % 600 === 0) cache.sweepShared(Date.now())
    if (this.sweeps % 10 === 0) {
      const sem = this.engine.semantic
      if (sem !== undefined) sem.syncShared(Date.now())
      this.storeMetrics()
      try {
        writeFileAtomic(`${this.shareDir}/metrics/${process.pid}.prom`, metrics.render(), { durable: false })
      } catch (e) {
        // a scrape then shows this worker's last written numbers
      }
    }
  }

  // Adds this node's new usage to its slots and gives each window the other nodes' share.
  pushLocal(c: Counters): void {
    const now = Date.now()
    for (const u of this.engine.gov.sharedUsage(now)) {
      let prev = this.pushed.get(u.name) ?? 0.0
      if (this.pushedWindow.get(u.name) !== u.window) prev = 0.0
      if (u.used > prev) c.add(u.name, u.window, u.used - prev)
      this.pushed.set(u.name, u.used)
      this.pushedWindow.set(u.name, u.window)
    }
    // the key holds travel with the usage (holds.tov); they exist only under adaptive load balancing
    c.setHolds(this.engine.health.holds.wire(now))
    // the replicated state (clusterstate.tov) travels the same way
    c.setState(clusterState().wire(now))
  }

  applyRemote(c: Counters): void {
    const now = Date.now()
    const gov = this.engine.gov
    for (const u of gov.sharedUsage(now)) gov.setRemote(u.name, u.window, Math.max(0.0, c.total(u.name, u.window) - u.used), now)
    const hs = c.takeHolds()
    if (this.engine.cfg.health?.adaptive === true) this.engine.health.holds.merge(hs, now)
    clusterState().merge(c.takeState(), now)
  }

  // The live nodes: this one and the peers heard from within the leader window, by node id (a worker counts as its node).
  liveNodes(): string[] {
    const me = cluster.nodeOf(this.nodeId)
    const out: string[] = [me]
    const c = this.counters
    if (c === undefined || this.clusterCfg === undefined) return out
    for (const p of c.peers(Date.now() - cluster.LEADER_WINDOW_MS)) {
      const n = cluster.nodeOf(p.id)
      if (!out.includes(n)) out.push(n)
    }
    return out
  }

  // Whether this node owns the retained admin credential of an MCP client (one node renews each, see gateway.tov).
  ownsAdmin(client: string): bool {
    return ownerOf(client, this.liveNodes()) === cluster.nodeOf(this.nodeId)
  }

  // whether the sync body has outgrown cluster.max_body_mb (said once)
  syncTooBig = false

  syncCluster(): void {
    const c = this.counters
    const cc = this.clusterCfg
    if (c === undefined || cc === undefined) return
    this.pushLocal(c)
    const body = c.encode()
    // a peer refuses a body over cluster.max_body_mb unread (413): said once, so the operator can raise it
    if (!this.syncTooBig && body.byteLength > cluster.clusterBodyCap(cc)) {
      this.syncTooBig = true
      console.error(`raiju: cluster: this node's sync body is ${body.byteLength} bytes, over cluster.max_body_mb (${cluster.clusterBodyCap(cc)} bytes): its peers refuse it; raise cluster.max_body_mb on every node`)
    }
    // signed over the body, and over the head (method, route, time, length) before a peer or the broker reads the body
    const h = cluster.peerHeaders(cc.secret, "/api/cluster/sync", body, Date.now())
    if (cluster.isBroker(cc)) {
      // one outbound exchange with the broker, which relays to the other nodes
      const b = cc.broker
      if (b !== undefined) this.syncBroker(c, b, cluster.peerHeaders(cc.secret, BROKER_ROUTE, body, Date.now()), body)
    } else {
      for (const p of this.peerUrls(cc)) this.pushTo(p + "/api/cluster/sync", h, body, c, cc.secret)
    }
    c.forget(Date.now() - 30.0 * syncInterval(cc))
  }

  // Broker mode: the broker answers with the joined state of all nodes and the roster, so this node learns
  // the usage of nodes it has no link to, and which nodes are alive for leadership.
  async syncBroker(c: Counters, b: BrokerConfig, h: Map<string, string>, body: string): Promise<void> {
    const r = await postText(brokerUrl(b) + BROKER_ROUTE, h, body)
    if (r.status !== 200) {
      const why = r.status === 0 ? r.body : `HTTP ${r.status}`
      if (why !== this.brokerErr) console.error(`raiju: cluster broker: ${why}`)
      this.brokerErr = why
      return
    }
    if (this.brokerErr !== "") console.error("raiju: cluster broker: connected again")
    this.brokerErr = ""
    try {
      c.relay(r.body, Date.now())
      this.applyRemote(c)
    } catch (e) {
      console.error(`raiju: cluster broker: bad answer: ${e.message}`)
    }
  }

  // GET /api/cluster/leader: whether this node leads, and by which election. Signed over the method, the path and the
  // caller's time in x-raiju-cluster-ts (cluster.signRequest), refused when that time is over a minute off like the
  // other peer routes, so a captured request does not replay.
  clusterLeader(req: Request): Response {
    const cc = this.clusterCfg
    if (cc === undefined) return json(404, errorJson("clustering is off", "invalid_request_error", undefined))
    const why = cluster.requestRefusal(cc.secret, "GET", "/api/cluster/leader", req.headers.get(cluster.TS_HEADER) ?? "", req.headers.get("x-raiju-cluster-sig") ?? "", Date.now())
    if (why !== "") return denied(401, why)
    const election = this.lock !== undefined ? "lock" : "rank"
    return json(200, JSON.stringify({ node: this.nodeId, leader: this.isLeader(), election: election }))
  }

  async pushTo(url: string, h: Map<string, string>, body: string, c: Counters, secret: string): Promise<void> {
    const r = await postText(url, h, body)
    if (r.status !== 200) return
    // the peer answers with its own state: push and pull in one round trip
    try {
      c.merge(r.body)
      this.applyRemote(c)
    } catch (e) {
      console.error(`raiju: cluster: bad state from ${url}: ${e.message}`)
    }
  }

  // POST /api/cluster/sync from a peer, signed with the shared secret.
  async clusterSync(req: Request): Promise<Response> {
    const c = this.counters
    const cc = this.clusterCfg
    if (c === undefined || cc === undefined) return json(404, errorJson("clustering is off", "invalid_request_error", undefined))
    const body = await req.text()
    if (!cluster.verify(cc.secret, body, req.headers.get("x-raiju-cluster-sig") ?? "")) return denied(401, "bad cluster signature")
    try {
      c.merge(body)
    } catch (e) {
      return json(400, errorJson(e.message, "invalid_request_error", undefined))
    }
    this.pushLocal(c)
    this.applyRemote(c)
    return json(200, c.encode())
  }

  // The storage that is on, required and could not open: the request log store (logs_store) and the audit log, each
  // required unless its section sets required: false. The start fails on any (main.tov), and readiness reports them.
  storageProblems(): string[] {
    const out: string[] = []
    const ls = this.engine.cfg.logs_store
    if (ls !== undefined && ls.enabled === true && ls.required !== false && this.engine.logStoreError !== "") out.push(`logs_store: ${this.engine.logStoreError}`)
    const ac = this.engine.cfg.audit
    if (ac !== undefined && ac.enabled === true && ac.required !== false && this.audit === undefined && this.auditError !== "") out.push(`audit: ${this.auditError}`)
    return out
  }

  // request log entries that could not be written, counted into raiju_log_store_dropped_total before a render
  droppedSeen: f64 = 0.0

  storeMetrics(): void {
    const ls = this.engine.logStore
    if (ls === undefined) return
    const total: f64 = ls.dropped
    if (total > this.droppedSeen) metrics.inc("raiju_log_store_dropped_total", "", total - this.droppedSeen)
    this.droppedSeen = total
  }

  // ---- config generations: a save reaches every worker of the node and the other nodes (store.tov) ----

  // the newest generation heard of, a pull in flight, and the last note logged (each once per generation)
  latestGen = ""
  pullingGen = ""
  genNote = ""

  // After a save here: this worker's share file (and, when clustered, a sync) goes out now, so the other workers take
  // the generation within one share tick (100 ms) and the peers within one round trip.
  configSaved(): void {
    const c = this.counters
    if (c === undefined) return
    if (this.shareDir !== "") {
      this.pushLocal(c)
      try {
        writeFileAtomic(`${this.shareDir}/counters/${process.pid}.json`, c.encode(), { durable: false })
      } catch (e) {
        // the next share tick writes it
      }
    }
    if (this.clusterCfg !== undefined) this.syncCluster()
  }

  // Notes in the share folder that this worker runs the config generation it holds (called once the engine has been
  // rebuilt from it, main.tov applyChange).
  ackConfig(): void {
    if (this.shareDir === "") return
    try {
      writeFileAtomic(`${this.shareDir}/gen/${process.pid}`, this.store.fileSha, { durable: false })
    } catch (e) {
      // settleConfig then waits out its bound for this worker
    }
  }

  // Called before a management API change is answered: waits until every other live worker of the node runs the
  // generation just saved (their notes in the share folder), at most SETTLE_MS, so a virtual key deleted through the
  // API is refused by every worker once the answer is out. A worker whose share file has not moved for a second is
  // taken for gone. Other nodes take the generation at their next cluster sync and are not waited for.
  async settleConfig(): Promise<void> {
    if (this.shareDir === "") return
    const sha = this.store.fileSha
    const until = Date.now() + SETTLE_MS
    for (;;) {
      const late = this.workersBehind(sha)
      if (late.length === 0) return
      if (Date.now() >= until) {
        console.error(`raiju: config: worker(s) ${late.join(", ")} did not apply the saved configuration within ${SETTLE_MS} ms; answering anyway`)
        return
      }
      await pause(10)
    }
  }

  // The live workers of the node (other than this one) that do not yet run generation sha (or a newer one).
  workersBehind(sha: string): string[] {
    const out: string[] = []
    const dir = this.shareDir + "/counters"
    const now = Date.now()
    let names: string[] = []
    try {
      names = readdirSync(dir)
    } catch (e) {
      return out
    }
    for (const f of names) {
      if (!f.endsWith(".json")) continue
      const pid = f.slice(0, f.byteLength - 5)
      if (pid === `${process.pid}`) continue
      try {
        if (now - statSync(dir + "/" + f).mtimeMs > 1000.0) continue
      } catch (e) {
        continue
      }
      let held = ""
      try {
        held = readFileSync(`${this.shareDir}/gen/${pid}`, "utf8")
      } catch (e) {
        held = ""
      }
      if (held !== sha && held !== this.store.fileSha) out.push(pid)
    }
    return out
  }

  // A generation saved by another worker of this node or by another node. A worker always rereads the file the node
  // shares. Another node's save is taken per cluster.config_sync: "file" (default) rereads the file when it holds the
  // saved text, "pull" fetches the text from a peer otherwise, and "off" ignores it.
  takeConfigGen(value: string | undefined): void {
    if (value === undefined) return
    const g = genOf(value)
    if (g === undefined) return
    this.latestGen = g.sha
    const sibling = g.node === cluster.nodeOf(this.nodeId)
    const mode = sibling ? "file" : this.clusterCfg?.config_sync ?? "file"
    if (mode === "off") return
    const r = this.store.takeGeneration(g.sha)
    if (r.status === "same") return
    if (r.status === "reloaded") {
      if (!sibling) console.error(`raiju: config: took the configuration node ${g.node} saved (shared config file)`)
      return
    }
    if (r.status === "error") {
      this.noteGen(g.sha, `raiju: config: the configuration ${sibling ? "another worker" : "node " + g.node} saved could not be applied: ${r.message}`)
      return
    }
    // the file holds other text: a sibling has saved again since (its next generation follows), or this node has a file of its own
    if (sibling) return
    if (mode === "pull") {
      this.pullConfig(g)
      return
    }
    this.noteGen(g.sha, `raiju: config: node ${g.node} saved a configuration this node's config file does not hold, so it is not applied here (share the file between the nodes, or set cluster.config_sync to "pull")`)
  }

  private noteGen(sha: string, msg: string): void {
    if (this.genNote === sha) return
    this.genNote = sha
    console.error(msg)
  }

  // cluster.config_sync "pull": the text of a generation another node saved, from the first peer that holds it (POST
  // /api/cluster/config), written to this node's file with its own cluster section and applied. A peer's workers may
  // take a moment to hold it, so a few rounds are tried. A newer generation heard of meanwhile wins.
  async pullConfig(g: ConfigGen): Promise<void> {
    const cc = this.clusterCfg
    if (cc === undefined || this.pullingGen === g.sha) return
    if (cluster.isBroker(cc)) {
      this.noteGen(g.sha, `raiju: config: node ${g.node} saved a configuration, and cluster.config_sync "pull" needs peers (type "broker" has none): share the config file between the nodes`)
      return
    }
    this.pullingGen = g.sha
    try {
      for (let round = 0; round < 5; round++) {
        if (round > 0) await pause(300 * round)
        if (this.latestGen !== g.sha || this.store.fileSha === g.sha) return
        const body = JSON.stringify({ sha: g.sha, ts: Date.now() })
        const h = cluster.peerHeaders(cc.secret, "/api/cluster/config", body, Date.now())
        for (const p of this.peerUrls(cc)) {
          const r = await postText(p + "/api/cluster/config", h, body)
          if (r.status !== 200 || textSha(r.body) !== g.sha) continue
          if (this.latestGen !== g.sha || this.store.fileSha === g.sha) return
          const note = this.store.adoptPulled(r.body, g.sha)
          if (note !== "") console.error(`raiju: config: ${note}`)
          if (this.store.fileSha === g.sha) console.error(`raiju: config: took the configuration node ${g.node} saved (pulled from ${p})`)
          return
        }
      }
      this.noteGen(g.sha, `raiju: config: node ${g.node} saved a configuration that no peer could hand over; this node keeps its own until the next save`)
    } finally {
      this.pullingGen = ""
    }
  }

  // POST /api/cluster/config from a peer pulling a generation (cluster.config_sync "pull"). Signed like the sync route,
  // over a body naming the generation and the time (a request older than a minute is refused, so a captured one does
  // not replay); the answer is the config text as its writer saved it, secrets sealed when encryption at rest is on.
  async clusterConfig(req: Request): Promise<Response> {
    const cc = this.clusterCfg
    if (cc === undefined) return json(404, errorJson("clustering is off", "invalid_request_error", undefined))
    const body = await req.text()
    if (!cluster.verify(cc.secret, body, req.headers.get("x-raiju-cluster-sig") ?? "")) return denied(401, "bad cluster signature")
    let ask: { sha: string, ts: f64 } = { sha: "", ts: 0.0 }
    try {
      ask = try JSON.parse(body) as { sha: string, ts: f64 }
    } catch (e) {
      return json(400, errorJson(e.message, "invalid_request_error", undefined))
    }
    if (!cluster.fresh(ask.ts, Date.now())) return denied(401, "stale cluster request")
    if (ask.sha === "" || ask.sha !== this.store.fileSha || this.store.genText === "") return json(404, errorJson("this node does not hold that configuration", "not_found_error", undefined))
    const hs: Record<string, string> = new Map()
    hs.set("content-type", "application/json")
    hs.set("cache-control", "no-store")
    return new Response(this.store.genText, { status: 200, headers: hs })
  }

  // ---- the redivision job of an equal-split project (Bifrost's redivision_job_id and redivision_progress) ----

  // The equal-split projects a management write may redivide, each with what its division depends on (redivisionSig).
  // Taken before the write; withRedivision compares after it.
  redivisionBefore(method: string, path: string): Map<string, string> {
    const out: Map<string, string> = new Map()
    if (method === "GET" || !(path.startsWith("/api/governance/") || userRoute(path).startsWith("/api/users/"))) return out
    const g = this.store.cfg.governance
    if (g === undefined) return out
    for (const pj of g.projects ?? []) {
      const sig = redivisionSig(g, pj)
      if (sig !== "") out.set(pj.id, sig)
    }
    return out
  }

  // After a management write that succeeded: a user deleted leaves every project roster (Bifrost's cascade), and each
  // equal-split project whose roster or divided caps changed gets a redivision job. The answer of a project or member
  // route names its job as redivision_job_id; any other write (a user delete, a budget or rate-limit edit) lists them
  // as redivision_job_ids. A project that is no longer equal-split (or is gone) has nothing to redivide.
  withRedivision(method: string, path: string, r: Reply, before: Map<string, string>): Reply {
    if (r.status >= 300 || method === "GET") return r
    const up = userRoute(path)
    if (method === "DELETE" && up.startsWith("/api/users/") && up.split("/").length === 4) {
      const user = pctDecode(up.split("/")[3] ?? "") ?? ""
      for (const pj of this.store.cfg.governance?.projects ?? []) {
        for (const m of pj.members ?? []) {
          if (user !== "" && m.user_id === user) this.store.removeProjectMember(pj.id, m.id)
        }
      }
    }
    if (before.size === 0) return r
    const g = this.store.cfg.governance
    const ids: string[] = []
    let named = ""
    const segs = path.split("/")
    const projectRoute = segs[2] === "governance" && segs[3] === "projects" && segs.length >= 5
    for (const pj of g?.projects ?? []) {
      const was = before.get(pj.id)
      if (was === undefined || g === undefined) continue
      const now = redivisionSig(g, pj)
      if (now === "" || now === was) continue
      const id = this.queueRedivision(pj.id)
      ids.push(id)
      if (projectRoute && segs[4] === pj.id) named = id
    }
    if (ids.length === 0 || !r.body.trimStart().startsWith("{")) return r
    try {
      let fs = fields(r.body)
      if (projectRoute && named !== "") setField(&fs, "redivision_job_id", JSON.stringify(named))
      else setField(&fs, "redivision_job_ids", JSON.stringify(ids))
      return { status: r.status, body: build(fs), contentType: r.contentType }
    } catch (e) {
      return r
    }
  }

  // Queues the redivision of a project and answers its job id. A job for the same project that has not started yet is
  // reused, as Bifrost reuses a pending job rather than queueing behind it.
  queueRedivision(pid: string): string {
    const pending = this.redivPending.get(pid)
    if (pending !== undefined) return pending
    const id = newId("redivision-")
    this.redivPending.set(pid, id)
    setTimeout(() => {
      this.runRedivision(id, pid)
    }, 0)
    return id
  }

  // One redivision: once this process runs the saved roster (the governance is rebuilt from the saved config, which
  // divides every budget and rate limit the project holds by its roster), each member's slices are counted. Progress
  // goes out on /ws as Bifrost's redivision_progress events (redividing, then completed or error). The work itself is
  // the reload; a slice keeps the spend it has counted (redivision moves caps, never spend).
  async runRedivision(id: string, pid: string): Promise<void> {
    this.redivPending.delete(pid)
    const saved = findProject(this.store.cfg, pid)
    let total = saved === undefined ? 0 : (saved.members ?? []).length
    this.redivisionProgress({ operation_id: id, project_id: pid, phase: "redividing", total: total, processed: 0, succeeded: 0, failed: 0, message: "" })
    // the running config takes the saved one within a moment (main.tov applyChange)
    const want = rosterKey(saved)
    for (let i = 0; i < 100; i++) {
      if (rosterKey(findProject(this.engine.cfg, pid)) === want) break
      await pause(20)
    }
    const running = findProject(this.engine.cfg, pid)
    if (running === undefined || saved === undefined) {
      this.redivisionProgress({ operation_id: id, project_id: pid, phase: "completed", total: 0, processed: 0, succeeded: 0, failed: 0, message: "the project was deleted; nothing to redivide" })
      return
    }
    if (rosterKey(running) !== want) {
      this.redivisionProgress({ operation_id: id, project_id: pid, phase: "error", total: total, processed: 0, succeeded: 0, failed: total, message: "the saved roster did not reach the running configuration in time" })
      return
    }
    const members = running.members ?? []
    total = members.length
    let ok = 0
    let failed = 0
    let slices = 0
    const gov = this.engine.gov
    for (const m of members) {
      const key = pid + "/" + m.user_id
      const b = gov.memberCaps.get(key)
      const l = gov.memberRateCaps.get(key)
      if (b === undefined || l === undefined) failed += 1
      else {
        ok += 1
        slices += b.length + l.length
      }
    }
    const message = `redivided the caps of ${total} member${total === 1 ? "" : "s"} (${slices} slice${slices === 1 ? "" : "s"})`
    this.redivisionProgress({ operation_id: id, project_id: pid, phase: failed > 0 ? "error" : "completed", total: total, processed: total, succeeded: ok, failed: failed, message: failed > 0 ? `${failed} member${failed === 1 ? "" : "s"} got no slices` : message })
  }

  // A redivision_progress event on /ws for every client, through the feed like a store update.
  redivisionProgress(p: RedivisionProgress): void {
    const it: FeedItem = { node: this.feedProducer(), seq: this.ui.nextSeq(), ts: Date.now(), team: "", bu: "", customer: "", project: "", data: JSON.stringify(p), kind: "redivision_progress" }
    this.ui.ingest(it, "local")
  }

  // ---- cross-node log reads: each node keeps its own log files, so a read asks the peers for their rows ----

  // The rows a log read at path needs from a node: the window (since, exclusive, and until), the kind ("" for any),
  // one row by id or the rows of one session, and whether bodies travel. undefined for a path that reads no rows
  // (dropped, the cost recalculation, the User-Agent mappings). now is the asking node's clock, so both nodes
  // compute the same window.
  readWindow(path: string, sp: URLSearchParams, now: f64): LogReadWindow | undefined {
    const any: LogReadWindow = { since: 0.0, until: undefined, kind: "", id: "", session: "", lite: true }
    if (path === "/api/logs" || path === "/api/logs/stats") {
      const f = listFilter(sp, now)
      // agent_names selects by the sessions of A2A calls, so those rows travel too
      const kind = (sp.get("agent_names") ?? "") !== "" ? "" : "llm"
      return { since: f.since - 1.0, until: f.until, kind: kind, id: "", session: "", lite: path !== "/api/logs" }
    }
    if (path.startsWith("/api/mcp-logs")) {
      const rest = path.slice("/api/mcp-logs".byteLength)
      if (rest === "" ) return { since: 0.0, until: undefined, kind: "mcp", id: "", session: "", lite: false }
      if (rest === "/filterdata") return { since: 0.0, until: undefined, kind: "mcp", id: "", session: "", lite: true }
      if (rest === "/stats" || rest.startsWith("/histogram")) {
        const end = epochParam(sp.get("end_time") ?? undefined, now)
        return { since: this.windowStart(sp, end) - 1.0, until: end, kind: "mcp", id: "", session: "", lite: true }
      }
      const id = rest.slice(1)
      if (id !== "" && !id.includes("/")) return { since: 0.0, until: undefined, kind: "mcp", id: id, session: "", lite: false }
      return undefined
    }
    if (!path.startsWith("/api/logs/")) return undefined
    const sub = path.slice("/api/logs/".byteLength)
    if (sub.startsWith("sessions/")) {
      const rest = sub.slice("sessions/".byteLength)
      const raw = rest.endsWith("/summary") ? rest.slice(0, rest.byteLength - "/summary".byteLength) : rest
      const sid = pctDecode(raw) ?? ""
      if (sid === "" || sid.includes("/")) return undefined
      return { since: 0.0, until: undefined, kind: "llm", id: "", session: sid, lite: true }
    }
    if (sub === "filterdata") return any
    if (sub === "dropped" || sub.startsWith("recalculate-cost") || sub.startsWith("user-agent-mappings")) return undefined
    if (sub !== "" && !sub.includes("/") && !LOG_ROUTE_NAMES.includes(sub)) return { since: 0.0, until: undefined, kind: "llm", id: sub, session: "", lite: false }
    // the histograms, rankings and dashboard: the window and the span before it (the rankings' trends)
    const end = epochParam(sp.get("end_time") ?? undefined, now)
    const start = this.windowStart(sp, end)
    if (start >= end) return undefined
    return { since: start - (end - start) - 1.0, until: end, kind: "", id: "", session: "", lite: true }
  }

  // This node's own rows for a read window (what POST /api/cluster/logs answers): never the rows of its peers.
  localRows(store: LogStore, w: LogReadWindow): LogEntry[] {
    if (w.id !== "") {
      const e = store.findById(w.id)
      if (e === undefined || (w.kind !== "" && kindOf(e) !== w.kind)) return []
      return [e]
    }
    const out: LogEntry[] = []
    for (const e of store.viewSince(w.since, w.until)) {
      if (w.kind !== "" && kindOf(e) !== w.kind) continue
      if (w.session !== "" && e.session_id !== w.session) continue
      out.push(w.lite ? liteEntry(e) : publicEntry(e))
    }
    // the newest rows when a node has more than it sends at once
    if (out.length > PEER_LOG_ROWS) return out.slice(out.length - PEER_LOG_ROWS)
    return out
  }

  // A request log read, with the peers' rows when the cluster is on with peers and cluster.log_reads is not false: each
  // peer is asked at once (POST /api/cluster/logs, signed, a few seconds at most), and the read is answered over this
  // node's rows and theirs. A peer that does not answer is left out (reported once until it answers again). Broker
  // mode has no peer addresses, so it reads this node's rows.
  // A log detail of an offloaded row (the hybrid store) also reads its payload object first (hydratedRow).
  async logsRouteAll(req: Request, path: string, body: string, scope?: DataScope, reveal?: bool): Promise<Reply> {
    const store = this.engine.logStore
    if (req.method !== "GET" || store === undefined) return this.logsRoute(req, path, body, scope, reveal)
    const rows = await this.askPeers(req, path)
    const hyd = await this.hydratedRow(path, store, rows)
    // (set and cleared around the synchronous route, so concurrent reads never see each other's rows)
    this.peerRows = rows
    this.hydratedEntry = hyd
    const r = this.logsRoute(req, path, body, scope, reveal)
    this.peerRows = []
    this.hydratedEntry = undefined
    return r
  }

  // The peers' rows for a read: none when clustering is off, cluster.log_reads is false, the mode is broker (no peer
  // addresses), there are no peers or the path reads no rows.
  async askPeers(req: Request, path: string): Promise<LogEntry[]> {
    const cc = this.clusterCfg
    const none: LogEntry[] = []
    if (cc === undefined || cc.log_reads === false || cluster.isBroker(cc)) return none
    const peers = this.peerUrls(cc)
    const u = URL.parse(req.url)
    const query = u === undefined ? "" : (u.search.startsWith("?") ? u.search.slice(1) : u.search)
    const now = Date.now()
    const w = this.readWindow(path, new URLSearchParams(query), now)
    if (peers.length === 0 || w === undefined) return none
    const ask = JSON.stringify({ path: path, query: query, now: now, ts: now })
    const h = cluster.peerHeaders(cc.secret, "/api/cluster/logs", ask, now)
    const pending: Promise<LogEntry[]>[] = []
    for (const p of peers) pending.push(this.peerLogs(p, h, ask))
    const rows: LogEntry[] = []
    for (const part of await Promise.all(pending)) {
      for (const e of part) rows.push(e)
    }
    return rows
  }

  // One peer's rows for a read, or none when it does not answer.
  async peerLogs(peer: string, h: Map<string, string>, ask: string): Promise<LogEntry[]> {
    const r = await postTextWithin(peer + "/api/cluster/logs", h, ask, PEER_LOG_MS)
    const prior = this.peerLogErr.get(peer) ?? ""
    if (r.status !== 200) {
      const why = r.status === 0 ? r.body : `HTTP ${r.status}`
      if (why !== prior) console.error(`raiju: cluster log read: ${peer}: ${why}; answering without its rows`)
      this.peerLogErr.set(peer, why)
      return []
    }
    if (prior !== "") console.error(`raiju: cluster log read: ${peer} answers again`)
    this.peerLogErr.delete(peer)
    try {
      return (try JSON.parse(r.body) as { rows: LogEntry[] }).rows
    } catch (e) {
      console.error(`raiju: cluster log read: bad answer from ${peer}: ${e.message}`)
      return []
    }
  }

  // POST /api/cluster/logs from a peer answering a log read: this node's own rows for the read's window. Signed like
  // the sync route, over a body naming the read's path and query and the asking node's time (a request older than a
  // minute is refused, so a captured one does not replay). The caller's data scope and hidden request types are
  // applied by the asking node; a row's reveal mapping travels only for a read of that one row.
  async clusterLogs(req: Request): Promise<Response> {
    const cc = this.clusterCfg
    if (cc === undefined) return json(404, errorJson("clustering is off", "invalid_request_error", undefined))
    const body = await req.text()
    if (!cluster.verify(cc.secret, body, req.headers.get("x-raiju-cluster-sig") ?? "")) return denied(401, "bad cluster signature")
    let ask: { path: string, query: string, now: f64, ts: f64 } = { path: "", query: "", now: 0.0, ts: 0.0 }
    try {
      ask = try JSON.parse(body) as { path: string, query: string, now: f64, ts: f64 }
    } catch (e) {
      return json(400, errorJson(e.message, "invalid_request_error", undefined))
    }
    if (!cluster.fresh(ask.ts, Date.now())) return denied(401, "stale cluster request")
    const store = this.engine.logStore
    if (store === undefined) return json(200, `{"node":${JSON.stringify(this.nodeId)},"rows":[]}`)
    const w = this.readWindow(ask.path, new URLSearchParams(ask.query), ask.now)
    if (w === undefined) return json(400, errorJson(`no log read at ${ask.path}`, "invalid_request_error", undefined))
    const rows = this.localRows(store, w)
    const hs: Record<string, string> = new Map()
    hs.set("content-type", "application/json")
    hs.set("cache-control", "no-store")
    return new Response(`{"node":${JSON.stringify(this.nodeId)},"rows":${JSON.stringify(rows)}}`, { status: 200, headers: hs })
  }

  // ---- the live feed (/ws) across the workers of a node and the cluster (feed.tov) ----

  // The ring and outbox sizes from cluster.feed (defaults in feed.tov). The ring serves resumes on every node.
  configureFeed(cc: ClusterConfig | undefined): void {
    const f = cc?.feed
    this.feedMax = f?.queue_max ?? FEED_QUEUE_MAX
    this.ui.configureRing(f?.ring_size ?? FEED_RING_SIZE, (f?.ring_seconds ?? FEED_RING_SECONDS) * 1000.0, this.feedMax)
  }

  // The feed's producer: the node, or the node and this worker's pid when several workers share it.
  feedProducer(): string {
    return this.shareDir === "" ? this.nodeId : `${this.nodeId}/${process.pid}`
  }

  // A request-log entry this process wrote, as a feed event.
  feedPublish(e: LogEntry): void {
    const it: FeedItem = { node: this.feedProducer(), seq: this.ui.nextSeq(), ts: e.ts, team: e.team_id ?? "", bu: e.business_unit_id ?? "", customer: e.customer_id ?? "", project: e.project_id ?? "", data: JSON.stringify(logEventView(e)) }
    this.ui.ingest(it, "local")
  }

  // The relay tick: this worker's new events go into each peer's queue (or the broker's), and one request goes out
  // per queue with events and none in flight. In broker mode every tick also pulls the other nodes' events.
  feedRelay(): void {
    const cc = this.clusterCfg
    if (cc === undefined || !this.ui.relayOn) return
    const batch = this.ui.outbox.take(this.ui.outbox.size)
    if (cluster.isBroker(cc)) {
      const b = cc.broker
      if (b !== undefined) this.feedBroker(brokerUrl(b) + BROKER_FEED_ROUTE, this.feedQueueFor("broker"), batch, cc.secret)
      return
    }
    const peers = this.peerUrls(cc)
    for (const k of this.feedQueues.keys()) {
      if (k !== "broker" && !peers.includes(k)) this.feedQueues.delete(k)
    }
    for (const p of peers) {
      const q = this.feedQueueFor(p)
      for (const it of batch) this.feedDropped("queue", q.push(it))
      this.feedPost(p + "/api/cluster/feed", q, cc.secret)
    }
  }

  private feedQueueFor(key: string): FeedQueue {
    const q = this.feedQueues.get(key)
    if (q !== undefined) return q
    const nq = new FeedQueue(this.feedMax)
    this.feedQueues.set(key, nq)
    return nq
  }

  // Events that did not get through, by reason: "queue" (the peer was too slow and the oldest went), "send" (a relay
  // request failed) and "missed" (the broker's ring had moved past them).
  private feedDropped(reason: string, n: int): void {
    if (n > 0) metrics.inc("raiju_feed_dropped_total", `reason="${reason}"`, n)
  }

  // Sends up to FEED_BATCH_MAX queued events to one peer. One request is in flight per peer, and a failed one drops its events.
  async feedPost(url: string, q: FeedQueue, secret: string): Promise<void> {
    if (q.busy || q.size === 0) return
    q.busy = true
    const items = q.take(FEED_BATCH_MAX)
    const body = JSON.stringify({ items: items })
    const h = cluster.peerHeaders(secret, "/api/cluster/feed", body, Date.now())
    const r = await postText(url, h, body)
    q.busy = false
    if (r.status === 200) {
      this.feedErr = ""
      metrics.inc("raiju_feed_relayed_total", "", items.length)
      return
    }
    this.feedDropped("send", items.length)
    const why = r.status === 0 ? r.body : `HTTP ${r.status}`
    if (why !== this.feedErr) console.error(`raiju: cluster feed: ${url}: ${why}`)
    this.feedErr = why
  }

  // Broker mode: one request per tick. It carries this worker's queued events and its cursor, and the answer has the
  // other nodes' events after the cursor. A broker that restarted has lower positions than the cursor: the cursor goes back to 0.
  async feedBroker(url: string, q: FeedQueue, batch: FeedItem[], secret: string): Promise<void> {
    for (const it of batch) this.feedDropped("queue", q.push(it))
    if (q.busy) return
    q.busy = true
    const items = q.take(FEED_BATCH_MAX)
    const body = JSON.stringify({ node: cluster.nodeOf(this.nodeId), after: this.brokerAfter, items: items })
    const h = cluster.peerHeaders(secret, BROKER_FEED_ROUTE, body, Date.now())
    const r = await postText(url, h, body)
    q.busy = false
    if (r.status !== 200) {
      this.feedDropped("send", items.length)
      const why = r.status === 0 ? r.body : `HTTP ${r.status}`
      if (why !== this.feedErr) console.error(`raiju: cluster feed: broker: ${why}`)
      this.feedErr = why
      return
    }
    if (this.feedErr !== "") console.error("raiju: cluster feed: broker connected again")
    this.feedErr = ""
    try {
      const ans = parseAnswer(r.body)
      if (ans.last < this.brokerAfter) {
        this.brokerAfter = 0
        return
      }
      this.brokerAfter = ans.next
      this.feedDropped("missed", ans.missed)
      metrics.inc("raiju_feed_relayed_total", "", items.length)
      for (const it of ans.items) this.ui.ingest(it, "peer")
    } catch (e) {
      console.error(`raiju: cluster feed: bad answer from the broker: ${e.message}`)
    }
  }

  // POST /api/cluster/feed from a peer: its events join this worker's ring, and go on to the sibling workers.
  async clusterFeed(req: Request): Promise<Response> {
    const cc = this.clusterCfg
    if (cc === undefined || !this.ui.relayOn) return json(404, errorJson("the cluster feed is off", "invalid_request_error", undefined))
    const body = await req.text()
    if (!cluster.verify(cc.secret, body, req.headers.get("x-raiju-cluster-sig") ?? "")) return denied(401, "bad cluster signature")
    let items: FeedItem[] = []
    try {
      items = parseFeed(body)
    } catch (e) {
      return json(400, errorJson(e.message, "invalid_request_error", undefined))
    }
    let n = 0
    for (const it of items) {
      if (this.ui.ingest(it, "peer")) n += 1
    }
    return json(200, JSON.stringify({ accepted: n }))
  }

  // ---- OpenTelemetry metrics (Bifrost's otel metrics_* settings) ----

  otelTimer: int = -1
  otelKey = ""
  readonly startMs = Date.now()

  configureOtelMetrics(oc: OtelConfig | undefined): void {
    const key = oc === undefined || oc.metrics_enabled !== true ? "" : JSON.stringify(oc)
    if (key === this.otelKey) return
    this.otelKey = key
    if (this.otelTimer >= 0) {
      clearInterval(this.otelTimer)
      this.otelTimer = -1
    }
    if (oc === undefined || key === "") return
    const s: OtelMetricsSettings = { metrics_enabled: true, metrics_endpoint: oc.metrics_endpoint, metrics_headers: oc.metrics_headers, metrics_push_interval: oc.metrics_push_interval, headers: oc.headers, traces_endpoint: oc.endpoint, overhead_breakdown_enabled: oc.overhead_breakdown_enabled }
    const problem = validateMetricsSettings(s)
    if (problem !== undefined) {
      console.error(`raiju: otel metrics: ${problem}`)
      return
    }
    const resource: Map<string, string> = new Map()
    resource.set("service.name", oc.service_name ?? "raiju")
    const tls = otelTls(oc)
    const grpc = usesGrpc(oc)
    this.otelTimer = setInterval(() => {
      const r = exportMetricsRequest(s, this.metricsText(), this.startMs, Date.now(), resource)
      if (grpc) {
        exportMetricsGrpc(oc, r.body, r.headers)
        return
      }
      this.pushOtel(r.url, r.headers, r.body, tls)
    }, pushIntervalSeconds(s) * 1000)
  }

  // ---- Prometheus Push Gateway (Bifrost's telemetry push_gateway) ----

  pushTimer: int = -1
  pushKey = ""

  configurePushGateway(pc: PushGatewayConfig | undefined): void {
    const key = pc === undefined || pc.enabled !== true ? "" : JSON.stringify(pc)
    if (key === this.pushKey) return
    this.pushKey = key
    if (this.pushTimer >= 0) {
      clearInterval(this.pushTimer)
      this.pushTimer = -1
    }
    if (pc === undefined || key === "") return
    const problem = pushProblem(pc)
    if (problem !== undefined) {
      console.error(`raiju: push gateway: ${problem}`)
      return
    }
    const url = pushUrl(pc)
    const h = pushHeaders(pc)
    this.pushTimer = setInterval(() => {
      this.pushMetrics(url, h)
    }, pushInterval(pc) * 1000)
  }

  async pushMetrics(url: string, h: Map<string, string>): Promise<void> {
    const r = await putText(url, h, this.metricsText())
    if (r.status < 200 || r.status >= 300) console.error(`raiju: push gateway: HTTP ${r.status} from ${url}`)
  }

  async pushOtel(url: string, h: Map<string, string>, body: string, tls: TlsOpts | undefined): Promise<void> {
    const r = await postText(url, h, body, tls)
    if (r.status < 200 || r.status >= 300) console.error(`raiju: otel metrics: HTTP ${r.status} from ${url}`)
  }

  // ---- the price datasheet (Bifrost's framework.pricing) ----

  pricingTimer: int = -1
  pricingKey = ""

  configurePricing(ps: PricingSyncConfig | undefined): void {
    const key = JSON.stringify(ps ?? {})
    if (key === this.pricingKey) return
    this.pricingKey = key
    if (this.pricingTimer >= 0) {
      clearInterval(this.pricingTimer)
      this.pricingTimer = -1
    }
    // syncing is opt-in: the built-in copy needs no network
    if (ps === undefined || ps.enabled === false) return
    const url = ps.url ?? "https://getbifrost.ai/datasheet"
    const every = Math.max(3600, ps.interval_seconds ?? 86400)
    this.syncPricing(url)
    this.pricingTimer = setInterval(() => {
      if (this.isLeader()) this.syncPricing(url)
    }, every * 1000)
  }

  async syncPricing(url: string): Promise<void> {
    const err = await this.loadPricing(url)
    if (err !== "") console.error(`raiju: ${err}; keeping the current prices`)
  }

  // Fetches the datasheet and swaps the prices in; "" on success, else what went wrong.
  async loadPricing(url: string): Promise<string> {
    const r = await getText(url)
    if (r.status !== 200) return `price datasheet from ${url}: HTTP ${r.status}`
    try {
      const rows = parseDatasheet(r.body)
      this.engine.catalogRows = rows
      this.engine.pricing.replaceCatalog(rows)
      return ""
    } catch (e) {
      return `price datasheet from ${url}: ${e.message}`
    }
  }

  // POST /api/pricing/force-sync: one sync now, from the configured URL or the default.
  async forcePricing(): Promise<Reply> {
    const url = this.store.cfg.pricing_sync?.url ?? "https://getbifrost.ai/datasheet"
    const err = await this.loadPricing(url)
    if (err !== "") return { status: 500, body: JSON.stringify({ error: { message: `failed to force pricing sync: ${err}`, type: "api_error" } }), contentType: "application/json" }
    return { status: 200, body: JSON.stringify({ status: "success", message: "pricing synced successfully" }), contentType: "application/json" }
  }

  // ---- the MCP server library (Bifrost's framework.pricing.mcp_library_url) ----

  libraryTimer: int = -1
  libraryKey = ""

  // The library file's lock, taken around a read-modify-write of it (the workers of a node all write it); waited for
  // without pausing the worker. ok is false when another process kept it.
  async lockLibrary(): Promise<FileLock> {
    if (this.store.path === "") return { path: "", ok: true }
    return await lockFileAsync(this.store.path + ".mcp_library.json")
  }

  // The library as its file holds it now (another worker or node may have synced it).
  library(): McpLibrary {
    const lib = new McpLibrary(this.store.path === "" ? "" : this.store.path + ".mcp_library.json")
    lib.load()
    return lib
  }

  // The library syncs in the background when a pricing_sync section turns it on (its mcp_library_url set, or
  // the section enabled), every mcp_library_sync_interval seconds (a day when unset or negative; 0 never).
  // The first sync runs now; later ones on the cluster leader only.
  configureLibrary(ps: PricingSyncConfig | undefined): void {
    const key = ps === undefined ? "" : JSON.stringify({ u: ps.mcp_library_url ?? "", i: ps.mcp_library_sync_interval ?? -1, e: ps.enabled ?? true })
    if (key === this.libraryKey) return
    this.libraryKey = key
    if (this.libraryTimer >= 0) {
      clearInterval(this.libraryTimer)
      this.libraryTimer = -1
    }
    if (ps === undefined) return
    const named = (ps.mcp_library_url ?? "") !== ""
    if (!named && ps.enabled === false) return
    const iv = ps.mcp_library_sync_interval ?? -1
    if (iv === 0) return
    const every = iv < 0 ? DEFAULT_LIBRARY_SYNC_SECONDS : iv
    const url = named ? ps.mcp_library_url! : DEFAULT_LIBRARY_URL
    this.backgroundLibrary(url)
    this.libraryTimer = setInterval(() => {
      if (this.isLeader()) this.backgroundLibrary(url)
    }, every * 1000)
  }

  async backgroundLibrary(url: string): Promise<void> {
    const r = await this.syncLibrary(url, true)
    if (r.error !== "") console.error(`raiju: MCP library sync: ${r.error}`)
  }

  // One library sync: the catalog fetched (retried with backoff for a network URL when retry), upserted and saved.
  async syncLibrary(url: string, retry: bool): Promise<{ count: int, error: string }> {
    let last = ""
    const tries = retry && !url.startsWith("file://") ? 4 : 1
    for (let attempt = 0; attempt < tries; attempt++) {
      if (attempt > 0) await new Promise<void>((resolve) => setTimeout(resolve, Math.min(10000, 1000 * Math.pow(2, attempt - 1))))
      try {
        const text = await fetchCatalog(url, 45000)
        const lock = await this.lockLibrary()
        if (!lock.ok) return { count: 0, error: "the MCP library file is locked by another process; retry" }
        try {
          const lib = this.library()
          const n = lib.sync(text, Date.now())
          lib.save()
          unlockFile(lock)
          return { count: n, error: "" }
        } catch (e) {
          unlockFile(lock)
          throw e
        }
      } catch (e) {
        last = e.message
      }
    }
    return { count: 0, error: `failed to fetch MCP library from ${url}: ${last}` }
  }

  // /api/mcp/library (GET a page, POST a custom entry), /api/mcp/library/filterdata, /api/mcp/library/force-sync
  // and DELETE /api/mcp/library/{id}.
  async libraryRoute(req: Request, path: string, body: string): Promise<Reply> {
    const m = req.method
    const noStore = this.store.path === ""
    const reply = (st: int, b: string): Reply => ({ status: st, body: b, contentType: "application/json" })
    const notAllowed = reply(405, errorJson(`method ${m} is not allowed on this route`, "invalid_request_error", undefined))
    if (path === "/api/mcp/library") {
      if (m === "GET") {
        if (noStore) return reply(200, `{"servers":[],"count":0,"total_count":0,"limit":0,"offset":0}`)
        const u = URL.parse(req.url)
        const r = listLibrary(this.library(), u === undefined ? new URLSearchParams("") : u.searchParams)
        return reply(r.status, r.body)
      }
      if (m === "POST") {
        if (noStore) return reply(503, errorJson("MCP operations unavailable: config store is disabled", "api_error", undefined))
        const lock = await this.lockLibrary()
        if (!lock.ok) return reply(503, errorJson("the MCP library file is locked by another process; retry", "api_error", undefined))
        const r = createLibraryEntry(this.library(), body, Date.now())
        unlockFile(lock)
        return reply(r.status, r.body)
      }
      return notAllowed
    }
    if (path === "/api/mcp/library/filterdata") {
      if (m !== "GET") return notAllowed
      if (noStore) return reply(200, `{"categories":[],"connection_types":[],"auth_types":[],"tags":[]}`)
      const r = libraryFilterData(this.library())
      return reply(r.status, r.body)
    }
    if (path === "/api/mcp/library/force-sync") {
      if (m !== "POST") return notAllowed
      if (noStore) return reply(503, errorJson("config store not available", "api_error", undefined))
      const ps = this.store.cfg.pricing_sync
      const url = (ps?.mcp_library_url ?? "") !== "" ? ps!.mcp_library_url! : DEFAULT_LIBRARY_URL
      const r = await this.syncLibrary(url, true)
      if (r.error !== "") return reply(500, errorJson(`failed to sync MCP library: ${r.error}`, "api_error", undefined))
      return reply(200, JSON.stringify({ status: "success", message: `MCP library sync completed, ${r.count} entries synced` }))
    }
    const segs = path.split("/")
    if (segs.length === 5) {
      if (m !== "DELETE") return notAllowed
      if (noStore) return reply(503, errorJson("MCP operations unavailable: config store is disabled", "api_error", undefined))
      const lock = await this.lockLibrary()
      if (!lock.ok) return reply(503, errorJson("the MCP library file is locked by another process; retry", "api_error", undefined))
      const r = deleteLibraryEntry(this.library(), segs[4]!)
      unlockFile(lock)
      return reply(r.status, r.body)
    }
    return reply(404, errorJson(`no route for ${path}`, "invalid_request_error", undefined))
  }

  // ---- model parameters and the writable catalog ----

  // GET /api/models/parameters?model=...: the parameter record for a model, as the datasheet keys it.
  // Provider-qualified ids resolve to the bare or qualified key (see resolveParams). The datasheet is
  // fetched once a day when a pricing_sync section is set (from its URL, /model-parameters); otherwise
  // and on any failure the embedded fallback answers.
  async modelParameters(req: Request): Promise<Reply> {
    if (req.method !== "GET") return { status: 405, body: errorJson("use GET", "invalid_request_error", undefined), contentType: "application/json" }
    const u = URL.parse(req.url)
    const sp = u === undefined ? new URLSearchParams("") : u.searchParams
    const model = (sp.get("model") ?? "").trim()
    if (model === "") return badRequest("model query parameter is required")
    await this.loadParams()
    const hit = resolveParams(this.params, model)
    if (hit === undefined) return { status: 404, body: errorJson(`no parameters found for model ${model}`, "not_found_error", undefined), contentType: "application/json" }
    return okJson(hit)
  }

  private async loadParams(): Promise<void> {
    const now = Date.now()
    const ps = this.store.cfg.pricing_sync
    // framework.pricing.model_parameters_url, else the datasheet's /model-parameters; a file:// URL is read from disk
    const url = ps === undefined ? "" : (ps.model_parameters_url ?? (trimSlash(ps.url ?? "https://getbifrost.ai/datasheet") + "/model-parameters"))
    // a changed URL is read now
    if (this.paramsAt >= 0.0 && now - this.paramsAt < 86400000.0 && url === this.paramsUrl) return
    if (this.params.size === 0) this.params = fallbackParams()
    this.paramsAt = now
    this.paramsUrl = url
    if (ps === undefined) return
    try {
      let body = ""
      if (url.startsWith("file://")) {
        let path = url.slice(7)
        if (path.startsWith("localhost/")) path = path.slice(9)
        body = try readFileSync(path, "utf8")
      } else {
        const r = await getText(url)
        if (r.status !== 200) throw new Error(`HTTP ${r.status}`)
        body = r.body
      }
      const next = parseParams(body)
      if (next.size > 0) this.params = next
    } catch (e) {
      console.error(`raiju: model parameters: ${e.message}`)
      // try again within the hour
      this.paramsAt = now - 82800000.0
    }
  }

  // PUT /api/models/catalog: sets the additional attributes of catalog entries, each (model, provider)
  // of which must be in the price catalog; the whole batch is refused when one is not. An empty
  // attribute map clears the entry. Kept in <config>.catalog.json next to the config file.
  // The route's form: the catalog file's lock is waited for without pausing the worker, then catalogUpsert takes it
  // again at once.
  async catalogUpsertRoute(req: Request, body: string): Promise<Reply> {
    if (req.method !== "PUT" || this.store.path === "") return this.catalogUpsert(req, body)
    const held = await lockFileAsync(this.catalogFile())
    if (!held.ok) return { status: 503, body: errorJson("the catalog file is locked by another process; retry", "api_error", undefined), contentType: "application/json" }
    const r = this.catalogUpsert(req, body)
    unlockFile(held)
    return r
  }

  catalogUpsert(req: Request, body: string): Reply {
    if (req.method !== "PUT") return { status: 405, body: errorJson("use PUT", "invalid_request_error", undefined), contentType: "application/json" }
    let items: string[] = []
    try {
      items = elements(body)
    } catch (e) {
      return badRequest("Invalid request payload")
    }
    const keys: string[] = []
    const values: string[] = []
    for (const it of items) {
      let fs: Field[] = []
      try {
        fs = fields(it)
      } catch (e) {
        return badRequest("Invalid request payload")
      }
      const model = (rawStr(fs, "model") ?? "").trim()
      const provider = (rawStr(fs, "provider") ?? "").trim()
      if (model === "" || provider === "") return badRequest("model and provider are required for every catalog entry")
      const key = provider + "/" + model
      if (!this.catalogHas(provider, model)) return { status: 404, body: errorJson(`no catalog entry for ${key}; the batch was not applied`, "not_found_error", undefined), contentType: "application/json" }
      const raw = find(fs, "additional_attributes")
      const parts: string[] = []
      if (raw !== undefined && raw !== "null") {
        let attrs: Field[] = []
        try {
          attrs = fields(raw)
        } catch (e) {
          return badRequest("additional_attributes must be an object of strings")
        }
        for (const a of attrs) {
          if (!a.raw.startsWith("\"")) return badRequest("additional_attributes must be an object of strings")
          parts.push(JSON.stringify(a.key) + ":" + a.raw)
        }
      }
      keys.push(key)
      values.push(parts.length === 0 ? "" : jobj(parts))
    }
    // the other workers write the same file: the change is applied to the file as it is now, under its lock
    const lock = lockFile(this.catalogFile())
    if (!lock.ok) return { status: 503, body: errorJson("the catalog file is locked by another process; retry", "api_error", undefined), contentType: "application/json" }
    this.loadCatalogAttrs()
    for (let i = 0; i < keys.length; i++) {
      if (values[i]! === "") this.catalogAttrs.delete(keys[i]!)
      else this.catalogAttrs.set(keys[i]!, values[i]!)
    }
    try {
      const pairs: string[] = []
      for (const k of this.catalogAttrs.keys()) pairs.push(jkv(k, this.catalogAttrs.get(k)!))
      writeFileAtomic(this.catalogFile(), jobj(pairs) + "\n")
    } catch (e) {
      unlockFile(lock)
      return { status: 500, body: errorJson(`could not save the catalog: ${e.message}`, "api_error", undefined), contentType: "application/json" }
    }
    unlockFile(lock)
    return { status: 204, body: "", contentType: "application/json" }
  }

  private catalogFile(): string {
    return this.store.path + ".catalog.json"
  }

  // Whether the price catalog has the model for the provider: keyed "provider/model", or bare
  // (catalogView lists the rows of the first provider that way).
  private catalogHas(provider: string, model: string): bool {
    const rows = this.engine.pricing.catalog.rows
    if (rows.get(provider + "/" + model) !== undefined) return true
    const bare = rows.get(model)
    return bare !== undefined && bare.provider === provider
  }

  // The catalog attributes saved beside the config file, read at startup and again before each change.
  private loadCatalogAttrs(): void {
    const path = this.catalogFile()
    if (!existsSync(path)) return
    try {
      const fs = fields(readFileSync(path, "utf8"))
      this.catalogAttrs = new Map()
      for (const f of fs) this.catalogAttrs.set(f.key, f.raw)
    } catch (e) {
      console.error(`raiju: could not read ${path}: ${e.message}`)
    }
  }

  // ---- circuit breaker and vault ----

  // POST /api/vault/flush-cache: drops the cached Vault values, so the next reference fetches them again.
  vaultFlush(): Reply {
    const v = this.store.cfg.secrets?.vault
    if (v === undefined) return badRequest("vault is not enabled")
    const n = flushVaultCache(v.address)
    return okJson(JSON.stringify({ message: "vault cache flushed", entries: n }))
  }

  // /api/circuit-breaker/policies (GET, POST) and /api/circuit-breaker/policies/{name} (PUT, DELETE).
  // Writes go to the config (circuit_breaker_policies) and are saved, so they survive a restart and
  // reach every worker through onChange; the live breakers are updated at once as well.
  circuitPoliciesRoute(method: string, path: string, body: string): Reply {
    const h = this.engine.health
    const rest = path.slice("/api/circuit-breaker/policies".byteLength)
    const one = rest.startsWith("/") ? rest.slice(1) : ""
    if (rest !== "" && one === "") return { status: 404, body: errorJson("no such route", "invalid_request_error", undefined), contentType: "application/json" }
    const cur: CircuitPolicyConfig[] = this.store.cfg.circuit_breaker_policies ?? []
    if (one === "") {
      if (method === "GET") {
        const rows: string[] = []
        for (const p of h.policyList()) rows.push(policyView(p))
        return okJson(`{"policies":[${rows.join(",")}]}`)
      }
      if (method !== "POST") return { status: 405, body: errorJson("use GET or POST", "invalid_request_error", undefined), contentType: "application/json" }
      const pr = parsePolicy(body, "")
      if (!pr.ok) return badRequest(pr.err)
      if (h.policyFind(pr.p.name) !== undefined) return { status: 409, body: errorJson(`a policy named ${pr.p.name} already exists`, "invalid_request_error", undefined), contentType: "application/json" }
      const saved = this.savePolicies(cur.concat([policyConfigOf(pr.p)]))
      if (saved !== undefined) return saved
      h.policyAdd(pr.p)
      return { status: 201, body: policyView(pr.p), contentType: "application/json" }
    }
    if (method === "PUT") {
      const pr = parsePolicy(body, one)
      if (!pr.ok) return badRequest(pr.err)
      const at = policyAt(cur, one)
      if (at < 0) return { status: 404, body: errorJson(`no policy named ${one}`, "not_found_error", undefined), contentType: "application/json" }
      const next: CircuitPolicyConfig[] = []
      for (let i = 0; i < cur.length; i++) next.push(i === at ? policyConfigOf(pr.p) : cur[i]!)
      const saved = this.savePolicies(next)
      if (saved !== undefined) return saved
      h.policyReplace(one, pr.p)
      return okJson(policyView(pr.p))
    }
    if (method === "DELETE") {
      const at = policyAt(cur, one)
      if (at < 0) return { status: 404, body: errorJson(`no policy named ${one}`, "not_found_error", undefined), contentType: "application/json" }
      const next: CircuitPolicyConfig[] = []
      for (const c of cur) {
        if (c.name !== one) next.push(c)
      }
      const saved = this.savePolicies(next)
      if (saved !== undefined) return saved
      h.policyDelete(one)
      return okJson(JSON.stringify({ message: `policy ${one} deleted` }))
    }
    return { status: 405, body: errorJson("use PUT or DELETE", "invalid_request_error", undefined), contentType: "application/json" }
  }

  // Saves the policy list to the config. A reply to send back when the save fails.
  private savePolicies(list: CircuitPolicyConfig[]): Reply | undefined {
    const r = this.store.setCircuitPolicies(list)
    if (r.kind === "error") return { status: r.status, body: errorJson(r.message, "api_error", undefined), contentType: "application/json" }
    return undefined
  }

  // ---- /api/session/*: login, logout and the auth state ----

  // Open routes (they run before the gate, since login is how a caller gets through it). Login
  // checks a user's password and issues a UI session token, the kind SSO sign-in issues; the token
  // goes in the body, where Bifrost sets a cookie. Logout drops a session token.
  async sessionRoute(req: Request, path: string): Promise<Response> {
    const m = req.method
    const auth = req.headers.get("authorization") ?? ""
    const bearer = auth.startsWith("Bearer ") ? auth.slice(7) : ""
    const now = Date.now()
    // a short-lived, single-use ticket for the /ws socket, which cannot send an Authorization header
    if (path === "/api/session/ws-ticket") {
      if (m !== "POST") return json(405, errorJson("use POST", "invalid_request_error", undefined))
      // the socket reads the logs, so the ticket needs the read permission on them (a GET for the gate)
      const hs: Record<string, string> = snapshot(req.headers)
      const g = this.gate(new Request(req.url, { method: "GET", headers: hs }), "/api/logs")
      if (g.kind === "deny") return g.res
      try {
        return json(200, JSON.stringify({ ticket: try this.wsTickets.issue(g.actor, now) }))
      } catch (e) {
        return json(500, errorJson("failed to issue WebSocket ticket", "api_error", undefined))
      }
    }
    // POST /api/session/setup: while no admin exists, the operator's setup token (X-Bifrost-Setup-Token) is
    // traded for a setup session cookie, which stands in for the token on POST /api/users (see users). Once an
    // admin exists the setup lock is not active and the answer is 409, as Bifrost's.
    if (path === "/api/session/setup") {
      if (m !== "POST") return json(405, errorJson("use POST", "invalid_request_error", undefined))
      if (this.authOn) return json(409, errorJson("the setup lock is not active", "invalid_request_error", undefined))
      const token = this.setupToken()
      const given = req.headers.get("x-bifrost-setup-token") ?? ""
      // guessing the token is throttled per client address, as password sign-ins are
      const ipKeys: string[] = clientIp(req) === "" ? [] : [addressKey(clientIp(req))]
      const wait = signInGuard().retryAfter(ipKeys, Date.now())
      if (wait > 0) return throttled(wait)
      if (!sameSecret(given, token)) {
        signInGuard().fail(ipKeys, Date.now())
        return json(403, errorJson("invalid setup token", "invalid_request_error", undefined))
      }
      try {
        const s = try issueSetupSession(token, now)
        const secure = req.url.startsWith("https:") || (req.headers.get("x-forwarded-proto") ?? "") === "https"
        const hs: Record<string, string> = new Map()
        hs.set("content-type", "application/json")
        hs.set("set-cookie", setupCookie(s.value, secure))
        return new Response(JSON.stringify({ expires_at: isoMs(s.expires) }), { status: 200, headers: hs })
      } catch (e) {
        return json(500, errorJson("failed to start setup session", "api_error", undefined))
      }
    }
    if (path === "/api/session/is-auth-enabled") {
      if (m !== "GET") return json(405, errorJson("use GET", "invalid_request_error", undefined))
      const valid = bearer !== "" && this.liveSession(bearer) !== undefined
      const enforced = this.store.cfg.client?.enforce_auth_on_inference ?? false
      return json(200, JSON.stringify({ is_auth_enabled: this.authOn, has_valid_token: valid, auth_type: this.authOn ? "basic" : "none", inference_auth_enforced: enforced, setup_required: !this.authOn, setup_token_configured: this.setupToken() !== "" }))
    }
    if (path === "/api/session/login") {
      if (m !== "POST") return json(405, errorJson("use POST", "invalid_request_error", undefined))
      if (!this.authOn) return json(403, errorJson("Authentication is not enabled", "invalid_request_error", undefined))
      let who: { username?: string, password?: string } = {}
      try {
        who = JSON.parse(await req.text()) as { username?: string, password?: string }
      } catch (e) {
        return json(400, errorJson("Invalid request payload", "invalid_request_error", undefined))
      }
      const hs: Map<string, string> = new Map()
      hs.set("authorization", "Basic " + b64.encode(utf8((who?.username ?? "") + ":" + (who?.password ?? ""))))
      hs.set(CLIENT_IP_HEADER, clientIp(req))
      const id = authenticate(this.rbac, hs)
      // audited without the body, which holds the password
      if (id.kind === "denied" && id.retry_after !== undefined) {
        this.recordChange("unauthenticated", req, path, 429, "")
        return throttled(id.retry_after ?? 1)
      }
      if (id.kind !== "user") {
        this.recordChange("unauthenticated", req, path, 401, "")
        return json(401, errorJson("invalid username or password", "invalid_request_error", undefined))
      }
      this.applyUpgrades()
      this.recordChange(id.name, req, path, 200, "")
      let token = ""
      try {
        token = this.sessions.create(id.name, id.role, now)
      } catch (e) {
        return json(503, errorJson(`could not create a session: ${e.message}`, "api_error", undefined))
      }
      return json(200, JSON.stringify({ message: "Login successful", token: token, username: id.name, role: id.role, expires_in: this.sessions.ttlSeconds }))
    }
    if (path === "/api/session/logout") {
      if (m !== "POST") return json(405, errorJson("use POST", "invalid_request_error", undefined))
      try {
        if (bearer !== "") this.sessions.delete(bearer)
      } catch (e) {
        return json(503, errorJson(`could not end the session: ${e.message}`, "api_error", undefined))
      }
      return json(200, JSON.stringify({ message: "Logged out successfully" }))
    }
    return json(404, errorJson(`no route ${path}`, "invalid_request_error", undefined))
  }

  // ---- agent sign-in for the CLI (agentsignin.tov) ----

  // The governance name of a single sign-on identity: the user governance lists under its subject or email, else the
  // email, else the subject.
  ssoUser(sub: string, email: string | undefined): string {
    const names = ssoNames(sub, email)
    for (const u of this.rbac.users) {
      if (names.includes(u.name) || names.includes((u.email ?? "").toLowerCase())) return u.name
    }
    const e = email ?? ""
    return e !== "" ? e : sub
  }

  // The user an agent access token (Bearer ck-bf-agent-...) stands for, while it lives and its user is not disabled.
  agentUserOf(h: Hdrs): AgentUser | undefined {
    const auth = h.get("authorization") ?? ""
    if (!auth.startsWith("Bearer " + AGENT_TOKEN_PREFIX)) return undefined
    const who = agentSignIn().identity(auth.slice(7).trim(), Date.now())
    if (who === undefined) return undefined
    if (disabledNamed(this.rbac, [who.user, who.email.toLowerCase()])) return undefined
    return who
  }

  // The active, unexpired keys assigned to a user, in config order; the first is the user's default (governance.tov
  // defaultKey picks the same one).
  assignedKeys(user: string): VirtualKeyConfig[] {
    const out: VirtualKeyConfig[] = []
    for (const vk of this.store.cfg.governance?.virtual_keys ?? []) {
      if (vk.user_id === user && vk.is_active !== false && !this.engine.gov.expired(vk)) out.push(vk)
    }
    return out
  }

  // GET /api/agent/auth/status, GET and POST /api/agent/auth/authorize, POST /api/agent/auth/token, /refresh and /logout,
  // and the signed-in user's GET /api/agent/virtual-keys and /api/agent/usage-summary (the Bifrost CLI's Enterprise agent
  // routes). These come before the management gate: the sign-in routes are open, the others take the agent token.
  async agentRoute(req: Request, path: string): Promise<Response> {
    const m = req.method
    const now = Date.now()
    const si = agentSignIn()
    const signInUsers = this.rbac.users.filter((u) => (u.password_hash !== undefined || u.password_sha256 !== undefined) && u.disabled !== true).length
    if (path === "/api/agent/auth/status") {
      if (m !== "GET") return json(405, errorJson("use GET", "invalid_request_error", undefined))
      return json(200, JSON.stringify({ idp_configured: signInUsers > 0 || this.oidcCfg !== undefined, virtual_key_auth_enabled: this.engine.gov.enforce }))
    }
    if (path === "/api/agent/auth/authorize") {
      const u = URL.parse(req.url)
      let sp = u === undefined ? new URLSearchParams("") : u.searchParams
      let form = new URLSearchParams("")
      if (m === "POST") {
        form = new URLSearchParams(await req.text())
        sp = form
      } else if (m !== "GET") return json(405, errorJson("use GET or POST", "invalid_request_error", undefined))
      const params: Map<string, string> = new Map()
      for (const k of ["client_id", "redirect_uri", "state", "code_challenge", "code_challenge_method"]) params.set(k, sp.get(k) ?? "")
      const problem = authorizeProblem(params.get("client_id")!, params.get("redirect_uri")!, params.get("state")!, params.get("code_challenge")!, params.get("code_challenge_method")!)
      if (problem !== "") return html(400, `<!doctype html><meta charset="utf-8"><title>Sign-in refused</title><p>This sign-in request cannot be used: ${problem.replaceAll("<", "&lt;")}.</p>`)
      const qs = new URLSearchParams("")
      for (const k of params.keys()) qs.set(k, params.get(k)!)
      const back = "/api/agent/auth/authorize?" + qs.toString()
      const sso = this.oidcCfg !== undefined
      if (m === "GET") return html(200, signInPage(params, "", sso, back))
      // a dashboard session already in the browser (single sign-on), or the user's name and password
      let who: AgentUser | undefined = undefined
      const sess = form.get("session") ?? ""
      if (sess !== "") {
        const s = this.liveSession(sess)
        if (s !== undefined) who = { user: this.ssoUser(s.sub, s.email), role: s.role, email: s.email ?? "" }
      } else {
        const hs: Map<string, string> = new Map()
        hs.set("authorization", "Basic " + b64.encode(utf8((form.get("username") ?? "") + ":" + (form.get("password") ?? ""))))
        hs.set(CLIENT_IP_HEADER, clientIp(req))
        const id = authenticate(this.rbac, hs)
        if (id.kind === "user") {
          const uc = this.rbac.users.find((x) => x.name === id.name)
          who = { user: id.name, role: id.role, email: uc?.email ?? "" }
          this.applyUpgrades()
        } else if (id.kind === "denied" && id.retry_after !== undefined) {
          const secs = id.retry_after ?? 1
          this.recordChange("unauthenticated", req, path, 429, "")
          const th: Record<string, string> = new Map()
          th.set("content-type", "text/html; charset=utf-8")
          th.set("cache-control", "no-store")
          th.set("retry-after", `${secs}`)
          return new Response(signInPage(params, `Too many failed sign-in attempts. Try again in ${secs} seconds.`, sso, back), { status: 429, headers: th })
        }
      }
      if (who === undefined) {
        this.recordChange("unauthenticated", req, path, 401, "")
        return html(401, signInPage(params, sess !== "" ? "Your dashboard session has expired; sign in again." : "Invalid username or password.", sso, back))
      }
      let code = ""
      try {
        code = try si.issueCode(who, params.get("code_challenge")!, params.get("redirect_uri")!, now)
      } catch (e) {
        return html(500, "<p>Could not start the session.</p>")
      }
      this.recordChange(who.user, req, path, 302, "")
      const lh: Record<string, string> = new Map()
      lh.set("location", callbackUrl(params.get("redirect_uri")!, code, params.get("state")!))
      lh.set("cache-control", "no-store")
      return new Response(undefined, { status: 302, headers: lh })
    }
    const oauthError = (status: int, error: string, message: string): Response => json(status, JSON.stringify({ error: error, error_description: message, message: message }))
    if (path === "/api/agent/auth/token" || path === "/api/agent/auth/refresh") {
      if (m !== "POST") return json(405, errorJson("use POST", "invalid_request_error", undefined))
      let body: { code?: string, code_verifier?: string, redirect_uri?: string, refresh_token?: string } = {}
      try {
        body = JSON.parse(await req.text()) as { code?: string, code_verifier?: string, redirect_uri?: string, refresh_token?: string }
      } catch (e) {
        return oauthError(400, "invalid_request", "the body must be a JSON object")
      }
      let r: Exchange = { kind: "error", status: 400, error: "invalid_request", message: "" }
      try {
        if (path === "/api/agent/auth/token") {
          if ((body.code ?? "") === "") return oauthError(400, "invalid_request", "code is required")
          r = try si.exchange(body.code ?? "", body.code_verifier ?? "", body.redirect_uri ?? "", now)
        } else {
          if ((body.refresh_token ?? "") === "") return oauthError(400, "invalid_request", "refresh_token is required")
          r = try si.rotate(body.refresh_token ?? "", now)
        }
      } catch (e) {
        return oauthError(500, "server_error", "could not issue a token")
      }
      if (r.kind === "error") return oauthError(r.status, r.error, r.message)
      // a user disabled since the code was issued gets no token
      if (disabledNamed(this.rbac, [r.issued.who.user, r.issued.who.email.toLowerCase()])) {
        try {
          si.revokeUser(r.issued.who.user)
        } catch (e) {
          return oauthError(503, "temporarily_unavailable", "the account is disabled; its tokens could not be ended yet, retry")
        }
        return oauthError(401, "invalid_grant", "the account is disabled")
      }
      const keys = this.assignedKeys(r.issued.who.user)
      return json(200, tokenResponseJson(r.issued, keys.length > 0 ? keys[0]!.id : ""))
    }
    if (path === "/api/agent/auth/logout") {
      if (m !== "POST") return json(405, errorJson("use POST", "invalid_request_error", undefined))
      const auth = req.headers.get("authorization") ?? ""
      try {
        if (auth.startsWith("Bearer ")) si.revoke(auth.slice(7).trim())
      } catch (e) {
        return json(503, errorJson(`could not end the session: ${e.message}`, "api_error", undefined))
      }
      return json(200, JSON.stringify({ message: "Logged out successfully" }))
    }
    if (path === "/api/agent/virtual-keys" || path === "/api/agent/usage-summary") {
      if (m !== "GET") return json(405, errorJson("use GET", "invalid_request_error", undefined))
      const who = this.agentUserOf(snapshot(req.headers))
      if (who === undefined) {
        const rh: Record<string, string> = new Map()
        rh.set("content-type", "application/json")
        rh.set("x-bf-agent-auth", "rejected")
        return new Response(errorJson("the agent token is missing, expired or revoked; sign in again", "authentication_error", undefined), { status: 401, headers: rh })
      }
      const keys = this.assignedKeys(who.user)
      const usage = this.engine.gov.budgetUsage()
      const budgetDefs = this.store.cfg.governance?.budgets ?? []
      const budgetJson = (id: string, source: string): string => {
        const u = usage.find((x) => x.id === id)
        const base = id.includes("@") ? id.slice(0, id.indexOf("@")) : id
        const def = budgetDefs.find((b) => b.id === base)
        const used = u === undefined ? 0.0 : u.used
        const limit = u === undefined ? (def?.max_limit ?? 0.0) : u.limit
        const avail = limit - used > 0.0 ? limit - used : 0.0
        return `{"id":${JSON.stringify(id)},"scope":${JSON.stringify(source)},"reset_duration":${JSON.stringify(def?.reset_duration ?? "")},"used":${used},"limit":${limit},"available":${avail}}`
      }
      if (path === "/api/agent/virtual-keys") {
        const rows: string[] = []
        for (const vk of keys) {
          const provs: string[] = []
          const bids: string[] = []
          if ((vk.budget_id ?? "") !== "") bids.push(vk.budget_id!)
          for (const pc of vk.provider_configs ?? []) {
            if (!provs.includes(pc.provider)) provs.push(pc.provider)
            if ((pc.budget_id ?? "") !== "" && !bids.includes(pc.budget_id!)) bids.push(pc.budget_id!)
          }
          let lim = 0.0
          let used = 0.0
          const bs: string[] = []
          for (const id of bids) {
            const u = usage.find((x) => x.id === id)
            const def = budgetDefs.find((b) => b.id === id)
            const l = u === undefined ? (def?.max_limit ?? 0.0) : u.limit
            const c = u === undefined ? 0.0 : u.used
            lim += l
            used += c
            bs.push(`{"id":${JSON.stringify(id)},"budget_limit":${l},"budget_consumed":${c},"budget_available":${l - c > 0.0 ? l - c : 0.0},"reset_duration":${JSON.stringify(def?.reset_duration ?? "")}}`)
          }
          rows.push(`{"id":${JSON.stringify(vk.id)},"name":${JSON.stringify(vk.name ?? vk.id)},"description":${JSON.stringify(vk.description ?? "")},"is_active":true,"providers":${JSON.stringify(provs)},"budgets":[${bs.join(",")}],"budget_limit":${lim},"budget_consumed":${used},"budget_available":${lim - used > 0.0 ? lim - used : 0.0}}`)
        }
        return json(200, `{"virtual_keys":[${rows.join(",")}],"selected_virtual_key_id":${JSON.stringify(keys.length > 0 ? keys[0]!.id : "")},"forced_virtual_key_id":""}`)
      }
      // the budgets and rate limits over the user's assigned keys and the user's own (@user) budgets
      const bids: string[] = []
      const rids: string[] = []
      for (const vk of keys) {
        if ((vk.budget_id ?? "") !== "" && !bids.includes(vk.budget_id!)) bids.push(vk.budget_id!)
        if ((vk.rate_limit_id ?? "") !== "" && !rids.includes(vk.rate_limit_id!)) rids.push(vk.rate_limit_id!)
        for (const pc of vk.provider_configs ?? []) {
          if ((pc.budget_id ?? "") !== "" && !bids.includes(pc.budget_id!)) bids.push(pc.budget_id!)
          if ((pc.rate_limit_id ?? "") !== "" && !rids.includes(pc.rate_limit_id!)) rids.push(pc.rate_limit_id!)
        }
      }
      const budgets: string[] = []
      let tl = 0.0
      let tu = 0.0
      for (const id of bids) budgets.push(budgetJson(id, "virtual_key"))
      for (const u of usage) {
        if (u.id.endsWith("@user/" + who.user)) budgets.push(budgetJson(u.id, "user"))
      }
      for (const u of usage) {
        if (bids.includes(u.id) || u.id.endsWith("@user/" + who.user)) {
          tl += u.limit
          tu += u.used
        }
      }
      const rl = this.engine.gov.rateLimitUsage(now)
      const rates: string[] = []
      const rdefs = this.store.cfg.governance?.rate_limits ?? []
      for (const id of rids) {
        const def = rdefs.find((r) => r.id === id)
        const counter = (kind: string, reset: string): string => {
          const e = rl.find((x) => x.id === id && x.kind === kind)
          if (e === undefined) return ""
          const used = Math.floor(e.used)
          const limit = Math.floor(e.limit)
          return `{"used":${used},"limit":${limit},"available":${limit - used > 0 ? limit - used : 0},"reset_duration":${JSON.stringify(reset)}}`
        }
        const tk = counter("token", def?.token_reset_duration ?? "1m")
        const rq = counter("request", def?.request_reset_duration ?? "1m")
        rates.push(`{"id":${JSON.stringify(id)},"scope":"virtual_key"${tk === "" ? "" : `,"tokens":${tk}`}${rq === "" ? "" : `,"requests":${rq}`}}`)
      }
      const avail = tl - tu > 0.0 ? tl - tu : 0.0
      return json(200, `{"budgets":[${budgets.join(",")}],"rate_limits":[${rates.join(",")}],"budget":{"used":${tu},"limit":${tl},"available":${avail}},"top_models":[],"top_apps":[],"generated_at":${JSON.stringify(isoMs(now))},"window":{}}`)
    }
    return json(404, errorJson(`no route ${path}`, "invalid_request_error", undefined))
  }

  // ---- the priced models, the circuit states and the log histogram ----

  // GET /api/models/base (distinct base model names) and /api/models/details (one row per priced
  // model with its prices), from the price datasheet. query filters by a case-insensitive
  // substring; limit (default 20) and offset page the list.
  catalogView(req: Request, path: string): Reply {
    if (req.method !== "GET") return { status: 405, body: errorJson("use GET", "invalid_request_error", undefined), contentType: "application/json" }
    const u = URL.parse(req.url)
    const sp = u === undefined ? new URLSearchParams("") : u.searchParams
    const lim: f64 = parseFloat(sp.get("limit") ?? "20") ?? 20.0
    const off: f64 = parseFloat(sp.get("offset") ?? "0") ?? 0.0
    const limit = lim >= 0 ? Math.floor(lim) : 20
    const offset = off >= 0 ? Math.floor(off) : 0
    const q = (sp.get("query") ?? "").toLowerCase()
    const rows = this.engine.pricing.catalog.rows
    if (path === "/api/models/base") {
      const names: string[] = []
      for (const k of rows.keys()) {
        const b = rows.get(k)!.baseModel
        if (b === "" || names.includes(b) || (q !== "" && !b.toLowerCase().includes(q))) continue
        names.push(b)
      }
      names.sort(byName)
      return { status: 200, body: JSON.stringify({ models: names.slice(offset, offset + limit), total: names.length }), contentType: "application/json" }
    }
    const provider = sp.get("provider") ?? ""
    const out: { name: string, provider: string, input_cost_per_token: f64, output_cost_per_token: f64, cache_read_input_token_cost?: f64, cache_creation_input_token_cost?: f64 }[] = []
    for (const k of rows.keys()) {
      const r = rows.get(k)!
      const pre = r.provider + "/"
      const name = k.startsWith(pre) ? k.slice(pre.byteLength) : k
      if (provider !== "" && r.provider !== provider) continue
      if (q !== "" && !name.toLowerCase().includes(q)) continue
      out.push({ name: name, provider: r.provider, input_cost_per_token: r.price.input, output_cost_per_token: r.price.output, cache_read_input_token_cost: r.price.cacheRead, cache_creation_input_token_cost: r.price.cacheWrite })
    }
    out.sort((a, b) => byName(a.provider + "/" + a.name, b.provider + "/" + b.name))
    return { status: 200, body: JSON.stringify({ models: out.slice(offset, offset + limit), total: out.length }), contentType: "application/json" }
  }

  // GET /api/circuit-breaker/state: the targets whose breaker is open or half-open, keyed by target
  // id (provider#key). Bifrost keys its circuits by policy; Raiju has one breaker per key. Closed
  // circuits are left out, as Bifrost's snapshot leaves them out.
  circuitView(): Reply {
    const parts: string[] = []
    for (const t of this.engine.health.snapshot(Date.now())) {
      if (t.state === "closed") continue
      parts.push(JSON.stringify(t.id) + ":" + JSON.stringify(t.state))
    }
    return { status: 200, body: `{"circuits":{${parts.join(",")}}}`, contentType: "application/json" }
  }

  // GET /api/adaptive-routing/held-keys: the keys and models held out of rotation by a provider's refusal
  // (holds.tov): the failure class, the provider's own reason, when each was held, when it is next checked,
  // its state (held, checking or due) and its rung on the wait ladder.
  adaptiveHeldKeys(): Reply {
    const rows: string[] = []
    for (const r of this.engine.health.holds.list(Date.now())) {
      const h = r.h
      rows.push(JSON.stringify({ target: h.target, provider: h.provider, key_id: h.keyId, model: h.model, state: r.state, failure_class: h.cls, reason: h.reason, held_since: rfc3339Of(h.heldAt), next_check_at: rfc3339Of(h.nextCheck), wait_seconds: Math.round(h.waitMs / 1000), rung: h.rung }))
    }
    return { status: 200, body: `{"held_keys":[${rows.join(",")}],"total":${rows.length}}`, contentType: "application/json" }
  }

  // GET /api/adaptive-routing/incidents: the incidents still open (a hold, or a circuit a run of failures
  // opened) and the policy circuits open now. Resolved incidents are in the history route.
  adaptiveIncidents(): Reply {
    const now = Date.now()
    const rows: string[] = []
    for (const inc of this.engine.health.holds.allIncidents()) {
      if (inc.resolvedAt > 0) continue
      rows.push(JSON.stringify(incidentRow(inc, now)))
    }
    for (const c of this.engine.health.openCircuits(now)) {
      if (c.id.indexOf("#") >= 0) continue
      const status = c.state === "half_open" ? "recovering" : "attention"
      rows.push(JSON.stringify({ target: c.id, kind: "policy", status: status, opened_at: rfc3339Of(c.openedAt), next_check_at: rfc3339Of(c.nextCheck) }))
    }
    return { status: 200, body: `{"incidents":[${rows.join(",")}],"total":${rows.length}}`, contentType: "application/json" }
  }

  // GET /api/adaptive-routing/history/issues: the incidents that were open at some point in a window (from,
  // to: RFC 3339, or unix seconds; the window defaults to all of history until now). statuses (attention,
  // recovering, resolved) filters them; sort is priority (attention first, then newest), newest, oldest,
  // longest or shortest. limit (default 25, at most 100) and offset page the result; with neither, every
  // match is returned. matched_summary covers every match, not the page.
  adaptiveHistory(req: Request): Reply {
    const u = URL.parse(req.url)
    const params = u === undefined ? new URLSearchParams("") : u.searchParams
    const now = Date.now()
    const from = historyBound(params.get("from"), 0.0)
    const to = historyBound(params.get("to"), now)
    if (from === undefined || to === undefined) return badRequest("from and to must be RFC 3339 times or unix seconds")
    const sort = params.get("sort") ?? "priority"
    if (!["priority", "newest", "oldest", "longest", "shortest"].includes(sort)) return badRequest("sort must be priority, newest, oldest, longest or shortest")
    const statuses = (params.get("statuses") ?? "").split(",").filter((s: string) => s !== "")
    for (const s of statuses) {
      if (!["attention", "recovering", "resolved"].includes(s)) return badRequest("statuses takes attention, recovering or resolved")
    }
    const limitRaw = params.get("limit")
    const offsetRaw = params.get("offset")
    const paged = limitRaw !== undefined || offsetRaw !== undefined
    const limit = limitRaw === undefined ? 25 : Math.min(100, Math.max(1, parseInt(limitRaw) ?? 25))
    const offset = offsetRaw === undefined ? 0 : parseInt(offsetRaw) ?? 0
    if (offset < 0) return badRequest("offset must not be negative")
    const matched: { inc: Incident, status: string, dur: f64 }[] = []
    for (const inc of this.engine.health.holds.allIncidents()) {
      const end = inc.resolvedAt > 0 ? inc.resolvedAt : now
      if (end < from || inc.openedAt > to) continue
      const st = incidentStatus(inc)
      if (statuses.length > 0 && !statuses.includes(st)) continue
      matched.push({ inc: inc, status: st, dur: end - inc.openedAt })
    }
    matched.sort((a, b) => {
      if (sort === "newest") return b.inc.openedAt - a.inc.openedAt
      if (sort === "oldest") return a.inc.openedAt - b.inc.openedAt
      if (sort === "longest") return b.dur - a.dur
      if (sort === "shortest") return a.dur - b.dur
      const pa = a.status === "resolved" ? 1 : 0
      const pb = b.status === "resolved" ? 1 : 0
      if (pa !== pb) return pa - pb
      return b.inc.openedAt - a.inc.openedAt
    })
    // the summary: counts by status, the median time to resolve, and the longest open incident
    const resolved: number[] = []
    let attention = 0
    let recovering = 0
    let longestOngoing = 0
    for (const m of matched) {
      if (m.status === "resolved") resolved.push(m.dur)
      else {
        if (m.status === "attention") attention += 1
        else recovering += 1
        longestOngoing = Math.max(longestOngoing, m.dur)
      }
    }
    resolved.sort((a, b) => a - b)
    const median = resolved.length === 0 ? "null" : "" + Math.round(resolved[Math.floor(resolved.length / 2)]! / 1000)
    const page = paged ? matched.slice(offset, offset + limit) : matched
    const issues: string[] = []
    for (const m of page) issues.push(JSON.stringify(incidentRow(m.inc, now)))
    const summary = `{"attention":${attention},"recovering":${recovering},"resolved":${resolved.length},"median_resolve_seconds":${median},"longest_ongoing_seconds":${Math.round(longestOngoing / 1000)}}`
    return okJson(`{"issues":[${issues.join(",")}],"total":${matched.length},"offset":${offset},"matched_summary":${summary}}`)
  }

  // POST /api/adaptive-routing/conditions/clear: releases the held keys named by {"keys": [...]} (target
  // ids as the held-keys view lists them), or every circuit with no body or {"all": true}. count is how
  // many circuits were closed.
  adaptiveRelease(body: string): Reply {
    const h = this.engine.health
    let all = body.trim() === ""
    let ids: string[] = []
    if (!all) {
      try {
        const req = JSON.parse(body) as { keys?: string[], all?: bool }
        if (req.all === true) all = true
        ids = req.keys ?? []
      } catch (e) {
        return badRequest("the body must be a JSON object")
      }
    }
    const now = Date.now()
    if (all) {
      // every hold, and every circuit that is open now
      let n = h.holds.clearAll(now)
      for (const c of h.openCircuits(now)) {
        if (h.reset(c.id)) {
          h.holds.noteClose(c.id, now)
          n += 1
        }
      }
      return okJson(JSON.stringify({ message: "held keys released", count: n }))
    }
    // a target is a key ("provider#key") or one of its models ("provider#key@model"), and counts once
    const open: string[] = []
    for (const c of h.openCircuits(now)) open.push(c.id)
    let n = 0
    for (const id of ids) {
      let hit = h.holds.clear(id, now)
      if (open.includes(id) && h.reset(id)) {
        h.holds.noteClose(id, now)
        hit = true
      }
      if (hit) n += 1
    }
    return okJson(JSON.stringify({ message: "held keys released", count: n }))
  }

  // POST /api/circuit-breaker/reset: closes one circuit now, by its id (a target id as the state
  // view lists it, or a policy name), or every circuit with {"all": true}. The cooldown is dropped.
  circuitReset(body: string): Reply {
    let fs: Field[] = []
    try {
      fs = try fields(body)
    } catch (e) {
      return badRequest("the body must be a JSON object")
    }
    const h = this.engine.health
    if (rawBool(fs, "all") === true) return okJson(JSON.stringify({ message: "all circuits reset", circuits: h.resetAll() }))
    const id = rawStr(fs, "id") ?? ""
    if (id === "") return badRequest("reset needs an id (a target id or a policy name), or all: true")
    if (!h.reset(id)) return { status: 404, body: errorJson(`no circuit named ${id}`, "not_found_error", undefined), contentType: "application/json" }
    return okJson(JSON.stringify({ message: `circuit ${id} reset` }))
  }

  // GET /api/logs/histogram: request counts per time bucket, in Bifrost's shape. start_time and
  // end_time are epoch milliseconds (the log store's own clock); the default is the last 24 hours.
  // Buckets with no requests are included. success is 2xx, cancelled is 499, error is the rest.
  logsHistogram(req: Request): Reply {
    return this.logsRoute(req, "/api/logs/histogram", "")
  }

  // The request-log analytics (Bifrost's /api/logs/histogram*, rankings, dashboard, filterdata,
  // dropped) and the MCP logs (/api/mcp-logs*). Every reply is JSON. Dimensions Raiju does not record
  // (user, app, user agent) are refused with a 400.
  logsRoute(req: Request, path: string, body: string, scope?: DataScope, reveal?: bool): Reply {
    const m = req.method
    const store = this.engine.logStore
    const sc: DataScope = scope ?? allScope()
    const rv = reveal === true
    if (path.startsWith("/api/mcp-logs")) return this.mcpLogsRoute(req, path, body, store, sc, rv)
    const u = URL.parse(req.url)
    const sp = u === undefined ? new URLSearchParams("") : u.searchParams
    const now = Date.now()
    // the User-Agent mappings are configuration: they work whether or not the request log is on
    if (path === "/api/logs/user-agent-mappings" || path.startsWith("/api/logs/user-agent-mappings/")) return this.userAgentRoute(m, path, body)
    if (store === undefined) return { status: 404, body: errorJson("request logs are off; enable logs_store in the config", "invalid_request_error", undefined), contentType: "application/json" }
    if (path === "/api/logs" && m === "DELETE") return this.deleteLogs(body, store, sc)
    if (path === "/api/logs/recalculate-cost" && m === "POST") return this.recalculateCost(body, store, sc)
    if (path === "/api/logs/recalculate-cost/status" && m === "GET") return this.recalcStatus(sp)
    if (path === "/api/logs/recalculate-cost/cancel" && m === "POST") return this.cancelRecalc(sp)
    if (m !== "GET") return { status: 405, body: errorJson("use GET", "invalid_request_error", undefined), contentType: "application/json" }
    if (path === "/api/logs") return this.logList(sp, store, sc)
    if (path === "/api/logs/stats") return this.logStats(sp, store, sc)
    const sub = path.slice("/api/logs/".byteLength)
    if (sub.startsWith("sessions/")) return this.sessionLogs(sub.slice("sessions/".byteLength), sp, store, sc)
    if (path === "/api/logs/dropped") return okJson(`{"dropped_requests":${store.dropped}}`)
    if (path === "/api/logs/filterdata") return okJson(this.logFilterData(store, sc))
    // GET /api/logs/{id}: one log (the names of the other /api/logs routes are not ids)
    const seg = path.slice("/api/logs/".byteLength)
    if (seg !== "" && !seg.includes("/") && !LOG_ROUTE_NAMES.includes(seg)) return this.logById(seg, store, sc, rv)
    const end = epochParam(sp.get("end_time") ?? undefined, now)
    const start = this.windowStart(sp, end)
    if (start >= end) return badRequest("start_time must be before end_time")
    const g = gridOf(start, end)
    if (g.n > 10000) return badRequest("too many buckets; narrow the time range")
    const es = selectAll(this.readView(store, sc, start - 1.0, end), filterFrom(sp, "llm", start, end))
    // the same span just before the window, for the rankings' trends
    const pf = filterFrom(sp, "llm", start - (end - start), start)
    const prev = selectAll(this.readView(store, sc, pf.since - 1.0, start), pf)
    const dim = sp.get("dimension") ?? ""
    const ranked = this.rankLimit(sp)
    if (ranked < 0) return badRequest("Invalid limit. Expected a positive integer, or all=true for no limit")
    if (path === "/api/logs/histogram") return okJson(requestsView(es, g))
    if (path === "/api/logs/histogram/tokens") return okJson(tokensView(es, g))
    if (path === "/api/logs/histogram/cost") return okJson(costView(es, g))
    if (path === "/api/logs/histogram/models") return okJson(modelsView(es, g))
    if (path === "/api/logs/histogram/latency") return okJson(latencyView(es, g))
    if (path === "/api/logs/histogram/cost/by-provider") return okJson(providerView(es, g, "cost"))
    if (path === "/api/logs/histogram/tokens/by-provider") return okJson(providerView(es, g, "tokens"))
    if (path === "/api/logs/histogram/latency/by-provider") return okJson(providerView(es, g, "latency"))
    if (path === "/api/logs/histogram/throughput") return okJson(throughputView(es, g))
    if (path === "/api/logs/histogram/throughput/by-provider") return okJson(providerView(es, g, "throughput"))
    if (path === "/api/logs/histogram/cost/by-dimension" || path === "/api/logs/histogram/tokens/by-dimension" || path === "/api/logs/histogram/latency/by-dimension") {
      const bad = this.dimensionError(dim, true)
      if (bad !== "") return badRequest(bad)
      const what = path.includes("/cost/") ? "cost" : path.includes("/tokens/") ? "tokens" : "latency"
      return okJson(dimensionView(es, g, what, histogramDimName(dim), dim))
    }
    if (path === "/api/logs/rankings") return okJson(modelRankingsView(es, prev, ranked))
    if (path === "/api/logs/rankings/users") return okJson(dimensionRankingsView(es, prev, "user", ranked))
    if (path === "/api/logs/rankings/by-dimension") {
      const bad = this.dimensionError(dim, false)
      if (bad !== "") return badRequest(bad)
      return okJson(dimensionRankingsView(es, prev, dim, ranked))
    }
    if (path === "/api/logs/dashboard") return okJson(this.dashboard(store, sp, es, prev, g, start, end, now, sc))
    return { status: 404, body: errorJson(`no route ${path}`, "invalid_request_error", undefined), contentType: "application/json" }
  }

  // The log rows since a time (and up to until) that a data scope may see: this node's, and, during a read that asked
  // the peers (logsRouteAll), theirs too.
  logRows(store: LogStore, sc: DataScope, since: f64, until?: f64): LogEntry[] {
    const local = store.viewSince(since, until)
    if (this.peerRows.length === 0) return scopedEntries(local, sc)
    const extra: LogEntry[] = []
    for (const e of this.peerRows) {
      if (e.ts > since && (until === undefined || e.ts <= until)) extra.push(e)
    }
    return scopedEntries(mergeRows(local, extra), sc)
  }

  // The entries a log read may see: the caller's data scope, without client.hidden_request_types.
  private readView(store: LogStore, sc: DataScope, since: f64, until?: f64): LogEntry[] {
    return withoutHidden(this.logRows(store, sc, since, until), this.store.cfg.client?.hidden_request_types)
  }

  // GET /api/logs: the logs a filter selects, newest first unless sort_by and order say otherwise
  // (Bifrost's getLogs). Raiju's entries and total ride along with Bifrost's logs, pagination and stats.
  private logList(sp: URLSearchParams, store: LogStore, sc: DataScope): Reply {
    const bad = unsupportedFilter(sp)
    if (bad !== "") return badRequest(`the ${bad} filter is not recorded by this gateway`)
    const pg = pageOfQuery(sp, 50, 1000)
    if (pg.error !== "") return badRequest(pg.error)
    let f = listFilter(sp, Date.now())
    this.withAgents(sp, &f, store, sc)
    const es = applyChains(selectAll(this.readView(store, sc, f.since - 1.0, f.until), f), f)
    return okJson(listJson(es, pg.page, es.length > 0 || this.readView(store, sc, 0.0).length > 0))
  }

  // GET /api/logs/stats: the totals of the logs a filter selects (Bifrost's SearchStats).
  private logStats(sp: URLSearchParams, store: LogStore, sc: DataScope): Reply {
    const bad = unsupportedFilter(sp)
    if (bad !== "") return badRequest(`the ${bad} filter is not recorded by this gateway`)
    let f = listFilter(sp, Date.now())
    this.withAgents(sp, &f, store, sc)
    return okJson(statsView(applyChains(selectAll(this.readView(store, sc, f.since - 1.0, f.until), f), f)))
  }

  // GET /api/logs/{id}: one log, with its bodies and raw payloads when the store kept them.
  // reveal: the caller holds Logs:Reveal, so a logs_only row's mapping is added (redaction_mapping).
  // The row is looked up wherever it is: memory, the files (rows beyond max_memory_entries and earlier days), and the
  // rows the peers sent for this read (cross-node reads).
  private logById(id: string, store: LogStore, sc: DataScope, reveal: bool): Reply {
    const hy = this.hydratedEntry
    let found = hy !== undefined && hy.id === id ? hy : store.findById(id)
    if (found === undefined) {
      for (const e of this.peerRows) {
        if (e.id === id) found = e
      }
    }
    if (found !== undefined && kindOf(found) === "llm" && visibleTo(found, sc) && withoutHidden([found], this.store.cfg.client?.hidden_request_types).length > 0) {
      const e: LogEntry = found
      return okJson(withMapping(detailJson(e), reveal ? this.openedMapping(e) : ""))
    }
    return { status: 404, body: errorJson("log not found", "not_found_error", undefined), contentType: "application/json" }
  }

  // GET /api/logs/sessions/{id} (its logs, oldest first) and /api/logs/sessions/{id}/summary.
  // rest is the path after "sessions/": the session id, or the id and "/summary".
  private sessionLogs(rest: string, sp: URLSearchParams, store: LogStore, sc: DataScope): Reply {
    const summary = rest.endsWith("/summary")
    const raw = summary ? rest.slice(0, rest.byteLength - "/summary".byteLength) : rest
    const sid = pctDecode(raw) ?? ""
    if (sid === "" || sid.includes("/")) return { status: 404, body: errorJson("no such route", "invalid_request_error", undefined), contentType: "application/json" }
    const es = this.readView(store, sc, 0.0)
    if (summary) return okJson(sessionSummaryJson(es, sid))
    const pg = pageOfQuery(sp, 500, 500)
    if (pg.error !== "") return badRequest(pg.error)
    const page: Page = pg.page
    if ((sp.get("order") ?? "") === "") page.order = "asc"
    return okJson(sessionJson(es, sid, page))
  }

  // DELETE /api/logs with {"ids": [...]}: removes the LLM logs among them (Bifrost's deleteLogs). Deleting
  // is for all-data roles, as deleting MCP logs is.
  private deleteLogs(body: string, store: LogStore, sc: DataScope): Reply {
    if (!sc.all) return { status: 403, body: errorJson("the data access scope of this role does not allow deleting logs", "permission_error", undefined), contentType: "application/json" }
    let ids: string[] = []
    try {
      ids = (JSON.parse(body) as { ids?: string[] }).ids ?? []
    } catch (e) {
      return badRequest("Invalid JSON")
    }
    if (ids.length === 0) return badRequest("No log IDs provided")
    const doomed: string[] = []
    const hidden: LogEntry[] = []
    const offloaded: LogEntry[] = []
    // each row wherever it is (memory, or the files beyond max_memory_entries and earlier days)
    for (const id of ids) {
      const e = store.findById(id)
      if (e === undefined || kindOf(e) !== "llm" || doomed.includes(e.id)) continue
      doomed.push(e.id)
      if (e.content_hidden === true) hidden.push(e)
      if (e.has_object === true) offloaded.push(e)
    }
    const removed = store.delete(doomed)
    // a hidden row's content object goes with it (Bifrost's DeleteLogs); a failed delete is only reported
    if (hidden.length > 0) this.deleteHidden(hidden)
    // and so does an offloaded row's payload object (the hybrid store)
    if (offloaded.length > 0) this.deletePayloads(offloaded)
    return okJson(JSON.stringify({ message: "Logs deleted successfully", removed: removed }))
  }

  // Deletes the retained-content objects of deleted rows, in the background: both object names (.json and
  // .json.gz), since compress may have changed since the row was written.
  async deleteHidden(es: LogEntry[]): Promise<void> {
    const q = this.engine.hiddenQueue
    if (q === undefined) return
    for (const e of es) {
      for (const req of hiddenDeletes(q, e.ts, e.id, Date.now())) {
        const dl = deadline(30000)
        try {
          const hs: Record<string, string> = req.headers
          const r = await fetch(req.url, { method: "DELETE", headers: hs, signal: dl.controller.signal })
          await r.text()
          if (r.status >= 300 && r.status !== 404) console.error(`raiju: retained content: delete of ${e.id}: HTTP ${r.status}`)
        } catch (err) {
          console.error(`raiju: retained content: delete of ${e.id}: ${err.message}`)
        }
        dl.finish()
      }
    }
  }

  // POST /api/logs/recalculate-cost: starts a background job that prices again the LLM logs the body's
  // filters select, at the current prices (Bifrost's enqueue). 202 with the job; 409 with the job when one is
  // already in flight, so the caller polls that one.
  private recalculateCost(body: string, store: LogStore, sc: DataScope): Reply {
    let rb: { filters?: RecalcFilters } = {}
    if (body.trim() !== "") {
      try {
        rb = JSON.parse(body) as { filters?: RecalcFilters }
      } catch (e) {
        return badRequest("Invalid JSON")
      }
    }
    const cur = this.recalc
    if (cur !== undefined && cur.inFlight()) return { status: 409, body: recalcJson(cur.snapshot()), contentType: "application/json" }
    // a job another worker runs (its status file is fresh) is the one in flight
    const shared = this.recalcFile()
    if (sharedInFlight(shared, Date.now())) return { status: 409, body: recalcJson(readShared(shared)!), contentType: "application/json" }
    const f = listFilter(recalcQuery(rb.filters), Date.now())
    const pricing = this.engine.pricing
    // a model the current price list does not know is left as it is (unpriceable), not priced at 0
    const job = new CostRecalc(
      (e) => {
        const decision = e.op === "decisions"
        if (pricing.priceFor(e.provider, e.model, decision) === undefined) return undefined
        return decision ? pricing.decisionCost(e.provider, e.model, e.prompt_tokens, e.completion_tokens) : pricing.cost(e.provider, e.model, e.prompt_tokens, e.completion_tokens)
      },
      (costs) => store.recost((e) => costs.get(e.id))
    )
    job.begin(selectAll(scopedView(store, sc, f.since - 1.0), f), Date.now())
    if (shared !== "") job.share(shared)
    this.recalc = job
    job.start()
    return { status: 202, body: recalcJson(job.snapshot()), contentType: "application/json" }
  }

  // The shared status file of the cost recalculation job when workers share state, else "".
  private recalcFile(): string {
    return this.shareDir === "" ? "" : this.shareDir + "/recalc-cost.json"
  }

  // GET /api/logs/recalculate-cost/status: the job with ?id=, else the one in flight, else idle (Bifrost's status).
  // A job this worker does not run is read from the shared status file, so every worker answers for it.
  private recalcStatus(sp: URLSearchParams): Reply {
    const local = this.recalc
    const shared = readShared(this.recalcFile())
    const id = (sp.get("id") ?? "").trim()
    if (id !== "") {
      if (local !== undefined && local.id() === id) return okJson(recalcJson(local.snapshot()))
      if (shared !== undefined && shared.id === id) return okJson(recalcJson(shared))
      return { status: 404, body: errorJson("Job not found", "not_found_error", undefined), contentType: "application/json" }
    }
    if (local !== undefined && local.inFlight()) return okJson(recalcJson(local.snapshot()))
    if (shared !== undefined && sharedInFlight(this.recalcFile(), Date.now())) return okJson(recalcJson(shared))
    return okJson(JSON.stringify({ status: "idle" }))
  }

  // POST /api/logs/recalculate-cost/cancel: stops the job with ?id= (else the one in flight) and answers with its
  // status. Costs already written stay. A job that finished is answered as it is. A job another worker runs is
  // asked to stop through the shared file; it stops before its next slice.
  private cancelRecalc(sp: URLSearchParams): Reply {
    const job = this.recalc
    const id = (sp.get("id") ?? "").trim()
    if (job !== undefined && ((id !== "" && job.id() === id) || (id === "" && job.inFlight()))) return okJson(recalcJson(job.cancel()))
    const file = this.recalcFile()
    const shared = readShared(file)
    if (shared !== undefined && (id === "" ? sharedInFlight(file, Date.now()) : shared.id === id)) {
      if (!sharedInFlight(file, Date.now())) return okJson(recalcJson(shared))
      requestCancel(file, shared.id)
      let s = shared
      s.status = "cancelled"
      s.message = "Cancellation requested; the job stops before its next slice."
      return okJson(recalcJson(s))
    }
    return { status: 404, body: errorJson("No recalculation job to cancel", "not_found_error", undefined), contentType: "application/json" }
  }

  // /api/logs/user-agent-mappings: the rules that name the app behind a User-Agent. Saved in the config.
  private userAgentRoute(method: string, path: string, body: string): Reply {
    const r = uaRoute(this.store.cfg.user_agent_mappings, method, path, body, isoMs(Date.now()))
    const next = r.next
    if (next !== undefined) {
      const saved = this.store.setUserAgentMappings(next)
      if (saved.kind !== "ok") return { status: saved.status, body: JSON.stringify({ error: { message: saved.message, type: "api_error" } }), contentType: "application/json" }
    }
    return { status: r.status, body: r.body, contentType: "application/json" }
  }

  // DELETE /api/cache/clear/{id} and /api/cache/clear-by-key/{key}: drops entries from the exact-match and
  // the semantic cache (Bifrost's cache handler). removed counts what went.
  async cacheClear(method: string, path: string): Promise<Reply> {
    if (method !== "DELETE") return { status: 405, body: errorJson("use DELETE", "invalid_request_error", undefined), contentType: "application/json" }
    const ex = this.engine.cache
    const sem = this.engine.semantic
    if (ex === undefined && sem === undefined) return { status: 400, body: errorJson("semantic_cache plugin is not loaded", "invalid_request_error", undefined), contentType: "application/json" }
    let removed = 0
    const rest = path.slice("/api/cache/".byteLength)
    if (rest.startsWith("clear-by-key/")) {
      const key = pctDecode(rest.slice("clear-by-key/".byteLength))
      if (key === undefined) return badRequest("Invalid cache key encoding")
      if (key === "") return badRequest("Invalid cache key")
      if (ex !== undefined) removed += ex.clearKey(key)
      if (sem !== undefined) removed += sem.clearKey(key)
      // the semantic cache's entries in an external vector store (Bifrost's DeleteAll by cache_key)
      try {
        removed += await this.engine.vectorClear("", key)
      } catch (e) {
        console.error(`raiju: vector_store clear by key: ${e.message}`)
        return { status: 500, body: errorJson("Failed to clear cache", "api_error", undefined), contentType: "application/json" }
      }
    } else if (rest.startsWith("clear/")) {
      const id = rest.slice("clear/".byteLength)
      if (id === "") return badRequest("Invalid cache ID")
      if (ex !== undefined) removed += ex.clearId(id)
      if (sem !== undefined && sem.clearId(id)) removed += 1
      // a vector-store hit's id is the store's own entry id (not a hash); the store deletes it
      if (this.engine.vstore !== undefined && !isCacheId(id)) {
        try {
          removed += await this.engine.vectorClear(id, "")
        } catch (e) {
          console.error(`raiju: vector_store clear: ${e.message}`)
          return { status: 500, body: errorJson("Failed to clear cache", "api_error", undefined), contentType: "application/json" }
        }
      }
    } else {
      return { status: 404, body: errorJson("no such route", "invalid_request_error", undefined), contentType: "application/json" }
    }
    return okJson(JSON.stringify({ message: "Cache cleared successfully", removed: removed }))
  }

  // /api/plugins: the configured plugins and their status (GET), one by name, /builtins and /loaded (the plugins
  // in the live chain). POST adds a plugin to the config, PUT /api/plugins/{name} changes it and DELETE removes
  // it; each save hands the config to engine.reload, which rebuilds the live chain.
  pluginsRoute(method: string, path: string, body: string): Reply {
    if (path === "/api/plugins/builtins" || path === "/api/plugins/loaded") {
      if (method !== "GET") return pluginError(405, "use GET")
      if (path === "/api/plugins/builtins") return okJson(JSON.stringify({ plugins: builtinPlugins() }))
      const names: string[] = []
      const chain = this.engine.plugins
      if (chain !== undefined) {
        for (const p of chain.plugins) names.push(p.name())
      }
      return okJson(JSON.stringify({ plugins: names }))
    }
    if (path === "/api/plugins") {
      if (method === "POST") return this.createPlugin(body)
      if (method !== "GET") return pluginError(405, "use GET or POST")
      const rows: string[] = []
      for (const sp of this.store.cfg.plugins ?? []) rows.push(pluginJson(sp, this.pluginStats(sp.name)))
      return okJson(jobj([jkv("plugins", jarr(rows)), jkv("count", jn(rows.length))]))
    }
    const name = pctDecode(path.slice("/api/plugins/".byteLength)) ?? ""
    if (name === "" || name.includes("/")) return pluginError(404, "plugin not found")
    if (method === "PUT") return this.updatePlugin(name, body)
    if (method === "DELETE") return this.deletePlugin(name)
    if (method !== "GET") return pluginError(405, "use GET, PUT or DELETE")
    for (const sp of this.store.cfg.plugins ?? []) {
      if (sp.name === name) return okJson(pluginJson(sp, this.pluginStats(sp.name)))
    }
    return pluginError(404, "plugin not found")
  }

  // /api/plugins with a plugin path that is a URL: the file is downloaded first (plugindl.tov, with Bifrost's limits and
  // the private-address rule), then the route runs as for a local file. A download that fails is answered as Bifrost
  // answers a plugin that failed to load (500 with its reason); a .so URL is refused as a .so file is.
  async pluginsRouteAsync(method: string, path: string, body: string): Promise<Reply> {
    if ((method === "POST" && path === "/api/plugins") || (method === "PUT" && path.startsWith("/api/plugins/"))) {
      let url = ""
      try {
        const fs = fields(body)
        url = (rawStr(fs, "path") ?? "").trim()
      } catch (e) {
        url = ""
      }
      const name = method === "PUT" ? pctDecode(path.slice("/api/plugins/".byteLength)) ?? "" : ""
      if (isPluginUrl(url) && !this.authOn && !builtinPlugins().includes(name)) return pluginError(403, pathAuthMessage(method === "POST"))
      if (isPluginUrl(url)) {
        // a name the route answers with 404, or a built-in plugin (which takes no path), downloads nothing
        const known = method === "POST" || (name !== "" && !name.includes("/") && !builtinPlugins().includes(name))
        if (known && url.split("?")[0]!.toLowerCase().endsWith(".so")) return pluginError(400, "Invalid plugin configuration: Go shared-object plugins (.so) are not supported by this gateway; build the plugin as WebAssembly (.wasm)")
        if (known) {
          // the pin the body names, else (on a PUT) the plugin's own: checked on the download
          let cur: string | undefined = undefined
          for (const sp of this.store.cfg.plugins ?? []) {
            if (sp.name === name) cur = sp.sha256
          }
          let pin: string | undefined = cur
          try {
            pin = pinOf(fields(body), cur)
          } catch (e) {
            pin = cur
          }
          const got = await downloadPlugin(url, this.store.cfg.server?.plugin_download_private_allowlist ?? [], pin)
          if (got.error !== "") {
            const msg = method === "POST" ? `Plugin was not created, it failed to load: ${got.error}` : `Plugin update was not applied, it failed to load and the previous configuration was kept: ${got.error}`
            return { status: 500, body: errorJson(msg, "api_error", undefined), contentType: "application/json" }
          }
        }
      }
    }
    // the download ran without the config file's lock; the change and its save run under it
    return await this.underLock(method, () => this.pluginsRoute(method, path, body))
  }

  // The live chain's statistics for a plugin name (this process's), or "".
  private pluginStats(name: string): string {
    const chain = this.engine.plugins
    if (chain === undefined) return ""
    return chain.statsOf(name)
  }

  // POST /api/plugins: {name, enabled, config, path, wasm_limits, placement, order}. 201 with the plugin; 409 when the name is taken; 400 when the name
  // is missing, or the config does not build (a custom plugin path must be a .wasm file that loads).
  private createPlugin(body: string): Reply {
    let fs: Field[] = []
    try {
      fs = fields(body)
    } catch (e) {
      return pluginError(400, "Invalid request body")
    }
    const name = (rawStr(fs, "name") ?? "").trim()
    if (name === "") return pluginError(400, "Plugin name is required")
    const specs = this.store.cfg.plugins ?? []
    for (const sp of specs) {
      if (sp.name === name) return pluginError(409, "Plugin already exists")
    }
    const pl = placementOf(fs, undefined)
    if (!pl.ok) return pluginError(400, "Invalid placement value. Must be 'pre_builtin' or 'post_builtin'")
    const od = orderOf(fs, undefined)
    if (!od.ok) return pluginError(400, "Invalid request body")
    // a built-in plugin takes no path; a custom path needs a caller who really signed in (Bifrost refuses it while
    // dashboard auth is off)
    const path = builtinPlugins().includes(name) ? undefined : pathOf(fs, undefined)
    if (path !== undefined && !this.authOn) return pluginError(403, pathAuthMessage(true))
    const config = configOf(fs, "{}")
    // endpoints and env./vault. references need a caller who really signed in (Bifrost's genuine-auth check)
    if (!this.authOn) {
      const moved = changedTargets("{}", config)
      if (moved.length > 0) return pluginError(403, targetAuthMessage(moved))
    }
    const spec: PluginSpec = { name: name, enabled: rawBool(fs, "enabled") ?? false, config_json: config, placement: pl.value, order: od.value, path: path, wasm_limits: limitsOf(fs, undefined), sha256: pinOf(fs, undefined) }
    const pp = pinProblem(spec.sha256)
    if (pp !== "") return pluginError(400, `Invalid plugin configuration: ${pp}`)
    const bad = badPlugin(spec)
    if (bad !== "") return pluginError(400, `Invalid plugin configuration: ${bad}`)
    const next: PluginSpec[] = specs.slice()
    next.push(spec)
    return this.savePlugins(next, 201, "Plugin created successfully", spec)
  }

  // PUT /api/plugins/{name}: changes the fields the body names (enabled, config, path, wasm_limits, placement, order).
  // A plugin that is not configured yet is created (off unless the body turns it on), as Bifrost creates the row.
  private updatePlugin(name: string, body: string): Reply {
    let fs: Field[] = []
    try {
      fs = fields(body)
    } catch (e) {
      return pluginError(400, "Invalid request body")
    }
    const specs = this.store.cfg.plugins ?? []
    let at = -1
    for (let i = 0; i < specs.length; i++) {
      if (specs[i]!.name === name) at = i
    }
    const cur: PluginSpec = at < 0 ? { name: name, enabled: false, config_json: "{}" } : specs[at]!
    const en = rawBool(fs, "enabled")
    // placement and order from the body, as Bifrost reads them; a body that names neither keeps the plugin's
    const pl = placementOf(fs, cur.placement)
    if (!pl.ok) return pluginError(400, "Invalid placement value. Must be 'pre_builtin' or 'post_builtin'")
    const od = orderOf(fs, cur.order)
    if (!od.ok) return pluginError(400, "Invalid request body")
    const builtin = builtinPlugins().includes(name)
    const asked = builtin ? undefined : pathOf(fs, undefined)
    if (asked !== undefined && !this.authOn) return pluginError(403, pathAuthMessage(false))
    // the body's config is merged over the stored one (a key it leaves out is kept, a redacted placeholder keeps the
    // stored value), as Bifrost merges it; a change of endpoint or reference needs a caller who really signed in
    const stored = cur.config_json ?? "{}"
    const raw = find(fs, "config")
    const config = raw === undefined || isNull(raw) ? stored : mergeConfig(stored, raw)
    if (!this.authOn) {
      const moved = changedTargets(stored, config)
      if (moved.length > 0) return pluginError(403, targetAuthMessage(moved))
    }
    const spec: PluginSpec = { name: name, enabled: en === undefined ? cur.enabled !== false : en, config_json: config, placement: pl.value, order: od.value, path: builtin ? undefined : pathOf(fs, cur.path), wasm_limits: limitsOf(fs, cur.wasm_limits), sha256: builtin ? undefined : pinOf(fs, cur.sha256) }
    const pp = pinProblem(spec.sha256)
    if (pp !== "") return pluginError(400, `Invalid plugin configuration: ${pp}`)
    const bad = badPlugin(spec)
    if (bad !== "") return pluginError(400, `Invalid plugin configuration: ${bad}`)
    const next: PluginSpec[] = []
    for (let i = 0; i < specs.length; i++) next.push(i === at ? spec : specs[i]!)
    if (at < 0) next.push(spec)
    return this.savePlugins(next, 200, "Plugin updated successfully", spec)
  }

  // DELETE /api/plugins/{name}: removes the plugin from the config. 404 when there is no such plugin.
  private deletePlugin(name: string): Reply {
    const specs = this.store.cfg.plugins ?? []
    const next = specs.filter((sp) => sp.name !== name)
    if (next.length === specs.length) return pluginError(404, "plugin not found")
    return this.savePlugins(next, 200, "Plugin deleted successfully", undefined)
  }

  // Saves the plugin list; the reply carries the message and, when there is one, the plugin as listed.
  private savePlugins(next: PluginSpec[], status: int, message: string, spec: PluginSpec | undefined): Reply {
    const saved = this.store.setPlugins(next)
    if (saved.kind !== "ok") return { status: saved.status, body: errorJson(saved.message, "api_error", undefined), contentType: "application/json" }
    if (spec === undefined) return { status: status, body: JSON.stringify({ message: message }), contentType: "application/json" }
    return { status: status, body: jobj([jkv("message", JSON.stringify(message)), jkv("plugin", pluginJson(spec, ""))]), contentType: "application/json" }
  }

  // The window's start: start_time, or the end less period ("1h", "6h", "24h", "7d", "30d"), or 24 hours.
  private windowStart(sp: URLSearchParams, end: f64): f64 {
    const period = sp.get("period") ?? ""
    let span = 86400000.0
    if (period !== "") {
      const unit = period.endsWith("d") ? 86400000.0 : period.endsWith("h") ? 3600000.0 : period.endsWith("m") ? 60000.0 : 0.0
      const n = parseFloat(period.slice(0, period.byteLength - 1)) ?? 0.0
      if (unit > 0.0 && n > 0.0) span = n * unit
    }
    return epochParam(sp.get("start_time") ?? undefined, end - span)
  }

  // The row limit of a ranking: limit (default 10), or 0 for no cap with all=true. -1 when invalid.
  private rankLimit(sp: URLSearchParams): int {
    if ((sp.get("all") ?? "") === "true") return 0
    const raw = sp.get("limit") ?? ""
    if (raw === "") return 10
    const v = parseInt(raw) ?? -1
    return v >= 1 ? v : -1
  }

  // "" when dim is a dimension the log store records for the route, else Bifrost's message for a 400. The
  // histograms take Bifrost's names (team_id, ...) and the rankings its names (team, ...); Raiju's own
  // dimensions (provider, model, virtual_key, tool, server) are accepted on both without being listed.
  private dimensionError(dim: string, histogram: bool): string {
    if (histogram) {
      if (dim === "") return "Missing required query parameter: dimension. Valid values: provider, team_id, customer_id, user_id, business_unit_id, project_id, app, user_agent"
      if (!validDimension(histogramDimName(dim))) return `Invalid dimension: ${dim}. Valid values: provider, team_id, customer_id, user_id, business_unit_id, project_id, app, user_agent`
      return ""
    }
    if (dim === "") return "Missing required query parameter: dimension. Valid values: team, customer, business_unit, project, user, virtual_key, app, user_agent"
    if (!validDimension(dim)) return `Invalid dimension: ${dim}. Valid values: team, customer, business_unit, project, user, virtual_key, app, user_agent`
    return ""
  }

  // GET /api/logs/dashboard: the overview, provider usage, model rankings, dimension rankings and MCP
  // usage for one window, in one call (Bifrost's shape).
  private dashboard(store: LogStore, sp: URLSearchParams, es: LogEntry[], prev: LogEntry[], g: Grid, start: f64, end: f64, now: f64, sc: DataScope): string {
    const mf = filterFrom(sp, "mcp", start, end)
    const mcp = selectAll(this.logRows(store, sc, start - 1.0), mf)
    const dims: string[] = []
    if (distinctDim(es, "virtual_key").length > 0) dims.push(jkv("virtual_key", dimensionRankingsView(es, prev, "virtual_key", 10)))
    return jobj([
      jkv("meta", jobj([jkv("generated_at", JSON.stringify(isoMs(now))), jkv("bucket_size_seconds", jn(g.sizeSec)), jkv("start_time", JSON.stringify(isoMs(start))), jkv("end_time", JSON.stringify(isoMs(end)))])),
      jkv("overview", jobj([jkv("stats", statsView(es)), jkv("requests", requestsView(es, g)), jkv("tokens", tokensView(es, g)), jkv("cost", costView(es, g)), jkv("models", modelsView(es, g)), jkv("latency", latencyView(es, g)), jkv("throughput", throughputView(es, g))])),
      jkv("provider_usage", jobj([jkv("cost", providerView(es, g, "cost")), jkv("tokens", providerView(es, g, "tokens")), jkv("latency", providerView(es, g, "latency")), jkv("throughput", providerView(es, g, "throughput"))])),
      jkv("model_rankings", jobj([jkv("rankings", modelRankingsView(es, prev, 10)), jkv("histogram", modelsView(es, g))])),
      jkv("dimension_rankings", jobj(dims)),
      jkv("mcp", jobj([jkv("volume", requestsView(mcp, g)), jkv("cost", mcpCostView(mcp, g)), jkv("top_tools", topToolsView(mcp, 10))])),
    ])
  }

  // GET /api/logs/filterdata: the values the log filters offer, from every entry in memory, and the
  // virtual keys and routing rules of the config.
  private logFilterData(store: LogStore, sc: DataScope): string {
    const all = this.readView(store, sc, 0.0)
    const llm: LogEntry[] = []
    const mcp: LogEntry[] = []
    for (const e of all) {
      if (kindOf(e) === "mcp") mcp.push(e)
      else llm.push(e)
    }
    const vks: string[] = []
    for (const vk of this.store.cfg.governance?.virtual_keys ?? []) {
      if (!inScope(sc, vk.team_id ?? "", "", vk.customer_id ?? "", "")) continue
      vks.push(jobj([jkv("id", JSON.stringify(vk.id)), jkv("name", JSON.stringify(vk.name ?? ""))]))
    }
    const rules: string[] = []
    for (const r of this.store.cfg.governance?.routing_rules ?? []) rules.push(jobj([jkv("id", JSON.stringify(r.id)), jkv("name", JSON.stringify(r.name ?? ""))]))
    return jobj([
      jkv("models", jstrs(distinctDim(llm, "model"))),
      jkv("providers", jstrs(distinctDim(llm, "provider"))),
      jkv("virtual_keys", jarr(vks)),
      jkv("selected_keys", "[]"),
      jkv("routing_rules", jarr(rules)),
      jkv("routing_engines", "[]"),
      jkv("tool_call_names", jstrs(distinctDim(mcp, "tool"))),
      jkv("projects", "[]"),
      jkv("user_ids", jstrs(distinctDim(llm, "user"))),
      jkv("apps", jstrs(distinctDim(llm, "app"))),
      jkv("user_agents", jstrs(distinctDim(llm, "user_agent"))),
    ])
  }

  // The MCP logs: GET lists, a single entry by id, and the stats, filter menus, histograms and top
  // tools; DELETE removes entries by id.
  private mcpLogsRoute(req: Request, path: string, body: string, store: LogStore | undefined, sc: DataScope, reveal: bool): Reply {
    if (store === undefined) return { status: 404, body: errorJson("request logs are off; enable logs_store in the config", "invalid_request_error", undefined), contentType: "application/json" }
    const u = URL.parse(req.url)
    const sp = u === undefined ? new URLSearchParams("") : u.searchParams
    const now = Date.now()
    // deleting log entries is for all-data roles
    if (path === "/api/mcp-logs" && req.method === "DELETE") return sc.all ? this.deleteMcpLogs(store, body) : { status: 403, body: errorJson("the data access scope of this role does not allow deleting logs", "permission_error", undefined), contentType: "application/json" }
    if (req.method !== "GET") return { status: 405, body: errorJson("use GET or DELETE", "invalid_request_error", undefined), contentType: "application/json" }
    if (path === "/api/mcp-logs") {
      const f = filterFrom(sp, "mcp", epochParam(sp.get("start_time") ?? undefined, 0.0), epochParam(sp.get("end_time") ?? undefined, now + 1.0))
      const es = selectAll(this.logRows(store, sc, f.since - 1.0), f)
      const limit = Math.min(1000, Math.max(1, parseInt(sp.get("limit") ?? "25") ?? 25))
      const offset = Math.max(0, parseInt(sp.get("offset") ?? "0") ?? 0)
      const rows: string[] = []
      for (let i = es.length - 1 - offset; i >= 0 && rows.length < limit; i--) rows.push(mcpLogJson(es[i]!))
      let hasLogs = false
      for (const e of this.logRows(store, sc, 0.0)) {
        if (kindOf(e) === "mcp") hasLogs = true
      }
      const pg = jobj([jkv("limit", jn(limit)), jkv("offset", jn(offset)), jkv("sort_by", JSON.stringify("timestamp")), jkv("order", JSON.stringify("desc")), jkv("total_count", jn(es.length))])
      return okJson(jobj([jkv("logs", jarr(rows)), jkv("pagination", pg), jkv("has_logs", hasLogs ? "true" : "false")]))
    }
    if (path === "/api/mcp-logs/filterdata") {
      const mcp: LogEntry[] = []
      for (const e of this.logRows(store, sc, 0.0)) {
        if (kindOf(e) === "mcp") mcp.push(e)
      }
      return okJson(jobj([jkv("tool_names", jstrs(distinctDim(mcp, "tool"))), jkv("server_labels", jstrs(distinctDim(mcp, "server"))), jkv("virtual_keys", "[]")]))
    }
    if (path === "/api/mcp-logs/stats" || path === "/api/mcp-logs/histogram" || path === "/api/mcp-logs/histogram/cost" || path === "/api/mcp-logs/histogram/top-tools") {
      const end = epochParam(sp.get("end_time") ?? undefined, now)
      const start = this.windowStart(sp, end)
      if (start >= end) return badRequest("start_time must be before end_time")
      const g = gridOf(start, end)
      if (g.n > 10000) return badRequest("too many buckets; narrow the time range")
      const es = selectAll(this.logRows(store, sc, start - 1.0), filterFrom(sp, "mcp", start, end))
      if (path === "/api/mcp-logs/stats") return okJson(mcpStatsView(es))
      if (path === "/api/mcp-logs/histogram") return okJson(requestsView(es, g))
      if (path === "/api/mcp-logs/histogram/cost") return okJson(mcpCostView(es, g))
      const lim = parseInt(sp.get("limit") ?? "10") ?? 10
      return okJson(topToolsView(es, lim))
    }
    const id = path.slice("/api/mcp-logs/".byteLength)
    if (id !== "" && !id.includes("/")) {
      for (const e of this.logRows(store, sc, 0.0)) {
        if (e.id === id && kindOf(e) === "mcp") return okJson(withMapping(mcpLogJson(e), reveal ? this.openedMapping(e) : ""))
      }
      return { status: 404, body: errorJson("MCP log not found", "not_found_error", undefined), contentType: "application/json" }
    }
    return { status: 404, body: errorJson(`no route ${path}`, "invalid_request_error", undefined), contentType: "application/json" }
  }

  // DELETE /api/mcp-logs with {"ids": [...]}: removes the MCP entries among them.
  private deleteMcpLogs(store: LogStore, body: string): Reply {
    let ids: string[] = []
    try {
      ids = (JSON.parse(body) as { ids?: string[] }).ids ?? []
    } catch (e) {
      return badRequest("Invalid JSON")
    }
    if (ids.length === 0) return badRequest("No log IDs provided")
    const doomed: string[] = []
    for (const e of store.viewSince(0.0)) {
      if (kindOf(e) === "mcp" && ids.includes(e.id)) doomed.push(e.id)
    }
    const removed = store.delete(doomed)
    return okJson(JSON.stringify({ message: `deleted ${removed} MCP tool logs` }))
  }

  // A tool call made through the MCP clients, as a log entry of kind "mcp".
  // A row's reveal mapping, opened ("" when it has none or it cannot be opened here).
  openedMapping(e: LogEntry): string {
    const m = e.redaction_mapping
    if (m === undefined || m === "") return ""
    return openStored(this.store.cipher, m) ?? ""
  }

  // Whether the actor may see logs_only reveal mappings (Bifrost's Logs:Reveal; the admin holds it, and a custom or
  // edited built-in role can be given it).
  mayReveal(actor: string): bool {
    return this.mePairs(actor).pairs.some((p) => p.resource === "Logs" && p.operation === "Reveal")
  }

  recordMcp(c: McpToolCall): void {
    const store = this.engine.logStore
    if (store === undefined) return
    const now = Date.now()
    // logs_only: the stored error carries placeholders, and their originals stay with the row for reveal (output phase)
    let err = c.error
    let mapping = ""
    const eng = this.engine
    if (err !== "" && (eng.logGuard !== undefined || eng.logRules.size > 0)) {
      const vault = new Vault()
      err = logsOnlyText(err, eng.logGuard, eng.logRules.values(), vault)
      if (vault.count > 0) mapping = phaseMapping(vault.items, [], [err])
    }
    store.add({
      redaction_mapping: mapping === "" ? undefined : eng.sealLog(mapping),
      id: "mcp-" + now + "-" + Math.floor(Math.random() * 1000000000),
      ts: now,
      request_id: "",
      op: "tool",
      provider: "",
      model: "",
      status: c.ok ? 200 : 500,
      latency_ms: c.latencyMs,
      prompt_tokens: 0,
      completion_tokens: 0,
      cost: c.cost ?? 0.0,
      cache_hit: false,
      error: err === "" ? undefined : err,
      kind: "mcp",
      tool: c.tool,
      server: c.server,
    })
  }


  // agent_names: the filter selects the requests in the sessions (A2A context ids) of the calls to those
  // agents within the window (Bifrost's agent context filter). Other filters pass through.
  withAgents(sp: URLSearchParams, inout f: Filter, store: LogStore, sc: DataScope): void {
    const names = listNames(sp.get("agent_names") ?? "")
    if (names.length === 0) return
    f.agentSessions = agentSessionsOf(this.logRows(store, sc, f.since - 1.0), names, f.since, f.until)
  }

  // One A2A call that reached an agent, as a log entry of kind "a2a" under the agent's name, attributed as the caller's
  // key is (its team, customer and user).
  recordA2a(c: A2aCall): void {
    // the operation's duration (Bifrost's a2a.client.operation.duration); push traffic is not an agent operation
    if (c.method !== "push_notification" && c.method !== "push_delivery") {
      const failed = c.status >= 400 || c.error !== ""
      metrics.observeA2a(c.op ?? c.method, c.method, c.vk ?? "", failed ? (c.status >= 400 ? "" + c.status : "_OTHER") : "", c.latencyMs / 1000.0)
    }
    const store = this.engine.logStore
    if (store === undefined) return
    const now = Date.now()
    let team: string | undefined = undefined
    let customer: string | undefined = undefined
    let user: string | undefined = undefined
    const kid = c.vk
    if (kid !== undefined) {
      for (const k of this.engine.cfg.governance?.virtual_keys ?? []) {
        if (k.id !== kid) continue
        team = k.team_id
        customer = k.customer_id
        user = k.user_id
      }
    }
    const opt = (v: string | undefined): string | undefined => (v === undefined || v === "" ? undefined : v)
    // the governance attribution of the call, when it had one (Bifrost's ApplyGovernanceContext)
    const at = c.at
    let bu: string | undefined = undefined
    let project: string | undefined = undefined
    if (at !== undefined) {
      team = opt(at.teamId) ?? team
      customer = opt(at.customerId) ?? customer
      bu = opt(at.businessUnitId)
      project = opt(at.projectId)
    }
    store.add({
      id: "a2a-" + now + "-" + Math.floor(Math.random() * 1000000000),
      ts: now,
      request_id: c.requestId ?? "",
      op: c.method,
      provider: "",
      model: "",
      status: c.status,
      latency_ms: c.latencyMs,
      prompt_tokens: 0,
      completion_tokens: 0,
      cost: 0.0,
      cache_hit: false,
      virtual_key: c.vk,
      team_id: team,
      customer_id: customer,
      business_unit_id: bu,
      project_id: project,
      user_id: user,
      session_id: c.context === "" ? undefined : c.context,
      error: c.error === "" ? undefined : c.error,
      kind: "a2a",
      record_kind: "request",
      agent_name: c.agent,
      task_id: opt(c.task),
      downstream_transport: opt(c.down),
      upstream_transport: opt(c.up),
      raw_request: rawCapture(c.rawReq ?? ""),
      raw_response: rawCapture(c.rawResp ?? ""),
      input: opt(c.input),
      output: opt(c.output),
    })
  }

  // One event of a call's stream, as its own row (record_kind "event", Bifrost's ObserveA2AEvent), under the call's
  // request id and attribution. An event is no operation: it has no latency, and it is not metered.
  recordA2aEvent(r: A2aEventRow): void {
    const store = this.engine.logStore
    if (store === undefined) return
    const now = Date.now()
    let user: string | undefined = undefined
    let team: string | undefined = undefined
    let customer: string | undefined = undefined
    const kid = r.vk
    if (kid !== undefined) {
      for (const k of this.engine.cfg.governance?.virtual_keys ?? []) {
        if (k.id !== kid) continue
        team = k.team_id
        customer = k.customer_id
        user = k.user_id
      }
    }
    const opt = (v: string | undefined): string | undefined => (v === undefined || v === "" ? undefined : v)
    const i = r.info
    store.add({
      id: "a2a-" + now + "-" + Math.floor(Math.random() * 1000000000),
      ts: now,
      request_id: r.requestId,
      op: r.method,
      provider: "",
      model: "",
      status: 200,
      latency_ms: 0.0,
      prompt_tokens: 0,
      completion_tokens: 0,
      cost: 0.0,
      cache_hit: false,
      virtual_key: r.vk,
      team_id: opt(r.at.teamId) ?? team,
      customer_id: opt(r.at.customerId) ?? customer,
      business_unit_id: opt(r.at.businessUnitId),
      project_id: opt(r.at.projectId),
      user_id: user,
      session_id: opt(i.contextId),
      kind: "a2a",
      record_kind: "event",
      event_sequence: r.sequence,
      event_type: i.type,
      task_state: opt(i.state),
      message_id: opt(i.messageId),
      artifact_id: opt(i.artifactId),
      content_type: opt(i.contentType),
      event_body: opt(r.body),
      agent_name: r.agent,
      task_id: opt(i.taskId),
      downstream_transport: opt(r.down),
    })
  }

  // The names the A2A history shows for the ids its calls carry, from the governance config ("" when unknown). A user is
  // known by name.
  historyName(dim: string, id: string): string {
    if (dim === "users") return id
    const g = this.engine.cfg.governance
    if (g === undefined) return ""
    if (dim === "virtual_keys") {
      for (const k of g.virtual_keys ?? []) {
        if (k.id === id) return k.name ?? k.id
      }
    } else if (dim === "teams") {
      for (const t of g.teams ?? []) {
        if (t.id === id) return t.name
      }
    } else if (dim === "customers") {
      for (const t of g.customers ?? []) {
        if (t.id === id) return t.name
      }
    } else if (dim === "business_units") {
      for (const t of g.business_units ?? []) {
        if (t.id === id) return t.name
      }
    } else if (dim === "projects") {
      for (const t of g.projects ?? []) {
        if (t.id === id) return t.name
      }
    }
    return ""
  }

  // /api/agents/history and its routes (agenthistory.tov), over the A2A calls the caller's data scope sees: GET lists them
  // newest first ({history, total}, Bifrost's filters and Raiju's agent_names), DELETE removes the ones a body's ids name,
  // and stats, histogram, top-agents, filterdata and {id} answer in Bifrost's shapes.
  agentHistoryRoute(method: string, path: string, sp: URLSearchParams, body: string, sc: DataScope): Reply {
    const segs = path.split("?")[0]!.split("/").filter((x) => x !== "")
    const store = this.engine.logStore
    const json503: Reply = { status: 503, body: errorJson("logs store is not available", "api_error", undefined), contentType: "application/json" }
    if (segs.length === 3) {
      if (method === "DELETE") {
        if (store === undefined) return json503
        const d = deleteIds(body)
        if (d.error !== "") return badRequest(d.error)
        const doomed: string[] = []
        for (const e of scopedView(store, sc, 0.0)) {
          if (kindOf(e) === "a2a" && d.ids.includes(e.id)) doomed.push(e.id)
        }
        store.delete(doomed)
        return okJson(`{"message":"Agent logs deleted successfully"}`)
      }
      if (method !== "GET") return { status: 405, body: errorJson("use GET or DELETE", "invalid_request_error", undefined), contentType: "application/json" }
      if (store === undefined) return json503
      const q = agentQuery(sp)
      if (q.error !== "") return badRequest(q.error)
      // Bifrost's {logs, pagination}; group_sessions keeps each context's earliest call, hydrate answers full rows
      let calls = selectedCalls(scopedView(store, sc, 0.0), q.filter)
      let children = new Map<string, int>()
      if (groupingActive(q.filter)) {
        const g = groupedCalls(calls)
        calls = g.rows
        children = g.children
      }
      const listNames = (dim: string, id: string): string => this.historyName(dim, id)
      const rows: string[] = []
      const page = pageOf(calls, q.page)
      const view = q.filter.hydrate && page.length > 0 ? scopedView(store, sc, 0.0) : []
      for (const e of page) {
        let row = ""
        if (q.filter.hydrate) {
          const evs: string[] = []
          for (const x of eventsOf(view, e)) evs.push(agentDetailJson(x, listNames))
          row = hydratedJson(agentDetailJson(e, listNames), evs)
        } else {
          row = a2aLogJson(e)
        }
        rows.push(withChildCount(row, children.get(e.id) ?? 0))
      }
      return okJson(historyPageJson(rows, q.page, calls.length))
    }
    if (segs.length !== 4) return { status: 404, body: errorJson("no such route", "not_found_error", undefined), contentType: "application/json" }
    if (method !== "GET") return { status: 405, body: errorJson("use GET", "invalid_request_error", undefined), contentType: "application/json" }
    if (store === undefined) return json503
    const sub = segs[3]!
    const names = (dim: string, id: string): string => this.historyName(dim, id)
    if (sub === "filterdata") {
      const dims: string[] = []
      for (const d of (sp.get("dimensions") ?? "").split(",")) {
        if (d.trim() !== "") dims.push(d.trim())
      }
      const all = selectedCalls(scopedView(store, sc, 0.0), agentQuery(new URLSearchParams("")).filter)
      return okJson(agentFilterDataJson(all, dims, sp.get("q") ?? "", 100, names))
    }
    if (sub === "stats" || sub === "histogram" || sub === "top-agents") {
      const q = agentQuery(sp)
      if (q.error !== "") return badRequest(q.error)
      const calls = selectedCalls(scopedView(store, sc, 0.0), q.filter)
      if (sub === "stats") return okJson(agentStatsJson(calls))
      if (sub === "histogram") return okJson(agentHistogramJson(calls, q.filter))
      return okJson(topAgentsJson(calls, 10))
    }
    const hydrate = truthy((sp.get("hydrate") ?? "").trim())
    const all = scopedView(store, sc, 0.0)
    for (const e of all) {
      if (kindOf(e) !== "a2a" || e.id !== sub) continue
      if (!hydrate) return okJson(agentDetailJson(e, names))
      // hydrated: the operation the row belongs to (its call, with the call's events), as Bifrost's FindAgentLogOperation
      const op = requestOf(all, e)
      if (op === undefined) break
      const evs: string[] = []
      for (const x of eventsOf(all, op)) evs.push(agentDetailJson(x, names))
      return okJson(hydratedJson(agentDetailJson(op, names), evs))
    }
    return { status: 404, body: errorJson("agent history entry not found", "not_found_error", undefined), contentType: "application/json" }
  }

  // ---- the A2A gateway ----

  // Whether push callbacks may go to private addresses (server.a2a_allow_private_push_callbacks).
  pushPrivate(): bool {
    return this.engine.cfg.server?.a2a_allow_private_push_callbacks === true
  }

  // The checks every call under /agents/a2a/{name} passes: the agent is registered and enabled, the caller's
  // virtual key (required when auth is enforced), the agent's grants, and the key's budgets. count also takes
  // the key's request and token limits (a call does; discovery does not). refusal is the answer when one fails.
  a2aGate(agent: AgentConfig | undefined, name: string, h: Hdrs, rest: bool, count: bool): A2aGate {
    if (agent === undefined || agent.enabled === false) return gateRefusal(rest, 404, `no agent named ${name}`, "not_found_error", undefined)
    const vk = this.engine.gov.findKey(h)
    if (this.engine.gov.enforce && vk === undefined) return gateRefusal(rest, 401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", vk)
    // the agent's own grants, the key's, its access profiles' and the project the call names (governance.tov agentAccess):
    // Bifrost's governance refuses in its PreA2AHook with its own message; the bindings answer it as A2A's -31403
    const access = this.engine.gov.agentAccess(h, agent)
    if (!access.allowed) {
      const r = gateRefusal(rest, 403, access.message, "permission_error", vk)
      return { refusal: r.refusal, vk: vk, status: 403, message: access.message, grant: true }
    }
    const gate = this.engine.gov.admitTool(h)
    if (gate.kind === "denial") return gateRefusal(rest, gate.status, gate.message, gate.type, vk)
    // an agent whose card is not fetched yet has no endpoint to call: refused here, in every binding, before any
    // budget is counted (the same 503 the card route answers; the gRPC binding maps it to UNAVAILABLE)
    if ((agent.card ?? "") === "") return gateRefusal(rest, 503, `the card of ${name} has not been fetched: refresh it through /api/agents/${name}/refresh-card`, "api_error", vk)
    // a card that requires an extension the registration does not allow cannot be relayed (Bifrost refuses to build it)
    const xe = allowedExtensions(agent.card ?? "", agent.extension_uris ?? []).error
    if (xe !== "") return gateRefusal(rest, 503, `the agent ${name} cannot be relayed: ${xe}`, "api_error", vk)
    if (count) {
      // the key's request and token limits count each call (admitTool checks the budgets only)
      const rls: string[] = []
      if (vk !== undefined && vk.rate_limit_id !== undefined) rls.push(vk.rate_limit_id)
      const limited = this.engine.gov.checkLimits(vk, [], rls)
      if (limited.kind === "denial") return gateRefusal(rest, limited.status, limited.message, limited.type, vk)
    }
    return { refusal: undefined, vk: vk, status: 200, message: "", grant: false }
  }

  // A refused grant on a protocol call, once the call is read (Bifrost's governance decides in the A2A plugin pipeline,
  // after the SDK decoded the request): JSON-RPC error -31403 in a 200, REST 403 PERMISSION_DENIED, each with the
  // UNAUTHORIZED ErrorInfo naming the agent, the request type and the request id.
  grantDenied(rest: bool, agent: string, call: Call, rpcId: string, message: string, h: Hdrs): Response {
    const info = this.grantInfo(agent, call.op, h, rest ? call.taskId : "")
    if (rest) return json(403, grantDeniedRest(message, info))
    return json(200, grantDeniedRpc(rpcId, message, info))
  }

  // The ErrorInfo of a refused grant for an operation (a2a.tov unauthorizedInfo), also sent by the gRPC binding.
  grantInfo(agent: string, op: string, h: Hdrs, taskId: string): string {
    return unauthorizedInfo(agent, requestTypeOf(op), h.get("x-request-id") ?? newId("req_"), taskId, errorStamp())
  }

  // The agent a call names, as this worker serves it. A worker that does not hold the agent's card yet first reads the
  // node's share folder (syncShared), where the worker that fetched the card wrote it (publishCards), so the answer does
  // not depend on which worker was asked.
  heldAgent(name: string): AgentConfig | undefined {
    const a = findAgent(this.engine.cfg.agents, name)
    if (a === undefined || (a.card ?? "") !== "") return a
    this.syncShared()
    return findAgent(this.engine.cfg.agents, name)
  }

  // The agent a call names with its card: a declared agent whose card was never fetched gets it now (Bifrost discovers a
  // card on its agent's first request). A fetch that failed is not tried again for 5 s; the call is then refused 503.
  async ensureCard(name: string): Promise<AgentConfig | undefined> {
    const a = this.heldAgent(name)
    if (a === undefined || a.enabled === false || (a.card ?? "") !== "") return a
    const now = Date.now()
    if (now - (this.cardMissAt.get(name) ?? -10000.0) < 5000.0) return a
    try {
      const f = await fetchCard(a.agent_card_url, a.discovery_auth, a.allow_private_network === true, a.name + "|discovery")
      if (f.error !== "") {
        this.cardMissAt.set(name, now)
        console.error(`raiju: agent card of ${name}: ${f.error}`)
        return a
      }
      // fetched without the config file's lock; saved under it
      const held = await this.store.holdLock()
      this.installCard(name, a.agent_card_url, f.card, Math.floor(Date.now()))
      this.store.releaseLock(held)
    } catch (e) {
      this.cardMissAt.set(name, now)
      return a
    }
    return findAgent(this.engine.cfg.agents, name)
  }

  // A card fetched on demand: into this process's config and the engine's at once (as adoptRemoteCard does), saved, and
  // published to the node's other workers and the cluster.
  installCard(name: string, url: string, card: string, at: int): void {
    const w: CardWire = { url: url, fetched_at: at, card: card }
    const e = adoptCard(this.engine.cfg.agents ?? [], name, w)
    if (e !== undefined) {
      let c = this.engine.cfg
      c.agents = e
      this.engine.cfg = c
    }
    const st = adoptCard(this.store.cfg.agents ?? [], name, w)
    if (st !== undefined) this.store.setAgents(st)
    this.publishCards()
  }

  // The cards of the declared agents that have none, fetched once at start by one process of the node.
  async fetchMissingCards(): Promise<void> {
    const missing = (this.store.cfg.agents ?? []).filter((a) => a.enabled !== false && (a.card ?? "") === "")
    if (missing.length === 0) return
    const dir = this.shareDir === "" ? "" : this.shareDir + "/leases"
    if (!takePeriod(new FileLease(dir, 60000), "a2a-card-start", 60000, Math.floor(Date.now()))) return
    for (const a of missing) await this.ensureCard(a.name)
  }

  // The gRPC binding's gate (a2agrpc.tov), in Bifrost's order: the gateway's public URL is set (the push ingress is
  // advertised there), the agent the authority named exists, a key that was sent is one the gateway knows (refused
  // even where auth is not enforced, as Bifrost does), then a2aGate. status is 0 when the call may go on.
  a2aGrpcGate(name: string, h: Hdrs, presented: bool): GrpcGate {
    const base = publicBase(this.engine.cfg.client?.a2a_external_client_url, "")
    if (base === "") return { status: 503, message: "agent gateway disabled: configure client.a2a_external_client_url", agent: undefined, vk: undefined, base: base, grant: false }
    const agent = this.heldAgent(name)
    if (agent === undefined || agent.enabled === false) return { status: 404, message: "agent not found", agent: undefined, vk: undefined, base: base, grant: false }
    if (presented && this.engine.gov.findKey(h) === undefined) return { status: 401, message: "authentication required", agent: agent, vk: undefined, base: base, grant: false }
    const gate = this.a2aGate(agent, name, h, false, true)
    if (gate.refusal !== undefined) return { status: gate.status, message: gate.message, agent: agent, vk: gate.vk, base: base, grant: gate.grant }
    return { status: 0, message: "", agent: agent, vk: gate.vk, base: base, grant: false }
  }

  // The routes under /agents/a2a/{name}: the agent's card (GET .../.well-known/agent-card.json), its JSON-RPC
  // endpoint (POST .../json-rpc), its REST endpoint (.../rest/...) and the push ingress (POST .../push/callback).
  // rest is the path after the name; base is the public base URL. A call passes a2aGate, then goes to the
  // agent's endpoint (a2aCall). The ingress takes no virtual key: the agent proves itself with the token the
  // gateway gave it.
  async a2aRoute(req: Request, name: string, rest: string, base: string): Promise<Response> {
    if (rest === INGRESS_SUFFIX) return await this.a2aIngress(req, name)
    const isCard = rest === CARD_PATH
    const isRpc = rest === JSON_RPC_SUFFIX
    const isRest = rest === REST_PREFIX || rest.startsWith(REST_PREFIX + "/")
    if (!isCard && !isRpc && !isRest) return json(404, errorJson("no such agent route", "invalid_request_error", undefined))
    if (isCard && req.method !== "GET") return json(405, errorJson("use GET for the agent card", "invalid_request_error", undefined))
    if (isRpc && req.method !== "POST") return json(405, errorJson("use POST for JSON-RPC", "invalid_request_error", undefined))
    const agent = await this.ensureCard(name)
    const h = snapshot(req.headers)
    // the version a call names (A2A-Version): one the gateway does not speak is refused, after the caller's credentials
    // are checked, before anything is counted (Bifrost: -32009 on JSON-RPC, 400 FAILED_PRECONDITION on REST)
    if (!isCard && !versionSupported(h.get("a2a-version") ?? "")) {
      const pre = this.a2aGate(agent, name, h, isRest, false)
      const pr = pre.refusal
      // (the grants are decided later, in the call's plugin phase)
      if (pr !== undefined && !pre.grant) return pr
      const vb = await req.text()
      if (isRpc) return json(200, rpcErrorBody(rpcIdOf(vb), -32009, "this version is not supported"))
      return json(400, `{"error":{"code":400,"status":"FAILED_PRECONDITION","message":"this version is not supported"}}`)
    }
    const gate = this.a2aGate(agent, name, h, isRest, true)
    const refusal = gate.refusal
    // a refused grant on the card is Bifrost's card handler's bare 403; on a call it is answered once the call is read
    if (refusal !== undefined && gate.grant && isCard) return forbiddenText()
    if (refusal !== undefined && !gate.grant) return refusal
    if (agent === undefined) return json(404, errorJson(`no agent named ${name}`, "not_found_error", undefined))
    if (isCard) return a2aCardResponse(this.servedCard(agent, agent.card ?? "", base), h)
    const body = await req.text()
    if (isRpc) {
      const routed = rpcCall(body)
      const id = rpcIdOf(body)
      if (routed.kind === "fail") return json(routed.status, rpcErrorBody(id, routed.code, routed.message))
      if (gate.grant) return this.grantDenied(false, name, routed.call, id, gate.message, h)
      return await this.a2aCall(agent, routed.call, "rpc", id, h, gate.vk, base)
    }
    const qi = req.url.indexOf("?")
    const query = qi < 0 ? "" : req.url.slice(qi + 1, req.url.byteLength)
    const routed = restCall(req.method, rest.slice(REST_PREFIX.byteLength, rest.byteLength), query, body)
    if (routed.kind === "fail") return a2aDeny(true, routed.status, routed.message, "invalid_request_error")
    if (gate.grant) return this.grantDenied(true, name, routed.call, "", gate.message, h)
    return await this.a2aCall(agent, routed.call, "rest", "\"1\"", h, gate.vk, base)
  }

  // A card as the gateway serves it for an agent (its own or its extended card): the gateway's interfaces, the gRPC one
  // when the binding listens (Bifrost lists it under the same two settings), and the extensions the registration allows.
  servedCard(agent: AgentConfig, card: string, base: string): string {
    const served = gatewayCard(card, base, agent.name, true, agent.extension_uris ?? [])
    const grpc = this.a2aGrpc
    return grpc === undefined ? served : withGrpcInterface(served, agent.name, grpc.domain, grpc.port)
  }

  // GET /agents/a2a (and .../.well-known/agent-card.json): one card for the gateway, listing the agents the
  // caller may call. Raiju's own; Bifrost has the per-agent cards only.
  async a2aAggregate(req: Request, base: string): Promise<Response> {
    if (req.method !== "GET") return json(405, errorJson("use GET for the agent card", "invalid_request_error", undefined))
    const h = snapshot(req.headers)
    const vk = this.engine.gov.findKey(h)
    if (this.engine.gov.enforce && vk === undefined) return a2aDeny(false, 401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error")
    const gate = this.engine.gov.admitTool(h)
    if (gate.kind === "denial") return a2aDeny(false, gate.status, gate.message, gate.type)
    const list = (this.engine.cfg.agents ?? []).filter((a) => a.enabled !== false && (a.card ?? "") !== "" && this.engine.gov.agentAccess(h, a).allowed)
    return a2aCardResponse(aggregateCard(list, base, true), h)
  }

  // An answer the gateway makes up itself, in the caller's binding.
  a2aFail(rest: bool, rpcId: string, status: int, code: int, message: string): Response {
    if (rest) return json(status, restErrorOfStatus(status, message))
    // a JSON-RPC error rides in a 200; only an agent that did not answer is a gateway error
    return json(status === 502 ? 502 : 200, rpcErrorBody(rpcId, code, message))
  }

  // A protocol error of the gateway's own (a JSON-RPC code), in the caller's binding: a REST error with the code's
  // status, or a JSON-RPC error.
  a2aError(rest: bool, rpcId: string, code: int, message: string): Response {
    if (rest) return json(httpOfCode(code), restErrorBody(code, message))
    return json(200, rpcErrorBody(rpcId, code, message))
  }

  // The result of a call in the caller's binding: the result object itself on REST, a JSON-RPC response on JSON-RPC.
  a2aResult(rest: bool, rpcId: string, result: string): Response {
    if (rest) return json(200, result)
    return json(200, `{"jsonrpc":"2.0","id":${rpcId},"result":${result}}`)
  }

  // Headers for a call to the agent: the caller's own headers (without the gateway credential it logged in
  // with, cookies and connection headers), then the agent's runtime credentials, which win. With
  // forward_accepted_credential the caller's gateway credential goes too, on the header it came in on, unless
  // the agent's own headers set that one (forward_accepted_credential_overrides_auth lets it replace them).
  async a2aHeaders(agent: AgentConfig, h: Hdrs, accepted: { header: string, value: string } | undefined, hasBody: bool, stream: bool): Promise<{ headers: Map<string, string>, error: string }> {
    const consumed = accepted === undefined ? "" : accepted.header
    const out: Map<string, string> = new Map()
    const conn = (h.get("connection") ?? "").split(",").map((x) => x.trim().toLowerCase())
    for (const k of h.keys()) {
      if (A2A_NOT_FORWARDED.includes(k) || k === consumed || conn.includes(k)) continue
      out.set(k, h.get(k) ?? "")
    }
    const managed = await upstreamHeaders(agent.name + "|runtime", agent.runtime_auth, agent.allow_private_network === true)
    if (managed.error !== "") return { headers: out, error: `the agent's credentials could not be obtained: ${managed.error}` }
    let mine = managed.headers
    if (agent.forward_accepted_credential === true && accepted !== undefined) withAcceptedCredential(&mine, accepted.header, accepted.value, agent.forward_accepted_credential_overrides_auth === true)
    for (const k of mine.keys()) out.set(k, mine.get(k) ?? "")
    if (hasBody) out.set("content-type", "application/json")
    out.set("accept", stream ? "text/event-stream" : "application/json")
    return { headers: out, error: "" }
  }

  // Whether the call log keeps the raw bytes of each call (client.a2a_store_raw_request_response).
  rawOn(): bool {
    return this.engine.cfg.client?.a2a_store_raw_request_response === true
  }

  // Sends one call to the agent on the interfaces its card offers, in order (a2agrpcup.tov upstreamCandidates: the
  // caller's binding first, then the others, newest protocol version first, the ones that failed lately last). A
  // failure that proves the interface unusable moves the call to the next one, as Bifrost's forwardUpstream does
  // (attemptVerdict); one that only suggests it sends later calls elsewhere first. params is the call's params after
  // any push rewriting, in the caller's version.
  async a2aSend(agent: AgentConfig, call: Call, params: string, binding: string, rpcId: string, h: Hdrs, accepted: { header: string, value: string } | undefined, cancel: CallCancel): Promise<Fwd> {
    const card = agent.card ?? ""
    const none = `the card of ${agent.name} names no endpoint the gateway may call`
    const list = this.a2aDemoted.order(agent.name, card, upstreamCandidates(card, agent.agent_card_url, binding, agent.allow_private_network === true))
    let last = fwdFail(none)
    for (const c of list) {
      const fwd = await this.a2aSendOn(agent, c, call, params, binding, rpcId, h, accepted, cancel)
      if (cancel.fired) return fwd
      const rpcCode = fwd.stream === undefined && fwd.error === "" ? unaryOf(fwd).code : 0
      const v = attemptVerdict({ binding: c.binding, method: fwd.method, status: fwd.status, ct: fwd.ct, rpcCode: rpcCode, grpcCode: fwd.grpc, error: fwd.error })
      if (v.demote) this.a2aDemoted.demote(agent.name, card, c)
      else if (fwd.error === "") this.a2aDemoted.restore(agent.name, card, c)
      if (!v.retry) return fwd
      last = fwd
    }
    return last
  }

  // One attempt on one interface: the params in the interface's protocol version (a2aver.tov) and the answer back in the
  // caller's. A JSON-RPC caller speaks the version of its method names; REST and gRPC callers speak v1; the gRPC
  // interface speaks v1.
  async a2aSendOn(agent: AgentConfig, c: Candidate, call: Call, params: string, binding: string, rpcId: string, h: Hdrs, accepted: { header: string, value: string } | undefined, cancel: CallCancel): Promise<Fwd> {
    // a v0.3 REST client (its /v1 routes, a2a.tov restCallV03) speaks v0.3 too
    const callerV03 = (binding === "rpc" || binding === "rest") && call.v03
    const upV03 = c.binding !== "GRPC" && c.v03
    const upParams = callerV03 === upV03 ? params : paramsTo(call.op, params, upV03)
    const upCall: Call = { op: call.op, v03: upV03, params: upParams, stream: call.stream, taskId: call.taskId, configId: call.configId }
    // the URL guard again at connect time, on the addresses the interface's host resolves to now (netguard.tov)
    const guard = await candidateProblem(c.binding, c.url, agent.allow_private_network === true)
    if (guard !== "") {
      let f = fwdFail(`the agent's ${c.binding} interface is refused: ${guard}`)
      f.binding = c.binding
      return f
    }
    const fwd = c.binding === "GRPC" ? await this.a2aSendGrpc(agent, upCall, c, rpcId, h, accepted, cancel) : await this.a2aSendHttp(agent, upCall, c, rpcId, h, accepted, cancel)
    if (callerV03 === upV03 || fwd.error !== "") return fwd
    return translatedFwd(fwd, call.op, callerV03)
  }

  // One attempt over JSON-RPC or REST. call is in the interface's version: its method names, its REST routes (v0.3's sit
  // under /v1) and its A2A-Version (v1 interfaces get theirs). The caller going away aborts the request.
  async a2aSendHttp(agent: AgentConfig, call: Call, c: Candidate, rpcId: string, h: Hdrs, accepted: { header: string, value: string } | undefined, cancel: CallCancel): Promise<Fwd> {
    const useRest = c.binding === "HTTP+JSON"
    let url = c.url
    let method = "POST"
    let body = ""
    if (useRest) {
      const rr = restRequestOf(call)
      let base = c.url
      while (base.endsWith("/")) base = base.slice(0, base.byteLength - 1)
      const path = call.v03 ? (call.op === "GetExtendedAgentCard" ? "/v1/card" : "/v1" + rr.path) : rr.path
      url = base + path + (rr.query === "" ? "" : "?" + rr.query)
      method = rr.method
      body = rr.body
    } else {
      body = `{"jsonrpc":"2.0","id":${rpcId},"method":${JSON.stringify(methodOf(call.op, call.v03))},"params":${call.params}}`
    }
    const failed = (message: string): Fwd => {
      let f = fwdFail(message)
      f.binding = c.binding
      f.method = method
      f.rpc = !useRest
      return f
    }
    const hd = await this.a2aHeaders(agent, h, accepted, body !== "", call.stream)
    if (hd.error !== "") return failed(hd.error)
    let hm = hd.headers
    if (!call.v03) hm.set("a2a-version", c.version === "" ? "1.0" : c.version)
    const dl = deadline(call.stream ? 300000 : 60000)
    // a caller that went away stops the request, and a stream's body, upstream
    cancel.on(() => {
      dl.controller.abort(new DOMException("the caller went away", "AbortError"))
    })
    try {
      // redirects are followed on the call's own origin only (Bifrost's clientFor), each hop's addresses checked by the
      // runtime when it connects under the agent's allow_private_network
      const opts: HopOpts = { signal: dl.controller.signal, tls: tlsOf(agent.runtime_auth), peer: peerOf(policyOf(agent.allow_private_network === true)) }
      const res = try await fetchFollowing({ method: method, url: url, headers: hm, body: body === "" ? undefined : body }, opts, sameOriginRule)
      const ct = res.headers.get("content-type") ?? ""
      const rb = res.body
      if (call.stream && ct.includes("text/event-stream") && rb !== undefined) {
        // the stream is passed on as it arrives: the deadline no longer applies to it
        dl.finish()
        let st: ReadableStream = rb
        let tap: StreamTap | undefined = undefined
        if (this.rawOn()) {
          const t = new StreamTap(RAW_LIMIT)
          tap = t
          st = tapped(st, t, undefined, undefined)
        }
        return { status: res.status, text: "", ct: ct, stream: st, rpc: !useRest, error: "", binding: c.binding, method: method, grpc: -1, rawReq: body, rawResp: "", tap: tap }
      }
      const text = await res.text()
      dl.finish()
      // an endpoint that is gone or does not speak the protocol: the card may have changed
      if (res.status === 405 || res.status === 410 || res.status === 426 || (res.status === 404 && !ct.includes("json"))) this.refreshSoon(agent.name)
      return { status: res.status, text: text, ct: ct, stream: undefined, rpc: !useRest, error: "", binding: c.binding, method: method, grpc: -1, rawReq: body, rawResp: text, tap: undefined }
    } catch (e) {
      dl.finish()
      return failed(`the agent did not answer: ${e.message}`)
    }
  }

  // One attempt on the agent's gRPC interface (a2agrpcup.tov): the answer comes back as a JSON-RPC answer, or an event
  // stream of them, so every binding maps it as it maps a JSON-RPC agent's. The caller going away resets the call.
  async a2aSendGrpc(agent: AgentConfig, call: Call, c: Candidate, rpcId: string, h: Hdrs, accepted: { header: string, value: string } | undefined, cancel: CallCancel): Promise<Fwd> {
    const failed = (message: string): Fwd => {
      let f = fwdFail(message)
      f.binding = "GRPC"
      return f
    }
    const hd = await this.a2aHeaders(agent, h, accepted, false, call.stream)
    if (hd.error !== "") return failed(hd.error)
    let md = hd.headers
    md.set("a2a-version", c.version === "" ? "1.0" : c.version)
    const tls: H2Tls = { ca: "", verify: true }
    const t = tlsOf(agent.runtime_auth)
    if (t !== undefined) {
      const ca = t.ca
      if (ca !== undefined) tls.ca = ca
      if (t.rejectUnauthorized === false) tls.verify = false
      tls.cert = t.cert
      tls.key = t.key
    }
    const g = await grpcSend(c.url, tls, call, call.params, rpcId, md, cancel)
    if (g.error !== "") return failed(`the agent did not answer: ${g.error}`)
    const st = g.stream
    if (st !== undefined) return { status: 200, text: "", ct: "text/event-stream", stream: st, rpc: true, error: "", binding: "GRPC", method: "POST", grpc: 0, rawReq: "", rawResp: "", tap: undefined }
    return { status: 200, text: g.text, ct: "application/json", stream: undefined, rpc: true, error: "", binding: "GRPC", method: "POST", grpc: g.code, rawReq: "", rawResp: "", tap: undefined }
  }

  // One call, whatever binding it came in on: push configs are kept by the gateway (get and list are answered
  // from its store; create and delete go to the agent first), the rest is sent on and its answer brought back
  // to the caller's binding. The extensions the caller asks for are checked first (a2aext.tov), and an extended card
  // comes back as the gateway serves cards. Every call that reached the agent is logged, a stream's when it ends.
  // cancel (the gRPC binding's) stops the work upstream when the caller goes away; a stream's caller that stops reading
  // does the same.
  async a2aCall(agent: AgentConfig, call: Call, binding: string, rpcId: string, h: Hdrs, vk: VirtualKeyConfig | undefined, base: string, cancel?: CallCancel): Promise<Response> {
    const name = agent.name
    const rest = binding === "rest"
    const started = Date.now()
    const label = methodOf(call.op, call.v03)
    const vkId = vk?.id
    const store = pushStore()
    const accepted = vk === undefined ? undefined : this.engine.gov.credentialHeader(h)
    const cc = cancel ?? new CallCancel()
    // an HTTP caller that goes away before the answer (clientgone.tov) stops the call upstream, as the gRPC binding's does
    const gone = cancel === undefined ? clientSignal(h) : undefined
    if (gone !== undefined) gone.addEventListener("abort", () => cc.fire())
    const down = transportOf(binding)
    const keepContent = !this.engine.contentOff(h)
    const rawOn = this.rawOn()
    // the id the call's row and its stream's event rows share, and the call's attribution
    const reqId = (h.get("x-request-id") ?? "").trim() !== "" ? (h.get("x-request-id") ?? "").trim() : newId("a2a-req-")
    const at = this.engine.gov.attributionOf(h)
    let params = call.params
    let context = contextOfParams(params)
    // the extensions the caller asks for (A2A-Extensions) against the ones the registration relays
    const xc = checkExtensions(agent.card ?? "", agent.extension_uris ?? [], h.get("a2a-extensions"), params)
    if (xc.code !== 0) return this.a2aError(rest, rpcId, xc.code, xc.message)
    // push configs the gateway answers itself
    if (call.op === "GetTaskPushNotificationConfig" || call.op === "ListTaskPushNotificationConfigs") {
      if (call.taskId === "") return this.a2aFail(rest, rpcId, 400, -32602, "invalid params: a task id is required")
      if (call.op === "GetTaskPushNotificationConfig") {
        const c = store.config(name, call.taskId, call.configId)
        if (c === undefined) return this.a2aFail(rest, rpcId, 404, -32001, "push notification config not found")
        this.recordA2a({ agent: name, method: label, op: call.op, status: 200, latencyMs: Date.now() - started, context: context, vk: vkId, error: "", task: call.taskId, down: down })
        return this.a2aResult(rest, rpcId, pushViewJson(c.task, c.id, c.url, c.scheme, call.v03))
      }
      const views: string[] = []
      for (const c of store.forTask(name, call.taskId)) views.push(pushViewJson(c.task, c.id, c.url, c.scheme, call.v03))
      this.recordA2a({ agent: name, method: label, op: call.op, status: 200, latencyMs: Date.now() - started, context: context, vk: vkId, error: "", task: call.taskId, down: down })
      return this.a2aResult(rest, rpcId, pushListJson(views, call.v03))
    }
    // a create or an embedded config: the agent gets the gateway's ingress and a token of its own for it
    const ingress = base + "/agents/a2a/" + name + INGRESS_SUFFIX
    let created: PushSpec | undefined = undefined
    let createdHash = ""
    let pendingTask = ""
    let pendingHash = ""
    try {
      if (call.op === "CreateTaskPushNotificationConfig") {
        const spec = pushSpecOf(call)
        if (spec.error !== "") return this.a2aFail(rest, rpcId, 400, -32602, `invalid params: ${spec.error}`)
        const bad = await callbackConnectProblem(spec.url, this.pushPrivate())
        if (bad !== "") return this.a2aFail(rest, rpcId, 400, -32602, `invalid params: ${bad}`)
        const m = mintToken()
        params = pushUpstreamParams(call, ingress, m.token)
        created = spec
        createdHash = m.hash
      } else if (call.op === "SendMessage" || call.op === "SendStreamingMessage") {
        const emb = embeddedPush(params)
        if (emb !== undefined) {
          if (emb.spec.error !== "") return this.a2aFail(rest, rpcId, 400, -32602, `invalid params: ${emb.spec.error}`)
          const bad = await callbackConnectProblem(emb.spec.url, this.pushPrivate())
          if (bad !== "") return this.a2aFail(rest, rpcId, 400, -32602, `invalid params: ${bad}`)
          const m = mintToken()
          const cid = emb.spec.configId !== "" ? emb.spec.configId : secureHex(8)
          pendingTask = PENDING_PREFIX + secureHex(8)
          pendingHash = m.hash
          const now = Math.floor(Date.now())
          store.saveConfig({ agent: name, task: pendingTask, id: cid, url: emb.spec.url, token: emb.spec.token, scheme: emb.spec.scheme, credentials: emb.spec.credentials, ingress: m.hash, created_at: now, updated_at: now })
          params = rewriteEmbedded(params, emb.key, cid, ingress, m.token)
        }
      }
    } catch (e) {
      return this.a2aFail(rest, rpcId, 500, -32603, `could not set up the push configuration: ${e.message}`)
    }
    // the caller's request as the log keeps it (the gateway's ingress in place of a callback)
    const input = keepContent ? params : ""
    const fwd = await this.a2aSend(agent, call, params, binding, rpcId, h, accepted, cc)
    const rawReq = rawOn ? fwd.rawReq : ""
    if (fwd.error !== "") {
      if (pendingTask !== "") store.removePending(name, pendingHash, pendingTask)
      this.recordA2a({ agent: name, method: label, op: call.op, status: 502, latencyMs: Date.now() - started, context: context, vk: vkId, error: fwd.error, task: call.taskId, down: down, up: fwd.binding, rawReq: rawReq, input: input, requestId: reqId, at: at })
      return this.a2aFail(rest, rpcId, 502, -32603, fwd.error)
    }
    const up = fwd.stream
    if (call.stream && up !== undefined) {
      const sh: Record<string, string> = new Map()
      sh.set("content-type", "text/event-stream")
      sh.set("cache-control", "no-cache")
      // the same binding on both sides passes the events as they are; the other maps each event's payload
      const mapped = !rest && !fwd.rpc ? relayMapped(up, (d: string): string => rpcEvent(rpcId, d)) : (rest && fwd.rpc ? relayMapped(up, restEvent) : relay(up))
      // the call is logged when its stream ends (or its caller goes away), with what the agent streamed when kept; each
      // event the caller is sent is a row of its own as it passes (Bifrost's ObserveA2AEvent)
      const tap = fwd.tap
      const status = fwd.status
      const err = status >= 400 ? `agent answered HTTP ${status}` : ""
      const events = new StreamTap(0)
      const seq = new EventCount()
      events.watch((d: string): void => {
        const info = a2aEventOf(d)
        if (info === undefined) return
        seq.n += 1
        this.recordA2aEvent({ agent: name, method: label, requestId: reqId, vk: vkId, at: at, down: down, sequence: seq.n, info: info, body: keepContent ? info.body : "" })
      })
      const out = tapped(mapped, events, () => {
        const raw = tap === undefined || tap.dropped ? "" : tap.text
        this.recordA2a({ agent: name, method: label, op: call.op, status: status, latencyMs: Date.now() - started, context: context, vk: vkId, error: err, task: call.taskId, down: down, up: fwd.binding, rawReq: rawReq, rawResp: raw, input: input, requestId: reqId, at: at })
      }, cc)
      return new Response(out, { status: fwd.status, headers: sh })
    }
    const u = unaryOf(fwd)
    if (context === "" && !u.failed) context = contextOfResult(u.result)
    const err = u.failed ? `agent answered ${fwd.status >= 400 ? "HTTP " + fwd.status : "a JSON-RPC error"}` : ""
    let task = call.taskId
    if (task === "" && !u.failed) task = taskIdOfResult(u.result)
    this.recordA2a({ agent: name, method: label, op: call.op, status: fwd.status, latencyMs: Date.now() - started, context: context, vk: vkId, error: err, task: task, down: down, up: fwd.binding, rawReq: rawReq, rawResp: rawOn ? fwd.rawResp : "", input: input, output: keepContent && !u.failed ? u.result : "", requestId: reqId, at: at })
    // an embedded config is bound to the task the send made, or dropped when it made none
    if (pendingTask !== "") {
      const tid = u.failed ? "" : taskIdOfResult(u.result)
      if (tid === "") store.removePending(name, pendingHash, pendingTask)
      else store.bind(name, pendingHash, pendingTask, tid)
    }
    if (!u.failed && created !== undefined) {
      const spec = created
      let cid = pushIdOfResult(u.result, call.v03)
      if (cid === "") cid = spec.configId
      if (cid === "") {
        try {
          cid = secureHex(8)
        } catch (e) {
          cid = "config"
        }
      }
      const now = Math.floor(Date.now())
      store.saveConfig({ agent: name, task: spec.taskId, id: cid, url: spec.url, token: spec.token, scheme: spec.scheme, credentials: spec.credentials, ingress: createdHash, created_at: now, updated_at: now })
      return this.a2aResult(rest, rpcId, pushViewJson(spec.taskId, cid, spec.url, spec.scheme, call.v03))
    }
    if (!u.failed && call.op === "DeleteTaskPushNotificationConfig") {
      store.remove(name, call.taskId, call.configId)
      return this.a2aResult(rest, rpcId, rest ? "{}" : "null")
    }
    // the extended card is the agent's own: it is served as the gateway serves the agent's card
    if (!u.failed && call.op === "GetExtendedAgentCard" && u.result.trim().startsWith("{")) return this.a2aResult(rest, rpcId, this.servedCard(agent, u.result.trim(), base))
    return a2aRender(rest, rpcId, fwd, u)
  }

  // POST /agents/a2a/{name}/push/callback: an event the agent pushes. The token it carries (the one the gateway
  // gave it for a config) is the only authentication; the event is queued for the relay (202).
  async a2aIngress(req: Request, name: string): Promise<Response> {
    if (req.method !== "POST") return json(405, errorJson("use POST for push notifications", "invalid_request_error", undefined))
    const agent = findAgent(this.engine.cfg.agents, name)
    if (agent === undefined || agent.enabled === false) return json(404, errorJson(`no agent named ${name}`, "not_found_error", undefined))
    const body = await req.text()
    const started = Date.now()
    const r = acceptPush(pushStore(), name, req.headers.get(TOKEN_HEADER) ?? "", body, Math.floor(started))
    this.recordA2a({ agent: name, method: "push_notification", status: r.status, latencyMs: Date.now() - started, context: "", vk: undefined, error: r.error })
    if (r.status !== 202) return json(r.status, errorJson(r.error, r.status === 401 ? "authentication_error" : "invalid_request_error", undefined))
    return new Response(undefined, { status: 202 })
  }

  // GET /api/agents/push-configs, DELETE /api/agents/push-configs/{agent}/{task}/{config}: the callbacks callers
  // registered through the gateway. Secrets are never shown. Deleting here removes the gateway's copy only; the
  // agent keeps its registration until the caller deletes it through the protocol.
  pushConfigsRoute(method: string, path: string, sp: URLSearchParams): Reply {
    const segs = path.split("?")[0]!.split("/").filter((x) => x !== "")
    const store = pushStore()
    if (segs.length === 3) {
      if (method !== "GET") return { status: 405, body: errorJson("use GET", "invalid_request_error", undefined), contentType: "application/json" }
      let limit = parseInt(sp.get("limit") ?? "") ?? 0
      let offset = parseInt(sp.get("offset") ?? "") ?? 0
      if (limit <= 0) limit = 25
      if (limit > 100) limit = 100
      if (offset < 0) offset = 0
      const page = store.page({ agents: listNames(sp.get("agent_names") ?? ""), task: sp.get("task_id") ?? "", config: sp.get("config_id") ?? "", url: sp.get("url") ?? "", limit: limit, offset: offset })
      const rows: string[] = []
      for (const c of page.rows) rows.push(configView(c))
      return okJson(`{"push_configs":[${rows.join(",")}],"agent_names":${JSON.stringify(store.agentNames())},"count":${rows.length},"total_count":${page.total},"limit":${limit},"offset":${offset}}`)
    }
    if (segs.length === 6) {
      if (method !== "DELETE") return { status: 405, body: errorJson("use DELETE", "invalid_request_error", undefined), contentType: "application/json" }
      if (!store.remove(segs[3]!, segs[4]!, segs[5]!)) return { status: 404, body: errorJson("agent push configuration not found", "not_found_error", undefined), contentType: "application/json" }
      return { status: 204, body: "", contentType: "application/json" }
    }
    return { status: 404, body: errorJson("no such route", "not_found_error", undefined), contentType: "application/json" }
  }

  // Starts the push relay: every second, the queued pushes that are due go to the callers' callbacks, and an
  // hour's housekeeping drops what is old. Runs in every worker; they share one queue and a worker takes a lease on
  // a push before it sends it, so each push is sent by one worker.
  startA2aRelay(): void {
    setInterval(() => {
      this.a2aRelayPass()
    }, 1000)
  }

  async a2aRelayPass(): Promise<void> {
    if (this.relayBusy) return
    this.relayBusy = true
    const store = pushStore()
    try {
      // the queue is shared with the node's other workers: read it before looking
      store.sync()
      if (store.deliveries.length > 0) {
        await deliverDue(store, this.pushPrivate(), Math.floor(Date.now()), (d: PushDelivery, err: string, ms: int): void => {
          this.recordA2a({ agent: d.agent, method: "push_delivery", status: err === "" ? 200 : 502, latencyMs: ms, context: "", vk: undefined, error: err })
        })
      }
      this.relayTicks += 1
      if (this.relayTicks % 3600 === 1) store.prune(Math.floor(Date.now()), (this.store.cfg.agents ?? []).map((a) => a.name))
    } catch (e) {
      console.error(`raiju: a2a push relay: ${e.message}`)
    }
    this.relayBusy = false
  }

  // Starts the card timer (client.a2a_card_refresh_seconds, 300 by default, 0 for none): each pass fetches the
  // card of every enabled agent the node owns again and saves the ones that changed. Every worker runs the timer;
  // cardTick gives each period's turn to one of them.
  startCardRefresh(): void {
    this.cardRefreshOn = true
    // the declared agents whose cards were never fetched get them now
    setTimeout(() => {
      this.fetchMissingCards()
    }, 0)
    const secs = this.store.cfg.client?.a2a_card_refresh_seconds ?? 300
    if (secs <= 0) return
    setInterval(() => {
      this.cardTick(secs * 1000)
    }, secs * 1000)
  }

  // One tick of the card timer: one process of the node takes each period's turn (a lease in the node's share folder).
  cardTick(periodMs: int): void {
    const dir = this.shareDir === "" ? "" : this.shareDir + "/leases"
    if (!takePeriod(new FileLease(dir, periodMs), "a2a-card-refresh", periodMs, Math.floor(Date.now()))) return
    this.refreshCards()
  }

  // One pass of the card timer, over the agents this node owns (ownerOf over the live nodes): the other nodes adopt
  // their cards from the cluster state.
  async refreshCards(): Promise<void> {
    const nodes = this.liveNodes()
    const me = cluster.nodeOf(this.nodeId)
    const list = (this.store.cfg.agents ?? []).filter((a) => ownerOf(a.name, nodes) === me)
    if (list.length === 0) return
    try {
      const r = await refreshAll(list)
      for (const f of r.failed) console.error(`raiju: agent card refresh: ${f}`)
      const next = r.next
      if (next !== undefined) {
        // fetched without the config file's lock; merged and saved under it
        const held = await this.store.holdLock()
        if (held.ok) this.store.setAgents(this.mergeCards(next, r.changed))
        this.store.releaseLock(held)
        this.publishCards()
        console.error(`raiju: agent card changed: ${r.changed.join(", ")}`)
      }
    } catch (e) {
      console.error(`raiju: agent card refresh: ${e.message}`)
    }
  }

  // The current list with the refreshed cards of the agents named in changed (the list may have been edited
  // while the cards were being fetched).
  mergeCards(fresh: AgentConfig[], changed: string[]): AgentConfig[] {
    const out: AgentConfig[] = []
    for (const a of this.store.cfg.agents ?? []) {
      const f = findAgent(fresh, a.name)
      if (f !== undefined && changed.includes(a.name) && f.agent_card_url === a.agent_card_url) out.push(withCard(a, f.card ?? "", f.card_fetched_at ?? Math.floor(Date.now())))
      else out.push(a)
    }
    return out
  }

  // An agent answered as if its endpoint had moved (404 without a protocol error, 405, 410, 426): fetch its card
  // again, at most once a minute. Only where the timer runs (the process that may save the config).
  refreshSoon(name: string): void {
    if (!this.cardRefreshOn) return
    const now = Date.now()
    const last = this.cardRefreshAt.get(name) ?? 0.0
    if (now - last < 60000.0) return
    this.cardRefreshAt.set(name, now)
    // one process of the node, once a minute
    const dir = this.shareDir === "" ? "" : this.shareDir + "/leases"
    if (!takePeriod(new FileLease(dir, 60000), "a2a-card-soon:" + name, 60000, Math.floor(now))) return
    this.refreshOne(name)
  }

  // A card another worker or node fetched arrives through the cluster state. It replaces this registration's card when
  // it is for the same URL and newer (or the registration has none), in the config this process holds and in the
  // engine's. A card held here that is newer goes back to the state, which keeps the last write it merged.
  adoptRemoteCard(name: string, value: string | undefined): void {
    if (value === undefined) return
    const w = cardOf(value)
    if (w === undefined) return
    const mine = findAgent(this.store.cfg.agents, name)
    if (mine === undefined || mine.agent_card_url !== w.url) return
    const have = mine.card ?? ""
    if (have !== "" && (mine.card_fetched_at ?? 0) > w.fetched_at) {
      cardShare().put(name, mine.agent_card_url, have, mine.card_fetched_at ?? 0)
      return
    }
    cardShare().known(name, w)
    const s = adoptCard(this.store.cfg.agents ?? [], name, w)
    if (s !== undefined) {
      let c = this.store.cfg
      c.agents = s
      this.store.cfg = c
    }
    const e = adoptCard(this.engine.cfg.agents ?? [], name, w)
    if (e !== undefined) {
      let c = this.engine.cfg
      c.agents = e
      this.engine.cfg = c
    }
  }

  async refreshOne(name: string): Promise<void> {
    const a = findAgent(this.store.cfg.agents, name)
    if (a === undefined || a.enabled === false) return
    try {
      const r = await refreshAll([a])
      const next = r.next
      if (next !== undefined) {
        const held = await this.store.holdLock()
        if (held.ok) this.store.setAgents(this.mergeCards(next, r.changed))
        this.store.releaseLock(held)
        this.publishCards()
        console.error(`raiju: agent card changed: ${name}`)
      }
    } catch (e) {
      console.error(`raiju: agent card refresh: ${e.message}`)
    }
  }

  // ---- log exporters (Datadog, Splunk, Elasticsearch, HTTP) ----

  configureExporters(list: LogExporterConfig[]): void {
    const key = JSON.stringify(list)
    if (key === this.exportersKey) return
    this.exportersKey = key
    if (this.exportersTimer >= 0) {
      clearInterval(this.exportersTimer)
      this.exportersTimer = -1
    }
    // the old senders close their broker sockets before the new ones start
    for (const s of this.exporterSenders.values()) s.close()
    this.exporterSenders = new Map()
    const qs: ExportQueue[] = []
    for (const c of list) {
      if (c.enabled === false) continue
      const problem = exporters.validate(c)
      if (problem !== "") {
        console.error(`raiju: exporter ${c.id}: ${problem}`)
        continue
      }
      qs.push(new ExportQueue(c))
      this.exporterSenders.set(c.id, new SinkSender(c))
    }
    this.engine.exportQueues = qs
    if (qs.length === 0) return
    this.exportersTimer = setInterval(() => {
      this.flushExporters()
    }, 1000)
  }

  // A graceful stop (lifecycle.tov): what is queued goes out once more, whether due or not: this worker's counters
  // to the share folder, the exporters' batches (each queue until it is empty or a send fails), retained content,
  // the trace spans and the request log's batched rows.
  async flushForStop(): Promise<void> {
    if (this.shareDir !== "") this.shareTick()
    for (const q of this.engine.exportQueues) {
      const sender = this.exporterSenders.get(q.cfg.id)
      if (sender === undefined) continue
      for (let i = 0; i < 100 && q.size() > 0; i++) {
        const batch = q.take(Date.now())
        if (batch.length === 0) break
        const st = await sender.send(batch)
        if (st === 0 || st === 429 || st >= 500) {
          q.requeue(batch)
          break
        }
      }
    }
    await this.flushRetained()
    const tr = this.engine.tracer
    if (tr !== undefined) this.engine.flushTraces(tr)
    // the request log's last batch (a process alone writes its rows every 100 ms; logstore.tov)
    const ls = this.engine.logStore
    if (ls !== undefined) ls.flush()
    this.saveAdaptive()
  }

  // ---- held keys and incidents across restarts ----

  // Where the holds and incidents of adaptive load balancing are kept between runs ("" with no config file).
  adaptivePath(): string {
    return this.store.path === "" ? "" : this.store.path + ".adaptive.json"
  }

  // Holds and incidents survive a restart, as in Bifrost (its regional leader writes the held keys every 30 seconds
  // and a starting node restores them): they are restored now from <config>.adaptive.json, and written there every
  // 30 seconds by the leader, and at a graceful stop, while adaptive load balancing is on.
  startAdaptiveStore(): void {
    const path = this.adaptivePath()
    if (path === "") return
    if (this.engine.cfg.health?.adaptive === true && existsSync(path)) {
      try {
        const n = this.engine.health.holds.restore(readFileSync(path, "utf8"), Date.now())
        if (n > 0) console.error(`raiju: restored ${n} held key${n === 1 ? "" : "s"} from ${path}`)
      } catch (e) {
        console.error(`raiju: held keys: ${e.message}`)
      }
    }
    setInterval(() => {
      if (this.isLeader()) this.saveAdaptive()
    }, 30000)
  }

  saveAdaptive(): void {
    const path = this.adaptivePath()
    if (path === "" || this.engine.cfg.health?.adaptive !== true) return
    try {
      writeFileAtomic(path, this.engine.health.holds.snapshot(Date.now()), { durable: false })
    } catch (e) {
      console.error(`raiju: held keys: ${e.message}`)
    }
  }

  async flushExporters(): Promise<void> {
    if (this.sending) return
    this.sending = true
    const now = Date.now()
    for (const q of this.engine.exportQueues) {
      if (!q.due(now)) continue
      const batch = q.take(now)
      if (batch.length === 0) continue
      const sender = this.exporterSenders.get(q.cfg.id)
      if (sender === undefined) {
        q.requeue(batch)
        continue
      }
      const st = await sender.send(batch)
      // 0 (network, token, a retriable broker error), 429 or 5xx is tried again later; any other refusal won't improve
      if (st === 0 || st === 429 || st >= 500) q.requeue(batch)
      else if (st >= 300) console.error(`raiju: exporter ${q.cfg.id}: status ${st}, batch dropped`)
    }
    this.sending = false
  }

  // ---- retained content (client.retain_content_in_object_storage) ----

  // The queue of hidden objects (and the hybrid store's payload objects) is uploaded once a second, while the engine has one.
  configureRetained(): void {
    if ((this.engine.hiddenQueue === undefined && this.engine.hybridQueue === undefined) || this.retainTimer >= 0) return
    this.retainTimer = setInterval(() => {
      this.flushRetained()
    }, 1000)
  }

  // Uploads the retained objects that are due: at most 16 a pass, each tried once here. A failed one waits
  // its pause in the queue and is given up after MAX_ATTEMPTS tries. Nothing waits on this, so a store
  // outage never holds up a request.
  async flushRetained(): Promise<void> {
    if (this.retainSending) return
    this.retainSending = true
    const queues: RetainQueue[] = []
    const hq = this.engine.hiddenQueue
    if (hq !== undefined) queues.push(hq)
    const pq = this.engine.hybridQueue
    if (pq !== undefined) queues.push(pq)
    try {
      for (const q of queues) {
        const what = q.policy === undefined ? "retained content" : "log payload"
        for (let n = 0; n < 16; n++) {
          const now = Date.now()
          const job = q.take(now)
          if (job === undefined) break
          const ok = await this.retainPut(jobRequest(q, job, now))
          if (ok) q.done(job)
          else if (!q.fail(job, Date.now())) console.error(`raiju: ${what} ${job.key}: given up after ${MAX_ATTEMPTS} tries`)
        }
      }
    } catch (e) {
      console.error(`raiju: retained content: ${e.message}`)
    }
    this.retainSending = false
  }

  // ---- the hybrid store's log detail (hybrid.tov): the row's payload object is read back and merged ----

  // The row a log detail at path names, with its object merged when the row has one (and its content is not hidden).
  // The object is tried under every key its format may have given it; one that cannot be read leaves the row as it is
  // (Bifrost logs the failure and answers the row). undefined when the path is no log detail or the row has no object.
  async hydratedRow(path: string, store: LogStore, peers: LogEntry[]): Promise<LogEntry | undefined> {
    const q = this.engine.hybridQueue
    const pol = q === undefined ? undefined : q.policy
    if (q === undefined || pol === undefined || !path.startsWith("/api/logs/")) return undefined
    const w = this.readWindow(path, new URLSearchParams(""), Date.now())
    if (w === undefined || w.id === "") return undefined
    let row = store.findById(w.id)
    if (row === undefined) {
      for (const e of peers) {
        if (e.id === w.id) row = e
      }
    }
    if (row === undefined || row.has_object !== true || row.content_hidden === true) return undefined
    const e: LogEntry = row
    for (const key of payloadKeys(pol, q.prefix, e.ts, e.id)) {
      const req = getObjectRequest(q.cfg, key, Date.now())
      const dl = deadline(15000)
      try {
        const hs: Record<string, string> = req.headers
        const r = await fetch(req.url, { method: "GET", headers: hs, signal: dl.controller.signal })
        const bytes = await r.bytes()
        dl.finish()
        if (r.status === 404) continue
        if (r.status !== 200) {
          console.error(`raiju: log payload ${key}: HTTP ${r.status}`)
          return undefined
        }
        return hydrate(e, try decodePayload(bytes))
      } catch (err) {
        dl.finish()
        console.error(`raiju: log payload ${key}: ${err.message}`)
        return undefined
      }
    }
    return undefined
  }

  // Deletes the payload objects of deleted rows, in the background, under every key they may have.
  async deletePayloads(es: LogEntry[]): Promise<void> {
    const q = this.engine.hybridQueue
    const pol = q === undefined ? undefined : q.policy
    if (q === undefined || pol === undefined) return
    for (const e of es) {
      for (const key of payloadKeys(pol, q.prefix, e.ts, e.id)) {
        const req = deleteRequest(q.cfg, key, Date.now())
        const dl = deadline(30000)
        try {
          const hs: Record<string, string> = req.headers
          const r = await fetch(req.url, { method: "DELETE", headers: hs, signal: dl.controller.signal })
          await r.text()
          if (r.status >= 300 && r.status !== 404) console.error(`raiju: log payload: delete of ${e.id}: HTTP ${r.status}`)
        } catch (err) {
          console.error(`raiju: log payload: delete of ${e.id}: ${err.message}`)
        }
        dl.finish()
      }
    }
  }

  // One upload, with a 30 second deadline. True when the store answered 2xx.
  async retainPut(req: ByteRequest): Promise<bool> {
    const dl = deadline(30000)
    let ok = false
    try {
      const hs: Record<string, string> = req.headers
      const r = await fetch(req.url, { method: "PUT", headers: hs, body: req.body, signal: dl.controller.signal })
      await r.text()
      ok = r.status >= 200 && r.status < 300
      if (!ok) console.error(`raiju: retained content: HTTP ${r.status} from ${req.url}`)
    } catch (e) {
      console.error(`raiju: retained content: ${e.message}`)
    }
    dl.finish()
    return ok
  }

  // ---- request log exports ----

  configureExports(ec: LogExportsConfig | undefined): void {
    const key = ec !== undefined && ec.enabled ? JSON.stringify(ec) : ""
    if (key === this.exportKey) return
    this.exportKey = key
    if (this.exportTimer >= 0) {
      clearInterval(this.exportTimer)
      this.exportTimer = -1
    }
    this.configureRetention(ec)
    if (ec === undefined || !ec.enabled) {
      this.exportCfg = undefined
      return
    }
    this.exportCfg = ec
    this.exportTimer = setInterval(() => {
      if (this.isLeader()) this.exportLogs()
    }, Math.max(1, exportInterval(ec)) * 1000)
  }

  // Retention sweeps: once shortly after start, then every few hours. Leader only.
  configureRetention(ec: LogExportsConfig | undefined): void {
    if (this.retentionTimer >= 0) {
      clearInterval(this.retentionTimer)
      this.retentionTimer = -1
    }
    if (ec === undefined || !ec.enabled || (ec.retention_days ?? 0) <= 0) return
    setTimeout(() => {
      if (this.isLeader()) this.sweepExports()
    }, 5000)
    this.retentionTimer = setInterval(() => {
      if (this.isLeader()) this.sweepExports()
    }, 4 * 3600 * 1000)
  }

  // Lists the export prefix and deletes the objects whose day is past retention_days.
  async sweepExports(): Promise<void> {
    const ec = this.exportCfg
    if (ec === undefined || !ec.enabled || this.sweeping) return
    const days = ec.retention_days ?? 0
    if (days <= 0) return
    this.sweeping = true
    let token: string | undefined = undefined
    let deleted = 0
    for (let page = 0; page < 1000; page++) {
      const lr = listRequest(ec, token, Date.now())
      const lh: Record<string, string> = lr.headers
      const dl = deadline(30000)
      let xml = ""
      try {
        const lres = await fetch(lr.url, { method: "GET", headers: lh, signal: dl.controller.signal })
        xml = await lres.text()
        if (lres.status < 200 || lres.status >= 300) {
          console.error(`raiju: log export retention: HTTP ${lres.status} listing ${lr.url}`)
          dl.finish()
          break
        }
      } catch (e) {
        console.error(`raiju: log export retention: ${e.message}`)
        dl.finish()
        break
      }
      dl.finish()
      const listing = parseListing(xml)
      const now = Date.now()
      for (const k of listing.keys) {
        if (!expiredKey(k, now, days)) continue
        const dr = deleteRequest(ec, k, Date.now())
        const dh: Record<string, string> = dr.headers
        const dd = deadline(30000)
        try {
          const dres = await fetch(dr.url, { method: "DELETE", headers: dh, signal: dd.controller.signal })
          await dres.text()
          if (dres.status >= 200 && dres.status < 300) deleted++
          else console.error(`raiju: log export retention: HTTP ${dres.status} deleting ${k}`)
        } catch (e) {
          console.error(`raiju: log export retention: ${e.message}`)
        }
        dd.finish()
      }
      token = listing.next
      if (token === undefined) break
    }
    if (deleted > 0) console.log(`raiju: log export retention: deleted ${deleted} object(s) older than ${days} day(s)`)
    this.sweeping = false
  }

  async exportLogs(): Promise<void> {
    const ec = this.exportCfg
    const ls = this.engine.logStore
    if (ec === undefined || ls === undefined || this.exporting) return
    const now = Date.now()
    const entries = ls.since(this.cursor.position())
    if (isParquet(ec)) {
      // one Parquet object per batch of the rows the cursor selects
      const sel = this.cursor.select(entries.map((e) => e.ts), now)
      if (sel === undefined) return
      const rows: LogEntry[] = sel.idx.map((i) => entries[i]!)
      const pq = putBytesRequest(ec, objectKey(ec, sel.startMs, sel.endMs, this.nodeId, "parquet"), logParquet(rows), now)
      this.exporting = true
      const pdl = deadline(30000)
      try {
        const hs: Record<string, string> = pq.headers
        const r = await fetch(pq.url, { method: "PUT", headers: hs, body: pq.body, signal: pdl.controller.signal })
        await r.text()
        if (r.status >= 200 && r.status < 300) this.cursor.commit(sel.endMs)
        else console.error(`raiju: log export: HTTP ${r.status} from ${pq.url}`)
      } catch (e) {
        console.error(`raiju: log export: ${e.message}`)
      }
      pdl.finish()
      this.exporting = false
      return
    }
    const batch = this.cursor.pending(entries.map((e) => JSON.stringify(publicEntry(e))), entries.map((e) => e.ts), now)
    if (batch === undefined) return
    this.exporting = true
    const put = putRequest(ec, objectKey(ec, batch.startMs, batch.endMs, this.nodeId), batch.body, now)
    const dl = deadline(30000)
    try {
      const hs: Record<string, string> = put.headers
      const r = await fetch(put.url, { method: "PUT", headers: hs, body: put.body, signal: dl.controller.signal })
      await r.text()
      if (r.status >= 200 && r.status < 300) this.cursor.commit(batch.endMs)
      else console.error(`raiju: log export: HTTP ${r.status} from ${put.url}`)
    } catch (e) {
      console.error(`raiju: log export: ${e.message}`)
    }
    dl.finish()
    this.exporting = false
  }

  // ---- SSO (OIDC) for the UI and the management API ----

  async disc(oc: OidcConfig): Promise<Discovery | undefined> {
    const d = this.discovery
    if (d !== undefined) return d
    const r = await getText(discoveryUrl(oc.issuer))
    if (r.status !== 200) return undefined
    try {
      const parsed = parseDiscovery(r.body)
      this.discovery = parsed
      return parsed
    } catch (e) {
      return undefined
    }
  }

  // What a sign-in's claims change when the identity provider is configured through scim_config (a provider set):
  // the user is found or created, its role decided (no default role) and its memberships resynced (claimsync.tov).
  // With SCIM provisioning on and claimsSyncMode "scim", a user SCIM has not pushed is refused and a pushed one signs
  // in with the role SCIM gave. "none" leaves the sign-in to the oidc section's own role rules (also when that section
  // sets role_map or default_role).
  syncSignIn(sub: string, email: string | undefined, payload: string): { kind: "none" } | { kind: "role", role: string } | { kind: "refuse", reason: string } {
    const sc = this.store.cfg.scim_config
    if (sc === undefined || sc.enabled !== true || (sc.provider ?? "") === "") return { kind: "none" }
    // an oidc section with role rules of its own (role_map, default_role) keeps deciding the role, as before
    const own = this.oidcCfg
    if (own !== undefined && (own.role_map !== undefined || own.default_role !== undefined)) return { kind: "none" }
    const c = sc.config ?? {}
    const g = this.store.cfg.governance ?? {}
    let users = g.users ?? []
    const at = findUser(users, sub, email)
    const who = (email ?? "") !== "" ? (email ?? "") : sub
    const dir: Directory = { teams: g.teams ?? [], businessUnits: g.business_units ?? [], projects: g.projects ?? [], profiles: g.access_profiles ?? [] }
    const mint = (p: string): string => randomId(p)
    let claims: Claims = new Map()
    const scimOnly = syncMode(c, resolveEnv(c.provisioningToken ?? "")) === "scim"
    if (scimOnly) {
      if (at < 0) return this.refused(who, "Provisioning is managed by SCIM: your identity provider has not pushed this user yet")
      const u = users[at]!
      // SCIM only: the token's claims are ignored; with mapping rules, they are re-applied to what SCIM last sent
      if (!hasRules(c) || (u.scim_attributes === undefined && (u.scim_groups ?? []).length === 0)) {
        if (u.role === "") return this.refused(who, "what SCIM last sent for this user maps to no role")
        return { kind: "role", role: u.role }
      }
      claims = scimClaims(u, dir.teams, c)
    } else claims = mergedClaims(payload, ruleAttributes(c), at >= 0 ? users[at]!.claims : undefined)
    const lower = (email ?? "").toLowerCase()
    const fresh: AdminUserConfig = { name: lower !== "" ? lower : sub, email: email, role: "", source: "sso" }
    const r = applyClaims(at >= 0 ? users[at]! : undefined, fresh, claims, c, dir, this.roleBook(), mint)
    const after = r.user
    // SCIM only: a refusal keeps what SCIM gave (the role is not used until SCIM sends data that maps one)
    if (after === undefined || (r.kind === "refuse" && scimOnly)) return this.refused(who, r.reason)
    // a refusal that took the role away keeps the account, with no role until a sign-in maps one again, and its
    // memberships resynced from the claims
    if (at >= 0) users[at] = after
    else users.push(after)
    const saved = this.store.setClaimSync(users, (g.teams ?? []).concat(r.newTeams), (g.business_units ?? []).concat(r.newBusinessUnits))
    if (saved.kind !== "ok") return { kind: "refuse", reason: "the user could not be saved: " + saved.message }
    this.storeUpdated("/api/users")
    if (r.newTeams.length > 0) this.storeUpdated("/api/governance/teams")
    if (r.newBusinessUnits.length > 0) this.storeUpdated("/api/governance/business-units")
    if (r.kind === "refuse") return this.refused(who, r.reason)
    return { kind: "role", role: after.role }
  }

  // A refused sign-in: the reason, and Bifrost's "Sign-in refused" notice for the admins (at most once an hour per
  // user and reason).
  refused(who: string, reason: string): { kind: "refuse", reason: string } {
    notifyOnce(`signin-refused:${who.toLowerCase()}:${reason}`, 3600000, { severity: "warning", title: "Sign-in refused", message: `${who} could not sign in: ${reason}. Check the attribute mappings for roles under scim_config.`, action_label: "Users", action_path: "/workspace/users" })
    return { kind: "refuse", reason: reason }
  }

  // The roles a sync may give and their permission counts (built-in and custom; -1 for a role that does not exist).
  roleBook(): RoleBook {
    const roles = this.store.cfg.governance?.roles
    const names: string[] = ["admin", "editor", "viewer", "auditor"]
    for (const r of customRoles(roles)) names.push(r.name)
    const count = (r: string): int => {
      const s = systemRole(roles, r, RESOURCES, OPERATIONS)
      if (s !== undefined) return (s.permissions ?? []).length
      const cr = customRole(roles, r)
      if (cr === undefined) return -1
      return (cr.permissions ?? []).length
    }
    return { names: names, count: count }
  }

  // GET /api/oidc/status, /api/oidc/login, /api/oidc/callback: open routes.
  async oidcRoute(req: Request, path: string): Promise<Response> {
    const oc0 = this.oidcCfg
    if (path === "/api/oidc/status") return json(200, `{"enabled":${oc0 !== undefined}}`)
    if (oc0 === undefined) return json(404, errorJson("SSO is off", "invalid_request_error", undefined))
    const oc = withRedirect(oc0, req.url)
    const d = await this.disc(oc)
    if (d === undefined) return json(502, errorJson("could not read the identity provider's discovery document", "api_error", undefined))
    const now = Date.now()
    // the state cookie is Secure over https (as Bifrost's session cookie: TLS, or X-Forwarded-Proto https)
    const secure = req.url.startsWith("https:") || (req.headers.get("x-forwarded-proto") ?? "") === "https"
    if (path === "/api/oidc/login") {
      try {
        // a consent page that sent its user to sign in gets them back (only the gateway's own consent pages); the
        // return path is kept with the sign-in, so the callback may come to any worker
        const lu = URL.parse(req.url)
        const back = returnPath(lu === undefined ? "" : (lu.searchParams.get("return_to") ?? ""))
        const b = this.flows.begin(oc, d, now, back)
        const h: Record<string, string> = new Map()
        h.set("location", b.url)
        h.set("cache-control", "no-store")
        // the browser that begins the sign-in is the only one whose callback is taken (login CSRF)
        h.set("set-cookie", stateCookie(b.state, secure))
        return new Response(undefined, { status: 302, headers: h })
      } catch (e) {
        return json(500, errorJson(e.message, "api_error", undefined))
      }
    }
    if (path !== "/api/oidc/callback") return json(404, errorJson(`no route for ${path}`, "invalid_request_error", undefined))
    // failed callbacks (a state or token that does not check out) are throttled per client address
    const ipKeys: string[] = clientIp(req) === "" ? [] : [addressKey(clientIp(req))]
    const wait = signInGuard().retryAfter(ipKeys, now)
    if (wait > 0) {
      const th: Record<string, string> = new Map()
      th.set("content-type", "text/html; charset=utf-8")
      th.set("cache-control", "no-store")
      th.set("retry-after", `${wait}`)
      return new Response(`<p>Too many failed sign-ins from this address. Try again in ${wait} seconds.</p>`, { status: 429, headers: th })
    }
    const u = URL.parse(req.url)
    const params = u === undefined ? new URLSearchParams("") : u.searchParams
    const st = params.get("state") ?? ""
    // every answer from here on clears the state cookie: a state is tried once per browser
    const clear = clearStateCookie(secure)
    // a state is taken only from the browser that began its sign-in (its cookie holds the state's hash), so a link
    // with an attacker's own state and code cannot sign a victim's browser in as the attacker
    if (!stateBound(req.headers.get("cookie") ?? "", st)) {
      signInGuard().fail(ipKeys, now)
      return html(401, "<p>This sign-in was not started in this browser, or its cookie expired. <a href=\"/api/oidc/login\">Sign in again</a>.</p>", clear)
    }
    const flow = this.flows.complete(st, now)
    if (flow === undefined) {
      signInGuard().fail(ipKeys, now)
      return html(401, "<p>This sign-in link expired or was already used. <a href=\"/api/oidc/login\">Sign in again</a>.</p>", clear)
    }
    const backTo = flow.back !== "" ? flow.back : "/"
    const th: Map<string, string> = new Map()
    th.set("content-type", "application/x-www-form-urlencoded")
    th.set("accept", "application/json")
    const tr = await postText(d.token_endpoint, th, tokenRequestBody(oc, params.get("code") ?? "", flow.verifier))
    if (tr.status !== 200) return html(502, `<p>The identity provider refused the sign-in (HTTP ${tr.status}).</p>`, clear)
    let idToken = ""
    let accessToken = ""
    let refreshToken = ""
    try {
      const tf = fields(tr.body)
      idToken = rawStr(tf, "id_token") ?? ""
      accessToken = rawStr(tf, "access_token") ?? ""
      refreshToken = rawStr(tf, "refresh_token") ?? ""
    } catch (e) {
      idToken = ""
    }
    if (idToken === "") return html(502, "<p>The identity provider sent no ID token.</p>", clear)
    const jw = await getText(d.jwks_uri)
    if (jw.status !== 200) return html(502, "<p>Could not read the identity provider's signing keys.</p>", clear)
    let v = verifyIdToken(idToken, jw.body, oc, d.issuer, flow.nonce, Date.now())
    if (v.kind === "error") {
      signInGuard().fail(ipKeys, now)
      return html(401, `<p>Sign-in failed: ${v.message.replace("<", "&lt;")}</p>`, clear)
    }
    // Keycloak puts its roles in the access token: its claims are the ones the mappings read
    if (oc.claims_token === "access_token") {
      const at = accessTokenClaims(accessToken, jw.body, oc, d.issuer, Date.now())
      if (at.kind === "error") return html(401, `<p>Sign-in failed: ${at.message.replace("<", "&lt;")}</p>`, clear)
      v = { kind: "ok", sub: v.sub, email: v.email, role: v.role, claims: at.claims }
    }
    // a user governance lists as disabled (a SCIM deactivation, say) signs in no more; users it does not list are unchanged
    if (disabledNamed(this.rbac, ssoNames(v.sub, v.email))) {
      this.recordChange("sso:" + v.sub, req, path, 403, "")
      return html(403, "<p>This account is disabled. Ask an administrator to enable it.</p>", clear)
    }
    // an identity provider configured through scim_config: its claims decide the role and the memberships
    const synced = await this.syncSignInLocked(v.sub, v.email, v.claims)
    if (synced.kind === "refuse") {
      this.recordChange("sso:" + v.sub, req, path, 403, "")
      return html(403, `<p>Sign-in refused: ${synced.reason.replace("<", "&lt;")}</p>`, clear)
    }
    const role = synced.kind === "role" ? synced.role : v.role
    let token = ""
    try {
      // the refresh token stays on the server: an expired session is refreshed silently with it (refreshSession)
      token = this.sessions.create(v.sub, role, Date.now(), v.email, refreshToken)
    } catch (e) {
      return html(503, "<p>Could not create a session; try again.</p>", clear)
    }
    // the UI keeps its admin token in sessionStorage; the session token takes its place
    return html(200, `<!doctype html><meta charset="utf-8"><title>Signed in</title><script>sessionStorage.setItem("raiju.adminToken", ${JSON.stringify(token)}); location.replace(${JSON.stringify(backTo)});</script><p>Signed in as ${(v.email ?? v.sub).replace("<", "&lt;")}.</p>`, clear)
  }

  // ---- session refresh and sweep ----

  // Before a management request: an expired single sign-on session with a refresh token is refreshed silently.
  async refreshDue(req: Request): Promise<void> {
    const auth = req.headers.get("authorization") ?? ""
    if (!auth.startsWith("Bearer sk-sess-")) return
    const due = this.sessions.refreshable(auth.slice(7), Date.now())
    if (due === undefined) return
    await this.refreshSession(due)
  }

  // A silent session refresh (Bifrost's): the refresh token traded for fresh tokens and their claims applied again,
  // as a sign-in applies them. A refresh the identity provider refuses, or fresh claims that resolve no role, end the
  // session; after a refused refresh the user is removed when the directory reports them inactive or gone (checkGone).
  // An unreachable provider leaves the session waiting for the next try. true when the session was renewed.
  async refreshSession(due: DueSession): Promise<bool> {
    const oc = this.oidcCfg
    if (oc === undefined) return false
    const d = await this.disc(oc)
    if (d === undefined) return false
    const th: Map<string, string> = new Map()
    th.set("content-type", "application/x-www-form-urlencoded")
    th.set("accept", "application/json")
    const tr = await postText(d.token_endpoint, th, refreshRequestBody(oc, due.refresh))
    if (tr.status === 0) return false
    if (tr.status !== 200) {
      this.endSession(due.token)
      await this.checkGone(due.sub, due.email)
      return false
    }
    let idToken = ""
    let accessToken = ""
    let rotated = ""
    try {
      const tf = fields(tr.body)
      idToken = rawStr(tf, "id_token") ?? ""
      accessToken = rawStr(tf, "access_token") ?? ""
      rotated = rawStr(tf, "refresh_token") ?? ""
    } catch (e) {
      idToken = ""
    }
    let role: string | undefined = undefined
    if (idToken !== "") {
      const jw = await getText(d.jwks_uri)
      if (jw.status !== 200) return false
      const v = verifyIdToken(idToken, jw.body, oc, d.issuer, undefined, Date.now())
      if (v.kind === "error" || v.sub !== due.sub) {
        this.endSession(due.token)
        return false
      }
      let claims = v.claims
      if (oc.claims_token === "access_token") {
        const at = accessTokenClaims(accessToken, jw.body, oc, d.issuer, Date.now())
        if (at.kind === "ok") claims = at.claims
      }
      role = v.role
      const synced = await this.syncSignInLocked(v.sub, v.email ?? due.email, claims)
      if (synced.kind === "refuse") {
        this.endSession(due.token)
        return false
      }
      if (synced.kind === "role") role = synced.role
    }
    try {
      this.sessions.renew(due.token, role, Date.now(), rotated)
    } catch (e) {
      // the session stays expired with its refresh token: the next request tries again
      console.error(`raiju: a single sign-on session could not be renewed: ${e.message}`)
      return false
    }
    return true
  }

  // Ends a session whose refresh failed. A session that cannot be ended now (its file's lock is kept by another
  // process) stays expired, and the next request or sweep ends it.
  endSession(token: string): void {
    try {
      this.sessions.delete(token)
    } catch (e) {
      console.error(`raiju: a single sign-on session could not be ended: ${e.message}`)
    }
  }

  // After a refused refresh: Bifrost asks the directory, and removes the user only when it reports them inactive or
  // gone (never in SCIM-only mode, where SCIM alone removes users; a failed check keeps the user).
  async checkGone(sub: string, email: string | undefined): Promise<void> {
    const sc = this.store.cfg.scim_config
    const c = sc?.config ?? {}
    if (syncMode(c, resolveEnv(c.provisioningToken ?? "")) === "scim") return
    const ds = directorySettings(sc).settings
    if (ds === undefined) return
    const users = this.store.cfg.governance?.users ?? []
    const at = findUser(users, sub, email)
    if (at < 0 || !idpManaged(users[at]!)) return
    const u = users[at]!
    const l = await lookupUser(ds, (u.email ?? "") !== "" ? (u.email ?? "") : u.name)
    if (l.kind !== "inactive" && l.kind !== "gone") return
    const held = await this.store.holdLock()
    if (held.ok) this.removeUsersNow([u.name], "the session refresh failed and the directory reports the user " + (l.kind === "gone" ? "gone" : "inactive"))
    else console.error(`raiju: ${u.name} was not removed: another process kept the config file's lock`)
    this.store.releaseLock(held)
  }

  // Removes users the identity provider no longer has (their keys and memberships go too) and ends their sessions.
  // The last enabled admin is kept.
  removeUsersNow(names: string[], why: string): void {
    const g = this.store.cfg.governance ?? {}
    const users = g.users ?? []
    const dir: Directory = { teams: g.teams ?? [], businessUnits: g.business_units ?? [], projects: g.projects ?? [], profiles: g.access_profiles ?? [] }
    const plan = withRemovals(users, { users: users, newTeams: [], newBusinessUnits: [], removed: [], changes: [] }, names, dir)
    if (plan.removed.length === 0) return
    this.applyPlan(plan)
    notify({ severity: "info", title: "User removed", message: `${plan.removed.join(", ")} removed: ${why}.` })
  }

  // Saves a provisioning plan: the users, the teams and business units it made, the removed users' keys and project
  // memberships gone, and their sessions ended.
  applyPlan(plan: Plan): string {
    const g = this.store.cfg.governance ?? {}
    const saved = this.store.setProvisioned(plan.users, (g.teams ?? []).concat(plan.newTeams), (g.business_units ?? []).concat(plan.newBusinessUnits), plan.removed)
    if (saved.kind !== "ok") return saved.message
    if (plan.removed.length > 0) {
      const gone: string[] = []
      for (const u of g.users ?? []) {
        if (plan.removed.includes(u.name)) {
          gone.push(u.name)
          if (u.email !== undefined) gone.push(u.email)
        }
      }
      try {
        this.sessions.endUser(gone)
      } catch (e) {
        return `the removed users' sessions could not be ended: ${e.message}`
      }
    }
    this.storeUpdated("/api/users")
    if (plan.newTeams.length > 0) this.storeUpdated("/api/governance/teams")
    if (plan.newBusinessUnits.length > 0) this.storeUpdated("/api/governance/business-units")
    return ""
  }

  // The daily session sweep (skipped with SCIM provisioning on): sessions that expire within the next day are
  // refreshed ahead of time, which removes the users the identity provider reports gone.
  async sweepSessions(): Promise<void> {
    const c = this.store.cfg.scim_config?.config ?? {}
    if (syncMode(c, resolveEnv(c.provisioningToken ?? "")) !== "off") return
    for (const due of this.sessions.dueBy(Date.now() + 86400000.0)) await this.refreshSession(due)
  }

  // ---- directory sync, bulk import and reconcile ----

  // The directory sync schedule: every bulkSyncInterval (24h by default, 1h to 30d) on the leader, while SCIM
  // provisioning is off and the provider's directory credentials are set (and enableBulkSync is not off). A changed
  // interval applies without a restart. The daily session sweep runs while sign-in is on.
  configureDirectory(): void {
    const sc = this.store.cfg.scim_config
    const c = sc?.config ?? {}
    const ds = directorySettings(sc).settings
    const iv = bulkSyncInterval(c.bulkSyncInterval)
    const on = ds !== undefined && syncMode(c, resolveEnv(c.provisioningToken ?? "")) === "off"
    const key = on ? JSON.stringify(ds) + "|" + `${iv.ms}` + (this.provisionOn ? "|timer" : "") : ""
    // every serving process sweeps its own sessions (they live in the process)
    if (this.provisionOn && this.sweepTimer < 0 && this.oidcCfg !== undefined) {
      this.sweepTimer = setInterval(() => {
        this.sweepSessions()
      }, 86400000)
    }
    if (key === this.dirKey) return
    this.dirKey = key
    if (this.dirTimer >= 0) {
      clearInterval(this.dirTimer)
      this.dirTimer = -1
    }
    this.dirNextMs = 0.0
    this.dirIntervalMs = 0.0
    if (!on) return
    if (iv.error !== "") console.error(`raiju: scim_config: ${iv.error}`)
    this.dirIntervalMs = iv.ms
    this.dirNextMs = Date.now() + iv.ms
    if (!this.provisionOn) return
    this.dirTimer = setInterval(() => {
      this.dirNextMs = Date.now() + this.dirIntervalMs
      // one process of the node takes each period's turn (a lease in the share folder), on the cluster's leader
      const ms = Math.floor(this.dirIntervalMs)
      const leases = this.shareDir === "" ? "" : this.shareDir + "/leases"
      if (!this.isLeader() || this.dirRunning || !takePeriod(new FileLease(leases, ms), "directory-sync", ms, Math.floor(Date.now()))) return
      this.runSync(newId("op_"), "sync", undefined)
    }, Math.floor(iv.ms))
  }

  // Starts the directory sync schedule and the session sweep in a serving process (main.tov, after the fork).
  startProvisioning(): void {
    this.provisionOn = true
    this.dirKey = "restart"
    this.configureDirectory()
  }

  // Records a provisioning job's state (the newest 50 are kept).
  jobSet(id: string, body: string): void {
    if (!this.provJobs.has(id)) this.provOrder.push(id)
    this.provJobs.set(id, body)
    while (this.provOrder.length > 50) {
      const old = this.provOrder[0]!
      this.provOrder = this.provOrder.slice(1)
      this.provJobs.delete(old)
    }
  }

  jobJson(id: string, op: string, status: string, startedMs: f64, plan: Plan | undefined, error: string): string {
    const parts: string[] = [`"operation_id":${JSON.stringify(id)}`, `"operation":${JSON.stringify(op)}`, `"status":${JSON.stringify(status)}`, `"started_at":${JSON.stringify(rfc3339Of(startedMs))}`]
    if (status !== "running") parts.push(`"finished_at":${JSON.stringify(rfc3339Of(Date.now()))}`)
    if (plan !== undefined) {
      parts.push(`"counts":${JSON.stringify(countsOf(plan.changes))}`)
      parts.push(`"changes":${JSON.stringify(plan.changes.slice(0, 500))}`)
    }
    if (error !== "") parts.push(`"error":${JSON.stringify(error)}`)
    return "{" + parts.join(",") + "}"
  }

  dirNow(): Directory {
    const g = this.store.cfg.governance ?? {}
    return { teams: g.teams ?? [], businessUnits: g.business_units ?? [], projects: g.projects ?? [], profiles: g.access_profiles ?? [] }
  }

  // A directory sync (op "sync": every user, then deprovisioning after a complete listing, each unlisted user first
  // confirmed inactive or gone with the directory) or a bulk import (op "import": the users the filter selects,
  // created or updated, nobody removed).
  async runSync(id: string, op: string, filter: ImportFilter | undefined): Promise<void> {
    const started = Date.now()
    this.dirRunning = true
    this.jobSet(id, this.jobJson(id, op, "running", started, undefined, ""))
    const sc = this.store.cfg.scim_config
    const ds = directorySettings(sc).settings
    if (ds === undefined) {
      this.jobSet(id, this.jobJson(id, op, "failed", started, undefined, directorySettings(sc).reason))
      this.dirRunning = false
      return
    }
    const listing = await listDirectory(ds)
    if (listing.error !== "" && (op === "sync" || listing.users.length === 0)) {
      this.jobSet(id, this.jobJson(id, op, "failed", started, undefined, listing.error))
      this.dirRunning = false
      return
    }
    const c = this.store.cfg.scim_config?.config ?? {}
    const mint = (p: string): string => randomId(p)
    let only: string[] | undefined = undefined
    if (filter !== undefined) {
      only = []
      for (const du of listing.users) {
        if (matchesFilter(du, filter, c)) only.push(accountName(du))
      }
    }
    let confirmed: string[] = []
    if (op === "sync" && listing.complete) {
      const first = planDirectory(this.store.cfg.governance?.users ?? [], this.dirNow(), listing.users, c, this.roleBook(), mint, undefined)
      for (const name of first.unlisted) {
        const l = await lookupUser(ds, name)
        if (l.kind === "inactive" || l.kind === "gone") confirmed.push(name)
      }
    }
    // planned again on the users as they are now, under the config file's lock (waited for without pausing the
    // worker), and saved at once
    const held = await this.store.holdLock()
    let err = "another process kept the config file's lock; run the sync again"
    let plan: Plan | undefined = undefined
    if (held.ok) {
      const dir = this.dirNow()
      const users = this.store.cfg.governance?.users ?? []
      let p = planDirectory(users, dir, listing.users, c, this.roleBook(), mint, only).plan
      if (confirmed.length > 0) p = withRemovals(users, p, confirmed, dir)
      plan = p
      err = this.applyPlan(p)
    }
    this.store.releaseLock(held)
    this.jobSet(id, this.jobJson(id, op, err === "" ? "completed" : "failed", started, plan, err))
    this.dirRunning = false
  }

  // /api/scim/provision/...: status, the import preview, import, sync, reconcile with its previews, and the jobs.
  async provisionRoute(method: string, path: string, body: string): Promise<Reply> {
    const ok = (status: int, b: string): Reply => ({ status: status, body: b, contentType: "application/json" })
    const bad = (status: int, msg: string): Reply => ok(status, errorJson(msg, "invalid_request_error", undefined))
    const sub = path.slice("/api/scim/provision".byteLength)
    const known = ["/status", "/jobs", "/preview", "/import", "/sync", "/reconcile", "/reconcile/preview", "/reconcile/preview/user"]
    if (!known.includes(sub) && !(sub.startsWith("/jobs/") && sub.byteLength > 6)) return bad(404, `no route for ${path}`)
    const wants = sub === "/status" || sub.startsWith("/jobs") ? "GET" : "POST"
    if (method !== wants) return bad(405, `use ${wants}`)
    const sc = this.store.cfg.scim_config
    if (sc === undefined || sc.enabled !== true || (sc.provider ?? "") === "") return bad(400, "user provisioning needs scim_config with a provider")
    const c = sc.config ?? {}
    const mode = syncMode(c, resolveEnv(c.provisioningToken ?? ""))
    const post = method === "POST"
    if (sub === "/status") {
      if (method !== "GET") return bad(405, "use GET")
      const dsr = directorySettings(sc)
      const dir = jobj([jkv("available", dsr.settings !== undefined && mode === "off" ? "true" : "false"), jkv("reason", JSON.stringify(mode !== "off" ? "SCIM provisioning is on: your identity provider pushes users" : dsr.reason)), jkv("interval_seconds", jn(this.dirIntervalMs / 1000.0)), jkv("next_run_at", this.dirNextMs > 0.0 ? JSON.stringify(rfc3339Of(this.dirNextMs)) : "null")])
      return ok(200, jobj([jkv("provider", JSON.stringify(sc.provider ?? "")), jkv("sync_mode", JSON.stringify(mode)), jkv("rules_hash", JSON.stringify(rulesHash(c, mode))), jkv("directory_sync", dir), jkv("session_sweep", this.sweepTimer >= 0 && mode === "off" ? "true" : "false")]))
    }
    if (sub === "/jobs" && method === "GET") {
      const out: string[] = []
      for (const id of this.provOrder.slice().reverse()) out.push(this.provJobs.get(id) ?? "{}")
      return ok(200, `{"jobs":[${out.join(",")}]}`)
    }
    if (sub.startsWith("/jobs/") && method === "GET") {
      const j = this.provJobs.get(sub.slice(6))
      return j === undefined ? bad(404, `no provisioning job ${sub.slice(6)}`) : ok(200, j)
    }
    let filter: ImportFilter = {}
    let ruleHash = ""
    let userIds: string[] | undefined = undefined
    let keepMissing = false
    let userId = ""
    if (post && body.trim() !== "") {
      try {
        const b = JSON.parse(body) as { groups?: string[], roles?: string[], departments?: string[], user_ids?: string[], keep_missing?: bool, rules_hash?: string, user_id?: string }
        filter = { groups: b.groups, roles: b.roles, departments: b.departments, user_ids: b.user_ids }
        userIds = b.user_ids
        keepMissing = b.keep_missing === true
        ruleHash = b.rules_hash ?? ""
        userId = b.user_id ?? ""
      } catch (e) {
        return bad(400, "the body must be a JSON object")
      }
    }
    const directoryOps = sub === "/preview" || sub === "/import" || sub === "/sync"
    if (directoryOps) {
      if (!post) return bad(405, "use POST")
      if (mode !== "off") return bad(403, "SCIM provisioning is on: bulk import and directory sync are unavailable; your identity provider pushes users")
      const dsr = directorySettings(sc)
      const ds = dsr.settings
      if (ds === undefined) return bad(400, "directory access is not configured: " + dsr.reason)
      if (sub === "/preview") return ok(200, await this.importPreview(ds, filter))
      if (this.dirRunning) return bad(409, "a directory sync or import is already running")
      const id = newId("op_")
      this.runSync(id, sub === "/sync" ? "sync" : "import", sub === "/sync" ? undefined : filter)
      return ok(202, `{"operation_id":${JSON.stringify(id)},"status":"running"}`)
    }
    if (sub === "/reconcile" || sub === "/reconcile/preview" || sub === "/reconcile/preview/user") {
      if (!post) return bad(405, "use POST")
      const hash = rulesHash(c, mode)
      if (sub === "/reconcile/preview/user") {
        if (userId === "") return bad(400, "user_id is required")
        const one = planReconcile(this.store.cfg.governance?.users ?? [], this.dirNow(), c, mode, this.roleBook(), (p: string): string => randomId(p), [userId, userId.toLowerCase()], keepMissing)
        if (one.changes.length === 0) return bad(404, `no user ${userId}`)
        return ok(200, `{"rules_hash":${JSON.stringify(hash)},"change":${JSON.stringify(one.changes[0]!)}}`)
      }
      const plan = planReconcile(this.store.cfg.governance?.users ?? [], this.dirNow(), c, mode, this.roleBook(), (p: string): string => randomId(p), userIds, keepMissing)
      if (sub === "/reconcile/preview") {
        const changed = plan.changes.filter((x) => x.action === "update" || x.action === "refuse")
        const losing = plan.changes.filter((x) => x.loses_all_profiles).map((x) => x.user)
        return ok(200, `{"rules_hash":${JSON.stringify(hash)},"sync_mode":${JSON.stringify(mode)},"total":${plan.changes.length},"changed":${changed.length},"counts":${JSON.stringify(countsOf(plan.changes))},"sample":${JSON.stringify(changed.slice(0, 50))},"losing_all_profiles":${JSON.stringify(losing)}}`)
      }
      if (ruleHash !== "" && ruleHash !== hash) return bad(409, "the rules changed since the preview; preview again")
      // planned again and saved under the config file's lock (the users may have changed while it was waited for);
      // the closure reads constants (a captured `let` of a union type does not compile)
      const ids = userIds
      const keep = keepMissing
      return await this.underLock(method, () => {
        const fresh = planReconcile(this.store.cfg.governance?.users ?? [], this.dirNow(), c, mode, this.roleBook(), (p: string): string => randomId(p), ids, keep)
        const id = newId("op_")
        const started = Date.now()
        const err = this.applyPlan(fresh)
        const job = this.jobJson(id, "reconcile", err === "" ? "completed" : "failed", started, fresh, err)
        this.jobSet(id, job)
        return ok(err === "" ? 200 : 500, job)
      })
    }
    return bad(404, `no route for ${path}`)
  }

  // The bulk import preview: up to 50 directory users the filter selects, with what an import would do to each, and
  // the groups to filter by.
  async importPreview(ds: DirSettings, filter: ImportFilter): Promise<string> {
    const listing = await listDirectory(ds)
    if (listing.error !== "" && listing.users.length === 0) return JSON.stringify({ error: { message: "the directory could not be listed: " + listing.error, type: "api_error" } })
    const c = this.store.cfg.scim_config?.config ?? {}
    const users = this.store.cfg.governance?.users ?? []
    const out: string[] = []
    let total = 0
    for (const du of listing.users) {
      if (!matchesFilter(du, filter, c)) continue
      total += 1
      if (out.length >= 50) continue
      const name = accountName(du)
      const p = planDirectory(users, this.dirNow(), [du], c, this.roleBook(), (x: string): string => x + "preview", [name]).plan
      const ch = p.changes[0]
      out.push(jobj([jkv("id", JSON.stringify(du.id)), jkv("email", JSON.stringify(du.email)), jkv("name", JSON.stringify(du.displayName)), jkv("active", du.active ? "true" : "false"), jkv("groups", JSON.stringify(du.claims.get("groups") ?? [])), jkv("exists", findUser(users, name, du.email) >= 0 ? "true" : "false"), jkv("plan", ch === undefined ? "null" : JSON.stringify(ch))]))
    }
    return `{"users":[${out.join(",")}],"total":${total},"truncated":${total > out.length},"groups":${JSON.stringify(listing.groups)}${listing.error === "" ? "" : `,"warning":${JSON.stringify(listing.error)}`}}`
  }

  // A SCIM request's users with the mapping rules applied to what SCIM pushed (Bifrost's SCIM attribute mapping), the
  // teams and business units the rules made, and the changes; nothing changes when the provider maps nothing.
  scimResynced(before: AdminUserConfig[], after: AdminUserConfig[], teams: TeamConfig[]): Plan {
    const c = this.store.cfg.scim_config?.config ?? {}
    const g = this.store.cfg.governance ?? {}
    const dir: Directory = { teams: teams, businessUnits: g.business_units ?? [], projects: g.projects ?? [], profiles: g.access_profiles ?? [] }
    return scimResync(before, after, dir, c, this.roleBook(), (p: string): string => randomId(p))
  }

  configureAlerts(al: AlertsConfig | undefined): void {
    const on = al !== undefined && al.enabled !== false && ((al.rules ?? []).length > 0 || (al.cel_rules ?? []).length > 0)
    // a changed rule set starts over; an unchanged one keeps its state
    const key = on ? JSON.stringify(al) : ""
    if (key === this.alertsKey) return
    this.alertsKey = key
    if (this.alertTimer >= 0) {
      clearInterval(this.alertTimer)
      this.alertTimer = -1
    }
    if (!on || al === undefined) {
      this.alerts = undefined
      this.cel = undefined
      this.engine.samples = undefined
      return
    }
    const eng = new AlertEngine(al.rules ?? [], al.channels ?? [])
    this.alerts = eng
    const ce = new CelEngine(al.cel_rules ?? [], al.channels ?? [])
    for (const e of ce.errors()) console.error(`raiju: alert rule: ${e}`)
    this.cel = ce
    if (this.engine.samples === undefined) this.engine.samples = new SampleRing(50000)
    const secs = Math.max(1, al.interval_seconds ?? 30)
    this.alertTimer = setInterval(() => {
      if (this.isLeader()) this.tick(eng)
    }, secs * 1000)
  }

  tick(eng: AlertEngine): void {
    // a budget that is used up is noticed once an hour until it resets (notify.tov)
    for (const b of this.engine.gov.budgetUsage()) {
      if (b.limit > 0 && b.used >= b.limit) notifyOnce("budget:" + b.id, 3600000, { severity: "warning", title: "Budget used up", message: `Budget ${b.id} is used up until it resets.` })
    }
    const ring = this.engine.samples
    if (ring === undefined) return
    const now = Date.now()
    let longest = 300
    for (const r of eng.rules) longest = Math.max(longest, r.window_seconds ?? 300)
    const open: string[] = []
    for (const t of this.engine.health.snapshot(now)) {
      if (t.state === "open") open.push(t.id)
    }
    const notes = eng.evaluate({ samples: ring.since(now - longest * 1000.0), budgets: this.engine.gov.budgetUsage(), rateLimits: this.engine.gov.rateLimitUsage(now), openBreakers: open }, now)
    for (const n of notes) {
      const r = alerts.request(n)
      sendAlert(r.url, r.headers, r.body, n.ruleId)
      notify({ severity: n.kind === "firing" ? "warning" : "success", title: `Alert ${n.ruleId} ${n.kind}`, message: `Alert rule ${n.ruleId} is ${n.kind}.` })
    }
    const ce = this.cel
    if (ce !== undefined) {
      const scopes: ScopeUsage[] = []
      for (const r of ce.rules) {
        const u = this.engine.gov.scopeUsage(r.scope_type, r.scope_id, now)
        if (u !== undefined) scopes.push(u)
      }
      for (const n of ce.evaluate(scopes, now)) {
        const r = alerts.request(n)
        sendAlert(r.url, r.headers, r.body, n.ruleId)
        notify({ severity: n.kind === "firing" ? "warning" : "success", title: `Alert ${n.ruleId} ${n.kind}`, message: `Alert rule ${n.ruleId} is ${n.kind}.` })
      }
    }
  }

  // The data scope of the actor a gate named. A stored user's custom role decides it; anyone else (the
  // legacy admin, and sign-in and proxy identities, which hold built-in roles) sees all data.
  scopeOfActor(actor: string): DataScope {
    return this.scopeOfActorFor(actor, "")
  }

  // The same for one resource: the role's entity_dac entry for it (Bifrost's per-resource override) wins
  // over the role's dac.
  scopeOfActorFor(actor: string, resource: string): DataScope {
    const name = actor.startsWith("proxy:") ? actor.slice(6) : actor
    const gov = this.store.cfg.governance
    for (const u of gov?.users ?? []) {
      if (u.name !== name) continue
      const r = customRole(gov?.roles, u.role)
      // the scope names its user: what the user created or holds stays theirs (and a creation records them)
      if (r === undefined) {
        let a = allScope()
        a.user = u.name
        return a
      }
      let dac = r.dac ?? "all-data"
      for (const e of r.entity_dac ?? []) {
        if (e.resource === resource) dac = e.dac
      }
      let s = scopeOf(gov ?? {}, u, dac)
      s.user = u.name
      return s
    }
    return allScope()
  }

  // check() with the data scope of the caller, for the routes that read scoped data.
  checkScope(req: Request, path: string): { res: Response | undefined, scope: DataScope } {
    const g = this.gate(req, path)
    if (g.kind === "deny") return { res: g.res, scope: noScope() }
    return { res: undefined, scope: this.scopeOfActor(g.actor) }
  }

  // The /ws event for a management write that succeeded: the resource it changed, as Bifrost's
  // store_update tags (the first path segment under /api).
  // It goes through the feed like a log event, so it reaches every worker's and node's clients and a client that
  // resumes with since= gets the store updates it missed.
  storeUpdated(path: string): void {
    const seg = path.split("/")[2] ?? ""
    const it: FeedItem = { node: this.feedProducer(), seq: this.ui.nextSeq(), ts: Date.now(), team: "", bu: "", customer: "", project: "", data: JSON.stringify({ id: newId("su_"), tags: [seg] }), kind: "store_update" }
    this.ui.ingest(it, "local")
  }

  // The single sign-on session a token names, or undefined when there is none or its user is now disabled in
  // governance: a deactivated user's session stops at its next request.
  liveSession(token: string): Session | undefined {
    const s = this.sessions.get(token, Date.now())
    if (s === undefined) return undefined
    if (disabledNamed(this.rbac, ssoNames(s.sub, s.email))) return undefined
    return s
  }

  // Whether the caller may use this /api route; the actor names them in the audit log.
  gate(req: Request, path: string): Gate {
    // client.whitelisted_routes: these exact paths skip authentication (Bifrost)
    if ((this.store.cfg.client?.whitelisted_routes ?? []).includes(path)) return { kind: "ok", actor: "anonymous" }
    const pg = this.proxyGate(req, path)
    if (pg !== undefined) return pg
    const auth = req.headers.get("authorization") ?? ""
    if (auth.startsWith("Bearer sk-sess-")) {
      const s = this.liveSession(auth.slice(7))
      // a single sign-on session holds a built-in role
      const role = s === undefined ? undefined : (isBuiltinRole(s.role) ? s.role : undefined)
      if (s === undefined || role === undefined) return { kind: "deny", res: denied(401, "the session expired; sign in again") }
      // a user-mode per-user flow is opened by its own user, whatever the user's role (the route checks the user again)
      if (req.method === "GET" && ownUserFlow(path, s.sub)) return { kind: "ok", actor: "sso:" + s.sub }
      const perm = required(req.method, path)
      if (!roleAllows(this.store.cfg.governance?.roles, role, req.method, path)) {
        this.recordChange("sso:" + s.sub, req, path, 403, "")
        return { kind: "deny", res: denied(403, `role ${role} may not ${perm} this route`) }
      }
      return { kind: "ok", actor: "sso:" + s.sub }
    }
    if (!this.authOn) return this.setupLock(req, path)
    // a temp token (client.mcp_enable_temp_token_auth) opens the per-user consent flow it was minted for
    if (this.store.cfg.client?.mcp_enable_temp_token_auth === true && tempTokenAllows(req.headers.get("x-bifrost-temp-token") ?? "", req.method, path, Date.now())) return { kind: "ok", actor: "temp-token" }
    const v = authorize(this.rbac, snapshot(req.headers), req.method, path)
    if (v.kind === "ok") {
      if (v.actor.startsWith("key:")) this.keyUsed.set(v.actor.slice(4), rfc3339Of(Date.now()))
      this.applyUpgrades()
      return { kind: "ok", actor: v.actor }
    }
    this.recordChange("unauthenticated", req, path, v.status, "")
    if (v.status === 429) return { kind: "deny", res: throttled(v.retry_after ?? 1) }
    return { kind: "deny", res: denied(v.status, v.message) }
  }

  // Who is consenting on an MCP OAuth consent request (Bifrost's identity resolver): the dashboard sign-in, the
  // identity-provider user of a single sign-on session (user mode, offered while OIDC is on), and the settings that
  // decide the modes offered.
  // needed is false on the routes that read none of it, so they cost no credential check.
  consentContext(req: Request, needed: bool): ConsentContext {
    const auth = req.headers.get("authorization") ?? ""
    let user = ""
    let name = ""
    if (needed && this.oidcCfg !== undefined && auth.startsWith("Bearer sk-sess-")) {
      const s = this.liveSession(auth.slice(7))
      if (s !== undefined) {
        user = s.sub
        name = s.email ?? ""
      }
    }
    const disable = this.engine.cfg.client?.oauth2_server_config?.disable_vk_identity === true
    return { signedIn: needed && (user !== "" || this.consentSignedIn(req)), enforce: this.engine.gov.enforce, userAvailable: this.oidcCfg !== undefined, disableVk: disable, user: user, userName: name, userActive: (sub: string): bool => this.userActive(sub) }
  }

  // Whether an identity-provider user may still use a user-mode grant: governance does not list the user as disabled
  // (a SCIM deactivation, say), as for the single sign-on sessions.
  userActive(sub: string): bool {
    return !disabledNamed(this.rbac, ssoNames(sub, undefined))
  }

  // The identity-provider user a request's single sign-on session names, or "".
  sessionUser(req: Request): string {
    const auth = req.headers.get("authorization") ?? ""
    if (!auth.startsWith("Bearer sk-sess-")) return ""
    const s = this.liveSession(auth.slice(7))
    return s === undefined ? "" : s.sub
  }

  // The operator's setup token: setup_token (env.NAME allowed), else the BIFROST_SETUP_TOKEN environment variable, as
  // Bifrost's resolveSetupToken reads them. "" when neither is set.
  setupToken(): string {
    const configured = resolveEnv(this.store.cfg.setup_token ?? "").trim()
    if (configured !== "") return configured
    return (process.env.BIFROST_SETUP_TOKEN ?? "").trim()
  }

  // The start-up warnings about open surfaces (Bifrost prints the first as a banner): /api is locked until an admin
  // exists, and inference is open to anyone who reaches the port while auth is not enforced on it.
  startupWarnings(): string[] {
    const out: string[] = []
    if (!this.authOn) {
      if (this.setupToken() !== "") out.push("no admin account is configured: /api is locked until one is created; send the setup token in the X-Bifrost-Setup-Token header (POST /api/users creates the first admin)")
      else out.push("no admin account and no setup token are configured: /api is locked (403); set setup_token in config.json (or the BIFROST_SETUP_TOKEN env var) and restart to finish setup")
    }
    if (!this.engine.gov.enforce) out.push("inference is not authenticated (client.enforce_auth_on_inference is off): anyone who reaches this port can use the provider keys")
    if (this.metricsOpen()) out.push("/metrics is open on the main port and its labels name virtual keys, teams and customers: set server.metrics_token, or move it to the cluster listener with cluster.serve_metrics")
    const dups = duplicateNames(this.engine.cfg)
    if (dups.length > 0) out.push(duplicateNamesText(dups))
    return out
  }

  // The dashboard notice for duplicate virtual key, team and customer names (saved before names were unique), published
  // by each serving worker at start; none when there are none.
  noticeDuplicateNames(): void {
    const dups = duplicateNames(this.engine.cfg)
    if (dups.length === 0) return
    notify({ severity: "warning", title: "Duplicate names", message: duplicateNamesText(dups) })
  }

  // Whether anyone who reaches the main port can read /metrics: no server.metrics_token, and not moved to the cluster
  // listener (cluster.serve_metrics with cluster.listen_port).
  metricsOpen(): bool {
    return (this.engine.cfg.server?.metrics_token ?? "") === "" && !this.metricsOnCluster
  }

  // Bifrost's setup lock (SetupLockMiddleware): while no admin account exists, every /api route but the public ones
  // needs the operator's setup token in X-Bifrost-Setup-Token (a wrong one is a 403) or the setup session cookie that
  // POST /api/session/setup trades it for (401 without either); the caller then acts as the admin. With no setup
  // token configured the API is locked outright (a 403 for everything but the public routes), as in Bifrost.
  setupLock(req: Request, path: string): Gate {
    if (setupPublic(path)) return { kind: "ok", actor: "anonymous" }
    const want = this.setupToken()
    if (want === "") return { kind: "deny", res: denied(403, LOCKED_MESSAGE) }
    const given = req.headers.get("x-bifrost-setup-token") ?? ""
    if (given !== "") {
      // guesses are throttled per client address
      const ipKeys: string[] = clientIp(req) === "" ? [] : [addressKey(clientIp(req))]
      const wait = signInGuard().retryAfter(ipKeys, Date.now())
      if (wait > 0) return { kind: "deny", res: throttled(wait) }
      if (!sameSecret(given, want)) {
        signInGuard().fail(ipKeys, Date.now())
        return { kind: "deny", res: denied(403, "invalid setup token") }
      }
      return { kind: "ok", actor: "setup-token" }
    }
    if (validSetupSession(cookieValue(req.headers.get("cookie") ?? "", SETUP_COOKIE), want, Date.now())) return { kind: "ok", actor: "setup-token" }
    return { kind: "deny", res: denied(401, "dashboard auth is not configured; send the setup token in the X-Bifrost-Setup-Token header") }
  }

  // Whether a request carries a dashboard sign-in (a session token, or admin credentials): the identity a session-mode
  // consent grants (Bifrost's consentIdentityPresent). With dashboard auth off there is none.
  consentSignedIn(req: Request): bool {
    if (!this.authOn) return false
    const auth = req.headers.get("authorization") ?? ""
    if (auth.startsWith("Bearer sk-sess-")) return this.liveSession(auth.slice(7)) !== undefined
    return authorize(this.rbac, snapshot(req.headers), "GET", "/api/users/me/permissions").kind === "ok"
  }

  // ---- identity-aware proxy (AWS ALB, Cloudflare Access, a generic JWT proxy) ----

  configureProxy(ap: AuthProxyConfig | undefined, oc: OidcConfig | undefined): void {
    this.proxyRoles = oc
    const key = ap !== undefined && ap.enabled ? JSON.stringify(ap) : ""
    if (key === this.proxyKey) return
    this.proxyKey = key
    this.proxyCfg = undefined
    this.proxyKeys = undefined
    if (ap === undefined || !ap.enabled) return
    const problem = proxyProblem(ap)
    if (problem !== "") {
      console.error(`raiju: auth proxy: ${problem}; the proxy is off`)
      return
    }
    const ks = new ProxyKeys(ap)
    this.proxyCfg = ap
    this.proxyKeys = ks
    ks.warm(Date.now())
  }

  // The identity the proxy names for a request, as a gate. Undefined when the proxy header is absent,
  // so the usual sign-in applies (as Bifrost does without its proxy header).
  proxyGate(req: Request, path: string): Gate | undefined {
    const pc = this.proxyCfg
    const keys = this.proxyKeys
    if (pc === undefined || keys === undefined) return undefined
    const token = req.headers.get(headerOf(pc)) ?? ""
    if (token === "") return undefined
    const now = Date.now()
    const c = checkProxyToken(pc, keys, token, now)
    if (c.kind === "unknown") {
      keys.want(c.kid, now)
      return { kind: "deny", res: denied(401, "the proxy's signing key is not loaded yet; retry") }
    }
    if (c.kind === "error") {
      this.recordChange("unauthenticated", req, path, 401, "")
      return { kind: "deny", res: denied(401, c.message) }
    }
    let role: Role | undefined = undefined
    if ((pc.mode ?? "login_only") === "full") {
      // the SSO login's role mapping: role_claim, role_map and default_role of the provider
      const oc = this.proxyRoles
      let mapped: string | undefined = undefined
      try {
        mapped = try mappedRole(c.claims, oc?.role_claim, oc?.role_map, oc?.default_role)
      } catch (e) {
        mapped = undefined
      }
      if (mapped === undefined) {
        this.recordChange("proxy:" + c.identity, req, path, 403, "")
        return { kind: "deny", res: denied(403, "no role maps from the proxy token") }
      }
      role = isBuiltinRole(mapped) ? mapped : undefined
    } else {
      // login only: the identity must already be an enabled user, and its role governs
      const u = provisioned(this.rbac, c.identity)
      if (u === undefined) {
        this.recordChange("proxy:" + c.identity, req, path, 403, "")
        return { kind: "deny", res: denied(403, `${c.identity} is not provisioned`) }
      }
      role = u.role
    }
    if (role === undefined) return { kind: "deny", res: denied(403, "the mapped role is not known") }
    const perm = required(req.method, path)
    if (!roleAllows(this.store.cfg.governance?.roles, role, req.method, path)) {
      this.recordChange("proxy:" + c.identity, req, path, 403, "")
      return { kind: "deny", res: denied(403, `role ${role} may not ${perm} this route`) }
    }
    return { kind: "ok", actor: "proxy:" + c.identity }
  }

  // The gate for read-only routes: undefined when allowed.
  check(req: Request, path: string): Response | undefined {
    const g = this.gate(req, path)
    return g.kind === "deny" ? g.res : undefined
  }

  // Saves the bcrypt hashes found for users who signed in with an old salted SHA-256 password (rbac.tov takeUpgrades).
  applyUpgrades(): void {
    const ups = takeUpgrades()
    if (ups.length === 0) return
    const r = this.store.upgradePasswords(ups)
    if (r.kind === "error") console.error(`raiju: password upgrade not saved: ${r.message}`)
  }

  // Runs change, code that may save the config and does not await, under the config file's lock: waited for without
  // pausing the worker; 503 without running change when another process keeps it. A GET runs change as it is.
  //
  // Group commit: the changes of this worker that arrive while one waits for the lock queue behind it, and the one that
  // gets the lock runs them all, in arrival order, under that one hold with one file write (ConfigStore.group). Each
  // change still gets its own reply (its own 400 or 409 when refused). Changes that queue while a group runs form the
  // next group, with a leader of their own.
  async underLock(method: string, change: () => Reply): Promise<Reply> {
    if (method === "GET") return change()
    const w = new LockWaiter(change)
    const p = new Promise<Reply>((resolve) => {
      w.done = resolve
    })
    this.lockQueue.push(w)
    if (!this.lockLeading) await this.leadGroup()
    return await p
  }

  // Takes the config file's lock for the changes queued by the time it is held and runs them as one group.
  private async leadGroup(): Promise<void> {
    this.lockLeading = true
    // one turn of the event loop first, so the requests already read join this group even when the lock is free
    await new Promise<void>((resolve) => {
      setTimeout(() => resolve(), 0)
    })
    const held = await this.store.holdLock()
    const group = this.lockQueue
    this.lockQueue = []
    let replies: Reply[] = []
    if (held.ok) {
      replies = this.store.group(group.map((w) => w.change), groupFailed)
    } else {
      for (const w of group) replies.push(lockBusyReply())
    }
    this.store.releaseLock(held)
    this.lockLeading = false
    for (let i = 0; i < group.length; i++) group[i]!.done(replies[i]!)
    // the changes that queued meanwhile: the next group
    if (this.lockQueue.length > 0) this.leadGroup()
  }

  // syncSignIn under the config file's lock (a sign-in's claims may save users, teams and business units).
  async syncSignInLocked(sub: string, email: string | undefined, payload: string): Promise<{ kind: "none" } | { kind: "role", role: string } | { kind: "refuse", reason: string }> {
    const held = await this.store.holdLock()
    if (!held.ok) {
      this.store.releaseLock(held)
      return { kind: "refuse", reason: "another process kept the configuration file's lock; sign in again" }
    }
    const r = this.syncSignIn(sub, email, payload)
    this.store.releaseLock(held)
    return r
  }

  recordChange(actor: string, req: Request, path: string, status: int, body: string): void {
    const log = this.audit
    const m = req.method
    if (log === undefined || m === "GET" || m === "HEAD" || m === "OPTIONS") return
    const q = path.indexOf("?")
    const a = actionFor(m, q < 0 ? path : path.slice(0, q))
    // the client's address as the server resolved it: the TCP peer, or what a trusted proxy forwarded (clientip.tov)
    const ip0 = clientIp(req)
    const ip = ip0 === "" ? undefined : ip0
    const detail = maskDetail(body)
    try {
      // omit_ip_addresses: the event keeps no client address
      const kept = this.store.cfg.audit?.omit_ip_addresses === true ? undefined : ip
      log.record(actor, a.action, a.target, m, path, status, kept, detail === "" ? undefined : detail, Date.now())
    } catch (e) {
      metrics.inc("raiju_audit_write_errors_total", "", 1.0)
      console.error(`raiju: audit write failed: ${e.message}`)
    }
  }

  // /api/users*: the reply, after saving any change through the config store.
  // GET /api/governance/virtual-keys/quota: the calling key's own budgets, rate limits and provider
  // configs with their usage. Self-service, as Bifrost's: the key in the request is the credential, and
  // an expired key is refused. model_configs lists the key's per-model limits (governance.model_configs
  // scoped to this key, the "*" ones left out as Bifrost does) with their budgets' and rate limit's usage.
  vkQuota(req: Request): Reply {
    const vk = this.engine.gov.findKey(snapshot(req.headers))
    if (vk === undefined) return { status: 401, body: errorJson("a valid virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", "authentication_error", undefined), contentType: "application/json" }
    if (this.engine.gov.expired(vk)) return { status: 403, body: errorJson("Virtual key has expired", "permission_error", undefined), contentType: "application/json" }
    const g = this.store.cfg.governance
    const now = Date.now()
    const usage = this.engine.gov.budgetUsage()
    const limits = this.engine.gov.rateLimitUsage(now)
    const ids = keyBudgetIds(vk)
    // a budget's usage is read from its window: the shared one, or (suffix "@user/<name>") a held profile's copy
    const quotaBudgets = (want: string[], suffix: string, src: AccessProfile | undefined): QuotaBudget[] => {
      const out: QuotaBudget[] = []
      for (const b of g?.budgets ?? []) {
        if (!want.includes(b.id)) continue
        const u = usage.find((x) => x.id === b.id + suffix)
        const qb: QuotaBudget = { id: b.id, max_limit: b.max_limit, effective_max_limit: u?.limit ?? b.max_limit, reset_duration: b.reset_duration, current_usage: u?.used ?? 0.0 }
        if (src !== undefined) {
          qb.source_type = "access_profile"
          qb.source_id = src.id
          qb.source_name = src.name ?? src.id
        }
        out.push(qb)
      }
      return out
    }
    const quotaRates = (want: string, suffix: string, src: AccessProfile | undefined): QuotaRate[] => {
      const out: QuotaRate[] = []
      for (const rl of g?.rate_limits ?? []) {
        if (rl.id !== want) continue
        const used: QuotaRateUsage[] = limits.filter((x) => x.id === rl.id + suffix).map((x) => ({ kind: x.kind, used: x.used, limit: x.limit }))
        const qr: QuotaRate = { id: rl.id, token_max_limit: rl.token_max_limit, token_reset_duration: rl.token_reset_duration, request_max_limit: rl.request_max_limit, request_reset_duration: rl.request_reset_duration, usage: used }
        if (src !== undefined) {
          qr.source_type = "access_profile"
          qr.source_id = src.id
          qr.source_name = src.name ?? src.id
        }
        out.push(qr)
      }
      return out
    }
    // A key whose user holds access profiles is governed by them (Bifrost's access-profile quota): each held profile's
    // budget and rate limit is listed with the profile as its source, its usage the user's own copy, and the per-model
    // spend is the user's. The key's own budgets follow, since every held budget and the key's own are all charged.
    const user = vk.user_id ?? ""
    const held: AccessProfile[] = user === "" ? [] : heldProfiles(g?.users, g?.roles, g?.access_profiles, user).filter((p) => p.is_active !== false)
    const budgets: QuotaBudget[] = []
    const rateLimits: QuotaRate[] = []
    const seenB: string[] = []
    const seenR: string[] = []
    for (const p of held) {
      const bid = p.budget_id
      if (bid !== undefined && !seenB.includes(bid)) {
        seenB.push(bid)
        for (const qb of quotaBudgets([bid], `@user/${user}`, p)) budgets.push(qb)
      }
      const rid = p.rate_limit_id
      if (rid !== undefined && !seenR.includes(rid)) {
        seenR.push(rid)
        for (const qr of quotaRates(rid, `@user/${user}`, p)) rateLimits.push(qr)
      }
    }
    for (const qb of quotaBudgets(ids, "", undefined)) budgets.push(qb)
    for (const qr of quotaRates(vk.rate_limit_id ?? "", "", undefined)) rateLimits.push(qr)
    // each budget's spend per model in its current cycle, from the request logs (none without a log store)
    const ls = this.engine.logStore
    const es: LogEntry[] = ls === undefined ? [] : ls.viewSince(0.0)
    for (let i = 0; i < budgets.length; i++) {
      const qb = budgets[i]!
      const suffix = qb.source_type === undefined ? "" : `@user/${user}`
      const start = this.engine.gov.budgetCycleStart(qb.id + suffix, now) ?? now
      budgets[i]!.per_model_usage = perModelUsage(es, vk.id, qb.source_type === undefined ? "" : user, start, now)
    }
    const models: QuotaModel[] = []
    for (const mc of g?.model_configs ?? []) {
      if (mc.scope !== "virtual_key" || mc.scope_id !== vk.id || mc.model_name === "*") continue
      const bids: string[] = []
      if (mc.budget_id !== undefined) bids.push(mc.budget_id)
      for (const b of mc.budget_ids ?? []) {
        if (!bids.includes(b)) bids.push(b)
      }
      const row: QuotaModel = { model_name: mc.model_name, provider: mc.provider, budgets: quotaBudgets(bids, "", undefined) }
      const rl = quotaRates(mc.rate_limit_id ?? "", "", undefined)[0]
      if (rl !== undefined) row.rate_limit = rl
      models.push(row)
    }
    const body = JSON.stringify({ virtual_key_name: vk.name ?? "", is_active: vk.is_active !== false, budgets: budgets, rate_limits: rateLimits, provider_configs: vk.provider_configs ?? [], model_configs: models })
    return { status: 200, body: body, contentType: "application/json" }
  }

  // The expired-key cleanup, hourly (Bifrost runs it daily). Only one process runs it: a worker's copy
  // of the config may be behind the file, and saving that copy would undo the workers' changes.
  startExpirySweep(): void {
    setInterval(() => {
      const done = sweepExpiredKeys(this.store, Date.now())
      if (done.length > 0) console.error(`raiju: deleted ${done.length} expired virtual key${done.length === 1 ? "" : "s"}`)
      this.auditRetention()
    }, 3600000)
    // the audit archive wakes every archive interval, and at least hourly (as Bifrost's job), so a window that
    // closes just after a pass does not wait a whole interval
    const every = Math.min(3600000.0, archiveIntervalMs(this.store.cfg.audit?.archive?.interval_seconds))
    setInterval(() => {
      this.auditArchive()
    }, every)
  }

  // Retention: deletes the audit events older than audit.retention_days (AuditLog.pruneBefore).
  auditRetention(): void {
    const days = this.store.cfg.audit?.retention_days ?? 0
    const log = this.audit
    if (log === undefined || days <= 0) return
    try {
      const n = log.pruneBefore(Date.now() - days * 86400000)
      if (n > 0) console.error(`raiju: audit retention removed ${n} event${n === 1 ? "" : "s"}`)
    } catch (e) {
      console.error(`raiju: audit retention failed: ${e.message}`)
    }
  }

  // The archive copy, as Bifrost's: time is cut into fixed windows of archive_interval aligned to the epoch,
  // and each window that has closed (archive_grace_period past its end) goes to object storage in order, one
  // at a time (audit_archive.tov planWindow): parts cut at archive_max_object_bytes, gzipped when
  // archive_compress is set, then the manifest that commits the window. The mark moves to a window's end only
  // after its manifest is stored, so a failed window is retried whole on the next pass and later windows wait.
  // A retried window can leave a part from the failed try that its manifest does not list (Bifrost's readers
  // go by the manifest). The first run only sets the mark, so events written before archiving was turned on
  // are not copied. Rows are never deleted here.
  async auditArchive(): Promise<void> {
    const log = this.audit
    const ac = this.store.cfg.audit?.archive
    if (log === undefined || ac === undefined || !ac.enabled) return
    try {
      const now = Date.now()
      const first = log.archiveMark()
      if (first === undefined) {
        log.setArchiveMark({ seq: log.lastSequence(), until: now })
        return
      }
      const interval = archiveIntervalMs(ac.interval_seconds)
      const grace = archiveGraceMs(this.store.cfg.audit?.archive_grace_seconds, interval)
      const ec: LogExportsConfig = {
        enabled: ac.enabled, kind: ac.kind, bucket: ac.bucket, prefix: ac.prefix, region: ac.region, endpoint: ac.endpoint,
        access_key_id: ac.access_key_id, secret_access_key: ac.secret_access_key, session_token: ac.session_token,
        interval_seconds: ac.interval_seconds, path_style: ac.path_style, format: ac.format, retention_days: ac.retention_days,
      }
      let mark = first
      // a pass catches up on at most a day's worth of short windows; the rest wait for the next pass
      for (const win of closedWindows(mark.until, interval, grace, now, 288)) {
        const w = log.exportWindow(mark.seq, win.end)
        const plan = planWindow(ac.prefix ?? "bifrost", win.start, win.end, w.body, maxObjectBytes(this.store.cfg.audit?.archive_max_object_bytes), this.store.cfg.audit?.archive_compress === true, Date.now())
        for (const o of plan.objects) {
          const req = putObjectRequest(ec, o.key, o.body, o.contentType, Date.now())
          if (!(await this.archivePut(req))) return
        }
        mark = { seq: w.last, until: win.end }
        log.setArchiveMark(mark)
      }
    } catch (e) {
      console.error(`raiju: audit archive failed: ${e.message}`)
    }
  }

  // One archive object's upload, tried up to three times with a growing pause. False when every try failed.
  async archivePut(req: ByteRequest): Promise<bool> {
    for (let attempt = 1; attempt <= 3; attempt++) {
      let ok = false
      const dl = deadline(30000)
      try {
        const hs: Record<string, string> = req.headers
        const r = await fetch(req.url, { method: "PUT", headers: hs, body: req.body, signal: dl.controller.signal })
        await r.text()
        ok = r.status >= 200 && r.status < 300
        if (!ok) console.error(`raiju: audit archive: HTTP ${r.status} from ${req.url}`)
      } catch (e) {
        console.error(`raiju: audit archive: ${e.message}`)
      }
      dl.finish()
      if (ok) return true
      if (attempt < 3) await new Promise<void>((resolve) => setTimeout(resolve, 1000 * attempt))
    }
    return false
  }

  // /api/users/me/permissions: the caller's role and its (resource, operation) pairs with their ids. A built-in
  // role's fixed rules are expanded into pairs (rbac.tov builtinPairs) and it carries its fixed role_id.
  mePermissions(actor: string): Reply {
    const me = this.mePairs(actor)
    const ids = permissionIds(RESOURCES, OPERATIONS, me.pairs)
    const docs = permissionDocs(RESOURCES, OPERATIONS).filter((d) => ids.includes(d.id))
    const out: { user: string, role: string, role_id?: int, built_in: bool, permissions: PermissionDoc[] } = { user: actor, role: me.role, built_in: me.builtIn, permissions: docs }
    if (me.roleId !== undefined) out.role_id = me.roleId
    return { status: 200, body: JSON.stringify(out), contentType: "application/json" }
  }

  // GET /api/governance/users/me/permissions: the same pairs in Bifrost's PermissionsResponse shape, every
  // resource with every operation set true or false.
  mePermissionMap(actor: string): Reply {
    return { status: 200, body: permissionMap(this.mePairs(actor).pairs, RESOURCES, OPERATIONS), contentType: "application/json" }
  }

  // The caller's role and pairs: a management API key's own permissions, else the stored user's role (a caller
  // with no stored user, the legacy admin credential, is the admin).
  mePairs(actor: string): { role: string, roleId?: int, builtIn: bool, pairs: PermissionPair[] } {
    if (actor.startsWith("key:")) return { role: "api_key", builtIn: false, pairs: this.heldOf(actor).pairs }
    let role = "admin"
    for (const u of this.store.cfg.governance?.users ?? []) {
      if (u.name === actor) role = u.role
    }
    const roles = this.store.cfg.governance?.roles ?? []
    const builtIn = isBuiltinRole(role) || customRole(roles, role) === undefined
    return { role: role, roleId: anyRoleId(roles, role), builtIn: builtIn, pairs: rolePairs(roles, role, RESOURCES, OPERATIONS) }
  }

  // GET /api/users/email/{email} and /api/governance/users/email/{email}: the user with that (URL-encoded)
  // address in Bifrost's UserObject shape; .../virtual-keys lists the keys assigned to the user.
  userByEmailRoute(method: string, path: string): Reply {
    if (method !== "GET") return { status: 405, body: errorJson(`method ${method} is not allowed on this route`, "invalid_request_error", undefined), contentType: "application/json" }
    const segs = path.split("/").filter((s) => s !== "")
    const at = segs[1] === "governance" ? 4 : 3
    const raw = segs[at] ?? ""
    const keys = segs.length === at + 2 && segs[at + 1] === "virtual-keys"
    if (raw === "" || !(segs.length === at + 1 || keys)) return { status: 404, body: errorJson(`no route for ${path}`, "invalid_request_error", undefined), contentType: "application/json" }
    const email = pctDecode(raw)
    if (email === undefined || email.trim() === "") return { status: 400, body: errorJson("email must be a URL-encoded email address", "invalid_request_error", undefined), contentType: "application/json" }
    const g = this.store.cfg.governance
    const u = userByEmail(g?.users ?? [], email)
    if (u === undefined) return { status: 404, body: errorJson("user not found", "not_found_error", undefined), contentType: "application/json" }
    if (keys) return { status: 200, body: userKeysJson(u, g?.virtual_keys), contentType: "application/json" }
    return { status: 200, body: userObjectJson(u, g?.users, g?.roles, g?.access_profiles), contentType: "application/json" }
  }

  // What the actor may grant to a management API key: everything for the admin and the legacy admin
  // credential, the custom role's permissions for a role user, and a key's own permissions for a key.
  // A single sign-on or proxy identity holds a built-in role, which grants no pairs here.
  heldOf(actor: string): Held {
    if (actor.startsWith("key:")) {
      for (const k of this.store.cfg.governance?.api_keys ?? []) {
        if ("key:" + k.name === actor) return { all: false, pairs: k.permissions }
      }
      return { all: false, pairs: [] }
    }
    if (actor.startsWith("sso:") || actor.startsWith("proxy:") || actor === "temp-token") return { all: false, pairs: [] }
    const gov = this.store.cfg.governance
    for (const u of gov?.users ?? []) {
      if (u.name !== actor) continue
      if (u.role === "admin") return { all: true, pairs: [] }
      return { all: false, pairs: customRole(gov?.roles ?? [], u.role)?.permissions ?? [] }
    }
    return { all: true, pairs: [] }
  }

  // /api/api-keys and /api/api-keys/{id} (apikeys.tov). A change is saved to the config; this worker's
  // copy of the keys is updated at once, so the next request with a new key already authenticates.
  apiKeysRoute(method: string, path: string, url: string, body: string, actor: string): Reply {
    let value = ""
    if (method === "POST") {
      try {
        value = newKeyValue()
      } catch (e) {
        return { status: 500, body: errorJson(`could not make a key: ${e.message}`, "api_error", undefined), contentType: "application/json" }
      }
    }
    const u = URL.parse(url)
    const sp = u === undefined ? new URLSearchParams("") : u.searchParams
    // a key names its creator only when that is a stored user (not a key, the anonymous caller or a sign-in)
    const creator = actor.startsWith("sso:") || actor.startsWith("proxy:") || actor.startsWith("key:") || actor === "anonymous" || actor === "temp-token" ? "" : actor
    const ctx: KeyCtx = { held: this.heldOf(actor), actor: creator, nowMs: Date.now(), value: value, lastUsed: this.keyUsed }
    const r = handleApiKeys(this.store.cfg.governance?.api_keys ?? [], method, path, sp, body, ctx)
    const next = r.keys
    if (next !== undefined) {
      const saved = this.store.setApiKeys(next)
      if (saved.kind !== "ok") return { status: saved.status, body: errorJson(saved.message, "api_error", undefined), contentType: "application/json" }
      this.rbac = { users: this.rbac.users, roles: this.rbac.roles, api_keys: next }
    }
    return { status: r.status, body: r.body, contentType: "application/json" }
  }

  // POST /api/governance/access-profiles/{id}/propagate ({"fields": [...]}; all of them when unset): the
  // profile's chosen fields go onto every virtual key that holds it (propagateProfileKeys).
  propagateProfile(id: string, body: string): Reply {
    const g = this.store.cfg.governance
    let prof: AccessProfile | undefined = undefined
    for (const x of g?.access_profiles ?? []) {
      if (x.id === id) prof = x
    }
    if (prof === undefined) return { status: 404, body: errorJson(`no access profile ${id}`, "invalid_request_error", undefined), contentType: "application/json" }
    let chosen: string[] = PROPAGATED_FIELDS
    if (body.trim() !== "") {
      try {
        const req = JSON.parse(body) as { fields?: string[] }
        if (req.fields !== undefined) chosen = req.fields
      } catch (e) {
        return { status: 400, body: errorJson("body must be a JSON object", "invalid_request_error", undefined), contentType: "application/json" }
      }
    }
    for (const f of chosen) {
      if (!PROPAGATED_FIELDS.includes(f)) return { status: 400, body: errorJson(`unknown field ${f}; use ${PROPAGATED_FIELDS.join(", ")}`, "invalid_request_error", undefined), contentType: "application/json" }
    }
    const r = propagateProfileKeys(g?.virtual_keys ?? [], prof, chosen)
    const saved = this.store.replaceVirtualKeys(r.vks)
    if (saved.kind === "error") return { status: saved.status, body: errorJson(saved.message, "api_error", undefined), contentType: "application/json" }
    return { status: 200, body: JSON.stringify({ access_profile_id: id, updated: r.updated, fields: chosen }), contentType: "application/json" }
  }

  // GET /api/users/me/vk-creation-policy: the access profile that governs keys the caller creates.
  vkCreationPolicy(actor: string): Reply {
    const g = this.store.cfg.governance
    return { status: 200, body: creationPolicy(g?.users, g?.roles, g?.access_profiles, actor), contentType: "application/json" }
  }

  // /api/users/{name}/access-profiles: GET lists the profiles the user holds; PUT and DELETE
  // .../{profile_id} add and remove one; PUT and DELETE .../{profile_id}/virtual-keys/{vk_id} link
  // the profile to one of the user's virtual keys.
  userProfiles(method: string, path: string, body: string): Reply {
    const segs = path.split("/").filter((s) => s !== "")
    const name = segs[2] ?? ""
    const pid = segs[4] ?? ""
    const notFound: Reply = { status: 404, body: errorJson(`no route for ${path}`, "invalid_request_error", undefined), contentType: "application/json" }
    if (segs.length < 4 || segs.length > 8 || segs[3] !== "access-profiles") return notFound
    const g = this.store.cfg.governance
    // PUT and DELETE .../access-profiles/{profile}/budgets/{budget}/override: the user's budget override
    if (segs.length === 8) {
      if (segs[5] !== "budgets" || segs[7] !== "override") return notFound
      if (method !== "PUT" && method !== "DELETE") return { status: 405, body: errorJson(`method ${method} is not allowed on this route`, "invalid_request_error", undefined), contentType: "application/json" }
      const bid = segs[6] ?? ""
      let o: BudgetOverride | undefined = undefined
      if (method === "PUT") {
        const pr = parseOverride(body)
        if (pr.kind === "error") return badRequest(pr.message)
        o = pr.override
      }
      const r = this.store.setUserBudgetOverride(name, pid, bid, o)
      if (r.kind === "error") return { status: r.status, body: errorJson(r.message, r.status === 404 ? "not_found_error" : "invalid_request_error", undefined), contentType: "application/json" }
      const now = Date.now()
      const lim = this.engine.gov.budgetUsage().find((x) => x.id === `${bid}@user/${name}`)
      let base: BudgetConfig | undefined = undefined
      for (const b of this.store.cfg.governance?.budgets ?? []) {
        if (b.id === bid) base = b
      }
      // the effective limit as the override makes it: the base, the forever amount, and a cycles amount while it runs
      let eff = base === undefined ? 0.0 : effectiveBudgetLimit(base)
      if (o !== undefined && o.mode === "forever") eff += o.amount
      if (o !== undefined && o.mode === "cycles") eff += o.amount
      const ov = o === undefined ? "null" : JSON.stringify(o)
      const bj = base === undefined ? "null" : jobj([jkv("id", JSON.stringify(bid)), jkv("max_limit", jn(base.max_limit)), jkv("reset_duration", JSON.stringify(base.reset_duration)), jkv("current_usage", jn(lim?.used ?? 0.0)), jkv("override", ov)])
      return okJson(jobj([jkv("user_id", JSON.stringify(name)), jkv("access_profile_id", JSON.stringify(pid)), jkv("budget", bj), jkv("effective_max_limit", jn(eff)), jkv("checked_at", JSON.stringify(isoMs(now)))]))
    }
    if (segs.length === 4) {
      if (method !== "GET") return { status: 405, body: errorJson(`method ${method} is not allowed on this route`, "invalid_request_error", undefined), contentType: "application/json" }
      const held = heldProfiles(g?.users, g?.roles, g?.access_profiles, name)
      return { status: 200, body: JSON.stringify({ access_profiles: held }), contentType: "application/json" }
    }
    const add = method === "PUT"
    if (method !== "PUT" && method !== "DELETE") return { status: 405, body: errorJson(`method ${method} is not allowed on this route`, "invalid_request_error", undefined), contentType: "application/json" }
    const r = segs.length === 5 ? this.store.setUserProfile(name, pid, add) : segs.length === 7 && segs[5] === "virtual-keys" ? this.store.setVkProfile(name, segs[6] ?? "", pid, add) : undefined
    if (r === undefined) return notFound
    if (r.kind === "error") return { status: r.status, body: errorJson(r.message, "invalid_request_error", undefined), contentType: "application/json" }
    return { status: 200, body: JSON.stringify({ user: name, access_profile_id: pid, linked: add }), contentType: "application/json" }
  }

  // setupToken is the X-Bifrost-Setup-Token header and setupSession the setup session cookie (POST /api/session/setup).
  users(method: string, path: string, body: string, setupToken: string, setupSession: string): Reply {
    // Bifrost's setup gate: while no admin exists, the first account needs the operator's setup_token, given
    // as the header or as a setup session from POST /api/session/setup
    const want = this.setupToken()
    if (method === "POST" && !this.authOn && want !== "" && !sameSecret(setupToken, want) && !validSetupSession(setupSession, want, Date.now())) {
      return { status: 403, body: errorJson("the setup token is required to create the first admin account", "invalid_request_error", undefined), contentType: "application/json" }
    }
    // only stored users are managed here; legacy auth_config credentials stay in the config
    const stored: UserConfig[] = this.store.cfg.governance?.users ?? []
    const r = handleUsers({ users: stored, roles: this.store.cfg.governance?.roles ?? [] }, method, path, body)
    if (method !== "GET" && r.status < 300) {
      const saved = this.store.setUsers(r.cfg.users)
      if (saved.kind === "error") return { status: saved.status, body: errorJson(saved.message, "api_error", undefined), contentType: "application/json" }
    }
    return { status: r.status, body: r.body, contentType: "application/json" }
  }

  // /api/governance/access-profiles/{id}/roles: POST attaches roles ({"role_ids": [...], "is_default": bool,
  // "apply_to_existing": bool}); DELETE .../roles/{role_id} detaches one. apply_to_existing gives the role's users
  // the profile now (counted as users_applied), is_default gives it to the role's later users.
  profileRoles(method: string, segs: string[], body: string): Reply {
    const id = segs[3] ?? ""
    if (segs.length === 5 && method === "POST") {
      let b: RoleAttachBody = {}
      try {
        b = JSON.parse(body) as RoleAttachBody
      } catch (e) {
        return { status: 400, body: errorJson("body must be a JSON object with role_ids", "invalid_request_error", undefined), contentType: "application/json" }
      }
      const ids: int[] = b.role_ids ?? []
      if (ids.length === 0) return { status: 400, body: errorJson("role_ids is required", "invalid_request_error", undefined), contentType: "application/json" }
      const apply = b.apply_to_existing === true
      const r = this.store.attachProfileRoles(id, ids, b.is_default, apply)
      if (r.kind === "error") return { status: r.status, body: errorJson(r.message, "invalid_request_error", undefined), contentType: "application/json" }
      // users_applied: the role's users given the profile now (apply_to_existing), as Bifrost counts them
      const g = this.store.cfg.governance
      let n = 0
      for (const u of g?.users ?? []) {
        const rid = anyRoleId(g?.roles, u.role)
        if (apply && rid !== undefined && ids.includes(rid)) n += 1
      }
      return { status: 200, body: JSON.stringify({ message: "roles attached", users_applied: n }), contentType: "application/json" }
    }
    if (segs.length === 6 && method === "DELETE") {
      const rid = parseInt(segs[5] ?? "") ?? 0
      const r = this.store.detachProfileRole(id, rid)
      if (r.kind === "error") return { status: r.status, body: errorJson(r.message, "invalid_request_error", undefined), contentType: "application/json" }
      return { status: 200, body: JSON.stringify({ message: "role detached" }), contentType: "application/json" }
    }
    return { status: 405, body: errorJson(`method ${method} is not allowed on this route`, "invalid_request_error", undefined), contentType: "application/json" }
  }

  // /api/governance/access-profiles[/{id}]. A profile that keys still use can't be deleted.
  profiles(method: string, path: string, body: string): Reply {
    const gov = this.store.cfg.governance
    const segs0 = path.split("/").filter((s) => s !== "")
    if (method === "POST" && segs0.length === 5 && segs0[4] === "propagate") return this.propagateProfile(segs0[3] ?? "", body)
    if (segs0.length >= 5 && segs0[4] === "roles") return this.profileRoles(method, segs0, body)
    // a profile attached to a role is detached from it first, as Bifrost refuses the delete while it is held
    if (method === "DELETE") {
      const did = segs0[3] ?? ""
      for (const p of gov?.access_profiles ?? []) {
        if (p.id === did && (p.roles ?? []).length > 0) return { status: 409, body: errorJson(`access profile ${did} is attached to roles; detach it first`, "invalid_request_error", undefined), contentType: "application/json" }
      }
    }
    const r = handleProfiles(gov?.access_profiles ?? [], method, path, body)
    if (method === "GET" || r.status >= 300) return { status: r.status, body: r.body, contentType: "application/json" }
    if (method === "DELETE") {
      const segs = path.split("/")
      const id = segs[segs.length - 1] ?? ""
      const users = (gov?.virtual_keys ?? []).filter((vk) => (vk.access_profile_ids ?? []).includes(id)).map((vk) => vk.id)
      if (users.length > 0) return { status: 409, body: errorJson(`access profile ${id} is used by ${users.join(", ")}`, "invalid_request_error", undefined), contentType: "application/json" }
    }
    const saved = this.store.setProfiles(r.profiles)
    if (saved.kind === "error") return { status: saved.status, body: errorJson(saved.message, "api_error", undefined), contentType: "application/json" }
    return { status: r.status, body: r.body, contentType: "application/json" }
  }

  // GET /api/governance/projects/{id}/members/{member_id}/usage: one member's usage (Bifrost's member usage view): each
  // slice the member holds of the project's budgets and rate limits with what it has counted in its window, and the
  // member's requests in the project grouped by provider and model, counted from the start of the earliest slice's
  // cycle (all the requests the log store holds when the member has no budget slice).
  memberUsage(path: string, sc: DataScope): Reply {
    const segs = path.split("/").filter((s) => s !== "")
    const pid = pctDecode(segs[3] ?? "") ?? ""
    const mid = pctDecode(segs[5] ?? "") ?? ""
    const nf = (what: string): Reply => ({ status: 404, body: errorJson(what, "not_found_error", undefined), contentType: "application/json" })
    let pj: ProjectConfig | undefined = undefined
    for (const p of this.store.cfg.governance?.projects ?? []) {
      if (p.id === pid) pj = p
    }
    if (pj === undefined || !inScope(sc, "", "", "", pid)) return nf(`no project ${pid}`)
    let user = ""
    for (const m of pj.members ?? []) {
      if (m.id === mid || m.user_id === mid) user = m.user_id
    }
    if (user === "") return nf(`no member ${mid}`)
    const now = Date.now()
    const suffix = `@${pid}/${user}`
    const budgets: string[] = []
    let since = -1.0
    for (const u of this.engine.gov.budgetUsage()) {
      if (!u.id.endsWith(suffix)) continue
      const src = u.id.slice(0, u.id.byteLength - suffix.byteLength)
      const st = this.engine.gov.budgetCycleStart(u.id, now) ?? now
      if (since < 0.0 || st < since) since = st
      budgets.push(jobj([jkv("source_budget_id", JSON.stringify(src)), jkv("budget_id", JSON.stringify(u.id)), jkv("max_limit", jn(u.limit)), jkv("current_usage", jn(u.used))]))
    }
    const rates = new Map<string, string[]>()
    const order: string[] = []
    for (const u of this.engine.gov.rateLimitUsage(now)) {
      if (!u.id.endsWith(suffix)) continue
      if (!rates.has(u.id)) order.push(u.id)
      const cur = rates.get(u.id) ?? []
      cur.push(jkv(u.kind + "_max_limit", jn(u.limit)))
      cur.push(jkv(u.kind + "_current_usage", jn(u.used)))
      rates.set(u.id, cur)
    }
    const limits: string[] = []
    for (const id of order) {
      const src = id.slice(0, id.byteLength - suffix.byteLength)
      limits.push(jobj([jkv("source_rate_limit_id", JSON.stringify(src)), jkv("rate_limit_id", JSON.stringify(id))].concat(rates.get(id) ?? [])))
    }
    const ls = this.engine.logStore
    const es: LogEntry[] = []
    if (ls !== undefined) {
      for (const e of ls.viewSince(0.0)) {
        if ((e.project_id ?? "") === pid) es.push(e)
      }
    }
    const spend = perModelUsage(es, "", user, since < 0.0 ? 0.0 : since, now)
    return okJson(jobj([jkv("project_id", JSON.stringify(pid)), jkv("member_id", JSON.stringify(mid)), jkv("user_id", JSON.stringify(user)), jkv("budgets", jarr(budgets)), jkv("rate_limits", jarr(limits)), jkv("usage", JSON.stringify(spend))]))
  }

  // GET /api/governance/access-profiles/audit-logs and .../{profile_id}/audit-logs (also under /api/access-profiles, as
  // Bifrost serves them): the access-profile changes the audit trail holds (audit.tov profileAuditJson), with
  // limit, offset, action and user_id. An empty list while the audit log is off.
  profileAudit(req: Request, path: string): Reply {
    const rest = path.startsWith("/api/governance/") ? path.slice("/api/governance/".byteLength) : path.slice("/api/".byteLength)
    const segs = rest.split("/").filter((s) => s !== "")
    const profile = segs.length === 3 ? pctDecode(segs[1] ?? "") ?? "" : undefined
    if (profile !== undefined && !(this.store.cfg.governance?.access_profiles ?? []).some((p) => p.id === profile)) return { status: 404, body: errorJson(`no access profile ${profile}`, "not_found_error", undefined), contentType: "application/json" }
    const u = URL.parse(req.url)
    const sp = u === undefined ? new URLSearchParams("") : u.searchParams
    const limit = parseInt(sp.get("limit") ?? "") ?? 50
    const offset = parseInt(sp.get("offset") ?? "") ?? 0
    const log = this.audit
    if (log === undefined) return okJson(`{"audit_logs":[],"total_count":0}`)
    const page = log.query({ paths: ["/api/governance/access-profiles"], limit: 1000, order: "desc" })
    return okJson(profileAuditJson(page.events, profile, (sp.get("action") ?? "").trim(), (sp.get("user_id") ?? "").trim(), limit > 0 ? Math.trunc(limit) : 50, offset > 0 ? Math.trunc(offset) : 0))
  }

  // GET /api/audit-logs, /api/audit-logs/export (JSONL), /api/audit-logs/verify
  auditRoute(req: Request, path: string): Reply {
    const log = this.audit
    if (log === undefined) return { status: 404, body: errorJson("the audit log is off; set audit.enabled in the config", "invalid_request_error", undefined), contentType: "application/json" }
    if (req.method !== "GET") return { status: 405, body: errorJson(`method ${req.method} is not allowed on this route`, "invalid_request_error", undefined), contentType: "application/json" }
    const u = URL.parse(req.url)
    const params = u === undefined ? new URLSearchParams("") : u.searchParams
    const p = path.indexOf("?") < 0 ? path : path.slice(0, path.indexOf("?"))
    try {
      if (p === "/api/audit-logs/verify") return { status: 200, body: JSON.stringify(log.verify()), contentType: "application/json" }
      if (p === "/api/audit-logs/export") return { status: 200, body: log.exportJsonl(num(params, "since"), num(params, "until")), contentType: "application/x-ndjson" }
    } catch (e) {
      return { status: 500, body: errorJson(e.message, "api_error", undefined), contentType: "application/json" }
    }
    // audit.omit_ip_addresses also hides the addresses older events kept, and ip filters and search skip them
    const omitIps = this.store.cfg.audit?.omit_ip_addresses === true
    if (p === "/api/audit-logs/filterdata") {
      const dims = (params.get("dimensions") ?? "").split(",").map((d) => d.trim()).filter((d) => d !== "")
      return { status: 200, body: log.filterData(dims, params.get("q") ?? "", omitIps), contentType: "application/json" }
    }
    // GET /api/audit-logs/{id}: one event, by its id (its sequence number), in Bifrost's {audit_log} wrapper;
    // GET /api/audit-logs/{id}/verify: its signature computed again and compared with the stored one
    if (p.startsWith("/api/audit-logs/")) {
      const rest = p.slice("/api/audit-logs/".byteLength)
      const verify = rest.endsWith("/verify")
      const idText = verify ? rest.slice(0, rest.byteLength - "/verify".byteLength) : rest
      const seq = idText.includes("/") ? -1 : parseInt(idText) ?? -1
      if (seq < 0 && verify) return badRequest("invalid audit log id")
      let ev: AuditEvent | undefined = undefined
      try {
        ev = seq >= 0 ? log.findAny(seq) : undefined
      } catch (e) {
        return { status: 500, body: errorJson(e.message, "api_error", undefined), contentType: "application/json" }
      }
      if (ev === undefined) return { status: 404, body: errorJson("audit log not found", "not_found_error", undefined), contentType: "application/json" }
      if (verify) return { status: 200, body: JSON.stringify(log.verifyOne(ev)), contentType: "application/json" }
      const shown: AuditEvent = ev
      if (omitIps) shown.ip = undefined
      return { status: 200, body: JSON.stringify({ audit_log: shown }), contentType: "application/json" }
    }
    if (p !== "/api/audit-logs") return { status: 404, body: errorJson(`no route for ${p}`, "invalid_request_error", undefined), contentType: "application/json" }
    const lq = auditQueryOf(params, Date.now(), omitIps)
    if (lq.error !== "") return badRequest(lq.error)
    return { status: 200, body: auditListJson(log.query(lq.q), lq.page, lq.limit, omitIps), contentType: "application/json" }
  }

  // GET /api/alerts: rule states and recent transitions.
  alertsView(): Reply {
    const a = this.alerts
    if (a === undefined) return { status: 200, body: `{"enabled":false,"rules":[],"history":[]}`, contentType: "application/json" }
    return { status: 200, body: JSON.stringify({ enabled: true, rules: a.states(), history: a.history() }), contentType: "application/json" }
  }

  // POST /mcp: the connected MCP servers' tools, served to MCP clients.
  // GET /api/mcp/virtual: each virtual MCP with its resolved tool names and problems.
  virtualView(): Reply {
    const m = this.engine.mcp
    const all: ExposedTool[] = m === undefined ? [] : exposedTools(m.allTools())
    return { status: 200, body: vmcp.listView(this.engine.cfg.virtual_mcps ?? [], all), contentType: "application/json" }
  }

  // Whether a key reaches a virtual MCP through the project its request names or through its access
  // profiles (the profiles' virtual_mcps names). Its own allowed_keys are checked by the caller.
  private grantedVirtual(h: Hdrs, vk: VirtualKeyConfig | undefined, name: string): bool {
    const proj = this.engine.gov.projectFor(h)
    if (proj !== undefined && (proj.virtual_mcps ?? []).includes(name)) return true
    if (vk === undefined) return false
    const pol = this.engine.gov.policyFor(h)
    const pids: string[] = pol === undefined ? (vk.access_profile_ids ?? []) : (pol.vk.access_profile_ids ?? [])
    const profiles = this.engine.cfg.governance?.access_profiles ?? []
    for (const p of profiles) {
      if (p.is_active === false || !pids.includes(p.id)) continue
      if ((p.virtual_mcps ?? []).includes(name)) return true
    }
    return false
  }

  // Who calls the MCP server (/mcp, /mcp/{name}), from the request's headers alone: the answer that refuses the
  // call, or the headers to go on with (the identity a token names set as the key or user) and whether a credential
  // was verified (a virtual key or a token; an anonymous call while auth is not enforced, or a session-mode token,
  // carries none). The server reads its body only after this (server.tov
  // headerCheck runs it before a big body is read, re-audit 3 P1-D).
  mcpCaller(req: Request): McpCaller {
    const m = this.engine.mcp
    if (m === undefined || this.engine.cfg.mcp_server?.enabled === false) return mcpRefused(json(404, errorJson("no MCP servers are connected", "invalid_request_error", undefined)))
    const h = snapshot(req.headers)
    // client.mcp_server_auth_mode: a Bifrost-issued JWT stands for the virtual key its sub names; in oauth
    // mode nothing else is accepted. The 401s name the protected resource when the authorization server is on.
    const iss = issuerOf(this.engine.cfg)
    const challenge = iss === undefined ? undefined : challengeOf(iss)
    const caller = callerOf(iss, h.get("authorization"), Date.now())
    if (caller.kind === "error") return mcpRefused(denied(401, caller.message, challenge))
    // a user is named only by a user-mode token checked here (mcpuser.tov markUser), never by a header the caller sent
    h.delete(USER_HEADER)
    if (caller.kind !== "none" && headerKeyOf(h) !== "") {
      // the OAuth token is the request's only identity: a virtual key header beside it is ambiguous (Bifrost)
      return mcpRefused(denied(401, "conflicting credentials: an OAuth token and a virtual key header were both provided; send only the OAuth token", challenge))
    }
    let mcpUser = ""
    if (caller.kind === "user") {
      // a dashboard sign-in on the same request must name the same user; a user governance disabled is refused at once
      const su = this.sessionUser(req)
      if (su !== "" && su !== caller.sub) return mcpRefused(denied(401, "session user does not match the authenticated token", challenge))
      if (!this.userActive(caller.sub)) return mcpRefused(denied(401, "user is no longer active", challenge))
      mcpUser = caller.sub
      h.set(USER_HEADER, markUser(caller.sub))
    } else if (caller.kind === "vk") {
      if (vkIdentityCut(this.engine.cfg, this.oidcCfg !== undefined)) return mcpRefused(denied(401, "virtual-key identity is no longer accepted; re-authenticate", challenge))
      const named = keyById(this.engine.cfg, caller.vk)
      if (!keyUsable(named, Date.now()) || named === undefined) return mcpRefused(denied(401, "the virtual key this token names is not active", challenge))
      h.set("x-bf-vk", named.value)
    } else if (caller.kind === "session") {
      // a session token carries no verified identity (Bifrost): the request is anonymous, refused while auth is enforced,
      // and keys its per-user OAuth tokens by the session id the token names
      if (this.engine.gov.enforce) return mcpRefused(denied(401, "authentication required; session-mode tokens are not accepted when authentication is enforced - re-authenticate with a virtual key", challenge))
      h.set("x-bf-mcp-session-id", caller.sub)
    } else if (serverAuthMode(this.engine.cfg) === "oauth") {
      return mcpRefused(denied(401, "this server requires OAuth JWT authentication; header credentials are not accepted in oauth mode", challenge))
    }
    const vk = this.engine.gov.findKey(h)
    // a user-mode token is an identity of its own, as an upstream-authenticated user is in Bifrost
    if (this.engine.gov.enforce && vk === undefined && mcpUser === "") return mcpRefused(denied(401, "a virtual key is required (x-bf-vk or Authorization: Bearer sk-bf-...)", challenge))
    return { res: undefined, h: h, checked: mcpUser !== "" || (vk !== undefined && keyUsable(vk, Date.now())) }
  }

  // POST /mcp (every connected tool) and /mcp/{name} (a virtual MCP's tool set).
  async mcp(req: Request, virtualName: string | undefined): Promise<Response> {
    const who = this.mcpCaller(req)
    const refused = who.res
    if (refused !== undefined) return refused
    const m = this.engine.mcp
    if (m === undefined) return json(404, errorJson("no MCP servers are connected", "invalid_request_error", undefined))
    const h = who.h
    const vk = this.engine.gov.findKey(h)
    // a key's access profile may limit the tools it sees; allow_by_default opens the clients it does not name
    const allowedTools = this.engine.gov.policyFor(h)?.mcpTools
    let tools = exposedTools(m.allToolsFor(allowedTools, this.engine.keyMcp(h, virtualName), this.engine.projectMcp(h, virtualName)))
    // code mode: the four meta-tools stand in for the code mode clients' tools, as in the tool list Bifrost serves
    // (a virtual MCP lists only its own tools)
    if (virtualName === undefined && this.engine.codeEntriesFor(m, h).length > 0) {
      for (const d of exposedTools(metaToolDefs())) tools.push(d)
    }
    // virtual names → the source tool and its argument defaults
    let mapping: Map<string, { source: string, defaults: string }> = new Map()
    if (virtualName !== undefined) {
      let v: vmcp.VirtualMcp | undefined = undefined
      for (const x of this.engine.cfg.virtual_mcps ?? []) {
        if (x.name === virtualName) v = x
      }
      if (v === undefined) return json(404, errorJson(`no virtual MCP ${virtualName}`, "invalid_request_error", undefined))
      if (!vmcp.keyAllowed(v, vk?.id) && !this.grantedVirtual(h, vk, v.name)) return denied(403, `this key may not use the virtual MCP ${virtualName}`)
      const r = vmcp.resolve(v, tools)
      for (const e of r.errors) console.error(`raiju: virtual MCP ${virtualName}: ${e}`)
      tools = r.tools
      mapping = r.map
    }
    const virtual = virtualName !== undefined
    if (req.method === "DELETE") {
      const sid = h.get("mcp-session-id")
      if (sid !== undefined) this.mcpSessions.delete(sid)
      return new Response(undefined, { status: 204 })
    }
    // GET is the server-to-client stream (Bifrost's SSE handler): a connection event, then heartbeats that
    // keep it open through proxies until the client leaves.
    if (req.method === "GET") {
      const sh: Record<string, string> = new Map()
      sh.set("content-type", "text/event-stream")
      sh.set("cache-control", "no-cache")
      sh.set("connection", "keep-alive")
      sh.set("x-accel-buffering", "no")
      return new Response(sseStream(SSE_HEARTBEAT_MS), { headers: sh })
    }
    if (req.method !== "POST") return json(405, errorJson("use POST for MCP requests", "invalid_request_error", undefined))
    const body = await req.text()
    const now = Date.now()
    this.mcpSessions.expire(now)
    // each call passes the key's MCP rules and budgets, forwards the allowed request headers, and
    // is charged its tool_pricing cost; a virtual MCP's call is judged by the tool it runs
    const run = async (name: string, args: string): Promise<{ text: string, isError: bool }, Error> => {
      // a code mode meta-tool runs its program; the program's own tool calls pass the same gates as any call
      if (isMetaTool(name)) {
        const mr = try await this.engine.codeMetaTool(m, h, name, args, undefined)
        return { text: mr.text, isError: mr.isError }
      }
      let real = name
      let merged = args
      if (virtual) {
        const target = mapping.get(name)
        if (target === undefined) throw new Error(`unknown tool ${name}`)
        real = target.source
        try {
          merged = vmcp.mergeArgs(target.defaults, args)
        } catch (e) {
          return { text: `bad arguments: ${e.message}`, isError: true }
        }
      }
      const gate = this.engine.toolGate(m, h, real, virtualName)
      if (gate.kind === "denial") return { text: gate.message, isError: true }
      const ua = try await this.engine.userAuth(real, h, false)
      if (ua.kind === "denial") return { text: ua.message, isError: true }
      const r = try await this.engine.runUser(m, real, merged, h, ua)
      this.engine.chargeTool(m, gate, real)
      return { text: r.text, isError: r.isError }
    }
    // the servers' own guidance goes out with initialize, for the servers that offer this caller a tool
    const seen: string[] = []
    if (virtual) {
      for (const k of mapping.keys()) seen.push(mapping.get(k)!.source)
    } else {
      for (const t of tools) seen.push(t.name)
    }
    const iparts = m.instructionParts(allowedTools, this.engine.keyMcp(h, virtualName), this.engine.projectMcp(h, virtualName)).filter((p) => seen.some((n) => n.startsWith(p.name + "-")))
    const instructions = m.renderInstructions(iparts)
    const r = await handleMcp(body, h.get("mcp-session-id"), tools, run, this.mcpSessions, now, instructions)
    const out: Record<string, string> = new Map()
    out.set("content-type", r.contentType)
    const sid = r.sessionId
    if (sid !== undefined) out.set("mcp-session-id", sid)
    return new Response(r.status === 202 ? undefined : r.body, { status: r.status, headers: out })
  }
}

// The folder share directories are made in ($TMPDIR, else /tmp).
function shareBase(): string {
  const t = process.env.TMPDIR ?? ""
  return t === "" ? "/tmp" : t
}

// The supervisor pid a share directory name carries: raiju-<pid>-<random hex>, or the older raiju-<pid>. undefined
// for any other name.
export function sharePid(name: string): int | undefined {
  if (!name.startsWith("raiju-")) return undefined
  let rest = name.slice(6)
  const dash = rest.indexOf("-")
  if (dash >= 0) {
    const tag = rest.slice(dash + 1)
    if (tag.byteLength !== 16) return undefined
    for (const ch of tag.chars()) {
      if (!"0123456789abcdef".includes(ch)) return undefined
    }
    rest = rest.slice(0, dash)
  }
  const pid = parseInt(rest)
  if (pid === undefined || "" + pid !== rest) return undefined
  return pid
}

// The node's share folder, made by the supervisor before its workers fork: raiju-<pid>-<16 random hex digits> under
// $TMPDIR (or /tmp). The random part makes the name unpredictable, and mkdir refuses a name that already exists (a
// planted folder or symlink), so another local user can neither pre-create it nor redirect it; it is then made
// private (0700), which keeps the shared counters, cache entries and metrics from other users. "" when it cannot be
// made (the workers then keep their state to themselves).
export function makeShareDir(supervisorPid: int): string {
  removeStaleShares()
  try {
    const dir = `${shareBase()}/raiju-${supervisorPid}-${try secureHex(16)}`
    mkdirSync(dir)
    chmodSync(dir, 448)
    return dir
  } catch (e) {
    console.error(`raiju: can't share state between workers: ${e.message}`)
    return ""
  }
}

// Share directories of gateways that are no longer running (their supervisor's pid is gone).
function removeStaleShares(): void {
  const base = shareBase()
  try {
    for (const d of readdirSync(base)) {
      const pid = sharePid(d)
      if (pid === undefined) continue
      if (!existsSync(`/proc/${pid}`)) rmSync(base + "/" + d, { recursive: true, force: true })
    }
  } catch (e) {
    // best effort
  }
}

async function sendAlert(url: string, headers: Map<string, string>, body: string, rule: string): Promise<void> {
  const dl = deadline(10000)
  try {
    const hs: Record<string, string> = headers
    const res = await fetch(url, { method: "POST", headers: hs, body: body, signal: dl.controller.signal })
    if (res.status < 200 || res.status >= 300) console.error(`raiju: alert ${rule}: webhook answered HTTP ${res.status}`)
    await res.text()
  } catch (e) {
    console.error(`raiju: alert ${rule}: ${e.message}`)
  }
  dl.finish()
}

