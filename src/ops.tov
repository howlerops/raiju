// The quota view of one virtual key's budget and rate limit (GET /api/governance/virtual-keys/quota).
// POST /api/governance/access-profiles/{id}/roles: the roles to attach (Bifrost's AttachRolesRequest).
type RoleAttachBody = { role_ids?: int[], is_default?: bool, apply_to_existing?: bool }
// A budget in the quota view; source_* name the access profile that governs it (Bifrost's SourceRef), and
// per_model_usage is the spend per model in its current cycle, from the request logs.
type QuotaBudget = { id: string, max_limit: f64, effective_max_limit: f64, reset_duration: string, current_usage: f64, source_type?: string, source_id?: string, source_name?: string, per_model_usage?: ModelSpend[] }
type QuotaRateUsage = { kind: string, used: f64, limit: f64 }
type QuotaRate = { id: string, token_max_limit?: int, token_reset_duration?: string, request_max_limit?: int, request_reset_duration?: string, usage: QuotaRateUsage[], source_type?: string, source_id?: string, source_name?: string }
// One per-model limit of a key in the quota view (Bifrost's quotaModelUsage); no provider means every provider.
type QuotaModel = { model_name: string, provider?: string, budgets: QuotaBudget[], rate_limit?: QuotaRate }
