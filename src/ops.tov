test("epoch params and histogram bucket sizes follow the store's rule", () => {
  expect(epochParam(undefined, 7.0)).toBe(7.0)
  expect(epochParam("", 7.0)).toBe(7.0)
  expect(epochParam("abc", 7.0)).toBe(7.0)
  expect(epochParam("1500", 7.0)).toBe(1500.0)
})

test("model catalog views list base models and priced rows, filtered and paged", () => {
  const ops = new Ops(new Engine({}), new ConfigStore("/tmp/raiju-ops-catalog.json", {}))
  const base = ops.catalogView(new Request("http://raiju.test/api/models/base?query=gpt&limit=3"), "/api/models/base")
  expect(base.status).toBe(200)
  expect(base.body.includes("\"models\":[")).toBe(true)
  expect(base.body.includes("gpt")).toBe(true)
  const det = ops.catalogView(new Request("http://raiju.test/api/models/details?provider=openai&limit=2"), "/api/models/details")
  expect(det.status).toBe(200)
  expect(det.body.includes("\"provider\":\"openai\"")).toBe(true)
  expect(det.body.includes("\"provider\":\"anthropic\"")).toBe(false)
  expect(ops.catalogView(new Request("http://raiju.test/api/models/details", { method: "POST" }), "/api/models/details").status).toBe(405)
})

test("circuit view lists only the circuits that are not closed", () => {
  const eng = new Engine({})
  const ops = new Ops(eng, new ConfigStore("/tmp/raiju-ops-circuit.json", {}))
  expect(ops.circuitView().body).toBe(`{"circuits":{}}`)
  for (let i = 0; i < 20; i++) eng.health.record("openai#k1", false, 100.0, Date.now())
  expect(ops.circuitView().body.includes("\"openai#k1\":\"open\"")).toBe(true)
})

test("duplicate names saved before names were unique: a start warning and a dashboard notice list them", () => {
  try {
    const ops = try lockFor({ governance: { virtual_keys: [{ id: "vk-1", name: "prod", value: "sk-bf-1" }, { id: "vk-2", name: "prod", value: "sk-bf-2" }], teams: [{ id: "t1", name: "core" }] } })
    const w = ops.startupWarnings().filter((x) => x.includes("duplicates"))
    expect(w.length).toBe(1)
    expect(w[0]!.includes(`virtual key name "prod" is held by vk-1, vk-2`)).toBe(true)
    expect(w[0]!.includes("team name")).toBe(false)
    const before = noticeList().items.length
    ops.noticeDuplicateNames()
    const items = noticeList().items
    expect(items.length).toBe(before + 1)
    expect(items[items.length - 1]!.severity).toBe("warning")
    expect(items[items.length - 1]!.message.includes(`"prod" is held by vk-1, vk-2`)).toBe(true)
    // none: no warning and no notice
    const clean = try lockFor({ governance: { virtual_keys: [{ id: "vk-1", name: "prod", value: "sk-bf-1" }] } })
    expect(clean.startupWarnings().some((x) => x.includes("duplicates"))).toBe(false)
    clean.noticeDuplicateNames()
    expect(noticeList().items.length).toBe(before + 1)
  } catch (e) {
    expect(e.message).toBe("")
  }
})

// An Ops whose engine and store both hold cfg, as at start.
function lockFor(cfg: Config): Ops throws Error {
  const path = "/tmp/raiju-ops-lock-" + (try secureHex(6)) + ".json"
  return new Ops(new Engine(cfg), new ConfigStore(path, cfg))
}

function gateStatus(ops: Ops, path: string, hs: Record<string, string>): int {
  const g = ops.gate(new Request("http://gw" + path, { method: "GET", headers: hs }), path)
  return g.kind === "ok" ? 200 : g.res.status
}

test("/api is locked without an admin: 403 with no setup token, the token or its session opens it", () => {
  const none: Record<string, string> = new Map()
  // no admin and no setup token: everything but the public routes is refused (the old default left it open)
  let lockOps = try lockFor({})
  if ((process.env.BIFROST_SETUP_TOKEN ?? "") === "") {
    expect(gateStatus(lockOps, "/api/providers", none)).toBe(403)
    expect(gateStatus(lockOps, "/api/config", none)).toBe(403)
    expect(lockOps.startupWarnings()[0]!.includes("no setup token")).toBe(true)
  }
  expect(gateStatus(lockOps, "/api/session/is-auth-enabled", none)).toBe(200)
  expect(gateStatus(lockOps, "/api/version", none)).toBe(200)
  expect(lockOps.startupWarnings().some((w) => w.includes("inference is not authenticated"))).toBe(true)
  // a setup token: missing 401, wrong 403, right opens it
  lockOps = try lockFor({ setup_token: "s3cret-setup" })
  expect(gateStatus(lockOps, "/api/providers", none)).toBe(401)
  const wrong: Record<string, string> = new Map()
  wrong.set("x-bifrost-setup-token", "nope")
  expect(gateStatus(lockOps, "/api/providers", wrong)).toBe(403)
  const right: Record<string, string> = new Map()
  right.set("x-bifrost-setup-token", "s3cret-setup")
  expect(gateStatus(lockOps, "/api/providers", right)).toBe(200)
  // client.whitelisted_routes stay open, as Bifrost's whitelist
  lockOps = try lockFor({ client: { whitelisted_routes: ["/api/models"] } })
  expect(gateStatus(lockOps, "/api/models", none)).toBe(200)
  // once an admin exists the setup token no longer opens anything
  lockOps = try lockFor({ setup_token: "s3cret-setup", governance: { auth_config: { token: "admin-tok" } } })
  expect(gateStatus(lockOps, "/api/providers", right)).toBe(401)
  const admin: Record<string, string> = new Map()
  admin.set("authorization", "Bearer admin-tok")
  expect(gateStatus(lockOps, "/api/providers", admin)).toBe(200)
  expect(lockOps.startupWarnings().some((w) => w.includes("/api is locked"))).toBe(false)
})

test("a start with /metrics open on the main port warns; a token or the cluster listener does not", () => {
  const open = (w: string): bool => w.includes("/metrics is open")
  let o = try lockFor({})
  expect(o.startupWarnings().some(open)).toBe(true)
  o = try lockFor({ server: { metrics_token: "m-token-1" } })
  expect(o.startupWarnings().some(open)).toBe(false)
  // cluster.serve_metrics moves it only with a cluster listener (main.tov openClusterListener sets metricsOnCluster)
  o = try lockFor({})
  o.metricsOnCluster = true
  expect(o.startupWarnings().some(open)).toBe(false)
})

test("the worker share folder is private, unpredictable and its stale copies are recognized", () => {
  expect(sharePid("raiju-123")).toBe(123)
  expect(sharePid("raiju-123-0123456789abcdef")).toBe(123)
  expect(sharePid("raiju-123-0123")).toBeUndefined()
  expect(sharePid("raiju-123-0123456789abcdeZ")).toBeUndefined()
  expect(sharePid("raiju-plugins")).toBeUndefined()
  expect(sharePid("raiju-store-ab.json")).toBeUndefined()
  const a = makeShareDir(process.pid)
  const b = makeShareDir(process.pid)
  expect(a !== "" && b !== "" && a !== b).toBe(true)
  expect(sharePid(a.slice(a.indexOf("raiju-")))).toBe(process.pid)
  expect((try statSync(a)).mode & 511).toBe(448)
  try rmSync(a, { recursive: true, force: true })
  try rmSync(b, { recursive: true, force: true })
})

test("circuit reset closes one circuit by id, or all of them", () => {
  const eng = new Engine({})
  const ops = new Ops(eng, new ConfigStore("/tmp/raiju-ops-reset.json", {}))
  for (let i = 0; i < 20; i++) eng.health.record("openai#k1", false, 100.0, Date.now())
  for (let i = 0; i < 20; i++) eng.health.record("openai#k2", false, 100.0, Date.now())
  expect(ops.circuitReset("not json").status).toBe(400)
  expect(ops.circuitReset(`{}`).status).toBe(400)
  expect(ops.circuitReset(`{"id":"nope"}`).status).toBe(404)
  expect(ops.circuitReset(`{"id":"openai#k1"}`).status).toBe(200)
  expect(ops.circuitView().body.includes("openai#k1")).toBe(false)
  expect(ops.circuitView().body.includes("openai#k2")).toBe(true)
  expect(ops.circuitReset(`{"all":true}`).status).toBe(200)
  expect(ops.circuitView().body).toBe(`{"circuits":{}}`)
})

test("model parameters resolve qualified and bare names; the datasheet's keys are read as given", () => {
  const m = fallbackParams()
  expect(resolveParams(m, "gpt-4o") !== undefined).toBe(true)
  expect(resolveParams(m, "openai/gpt-4o")).toBe(resolveParams(m, "gpt-4o"))
  expect(resolveParams(m, "openrouter/openai/gpt-4o-mini")).toBe(resolveParams(m, "gpt-4o-mini"))
  expect(resolveParams(m, "nope/none") === undefined).toBe(true)
  const live = try parseParams(`{"openrouter/moonshotai/kimi-k2.5": {"max_input_tokens": 1}, "gpt-x": {"max_input_tokens": 2}, "junk": 3}`)
  expect((resolveParams(live, "kimi-k2.5") ?? "").includes(`"max_input_tokens": 1`)).toBe(true)
  expect((resolveParams(live, "gpt-x") ?? "").includes(`"max_input_tokens": 2`)).toBe(true)
  expect(live.get("junk") === undefined).toBe(true)
})

test("the catalog takes attributes for priced entries only, and saves them beside the config", () => {
  const path = "/tmp/raiju-ops-catalog-" + (try secureHex(6)) + ".json"
  try {
    const eng = new Engine({})
    const ops = new Ops(eng, new ConfigStore(path, {}))
    const put = (b: string): Reply => ops.catalogUpsert(new Request("http://raiju.test/api/models/catalog", { method: "PUT" }), b)
    expect(put(`[{"model":"no-such-model","provider":"openai"}]`).status).toBe(404)
    expect(put(`[{"model":"gpt-4o","provider":"openai"},{"model":"","provider":"openai"}]`).status).toBe(400)
    expect(put(`[{"model":"gpt-4o","provider":"openai","additional_attributes":{"tier":3}}]`).status).toBe(400)
    expect(ops.catalogUpsert(new Request("http://raiju.test/api/models/catalog"), "[]").status).toBe(405)
    expect(put(`[{"model":"gpt-4o","provider":"openai","additional_attributes":{"tier":"gold"}}]`).status).toBe(204)
    expect(existsSync(path + ".catalog.json")).toBe(true)
    expect(try readFileSync(path + ".catalog.json", "utf8").includes(`"openai/gpt-4o":{"tier":"gold"}`)).toBe(true)
    // a batch with one unknown entry changes nothing
    expect(put(`[{"model":"gpt-4o-mini","provider":"openai","additional_attributes":{"tier":"x"}},{"model":"no-such-model","provider":"openai"}]`).status).toBe(404)
    expect(try readFileSync(path + ".catalog.json", "utf8").includes("gpt-4o-mini")).toBe(false)
    expect(put(`[{"model":"gpt-4o","provider":"openai","additional_attributes":{}}]`).status).toBe(204)
    expect(try readFileSync(path + ".catalog.json", "utf8").includes("gpt-4o")).toBe(false)
  } finally {
    try rmSync(path + ".catalog.json", { force: true })
  }
})

test("circuit policy routes: create, conflict, update, delete; a vault flush needs a vault", () => {
  const eng = new Engine({})
  const ops = new Ops(eng, new ConfigStore("/tmp/raiju-ops-policy.json", {}))
  const body = `{"name":"p","primary_provider":"a","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"signals":[{"source":"response_header","header_name":"x"}]}}`
  expect(ops.circuitPoliciesRoute("POST", "/api/circuit-breaker/policies", body).status).toBe(201)
  expect(ops.circuitPoliciesRoute("POST", "/api/circuit-breaker/policies", body).status).toBe(409)
  expect(ops.circuitPoliciesRoute("GET", "/api/circuit-breaker/policies", "").body.includes(`"name":"p"`)).toBe(true)
  expect(ops.circuitPoliciesRoute("PUT", "/api/circuit-breaker/policies/p", body).status).toBe(200)
  const nameless = `{"primary_provider":"a","primary_model":"m","fallback_provider":"b","fallback_model":"n","condition":{"signals":[{"source":"response_header","header_name":"x"}]}}`
  expect(ops.circuitPoliciesRoute("PUT", "/api/circuit-breaker/policies/q", nameless).status).toBe(404)
  expect(ops.circuitPoliciesRoute("DELETE", "/api/circuit-breaker/policies/p", "").status).toBe(200)
  expect(ops.circuitPoliciesRoute("DELETE", "/api/circuit-breaker/policies/p", "").status).toBe(404)
  expect(ops.circuitPoliciesRoute("PATCH", "/api/circuit-breaker/policies", "").status).toBe(405)
  expect(ops.vaultFlush().status).toBe(400)
})

test("analytics and MCP routes answer from the store and refuse what is not recorded", () => {
  const dir = "/tmp/raiju-ops-analytics-" + (try secureHex(6))
  try {
    try mkdirSync(dir, { recursive: true })
    const eng = new Engine({})
    eng.logStore = try new LogStore(defaultLogStoreConfig(dir))
    const now = Date.now()
    eng.logStore!.add({ id: "d1", ts: now - 1000.0, request_id: "r1", op: "chat", provider: "openai", model: "gpt-4o", status: 200, latency_ms: 20.0, prompt_tokens: 3, completion_tokens: 4, cost: 0.5, cache_hit: false, virtual_key: "vk1" })
    const ops = new Ops(eng, new ConfigStore("/tmp/raiju-ops-analytics.json", {}))
    const get = (p: string): Reply => ops.logsRoute(new Request("http://raiju.test" + p), p.split("?")[0]!, "")
    const dash = get("/api/logs/dashboard")
    expect(dash.status).toBe(200)
    expect(dash.body.includes(`"total_requests":1`)).toBe(true)
    expect(dash.body.includes(`"virtual_key":{"rankings"`)).toBe(true)
    expect(get("/api/logs/histogram/cost/by-dimension?dimension=team_name").status).toBe(400)
    expect(get("/api/logs/histogram/cost/by-dimension?dimension=user").status).toBe(200)
    expect(get("/api/logs/histogram/cost/by-dimension?dimension=virtual_key").body.includes(`"dimension_values":["vk1"]`)).toBe(true)
    expect(get("/api/logs/rankings?limit=0").status).toBe(400)
    expect(get("/api/logs/nothing-here").status).toBe(404)
    expect(get(`/api/logs/histogram?start_time=${now}&end_time=${now - 5.0}`).status).toBe(400)
    expect(get("/api/logs/dropped").body).toBe(`{"dropped_requests":0}`)
    expect(ops.logsRoute(new Request("http://raiju.test/api/mcp-logs"), "/api/mcp-logs", "").body.includes(`"total_count":0`)).toBe(true)
    ops.recordMcp({ server: "weather", tool: "get_weather", latencyMs: 12.0, ok: false, error: "boom" })
    const mcp = ops.logsRoute(new Request("http://raiju.test/api/mcp-logs"), "/api/mcp-logs", "")
    expect(mcp.body.includes(`"tool_name":"get_weather"`)).toBe(true)
    expect(mcp.body.includes(`"status":"error"`)).toBe(true)
    // the LLM views leave the MCP entry out
    expect(get("/api/logs/dashboard").body.includes(`"total_requests":1`)).toBe(true)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("logs_only MCP tool errors keep placeholders, and the reveal mapping shows only to a caller holding Logs:Reveal", () => {
  const dir = "/tmp/raiju-ops-reveal-" + (try secureHex(6))
  try {
    try mkdirSync(dir, { recursive: true })
    const eng = new Engine({ guardrails: { enabled: true, detect: ["email"], mode: "redact", apply_to: "both", logs_only: true } })
    eng.logStore = try new LogStore(defaultLogStoreConfig(dir))
    const ops = new Ops(eng, new ConfigStore("/tmp/raiju-ops-reveal.json", { governance: { users: [{ name: "vi", role: "viewer" }] } }))
    ops.recordMcp({ server: "crm", tool: "lookup", latencyMs: 3.0, ok: false, error: "no account for jane.r@example.com" })
    const list = ops.logsRoute(new Request("http://raiju.test/api/mcp-logs"), "/api/mcp-logs", "")
    expect(list.body.includes("jane.r@example.com")).toBe(false)
    expect(list.body.includes("[EMAIL-1]")).toBe(true)
    const e = eng.logStore!.viewSince(0.0)[0]!
    const p = "/api/mcp-logs/" + e.id
    const hidden = ops.logsRoute(new Request("http://raiju.test" + p), p, "", undefined, false)
    expect(hidden.body.includes("redaction_mapping")).toBe(false)
    const shown = ops.logsRoute(new Request("http://raiju.test" + p), p, "", undefined, true)
    expect(shown.body.includes(`"redaction_mapping":{"output":{"EMAIL-1":"jane.r@example.com"}}`)).toBe(true)
    // the admin (and the legacy admin credential) holds Logs:Reveal; a viewer does not
    expect(ops.mayReveal("admin")).toBe(true)
    expect(ops.mayReveal("vi")).toBe(false)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("hidden_request_types leave entries out of the log reads by Bifrost type or op name", () => {
  const entry = (id: string, op: string, streamed: bool): LogEntry => ({ id: id, ts: 1.0, request_id: id, op: op, provider: "openai", model: "m", status: 200, latency_ms: 1.0, prompt_tokens: 1, completion_tokens: 1, cost: 0.0, cache_hit: false, streamed: streamed ? true : undefined })
  const es = [entry("a", "chat", false), entry("b", "chat", true), entry("c", "embeddings", false), entry("d", "files.upload", false)]
  const tool: LogEntry = entry("t", "tool", false)
  tool.kind = "mcp"
  es.push(tool)
  const ids = (hidden: string[] | undefined): string => withoutHidden(es, hidden).map((e) => e.id).join(",")
  expect(ids(undefined)).toBe("a,b,c,d,t")
  expect(ids(["chat_completion_stream"])).toBe("a,c,d,t")
  expect(ids([" chat_completion ", "embedding", ""])).toBe("b,d,t")
  expect(ids(["files.upload", "tool"])).toBe("a,b,c,t")
  const dir = "/tmp/raiju-ops-hidden-" + (try secureHex(6))
  try {
    try mkdirSync(dir, { recursive: true })
    const eng = new Engine({})
    eng.logStore = try new LogStore(defaultLogStoreConfig(dir))
    for (const e of es) eng.logStore!.add({ id: e.id, ts: Date.now() - 1000.0, request_id: e.id, op: e.op, provider: "openai", model: "m", status: 200, latency_ms: 1.0, prompt_tokens: 1, completion_tokens: 1, cost: 0.0, cache_hit: false, streamed: e.streamed, kind: e.kind })
    const ops = new Ops(eng, new ConfigStore(dir + "/config.json", { client: { hidden_request_types: ["embedding"] } }))
    const get = (p: string): Reply => ops.logsRoute(new Request("http://raiju.test" + p), p.split("?")[0]!, "")
    expect(get("/api/logs").body.includes(`"total_requests":3`)).toBe(true)
    expect(get("/api/logs/c").status).toBe(404)
    expect(get("/api/logs/a").status).toBe(200)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("log histogram counts requests per bucket by status", () => {
  const dir = "/tmp/raiju-ops-hist-" + (try secureHex(6))
  try mkdirSync(dir, { recursive: true })
  const eng = new Engine({})
  eng.logStore = try new LogStore(defaultLogStoreConfig(dir))
  const t0 = Math.floor(Date.now() / 60000.0) * 60000.0
  const entry = (ts: f64, status: int): LogEntry => ({ id: "l" + ts + "-" + status, ts: ts, request_id: "r", op: "chat", provider: "openai", model: "gpt-4o", status: status, latency_ms: 1.0, prompt_tokens: 1, completion_tokens: 1, cost: 0.0, cache_hit: false })
  eng.logStore!.add(entry(t0 + 1000.0, 200))
  eng.logStore!.add(entry(t0 + 2000.0, 200))
  eng.logStore!.add(entry(t0 + 3000.0, 500))
  eng.logStore!.add(entry(t0 + 61000.0, 499))
  const ops = new Ops(eng, new ConfigStore("/tmp/raiju-ops-hist.json", {}))
  const r = ops.logsHistogram(new Request(`http://raiju.test/api/logs/histogram?start_time=${t0}&end_time=${t0 + 120000.0}`))
  expect(r.status).toBe(200)
  const h = try JSON.parse(r.body) as { buckets: { count: int, success: int, error: int, cancelled: int }[], bucket_size_seconds: int }
  expect(h.bucket_size_seconds).toBe(60)
  expect(h.buckets.length).toBe(2)
  expect(h.buckets[0]!.count).toBe(3)
  expect(h.buckets[0]!.success).toBe(2)
  expect(h.buckets[0]!.error).toBe(1)
  expect(h.buckets[1]!.cancelled).toBe(1)
  expect(ops.logsHistogram(new Request(`http://raiju.test/api/logs/histogram?start_time=${t0 + 5.0}&end_time=${t0}`)).status).toBe(400)
  try rmSync(dir, { recursive: true, force: true })
})

function fwdOf(status: int, text: string, rpc: bool): Fwd {
  return { status: status, text: text, ct: "", stream: undefined, rpc: rpc, error: "", binding: "", method: "POST", grpc: -1, rawReq: "", rawResp: "", tap: undefined }
}

test("an agent's unary answer is read the same from either binding", () => {
  const ok = unaryOf(fwdOf(200, `{"jsonrpc":"2.0","id":1,"result":{"task":{"id":"t1"}}}`, true))
  expect(ok.failed).toBe(false)
  expect(ok.result).toBe(`{"task":{"id":"t1"}}`)
  expect(unaryOf(fwdOf(200, `{"jsonrpc":"2.0","id":1,"result":null}`, true)).result).toBe("null")
  const bad = unaryOf(fwdOf(200, `{"jsonrpc":"2.0","id":1,"error":{"code":-32001,"message":"task not found"}}`, true))
  expect(bad.failed).toBe(true)
  expect(bad.code).toBe(-32001)
  expect(bad.message).toBe("task not found")
  const html = unaryOf(fwdOf(502, "<html>bad gateway</html>", true))
  expect(html.failed).toBe(true)
  expect(html.message).toBe("the agent answered HTTP 502")
  expect(unaryOf(fwdOf(200, "plain text", true)).failed).toBe(true)
  const rest = unaryOf(fwdOf(200, `{"id":"t1"}`, false))
  expect(rest.failed).toBe(false)
  expect(rest.result).toBe(`{"id":"t1"}`)
  expect(unaryOf(fwdOf(204, "", false)).result).toBe("{}")
  const gone = unaryOf(fwdOf(404, `{"error":{"code":404,"status":"NOT_FOUND","message":"gone","details":[{"reason":"TASK_NOT_FOUND"}]}}`, false))
  expect(gone.failed).toBe(true)
  expect(gone.code).toBe(-32001)
  expect(gone.message).toBe("gone")
  expect(unaryOf(fwdOf(500, "oops", false)).code).toBe(-32603)
})

test("an agent's answer reaches the caller in the caller's binding", () => {
  const same = a2aRender(true, "\"1\"", fwdOf(201, `{"id":"t1"}`, false), unaryOf(fwdOf(201, `{"id":"t1"}`, false)))
  expect(same.status).toBe(201)
  expect(a2aRender(true, "\"1\"", fwdOf(204, "", false), unaryOf(fwdOf(204, "", false))).status).toBe(204)
  const rpcErr = fwdOf(200, `{"jsonrpc":"2.0","id":1,"error":{"code":-32001,"message":"gone"}}`, true)
  expect(a2aRender(true, "\"1\"", rpcErr, unaryOf(rpcErr)).status).toBe(404)
  expect(a2aRender(false, "5", rpcErr, unaryOf(rpcErr)).status).toBe(200)
  const restErr = fwdOf(404, `{"error":{"code":404,"status":"NOT_FOUND","message":"gone"}}`, false)
  expect(a2aRender(false, "5", restErr, unaryOf(restErr)).status).toBe(200)
  expect(a2aRender(true, "\"1\"", restErr, unaryOf(restErr)).status).toBe(404)
})

test("a refusal comes in the caller's binding, and an ETag is matched like HTTP does", () => {
  expect(a2aDeny(false, 403, "no", "permission_error").status).toBe(403)
  expect(a2aDeny(true, 401, "no", "authentication_error").headers.get("www-authenticate")).toBe(`ApiKey name="x-bf-vk", in="header"`)
  expect(a2aDeny(false, 401, "no", "authentication_error").headers.get("www-authenticate")).toBe(`Bearer realm="raiju", Basic realm="raiju"`)
  expect(etagMatches(`"a", "b"`, `"b"`)).toBe(true)
  expect(etagMatches(`W/"b"`, `"b"`)).toBe(true)
  expect(etagMatches("*", `"b"`)).toBe(true)
  expect(etagMatches(`"a"`, `"b"`)).toBe(false)
  expect(etagMatches("", `"b"`)).toBe(false)
  const h: Hdrs = new Map()
  h.set("if-none-match", `"zzz"`)
  expect(a2aCardResponse("{}", h).status).toBe(200)
  const first = a2aCardResponse("{}", new Map())
  const tag = first.headers.get("etag") ?? ""
  expect(tag.byteLength).toBe(34)
  h.set("if-none-match", tag)
  expect(a2aCardResponse("{}", h).status).toBe(304)
})

test("a sign-in returns only to the gateway's own consent pages", () => {
  expect(returnPath("/oauth/consent?flow=abc")).toBe("/oauth/consent?flow=abc")
  expect(returnPath("/workspace/mcp-sessions/auth?flow=abc&kind=headers")).toBe("/workspace/mcp-sessions/auth?flow=abc&kind=headers")
  expect(returnPath("https://evil.example/oauth/consent?flow=abc")).toBe("")
  expect(returnPath("//evil.example/oauth/consent?x")).toBe("")
  expect(returnPath("/oauth/consent?flow=abc#t=x")).toBe("")
  expect(returnPath("/api/config")).toBe("")
  expect(returnPath("")).toBe("")
})

test("a virtual key in a header beside an OAuth token is found, a provider key is not", () => {
  const h: Hdrs = new Map()
  expect(headerKeyOf(h)).toBe("")
  h.set("x-api-key", "sk-ant-provider")
  expect(headerKeyOf(h)).toBe("")
  h.set("api-key", "sk-bf-x")
  expect(headerKeyOf(h)).toBe("sk-bf-x")
  h.set("x-bf-vk", "anything")
  expect(headerKeyOf(h)).toBe("anything")
})

test("config generations: a shared file is reread, another node's own file is left alone, and a sibling's stale one waits", () => {
  const path = "/tmp/raiju-ops-gen-" + (try secureHex(6)) + ".json"
  try {
    const t1 = `{"governance":{"virtual_keys":[{"id":"vk-1","value":"sk-bf-1"}]}}`
    try writeFileSync(path, t1)
    const raw = try JSON.parse(t1) as Config
    const store = new ConfigStore(path, raw)
    const ops = new Ops(new Engine(raw), store)
    let applied: int[] = []
    store.onChange = (c) => {
      applied.push((c.governance?.virtual_keys ?? []).length)
    }
    const me = cluster.nodeOf(ops.nodeId)
    // another node saved, and the file is shared: reread (config_sync defaults to "file")
    const t2 = `{"governance":{"virtual_keys":[]}}`
    try writeFileSync(path, t2)
    ops.takeConfigGen(JSON.stringify({ sha: textSha(t2), node: me + "-other" }))
    expect(applied).toEqual([0])
    expect(store.fileSha).toBe(textSha(t2))
    // a generation this node's file does not hold: nothing is applied (no pull without config_sync "pull")
    ops.takeConfigGen(JSON.stringify({ sha: textSha("{}"), node: me + "-other" }))
    expect(applied).toEqual([0])
    // a sibling worker's save that the file no longer holds (it saved again since): the next generation follows
    ops.takeConfigGen(JSON.stringify({ sha: textSha("{}"), node: me }))
    expect(applied).toEqual([0])
    // a sibling worker's save the file holds is always reread
    try writeFileSync(path, t1)
    ops.takeConfigGen(JSON.stringify({ sha: textSha(t1), node: me }))
    expect(applied).toEqual([0, 1])
    // a deletion or a value that is not a generation is ignored
    ops.takeConfigGen(undefined)
    ops.takeConfigGen("junk")
    expect(applied.length).toBe(2)
  } finally {
    try rmSync(path, { force: true })
  }
})

test("storageProblems names a required log store or audit log that could not open, and not one with required false", () => {
  const dir = "/tmp/raiju-ops-storage-" + (try secureHex(6))
  try {
    try mkdirSync(dir, { recursive: true })
    try writeFileSync(dir + "/blocker", "x")
    const bad: Config = { logs_store: { enabled: true, dir: dir + "/blocker/logs" }, audit: { enabled: true, dir: dir + "/blocker/audit", key: "k" } }
    const ops = new Ops(new Engine(bad), new ConfigStore(dir + "/c.json", bad))
    const ps = ops.storageProblems()
    expect(ps.length).toBe(2)
    expect(ps[0]!.startsWith("logs_store: ")).toBe(true)
    expect(ps[1]!.startsWith("audit: ")).toBe(true)
    const soft: Config = { logs_store: { enabled: true, required: false, dir: dir + "/blocker/logs" }, audit: { enabled: true, required: false, dir: dir + "/blocker/audit", key: "k" } }
    const sops = new Ops(new Engine(soft), new ConfigStore(dir + "/c.json", soft))
    expect(sops.storageProblems().length).toBe(0)
    const good: Config = { logs_store: { enabled: true, dir: dir + "/logs" }, audit: { enabled: true, dir: dir + "/audit", key: "k" } }
    const gops = new Ops(new Engine(good), new ConfigStore(dir + "/c.json", good))
    expect(gops.storageProblems().length).toBe(0)
    expect(gops.audit !== undefined && gops.engine.logStore !== undefined).toBe(true)
  } finally {
    try rmSync(dir, { recursive: true, force: true })
  }
})

test("redivisionSig follows an equal split's roster and the caps it divides, and is empty for any other split", () => {
  const g: GovernanceConfig = {
    budgets: [{ id: "b1", max_limit: 100.0, reset_duration: "1M" }],
    rate_limits: [{ id: "r1", token_max_limit: 1000, token_reset_duration: "1m" }],
  }
  const pj: ProjectConfig = { id: "p1", name: "p", split_policy: "equal", budget_id: "b1", rate_limit_id: "r1", members: [{ id: "m1", user_id: "alice" }] }
  const sig = redivisionSig(g, pj)
  expect(sig !== "").toBe(true)
  const more: ProjectConfig = { id: "p1", name: "p", split_policy: "equal", budget_id: "b1", rate_limit_id: "r1", members: [{ id: "m1", user_id: "alice" }, { id: "m2", user_id: "bob" }] }
  expect(redivisionSig(g, more) !== sig).toBe(true)
  const g2: GovernanceConfig = { budgets: [{ id: "b1", max_limit: 200.0, reset_duration: "1M" }], rate_limits: g.rate_limits }
  expect(redivisionSig(g2, pj) !== sig).toBe(true)
  const none: ProjectConfig = { id: "p1", name: "p", split_policy: "none", budget_id: "b1", members: [{ id: "m1", user_id: "alice" }] }
  expect(redivisionSig(g, none)).toBe("")
})
