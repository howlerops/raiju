// The front end on the http1 server (raw sockets), so streamed answers reach
// the client chunk by chunk. Every request runs through the same dispatch() as
// the Bun.serve server; streaming chat requests get a sink that writes SSE
// events to the socket as they arrive from the upstream.
import { serve, Http1Request, Http1Response, BodyQueue } from "./http1"
import { WsConnection } from "./ws"
import { Engine, StreamSink, errorResponse, noHeaders } from "./gateway"
import { Ops } from "./ops"
import { clientIpFor, dispatch, clusterDispatch, compatPath, streamKind, streamsRequest, routeStream, httpPathLabel, http1Upgrade, largeFront, limitedBody, credentialRefusal, heldBody, Served } from "./server"
import { bodyBudget } from "./bodybudget"
import { ServerLimits } from "./lifecycle"
import { snapshot } from "./schemas"
import { TransportRun, transportStart, transportEnd, transportDone, transportSink } from "./pluginroute"
import * as metrics from "./metrics"
import { CLIENT_WATCH_HEADER, watchStart, watchGone, watchEnd, watched } from "./clientgone"
import { isInferencePath } from "./plughttp"
import { CLIENT_IP_HEADER } from "./clientip"

// streamThreshold: request bodies over this many bytes reach the handler as a stream (0: never; large_payload_optimization).
// limitBytes: client.max_request_body_size_mb, checked by the handler when maxBodyBytes (the parser's) is looser than it.
// limits: both read from the current config (a new connection's threshold, each request's limit), in place of the two.
// timeouts: the servers' header, idle and body timeouts and connection cap (lifecycle.tov).
export type FrontOptions = { hostname: string, port: int, maxBodyBytes: int, streamThreshold?: int, limitBytes?: int, limits?: () => { limit: int, threshold: int }, timeouts?: ServerLimits }

function pathOf(target: string): string {
  const q = target.indexOf("?")
  return q < 0 ? target : target.slice(0, q)
}

// The streamed route kind of a request this front end streams, or "". Bedrock's event streams
// are binary, which this front end can't write yet, so those answer whole.
function streamingKind(req: Http1Request, body: string): string {
  if (req.method !== "POST") return ""
  const kind = streamKind(compatPath(pathOf(req.path)))
  if (kind === "bedrock") return ""
  return streamsRequest(kind, body) ? kind : ""
}

// A request body that is still arriving, as a stream (src/http1.tov BodyQueue).
function bodyStream(q: BodyQueue): ReadableStream {
  return new ReadableStream({
    async pull(c) {
      try {
        const v = await q.next()
        if (v === undefined) c.close()
        else c.enqueue(v)
      } catch (e) {
        c.error(e)
      }
    },
    cancel() {
      q.discard()
    },
  })
}

// watch: the id of the request's client watch (clientgone.tov), "" for none; a value the client sent is dropped.
// clientIp: the client's address (clientip.tov) for the routes that read it, "" for none; the client's own value is
// dropped too.
function toRequest(req: Http1Request, host: string, watch: string, clientIp: string): Request {
  let h: Record<string, string> = req.headers
  h.delete(CLIENT_WATCH_HEADER)
  if (watch !== "") h.set(CLIENT_WATCH_HEADER, watch)
  h.delete(CLIENT_IP_HEADER)
  if (clientIp !== "") h.set(CLIENT_IP_HEADER, clientIp)
  const url = "http://" + (req.headers.get("host") ?? host) + req.path
  if (req.method === "GET" || req.method === "HEAD") return new Request(url, { method: req.method, headers: h })
  const q = req.stream
  if (q !== undefined) return new Request(url, { method: req.method, headers: h, body: bodyStream(q) })
  // the bytes, not the decoded text: a multipart upload carries binary files
  return new Request(url, { method: req.method, headers: h, body: req.bytes })
}

async function write(res: Http1Response, r: Response): Promise<int> {
  const h: Map<string, string> = new Map()
  r.headers.forEach((value, key) => {
    h.set(key, value)
  })
  // a streamed body (a large answer) goes out as it comes
  const st = r.body
  if (st !== undefined && st.pushed) {
    res.writeHead(r.status, h)
    let sent = 0
    try {
      while (true) {
        const c = await st.pull()
        const v = c.value
        if (c.done || v === undefined) break
        // a client that went away stops the source (a long-lived stream would otherwise run on)
        if (res.gone()) {
          await st.cancel()
          break
        }
        res.writeBytes(v)
        sent += v.length
      }
    } catch (e) {
      // the source failed after the head went out: the body ends here
    }
    res.end("")
    return sent
  }
  // bytes, so binary bodies (audio, images, file contents) pass through intact
  let body: u8[] = []
  try {
    body = await r.bytes()
  } catch (e) {
    body = []
  }
  res.writeHead(r.status, h)
  res.endBytes(body)
  return body.length
}

async function handle(engine: Engine, ops: Ops, host: string, req: Http1Request, res: Http1Response, limit: int): Promise<void> {
  const path = pathOf(req.path)
  // an inference request's client watch: its connection closing before the answer stops the upstream call
  const wid = watched(req.method, path, isInferencePath(compatPath(path))) ? watchStart() : ""
  if (wid !== "") res.onGone = () => watchGone(wid)
  let request = toRequest(req, host, wid, clientIpFor(engine, path, req.peer ?? "", req.headers))
  let tr: TransportRun | undefined = undefined
  const t0 = performance.now()
  // (a streamed body has not arrived: its declared length stands in)
  const inBytes = req.stream === undefined ? req.bytes.length * 1.0 : (parseFloat(req.headers.get("content-length") ?? "0") ?? 0.0)
  // what this request holds of the process's body budget (heldBody), given back when it is done
  let held = 0
  // the body's text, for the streaming check (a streamed body is read below)
  let bodyText = req.body
  try {
    // a big body is not read for a caller its credentials already refuse
    const refused = await credentialRefusal(engine, ops, request, limit > 0 ? limit : NO_LIMIT)
    if (refused !== undefined) {
      const n = await write(res, refused)
      metrics.observeHttp(httpPathLabel(path, refused.status), req.method, refused.status, (performance.now() - t0) / 1000.0, inBytes, n * 1.0, metrics.httpCustomValues(request.headers))
      return
    }
    // large_payload_optimization: a big body is refused, streamed on, or read after all
    const lf = await largeFront(engine, request)
    if (lf instanceof Response) {
      const n = await write(res, lf)
      metrics.observeHttp(httpPathLabel(path, lf.status), req.method, lf.status, (performance.now() - t0) / 1000.0, inBytes, n * 1.0, metrics.httpCustomValues(request.headers))
      return
    }
    if (lf instanceof Request) {
      // (a body the feature streams on is not held here)
      request = lf
      if (limit > 0) {
        const within = await limitedBody(request, limit)
        if (within === undefined) {
          const n = await write(res, errorResponse(413, "request body too large", "invalid_request_error", noHeaders()))
          metrics.observeHttp(httpPathLabel(path, 413), req.method, 413, (performance.now() - t0) / 1000.0, inBytes, n * 1.0, metrics.httpCustomValues(request.headers))
          return
        }
        request = within
      }
    } else {
      // the body is read whole here, charged to the process's body budget first (413 and 503 refuse it unread)
      const hb = await heldBody(engine, request, limit > 0 ? limit : NO_LIMIT)
      const no = hb.res
      if (no !== undefined) {
        const n = await write(res, no)
        metrics.observeHttp(httpPathLabel(path, no.status), req.method, no.status, (performance.now() - t0) / 1000.0, inBytes, n * 1.0, metrics.httpCustomValues(request.headers))
        return
      }
      request = hb.req
      held = hb.held
      if (req.stream !== undefined) {
        // the body stream is spent: the request is rebuilt around what was read, so a later reader of its body
        // (the plugins' transport hooks on a large body) gets the bytes
        bodyText = await request.text()
        request = new Request(request.url, { method: request.method, headers: snapshot(request.headers), body: bodyText })
      }
    }
    // the plugins' HTTP pre hooks, before the request is routed: they may rewrite it or answer it
    const th = await transportStart(engine, request)
    tr = th.tr
    if (th.response !== undefined) {
      const n = await write(res, th.response)
      metrics.observeHttp(httpPathLabel(path, th.response.status), req.method, th.response.status, (performance.now() - t0) / 1000.0, inBytes, n * 1.0, metrics.httpCustomValues(request.headers))
      return
    }
    request = th.request
    const kind = streamingKind(req, tr === undefined ? bodyText : th.body)
    if (kind !== "") {
      const sink = new StreamSink(
        (status, headers) => res.writeHead(status, headers),
        (chunk) => res.write(chunk),
        () => res.end(),
      )
      // the plugins' chunk hooks see each event on its way to the client
      const r = await routeStream(engine, request, kind, transportSink(tr, sink))
      // Bifrost's http_* metrics; a streamed body counts as 0 bytes
      let n = 0
      let status = r.status
      if (!sink.started) {
        const hooked = await transportEnd(engine, tr, r)
        status = hooked.status
        n = await write(res, hooked)
      }
      metrics.observeHttp(httpPathLabel(path, status), req.method, status, (performance.now() - t0) / 1000.0, inBytes, n * 1.0, metrics.httpCustomValues(request.headers))
      return
    }
    const r = await transportEnd(engine, tr, await dispatch(engine, ops, request))
    const n = await write(res, r)
    metrics.observeHttp(httpPathLabel(path, r.status), req.method, r.status, (performance.now() - t0) / 1000.0, inBytes, n * 1.0, metrics.httpCustomValues(request.headers))
  } catch (e) {
    if (!res.finished) {
      const h: Map<string, string> = new Map()
      h.set("content-type", "application/json")
      res.writeHead(500, h)
      res.end(`{"error":{"message":"internal error","type":"api_error"}}`)
    }
    console.error(`raiju: ${e.message}`)
  } finally {
    bodyBudget().give(held)
    transportDone(engine, tr)
    if (wid !== "") {
      res.onGone = undefined
      watchEnd(wid)
    }
  }
}

// No body limit of the handler's own (the parser's applies).
const NO_LIMIT = 1099511627776

function ms(seconds: f64): int {
  return seconds > 0 ? Math.max(1, Math.round(seconds * 1000)) : 0
}

export function startFront(engine: Engine, ops: Ops, opts: FrontOptions): Served {
  const host = `${opts.hostname}:${opts.port}`
  const onUpgrade = (req: Http1Request, accept: (protocol: string) => WsConnection | undefined, reject: (status: int, body: string) => void): bool => {
    // every WebSocket route, the realtime relay among them (server.tov's wsUpgrade)
    return http1Upgrade(engine, ops, toRequest(req, host, "", ""), accept, reject)
  }
  const lim = opts.limits
  const thresholdOf = lim === undefined ? undefined : () => lim().threshold
  const t = opts.timeouts
  const limits = t === undefined ? undefined : { headerMs: ms(t.headerSeconds), idleMs: ms(t.idleSeconds), bodyMs: ms(t.bodySeconds), maxConnections: t.maxConnections }
  const srv = serve({ hostname: opts.hostname, port: opts.port, maxBodyBytes: opts.maxBodyBytes, streamThreshold: opts.streamThreshold, thresholdOf: thresholdOf, onUpgrade: onUpgrade, limits: limits }, (req, res) => {
    // runs as its own task; the response is finished from there
    handle(engine, ops, host, req, res, lim !== undefined ? lim().limit : (opts.limitBytes ?? 0))
  })
  return {
    url: `http://${host}/`,
    stopListener: () => {
      srv.stop()
    },
    open: (): int => srv.open(),
  }
}

// The cluster listener (cluster.listen_port) on the http1 server: the peer routes, /health and, with
// cluster.serve_metrics, /metrics (server.tov clusterDispatch). Bodies are read whole, up to maxBody bytes.
export function startClusterFront(engine: Engine, ops: Ops, hostname: string, port: int, maxBody: int, t: ServerLimits): Served {
  const host = `${hostname}:${port}`
  const limits = { headerMs: ms(t.headerSeconds), idleMs: ms(t.idleSeconds), bodyMs: ms(t.bodySeconds), maxConnections: t.maxConnections }
  const srv = serve({ hostname: hostname, port: port, maxBodyBytes: maxBody, limits: limits }, (req, res) => {
    clusterHandle(engine, ops, host, req, res)
  })
  return {
    url: `http://${host}/`,
    stopListener: () => {
      srv.stop()
    },
    open: (): int => srv.open(),
  }
}

async function clusterHandle(engine: Engine, ops: Ops, host: string, req: Http1Request, res: Http1Response): Promise<void> {
  try {
    await write(res, await clusterDispatch(engine, ops, toRequest(req, host, "", "")))
  } catch (e) {
    if (!res.finished) {
      const h: Map<string, string> = new Map()
      h.set("content-type", "application/json")
      res.writeHead(500, h)
      res.end(`{"error":{"message":"internal error","type":"api_error"}}`)
    }
    console.error(`raiju: cluster listener: ${e.message}`)
  }
}
