// Maxim observability sink. The request goes to the SDK log endpoint that
// maxim-go's PushLogs uses: POST {base}/api/sdk/v3/log?id={repoId} with the
// x-maxim-api-key header and a body of one serialized commit per line. Each log
// entry becomes a trace (create) and a generation (update) with its tokens,
// cost and latency. The line envelope (entity, id, action, data) follows the
// action names maxim-go commits; its Serialize method was not readable, so the
// envelope keys are inferred and not verified against a live repository.
// The x-bf-maxim-* headers of a request set the trace and generation ids and
// names, the session and the tags, as Bifrost's Maxim plugin reads them (reqlog.tov).
import { LogEntry } from "./logstore"
import { isoMs } from "./exports"
import { trimSlash } from "./providers/types"

export const MAXIM_BASE = "https://app.getmaxim.ai"

export type MaximRequest = { url: string, method: "POST", headers: Map<string, string>, body: string }

// Trace data and generation data share one shape; a line sets only its own fields.
type MaximData = {
  id?: string,
  name?: string,
  startTimestamp?: string,
  provider: string,
  model: string,
  status?: int,
  virtual_key?: string,
  prompt_tokens?: int,
  completion_tokens?: int,
  cost?: f64,
  latency_ms?: f64,
  cache_hit?: bool,
  error?: string,
  // the trace's session and tags, and the trace a generation belongs to
  session_id?: string,
  tags?: Record<string, string>,
  traceId?: string,
}

type MaximLine = { entity: string, id: string, action: string, data: MaximData }

// One x-bf-maxim-* attribute the row carries, if the caller sent it.
function attr(e: LogEntry, name: string): string | undefined {
  const m = e.maxim
  if (m === undefined) return undefined
  return m.get(name)
}

// The log repo a row goes to: the x-bf-maxim-log-repo-id it named, else the exporter's own.
export function repoOf(e: LogEntry, dflt: string): string {
  return attr(e, "log-repo-id") ?? dflt
}

// The trace tags: the row's metadata (logging headers and dimensions), then the x-bf-maxim-* tags.
function tagsOf(e: LogEntry): Record<string, string> {
  const out: Record<string, string> = new Map()
  const md = e.metadata
  if (md !== undefined) {
    for (const k of md.keys()) out.set(k, md.get(k) ?? "")
  }
  const mt = e.maxim_tags
  if (mt !== undefined) {
    for (const k of mt.keys()) out.set(k, mt.get(k) ?? "")
  }
  return out
}

// The envelope lines for one entry: a trace with its request tags, then a
// generation with the usage numbers.
export function maximLines(e: LogEntry): string[] {
  const traceId = attr(e, "trace-id") ?? e.request_id
  const trace: MaximLine = {
    entity: "trace",
    id: traceId,
    action: "create",
    data: {
      id: traceId, name: attr(e, "trace-name") ?? e.op, startTimestamp: isoMs(e.ts), provider: e.provider, model: e.model, status: e.status,
      virtual_key: e.virtual_key ?? "", session_id: attr(e, "session-id"), tags: tagsOf(e),
    },
  }
  const gen: MaximLine = {
    entity: "generation",
    id: attr(e, "generation-id") ?? e.id,
    action: "result",
    data: {
      name: attr(e, "generation-name"),
      traceId: traceId,
      provider: e.provider,
      model: e.model,
      prompt_tokens: e.prompt_tokens,
      completion_tokens: e.completion_tokens,
      cost: e.cost,
      latency_ms: e.latency_ms,
      cache_hit: e.cache_hit,
      error: e.error ?? "",
    },
  }
  return [JSON.stringify(trace), JSON.stringify(gen)]
}

// The PushLogs POST for a batch. The log repo id is required by the endpoint.
export function maximRequest(base: string, apiKey: string, repoId: string, rows: LogEntry[]): MaximRequest {
  let body = ""
  for (const e of rows) {
    for (const line of maximLines(e)) body += line + "\n"
  }
  const headers: Map<string, string> = new Map()
  headers.set("content-type", "application/json")
  headers.set("accept", "application/json")
  headers.set("x-maxim-api-key", apiKey)
  const root = trimSlash(base === "" ? MAXIM_BASE : base)
  return { url: `${root}/api/sdk/v3/log?id=${repoId}`, method: "POST", headers: headers, body: body }
}

// ---- tests ----

function sample(id: string): LogEntry {
  return {
    id: id,
    ts: 1791979200000.0,
    request_id: "req-" + id,
    op: "chat",
    provider: "openai",
    model: "gpt-4o",
    status: 200,
    latency_ms: 42.0,
    prompt_tokens: 5,
    completion_tokens: 6,
    cost: 0.5,
    cache_hit: false,
    input: "secret",
  }
}

test("maxim: PushLogs URL with the repo id, and the API key header", () => {
  const r = maximRequest("https://maxim.example/", "mk", "repo1", [sample("a")])
  expect(r.url).toBe("https://maxim.example/api/sdk/v3/log?id=repo1")
  expect(r.method).toBe("POST")
  expect(r.headers.get("x-maxim-api-key")).toBe("mk")
  expect(r.headers.get("content-type")).toBe("application/json")
})

test("maxim: default base when none is set", () => {
  expect(maximRequest("", "k", "r", []).url).toBe("https://app.getmaxim.ai/api/sdk/v3/log?id=r")
})

test("maxim: two newline-separated JSON lines per entry, no content", () => {
  const r = maximRequest(MAXIM_BASE, "k", "r", [sample("a"), sample("b")])
  const lines = r.body.split("\n")
  expect(lines.length).toBe(5)
  expect(lines[4]).toBe("")
  const t = try JSON.parse(lines[0]!) as MaximLine
  expect(t.entity).toBe("trace")
  expect(t.action).toBe("create")
  expect(t.id).toBe("req-a")
  expect(t.data.startTimestamp).toBe("2026-10-14T12:00:00.000Z")
  const g = try JSON.parse(lines[1]!) as MaximLine
  expect(g.entity).toBe("generation")
  expect(g.id).toBe("a")
  expect(r.body.includes("secret")).toBe(false)
})

test("maxim: x-bf-maxim attributes name the trace and generation, and tag the trace", () => {
  const e = sample("c")
  const ids: Record<string, string> = new Map()
  ids.set("trace-id", "tr-9")
  ids.set("generation-name", "answer")
  ids.set("session-id", "sess-1")
  ids.set("log-repo-id", "repo-2")
  const tags: Record<string, string> = new Map()
  tags.set("customer", "acme")
  e.maxim = ids
  e.maxim_tags = tags
  const md: Record<string, string> = new Map()
  md.set("env", "prod")
  e.metadata = md
  const lines = maximLines(e)
  const t = try JSON.parse(lines[0]!) as MaximLine
  expect(t.id).toBe("tr-9")
  expect(t.data.session_id).toBe("sess-1")
  expect(t.data.tags!.get("customer")).toBe("acme")
  expect(t.data.tags!.get("env")).toBe("prod")
  const g = try JSON.parse(lines[1]!) as MaximLine
  expect(g.id).toBe("c")
  expect(g.data.traceId).toBe("tr-9")
  expect(g.data.name).toBe("answer")
  expect(repoOf(e, "repo-1")).toBe("repo-2")
  expect(repoOf(sample("d"), "repo-1")).toBe("repo-1")
})
