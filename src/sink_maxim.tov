// Maxim observability sink: the trace Bifrost's Maxim plugin (plugins/maxim) writes for each request, sent as
// maxim-go's logger sends it. The request goes to the SDK log endpoint that maxim-go's PushLogs uses: POST
// {base}/api/sdk/v3/log?id={repoId} with the x-maxim-api-key header and a body of one commit log per line, each
// serialized as maxim-go's CommitLog.Serialize writes it: `<entity>{id=<id>,action=<action>,data=<json>}`.
//
// Per log entry, in the plugin's order (its PreLLMHook, then PostLLMHook):
//   trace create (id, name bifrost_<request type> or x-bf-maxim-trace-name, sessionId, startTimestamp),
//   trace update {input: the latest message}, trace add-generation (id, provider, model, messages,
//   modelParameters, name), then generation result (the response, or {error}) and generation end, trace end,
//   and one update {tags: {k: v}} on the generation and on the trace per tag: the x-bf-maxim-* tags, the row's
//   metadata (dimensions and logging headers) not already set by them, model, upstream_latency_ms and
//   overhead_latency_ms, and header.<name> for each header the exporter's request_headers named (sensitive ones
//   REDACTED, as the plugin redacts them).
// An x-bf-maxim-generation-id names a generation made elsewhere: no trace or generation is created then (the plugin
// returns early), the result goes to that generation and the trace is ended only when x-bf-maxim-trace-id names it.
// Realtime turns and the MCP and A2A rows are not traced, as the plugin traces LLM requests only and skips realtime.
// The messages, the input and the result come from the row's request and response bodies, so they are sent when the
// exporter includes content (include_content; config_compat sets it for a Bifrost maxim plugin) and the request's
// content was logged.
import { LogEntry, kindOf, bifrostRequestType } from "./logstore"
import { isoMs } from "./exports"
import { trimSlash } from "./providers/types"
import { Field, fields, elements, find, rawStr, quote, build } from "./json"
import { sha256, toHex, utf8 } from "./crypto"
import { decode } from "./base64"
import { pctEncode } from "./cloud_auth"

export const MAXIM_BASE = "https://app.getmaxim.ai"

export type MaximRequest = { url: string, method: "POST", headers: Map<string, string>, body: string }

// One x-bf-maxim-* attribute the row carries, if the caller sent it.
function attr(e: LogEntry, name: string): string | undefined {
  const m = e.maxim
  if (m === undefined) return undefined
  const v = m.get(name)
  return v === undefined || v === "" ? undefined : v
}

// The log repo a row goes to: the x-bf-maxim-log-repo-id it named, else the exporter's own.
export function repoOf(e: LogEntry, dflt: string): string {
  return attr(e, "log-repo-id") ?? dflt
}

// One commit log line, as maxim-go's CommitLog.Serialize writes it.
export function commitLine(entity: string, id: string, action: string, data: string): string {
  return `${entity}{id=${id},action=${action},data=${data}}`
}

// Whether a row is traced: an LLM request that is not a realtime turn.
export function traced(e: LogEntry): bool {
  return kindOf(e) === "llm" && e.op !== "realtime"
}

// The request body's fields, or none when it was not kept or is not a JSON object.
function bodyFields(raw: string | undefined): Field[] {
  if (raw === undefined || !raw.trimStart().startsWith("{")) return []
  try {
    return fields(raw)
  } catch (e) {
    return []
  }
}

// The text a message's content gives as the latest message: a string as it is, else its last text block, else "-"
// (the plugin's placeholder).
function latestText(content: string | undefined): string {
  if (content === undefined) return "-"
  try {
    if (content.startsWith("\"")) return rawStr([{ key: "c", raw: content }], "c") ?? "-"
    if (content.startsWith("[")) {
      const parts = elements(content)
      for (let i = parts.length - 1; i >= 0; i--) {
        const t = rawStr(fields(parts[i]!), "text")
        if (t !== undefined) return t
      }
    }
  } catch (e) {
    return "-"
  }
  return "-"
}

// The generation's messages ([{role, content}] as raw JSON) and the trace's input, from the request body of each
// request type the plugin reads: chat messages, a text completion's prompt, Responses input items, an image
// generation's or edit's prompt. Other types have none.
export function messagesOf(reqType: string, body: Field[]): { messages: string[], latest: string } {
  const out: string[] = []
  let latest = ""
  const base = reqType.endsWith("_stream") ? reqType.slice(0, reqType.byteLength - 7) : reqType
  try {
    if (base === "chat_completion") {
      const ms = elements(find(body, "messages") ?? "[]")
      for (const m of ms) {
        const f = fields(m)
        out.push(`{"role":${quote(rawStr(f, "role") ?? "user")},"content":${find(f, "content") ?? "null"}}`)
      }
      if (ms.length > 0) latest = latestText(find(fields(ms[ms.length - 1]!), "content"))
    } else if (base === "text_completion") {
      const p = find(body, "prompt") ?? "\"\""
      out.push(`{"role":"user","content":${p}}`)
      if (p.startsWith("[")) {
        for (const s of elements(p)) latest += rawStr([{ key: "s", raw: s }], "s") ?? ""
      } else {
        latest = rawStr([{ key: "p", raw: p }], "p") ?? ""
      }
    } else if (base === "responses") {
      const input = find(body, "input")
      if (input !== undefined && input.startsWith("\"")) {
        out.push(`{"role":"user","content":${input}}`)
        latest = rawStr([{ key: "i", raw: input }], "i") ?? "-"
      } else if (input !== undefined && input.startsWith("[")) {
        const items = elements(input)
        for (const it of items) {
          const f = fields(it)
          const c = find(f, "content")
          if (c === undefined) continue
          out.push(`{"role":${quote(rawStr(f, "role") ?? "user")},"content":${c}}`)
        }
        latest = items.length === 0 ? "" : latestText(find(fields(items[items.length - 1]!), "content"))
      }
    } else if (base === "image_generation" || base === "image_edit") {
      const p = find(body, "prompt")
      if (p !== undefined) {
        out.push(`{"role":"user","content":${p}}`)
        latest = rawStr([{ key: "p", raw: p }], "p") ?? ""
      }
    }
  } catch (e) {
    return { messages: out, latest: latest }
  }
  return { messages: out, latest: latest }
}

// The request's parameters (its body without the model, the input and Raiju's routing fields), as the plugin
// sends the request's Params.
export function paramsOf(body: Field[]): string {
  const keep: Field[] = []
  for (const f of body) {
    if (["model", "messages", "prompt", "input", "fallbacks", "stream"].includes(f.key)) continue
    keep.push(f)
  }
  return build(keep)
}

// The model as the plugin names it: without the provider prefix the row may carry (provider/model).
function bareModel(e: LogEntry): string {
  const pre = e.provider + "/"
  return e.provider !== "" && e.model.startsWith(pre) ? e.model.slice(pre.byteLength) : e.model
}

// The tags of a row, in the order the plugin adds them (a later one with the same name replaces an earlier one in
// Maxim, as each is its own update): the x-bf-maxim-* tags, the metadata not set by them, the model, the latency
// split, the request headers (already prefixed header. when the row was made).
export function tagsOf(e: LogEntry): Field[] {
  const out: Field[] = []
  const mt = e.maxim_tags
  const headers: Field[] = []
  if (mt !== undefined) {
    for (const k of mt.keys()) {
      if (k.startsWith("header.")) headers.push({ key: k, raw: mt.get(k) ?? "" })
      else out.push({ key: k, raw: mt.get(k) ?? "" })
    }
  }
  const md = e.metadata
  if (md !== undefined) {
    for (const k of md.keys()) {
      if (mt !== undefined && mt.has(k)) continue
      out.push({ key: k, raw: md.get(k) ?? "" })
    }
  }
  if (e.model !== "") out.push({ key: "model", raw: bareModel(e) })
  const ov = e.overhead_ms
  if (ov !== undefined) {
    const up = Math.max(0, Math.round(e.latency_ms - ov))
    out.push({ key: "upstream_latency_ms", raw: "" + up })
    out.push({ key: "overhead_latency_ms", raw: "" + Math.round(ov) })
  }
  for (const h of headers) out.push(h)
  return out
}

// The generation's error, as the plugin sets it from a Bifrost error: its message, code and type (empty when the
// answer names none).
function errorData(e: LogEntry): string {
  let message = e.error ?? ""
  let code = ""
  let type = ""
  const of = bodyFields(e.output)
  const er = find(of, "error")
  if (er !== undefined && er.startsWith("{")) {
    try {
      const ef = fields(er)
      message = rawStr(ef, "message") ?? message
      code = rawStr(ef, "code") ?? ""
      type = rawStr(ef, "type") ?? ""
    } catch (x) {
      // the row's error text stands
    }
  }
  return `{"result":{"error":{"message":${quote(message)},"code":${quote(code)},"type":${quote(type)}}}}`
}

// The commit log lines of one row (none for a row the plugin does not trace).
export function maximLines(e: LogEntry): string[] {
  if (!traced(e)) return []
  const lines: string[] = []
  const reqType = bifrostRequestType(e.op, e.streamed === true)
  const givenGen = attr(e, "generation-id")
  const givenTrace = attr(e, "trace-id")
  const traceId = givenTrace ?? (e.request_id !== "" ? e.request_id : e.id)
  const genId = givenGen ?? e.id
  const start = isoMs(e.ts)
  const end = isoMs(e.ts + e.latency_ms)
  // the trace exists when the plugin made it here or the caller named it
  const hasTrace = givenGen === undefined || givenTrace !== undefined
  if (givenGen === undefined) {
    const body = bodyFields(e.input)
    const msgs = messagesOf(reqType, body)
    const session = attr(e, "session-id")
    const tdata: Field[] = [{ key: "startTimestamp", raw: quote(start) }, { key: "name", raw: quote(attr(e, "trace-name") ?? "bifrost_" + reqType) }]
    if (session !== undefined) tdata.push({ key: "sessionId", raw: quote(session) })
    tdata.push({ key: "id", raw: quote(traceId) })
    lines.push(commitLine("trace", traceId, "create", build(tdata)))
    lines.push(commitLine("trace", traceId, "update", `{"input":${quote(msgs.latest)}}`))
    const gdata: Field[] = [{ key: "startTimestamp", raw: quote(start) }]
    const gname = attr(e, "generation-name")
    if (gname !== undefined) gdata.push({ key: "name", raw: quote(gname) })
    gdata.push({ key: "provider", raw: quote(e.provider) })
    gdata.push({ key: "model", raw: quote(bareModel(e)) })
    if (msgs.messages.length > 0) gdata.push({ key: "messages", raw: "[" + msgs.messages.join(",") + "]" })
    const params = paramsOf(body)
    if (params !== "{}") gdata.push({ key: "modelParameters", raw: params })
    gdata.push({ key: "id", raw: quote(genId) })
    lines.push(commitLine("trace", traceId, "add-generation", build(gdata)))
  }
  const failed = e.status >= 400 || e.error !== undefined
  if (failed) {
    lines.push(commitLine("generation", genId, "result", errorData(e)))
    lines.push(commitLine("generation", genId, "end", `{"endTimestamp":${quote(end)}}`))
  } else {
    const out = e.output
    if (out !== undefined && out.trimStart().startsWith("{")) {
      lines.push(commitLine("generation", genId, "result", `{"result":${out}}`))
      lines.push(commitLine("generation", genId, "end", `{"endTimestamp":${quote(end)}}`))
    }
  }
  if (hasTrace) lines.push(commitLine("trace", traceId, "end", `{"endTimestamp":${quote(end)}}`))
  for (const t of tagsOf(e)) {
    const data = `{"tags":{${quote(t.key)}:${quote(t.raw)}}}`
    lines.push(commitLine("generation", genId, "update", data))
    if (hasTrace) lines.push(commitLine("trace", traceId, "update", data))
  }
  return lines
}

// The PushLogs POST for a batch. The log repo id is required by the endpoint.
export function maximRequest(base: string, apiKey: string, repoId: string, rows: LogEntry[]): MaximRequest {
  let body = ""
  for (const e of rows) {
    for (const line of maximLines(e)) body += line + "\n"
  }
  const headers: Map<string, string> = new Map()
  headers.set("content-type", "application/json")
  headers.set("accept", "application/json")
  headers.set("x-maxim-api-key", apiKey)
  const root = trimSlash(base === "" ? MAXIM_BASE : base)
  return { url: `${root}/api/sdk/v3/log?id=${repoId}`, method: "POST", headers: headers, body: body }
}

// ---- attachments ----

// One attachment of a generation, as the plugin's ExtractAttachmentsFromRequest makes it from the request: a URL
// (sent as an add-attachment line) or file data (uploaded to the signed URL maxim-go asks for, then announced by an
// add-attachment line).
export type MaximAttachment = { generationId: string, id: string, name: string, mimeType: string, kind: "url" | "fileData", url: string, data: u8[] }

// A JSON string as Go's encoding/json writes it (it escapes <, > and & too).
function goQuote(s: string): string {
  return quote(s).replaceAll("<", "\\u003c").replaceAll(">", "\\u003e").replaceAll("&", "\\u0026")
}

// The attachment's id: a UUID made from the generation and the attachment's place in the request, so a batch that is
// sent again names (and uploads) the same attachments. The plugin draws random ones.
export function attachmentId(generationId: string, index: int): string {
  const h = toHex(sha256(utf8(generationId + "/attachment/" + index)))
  const n = "0123456789abcdef".indexOf(h.slice(16, 17)) % 4
  const v = "89ab".slice(n, n + 1)
  return `${h.slice(0, 8)}-${h.slice(8, 12)}-4${h.slice(13, 16)}-${v}${h.slice(17, 20)}-${h.slice(20, 32)}`
}

// The file extension the plugin names a file after (extFromMime).
function extOf(mime: string): string {
  if (mime === "image/png") return "png"
  if (mime === "image/jpeg" || mime === "image/jpg") return "jpg"
  if (mime === "image/gif") return "gif"
  if (mime === "image/webp") return "webp"
  if (mime === "audio/wav") return "wav"
  if (mime === "audio/mpeg") return "mp3"
  if (mime === "application/pdf") return "pdf"
  return "bin"
}

// The image type of raw bytes, as http.DetectContentType names the image formats; "" for anything else.
export function sniffImage(b: u8[]): string {
  const at = (i: int): int => i < b.length ? int(b[i]!) : -1
  if (at(0) === 0x89 && at(1) === 0x50 && at(2) === 0x4e && at(3) === 0x47) return "image/png"
  if (at(0) === 0xff && at(1) === 0xd8 && at(2) === 0xff) return "image/jpeg"
  if (at(0) === 0x47 && at(1) === 0x49 && at(2) === 0x46 && at(3) === 0x38) return "image/gif"
  if (at(0) === 0x52 && at(1) === 0x49 && at(2) === 0x46 && at(3) === 0x46 && at(8) === 0x57 && at(9) === 0x45 && at(10) === 0x42 && at(11) === 0x50) return "image/webp"
  if (at(0) === 0x42 && at(1) === 0x4d) return "image/bmp"
  if (at(0) === 0 && at(1) === 0 && at(2) === 1 && at(3) === 0) return "image/x-icon"
  return ""
}

// The MIME type maxim-go gives a URL attachment that names none (mimeFromPath on the URL's path).
function mimeFromPath(path: string): string {
  const slash = path.split("/")
  const last = slash[slash.length - 1] ?? ""
  const parts = last.split(".")
  if (parts.length < 2) return "application/octet-stream"
  const ext = parts[parts.length - 1]!.toLowerCase()
  if (ext === "png") return "image/png"
  if (ext === "jpg" || ext === "jpeg") return "image/jpeg"
  if (ext === "gif") return "image/gif"
  if (ext === "webp") return "image/webp"
  if (ext === "pdf") return "application/pdf"
  if (ext === "zip") return "application/zip"
  if (ext === "json") return "application/json"
  if (ext === "html" || ext === "htm") return "text/html"
  if (ext === "txt") return "text/plain"
  return "application/octet-stream"
}

// The last segment of a URL's path, or "" (path.Base: "." and "/" count as none).
function baseName(path: string): string {
  const segs = path.split("/").filter((s) => s !== "")
  if (segs.length === 0) return ""
  return segs[segs.length - 1]!
}

function imageMimeOfFormat(f: string): string {
  const x = f.trim().toLowerCase()
  if (x === "png") return "image/png"
  if (x === "jpeg" || x === "jpg") return "image/jpeg"
  if (x === "webp") return "image/webp"
  if (x === "gif") return "image/gif"
  return ""
}

function b64(s: string): u8[] | undefined {
  try {
    return decode(s)
  } catch (e) {
    return undefined
  }
}

// A data URL as file data (dataURLToAttachment), or undefined when it is not base64.
function dataUrlAttachment(gen: string, idx: int, s: string, kind: string): MaximAttachment | undefined {
  const at = s.indexOf(";base64,")
  if (at < 0) return undefined
  let mime = s.slice(5, at).split(";")[0] ?? ""
  if (mime === "") mime = "application/octet-stream"
  const data = b64(s.slice(at + 8))
  if (data === undefined) return undefined
  return { generationId: gen, id: attachmentId(gen, idx), name: kind + "." + extOf(mime), mimeType: mime, kind: "fileData", url: "", data: data }
}

// An image URL (urlToAttachment): a data URL is file data; an http(s) URL is a URL attachment named after its path,
// typed by its extension, else its rsct query parameter (Azure), else image/png.
function imageUrlAttachment(gen: string, idx: int, s: string): MaximAttachment | undefined {
  if (s.startsWith("data:")) return dataUrlAttachment(gen, idx, s, "image")
  let name = "attachment"
  let mime = ""
  const u = URL.parse(s)
  if (u !== undefined) {
    const b = baseName(u.pathname)
    if (b !== "") name = b
    const dot = b.split(".")
    if (dot.length > 1) mime = imageMimeOfFormat(dot[dot.length - 1]!)
    if (mime === "") mime = u.searchParams.get("rsct") ?? ""
  }
  if (mime === "") mime = "image/png"
  return { generationId: gen, id: attachmentId(gen, idx), name: name, mimeType: mime, kind: "url", url: s, data: [] }
}

// A file part (chatFileToAttachment, responsesFileToAttachment): its file_url as a URL attachment, else its
// file_data as file data.
function fileAttachment(gen: string, idx: int, f: Field[]): MaximAttachment | undefined {
  const name0 = rawStr(f, "filename") ?? ""
  const name = name0 === "" ? "attachment" : name0
  const type = rawStr(f, "file_type") ?? ""
  const url = rawStr(f, "file_url") ?? ""
  if (url !== "") return { generationId: gen, id: attachmentId(gen, idx), name: name, mimeType: type, kind: "url", url: url, data: [] }
  const fd = rawStr(f, "file_data") ?? ""
  if (fd === "") return undefined
  const data = b64(fd)
  if (data === undefined) return undefined
  return { generationId: gen, id: attachmentId(gen, idx), name: name, mimeType: type === "" ? "application/octet-stream" : type, kind: "fileData", url: "", data: data }
}

// Audio data (audioDataToAttachment): base64 or a data URL; the format names the type (wav, mp3, else audio/<format>).
function audioAttachment(gen: string, idx: int, data: string, format: string | undefined): MaximAttachment | undefined {
  let enc = data
  if (data.startsWith("data:")) {
    const at = data.indexOf(";base64,")
    if (at < 0) return undefined
    enc = data.slice(at + 8)
  }
  const bytes = b64(enc)
  if (bytes === undefined) return undefined
  let mime = "audio/mpeg"
  if (format !== undefined) {
    const f = format.toLowerCase()
    mime = f === "wav" ? "audio/wav" : f === "mp3" ? "audio/mpeg" : "audio/" + format
  }
  return { generationId: gen, id: attachmentId(gen, idx), name: "audio." + extOf(mime), mimeType: mime, kind: "fileData", url: "", data: bytes }
}

// An input image of an image generation (inputImageStringToAttachment): a URL or data URL, else raw base64 typed by
// its bytes (image/png when they are not an image).
function inputImageAttachment(gen: string, idx: int, s: string): MaximAttachment | undefined {
  if (s === "") return undefined
  if (s.startsWith("data:") || s.startsWith("http://") || s.startsWith("https://")) return imageUrlAttachment(gen, idx, s)
  const bytes = b64(s)
  if (bytes === undefined) return imageUrlAttachment(gen, idx, s)
  let mime = sniffImage(bytes)
  if (mime === "") mime = "image/png"
  return { generationId: gen, id: attachmentId(gen, idx), name: "input_image." + extOf(mime), mimeType: mime, kind: "fileData", url: "", data: bytes }
}

// The attachments of a row, from its request body, in the order of the request: chat image_url, file and input_audio
// parts; Responses input_image, input_file and input_audio parts; an image generation's input_images. A row that
// names its generation (x-bf-maxim-generation-id) has none, as the plugin returns before it reads them.
export function attachmentsOf(e: LogEntry): MaximAttachment[] {
  const out: MaximAttachment[] = []
  if (!traced(e) || attr(e, "generation-id") !== undefined) return out
  const body = bodyFields(e.input)
  if (body.length === 0) return out
  const gen = e.id
  const reqType = bifrostRequestType(e.op, e.streamed === true)
  const base = reqType.endsWith("_stream") ? reqType.slice(0, reqType.byteLength - 7) : reqType
  const push = (a: MaximAttachment | undefined): void => {
    if (a !== undefined) out.push(a)
  }
  try {
    if (base === "chat_completion" || base === "responses") {
      const items = elements(find(body, base === "responses" ? "input" : "messages") ?? "[]")
      for (const m of items) {
        if (!m.startsWith("{")) continue
        const content = find(fields(m), "content")
        if (content === undefined || !content.startsWith("[")) continue
        for (const part of elements(content)) {
          if (!part.startsWith("{")) continue
          const pf = fields(part)
          const t = rawStr(pf, "type") ?? ""
          const idx = out.length
          if (base === "chat_completion" && t === "image_url") {
            const iu = find(pf, "image_url")
            const url = iu === undefined ? "" : iu.startsWith("{") ? rawStr(fields(iu), "url") ?? "" : rawStr(pf, "image_url") ?? ""
            if (url !== "") push(imageUrlAttachment(gen, idx, url))
          } else if (base === "responses" && t === "input_image") {
            const url = rawStr(pf, "image_url") ?? ""
            if (url !== "") push(imageUrlAttachment(gen, idx, url))
          } else if (base === "chat_completion" && t === "file") {
            const f = find(pf, "file")
            if (f !== undefined && f.startsWith("{")) push(fileAttachment(gen, idx, fields(f)))
          } else if (base === "responses" && t === "input_file") {
            push(fileAttachment(gen, idx, pf))
          } else if (t === "input_audio") {
            const a = find(pf, "input_audio")
            if (a !== undefined && a.startsWith("{")) {
              const af = fields(a)
              const data = rawStr(af, "data") ?? ""
              let format = rawStr(af, "format")
              // a Responses part's format defaults to mp3
              if (base === "responses" && (format === undefined || format === "")) format = "mp3"
              if (data !== "") push(audioAttachment(gen, idx, data, format))
            }
          }
        }
      }
    } else if (base === "image_generation") {
      const imgs = find(body, "input_images")
      if (imgs !== undefined && imgs.startsWith("[")) {
        for (const raw of elements(imgs)) {
          const s = rawStr([{ key: "s", raw: raw }], "s") ?? ""
          push(inputImageAttachment(gen, out.length, s))
        }
      }
    }
  } catch (x) {
    return out
  }
  return out
}

// The storage key maxim-go uploads an attachment under: {repoId}/{entity}/{entityId}/files/original/{fileId}.
export function attachmentKey(repoId: string, a: MaximAttachment): string {
  return `${repoId}/generation/${a.generationId}/files/original/${a.id}`
}

// The add-attachment commit line of an attachment (maxim-go's populated fields without the data, keys sorted as Go
// writes a map): a URL attachment's metadata carries its url, and a URL that names no type is typed by its path.
export function attachmentLine(repoId: string, a: MaximAttachment): string {
  const fs: string[] = [`"id":${goQuote(a.id)}`, `"key":${goQuote(attachmentKey(repoId, a))}`]
  if (a.kind === "url") {
    let mime = a.mimeType
    if (mime === "") {
      const u = URL.parse(a.url)
      if (u !== undefined) mime = mimeFromPath(u.pathname)
    }
    fs.push(`"metadata":{"url":${goQuote(a.url)}}`)
    if (mime !== "") fs.push(`"mimeType":${goQuote(mime)}`)
    fs.push(`"name":${goQuote(a.name)}`)
    fs.push(`"type":"url"`)
    fs.push(`"url":${goQuote(a.url)}`)
  } else {
    fs.push(`"mimeType":${goQuote(a.mimeType === "" ? "application/octet-stream" : a.mimeType)}`)
    if (a.name !== "") fs.push(`"name":${goQuote(a.name)}`)
    if (a.data.length > 0) fs.push(`"size":${a.data.length}`)
    fs.push(`"type":"fileData"`)
  }
  return commitLine("generation", a.generationId, "add-attachment", "{" + fs.join(",") + "}")
}

// Query encoding as Go's url.Values.Encode writes it (a space is +).
function qs(s: string): string {
  return pctEncode(s).replaceAll("%20", "+")
}

// The GetUploadUrl call: GET {base}/api/sdk/v1/log-repositories/attachments/upload-url?key=&mimeType=&size= with the
// API key.
export function uploadUrlRequest(base: string, apiKey: string, key: string, mimeType: string, size: int): { url: string, headers: Map<string, string> } {
  const root = trimSlash(base === "" ? MAXIM_BASE : base)
  const hs: Map<string, string> = new Map()
  hs.set("content-type", "application/json")
  hs.set("accept", "application/json")
  hs.set("x-maxim-api-key", apiKey)
  return { url: `${root}/api/sdk/v1/log-repositories/attachments/upload-url?key=${qs(key)}&mimeType=${qs(mimeType)}&size=${size}`, headers: hs }
}

// The signed URL of a GetUploadUrl answer ({data: {url}}); an {error: {message}} or no URL throws.
export function parseUploadUrl(text: string): string throws SyntaxError {
  const fs = try fields(text)
  const er = find(fs, "error")
  if (er !== undefined && er.startsWith("{")) throw new SyntaxError(`API error: ${rawStr(try fields(er), "message") ?? ""}`)
  const d = find(fs, "data")
  const url = d !== undefined && d.startsWith("{") ? rawStr(try fields(d), "url") ?? rawStr(try fields(d), "URL") ?? "" : ""
  if (url === "") throw new SyntaxError("no upload URL in response")
  return url
}

// ---- tests ----

function sample(id: string): LogEntry {
  return {
    id: id,
    ts: 1791979200000.0,
    request_id: "req-" + id,
    op: "chat",
    provider: "openai",
    model: "gpt-4o",
    status: 200,
    latency_ms: 42.0,
    prompt_tokens: 5,
    completion_tokens: 6,
    cost: 0.5,
    cache_hit: false,
  }
}

// A line's entity, id, action and data.
function parsed(line: string): { entity: string, id: string, action: string, data: string } {
  const b = line.indexOf("{")
  const rest = line.slice(b + 1, line.byteLength - 1)
  const idEnd = rest.indexOf(",action=")
  const actEnd = rest.indexOf(",data=")
  return { entity: line.slice(0, b), id: rest.slice(3, idEnd), action: rest.slice(idEnd + 8, actEnd), data: rest.slice(actEnd + 6) }
}

test("maxim: PushLogs URL with the repo id, and the API key header", () => {
  const r = maximRequest("https://maxim.example/", "mk", "repo1", [sample("a")])
  expect(r.url).toBe("https://maxim.example/api/sdk/v3/log?id=repo1")
  expect(r.method).toBe("POST")
  expect(r.headers.get("x-maxim-api-key")).toBe("mk")
  expect(r.headers.get("content-type")).toBe("application/json")
})

test("maxim: default base when none is set", () => {
  expect(maximRequest("", "k", "r", []).url).toBe("https://app.getmaxim.ai/api/sdk/v3/log?id=r")
})

test("maxim: a chat row is the plugin's trace, in maxim-go's commit log lines", () => {
  let e = sample("a")
  e.input = `{"model":"openai/gpt-4o","messages":[{"role":"system","content":"be brief"},{"role":"user","content":[{"type":"text","text":"hi there"}]}],"temperature":0.2,"fallbacks":["x/y"]}`
  e.output = `{"id":"c1","object":"chat.completion","choices":[{"index":0,"message":{"role":"assistant","content":"hello"}}],"usage":{"prompt_tokens":5,"completion_tokens":6,"total_tokens":11}}`
  e.overhead_ms = 2.0
  const lines = maximLines(e)
  const p = lines.map((l) => parsed(l))
  expect(lines[0]).toBe(`trace{id=req-a,action=create,data={"startTimestamp":"2026-10-14T12:00:00.000Z","name":"bifrost_chat_completion","id":"req-a"}}`)
  expect(lines[1]).toBe(`trace{id=req-a,action=update,data={"input":"hi there"}}`)
  expect(p[2]!.action).toBe("add-generation")
  const g = try fields(p[2]!.data)
  expect(rawStr(g, "id")).toBe("a")
  expect(rawStr(g, "provider")).toBe("openai")
  expect(rawStr(g, "model")).toBe("gpt-4o")
  let pref = sample("p")
  pref.model = "openai/gpt-4o"
  expect(maximLines(pref).includes(`generation{id=p,action=update,data={"tags":{"model":"gpt-4o"}}}`)).toBe(true)
  expect(find(g, "messages")).toBe(`[{"role":"system","content":"be brief"},{"role":"user","content":[{"type":"text","text":"hi there"}]}]`)
  expect(find(g, "modelParameters")).toBe(`{"temperature":0.2}`)
  expect(lines[3]!.startsWith(`generation{id=a,action=result,data={"result":{"id":"c1"`)).toBe(true)
  expect(lines[4]).toBe(`generation{id=a,action=end,data={"endTimestamp":"2026-10-14T12:00:00.042Z"}}`)
  expect(lines[5]).toBe(`trace{id=req-a,action=end,data={"endTimestamp":"2026-10-14T12:00:00.042Z"}}`)
  expect(lines[6]).toBe(`generation{id=a,action=update,data={"tags":{"model":"gpt-4o"}}}`)
  expect(lines[7]).toBe(`trace{id=req-a,action=update,data={"tags":{"model":"gpt-4o"}}}`)
  expect(lines.includes(`generation{id=a,action=update,data={"tags":{"upstream_latency_ms":"40"}}}`)).toBe(true)
  expect(lines.includes(`trace{id=req-a,action=update,data={"tags":{"overhead_latency_ms":"2"}}}`)).toBe(true)
})

test("maxim: without the bodies the trace has no messages or result, and an error is the generation's result", () => {
  const plain = maximLines(sample("b"))
  expect(plain[1]).toBe(`trace{id=req-b,action=update,data={"input":""}}`)
  expect(plain.some((l) => l.includes("action=result"))).toBe(false)
  expect(plain.some((l) => l.includes("\"messages\""))).toBe(false)
  let e = sample("c")
  e.status = 429
  e.error = "slow down"
  e.output = `{"error":{"message":"rate limited","type":"rate_limit","code":"429"}}`
  const lines = maximLines(e)
  expect(lines.includes(`generation{id=c,action=result,data={"result":{"error":{"message":"rate limited","code":"429","type":"rate_limit"}}}}`)).toBe(true)
  expect(lines.some((l) => l.startsWith("generation{id=c,action=end,"))).toBe(true)
})

test("maxim: x-bf-maxim attributes name the trace, the session and the generation, and tag both", () => {
  let e = sample("d")
  const ids: Record<string, string> = new Map()
  ids.set("trace-id", "tr-9")
  ids.set("trace-name", "support")
  ids.set("generation-name", "answer")
  ids.set("session-id", "sess-1")
  ids.set("log-repo-id", "repo-2")
  const tags: Record<string, string> = new Map()
  tags.set("customer", "acme")
  tags.set("header.x-team", "search")
  e.maxim = ids
  e.maxim_tags = tags
  const md: Record<string, string> = new Map()
  md.set("env", "prod")
  md.set("customer", "ignored")
  e.metadata = md
  const lines = maximLines(e)
  expect(lines[0]).toBe(`trace{id=tr-9,action=create,data={"startTimestamp":"2026-10-14T12:00:00.000Z","name":"support","sessionId":"sess-1","id":"tr-9"}}`)
  expect(rawStr(try fields(parsed(lines[2]!).data), "name")).toBe("answer")
  const tagLines = lines.filter((l) => l.startsWith("generation{id=d,action=update"))
  expect(tagLines.map((l) => parsed(l).data).join("|")).toBe(`{"tags":{"customer":"acme"}}|{"tags":{"env":"prod"}}|{"tags":{"model":"gpt-4o"}}|{"tags":{"header.x-team":"search"}}`)
  expect(repoOf(e, "repo-1")).toBe("repo-2")
  expect(repoOf(sample("e"), "repo-1")).toBe("repo-1")
})

test("maxim: a generation named by the caller gets only its result; realtime, MCP and A2A rows are not traced", () => {
  let e = sample("f")
  e.output = `{"id":"c2","choices":[]}`
  const ids: Record<string, string> = new Map()
  ids.set("generation-id", "gen-x")
  e.maxim = ids
  const lines = maximLines(e)
  expect(lines[0]!.startsWith(`generation{id=gen-x,action=result,`)).toBe(true)
  expect(lines.some((l) => l.startsWith("trace{"))).toBe(false)
  ids.set("trace-id", "tr-x")
  e.maxim = ids
  expect(maximLines(e).includes(`trace{id=tr-x,action=end,data={"endTimestamp":"2026-10-14T12:00:00.042Z"}}`)).toBe(true)
  let rt = sample("g")
  rt.op = "realtime"
  expect(maximLines(rt).length).toBe(0)
  let mcp = sample("h")
  mcp.kind = "mcp"
  expect(maximLines(mcp).length).toBe(0)
})

test("maxim: the messages of text completions, Responses and image prompts", () => {
  const t = messagesOf("text_completion", try fields(`{"prompt":["a","b"]}`))
  expect(t.messages.join(",")).toBe(`{"role":"user","content":["a","b"]}`)
  expect(t.latest).toBe("ab")
  const r = messagesOf("responses_stream", try fields(`{"input":[{"role":"user","content":"q1"},{"type":"function_call_output","output":"x"},{"role":"assistant","content":[{"type":"output_text","text":"a1"}]}]}`))
  expect(r.messages.length).toBe(2)
  expect(r.latest).toBe("a1")
  expect(messagesOf("responses", try fields(`{"input":"just this"}`)).latest).toBe("just this")
  expect(messagesOf("image_generation", try fields(`{"prompt":"a cat"}`)).messages.join(",")).toBe(`{"role":"user","content":"a cat"}`)
  expect(messagesOf("embedding", try fields(`{"input":"x"}`)).messages.length).toBe(0)
})

test("maxim: chat image, file and audio parts are the generation's attachments, as the plugin extracts them", () => {
  let e = sample("att")
  // "iVBORw0KGgo=" is a PNG signature; "AAEC" is three bytes
  e.input = `{"model":"gpt-4o","messages":[{"role":"user","content":[{"type":"text","text":"look"},{"type":"image_url","image_url":{"url":"https://cdn.example/pics/cat.jpg?x=1&y=2"}},{"type":"image_url","image_url":{"url":"data:image/png;base64,iVBORw0KGgo="}},{"type":"file","file":{"file_data":"AAEC","filename":"r.pdf","file_type":"application/pdf"}},{"type":"file","file":{"file_url":"https://files.example/doc"}},{"type":"input_audio","input_audio":{"data":"AAEC","format":"wav"}}]}]}`
  const as = attachmentsOf(e)
  expect(as.length).toBe(5)
  expect(as[0]!.kind).toBe("url")
  expect(as[0]!.name).toBe("cat.jpg")
  expect(as[0]!.mimeType).toBe("image/jpeg")
  expect(as[1]!.kind).toBe("fileData")
  expect(as[1]!.name).toBe("image.png")
  expect(as[1]!.data.length).toBe(8)
  expect(as[2]!.name).toBe("r.pdf")
  expect(as[2]!.mimeType).toBe("application/pdf")
  expect(as[3]!.name).toBe("attachment")
  expect(as[3]!.mimeType).toBe("")
  expect(as[4]!.name).toBe("audio.wav")
  expect(as[4]!.mimeType).toBe("audio/wav")
  // the ids are UUIDs that stay the same for the same row
  expect(as[0]!.id).toBe(attachmentsOf(e)[0]!.id)
  expect(as[0]!.id.byteLength).toBe(36)
  expect(as[0]!.id.slice(14, 15)).toBe("4")
  expect(as[0]!.id === as[1]!.id).toBe(false)
  // the add-attachment lines: Go's sorted keys and HTML escapes, the url in metadata, a typeless URL typed by its path
  expect(attachmentLine("repo1", as[0]!)).toBe(`generation{id=att,action=add-attachment,data={"id":"${as[0]!.id}","key":"repo1/generation/att/files/original/${as[0]!.id}","metadata":{"url":"https://cdn.example/pics/cat.jpg?x=1\\u0026y=2"},"mimeType":"image/jpeg","name":"cat.jpg","type":"url","url":"https://cdn.example/pics/cat.jpg?x=1\\u0026y=2"}}`)
  expect(attachmentLine("repo1", as[3]!).includes(`"mimeType":"application/octet-stream","name":"attachment","type":"url"`)).toBe(true)
  expect(attachmentLine("repo1", as[2]!)).toBe(`generation{id=att,action=add-attachment,data={"id":"${as[2]!.id}","key":"repo1/generation/att/files/original/${as[2]!.id}","mimeType":"application/pdf","name":"r.pdf","size":3,"type":"fileData"}}`)
  // a row that names its generation, and a row without its body, have none
  let named = e
  const ids: Record<string, string> = new Map()
  ids.set("generation-id", "g-1")
  named.maxim = ids
  expect(attachmentsOf(named).length).toBe(0)
  expect(attachmentsOf(sample("plain")).length).toBe(0)
})

test("maxim: Responses parts and image-generation input images; the upload URL call", () => {
  let r = sample("rs")
  r.op = "responses"
  r.input = `{"model":"gpt-4o","input":[{"role":"user","content":[{"type":"input_image","image_url":"https://x.example/a?rsct=image/webp"},{"type":"input_file","file_url":"https://x.example/f.pdf","filename":"f.pdf"},{"type":"input_audio","input_audio":{"data":"AAEC"}}]}]}`
  const ra = attachmentsOf(r)
  expect(ra.length).toBe(3)
  expect(ra[0]!.mimeType).toBe("image/webp")
  expect(ra[0]!.name).toBe("a")
  expect(ra[1]!.name).toBe("f.pdf")
  expect(ra[2]!.mimeType).toBe("audio/mpeg")
  let g = sample("ig")
  g.op = "image_generation"
  g.input = `{"model":"gpt-image-1","prompt":"x","input_images":["iVBORw0KGgo=","https://x.example/in.png","AAEC"]}`
  const ga = attachmentsOf(g)
  expect(ga.length).toBe(3)
  expect(ga[0]!.name).toBe("input_image.png")
  expect(ga[1]!.kind).toBe("url")
  // bytes that are not an image are named and typed as a PNG, as the plugin does
  expect(ga[2]!.mimeType).toBe("image/png")
  const u = uploadUrlRequest("https://maxim.example/", "mk", "repo1/generation/ig/files/original/abc", "image/png", 8)
  expect(u.url).toBe("https://maxim.example/api/sdk/v1/log-repositories/attachments/upload-url?key=repo1%2Fgeneration%2Fig%2Ffiles%2Foriginal%2Fabc&mimeType=image%2Fpng&size=8")
  expect(u.headers.get("x-maxim-api-key")).toBe("mk")
  expect(try parseUploadUrl(`{"data":{"url":"https://bucket.example/put?sig=1"}}`)).toBe("https://bucket.example/put?sig=1")
  let msg = ""
  try {
    parseUploadUrl(`{"error":{"message":"no repo"}}`)
  } catch (x) {
    msg = x.message
  }
  expect(msg).toBe("API error: no repo")
  expect(sniffImage([0xff, 0xd8, 0xff, 0xe0])).toBe("image/jpeg")
})
