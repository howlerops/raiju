test("providers: POST creates by the body's name (409 when taken), keys list and get", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  const made = handleApi(s, "POST", "/api/providers", `{"provider":"groq","keys":[{"id":"k1","value":"gsk-example0123456789"}]}`)
  expect(made.status).toBe(200)
  expect(made.body.includes("example0123456789")).toBe(false)
  expect(handleApi(s, "POST", "/api/providers", `{"provider":"groq"}`).status).toBe(409)
  expect(handleApi(s, "POST", "/api/providers", `{"keys":[]}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/providers", `{"provider":"Bad Name"}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/providers", `[1]`).status).toBe(400)
  const list = handleApi(s, "GET", "/api/providers/groq/keys", "")
  expect(list.status).toBe(200)
  expect(list.body.includes(`"total":1`)).toBe(true)
  expect(list.body.includes("example0123456789")).toBe(false)
  expect(handleApi(s, "GET", "/api/providers/groq/keys/k1", "").status).toBe(200)
  expect(handleApi(s, "GET", "/api/providers/groq/keys/nope", "").status).toBe(404)
  expect(handleApi(s, "GET", "/api/providers/nope/keys", "").status).toBe(404)
  expect(handleApi(s, "DELETE", "/api/providers", "").status).toBe(405)
  cleanup(path)
})

