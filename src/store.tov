  expect(handleApi(s, "POST", "/api/config/metadata", `{}`).status).toBe(400)
  expect(handleApi(s, "GET", "/api/config/metadata", "").status).toBe(405)
  cleanup(path)
})

test("virtual key rotation: new value, grace for the old one, bulk and 404s", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "dev", value: "sk-bf-" + "1".repeat(32) }))).toBe(200)
  const old = findById(gov(s.cfg).virtual_keys, "vk1")!.value
  expect(statusOf(s.rotateVirtualKey("vk1", 0))).toBe(200)
  const cur = findById(gov(s.cfg).virtual_keys, "vk1")!
  expect(cur.value === old).toBe(false)
  expect(cur.previous_value === undefined).toBe(true)
  expect(cur.rotated_at !== undefined).toBe(true)
  expect(statusOf(s.rotateVirtualKey("vk1", 3600000))).toBe(200)
  const again = findById(gov(s.cfg).virtual_keys, "vk1")!
  expect(again.previous_value === cur.value).toBe(true)
  expect(rfc3339Ms(again.previous_value_expires_at ?? "") !== undefined).toBe(true)
  expect(statusOf(s.rotateVirtualKey("nope", 0))).toBe(404)
  // a plain write with a new value drops the grace period; the same value keeps it
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "dev", value: "" }))).toBe(200)
  expect(findById(gov(s.cfg).virtual_keys, "vk1")!.previous_value === again.previous_value).toBe(true)
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "dev", value: "sk-bf-" + "2".repeat(32) }))).toBe(200)
  expect(findById(gov(s.cfg).virtual_keys, "vk1")!.previous_value === undefined).toBe(true)
  // expires_at is an RFC 3339 time, kept on writes
  expect(statusOf(s.upsertVirtualKey({ id: "vk2", name: "x", value: "sk-bf-" + "3".repeat(32), expires_at: "tomorrow" }))).toBe(400)
  expect(statusOf(s.upsertVirtualKey({ id: "vk2", name: "x", value: "sk-bf-" + "3".repeat(32), expires_at: "2030-01-01T00:00:00Z" }))).toBe(200)
  expect(findById(gov(s.cfg).virtual_keys, "vk2")!.expires_at).toBe("2030-01-01T00:00:00Z")
  // the HTTP route: bulk ids and the single form, with the new value in the reply
  const bulk = handleApi(s, "POST", "/api/governance/virtual-keys/rotate", `{"ids":["vk1","vk2"]}`)
  expect(bulk.status).toBe(200)
  expect(bulk.body.includes("Virtual keys rotated successfully")).toBe(true)
  expect(handleApi(s, "POST", "/api/governance/virtual-keys/rotate", `{"ids":[]}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/governance/virtual-keys/rotate", `{"ids":[""]}`).status).toBe(400)
  const one = handleApi(s, "POST", "/api/governance/virtual-keys/vk2/rotate", "")
  expect(one.status).toBe(200)
  expect(one.body.includes("Virtual key rotated successfully")).toBe(true)
  expect(handleApi(s, "POST", "/api/governance/virtual-keys/nope/rotate", "").status).toBe(404)
  expect(handleApi(s, "GET", "/api/governance/virtual-keys/vk1/rotate", "").status).toBe(405)
  cleanup(path)
})

