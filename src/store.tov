  expect(handleApi(s, "PUT", pg + "/openai", "not json").status).toBe(400)
  expect(handleApi(s, "POST", pg, "{}").status).toBe(405)
  const put = handleApi(s, "PUT", pg + "/openai", "{\"budgets\":[{\"max_limit\":3,\"reset_duration\":\"1d\"}],\"rate_limit\":{\"request_max_limit\":2,\"request_reset_duration\":\"1m\"}}")
  expect(put.status).toBe(201)
  expect(handleApi(s, "PUT", pg + "/openai", "{\"budget\":{\"max_limit\":1,\"reset_duration\":\"1d\"},\"budgets\":[]}").status).toBe(400)
  const list = handleApi(s, "GET", pg, "")
