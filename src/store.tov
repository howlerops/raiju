  expect(handleApi(s, "POST", "/api/config/metadata", `{"tip":null}`).status).toBe(200)
  const red = handleApi(s, "GET", "/api/config", "").body
  expect(s.cfg.metadata!.get("onboarding_dismissed")).toBe(true)
  expect(red.includes(`"onboarding_dismissed"`)).toBe(true)
  expect(red.includes(`"tip"`)).toBe(false)
  expect(red.includes(`"n"`)).toBe(true)
