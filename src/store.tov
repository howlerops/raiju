// Config store and management API (Bifrost's /api/*). Providers, keys, virtual
// keys, budgets and rate limits change at runtime; each change is saved to the
// config file and handed to the lead through onChange, which rebuilds the
// engine. Secrets are masked on every read, and a masked value sent back
// unchanged keeps the stored secret.
import { readFileSync, writeFileSync, existsSync, unlinkSync, statSync, chmodSync } from "node:fs"
import { writeFileAtomic, removeStaleTemps, writeTemp, PRIVATE_FILE } from "./atomicfile"
import {
  Config, GovernanceConfig, KeyConfig, ProviderConfig, VirtualKeyConfig, BudgetConfig, resolveEnv, getEnv,
  RateLimitConfig, TeamConfig, CustomerConfig, ProviderConfigRef, providerOf, AdminAuthConfig, AdminUserConfig, AccessProfile, NetworkConfig, CustomProviderConfig,
  ModelConfigGovernance, ProviderGovernance, PricingOverrideConfig, AlertsConfig, ClientConfig, providerNames, GlobalProxyConfig, CircuitPolicyConfig,
  WebhookEndpoint, AgentConfig, AgentGrant, AgentAuth, AgentOAuth, AgentTls, ProjectConfig, BusinessUnitConfig, RoleConfig, PermissionPair, UserAgentMapping, PluginSpec,
  BudgetOverride, PricingSyncConfig, ComplexitySettings, BedrockKeyConfig, ProjectMember, MemberShare, RateLimitShare, EntityDac, ProfileRole, ApiKeyConfig, UserBudgetOverride, VertexAwsWorkloadIdentity,
  loadRawConfig, rawConfigOf,
} from "./config"
import { clusterState } from "./clusterstate"
import { nodeOf } from "./cluster"
import { RoutingRule, RuleTarget } from "./cel"
import { aliasProviderProblem } from "./aliases"
import { oauthKeyProblem } from "./oauth_key"
import { permissionDocs, pairOfId, permissionIds, parseOverride, keyBudgetIds, expiredToDelete, ruleError, complexityProblem, complexityFrom, emailOf, attachBinding, heldProfiles } from "./govapi"
import { PromptRepoConfig } from "./prompts"
import { FeatureFlagsConfig } from "./flags"
import { notify } from "./notify"
import { analyzerStatus, retryWarmup, generationsJson, deleteGeneration } from "./complexity"
import { isBuiltinRole, customRole, customRoles, systemRole, withRoleIds, roleIdOf, roleNameById, anyRoleName, builtinRoleName, builtinRoles } from "./rbac"
import { DataScope, allScope, inScope, scopeOf } from "./scope"
import { setGlobalProxy } from "./providers/types"
import { McpClientConfig, McpUserCredential } from "./mcp"
import { McpUserToken } from "./mcpuser"
import { decode, encode } from "./base64"
import { gcmSeal, gcmOpen, pbkdf2Sha256 } from "./aesgcm"
import { Field, fields, find, isNull, quote, elements, decodeString, rawStr, rawBool, rawNum, build, setField, without } from "./json"
import { secureHex, utf8, sha256, toHex } from "./crypto"
import { Policy, Verdict, hostVerdict, urlVerdict } from "./netguard"
