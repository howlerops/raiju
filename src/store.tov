  expect(handleApi(s, "DELETE", pg + "/openai", "").status).toBe(200)
  expect(handleApi(s, "DELETE", pg + "/openai", "").status).toBe(404)
  expect(handleApi(s, "GET", pg, "").body.includes("openai")).toBe(false)
  cleanup(path)
})

test("pricing overrides: CRUD in Bifrost's shape, patch kept as sent", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  const po = "/api/governance/pricing-overrides"
  const bad = "{\"scope_kind\":\"global\",\"match_type\":\"exact\",\"pattern\":\"gpt-4o\",\"patch\":{\"input_cost_per_token\":0.000001}}"
  expect(handleApi(s, "POST", po, "{\"scope_kind\":\"galaxy\",\"match_type\":\"exact\",\"pattern\":\"x\",\"patch\":{}}").status).toBe(400)
  expect(handleApi(s, "POST", po, "{\"scope_kind\":\"provider\",\"match_type\":\"exact\",\"pattern\":\"x\",\"patch\":{}}").status).toBe(400)
  expect(handleApi(s, "POST", po, "{\"scope_kind\":\"global\",\"match_type\":\"wildcard\",\"pattern\":\"gpt\",\"patch\":{}}").status).toBe(400)
  expect(handleApi(s, "POST", po, "{\"scope_kind\":\"global\",\"match_type\":\"exact\",\"pattern\":\"x\",\"patch\":\"nope\"}").status).toBe(400)
  const created = handleApi(s, "POST", po, bad)
  expect(created.status).toBe(201)
  expect(created.body.includes("\"patch\":{\"input_cost_per_token\":0.000001}")).toBe(true)
  const idOf = try JSON.parse(created.body) as { id: string }
  const id = idOf.id
  expect(s.cfg.governance!.pricing_overrides!.length).toBe(1)
  const put = handleApi(s, "PUT", po + "/" + id, "{\"provider_id\":null,\"pattern\":\"gpt-4*\",\"match_type\":\"wildcard\"}")
  expect(put.status).toBe(200)
  expect(put.body.includes("gpt-4*")).toBe(true)
  expect(put.body.includes("\"patch\":{\"input_cost_per_token\":0.000001}")).toBe(true)
  expect(handleApi(s, "PUT", po + "/nope", "{}").status).toBe(404)
  expect(handleApi(s, "GET", po, "").body.includes(id)).toBe(true)
  expect(handleApi(s, "DELETE", po + "/" + id, "").status).toBe(200)
  expect(handleApi(s, "DELETE", po + "/" + id, "").status).toBe(404)
  cleanup(path)
})

