export type AdminAuth = AdminAuthConfig

export type Failure = { kind: "error", status: int, message: string }
export type Result = { kind: "ok", id: string } | Failure

export type ApiReply = { status: int, body: string }

type HasId = { id: string }

// Request bodies: the server fills the id, and a missing required field is
// caught by the store's validation instead of by JSON.parse's type check.
type VkBody = { id?: string, name?: string, value?: string, description?: string, is_active?: bool, team_id?: string, customer_id?: string, user_id?: string, budget_id?: string, rate_limit_id?: string, provider_configs?: ProviderConfigRef[], key_ids?: string[], expires_at?: string, disable_content_logging?: bool, mcp_configs?: { mcp_client_name: string, tools_to_execute?: string[] }[], agent_grants?: AgentGrant[] }
type BudgetBody = { id?: string, max_limit?: f64, reset_duration?: string, current_usage?: f64 }
type RateBody = { id?: string, token_max_limit?: int, token_reset_duration?: string, request_max_limit?: int, request_reset_duration?: string }
type NamedBody = { id?: string, name?: string, customer_id?: string, budget_id?: string, business_unit_id?: string }
// Bifrost's model config, provider governance and pricing override requests. Budgets and rate
// limits come inline; the store keeps them under ids the owner derives.
type ModelConfigBody = { id?: string, model_name?: string, provider?: string, scope?: string, scope_id?: string, calendar_aligned?: bool, budgets?: BudgetBody[], rate_limit?: RateBody }
type ProviderBody = { description?: string, budget?: BudgetBody, budgets?: BudgetBody[], rate_limit?: RateBody }
type PricingBody = { name?: string, scope_kind?: string, provider_id?: string, provider_key_id?: string, virtual_key_id?: string, user_id?: string, request_types?: string[], match_type?: string, pattern?: string }
// Bifrost's projects, business units and custom roles. Projects and business units are written whole
// (a PUT replaces the record); a role is keyed by its name.
type ProjectBody = { id?: string, name?: string, description?: string, is_active?: bool, access_rule?: string, accounting_mode?: string, membership_mode?: string, virtual_key_ids?: string[], budget_id?: string, rate_limit_id?: string, provider_configs?: ProviderConfigRef[], split_policy?: string, agent_grants?: AgentGrant[] }
type MemberBody = { members?: { user_id?: string }[] }
type MemberCapsBody = { budget_shares?: MemberShare[], rate_limit_shares?: RateLimitShare[] }
type BusinessUnitBody = { id?: string, name?: string, budget_id?: string, rate_limit_id?: string, team_ids?: string[], customer_ids?: string[] }
type RoleBody = { name?: string, description?: string, dac?: string, permissions?: PermissionPair[] }
// entity_dac arrives as an object and is read by entityDacFrom


// The resources a custom role may name, the operations on them, and the data access scopes.
export const RESOURCES = ["Logs", "MCPLogs", "AuditLogs", "ModelProvider", "Observability", "VirtualKeys", "Users", "MCPGateway", "Teams", "Customers", "BusinessUnits", "Projects", "RBAC", "AccessProfiles", "RoutingRules", "Governance", "Settings", "Cluster", "APIKeys", "Crews"]
export const OPERATIONS = ["View", "Create", "Update", "Delete", "Download", "Reveal", "RunInference"]
const DACS = ["own-data", "team-data", "business-unit-data", "customer-data", "all-data"]
// The governance collections a scoped user (see scope.tov) may read and change, record by record.
const SCOPED_COLLECTIONS = ["virtual-keys", "teams", "customers", "business-units", "projects"]

const HEX = "0123456789abcdef"
const DIGITS = "0123456789"
const UNITS = "smhdwMQY"
const COLLECTIONS = ["virtual-keys", "budgets", "rate-limits", "teams", "customers"]

// Ids and virtual key values are bearer credentials: they come from the kernel CSPRNG.
function randHex(n: int): string {
  try {
    return secureHex(n)
  } catch (e) {
    // No secure source: refuse to mint credentials rather than make weak ones.
    console.error(`raiju: ${e.message}`)
    process.exit(1)
    return ""
  }
}

export function randomId(prefix: string): string {
  return prefix + randHex(12)
}

// A virtual key value: "sk-bf-" then 32 hex characters.
export function newVkValue(): string {
  return "sk-bf-" + randHex(32)
}

// Shows the first and last four characters. Short secrets become "****"; empty
// values and "env.NAME" references are not secrets and pass through.
export function maskSecret(v: string): string {
  if (v === "" || v.startsWith("env.")) return v
  const n = v.byteLength
  if (n <= 8) return "****"
  return v.slice(0, 4) + "…" + v.slice(n - 4)
}

function maskOpt(v: string | undefined): string | undefined {
  return v === undefined ? undefined : maskSecret(v)
}

// A masked value sent back unchanged means "keep the stored secret".
function keepSecret(incoming: string, existing: string | undefined): string {
  if (existing === undefined) return incoming
  return incoming === maskSecret(existing) ? existing : incoming
}

function keepOpt(incoming: string | undefined, existing: string | undefined): string | undefined {
  if (incoming === undefined) return existing
  return keepSecret(incoming, existing)
}

// Whether a value is in maskSecret's shape ("****", or four characters, "…", four characters): a masked value that
// matched no stored secret must not be saved as if it were the secret.
export function looksMasked(v: string | undefined): bool {
  if (v === undefined) return false
  if (v === "****") return true
  return v.includes("…") && v.byteLength === 4 + "…".byteLength + 4
}

// The secrets of a key that are still masked after prepKey: masked values that matched no stored key.
function maskedLeft(k: KeyConfig): bool {
  return looksMasked(k.value) || looksMasked(k.vertex_key_config?.auth_credentials) || looksMasked(k.bedrock_key_config?.secret_key) || looksMasked(k.bedrock_key_config?.session_token)
    || looksMasked(k.azure_key_config?.client_secret) || looksMasked(k.bedrock_mantle_key_config?.secret_key) || looksMasked(k.bedrock_mantle_key_config?.session_token)
    || looksMasked(k.watsonx_key_config?.api_key) || looksMasked(k.databricks_key_config?.client_secret) || looksMasked(k.github_copilot_key_config?.private_key)
    || looksMasked(k.oauth_key_config?.client_secret) || looksMasked(k.oauth_key_config?.private_key)
}

const MASKED_KEY = "a key value is masked but matches no stored key: send the real value, or the key's id with its masked value to keep it"

// Provider names: lower-case letters, digits, "_" and "-", 1 to 64 bytes.
export function validProviderName(name: string): bool {
  const n = name.byteLength
  if (n < 1 || n > 64) return false
  for (const b of new TextEncoder().encode(name)) {
    const c = int(b)
    const ok = (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c === 95 || c === 45
    if (!ok) return false
  }
  return true
}

// A positive number and one unit: s m h d w M (30 days) Q (90 days) Y.
export function validDuration(s: string): bool {
  let i = 0
  while (i < s.byteLength && DIGITS.includes(s.slice(i, i + 1))) i += 1
  if (i === 0 || i + 1 !== s.byteLength) return false
  if (!UNITS.includes(s.slice(i))) return false
  const n = parseInt(s.slice(0, i)) ?? 0
  return n > 0
}

function fail(status: int, message: string): Failure {
  return { kind: "error", status: status, message: message }
}

// These copy the whole value and replace one field, so config sections and
// fields this file doesn't know about (auth_config, routing_rules, plugins,
// otel, ...) survive every save.
function gov(c: Config): GovernanceConfig {
  const g = c.governance
  if (g === undefined) return {}
  return g
}

function withGov(c: Config, g: GovernanceConfig): Config {
  let n = c
  n.governance = g
  return n
}

function copyProviders(c: Config): Map<string, ProviderConfig> {
  const out: Map<string, ProviderConfig> = new Map()
  const ps = c.providers
  if (ps !== undefined) {
    for (const n of ps.keys()) out.set(n, ps.get(n)!)
  }
  return out
}

function withProviders(c: Config, ps: Map<string, ProviderConfig>): Config {
  let n = c
  n.providers = ps
  return n
}

function withKeys(p: ProviderConfig, keys: KeyConfig[]): ProviderConfig {
  let n = p
  n.keys = keys
  return n
}

function findById<T extends HasId>(xs: T[] | undefined, id: string): T | undefined {
  if (xs === undefined) return undefined
  for (const x of xs) {
    if (x.id === id) return x
  }
  return undefined
}

// Replaces the entry with x's id, or appends x.
function putById<T extends HasId>(xs: T[], x: T): T[] {
  const out: T[] = []
  let placed = false
  for (const y of xs) {
    if (y.id === x.id) {
      out.push(x)
      placed = true
    } else {
      out.push(y)
    }
  }
  if (!placed) out.push(x)
  return out
}

function dropById<T extends HasId>(xs: T[], id: string): T[] {
  const out: T[] = []
  for (const y of xs) {
    if (y.id !== id) out.push(y)
  }
  return out
}

// Keys are addressed by id, or by name for keys written by hand without one.
function isKey(k: KeyConfig, ref: string): bool {
  return k.id === ref || (k.id === undefined && k.name === ref) || (k.name === ref && ref !== "")
}

function findKey(ks: KeyConfig[], id: string): KeyConfig | undefined {
  for (const k of ks) {
    if (isKey(k, id)) return k
  }
  return undefined
}

function hasDupKeyIds(keys: KeyConfig[]): bool {
  const seen: string[] = []
  for (const k of keys) {
    const id = k.id ?? ""
    if (seen.includes(id)) return true
    seen.push(id)
  }
  return false
}

// The stored form of a key: its id, and the stored secrets when the request sent them masked or left them out. The
// whole key is kept, every per-key block with it (azure, vertex, bedrock, bedrock_mantle, watsonx, cloudflare,
// databricks, github_copilot, replicate and oauth_key_config); a secret inside a block that comes back masked keeps
// the stored value (keyWithSecrets).
function prepKey(k: KeyConfig, id: string, old: KeyConfig | undefined): KeyConfig {
  const kept = keyWithSecrets(k, old, true)
  let n = kept
  n.id = id
  return n
}

// Each secret of a key, masked (restore false: for reads) or restored from the stored key when it came back masked or
// was left out (restore true: for writes). Settings that are not secrets pass as they are. (Every value is read from
// k before the copies are changed: records are values.)
function keyWithSecrets(k: KeyConfig, old: KeyConfig | undefined, restore: bool): KeyConfig {
  const sec = (v: string | undefined, prev: string | undefined): string | undefined => restore ? keepOpt(v, prev) : maskOpt(v)
  const value = sec(k.value, old?.value)
  const az = k.azure_key_config
  const azSecret = az === undefined ? undefined : sec(az.client_secret, old?.azure_key_config?.client_secret)
  const vx = k.vertex_key_config
  const vxCreds = vx === undefined ? undefined : sec(vx.auth_credentials, old?.vertex_key_config?.auth_credentials)
  const bk = k.bedrock_key_config
  const bkNew = bk === undefined ? undefined : bedrockSecrets(bk, old?.bedrock_key_config, restore)
  const bm = k.bedrock_mantle_key_config
  const bmNew = bm === undefined ? undefined : bedrockSecrets(bm, old?.bedrock_mantle_key_config, restore)
  const wx = k.watsonx_key_config
  const wxKey = wx === undefined ? "" : (sec(wx.api_key, old?.watsonx_key_config?.api_key) ?? "")
  const db = k.databricks_key_config
  const dbSecret = db === undefined ? undefined : sec(db.client_secret, old?.databricks_key_config?.client_secret)
  const gc = k.github_copilot_key_config
  const gcKey = gc === undefined ? "" : (sec(gc.private_key, old?.github_copilot_key_config?.private_key) ?? "")
  const oc = k.oauth_key_config
  const prev = old?.oauth_key_config
  const ocSecret = oc === undefined ? undefined : sec(oc.client_secret, prev?.client_secret)
  const ocKey = oc === undefined ? undefined : sec(oc.private_key, prev?.private_key)
  // extra parameters can carry credentials, as Bifrost treats them
  let ocExtra: Map<string, string> | undefined = undefined
  const ex = oc?.extra_params
  if (ex !== undefined) {
    const out: Map<string, string> = new Map()
    const pe = prev?.extra_params
    for (const name of ex.keys()) {
      let pv: string | undefined = undefined
      if (pe !== undefined) pv = pe.get(name)
      out.set(name, sec(ex.get(name), pv) ?? "")
    }
    ocExtra = out
  }
  let n = k
  n.value = value
  if (az !== undefined) {
    let a = az
    a.client_secret = azSecret
    n.azure_key_config = a
  }
  if (vx !== undefined) {
    // aws_workload_identity's role ARN is masked on reads, as Bifrost's Redacted masks it
    const wi: VertexAwsWorkloadIdentity | undefined = vx.aws_workload_identity
    let v = vx
    v.auth_credentials = vxCreds
    if (wi !== undefined) {
      const arn = sec(wi.aws_role_arn, old?.vertex_key_config?.aws_workload_identity?.aws_role_arn)
      let w = wi
      w.aws_role_arn = arn
      v.aws_workload_identity = w
    }
    n.vertex_key_config = v
  }
  if (bkNew !== undefined) n.bedrock_key_config = bkNew
  if (bmNew !== undefined) n.bedrock_mantle_key_config = bmNew
  if (wx !== undefined) {
    let w = wx
    w.api_key = wxKey
    n.watsonx_key_config = w
  }
  if (db !== undefined) {
    let d = db
    d.client_secret = dbSecret
    n.databricks_key_config = d
  }
  if (gc !== undefined) {
    let g = gc
    g.private_key = gcKey
    n.github_copilot_key_config = g
  }
  if (oc !== undefined) {
    let o = oc
    o.client_secret = ocSecret
    o.private_key = ocKey
    if (ocExtra !== undefined) o.extra_params = ocExtra
    n.oauth_key_config = o
  }
  return n
}

function bedrockSecrets(b: BedrockKeyConfig, old: BedrockKeyConfig | undefined, restore: bool): BedrockKeyConfig {
  const sk = restore ? keepOpt(b.secret_key, old?.secret_key) : maskOpt(b.secret_key)
  const st = restore ? keepOpt(b.session_token, old?.session_token) : maskOpt(b.session_token)
  let n = b
  n.secret_key = sk
  n.session_token = st
  return n
}

// The stored key a key sent back stands for: by id, else by name, else the key at the same position when that one
// has neither an id nor a name to match by (a GET of a hand-written config, sent back with its keys in order).
function oldKeyFor(k: KeyConfig, i: int, old: KeyConfig[]): KeyConfig | undefined {
  const id = k.id ?? ""
  if (id !== "") return findKey(old, id)
  const name = k.name ?? ""
  if (name !== "") {
    const byName = findKey(old, name)
    if (byName !== undefined) return byName
  }
  const at = old[i]
  if (name === "" && at !== undefined && (at.id ?? "") === "" && (at.name ?? "") === "") return at
  return undefined
}

// Gives every key an id, keeping the stored secrets of keys sent back masked. A key that matches a stored one keeps
// that key's id (so a GET then PUT changes no id).
function prepKeys(keys: KeyConfig[], old: KeyConfig[]): KeyConfig[] {
  const out: KeyConfig[] = []
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i]!
    const prev = oldKeyFor(k, i, old)
    const given = k.id ?? ""
    const id = given !== "" ? given : (prev?.id ?? "") !== "" ? prev!.id! : randomId("key-")
    out.push(prepKey(k, id, prev))
  }
  return out
}

function budgetError(b: BudgetConfig): string {
  if (b.max_limit === undefined || !(b.max_limit > 0.0)) return "max_limit must be greater than 0"
  if (b.reset_duration === undefined || !validDuration(b.reset_duration)) return "reset_duration must be a number and one unit: s m h d w M Q or Y"
  const cu = b.current_usage
  if (cu !== undefined && !(cu >= 0.0)) return "current_usage cannot be negative"
  return ""
}

function rateLimitError(r: RateLimitConfig): string {
  if (r.request_max_limit === undefined && r.token_max_limit === undefined) return "a rate limit needs request_max_limit or token_max_limit"
  const rm = r.request_max_limit
  if (rm !== undefined && rm < 1) return "request_max_limit must be at least 1"
  const tm = r.token_max_limit
  if (tm !== undefined && tm < 1) return "token_max_limit must be at least 1"
  const rd = r.request_reset_duration
  if (rd !== undefined && !validDuration(rd)) return "request_reset_duration must be a number and one unit: s m h d w M Q or Y"
  const td = r.token_reset_duration
  if (td !== undefined && !validDuration(td)) return "token_reset_duration must be a number and one unit: s m h d w M Q or Y"
  return ""
}

// Budgets and rate limits an owner (a model config or a provider) created from inline values
// carry ids derived from the owner's id, so deleting the owner can find them.
function ownsBudget(owner: string, id: string): bool {
  return id.startsWith(owner + "-budget-")
}

function ownsRate(owner: string, id: string): bool {
  return id === owner + "-rate-limit"
}

type Inline = { err: string, budgetIds?: string[], rateSet: bool, rateId?: string }

// Stores inline budgets (absent keeps the owner's) and a rate limit ({} clears it) under the owner's
// derived ids. The caller keeps g only when err is "".
function applyInline(inout g: GovernanceConfig, owner: string, budgets: BudgetBody[] | undefined, rate: RateBody | undefined): Inline {
  const out: Inline = { err: "", rateSet: false }
  if (budgets !== undefined) {
    let next: BudgetConfig[] = (g.budgets ?? []).filter((x) => !ownsBudget(owner, x.id))
    const ids: string[] = []
    let i = 0
    for (const x of budgets) {
      const bid = `${owner}-budget-${i}`
      i += 1
      const nb: BudgetConfig = { id: bid, max_limit: x.max_limit ?? 0.0, reset_duration: x.reset_duration ?? "", current_usage: findById(g.budgets, bid)?.current_usage }
      const err = budgetError(nb)
      if (err !== "") {
        out.err = err
        return out
      }
      next = putById(next, nb)
      ids.push(bid)
    }
    g.budgets = next
    out.budgetIds = ids
  }
  if (rate !== undefined) {
    const rid = owner + "-rate-limit"
    const kept: RateLimitConfig[] = (g.rate_limits ?? []).filter((x) => x.id !== rid)
    out.rateSet = true
    if (rate.request_max_limit === undefined && rate.token_max_limit === undefined) {
      g.rate_limits = kept
      return out
    }
    const nr: RateLimitConfig = { id: rid, token_max_limit: rate.token_max_limit, token_reset_duration: rate.token_reset_duration, request_max_limit: rate.request_max_limit, request_reset_duration: rate.request_reset_duration }
    const err = rateLimitError(nr)
    if (err !== "") {
      out.err = err
      return out
    }
    g.rate_limits = putById(kept, nr)
    out.rateId = rid
  }
  return out
}

// Drops the budgets and rate limit an owner created.
function dropOwned(inout g: GovernanceConfig, owner: string): void {
  g.budgets = (g.budgets ?? []).filter((x) => !ownsBudget(owner, x.id))
  g.rate_limits = (g.rate_limits ?? []).filter((x) => !ownsRate(owner, x.id))
}

// Names what still uses a budget or rate limit the owner created; "" when nothing does.
function ownedInUse(c: Config, g: GovernanceConfig, owner: string): string {
  const probe = withGov(c, g)
  for (const x of g.budgets ?? []) {
    if (ownsBudget(owner, x.id)) {
      const u = budgetUsers(probe, x.id)
      if (u !== "") return `budget ${x.id} is used by ${u}`
    }
  }
  for (const x of g.rate_limits ?? []) {
    if (ownsRate(owner, x.id)) {
      const u = rateLimitUsers(probe, x.id)
      if (u !== "") return `rate limit ${x.id} is used by ${u}`
    }
  }
  return ""
}

function budgetsOf(g: GovernanceConfig, ids: string[]): BudgetConfig[] {
  const out: BudgetConfig[] = []
  for (const id of ids) {
    const x = findById(g.budgets, id)
    if (x !== undefined) out.push(x)
  }
  return out
}

function providerGovFor(g: GovernanceConfig, name: string): ProviderGovernance | undefined {
  for (const pg of g.providers ?? []) {
    if (pg.name === name) return pg
  }
  return undefined
}

function overrideById(xs: PricingOverrideConfig[] | undefined, id: string): PricingOverrideConfig | undefined {
  for (const x of xs ?? []) {
    if (x.id === id) return x
  }
  return undefined
}

// Bifrost's view of a model config: its budgets and rate limit inline.
function modelConfigView(c: Config, mc: ModelConfigGovernance): string {
  const g = gov(c)
  const ids: string[] = []
  if (mc.budget_id !== undefined) ids.push(mc.budget_id)
  for (const id of mc.budget_ids ?? []) ids.push(id)
  return JSON.stringify({
    id: mc.id,
    model_name: mc.model_name,
    provider: mc.provider,
    scope: mc.scope ?? "global",
    scope_id: mc.scope_id,
    calendar_aligned: mc.calendar_aligned ?? false,
    budgets: budgetsOf(g, ids),
    rate_limit: findById(g.rate_limits, mc.rate_limit_id ?? ""),
  })
}

function modelConfigList(c: Config): string {
  const views: string[] = []
  for (const mc of gov(c).model_configs ?? []) views.push(modelConfigView(c, mc))
  const n = views.length
  return `{"model_configs":[${views.join(",")}],"count":${n},"total_count":${n}}`
}

function providerGovView(c: Config, pg: ProviderGovernance): string {
  const g = gov(c)
  const ids: string[] = []
  if (pg.budget_id !== undefined) ids.push(pg.budget_id)
  for (const id of pg.budget_ids ?? []) ids.push(id)
  return JSON.stringify({
    provider: pg.name,
    description: pg.description,
    budgets: budgetsOf(g, ids),
    rate_limit: findById(g.rate_limits, pg.rate_limit_id ?? ""),
  })
}

function providerGovList(c: Config): string {
  const views: string[] = []
  for (const pg of gov(c).providers ?? []) views.push(providerGovView(c, pg))
  const n = views.length
  return `{"providers":[${views.join(",")}],"count":${n}}`
}

// A pricing override as Bifrost returns it: the stored patch text becomes the patch object.
function pricingView(o: PricingOverrideConfig): string {
  const head = JSON.stringify({
    id: o.id,
    name: o.name,
    scope_kind: o.scope_kind,
    provider_id: o.provider_id,
    provider_key_id: o.provider_key_id,
    virtual_key_id: o.virtual_key_id,
    user_id: o.user_id,
    request_types: o.request_types,
    match_type: o.match_type,
    pattern: o.pattern,
  })
  return head.slice(0, head.byteLength - 1) + ",\"patch\":" + o.pricing_patch + "}"
}

function pricingList(c: Config): string {
  const views: string[] = []
  for (const o of gov(c).pricing_overrides ?? []) views.push(pricingView(o))
  const n = views.length
  return `{"pricing_overrides":[${views.join(",")}],"count":${n},"total_count":${n},"limit":${n},"offset":0}`
}

// Why a pricing override cannot be stored; "" when it can.
function pricingError(o: PricingOverrideConfig): string {
  const k = o.scope_kind
  if (k !== "global" && k !== "provider" && k !== "provider_key" && k !== "virtual_key" && k !== "user") return `invalid scope_kind ${k}`
  if (k === "provider" && (o.provider_id ?? "") === "") return "provider_id is required for a provider scope"
  if (k === "provider_key" && (o.provider_key_id ?? "") === "") return "provider_key_id is required for a provider_key scope"
  if (k === "virtual_key" && (o.virtual_key_id ?? "") === "") return "virtual_key_id is required for a virtual_key scope"
  if (k === "user" && (o.user_id ?? "") === "") return "user_id is required for a user scope"
  const mt = o.match_type
  if (mt !== "exact" && mt !== "wildcard") return `invalid match_type ${mt}`
  if (o.pattern === "") return "pattern is required"
  if (mt === "wildcard" && !o.pattern.endsWith("*")) return "a wildcard pattern must end with *"
  const raw = o.pricing_patch
  let ok = raw.trim().startsWith("{")
  if (ok) {
    try {
      // a text that starts with "{" parses to an object or fails
      JSON.parse(raw) as Record<string, f64>
    } catch (e) {
      ok = false
    }
  }
  if (!ok) return "patch must be a JSON object"
  return ""
}

// A nullable id from a PUT body: absent keeps the old value, null clears it, a string sets it.
function nullable(fs: Field[], key: string, incoming: string | undefined, old: string | undefined): string | undefined {
  const raw = find(fs, key)
  if (raw === undefined) return old
  if (isNull(raw)) return undefined
  return incoming
}

function parseModelConfig(b: string): ModelConfigBody | undefined {
  try {
    return JSON.parse(b) as ModelConfigBody
  } catch (e) {
    return undefined
  }
}

function parseProviderGov(b: string): ProviderBody | undefined {
  try {
    return JSON.parse(b) as ProviderBody
  } catch (e) {
    return undefined
  }
}

function parsePricing(b: string): PricingBody | undefined {
  try {
    return JSON.parse(b) as PricingBody
  } catch (e) {
    return undefined
  }
}

function parseFields(b: string): Field[] | undefined {
  try {
    return fields(b)
  } catch (e) {
    return undefined
  }
}

// Names the first reference from a virtual key that points at nothing.
function vkRefError(c: Config, vk: VirtualKeyConfig): string {
  const g = gov(c)
  const b = vk.budget_id
  if (b !== undefined && findById(g.budgets, b) === undefined) return `unknown budget ${b}`
  const rl = vk.rate_limit_id
  if (rl !== undefined && findById(g.rate_limits, rl) === undefined) return `unknown rate limit ${rl}`
  const t = vk.team_id
  if (t !== undefined && findById(g.teams, t) === undefined) return `unknown team ${t}`
  const cu = vk.customer_id
  if (cu !== undefined && findById(g.customers, cu) === undefined) return `unknown customer ${cu}`
  for (const pc of vk.provider_configs ?? []) {
    const pb = pc.budget_id
    if (pb !== undefined && findById(g.budgets, pb) === undefined) return `unknown budget ${pb}`
    const pr = pc.rate_limit_id
    if (pr !== undefined && findById(g.rate_limits, pr) === undefined) return `unknown rate limit ${pr}`
  }
  return ""
}

// What still refers to a budget, rate limit, team or customer; "" when nothing does.
function budgetUsers(c: Config, id: string): string {
  const g = gov(c)
  for (const mc of g.model_configs ?? []) {
    if (mc.budget_id === id || (mc.budget_ids ?? []).includes(id)) return `model config ${mc.id}`
  }
  for (const pg of g.providers ?? []) {
    if (pg.budget_id === id || (pg.budget_ids ?? []).includes(id)) return `provider ${pg.name}`
  }
  for (const vk of g.virtual_keys ?? []) {
    if (vk.budget_id === id) return `virtual key ${vk.id}`
    for (const pc of vk.provider_configs ?? []) {
      if (pc.budget_id === id) return `virtual key ${vk.id}`
    }
  }
  for (const t of g.teams ?? []) {
    if (t.budget_id === id) return `team ${t.id}`
  }
  for (const cu of g.customers ?? []) {
    if (cu.budget_id === id) return `customer ${cu.id}`
  }
  for (const b of g.business_units ?? []) {
    if (b.budget_id === id) return `business unit ${b.id}`
  }
  for (const pj of g.projects ?? []) {
    if (pj.budget_id === id) return `project ${pj.id}`
    for (const pc of pj.provider_configs ?? []) {
      if (pc.budget_id === id) return `project ${pj.id}`
    }
  }
  return ""
}

function rateLimitUsers(c: Config, id: string): string {
  for (const mc of gov(c).model_configs ?? []) {
    if (mc.rate_limit_id === id) return `model config ${mc.id}`
  }
  for (const pg of gov(c).providers ?? []) {
    if (pg.rate_limit_id === id) return `provider ${pg.name}`
  }
  for (const vk of gov(c).virtual_keys ?? []) {
    if (vk.rate_limit_id === id) return `virtual key ${vk.id}`
    for (const pc of vk.provider_configs ?? []) {
      if (pc.rate_limit_id === id) return `virtual key ${vk.id}`
    }
  }
  for (const b of gov(c).business_units ?? []) {
    if (b.rate_limit_id === id) return `business unit ${b.id}`
  }
  for (const pj of gov(c).projects ?? []) {
    if (pj.rate_limit_id === id) return `project ${pj.id}`
    for (const pc of pj.provider_configs ?? []) {
      if (pc.rate_limit_id === id) return `project ${pj.id}`
    }
  }
  return ""
}

function teamUsers(c: Config, id: string): string {
  for (const vk of gov(c).virtual_keys ?? []) {
    if (vk.team_id === id) return `virtual key ${vk.id}`
  }
  return ""
}

function customerUsers(c: Config, id: string): string {
  const g = gov(c)
  for (const vk of g.virtual_keys ?? []) {
    if (vk.customer_id === id) return `virtual key ${vk.id}`
  }
  for (const t of g.teams ?? []) {
    if (t.customer_id === id) return `team ${t.id}`
  }
  return ""
}

// Masked copies for reads: the whole key, every block with its secrets masked (keyWithSecrets).
function redactKey(k: KeyConfig): KeyConfig {
  let out = keyWithSecrets(k, undefined, false)
  // the effective id (a hand-written key without one is addressed by its name), so a GET then PUT finds the key
  out.id = k.id ?? k.name
  return out
}

// The whole provider with its secrets masked, so settings added later survive a GET then PUT.
function redactProvider(p: ProviderConfig): ProviderConfig {
  const ks = p.keys
  let px = p.proxy_config
  let n = p
  n.keys = ks === undefined ? undefined : ks.map((k) => redactKey(k))
  if (px !== undefined) {
    px.password = maskOpt(px.password)
    n.proxy_config = px
  }
  return n
}

type ProviderView = {
  name: string,
  kind: string,
  base_url: string,
  keys: { id: string, name: string, value: string, models: string[], weight: f64 }[],
  network_config?: NetworkConfig,
  custom_provider_config?: CustomProviderConfig,
}

// GET /api/providers: a list (Bifrost's shape), secrets masked.
function providerList(c: Config): string {
  const out: ProviderView[] = []
  const ps = c.providers
  if (ps !== undefined) {
    for (const name of ps.keys()) {
      const p = ps.get(name)!
      out.push({
        name: name,
        kind: p.custom_provider_config?.base_provider_type ?? name,
        base_url: p.network_config?.base_url ?? "",
        keys: (p.keys ?? []).map((k) => ({ id: k.id ?? k.name ?? "", name: k.name ?? k.id ?? "", value: maskSecret(k.value ?? ""), models: k.models ?? [], weight: k.weight ?? 1.0 })),
        network_config: p.network_config,
        custom_provider_config: p.custom_provider_config,
      })
    }
  }
  return JSON.stringify({ providers: out })
}

function redactProviders(ps: Map<string, ProviderConfig> | undefined): Map<string, ProviderConfig> | undefined {
  if (ps === undefined) return undefined
  const out: Map<string, ProviderConfig> = new Map()
  for (const n of ps.keys()) out.set(n, redactProvider(ps.get(n)!))
  return out
}

function redactVk(vk: VirtualKeyConfig): VirtualKeyConfig {
  return {
    id: vk.id,
    name: vk.name,
    value: maskSecret(vk.value),
    description: vk.description,
    is_active: vk.is_active,
    team_id: vk.team_id,
    customer_id: vk.customer_id,
    user_id: vk.user_id,
    budget_id: vk.budget_id,
    rate_limit_id: vk.rate_limit_id,
    provider_configs: vk.provider_configs,
    key_ids: vk.key_ids,
    // the editor sends these back on a PUT, which replaces the record
    access_profile_ids: vk.access_profile_ids,
    disable_content_logging: vk.disable_content_logging,
    expires_at: vk.expires_at,
    mcp_configs: vk.mcp_configs,
    agent_grants: vk.agent_grants,
  }
}

function redactConfig(c: Config): Config {
  const ps = redactProviders(c.providers)
  const sc = c.scim_config
  const tok = sc?.config?.provisioningToken
  const g0 = c.governance
  let n = c
  n.providers = ps
  if (g0 !== undefined) {
    const vks = g0.virtual_keys
    const auth = g0.auth_config
    let g = g0
    if (vks !== undefined) g.virtual_keys = vks.map((vk) => redactVk(vk))
    if (auth !== undefined) {
      g.auth_config = {
        username: auth.username,
        password: auth.password === undefined ? undefined : maskSecret(auth.password),
        token: auth.token === undefined ? undefined : maskSecret(auth.token),
      }
    }
    n.governance = g
  }
  // the SCIM provisioning token and the provider's secrets are masked too (an env. reference shows as written)
  if (sc !== undefined) {
    let ms = sc
    let mc = sc.config ?? {}
    if (tok !== undefined) mc.provisioningToken = maskSecret(tok)
    const cs = mc.clientSecret
    if (cs !== undefined) mc.clientSecret = maskSecret(cs)
    const at = mc.apiToken
    if (at !== undefined) mc.apiToken = maskSecret(at)
    const ss = mc.serviceAccountClientSecret
    if (ss !== undefined) mc.serviceAccountClientSecret = maskSecret(ss)
    const sj = mc.serviceAccountJson
    if (sj !== undefined) mc.serviceAccountJson = maskSecret(sj)
    ms.config = mc
    n.scim_config = ms
  }
  return n
}

// ---- the global proxy: GET and PUT /api/proxy-config ----

const REDACTED = "<redacted>"

// The global proxy as GET returns it: the password masked, and Bifrost's defaults when none is set.
function proxyView(px: GlobalProxyConfig | undefined): string {
  const p: GlobalProxyConfig = px ?? { enabled: false, type: "http" }
  return JSON.stringify({
    enabled: p.enabled ?? false,
    type: p.type ?? "http",
    url: p.url ?? "",
    username: p.username ?? "",
    password: (p.password ?? "") === "" ? "" : REDACTED,
    no_proxy: p.no_proxy ?? "",
    timeout: p.timeout ?? 0,
    skip_tls_verify: p.skip_tls_verify ?? false,
    enable_for_scim: p.enable_for_scim ?? false,
    enable_for_inference: p.enable_for_inference ?? false,
    enable_for_api: p.enable_for_api ?? false,
  })
}

type ProxyParse = { ok: bool, px: GlobalProxyConfig, err: string }

function proxyFail(err: string): ProxyParse {
  return { ok: false, px: {}, err: err }
}

// The proxy a PUT body sets, or why it is refused. A password of "<redacted>" keeps the stored one.
function proxyBody(b: string, old: GlobalProxyConfig | undefined): ProxyParse {
  let body: GlobalProxyConfig = {}
  try {
    body = JSON.parse(b) as GlobalProxyConfig
  } catch (e) {
    return proxyFail("Invalid request payload")
  }
  const type = (body.type ?? "http").toLowerCase()
  const url = body.url ?? ""
  if (body.enabled === true) {
    if (type === "socks5" || type === "tcp") return proxyFail(`proxy type ${type} is not yet supported`)
    if (type !== "http") return proxyFail(`invalid proxy type: ${type}`)
    if (url === "") return proxyFail("proxy URL is required when proxy is enabled")
    if (!url.startsWith("http://") && !url.startsWith("https://")) return proxyFail("Invalid proxy URL: must be an http or https URL")
    // link-local and unspecified hosts are never allowed (Bifrost's ValidateExternalURL rule)
    const host = url.slice(url.indexOf("://") + 3).split("/")[0]!.split(":")[0]!
    if (host.startsWith("169.254.") || host === "0.0.0.0") return proxyFail("Invalid proxy URL: link-local and unspecified addresses are not allowed")
  }
  if ((body.timeout ?? 0) < 0) return proxyFail("proxy timeout must be non-negative")
  let password = body.password ?? ""
  if (password === REDACTED) password = old?.password ?? ""
  const px: GlobalProxyConfig = {
    enabled: body.enabled ?? false,
    type: type,
    url: url,
    username: body.username ?? "",
    password: password,
    no_proxy: body.no_proxy ?? "",
    timeout: body.timeout ?? 0,
    skip_tls_verify: body.skip_tls_verify ?? false,
    enable_for_scim: body.enable_for_scim ?? false,
    enable_for_inference: body.enable_for_inference ?? false,
    enable_for_api: body.enable_for_api ?? false,
  }
  return { ok: true, px: px, err: "" }
}

// The changes a PUT would make that need an authenticated admin: a new proxy URL, or skip_tls_verify
// turned on. Bifrost refuses these while dashboard auth is off, since they let the proxy read traffic.
export function proxyWidening(old: GlobalProxyConfig | undefined, body: string): string[] {
  const b = proxyBody(body, old)
  if (!b.ok) return []
  const out: string[] = []
  if (b.px.enabled === true && (b.px.url ?? "") !== (old?.url ?? "")) out.push("url")
  if (b.px.skip_tls_verify === true && old?.skip_tls_verify !== true) out.push("skip_tls_verify")
  return out
}

function proxyRoute(store: ConfigStore, m: string, body: string): ApiReply {
  if (m === "GET") return reply(200, proxyView(store.cfg.proxy_config))
  if (m !== "PUT") return notAllowed(m)
  const b = proxyBody(body, store.cfg.proxy_config)
  if (!b.ok) return reply(400, errorBody(b.err))
  const r = store.setProxy(b.px)
  if (r.kind === "error") return errReply(r)
  return reply(200, JSON.stringify({ message: "Proxy configuration updated successfully" }))
}

// Encryption at rest (Bifrost's encryption_key). The secrets in the saved file are sealed with
// AES-256-GCM: provider key values, virtual key values, and the admin password and token. The
// store keeps them as plain text in memory. The key is PBKDF2-HMAC-SHA256 of the passphrase with a
// fixed salt and 100,000 rounds, derived once at startup. Bifrost derives its key with Argon2id,
// so a file sealed here does not open in Bifrost, and the other way round.
export type ConfigCipher = { key: u8[] }

const KDF_ROUNDS = 100000
const KDF_SALT = "raiju-config-encryption-v1"
const SEALED = "enc:v1:"
const NO_AAD: u8[] = []
const HEXV = "0123456789abcdef"

export function cipherFor(passphrase: string): ConfigCipher {
  return { key: pbkdf2Sha256(utf8(passphrase), utf8(KDF_SALT), KDF_ROUNDS, 32) }
}

// The cipher for a config: its encryption_key (env.NAME is read), else the BIFROST_ENCRYPTION_KEY
// variable. undefined when neither is set, so the file is saved in plain text as before.
export function cipherFromConfig(c: Config): ConfigCipher | undefined throws Error {
  const k = c.encryption_key ?? ""
  if (k.startsWith("env.") && resolveEnv(k) === "") throw new Error(`encryption_key ${k} is not set in the environment`)
  const pass = k !== "" ? resolveEnv(k) : (getEnv("BIFROST_ENCRYPTION_KEY") ?? "")
  if (pass === "") return undefined
  return cipherFor(pass)
}

// References are kept as written: env.NAME, vault.path and aws-sm.id are never sealed.
function isReference(v: string): bool {
  return v.startsWith("env.") || v.startsWith("vault.") || v.startsWith("aws-sm.")
}

function hexBytes(h: string): u8[] {
  const out: u8[] = []
  for (let i = 0; i + 1 < h.byteLength; i += 2) {
    out.push(u8(HEXV.indexOf(h.slice(i, i + 1)) * 16 + HEXV.indexOf(h.slice(i + 1, i + 2))))
  }
  return out
}

// "enc:v1:" then base64 of the 12-byte nonce, the ciphertext and the 16-byte tag.
function sealValue(c: ConfigCipher, v: string): string throws Error {
  const nonce = hexBytes(try secureHex(24))
  return SEALED + encode(nonce.concat(gcmSeal(c.key, nonce, utf8(v), NO_AAD)))
}

// The plain text of a value. A value that is not sealed is returned as it is; undefined means it
// is sealed and cannot be opened (no key, another key, or a damaged value).
function openValue(c: ConfigCipher | undefined, v: string): string | undefined {
  if (!v.startsWith(SEALED)) return v
  if (c === undefined) return undefined
  let raw: u8[] = []
  try {
    raw = decode(v.slice(SEALED.byteLength))
  } catch (e) {
    return undefined
  }
  if (raw.length < 28) return undefined
  const pt = gcmOpen(c.key, raw.slice(0, 12), raw.slice(12), NO_AAD)
  if (pt === undefined) return undefined
  try {
    return new TextDecoder().decode(pt)
  } catch (e) {
    return undefined
  }
}

// A secret the gateway keeps outside the config file (the MCP authorization server's generated key): sealed with
// the config's cipher when there is one, so it is no plainer on disk than the config's own secrets.
export function sealStored(cipher: ConfigCipher | undefined, v: string): string throws Error {
  if (cipher === undefined || v === "") return v
  return try sealValue(cipher, v)
}

// The plain text of a stored secret, or undefined when it is sealed and cannot be opened.
export function openStored(cipher: ConfigCipher | undefined, v: string): string | undefined {
  return openValue(cipher, v)
}

// A retained credential as the cluster state carries it (clusterstate.tov): its JSON, with the access and refresh
// tokens sealed like the config file's secrets. Without a cipher the tokens travel as the config file holds them.
export function sealAdminRow(cipher: ConfigCipher | undefined, row: McpUserToken): string throws Error {
  const x = try JSON.parse(JSON.stringify(row)) as McpUserToken
  x.access_token = try sealStored(cipher, row.access_token)
  x.refresh_token = try sealStored(cipher, row.refresh_token)
  return JSON.stringify(x)
}

// The credential a cluster state entry carries, its tokens opened; undefined when the entry does not parse or a token
// is sealed under a key this node does not hold.
export function openAdminRow(cipher: ConfigCipher | undefined, text: string): McpUserToken | undefined {
  let x: McpUserToken | undefined = undefined
  try {
    x = JSON.parse(text) as McpUserToken
  } catch (e) {
    return undefined
  }
  if (x === undefined) return undefined
  const at = openStored(cipher, x.access_token)
  const rt = openStored(cipher, x.refresh_token)
  if (at === undefined || rt === undefined) return undefined
  x.access_token = at
  x.refresh_token = rt
  return x
}

// The admin credential of one client as the config file holds it now (other workers and nodes save there). undefined
// when the file cannot be read or holds none for the client.
export function readStoredAdmin(path: string, cipher: ConfigCipher | undefined, client: string): McpUserToken | undefined {
  let c: Config | undefined = undefined
  try {
    c = loadRawConfig(path)
  } catch (e) {
    return undefined
  }
  if (c === undefined) return undefined
  let opened: Config = c
  try {
    opened = openConfig(c, cipher).cfg
  } catch (e) {
    return undefined
  }
  for (const r of opened.mcp?.exchange_admin ?? []) {
    // a token that is still sealed was not opened (no key, or another key): it is not taken
    if (r.mcp_client_name === client && !r.access_token.startsWith(SEALED)) return r
  }
  return undefined
}

// The header values of an agent's auth, sealed or opened (see secretValue).
function sealAuth(cipher: ConfigCipher | undefined, seal: bool, a: AgentAuth | undefined, path: string, inout errors: string[]): AgentAuth | undefined throws Error {
  if (a === undefined) return a
  let headers: Map<string, string> | undefined = undefined
  const hs = a.headers
  if (hs !== undefined) {
    const hm: Map<string, string> = new Map()
    for (const k of hs.keys()) hm.set(k, try secretValue(cipher, seal, hs.get(k) ?? "", `${path}.${k}`, &errors))
    headers = hm
  }
  let oauth: AgentOAuth | undefined = undefined
  const oa = a.oauth
  if (oa !== undefined) oauth = { provider_url: oa.provider_url, discovery_url: oa.discovery_url, token_url: oa.token_url, client_id: try secretValue(cipher, seal, oa.client_id, `${path}.oauth.client_id`, &errors), client_secret: try secretValue(cipher, seal, oa.client_secret, `${path}.oauth.client_secret`, &errors), scopes: oa.scopes, resource: oa.resource }
  let tls: AgentTls | undefined = undefined
  const t = a.tls
  if (t !== undefined) tls = { insecure_skip_verify: t.insecure_skip_verify, ca_cert_pem: try sealOpt(cipher, seal, t.ca_cert_pem, `${path}.tls.ca_cert_pem`, &errors), client_cert_pem: try sealOpt(cipher, seal, t.client_cert_pem, `${path}.tls.client_cert_pem`, &errors), client_key_pem: try sealOpt(cipher, seal, t.client_key_pem, `${path}.tls.client_key_pem`, &errors) }
  return { type: a.type, headers: headers, oauth: oauth, security_schemes: a.security_schemes, advanced: a.advanced, tls: tls }
}

function sealOpt(cipher: ConfigCipher | undefined, seal: bool, v: string | undefined, path: string, inout errors: string[]): string | undefined throws Error {
  if (v === undefined) return undefined
  return try secretValue(cipher, seal, v, path, &errors)
}

// One secret value, sealed (seal) or opened. A value that cannot be opened is kept and noted.
function secretValue(cipher: ConfigCipher | undefined, seal: bool, v: string, path: string, inout errors: string[]): string throws Error {
  if (v === "" || isReference(v)) return v
  if (seal) {
    if (cipher === undefined || v.startsWith(SEALED)) return v
    return try sealValue(cipher, v)
  }
  const plain = openValue(cipher, v)
  if (plain === undefined) {
    errors.push(`config: "${path}" is sealed and cannot be opened: check encryption_key`)
    return v
  }
  return plain
}

// The config with its secrets sealed (seal) or opened. The input is not changed.
function transformSecrets(c: Config, cipher: ConfigCipher | undefined, seal: bool, inout errors: string[]): Config throws Error {
  const ps = c.providers
  const gov = c.governance
  const mcp = c.mcp
  let out = c
  if (ps !== undefined) {
    const np: Map<string, ProviderConfig> = new Map()
    for (const name of ps.keys()) {
      let p = ps.get(name)!
      const keys = p.keys
      if (keys !== undefined) {
        let nk: KeyConfig[] = []
        for (const k of keys) {
          let kk = k
          const v = kk.value
          if (v !== undefined) kk.value = try secretValue(cipher, seal, v, `providers.${name}.keys.value`, &errors)
          nk.push(kk)
        }
        p.keys = nk
      }
      np.set(name, p)
    }
    out.providers = np
  }
  const whs = out.webhooks
  if (whs !== undefined) {
    let nw: WebhookEndpoint[] = []
    for (const w of whs) {
      let x = w
      const sec = x.secret
      if (sec !== undefined) x.secret = try secretValue(cipher, seal, sec, `webhooks.${x.name}.secret`, &errors)
      const hs = x.headers
      if (hs !== undefined) {
        const hm: Map<string, string> = new Map()
        for (const k of hs.keys()) hm.set(k, try secretValue(cipher, seal, hs.get(k) ?? "", `webhooks.${x.name}.headers.${k}`, &errors))
        x.headers = hm
      }
      nw.push(x)
    }
    out.webhooks = nw
  }
  const ags = out.agents
  if (ags !== undefined) {
    let na: AgentConfig[] = []
    for (const a of ags) {
      let x = a
      x.discovery_auth = try sealAuth(cipher, seal, x.discovery_auth, `agents.${x.name}.discovery_auth`, &errors)
      x.runtime_auth = try sealAuth(cipher, seal, x.runtime_auth, `agents.${x.name}.runtime_auth`, &errors)
      na.push(x)
    }
    out.agents = na
  }
  if (gov !== undefined) {
    let g = gov
    const au = g.auth_config
    if (au !== undefined) {
      let a = au
      const pw = a.password
      const tok = a.token
      if (pw !== undefined) a.password = try secretValue(cipher, seal, pw, "governance.auth_config.password", &errors)
      if (tok !== undefined) a.token = try secretValue(cipher, seal, tok, "governance.auth_config.token", &errors)
      g.auth_config = a
    }
    const vks = g.virtual_keys
    if (vks !== undefined) {
      let nv: VirtualKeyConfig[] = []
      for (const vk of vks) {
        let x = vk
        x.value = try secretValue(cipher, seal, x.value, `governance.virtual_keys.${x.id}.value`, &errors)
        nv.push(x)
      }
      g.virtual_keys = nv
    }
    out.governance = g
  }
  // the secrets of MCP clients: static tokens, client secrets, and the tokens an OAuth flow saved
  if (mcp !== undefined && mcp.client_configs !== undefined) {
    let nm = mcp
    let nl: McpClientConfig[] = []
    for (const cc of mcp.client_configs) {
      let x = cc
      const au = x.auth
      if (au !== undefined) {
        let a = au
        const where = `mcp.client_configs.${x.name}.auth`
        const tk = a.token
        if (tk !== undefined && tk !== "") a.token = try secretValue(cipher, seal, tk, `${where}.token`, &errors)
        const cs = a.client_secret
        if (cs !== undefined && cs !== "") a.client_secret = try secretValue(cipher, seal, cs, `${where}.client_secret`, &errors)
        const rt = a.refresh_token
        if (rt !== undefined && rt !== "") a.refresh_token = try secretValue(cipher, seal, rt, `${where}.refresh_token`, &errors)
        const at = a.access_token
        if (at !== undefined && at !== "") a.access_token = try secretValue(cipher, seal, at, `${where}.access_token`, &errors)
        x.auth = a
      }
      nl.push(x)
    }
    nm.client_configs = nl
    out.mcp = nm
  }
  // the per-user OAuth tokens (per_user_oauth clients): the access and refresh tokens are secrets
  if (out.mcp !== undefined && out.mcp.user_tokens !== undefined) {
    let nt: McpUserToken[] = []
    for (const ut of out.mcp.user_tokens) {
      let x = ut
      x.access_token = try secretValue(cipher, seal, x.access_token, `mcp.user_tokens.${x.id}.access_token`, &errors)
      x.refresh_token = try secretValue(cipher, seal, x.refresh_token, `mcp.user_tokens.${x.id}.refresh_token`, &errors)
      nt.push(x)
    }
    let mt = out.mcp
    mt.user_tokens = nt
    out.mcp = mt
  }
  // the admin discovery credentials of the token_exchange clients: their access and refresh tokens are secrets
  if (out.mcp !== undefined && out.mcp.exchange_admin !== undefined) {
    let na: McpUserToken[] = []
    for (const ea of out.mcp.exchange_admin) {
      let x = ea
      x.access_token = try secretValue(cipher, seal, x.access_token, `mcp.exchange_admin.${x.mcp_client_name}.access_token`, &errors)
      x.refresh_token = try secretValue(cipher, seal, x.refresh_token, `mcp.exchange_admin.${x.mcp_client_name}.refresh_token`, &errors)
      na.push(x)
    }
    let ma = out.mcp
    ma.exchange_admin = na
    out.mcp = ma
  }
  // the per-user headers each virtual key submitted (per_user_headers clients): their values are secrets
  if (out.mcp !== undefined && out.mcp.user_credentials !== undefined) {
    let nu: McpUserCredential[] = []
    for (const uc of out.mcp.user_credentials) {
      let x = uc
      const hs: Map<string, string> = new Map()
      for (const k of x.headers.keys()) hs.set(k, try secretValue(cipher, seal, x.headers.get(k) ?? "", `mcp.user_credentials.${x.id}.headers.${k}`, &errors))
      x.headers = hs
      nu.push(x)
    }
    let mo = out.mcp
    mo.user_credentials = nu
    out.mcp = mo
  }
  return out
}

// The config as it is saved: its secrets sealed. With no cipher it is returned unchanged.
export function sealConfig(c: Config, cipher: ConfigCipher | undefined): Config throws Error {
  if (cipher === undefined) return c
  let errs: string[] = []
  return try transformSecrets(c, cipher, true, &errs)
}

// A config as it was read from the file, its sealed secrets opened. errors names each value that
// cannot be opened; the caller refuses to start when there are any.
export function openConfig(c: Config, cipher: ConfigCipher | undefined): { cfg: Config, errors: string[] } throws Error {
  let errs: string[] = []
  const cfg = try transformSecrets(c, cipher, false, &errs)
  return { cfg: cfg, errors: errs }
}

// The config generation. Every save puts the sha256 of the text written, and the node that wrote it, on the cluster
// state under CONFIG_NS/CONFIG_KEY. The other workers of the node get it through the share folder within two share
// ticks, the other nodes at their next cluster sync; each takes the text as its config (takeGeneration, adopt), so a
// deleted virtual key stops working everywhere and not only in the process that saved.
export const CONFIG_NS = "config"
export const CONFIG_KEY = "file"

export type ConfigGen = { sha: string, node: string }

// sha256 of a config text, in hex: the generation's name.
export function textSha(text: string): string {
  return toHex(sha256(utf8(text)))
}

// The generation carried by a cluster state value, or undefined when it does not hold one.
export function genOf(value: string): ConfigGen | undefined {
  try {
    const g = try JSON.parse(value) as ConfigGen
    if (g.sha.byteLength !== 64 || g.node === "") return undefined
    return g
  } catch (e) {
    return undefined
  }
}

// What takeGeneration did: "same" (this process holds it), "reloaded" (the file held it, now the config), "differs"
// (the file holds other text, another node's own file) or "error" (it could not be read or opened; message says why).
export type GenOutcome = { status: "same" | "reloaded" | "differs" | "error", message: string }

// A config text pulled from another node, with this node's own cluster section put back (node_id, peers and the secret
// stay this node's). own is the cluster section as the local file writes it, or undefined when there is none.
export function withOwnCluster(text: string, own: string | undefined): string throws SyntaxError {
  let fs = without(try fields(text), ["cluster", "cluster_config"])
  if (own !== undefined) setField(&fs, "cluster", own)
  return build(fs)
}

export class ConfigStore {
  cfg: Config
  version: int = 0
  // the generation this process holds: sha256 of the config text it last saved, read or adopted ("" before any)
  fileSha: string = ""
  // that generation's text as its writer saved it (what a peer pulling it is served, see Ops.clusterConfig)
  genText: string = ""
  onChange: ((c: Config) => void) | undefined = undefined
  // called after every save, once the generation is on the cluster state (Ops sends it out at once)
  onSaved: (() => void) | undefined = undefined
  // encryption at rest: the saved file seals its secrets with this cipher (set at startup)
  cipher: ConfigCipher | undefined = undefined
  // why the last change could not be saved ("" once one is): GET /ready reports it
  saveError = ""

  // `initial` should be the config as written in the file (env.NAME references
  // unresolved), so save() writes the references and not their values.
  // Top-level sections of the file that Config doesn't model (Bifrost's guardrails_config,
  // say), kept as written: saves put them back, and rawSection() hands them out.
  private extras: Field[] = []

  constructor(readonly path: string, initial: Config) {
    this.cfg = initial
    setGlobalProxy(initial.proxy_config)
    // temporary files a crash left between write and rename (a recent one may be another worker's save in progress)
    removeStaleTemps(path, 600000.0)
    removeStaleTemps(path + ".bak", 600000.0)
    try {
      if (existsSync(path)) {
        const text = readFileSync(path, "utf8")
        this.fileSha = textSha(text)
        this.genText = text
        const known = fields(JSON.stringify(initial)).map((f) => f.key)
        this.extras = fields(text).filter((f) => !known.includes(f.key) && f.key !== "plugins")
      }
    } catch (e) {
      this.extras = []
    }
  }

  rawSection(name: string): string | undefined {
    return find(this.extras, name)
  }

  // Writes the config as JSON, atomically (a temporary file renamed over it), so a crash or another worker never
  // sees half a file. The previous file is kept as <path>.bak.
  save(): void throws Error {
    this.keepNewerAdmin()
    let text = JSON.stringify(try sealConfig(this.cfg, this.cipher), undefined, 2)
    if (this.extras.length > 0) {
      const end = text.byteLength - 1
      const sep = text.trim() === "{}" ? "\n" : ",\n"
      text = text.slice(0, end).trimEnd() + sep + this.extras.map((f) => `  ${quote(f.key)}: ${f.raw}`).join(",\n") + "\n}"
    }
    if (existsSync(this.path)) {
      const old = try readFileSync(this.path, "utf8")
      // the backup holds every secret the config held: private, whatever an older version left it as
      try writeFileAtomic(this.path + ".bak", old, { mode: PRIVATE_FILE, exact: true })
    }
    const out = text + "\n"
    try writeFileAtomic(this.path, out)
    this.fileSha = textSha(out)
    this.genText = out
    // the other workers and nodes take this text as their config (takeGeneration)
    const st = clusterState()
    const gen: ConfigGen = { sha: this.fileSha, node: nodeOf(st.writerId()) }
    st.put(CONFIG_NS, CONFIG_KEY, JSON.stringify(gen))
    const f = this.onSaved
    if (f !== undefined) f()
  }

  // A generation saved by another process. When this process holds it nothing happens; when the config file holds it
  // (a sibling worker's save, or a file the nodes share) it becomes the config through adopt; otherwise the file holds
  // other text and the caller decides (pull it from a peer, or leave this node's config as it is).
  takeGeneration(sha: string): GenOutcome {
    if (sha === this.fileSha) return { status: "same", message: "" }
    let text = ""
    try {
      text = readFileSync(this.path, "utf8")
    } catch (e) {
      return { status: "error", message: e.message }
    }
    if (textSha(text) !== sha) return { status: "differs", message: "" }
    const problem = this.adopt(text, sha, text)
    if (problem !== "") return { status: "error", message: problem }
    return { status: "reloaded", message: "" }
  }

  // Takes a config text another process saved as this process's config, without saving it: its sealed secrets are
  // opened with this store's cipher, the sections Config does not model are kept, and onChange applies it. sha and
  // writerText name the generation as its writer saved it. Returns "" or the problem (the config is then unchanged).
  adopt(text: string, sha: string, writerText: string): string {
    let next: Config = {}
    try {
      const opened = try openConfig(try rawConfigOf(text), this.cipher)
      if (opened.errors.length > 0) return opened.errors.join("; ")
      next = opened.cfg
    } catch (e) {
      return e.message
    }
    let extras: Field[] = []
    try {
      const known = fields(JSON.stringify(next)).map((f) => f.key)
      extras = fields(text).filter((f) => !known.includes(f.key) && f.key !== "plugins")
    } catch (e) {
      extras = []
    }
    this.cfg = next
    this.extras = extras
    this.fileSha = sha
    this.genText = writerText
    this.version += 1
    setGlobalProxy(next.proxy_config)
    const f = this.onChange
    if (f !== undefined) f(this.cfg)
    return ""
  }

  // A generation pulled from a peer (cluster.config_sync "pull"): the writer's text, with this node's cluster section
  // put back, is written to the config file and adopted. A file that cannot be written (a read-only mount) still
  // leaves the config adopted in memory. Returns "" or the problem.
  adoptPulled(pulled: string, sha: string): string {
    if (textSha(pulled) !== sha) return "the text does not match the generation"
    let merged = ""
    try {
      merged = try withOwnCluster(pulled, this.ownClusterRaw())
    } catch (e) {
      return e.message
    }
    let note = ""
    try {
      try writeFileAtomic(this.path, merged + "\n")
    } catch (e) {
      note = `adopted in memory only: the config file could not be written: ${e.message}`
    }
    const problem = this.adopt(merged + "\n", sha, pulled)
    return problem !== "" ? problem : note
  }

  // This node's cluster section as its file writes it (secrets sealed when encryption at rest is on).
  ownClusterRaw(): string | undefined {
    try {
      const raw = find(try fields(try readFileSync(this.path, "utf8")), "cluster")
      if (raw !== undefined) return raw
    } catch (e) {
      // no file: the section comes from the config held
    }
    try {
      const c = (try sealConfig(this.cfg, this.cipher)).cluster
      return c === undefined ? undefined : JSON.stringify(c)
    } catch (e) {
      return undefined
    }
  }

  // A save never writes back a retained admin credential older than the one the file holds: another worker or node
  // renewed it since this copy was read (a renewal moves last_refreshed_at forward). The newer row is kept here too.
  private keepNewerAdmin(): void {
    if (!existsSync(this.path)) return
    let disk: Config | undefined = undefined
    try {
      disk = openConfig(loadRawConfig(this.path), this.cipher).cfg
    } catch (e) {
      return
    }
    if (disk === undefined) return
    const theirs = disk.mcp?.exchange_admin ?? []
    let changed = false
    let kept: McpUserToken[] = []
    for (const r of this.cfg.mcp?.exchange_admin ?? []) {
      let keep = r
      for (const d of theirs) {
        if (d.mcp_client_name === r.mcp_client_name && d.last_refreshed_at > r.last_refreshed_at && !d.access_token.startsWith(SEALED)) {
          keep = d
          changed = true
        }
      }
      kept.push(keep)
    }
    if (!changed) return
    let c = this.cfg
    let m = c.mcp ?? {}
    m.exchange_admin = kept
    c.mcp = m
    this.cfg = c
  }

  // Swaps in the next config, saves it and notifies. A failed save restores
  // the previous config, so memory never differs from the file.
  private commit(next: Config, id: string): Result {
    const prev = this.cfg
    this.cfg = next
    try {
      this.save()
    } catch (e) {
      this.cfg = prev
      this.saveError = e.message
      return fail(500, `could not save config: ${e.message}`)
    }
    this.saveError = ""
    this.version += 1
    setGlobalProxy(next.proxy_config)
    // the dashboard hears of every saved change (notify.tov)
    notify({ severity: "info", title: "Configuration changed", message: `${id} was saved (configuration version ${this.version}).` })
    const f = this.onChange
    if (f !== undefined) f(this.cfg)
    return { kind: "ok", id: id }
  }

  // Replaces the prompt repository (prompts with their versions, and deployments); see prompts.tov.
  setPromptRepo(r: PromptRepoConfig): Result {
    let n: Config = this.cfg
    n.prompt_repo = r
    return this.commit(n, "prompt-repo")
  }

  // Replaces the registered A2A agents; see agents.tov.
  setAgents(a: AgentConfig[]): Result {
    let n: Config = this.cfg
    n.agents = a
    return this.commit(n, "agents")
  }

  // Replaces the webhook endpoints; see webhooks.tov.
  setWebhooks(w: WebhookEndpoint[]): Result {
    let n: Config = this.cfg
    n.webhooks = w
    return this.commit(n, "webhooks")
  }

  // Replaces the feature flag overrides; see flags.tov.
  setFeatureFlags(f: FeatureFlagsConfig): Result {
    let n: Config = this.cfg
    n.feature_flags = f
    return this.commit(n, "feature-flags")
  }

  // Replaces the User-Agent to app mappings of the request logs (logapi.tov).
  setUserAgentMappings(m: UserAgentMapping[]): Result {
    let n: Config = this.cfg
    n.user_agent_mappings = m
    return this.commit(n, "user-agent-mappings")
  }

  // Replaces the plugin list (plugins[]); the save rebuilds the live plugin chain (see /api/plugins in ops.tov).
  setPlugins(list: PluginSpec[]): Result {
    let n: Config = this.cfg
    n.plugins = list
    return this.commit(n, "plugins")
  }

  // Replaces the alerts section (rules, channels and Bifrost-style CEL rules); see alertapi.tov.
  setAlerts(a: AlertsConfig): Result {
    let n = this.cfg
    n.alerts = a
    return this.commit(n, "alerts")
  }

  // Replaces the access profiles (governance.access_profiles); see profiles.tov.
  setProfiles(profiles: AccessProfile[]): Result {
    let g: GovernanceConfig = this.cfg.governance ?? {}
    g.access_profiles = profiles
    return this.commit(withGov(this.cfg, g), "access-profiles")
  }

  // Replaces the management API keys (governance.api_keys); see apikeys.tov.
  setApiKeys(keys: ApiKeyConfig[]): Result {
    let g: GovernanceConfig = this.cfg.governance ?? {}
    g.api_keys = keys
    return this.commit(withGov(this.cfg, g), "api-keys")
  }

  // Replaces the admin users (governance.users); see rbac.tov.
  setUsers(users: AdminUserConfig[]): Result {
    let g: GovernanceConfig = this.cfg.governance ?? {}
    g.users = users
    return this.commit(withGov(this.cfg, g), "users")
  }

  // Puts bcrypt hashes in place of old salted SHA-256 passwords (rbac.tov takeUpgrades): each user that still holds
  // the old hash it was verified against gets the new one, and the old fields go. Nothing to change saves nothing.
  upgradePasswords(ups: { name: string, old: string, hash: string }[]): Result {
    const users: AdminUserConfig[] = []
    let changed = 0
    for (const u of this.cfg.governance?.users ?? []) {
      let next = u
      for (const up of ups) {
        if (u.name === up.name && u.password_sha256 !== undefined && u.password_sha256 === up.old && u.password_hash === undefined) {
          next.password_hash = up.hash
          next.password_sha256 = undefined
          next.salt = undefined
          changed += 1
        }
      }
      users.push(next)
    }
    if (changed === 0) return { kind: "ok", id: "" }
    return this.setUsers(users)
  }

  // Replaces the users, teams and business units a sign-in's claims changed, as one save (claimsync.tov).
  setClaimSync(users: AdminUserConfig[], teams: TeamConfig[], bus: BusinessUnitConfig[]): Result {
    let g: GovernanceConfig = this.cfg.governance ?? {}
    g.users = users
    g.teams = teams
    g.business_units = bus
    return this.commit(withGov(this.cfg, g), "claim-sync")
  }

  // Replaces the SCIM provisioning token (the identity provider's connector must be given the new one).
  setScimToken(token: string): Result {
    let sc = this.cfg.scim_config ?? {}
    let c = sc.config ?? {}
    c.provisioningToken = token
    sc.config = c
    let n: Config = this.cfg
    n.scim_config = sc
    return this.commit(n, "scim-token")
  }

  // The users, teams and business units a directory sync, import, reconcile or SCIM push left, as one save, with the
  // removed users' virtual keys (the keys assigned to them) and project memberships gone with them, as Bifrost's
  // deprovisioning removes a user's keys and memberships.
  setProvisioned(users: AdminUserConfig[], teams: TeamConfig[], bus: BusinessUnitConfig[], removed: string[]): Result {
    let g: GovernanceConfig = this.cfg.governance ?? {}
    g.users = users
    g.teams = teams
    g.business_units = bus
    if (removed.length > 0) {
      const lower = removed.map((n) => n.toLowerCase())
      const vks = g.virtual_keys
      if (vks !== undefined) g.virtual_keys = vks.filter((vk) => !lower.includes((vk.user_id ?? "").toLowerCase()))
      const pjs = g.projects
      if (pjs !== undefined) {
        g.projects = pjs.map((p) => {
          let n = p
          const ms = p.members
          if (ms !== undefined) n.members = ms.filter((m) => !lower.includes(m.user_id.toLowerCase()))
          return n
        })
      }
    }
    return this.commit(withGov(this.cfg, g), "provisioning")
  }

  // Replaces the users and teams a SCIM request changed, as one save (scim.tov).
  setScim(users: AdminUserConfig[], teams: TeamConfig[]): Result {
    let g: GovernanceConfig = this.cfg.governance ?? {}
    g.users = users
    g.teams = teams
    return this.commit(withGov(this.cfg, g), "scim")
  }

  // Adds or removes one access profile a user holds (users API); the profile must exist.
  setUserProfile(name: string, profileId: string, add: bool): Result {
    const g: GovernanceConfig = this.cfg.governance ?? {}
    if (findById(g.access_profiles, profileId) === undefined) return fail(404, `no access profile ${profileId}`)
    const users: AdminUserConfig[] = []
    let found = false
    for (const u of g.users ?? []) {
      if (u.name !== name) {
        users.push(u)
        continue
      }
      found = true
      let nu = u
      const held: string[] = (u.access_profile_ids ?? []).filter((id) => id !== profileId)
      if (add) held.push(profileId)
      nu.access_profile_ids = held
      users.push(nu)
    }
    if (!found) return fail(404, `no user ${name}`)
    g.users = users
    return this.commit(withGov(this.cfg, g), "user-profiles")
  }

  // Sets or clears (undefined) a user's override on the budget of an access profile the user holds (Bifrost's PUT and
  // DELETE /api/users/{user}/access-profiles/{profile}/budgets/{budget}/override). The budget must be the profile's.
  setUserBudgetOverride(name: string, profileId: string, budgetId: string, o: BudgetOverride | undefined): Result {
    const g: GovernanceConfig = this.cfg.governance ?? {}
    const p = findById(g.access_profiles, profileId)
    if (p === undefined) return fail(404, `no access profile ${profileId}`)
    if (findById(g.budgets, budgetId) === undefined || p.budget_id !== budgetId) return fail(404, `budget ${budgetId} is not on access profile ${profileId}`)
    if (!(g.users ?? []).some((u) => u.name === name)) return fail(404, `no user ${name}`)
    if (!heldProfiles(g.users, g.roles, g.access_profiles, name).some((h) => h.id === profileId)) return fail(404, `user ${name} does not hold access profile ${profileId}`)
    const users: AdminUserConfig[] = []
    for (const u of g.users ?? []) {
      if (u.name !== name) {
        users.push(u)
        continue
      }
      let nu = u
      const kept: UserBudgetOverride[] = (u.budget_overrides ?? []).filter((x) => !(x.profile_id === profileId && x.budget_id === budgetId))
      if (o !== undefined) kept.push({ profile_id: profileId, budget_id: budgetId, override: { amount: o.amount, mode: o.mode, cycles: o.cycles, started_at: o.mode === "cycles" ? rfc3339Of(Date.now()) : undefined } })
      nu.budget_overrides = kept.length === 0 ? undefined : kept
      users.push(nu)
    }
    g.users = users
    return this.commit(withGov(this.cfg, g), "user-budget-override")
  }

  // Links or unlinks an access profile on a virtual key the user is assigned (users API).
  setVkProfile(name: string, vkId: string, profileId: string, add: bool): Result {
    const g: GovernanceConfig = this.cfg.governance ?? {}
    const vk = findById(g.virtual_keys, vkId)
    if (vk === undefined || (vk.user_id ?? "") !== name) return fail(404, `no virtual key ${vkId} assigned to user ${name}`)
    if (findById(g.access_profiles, profileId) === undefined) return fail(404, `no access profile ${profileId}`)
    let nvk = vk
    const held: string[] = (vk.access_profile_ids ?? []).filter((id) => id !== profileId)
    if (add) held.push(profileId)
    nvk.access_profile_ids = held
    g.virtual_keys = putById(g.virtual_keys ?? [], nvk)
    return this.commit(withGov(this.cfg, g), "virtual-key-profiles")
  }

  // Replaces the virtual keys as a whole (a propagate changes several at once).
  replaceVirtualKeys(vks: VirtualKeyConfig[]): Result {
    const g: GovernanceConfig = this.cfg.governance ?? {}
    g.virtual_keys = vks
    return this.commit(withGov(this.cfg, g), "propagate")
  }

  // Replaces the global proxy (Bifrost's proxy_config); see proxyRoute.
  setProxy(px: GlobalProxyConfig | undefined): Result {
    let n: Config = this.cfg
    n.proxy_config = px
    return this.commit(n, "proxy-config")
  }

  // Replaces the circuit breaker policies (Bifrost's circuit_breaker_config.policies); see circuitPoliciesRoute.
  setCircuitPolicies(list: CircuitPolicyConfig[]): Result {
    let n: Config = this.cfg
    n.circuit_breaker_policies = list
    return this.commit(n, "circuit-breaker-policies")
  }

  // Replaces the UI and admin metadata map; see postMetadata.
  setMetadata(m: Map<string, string | f64 | bool>): Result {
    let n: Config = this.cfg
    n.metadata = m
    return this.commit(n, "metadata")
  }

  // Replaces the client section (Bifrost's client_config); see putConfig.
  setClient(c: ClientConfig): Result {
    let n: Config = this.cfg
    n.client = c
    return this.commit(n, "client")
  }

  // Replaces the pricing sync section (Bifrost's framework.pricing); see putConfig.
  setPricingSync(ps: PricingSyncConfig | undefined): Result {
    let n: Config = this.cfg
    n.pricing_sync = ps
    return this.commit(n, "framework-config")
  }

  // Replaces the admin credential (governance.auth_config); see putConfig.
  setAdminAuth(a: AdminAuthConfig): Result {
    const g: GovernanceConfig = this.cfg.governance ?? {}
    g.auth_config = a
    return this.commit(withGov(this.cfg, g), "auth-config")
  }

  // Sets or clears (undefined) a budget's override. The budget must be one the key draws on (keyBudgetIds).
  setBudgetOverride(vkId: string, budgetId: string, o: BudgetOverride | undefined): Result {
    const g: GovernanceConfig = this.cfg.governance ?? {}
    const vk = findById(g.virtual_keys, vkId)
    if (vk === undefined) return fail(404, `no virtual-keys ${vkId}`)
    if (!keyBudgetIds(vk).includes(budgetId)) return fail(404, `budget ${budgetId} is not on virtual key ${vkId}`)
    const budgets: BudgetConfig[] = g.budgets ?? []
    const b = findById(budgets, budgetId)
    if (b === undefined) return fail(404, `no budgets ${budgetId}`)
    // a cycles override runs its cycles from now, and keeps the start across restarts (BudgetOverride.started_at)
    const kept: BudgetOverride | undefined = o === undefined ? undefined : { amount: o.amount, mode: o.mode, cycles: o.cycles, started_at: o.mode === "cycles" ? rfc3339Of(Date.now()) : undefined }
    const nb: BudgetConfig = { id: b.id, max_limit: b.max_limit, reset_duration: b.reset_duration, current_usage: b.current_usage, override: kept }
    g.budgets = putById(budgets, nb)
    return this.commit(withGov(this.cfg, g), "budget-override")
  }

  // Adds or replaces a routing rule (by id), after ruleError.
  upsertRoutingRule(rule: RoutingRule): Result {
    const err = ruleError(rule)
    if (err !== "") return fail(400, err)
    const g: GovernanceConfig = this.cfg.governance ?? {}
    g.routing_rules = putById(g.routing_rules ?? [], rule)
    return this.commit(withGov(this.cfg, g), "routing-rules")
  }

  deleteRoutingRule(id: string): Result {
    const g: GovernanceConfig = this.cfg.governance ?? {}
    const rules: RoutingRule[] = g.routing_rules ?? []
    if (findById(rules, id) === undefined) return fail(404, `no routing rule ${id}`)
    g.routing_rules = dropById(rules, id)
    return this.commit(withGov(this.cfg, g), "routing-rules")
  }

  // Replaces the complexity analyzer config (complexity_router); undefined turns it off.
  setComplexity(cs: ComplexitySettings | undefined): Result {
    let n: Config = this.cfg
    n.complexity_router = cs
    return this.commit(n, "complexity-analyzer-config")
  }

  // Why keys written to a provider are refused for their aliases, as Bifrost's key routes answer "Invalid aliases":
  // a provider override for another provider's keys (aliases.tov aliasProviderProblem). "" when they fit.
  private aliasFault(name: string, custom: CustomProviderConfig | undefined, keys: KeyConfig[]): string {
    const kind = custom?.base_provider_type ?? name
    for (const k of keys) {
      const a = k.aliases
      if (a === undefined) continue
      const p = aliasProviderProblem(a, kind)
      if (p !== "") return `Invalid aliases: ${p}`
    }
    return ""
  }

  // Why keys are refused for their oauth_key_config, as Bifrost's key routes check it on save (a jwt_bearer key needs
  // its issuer and audience, and a private key that fits its signing_algorithm). "" when they fit.
  private oauthFault(keys: KeyConfig[]): string {
    for (const k of keys) {
      const oc = k.oauth_key_config
      if (oc === undefined) continue
      const p = oauthKeyProblem(oc, true)
      if (p !== "") return p
    }
    return ""
  }

  private putProvider(name: string, np: ProviderConfig, id: string): Result {
    const ps = copyProviders(this.cfg)
    ps.set(name, np)
    return this.commit(withProviders(this.cfg, ps), id)
  }

  // Replaces the provider. Omitted keys keep the stored ones; omitted or masked
  // secrets keep the stored values.
  upsertProvider(name: string, p: ProviderConfig): Result {
    if (!validProviderName(name)) return fail(400, `invalid provider name ${name}`)
    const old = providerOf(this.cfg, name)
    const oldKeys = old?.keys ?? []
    const keys = p.keys === undefined ? oldKeys : prepKeys(p.keys, oldKeys)
    if (hasDupKeyIds(keys)) return fail(400, "duplicate key id")
    if (keys.some((k) => maskedLeft(k))) return fail(400, MASKED_KEY)
    if (looksMasked(p.proxy_config?.password) && (old?.proxy_config?.password === undefined || p.proxy_config?.password !== maskSecret(old?.proxy_config?.password ?? ""))) return fail(400, "proxy_config.password is masked but matches no stored password: send the real value")
    const af = this.aliasFault(name, p.custom_provider_config, p.keys ?? [])
    if (af !== "") return fail(400, af)
    const of = p.keys === undefined ? "" : this.oauthFault(keys)
    if (of !== "") return fail(400, of)
    const px = p.proxy_config
    const opx = old?.proxy_config
    return this.putProvider(name, {
      keys: keys,
      network_config: p.network_config,
      proxy_config: px === undefined ? undefined : { type: px.type, url: px.url, username: px.username, password: keepOpt(px.password, opx?.password) },
      custom_provider_config: p.custom_provider_config,
      send_back_raw_response: p.send_back_raw_response,
    }, name)
  }

  deleteProvider(name: string): Result {
    const ps = copyProviders(this.cfg)
    if (!ps.has(name)) return fail(404, `no provider ${name}`)
    ps.delete(name)
    return this.commit(withProviders(this.cfg, ps), name)
  }

  // Adds a key to an existing provider. The id is generated when missing.
  addKey(provider: string, k: KeyConfig): Result {
    const p = providerOf(this.cfg, provider)
    if (p === undefined) return fail(404, `no provider ${provider}`)
    const id = k.id === undefined || k.id === "" ? randomId("key-") : k.id
    const keys = p.keys ?? []
    if (findKey(keys, id) !== undefined) return fail(409, `key ${id} already exists`)
    const af = this.aliasFault(provider, p.custom_provider_config, [k])
    if (af !== "") return fail(400, af)
    const nk = prepKey(k, id, undefined)
    const of = this.oauthFault([nk])
    if (of !== "") return fail(400, of)
    const next: KeyConfig[] = []
    for (const x of keys) next.push(x)
    if (maskedLeft(nk)) return fail(400, MASKED_KEY)
    next.push(nk)
    return this.putProvider(provider, withKeys(p, next), id)
  }

  updateKey(provider: string, keyId: string, k: KeyConfig): Result {
    const p = providerOf(this.cfg, provider)
    if (p === undefined) return fail(404, `no provider ${provider}`)
    const keys = p.keys ?? []
    const old = findKey(keys, keyId)
    if (old === undefined) return fail(404, `no key ${keyId} on provider ${provider}`)
    const af = this.aliasFault(provider, p.custom_provider_config, [k])
    if (af !== "") return fail(400, af)
    const nk = prepKey(k, old.id ?? keyId, old)
    const of = this.oauthFault([nk])
    if (of !== "") return fail(400, of)
    if (maskedLeft(nk)) return fail(400, MASKED_KEY)
    const next: KeyConfig[] = []
    for (const x of keys) next.push(isKey(x, keyId) ? nk : x)
    return this.putProvider(provider, withKeys(p, next), keyId)
  }

  deleteKey(provider: string, keyId: string): Result {
    const p = providerOf(this.cfg, provider)
    if (p === undefined) return fail(404, `no provider ${provider}`)
    const keys = p.keys ?? []
    if (findKey(keys, keyId) === undefined) return fail(404, `no key ${keyId} on provider ${provider}`)
    const next: KeyConfig[] = []
    for (const x of keys) {
      if (!isKey(x, keyId)) next.push(x)
    }
    return this.putProvider(provider, withKeys(p, next), keyId)
  }

  // Creates or replaces a virtual key. A missing id or value is generated; an
  // existing key keeps its value when none is sent or the masked value is sent.
  upsertVirtualKey(vk: VirtualKeyConfig): Result {
    const id = vk.id === undefined || vk.id === "" ? randomId("vk-") : vk.id
    const g = gov(this.cfg)
    const old = findById(g.virtual_keys, id)
    const value = vk.value === undefined || vk.value === ""
      ? (old?.value ?? newVkValue())
      : keepSecret(vk.value, old?.value)
    if (looksMasked(value)) return fail(400, "the virtual key value is masked but matches no stored key: send the real value, or leave it out to keep it")
    for (const other of g.virtual_keys ?? []) {
      if (other.value === value && other.id !== id) return fail(409, "another virtual key has this value")
    }
    const refErr = vkRefError(this.cfg, vk)
    if (refErr !== "") return fail(400, refErr)
    const exp = vk.expires_at
    if (exp !== undefined && exp !== "" && rfc3339Ms(exp) === undefined) return fail(400, "expires_at must be an RFC 3339 time")
    const next: VirtualKeyConfig = {
      id: id,
      name: vk.name,
      value: value,
      description: vk.description,
      is_active: vk.is_active,
      team_id: vk.team_id,
      customer_id: vk.customer_id,
      budget_id: vk.budget_id,
      rate_limit_id: vk.rate_limit_id,
      provider_configs: vk.provider_configs,
      key_ids: vk.key_ids,
      // the profiles API assigns access profiles, so a write keeps the stored list
      access_profile_ids: old?.access_profile_ids,
      disable_content_logging: vk.disable_content_logging,
      user_id: old?.user_id,
      expires_at: exp === undefined || exp === "" ? undefined : exp,
      // a rotation's grace period is not set by a write; it stays until it ends or the next rotation
      previous_value: value === old?.value ? old?.previous_value : undefined,
      previous_value_expires_at: value === old?.value ? old?.previous_value_expires_at : undefined,
      rotated_at: old?.rotated_at,
      mcp_configs: vk.mcp_configs,
      agent_grants: vk.agent_grants,
    }
    g.virtual_keys = putById(g.virtual_keys ?? [], next)
    return this.commit(withGov(this.cfg, g), id)
  }

  // Gives a key a new value (Bifrost's rotation). The old value keeps working for cooldownMs
  // when that is positive; otherwise it stops at once.
  rotateVirtualKey(id: string, cooldownMs: number): Result {
    const g = gov(this.cfg)
    const old = findById(g.virtual_keys, id)
    if (old === undefined) return fail(404, `no virtual key ${id}`)
    let value = newVkValue()
    while (value === old.value) value = newVkValue()
    const now = Date.now()
    const grace = cooldownMs > 0
    const next: VirtualKeyConfig = {
      id: old.id,
      name: old.name,
      value: value,
      disable_content_logging: old.disable_content_logging,
      description: old.description,
      is_active: old.is_active,
      team_id: old.team_id,
      customer_id: old.customer_id,
      budget_id: old.budget_id,
      rate_limit_id: old.rate_limit_id,
      provider_configs: old.provider_configs,
      key_ids: old.key_ids,
      access_profile_ids: old.access_profile_ids,
      expires_at: old.expires_at,
      previous_value: grace ? old.value : undefined,
      previous_value_expires_at: grace ? rfc3339Of(now + cooldownMs) : undefined,
      rotated_at: rfc3339Of(now),
      mcp_configs: old.mcp_configs,
      agent_grants: old.agent_grants,
    }
    g.virtual_keys = putById(g.virtual_keys ?? [], next)
    return this.commit(withGov(this.cfg, g), id)
  }

  deleteVirtualKey(id: string): Result {
    const g = gov(this.cfg)
    if (findById(g.virtual_keys, id) === undefined) return fail(404, `no virtual key ${id}`)
    g.virtual_keys = dropById(g.virtual_keys ?? [], id)
    return this.commit(withGov(this.cfg, g), id)
  }

  upsertBudget(b: BudgetConfig): Result {
    const id = b.id === undefined || b.id === "" ? randomId("budget-") : b.id
    const err = budgetError(b)
    if (err !== "") return fail(400, err)
    const g = gov(this.cfg)
    const old = findById(g.budgets, id)
    const next: BudgetConfig = {
      id: id,
      max_limit: b.max_limit,
      reset_duration: b.reset_duration,
      current_usage: b.current_usage ?? old?.current_usage,
    }
    g.budgets = putById(g.budgets ?? [], next)
    return this.commit(withGov(this.cfg, g), id)
  }

  deleteBudget(id: string): Result {
    const g = gov(this.cfg)
    if (findById(g.budgets, id) === undefined) return fail(404, `no budget ${id}`)
    const user = budgetUsers(this.cfg, id)
    if (user !== "") return fail(409, `budget ${id} is used by ${user}`)
    g.budgets = dropById(g.budgets ?? [], id)
    return this.commit(withGov(this.cfg, g), id)
  }

  upsertRateLimit(r: RateLimitConfig): Result {
    const id = r.id === undefined || r.id === "" ? randomId("rl-") : r.id
    const err = rateLimitError(r)
    if (err !== "") return fail(400, err)
    const g = gov(this.cfg)
    const next: RateLimitConfig = {
      id: id,
      token_max_limit: r.token_max_limit,
      token_reset_duration: r.token_reset_duration,
      request_max_limit: r.request_max_limit,
      request_reset_duration: r.request_reset_duration,
    }
    g.rate_limits = putById(g.rate_limits ?? [], next)
    return this.commit(withGov(this.cfg, g), id)
  }

  deleteRateLimit(id: string): Result {
    const g = gov(this.cfg)
    if (findById(g.rate_limits, id) === undefined) return fail(404, `no rate limit ${id}`)
    const user = rateLimitUsers(this.cfg, id)
    if (user !== "") return fail(409, `rate limit ${id} is used by ${user}`)
    g.rate_limits = dropById(g.rate_limits ?? [], id)
    return this.commit(withGov(this.cfg, g), id)
  }

  upsertTeam(t: TeamConfig): Result {
    const id = t.id === undefined || t.id === "" ? randomId("team-") : t.id
    if (t.name === undefined || t.name === "") return fail(400, "team name is required")
    const g = gov(this.cfg)
    const cu = t.customer_id
    if (cu !== undefined && findById(g.customers, cu) === undefined) return fail(400, `unknown customer ${cu}`)
    const b = t.budget_id
    if (b !== undefined && findById(g.budgets, b) === undefined) return fail(400, `unknown budget ${b}`)
    const bu = t.business_unit_id
    if (bu !== undefined && bu !== "" && findById(g.business_units, bu) === undefined) return fail(400, `unknown business unit ${bu}`)
    const next: TeamConfig = { id: id, name: t.name, customer_id: cu, budget_id: b, business_unit_id: bu === "" ? undefined : bu }
    g.teams = putById(g.teams ?? [], next)
    return this.commit(withGov(this.cfg, g), id)
  }

  deleteTeam(id: string): Result {
    const g = gov(this.cfg)
    if (findById(g.teams, id) === undefined) return fail(404, `no team ${id}`)
    const user = teamUsers(this.cfg, id)
    if (user !== "") return fail(409, `team ${id} is used by ${user}`)
    g.teams = dropById(g.teams ?? [], id)
    return this.commit(withGov(this.cfg, g), id)
  }

  upsertCustomer(c: CustomerConfig): Result {
    const id = c.id === undefined || c.id === "" ? randomId("customer-") : c.id
    if (c.name === undefined || c.name === "") return fail(400, "customer name is required")
    const g = gov(this.cfg)
    const b = c.budget_id
    if (b !== undefined && findById(g.budgets, b) === undefined) return fail(400, `unknown budget ${b}`)
    const next: CustomerConfig = { id: id, name: c.name, budget_id: b }
    g.customers = putById(g.customers ?? [], next)
    return this.commit(withGov(this.cfg, g), id)
  }

  deleteCustomer(id: string): Result {
    const g = gov(this.cfg)
    if (findById(g.customers, id) === undefined) return fail(404, `no customer ${id}`)
    const user = customerUsers(this.cfg, id)
    if (user !== "") return fail(409, `customer ${id} is used by ${user}`)
    g.customers = dropById(g.customers ?? [], id)
    return this.commit(withGov(this.cfg, g), id)
  }

  // Saves a project whole (its id is decided by the caller). Defaults fill in the rules left out.
  upsertProject(p: ProjectConfig): Result {
    const next: ProjectConfig = {
      id: p.id,
      name: p.name,
      description: p.description,
      is_active: p.is_active ?? true,
      access_rule: p.access_rule ?? "union",
      accounting_mode: p.accounting_mode ?? "both",
      membership_mode: p.membership_mode ?? "explicit",
      virtual_key_ids: p.virtual_key_ids,
      budget_id: p.budget_id,
      rate_limit_id: p.rate_limit_id,
      provider_configs: p.provider_configs,
      split_policy: p.split_policy ?? "none",
      agent_grants: p.agent_grants,
    }
    const err = projectError(this.cfg, next)
    if (err !== "") return fail(400, err)
    const g = gov(this.cfg)
    // the roster stays with the project; under an equal split the hand-written member caps are dropped
    const kept: ProjectMember[] = []
    const prior = findById(g.projects, p.id)
    if (prior !== undefined) {
      for (const m of prior.members ?? []) kept.push(next.split_policy === "equal" ? { id: m.id, user_id: m.user_id } : m)
    }
    const eq = equalRateError(g, next, kept.length)
    if (eq !== "") return fail(400, eq)
    next.members = kept
    g.projects = putById(g.projects ?? [], next)
    return this.commit(withGov(this.cfg, g), next.id)
  }

  deleteProject(id: string): Result {
    const g = gov(this.cfg)
    if (findById(g.projects, id) === undefined) return fail(404, `no project ${id}`)
    g.projects = dropById(g.projects ?? [], id)
    return this.commit(withGov(this.cfg, g), id)
  }

  // Adds members to a project, each user once. A user must be a stored user.
  addProjectMembers(pid: string, users: string[]): Result {
    const g = gov(this.cfg)
    const pj = findById(g.projects, pid)
    if (pj === undefined) return fail(404, `no project ${pid}`)
    const members: ProjectMember[] = []
    for (const m of pj.members ?? []) members.push(m)
    for (const u of users) {
      let known = false
      for (const su of g.users ?? []) {
        if (su.name === u) known = true
      }
      if (!known) return fail(400, `unknown user ${u}`)
      let dup = false
      for (const m of members) {
        if (m.user_id === u) dup = true
      }
      if (!dup) members.push({ id: resolveId(undefined, undefined, "pm-"), user_id: u })
    }
    const eq = equalRateError(g, pj, members.length)
    if (eq !== "") return fail(400, eq)
    let np = pj
    np.members = members
    g.projects = putById(g.projects ?? [], np)
    return this.commit(withGov(this.cfg, g), pid)
  }

  // Removes a member from a project; the member's caps go with it.
  removeProjectMember(pid: string, mid: string): Result {
    const g = gov(this.cfg)
    const pj = findById(g.projects, pid)
    if (pj === undefined) return fail(404, `no project ${pid}`)
    if (findById(pj.members, mid) === undefined) return fail(404, `no member ${mid}`)
    const members: ProjectMember[] = []
    for (const m of pj.members ?? []) {
      if (m.id !== mid) members.push(m)
    }
    let np = pj
    np.members = members
    g.projects = putById(g.projects ?? [], np)
    return this.commit(withGov(this.cfg, g), pid)
  }

  // Replaces a member's own caps (the complete statement, as Bifrost's): only under split_policy none, and
  // each share names a budget or rate limit the project holds.
  setMemberShares(pid: string, mid: string, shares: MemberShare[], rshares: RateLimitShare[]): Result {
    const g = gov(this.cfg)
    const pj = findById(g.projects, pid)
    if (pj === undefined) return fail(404, `no project ${pid}`)
    if (pj.split_policy === "equal") return fail(400, "the project splits its caps equally, so member caps are not set by hand; use split_policy none")
    if (findById(pj.members, mid) === undefined) return fail(404, `no member ${mid}`)
    const held = projectBudgetIds(pj)
    for (const s of shares) {
      if (!held.includes(s.source_budget_id)) return fail(400, `budget ${s.source_budget_id} is not held by project ${pid}`)
      if (s.share_type !== "percent" && s.share_type !== "amount") return fail(400, "share_type must be percent or amount")
      if (!(s.share_value > 0.0)) return fail(400, "share_value must be positive")
      if (s.share_type === "percent" && s.share_value > 100.0) return fail(400, "a percent share cannot be over 100")
    }
    const heldRates = projectRateLimitIds(pj)
    for (const s of rshares) {
      const src = s.source_rate_limit_id
      if (!heldRates.includes(src)) return fail(400, `rate limit ${src} is not held by project ${pid}`)
      const err = rateShareError(findById(g.rate_limits, src), s)
      if (err !== "") return fail(400, err)
    }
    const members: ProjectMember[] = []
    for (const m of pj.members ?? []) {
      members.push(m.id === mid ? { id: m.id, user_id: m.user_id, budget_shares: shares, rate_limit_shares: rshares } : m)
    }
    let np = pj
    np.members = members
    g.projects = putById(g.projects ?? [], np)
    return this.commit(withGov(this.cfg, g), pid)
  }

  // Saves a business unit whole. Its teams follow it: the listed teams join the unit, and teams it
  // stops listing leave it (the team's own business_unit_id is kept in step).
  upsertBusinessUnit(b: BusinessUnitConfig): Result {
    const err = businessUnitError(this.cfg, b)
    if (err !== "") return fail(400, err)
    const g = gov(this.cfg)
    const teams = b.team_ids ?? []
    const next: BusinessUnitConfig = { id: b.id, name: b.name, budget_id: b.budget_id, rate_limit_id: b.rate_limit_id, team_ids: teams, customer_ids: b.customer_ids }
    const out: TeamConfig[] = []
    for (const t of g.teams ?? []) {
      const nt: TeamConfig = { id: t.id, name: t.name, customer_id: t.customer_id, budget_id: t.budget_id, business_unit_id: t.business_unit_id }
      if (teams.includes(t.id)) nt.business_unit_id = b.id
      else if (t.business_unit_id === b.id) nt.business_unit_id = undefined
      out.push(nt)
    }
    g.teams = out
    g.business_units = putById(g.business_units ?? [], next)
    return this.commit(withGov(this.cfg, g), next.id)
  }

  deleteBusinessUnit(id: string): Result {
    const g = gov(this.cfg)
    if (findById(g.business_units, id) === undefined) return fail(404, `no business unit ${id}`)
    const out: TeamConfig[] = []
    for (const t of g.teams ?? []) {
      const nt: TeamConfig = { id: t.id, name: t.name, customer_id: t.customer_id, budget_id: t.budget_id, business_unit_id: t.business_unit_id }
      if (t.business_unit_id === id) nt.business_unit_id = undefined
      out.push(nt)
    }
    g.teams = out
    g.business_units = dropById(g.business_units ?? [], id)
    return this.commit(withGov(this.cfg, g), id)
  }

  // Saves a custom role. Built-in role names are refused; a role's users keep it when it changes, and so
  // does its id (a new role takes the next id; see rbac.tov withRoleIds).
  upsertRole(r: RoleConfig): Result {
    const err = roleError(r, false)
    if (err !== "") return fail(400, err)
    return this.saveRole(r)
  }

  // Saves a built-in role's edited description, dac and permissions (Bifrost lets a system role's permissions
  // be changed); it is kept under governance.roles by its name and keeps its fixed id.
  editSystemRole(r: RoleConfig): Result {
    if (!isBuiltinRole(r.name)) return fail(404, `no system role ${r.name}`)
    const err = roleError(r, true)
    if (err !== "") return fail(400, err)
    if (r.name === "admin") {
      const ps = r.permissions ?? []
      const view = ps.some((p) => p.resource === "RBAC" && p.operation === "View")
      const update = ps.some((p) => p.resource === "RBAC" && p.operation === "Update")
      if (!view || !update) return fail(400, "the admin role must keep RBAC View and Update, or no one could change roles again")
    }
    return this.saveRole(r)
  }

  private saveRole(r: RoleConfig): Result {
    const g = gov(this.cfg)
    const prior = customRole(g.roles, r.name)
    let keep: int | undefined = undefined
    if (prior !== undefined) keep = prior.id
    const next: RoleConfig = { id: keep, name: r.name, description: r.description, dac: r.dac ?? "all-data", permissions: r.permissions ?? [], entity_dac: r.entity_dac ?? [] }
    const out: RoleConfig[] = []
    let found = false
    for (const x of g.roles ?? []) {
      if (x.name === next.name) {
        out.push(next)
        found = true
      } else {
        out.push(x)
      }
    }
    if (!found) out.push(next)
    g.roles = withRoleIds(out)
    return this.commit(withGov(this.cfg, g), next.name)
  }

  // Removes a custom role, unless a user still holds it. Access profiles attached to it let go of it.
  deleteRole(name: string): Result {
    if (isBuiltinRole(name)) return fail(403, "cannot delete system role")
    const g = gov(this.cfg)
    if (customRole(g.roles, name) === undefined) return fail(404, `no role ${name}`)
    for (const u of g.users ?? []) {
      if (u.role === name) return fail(409, `role ${name} is used by user ${u.name}`)
    }
    const rid = roleIdOf(g.roles, name)
    const out: RoleConfig[] = []
    for (const x of g.roles ?? []) {
      if (x.name !== name) out.push(x)
    }
    g.roles = withRoleIds(out)
    if (rid !== undefined) {
      const profiles: AccessProfile[] = []
      for (const p of g.access_profiles ?? []) {
        let np = p
        if (np.roles !== undefined) np.roles = np.roles.filter((b) => b.role_id !== rid)
        profiles.push(np)
      }
      g.access_profiles = profiles
    }
    return this.commit(withGov(this.cfg, g), name)
  }

  // Attaches roles (built-in or custom, by id) to an access profile (Bifrost's attach): with apply_to_existing the
  // role's users now hold the profile, with is_default its later users do (govapi.tov attachBinding). A role
  // already attached takes the new settings, and its users who held the profile keep it. Returns how many users
  // were given the profile now, through users_applied.
  attachProfileRoles(profileId: string, roleIds: int[], isDefault: bool | undefined, apply: bool): Result {
    const g = gov(this.cfg)
    if (findById(g.access_profiles, profileId) === undefined) return fail(404, `no access profile ${profileId}`)
    for (const rid of roleIds) {
      if (anyRoleName(g.roles, rid) === undefined) return fail(400, `role_id ${rid} names no role`)
    }
    const profiles: AccessProfile[] = []
    for (const p of g.access_profiles ?? []) {
      let np = p
      if (p.id === profileId) {
        const kept: ProfileRole[] = []
        for (const b of np.roles ?? []) {
          if (!roleIds.includes(b.role_id)) kept.push(b)
        }
        for (const rid of roleIds) {
          const roleName = anyRoleName(g.roles, rid) ?? ""
          const holders = (g.users ?? []).filter((u) => u.role === roleName).map((u) => u.name)
          let prior: ProfileRole | undefined = undefined
          for (const b of np.roles ?? []) {
            if (b.role_id === rid) prior = b
          }
          kept.push(attachBinding(rid, isDefault, apply, holders, prior))
        }
        np.roles = kept
      }
      profiles.push(np)
    }
    g.access_profiles = profiles
    return this.commit(withGov(this.cfg, g), profileId)
  }

  // Detaches one custom role from an access profile.
  detachProfileRole(profileId: string, roleId: int): Result {
    const g = gov(this.cfg)
    const cur = findById(g.access_profiles, profileId)
    if (cur === undefined) return fail(404, `no access profile ${profileId}`)
    if (!(cur.roles ?? []).some((b) => b.role_id === roleId)) return fail(404, `role_id ${roleId} is not attached to ${profileId}`)
    const profiles: AccessProfile[] = []
    for (const p of g.access_profiles ?? []) {
      let np = p
      if (np.id === profileId) np.roles = (np.roles ?? []).filter((b) => b.role_id !== roleId)
      profiles.push(np)
    }
    g.access_profiles = profiles
    return this.commit(withGov(this.cfg, g), profileId)
  }

  // A model config for one model (or "*"), provider and scope. Inline budgets and rate limit replace
  // the ones it owns; an absent one stays as it was.
  upsertModelConfig(id: string, b: ModelConfigBody): Result {
    const model = b.model_name ?? ""
    if (model === "") return fail(400, "model_name is required")
    const scope = b.scope ?? "global"
    if (scope !== "global" && scope !== "virtual_key") return fail(400, `invalid scope ${scope}`)
    const sid = b.scope_id ?? ""
    const scopeId = scope === "virtual_key" ? sid : undefined
    if (scope === "virtual_key" && findById(gov(this.cfg).virtual_keys, sid) === undefined) return fail(400, `unknown virtual key ${sid}`)
    const prov = b.provider === "" ? undefined : b.provider
    let g = gov(this.cfg)
    const old = findById(g.model_configs, id)
    for (const x of g.model_configs ?? []) {
      if (x.id !== id && x.model_name === model && x.provider === prov && (x.scope ?? "global") === scope && x.scope_id === scopeId) {
        return fail(409, `model config ${x.id} already covers ${model}`)
      }
    }
    const inl = applyInline(&g, id, b.budgets, b.rate_limit)
    if (inl.err !== "") return fail(400, inl.err)
    const next: ModelConfigGovernance = {
      id: id,
      model_name: model,
      provider: prov,
      scope: scope,
      scope_id: scopeId,
      calendar_aligned: b.calendar_aligned ?? old?.calendar_aligned,
      budget_id: old?.budget_id,
      budget_ids: inl.budgetIds ?? old?.budget_ids,
      rate_limit_id: inl.rateSet ? inl.rateId : old?.rate_limit_id,
    }
    g.model_configs = putById(g.model_configs ?? [], next)
    return this.commit(withGov(this.cfg, g), id)
  }

  deleteModelConfig(id: string): Result {
    let g = gov(this.cfg)
    if (findById(g.model_configs, id) === undefined) return fail(404, `no model config ${id}`)
    g.model_configs = dropById(g.model_configs ?? [], id)
    const user = ownedInUse(this.cfg, g, id)
    if (user !== "") return fail(409, user)
    dropOwned(&g, id)
    return this.commit(withGov(this.cfg, g), id)
  }

  // Provider governance (Bifrost's PUT /api/governance/providers/{name}): one entry per provider.
  upsertProviderGov(name: string, description: string | undefined, budgets: BudgetBody[] | undefined, rate: RateBody | undefined): Result {
    if (providerOf(this.cfg, name) === undefined) return fail(404, `no provider ${name}`)
    let g = gov(this.cfg)
    const old = providerGovFor(g, name)
    const owner = "provider-" + name
    const inl = applyInline(&g, owner, budgets, rate)
    if (inl.err !== "") return fail(400, inl.err)
    const next: ProviderGovernance = {
      id: old?.id ?? owner,
      name: name,
      description: description ?? old?.description,
      budget_id: old?.budget_id,
      budget_ids: inl.budgetIds ?? old?.budget_ids,
      rate_limit_id: inl.rateSet ? inl.rateId : old?.rate_limit_id,
    }
    let list: ProviderGovernance[] = (g.providers ?? []).filter((x) => x.name !== name)
    list.push(next)
    g.providers = list
    return this.commit(withGov(this.cfg, g), name)
  }

  deleteProviderGov(name: string): Result {
    let g = gov(this.cfg)
    if (providerGovFor(g, name) === undefined) return fail(404, `no provider governance for ${name}`)
    g.providers = (g.providers ?? []).filter((x) => x.name !== name)
    const owner = "provider-" + name
    const user = ownedInUse(this.cfg, g, owner)
    if (user !== "") return fail(409, user)
    dropOwned(&g, owner)
    return this.commit(withGov(this.cfg, g), name)
  }

  // A pricing override, replacing the one with the same id or adding it.
  savePricingOverride(o: PricingOverrideConfig): Result {
    const err = pricingError(o)
    if (err !== "") return fail(400, err)
    const g = gov(this.cfg)
    const id = o.id ?? ""
    const list: PricingOverrideConfig[] = []
    let placed = false
    for (const x of g.pricing_overrides ?? []) {
      if (x.id === id) {
        list.push(o)
        placed = true
      } else {
        list.push(x)
      }
    }
    if (!placed) list.push(o)
    g.pricing_overrides = list
    return this.commit(withGov(this.cfg, g), id)
  }

  deletePricingOverride(id: string): Result {
    const g = gov(this.cfg)
    if (overrideById(g.pricing_overrides, id) === undefined) return fail(404, `no pricing override ${id}`)
    g.pricing_overrides = (g.pricing_overrides ?? []).filter((x) => x.id !== id)
    return this.commit(withGov(this.cfg, g), id)
  }

  // The whole config as JSON with secrets masked.
  redacted(): string {
    const text = JSON.stringify(redactConfig(this.cfg), undefined, 2)
    try {
      return maskJson(text, false)
    } catch (e) {
      return "{}"
    }
  }
}

// Field names whose string values are secrets, wherever they are in the config.
function secretKey(k: string): bool {
  const n = k.toLowerCase()
  if (n.endsWith("_url") || n.endsWith("_uri") || n.endsWith("_endpoint")) return n === "webhook_url"
  if (n === "key" || n === "value" || n === "webhook_url" || n === "dsn") return true
  for (const w of ["secret", "password", "token", "credential", "private_key", "api_key", "routing_key", "hmac", "authorization"]) {
    if (n.includes(w)) return true
  }
  return false
}

// Maps whose every value is secret (headers and environment variables).
function secretMap(k: string): bool {
  const n = k.toLowerCase()
  return n === "headers" || n === "env" || n.endsWith("_headers")
}

// Masks the secret string values of a JSON text (see secretKey and secretMap).
function maskJson(raw: string, all: bool): string throws SyntaxError {
  const t = raw.trim()
  if (t.startsWith("{")) {
    const out: string[] = []
    for (const f of try fields(t)) out.push(`${quote(f.key)}:${try maskJson(f.raw, all || secretMap(f.key) || (secretKey(f.key) && f.raw.trim().startsWith("\"")))}`)
    return "{" + out.join(",") + "}"
  }
  if (t.startsWith("[")) {
    const out: string[] = []
    for (const e of try elements(t)) out.push(try maskJson(e, all))
    return "[" + out.join(",") + "]"
  }
  if (all && t.startsWith("\"")) return quote(maskSecret(try decodeString(t)))
  return t
}

test("the config view masks secrets in every section", () => {
  const m = try maskJson(`{"mcp":{"client_configs":[{"name":"a","headers":{"X-Api":"sekret-value-1234"},"stdio_config":{"env":{"TOKEN":"abcdefghijkl"}}}]},"oidc":{"client_secret":"0123456789ab","issuer":"https://i"},"cluster":{"secret":"zzzzzzzzzzzz"},"vector_store":{"config":{"password":"pppppppppppp","addr":"r:6379"}},"governance":{"budgets":[{"max_limit":5}]},"alerts":{"channels":[{"url":"https://hooks.slack.com/services/X","routing_key":"rrrrrrrrrrrr","max_tokens":5}]},"mcp_auth":{"token_url":"https://t/token"},"k":{"value":"env.FOO"}}`, false)
  expect(m.includes("sekret-value-1234")).toBe(false)
  expect(m.includes("abcdefghijkl")).toBe(false)
  expect(m.includes("0123456789ab")).toBe(false)
  expect(m.includes("zzzzzzzzzzzz")).toBe(false)
  expect(m.includes("pppppppppppp")).toBe(false)
  expect(m.includes("rrrrrrrrrrrr")).toBe(false)
  expect(m.includes(`"addr":"r:6379"`)).toBe(true)
  expect(m.includes(`"issuer":"https://i"`)).toBe(true)
  expect(m.includes(`"max_limit":5`)).toBe(true)
  expect(m.includes(`"max_tokens":5`)).toBe(true)
  expect(m.includes(`"token_url":"https://t/token"`)).toBe(true)
  expect(m.includes(`"value":"env.FOO"`)).toBe(true)
})

// Compares two strings without stopping at the first difference.
function safeEq(a: string, b: string): bool {
  const x = new TextEncoder().encode(a)
  const y = new TextEncoder().encode(b)
  const n = x.length > y.length ? x.length : y.length
  let d = x.length === y.length ? 0 : 1
  for (let i = 0; i < n; i++) {
    const p = i < x.length ? int(x[i]!) : 0
    const q = i < y.length ? int(y[i]!) : 0
    d = d | (p ^ q)
  }
  return d === 0
}

// The decoded "user:password" of a Basic credential, or undefined if it is not base64 text.
function basicCreds(v: string): string | undefined {
  try {
    return new TextDecoder().decode(decode(v.trim()))
  } catch (e) {
    return undefined
  }
}

// Checks a request's credentials against the admin auth. With no auth
// configured every request passes. Once any field is set, a request needs a
// matching Bearer token or a matching Basic user and password; a partly
// configured auth fails closed.
export function checkAdmin(auth: AdminAuth | undefined, headers: Map<string, string>): bool {
  if (auth === undefined) return true
  const u = auth.username
  const p = auth.password
  const t = auth.token
  if (u === undefined && p === undefined && t === undefined) return true
  const h = headers.get("authorization") ?? ""
  if (h.startsWith("Bearer ") || h.startsWith("bearer ")) {
    if (t === undefined || t === "") return false
    return safeEq(h.slice(7), t)
  }
  if (h.startsWith("Basic ") || h.startsWith("basic ")) {
    if (u === undefined || p === undefined || u === "" || p === "") return false
    const creds = basicCreds(h.slice(6))
    if (creds === undefined) return false
    const i = creds.indexOf(":")
    if (i < 0) return false
    const okUser = safeEq(creds.slice(0, i), u)
    const okPass = safeEq(creds.slice(i + 1), p)
    return okUser && okPass
  }
  return false
}

function reply(status: int, body: string): ApiReply {
  return { status: status, body: body }
}

function errorBody(message: string): string {
  return JSON.stringify({ error: { message: message } })
}

function notFound(path: string): ApiReply {
  return reply(404, errorBody(`no route for ${path}`))
}

function notAllowed(method: string): ApiReply {
  return reply(405, errorBody(`method ${method} is not allowed on this route`))
}

function badBody(): ApiReply {
  return reply(400, errorBody("body must be a JSON object matching the resource"))
}

function serverError(): ApiReply {
  return reply(500, errorBody("the saved record could not be read back"))
}

function errReply(f: Failure): ApiReply {
  return reply(f.status, errorBody(f.message))
}

function storedReply<T extends HasId>(x: T | undefined, status: int): ApiReply {
  if (x === undefined) return serverError()
  return reply(status, JSON.stringify(x))
}

// The path id wins; otherwise the body's id, or a fresh one.
function resolveId(pathId: string | undefined, bodyId: string | undefined, prefix: string): string {
  if (pathId !== undefined) return pathId
  if (bodyId === undefined || bodyId === "") return randomId(prefix)
  return bodyId
}

function parseProvider(b: string): ProviderConfig | undefined {
  try {
    return JSON.parse(b) as ProviderConfig
  } catch (e) {
    return undefined
  }
}

function parseKey(b: string): KeyConfig | undefined {
  try {
    return JSON.parse(b) as KeyConfig
  } catch (e) {
    return undefined
  }
}

function parseVk(b: string): VkBody | undefined {
  try {
    return JSON.parse(b) as VkBody
  } catch (e) {
    return undefined
  }
}

function parseBudget(b: string): BudgetBody | undefined {
  try {
    return JSON.parse(b) as BudgetBody
  } catch (e) {
    return undefined
  }
}

function parseRate(b: string): RateBody | undefined {
  try {
    return JSON.parse(b) as RateBody
  } catch (e) {
    return undefined
  }
}

function parseTeam(b: string): NamedBody | undefined {
  try {
    return JSON.parse(b) as NamedBody
  } catch (e) {
    return undefined
  }
}

function parseCustomer(b: string): NamedBody | undefined {
  try {
    return JSON.parse(b) as NamedBody
  } catch (e) {
    return undefined
  }
}

function listBody(c: Config, coll: string, scope: DataScope): string {
  const g = gov(c)
  if (coll === "virtual-keys") return JSON.stringify({ virtual_keys: (g.virtual_keys ?? []).filter((vk) => recordInScope(c, coll, vk.id, scope)).map((vk) => redactVk(vk)) })
  if (coll === "budgets") return JSON.stringify({ budgets: g.budgets ?? [] })
  if (coll === "rate-limits") return JSON.stringify({ rate_limits: g.rate_limits ?? [] })
  if (coll === "teams") return JSON.stringify({ teams: (g.teams ?? []).filter((t) => recordInScope(c, coll, t.id, scope)) })
  return JSON.stringify({ customers: (g.customers ?? []).filter((cu) => recordInScope(c, coll, cu.id, scope)) })
}

// POST (pathId undefined) and PUT on the governance collections. Returns the
// stored record; a virtual key's full value is included only when this call
// created it.
function putGov(store: ConfigStore, coll: string, pathId: string | undefined, body: string): ApiReply {
  const g = gov(store.cfg)
  if (coll === "virtual-keys") {
    const b = parseVk(body)
    if (b === undefined) return badBody()
    const id = resolveId(pathId, b.id, "vk-")
    const created = findById(g.virtual_keys, id) === undefined
    const vk: VirtualKeyConfig = {
      id: id,
      name: b.name,
      value: b.value ?? "",
      description: b.description,
      is_active: b.is_active,
      team_id: b.team_id,
      customer_id: b.customer_id,
      user_id: b.user_id,
      budget_id: b.budget_id,
      rate_limit_id: b.rate_limit_id,
      provider_configs: b.provider_configs,
      key_ids: b.key_ids,
      expires_at: b.expires_at,
      disable_content_logging: b.disable_content_logging,
      mcp_configs: b.mcp_configs,
      agent_grants: b.agent_grants,
    }
    const r = store.upsertVirtualKey(vk)
    if (r.kind === "error") return errReply(r)
    const stored = findById(gov(store.cfg).virtual_keys, id)
    if (stored === undefined) return serverError()
    return reply(created ? 201 : 200, JSON.stringify(created ? stored : redactVk(stored)))
  }
  if (coll === "budgets") {
    const b = parseBudget(body)
    if (b === undefined) return badBody()
    const id = resolveId(pathId, b.id, "budget-")
    const created = findById(g.budgets, id) === undefined
    const r = store.upsertBudget({ id: id, max_limit: b.max_limit ?? 0.0, reset_duration: b.reset_duration ?? "", current_usage: b.current_usage })
    if (r.kind === "error") return errReply(r)
    return storedReply(findById(gov(store.cfg).budgets, id), created ? 201 : 200)
  }
  if (coll === "rate-limits") {
    const b = parseRate(body)
    if (b === undefined) return badBody()
    const id = resolveId(pathId, b.id, "rl-")
    const created = findById(g.rate_limits, id) === undefined
    const r = store.upsertRateLimit({
      id: id,
      token_max_limit: b.token_max_limit,
      token_reset_duration: b.token_reset_duration,
      request_max_limit: b.request_max_limit,
      request_reset_duration: b.request_reset_duration,
    })
    if (r.kind === "error") return errReply(r)
    return storedReply(findById(gov(store.cfg).rate_limits, id), created ? 201 : 200)
  }
  if (coll === "teams") {
    const b = parseTeam(body)
    if (b === undefined) return badBody()
    const id = resolveId(pathId, b.id, "team-")
    const created = findById(g.teams, id) === undefined
    const r = store.upsertTeam({ id: id, name: b.name ?? "", customer_id: b.customer_id, budget_id: b.budget_id, business_unit_id: b.business_unit_id })
    if (r.kind === "error") return errReply(r)
    return storedReply(findById(gov(store.cfg).teams, id), created ? 201 : 200)
  }
  const b = parseCustomer(body)
  if (b === undefined) return badBody()
  const id = resolveId(pathId, b.id, "customer-")
  const created = findById(g.customers, id) === undefined
  const r = store.upsertCustomer({ id: id, name: b.name ?? "", budget_id: b.budget_id })
  if (r.kind === "error") return errReply(r)
  return storedReply(findById(gov(store.cfg).customers, id), created ? 201 : 200)
}

// GET /api/governance/{collection}/{id}: one stored record (a key's value stays masked).
function getGov(c: Config, coll: string, id: string): ApiReply {
  const g = gov(c)
  if (coll === "virtual-keys") {
    const vk = findById(g.virtual_keys, id)
    return vk === undefined ? reply(404, errorBody(`no virtual key ${id}`)) : reply(200, JSON.stringify(redactVk(vk)))
  }
  if (coll === "budgets" || coll === "rate-limits") return notAllowed("GET")
  if (coll === "teams") return storedReply(findById(g.teams, id), 200)
  return storedReply(findById(g.customers, id), 200)
}

function deleteGov(store: ConfigStore, coll: string, id: string): ApiReply {
  let r: Result
  if (coll === "virtual-keys") r = store.deleteVirtualKey(id)
  else if (coll === "budgets") r = store.deleteBudget(id)
  else if (coll === "rate-limits") r = store.deleteRateLimit(id)
  else if (coll === "teams") r = store.deleteTeam(id)
  else r = store.deleteCustomer(id)
  if (r.kind === "error") return errReply(r)
  return reply(200, JSON.stringify({ deleted: id }))
}

// POST and PUT on /api/governance/model-configs. A PUT keeps what the body leaves out; scope is not editable.
function putModelConfig(store: ConfigStore, pathId: string | undefined, body: string): ApiReply {
  const b = parseModelConfig(body)
  if (b === undefined) return badBody()
  const id = resolveId(pathId, b.id, "mc-")
  const old = findById(gov(store.cfg).model_configs, id)
  if (pathId !== undefined && old === undefined) return reply(404, errorBody(`no model config ${id}`))
  const merged: ModelConfigBody = {
    id: id,
    model_name: b.model_name ?? old?.model_name,
    provider: b.provider ?? old?.provider,
    scope: old === undefined ? b.scope : old.scope,
    scope_id: old === undefined ? b.scope_id : old.scope_id,
    calendar_aligned: b.calendar_aligned,
    budgets: b.budgets,
    rate_limit: b.rate_limit,
  }
  const r = store.upsertModelConfig(id, merged)
  if (r.kind === "error") return errReply(r)
  const saved = findById(gov(store.cfg).model_configs, id)
  if (saved === undefined) return serverError()
  return reply(old === undefined ? 201 : 200, modelConfigView(store.cfg, saved))
}

function modelConfigRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string): ApiReply {
  if (segs.length === 3) {
    if (m === "GET") return reply(200, modelConfigList(store.cfg))
    if (m === "POST") return putModelConfig(store, undefined, body)
    return notAllowed(m)
  }
  if (segs.length > 4) return notFound(path)
  const id = segs[3] ?? ""
  if (m === "GET") {
    const mc = findById(gov(store.cfg).model_configs, id)
    if (mc === undefined) return reply(404, errorBody(`no model config ${id}`))
    return reply(200, modelConfigView(store.cfg, mc))
  }
  if (m === "PUT") return putModelConfig(store, id, body)
  if (m === "DELETE") {
    const r = store.deleteModelConfig(id)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: id }))
  }
  return notAllowed(m)
}

// /api/governance/providers: GET the list, PUT or DELETE one provider by name (Bifrost's routes).
function providerGovRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string): ApiReply {
  if (segs.length === 3) {
    if (m === "GET") return reply(200, providerGovList(store.cfg))
    return notAllowed(m)
  }
  if (segs.length > 4) return notFound(path)
  const name = segs[3] ?? ""
  if (m === "PUT") {
    const b = parseProviderGov(body)
    if (b === undefined) return badBody()
    if (b.budget !== undefined && b.budgets !== undefined) return reply(400, errorBody("only one of 'budget' or 'budgets' may be set"))
    let list: BudgetBody[] | undefined = b.budgets
    const one = b.budget
    if (one !== undefined) list = [one]
    const created = providerGovFor(gov(store.cfg), name) === undefined
    const r = store.upsertProviderGov(name, b.description, list, b.rate_limit)
    if (r.kind === "error") return errReply(r)
    const saved = providerGovFor(gov(store.cfg), name)
    if (saved === undefined) return serverError()
    return reply(created ? 201 : 200, providerGovView(store.cfg, saved))
  }
  if (m === "DELETE") {
    const r = store.deleteProviderGov(name)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: name }))
  }
  return notAllowed(m)
}

// POST and PUT on /api/governance/pricing-overrides. The patch is kept as the JSON text it came in.
function putPricing(store: ConfigStore, pathId: string | undefined, body: string): ApiReply {
  const b = parsePricing(body)
  const fs = parseFields(body)
  if (b === undefined || fs === undefined) return badBody()
  const old = overrideById(gov(store.cfg).pricing_overrides, pathId ?? "")
  if (pathId !== undefined && old === undefined) return reply(404, errorBody(`no pricing override ${pathId}`))
  const id = pathId ?? randomId("po-")
  const raw = find(fs, "patch")
  const next: PricingOverrideConfig = {
    id: id,
    name: b.name ?? old?.name,
    scope_kind: b.scope_kind ?? old?.scope_kind ?? "",
    provider_id: nullable(fs, "provider_id", b.provider_id, old?.provider_id),
    provider_key_id: nullable(fs, "provider_key_id", b.provider_key_id, old?.provider_key_id),
    virtual_key_id: nullable(fs, "virtual_key_id", b.virtual_key_id, old?.virtual_key_id),
    user_id: nullable(fs, "user_id", b.user_id, old?.user_id),
    request_types: b.request_types ?? old?.request_types,
    match_type: b.match_type ?? old?.match_type ?? "",
    pattern: b.pattern ?? old?.pattern ?? "",
    pricing_patch: raw ?? old?.pricing_patch ?? "{}",
  }
  const r = store.savePricingOverride(next)
  if (r.kind === "error") return errReply(r)
  const saved = overrideById(gov(store.cfg).pricing_overrides, id)
  if (saved === undefined) return serverError()
  return reply(pathId === undefined ? 201 : 200, pricingView(saved))
}

function pricingRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string): ApiReply {
  if (segs.length === 3) {
    if (m === "GET") return reply(200, pricingList(store.cfg))
    if (m === "POST") return putPricing(store, undefined, body)
    return notAllowed(m)
  }
  if (segs.length > 4) return notFound(path)
  const id = segs[3] ?? ""
  if (m === "PUT") return putPricing(store, id, body)
  if (m === "DELETE") {
    const r = store.deletePricingOverride(id)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: id }))
  }
  return notAllowed(m)
}

// GET /api/governance/teams/{team}/members: the users whose teams list names the team, in Bifrost's
// {members} shape. Users here have a name and no email, so the name stands for both id and name.
function teamMembers(store: ConfigStore, m: string, team: string, scope: DataScope): ApiReply {
  if (m !== "GET") return notAllowed(m)
  const g = gov(store.cfg)
  if (!recordInScope(store.cfg, "teams", team, scope) || findById(g.teams, team) === undefined) return reply(404, errorBody(`no teams ${team}`))
  const out: { user_id: string, user_name: string, user_email: string, source: string }[] = []
  for (const u of g.users ?? []) {
    if ((u.teams ?? []).includes(team)) out.push({ user_id: u.name, user_name: u.name, user_email: emailOf(u), source: membershipSource(u, "teams", team) })
  }
  return reply(200, JSON.stringify({ members: out }))
}

// The grace period for a rotated key's old value, from client.vk_rotation_cooldown (0 when unset).
function rotationCooldownMs(c: Config): number {
  const s = c.client?.vk_rotation_cooldown ?? ""
  if (s === "") return 0.0
  const ms: number = durationMs(s)
  return ms
}

// POST /api/governance/virtual-keys/rotate ({"ids": [...]}) and POST .../{id}/rotate. The reply
// carries the new value, as Bifrost's does; it is the only time the caller sees it in full.
function rotateVkRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string, scope: DataScope): ApiReply {
  if (m !== "POST") return notAllowed(m)
  const cooldown = rotationCooldownMs(store.cfg)
  if (segs.length === 5) {
    const id = segs[3] ?? ""
    if (!recordInScope(store.cfg, "virtual-keys", id, scope)) return reply(404, errorBody(`no virtual-keys ${id}`))
    const r = store.rotateVirtualKey(id, cooldown)
    if (r.kind === "error") return errReply(r)
    const stored = findById(gov(store.cfg).virtual_keys, id)
    if (stored === undefined) return serverError()
    return reply(200, JSON.stringify({ message: "Virtual key rotated successfully", virtual_key: stored }))
  }
  if (segs.length !== 4) return notFound(path)
  let fs: Field[] = []
  try {
    fs = fields(body)
  } catch (e) {
    return badBody()
  }
  const raw = find(fs, "ids") ?? ""
  const ids: string[] = []
  try {
    for (const el of elements(raw)) {
      const id = decodeString(el).trim()
      if (id === "") return reply(400, errorBody("Virtual key ID cannot be empty"))
      if (!ids.includes(id)) ids.push(id)
    }
  } catch (e) {
    return reply(400, errorBody("ids must be a list of virtual key IDs"))
  }
  if (ids.length === 0) return reply(400, errorBody("At least one virtual key ID is required"))
  const done: VirtualKeyConfig[] = []
  const failures: Map<string, string> = new Map()
  for (const id of ids) {
    if (!recordInScope(store.cfg, "virtual-keys", id, scope)) {
      failures.set(id, "virtual key not found")
      continue
    }
    const r = store.rotateVirtualKey(id, cooldown)
    if (r.kind === "error") {
      failures.set(id, r.message)
      continue
    }
    const stored = findById(gov(store.cfg).virtual_keys, id)
    if (stored !== undefined) done.push(stored)
  }
  if (done.length === 0) return reply(500, JSON.stringify({ message: "Failed to rotate virtual keys", virtual_keys: done, errors: failures }))
  const out: { message: string, virtual_keys: VirtualKeyConfig[], errors?: Map<string, string> } = { message: "Virtual keys rotated successfully", virtual_keys: done }
  if (failures.size > 0) out.errors = failures
  return reply(200, JSON.stringify(out))
}

// The ids of the keys a rotate reply names (virtual_key, or each of virtual_keys): the caller revokes their MCP
// OAuth grants (mcpissuer.tov revokeSubject), as Bifrost does in the rotation's transaction.
export function rotatedKeyIds(replyBody: string): string[] {
  const out: string[] = []
  try {
    const r = JSON.parse(replyBody) as { virtual_key?: { id: string }, virtual_keys?: { id: string }[] }
    const one = r.virtual_key
    if (one !== undefined) out.push(one.id)
    for (const k of r.virtual_keys ?? []) out.push(k.id)
  } catch (e) {
    return out
  }
  return out
}

// Whether a path is a virtual-key rotate route (the collection or one key).
export function isRotatePath(path: string): bool {
  const segs = path.split("?")[0]!.split("/").filter((x) => x !== "")
  if (segs[0] !== "api" || segs[1] !== "governance" || segs[2] !== "virtual-keys") return false
  return segs.length === 4 && segs[3] === "rotate" || segs.length === 5 && segs[4] === "rotate"
}

function governanceRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string, sp: URLSearchParams, scope: DataScope): ApiReply {
  const coll = segs[2] ?? ""
  if (coll === "virtual-keys" && (segs.length === 4 && segs[3] === "rotate" || segs.length === 5 && segs[4] === "rotate")) {
    return rotateVkRoute(store, m, segs, body, path, scope)
  }
  // the quota view is served before the admin gate (server.tov); here only its method is judged
  if (coll === "virtual-keys" && segs.length === 4 && segs[3] === "quota") return notAllowed(m)
  if (coll === "virtual-keys" && segs.length === 5 && segs[4] === "users") return vkUsers(store, m, segs[3] ?? "", scope)
  if (coll === "virtual-keys" && segs.length === 7 && segs[4] === "budgets" && segs[6] === "override") {
    return budgetOverrideRoute(store, m, segs[3] ?? "", segs[5] ?? "", body, scope)
  }
  if (coll === "routing-rules") return routingRulesRoute(store, m, segs, body, path, scope)
  if (coll === "complexity-analyzer-config") return complexityRoute(store, m, segs, body, path, scope)
  // Bifrost's RBAC routes: /api/governance/rbac/roles is /api/roles, the rest are the catalogue
  if (coll === "rbac") {
    const sub = segs[3] ?? ""
    if (sub === "roles") return roleRoute(store, m, ["api", "roles"].concat(segs.slice(4)), body, path, scope, true)
    if (sub === "resources" || sub === "operations" || sub === "permissions") return segs.length === 4 ? rbacListing(sub, m) : notFound(path)
    return notFound(path)
  }
  if (coll === "model-configs") return modelConfigRoute(store, m, segs, body, path)
  if (coll === "providers") return providerGovRoute(store, m, segs, body, path)
  if (coll === "pricing-overrides") return pricingRoute(store, m, segs, body, path)
  if (coll === "projects") return projectRoute(store, m, segs, body, path, sp, scope)
  if (coll === "business-units") return businessUnitRoute(store, m, segs, body, path, sp, scope)
  if (coll === "teams" && segs.length === 5 && segs[4] === "members") return teamMembers(store, m, segs[3] ?? "", scope)
  if (!COLLECTIONS.includes(coll) || segs.length > 4) return notFound(path)
  // a scoped user reaches the teams, customers and keys in its scope; budgets and rate limits are all-data
  if (!scope.all && !SCOPED_COLLECTIONS.includes(coll)) return reply(403, errorBody(`the data access scope of this role does not cover ${coll}`))
  if (segs.length === 3) {
    if (m === "GET") return reply(200, listBody(store.cfg, coll, scope))
    if (m === "POST") return scope.all ? putGov(store, coll, undefined, body) : scopeDenied()
    return notAllowed(m)
  }
  const id = segs[3] ?? ""
  if (!recordInScope(store.cfg, coll, id, scope)) return reply(404, errorBody(`no ${coll} ${id}`))
  if (m === "PUT") return putGov(store, coll, id, body)
  if (m === "DELETE") return deleteGov(store, coll, id)
  if (m === "GET") return getGov(store.cfg, coll, id)
  return notAllowed(m)
}

// ---- projects, business units and custom roles ----

// The error for a project, or "". The rules are checked against the config as it is now.
function projectError(c: Config, p: ProjectConfig): string {
  const g = gov(c)
  if (p.name === "") return "project name is required"
  for (const o of g.projects ?? []) {
    if (o.id !== p.id && o.name === p.name) return `project name ${p.name} is already used`
  }
  const rule = p.access_rule ?? "union"
  if (rule !== "union" && rule !== "intersect") return "access_rule must be union or intersect"
  const acc = p.accounting_mode ?? "both"
  if (acc !== "both" && acc !== "project_only" && acc !== "principal_only") return "accounting_mode must be both, project_only or principal_only"
  const mode = p.membership_mode ?? "explicit"
  if (mode !== "explicit" && mode !== "open") return "membership_mode must be explicit or open"
  const split = p.split_policy ?? "none"
  if (split !== "none" && split !== "equal") return "split_policy must be none or equal"
  const b = p.budget_id
  if (b !== undefined && findById(g.budgets, b) === undefined) return `unknown budget ${b}`
  const r = p.rate_limit_id
  if (r !== undefined && findById(g.rate_limits, r) === undefined) return `unknown rate limit ${r}`
  const seen: string[] = []
  for (const pc of p.provider_configs ?? []) {
    if (pc.provider === "") return "each provider config needs a provider"
    if (seen.includes(pc.provider)) return `provider ${pc.provider} is listed twice`
    seen.push(pc.provider)
    const pb = pc.budget_id
    if (pb !== undefined && findById(g.budgets, pb) === undefined) return `unknown budget ${pb}`
    const pr = pc.rate_limit_id
    if (pr !== undefined && findById(g.rate_limits, pr) === undefined) return `unknown rate limit ${pr}`
  }
  for (const vk of p.virtual_key_ids ?? []) {
    if (findById(g.virtual_keys, vk) === undefined) return `unknown virtual key ${vk}`
  }
  return ""
}

// The error for a business unit, or "".
function businessUnitError(c: Config, b: BusinessUnitConfig): string {
  const g = gov(c)
  if (b.name === "") return "business unit name is required"
  const bud = b.budget_id
  if (bud !== undefined && findById(g.budgets, bud) === undefined) return `unknown budget ${bud}`
  const rl = b.rate_limit_id
  if (rl !== undefined && findById(g.rate_limits, rl) === undefined) return `unknown rate limit ${rl}`
  for (const t of b.team_ids ?? []) {
    if (findById(g.teams, t) === undefined) return `unknown team ${t}`
  }
  for (const cu of b.customer_ids ?? []) {
    if (findById(g.customers, cu) === undefined) return `unknown customer ${cu}`
  }
  return ""
}

// The error for a custom role, or "". Built-in names are reserved.
function roleError(r: RoleConfig, system: bool): string {
  if (r.name === "") return "role name is required"
  if (isNumeric(r.name)) return "role name cannot be a number, which is how its id is written"
  if (isBuiltinRole(r.name) && !system) return `${r.name} is a built-in role; change it by its id`
  const dac = r.dac ?? "all-data"
  if (!DACS.includes(dac)) return `dac must be one of ${DACS.join(", ")}`
  for (const p of r.permissions ?? []) {
    if (!RESOURCES.includes(p.resource)) return `unknown resource ${p.resource}`
    if (!OPERATIONS.includes(p.operation)) return `unknown operation ${p.operation}`
  }
  for (const e of r.entity_dac ?? []) {
    if (!RESOURCES.includes(e.resource)) return `unknown resource ${e.resource} in entity_dac`
    if (!DACS.includes(e.dac)) return `entity_dac ${e.resource} must be one of ${DACS.join(", ")}`
  }
  return ""
}

// Whether a record of a scoped collection is in the user's scope (see scope.tov).
function recordInScope(c: Config, coll: string, id: string, scope: DataScope): bool {
  if (scope.all) return true
  if (coll === "teams") return inScope(scope, id, "", "", "")
  if (coll === "customers") return inScope(scope, "", "", id, "")
  if (coll === "business-units") return inScope(scope, "", id, "", "")
  if (coll === "projects") return inScope(scope, "", "", "", id)
  if (coll === "virtual-keys") {
    const vk = findById(gov(c).virtual_keys, id)
    return vk !== undefined && inScope(scope, vk.team_id ?? "", "", vk.customer_id ?? "", "")
  }
  return false
}

function scopeDenied(): ApiReply {
  return reply(403, errorBody("the data access scope of this role does not allow this change"))
}

// One page of a list: limit (default 25, at most 100), offset or page (counted from 1).
function pageOf<T>(xs: T[], sp: URLSearchParams): { items: T[], limit: int, offset: int, total: int } {
  let limit: int = parseInt(sp.get("limit") ?? "25") ?? 25
  if (limit < 1) limit = 25
  if (limit > 100) limit = 100
  let offset: int = parseInt(sp.get("offset") ?? "0") ?? 0
  const page: int = parseInt(sp.get("page") ?? "0") ?? 0
  if (offset === 0 && page > 1) offset = (page - 1) * limit
  if (offset < 0) offset = 0
  return { items: xs.slice(offset, offset + limit), limit: limit, offset: offset, total: xs.length }
}

function projectFrom(id: string, b: ProjectBody): ProjectConfig {
  return {
    id: id,
    name: b.name ?? "",
    description: b.description,
    is_active: b.is_active,
    access_rule: b.access_rule,
    accounting_mode: b.accounting_mode,
    membership_mode: b.membership_mode,
    virtual_key_ids: b.virtual_key_ids,
    budget_id: b.budget_id,
    rate_limit_id: b.rate_limit_id,
    provider_configs: b.provider_configs,
    split_policy: b.split_policy,
    agent_grants: b.agent_grants,
  }
}

function parseProjectBody(b: string): ProjectBody | undefined {
  try {
    return JSON.parse(b) as ProjectBody
  } catch (e) {
    return undefined
  }
}

function parseBusinessUnitBody(b: string): BusinessUnitBody | undefined {
  try {
    return JSON.parse(b) as BusinessUnitBody
  } catch (e) {
    return undefined
  }
}

function parseRoleBody(b: string): RoleBody | undefined {
  try {
    return JSON.parse(b) as RoleBody
  } catch (e) {
    return undefined
  }
}

// GET /api/governance/projects: search by name or description, is_active, and the scope.
function projectsView(c: Config, sp: URLSearchParams, scope: DataScope): string {
  const q = (sp.get("search") ?? "").toLowerCase()
  const active = sp.get("is_active") ?? ""
  const all: ProjectConfig[] = []
  for (const p of gov(c).projects ?? []) {
    if (!recordInScope(c, "projects", p.id, scope)) continue
    if (q !== "" && !p.name.toLowerCase().includes(q) && !(p.description ?? "").toLowerCase().includes(q)) continue
    if (active === "true" && p.is_active === false) continue
    if (active === "false" && p.is_active !== false) continue
    all.push(p)
  }
  const pg = pageOf(all, sp)
  return JSON.stringify({ projects: pg.items, pagination: { limit: pg.limit, offset: pg.offset, total_count: pg.total } })
}

// /api/governance/projects[/{id}]: Bifrost's shapes. Creating needs all-data; a scoped user may
// change the projects in its scope.
function projectRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string, sp: URLSearchParams, scope: DataScope): ApiReply {
  if (segs.length > 6) return notFound(path)
  const id = segs[3]
  if (id === undefined) {
    if (m === "GET") return reply(200, projectsView(store.cfg, sp, scope))
    if (m !== "POST") return notAllowed(m)
    if (!scope.all) return scopeDenied()
    const b = parseProjectBody(body)
    if (b === undefined) return badBody()
    const pid = resolveId(undefined, b.id, "project-")
    const r = store.upsertProject(projectFrom(pid, b))
    if (r.kind === "error") return errReply(r)
    return reply(201, JSON.stringify({ project: findById(gov(store.cfg).projects, pid) }))
  }
  const cur = findById(gov(store.cfg).projects, id)
  if (cur === undefined || !recordInScope(store.cfg, "projects", id, scope)) return reply(404, errorBody(`no project ${id}`))
  if (segs.length >= 5) return projectMembersRoute(store, m, id, segs, body, path, scope)
  if (m === "GET") return reply(200, JSON.stringify({ project: cur }))
  if (m === "PUT") {
    const b = parseProjectBody(body)
    if (b === undefined) return badBody()
    const r = store.upsertProject(projectFrom(id, b))
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ project: findById(gov(store.cfg).projects, id) }))
  }
  if (m === "DELETE") {
    const r = store.deleteProject(id)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: id }))
  }
  return notAllowed(m)
}

// The budgets a project holds: its own and each provider config's.
function projectBudgetIds(pj: ProjectConfig): string[] {
  const out: string[] = []
  if (pj.budget_id !== undefined) out.push(pj.budget_id)
  for (const pc of pj.provider_configs ?? []) {
    const b = pc.budget_id
    if (b !== undefined && !out.includes(b)) out.push(b)
  }
  return out
}

// The rate limits a project holds: its own and each provider config's.
function projectRateLimitIds(pj: ProjectConfig): string[] {
  const out: string[] = []
  if (pj.rate_limit_id !== undefined) out.push(pj.rate_limit_id)
  for (const pc of pj.provider_configs ?? []) {
    const r = pc.rate_limit_id
    if (r !== undefined && !out.includes(r)) out.push(r)
  }
  return out
}

// Why a member's rate limit share cannot be stored, or "": it names a count the limit caps, its type is
// percent or amount, and a percent share comes to at least one whole count.
function rateShareError(rl: RateLimitConfig | undefined, s: RateLimitShare): string {
  if (rl === undefined) return `unknown rate limit ${s.source_rate_limit_id}`
  if (s.token_share === undefined && s.request_share === undefined) return "a rate limit share needs a token_share or a request_share"
  const t = countShareError("token", rl.token_max_limit, s.token_share, s.token_share_type)
  if (t !== "") return t
  return countShareError("request", rl.request_max_limit, s.request_share, s.request_share_type)
}

function countShareError(kind: string, max: int | undefined, v: int | undefined, t: string | undefined): string {
  if (v === undefined) return ""
  if (max === undefined) return `the rate limit does not cap ${kind}s`
  const type: string = t ?? "amount"
  if (type !== "percent" && type !== "amount") return "share type must be percent or amount"
  if (!(v > 0)) return `${kind}_share must be positive`
  if (type === "percent") {
    if (v > 100) return "a percent share cannot be over 100"
    if (Math.floor(max * v / 100) < 1) return `a ${kind} percent share comes to no whole ${kind}`
  }
  return ""
}

// Under split equal every member gets a whole part of each count of each rate limit the project holds, so
// a limit with fewer counts than the roster is refused rather than stored (Bifrost's rule). "" when it fits.
function equalRateError(c: GovernanceConfig, pj: ProjectConfig, members: int): string {
  if (pj.split_policy !== "equal" || members === 0) return ""
  for (const id of projectRateLimitIds(pj)) {
    const rl = findById(c.rate_limits, id)
    if (rl === undefined) continue
    if (rl.token_max_limit !== undefined && rl.token_max_limit < members) return `rate limit ${id} has ${rl.token_max_limit} tokens, too few for ${members} members under an equal split`
    if (rl.request_max_limit !== undefined && rl.request_max_limit < members) return `rate limit ${id} has ${rl.request_max_limit} requests, too few for ${members} members under an equal split`
  }
  return ""
}

// /api/governance/projects/{id}/members[/{member_id}]: the roster and, under split_policy none, a member's
// own caps. Changing the roster or the caps needs all-data.
function projectMembersRoute(store: ConfigStore, m: string, pid: string, segs: string[], body: string, path: string, scope: DataScope): ApiReply {
  if (segs.length > 6 || segs[4] !== "members") return notFound(path)
  const pj = findById(gov(store.cfg).projects, pid)
  if (pj === undefined) return reply(404, errorBody(`no project ${pid}`))
  const mid = segs[5]
  if (mid === undefined) {
    if (m === "GET") return reply(200, JSON.stringify({ members: pj.members ?? [], total_count: (pj.members ?? []).length }))
    if (m !== "POST") return notAllowed(m)
    if (!scope.all) return scopeDenied()
    let b: MemberBody = {}
    try {
      b = JSON.parse(body) as MemberBody
    } catch (e) {
      return badBody()
    }
    const users: string[] = []
    for (const x of b.members ?? []) {
      const u = x.user_id ?? ""
      if (u === "") return reply(400, errorBody("each member needs a user_id"))
      users.push(u)
    }
    const r = store.addProjectMembers(pid, users)
    if (r.kind === "error") return errReply(r)
    const after = findById(gov(store.cfg).projects, pid)
    const roster: ProjectMember[] = after === undefined ? [] : after.members ?? []
    return reply(201, JSON.stringify({ members: roster }))
  }
  if (m === "GET") {
    const one = findById(pj.members, mid)
    if (one === undefined) return reply(404, errorBody(`no member ${mid}`))
    return reply(200, JSON.stringify({ member: one }))
  }
  if (!scope.all) return scopeDenied()
  if (m === "PUT") {
    let c: MemberCapsBody = {}
    if (body.trim() !== "") {
      try {
        c = JSON.parse(body) as MemberCapsBody
      } catch (e) {
        return badBody()
      }
    }
    const r = store.setMemberShares(pid, mid, c.budget_shares ?? [], c.rate_limit_shares ?? [])
    if (r.kind === "error") return errReply(r)
    const after = findById(gov(store.cfg).projects, pid)
    const kept: ProjectMember | undefined = after === undefined ? undefined : findById(after.members, mid)
    return reply(200, JSON.stringify({ member: kept }))
  }
  if (m === "DELETE") {
    const r = store.removeProjectMember(pid, mid)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: mid }))
  }
  return notAllowed(m)
}

// GET /api/governance/business-units: the same paging as Bifrost, with count and total_count.
function businessUnitsView(c: Config, sp: URLSearchParams, scope: DataScope): string {
  const q = (sp.get("search") ?? "").toLowerCase()
  const all: BusinessUnitConfig[] = []
  for (const b of gov(c).business_units ?? []) {
    if (!recordInScope(c, "business-units", b.id, scope)) continue
    if (q !== "" && !b.name.toLowerCase().includes(q)) continue
    all.push(b)
  }
  const pg = pageOf(all, sp)
  return JSON.stringify({ business_units: pg.items, count: pg.items.length, total_count: pg.total, limit: pg.limit, offset: pg.offset })
}

// /api/governance/business-units[/{id}]
function businessUnitRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string, sp: URLSearchParams, scope: DataScope): ApiReply {
  if ((segs.length === 5 || segs.length === 6) && segs[4] === "users") return businessUnitUsers(store, m, segs[3] ?? "", segs[5], body, scope)
  if (segs.length > 4) return notFound(path)
  const id = segs[3]
  if (id === undefined) {
    if (m === "GET") return reply(200, businessUnitsView(store.cfg, sp, scope))
    if (m !== "POST") return notAllowed(m)
    if (!scope.all) return scopeDenied()
    const b = parseBusinessUnitBody(body)
    if (b === undefined) return badBody()
    const bid = resolveId(undefined, b.id, "bu-")
    const r = store.upsertBusinessUnit(businessUnitFrom(bid, b))
    if (r.kind === "error") return errReply(r)
    return reply(201, JSON.stringify(findById(gov(store.cfg).business_units, bid)))
  }
  const cur = findById(gov(store.cfg).business_units, id)
  if (cur === undefined || !recordInScope(store.cfg, "business-units", id, scope)) return reply(404, errorBody(`no business unit ${id}`))
  if (m === "GET") return reply(200, JSON.stringify(cur))
  if (m === "PUT") {
    const b = parseBusinessUnitBody(body)
    if (b === undefined) return badBody()
    const r = store.upsertBusinessUnit(businessUnitFrom(id, b))
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify(findById(gov(store.cfg).business_units, id)))
  }
  if (m === "DELETE") {
    const r = store.deleteBusinessUnit(id)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: id }))
  }
  return notAllowed(m)
}

// The members of a business unit with how each was granted (Bifrost's member list): source "manual" for an admin's
// assignment, "synced" for one the identity provider gave (a mapping rule).
function businessUnitMembers(store: ConfigStore, bu: string): string {
  const out: { user_id: string, user_name: string, user_email: string, source: string }[] = []
  for (const u of gov(store.cfg).users ?? []) {
    if ((u.business_units ?? []).includes(bu)) out.push({ user_id: u.name, user_name: u.name, user_email: emailOf(u), source: membershipSource(u, "business_units", bu) })
  }
  return JSON.stringify({ users: out, total: out.length })
}

// GET and POST /api/governance/business-units/{id}/users, DELETE .../users/{user_id}: the members, adding users
// ({"user_ids": [...]} or {"user_id": ...}, by name or email; an admin's assignment) and removing one. A membership
// the identity provider gave is removed by the identity provider (the next sync), so its DELETE is refused.
function businessUnitUsers(store: ConfigStore, m: string, bu: string, member: string | undefined, body: string, scope: DataScope): ApiReply {
  const g = gov(store.cfg)
  if (findById(g.business_units, bu) === undefined || !recordInScope(store.cfg, "business-units", bu, scope)) return reply(404, errorBody(`no business unit ${bu}`))
  if (member === undefined && m === "GET") return reply(200, businessUnitMembers(store, bu))
  if (m !== "GET" && !scope.all) return scopeDenied()
  const users: AdminUserConfig[] = g.users ?? []
  const at = (key: string): int => {
    const k = key.toLowerCase()
    for (let i = 0; i < users.length; i++) {
      const u = users[i]!
      if (u.name === key || u.name.toLowerCase() === k || emailOf(u).toLowerCase() === k) return i
    }
    return -1
  }
  if (member === undefined && m === "POST") {
    let ids: string[] = []
    try {
      const b = JSON.parse(body) as { user_ids?: string[], user_id?: string }
      ids = b.user_ids ?? []
      const one = b.user_id
      if (one !== undefined) ids.push(one)
    } catch (e) {
      return badBody()
    }
    if (ids.length === 0) return reply(400, errorBody("user_ids is required"))
    let next = users.slice()
    for (const id of ids) {
      const i = at(id)
      if (i < 0) return reply(400, errorBody(`no user ${id}`))
      let u = next[i]!
      const held: string[] = u.business_units ?? []
      if (!held.includes(bu)) held.push(bu)
      u.business_units = held
      next[i] = u
    }
    const r = store.setUsers(next)
    if (r.kind === "error") return errReply(r)
    return reply(200, businessUnitMembers(store, bu))
  }
  if (member !== undefined && m === "DELETE") {
    const i = at(member)
    if (i < 0 || !(users[i]!.business_units ?? []).includes(bu)) return reply(404, errorBody(`user ${member} is not a member of ${bu}`))
    if (membershipSource(users[i]!, "business_units", bu) === "synced") return reply(409, errorBody(`the identity provider manages ${member}'s membership of ${bu}; change the mapping rules or the user's attributes instead`))
    let next = users.slice()
    let u = next[i]!
    u.business_units = (u.business_units ?? []).filter((x) => x !== bu)
    next[i] = u
    const r = store.setUsers(next)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: member }))
  }
  return notAllowed(m)
}

function businessUnitFrom(id: string, b: BusinessUnitBody): BusinessUnitConfig {
  return { id: id, name: b.name ?? "", budget_id: b.budget_id, rate_limit_id: b.rate_limit_id, team_ids: b.team_ids, customer_ids: b.customer_ids }
}

// /api/roles[/{name}]: custom roles, as Bifrost's role routes name them. A numeric segment names the role by
// its id (Bifrost's /api/governance/rbac/roles/{role_id}), answered in Bifrost's shape; a name keeps the shape
// Raiju has always answered. Bifrost's list (system set, the /api/governance/rbac/roles path) puts the built-in
// roles first, with their fixed ids and is_system_role; /api/roles lists the custom roles only.
function roleRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string, scope: DataScope, system: bool): ApiReply {
  if (segs.length > 4 || segs.length === 4 && segs[3] !== "permissions") return notFound(path)
  if (!scope.all && m !== "GET") return scopeDenied()
  const name = segs[2]
  if (name !== undefined && isNumeric(name)) return roleByIdRoute(store, m, parseInt(name) ?? 0, segs, body)
  if (name !== undefined && isBuiltinRole(name)) return systemRoleRoute(store, m, name, segs, body, false)
  if (segs.length === 4 && name !== undefined) return rolePermissions(store, m, name, body)
  if (name === undefined) {
    if (m === "GET") {
      const parts: string[] = []
      if (system) {
        for (const r of builtinRoles(RESOURCES, OPERATIONS)) {
          const cur = systemRole(gov(store.cfg).roles, r.name, RESOURCES, OPERATIONS)
          if (cur !== undefined) parts.push(roleJsonAs(cur, true))
        }
      }
      for (const r of customRoles(gov(store.cfg).roles)) parts.push(roleJson(r))
      return reply(200, `{"roles":[${parts.join(",")}]}`)
    }
    if (m !== "POST") return notAllowed(m)
    const b = parseRoleBody(body)
    if (b === undefined) return badBody()
    const ed = entityDacFrom(body)
    if (ed.error !== "") return reply(400, errorBody(ed.error))
    const r = store.upsertRole(roleFrom(b.name ?? "", b, ed.list))
    if (r.kind === "error") return errReply(r)
    const made = roleView(store, b.name ?? "")
    if (made === undefined) return serverError()
    return reply(201, roleJson(made))
  }
  const cur = roleView(store, name)
  if (cur === undefined) return reply(404, errorBody(`no role ${name}`))
  if (m === "GET") return reply(200, roleJson(cur))
  if (m === "PUT") {
    const b = parseRoleBody(body)
    if (b === undefined) return badBody()
    const ed = entityDacFrom(body)
    if (ed.error !== "") return reply(400, errorBody(ed.error))
    const r = store.upsertRole(roleFrom(name, b, ed.list))
    if (r.kind === "error") return errReply(r)
    const saved = roleView(store, name)
    if (saved === undefined) return serverError()
    return reply(200, roleJson(saved))
  }
  if (m === "DELETE") {
    const r = store.deleteRole(name)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: name }))
  }
  return notAllowed(m)
}

// The custom role with this name, with its id.
function roleView(store: ConfigStore, name: string): RoleConfig | undefined {
  return customRole(withRoleIds(gov(store.cfg).roles ?? []), name)
}

// /api/governance/rbac/roles/{role_id}: GET, PUT and DELETE in Bifrost's shape ({"role": ...}). PUT is a
// partial update: a field left out keeps its value, and a description of "" clears it. A role cannot be
// renamed, since its users and access profiles are kept by its id.
function roleByIdRoute(store: ConfigStore, m: string, id: int, segs: string[], body: string): ApiReply {
  const sys = builtinRoleName(id)
  if (sys !== undefined) return systemRoleRoute(store, m, sys, segs, body, true)
  const name = roleNameById(gov(store.cfg).roles, id)
  if (name === undefined) return reply(404, errorBody(`no role ${id}`))
  if (segs.length === 4) return rolePermissions(store, m, name, body)
  const cur = roleView(store, name)
  if (cur === undefined) return reply(404, errorBody(`no role ${id}`))
  if (m === "GET") return reply(200, `{"role":${roleJson(cur)}}`)
  if (m === "PUT") {
    const b = parseRoleBody(body)
    if (b === undefined) return badBody()
    if (b.name !== undefined && b.name !== name) return reply(400, errorBody("a role cannot be renamed; its id and its users keep it"))
    const ed = entityDacFrom(body)
    if (ed.error !== "") return reply(400, errorBody(ed.error))
    let description: string | undefined = cur.description
    if (b.description !== undefined) description = b.description === "" ? undefined : b.description
    // entity_dac is kept when the body leaves it out
    let present = false
    try {
      present = find(fields(body), "entity_dac") !== undefined
    } catch (e) {
      present = false
    }
    const next: RoleConfig = { name: name, description: description, dac: b.dac ?? cur.dac, permissions: b.permissions ?? cur.permissions, entity_dac: present ? ed.list : cur.entity_dac }
    const r = store.upsertRole(next)
    if (r.kind === "error") return errReply(r)
    const saved = roleView(store, name)
    if (saved === undefined) return serverError()
    return reply(200, `{"role":${roleJson(saved)}}`)
  }
  if (m === "DELETE") {
    const r = store.deleteRole(name)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ message: "role deleted" }))
  }
  return notAllowed(m)
}

// A built-in role (by its id, or by name on /api/roles/{name}): GET reads it as it stands (or its pairs, at
// .../permissions). As in Bifrost it cannot be deleted (403) but can be edited: PUT changes its description, dac,
// entity_dac and permissions (a field left out keeps its value; it cannot be renamed), and PUT .../permissions
// {"permission_ids": [...]} replaces its pairs. An edited role is judged by its pairs, as a custom role is.
function systemRoleRoute(store: ConfigStore, m: string, name: string, segs: string[], body: string, wrap: bool): ApiReply {
  const role = systemRole(gov(store.cfg).roles, name, RESOURCES, OPERATIONS)
  if (role === undefined) return reply(404, errorBody(`no role ${name}`))
  if (segs.length === 4) {
    if (m === "GET") return permissionsReply(name, role.permissions ?? [])
    if (m !== "PUT") return notAllowed(m)
    const ps = permissionIdsOf(body)
    if (ps.error !== "") return reply(400, errorBody(ps.error))
    const r = store.editSystemRole({ name: name, description: role.description, dac: role.dac, permissions: ps.pairs, entity_dac: role.entity_dac })
    if (r.kind === "error") return errReply(r)
    return systemRoleRoute(store, "GET", name, segs, "", wrap)
  }
  if (m === "GET") return reply(200, wrap ? `{"role":${roleJsonAs(role, true)}}` : roleJsonAs(role, true))
  if (m === "DELETE") return reply(403, errorBody("cannot delete system role"))
  if (m !== "PUT") return notAllowed(m)
  const b = parseRoleBody(body)
  if (b === undefined) return badBody()
  if (b.name !== undefined && b.name !== name) return reply(400, errorBody("a system role cannot be renamed"))
  const ed = entityDacFrom(body)
  if (ed.error !== "") return reply(400, errorBody(ed.error))
  let present = false
  try {
    present = find(fields(body), "entity_dac") !== undefined
  } catch (e) {
    present = false
  }
  let description: string | undefined = role.description
  if (b.description !== undefined) description = b.description === "" ? undefined : b.description
  const r = store.editSystemRole({ name: name, description: description, dac: b.dac ?? role.dac, permissions: b.permissions ?? role.permissions, entity_dac: present ? ed.list : role.entity_dac })
  if (r.kind === "error") return errReply(r)
  return systemRoleRoute(store, "GET", name, segs, "", wrap)
}

// Whether a path segment is a number (a role id): digits only, at least one.
function isNumeric(s: string): bool {
  if (s === "") return false
  let i = 0
  while (i < s.byteLength) {
    if (!"0123456789".includes(s.slice(i, i + 1))) return false
    i += 1
  }
  return true
}

// GET and PUT /api/roles/{name}/permissions. Bifrost names permissions by id: GET lists the role's
// pairs with their ids, and PUT {"permission_ids": [...]} replaces the pairs with the ones those ids name.
function rolePermissions(store: ConfigStore, m: string, name: string, body: string): ApiReply {
  const cur = customRole(gov(store.cfg).roles, name)
  if (cur === undefined) return reply(404, errorBody(`no role ${name}`))
  if (m === "GET") return permissionsReply(name, cur.permissions ?? [])
  if (m !== "PUT") return notAllowed(m)
  const ps = permissionIdsOf(body)
  if (ps.error !== "") return reply(400, errorBody(ps.error))
  const r = store.upsertRole({ name: name, description: cur.description, dac: cur.dac, permissions: ps.pairs, entity_dac: cur.entity_dac })
  if (r.kind === "error") return errReply(r)
  return rolePermissions(store, "GET", name, "")
}

// A role's pairs with their ids, as GET .../permissions answers.
function permissionsReply(name: string, pairs: PermissionPair[]): ApiReply {
  const ids = permissionIds(RESOURCES, OPERATIONS, pairs)
  const docs = permissionDocs(RESOURCES, OPERATIONS).filter((d) => ids.includes(d.id))
  return reply(200, JSON.stringify({ role: name, permissions: docs }))
}

// The pairs a {"permission_ids": [...]} body names, or the 400 message.
function permissionIdsOf(body: string): { pairs: PermissionPair[], error: string } {
  const pairs: PermissionPair[] = []
  let fs: Field[] = []
  try {
    fs = fields(body)
  } catch (e) {
    return { pairs: pairs, error: "body must be a JSON object matching the resource" }
  }
  const raw = find(fs, "permission_ids") ?? ""
  try {
    for (const el of elements(raw)) {
      const id = parseFloat(el)
      const pair = id === undefined ? undefined : pairOfId(RESOURCES, OPERATIONS, Math.floor(id))
      if (pair === undefined) return { pairs: pairs, error: `unknown permission id ${el}` }
      pairs.push(pair)
    }
  } catch (e) {
    return { pairs: pairs, error: "permission_ids must be a list of permission ids" }
  }
  return { pairs: pairs, error: "" }
}

function roleFrom(name: string, b: RoleBody, entity: EntityDac[]): RoleConfig {
  return { name: name, description: b.description, dac: b.dac, permissions: b.permissions, entity_dac: entity }
}

// A role body's entity_dac, read from Bifrost's object form ({"Logs": "own-data"}). Undefined keys
// count as no overrides; a value that is not a string is an error.
function entityDacFrom(body: string): { list: EntityDac[], error: string } {
  const out: EntityDac[] = []
  let fs: Field[] = []
  try {
    fs = fields(body)
  } catch (e) {
    return { list: out, error: "" }
  }
  const raw = find(fs, "entity_dac")
  if (raw === undefined || raw === "null") return { list: out, error: "" }
  if (!raw.startsWith("{")) return { list: out, error: "entity_dac must be an object" }
  let inner: Field[] = []
  try {
    inner = fields(raw)
  } catch (e) {
    return { list: out, error: "entity_dac must be an object" }
  }
  for (const f of inner) {
    if (!f.raw.startsWith("\"")) return { list: out, error: `entity_dac ${f.key} must be a data access scope` }
    let dac = ""
    try {
      dac = decodeString(f.raw)
    } catch (e) {
      return { list: out, error: `entity_dac ${f.key} must be a data access scope` }
    }
    out.push({ resource: f.key, dac: dac })
  }
  return { list: out, error: "" }
}

// A custom role as the management API shows it: its id, entity_dac as Bifrost's object, dac only when set.
function roleJson(r: RoleConfig): string {
  return roleJsonAs(r, false)
}

function roleJsonAs(r: RoleConfig, system: bool): string {
  const parts: string[] = []
  if (r.id !== undefined) parts.push(`"id":${r.id}`)
  parts.push(`"name":${quote(r.name)}`)
  if (r.description !== undefined) parts.push(`"description":${quote(r.description)}`)
  parts.push(`"is_system_role":${system ? "true" : "false"}`)
  if (r.dac !== undefined) parts.push(`"dac":${quote(r.dac)}`)
  parts.push(`"permissions":${JSON.stringify(r.permissions ?? [])}`)
  const ed: string[] = []
  for (const e of r.entity_dac ?? []) ed.push(`${quote(e.resource)}:${quote(e.dac)}`)
  parts.push(`"entity_dac":{${ed.join(",")}}`)
  return "{" + parts.join(",") + "}"
}

// Bifrost's ValidateExternalURL on a provider's base_url (handlers/providers.go): http or https, loopback always
// allowed, link-local, unspecified and metadata addresses never, other private addresses only with
// network_config.allow_private_network. Judged on the host as written (netguard.tov, every spelling of an address);
// providerBaseUrlProblem also resolves a host name. "" when the URL is fine or absent.
function baseUrlVerdict(v: Verdict): string {
  if (v.kind === "blocked") return `Invalid base URL: link-local, unspecified and metadata addresses are not allowed (${v.detail})`
  if (v.kind === "private") return `Invalid base URL: private IP addresses are not allowed (${v.detail}); set network_config.allow_private_network to allow them`
  if (v.kind === "dns") return `Invalid base URL: failed to resolve hostname: ${v.detail}`
  return ""
}

function baseUrlShape(nc: NetworkConfig | undefined): { url: string, policy: Policy, error: string } {
  const policy: Policy = { private: nc?.allow_private_network === true, loopback: true, allow: [] }
  const url = (nc?.base_url ?? "").trim()
  if (url === "") return { url: "", policy: policy, error: "" }
  const u = URL.parse(url)
  if (u === undefined) return { url: url, policy: policy, error: "Invalid base URL: invalid URL format" }
  if (u.protocol !== "http:" && u.protocol !== "https:") return { url: url, policy: policy, error: `Invalid base URL: only https and http schemes are allowed, got: ${u.protocol.replace(":", "")}` }
  if (u.hostname === "") return { url: url, policy: policy, error: "Invalid base URL: URL must have a hostname" }
  return { url: url, policy: policy, error: "" }
}

export function baseUrlProblem(nc: NetworkConfig | undefined): string {
  const s = baseUrlShape(nc)
  if (s.error !== "" || s.url === "") return s.error
  const v = hostVerdict(URL.parse(s.url)!.hostname, s.policy)
  return v.kind === "name" ? "" : baseUrlVerdict(v)
}

// The base_url check for POST /api/providers and PUT /api/providers/{p} at save time, with the host resolved and every
// address checked (the request is then answered by handleApi, which checks the literal again).
export async function providerBaseUrlProblem(method: string, path: string, body: string): Promise<string> {
  const create = method === "POST" && path === "/api/providers"
  const update = method === "PUT" && path.startsWith("/api/providers/") && !path.slice("/api/providers/".byteLength).includes("/")
  if (!create && !update) return ""
  const p = parseProvider(body)
  if (p === undefined) return ""
  const s = baseUrlShape(p.network_config)
  if (s.error !== "" || s.url === "") return s.error
  return baseUrlVerdict(await urlVerdict(s.url, s.policy))
}

// Saves a provider under name from a provider body (PUT upserts, POST creates) and reads it back masked.
function saveProvider(store: ConfigStore, name: string, body: string): ApiReply {
  const p = parseProvider(body)
  if (p === undefined) return badBody()
  const bu = baseUrlProblem(p.network_config)
  if (bu !== "") return reply(400, errorBody(bu))
  const r = store.upsertProvider(name, p)
  if (r.kind === "error") return errReply(r)
  const saved = providerOf(store.cfg, name)
  if (saved === undefined) return serverError()
  return reply(200, JSON.stringify(redactProvider(saved)))
}

// POST /api/providers: adds the provider named by the body's provider field (Bifrost's shape); 409 when it exists.
function createProvider(store: ConfigStore, body: string): ApiReply {
  let fs: Field[] = []
  try {
    fs = fields(body)
  } catch (e) {
    return badBody()
  }
  const name = rawStr(fs, "provider") ?? ""
  if (name === "") return reply(400, errorBody("provider is required"))
  if (!validProviderName(name)) return reply(400, errorBody(`invalid provider name ${name}`))
  if (providerOf(store.cfg, name) !== undefined) return reply(409, errorBody(`provider ${name} already exists`))
  return saveProvider(store, name, body)
}

// GET /api/providers/{p}/keys: the keys with secrets masked, in Bifrost's {keys, total} shape.
function listProviderKeys(store: ConfigStore, name: string): ApiReply {
  const p = providerOf(store.cfg, name)
  if (p === undefined) return reply(404, errorBody(`no provider ${name}`))
  const ks: KeyConfig[] = []
  for (const k of p.keys ?? []) ks.push(redactKey(k))
  return reply(200, JSON.stringify({ keys: ks, total: ks.length }))
}

// GET /api/providers/{p}/keys/{id}: one key, masked.
function getProviderKey(store: ConfigStore, name: string, keyId: string): ApiReply {
  const p = providerOf(store.cfg, name)
  if (p === undefined) return reply(404, errorBody(`no provider ${name}`))
  const k = findKey(p.keys ?? [], keyId)
  if (k === undefined) return reply(404, errorBody(`no key ${keyId} on provider ${name}`))
  return reply(200, JSON.stringify(redactKey(k)))
}

function providerRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string): ApiReply {
  if (segs.length === 2) {
    if (m === "GET") return reply(200, providerList(store.cfg))
    if (m === "POST") return createProvider(store, body)
    return notAllowed(m)
  }
  const name = segs[2] ?? ""
  if (segs.length === 3) {
    if (m === "GET") {
      const p = providerOf(store.cfg, name)
      if (p === undefined) return reply(404, errorBody(`no provider ${name}`))
      return reply(200, JSON.stringify(redactProvider(p)))
    }
    if (m === "PUT") return saveProvider(store, name, body)
    if (m === "DELETE") {
      const r = store.deleteProvider(name)
      if (r.kind === "error") return errReply(r)
      return reply(200, JSON.stringify({ deleted: name }))
    }
    return notAllowed(m)
  }
  if (segs[3] !== "keys" || segs.length > 5) return notFound(path)
  if (segs.length === 4) {
    if (m === "GET") return listProviderKeys(store, name)
    if (m !== "POST") return notAllowed(m)
    const k = parseKey(body)
    if (k === undefined) return badBody()
    const id = resolveId(undefined, k.id, "key-")
    k.id = id
    const r = store.addKey(name, k)
    if (r.kind === "error") return errReply(r)
    const saved = findKey(providerOf(store.cfg, name)?.keys ?? [], id)
    if (saved === undefined) return serverError()
    return reply(201, JSON.stringify(redactKey(saved)))
  }
  const keyId = segs[4] ?? ""
  if (m === "GET") return getProviderKey(store, name, keyId)
  if (m === "PUT") {
    const k = parseKey(body)
    if (k === undefined) return badBody()
    const r = store.updateKey(name, keyId, k)
    if (r.kind === "error") return errReply(r)
    const saved = findKey(providerOf(store.cfg, name)?.keys ?? [], keyId)
    if (saved === undefined) return serverError()
    return reply(200, JSON.stringify(redactKey(saved)))
  }
  if (m === "DELETE") {
    const r = store.deleteKey(name, keyId)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: keyId }))
  }
  return notAllowed(m)
}

// Routes one request of the management API. Bodies are JSON; errors are
// {"error":{"message":...}}. The query string is ignored.
// The gateway's version, as GET /api/version returns it.
const RAIJU_VERSION = "0.1.0"

// The client section's settings by JSON type, for PUT /api/config. Any other name is refused.
const CLIENT_BOOL = ["drop_excess_requests", "disable_content_logging", "allow_per_request_content_storage_override", "retain_content_in_object_storage", "enable_logging", "enable_governance", "enforce_governance_header", "enforce_auth_on_inference", "allow_direct_keys", "refuse_unpriced_models", "delete_expired_virtual_keys", "hide_deleted_virtual_keys_in_filters", "enforce_vk_object_ownership", "mcp_enable_temp_token_auth"]
const CLIENT_INT = ["max_request_body_size_mb", "async_job_result_ttl", "mcp_agent_depth"]
const CLIENT_LIST = ["required_headers", "allowed_origins", "prometheus_labels", "mcp_auto_execute"]

// "" when the client section is a JSON object of known settings with the right types, else
// what is wrong with it.
function clientProblem(text: string): string {
  if (!text.trim().startsWith("{")) return "client must be a JSON object"
  let fs: Field[] = []
  try {
    fs = fields(text)
  } catch (e) {
    return "client must be a JSON object"
  }
  for (const f of fs) {
    const raw = f.raw
    if (CLIENT_BOOL.includes(f.key)) {
      if (raw !== "true" && raw !== "false") return `${f.key} must be true or false`
    } else if (CLIENT_INT.includes(f.key)) {
      if (!digitsOnly(raw)) return `${f.key} must be a whole number`
    } else if (CLIENT_LIST.includes(f.key)) {
      if (!raw.startsWith("[")) return `${f.key} must be a list`
    } else if (f.key === "vk_rotation_cooldown") {
      if (!raw.startsWith("\"")) return "vk_rotation_cooldown must be a duration string such as 1h"
    } else if (f.key === "dual_credential_conflict_behavior") {
      const v = raw.startsWith("\"") ? rawStr(fs, f.key) ?? "" : "-"
      if (v !== "" && v !== "error" && v !== "prefer_vk" && v !== "prefer_idp") return "dual_credential_conflict_behavior must be error, prefer_vk or prefer_idp"
    } else if (f.key === "mcp_server_auth_mode") {
      if (!raw.startsWith("\"")) return "mcp_server_auth_mode must be a string"
    } else if (f.key === "oauth2_server_config") {
      if (!raw.startsWith("{")) return "oauth2_server_config must be an object"
    } else return `unknown client setting ${f.key}`
  }
  return ""
}

function digitsOnly(s: string): bool {
  if (s === "") return false
  for (const ch of s.chars()) {
    if (ch < "0" || ch > "9") return false
  }
  return true
}

// The framework_config section (Bifrost's TableFrameworkConfig): pricing_url and pricing_sync_interval
// become pricing_sync. An empty pricing_url resets to the default; model_parameters_url (empty resets to the
// default) and live_models_sync_interval (0 off, else at least 60 seconds) are kept as Bifrost's handler keeps them.
// The section's other settings (the MCP library sync) are kept.
type FrameworkPlan = { kind: "ok", ps: PricingSyncConfig | undefined } | { kind: "error", message: string }

function frameworkPlan(raw: string, cur: PricingSyncConfig | undefined): FrameworkPlan {
  let fs: Field[] = []
  try {
    fs = fields(raw)
  } catch (e) {
    return { kind: "error", message: "framework_config must be a JSON object" }
  }
  let url: string | undefined = cur?.url
  const given = rawStr(fs, "pricing_url")
  if (find(fs, "pricing_url") !== undefined && given === undefined) return { kind: "error", message: "pricing_url must be a string" }
  if (given !== undefined) url = given === "" ? undefined : given
  if (url !== undefined && !url.startsWith("https://") && !url.startsWith("http://")) return { kind: "error", message: "pricing_url must be an http or https URL" }
  let interval: int | undefined = cur?.interval_seconds
  const iv = rawNum(fs, "pricing_sync_interval")
  if (find(fs, "pricing_sync_interval") !== undefined && iv === undefined) return { kind: "error", message: "pricing_sync_interval must be a number of seconds" }
  if (iv !== undefined) {
    if (iv <= 0.0) return { kind: "error", message: "pricing_sync_interval must be positive" }
    interval = Math.floor(iv)
  }
  let mpu: string | undefined = cur?.model_parameters_url
  const gm = rawStr(fs, "model_parameters_url")
  if (find(fs, "model_parameters_url") !== undefined && gm === undefined && !isNull(find(fs, "model_parameters_url")!)) return { kind: "error", message: "model_parameters_url must be a string" }
  if (gm !== undefined) mpu = gm.trim() === "" ? undefined : gm.trim()
  if (mpu !== undefined && !mpu.startsWith("https://") && !mpu.startsWith("http://") && !mpu.startsWith("file://")) return { kind: "error", message: "model_parameters_url must be an http, https or file URL" }
  let live: int | undefined = cur?.live_models_sync_interval
  const lv = rawNum(fs, "live_models_sync_interval")
  if (find(fs, "live_models_sync_interval") !== undefined && lv === undefined && !isNull(find(fs, "live_models_sync_interval")!)) return { kind: "error", message: "live_models_sync_interval must be a number of seconds" }
  if (lv !== undefined) {
    if (lv < 0.0) return { kind: "error", message: "live models sync interval cannot be negative" }
    if (lv > 0.0 && lv < 60.0) return { kind: "error", message: "live models sync interval must be 0 (disabled) or at least 60 seconds" }
    live = Math.floor(lv)
  }
  if (url === undefined && interval === undefined && cur?.enabled === undefined && mpu === undefined && live === undefined && cur?.mcp_library_url === undefined && cur?.mcp_library_sync_interval === undefined) return { kind: "ok", ps: undefined }
  let ps: PricingSyncConfig = cur ?? {}
  ps.url = url
  ps.interval_seconds = interval
  ps.model_parameters_url = mpu
  ps.live_models_sync_interval = live
  return { kind: "ok", ps: ps }
}

// The auth_config section (Bifrost's auth config, as PUT /api/config takes it): admin_username and
// admin_password replace the stored credential ("<redacted>" keeps the stored password), is_enabled false
// clears it, and disable_auth_on_inference sets client.enforce_auth_on_inference. The token is kept.
type AuthPlan = { kind: "ok", auth: AdminAuthConfig, disable: bool | undefined } | { kind: "error", message: string }

function authPlan(raw: string, cur: AdminAuthConfig | undefined): AuthPlan {
  let fs: Field[] = []
  try {
    fs = fields(raw)
  } catch (e) {
    return { kind: "error", message: "auth_config must be a JSON object" }
  }
  const enabledRaw = find(fs, "is_enabled")
  if (enabledRaw !== undefined && rawBool(fs, "is_enabled") === undefined) return { kind: "error", message: "is_enabled must be true or false" }
  const disableRaw = find(fs, "disable_auth_on_inference")
  if (disableRaw !== undefined && rawBool(fs, "disable_auth_on_inference") === undefined) return { kind: "error", message: "disable_auth_on_inference must be true or false" }
  const disable = rawBool(fs, "disable_auth_on_inference")
  if (rawBool(fs, "is_enabled") === false) return { kind: "ok", auth: { token: cur?.token }, disable: disable }
  let user: string | undefined = cur?.username
  const u = rawStr(fs, "admin_username")
  if (u !== undefined) user = u
  let pw: string | undefined = cur?.password
  const p = rawStr(fs, "admin_password")
  if (p !== undefined && p !== REDACTED) pw = p
  if (user === undefined || user === "" || pw === undefined || pw === "") {
    return { kind: "error", message: "admin_username and admin_password are required to turn admin auth on" }
  }
  return { kind: "ok", auth: { username: user, password: pw, token: cur?.token }, disable: disable }
}

// PUT /api/config: the sections Bifrost's handler takes, each given section replaced and the rest kept:
// client_config (or client), framework_config and auth_config. Every section is checked before any is saved.
// The name of the first MCP client whose auth_type is token_exchange, or "".
export function exchangeClientIn(list: McpClientConfig[] | undefined): string {
  for (const c of list ?? []) {
    if (c.auth_type === "token_exchange") return c.name
  }
  return ""
}

function putConfig(store: ConfigStore, body: string): ApiReply {
  let fs: Field[] = []
  try {
    fs = fields(body)
  } catch (e) {
    return badBody()
  }
  const rawClient = find(fs, "client_config") ?? find(fs, "client")
  const rawFramework = find(fs, "framework_config")
  const rawAuth = find(fs, "auth_config")
  if (rawClient === undefined && rawFramework === undefined && rawAuth === undefined) {
    return reply(400, errorBody("the body needs a client_config, framework_config or auth_config object"))
  }
  let c: ClientConfig | undefined = undefined
  if (rawClient !== undefined) {
    const problem = clientProblem(rawClient)
    if (problem !== "") return reply(400, errorBody(problem))
    try {
      c = JSON.parse(rawClient) as ClientConfig
    } catch (e) {
      return badBody()
    }
  }
  // "error" refuses exactly the requests token_exchange clients rely on, so the two cannot be set together (Bifrost's config.go)
  const te = exchangeClientIn(store.cfg.mcp?.client_configs)
  if (c !== undefined && c.dual_credential_conflict_behavior === "error" && te !== "") {
    return reply(400, errorBody(`dual_credential_conflict_behavior cannot be set to 'error' while MCP client "${te}" uses auth_type 'token_exchange'; delete that client first or choose 'prefer_idp'/'prefer_vk'`))
  }
  let fp: FrameworkPlan = { kind: "ok", ps: store.cfg.pricing_sync }
  if (rawFramework !== undefined) fp = frameworkPlan(rawFramework, store.cfg.pricing_sync)
  if (fp.kind === "error") return reply(400, errorBody(fp.message))
  let ap: AuthPlan | undefined = undefined
  if (rawAuth !== undefined) {
    ap = authPlan(rawAuth, store.cfg.governance?.auth_config ?? store.cfg.auth_config)
    if (ap.kind === "error") return reply(400, errorBody(ap.message))
  }
  // disable_auth_on_inference is client.enforce_auth_on_inference, inverted
  let disable: bool | undefined = undefined
  if (ap !== undefined && ap.kind === "ok") disable = ap.disable
  if (c !== undefined || disable !== undefined) {
    let cl: ClientConfig = c ?? store.cfg.client ?? {}
    if (disable !== undefined) cl.enforce_auth_on_inference = !disable
    const r = store.setClient(cl)
    if (r.kind === "error") return errReply(r)
  }
  if (rawFramework !== undefined) {
    const r = store.setPricingSync(fp.ps)
    if (r.kind === "error") return errReply(r)
  }
  if (ap !== undefined && ap.kind === "ok") {
    const r = store.setAdminAuth(ap.auth)
    if (r.kind === "error") return errReply(r)
  }
  const pf = store.cfg.pricing_sync
  const au = store.cfg.governance?.auth_config
  const view = JSON.stringify({
    status: "success",
    message: "config updated successfully",
    client: store.cfg.client ?? {},
    framework_config: { pricing_url: pf?.url ?? "", pricing_sync_interval: pf?.interval_seconds ?? 0, model_parameters_url: pf?.model_parameters_url ?? "", live_models_sync_interval: pf?.live_models_sync_interval ?? 3600 },
    auth_config: { admin_username: au?.username ?? "", is_enabled: au?.username !== undefined, disable_auth_on_inference: store.cfg.client?.enforce_auth_on_inference === false },
  })
  return reply(200, view)
}

// ---- routing rules, complexity analyzer, budget overrides, expired keys ----

// PUT /api/governance/virtual-keys/{vk}/budgets/{budget}/override and DELETE on the same path.
function budgetOverrideRoute(store: ConfigStore, m: string, vkId: string, budgetId: string, body: string, scope: DataScope): ApiReply {
  if (m !== "PUT" && m !== "DELETE") return notAllowed(m)
  if (!scope.all) return scopeDenied()
  if (!recordInScope(store.cfg, "virtual-keys", vkId, scope)) return reply(404, errorBody(`no virtual-keys ${vkId}`))
  let o: BudgetOverride | undefined = undefined
  if (m === "PUT") {
    const pr = parseOverride(body)
    if (pr.kind === "error") return reply(400, errorBody(pr.message))
    o = pr.override
  }
  const r = store.setBudgetOverride(vkId, budgetId, o)
  if (r.kind === "error") return errReply(r)
  const b = findById(gov(store.cfg).budgets, budgetId)
  // a cycles override adds to the limit for its cycles, so the view counts it while it runs
  let eff = 0.0
  if (b !== undefined) {
    eff = effectiveBudgetLimit(b)
    const o = b.override
    if (o !== undefined && o.mode === "cycles" && cyclesLeft(o, durationMs(b.reset_duration), Date.now()) > 0) eff += o.amount
  }
  return reply(200, JSON.stringify({ budget: b, effective_max_limit: eff }))
}

// GET /api/governance/virtual-keys/{vk}/users. A key has one assigned user (its user_id).
function vkUsers(store: ConfigStore, m: string, id: string, scope: DataScope): ApiReply {
  if (m !== "GET") return notAllowed(m)
  const vk = findById(gov(store.cfg).virtual_keys, id)
  if (vk === undefined || !recordInScope(store.cfg, "virtual-keys", id, scope)) return reply(404, errorBody(`no virtual-keys ${id}`))
  const users: { user_id: string, user_name: string, user_email: string, source: string }[] = []
  const u = vk.user_id ?? ""
  let email = ""
  for (const x of gov(store.cfg).users ?? []) {
    if (x.name === u) email = emailOf(x)
  }
  if (u !== "") users.push({ user_id: u, user_name: u, user_email: email, source: "assigned" })
  return reply(200, JSON.stringify({ users: users }))
}

// GET /api/resources, /api/operations and /api/permissions (and the /api/governance/rbac/ forms).
function rbacListing(what: string, m: string): ApiReply {
  if (m !== "GET") return notAllowed(m)
  if (what === "resources") return reply(200, JSON.stringify({ resources: RESOURCES.map((r, i) => ({ id: i + 1, name: r })) }))
  if (what === "operations") return reply(200, JSON.stringify({ operations: OPERATIONS.map((o, i) => ({ id: i + 1, name: o })) }))
  return reply(200, JSON.stringify({ permissions: permissionDocs(RESOURCES, OPERATIONS) }))
}

// A routing rule as a request body gives it: every field optional, so ruleError names what is missing.
type RuleBody = { id?: string, name?: string, cel_expression?: string, targets?: RuleTarget[], fallbacks?: string[], scope?: "global" | "virtual_key" | "team" | "customer", scope_id?: string, priority?: int, enabled?: bool }

// The routing rule in a request body. The id comes from the path or is generated; the rest is taken as given.
function parseRule(b: string, id: string): RoutingRule | undefined {
  try {
    const r = JSON.parse(b) as RuleBody
    const given = r.id ?? ""
    return { id: given === "" ? id : given, name: r.name, cel_expression: r.cel_expression ?? "", targets: r.targets ?? [], fallbacks: r.fallbacks, scope: r.scope, scope_id: r.scope_id, priority: r.priority, enabled: r.enabled }
  } catch (e) {
    return undefined
  }
}

// /api/governance/routing-rules[/{id}] (and /api/routing/rules): the CEL routing rules, as Raiju stores them.
function routingRulesRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string, scope: DataScope): ApiReply {
  if (!scope.all && m !== "GET") return scopeDenied()
  const rules: RoutingRule[] = gov(store.cfg).routing_rules ?? []
  if (segs.length === 3) {
    if (m === "GET") return reply(200, JSON.stringify({ rules: rules, total: rules.length }))
    if (m !== "POST") return notAllowed(m)
    const rule = parseRule(body, randomId("rule"))
    if (rule === undefined) return badBody()
    if (findById(rules, rule.id) !== undefined) return reply(409, errorBody(`routing rule ${rule.id} exists`))
    const r = store.upsertRoutingRule(rule)
    if (r.kind === "error") return errReply(r)
    return reply(201, JSON.stringify(findById(gov(store.cfg).routing_rules, rule.id)))
  }
  if (segs.length !== 4) return notFound(path)
  const id = segs[3] ?? ""
  const cur = findById(rules, id)
  if (cur === undefined) return reply(404, errorBody(`no routing rule ${id}`))
  if (m === "GET") return reply(200, JSON.stringify(cur))
  if (m === "PUT") {
    const rule = parseRule(body, id)
    if (rule === undefined) return badBody()
    const r = store.upsertRoutingRule(rule)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify(findById(gov(store.cfg).routing_rules, id)))
  }
  if (m === "DELETE") {
    const r = store.deleteRoutingRule(id)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ deleted: id }))
  }
  return notAllowed(m)
}

// /api/governance/complexity-analyzer-config (and /api/routing/...): Raiju's complexity_router, read,
// replaced, or reset to none.
function complexityRoute(store: ConfigStore, m: string, segs: string[], body: string, path: string, scope: DataScope): ApiReply {
  if (!scope.all && m !== "GET") return scopeDenied()
  const reset = segs.length === 4 && segs[3] === "reset"
  if (segs.length === 3 && m === "GET") return reply(200, JSON.stringify(store.cfg.complexity_router ?? {}))
  if (segs.length === 3 && m === "PUT") {
    const problem = complexityProblem(body)
    if (problem !== "") return reply(400, errorBody(problem))
    const cs = complexityFrom(body)
    if (cs === undefined) return badBody()
    const r = store.setComplexity(cs)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify(store.cfg.complexity_router ?? {}))
  }
  if (reset && m === "POST") {
    const r = store.setComplexity(undefined)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({}))
  }
  if (segs.length === 3 || reset) return notAllowed(m)
  return notFound(path)
}

// Bifrost's complexity status routes (no /api/governance alias, as in Bifrost): GET .../complexity-analyzer-status
// and POST .../status/retry, GET .../complexity-analyzer-generations and DELETE .../generations/{namespace}. The
// state is the semantic classifier's in this process (complexity.tov).
function complexityStateRoute(store: ConfigStore, m: string, segs: string[], path: string, scope: DataScope): ApiReply {
  const cx = store.cfg.complexity_router ?? {}
  const on = cx.enabled === true
  if (segs[2] === "complexity-analyzer-status") {
    if (segs.length === 3) return m === "GET" ? reply(200, analyzerStatus(on, cx.classifier, cx.semantic, cx.llm)) : notAllowed(m)
    if (segs.length === 4 && segs[3] === "retry") {
      if (m !== "POST") return notAllowed(m)
      if (!scope.all) return scopeDenied()
      const r = retryWarmup(on, cx.classifier, cx.semantic, cx.llm)
      return reply(r.status, r.body)
    }
    return notFound(path)
  }
  if (segs.length === 3) return m === "GET" ? reply(200, generationsJson(on, cx.classifier)) : notAllowed(m)
  if (segs.length === 4) {
    if (m !== "DELETE") return notAllowed(m)
    if (!scope.all) return scopeDenied()
    const r = deleteGeneration(on, cx.classifier, segs[3] ?? "")
    return reply(r.status, r.body)
  }
  return notFound(path)
}

// The expired-key cleanup (Bifrost's daily vk_expiry_cleanup): deletes the keys expiredToDelete names.
// Returns the ids deleted. Run by the supervisor on a timer (ops.tov sweepExpiredKeys).
export function sweepExpiredKeys(store: ConfigStore, nowMs: number): string[] {
  const done: string[] = []
  for (const id of expiredToDelete(store.cfg.governance, store.cfg.client, nowMs)) {
    const r = store.deleteVirtualKey(id)
    if (r.kind === "ok") done.push(id)
  }
  return done
}

// POST /api/config/metadata: merges the body's keys into the metadata map; null removes a key.
// Values are strings, numbers or booleans (Bifrost takes any JSON value; objects and lists are refused).
function postMetadata(store: ConfigStore, body: string): ApiReply {
  let fs: Field[] = []
  try {
    fs = fields(body)
  } catch (e) {
    return reply(400, errorBody("Invalid request payload"))
  }
  if (fs.length === 0) return reply(400, errorBody("patch body must contain at least one key"))
  const m: Map<string, string | f64 | bool> = new Map()
  const cur = store.cfg.metadata
  if (cur !== undefined) {
    for (const k of cur.keys()) m.set(k, cur.get(k)!)
  }
  for (const f of fs) {
    const raw = f.raw
    if (raw === "null") {
      m.delete(f.key)
    } else if (raw.startsWith("\"")) {
      let s = ""
      try {
        s = decodeString(raw)
      } catch (e) {
        return reply(400, errorBody(`metadata ${f.key} is not a valid string`))
      }
      m.set(f.key, s)
    } else if (raw === "true" || raw === "false") {
      m.set(f.key, raw === "true")
    } else {
      const n = parseFloat(raw)
      if (n === undefined) return reply(400, errorBody(`metadata ${f.key} must be a string, number, boolean or null`))
      m.set(f.key, n)
    }
  }
  const r = store.setMetadata(m)
  if (r.kind === "error") return errReply(r)
  return reply(200, JSON.stringify({ success: true }))
}

// GET /api/keys: every provider key in one list, secrets masked (Bifrost's shape).
function keyList(c: Config): string {
  const out: { id: string, name: string, provider: string, value: string, models: string[], weight: f64 }[] = []
  for (const name of providerNames(c)) {
    for (const k of providerOf(c, name)!.keys ?? []) {
      out.push({ id: k.id ?? "", name: k.name ?? "", provider: name, value: maskOpt(k.value) ?? "", models: k.models ?? [], weight: k.weight ?? 1.0 })
    }
  }
  return JSON.stringify(out)
}

// The models named by the providers' keys ("*" is not a model), in Bifrost's list shape:
// {models: [{name, provider}], total}, filtered by provider and by a case-insensitive query
// and paged by limit and offset. Models the providers serve but the config does not name
// are not listed.
function modelList(c: Config, only: string, query: string, limit: f64, offset: f64): string {
  const all: { name: string, provider: string }[] = []
  const want = query.toLowerCase()
  for (const name of providerNames(c)) {
    if (only !== "" && name !== only) continue
    for (const k of providerOf(c, name)!.keys ?? []) {
      for (const m of k.models ?? []) {
        if (m === "*" || all.some((x) => x.name === m && x.provider === name)) continue
        if (want !== "" && !m.toLowerCase().includes(want)) continue
        all.push({ name: m, provider: name })
      }
    }
  }
  const from = offset >= 0 ? Math.floor(offset) : 0
  const n = limit >= 0 ? Math.floor(limit) : 5
  return JSON.stringify({ models: all.slice(from, from + n), total: all.length })
}

// scope is what the caller may see and change (see scope.tov); all data when it is not given.
export function handleApi(store: ConfigStore, method: string, path: string, body: string, scope?: DataScope): ApiReply {
  const m = method.toUpperCase()
  const q = path.indexOf("?")
  const p = q < 0 ? path : path.slice(0, q)
  const sc: DataScope = scope ?? allScope()
  const qp = new URLSearchParams(q < 0 ? "" : path.slice(q + 1))
  const segs = p.split("/").filter((s) => s !== "")
  if (segs.length === 0 || segs[0] !== "api") return notFound(p)
  const area = segs[1] ?? ""
  // Bifrost's /api/routing/... are the governance routes
  if (area === "routing" && (segs[2] === "complexity-analyzer-status" || segs[2] === "complexity-analyzer-generations")) return complexityStateRoute(store, m, segs, p, sc)
  if (area === "routing" && segs.length >= 3) {
    const sub = segs[2] === "rules" ? "routing-rules" : segs[2] ?? ""
    return governanceRoute(store, m, ["api", "governance", sub].concat(segs.slice(3)), body, p, qp, sc)
  }
  // Bifrost's RBAC catalogue: the resources, operations and permission pairs (read only)
  if (area === "resources" || area === "operations" || area === "permissions") {
    if (segs.length !== 2) return notFound(p)
    return rbacListing(area, m)
  }
  if (area === "config") {
    if (segs.length === 3 && segs[2] === "metadata") return m === "POST" ? postMetadata(store, body) : notAllowed(m)
    if (segs.length !== 2) return notFound(p)
    if (m === "PUT") return putConfig(store, body)
    return m === "GET" ? reply(200, store.redacted()) : notAllowed(m)
  }
  // POST /api/scim/provisioning-token: a new SCIM provisioning token, shown once; the old one stops working
  if (area === "scim") {
    if (segs.length !== 3 || segs[2] !== "provisioning-token") return notFound(p)
    if (m !== "POST") return notAllowed(m)
    if (store.cfg.scim_config?.enabled !== true) return reply(400, errorBody("SCIM is not enabled (scim_config.enabled)"))
    let tok = ""
    try {
      tok = "scim-" + secureHex(32)
    } catch (e) {
      return reply(500, errorBody("no random source for the token"))
    }
    const r = store.setScimToken(tok)
    if (r.kind === "error") return errReply(r)
    return reply(200, JSON.stringify({ token: tok, message: "Give this token to your identity provider's SCIM connector now; it is not shown again." }))
  }
  if (area === "version") {
    if (segs.length !== 2) return notFound(p)
    return m === "GET" ? reply(200, JSON.stringify(RAIJU_VERSION)) : notAllowed(m)
  }
  if (area === "keys") {
    if (segs.length !== 2) return notFound(p)
    return m === "GET" ? reply(200, keyList(store.cfg)) : notAllowed(m)
  }
  if (area === "models") {
    if (m !== "GET") return notAllowed(m)
    const sp = new URLSearchParams(q < 0 ? "" : path.slice(q + 1))
    const limit: f64 = parseFloat(sp.get("limit") ?? "5") ?? 5.0
    const offset: f64 = parseFloat(sp.get("offset") ?? "0") ?? 0.0
    if (segs.length === 2) return reply(200, modelList(store.cfg, sp.get("provider") ?? "", sp.get("query") ?? "", limit, offset))
    if (segs.length === 3) {
      const pn = segs[2]!
      if (providerOf(store.cfg, pn) === undefined) return reply(404, errorBody(`no provider ${pn}`))
      return reply(200, modelList(store.cfg, pn, sp.get("query") ?? "", limit, offset))
    }
    return notFound(p)
  }
  if (area === "proxy-config") {
    if (segs.length !== 2) return notFound(p)
    return proxyRoute(store, m, body)
  }
  if (area === "providers") return providerRoute(store, m, segs, body, p)
  if (area === "governance" && segs.length >= 3) return governanceRoute(store, m, segs, body, p, qp, sc)
  if (area === "roles") return roleRoute(store, m, segs, body, p, sc, false)
  return notFound(p)
}

// ---- tests ----

test("proxy-config: defaults, validation, password kept on <redacted>, and widening", () => {
  const path = tmpPath()
  try {
    const store = try new ConfigStore(path, {})
    const dflt = handleApi(store, "GET", "/api/proxy-config", "")
    expect(dflt.status).toBe(200)
    expect(dflt.body.includes(`"enabled":false`)).toBe(true)
    expect(dflt.body.includes(`"type":"http"`)).toBe(true)

    expect(handleApi(store, "PUT", "/api/proxy-config", `{"enabled":true,"type":"socks5","url":"socks5://p:1080"}`).status).toBe(400)
    expect(handleApi(store, "PUT", "/api/proxy-config", `{"enabled":true,"type":"http"}`).status).toBe(400)
    expect(handleApi(store, "PUT", "/api/proxy-config", `{"enabled":true,"type":"http","url":"ftp://x"}`).status).toBe(400)
    expect(handleApi(store, "PUT", "/api/proxy-config", `{"enabled":true,"type":"http","url":"http://169.254.169.254:80"}`).status).toBe(400)
    expect(handleApi(store, "PUT", "/api/proxy-config", `{"enabled":true,"url":"http://x:1","timeout":-1}`).status).toBe(400)
    expect(handleApi(store, "PUT", "/api/proxy-config", "not json").status).toBe(400)
    expect(handleApi(store, "DELETE", "/api/proxy-config", "").status).toBe(405)

    const put = handleApi(store, "PUT", "/api/proxy-config", `{"enabled":true,"type":"http","url":"http://egress:8080","username":"u","password":"secret-pw","enable_for_inference":true}`)
    expect(put.status).toBe(200)
    expect(store.cfg.proxy_config?.password).toBe("secret-pw")
    const view = handleApi(store, "GET", "/api/proxy-config", "").body
    expect(view.includes("secret-pw")).toBe(false)
    expect(view.includes(`"password":"<redacted>"`)).toBe(true)

    // a masked password sent back keeps the stored one
    expect(handleApi(store, "PUT", "/api/proxy-config", `{"enabled":true,"type":"http","url":"http://egress:8080","username":"u","password":"<redacted>","enable_for_inference":true}`).status).toBe(200)
    expect(store.cfg.proxy_config?.password).toBe("secret-pw")

    // the gate: a new URL or skip_tls_verify widens; the stored URL with other fields does not
    expect(proxyWidening(store.cfg.proxy_config, `{"enabled":true,"url":"http://other:1"}`).join(",")).toBe("url")
    expect(proxyWidening(store.cfg.proxy_config, `{"enabled":true,"url":"http://egress:8080","timeout":5}`).length).toBe(0)
    expect(proxyWidening(store.cfg.proxy_config, `{"enabled":true,"url":"http://egress:8080","skip_tls_verify":true}`).join(",")).toBe("skip_tls_verify")
    expect(proxyWidening(store.cfg.proxy_config, `{"enabled":false}`).length).toBe(0)

    // disabling clears the proxy for providers too
    expect(handleApi(store, "PUT", "/api/proxy-config", `{"enabled":false}`).status).toBe(200)
    expect(store.cfg.proxy_config?.enabled).toBe(false)
  } finally {
    cleanup(path)
  }
})

test("sweepExpiredKeys deletes the expired keys that opted in and keeps the others", () => {
  const path = tmpPath()
  try {
    const store = try new ConfigStore(path, { governance: { virtual_keys: [
      { id: "x", value: "vx", expires_at: "2001-01-01T00:00:00Z", delete_after_expire: true },
      { id: "y", value: "vy", expires_at: "2001-01-01T00:00:00Z" },
      { id: "z", value: "vz", expires_at: "2999-01-01T00:00:00Z", delete_after_expire: true },
    ] } })
    expect(sweepExpiredKeys(store, Date.now()).join(",")).toBe("x")
    const left = store.cfg.governance?.virtual_keys ?? []
    expect(left.map((v) => v.id).join(",")).toBe("y,z")
  } finally {
    cleanup(path)
  }
})

test("PUT /api/config: framework_config and auth_config are checked, then saved, and the rest is kept", () => {
  const path = tmpPath()
  try {
    const store = try new ConfigStore(path, { governance: { auth_config: { username: "root", password: "pw1" } } })
    expect(handleApi(store, "PUT", "/api/config", `{}`).status).toBe(400)
    expect(handleApi(store, "PUT", "/api/config", `{"framework_config":{"pricing_url":"ftp://x"}}`).status).toBe(400)
    expect(handleApi(store, "PUT", "/api/config", `{"framework_config":{"pricing_sync_interval":0}}`).status).toBe(400)
    expect(handleApi(store, "PUT", "/api/config", `{"auth_config":{"admin_username":"","admin_password":"x"}}`).status).toBe(400)
    // a bad section saves nothing, the good one included
    expect(handleApi(store, "PUT", "/api/config", `{"client_config":{"bogus":1},"auth_config":{"is_enabled":false}}`).status).toBe(400)
    expect(store.cfg.governance?.auth_config?.username).toBe("root")

    const ok = handleApi(store, "PUT", "/api/config", `{"framework_config":{"pricing_url":"https://prices.example/x.json","pricing_sync_interval":7200}}`)
    expect(ok.status).toBe(200)
    expect(store.cfg.pricing_sync?.url).toBe("https://prices.example/x.json")
    expect(store.cfg.pricing_sync?.interval_seconds).toBe(7200)
    expect(handleApi(store, "PUT", "/api/config", `{"framework_config":{"pricing_url":""}}`).status).toBe(200)
    expect(store.cfg.pricing_sync?.url).toBeUndefined()
    // model_parameters_url and live_models_sync_interval (0 off, else at least 60 s), as Bifrost's handler checks them
    const low = handleApi(store, "PUT", "/api/config", `{"framework_config":{"live_models_sync_interval":30}}`)
    expect(low.status).toBe(400)
    expect(low.body.includes("live models sync interval must be 0 (disabled) or at least 60 seconds")).toBe(true)
    expect(handleApi(store, "PUT", "/api/config", `{"framework_config":{"model_parameters_url":"ftp://x"}}`).status).toBe(400)
    const lm = handleApi(store, "PUT", "/api/config", `{"framework_config":{"model_parameters_url":"https://params.example/mp.json","live_models_sync_interval":0}}`)
    expect(lm.status).toBe(200)
    expect(lm.body.includes(`"live_models_sync_interval":0`)).toBe(true)
    expect(store.cfg.pricing_sync?.model_parameters_url).toBe("https://params.example/mp.json")
    expect(store.cfg.pricing_sync?.live_models_sync_interval).toBe(0)
    expect(store.cfg.pricing_sync?.interval_seconds).toBe(7200)
    expect(handleApi(store, "PUT", "/api/config", `{"framework_config":{"model_parameters_url":""}}`).status).toBe(200)
    expect(store.cfg.pricing_sync?.model_parameters_url).toBeUndefined()

    // a redacted password keeps the stored one; disable_auth_on_inference sets client.enforce_auth_on_inference
    expect(handleApi(store, "PUT", "/api/config", `{"auth_config":{"admin_username":"root","admin_password":"<redacted>","disable_auth_on_inference":true}}`).status).toBe(200)
    expect(store.cfg.governance?.auth_config?.password).toBe("pw1")
    expect(store.cfg.client?.enforce_auth_on_inference).toBe(false)
    expect(handleApi(store, "PUT", "/api/config", `{"auth_config":{"admin_username":"ops","admin_password":"pw2","disable_auth_on_inference":false}}`).status).toBe(200)
    expect(store.cfg.governance?.auth_config?.username).toBe("ops")
    expect(store.cfg.client?.enforce_auth_on_inference).toBe(true)
    expect(handleApi(store, "PUT", "/api/config", `{"client_config":{"max_request_body_size_mb":5}}`).status).toBe(200)
    expect(store.cfg.governance?.auth_config?.username).toBe("ops")
    expect(handleApi(store, "PUT", "/api/config", `{"auth_config":{"is_enabled":false}}`).status).toBe(200)
    expect(store.cfg.governance?.auth_config?.username).toBeUndefined()
  } finally {
    cleanup(path)
  }
})

test("PUT /api/config refuses dual_credential_conflict_behavior error while a token_exchange client exists", () => {
  const path = tmpPath()
  try {
    const store = try new ConfigStore(path, { mcp: { client_configs: [{ name: "jira", connection_type: "http", connection_string: "http://127.0.0.1:1/mcp", auth_type: "token_exchange", token_exchange: { audience: "api://jira", client_id: "exch" } }] } })
    const r = handleApi(store, "PUT", "/api/config", `{"client_config":{"dual_credential_conflict_behavior":"error"}}`)
    expect(r.status).toBe(400)
    expect(r.body.includes(`jira`) && r.body.includes(`uses auth_type 'token_exchange'`)).toBe(true)
    expect(store.cfg.client?.dual_credential_conflict_behavior).toBeUndefined()
    expect(handleApi(store, "PUT", "/api/config", `{"client_config":{"dual_credential_conflict_behavior":"prefer_idp"}}`).status).toBe(200)
    expect(store.cfg.client?.dual_credential_conflict_behavior).toBe("prefer_idp")
    expect(handleApi(store, "PUT", "/api/config", `{"client_config":{"dual_credential_conflict_behavior":"sometimes"}}`).status).toBe(400)
    expect(exchangeClientIn([])).toBe("")
  } finally {
    cleanup(path)
  }
})

test("governance: budget overrides, VK users, routing rules, complexity config, role permission ids and the catalogue", () => {
  const path = tmpPath()
  try {
    const store = try new ConfigStore(path, { governance: {
      budgets: [{ id: "b1", max_limit: 10, reset_duration: "1d" }],
      virtual_keys: [{ id: "vk1", value: "v1", budget_id: "b1", user_id: "alice" }, { id: "vk2", value: "v2" }],
    } })
    // budget override: forever adds to the limit; a key only reaches its own budgets; cycles add for their cycles
    const ov = handleApi(store, "PUT", "/api/governance/virtual-keys/vk1/budgets/b1/override", `{"amount": 5, "mode": "forever"}`)
    expect(ov.status).toBe(200)
    expect(ov.body.includes(`"effective_max_limit":15`)).toBe(true)
    expect(handleApi(store, "PUT", "/api/governance/virtual-keys/vk2/budgets/b1/override", `{"amount": 5, "mode": "forever"}`).status).toBe(404)
    const cyc = handleApi(store, "PUT", "/api/governance/virtual-keys/vk1/budgets/b1/override", `{"amount": 5, "mode": "cycles", "cycles": 2}`)
    expect(cyc.status).toBe(200)
    expect(cyc.body.includes(`"effective_max_limit":15`)).toBe(true)
    expect(handleApi(store, "PUT", "/api/governance/virtual-keys/vk1/budgets/b1/override", `{"amount": 5, "mode": "weekly"}`).status).toBe(400)
    expect(handleApi(store, "DELETE", "/api/governance/virtual-keys/vk1/budgets/b1/override", "").status).toBe(200)
    const bs = store.cfg.governance?.budgets ?? []
    expect(bs[0]!.override).toBeUndefined()

    expect(handleApi(store, "GET", "/api/governance/virtual-keys/vk1/users", "").body.includes(`"user_id":"alice"`)).toBe(true)
    expect(handleApi(store, "GET", "/api/governance/virtual-keys/vk2/users", "").body.includes(`"users":[]`)).toBe(true)

    // routing rules: CRUD on the CEL rules, through both route families
    const made = handleApi(store, "POST", "/api/routing/rules", `{"name":"big","cel_expression":"request > 10","targets":[{"provider":"openai"}]}`)
    expect(made.status).toBe(201)
    const rrs = store.cfg.governance?.routing_rules ?? []
    const id = rrs[0]?.id ?? ""
    expect(id !== "").toBe(true)
    expect(handleApi(store, "GET", "/api/governance/routing-rules", "").body.includes(`"total":1`)).toBe(true)
    expect(handleApi(store, "POST", "/api/governance/routing-rules", `{"cel_expression":"request >","targets":[{"provider":"openai"}]}`).status).toBe(400)
    expect(handleApi(store, "PUT", `/api/governance/routing-rules/${id}`, `{"cel_expression":"true","targets":[]}`).status).toBe(400)
    expect(handleApi(store, "PUT", `/api/governance/routing-rules/${id}`, `{"cel_expression":"request > 20","targets":[{"provider":"anthropic"}]}`).status).toBe(200)
    expect(handleApi(store, "GET", `/api/routing/rules/${id}`, "").body.includes("anthropic")).toBe(true)
    expect(handleApi(store, "DELETE", `/api/routing/rules/${id}`, "").status).toBe(200)
    expect(handleApi(store, "GET", `/api/routing/rules/${id}`, "").status).toBe(404)

    // complexity analyzer config
    expect(handleApi(store, "GET", "/api/governance/complexity-analyzer-config", "").body).toBe("{}")
    expect(handleApi(store, "PUT", "/api/governance/complexity-analyzer-config", `{"enabled":"yes"}`).status).toBe(400)
    expect(handleApi(store, "PUT", "/api/governance/complexity-analyzer-config", `{"enabled":true,"simple_max_score":0.3}`).status).toBe(200)
    expect(store.cfg.complexity_router?.enabled).toBe(true)
    expect(handleApi(store, "POST", "/api/governance/complexity-analyzer-config/reset", "").status).toBe(200)
    expect(store.cfg.complexity_router).toBeUndefined()

    // roles by id, and the catalogue
    expect(handleApi(store, "POST", "/api/roles", `{"name":"ops","permissions":[]}`).status).toBe(201)
    const put = handleApi(store, "PUT", "/api/roles/ops/permissions", `{"permission_ids":[1,2]}`)
    expect(put.status).toBe(200)
    expect(put.body.includes(`"resource":"Logs","operation":"View"`)).toBe(true)
    expect(put.body.includes(`"operation":"Create"`)).toBe(true)
    expect(handleApi(store, "PUT", "/api/roles/ops/permissions", `{"permission_ids":[0]}`).status).toBe(400)
    expect(handleApi(store, "GET", "/api/roles/nope/permissions", "").status).toBe(404)
    expect(handleApi(store, "GET", "/api/resources", "").body.includes(`"name":"VirtualKeys"`)).toBe(true)
    expect(handleApi(store, "GET", "/api/governance/rbac/permissions", "").body.includes(`"id":1`)).toBe(true)
    expect(handleApi(store, "POST", "/api/operations", "").status).toBe(405)
  } finally {
    cleanup(path)
  }
})

function statusOf(r: Result): int {
  return r.kind === "error" ? r.status : 200
}

function messageOf(r: Result): string {
  return r.kind === "error" ? r.message : ""
}

function tmpPath(): string {
  return "/tmp/raiju-store-" + randHex(12) + ".json"
}

function cleanup(path: string): void {
  try {
    unlinkSync(path)
  } catch (e) {
    // already gone
  }
  try {
    unlinkSync(path + ".bak")
  } catch (e) {
    // no backup yet
  }
}

class Counter {
  n = 0
}

function authHeader(v: string): Map<string, string> {
  const m: Map<string, string> = new Map()
  m.set("authorization", v)
  return m
}

test("the SCIM provisioning token is kept in the file and masked in the config view", () => {
  const path = "/tmp/raiju-store-scim-" + randomId("t") + ".json"
  const token = "scim-" + "unit-" + "provisioning-9a2c4e"
  const c: Config = { providers: new Map(), scim_config: { enabled: true, config: { provisioningToken: token } } }
  const store = new ConfigStore(path, c)
  expect(store.setScim([], []).kind).toBe("ok")
  const saved = try readFileSync(path, "utf8")
  expect(saved.includes(token)).toBe(true)
  expect(store.redacted().includes(token)).toBe(false)
  expect(store.redacted().includes(`"enabled":true`)).toBe(true)
  try unlinkSync(path)
  try {
    unlinkSync(path + ".bak")
  } catch (e) {
    // no backup on a first save
  }
})

test("saving keeps every config section", () => {
  const path = "/tmp/raiju-store-sections-" + randomId("t") + ".json"
  const c: Config = {
    providers: new Map(),
    governance: { auth_config: { token: "env.ADMIN" }, routing_rules: [{ id: "r", cel_expression: "true", targets: [{ provider: "openai" }] }] },
    otel: { endpoint: "http://c:4318/v1/traces" },
    logs_store: { enabled: true },
    plugins: [{ name: "mocker", config_json: "{}" }],
    health: { circuit_breaker: true },
  }
  const store = new ConfigStore(path, c)
  const r = store.upsertBudget({ id: "b", max_limit: 1.0, reset_duration: "1d" })
  expect(r.kind).toBe("ok")
  const saved = try readFileSync(path, "utf8")
  expect(saved.includes(`"auth_config"`)).toBe(true)
  expect(saved.includes(`"routing_rules"`)).toBe(true)
  expect(saved.includes(`"otel"`)).toBe(true)
  expect(saved.includes(`"logs_store"`)).toBe(true)
  expect(saved.includes(`"plugins"`)).toBe(true)
  expect(saved.includes(`"health"`)).toBe(true)
  expect(store.redacted().includes("env.ADMIN")).toBe(true)
  try unlinkSync(path)
  try {
    unlinkSync(path + ".bak")
  } catch (e) {
    // no backup on a first save
  }
})

test("durations and provider names are validated", () => {
  expect(validDuration("30s")).toBe(true)
  expect(validDuration("1M")).toBe(true)
  expect(validDuration("M")).toBe(false)
  expect(validDuration("5x")).toBe(false)
  expect(validDuration("0d")).toBe(false)
  expect(validDuration("10")).toBe(false)
  expect(validDuration("")).toBe(false)
  expect(validProviderName("openai")).toBe(true)
  expect(validProviderName("my_proxy-2")).toBe(true)
  expect(validProviderName("OpenAI")).toBe(false)
  expect(validProviderName("")).toBe(false)
  expect(validProviderName("a/b")).toBe(false)
})

test("providers: upsert, read, delete and 404s", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertProvider("openai", { keys: [{ value: "sk-abcdefghijkl", models: ["gpt-4o"] }] }))).toBe(200)
  expect(s.version).toBe(1)
  const keys = providerOf(s.cfg, "openai")!.keys!
  expect(keys[0]!.id!.startsWith("key-")).toBe(true)
  expect(statusOf(s.upsertProvider("Bad Name", {}))).toBe(400)
  expect(statusOf(s.deleteProvider("nope"))).toBe(404)
  expect(statusOf(s.deleteProvider("openai"))).toBe(200)
  expect(s.version).toBe(2)
  expect(providerOf(s.cfg, "openai") === undefined).toBe(true)
  cleanup(path)
})

test("keys: add, update, delete and 404/409", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertProvider("openai", {}))).toBe(200)
  const added = s.addKey("openai", { value: "sk-first-0123456789" })
  expect(statusOf(added)).toBe(200)
  const id = added.kind === "ok" ? added.id : ""
  expect(id.startsWith("key-")).toBe(true)
  expect(statusOf(s.addKey("nope", { value: "x" }))).toBe(404)
  expect(statusOf(s.addKey("openai", { id: id, value: "dup" }))).toBe(409)
  expect(statusOf(s.updateKey("openai", "missing", { value: "x" }))).toBe(404)
  expect(statusOf(s.updateKey("openai", id, { value: "sk-second-98765432", models: ["m1"] }))).toBe(200)
  expect(providerOf(s.cfg, "openai")!.keys![0]!.value).toBe("sk-second-98765432")
  expect(statusOf(s.deleteKey("openai", "missing"))).toBe(404)
  expect(statusOf(s.deleteKey("openai", id))).toBe(200)
  expect(providerOf(s.cfg, "openai")!.keys!.length).toBe(0)
  cleanup(path)
})

test("a masked key value sent back keeps the stored secret", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.addKey("anthropic", { value: "x" }))).toBe(404)
  expect(statusOf(s.upsertProvider("anthropic", { keys: [{ id: "key-a", value: "sk-ant-secret-1234" }] }))).toBe(200)
  expect(statusOf(s.updateKey("anthropic", "key-a", { value: "sk-a…1234", name: "renamed" }))).toBe(200)
  expect(providerOf(s.cfg, "anthropic")!.keys![0]!.value).toBe("sk-ant-secret-1234")
  expect(providerOf(s.cfg, "anthropic")!.keys![0]!.name).toBe("renamed")
  cleanup(path)
})

test("a GET then PUT of a provider whose keys have no id keeps every stored secret", () => {
  const path = tmpPath()
  const ps: Map<string, ProviderConfig> = new Map()
  // a hand-written (Bifrost-style) config: keys with a name and no id, and one with neither
  ps.set("openai", { keys: [{ name: "openai-1", value: "sk-REAL-openai-0001-3456", models: [], weight: 1.0 }, { name: "openai-2", value: "sk-REAL-openai-0002-7890", weight: 1.0 }] })
  ps.set("anon", { keys: [{ value: "sk-REAL-anon-key-0003-1111" }] })
  const s = new ConfigStore(path, { providers: ps })
  for (const name of ["openai", "anon"]) {
    const got = handleApi(s, "GET", "/api/providers/" + name, "")
    expect(got.status).toBe(200)
    expect(got.body.includes("sk-REAL")).toBe(false)
    // the client sends the masked provider back with one setting changed
    const put = handleApi(s, "PUT", "/api/providers/" + name, got.body.replace(`"keys"`, `"send_back_raw_response":true,"keys"`))
    expect(put.status).toBe(200)
  }
  const ok = providerOf(s.cfg, "openai")!.keys!
  expect(ok.length).toBe(2)
  expect(ok[0]!.value).toBe("sk-REAL-openai-0001-3456")
  expect(ok[1]!.value).toBe("sk-REAL-openai-0002-7890")
  // the id the GET showed is the one kept
  expect(ok[0]!.id).toBe("openai-1")
  expect(providerOf(s.cfg, "anon")!.keys![0]!.value).toBe("sk-REAL-anon-key-0003-1111")
  expect((try readFileSync(path, "utf8")).includes("…")).toBe(false)
  // a masked value that matches no stored key is refused, not saved as the key
  const bad = s.upsertProvider("openai", { keys: [{ name: "new-key", value: "sk-R…3456" }] })
  expect(statusOf(bad)).toBe(400)
  expect(statusOf(s.upsertProvider("openai", { keys: [{ id: "openai-1", value: "sk-X…9999" }] }))).toBe(400)
  expect(statusOf(s.addKey("openai", { name: "short", value: "****" }))).toBe(400)
  expect(statusOf(s.updateKey("openai", "openai-2", { value: "sk-R…0000" }))).toBe(400)
  expect(statusOf(s.upsertVirtualKey({ id: "vk-m", name: "m", value: "sk-b…abcd" }))).toBe(400)
  expect(providerOf(s.cfg, "openai")!.keys![0]!.value).toBe("sk-REAL-openai-0001-3456")
  cleanup(path)
})

test("the config file and its backup are written private (0600)", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertProvider("openai", { keys: [{ id: "k", value: "sk-REAL-private-0001" }] }))).toBe(200)
  expect((try statSync(path)).mode & 511).toBe(384)
  // a backup an older version wrote world-readable is made private on the next save
  try writeFileSync(path + ".bak", "{}")
  try chmodSync(path + ".bak", 420)
  expect(statusOf(s.upsertProvider("anthropic", { keys: [{ id: "a", value: "sk-REAL-private-0002" }] }))).toBe(200)
  expect((try statSync(path + ".bak")).mode & 511).toBe(384)
  expect((try statSync(path)).mode & 511).toBe(384)
  cleanup(path)
})

test("virtual keys: generated id and value format, masked update, refs and duplicates", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertVirtualKey({ id: "", name: "auto", value: "" }))).toBe(200)
  const vk = s.cfg.governance!.virtual_keys![0]!
  expect(vk.id.startsWith("vk-")).toBe(true)
  expect(vk.value.startsWith("sk-bf-")).toBe(true)
  expect(vk.value.byteLength).toBe(38)
  let hexOk = true
  for (const ch of vk.value.slice(6).chars()) {
    if (!"0123456789abcdef".includes(ch)) hexOk = false
  }
  expect(hexOk).toBe(true)
  const first = vk.value
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "dev", value: "" }))).toBe(200)
  const v1 = s.cfg.governance!.virtual_keys!.filter((x) => x.id === "vk1")[0]!.value
  expect(v1 === first).toBe(false)
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "dev2", value: maskSecret(v1) }))).toBe(200)
  expect(s.cfg.governance!.virtual_keys!.filter((x) => x.id === "vk1")[0]!.value).toBe(v1)
  expect(statusOf(s.upsertVirtualKey({ id: "vk2", name: "dup", value: v1 }))).toBe(409)
  expect(statusOf(s.upsertVirtualKey({ id: "vk3", name: "bad", value: "sk-x", budget_id: "nope" }))).toBe(400)
  expect(statusOf(s.deleteVirtualKey("vk1"))).toBe(200)
  expect(statusOf(s.deleteVirtualKey("vk1"))).toBe(404)
  cleanup(path)
})

test("budgets: validation, 409 when referenced, delete", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertBudget({ id: "b1", max_limit: 0.0, reset_duration: "1M" }))).toBe(400)
  expect(statusOf(s.upsertBudget({ id: "b1", max_limit: 10.0, reset_duration: "5x" }))).toBe(400)
  expect(statusOf(s.upsertBudget({ id: "b1", max_limit: 10.0, reset_duration: "m" }))).toBe(400)
  expect(statusOf(s.upsertBudget({ id: "b1", max_limit: 10.0, reset_duration: "10d" }))).toBe(200)
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "x", value: "", budget_id: "b1" }))).toBe(200)
  const r = s.deleteBudget("b1")
  expect(statusOf(r)).toBe(409)
  expect(messageOf(r).includes("vk1")).toBe(true)
  expect(statusOf(s.deleteBudget("nope"))).toBe(404)
  expect(statusOf(s.deleteVirtualKey("vk1"))).toBe(200)
  expect(statusOf(s.deleteBudget("b1"))).toBe(200)
  cleanup(path)
})

test("rate limits, teams and customers reference and delete rules", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertRateLimit({ id: "rl1", request_max_limit: 0, request_reset_duration: "1m" }))).toBe(400)
  expect(statusOf(s.upsertRateLimit({ id: "rl1" }))).toBe(400)
  expect(statusOf(s.upsertRateLimit({ id: "rl1", request_max_limit: 10, request_reset_duration: "1m" }))).toBe(200)
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "x", value: "", rate_limit_id: "rl1" }))).toBe(200)
  expect(statusOf(s.deleteRateLimit("rl1"))).toBe(409)
  expect(statusOf(s.upsertCustomer({ id: "c1", name: "acme", budget_id: "nope" }))).toBe(400)
  expect(statusOf(s.upsertCustomer({ id: "c1", name: "acme" }))).toBe(200)
  expect(statusOf(s.upsertTeam({ id: "t1", name: "core", customer_id: "c1" }))).toBe(200)
  expect(statusOf(s.upsertTeam({ id: "t2", name: "", customer_id: "c1" }))).toBe(400)
  expect(statusOf(s.deleteCustomer("c1"))).toBe(409)
  expect(statusOf(s.deleteTeam("t1"))).toBe(200)
  expect(statusOf(s.deleteCustomer("c1"))).toBe(200)
  expect(statusOf(s.deleteRateLimit("rl1"))).toBe(409)
  expect(statusOf(s.deleteVirtualKey("vk1"))).toBe(200)
  expect(statusOf(s.deleteRateLimit("rl1"))).toBe(200)
  expect(statusOf(s.deleteRateLimit("rl1"))).toBe(404)
  cleanup(path)
})

test("persistence: saved file parses back to the same config and keeps a backup", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertProvider("openai", { keys: [{ value: "env.OPENAI_KEY", models: ["gpt-4o"] }] }))).toBe(200)
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "x", value: "" }))).toBe(200)
  const text = try readFileSync(path, "utf8")
  const back = try JSON.parse(text) as Config
  expect(JSON.stringify(back, undefined, 2) === JSON.stringify(s.cfg, undefined, 2)).toBe(true)
  const reloaded = new ConfigStore(path, back)
  expect(reloaded.version).toBe(0)
  expect(JSON.stringify(reloaded.cfg, undefined, 2) === JSON.stringify(s.cfg, undefined, 2)).toBe(true)
  expect(statusOf(s.upsertProvider("anthropic", {}))).toBe(200)
  expect(try readFileSync(path + ".bak", "utf8") === text).toBe(true)
  cleanup(path)
})

test("persistence: a save is atomic, and a temporary file left by a crash is cleared at startup", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "x", value: "" }))).toBe(200)
  const saved = try readFileSync(path, "utf8")
  // a save that died before its rename: the file still holds the last complete save
  const tmp = try writeTemp(path, "{\"half\":")
  expect(try readFileSync(path, "utf8") === saved).toBe(true)
  expect(existsSync(tmp)).toBe(true)
  // a recent temporary file may be another worker's save in progress: kept
  const again = new ConfigStore(path, {})
  expect(existsSync(tmp)).toBe(true)
  expect(removeStaleTemps(path, -1.0)).toBe(1)
  expect(statusOf(again.upsertVirtualKey({ id: "vk2", name: "y", value: "" }))).toBe(200)
  expect((try readFileSync(path, "utf8")).includes("vk2")).toBe(true)
  expect(existsSync(tmp)).toBe(false)
  cleanup(path)
})

test("a failed save leaves the in-memory config and version unchanged", () => {
  const s = new ConfigStore("/nonexistent-raiju-dir/config.json", {})
  const r = s.upsertProvider("openai", { keys: [{ value: "sk-abcdefghijkl" }] })
  expect(statusOf(r)).toBe(500)
  expect(s.cfg.providers === undefined).toBe(true)
  expect(s.version).toBe(0)
})

test("a save keeps the newer retained admin credential the file holds, and the change hears the kept one", () => {
  const path = tmpPath()
  const client: McpClientConfig = { name: "jira", connection_type: "http", connection_string: "http://127.0.0.1:1/mcp", auth_type: "token_exchange", token_exchange: { audience: "api://jira", client_id: "exch" } }
  const row = (access: string, rt: string, at: f64): McpUserToken => ({ id: "exchange-jira", mcp_client_name: "jira", virtual_key_id: "", session_id: "", access_token: access, refresh_token: rt, token_expires_at: 0.0, scopes: [], created_at: 1.0, last_refreshed_at: at })
  // another worker renewed the credential (rt-2) and saved it; this copy still holds the older one (rt-1)
  try writeFileSync(path, JSON.stringify({ mcp: { client_configs: [client], exchange_admin: [row("new", "rt-2", 2000.0)] } }))
  const s = new ConfigStore(path, { mcp: { client_configs: [client], exchange_admin: [row("old", "rt-1", 1000.0)] } })
  const heard: string[] = []
  s.onChange = (c: Config) => {
    const ea = c.mcp?.exchange_admin ?? []
    if (ea.length > 0) heard.push(ea[0]!.access_token)
  }
  expect(statusOf(s.upsertBudget({ id: "b1", max_limit: 5.0, reset_duration: "1d" }))).toBe(200)
  expect(s.cfg.mcp!.exchange_admin![0]!.refresh_token).toBe("rt-2")
  expect(heard).toEqual(["new"])
  expect(try readFileSync(path, "utf8").includes("rt-2")).toBe(true)
  expect(try readFileSync(path, "utf8").includes("rt-1")).toBe(false)
  cleanup(path)
})

test("onChange runs once per successful change only", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  const seen = new Counter()
  s.onChange = (c: Config) => {
    seen.n += 1
  }
  expect(statusOf(s.upsertBudget({ id: "b1", max_limit: 0.0, reset_duration: "1d" }))).toBe(400)
  expect(seen.n).toBe(0)
  expect(statusOf(s.upsertBudget({ id: "b1", max_limit: 5.0, reset_duration: "1d" }))).toBe(200)
  expect(seen.n).toBe(1)
  expect(s.version).toBe(1)
  cleanup(path)
})

test("redaction masks keys, bedrock secrets, proxy password and virtual keys; env refs stay", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertProvider("openai", {
    keys: [{ value: "sk-abcdefghijkl" }, { value: "short" }, { value: "env.OPENAI_KEY" }],
    proxy_config: { type: "http", url: "http://p", username: "u", password: "proxy-pass-123" },
  }))).toBe(200)
  expect(statusOf(s.upsertProvider("bedrock", {
    keys: [{ value: "", bedrock_key_config: { access_key: "AKIAEXAMPLE", secret_key: "wJalrXUtnFEMI", session_token: "tok-abcdefghijk", region: "us-east-1" } }],
  }))).toBe(200)
  expect(statusOf(s.upsertVirtualKey({ id: "vk1", name: "x", value: "sk-bf-" + "f".repeat(32) }))).toBe(200)
  expect(statusOf(s.upsertVirtualKey({ id: "vk2", name: "env", value: "env.VK_SECRET" }))).toBe(200)
  const red = s.redacted()
  expect(red.includes("sk-abcdefghijkl")).toBe(false)
  expect(red.includes("sk-a…ijkl")).toBe(true)
  expect(red.includes("\"****\"")).toBe(true)
  expect(red.includes("env.OPENAI_KEY")).toBe(true)
  expect(red.includes("proxy-pass-123")).toBe(false)
  expect(red.includes("wJalrXUtnFEMI")).toBe(false)
  expect(red.includes("wJal…FEMI")).toBe(true)
  expect(red.includes("AKIAEXAMPLE")).toBe(true)
  expect(red.includes("tok-abcdefghijk")).toBe(false)
  expect(red.includes("sk-bf-" + "f".repeat(32))).toBe(false)
  expect(red.includes("sk-b…ffff")).toBe(true)
  expect(red.includes("env.VK_SECRET")).toBe(true)
  expect(maskSecret("12345678")).toBe("****")
  expect(maskSecret("123456789")).toBe("1234…6789")
  expect(maskSecret("")).toBe("")
  cleanup(path)
})

test("checkAdmin: no auth, bearer, basic, wrong credentials and partial config", () => {
  const none = new Map<string, string>()
  expect(checkAdmin(undefined, none)).toBe(true)
  expect(checkAdmin({}, none)).toBe(true)
  const auth: AdminAuth = { username: "admin", password: "secret", token: "tok-123" }
  expect(checkAdmin(auth, none)).toBe(false)
  expect(checkAdmin(auth, authHeader("Bearer tok-123"))).toBe(true)
  expect(checkAdmin(auth, authHeader("Bearer tok-12"))).toBe(false)
  expect(checkAdmin(auth, authHeader("Bearer tok-1234"))).toBe(false)
  expect(checkAdmin(auth, authHeader("Basic YWRtaW46c2VjcmV0"))).toBe(true)
  expect(checkAdmin(auth, authHeader("Basic YWRtaW46bm9wZQ=="))).toBe(false)
  expect(checkAdmin(auth, authHeader("Basic !!!"))).toBe(false)
  expect(checkAdmin(auth, authHeader("Basic dXNlcg=="))).toBe(false)
  const tokenOnly: AdminAuth = { token: "tok" }
  expect(checkAdmin(tokenOnly, authHeader("Basic YWRtaW46c2VjcmV0"))).toBe(false)
  expect(checkAdmin(tokenOnly, authHeader("Bearer "))).toBe(false)
  const partial: AdminAuth = { username: "admin" }
  expect(checkAdmin(partial, authHeader("Basic YWRtaW46c2VjcmV0"))).toBe(false)
  expect(checkAdmin(partial, none)).toBe(false)
})

test("handleApi routes, methods and status codes", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(handleApi(s, "GET", "/api/config", "").status).toBe(200)
  expect(handleApi(s, "GET", "/api/config?pretty=1", "").status).toBe(200)
  expect(handleApi(s, "GET", "/api/nothing", "").status).toBe(404)
  expect(handleApi(s, "GET", "/v1/models", "").status).toBe(404)
  expect(handleApi(s, "POST", "/api/config", "{}").status).toBe(405)
  expect(handleApi(s, "PUT", "/api/providers", "{}").status).toBe(405)
  expect(handleApi(s, "PUT", "/api/providers/openai", "not json").status).toBe(400)
  expect(handleApi(s, "PUT", "/api/providers/OpenAI", "{}").status).toBe(400)
  expect(handleApi(s, "GET", "/api/providers/openai", "").status).toBe(404)
  const put = handleApi(s, "PUT", "/api/providers/openai", "{\"keys\":[{\"value\":\"sk-abcdefghijkl\"}]}")
  expect(put.status).toBe(200)
  expect(put.body.includes("sk-abcdefghijkl")).toBe(false)
  expect(handleApi(s, "GET", "/api/providers", "").body.includes("sk-a…ijkl")).toBe(true)
  expect(handleApi(s, "GET", "/api/providers/openai/keys", "").status).toBe(200)
  expect(handleApi(s, "POST", "/api/providers/openai/keys", "{\"value\":\"sk-zzzzzzzzzzzz\"}").status).toBe(201)
  expect(handleApi(s, "PUT", "/api/providers/openai/keys/nope", "{}").status).toBe(404)
  // an alias with another provider's override is refused, as Bifrost's key routes refuse it
  const wrong = handleApi(s, "POST", "/api/providers/openai/keys", `{"value":"sk-yyyyyyyyyyyy","aliases":{"east":{"model_id":"gpt-4o","endpoint":"https://east.example.com"}}}`)
  expect(wrong.status).toBe(400)
  expect(wrong.body.includes(`Invalid aliases: alias \\"east\\": azure sub-config is only valid on Azure keys`)).toBe(true)
  expect(handleApi(s, "PUT", "/api/providers/openai", `{"keys":[{"value":"sk-abcdefghijkl","aliases":{"d":{"model_id":"x","use_deployments_endpoint":true}}}]}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/providers/nope/keys", "{\"value\":\"x\"}").status).toBe(404)
  // a jwt_bearer key with no audience is refused on save, as Bifrost's key routes refuse it
  const noAud = handleApi(s, "POST", "/api/providers/openai/keys", `{"value":"","oauth_key_config":{"grant_type":"jwt_bearer","token_url":"https://auth.example.test/token","private_key":"env.SIGNING_KEY","issuer":"svc"}}`)
  expect(noAud.status).toBe(400)
  expect(noAud.body.includes("oauth_key_config.audience is required for the jwt_bearer grant")).toBe(true)
  expect(handleApi(s, "POST", "/api/providers/openai/keys", `{"value":"","oauth_key_config":{"grant_type":"jwt_bearer","token_url":"https://auth.example.test/token","private_key":"env.SIGNING_KEY","issuer":"svc","audience":"aud","signing_algorithm":"PS384"}}`).status).toBe(201)
  expect(handleApi(s, "DELETE", "/api/providers/openai/keys/nope", "").status).toBe(404)
  expect(handleApi(s, "POST", "/api/providers/openai/keys/x", "{}").status).toBe(405)

  const vk = handleApi(s, "POST", "/api/governance/virtual-keys", "{\"name\":\"dev\"}")
  expect(vk.status).toBe(201)
  const created = try JSON.parse(vk.body) as VirtualKeyConfig
  expect(created.value.startsWith("sk-bf-")).toBe(true)
  expect(created.value.byteLength).toBe(38)
  const list = handleApi(s, "GET", "/api/governance/virtual-keys", "")
  expect(list.status).toBe(200)
  expect(list.body.includes(created.value)).toBe(false)
  const one = handleApi(s, "GET", "/api/governance/virtual-keys/" + created.id, "")
  expect(one.body.includes(created.value)).toBe(false)
  const again = handleApi(s, "PUT", "/api/governance/virtual-keys/" + created.id, "{\"name\":\"renamed\"}")
  expect(again.status).toBe(200)
  expect(again.body.includes(created.value)).toBe(false)
  expect(handleApi(s, "GET", "/api/governance/virtual-keys/nope", "").status).toBe(404)
  expect(handleApi(s, "PUT", "/api/governance/virtual-keys/" + created.id + "x", "{}").status).toBe(201)
  expect(handleApi(s, "DELETE", "/api/governance/virtual-keys/nope", "").status).toBe(404)

  expect(handleApi(s, "POST", "/api/governance/budgets", "{\"id\":\"b1\",\"max_limit\":0,\"reset_duration\":\"1d\"}").status).toBe(400)
  expect(handleApi(s, "POST", "/api/governance/budgets", "{\"id\":\"b1\",\"max_limit\":5,\"reset_duration\":\"1d\"}").status).toBe(201)
  expect(handleApi(s, "PUT", "/api/governance/budgets/b1", "{\"max_limit\":7,\"reset_duration\":\"1M\"}").status).toBe(200)
  expect(handleApi(s, "GET", "/api/governance/budgets/b1", "").status).toBe(405)
  expect(handleApi(s, "GET", "/api/governance/budgets", "").body.includes("\"b1\"")).toBe(true)
  expect(handleApi(s, "DELETE", "/api/governance/budgets/nope", "").status).toBe(404)
  expect(handleApi(s, "DELETE", "/api/governance/budgets/b1", "").status).toBe(200)
  expect(handleApi(s, "POST", "/api/governance/rate-limits", "{\"id\":\"rl\",\"request_max_limit\":3}").status).toBe(201)
  expect(handleApi(s, "PUT", "/api/governance/rate-limits/rl", "{\"token_max_limit\":100,\"token_reset_duration\":\"1h\"}").status).toBe(200)
  expect(handleApi(s, "POST", "/api/governance/teams", "{\"name\":\"core\"}").status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/customers", "{\"name\":\"acme\"}").status).toBe(201)
  expect(handleApi(s, "DELETE", "/api/governance/customers/nope", "").status).toBe(404)
  expect(handleApi(s, "GET", "/api/governance/unknown", "").status).toBe(404)
  expect(handleApi(s, "GET", "/api/governance", "").status).toBe(404)
  expect(handleApi(s, "POST", "/api/governance/virtual-keys", "not json").status).toBe(400)
  expect(handleApi(s, "DELETE", "/api/providers/openai", "").status).toBe(200)
  expect(handleApi(s, "GET", "/api/unknown", "").body.includes("\"error\"")).toBe(true)
  cleanup(path)
})

test("sections the config type doesn't know survive a save", () => {
  const path = tmpPath()
  try writeFileSync(path, `{"client":{"enable_logging":false},"guardrails_config":{"guardrail_rules":[{"id":"r1"}]},"server":{"port":1}}`)
  const s = new ConfigStore(path, { client: { enable_logging: false } })
  expect(s.rawSection("guardrails_config")).toBe(`{"guardrail_rules":[{"id":"r1"}]}`)
  try s.save()
  const saved = try readFileSync(path, "utf8")
  expect(JSON.stringify(try JSON.parse(saved) as Config).includes("enable_logging")).toBe(true)
  expect(saved.includes(`"guardrails_config": {"guardrail_rules":[{"id":"r1"}]}`)).toBe(true)
  expect(saved.includes(`"server": {"port":1}`)).toBe(true)
})

test("model configs: inline budgets and rate limit, derived ids, 409s and cleanup", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  const mc = "/api/governance/model-configs"
  const c = handleApi(s, "POST", mc, "{\"model_name\":\"gpt-4o\",\"provider\":\"openai\",\"budgets\":[{\"max_limit\":5,\"reset_duration\":\"1d\"}],\"rate_limit\":{\"request_max_limit\":10,\"request_reset_duration\":\"1m\"}}")
  expect(c.status).toBe(201)
  expect(c.body.includes("\"max_limit\":5")).toBe(true)
  expect(c.body.includes("\"request_max_limit\":10")).toBe(true)
  const idOf = try JSON.parse(c.body) as { id: string }
  const id = idOf.id
  expect(handleApi(s, "POST", mc, "{\"model_name\":\"gpt-4o\",\"provider\":\"openai\"}").status).toBe(409)
  expect(handleApi(s, "POST", mc, "{\"provider\":\"openai\"}").status).toBe(400)
  expect(handleApi(s, "POST", mc, "{\"model_name\":\"x\",\"scope\":\"virtual_key\"}").status).toBe(400)
  expect(handleApi(s, "POST", mc + "/" + id, "{}").status).toBe(405)
  expect(handleApi(s, "GET", mc, "").body.includes(id)).toBe(true)
  expect(handleApi(s, "GET", mc + "/" + id, "").status).toBe(200)
  expect(handleApi(s, "GET", mc + "/nope", "").status).toBe(404)
  // the budget it owns is in use, so the budget route refuses to drop it
  expect(handleApi(s, "DELETE", "/api/governance/budgets/" + id + "-budget-0", "").status).toBe(409)
  // PUT keeps what the body leaves out; {} clears the rate limit
  const put = handleApi(s, "PUT", mc + "/" + id, "{\"budgets\":[{\"max_limit\":7,\"reset_duration\":\"1M\"}]}")
  expect(put.status).toBe(200)
  expect(put.body.includes("gpt-4o")).toBe(true)
  expect(put.body.includes("\"max_limit\":7")).toBe(true)
  expect(put.body.includes("\"request_max_limit\":10")).toBe(true)
  expect(handleApi(s, "PUT", mc + "/" + id, "{\"rate_limit\":{}}").status).toBe(200)
  expect(handleApi(s, "GET", "/api/governance/rate-limits", "").body.includes(id + "-rate-limit")).toBe(false)
  expect(handleApi(s, "PUT", mc + "/nope", "{}").status).toBe(404)
  expect(handleApi(s, "DELETE", mc + "/" + id, "").status).toBe(200)
  expect(handleApi(s, "GET", "/api/governance/budgets", "").body.includes(id)).toBe(false)
  expect(handleApi(s, "DELETE", mc + "/" + id, "").status).toBe(404)
  cleanup(path)
})

test("provider governance: needs a provider, budgets and rate limit, delete", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  const pg = "/api/governance/providers"
  expect(handleApi(s, "PUT", pg + "/openai", "{}").status).toBe(404)
  expect(handleApi(s, "PUT", "/api/providers/openai", "{\"keys\":[{\"value\":\"sk-abcdefghijkl\"}]}").status).toBe(200)
  expect(handleApi(s, "PUT", pg + "/openai", "not json").status).toBe(400)
  expect(handleApi(s, "POST", pg, "{}").status).toBe(405)
  const put = handleApi(s, "PUT", pg + "/openai", "{\"budgets\":[{\"max_limit\":3,\"reset_duration\":\"1d\"}],\"rate_limit\":{\"request_max_limit\":2,\"request_reset_duration\":\"1m\"}}")
  expect(put.status).toBe(201)
  expect(handleApi(s, "PUT", pg + "/openai", "{\"budget\":{\"max_limit\":1,\"reset_duration\":\"1d\"},\"budgets\":[]}").status).toBe(400)
  const list = handleApi(s, "GET", pg, "")
  expect(list.body.includes("\"provider\":\"openai\"")).toBe(true)
  expect(list.body.includes("\"max_limit\":3")).toBe(true)
  expect(handleApi(s, "DELETE", pg + "/openai", "").status).toBe(200)
  expect(handleApi(s, "DELETE", pg + "/openai", "").status).toBe(404)
  expect(handleApi(s, "GET", pg, "").body.includes("openai")).toBe(false)
  cleanup(path)
})

test("pricing overrides: CRUD in Bifrost's shape, patch kept as sent", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  const po = "/api/governance/pricing-overrides"
  const bad = "{\"scope_kind\":\"global\",\"match_type\":\"exact\",\"pattern\":\"gpt-4o\",\"patch\":{\"input_cost_per_token\":0.000001}}"
  expect(handleApi(s, "POST", po, "{\"scope_kind\":\"galaxy\",\"match_type\":\"exact\",\"pattern\":\"x\",\"patch\":{}}").status).toBe(400)
  expect(handleApi(s, "POST", po, "{\"scope_kind\":\"provider\",\"match_type\":\"exact\",\"pattern\":\"x\",\"patch\":{}}").status).toBe(400)
  expect(handleApi(s, "POST", po, "{\"scope_kind\":\"global\",\"match_type\":\"wildcard\",\"pattern\":\"gpt\",\"patch\":{}}").status).toBe(400)
  expect(handleApi(s, "POST", po, "{\"scope_kind\":\"global\",\"match_type\":\"exact\",\"pattern\":\"x\",\"patch\":\"nope\"}").status).toBe(400)
  const created = handleApi(s, "POST", po, bad)
  expect(created.status).toBe(201)
  expect(created.body.includes("\"patch\":{\"input_cost_per_token\":0.000001}")).toBe(true)
  const idOf = try JSON.parse(created.body) as { id: string }
  const id = idOf.id
  expect(s.cfg.governance!.pricing_overrides!.length).toBe(1)
  const put = handleApi(s, "PUT", po + "/" + id, "{\"provider_id\":null,\"pattern\":\"gpt-4*\",\"match_type\":\"wildcard\"}")
  expect(put.status).toBe(200)
  expect(put.body.includes("gpt-4*")).toBe(true)
  expect(put.body.includes("\"patch\":{\"input_cost_per_token\":0.000001}")).toBe(true)
  expect(handleApi(s, "PUT", po + "/nope", "{}").status).toBe(404)
  expect(handleApi(s, "GET", po, "").body.includes(id)).toBe(true)
  expect(handleApi(s, "DELETE", po + "/" + id, "").status).toBe(200)
  expect(handleApi(s, "DELETE", po + "/" + id, "").status).toBe(404)
  cleanup(path)
})

test("client section: known settings with their types only", () => {
  expect(clientProblem(`{"enable_logging": false, "max_request_body_size_mb": 10, "allowed_origins": ["*"]}`)).toBe("")
  expect(clientProblem(`{"enable_logging": "yes"}`) === "").toBe(false)
  expect(clientProblem(`{"max_request_body_size_mb": -1}`) === "").toBe(false)
  expect(clientProblem(`{"allowed_origins": "*"}`) === "").toBe(false)
  expect(clientProblem(`{"mcp_server_auth_mode": "both", "oauth2_server_config": {"issuer_url": "https://gw.example"}}`)).toBe("")
  expect(clientProblem(`{"oauth2_server_config": "x"}`) === "").toBe(false)
  expect(clientProblem(`{"made_up": true}`) === "").toBe(false)
  expect(clientProblem(`[1]`) === "").toBe(false)
})

test("config put replaces only the client section", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, { providers: new Map(), otel: { endpoint: "http://c:4318/v1/traces" } })
  const r = handleApi(s, "PUT", "/api/config", `{"client_config": {"enable_logging": false, "required_headers": ["x-team"]}}`)
  expect(r.status).toBe(200)
  expect(s.cfg.client?.enable_logging).toBe(false)
  expect((s.cfg.client?.required_headers ?? [])[0] ?? "").toBe("x-team")
  expect(s.cfg.otel?.endpoint).toBe("http://c:4318/v1/traces")
  expect(handleApi(s, "PUT", "/api/config", `{"client": {"enable_logging": 1}}`).status).toBe(400)
  expect(handleApi(s, "PUT", "/api/config", `{"other": {}}`).status).toBe(400)
  expect(handleApi(s, "PUT", "/api/config", `not json`).status).toBe(400)
  const on = handleApi(s, "PUT", "/api/config", `{"client": {"refuse_unpriced_models": true}}`)
  expect(on.status).toBe(200)
  expect(s.cfg.client?.refuse_unpriced_models).toBe(true)
  expect(handleApi(s, "GET", "/api/config", "").body.includes("\"refuse_unpriced_models\":true")).toBe(true)
  expect(handleApi(s, "PUT", "/api/config", `{"client": {"refuse_unpriced_models": "yes"}}`).status).toBe(400)
  cleanup(path)
})

test("version, keys and models: masked keys, configured models in Bifrost's shape", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(statusOf(s.upsertProvider("openai", { keys: [{ id: "k1", name: "main", value: "sk-abcdefghijkl", models: ["gpt-4o", "*"] }] }))).toBe(200)
  expect(statusOf(s.upsertProvider("anthropic", { keys: [{ value: "sk-ant-xyz-12345678", models: ["claude-3-haiku", "gpt-4o"] }] }))).toBe(200)
  const v = handleApi(s, "GET", "/api/version", "")
  expect(v.status).toBe(200)
  const ks = handleApi(s, "GET", "/api/keys", "")
  expect(ks.body.includes("sk-abcdefghijkl")).toBe(false)
  expect(ks.body.includes(`"provider":"openai"`)).toBe(true)
  const all = try JSON.parse(handleApi(s, "GET", "/api/models?limit=10", "").body) as { models: { name: string, provider: string }[], total: number }
  expect(all.total).toBe(3)
  expect(all.models[0]!.name).toBe("gpt-4o")
  const one = try JSON.parse(handleApi(s, "GET", "/api/models/anthropic?query=HAIKU", "").body) as { models: { name: string, provider: string }[], total: number }
  expect(one.total).toBe(1)
  expect(one.models[0]!.provider).toBe("anthropic")
  expect(handleApi(s, "GET", "/api/models/nope", "").status).toBe(404)
  expect(handleApi(s, "POST", "/api/models", "").status).toBe(405)
  cleanup(path)
})

test("sealed secrets: the saved text hides them, and opening restores them", () => {
  const ps: Map<string, ProviderConfig> = new Map()
  ps.set("openai", { keys: [{ value: "sk-plain-123456789" }, { value: "env.OPENAI_KEY_2" }] })
  const c: Config = { providers: ps, governance: { auth_config: { username: "root", password: "pw-plain-123" } } }
  const cipher = cipherFor("a passphrase of sixteen bytes")
  const sealed = try sealConfig(c, cipher)
  const text = JSON.stringify(sealed)
  expect(text.includes("sk-plain-123456789")).toBe(false)
  expect(text.includes("pw-plain-123")).toBe(false)
  expect(text.includes("enc:v1:")).toBe(true)
  // references are not sealed, and the username is not a secret
  expect(text.includes("env.OPENAI_KEY_2")).toBe(true)
  expect(text.includes(`"root"`)).toBe(true)
  // the input is unchanged
  expect(c.providers!.get("openai")!.keys![0]!.value).toBe("sk-plain-123456789")
  const back = try openConfig(try JSON.parse(text) as Config, cipher)
  expect(back.errors.length).toBe(0)
  expect(back.cfg.providers!.get("openai")!.keys![0]!.value).toBe("sk-plain-123456789")
  expect(back.cfg.governance!.auth_config!.password).toBe("pw-plain-123")
})

test("sealed secrets: a wrong or missing key is reported, and plain text still loads", () => {
  const ps: Map<string, ProviderConfig> = new Map()
  ps.set("openai", { keys: [{ value: "sk-plain-123456789" }] })
  const sealed = try sealConfig({ providers: ps }, cipherFor("right passphrase here"))
  const parsed = try JSON.parse(JSON.stringify(sealed)) as Config
  const wrong = try openConfig(parsed, cipherFor("wrong passphrase here"))
  expect(wrong.errors.length).toBe(1)
  expect(wrong.errors[0]!.includes(`"providers.openai.keys.value" is sealed`)).toBe(true)
  const none = try openConfig(parsed, undefined)
  expect(none.errors.length).toBe(1)
  const plain = try openConfig(try JSON.parse(`{"providers":{"openai":{"keys":[{"value":"sk-old"}]}}}`) as Config, cipherFor("right passphrase here"))
  expect(plain.errors.length).toBe(0)
  expect(plain.cfg.providers!.get("openai")!.keys![0]!.value).toBe("sk-old")
  // no cipher: the config is saved as it is
  expect(JSON.stringify(try sealConfig({ providers: ps }, undefined)).includes("sk-plain-123456789")).toBe(true)
})

test("sealed secrets: the store writes sealed secrets to the file", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  s.cipher = cipherFor("a passphrase of sixteen bytes")
  expect(statusOf(s.upsertProvider("openai", { keys: [{ value: "sk-store-987654321" }] }))).toBe(200)
  const text = try readFileSync(path, "utf8")
  expect(text.includes("sk-store-987654321")).toBe(false)
  expect(text.includes("enc:v1:")).toBe(true)
  // the in-memory config keeps the plain value
  expect(s.cfg.providers!.get("openai")!.keys![0]!.value).toBe("sk-store-987654321")
  cleanup(path)
})

test("MCP client secrets and OAuth tokens are sealed at rest", () => {
  const cipher = cipherFor("a passphrase of sixteen bytes")
  const c: Config = { mcp: { client_configs: [{ name: "m", connection_type: "http", connection_string: "https://m/mcp", auth: { type: "oauth", client_secret: "cs-plain-1", access_token: "at-plain-2", refresh_token: "rt-plain-3" } }] } }
  const text = JSON.stringify(try sealConfig(c, cipher))
  expect(text.includes("rt-plain-3")).toBe(false)
  expect(text.includes("at-plain-2")).toBe(false)
  expect(text.includes("cs-plain-1")).toBe(false)
  const back = try openConfig(try JSON.parse(text) as Config, cipher)
  expect(back.errors.length).toBe(0)
  const a = back.cfg.mcp!.client_configs![0]!.auth!
  expect(a.refresh_token).toBe("rt-plain-3")
  expect(a.access_token).toBe("at-plain-2")
  expect(a.client_secret).toBe("cs-plain-1")
})

test("per-user MCP header values are sealed at rest", () => {
  const cipher = cipherFor("a passphrase of sixteen bytes")
  const hs: Map<string, string> = new Map()
  hs.set("x-tenant-key", "tenant-a-key-example")
  const uc: McpUserCredential = { id: "uc1", mcp_client_name: "m", virtual_key_id: "vk1", headers: hs, updated_at: 1.0 }
  const c: Config = { mcp: { user_credentials: [uc] } }
  const text = JSON.stringify(try sealConfig(c, cipher))
  expect(text.includes("tenant-a-key-example")).toBe(false)
  expect(text.includes("enc:v1:")).toBe(true)
  const back = try openConfig(try JSON.parse(text) as Config, cipher)
  expect(back.errors.length).toBe(0)
  expect(back.cfg.mcp!.user_credentials![0]!.headers.get("x-tenant-key")).toBe("tenant-a-key-example")
  expect(c.mcp!.user_credentials![0]!.headers.get("x-tenant-key")).toBe("tenant-a-key-example")
})

test("per-user OAuth tokens are sealed at rest", () => {
  const cipher = cipherFor("a passphrase of sixteen bytes")
  const row: McpUserToken = { id: "ut1", mcp_client_name: "m", virtual_key_id: "vk1", session_id: "", access_token: "acc-example-token", refresh_token: "ref-example-token", token_expires_at: 5.0, scopes: [], created_at: 1.0, last_refreshed_at: 1.0 }
  const c: Config = { mcp: { user_tokens: [row] } }
  const text = JSON.stringify(try sealConfig(c, cipher))
  expect(text.includes("acc-example-token")).toBe(false)
  expect(text.includes("ref-example-token")).toBe(false)
  const back = try openConfig(try JSON.parse(text) as Config, cipher)
  expect(back.errors.length).toBe(0)
  expect(back.cfg.mcp!.user_tokens![0]!.refresh_token).toBe("ref-example-token")
  expect(back.cfg.mcp!.user_tokens![0]!.access_token).toBe("acc-example-token")
})

test("a token_exchange client's admin access and refresh tokens are sealed at rest, and its status is kept", () => {
  const cipher = cipherFor("a passphrase of sixteen bytes")
  const row: McpUserToken = { id: "exchange-jira", mcp_client_name: "jira", virtual_key_id: "", session_id: "", access_token: "adm-example-token", refresh_token: "adm-refresh-example", token_expires_at: 5.0, scopes: [], created_at: 1.0, last_refreshed_at: 1.0, status: "needs_reauth", status_reason: "admin token exchange failed: revoked" }
  const c: Config = { mcp: { exchange_admin: [row] } }
  const text = JSON.stringify(try sealConfig(c, cipher))
  expect(text.includes("adm-example-token")).toBe(false)
  expect(text.includes("adm-refresh-example")).toBe(false)
  const back = try openConfig(try JSON.parse(text) as Config, cipher)
  expect(back.errors.length).toBe(0)
  const got = back.cfg.mcp!.exchange_admin![0]!
  expect(got.access_token).toBe("adm-example-token")
  expect(got.refresh_token).toBe("adm-refresh-example")
  expect(got.status).toBe("needs_reauth")
  expect(got.status_reason).toBe("admin token exchange failed: revoked")
})

test("encryption_key: an unset env reference is an error, and no key means no cipher", () => {
  const none = try cipherFromConfig({})
  expect(none === undefined).toBe(true)
  let threw = false
  try {
    cipherFromConfig({ encryption_key: "env.RAIJU_UNSET_KEY_FOR_TEST" })
  } catch (e) {
    threw = true
  }
  expect(threw).toBe(true)
  expect((try cipherFromConfig({ encryption_key: "a literal passphrase" })) !== undefined).toBe(true)
})

test("projects: Bifrost's shapes, validation and paging", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(handleApi(s, "POST", "/api/governance/budgets", `{"id":"b-proj","max_limit":5,"reset_duration":"1M"}`).status).toBe(201)
  const bad = handleApi(s, "POST", "/api/governance/projects", `{"name":"eval","access_rule":"both"}`)
  expect(bad.status).toBe(400)
  expect(handleApi(s, "POST", "/api/governance/projects", `{"name":"eval","budget_id":"nope"}`).status).toBe(400)
  const made = handleApi(s, "POST", "/api/governance/projects", `{"id":"p1","name":"eval","budget_id":"b-proj","provider_configs":[{"provider":"anthropic"}]}`)
  expect(made.status).toBe(201)
  expect(made.body.includes(`"project":{`)).toBe(true)
  expect(made.body.includes(`"access_rule":"union"`)).toBe(true)
  expect(made.body.includes(`"accounting_mode":"both"`)).toBe(true)
  expect(handleApi(s, "POST", "/api/governance/projects", `{"id":"p2","name":"eval"}`).status).toBe(400)
  const list = handleApi(s, "GET", "/api/governance/projects?limit=1", "")
  expect(list.body.includes(`"projects":[{"id":"p1"`)).toBe(true)
  expect(list.body.includes(`"pagination":{"limit":1,"offset":0,"total_count":1}`)).toBe(true)
  expect(handleApi(s, "GET", "/api/governance/projects?search=zzz", "").body.includes(`"total_count":0`)).toBe(true)
  expect(handleApi(s, "GET", "/api/governance/projects/p1", "").status).toBe(200)
  expect(handleApi(s, "PUT", "/api/governance/projects/p1", `{"name":"eval","budget_id":"b-proj","is_active":false}`).status).toBe(200)
  expect(handleApi(s, "GET", "/api/governance/projects?is_active=true", "").body.includes(`"total_count":0`)).toBe(true)
  // the project's budget cannot be deleted while the project uses it
  expect(handleApi(s, "DELETE", "/api/governance/budgets/b-proj", "").status).toBe(409)
  expect(handleApi(s, "DELETE", "/api/governance/projects/p1", "").status).toBe(200)
  expect(handleApi(s, "DELETE", "/api/governance/budgets/b-proj", "").status).toBe(200)
  expect(handleApi(s, "GET", "/api/governance/projects/p1", "").status).toBe(404)
  cleanup(path)
})

test("business units: teams follow the unit, and the unit's budget is protected", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(handleApi(s, "POST", "/api/governance/budgets", `{"id":"b-bu","max_limit":5,"reset_duration":"1M"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/teams", `{"id":"t1","name":"core"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/teams", `{"id":"t2","name":"data"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/business-units", `{"id":"bu1","name":"emea","team_ids":["nope"]}`).status).toBe(400)
  const made = handleApi(s, "POST", "/api/governance/business-units", `{"id":"bu1","name":"emea","budget_id":"b-bu","team_ids":["t1"]}`)
  expect(made.status).toBe(201)
  expect(handleApi(s, "GET", "/api/governance/teams/t1", "").body.includes(`"business_unit_id":"bu1"`)).toBe(true)
  expect(handleApi(s, "DELETE", "/api/governance/budgets/b-bu", "").status).toBe(409)
  // moving the unit's teams: t2 joins, t1 leaves
  expect(handleApi(s, "PUT", "/api/governance/business-units/bu1", `{"name":"emea","budget_id":"b-bu","team_ids":["t2"]}`).status).toBe(200)
  expect(handleApi(s, "GET", "/api/governance/teams/t1", "").body.includes(`"business_unit_id"`)).toBe(false)
  expect(handleApi(s, "GET", "/api/governance/teams/t2", "").body.includes(`"business_unit_id":"bu1"`)).toBe(true)
  const list = handleApi(s, "GET", "/api/governance/business-units", "")
  expect(list.body.includes(`"business_units":[{"id":"bu1"`)).toBe(true)
  expect(list.body.includes(`"count":1,"total_count":1,"limit":25,"offset":0`)).toBe(true)
  expect(handleApi(s, "DELETE", "/api/governance/business-units/bu1", "").status).toBe(200)
  expect(handleApi(s, "GET", "/api/governance/teams/t2", "").body.includes(`"business_unit_id"`)).toBe(false)
  expect(handleApi(s, "POST", "/api/governance/teams", `{"id":"t3","name":"x","business_unit_id":"nope"}`).status).toBe(400)
  cleanup(path)
})

test("custom roles: built-in names are reserved, dac and permissions are checked, held roles stay", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(handleApi(s, "POST", "/api/roles", `{"name":"admin"}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/roles", `{"name":"x","dac":"galaxy-data"}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/roles", `{"name":"x","permissions":[{"resource":"Widgets","operation":"View"}]}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/roles", `{"name":"x","permissions":[{"resource":"Logs","operation":"Fly"}]}`).status).toBe(400)
  const made = handleApi(s, "POST", "/api/roles", `{"name":"ops","dac":"team-data","permissions":[{"resource":"Teams","operation":"View"}]}`)
  expect(made.status).toBe(201)
  expect(made.body.includes(`"dac":"team-data"`)).toBe(true)
  expect(handleApi(s, "GET", "/api/roles", "").body.includes(`"roles":[{"id":1,"name":"ops"`)).toBe(true)
  expect(handleApi(s, "GET", "/api/roles/ops", "").status).toBe(200)
  expect(handleApi(s, "GET", "/api/roles/admin", "").body.includes(`"id":9001,"name":"admin"`)).toBe(true)
  expect(handleApi(s, "PUT", "/api/roles/ops", `{"dac":"all-data","permissions":[{"resource":"Teams","operation":"Update"}]}`).status).toBe(200)
  expect(handleApi(s, "GET", "/api/roles/ops", "").body.includes(`"operation":"Update"`)).toBe(true)
  expect(handleApi(s, "DELETE", "/api/roles/ops", "").status).toBe(200)
  expect(handleApi(s, "GET", "/api/roles/ops", "").status).toBe(404)
  cleanup(path)
})

test("data access scope: a scoped user lists, reads and edits only its own teams, customers and keys", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  expect(handleApi(s, "POST", "/api/governance/customers", `{"id":"c1","name":"acme"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/customers", `{"id":"c2","name":"globex"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/teams", `{"id":"t1","name":"core","customer_id":"c1"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/teams", `{"id":"t2","name":"other","customer_id":"c2"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/virtual-keys", `{"id":"vk1","name":"one","team_id":"t1"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/virtual-keys", `{"id":"vk2","name":"two","team_id":"t2"}`).status).toBe(201)
  const scope = scopeOf(s.cfg.governance ?? {}, { name: "ann", role: "ops", teams: ["t1"] }, "team-data")
  // lists
  const teams = handleApi(s, "GET", "/api/governance/teams", "", scope).body
  expect(teams.includes(`"id":"t1"`)).toBe(true)
  expect(teams.includes(`"id":"t2"`)).toBe(false)
  const keys = handleApi(s, "GET", "/api/governance/virtual-keys", "", scope).body
  expect(keys.includes(`"id":"vk1"`)).toBe(true)
  expect(keys.includes(`"id":"vk2"`)).toBe(false)
  // one record it does not own looks absent
  expect(handleApi(s, "GET", "/api/governance/teams/t2", "", scope).status).toBe(404)
  expect(handleApi(s, "DELETE", "/api/governance/virtual-keys/vk2", "", scope).status).toBe(404)
  expect(handleApi(s, "GET", "/api/governance/customers", "", scope).body.includes(`"id":"c2"`)).toBe(false)
  // it edits its own team, and creates nothing
  expect(handleApi(s, "PUT", "/api/governance/teams/t1", `{"name":"core-2"}`, scope).status).toBe(200)
  expect(handleApi(s, "POST", "/api/governance/teams", `{"id":"t9","name":"new"}`, scope).status).toBe(403)
  expect(handleApi(s, "GET", "/api/governance/budgets", "", scope).status).toBe(403)
  // all data sees everything
  expect(handleApi(s, "GET", "/api/governance/teams", "", allScope()).body.includes(`"id":"t2"`)).toBe(true)
  cleanup(path)
})

