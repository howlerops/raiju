test("business-unit members carry their source; admins add and remove manual ones, not synced ones", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, { governance: {
    business_units: [{ id: "bu1", name: "Research" }],
    users: [{ name: "ana", role: "editor", business_units: ["bu1"], synced: { business_units: ["bu1"] } }, { name: "bo", email: "Bo@x.io", role: "viewer" }],
    teams: [{ id: "t1", name: "core" }],
  } })
  let g = gov(s.cfg)
  let us = g.users ?? []
  let first = us[0]!
  first.teams = ["t1"]
  first.scim_groups = ["t1"]
  us[0] = first
  g.users = us
  let n: Config = s.cfg
  n.governance = g
  s.cfg = n
  const list = handleApi(s, "GET", "/api/governance/business-units/bu1/users", "")
  expect(list.status === 200 && list.body.includes(`"user_id":"ana"`) && list.body.includes(`"source":"synced"`)).toBe(true)
  const add = handleApi(s, "POST", "/api/governance/business-units/bu1/users", `{"user_ids":["bo@x.io"]}`)
  expect(add.status === 200 && add.body.includes(`{"user_id":"bo","user_name":"bo","user_email":"Bo@x.io","source":"manual"}`)).toBe(true)
  expect(handleApi(s, "POST", "/api/governance/business-units/bu1/users", `{"user_ids":["nobody"]}`).status).toBe(400)
  expect(handleApi(s, "DELETE", "/api/governance/business-units/bu1/users/ana", "").status).toBe(409)
  expect(handleApi(s, "DELETE", "/api/governance/business-units/bu1/users/bo", "").status).toBe(200)
  expect(handleApi(s, "DELETE", "/api/governance/business-units/bu1/users/bo", "").status).toBe(404)
  expect(handleApi(s, "GET", "/api/governance/business-units/nope/users", "").status).toBe(404)
  expect(handleApi(s, "GET", "/api/governance/teams/t1/members", "").body.includes(`"source":"synced"`)).toBe(true)
  cleanup(path)
})

test("a provisioning save removes the removed users' keys and project memberships", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, { governance: {
    users: [{ name: "ana", role: "editor" }, { name: "bo", role: "viewer" }],
    virtual_keys: [{ id: "vk-a", value: "sk-bf-a", user_id: "ana" }, { id: "vk-b", value: "sk-bf-b", user_id: "bo" }],
    projects: [{ id: "p1", name: "P", members: [{ id: "m1", user_id: "ana" }, { id: "m2", user_id: "bo" }] }],
  } })
  expect(statusOf(s.setProvisioned([{ name: "bo", role: "viewer" }], [], [], ["ana"]))).toBe(200)
  const g = gov(s.cfg)
  expect((g.virtual_keys ?? []).map((k) => k.id).join(",")).toBe("vk-b")
  expect(((g.projects ?? [])[0]!.members ?? []).map((m) => m.user_id).join(",")).toBe("bo")
  cleanup(path)
})

test("project members: the roster, member caps under split none, and refusals under equal", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, { governance: {
    budgets: [{ id: "b-pm", max_limit: 100.0, reset_duration: "1M" }],
    users: [{ name: "ana", role: "editor" }, { name: "bo", role: "viewer" }],
  } })
  expect(handleApi(s, "POST", "/api/governance/projects", `{"id":"pm","name":"pm","budget_id":"b-pm"}`).status).toBe(201)
  const add = handleApi(s, "POST", "/api/governance/projects/pm/members", `{"members":[{"user_id":"ana"},{"user_id":"ana"},{"user_id":"bo"}]}`)
  expect(add.status).toBe(201)
  expect(add.body.includes(`"user_id":"ana"`)).toBe(true)
  expect(handleApi(s, "POST", "/api/governance/projects/pm/members", `{"members":[{"user_id":"nobody"}]}`).status).toBe(400)
  const list = handleApi(s, "GET", "/api/governance/projects/pm/members", "")
  expect(list.body.includes(`"total_count":2`)).toBe(true)
  const mid = (s.cfg.governance?.projects ?? [])[0]!.members![0]!.id
  // a member's own cap: a percent of a budget the project holds
  expect(handleApi(s, "PUT", `/api/governance/projects/pm/members/${mid}`, `{"budget_shares":[{"source_budget_id":"b-other","share_value":10,"share_type":"percent"}]}`).status).toBe(400)
  expect(handleApi(s, "PUT", `/api/governance/projects/pm/members/${mid}`, `{"budget_shares":[{"source_budget_id":"b-pm","share_value":150,"share_type":"percent"}]}`).status).toBe(400)
  const cap = handleApi(s, "PUT", `/api/governance/projects/pm/members/${mid}`, `{"budget_shares":[{"source_budget_id":"b-pm","share_value":25,"share_type":"percent"}]}`)
  expect(cap.status).toBe(200)
  expect(cap.body.includes(`"share_value":25`)).toBe(true)
  // a project edit keeps the roster and the caps
  expect(handleApi(s, "PUT", "/api/governance/projects/pm", `{"name":"pm","budget_id":"b-pm"}`).status).toBe(200)
  expect((s.cfg.governance?.projects ?? [])[0]!.members!.length).toBe(2)
  // equal split: the hand-written caps go, and caps are refused
  expect(handleApi(s, "PUT", "/api/governance/projects/pm", `{"name":"pm","budget_id":"b-pm","split_policy":"equal"}`).status).toBe(200)
  expect((s.cfg.governance?.projects ?? [])[0]!.members![0]!.budget_shares).toBeUndefined()
  expect(handleApi(s, "PUT", `/api/governance/projects/pm/members/${mid}`, `{"budget_shares":[]}`).status).toBe(400)
  expect(handleApi(s, "PUT", "/api/governance/projects/pm", `{"name":"pm","split_policy":"weekly"}`).status).toBe(400)
  // removing a member takes the member away
  expect(handleApi(s, "DELETE", `/api/governance/projects/pm/members/${mid}`, "").status).toBe(200)
  expect(handleApi(s, "GET", `/api/governance/projects/pm/members/${mid}`, "").status).toBe(404)
  expect(handleApi(s, "GET", "/api/governance/projects/pm/members", "").body.includes(`"total_count":1`)).toBe(true)
  cleanup(path)
})

test("project members: rate limit shares are checked against the limits the project holds", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, { governance: {
    budgets: [{ id: "b-pm", max_limit: 100.0, reset_duration: "1M" }],
    rate_limits: [{ id: "rl-pm", token_max_limit: 1000, token_reset_duration: "1d", request_max_limit: 10, request_reset_duration: "1m" }, { id: "rl-free", request_max_limit: 5 }, { id: "rl-small", request_max_limit: 1 }],
    users: [{ name: "ana", role: "editor" }, { name: "bo", role: "viewer" }],
  } })
  expect(handleApi(s, "POST", "/api/governance/projects", `{"id":"pm","name":"pm","budget_id":"b-pm","rate_limit_id":"rl-pm"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/projects/pm/members", `{"members":[{"user_id":"ana"}]}`).status).toBe(201)
  const mid = (s.cfg.governance?.projects ?? [])[0]!.members![0]!.id
  const url = `/api/governance/projects/pm/members/${mid}`
  // a limit the project does not hold, a share with no count named, a percent over 100, and a percent with no whole request
  expect(handleApi(s, "PUT", url, `{"rate_limit_shares":[{"source_rate_limit_id":"rl-free","request_share":2}]}`).status).toBe(400)
  expect(handleApi(s, "PUT", url, `{"rate_limit_shares":[{"source_rate_limit_id":"rl-pm"}]}`).status).toBe(400)
  expect(handleApi(s, "PUT", url, `{"rate_limit_shares":[{"source_rate_limit_id":"rl-pm","token_share":150,"token_share_type":"percent"}]}`).status).toBe(400)
  expect(handleApi(s, "PUT", url, `{"rate_limit_shares":[{"source_rate_limit_id":"rl-pm","request_share":5,"request_share_type":"percent"}]}`).status).toBe(400)
  const ok = handleApi(s, "PUT", url, `{"rate_limit_shares":[{"source_rate_limit_id":"rl-pm","token_share":30,"token_share_type":"percent","request_share":2}]}`)
  expect(ok.status).toBe(200)
  expect(ok.body.includes(`"request_share":2`)).toBe(true)
  expect((s.cfg.governance?.projects ?? [])[0]!.members![0]!.rate_limit_shares!.length).toBe(1)
  // an equal split: a limit with fewer requests than members is refused, and the member caps go
  expect(handleApi(s, "POST", "/api/governance/projects", `{"id":"pe","name":"pe","rate_limit_id":"rl-small","split_policy":"equal"}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/governance/projects/pe/members", `{"members":[{"user_id":"ana"},{"user_id":"bo"}]}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/governance/projects/pe/members", `{"members":[{"user_id":"ana"}]}`).status).toBe(201)
  expect(handleApi(s, "PUT", "/api/governance/projects/pm", `{"name":"pm","budget_id":"b-pm","rate_limit_id":"rl-pm","split_policy":"equal"}`).status).toBe(200)
  expect((s.cfg.governance?.projects ?? [])[0]!.members![0]!.rate_limit_shares).toBeUndefined()
  expect(handleApi(s, "PUT", url, `{"rate_limit_shares":[]}`).status).toBe(400)
  cleanup(path)
})

test("roles by id: Bifrost's shape, partial updates, and access profile attachments", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, { governance: {
    users: [{ name: "ana", role: "ops", access_profile_ids: ["p-own"] }],
    access_profiles: [{ id: "p-role", allowed_models: ["openai/*"] }, { id: "p-own" }],
  } })
  expect(handleApi(s, "POST", "/api/roles", `{"name":"ops","dac":"team-data","permissions":[{"resource":"Teams","operation":"View"}]}`).status).toBe(201)
  expect(handleApi(s, "POST", "/api/roles", `{"name":"42"}`).status).toBe(400)
  expect((s.cfg.governance?.roles ?? [])[0]!.id).toBe(1)
  const got = handleApi(s, "GET", "/api/governance/rbac/roles/1", "")
  expect(got.status).toBe(200)
  expect(got.body.startsWith(`{"role":{"id":1,"name":"ops"`)).toBe(true)
  expect(handleApi(s, "GET", "/api/governance/rbac/roles/9", "").status).toBe(404)
  // a partial update keeps what it leaves out; an empty description clears it
  expect(handleApi(s, "PUT", "/api/governance/rbac/roles/1", `{"description":"on call"}`).status).toBe(200)
  const kept = handleApi(s, "GET", "/api/governance/rbac/roles/1", "").body
  expect(kept.includes(`"dac":"team-data"`)).toBe(true)
  expect(kept.includes(`"description":"on call"`)).toBe(true)
  expect(kept.includes(`"operation":"View"`)).toBe(true)
  expect(handleApi(s, "PUT", "/api/governance/rbac/roles/1", `{"description":""}`).status).toBe(200)
  expect(handleApi(s, "GET", "/api/governance/rbac/roles/1", "").body.includes(`"description"`)).toBe(false)
  expect(handleApi(s, "PUT", "/api/governance/rbac/roles/1", `{"name":"renamed"}`).status).toBe(400)
  expect(handleApi(s, "PUT", "/api/governance/rbac/roles/1", `{"dac":"galaxy-data"}`).status).toBe(400)
  // the name route answers the same role in its own shape, with the id added
  expect(handleApi(s, "GET", "/api/roles/ops", "").body.startsWith(`{"id":1,"name":"ops"`)).toBe(true)
  // the permissions of a role by id
  expect(handleApi(s, "GET", "/api/governance/rbac/roles/1/permissions", "").body.includes(`"resource":"Teams"`)).toBe(true)
  // a role's id is kept when it is saved again, and a new role takes the next id
  expect(handleApi(s, "POST", "/api/roles", `{"name":"temp"}`).status).toBe(201)
  expect((s.cfg.governance?.roles ?? [])[1]!.id).toBe(2)
  // attach a profile to roles: an id must name a custom role, and the profile keeps the attachment on update
  expect(s.attachProfileRoles("p-role", [7], undefined, true).kind).toBe("error")
  expect(s.attachProfileRoles("p-role", [1], true, true).kind).toBe("ok")
  expect(s.attachProfileRoles("p-role", [2], undefined, true).kind).toBe("ok")
  const held = (s.cfg.governance?.access_profiles ?? [])[0]!.roles ?? []
  expect(held.length).toBe(2)
  expect(held[0]!.is_default).toBe(true)
  expect(s.detachProfileRole("p-role", 9).kind).toBe("error")
  expect(s.detachProfileRole("p-role", 2).kind).toBe("ok")
  expect(((s.cfg.governance?.access_profiles ?? [])[0]!.roles ?? []).length).toBe(1)
  // a role with a user on it cannot go; one that is only attached to a profile goes and takes its attachment
  expect(handleApi(s, "DELETE", "/api/roles/ops", "").status).toBe(409)
  expect(s.attachProfileRoles("p-role", [2], undefined, true).kind).toBe("ok")
  expect(handleApi(s, "DELETE", "/api/roles/temp", "").status).toBe(200)
  expect(((s.cfg.governance?.access_profiles ?? [])[0]!.roles ?? []).length).toBe(1)
  expect(handleApi(s, "DELETE", "/api/governance/rbac/roles/1", "").status).toBe(409)
  cleanup(path)
})

test("roles: entity_dac is read as Bifrost's object and shown the same way", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  const made = handleApi(s, "POST", "/api/roles", `{"name":"acct","dac":"team-data","entity_dac":{"Projects":"all-data","Logs":"own-data"},"permissions":[]}`)
  expect(made.status).toBe(201)
  expect(made.body.includes(`"entity_dac":{"Projects":"all-data","Logs":"own-data"}`)).toBe(true)
  expect(handleApi(s, "POST", "/api/roles", `{"name":"bad","entity_dac":{"Projects":"weekly"}}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/roles", `{"name":"bad2","entity_dac":{"Nope":"all-data"}}`).status).toBe(400)
  expect(handleApi(s, "POST", "/api/roles", `{"name":"bad3","entity_dac":{"Logs":5}}`).status).toBe(400)
  const put = handleApi(s, "PUT", "/api/roles/acct", `{"dac":"own-data"}`)
  expect(put.status).toBe(200)
  expect(put.body.includes(`"entity_dac":{}`)).toBe(true)
  expect(handleApi(s, "GET", "/api/roles", "").body.includes(`"name":"acct"`)).toBe(true)
  cleanup(path)
})

test("built-in roles: listed first on Bifrost's path with fixed ids, readable by id, editable, not deletable", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, { governance: { access_profiles: [{ id: "p-view" }] } })
  expect(handleApi(s, "POST", "/api/roles", `{"name":"ops"}`).status).toBe(201)
  const list = handleApi(s, "GET", "/api/governance/rbac/roles", "").body
  expect(list.startsWith(`{"roles":[{"id":9001,"name":"admin"`)).toBe(true)
  expect(list.includes(`"id":9003,"name":"viewer"`)).toBe(true)
  expect(list.includes(`"is_system_role":true`)).toBe(true)
  expect(list.includes(`{"id":1,"name":"ops","is_system_role":false`)).toBe(true)
  // the old path keeps listing the custom roles only
  expect(handleApi(s, "GET", "/api/roles", "").body.includes("viewer")).toBe(false)
  const one = handleApi(s, "GET", "/api/governance/rbac/roles/9004", "")
  expect(one.status).toBe(200)
  expect(one.body.includes(`{"resource":"AuditLogs","operation":"View"}`)).toBe(true)
  expect(one.body.includes(`"Create"`)).toBe(false)
  const perms = handleApi(s, "GET", "/api/governance/rbac/roles/9004/permissions", "").body
  expect(perms.includes(`"role":"auditor"`)).toBe(true)
  expect(perms.includes(`"resource":"AuditLogs","operation":"View"`)).toBe(true)
  expect(handleApi(s, "DELETE", "/api/governance/rbac/roles/9001", "").status).toBe(403)
  // as in Bifrost a system role's permissions and description are edited; it keeps its id and its place
  const ed = handleApi(s, "PUT", "/api/governance/rbac/roles/9002", `{"description":"x","dac":"team-data"}`)
  expect(ed.status).toBe(200)
  expect(ed.body.startsWith(`{"role":{"id":9002,"name":"editor","description":"x","is_system_role":true,"dac":"team-data"`)).toBe(true)
  expect(ed.body.includes(`{"resource":"VirtualKeys","operation":"Create"}`)).toBe(true)
  expect(handleApi(s, "PUT", "/api/governance/rbac/roles/9002", `{"name":"boss"}`).status).toBe(400)
  const pp = handleApi(s, "PUT", "/api/governance/rbac/roles/9002/permissions", `{"permission_ids":[1]}`)
  expect(pp.status).toBe(200)
  expect(pp.body).toBe(`{"role":"editor","permissions":[{"id":1,"resource":"Logs","operation":"View"}]}`)
  expect(handleApi(s, "PUT", "/api/governance/rbac/roles/9002/permissions", `{"permission_ids":[99999]}`).status).toBe(400)
  const after = handleApi(s, "GET", "/api/governance/rbac/roles", "").body
  expect(after.startsWith(`{"roles":[{"id":9001,"name":"admin"`)).toBe(true)
  expect(after.includes(`{"id":9002,"name":"editor","description":"x","is_system_role":true,"dac":"team-data","permissions":[{"resource":"Logs","operation":"View"}]`)).toBe(true)
  expect(handleApi(s, "GET", "/api/roles", "").body.includes("editor")).toBe(false)
  expect(handleApi(s, "GET", "/api/roles/editor", "").body.includes(`"description":"x"`)).toBe(true)
  expect(handleApi(s, "DELETE", "/api/governance/rbac/roles/9002", "").status).toBe(403)
  expect(handleApi(s, "DELETE", "/api/roles/editor", "").status).toBe(403)
  // a custom role cannot take a built-in name; the admin keeps the right to change roles
  expect(handleApi(s, "POST", "/api/roles", `{"name":"viewer"}`).status).toBe(400)
  expect(handleApi(s, "PUT", "/api/governance/rbac/roles/9001/permissions", `{"permission_ids":[1]}`).status).toBe(400)
  // a profile attaches to a built-in role by its id
  expect(s.attachProfileRoles("p-view", [9003], undefined, true).kind).toBe("ok")
  expect(s.attachProfileRoles("p-view", [9100], undefined, true).kind).toBe("error")
  cleanup(path)
})

test("rotate replies name the rotated keys", () => {
  expect(rotatedKeyIds(`{"message":"ok","virtual_key":{"id":"vk-1","value":"sk-bf-x"}}`).join(",")).toBe("vk-1")
  expect(rotatedKeyIds(`{"message":"ok","virtual_keys":[{"id":"a"},{"id":"b"}],"errors":{"c":"no"}}`).join(",")).toBe("a,b")
  expect(rotatedKeyIds("not json").length).toBe(0)
  expect(isRotatePath("/api/governance/virtual-keys/rotate")).toBe(true)
  expect(isRotatePath("/api/governance/virtual-keys/vk-1/rotate")).toBe(true)
  expect(isRotatePath("/api/governance/virtual-keys/vk-1")).toBe(false)
})

test("complexity status routes: disabled, warming before the first classified request, and the generation guards", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, {})
  const off = handleApi(s, "GET", "/api/routing/complexity-analyzer-status", "")
  expect(off.status).toBe(200)
  expect(off.body.startsWith(`{"state":"disabled","loaded":0,"total":0,"cached_phrases":0,"llm":{"state":"disabled"}`)).toBe(true)
  expect(off.body.includes(`"decision_defaults":{"criteria":{"SIMPLE":`)).toBe(true)
  expect(handleApi(s, "POST", "/api/routing/complexity-analyzer-status/retry", "").status).toBe(503)
  expect(handleApi(s, "GET", "/api/routing/complexity-analyzer-generations", "").body).toBe(`{"generations":[]}`)
  expect(handleApi(s, "DELETE", "/api/routing/complexity-analyzer-generations/other", "").status).toBe(400)
  expect(handleApi(s, "GET", "/api/governance/complexity-analyzer-status", "").status).toBe(404)
  expect(s.setComplexity({ enabled: true, classifier: "semantic", semantic: { embedding_model: "e", exemplars: { simple: ["hi"], medium: ["sum"], complex: ["design"] } } }).kind).toBe("ok")
  const warm = handleApi(s, "GET", "/api/routing/complexity-analyzer-status", "").body
  expect(warm.startsWith(`{"state":"warming","loaded":0,"total":3,"cached_phrases":0`)).toBe(true)
  // nothing failed, so there is nothing to retry
  expect(handleApi(s, "POST", "/api/routing/complexity-analyzer-status/retry", "").status).toBe(409)
  expect(handleApi(s, "DELETE", "/api/routing/complexity-analyzer-generations/BifrostComplexityRouter_00", "").status).toBe(200)
  cleanup(path)
})

test("a user's budget override on a profile they hold is kept on the user, and refused for any other budget", () => {
  const path = tmpPath()
  const s = new ConfigStore(path, { governance: {
    users: [{ name: "ana", role: "viewer", access_profile_ids: ["p"] }, { name: "bo", role: "viewer" }],
    access_profiles: [{ id: "p", budget_id: "b-p" }, { id: "q" }],
    budgets: [{ id: "b-p", max_limit: 10.0, reset_duration: "1d" }, { id: "b-x", max_limit: 1.0, reset_duration: "1d" }],
  } })
  expect(s.setUserBudgetOverride("ana", "p", "b-p", { amount: 5.0, mode: "cycles", cycles: 2 }).kind).toBe("ok")
  const ana = (s.cfg.governance?.users ?? [])[0]!
  const o = (ana.budget_overrides ?? [])[0]!
  expect(o.override.amount).toBe(5.0)
  expect(o.override.started_at !== undefined).toBe(true)
  // a second save replaces it; a clear removes it
  expect(s.setUserBudgetOverride("ana", "p", "b-p", { amount: 7.0, mode: "forever" }).kind).toBe("ok")
  expect(((s.cfg.governance?.users ?? [])[0]!.budget_overrides ?? []).length).toBe(1)
  expect(s.setUserBudgetOverride("ana", "p", "b-x", { amount: 1.0, mode: "forever" }).kind).toBe("error")
  expect(s.setUserBudgetOverride("bo", "p", "b-p", { amount: 1.0, mode: "forever" }).kind).toBe("error")
  expect(s.setUserBudgetOverride("zed", "p", "b-p", { amount: 1.0, mode: "forever" }).kind).toBe("error")
  expect(s.setUserBudgetOverride("ana", "p", "b-p", undefined).kind).toBe("ok")
  expect((s.cfg.governance?.users ?? [])[0]!.budget_overrides).toBeUndefined()
  cleanup(path)
})

test("a save puts its generation on the cluster state, and a sibling store takes it from the shared file", () => {
  const path = tmpPath()
  try writeFileSync(path, `{"governance":{"virtual_keys":[{"id":"vk-1","value":"sk-bf-1"},{"id":"vk-2","value":"sk-bf-2"}]},"guardrails_config":{"x":1}}`)
  const first = try loadRawConfig(path)
  const a = new ConfigStore(path, first)
  const b = new ConfigStore(path, first)
  expect(a.fileSha).toBe(b.fileSha)
  let saved = 0
  a.onSaved = () => {
    saved += 1
  }
  let applied: string[] = []
  b.onChange = (c) => {
    applied.push((c.governance?.virtual_keys ?? []).map((v) => v.id).join(","))
  }
  expect(handleApi(a, "DELETE", "/api/governance/virtual-keys/vk-1", "").status).toBe(200)
  expect(saved).toBe(1)
  const g = genOf(clusterState().get(CONFIG_NS, CONFIG_KEY) ?? "")
  expect(g !== undefined && g.sha === a.fileSha).toBe(true)
  expect(a.fileSha).toBe(textSha(try readFileSync(path, "utf8")))
  const r = b.takeGeneration(a.fileSha)
  expect(r.status).toBe("reloaded")
  expect(applied).toEqual(["vk-2"])
  expect((b.cfg.governance?.virtual_keys ?? []).length).toBe(1)
  expect(b.version).toBe(1)
  // the section Config does not model stays with the adopted config
  expect(b.rawSection("guardrails_config")).toBe(`{"x":1}`)
  // the same generation again changes nothing
  expect(b.takeGeneration(a.fileSha).status).toBe("same")
  expect(applied.length).toBe(1)
  // a generation the file does not hold (another node's own file) is left to the caller
  expect(b.takeGeneration("0".repeat(64)).status).toBe("differs")
  // a broken file is an error, and the config held stays
  try writeFileSync(path, "{broken")
  expect(b.takeGeneration(textSha("{broken")).status).toBe("error")
  expect((b.cfg.governance?.virtual_keys ?? []).length).toBe(1)
  cleanup(path)
})

test("a pulled generation keeps this node's cluster section, is written to the file and is served as its writer saved it", () => {
  const path = tmpPath()
  try writeFileSync(path, `{"cluster":{"enabled":true,"node_id":"b","peers":["http://a"],"secret":"s"},"governance":{"virtual_keys":[{"id":"vk-1","value":"sk-bf-1"}]}}`)
  const b = new ConfigStore(path, try loadRawConfig(path))
  let applied = 0
  b.onChange = (c) => {
    applied += 1
  }
  const theirs = `{"cluster":{"enabled":true,"node_id":"a","peers":["http://b"],"secret":"s"},"governance":{"virtual_keys":[{"id":"vk-9","value":"sk-bf-9"}]}}` + "\n"
  const sha = textSha(theirs)
  expect(b.adoptPulled(theirs, "f".repeat(64)) !== "").toBe(true)
  expect(applied).toBe(0)
  expect(b.adoptPulled(theirs, sha)).toBe("")
  expect(applied).toBe(1)
  expect(b.fileSha).toBe(sha)
  expect(b.genText).toBe(theirs)
  expect(b.cfg.cluster?.node_id ?? "").toBe("b")
  expect((b.cfg.governance?.virtual_keys ?? [])[0]?.id ?? "").toBe("vk-9")
  const written = try loadRawConfig(path)
  expect(written.cluster?.node_id ?? "").toBe("b")
  expect(written.cluster?.peers ?? []).toEqual(["http://a"])
  expect((written.governance?.virtual_keys ?? [])[0]?.id ?? "").toBe("vk-9")
  // the generation is held now, whatever the local file's own hash
  expect(b.takeGeneration(sha).status).toBe("same")
  cleanup(path)
})

test("withOwnCluster swaps the cluster section (Bifrost's cluster_config too) and genOf refuses what is not a generation", () => {
  const t = try withOwnCluster(`{"a":1,"cluster_config":{"x":1},"cluster":{"node_id":"a"}}`, `{"node_id":"b"}`)
  expect(t).toBe(`{"a":1,"cluster":{"node_id":"b"}}`)
  expect(try withOwnCluster(`{"a":1,"cluster":{"node_id":"a"}}`, undefined)).toBe(`{"a":1}`)
  expect(genOf("not json") === undefined).toBe(true)
  expect(genOf(`{"sha":"abc","node":"n"}`) === undefined).toBe(true)
  expect(genOf(JSON.stringify({ sha: "a".repeat(64), node: "" })) === undefined).toBe(true)
  expect(genOf(JSON.stringify({ sha: "a".repeat(64), node: "n" }))?.node ?? "").toBe("n")
})

test("every per-key block survives the key routes, and masked secrets inside a block keep the stored values", () => {
  const path = tmpPath()
  try {
    const s = new ConfigStore(path, {})
    expect(handleApi(s, "PUT", "/api/providers/openai", `{"keys":[]}`).status).toBe(200)
    const pem = "-----BEGIN " + "PRIVATE KEY-----\nAAAAexampleonlyZZZZ\n-----END " + "PRIVATE KEY-----"
    const body = JSON.stringify({ id: "k1", value: "sk-test-1234567890", oauth_key_config: { grant_type: "client_credentials", token_url: "https://auth.example.test/token", client_id: "cid", client_secret: "csecret-1234567890", extra_params: { resource: "res-secret-123456" } }, azure_key_config: { endpoint: "https://a.example.test", client_secret: "azsecret-1234567890" }, databricks_key_config: { workspace_url: "w.example.test", client_secret: "dbsecret-1234567890" }, github_copilot_key_config: { app_id: "1", installation_id: "2", repository_id: "3", private_key: pem }, cloudflare_key_config: { account_id: "acct" }, watsonx_key_config: { api_key: "wxkey-1234567890", project_id: "p", url: "https://wx.example.test" }, bedrock_mantle_key_config: { region: "us-east-1", secret_key: "bmsecret-1234567890" } })
    expect(handleApi(s, "POST", "/api/providers/openai/keys", body).status).toBe(201)
    const k = findKey(providerOf(s.cfg, "openai")!.keys ?? [], "k1")!
    expect(k.oauth_key_config!.client_secret).toBe("csecret-1234567890")
    expect(k.azure_key_config!.client_secret).toBe("azsecret-1234567890")
    expect(k.github_copilot_key_config!.private_key).toBe(pem)
    expect(k.cloudflare_key_config!.account_id).toBe("acct")
    // a read masks every secret, in every block
    const got = handleApi(s, "GET", "/api/providers/openai/keys/k1", "")
    expect(got.status).toBe(200)
    expect(got.body.includes("csecret-1234567890")).toBe(false)
    expect(got.body.includes("azsecret-1234567890")).toBe(false)
    expect(got.body.includes("dbsecret-1234567890")).toBe(false)
    expect(got.body.includes("AAAAexampleonlyZZZZ")).toBe(false)
    expect(got.body.includes("wxkey-1234567890")).toBe(false)
    expect(got.body.includes("res-secret-123456")).toBe(false)
    expect(got.body.includes("bmsecret-1234567890")).toBe(false)
    expect(got.body.includes(`"oauth_key_config"`)).toBe(true)
    expect(got.body.includes(`"account_id":"acct"`)).toBe(true)
    // sent back as read: the stored secrets stay; a changed setting replaces its own
    const back = got.body.replace(`"client_id":"cid"`, `"client_id":"cid2"`)
    expect(handleApi(s, "PUT", "/api/providers/openai/keys/k1", back).status).toBe(200)
    const k2 = findKey(providerOf(s.cfg, "openai")!.keys ?? [], "k1")!
    expect(k2.value).toBe("sk-test-1234567890")
    expect(k2.oauth_key_config!.client_id).toBe("cid2")
    expect(k2.oauth_key_config!.client_secret).toBe("csecret-1234567890")
    expect(k2.oauth_key_config!.extra_params!.get("resource")).toBe("res-secret-123456")
    expect(k2.azure_key_config!.client_secret).toBe("azsecret-1234567890")
    expect(k2.databricks_key_config!.client_secret).toBe("dbsecret-1234567890")
    expect(k2.github_copilot_key_config!.private_key).toBe(pem)
    expect(k2.watsonx_key_config!.api_key).toBe("wxkey-1234567890")
    expect(k2.bedrock_mantle_key_config!.secret_key).toBe("bmsecret-1234567890")
    // the whole provider read and written back keeps them too
    const prov = handleApi(s, "GET", "/api/providers/openai", "")
    expect(prov.status).toBe(200)
    expect(handleApi(s, "PUT", "/api/providers/openai", prov.body).status).toBe(200)
    const k3 = findKey(providerOf(s.cfg, "openai")!.keys ?? [], "k1")!
    expect(k3.oauth_key_config!.client_secret).toBe("csecret-1234567890")
    expect(k3.github_copilot_key_config!.private_key).toBe(pem)
    expect(k3.cloudflare_key_config!.account_id).toBe("acct")
  } finally {
    cleanup(path)
  }
})
