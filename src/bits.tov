// Bitwise operations on 64-bit integers. Raiju's hashes, ciphers, wire formats and bit sets work on
// whole 64-bit integers, so they call these functions instead of the operators: on Tov v0.1.0 the
// operators & | ^ ~ << >> on an int are JavaScript's, which keep 32 bits. (Masking with a constant
// from 0 to 0x7fffffff, `x & 0xff`, is the same either way and stays an operator.) Shift counts are
// taken mod 64, and bitShr keeps the sign.

export function bitAnd(a: int, b: int): int {
  return a & b
}

export function bitOr(a: int, b: int): int {
  return a | b
}

export function bitXor(a: int, b: int): int {
  return a ^ b
}

export function bitNot(a: int): int {
  return a ^ -1
}

export function bitShl(a: int, n: int): int {
  return a << n
}

export function bitShr(a: int, n: int): int {
  return a >> n
}

const MIN64: int = -9223372036854775807 - 1
const MAX64: int = 9223372036854775807

test("bitAnd, bitOr and bitXor work on all 64 bits, signs included", () => {
  expect(bitAnd(0x1ffffffff, 0xffffffff)).toBe(4294967295)
  expect(bitAnd(0xf0f0f0f0f0, 0xff00ff00ff)).toBe(0xf000f000f0)
  expect(bitAnd(-1, 255)).toBe(255)
  expect(bitAnd(-1, -1)).toBe(-1)
  expect(bitAnd(-2, MAX64)).toBe(MAX64 - 1)
  expect(bitAnd(MIN64, -1)).toBe(MIN64)
  expect(bitAnd(MIN64, MAX64)).toBe(0)
  expect(bitAnd(-256, -16)).toBe(-256)
  expect(bitAnd(3000000000, 3000000000)).toBe(3000000000)
  expect(bitOr(0x100000000, 1)).toBe(4294967297)
  expect(bitOr(0x80000000, 0)).toBe(2147483648)
  expect(bitOr(-1, 5)).toBe(-1)
  expect(bitOr(MIN64, 1)).toBe(MIN64 + 1)
  expect(bitOr(MIN64, MAX64)).toBe(-1)
  expect(bitOr(-256, 15)).toBe(-241)
  expect(bitOr(0, 0)).toBe(0)
  expect(bitXor(0xffffffff, 0x0f0f0f0f)).toBe(0xf0f0f0f0)
  expect(bitXor(0xffffffffff, 1)).toBe(0xfffffffffe)
  expect(bitXor(-1, 0)).toBe(-1)
  expect(bitXor(-1, -1)).toBe(0)
  expect(bitXor(-1, MAX64)).toBe(MIN64)
  expect(bitXor(MIN64, 1)).toBe(MIN64 + 1)
  expect(bitXor(-5, 3)).toBe(-8)
  expect(bitNot(0)).toBe(-1)
  expect(bitNot(-1)).toBe(0)
  expect(bitNot(MAX64)).toBe(MIN64)
  expect(bitNot(MIN64)).toBe(MAX64)
  expect(bitNot(0xffffffff)).toBe(-4294967296)
})

test("bitShl and bitShr shift 64-bit integers; the count is taken mod 64", () => {
  expect(bitShl(1, 0)).toBe(1)
  expect(bitShl(1, 31)).toBe(2147483648)
  expect(bitShl(1, 32)).toBe(4294967296)
  expect(bitShl(1, 40)).toBe(1099511627776)
  expect(bitShl(1, 62)).toBe(4611686018427387904)
  expect(bitShl(1, 63)).toBe(MIN64)
  expect(bitShl(1, 64)).toBe(1)
  expect(bitShl(1, 65)).toBe(2)
  expect(bitShl(3, 63)).toBe(MIN64)
  expect(bitShl(0xff, 24)).toBe(4278190080)
  expect(bitShl(-1, 4)).toBe(-16)
  expect(bitShl(-1, 63)).toBe(MIN64)
  expect(bitShl(MAX64, 1)).toBe(-2)
  expect(bitShl(MIN64, 1)).toBe(0)
  expect(bitShl(0x123456789, 28)).toBe(0x1234567890000000)
  expect(bitShl(5, -1)).toBe(MIN64)
  expect(bitShr(1099511627776, 8)).toBe(4294967296)
  expect(bitShr(0xffffffff, 31)).toBe(1)
  expect(bitShr(0x100000000, 32)).toBe(1)
  expect(bitShr(MAX64, 62)).toBe(1)
  expect(bitShr(MAX64, 63)).toBe(0)
  expect(bitShr(8, 64)).toBe(8)
  expect(bitShr(8, 65)).toBe(4)
  expect(bitShr(-1, 1)).toBe(-1)
  expect(bitShr(-1, 63)).toBe(-1)
  expect(bitShr(-16, 2)).toBe(-4)
  expect(bitShr(-17, 2)).toBe(-5)
  expect(bitShr(MIN64, 63)).toBe(-1)
  expect(bitShr(MIN64, 1)).toBe(-4611686018427387904)
  expect(bitShr(MIN64, 0)).toBe(MIN64)
  expect(bitShr(0, 5)).toBe(0)
})
