// Bifrost's oauth_key_config: a provider key with no value gets its bearer token from a token endpoint
// (core/providers/utils/tokencache). The grant is RFC 6749 client_credentials (the client's id and secret as
// HTTP Basic auth, or in the form with auth_style "body"), or RFC 7523 jwt_bearer (an assertion signed with
// the key's private key: RS256, RS384, RS512, PS256, PS384 or PS512 with an RSA key, ES256, ES384 or ES512 with an EC
// key on P-256, P-384 or P-521). This module builds the token
// request and reads the answer; gateway.tov caches the token per credential and mints a new one before it
// expires, for every call the key serves (the routes, the raw passthrough, batches and files).

import { fields, rawStr, rawNum, quote } from "./json"
import { utf8, sha256, toHex, secureHex } from "./crypto"
import { encodeUrl, encode, decode } from "./base64"
import { signRsa } from "./jwt"
import { signEs, ecPrivateKey } from "./ecdsa"
import { pctEncode } from "./cloud_auth"
import { OAuthKeyConfig } from "./config"

export type OAuthRequest = { url: string, body: string, headers: Map<string, string> }

const JWT_BEARER_URN = "urn:ietf:params:oauth:grant-type:jwt-bearer"
// the lifetime of a jwt_bearer assertion when assertion_lifetime_seconds is unset, in seconds
const ASSERTION_SECONDS = 300
// iat and nbf are backdated this much, so a host clock a little fast does not issue a future assertion
const ISSUED_SKEW_SECONDS = 30
// the token lifetime when the response names none
const DEFAULT_TOKEN_SECONDS = 3600.0
// the algorithms an assertion can be signed with (Bifrost's OAuthSigningAlgorithms)
const ALGORITHMS = ["RS256", "RS384", "RS512", "PS256", "PS384", "PS512", "ES256", "ES384", "ES512"]

// A token URL is an absolute https URL with no userinfo, query or fragment. Plain http is for loopback only.
function checkTokenUrl(url: string): void throws SyntaxError {
  const local = url.startsWith("http://localhost") || url.startsWith("http://127.0.0.1") || url.startsWith("http://[::1]")
  if (!url.startsWith("https://") && !local) throw new SyntaxError("oauth_key_config.token_url must be https (http is allowed for loopback hosts only)")
  const rest = url.slice(url.indexOf("//") + 2)
  if (rest.includes("@") || url.includes("?") || url.includes("#")) throw new SyntaxError("oauth_key_config.token_url must not carry userinfo, a query, or a fragment; send extra parameters through extra_params")
}

// Why a key's oauth_key_config is refused, as Bifrost's OAuthKeyConfig.Validate words it; "" when it is whole. With
// checkKey, a literal PEM private key must also fit the algorithm (an EC key on its curve), as Bifrost's key routes
// check it when a key is saved.
export function oauthKeyProblem(c: OAuthKeyConfig, checkKey: bool): string {
  const url = (c.token_url ?? "").trim()
  if (url === "") return "oauth_key_config.token_url is required"
  if (!url.startsWith("env.")) {
    try {
      checkTokenUrl(url)
    } catch (e) {
      return e.message
    }
  }
  const grant = c.grant_type ?? ""
  if (grant === "client_credentials") {
    if ((c.client_id ?? "").trim() === "" || (c.client_secret ?? "").trim() === "") return "oauth_key_config.client_id and oauth_key_config.client_secret are required for the client_credentials grant"
    const style = c.auth_style ?? ""
    if (style !== "" && style !== "header" && style !== "body") return "oauth_key_config.auth_style must be header or body"
  } else if (grant === "jwt_bearer") {
    const pem = (c.private_key ?? "").trim()
    if (pem === "") return "oauth_key_config.private_key is required for the jwt_bearer grant"
    if ((c.issuer ?? "").trim() === "") return "oauth_key_config.issuer is required for the jwt_bearer grant"
    if ((c.audience ?? "").trim() === "") return "oauth_key_config.audience is required for the jwt_bearer grant"
    const alg = c.signing_algorithm ?? ""
    if (alg !== "" && !ALGORITHMS.includes(alg)) return "oauth_key_config.signing_algorithm must be one of " + ALGORITHMS.join(", ")
    const life = c.assertion_lifetime_seconds ?? 0
    if (life < 0 || life > 3600) return "oauth_key_config.assertion_lifetime_seconds must be between 0 (default) and 3600"
    if (checkKey && !pem.startsWith("env.")) return keyAlgorithmProblem(pem, alg === "" ? "RS256" : alg)
  } else if (grant === "") {
    return "oauth_key_config.grant_type is required"
  } else {
    return "oauth_key_config.grant_type must be client_credentials or jwt_bearer"
  }
  return ""
}

// Whether a PEM private key fits the algorithm (Bifrost's keyMatchesSigningAlgorithm): RSA for RS* and PS*, and for
// ES* an EC key on the curve the algorithm names.
function keyAlgorithmProblem(pem: string, alg: string): string {
  const isRsa = pem.includes("-----BEGIN RSA PRIVATE KEY-----")
  const isP8 = pem.includes("-----BEGIN PRIVATE KEY-----")
  let ecCurve = ""
  let isEc = false
  if (!isRsa) {
    try {
      ecCurve = ecPrivateKey(pem).curve
      isEc = true
    } catch (e) {
      // a PKCS#8 container that is not an EC key is taken as RSA
      if (!isP8 || !e.message.includes("not an EC key")) return "oauth_key_config.private_key must be an RSA or EC private key in PEM form"
    }
  }
  if (alg.startsWith("ES")) {
    if (!isEc) return `oauth_key_config.signing_algorithm ${alg} needs an EC private key; private_key is RSA`
    const want = alg === "ES256" ? "P-256" : (alg === "ES384" ? "P-384" : "P-521")
    if (ecCurve !== "" && ecCurve !== want) return `oauth_key_config.signing_algorithm ${alg} needs a ${want} key; private_key is on ${ecCurve}`
    return ""
  }
  if (isEc) return `oauth_key_config.signing_algorithm ${alg} needs an RSA private key; private_key is EC (set an ES* algorithm)`
  return ""
}

// The RFC 7523 assertion of a jwt_bearer key: iss, sub (the subject, else the issuer), aud, iat and nbf (backdated
// 30 seconds), exp, and a random jti; kid in the header when key_id is set. Signed by signing_algorithm (RS256 when
// unset).
export function jwtAssertion(c: OAuthKeyConfig, nowSeconds: int): string throws SyntaxError {
  const alg = (c.signing_algorithm ?? "") === "" ? "RS256" : (c.signing_algorithm ?? "")
  if (!ALGORITHMS.includes(alg)) throw new SyntaxError(`oauth jwt_bearer: signing_algorithm "${alg}" is not supported`)
  const iss = (c.issuer ?? "").trim()
  const sub = (c.subject ?? "").trim() === "" ? iss : (c.subject ?? "").trim()
  const life = c.assertion_lifetime_seconds ?? 0
  const lifetime = life > 0 ? life : ASSERTION_SECONDS
  const kid = c.key_id ?? ""
  const header = kid === "" ? `{"alg":${quote(alg)},"typ":"JWT"}` : `{"alg":${quote(alg)},"kid":${quote(kid)},"typ":"JWT"}`
  let jti = ""
  try {
    jti = secureHex(32)
  } catch (e) {
    throw new SyntaxError(`oauth jwt_bearer: could not generate jti: ${e.message}`)
  }
  const issued = nowSeconds - ISSUED_SKEW_SECONDS
  const claims = `{"aud":${quote((c.audience ?? "").trim())},"exp":${nowSeconds + lifetime},"iat":${issued},"iss":${quote(iss)},"jti":${quote(jti)},"nbf":${issued},"sub":${quote(sub)}}`
  const input = encodeUrl(utf8(header)) + "." + encodeUrl(utf8(claims))
  const pem = c.private_key ?? ""
  let sig = ""
  try {
    sig = alg.startsWith("ES") ? signEs(alg, pem, input) : signRsa(alg, pem, input)
  } catch (e) {
    const msg = e.message
    const es = msg.includes("EC PEM") ? `private_key could not be parsed as an EC PEM for ${alg}` : msg
    throw new SyntaxError(`oauth jwt_bearer: ${alg.startsWith("ES") ? es : "private_key could not be parsed as an RSA PEM (PKCS#1 or PKCS#8) for " + alg + ": " + msg}`)
  }
  return input + "." + sig
}

// The token request for a key: the grant's own fields, then the scopes, the audience (client_credentials) and the
// extra parameters (sorted), as a form body; a client_credentials key sends its id and secret as Basic auth unless
// auth_style is "body".
export function tokenRequest(c: OAuthKeyConfig, nowSeconds: int): OAuthRequest throws SyntaxError {
  const url = (c.token_url ?? "").trim()
  const problem = oauthKeyProblem(c, false)
  if (problem !== "") throw new SyntaxError(problem)
  let parts: string[] = []
  const hs: Map<string, string> = new Map()
  hs.set("content-type", "application/x-www-form-urlencoded")
  hs.set("accept", "application/json")
  if (c.grant_type === "jwt_bearer") {
    const assertion = try jwtAssertion(c, nowSeconds)
    parts.push("grant_type=" + pctEncode(JWT_BEARER_URN))
    parts.push("assertion=" + pctEncode(assertion))
  } else if (c.grant_type === "client_credentials") {
    const id = c.client_id ?? ""
    const secret = c.client_secret ?? ""
    const style = c.auth_style ?? ""
    parts.push("grant_type=client_credentials")
    if (style === "body") {
      parts.push("client_id=" + pctEncode(id))
      parts.push("client_secret=" + pctEncode(secret))
    } else {
      // RFC 6749 section 2.3.1: the id and secret are form-encoded, then joined for Basic auth
      hs.set("authorization", "Basic " + encode(utf8(pctEncode(id) + ":" + pctEncode(secret))))
    }
  }
  const scopes = c.scopes ?? []
  if (scopes.length > 0) parts.push("scope=" + pctEncode(scopes.join(" ")))
  const aud = c.audience ?? ""
  if (c.grant_type === "client_credentials" && aud !== "") parts.push("audience=" + pctEncode(aud))
  const extra = c.extra_params
  if (extra !== undefined) {
    const ks = extra.keys()
    ks.sort((a: string, b: string): int => a < b ? -1 : (a > b ? 1 : 0))
    for (const k of ks) parts.push(pctEncode(k) + "=" + pctEncode(extra.get(k) ?? ""))
  }
  return { url: url, body: parts.join("&"), headers: hs }
}

// The cache key of a credential: every field that changes which token comes back (Bifrost's oauthKeyCacheKey), so
// two keys that differ in any of them never share a token.
export function credentialKey(c: OAuthKeyConfig): string {
  const extra = c.extra_params
  const ex: string[] = []
  if (extra !== undefined) {
    const ks = extra.keys()
    ks.sort((a: string, b: string): int => a < b ? -1 : (a > b ? 1 : 0))
    for (const k of ks) ex.push(k + "=" + (extra.get(k) ?? ""))
  }
  const parts = [c.grant_type ?? "", c.token_url ?? "", c.client_id ?? "", c.client_secret ?? "", c.private_key ?? "", c.issuer ?? "", c.subject ?? "", c.audience ?? "", c.key_id ?? "", c.signing_algorithm ?? "", c.auth_style ?? "", (c.scopes ?? []).join(" "), ex.join("&")]
  return "oauthkey-v1:" + toHex(sha256(utf8(JSON.stringify(parts))))
}

// The access token and its absolute expiry from a token response. An error answer names its reason.
export function parseOAuthToken(text: string, nowMs: f64): { token: string, expiresAtMs: f64 } throws SyntaxError {
  const fs = try fields(text)
  const token = rawStr(fs, "access_token")
  if (token === undefined || token === "") {
    throw new SyntaxError(`oauth_key_config: token request failed: ${rawStr(fs, "error_description") ?? rawStr(fs, "error") ?? "no access_token"}`)
  }
  const secs = rawNum(fs, "expires_in") ?? DEFAULT_TOKEN_SECONDS
  return { token: token, expiresAtMs: nowMs + (secs > 0.0 ? secs : DEFAULT_TOKEN_SECONDS) * 1000.0 }
}

test("client credentials go as Basic auth by default; the body names the grant, scopes and extra parameters", () => {
  const extra: Map<string, string> = new Map()
  extra.set("resource", "x y")
  extra.set("a", "1")
  const c: OAuthKeyConfig = { grant_type: "client_credentials", token_url: "https://auth.example.test/oauth/token", client_id: "id-1", client_secret: "sec ret", scopes: ["read", "write"], audience: "api", extra_params: extra }
  const r = try tokenRequest(c, 1000)
  expect(r.url).toBe("https://auth.example.test/oauth/token")
  expect(r.body).toBe("grant_type=client_credentials&scope=read%20write&audience=api&a=1&resource=x%20y")
  expect(r.headers.get("authorization")).toBe("Basic " + encode(utf8("id-1:sec%20ret")))
  let b = c
  b.auth_style = "body"
  const rb = try tokenRequest(b, 1000)
  expect(rb.body).toBe("grant_type=client_credentials&client_id=id-1&client_secret=sec%20ret&scope=read%20write&audience=api&a=1&resource=x%20y")
  expect(rb.headers.get("authorization")).toBeUndefined()
})

function clientCreds(url: string): OAuthKeyConfig {
  return { grant_type: "client_credentials", token_url: url, client_id: "a", client_secret: "b" }
}

test("token URLs must be https, or loopback http, with no query", () => {
  let plain = false
  try {
    tokenRequest(clientCreds("http://auth.example.test/token"), 0)
  } catch (e) {
    plain = true
  }
  expect(plain).toBe(true)
  const local = try tokenRequest(clientCreds("http://localhost:9/token"), 0)
  expect(local.url).toBe("http://localhost:9/token")
  let query = false
  try {
    tokenRequest(clientCreds("https://auth.example.test/token?x=1"), 0)
  } catch (e) {
    query = true
  }
  expect(query).toBe(true)
})

test("a jwt_bearer key needs its private key and a known grant and algorithm", () => {
  let missing = false
  try {
    tokenRequest({ grant_type: "jwt_bearer", token_url: "https://auth.example.test/token", client_id: "a" }, 0)
  } catch (e) {
    missing = true
  }
  expect(missing).toBe(true)
  let unknown = false
  try {
    tokenRequest({ grant_type: "password", token_url: "https://auth.example.test/token", client_id: "a", client_secret: "b" }, 0)
  } catch (e) {
    unknown = true
  }
  expect(unknown).toBe(true)
  let alg = ""
  try {
    jwtAssertion({ grant_type: "jwt_bearer", token_url: "https://t", private_key: "k", issuer: "i", audience: "a", signing_algorithm: "HS256" }, 0)
  } catch (e) {
    alg = e.message
  }
  expect(alg.includes("not supported")).toBe(true)
})

test("token responses give the token and its expiry, or the reason they fail", () => {
  const ok = try parseOAuthToken(`{"access_token":"tok-1","token_type":"bearer","expires_in":60}`, 1000.0)
  expect(ok.token).toBe("tok-1")
  expect(ok.expiresAtMs).toBe(61000.0)
  const dflt = try parseOAuthToken(`{"access_token":"tok-2"}`, 0.0)
  expect(dflt.expiresAtMs).toBe(3600000.0)
  let reason = ""
  try {
    parseOAuthToken(`{"error":"invalid_client","error_description":"bad secret"}`, 0.0)
  } catch (e) {
    reason = e.message
  }
  expect(reason.includes("bad secret")).toBe(true)
})

test("credentials that differ in any field do not share a cache key", () => {
  const a = clientCreds("https://auth.example.test/token")
  const b: OAuthKeyConfig = { grant_type: "client_credentials", token_url: "https://auth.example.test/token", client_id: "a", client_secret: "b", scopes: ["x"] }
  expect(credentialKey(a)).toBe(credentialKey(clientCreds("https://auth.example.test/token")))
  expect(credentialKey(a) === credentialKey(b)).toBe(false)
})

// RFC 6979's P-256 test key as a SEC 1 PEM, built here.
function testEcPem(): string {
  const der: u8[] = []
  for (const b of [0x30, 0x31, 0x02, 0x01, 0x01, 0x04, 0x20]) der.push(u8(b))
  const d = "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721"
  for (let i = 0; i < 64; i += 2) {
    const v: int = parseInt(d.slice(i, i + 2), 16) ?? 0
    der.push(u8(v))
  }
  for (const b of [0xa0, 0x0a, 0x06, 0x08, 0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07]) der.push(u8(b))
  return "-----BEGIN EC " + "PRIVATE KEY-----\n" + encode(der) + "\n-----END EC " + "PRIVATE KEY-----\n"
}

test("an ES256 jwt_bearer assertion names its issuer, subject, audience and kid", () => {
  const c: OAuthKeyConfig = { grant_type: "jwt_bearer", token_url: "https://auth.example.test/token", private_key: testEcPem(), issuer: "svc@example.test", audience: "https://api.example.test", key_id: "k1", signing_algorithm: "ES256", scopes: ["s1"], assertion_lifetime_seconds: 120 }
  const r = try tokenRequest(c, 1000000)
  expect(r.body.startsWith("grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Ajwt-bearer&assertion=")).toBe(true)
  expect(r.body.endsWith("&scope=s1")).toBe(true)
  expect(r.headers.get("authorization")).toBeUndefined()
  const a = try jwtAssertion(c, 1000000)
  const parts = a.split(".")
  expect(parts.length).toBe(3)
  const header = try new TextDecoder().decode(try decode(parts[0]!))
  expect(header).toBe(`{"alg":"ES256","kid":"k1","typ":"JWT"}`)
  const claims = try fields(try new TextDecoder().decode(try decode(parts[1]!)))
  expect(rawStr(claims, "iss")).toBe("svc@example.test")
  expect(rawStr(claims, "sub")).toBe("svc@example.test")
  expect(rawStr(claims, "aud")).toBe("https://api.example.test")
  expect(rawNum(claims, "exp")).toBe(1000120.0)
  expect(rawNum(claims, "iat")).toBe(999970.0)
  expect((rawStr(claims, "jti") ?? "").byteLength).toBe(32)
  expect((try decode(parts[2]!)).length).toBe(64)
})

// RFC 6979's P-384 test key as a SEC 1 PEM, built here.
function testEc384Pem(): string {
  const der: u8[] = []
  for (const b of [0x30, 0x3e, 0x02, 0x01, 0x01, 0x04, 0x30]) der.push(u8(b))
  const d = "6b9d3dad2e1b8c1c05b19875b6659f4de23c3b667bf297ba9aa47740787137d896d5724e4c70a825f872c9ea60d2edf5"
  for (let i = 0; i < 96; i += 2) {
    const v: int = parseInt(d.slice(i, i + 2), 16) ?? 0
    der.push(u8(v))
  }
  for (const b of [0xa0, 0x07, 0x06, 0x05, 0x2b, 0x81, 0x04, 0x00, 0x22]) der.push(u8(b))
  return "-----BEGIN EC " + "PRIVATE KEY-----\n" + encode(der) + "\n-----END EC " + "PRIVATE KEY-----\n"
}

test("a jwt_bearer key with no issuer or audience is refused, as Bifrost refuses it", () => {
  const base: OAuthKeyConfig = { grant_type: "jwt_bearer", token_url: "https://auth.example.test/token", client_id: "cid", private_key: testEcPem(), signing_algorithm: "ES256" }
  expect(oauthKeyProblem(base, false)).toBe("oauth_key_config.issuer is required for the jwt_bearer grant")
  let withIss = base
  withIss.issuer = "svc"
  expect(oauthKeyProblem(withIss, false)).toBe("oauth_key_config.audience is required for the jwt_bearer grant")
  let msg = ""
  try {
    tokenRequest(withIss, 0)
  } catch (e) {
    msg = e.message
  }
  expect(msg).toBe("oauth_key_config.audience is required for the jwt_bearer grant")
  let whole = withIss
  whole.audience = "https://api.example.test"
  expect(oauthKeyProblem(whole, true)).toBe("")
  let badAlg = whole
  badAlg.signing_algorithm = "HS256"
  expect(oauthKeyProblem(badAlg, false)).toBe("oauth_key_config.signing_algorithm must be one of RS256, RS384, RS512, PS256, PS384, PS512, ES256, ES384, ES512")
})

test("a saved key must fit its algorithm: RSA for RS and PS, an EC key on the named curve for ES", () => {
  let c: OAuthKeyConfig = { grant_type: "jwt_bearer", token_url: "https://auth.example.test/token", private_key: testEcPem(), issuer: "i", audience: "a", signing_algorithm: "ES384" }
  expect(oauthKeyProblem(c, true)).toBe("oauth_key_config.signing_algorithm ES384 needs a P-384 key; private_key is on P-256")
  c.signing_algorithm = "PS256"
  expect(oauthKeyProblem(c, true)).toBe("oauth_key_config.signing_algorithm PS256 needs an RSA private key; private_key is EC (set an ES* algorithm)")
  c.signing_algorithm = "ES384"
  c.private_key = testEc384Pem()
  expect(oauthKeyProblem(c, true)).toBe("")
  c.private_key = "not a pem"
  expect(oauthKeyProblem(c, true)).toBe("oauth_key_config.private_key must be an RSA or EC private key in PEM form")
  c.private_key = "env.SIGNING_KEY"
  expect(oauthKeyProblem(c, true)).toBe("")
})

test("an ES384 assertion carries the 96-byte r||s and its alg", () => {
  const c: OAuthKeyConfig = { grant_type: "jwt_bearer", token_url: "https://auth.example.test/token", private_key: testEc384Pem(), issuer: "svc", audience: "aud", signing_algorithm: "ES384" }
  const a = try jwtAssertion(c, 1000)
  const parts = a.split(".")
  expect(try new TextDecoder().decode(try decode(parts[0]!))).toBe(`{"alg":"ES384","typ":"JWT"}`)
  expect((try decode(parts[2]!)).length).toBe(96)
})
