// /v1/realtime: a WebSocket relay between the caller and the provider's realtime endpoint (OpenAI, Azure
// OpenAI or xAI). The gateway checks the virtual key, picks the provider key, and relays the events through
// a LiveCore (webrtc.tov), as Bifrost's realtime handler does: each turn (a response, from its start to its
// response.done) is admitted by governance, the text of both sides is guarded, the tokens that response.done
// reports are billed (audio tokens at the audio rates, cached tokens at the cache rate), and the session ends
// as one log row with its cost. The events themselves pass as they came. A client secret this gateway minted
// (rtsession.tov) connects as the virtual key it was minted under, and a transcription session
// (?intent=transcription) is billed per transcription at the transcription rates.
import { Engine } from "./gateway"
import { parseModel, target } from "./router"
import { Target } from "./providers/types"
import { Grant } from "./governance"
import { Hdrs, snapshot } from "./schemas"
import { WsConnection, SocketGate } from "./ws"
import { errorJson } from "./schemas"
import { SessionSpec, sessionHooks, sessionGuard } from "./livehooks"
import { Relay, Leg, Refusal, startClock, errorEvent } from "./webrtc"
import { RealtimeCred, realtimeCredential, transcriptionModelOf, pinTranscriptionModel, BOOTSTRAP_MS, BOOTSTRAP_FRAMES, BOOTSTRAP_BYTES } from "./rtsession"
import { openSessions, GOING_AWAY, GOING_AWAY_REASON } from "./drain"

// What a WebSocket upgrade becomes on the server: the socket's own state in ext.
export class Session {
  // the state of the WebSocket route (the realtime relay, responses, live, the UI socket)
  ext: SocketExt | undefined = undefined
  // the subprotocol the 101 answers with ("" for none): one the client offered, never a credential-bearing one
  protocol = ""
  constructor(readonly url: string, readonly headers: Map<string, string>, readonly provider: string, readonly model: string) {}
}

// What a WebSocket route sends through: the connection's send and close, as closures so the route
// code is the same on Bun.serve and on the http1 server.
export class Pipe {
  constructor(readonly sendText: (s: string) => void, readonly closeWith: (code: int, reason: string) => void, readonly pingWith: () => void, readonly dropWith: () => void) {}
}

// The state of a WebSocket route other than /v1/realtime. The server attaches a Pipe, then calls
// onOpen, and calls onMessage for each text frame and onClose once the socket is gone.
export class SocketExt {
  pipe: Pipe | undefined = undefined
  // the client has gone
  closed = false
  // the route has closed the socket (sent its close frame)
  ended = false
  // the route's session cap, and whether this socket holds one of its slots
  gate: SocketGate | undefined = undefined
  held = false
  // when the client last answered a ping (ms since the epoch); see the UI socket's heartbeat
  pongAt: f64 = Date.now()
  // a live feed socket (/ws): a graceful stop closes it first (drain.tov)
  uiFeed = false
  // its entry among the sessions a graceful stop closes (0: none)
  drainId = 0
  private closeRan = false
  onOpen(): void {}
  onMessage(m: string): void {}
  onClose(): void {}
  onPong(): void {
    this.pongAt = Date.now()
  }
  send(t: string): void {
    const p = this.pipe
    if (p !== undefined && !this.closed && !this.ended) p.sendText(t)
  }
  ping(): void {
    const p = this.pipe
    if (p !== undefined && !this.closed && !this.ended) p.pingWith()
  }
  // Drops the connection at once, for a client that has stopped answering pings.
  drop(): void {
    const p = this.pipe
    if (p !== undefined && !this.ended) {
      this.ended = true
      p.dropWith()
    }
  }
  endWith(code: int, reason: string): void {
    const p = this.pipe
    if (p !== undefined && !this.ended) {
      this.ended = true
      p.closeWith(code, reason)
    }
  }
  // The client has gone (its close came, or the socket was cut): the route's close runs once.
  gone(): void {
    openSessions().remove(this.drainId)
    this.drainId = 0
    if (this.closeRan) return
    this.closeRan = true
    this.closed = true
    this.onClose()
    this.leave()
  }
  // Counts the socket among the sessions a graceful stop closes with a going-away frame (drain.tov).
  track(): void {
    if (this.drainId !== 0 || this.closed) return
    const e = this
    this.drainId = openSessions().add({ feed: this.uiFeed, goAway: () => {
      e.endWith(GOING_AWAY, GOING_AWAY_REASON)
    }, ended: (): bool => e.closed, drop: () => {
      // (after its close frame the socket counts as ended, so drop() would not cut it)
      e.ended = true
      const p = e.pipe
      if (p !== undefined) p.dropWith()
      e.gone()
    } })
  }
  // Takes this socket's slot in its route's gate. False when the route is full.
  enter(): bool {
    if (this.held) return true
    const g = this.gate
    if (g === undefined) return true
    if (!g.take()) return false
    this.held = true
    return true
  }
  leave(): void {
    if (!this.held) return
    this.held = false
    const g = this.gate
    if (g !== undefined) g.give()
  }
  // The error event of a socket the route has no room for: Bifrost's realtime error for a 429 (the realtime and live
  // routes; the Responses socket answers in its own shape).
  fullEvent(): string {
    return FULL_EVENT
  }
  // Answers a socket that the route has no room for: an error event, then a close (Bifrost's 429).
  refuseFull(): void {
    this.send(this.fullEvent())
    this.closed = true
    this.endWith(1013, FULL_REASON)
  }
}

const FULL_REASON = "websocket connection limit reached"
const FULL_EVENT = `{"type":"error","error":{"type":"rate_limit_exceeded","code":"rate_limit_exceeded","message":"${FULL_REASON}"}}`
// the Responses socket's: Bifrost's WebSocket error event with the 429 status
export const FULL_EVENT_RESPONSES = `{"type":"error","status":429,"error":{"code":"websocket_connection_limit_reached","message":"${FULL_REASON}"}}`

export type Upgrade = { kind: "session", session: Session } | { kind: "refused", status: int, message: string }

export function wsBase(url: string): string {
  if (url.startsWith("https://")) return "wss://" + url.slice(8)
  if (url.startsWith("http://")) return "ws://" + url.slice(7)
  return url
}

function trim(s: string): string {
  return s.endsWith("/") ? s.slice(0, s.byteLength - 1) : s
}

// Bun.serve's open, message and close for a route with state in ext (every WebSocket route has one).
export function extOpen(ws: ServerWebSocket<Session>): bool {
  const s = ws.data
  if (s === undefined) return false
  const e = s.ext
  if (e === undefined) return false
  e.pipe = new Pipe((t) => {
    ws.send(t)
  }, (c, r) => {
    ws.close(c, r)
  }, () => {
    ws.ping()
  }, () => {
    ws.terminate()
  })
  if (!e.enter()) {
    e.refuseFull()
    return true
  }
  e.track()
  e.onOpen()
  return true
}

// Bun's pong event: the client answered a ping.
export function extPong(ws: ServerWebSocket<Session>): void {
  const s = ws.data
  if (s === undefined) return
  const e = s.ext
  if (e !== undefined) e.onPong()
}

export function extMessage(ws: ServerWebSocket<Session>, m: string | u8[]): bool {
  const s = ws.data
  if (s === undefined) return false
  const e = s.ext
  if (e === undefined) return false
  if (typeof m === "string") e.onMessage(m)
  return true
}

export function extClose(ws: ServerWebSocket<Session>): bool {
  const s = ws.data
  if (s === undefined) return false
  const e = s.ext
  if (e === undefined) return false
  e.gone()
  return true
}

// The same for an accepted http1 connection.
export function attachHttp1(e: SocketExt, client: WsConnection): void {
  e.pipe = new Pipe((t) => {
    client.send(t)
  }, (c, r) => {
    client.close(c, r)
  }, () => {
    client.ping()
  }, () => {
    client.terminate()
  })
  client.onMessage = (m) => {
    if (typeof m === "string") e.onMessage(m)
  }
  client.onPong = () => {
    e.onPong()
  }
  client.onClose = (c, r) => {
    e.gone()
  }
  if (!e.enter()) {
    e.refuseFull()
    return
  }
  e.track()
  e.onOpen()
}

// The providers whose realtime API this relay serves, as Bifrost's RealtimeProvider: OpenAI, Azure
// OpenAI and xAI. ElevenLabs is a media provider here, and the other OpenAI-compatible providers
// have no realtime endpoint.
export function realtimeKind(kind: string): bool {
  return kind === "openai" || kind === "azure" || kind === "xai"
}

// The provider's configured headers, as Bifrost copies them. With keepAuth false an
// authorization header from the config is dropped, since the provider key is the one sent.
function configHeaders(inout h: Map<string, string>, t: Target, keepAuth: bool): void {
  const extra = t.cfg.network_config?.extra_headers
  if (extra === undefined) return
  for (const k of extra.keys()) {
    if (keepAuth || k.toLowerCase() !== "authorization") h.set(k, extra.get(k)!)
  }
}

export function upstreamFor(t: Target, beta: string | undefined): { url: string, headers: Map<string, string> } {
  let h: Map<string, string> = new Map()
  if (t.kind === "azure") {
    const az = t.key.azure_key_config
    let deployment = t.model
    const deps = az?.deployments
    if (deps !== undefined) deployment = deps.get(t.model) ?? t.model
    // an Entra ID token goes in authorization and an API key in api-key, as chat does
    if (az?.tenant_id !== undefined) h.set("authorization", "Bearer " + (t.key.value ?? ""))
    else h.set("api-key", t.key.value ?? "")
    configHeaders(&h, t, true)
    const endpoint = trim(az?.endpoint ?? t.cfg.network_config?.base_url ?? "")
    return { url: `${wsBase(endpoint)}/openai/realtime?api-version=${az?.api_version ?? "2025-04-01-preview"}&deployment=${deployment}`, headers: h }
  }
  if (t.kind === "xai") {
    // xAI's voice endpoint takes the bearer key only: no OpenAI beta header, and the origin is api.x.ai
    // unless network_config.base_url names another
    const base = trim(t.cfg.network_config?.base_url ?? "https://api.x.ai")
    configHeaders(&h, t, false)
    h.set("authorization", "Bearer " + (t.key.value ?? ""))
    return { url: `${wsBase(base)}/v1/realtime?model=${t.model}`, headers: h }
  }
  const base = trim(t.cfg.network_config?.base_url ?? "https://api.openai.com")
  h.set("authorization", "Bearer " + (t.key.value ?? ""))
  if (beta !== undefined) h.set("openai-beta", beta)
  configHeaders(&h, t, true)
  return { url: `${wsBase(base)}/v1/realtime?model=${t.model}`, headers: h }
}

// The provider's realtime WebSocket for a session: its URL and headers, with token (when set) sent instead of the
// key (the provider's token behind a client secret this gateway minted, or an ek_ token it did not), and for a
// transcription session the intent=transcription endpoint with no model (Bifrost's RealtimeWebSocketURL with an
// intent). Azure takes an ephemeral token as a bearer, as Bifrost's Azure RealtimeHeaders does.
export function sessionUpstream(t: Target, beta: string | undefined, transcription: bool, token: string): { url: string, headers: Map<string, string> } {
  let k = t.key
  if (token !== "") k.value = token
  const tt: Target = { provider: t.provider, kind: t.kind, model: t.model, key: k, cfg: t.cfg }
  const up = upstreamFor(tt, beta)
  let h: Map<string, string> = new Map()
  for (const name of up.headers.keys()) h.set(name, up.headers.get(name)!)
  if (tt.kind === "azure" && token.startsWith("ek_")) {
    h.delete("api-key")
    h.set("authorization", "Bearer " + token)
  }
  if (!transcription) return { url: up.url, headers: h }
  if (tt.kind === "azure") {
    const endpoint = trim(tt.key.azure_key_config?.endpoint ?? tt.cfg.network_config?.base_url ?? "")
    return { url: `${wsBase(endpoint)}/openai/v1/realtime?intent=transcription`, headers: h }
  }
  const base = trim(tt.cfg.network_config?.base_url ?? "https://api.openai.com")
  return { url: `${wsBase(base)}/v1/realtime?intent=transcription`, headers: h }
}

// The subprotocol a realtime upgrade answers with, as Bifrost's upgrader does: "realtime" when the client offered it
// and the provider's realtime API speaks it (OpenAI and Azure; xAI names none), else none. A credential the client
// put in its offer (openai-insecure-api-key.<key>) is never echoed. kind is "" while a transcription session's
// provider is not known yet (Bifrost answers such an upgrade with "realtime").
export function answerProtocol(offered: string | undefined, kind: string): string {
  if (offered === undefined || kind === "xai") return ""
  for (const p of offered.split(",")) {
    if (p.trim() === "realtime") return "realtime"
  }
  return ""
}

// Decides whether a /v1/realtime upgrade may proceed, and where it goes. The session it returns carries
// the socket's state (a RealtimeSocket), which both servers run the same way. A client secret this gateway minted
// stands for the virtual key it was minted under (rtsession.tov realtimeCredential), and names the model when the
// URL does not. A transcription session (?intent=transcription) with no model is upgraded first: its model comes in
// its first update, and it is admitted then.
export function prepare(engine: Engine, req: Request): Upgrade {
  const u = URL.parse(req.url)
  let model = u === undefined ? "" : (u.searchParams.get("model") ?? "").trim()
  const intent = u === undefined ? "" : (u.searchParams.get("intent") ?? "").trim().toLowerCase()
  const transcription = intent === "transcription"
  const cred = realtimeCredential(engine.cfg, snapshot(req.headers), Date.now())
  if (cred.refused !== "") return { kind: "refused", status: 401, message: cred.refused }
  const m = cred.mapping
  if (model === "" && m !== undefined && m.transcription === transcription) model = m.provider + "/" + m.model
  if (model === "" && !transcription) return { kind: "refused", status: 400, message: "add ?model=openai/gpt-realtime (or another realtime model)" }
  const sock = new RealtimeSocket(engine, cred, transcription, req.headers.get("openai-beta") ?? undefined)
  if (model !== "") {
    const why = sock.resolve(model)
    if (why !== undefined) return { kind: "refused", status: why.status, message: why.message }
  }
  const session = new Session(sock.url, sock.upstreamHeaders, sock.provider, sock.model)
  session.protocol = answerProtocol(req.headers.get("sec-websocket-protocol") ?? undefined, sock.kind)
  sock.gate = engine.wsRealtime
  session.ext = sock
  return { kind: "session", session: session }
}

// A WebSocket the gateway opens upstream, or undefined when it can't be made (a malformed URL, say).
function openUpstream(url: string, hs: Record<string, string>): WebSocket | undefined {
  try {
    return new WebSocket(url, { headers: hs })
  } catch (e) {
    return undefined
  }
}

// Closes an upstream socket that is open. One still connecting is left to its onopen, which closes it:
// closing a socket mid-connect crashed the process on the http1 server.
function closeUp(up: WebSocket): void {
  if (up.readyState === 1) up.close()
}

// One realtime WebSocket: the caller's frames and the provider's pass through a relay (webrtc.tov) that
// admits each turn, guards the text, bills the tokens and logs the session. Frames go on as they came, except
// where a guard redacted text. The provider's socket is opened with the caller's; what the caller sends before
// it is open waits. A transcription session that has not named its model yet holds its frames (up to Bifrost's
// bootstrap limits) until an update names one; it is admitted for that model, and the frames go on.
export class RealtimeSocket extends SocketExt {
  relay: Relay | undefined = undefined
  upstream: WebSocket | undefined = undefined
  // what the session was admitted for, once its model is known: the grant, the provider and model, the model the
  // provider knows it by, and the provider's socket
  grant: Grant | undefined = undefined
  provider = ""
  model = ""
  upstreamModel = ""
  // the provider's kind ("" until the model is known)
  kind = ""
  url = ""
  upstreamHeaders: Map<string, string> = new Map()
  // the frames a transcription session sent before it named its model
  pending: string[] = []
  pendingBytes = 0
  readonly headers: Hdrs
  constructor(readonly engine: Engine, readonly cred: RealtimeCred, readonly transcription: bool, readonly beta: string | undefined) {
    super()
    this.headers = cred.headers
  }

  // Admits the session for a model and finds the provider's socket for it: undefined, or the refusal. A client
  // secret's session runs on the pool key that minted it, or another when that key is gone.
  resolve(rawModel: string): Refusal | undefined {
    const cfg = this.engine.cfg
    const ref = parseModel(cfg, rawModel)
    const admitted = this.engine.gov.admit(this.headers, ref.provider, ref.model)
    if (admitted.kind === "denial") return { status: admitted.status, type: admitted.type, message: admitted.message }
    const grant: Grant = admitted
    const none: Set<int> = new Set()
    let sel = target(cfg, ref, none, this.cred.pin)
    if (sel === undefined && this.cred.mapping !== undefined) sel = target(cfg, ref, none, this.headers.get("x-bf-api-key") ?? undefined)
    if (sel === undefined) return { status: 404, type: "invalid_request_error", message: `no key is configured for ${ref.provider}/${ref.model}` }
    if (!realtimeKind(sel.t.kind)) return { status: 400, type: "invalid_request_error", message: `${ref.provider} has no realtime API this gateway can relay` }
    if (this.transcription && sel.t.kind === "xai") return { status: 400, type: "invalid_request_error", message: "xai realtime requires a model and does not support a transcription-only intent" }
    const up = sessionUpstream(sel.t, this.beta, this.transcription, this.cred.providerToken)
    this.grant = grant
    this.provider = ref.provider
    this.model = ref.model
    this.upstreamModel = sel.t.model
    this.kind = sel.t.kind
    this.url = up.url
    this.upstreamHeaders = up.headers
    return undefined
  }

  onOpen(): void {
    if (this.grant !== undefined) {
      this.start([])
      return
    }
    // a transcription session names its model in its first update, within the bootstrap time
    const me = this
    setTimeout(() => {
      if (me.grant === undefined && !me.closed && !me.ended) me.refuse("invalid_request_error", "transcription session.update model was not received within bootstrap limits")
    }, BOOTSTRAP_MS)
  }

  // Ends a session that could not start: the client gets the error event, then the close.
  private refuse(type: string, message: string): void {
    this.pending = []
    this.send(errorEvent(type, message))
    this.endWith(1008, message.byteLength > 120 ? message.slice(0, 120) : message)
  }

  // A frame of a transcription session that has not named its model: held, and the session starts with the update
  // that names one.
  private bootstrap(m: string): void {
    this.pending.push(m)
    this.pendingBytes += m.byteLength
    if (this.pendingBytes > BOOTSTRAP_BYTES) {
      this.refuse("invalid_request_error", "transcription bootstrap exceeded 1 MiB")
      return
    }
    const model = transcriptionModelOf(m)
    if (model !== "") {
      const why = this.resolve(model)
      if (why !== undefined) {
        this.refuse(why.type, why.message)
        return
      }
      const frames = this.pending
      this.pending = []
      this.start(frames)
      return
    }
    if (this.pending.length >= BOOTSTRAP_FRAMES) this.refuse("invalid_request_error", "transcription bootstrap exceeded 16 frames before session.update supplied a model")
  }

  // A client frame as the provider gets it: a transcription session's updates stay on the model it was admitted for.
  private outbound(m: string): string {
    return this.transcription ? pinTranscriptionModel(m, this.upstreamModel) : m
  }

  private start(frames: string[]): void {
    const grant = this.grant
    if (grant === undefined) return
    const spec: SessionSpec = { op: "realtime", transport: "websocket", provider: this.provider, model: this.model }
    // a realtime session has no id of its own to record: attach and content are live sessions' routes
    const relay = new Relay(sessionHooks(this.engine, this.headers, grant, spec, (id) => true), sessionGuard(this.engine), Date.now())
    relay.core.realtime = true
    relay.core.transcription = this.transcription
    relay.core.minimum = 0.0
    relay.core.model = this.model
    relay.clientOpen = true
    relay.setupDone = true
    const me = this
    relay.client = new Leg((t) => {
      me.send(t)
      return true
    }, (p) => false, () => 0, (code, why) => {
      if (!me.closed) me.endWith(code, why)
    })
    this.relay = relay
    const hs: Record<string, string> = {}
    for (const k of this.upstreamHeaders.keys()) hs.set(k, this.upstreamHeaders.get(k)!)
    const up = openUpstream(this.url, hs)
    if (up === undefined) {
      relay.providerBroke()
      return
    }
    this.upstream = up
    relay.provider = new Leg((t) => {
      up.send(t)
      return true
    }, (p) => false, () => 0, (code, why) => {
      closeUp(up)
    })
    up.onopen = () => {
      // a caller that left while the dial was connecting: the relay is over, so the socket is closed
      if (relay.closed) up.close()
      else relay.channelOpened(false)
    }
    up.onmessage = (ev) => {
      const d = ev.data
      if (typeof d === "string") relay.fromProvider(d)
    }
    up.onclose = (ev) => {
      if (ev.code === 1000 || ev.code === 1001 || ev.code === 1005) relay.providerGone()
      else relay.providerBroke()
    }
    up.onerror = (ev) => {
      relay.providerBroke()
    }
    startClock(relay)
    // what a transcription session sent before it named its model goes on now
    for (const f of frames) relay.fromBrowser(this.outbound(f))
  }

  onMessage(m: string): void {
    if (this.closed || this.ended) return
    if (this.grant === undefined) {
      this.bootstrap(m)
      return
    }
    const r = this.relay
    if (r !== undefined) r.fromBrowser(this.outbound(m))
  }

  onClose(): void {
    this.closed = true
    const r = this.relay
    if (r !== undefined) r.browserGone()
  }
}

test("a route's gate admits sockets up to its cap and frees a slot when one leaves", () => {
  const g = new SocketGate(2)
  const a = new SocketExt()
  const b = new SocketExt()
  const c = new SocketExt()
  a.gate = g
  b.gate = g
  c.gate = g
  expect(a.enter()).toBe(true)
  expect(b.enter()).toBe(true)
  expect(c.enter()).toBe(false)
  a.leave()
  expect(c.enter()).toBe(true)
  a.leave()
  expect(g.open).toBe(2)
  const free = new SocketExt()
  expect(free.enter()).toBe(true)
})

test("realtime upstream URLs", () => {
  const t: Target = { provider: "openai", kind: "openai", model: "gpt-realtime", key: { value: "sk" }, cfg: {} }
  const u = upstreamFor(t, "realtime=v1")
  expect(u.url).toBe("wss://api.openai.com/v1/realtime?model=gpt-realtime")
  expect(u.headers.get("authorization")).toBe("Bearer sk")
  expect(u.headers.get("openai-beta")).toBe("realtime=v1")
  const deps: Map<string, string> = new Map()
  deps.set("gpt-realtime", "rt-prod")
  const az: Target = { provider: "azure", kind: "azure", model: "gpt-realtime", key: { value: "ak", azure_key_config: { endpoint: "https://x.openai.azure.com/", deployments: deps, api_version: "2025-04-01-preview" } }, cfg: {} }
  expect(upstreamFor(az, undefined).url).toBe("wss://x.openai.azure.com/openai/realtime?api-version=2025-04-01-preview&deployment=rt-prod")
})

test("realtime kinds and xAI upstream", () => {
  expect(realtimeKind("openai")).toBe(true)
  expect(realtimeKind("azure")).toBe(true)
  expect(realtimeKind("xai")).toBe(true)
  expect(realtimeKind("groq")).toBe(false)
  expect(realtimeKind("gemini")).toBe(false)
  const x: Target = { provider: "xai", kind: "xai", model: "grok-realtime", key: { value: "xk" }, cfg: {} }
  const u = upstreamFor(x, "realtime=v1")
  expect(u.url).toBe("wss://api.x.ai/v1/realtime?model=grok-realtime")
  expect(u.headers.get("authorization")).toBe("Bearer xk")
  // Bifrost's xAI realtime sends no OpenAI beta header
  expect(u.headers.has("openai-beta")).toBe(false)
  const extra: Map<string, string> = new Map()
  extra.set("Authorization", "Bearer config-value")
  extra.set("x-team", "voice")
  const xc: Target = { provider: "xai", kind: "xai", model: "grok-realtime", key: { value: "xk" }, cfg: { network_config: { base_url: "https://xai.example.test/", extra_headers: extra } } }
  const v = upstreamFor(xc, undefined)
  expect(v.url).toBe("wss://xai.example.test/v1/realtime?model=grok-realtime")
  expect(v.headers.get("authorization")).toBe("Bearer xk")
  expect(v.headers.get("x-team")).toBe("voice")
})

test("realtime Azure with Entra ID and configured headers", () => {
  const extra: Map<string, string> = new Map()
  extra.set("x-team", "voice")
  const az: Target = { provider: "azure", kind: "azure", model: "gpt-realtime", key: { value: "entra-token", azure_key_config: { endpoint: "https://x.openai.azure.com", tenant_id: "t", client_id: "c", client_secret: "s" } }, cfg: { network_config: { extra_headers: extra } } }
  const u = upstreamFor(az, undefined)
  expect(u.headers.get("authorization")).toBe("Bearer entra-token")
  expect(u.headers.has("api-key")).toBe(false)
  expect(u.headers.get("x-team")).toBe("voice")
})

test("a realtime upgrade answers with realtime when offered, never the credential", () => {
  expect(answerProtocol("realtime, openai-insecure-api-key.ek_bf_x", "openai")).toBe("realtime")
  expect(answerProtocol("openai-insecure-api-key.ek_bf_x", "openai")).toBe("")
  expect(answerProtocol(undefined, "azure")).toBe("")
  expect(answerProtocol("realtime", "")).toBe("realtime")
  expect(answerProtocol("realtime, xai-client-secret.k", "xai")).toBe("")
})

test("a session's upstream: a client secret's provider token instead of the key, and the transcription endpoint", () => {
  const t: Target = { provider: "openai", kind: "openai", model: "gpt-realtime", key: { value: "sk-pool" }, cfg: { network_config: { base_url: "https://api.example.test/" } } }
  const a = sessionUpstream(t, undefined, false, "")
  expect(a.url).toBe("wss://api.example.test/v1/realtime?model=gpt-realtime")
  expect(a.headers.get("authorization")).toBe("Bearer sk-pool")
  const b = sessionUpstream(t, undefined, true, "ek_up_1")
  expect(b.url).toBe("wss://api.example.test/v1/realtime?intent=transcription")
  expect(b.headers.get("authorization")).toBe("Bearer ek_up_1")
  const az: Target = { provider: "azure", kind: "azure", model: "gpt-realtime", key: { value: "ak", azure_key_config: { endpoint: "https://x.openai.azure.com/" } }, cfg: {} }
  const c = sessionUpstream(az, undefined, true, "ek_up_2")
  expect(c.url).toBe("wss://x.openai.azure.com/openai/v1/realtime?intent=transcription")
  expect(c.headers.get("authorization")).toBe("Bearer ek_up_2")
  expect(c.headers.has("api-key")).toBe(false)
  expect(sessionUpstream(az, undefined, false, "").headers.get("api-key")).toBe("ak")
})

test("a socket past the cap gets Bifrost's 429 event for its route", () => {
  const rt = new SocketExt()
  let sent = ""
  rt.pipe = new Pipe((s: string) => {
    sent = s
  }, (c: int, r: string) => {}, () => {}, () => {})
  rt.refuseFull()
  expect(sent).toBe(`{"type":"error","error":{"type":"rate_limit_exceeded","code":"rate_limit_exceeded","message":"websocket connection limit reached"}}`)
  expect(FULL_EVENT_RESPONSES).toBe(`{"type":"error","status":429,"error":{"code":"websocket_connection_limit_reached","message":"websocket connection limit reached"}}`)
})
