// An array element that may be absent. `xs[i]` past either end is undefined on Tov before v0.1.0
// and traps on Tov v0.1.0 (unless the code around it visibly expects undefined), so a read that
// means "the element, if there is one" says so: `elemAt(segs, 4) === "rotate"`.

export function elemAt<T>(xs: T[], i: int): T | undefined {
  return xs[i]
}

test("elemAt is the element, or undefined past either end", () => {
  const segs = "/api/users/bob".split("/")
  expect(elemAt(segs, 3)).toBe("bob")
  expect(elemAt(segs, 4) === "access-profiles").toBe(false)
  expect(elemAt(segs, 4) === undefined).toBe(true)
  expect(elemAt(segs, -1) === undefined).toBe(true)
  expect(elemAt(segs, 99) ?? "none").toBe("none")
  const b: u8[] = [u8(1), u8(2)]
  expect(elemAt(b, 1) === u8(2)).toBe(true)
  expect(elemAt(b, 2) === u8(2)).toBe(false)
  expect(elemAt(b, 2) !== u8(0)).toBe(true)
  const none: string[] = []
  expect(elemAt(none, 0) === undefined).toBe(true)
})
