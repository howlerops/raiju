// RE2-style regular expressions: the subset that CEL's matches() and routing
// rules use. test() is unanchored, like RE2's MatchString.
//
// The engine is a backtracking VM over code points. Each (instruction,
// position) pair is explored at most once, as in RE2's BitState, so one search
// costs at most instructions x (input code points + 1) steps. That keeps
// nested quantifiers such as (a*)*b and (x+x+)+y fast, and makes loops whose
// body can match the empty string safe.
//
// LIMITS:
// - Matching works on code points. Case folding under (?i) covers ASCII only.
// - Unicode classes (\pL, \p{Greek}) and \C are rejected, not ignored.
// - Captures are reported by exec() (byte spans of each numbered group). test()
//   says only whether the pattern matches. Named groups are numbered like the
//   others.
// - Repeat counts are at most 1000. A pattern that expands past 50000
//   instructions, such as (a{1000}){1000}, is rejected at compile time.
// - Step budget: test() returns false without searching when instructions x
//   (input code points + 1) exceeds 4194304. Each search step visits a new
//   (instruction, position) pair, so that product is the most work a search
//   can do. Routing-rule patterns are far below it.
// - Greedy and lazy quantifiers accept the same strings, so for a bool result
//   they behave the same. The flag changes only branch order.
// - \Z, octal escapes and backreferences are not supported.

// Opcodes of a compiled program. The program is parallel int arrays with one row per
// instruction, so the matcher reads ints and copies no records. ax and ay hold the
// operands: a code point, a set index, an assertion code, a jump target or a slot.
const OP_CHAR = 0
const OP_SET = 1
const OP_ANY = 2
const OP_ASSERT = 3
const OP_SPLIT = 4
const OP_JMP = 5
const OP_SAVE = 6
const OP_MATCH = 7

// A compiled program. setBits holds 4 words per set (its ASCII members, 32 to a word);
// setLo and setHi hold the ranges of set k at indexes setAt[k] up to setAt[k+1]. first
// is the bitmap of code points a match can start with (firstHigh covers all the others).
// filtered is set when a match cannot be empty and cannot start with any code point, so
// the matcher skips each start whose character is not in first.
class Prog {
  constructor(public ops: int[], public ax: int[], public ay: int[], public setBits: int[], public setLo: int[], public setHi: int[], public setAt: int[], public first: int[], public firstHigh: bool, public filtered: bool) {}
  // every path starts with the start-of-text assertion (a leading ^ without the m flag): only start 0 can match
  anchored = false
}

// A text decoded once for many matches: its code points and the byte offset of each
// (at[i] for code point i, then the byte length).
export class Decoded {
  constructor(public cps: int[], public at: int[]) {}
}

export function decodeText(s: string): Decoded {
  const cps = decodeCps(s)
  return new Decoded(cps, byteStarts(cps))
}

// The matcher is a memoized backtracking VM over code points.
export class Regex {
  constructor(private prog: Prog, private ncap: int, private lits: LitCand[]) {}

  // Numbered groups in the pattern (group 0, the whole match, not counted).
  groups(): int {
    return this.ncap
  }

  // Lowercase ASCII literals, one of which every match contains (an any-of set), or none
  // when the pattern has no such set. A text with none of them has no match, so a caller
  // can skip it without running the matcher. The byte bound pre and the character set cls
  // say where a match holding the literal can start (see seqReq). A literal may overlap
  // itself (hasBorder), so a caller that finds occurrences must count overlapping ones.
  literals(): LitCand[] {
    return this.lits
  }

  // test() on a decoded text. With lo and hi given, only the starts in the byte ranges
  // [lo[r], hi[r]] are tried; a range is widened to whole code points, so the ranges
  // must cover every start a match could have. No ranges means every start.
  testDecoded(d: Decoded, lo: int[], hi: int[]): bool {
    const n = d.cps.length
    if (this.prog.ops.length * (n + 1) > stepLimit()) return false
    const rlo: int[] = []
    const rhi: int[] = []
    for (let r = 0; r < lo.length; r++) {
      if (hi[r]! < 0) continue
      rlo.push(cpFloor(d.at, lo[r]! < 0 ? 0 : lo[r]!))
      rhi.push(cpFloor(d.at, hi[r]!))
    }
    if (lo.length > 0 && rlo.length === 0) return false
    let caps: int[] = []
    return runProg(this.prog, d.cps, false, &caps, rlo, rhi)
  }

  // False when a text of n bytes is past the step budget, so test() and exec() would
  // give up on it. Code points never outnumber bytes, so this can refuse a multibyte
  // text that would fit; callers use it to skip a text without decoding it.
  fits(n: int): bool {
    return this.prog.ops.length * (n + 1) <= stepLimit()
  }

  test(s: string): bool {
    const cps = decodeCps(s)
    if (this.prog.ops.length * (cps.length + 1) > stepLimit()) return false
    let caps: int[] = []
    const none: int[] = []
    return runProg(this.prog, cps, false, &caps, none, none)
  }

  // The leftmost-first match, as RE2 and Perl choose it, with the span of every
  // group: byte offsets into s, [start0, end0, start1, end1, ...], -1 for a group
  // that did not take part. Undefined when there is no match or the input is past
  // the step budget. This is test()'s search with the captures tracked as in RE2's
  // BitState: a (instruction, position) pair is still explored at most once, and
  // that pruning cannot change the result, because captures never affect whether a
  // state reaches a match. The first path to reach the match is the highest-priority
  // one, so its captures are the ones reported.
  exec(s: string): int[] | undefined {
    const cps = decodeCps(s)
    const n = cps.length
    if (this.prog.ops.length * (n + 1) > stepLimit()) return undefined
    let caps: int[] = []
    for (let k = 0; k < 2 * (this.ncap + 1); k++) caps.push(-1)
    const none: int[] = []
    if (runProg(this.prog, cps, true, &caps, none, none)) return spansOf(caps, byteStarts(cps))
    return undefined
  }
}

// Parses src and compiles it. The error says what is wrong and where.
export function compileRegex(src: string): Regex throws SyntaxError {
  const p = new ReParser(decodeCps(src))
  const root = try p.top()
  const c = new ReCompiler()
  // Slots 0 and 1 hold the whole match; group k uses slots 2k and 2k+1.
  try c.emit({ kind: "save", slot: 0 })
  try c.gen(root)
  try c.emit({ kind: "save", slot: 1 })
  try c.emit({ kind: "match" })
  return new Regex(toProg(c.prog), p.groupCount(), seqReq([root]))
}

// Assertion codes: 0 bot, 1 eot, 2 bol, 3 eol, 4 wordb, 5 nwordb.
function assertCode(op: string): int {
  if (op === "bot") return 0
  if (op === "eot") return 1
  if (op === "bol") return 2
  if (op === "eol") return 3
  if (op === "wordb") return 4
  return 5
}

// The program as parallel int arrays, with the set bitmaps and the first characters.
function toProg(insts: Inst[]): Prog {
  const ops: int[] = []
  const ax: int[] = []
  const ay: int[] = []
  const setBits: int[] = []
  const setLo: int[] = []
  const setHi: int[] = []
  const setAt: int[] = []
  let nsets = 0
  for (const ins of insts) {
    if (ins.kind === "char") {
      ops.push(OP_CHAR)
      ax.push(ins.c)
      ay.push(0)
    } else if (ins.kind === "set") {
      ops.push(OP_SET)
      ax.push(nsets)
      ay.push(0)
      nsets += 1
      setAt.push(setLo.length)
      let bits: int[] = [0, 0, 0, 0]
      for (const x of ins.rs) {
        setLo.push(x.lo)
        setHi.push(x.hi)
        for (let c = x.lo; c <= x.hi && c < 128; c++) bits[c >> 5] = bits[c >> 5]! | (1 << (c & 31))
      }
      for (const w of bits) setBits.push(w)
    } else if (ins.kind === "any") {
      ops.push(OP_ANY)
      ax.push(ins.nl ? 1 : 0)
      ay.push(0)
    } else if (ins.kind === "assert") {
      ops.push(OP_ASSERT)
      ax.push(assertCode(ins.op))
      ay.push(0)
    } else if (ins.kind === "split") {
      ops.push(OP_SPLIT)
      ax.push(ins.x)
      ay.push(ins.y)
    } else if (ins.kind === "jmp") {
      ops.push(OP_JMP)
      ax.push(ins.x)
      ay.push(0)
    } else if (ins.kind === "save") {
      ops.push(OP_SAVE)
      ax.push(ins.slot)
      ay.push(0)
    } else {
      ops.push(OP_MATCH)
      ax.push(0)
      ay.push(0)
    }
  }
  setAt.push(setLo.length)
  // The first characters: follow the edges that consume nothing (split, jmp, save and
  // assert) from the start. A match that can be reached without a character can be empty.
  const first: int[] = [0, 0, 0, 0]
  let firstHigh = false
  let firstAll = false
  let nullable = false
  const visited: bool[] = []
  for (let k = 0; k < ops.length; k++) visited.push(false)
  const todo: int[] = [0]
  while (todo.length > 0) {
    const pc = todo.pop()!
    if (visited[pc]!) continue
    visited[pc] = true
    const op = ops[pc]!
    if (op === OP_CHAR) {
      const c = ax[pc]!
      if (c >= 128) {
        firstHigh = true
      } else {
        first[c >> 5] = first[c >> 5]! | (1 << (c & 31))
      }
    } else if (op === OP_SET) {
      const k = ax[pc]!
      for (let w = 0; w < 4; w++) first[w] = first[w]! | setBits[4 * k + w]!
      for (let j = setAt[k]!; j < setAt[k + 1]!; j++) {
        if (setHi[j]! >= 128) firstHigh = true
      }
    } else if (op === OP_ANY) {
      firstAll = true
    } else if (op === OP_SPLIT) {
      todo.push(ax[pc]!)
      todo.push(ay[pc]!)
    } else if (op === OP_JMP) {
      todo.push(ax[pc]!)
    } else if (op === OP_MATCH) {
      nullable = true
    } else {
      todo.push(pc + 1)
    }
  }
  const prog = new Prog(ops, ax, ay, setBits, setLo, setHi, setAt, first, firstHigh, !nullable && !firstAll)
  let pc0 = 0
  while (pc0 < ops.length && ops[pc0]! === OP_SAVE) pc0 += 1
  prog.anchored = pc0 < ops.length && ops[pc0]! === OP_ASSERT && ax[pc0]! === 0
  return prog
}

// Byte offset of each code point of cps, then the byte length.
function byteStarts(cps: int[]): int[] {
  const out: int[] = []
  let at = 0
  for (const c of cps) {
    out.push(at)
    if (c < 128) {
      at += 1
    } else if (c < 2048) {
      at += 2
    } else if (c < 65536) {
      at += 3
    } else {
      at += 4
    }
  }
  out.push(at)
  return out
}

// Slot values (code point indices) as byte offsets.
function spansOf(caps: int[], at: int[]): int[] {
  const out: int[] = []
  for (const v of caps) out.push(v < 0 ? -1 : at[v]!)
  return out
}

// ---- code points and bits ----

// Decodes UTF-8 into code points. Tov strings are valid UTF-8, so the
// fallback for a malformed byte is only defensive.
function decodeCps(s: string): int[] {
  const b = new TextEncoder().encode(s)
  const out: int[] = []
  let i = 0
  while (i < b.length) {
    const c = int(b[i]!)
    let cp = 0xfffd
    let n = 1
    if (c < 0x80) {
      cp = c
    } else if (c >= 0xc0 && c < 0xe0 && i + 1 < b.length) {
      cp = ((c & 0x1f) << 6) | (int(b[i + 1]!) & 0x3f)
      n = 2
    } else if (c >= 0xe0 && c < 0xf0 && i + 2 < b.length) {
      cp = ((c & 0x0f) << 12) | ((int(b[i + 1]!) & 0x3f) << 6) | (int(b[i + 2]!) & 0x3f)
      n = 3
    } else if (c >= 0xf0 && c < 0xf8 && i + 3 < b.length) {
      cp = ((c & 0x07) << 18) | ((int(b[i + 1]!) & 0x3f) << 12) | ((int(b[i + 2]!) & 0x3f) << 6) | (int(b[i + 3]!) & 0x3f)
      n = 4
    }
    out.push(cp)
    i += n
  }
  return out
}

function utf8Push(inout buf: u8[], cp: int): void {
  if (cp < 0x80) {
    buf.push(u8(cp))
  } else if (cp < 0x800) {
    buf.push(u8(0xc0 | (cp >> 6)))
    buf.push(u8(0x80 | (cp & 0x3f)))
  } else if (cp < 0x10000) {
    buf.push(u8(0xe0 | (cp >> 12)))
    buf.push(u8(0x80 | ((cp >> 6) & 0x3f)))
    buf.push(u8(0x80 | (cp & 0x3f)))
  } else {
    buf.push(u8(0xf0 | (cp >> 18)))
    buf.push(u8(0x80 | ((cp >> 12) & 0x3f)))
    buf.push(u8(0x80 | ((cp >> 6) & 0x3f)))
    buf.push(u8(0x80 | (cp & 0x3f)))
  }
}

// Text of code points p[from..to). Used for the short ASCII names in [:name:].
function cpString(p: int[], from: int, to: int): string {
  let b: u8[] = []
  for (let k = from; k < to; k++) utf8Push(&b, p[k]!)
  try {
    return new TextDecoder().decode(b)
  } catch (e) {
    return ""
  }
}

// Visited set: one bit per (instruction, position) pair, 32 to an int.
function newBits(count: int): int[] {
  const words: int[] = []
  const nw = (count >> 5) + 1
  for (let i = 0; i < nw; i++) words.push(0)
  return words
}

function testBit(words: int[], idx: int): bool {
  return (words[idx >> 5]! & (1 << (idx & 31))) !== 0
}

function setBit(inout words: int[], idx: int): void {
  const w = idx >> 5
  words[w] = words[w]! | (1 << (idx & 31))
}

// Limits. Functions rather than constants: top-level statements in an imported
// module do not run.
function stepLimit(): int {
  return 4194304
}

function progLimit(): int {
  return 50000
}

function maxRepeat(): int {
  return 1000
}

function isDigitCp(c: int): bool {
  return c >= 48 && c <= 57
}

function isLetterCp(c: int): bool {
  return (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

function isWordCp(c: int): bool {
  return isDigitCp(c) || isLetterCp(c) || c === 95
}

function hexDigit(c: int): int {
  if (isDigitCp(c)) return c - 48
  if (c >= 97 && c <= 102) return c - 87
  if (c >= 65 && c <= 70) return c - 55
  return -1
}

function toLower(c: int): int {
  return c >= 65 && c <= 90 ? c + 32 : c
}

function toUpper(c: int): int {
  return c >= 97 && c <= 122 ? c - 32 : c
}

// ---- ranges ----

type Range = { lo: int, hi: int }

const MAX_CP = 0x10ffff

function r(lo: int, hi: int): Range {
  return { lo: lo, hi: hi }
}

function inRanges(rs: Range[], c: int): bool {
  for (const x of rs) {
    if (c >= x.lo && c <= x.hi) return true
  }
  return false
}

// Sorts and merges, so complement() can walk the gaps.
function normalize(rs: Range[]): Range[] {
  const s: Range[] = []
  for (const x of rs) s.push(x)
  s.sort((a, b) => a.lo - b.lo)
  const out: Range[] = []
  for (const x of s) {
    const last = out.length - 1
    if (last >= 0 && x.lo <= out[last]!.hi + 1) {
      if (x.hi > out[last]!.hi) out[last] = r(out[last]!.lo, x.hi)
    } else {
      out.push(x)
    }
  }
  return out
}

// rs must be normalized.
function complement(rs: Range[]): Range[] {
  const out: Range[] = []
  let next = 0
  for (const x of rs) {
    if (x.lo > next) out.push(r(next, x.lo - 1))
    next = x.hi + 1
  }
  if (next <= MAX_CP) out.push(r(next, MAX_CP))
  return out
}

// Adds the other-case ASCII letters of every range (ASCII-only folding).
function foldRanges(rs: Range[]): Range[] {
  const out: Range[] = []
  for (const x of rs) {
    out.push(x)
    const a = x.lo > 65 ? x.lo : 65
    const b = x.hi < 90 ? x.hi : 90
    if (a <= b) out.push(r(a + 32, b + 32))
    const c = x.lo > 97 ? x.lo : 97
    const d = x.hi < 122 ? x.hi : 122
    if (c <= d) out.push(r(c - 32, d - 32))
  }
  return out
}

function digitRanges(): Range[] {
  return [r(48, 57)]
}

function spaceRanges(): Range[] {
  // RE2's \s is [\t\n\f\r ]; it has no \v.
  return [r(9, 10), r(12, 13), r(32, 32)]
}

function wordRanges(): Range[] {
  return [r(48, 57), r(65, 90), r(95, 95), r(97, 122)]
}

// Ranges for \d \D \s \S \w \W, or undefined for any other escape.
function escapeClass(c: int): Range[] | undefined {
  if (c === 100) return digitRanges()
  if (c === 68) return complement(digitRanges())
  if (c === 115) return spaceRanges()
  if (c === 83) return complement(spaceRanges())
  if (c === 119) return wordRanges()
  if (c === 87) return complement(wordRanges())
  return undefined
}

// Ranges for a [:name:] class, or undefined for an unknown name.
function posixRanges(name: string): Range[] | undefined {
  if (name === "alnum") return [r(48, 57), r(65, 90), r(97, 122)]
  if (name === "alpha") return [r(65, 90), r(97, 122)]
  if (name === "ascii") return [r(0, 127)]
  if (name === "blank") return [r(9, 9), r(32, 32)]
  if (name === "cntrl") return [r(0, 31), r(127, 127)]
  if (name === "digit") return digitRanges()
  if (name === "graph") return [r(33, 126)]
  if (name === "lower") return [r(97, 122)]
  if (name === "print") return [r(32, 126)]
  if (name === "punct") return [r(33, 47), r(58, 64), r(91, 96), r(123, 126)]
  if (name === "space") return [r(9, 13), r(32, 32)]
  if (name === "upper") return [r(65, 90)]
  if (name === "word") return wordRanges()
  if (name === "xdigit") return [r(48, 57), r(65, 70), r(97, 102)]
  return undefined
}

// ---- parsing ----

type Flags = { fold: bool, dotNl: bool, multi: bool, ungreedy: bool }

// Children sit in arrays, so no node contains itself directly.
type Node = { kind: "empty" }
  | { kind: "lit", c: int }
  | { kind: "set", rs: Range[] }
  | { kind: "any", nl: bool }
  | { kind: "assert", op: string }
  | { kind: "cat", items: Node[] }
  | { kind: "alt", items: Node[] }
  | { kind: "rep", min: int, max: int, greedy: bool, items: Node[] }
  | { kind: "cap", idx: int, items: Node[] }

type Rep = { min: int, max: int, end: int }

type Num = { n: int, end: int }

class ReParser {
  private i = 0
  private ncap = 0
  private flags: Flags = { fold: false, dotNl: false, multi: false, ungreedy: false }

  constructor(private p: int[]) {}

  groupCount(): int {
    return this.ncap
  }

  more(): bool {
    return this.i < this.p.length
  }

  at(k: int): int {
    if (k < 0 || k >= this.p.length) return -1
    return this.p[k]!
  }

  peek(): int {
    return this.at(this.i)
  }

  peekIs(c: int): bool {
    return this.at(this.i) === c
  }

  // Returns the code point at the cursor and moves past it. Callers check more() first.
  next(): int {
    const c = this.at(this.i)
    this.i += 1
    return c
  }

  fail(msg: string): SyntaxError {
    return new SyntaxError(`${msg} at position ${this.i + 1}`)
  }

  top(): Node throws SyntaxError {
    const n = try this.alt()
    if (this.more()) throw this.fail("unexpected )")
    return n
  }

  // alt := seq ('|' seq)*. Stops at ')' or the end; the caller checks which.
  alt(): Node throws SyntaxError {
    const alts: Node[] = []
    alts.push(try this.seq())
    while (this.peekIs(124)) {
      this.i += 1
      alts.push(try this.seq())
    }
    if (alts.length === 1) return alts[0]!
    return { kind: "alt", items: alts }
  }

  seq(): Node throws SyntaxError {
    const items: Node[] = []
    while (this.more()) {
      const c = this.peek()
      if (c === 124 || c === 41) break
      const a = try this.atom()
      // A flag group such as (?i) yields no node.
      if (a !== undefined) items.push(try this.quantified(a))
    }
    if (items.length === 0) return { kind: "empty" }
    if (items.length === 1) return items[0]!
    return { kind: "cat", items: items }
  }

  atom(): Node | undefined throws SyntaxError {
    const start = this.i
    const c = this.next()
    if (c === 46) return { kind: "any", nl: this.flags.dotNl }
    if (c === 94) return { kind: "assert", op: this.flags.multi ? "bol" : "bot" }
    if (c === 36) return { kind: "assert", op: this.flags.multi ? "eol" : "eot" }
    if (c === 91) return try this.cls()
    if (c === 92) return try this.escape()
    if (c === 40) return try this.group()
    if (c === 42 || c === 43 || c === 63) throw this.fail("missing argument to repetition operator")
    if (c === 123) {
      // A '{' that does not start a valid repeat is a literal.
      const rep = try this.repeatAt(start)
      if (rep !== undefined) throw this.fail("missing argument to repetition operator")
    }
    return this.lit(c)
  }

  lit(c: int): Node {
    if (this.flags.fold && isLetterCp(c)) {
      return { kind: "set", rs: [r(toLower(c), toLower(c)), r(toUpper(c), toUpper(c))] }
    }
    return { kind: "lit", c: c }
  }

  quantified(a: Node): Node throws SyntaxError {
    const c = this.peek()
    let min: int = 0
    let max: int = 0
    if (c === 42) {
      max = -1
      this.i += 1
    } else if (c === 43) {
      min = 1
      max = -1
      this.i += 1
    } else if (c === 63) {
      max = 1
      this.i += 1
    } else if (c === 123) {
      const rep = try this.repeatAt(this.i)
      if (rep === undefined) return a
      min = rep.min
      max = rep.max
      this.i = rep.end
    } else {
      return a
    }
    let greedy = !this.flags.ungreedy
    if (this.peekIs(63)) {
      greedy = !greedy
      this.i += 1
    }
    if (try this.repeatStarts()) throw this.fail("invalid nested repetition operator")
    return { kind: "rep", min: min, max: max, greedy: greedy, items: [a] }
  }

  repeatStarts(): bool throws SyntaxError {
    const c = this.peek()
    if (c === 42 || c === 43 || c === 63) return true
    if (c === 123) {
      const rep = try this.repeatAt(this.i)
      return rep !== undefined
    }
    return false
  }

  // Digits at p[j..]. Undefined when there are none.
  digits(j: int): Num | undefined {
    let k = j
    let n = 0
    while (isDigitCp(this.at(k))) {
      // Clamped: anything this large is over maxRepeat() anyway.
      if (n < 100000) n = n * 10 + (this.at(k) - 48)
      k += 1
    }
    if (k === j) return undefined
    return { n: n, end: k }
  }

  // Parses {n}, {n,} or {n,m} at pos. Undefined when the text is not a repeat
  // (then the '{' is a literal). Throws when the counts are out of range.
  repeatAt(pos: int): Rep | undefined throws SyntaxError {
    if (!this.peekAtIs(pos, 123)) return undefined
    const lo = this.digits(pos + 1)
    if (lo === undefined) return undefined
    let min = lo.n
    let max = lo.n
    let j = lo.end
    if (this.peekAtIs(j, 44)) {
      j += 1
      const hi = this.digits(j)
      if (hi === undefined) {
        max = -1
      } else {
        max = hi.n
        j = hi.end
      }
    }
    if (!this.peekAtIs(j, 125)) return undefined
    if (min > maxRepeat() || max > maxRepeat() || (max >= 0 && min > max)) {
      throw this.fail("invalid repeat count")
    }
    return { min: min, max: max, end: j + 1 }
  }

  peekAtIs(k: int, c: int): bool {
    return this.at(k) === c
  }

  // Called after '('.
  group(): Node | undefined throws SyntaxError {
    const saved = this.flags
    let capture = true
    if (this.peekIs(63)) {
      this.i += 1
      if (this.peekIs(58)) {
        this.i += 1
        capture = false
      } else if (this.peekIs(80) || this.peekIs(60)) {
        // (?P<name>re) and (?<name>re): a numbered capture; the name is only checked.
        if (this.peekIs(80)) this.i += 1
        if (!this.peekIs(60)) throw this.fail("invalid named capture")
        this.i += 1
        const nameStart = this.i
        while (isWordCp(this.peek())) this.i += 1
        if (this.i === nameStart || !this.peekIs(62)) throw this.fail("invalid named capture")
        this.i += 1
      } else {
        return try this.flagGroup(saved)
      }
    }
    // Groups are numbered by their opening parenthesis, as in RE2.
    let idx = 0
    if (capture) {
      this.ncap += 1
      idx = this.ncap
    }
    const body = try this.alt()
    if (!this.peekIs(41)) throw this.fail("missing closing )")
    this.i += 1
    this.flags = saved
    if (capture) return { kind: "cap", idx: idx, items: [body] }
    return body
  }

  // (?flags) changes the flags of the enclosing group and yields no node.
  // (?flags:re) is a group with those flags.
  flagGroup(saved: Flags): Node | undefined throws SyntaxError {
    let f = this.flags
    let on = true
    let any = false
    while (this.more()) {
      const c = this.next()
      if (c === 41 || c === 58) {
        if (!any) throw this.fail("missing flags in group")
        this.flags = f
        if (c === 41) return undefined
        const body = try this.alt()
        if (!this.peekIs(41)) throw this.fail("missing closing )")
        this.i += 1
        this.flags = saved
        return body
      }
      if (c === 45) {
        on = false
      } else if (c === 105) {
        f.fold = on
      } else if (c === 109) {
        f.multi = on
      } else if (c === 115) {
        f.dotNl = on
      } else if (c === 85) {
        f.ungreedy = on
      } else {
        throw this.fail("invalid or unsupported Perl syntax")
      }
      any = true
    }
    throw this.fail("missing closing )")
  }

  // Called after '\'. Outside a class.
  escape(): Node throws SyntaxError {
    if (!this.more()) throw this.fail("trailing \\")
    const c = this.next()
    if (c === 98) return { kind: "assert", op: "wordb" }
    if (c === 66) return { kind: "assert", op: "nwordb" }
    if (c === 65) return { kind: "assert", op: "bot" }
    if (c === 122) return { kind: "assert", op: "eot" }
    if (c === 81) return this.quoted()
    if (c === 112 || c === 80) throw this.fail("Unicode classes are not supported")
    const sub = escapeClass(c)
    if (sub !== undefined) return { kind: "set", rs: sub }
    return this.lit(try this.charEscape(c))
  }

  // \Q...\E: literal text. Without \E it runs to the end, as in RE2.
  quoted(): Node {
    const items: Node[] = []
    while (this.more()) {
      if (this.peekIs(92) && this.at(this.i + 1) === 69) {
        this.i += 2
        return { kind: "cat", items: items }
      }
      items.push(this.lit(this.next()))
    }
    return { kind: "cat", items: items }
  }

  // The code point for an escape whose letter c is already consumed.
  charEscape(c: int): int throws SyntaxError {
    if (c === 110) return 10
    if (c === 116) return 9
    if (c === 114) return 13
    if (c === 102) return 12
    if (c === 118) return 11
    if (c === 97) return 7
    if (c === 120) return try this.hexEscape()
    if (c < 0) throw this.fail("trailing \\")
    // Any ASCII punctuation or non-ASCII character escapes to itself. Letters,
    // digits and '_' are reserved, so an escape of them is an error.
    if (c >= 128 || !isWordCp(c)) return c
    throw this.fail("invalid escape sequence")
  }

  // \xHH or \x{H...}. The 'x' is already consumed.
  hexEscape(): int throws SyntaxError {
    if (this.peekIs(123)) {
      this.i += 1
      let v = 0
      let digits = 0
      while (this.more() && !this.peekIs(125)) {
        const h = hexDigit(this.next())
        if (h < 0) throw this.fail("invalid \\x escape")
        v = v * 16 + h
        if (v > MAX_CP) throw this.fail("invalid \\x escape")
        digits += 1
      }
      if (!this.more() || digits === 0) throw this.fail("invalid \\x escape")
      this.i += 1
      return v
    }
    const a = hexDigit(this.at(this.i))
    const b = hexDigit(this.at(this.i + 1))
    if (a < 0 || b < 0) throw this.fail("invalid \\x escape")
    this.i += 2
    return a * 16 + b
  }

  // Called after '['. The leading ']' is a literal, as in RE2.
  cls(): Node throws SyntaxError {
    let neg = false
    if (this.peekIs(94)) {
      neg = true
      this.i += 1
    }
    const rs: Range[] = []
    let first = true
    let closed = false
    while (this.more()) {
      if (this.peekIs(93) && !first) {
        this.i += 1
        closed = true
        break
      }
      first = false
      if (this.peekIs(91) && this.at(this.i + 1) === 58) {
        const named = try this.posix()
        if (named !== undefined) {
          for (const x of named) rs.push(x)
          continue
        }
      }
      let lo = 0
      if (this.peekIs(92)) {
        this.i += 1
        if (!this.more()) throw this.fail("trailing \\")
        const e = this.next()
        const sub = escapeClass(e)
        if (sub !== undefined) {
          for (const x of sub) rs.push(x)
          continue
        }
        lo = try this.charEscape(e)
      } else {
        lo = this.next()
      }
      let hi = lo
      if (this.peekIs(45) && this.at(this.i + 1) >= 0 && this.at(this.i + 1) !== 93) {
        this.i += 1
        if (this.peekIs(92)) {
          this.i += 1
          if (!this.more()) throw this.fail("trailing \\")
          hi = try this.charEscape(this.next())
        } else {
          hi = this.next()
        }
        if (hi < lo) throw this.fail("invalid character class range")
      }
      rs.push(r(lo, hi))
    }
    if (!closed) throw this.fail("missing closing ]")
    let out = normalize(rs)
    if (this.flags.fold) out = normalize(foldRanges(out))
    if (neg) out = complement(out)
    return { kind: "set", rs: out }
  }

  // At "[:". Returns the ranges of a [:name:] class, or undefined when the text is not one.
  posix(): Range[] | undefined throws SyntaxError {
    let j = this.i + 2
    let neg = false
    if (this.peekAtIs(j, 94)) {
      neg = true
      j += 1
    }
    const start = j
    while (isLetterCp(this.at(j))) j += 1
    if (!this.peekAtIs(j, 58) || !this.peekAtIs(j + 1, 93)) return undefined
    const rs = posixRanges(cpString(this.p, start, j))
    if (rs === undefined) throw this.fail("invalid character class name")
    this.i = j + 2
    if (neg) return complement(normalize(rs))
    return rs
  }
}

// ---- compiling ----

type Inst = { kind: "char", c: int }
  | { kind: "set", rs: Range[] }
  | { kind: "any", nl: bool }
  | { kind: "assert", op: string }
  | { kind: "split", x: int, y: int }
  | { kind: "jmp", x: int }
  | { kind: "save", slot: int }
  | { kind: "match" }

// A search branch. slot < 0 is a branch to (pc, pos); slot >= 0 is a restore
// entry that puts pos back into capture slot slot when backtracking reaches it.
type Branch = { pc: int, pos: int, slot: int }


function splitI(x: int, y: int): Inst {
  return { kind: "split", x: x, y: y }
}

function jmpI(x: int): Inst {
  return { kind: "jmp", x: x }
}

// Greedy prefers the body (x); lazy prefers the exit (y).
function splitOf(body: int, exit: int, greedy: bool): Inst {
  if (greedy) return splitI(body, exit)
  return splitI(exit, body)
}

class ReCompiler {
  prog: Inst[] = []

  emit(i: Inst): int throws SyntaxError {
    if (this.prog.length >= progLimit()) throw new SyntaxError("pattern too large")
    this.prog.push(i)
    return this.prog.length - 1
  }

  gen(n: Node): void throws SyntaxError {
    if (n.kind === "empty") return
    if (n.kind === "lit") {
      try this.emit({ kind: "char", c: n.c })
      return
    }
    if (n.kind === "set") {
      try this.emit({ kind: "set", rs: n.rs })
      return
    }
    if (n.kind === "any") {
      try this.emit({ kind: "any", nl: n.nl })
      return
    }
    if (n.kind === "assert") {
      try this.emit({ kind: "assert", op: n.op })
      return
    }
    if (n.kind === "cap") {
      try this.emit({ kind: "save", slot: 2 * n.idx })
      try this.gen(n.items[0]!)
      try this.emit({ kind: "save", slot: 2 * n.idx + 1 })
      return
    }
    if (n.kind === "cat") {
      for (const x of n.items) {
        try this.gen(x)
      }
      return
    }
    if (n.kind === "alt") {
      const jumps: int[] = []
      for (let k = 0; k < n.items.length; k++) {
        const item = n.items[k]!
        if (k + 1 < n.items.length) {
          const sp = try this.emit(splitI(0, 0))
          try this.gen(item)
          jumps.push(try this.emit(jmpI(0)))
          this.prog[sp] = splitI(sp + 1, this.prog.length)
        } else {
          try this.gen(item)
        }
      }
      const end = this.prog.length
      for (const j of jumps) {
        this.prog[j] = jmpI(end)
      }
      return
    }
    // rep: min copies, then either a loop (unbounded) or max - min optional copies.
    const sub = n.items[0]!
    for (let k = 0; k < n.min; k++) {
      try this.gen(sub)
    }
    if (n.max < 0) {
      const loop = try this.emit(splitI(0, 0))
      try this.gen(sub)
      try this.emit(jmpI(loop))
      this.prog[loop] = splitOf(loop + 1, this.prog.length, n.greedy)
      return
    }
    const splits: int[] = []
    for (let k = n.min; k < n.max; k++) {
      splits.push(try this.emit(splitI(0, 0)))
      try this.gen(sub)
    }
    const end = this.prog.length
    for (const sp of splits) {
      this.prog[sp] = splitOf(sp + 1, end, n.greedy)
    }
  }
}

// ---- helpers used by the matcher ----

function assertHolds(op: int, cps: int[], pos: int): bool {
  const n = cps.length
  if (op === 0) return pos === 0
  if (op === 1) return pos === n
  if (op === 2) return pos === 0 || cps[pos - 1] === 10
  if (op === 3) return pos === n || cps[pos] === 10
  const before = pos > 0 && isWordCp(cps[pos - 1]!)
  const after = pos < n && isWordCp(cps[pos]!)
  if (op === 4) return before !== after
  return before === after
}

// Whether a match can start with code point c.
function startOk(p: Prog, c: int): bool {
  if (c >= 128) return p.firstHigh
  return ((p.first[c >> 5]! >> (c & 31)) & 1) === 1
}

// Whether set k of the program holds code point c.
function setHas(p: Prog, k: int, c: int): bool {
  if (c < 128) return ((p.setBits[4 * k + (c >> 5)]! >> (c & 31)) & 1) === 1
  const end = p.setAt[k + 1]!
  for (let j = p.setAt[k]!; j < end; j++) {
    if (c >= p.setLo[j]! && c <= p.setHi[j]!) return true
  }
  return false
}

// The code point holding byte b: the largest i with at[i] <= b.
function cpFloor(at: int[], b: int): int {
  let lo = 0
  let hi = at.length - 1
  while (lo < hi) {
    const mid = (lo + hi + 1) >> 1
    if (at[mid]! <= b) {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  return lo
}

// Whether code point index i lies in one of the ranges [lo[r], hi[r]].
function startIn(lo: int[], hi: int[], i: int): bool {
  for (let r = 0; r < lo.length; r++) {
    if (i >= lo[r]! && i <= hi[r]!) return true
  }
  return false
}

// Runs the program over cps, from each start in turn: true at the first match found.
// With track set, save instructions record positions in caps and restore them when the
// search backtracks past them, so caps holds the match's spans on return.
function runProg(p: Prog, cps: int[], track: bool, inout caps: int[], rlo: int[], rhi: int[]): bool {
  const found = runOn(p, cps, track, &caps, rlo, rhi)
  // the visited bits are kept for the next run: only the words this run set are cleared
  const sc = SCRATCH
  for (const w of sc.touched) sc.bits[w] = 0
  sc.touched = []
  return found
}

// The (instruction, position) pairs already explored, kept between runs so a big program on a short text does not
// allocate and clear its whole table each time (the allowlist patterns run once per finding).
class Scratch {
  bits: int[] = []
  touched: int[] = []
}

function newScratch(): Scratch {
  return new Scratch()
}

const SCRATCH = newScratch()

function runOn(p: Prog, cps: int[], track: bool, inout caps: int[], rlo: int[], rhi: int[]): bool {
  const n = cps.length
  const stride = n + 1
  const sc = SCRATCH
  const need = ((p.ops.length * stride) >> 5) + 1
  while (sc.bits.length < need) sc.bits.push(0)
  let stk: int[] = []
  for (let start = 0; start <= n; start++) {
    // A pattern anchored at the start of the text has nowhere else to start.
    if (p.anchored && start > 0) break
    // With ranges given, only starts inside them are tried.
    if (rlo.length > 0 && !startIn(rlo, rhi, start)) continue
    // A start whose character cannot begin a match has no match to find.
    if (p.filtered) {
      if (start >= n) break
      if (!startOk(p, cps[start]!)) continue
    }
    // Stack entries are three ints: pc, pos, slot. A slot >= 0 is a restore entry
    // that puts pos back into that capture slot; slot -1 is a branch to (pc, pos).
    stk.push(0)
    stk.push(start)
    stk.push(-1)
    while (stk.length > 0) {
      const slot = stk.pop()!
      const at = stk.pop()!
      let pc = stk.pop()!
      if (slot >= 0) {
        caps[slot] = at
        continue
      }
      let pos = at
      while (true) {
        const idx = pc * stride + pos
        const wd = idx >> 5
        const word = sc.bits[wd]!
        const bit = 1 << (idx & 31)
        if ((word & bit) !== 0) break
        if (word === 0) sc.touched.push(wd)
        sc.bits[wd] = word | bit
        const op = p.ops[pc]!
        if (op === OP_CHAR) {
          if (pos >= n || cps[pos] !== p.ax[pc]) break
          pc += 1
          pos += 1
        } else if (op === OP_SET) {
          if (pos >= n || !setHas(p, p.ax[pc]!, cps[pos]!)) break
          pc += 1
          pos += 1
        } else if (op === OP_SPLIT) {
          stk.push(p.ay[pc]!)
          stk.push(pos)
          stk.push(-1)
          pc = p.ax[pc]!
        } else if (op === OP_JMP) {
          pc = p.ax[pc]!
        } else if (op === OP_ANY) {
          if (pos >= n || (p.ax[pc] === 0 && cps[pos] === 10)) break
          pc += 1
          pos += 1
        } else if (op === OP_SAVE) {
          if (track) {
            const s = p.ax[pc]!
            stk.push(0)
            stk.push(caps[s]!)
            stk.push(s)
            caps[s] = pos
          }
          pc += 1
        } else if (op === OP_ASSERT) {
          if (!assertHolds(p.ax[pc]!, cps, pos)) break
          pc += 1
        } else {
          return true
        }
      }
    }
  }
  return false
}

// ---- required literals ----
// A literal is a run of characters every match must contain, lowercased when it is
// ASCII: a match of a case-folded letter contains the letter in either case, and the
// window filter in guard_regex lowercases the text the same way. pre is the most bytes a
// match can consume before the literal, so a match that holds the literal at byte q
// starts at or after q - pre. pre is -1 when no bound is known.

export type LitCand = { lit: string, pre: int, cls: Cset }

// A set of characters: the ASCII members as 4 words, whether some non-ASCII character is
// in it, and whether every character is (a dot).
export type Cset = { bits: int[], high: bool, any: bool }

// The ASCII lowercase of code point c, or -1 when c is not ASCII.
function asciiLow(c: int): int {
  if (c < 0 || c >= 128) return -1
  return c >= 65 && c <= 90 ? c + 32 : c
}

// The lowercase ASCII code point a node matches on its own, or -1 when it matches
// anything else. A set counts when all its members fold to one character.
function singleChar(n: Node): int {
  if (n.kind === "lit") return asciiLow(n.c)
  if (n.kind === "set") {
    let out = -1
    for (const x of n.rs) {
      if (x.lo !== x.hi) return -1
      const c = asciiLow(x.lo)
      if (c < 0 || (out >= 0 && c !== out)) return -1
      out = c
    }
    return out
  }
  return -1
}

function emptyCset(): Cset {
  return { bits: [0, 0, 0, 0], high: false, any: false }
}

// The union of two character sets.
function unionCs(a: Cset, b: Cset): Cset {
  const bits: int[] = []
  for (let w = 0; w < 4; w++) bits.push(a.bits[w]! | b.bits[w]!)
  return { bits: bits, high: a.high || b.high, any: a.any || b.any }
}

function addCp(inout cs: Cset, c: int): void {
  if (c >= 128) {
    cs.high = true
  } else {
    cs.bits[c >> 5] = cs.bits[c >> 5]! | (1 << (c & 31))
  }
}

// Adds the characters a node can match to cs. An assertion or an empty node matches none.
function addNode(n: Node, inout cs: Cset): void {
  if (n.kind === "lit") {
    addCp(&cs, n.c)
  } else if (n.kind === "set") {
    for (const x of n.rs) {
      for (let c = x.lo; c <= x.hi && c < 128; c++) addCp(&cs, c)
      if (x.hi >= 128) cs.high = true
    }
  } else if (n.kind === "any") {
    cs.any = true
  } else if (n.kind === "cat") {
    for (const x of n.items) addNode(x, &cs)
  } else if (n.kind === "cap") {
    for (const x of n.items) addNode(x, &cs)
  } else if (n.kind === "alt") {
    for (const x of n.items) addNode(x, &cs)
  } else if (n.kind === "rep") {
    if (n.max !== 0) addNode(n.items[0]!, &cs)
  }
}

// The characters a node can match.
function charsOf(n: Node): Cset {
  let cs = emptyCset()
  addNode(n, &cs)
  return cs
}

// Bytes of one code point in UTF-8.
function utf8Len(c: int): int {
  if (c < 128) return 1
  if (c < 2048) return 2
  if (c < 65536) return 3
  return 4
}

// a + b, or -1 when either is unbounded.
function addBytes(a: int, b: int): int {
  if (a < 0 || b < 0) return -1
  return a + b
}

// The most bytes a node can match, or -1 when that is unbounded.
function maxBytes(n: Node): int {
  if (n.kind === "empty" || n.kind === "assert") return 0
  if (n.kind === "lit") return utf8Len(n.c)
  if (n.kind === "set") {
    // an ASCII-only set matches one byte
    for (const x of n.rs) {
      if (x.hi >= 128) return 4
    }
    return 1
  }
  if (n.kind === "any") return 4
  if (n.kind === "cat" || n.kind === "cap") {
    let total = 0
    for (const x of n.items) total = addBytes(total, maxBytes(x))
    return total
  }
  if (n.kind === "alt") {
    let m = 0
    for (const x of n.items) {
      const b = maxBytes(x)
      if (b < 0) return -1
      if (b > m) m = b
    }
    return m
  }
  // a repeat of a node that matches nothing matches nothing however often it repeats
  const b = maxBytes(n.items[0]!)
  if (b === 0) return 0
  if (n.max < 0 || b < 0) return -1
  return b * n.max
}

// Appends the nodes of a sequence to out, with concatenations and groups spliced in.
// A group is a zero-width wrapper for this purpose.
function flatten(items: Node[], inout out: Node[]): void {
  for (const x of items) {
    if (x.kind === "cat") {
      flatten(x.items, &out)
    } else if (x.kind === "cap") {
      flatten(x.items, &out)
    } else {
      out.push(x)
    }
  }
}

// The candidates of a node that starts off bytes into the sequence, after the characters
// pref: their bounds and sets count what comes before them.
function shiftLits(xs: LitCand[], off: int, pref: Cset): LitCand[] {
  const out: LitCand[] = []
  for (const x of xs) out.push({ lit: x.lit, pre: addBytes(x.pre, off), cls: unionCs(pref, x.cls) })
  return out
}

// The literal of a run of code points, or none for an empty run.
function flushRun(run: int[], pre: int, cls: Cset): LitCand[] {
  if (run.length === 0) return []
  return [{ lit: cpString(run, 0, run.length), pre: pre, cls: cls }]
}

function shortestLen(xs: LitCand[]): int {
  let m = xs[0]!.lit.byteLength
  for (const x of xs) {
    if (x.lit.byteLength < m) m = x.lit.byteLength
  }
  return m
}

// The largest pre of a set, with unbounded as the largest.
function maxPre(xs: LitCand[]): int {
  let m = 0
  for (const x of xs) {
    if (x.pre < 0) return 1000000000
    if (x.pre > m) m = x.pre
  }
  return m
}

// The better of two candidate sets. The longer shortest literal is the stronger filter,
// then fewer literals, then the smaller largest pre. An empty set means none.
function betterLits(a: LitCand[], b: LitCand[]): LitCand[] {
  if (b.length === 0) return a
  if (a.length === 0) return b
  const la = shortestLen(a)
  const lb = shortestLen(b)
  if (la !== lb) return lb > la ? b : a
  if (b.length !== a.length) return b.length < a.length ? b : a
  return maxPre(b) < maxPre(a) ? b : a
}

// The candidates of a node that is not a sequence: an alternation needs a literal from
// every branch, and a repeat needs its body when it runs at least once.
function nodeReq(n: Node): LitCand[] {
  if (n.kind === "alt") {
    const out: LitCand[] = []
    for (const x of n.items) {
      const r = seqReq([x])
      if (r.length === 0) return []
      for (const c of r) out.push(c)
    }
    return out.length <= 16 ? out : []
  }
  if (n.kind === "rep" && n.min >= 1) return seqReq([n.items[0]!])
  return []
}

// The candidates of a sequence: sets of literals that every match of the sequence
// contains one of, or [] when there are none. Runs of literal characters are candidates.
// An assertion is zero-width, so a run goes on across it.
function seqReq(items: Node[]): LitCand[] {
  let flat: Node[] = []
  flatten(items, &flat)
  let best: LitCand[] = []
  let run: int[] = []
  // what the sequence holds before the current item: its byte bound, and its characters
  let cons = 0
  let pref = emptyCset()
  let runPre = 0
  let runCls = emptyCset()
  for (const x of flat) {
    if (x.kind === "empty" || x.kind === "assert") continue
    const c = singleChar(x)
    if (c >= 0) {
      if (run.length === 0) {
        runPre = cons
        runCls = pref
      }
      run.push(c)
    } else {
      best = betterLits(best, flushRun(run, runPre, runCls))
      run = []
      best = betterLits(best, shiftLits(nodeReq(x), cons, pref))
    }
    cons = addBytes(cons, maxBytes(x))
    pref = unionCs(pref, charsOf(x))
  }
  best = betterLits(best, flushRun(run, runPre, runCls))
  return best
}

// True when a proper prefix of s is also its suffix, so occurrences of s can overlap.
export function hasBorder(s: string): bool {
  for (let k = 1; k < s.byteLength; k++) {
    if (s.slice(0, k) === s.slice(s.byteLength - k)) return true
  }
  return false
}

// ---- tests ----

// true or false, or "error: ..." when the pattern does not compile.
function find(p: string, s: string): bool | string {
  try {
    return compileRegex(p).test(s)
  } catch (e) {
    return "error: " + e.message
  }
}

function repeatText(unit: string, count: int): string {
  const one = new TextEncoder().encode(unit)
  const b: u8[] = []
  for (let i = 0; i < count; i++) {
    for (const x of one) b.push(x)
  }
  try {
    return new TextDecoder().decode(b)
  } catch (e) {
    return ""
  }
}

test("literals and unanchored search", () => {
  expect(find("abc", "xabcx")).toBe(true)
  expect(find("abc", "abd")).toBe(false)
  expect(find("abc", "")).toBe(false)
  expect(find("", "anything")).toBe(true)
  expect(find("", "")).toBe(true)
  expect(find("gpt", "gpt-4o")).toBe(true)
  expect(find("a b", "a b")).toBe(true)
})

test("dot matches any code point except newline unless (?s)", () => {
  expect(find("a.c", "abc")).toBe(true)
  expect(find("a.c", "a\nc")).toBe(false)
  expect(find("(?s)a.c", "a\nc")).toBe(true)
  expect(find("^.$", "é")).toBe(true)
  expect(find("^..$", "é")).toBe(false)
  expect(find("^.$", "€")).toBe(true)
})

test("character classes, ranges and negation", () => {
  expect(find("^[a-z0-9_]+$", "__x9")).toBe(true)
  expect(find("^[a-z0-9_]+$", "X")).toBe(false)
  expect(find("^[^0-9]$", "a")).toBe(true)
  expect(find("^[^0-9]$", "7")).toBe(false)
  expect(find("^[]a]$", "]")).toBe(true)
  expect(find("^[a-]$", "-")).toBe(true)
  expect(find("^[-a]$", "-")).toBe(true)
  expect(find("^[\\]]$", "]")).toBe(true)
  expect(find("^[\\d.]+$", "1.5")).toBe(true)
  expect(find("^[\\W]$", " ")).toBe(true)
  expect(find("^[\\x41-\\x43]+$", "ABC")).toBe(true)
  expect(find("^[é-ê]$", "ê")).toBe(true)
  expect(find("^[[:alpha:]]+$", "abcXYZ")).toBe(true)
  expect(find("^[[:digit:][:space:]]+$", "1 2")).toBe(true)
  expect(find("^[[:^digit:]]$", "5")).toBe(false)
  expect(find("^[[:^digit:]]$", "x")).toBe(true)
  expect(find("^[a[]$", "[")).toBe(true)
})

test("escapes", () => {
  expect(find("\\d+", "ab12")).toBe(true)
  expect(find("^\\D+$", "123")).toBe(false)
  expect(find("^\\D+$", "ab")).toBe(true)
  expect(find("\\w+@\\w+\\.com", "me@x.com")).toBe(true)
  expect(find("\\w+@\\w+\\.com", "me@x-com")).toBe(false)
  expect(find("a\\sb", "a b")).toBe(true)
  expect(find("a\\s b", "a  b")).toBe(true)
  expect(find("\\s", "ab")).toBe(false)
  expect(find("^\\S+$", "a\tb")).toBe(false)
  expect(find("a\\.b", "axb")).toBe(false)
  expect(find("a\\.b", "a.b")).toBe(true)
  expect(find("a\\\\b", "a\\b")).toBe(true)
  expect(find("\\t", "a\tb")).toBe(true)
  expect(find("\\n", "a\nb")).toBe(true)
  expect(find("\\x41", "A")).toBe(true)
  expect(find("\\x{263A}", "smile ☺")).toBe(true)
  expect(find("\\(\\)\\[\\]\\{\\}\\*\\+\\?\\|\\^\\$", "()[]{}*+?|^$")).toBe(true)
  expect(find("\\Q.*\\E", "a.*b")).toBe(true)
  expect(find("\\Q.*\\E", "axb")).toBe(false)
})

test("anchors and word boundaries", () => {
  expect(find("^abc$", "abc")).toBe(true)
  expect(find("^abc$", "abcd")).toBe(false)
  expect(find("^abc$", "xabc")).toBe(false)
  expect(find("^$", "")).toBe(true)
  expect(find("^$", "a")).toBe(false)
  expect(find("\\Aabc\\z", "abc")).toBe(true)
  expect(find("abc$", "abc\n")).toBe(false)
  expect(find("(?m)^b$", "a\nb\nc")).toBe(true)
  expect(find("^b$", "a\nb\nc")).toBe(false)
  expect(find("(?m)a$", "a\nb")).toBe(true)
  expect(find("\\bcat\\b", "a cat.")).toBe(true)
  expect(find("\\bcat\\b", "concat")).toBe(false)
  expect(find("\\Bcat", "concat")).toBe(true)
})

test("groups, alternation and empty alternatives", () => {
  expect(find("(ab)+c", "ababc")).toBe(true)
  expect(find("(?:ab|cd)e", "cde")).toBe(true)
  expect(find("(?:ab|cd)e", "ce")).toBe(false)
  expect(find("a(b|)c", "ac")).toBe(true)
  expect(find("^(cat|dog)$", "dog")).toBe(true)
  expect(find("cat|dog", "hotdog")).toBe(true)
  expect(find("cat|dog", "bird")).toBe(false)
  expect(find("(?P<name>x)y", "xy")).toBe(true)
  expect(find("(?<name>x)y", "xy")).toBe(true)
  expect(find("()", "")).toBe(true)
  expect(find("a|", "zzz")).toBe(true)
})

test("quantifiers and counted repeats", () => {
  expect(find("^a{2}$", "a")).toBe(false)
  expect(find("^a{2}$", "aa")).toBe(true)
  expect(find("^a{2,}$", "aaa")).toBe(true)
  expect(find("^a{2,}$", "a")).toBe(false)
  expect(find("^a{2,3}$", "aaaa")).toBe(false)
  expect(find("^a{2,3}$", "aaa")).toBe(true)
  expect(find("^x{0}$", "")).toBe(true)
  expect(find("^a?b$", "b")).toBe(true)
  expect(find("^a+$", "")).toBe(false)
  expect(find("^a*$", "")).toBe(true)
  expect(find("^a{1000}$", repeatText("a", 1000))).toBe(true)
  expect(find("^a{1000}$", repeatText("a", 999))).toBe(false)
  // Not a repeat, so the braces are literal.
  expect(find("a{,2}", "a{,2}")).toBe(true)
  expect(find("a{", "a{")).toBe(true)
  expect(find("a{x}", "a{x}")).toBe(true)
  expect(find("{", "{")).toBe(true)
})

test("lazy and ungreedy forms accept the same strings", () => {
  expect(find("a.*?b", "aXbYb")).toBe(true)
  expect(find("^a+?$", "aaa")).toBe(true)
  expect(find("^a??$", "")).toBe(true)
  expect(find("^a{2,3}?$", "aaa")).toBe(true)
  expect(find("(?U)^a+$", "aaa")).toBe(true)
  expect(find("(?U)^a+?$", "aaa")).toBe(true)
})

test("case folding is scoped by flag groups", () => {
  expect(find("(?i)hello", "HeLLo")).toBe(true)
  expect(find("(?i)[a-c]+", "B")).toBe(true)
  expect(find("(?i)^[^a]$", "A")).toBe(false)
  expect(find("(?i)^[^a]$", "b")).toBe(true)
  expect(find("(?i:a)b", "Ab")).toBe(true)
  expect(find("(?i:a)b", "AB")).toBe(false)
  expect(find("a(?i)b", "aB")).toBe(true)
  expect(find("a(?i)b", "AB")).toBe(false)
  expect(find("(?i)\\bfoo\\b", "FOO!")).toBe(true)
  expect(find("(?i)[[:upper:]]", "q")).toBe(true)
  expect(find("(?i-i:a)", "A")).toBe(false)
  expect(find("(?i)(?-i:a)", "A")).toBe(false)
})

test("nested groups and flags end with their group", () => {
  expect(find("(a(?i)b)c", "aBc")).toBe(true)
  expect(find("(a(?i)b)c", "aBC")).toBe(false)
})

test("catastrophic patterns finish and fail closed or match correctly", () => {
  expect(find("(a*)*b", repeatText("a", 40))).toBe(false)
  expect(find("(a|a)*b", repeatText("a", 40))).toBe(false)
  expect(find("(x+x+)+y", repeatText("x", 40))).toBe(false)
  expect(find("(a+)+$", repeatText("a", 40) + "!")).toBe(false)
  expect(find("^(a|aa)+$", repeatText("a", 60))).toBe(true)
})

test("loops whose body can match empty still find later matches", () => {
  expect(find("(a*)*b", "b")).toBe(true)
  expect(find("(a|)+b", "b")).toBe(true)
  expect(find("(a*)+$", "aa")).toBe(true)
  expect(find("(a?){5}b", "b")).toBe(true)
  expect(find("(|a)*c", "aac")).toBe(true)
  expect(find("b.*c", "abbbcd")).toBe(true)
  expect(find("xyz", "axyzb")).toBe(true)
})

test("routing-rule patterns from the Bifrost docs", () => {
  expect(find("[0-9]+\\.[0-9]+\\.[0-9]+", "v1.2.3")).toBe(true)
  expect(find("[0-9]+\\.[0-9]+\\.[0-9]+", "1.2")).toBe(false)
  expect(find(".*premium.*", "x-premium-tier")).toBe(true)
  expect(find("^prod-", "prod-7")).toBe(true)
  expect(find("^gpt-4", "gpt-4o")).toBe(true)
  expect(find("^[a-z]+@company\\.com$", "ann@company.com")).toBe(true)
})

test("syntax errors are reported", () => {
  expect(find("(a", "")).toBe("error: missing closing ) at position 3")
  expect(find("a)", "")).toBe("error: unexpected ) at position 2")
  expect(find("[a", "")).toBe("error: missing closing ] at position 3")
  expect(find("*a", "")).toBe("error: missing argument to repetition operator at position 2")
  expect(find("a**", "")).toBe("error: invalid nested repetition operator at position 3")
  expect(find("a*+", "")).toBe("error: invalid nested repetition operator at position 3")
  expect(find("a{2}{3}", "")).toBe("error: invalid nested repetition operator at position 5")
  expect(find("a{3,2}", "")).toBe("error: invalid repeat count at position 2")
  expect(find("a{1001}", "")).toBe("error: invalid repeat count at position 2")
  expect(find("a{1,1001}", "")).toBe("error: invalid repeat count at position 2")
  expect(find("\\q", "")).toBe("error: invalid escape sequence at position 3")
  expect(find("\\1", "")).toBe("error: invalid escape sequence at position 3")
  expect(find("\\pL", "")).toBe("error: Unicode classes are not supported at position 3")
  expect(find("\\p{Greek}", "")).toBe("error: Unicode classes are not supported at position 3")
  expect(find("[z-a]", "")).toBe("error: invalid character class range at position 5")
  expect(find("[[:nope:]]", "")).toBe("error: invalid character class name at position 2")
  expect(find("(?=a)", "")).toBe("error: invalid or unsupported Perl syntax at position 4")
  expect(find("(?P=n)", "")).toBe("error: invalid named capture at position 4")
  expect(find("(?)", "")).toBe("error: missing flags in group at position 4")
  expect(find("(?i", "")).toBe("error: missing closing ) at position 4")
  expect(find("\\x{110000}", "")).toBe("error: invalid \\x escape at position 10")
  expect(find("\\xZ1", "")).toBe("error: invalid \\x escape at position 3")
  expect(find("a\\", "")).toBe("error: trailing \\ at position 3")
  expect(find("[a\\", "")).toBe("error: trailing \\ at position 4")
  expect(find("\\Qabc", "abc")).toBe(true)
})

test("an oversized program is rejected at compile time", () => {
  expect(find("(a{1000}){1000}", "")).toBe("error: pattern too large")
})

test("inputs past the step budget fail closed", () => {
  // 80 literal instructions over 65536 code points is past the budget, so the
  // search is skipped and reports no match, even though the text matches.
  const pat = repeatText("x", 80)
  expect(find(pat, repeatText("x", 65536))).toBe(false)
  expect(find(pat, repeatText("x", 200))).toBe(true)
})

test("long inputs within the budget match", () => {
  expect(find("a$", repeatText("a", 50000))).toBe(true)
  expect(find("b", repeatText("a", 50000))).toBe(false)
})

// exec() gives the leftmost-first match and the span of each group.
// [-9] for no match, [-8] for a pattern that does not compile (so a test fails).
function spansFor(p: string, s: string): int[] {
  try {
    const m = compileRegex(p).exec(s)
    return m === undefined ? [-9] : m
  } catch (e) {
    return [-8]
  }
}

test("exec reports the span of each numbered group", () => {
  expect(spansFor("(\\w+)@(\\w+)", "x ab@cd")).toEqual([2, 7, 2, 4, 5, 7])
  expect(try compileRegex("(a)(b)(c)").groups()).toBe(3)
  expect(try compileRegex("(?:a)(b)").groups()).toBe(1)
  expect(try compileRegex("(?P<n>\\d+)x").groups()).toBe(1)
  expect(try compileRegex("abc").groups()).toBe(0)
  expect(spansFor("(?:a)(b)", "ab")).toEqual([0, 2, 1, 2])
  expect(spansFor("(?P<n>\\d+)x", "12x")).toEqual([0, 3, 0, 2])
})

test("exec keeps the leftmost-first choice, as Perl and RE2 do", () => {
  // (a|ab) takes "a" first; the rest then matches "bcd", so the match is "abcd".
  expect(spansFor("(a|ab)(c|bcd)(d*)", "abcd")).toEqual([0, 4, 0, 1, 1, 4, 4, 4])
  expect(spansFor("(a+?)(a*)", "aaa")).toEqual([0, 3, 0, 1, 1, 3])
  expect(spansFor("(a*)(a)", "aaa")).toEqual([0, 3, 0, 2, 2, 3])
})

test("exec reports -1 for groups that did not take part", () => {
  expect(spansFor("(x)?y", "y")).toEqual([0, 1, -1, -1])
  expect(spansFor("(a)|(b)", "b")).toEqual([0, 1, -1, -1, 0, 1])
})

test("exec clears captures left by a failed path", () => {
  // The first alternative sets group 1 at "a" and then fails; the match is "c" alone.
  expect(spansFor("(a)b|c", "ac")).toEqual([1, 2, -1, -1])
  // group 2 is set inside the first alternative and cleared when it fails
  expect(spansFor("((a)x|a)y", "ay")).toEqual([0, 2, 0, 1, -1, -1])
})

test("exec keeps the last iteration of a repeated group", () => {
  expect(spansFor("(a|b)+", "ab")).toEqual([0, 2, 1, 2])
  expect(spansFor("((a)(b))", "ab")).toEqual([0, 2, 0, 2, 0, 1, 1, 2])
})

test("exec spans are byte offsets after multibyte characters", () => {
  expect(spansFor("é(y)", "éy")).toEqual([0, 3, 2, 3])
  expect(spansFor("(€)x", "a€x")).toEqual([1, 5, 1, 4])
})

test("exec agrees with test() on whether there is a match", () => {
  const pats = ["(a|b)c", "^(x+)$", "(?i)(HELLO)\\s+(w)", "a(b)?c", "\\b(\\d{2})\\b", "(a*)*b", "x(?:y|(z))$"]
  const texts = ["ac", "bc", "xxx", "xx!", "Hello  World", "abc 12 ", "aaaa", "xyz", "xz"]
  for (const p of pats) {
    const re = try compileRegex(p)
    for (const t of texts) {
      expect(re.exec(t) !== undefined).toBe(re.test(t))
    }
  }
})

test("exec gives no match past the step budget, as test() does", () => {
  const m = try compileRegex(repeatText("x", 80)).exec(repeatText("x", 65536))
  expect(m === undefined).toBe(true)
  expect(try compileRegex("(a)").exec("a")).toEqual([0, 1, 0, 1])
  expect(spansFor("(a$)", repeatText("a", 50000))).toEqual([49999, 50000, 49999, 50000])
})

function litsOf(p: string): string[] throws SyntaxError {
  const out: string[] = []
  const re = try compileRegex(p)
  for (const c of re.literals()) out.push(c.lit)
  return out
}

test("required literals: the literal, its case folding and the bytes that may precede it", () => {
  expect(try litsOf("ghp_[0-9a-zA-Z]{36}")).toEqual(["ghp_"])
  expect(try litsOf("(?i)algolia")).toEqual(["algolia"])
  expect(try litsOf("[0-9]+")).toEqual([])
  expect(try litsOf("(?:sk|rk)_(?:test|live)_[a-z]+")).toEqual(["test", "live"])
  const pre = try compileRegex("^[a-z]{2}xyz").literals()
  expect(pre[0]!.lit).toBe("xyz")
  expect(pre[0]!.pre).toBe(2)
  // an unbounded prefix has no byte bound
  expect(try compileRegex("a.*xyz").literals()[0]!.pre).toBe(-1)
})

test("testDecoded tries only the starts in the given byte ranges", () => {
  const re = try compileRegex("ab")
  const d = decodeText("xxab")
  expect(re.testDecoded(d, [], [])).toBe(true)
  expect(re.testDecoded(d, [0], [1])).toBe(false)
  expect(re.testDecoded(d, [2], [2])).toBe(true)
  expect(re.testDecoded(d, [3], [3])).toBe(false)
  // after a two-byte character, byte 2 is the start of "a"
  expect(re.testDecoded(decodeText("éab"), [2], [2])).toBe(true)
})

test("a pattern anchored at the start tries only the start, and runs reuse the visited table", () => {
  const re = try compileRegex("^[a-z_.-]+$")
  expect(re.test("abc_def")).toBe(true)
  expect(re.test("1abc")).toBe(false)
  expect(re.test("abc1")).toBe(false)
  // a multiline ^ is not anchored to the text's start
  const ml = try compileRegex("(?m)^b")
  expect(ml.test("a\nb")).toBe(true)
  // an alternation with one anchored branch still tries every start
  const alt = try compileRegex("^x|y")
  expect(alt.test("aay")).toBe(true)
  // a long run after a short one, and back: the kept table is cleared between runs
  const big = try compileRegex("(?:alpha|beta|gamma)[0-9]{2}")
  expect(big.test("xx gamma42")).toBe(true)
  expect(big.test("beta4")).toBe(false)
  expect(big.test("alpha12")).toBe(true)
  expect(big.exec("--beta77--")!.join(",")).toBe("2,8")
})
