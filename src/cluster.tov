// Shared budget and rate-limit state for a cluster of gateways. Each counter
// is a state-based CRDT keyed by node id: a node only ever writes its own slot,
// and a merge takes the newer window or, within one window, the max per slot.
// That join is commutative, associative and idempotent, so nodes converge
// whatever order payloads arrive in and however often they repeat.
// HTTP transport and the sync timer live in the server; this file is pure state.
import { hmacSha256, toHex, utf8 } from "./crypto"
import { DiscoveryConfig, baseUrl } from "./discovery"
import { HoldWire, holdProblem } from "./holds"
import { StateWire, stateProblem } from "./clusterstate"

// Bifrost's cluster_config.broker (type "broker"): where the nodes reach the broker, and the port it serves on.
export type BrokerConfig = { address: string, tls?: bool, listen_port?: int }

// Raiju only: the etcd lock behind leader election (leader.tov). Without it, leadership is by rank.
export type LeaderLockConfig = { etcd_endpoints: string[], key?: string, ttl_seconds?: int }

// Raiju only: the live feed (/ws). cluster_wide (default true) relays this node's log events to its peers or the
// broker and accepts theirs; false keeps the feed on this node. ring_size and ring_seconds bound the replay ring a
// client resumes from; queue_max bounds each destination's backlog (drop-oldest); batch_ms is the relay interval.
export type FeedConfig = { cluster_wide?: bool, ring_size?: int, ring_seconds?: int, queue_max?: int, batch_ms?: int }

// Raiju only: config_sync is what a node does when another node saves the config (a generation on the cluster state,
// store.tov). "file" (default) rereads its config file when that file holds the saved text (a shared file); "pull"
// also fetches the text from a peer when its own file differs and writes it, keeping its own cluster section; "off"
// ignores other nodes' saves. The workers of one node always reread their shared file.
// log_reads (default true): a request log read (/api/logs, its detail, stats, sessions and histograms, the MCP and
// agent logs) also asks the peers for their rows (POST /api/cluster/logs), since each node keeps its own log files;
// false answers with this node's rows only.
// listen_port (Raiju only): a second listener that serves the peer routes (/api/cluster/*) and /health, so they need
// not be reachable on the public port; the main listener then answers 404 for them, and the other nodes name this
// port. bind: the address of that listener (default the gateway's -host). serve_metrics: /metrics moves to that
// listener too (404 on the main one). Read at start.
// secret: env.NAME allowed. It must hold at least 32 bytes once resolved, or the gateway refuses to start with
// clustering on (secretProblem).
export type ClusterConfig = { enabled: bool, node_id?: string, peers: string[], secret: string, interval_ms?: int, discovery?: DiscoveryConfig, type?: string, broker?: BrokerConfig, leader_lock?: LeaderLockConfig, feed?: FeedConfig, config_sync?: string, log_reads?: bool, listen_port?: int, bind?: string, serve_metrics?: bool }

// The shortest cluster.secret accepted: 32 bytes (256 bits, as long as the HMAC-SHA256 key it becomes).
export const MIN_SECRET_BYTES = 32

// Why a cluster secret cannot sign peer traffic, or "". raw is the value as written, resolved the value after its
// env.NAME reference was read ("" when the variable is unset). Every node holding the same weak or missing secret
// would let anyone who reaches the port sign the peer routes (the config with its keys, the logs, the counters).
export function secretProblem(raw: string, resolved: string): string {
  if (raw.startsWith("env.") && resolved === "") return `cluster.secret names ${raw}, but the environment variable ${raw.slice(4)} is not set`
  if (resolved === "") return "cluster.secret is empty"
  if (resolved.startsWith("env.")) return `cluster.secret is still an unresolved reference (${resolved})`
  if (resolved.byteLength < MIN_SECRET_BYTES) return `cluster.secret is ${resolved.byteLength} bytes; it must be at least ${MIN_SECRET_BYTES} (for example: openssl rand -hex 32)`
  return ""
}

export function syncInterval(cfg: ClusterConfig): int {
  return cfg.interval_ms ?? 1000
}

// Broker mode is type "broker"; anything else is the default mesh.
export function isBroker(cfg: ClusterConfig): bool {
  return cfg.type === "broker"
}

// The broker's base URL. An address with a scheme keeps it; otherwise tls picks https.
export function brokerUrl(b: BrokerConfig): string {
  const a = b.address.includes("://") ? b.address : (b.tls === true ? "https://" : "http://") + b.address
  return baseUrl(a)
}

// A node counts as alive while its payloads arrive within this window (Bifrost re-evaluates membership every 30 s).
export const LEADER_WINDOW_MS: f64 = 30000.0

// The node part of a peer id: the worker processes of one node are "node/pid".
export function nodeOf(id: string): string {
  const i = id.indexOf("/")
  return i < 0 ? id : id.slice(0, i)
}

// Bifrost's rule: the lexicographically-first live node leads. Leader-only tasks
// (pricing sync, alert evaluation, log export uploads) run where this holds.
export function electLeader(ids: string[]): string {
  let best = ""
  for (const id of ids) {
    if (best === "" || id < best) best = id
  }
  return best
}

type WireCounter = { name: string, window: string, slots: Record<string, f64> }
// roster: only in a broker's answer, the ids of the nodes it has heard from. holds: the key holds of
// adaptive load balancing (holds.tov), joined by write count and writer. state: the replicated entries of
// clusterstate.tov, joined by version and writer.
type Wire = { node: string, ts: f64, counters: WireCounter[], roster?: string[], holds?: HoldWire[], state?: StateWire[] }

// Slot values must be finite; NaN and infinities would poison every total.
// Far above any budget or token count, and below the f64 limit.
const MAX_SLOT: f64 = 1.0e300

// Parses and checks a payload before anything is merged, so a bad one changes nothing.
function parseWire(text: string): Wire throws SyntaxError {
  const w = try JSON.parse(text) as Wire
  if (w.node.byteLength === 0) throw new SyntaxError("cluster payload has no node id")
  for (const id of w.roster ?? []) {
    if (id.byteLength === 0) throw new SyntaxError("cluster payload has an empty id in its roster")
  }
  for (const h of w.holds ?? []) {
    const p = holdProblem(h)
    if (p !== "") throw new SyntaxError("cluster payload: " + p)
  }
  for (const e of w.state ?? []) {
    const p = stateProblem(e)
    if (p !== "") throw new SyntaxError("cluster payload: " + p)
  }
  for (const c of w.counters) {
    if (c.name.byteLength === 0) throw new SyntaxError("cluster payload has an empty counter name")
    for (const id of c.slots.keys()) {
      const v = c.slots.get(id)!
      if (!(v >= 0 && v <= MAX_SLOT)) throw new SyntaxError("cluster payload has a negative or out-of-range slot")
    }
  }
  return w
}

class Counter {
  slots: Map<string, f64> = new Map()
  constructor(readonly window: string) {}
}

export class Counters {
  private counters: Map<string, Counter> = new Map()
  // the holds this node sends (set before encode), and the holds received since the last takeHolds
  private outHolds: HoldWire[] = []
  private inHolds: HoldWire[] = []
  // the replicated state entries this node sends, and those received since the last takeState
  private outState: StateWire[] = []
  private inState: StateWire[] = []
  // Last time a peer's payload was merged, by node id. Own node is never tracked.
  private seen: Map<string, f64> = new Map()
  constructor(readonly nodeId: string) {}

  // Grow-only add to this node's slot. A newer window starts fresh; an older one is ignored.
  add(name: string, window: string, by: f64): void {
    if (!(by >= 0 && by <= MAX_SLOT)) return
    let c = this.counters.get(name)
    if (c === undefined || c.window < window) {
      c = new Counter(window)
      this.counters.set(name, c)
    }
    if (c.window !== window) return
    c.slots.set(this.nodeId, (c.slots.get(this.nodeId) ?? 0) + by)
  }

  // Sums in node-id order so every node adds the same floats in the same order.
  total(name: string, window: string): f64 {
    const c = this.counters.get(name)
    if (c === undefined || c.window !== window) return 0
    let sum = 0.0
    const ids = c.slots.keys()
    ids.sort()
    for (const id of ids) sum += c.slots.get(id) ?? 0
    return sum
  }

  // nowMs is the local receipt time used for peer liveness; the payload's ts is the sender's clock.
  merge(remote: string, nowMs?: f64): void throws SyntaxError {
    const w = try parseWire(remote)
    this.apply(w)
    if (w.node !== this.nodeId) this.seen.set(w.node, nowMs ?? Date.now())
  }

  // A broker's answer: the joined state, and the nodes it has heard from (its roster), all heard at nowMs.
  // The broker is not a peer, so its own id is never tracked.
  relay(remote: string, nowMs: f64): void throws SyntaxError {
    const w = try parseWire(remote)
    this.apply(w)
    for (const id of w.roster ?? []) {
      if (id !== this.nodeId) this.seen.set(id, nowMs)
    }
  }

  // The key holds this node sends with its next encode.
  setHolds(list: HoldWire[]): void {
    this.outHolds = list
  }

  // The holds received from peers since the last call; the caller merges them into its holds.
  takeHolds(): HoldWire[] {
    const out = this.inHolds
    this.inHolds = []
    return out
  }

  // The state entries this node sends with its next encode (clusterstate.tov).
  setState(list: StateWire[]): void {
    this.outState = list
  }

  // The state entries received from peers since the last call; the caller merges them into its clusterState.
  takeState(): StateWire[] {
    const out = this.inState
    this.inState = []
    return out
  }

  private apply(w: Wire): void {
    for (const h of w.holds ?? []) this.inHolds.push(h)
    for (const e of w.state ?? []) this.inState.push(e)
    for (const rc of w.counters) {
      const cur = this.counters.get(rc.name)
      if (cur === undefined || rc.window > cur.window) {
        const c = new Counter(rc.window)
        for (const id of rc.slots.keys()) c.slots.set(id, rc.slots.get(id)!)
        this.counters.set(rc.name, c)
      } else if (rc.window === cur.window) {
        for (const id of rc.slots.keys()) {
          const v = rc.slots.get(id)!
          if (v > (cur.slots.get(id) ?? 0)) cur.slots.set(id, v)
        }
      }
    }
  }

  // Full state, so a node relays what it learned from others too. A broker adds its roster.
  encode(roster?: string[]): string {
    const names = this.counters.keys()
    names.sort()
    const counters: WireCounter[] = []
    for (const name of names) {
      const c = this.counters.get(name)!
      counters.push({ name, window: c.window, slots: c.slots })
    }
    const w: Wire = { node: this.nodeId, ts: Date.now(), counters: counters, roster: roster, holds: this.outHolds, state: this.outState }
    return JSON.stringify(w)
  }

  // Peers merged from, sorted by id. With sinceMs, only those heard from at or after it.
  peers(sinceMs?: f64): { id: string, lastSeen: f64 }[] {
    const out: { id: string, lastSeen: f64 }[] = []
    const ids = this.seen.keys()
    ids.sort()
    for (const id of ids) {
      const t = this.seen.get(id)!
      if (sinceMs === undefined || t >= sinceMs) out.push({ id, lastSeen: t })
    }
    return out
  }

  // Drops the slots of peers not heard from since olderThanMs. A peer that
  // still holds the slot resends it, so every node should forget on the same schedule.
  forget(olderThanMs: f64): void {
    for (const id of this.seen.keys()) {
      if (this.seen.get(id)! >= olderThanMs) continue
      this.seen.delete(id)
      for (const c of this.counters.values()) c.slots.delete(id)
    }
  }
}

// Hex HMAC-SHA256 of the request body, sent in the x-raiju-cluster-sig header.
export function sign(secret: string, body: string): string {
  return toHex(hmacSha256(utf8(secret), utf8(body)))
}

// Constant-time: the loop always runs over the whole signature, so timing reveals only its length.
export function verify(secret: string, body: string, sig: string): bool {
  // no secret, no trust: an empty key is one anyone can sign with
  if (secret === "") return false
  const want = utf8(sign(secret, body))
  const got = utf8(sig)
  if (want.length !== got.length) return false
  let diff = 0
  for (let i = 0; i < want.length; i++) diff = diff | (int(want[i]!) ^ int(got[i]!))
  return diff === 0
}

test("merge is commutative", () => {
  const a = new Counters("a")
  const b = new Counters("b")
  a.add("budget:monthly", "2026-10", 5)
  b.add("budget:monthly", "2026-10", 3)
  b.add("rl:key1:tokens", "10:00", 7)
  const ea = a.encode()
  const eb = b.encode()
  try a.merge(eb)
  try b.merge(ea)
  expect(a.total("budget:monthly", "2026-10")).toBe(8)
  expect(b.total("budget:monthly", "2026-10")).toBe(8)
  expect(a.total("rl:key1:tokens", "10:00")).toBe(b.total("rl:key1:tokens", "10:00"))
  expect(a.total("rl:key1:tokens", "10:00")).toBe(7)
})

test("merge is idempotent", () => {
  const a = new Counters("a")
  const b = new Counters("b")
  b.add("c", "w", 4)
  const eb = b.encode()
  try a.merge(eb)
  try a.merge(eb)
  try a.merge(eb)
  expect(a.total("c", "w")).toBe(4)
})

test("a newer window resets the counter and older windows are ignored", () => {
  const a = new Counters("a")
  a.add("budget:monthly", "2026-10", 4)
  a.add("budget:monthly", "2026-11", 2)
  expect(a.total("budget:monthly", "2026-11")).toBe(2)
  expect(a.total("budget:monthly", "2026-10")).toBe(0)
  a.add("budget:monthly", "2026-10", 100)
  expect(a.total("budget:monthly", "2026-11")).toBe(2)

  const b = new Counters("b")
  b.add("budget:monthly", "2026-10", 9)
  try a.merge(b.encode())
  expect(a.total("budget:monthly", "2026-11")).toBe(2)
  b.add("budget:monthly", "2026-11", 1)
  try a.merge(b.encode())
  expect(a.total("budget:monthly", "2026-11")).toBe(3)
  expect(a.total("budget:monthly", "2026-10")).toBe(0)
})

test("a bad payload throws SyntaxError and changes nothing", () => {
  const a = new Counters("a")
  a.add("c", "w", 1)
  const bad = [
    "not json",
    `{"node":"b"}`,
    `{"node":"b","ts":1,"counters":[{"name":"c","window":"w","slots":{"b":-3}}]}`,
    `{"node":"b","ts":1,"counters":[{"name":"c","window":"w","slots":{"b":5},"x":1}, {"name":"c","window":"w","slots":{"b":"oops"}}]}`,
    `{"node":"","ts":1,"counters":[]}`,
  ]
  let threw = 0
  for (const text of bad) {
    try {
      a.merge(text)
    } catch (e) {
      if (e instanceof SyntaxError) threw += 1
    }
  }
  expect(threw).toBe(bad.length)
  expect(a.total("c", "w")).toBe(1)
  expect(a.peers().length).toBe(0)
})

test("signatures verify and reject tampering", () => {
  // RFC 4231 test case 2 through the cluster helper
  expect(sign("Jefe", "what do ya want for nothing?")).toBe("5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
  const body = new Counters("a").encode()
  const sig = sign("s3cret", body)
  expect(verify("s3cret", body, sig)).toBe(true)
  expect(verify("other", body, sig)).toBe(false)
  expect(verify("s3cret", body + " ", sig)).toBe(false)
  expect(verify("s3cret", body, sig.slice(0, 10))).toBe(false)
  expect(verify("s3cret", body, "")).toBe(false)
})

test("peers and forget track who was heard from", () => {
  const a = new Counters("a")
  const b = new Counters("b")
  const c = new Counters("c")
  b.add("x", "w", 2)
  c.add("x", "w", 3)
  try a.merge(b.encode(), 1000)
  try a.merge(c.encode(), 5000)
  a.add("x", "w", 1)
  expect(a.total("x", "w")).toBe(6)
  expect(a.peers().length).toBe(2)
  expect(a.peers(2000).length).toBe(1)
  expect(a.peers(2000)[0]!.id).toBe("c")
  a.forget(3000)
  expect(a.peers().length).toBe(1)
  expect(a.total("x", "w")).toBe(4)
})

test("three nodes converge", () => {
  const nodes = [new Counters("n1"), new Counters("n2"), new Counters("n3")]
  nodes[0]!.add("budget:monthly", "2026-10", 1.5)
  nodes[1]!.add("budget:monthly", "2026-10", 2)
  nodes[2]!.add("budget:monthly", "2026-10", 0.25)
  nodes[2]!.add("rl:key1:requests", "00:00", 3)
  nodes[0]!.add("rl:key1:requests", "00:00", 1)
  // A ring gossip, then a second round in the other direction, so every node
  // hears from the others transitively.
  for (let round = 0; round < 2; round++) {
    const ea = nodes[0]!.encode()
    try nodes[1]!.merge(ea)
    const eb = nodes[1]!.encode()
    try nodes[2]!.merge(eb)
    const ec = nodes[2]!.encode()
    try nodes[0]!.merge(ec)
    try nodes[2]!.merge(ea)
    try nodes[1]!.merge(ec)
    try nodes[0]!.merge(eb)
  }
  for (const n of nodes) {
    expect(n.total("budget:monthly", "2026-10")).toBe(3.75)
    expect(n.total("rl:key1:requests", "00:00")).toBe(4)
  }
})

test("the leader is the lexicographically-first live node", () => {
  expect(electLeader(["node-c", "node-a", "node-b"])).toBe("node-a")
  expect(electLeader(["node-b"])).toBe("node-b")
  expect(electLeader([])).toBe("")
  // worker ids count as their node
  expect(nodeOf("node-a/4242")).toBe("node-a")
  expect(nodeOf("node-a")).toBe("node-a")
  expect(electLeader(["node-b", nodeOf("node-a/1"), nodeOf("node-a/2")])).toBe("node-a")
})

test("a relayed state joins the slots and counts the roster as heard, never the broker", () => {
  // a broker's answer: the state of two nodes, its own id, and the roster
  const b = new Counters("b")
  const c = new Counters("c")
  b.add("budget:monthly", "2026-10", 2)
  c.add("budget:monthly", "2026-10", 3)
  const hub = new Counters("broker")
  try hub.merge(b.encode(), 1000)
  try hub.merge(c.encode(), 1000)
  const answer = hub.encode(["b", "c"])
  const a = new Counters("a")
  a.add("budget:monthly", "2026-10", 1)
  try a.relay(answer, 5000)
  expect(a.total("budget:monthly", "2026-10")).toBe(6)
  expect(a.peers().map((p) => p.id)).toEqual(["b", "c"])
  expect(a.peers().find((p) => p.id === "broker")).toBe(undefined)
  // a node's own id in the roster is not a peer of itself
  try a.relay(hub.encode(["a", "b"]), 6000)
  expect(a.peers(6000).map((p) => p.id)).toEqual(["b"])
  // an answer without a roster carries state only
  const plain = new Counters("x")
  plain.add("budget:monthly", "2026-10", 1)
  try a.relay(plain.encode(), 7000)
  expect(a.peers(7000).length).toBe(0)
  expect(a.total("budget:monthly", "2026-10")).toBe(7)
})

test("the roster is only in answers that ask for it, and a bad roster changes nothing", () => {
  const a = new Counters("a")
  a.add("c", "w", 1)
  expect(a.encode().includes("roster")).toBe(false)
  expect(a.encode(["b"]).includes(`"roster":["b"]`)).toBe(true)
  let threw = 0
  for (const text of [`{"node":"broker","ts":1,"counters":[],"roster":[""]}`, `{"node":"broker","ts":1,"counters":[{"name":"c","window":"w","slots":{"b":9}}],"roster":["b",""]}`]) {
    try {
      a.relay(text, 1000)
    } catch (e) {
      if (e instanceof SyntaxError) threw += 1
    }
  }
  expect(threw).toBe(2)
  expect(a.total("c", "w")).toBe(1)
  expect(a.peers().length).toBe(0)
})

test("a cluster secret must be set, resolved and at least 32 bytes", () => {
  const strong = "0123456789abcdef0123456789abcdef"
  expect(secretProblem(strong, strong)).toBe("")
  expect(secretProblem("env.RAIJU_CLUSTER_SECRET", strong)).toBe("")
  expect(secretProblem("", "")).toBe("cluster.secret is empty")
  expect(secretProblem("env.RAIJU_CLUSTER_SECRET", "")).toBe("cluster.secret names env.RAIJU_CLUSTER_SECRET, but the environment variable RAIJU_CLUSTER_SECRET is not set")
  expect(secretProblem("env.A", "env.B_STILL_A_REFERENCE_PADDED_TO_32")).toBe("cluster.secret is still an unresolved reference (env.B_STILL_A_REFERENCE_PADDED_TO_32)")
  expect(secretProblem("short", "short")).toBe("cluster.secret is 5 bytes; it must be at least 32 (for example: openssl rand -hex 32)")
  expect(secretProblem(strong.slice(1), strong.slice(1)).includes("31 bytes")).toBe(true)
})

test("an empty secret verifies nothing, not even a signature made with an empty key", () => {
  expect(verify("", "", sign("", ""))).toBe(false)
  expect(verify("", "{}", sign("", "{}"))).toBe(false)
  const k = "0123456789abcdef0123456789abcdef"
  expect(verify(k, "{}", sign(k, "{}"))).toBe(true)
  expect(verify(k, "{}", sign("env.RAIJU_CLUSTER_SECRET", "{}"))).toBe(false)
})

test("broker mode and the broker URL", () => {
  const broker: ClusterConfig = { enabled: true, peers: [], secret: "s", type: "broker" }
  const mesh: ClusterConfig = { enabled: true, peers: [], secret: "s", type: "mesh" }
  const plain: ClusterConfig = { enabled: true, peers: [], secret: "s" }
  expect(isBroker(broker)).toBe(true)
  expect(isBroker(mesh)).toBe(false)
  expect(isBroker(plain)).toBe(false)
  expect(brokerUrl({ address: "broker.example.run.app:443", tls: true })).toBe("https://broker.example.run.app:443")
  expect(brokerUrl({ address: "10.0.0.5:50051" })).toBe("http://10.0.0.5:50051")
  expect(brokerUrl({ address: "https://b.example/" })).toBe("https://b.example")
})

test("key holds travel with the counters, and a payload with a bad hold changes nothing", () => {
  const a = new Counters("a")
  const b = new Counters("b")
  const h: HoldWire = { target: "p#k", provider: "p", keyId: "k", model: "", cls: "credential", reason: "bad", heldAt: 1000.0, rung: 0, waitMs: 30000.0, nextCheck: 31000.0, owner: "a", claimBy: "", claimAt: 0.0, ver: 1, by: "a", released: false, at: 1000.0 }
  a.setHolds([h])
  try b.merge(a.encode(), 1000)
  const got = b.takeHolds()
  expect(got.length).toBe(1)
  expect(got[0]!.target).toBe("p#k")
  expect(b.takeHolds().length).toBe(0)
  // a hold with a negative wait refuses the whole payload, its counters included
  const c = new Counters("c")
  const bad = `{"node":"x","ts":1,"counters":[{"name":"c","window":"w","slots":{"x":1}}],"holds":[{"target":"p#k","provider":"p","keyId":"k","model":"","cls":"credential","reason":"","heldAt":1,"rung":0,"waitMs":-1,"nextCheck":1,"owner":"x","claimBy":"","claimAt":0,"ver":1,"by":"x","released":false,"at":1}]}`
  let threw = 0
  try {
    c.merge(bad)
  } catch (e) {
    if (e instanceof SyntaxError) threw += 1
  }
  expect(threw).toBe(1)
  expect(c.total("c", "w")).toBe(0)
  expect(c.takeHolds().length).toBe(0)
})

test("replicated state entries travel in the payload, and a payload with a bad entry changes nothing", () => {
  const a = new Counters("a")
  const b = new Counters("b")
  const e: StateWire = { ns: "mcp.exchange_admin", key: "jira", value: `{"access_token":"x"}`, ver: 5000, by: "a", deleted: false, at: 5000.0 }
  a.setState([e])
  const text = a.encode()
  try b.merge(text, 1000)
  const got = b.takeState()
  expect(got.length).toBe(1)
  expect(got[0]!.key).toBe("jira")
  expect(got[0]!.value).toBe(`{"access_token":"x"}`)
  expect(b.takeState().length).toBe(0)
  // a relayed answer carries the state the broker holds
  const hub = new Counters("broker")
  hub.setState([e])
  const answer = new Counters("c")
  try answer.relay(hub.encode(["a"]), 2000)
  expect(answer.takeState().length).toBe(1)
  // an entry with no writer refuses the whole payload, its counters included
  const c = new Counters("c")
  const bad = `{"node":"x","ts":1,"counters":[{"name":"c","window":"w","slots":{"x":1}}],"state":[{"ns":"n","key":"k","value":"1","ver":1,"by":"","deleted":false,"at":1}]}`
  let threw = 0
  try {
    c.merge(bad)
  } catch (err) {
    if (err instanceof SyntaxError) threw += 1
  }
  expect(threw).toBe(1)
  expect(c.total("c", "w")).toBe(0)
  expect(c.takeState().length).toBe(0)
})
