+test("all-data sees records with no owner, scoped users do not", () => {
+  const g: GovernanceConfig = {}
+  const u: AdminUserConfig = { name: "root", role: "admin" }
+  expect(inScope(scopeOf(g, u, "all-data"), "", "", "", "")).toBe(true)
