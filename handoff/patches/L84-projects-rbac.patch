+    if (b === undefined) return badBody()
+    const r = store.upsertProject(projectFrom(id, b))
+    if (r.kind === "error") return errReply(r)
+    return reply(200, JSON.stringify({ project: findById(gov(store.cfg).projects, id) }))
+  }
+  if (m === "DELETE") {
+    const r = store.deleteProject(id)
+    if (r.kind === "error") return errReply(r)
+    return reply(200, JSON.stringify({ deleted: id }))
+  }
+  return notAllowed(m)
