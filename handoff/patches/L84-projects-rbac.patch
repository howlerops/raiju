+    if (r.kind === "error") return errReply(r)
+    return reply(201, JSON.stringify({ project: findById(gov(store.cfg).projects, pid) }))
+  }
+  const cur = findById(gov(store.cfg).projects, id)
+  if (cur === undefined || !recordInScope(store.cfg, "projects", id, scope)) return reply(404, errorBody(`no project ${id}`))
+  if (m === "GET") return reply(200, JSON.stringify({ project: cur }))
+  if (m === "PUT") {
