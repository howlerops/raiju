+    if (strcmp(k, "ttl") == 0)
+        return setsockopt(fd, lvl, v6 ? IPV6_UNICAST_HOPS : IP_TTL, &v, sizeof v) == 0 ? 0 : -errno;
+    if (strcmp(k, "multicastTTL") == 0)
+        return setsockopt(fd, lvl, v6 ? IPV6_MULTICAST_HOPS : IP_MULTICAST_TTL, &v, sizeof v) == 0 ? 0 : -errno;
