+tv_int tv_native_udpMulticastIf(tv_int id, tv_str iface) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return -EBADF;
+    if (u->family == 6) {
+        unsigned idx = (unsigned)atoi(iface.p->data);
+        return setsockopt(u->fd, IPPROTO_IPV6, IPV6_MULTICAST_IF, &idx, sizeof idx) == 0 ? 0 : -errno;
+    }
+    struct in_addr a;
+    a.s_addr = htonl(INADDR_ANY);
+    if (iface.p->len && inet_pton(AF_INET, iface.p->data, &a) != 1) return -EINVAL;
+    return setsockopt(u->fd, IPPROTO_IP, IP_MULTICAST_IF, &a, sizeof a) == 0 ? 0 : -errno;
+}
+
+/* udpAddress(id, which): 2 the local address, 3 the local port, as text ("" if there is none). */
+tv_str tv_native_udpAddress(tv_int id, tv_int which) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return TV_EMPTY_STR;
+    struct sockaddr_storage ss;
+    socklen_t len = sizeof ss;
+    if (getsockname(u->fd, (struct sockaddr *)&ss, &len) != 0) return TV_EMPTY_STR;
+    char buf[INET6_ADDRSTRLEN + 8];
+    if (ss.ss_family == AF_INET) {
+        struct sockaddr_in *v4 = (struct sockaddr_in *)&ss;
+        if (which == 3) snprintf(buf, sizeof buf, "%d", ntohs(v4->sin_port));
+        else inet_ntop(AF_INET, &v4->sin_addr, buf, sizeof buf);
+    } else if (ss.ss_family == AF_INET6) {
+        struct sockaddr_in6 *v6 = (struct sockaddr_in6 *)&ss;
+        if (which == 3) snprintf(buf, sizeof buf, "%d", ntohs(v6->sin6_port));
+        else inet_ntop(AF_INET6, &v6->sin6_addr, buf, sizeof buf);
+    } else {
+        return TV_EMPTY_STR;
+    }
+    return tv_str_from(buf, strlen(buf));
+}
+
+/* udpRef(id, on): whether an open, reading socket keeps the program running. */
+void tv_native_udpRef(tv_int id, bool on) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    u->refd = on;
+    tv_udp_update(u);
+}
+
+/* udpClose(id): closes now; a datagram not yet delivered is dropped. */
+void tv_native_udpClose(tv_int id) {
+    tv_udp *u = tv_udp_get(id);
+    if (!u) return;
+    u->closed = true;
+    u->reading = false;
+    if (u->fd >= 0) {
+        close(u->fd);   /* (removes it from the loop) */
+        u->fd = -1;
+    }
+    if (u->counted) {
+        tv_io_refs--;
+        u->counted = false;
+    }
+    tv_udp_settle(u);
+}
