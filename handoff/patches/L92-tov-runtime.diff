+        return setsockopt(u->fd, IPPROTO_IPV6, join ? IPV6_JOIN_GROUP : IPV6_LEAVE_GROUP, &m, sizeof m) == 0 ? 0 : -errno;
+    }
+    struct ip_mreq m;
+    memset(&m, 0, sizeof m);
+    if (inet_pton(AF_INET, group.p->data, &m.imr_multiaddr) != 1) return -EINVAL;
+    m.imr_interface.s_addr = htonl(INADDR_ANY);
