+++ b/tov-patches/tests/alpn.tov
@@ -0,0 +1,28 @@
+// Socket TLS with ALPN (patch 0003): the protocol the server picked is on socket.alpnProtocol.
+// Run by tov-patches/tests/run.sh, which starts tls_server.py and sets ALPN_PORT.
+async function alpnOf(port: int, protos: string[] | undefined): Promise<string, Error> {
+  const s = try await Bun.connect({
+    hostname: "127.0.0.1",
+    port: port,
+    tls: protos === undefined ? { rejectUnauthorized: false } : { rejectUnauthorized: false, alpn: protos },
+    socket: {},
+  })
+  const picked = s.alpnProtocol
+  s.terminate()
+  return picked
+}
+
+async function main(): Promise<int> {
+  const port = parseInt(process.env.ALPN_PORT ?? "0") ?? 0
+  try {
+    const h2 = try await alpnOf(port, ["http/1.1", "h2"])
+    console.log(h2 === "h2" ? "ok alpn picks h2 from the offer" : `FAIL alpn picked ${JSON.stringify(h2)}`)
+    const none = try await alpnOf(port, ["http/1.1"])
+    console.log(none === "" ? "ok alpn with no protocol in common picks none" : `FAIL no overlap picked ${JSON.stringify(none)}`)
+    const plain = try await alpnOf(port, undefined)
+    console.log(plain === "" ? "ok no alpn option, no protocol picked" : `FAIL default picked ${JSON.stringify(plain)}`)
+  } catch (e) {
+    console.log("FAIL " + e.message)
+  }
+  return 0
+}
