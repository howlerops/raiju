@@ -0,0 +1,59 @@
+// node:dgram over Tov's datagram sockets (patch 0004). run() prints "ok" or "FAIL" lines; the
+// event loop keeps running until all four sockets close. Called by tov-patches/tests/udp_dgram.tov.
+"use strict";
+
+const dgram = require("dgram");
+
+function run() {
+  const a = dgram.createSocket("udp4");
+  const b = dgram.createSocket("udp4");
+  // a multicast listener and a sender bound to the wildcard (a loopback source can't reach a group)
+  const m = dgram.createSocket({ type: "udp4", reuseAddr: true });
+  const w = dgram.createSocket("udp4");
+  let closed = 0;
+  const done = () => {
+    if (++closed === 4) console.log("ok dgram sockets closed");
+  };
+  for (const s of [a, b, m, w]) s.on("close", done);
+
+  a.on("message", (msg, rinfo) => {
+    const fromB = rinfo.address === "127.0.0.1" && rinfo.port === b.address().port && rinfo.family === "IPv4";
+    console.log(msg.toString() === "ping" && fromB ? "ok dgram message with rinfo" : `FAIL message ${msg} ${JSON.stringify(rinfo)}`);
+    a.send("pong", rinfo.port, rinfo.address, (err, n) => {
+      console.log(err === null && n === 4 ? "ok dgram send callback" : `FAIL send ${err} ${n}`);
+    });
+  });
+
+  b.on("message", (msg) => {
+    console.log(msg.toString() === "pong" ? "ok dgram reply" : `FAIL reply ${msg}`);
+    a.close();
+    b.close();
+  });
+
+  m.on("message", (msg) => {
+    console.log(msg.toString() === "group" ? "ok dgram multicast membership receives" : `FAIL group ${msg}`);
+    m.close();
+    w.close();
+  });
+
+  a.bind(0, "127.0.0.1", () => {
+    const port = a.address().port;
+    console.log(port > 0 && a.address().address === "127.0.0.1" ? "ok dgram bind and address" : "FAIL dgram address");
+    b.bind(0, "127.0.0.1", () => {
+      a.setBroadcast(true);
+      console.log("ok dgram setBroadcast");
+      b.send("ping", port, "127.0.0.1");
+    });
+  });
+
+  m.bind(0, "0.0.0.0", () => {
+    const group = "239.255.42.97";
+    m.addMembership(group);
+    console.log("ok dgram addMembership");
+    w.bind(0, "0.0.0.0", () => {
+      w.send("group", m.address().port, group);
+    });
+  });
+}
+
+module.exports = { run };
