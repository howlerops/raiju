+test("a datasheet row: listed parameters, flags, endpoints and the output limit", () => {
+  const row = `{"mode":"chat","max_output_tokens":1000,"supported_endpoints":["/v1/chat/completions","/v1/responses"],"model_parameters":[{"id":"max_tokens"},{"id":"stop_sequences"},{"id":"reasoning_effort"}],"supports_function_calling":true}`
+  const s = supportOf(row)
+  expect(s.known).toBe(true)
+  expect(s.params.includes("max_tokens") && s.params.includes("stop") && s.params.includes("reasoning") && s.params.includes("tools")).toBe(true)
+  expect(s.params.includes("temperature")).toBe(false)
+  expect(s.params.includes("reasoning_with_tool_calls")).toBe(true)
+  expect(serves(s, "chat_completion") && serves(s, "responses") && !serves(s, "text_completion")).toBe(true)
+  expect(s.maxOutput).toBe(1000.0)
+  const explicit = supportOf(`{"mode":"responses","model_parameters":[{"id":"reasoning_effort"}],"supports_reasoning_with_tool_calls":false}`)
+  expect(explicit.params.includes("reasoning_with_tool_calls")).toBe(false)
+  expect(serves(explicit, "responses") && !serves(explicit, "chat_completion")).toBe(true)
+  // no model_parameters list: nothing is known about the parameters
+  expect(supportOf(`{"mode":"chat","supports_function_calling":true}`).known).toBe(false)
+  expect(supportOf("not json").known).toBe(false)
+  expect(supportOf("").types.length).toBe(0)
+})
