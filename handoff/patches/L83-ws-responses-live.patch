+// How often the UI socket looks for new request-log entries, in ms.
+const UI_TICK_MS = 1000
+
+// One dashboard client on /ws.
+export class UiSocket extends SocketExt {
+  constructor(readonly hub: UiHub) {
+    super()
+  }
+
+  onOpen(): void {
+    this.hub.add(this)
+  }
+
+  onClose(): void {
