+  expect(r.body).toBe(`{"model":"jev-1.13.0","answers":[{"type":"predicate","name":"p","probability":0.8,"confidence":0.9},{"type":"choice","choice":true,"probabilities":[{"value":true,"probability":0.7},{"value":false,"probability":0.3}]},{"type":"score","name":"s","score":1.4,"probabilities":[{"value":0,"label":"low","probability":0.6},{"value":1,"label":"1","probability":0.4}]}],"usage":{"prompt_tokens":20,"completion_tokens":0,"total_tokens":20}}`)
+})
+
+test("a missing or mistyped answer is refused", () => {
+  const d: DecisionReq = { model: "m", state: "null", questions: [{ type: "predicate", name: "p", named: true, instructions: "null", trueSide: "", falseSide: "", choices: [], levels: [] }] }
+  let missing = ""
