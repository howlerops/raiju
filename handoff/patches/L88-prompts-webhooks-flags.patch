@@ -0,0 +1,738 @@
+// Webhooks (Bifrost's /api/webhooks and framework/webhooks): signed HTTP deliveries of an
+// async job's outcome, so a caller need not poll for it.
+//
+// A job is submitted with x-bf-async-webhook naming an enabled endpoint. When the job finishes,
+// the endpoint gets one POST whose body is {event, created_at, data}; event is async_job.completed
+// or async_job.failed, and the endpoint must subscribe to it. Each delivery carries Standard
+// Webhooks headers: webhook-id, webhook-timestamp and webhook-signature (v1,<base64> of
+// HMAC-SHA256 over "{id}.{timestamp}.{body}", keyed with the secret's bytes). A failed attempt is
+// retried with doubling backoff. Delivery is at least once, and every attempt of one delivery
+// keeps its webhook-id, so a receiver dedupes on it.
+//
+// Bifrost emits only these two events. Alerts, budgets and config changes reach the dashboard
+// through notify.tov, and alerting channels have their own webhook type (alerts.tov).
+//
+// Deliveries are kept in memory, the last 500 of them, per process. Endpoints are config (the
+// webhooks section), so they survive restarts.
+import { hmacSha256, utf8, secureHex } from "./crypto"
+import { encode, decode } from "./base64"
+import { Field, fields, elements, find, rawStr, rawBool, rawNum, decodeString } from "./json"
+import { Hdrs, newId, errorJson } from "./schemas"
+import { isoMs } from "./exports"
+import { Job, JobStore } from "./jobs"
+import { asyncSubmit, Dispatch } from "./extras"
+import { deadline } from "./deadline"
+import { WebhookEndpoint } from "./config"
+
+// One delivery of one event to one endpoint. message_id is the webhook-id its attempts share;
+// a redelivery is a new row with the same message_id.
+export type Delivery = {
+  id: string,
+  message_id: string,
+  webhook_id: string,
+  webhook_name: string,
+  event: string,
+  status: string, // pending, delivered or failed
+  attempts: int,
+  status_code: int,
+  error: string,
+  body: string,
+  created_at: int,
+  updated_at: int,
+}
+
+export type WebhookReply = { status: int, body: string, next?: WebhookEndpoint[] }
+
+export const EVENTS: string[] = ["async_job.completed", "async_job.failed"]
+const SECRET_PREFIX = "whsec_"
+const MASK = "********"
+const KEEP = 500
+const PROTECTED: string[] = ["webhook-id", "webhook-timestamp", "webhook-signature", "x-bifrost-event", "content-type", "content-length", "user-agent", "host", "connection", "transfer-encoding"]
+
+// Deliveries of this process, newest last.
+export class DeliveryLog {
+  rows: Delivery[] = []
+
+  add(d: Delivery): void {
+    this.rows.push(d)
+    if (this.rows.length > KEEP) this.rows = this.rows.slice(this.rows.length - KEEP)
+  }
+
+  indexOf(id: string): int {
+    for (let i = 0; i < this.rows.length; i++) {
+      if (this.rows[i]!.id === id) return i
+    }
+    return -1
+  }
+
+  // Records one attempt's outcome on a row.
+  attempt(id: string, status: int, error: string, now: int): void {
+    const i = this.indexOf(id)
+    if (i < 0) return
+    this.rows[i]!.attempts += 1
+    this.rows[i]!.status_code = status
+    this.rows[i]!.error = error
+    this.rows[i]!.updated_at = now
+  }
+
+  settle(id: string, status: string, now: int): void {
+    const i = this.indexOf(id)
+    if (i < 0) return
+    this.rows[i]!.status = status
+    this.rows[i]!.updated_at = now
+  }
+}
+
+let logInstance: DeliveryLog | undefined = undefined
+
+// The process's delivery log (created on first use: top-level statements in imported modules do not run).
+export function deliveryLog(): DeliveryLog {
+  let l = logInstance
+  if (l === undefined) {
+    l = new DeliveryLog()
+    logInstance = l
+  }
+  return l
+}
+
+// A fresh signing secret: whsec_ plus the base64 of 32 random bytes.
+export function newSecret(): string throws Error {
+  const hex = try secureHex(32)
+  return SECRET_PREFIX + encode(utf8(hex))
+}
+
+// The HMAC key a secret carries; it must decode to 24 to 64 bytes.
+function keyOf(secret: string): u8[] throws Error {
+  if (!secret.startsWith(SECRET_PREFIX)) throw new Error("the signing secret must start with whsec_")
+  const key = try decode(secret.slice(SECRET_PREFIX.byteLength))
+  if (key.length < 24 || key.length > 64) throw new Error(`the signing secret must decode to 24-64 bytes, got ${key.length}`)
+  return key
+}
+
+// The Standard Webhooks signature of one delivery attempt, as the webhook-signature header carries it.
+export function sign(secret: string, id: string, timestamp: int, body: string): string throws Error {
+  const key = try keyOf(secret)
+  return "v1," + encode(hmacSha256(key, utf8(id + "." + timestamp + "." + body)))
+}
+
+// The reason an endpoint URL is refused, or "" when it may be used. Link-local and metadata
+// addresses are refused always; private addresses and plain http only with allow_private_network.
+export function urlProblem(raw: string, allowPrivate: bool): string {
+  const u = URL.parse(raw)
+  if (u === undefined) return "url is not a valid URL"
+  const host = u.hostname
+  if (host.startsWith("169.254.") || host === "0.0.0.0" || host === "metadata.google.internal" || host === "fd00:ec2::254") return "link-local and metadata addresses are not allowed"
+  if (u.protocol !== "https:" && !(u.protocol === "http:" && allowPrivate)) return "url must be https (http needs allow_private_network)"
+  if (!allowPrivate && isPrivateHost(host)) return "url points at a private address; set allow_private_network to deliver there"
+  return ""
+}
+
+function isPrivateHost(h: string): bool {
+  if (h === "localhost" || h.endsWith(".localhost") || h === "[::1]" || h === "::1") return true
+  if (h.startsWith("127.") || h.startsWith("10.") || h.startsWith("192.168.")) return true
+  if (h.startsWith("[fc") || h.startsWith("[fd") || h.startsWith("[fe80")) return true
+  if (h.startsWith("172.")) {
+    const second = parseInt(h.split(".")[1] ?? "")
+    if (second !== undefined && second >= 16 && second <= 31) return true
+  }
+  if (h.startsWith("100.")) {
+    const second = parseInt(h.split(".")[1] ?? "")
+    if (second !== undefined && second >= 64 && second <= 127) return true
+  }
+  return false
+}
+
+// Bifrost's request_type names for the async ops.
+function requestTypeOf(op: string): string {
+  if (op === "chat/completions") return "chat_completion"
+  if (op === "completions") return "text_completion"
+  if (op === "embeddings") return "embedding"
+  return op.split("/").join("_")
+}
+
+function headersFor(ep: WebhookEndpoint): Map<string, string> {
+  const out: Map<string, string> = new Map()
+  const hs = ep.headers
+  if (hs === undefined) return out
+  for (const k of hs.keys()) {
+    if (!PROTECTED.includes(k.toLowerCase())) out.set(k, hs.get(k) ?? "")
+  }
+  return out
+}
+
+// One POST of a body to an endpoint, signed now. status is 0 when no answer came.
+async function attemptOnce(ep: WebhookEndpoint, messageId: string, event: string, body: string): Promise<{ status: int, error: string }> {
+  const problem = urlProblem(ep.url, ep.allow_private_network === true)
+  if (problem !== "") return { status: 0, error: problem }
+  const secret = ep.secret ?? ""
+  const ts = Math.floor(Date.now() / 1000)
+  let sig = ""
+  try {
+    sig = sign(secret, messageId, ts, body)
+  } catch (e) {
+    return { status: 0, error: e.message }
+  }
+  const hm: Map<string, string> = headersFor(ep)
+  hm.set("content-type", "application/json")
+  hm.set("user-agent", "Raiju-Webhooks/1.0")
+  hm.set("webhook-id", messageId)
+  hm.set("webhook-timestamp", "" + ts)
+  hm.set("webhook-signature", sig)
+  hm.set("x-bifrost-event", event)
+  const hs: Record<string, string> = hm
+  const timeout = (ep.attempt_timeout_seconds ?? 10) * 1000
+  const dl = deadline(timeout)
+  try {
+    const r = await fetch(ep.url, { method: "POST", headers: hs, body: body, signal: dl.controller.signal })
+    await r.text()
+    dl.finish()
+    return { status: r.status, error: "" }
+  } catch (e) {
+    dl.finish()
+    return { status: 0, error: e.message }
+  }
+}
+
+async function sleepMs(ms: int): Promise<void> {
+  await new Promise<void>((resolve) => {
+    setTimeout(() => resolve(), ms)
+  })
+}
+
+// Sends one delivery with its retries, recording each attempt in the log.
+async function deliver(ep: WebhookEndpoint, rowId: string, messageId: string, event: string, body: string): Promise<void> {
+  const log = deliveryLog()
+  const max = ep.max_retries ?? 4
+  const cap = ep.retry_backoff_max_seconds ?? 1800
+  let wait: f64 = ep.retry_backoff_initial_seconds ?? 30
+  let attempt = 0
+  while (true) {
+    attempt += 1
+    const r = await attemptOnce(ep, messageId, event, body)
+    log.attempt(rowId, r.status, r.error, Math.floor(Date.now()))
+    if (r.status >= 200 && r.status < 300) {
+      log.settle(rowId, "delivered", Math.floor(Date.now()))
+      return
+    }
+    if (attempt > max) {
+      log.settle(rowId, "failed", Math.floor(Date.now()))
+      return
+    }
+    await sleepMs(Math.floor(wait * 1000))
+    wait = Math.min(wait * 2.0, cap)
+  }
+}
+
+// The {event, created_at, data} envelope.
+function envelope(event: string, data: string): string {
+  return `{"event":${JSON.stringify(event)},"created_at":${JSON.stringify(isoMs(Date.now()))},"data":${data}}`
+}
+
+// The data of an async job's outcome: ids, status, times, the result URL, and the response or
+// error when the endpoint includes them and they fit its size cap.
+export function jobData(ep: WebhookEndpoint, j: Job, ttlMs: int): string {
+  const parts: string[] = [`"job_id":${JSON.stringify(j.id)}`, `"request_type":${JSON.stringify(requestTypeOf(j.op))}`, `"status":${JSON.stringify(j.status)}`]
+  const st = j.http_status
+  if (st !== undefined) parts.push(`"status_code":${st}`)
+  parts.push(`"created_at":${JSON.stringify(isoMs(j.created_at * 1000))}`)
+  const done = j.completed_at
+  if (done !== undefined) {
+    parts.push(`"completed_at":${JSON.stringify(isoMs(done * 1000))}`)
+    parts.push(`"result_expires_at":${JSON.stringify(isoMs(done * 1000 + ttlMs))}`)
+  }
+  parts.push(`"result_url":${JSON.stringify("/v1/async/" + j.op + "/" + j.id)}`)
+  const cap = (ep.max_response_payload_kbs ?? 256) * 1024
+  if (ep.include_response === true) {
+    const res = j.result
+    if (res !== undefined) {
+      if (res.byteLength <= cap) parts.push(`"response":${res}`)
+      else parts.push(`"response_omitted":true`)
+    }
+    const err = j.error
+    if (err !== undefined) {
+      const body = JSON.stringify({ message: err })
+      if (body.byteLength <= cap) parts.push(`"error":${body}`)
+      else parts.push(`"error_omitted":true`)
+    }
+  }
+  return "{" + parts.join(",") + "}"
+}
+
+// Starts a delivery of an event to an endpoint that subscribes to it. Returns the delivery's row
+// id, or "" when the endpoint does not take the event.
+export function enqueue(ep: WebhookEndpoint, event: string, body: string): string {
+  if (ep.disabled === true || !ep.events.includes(event)) return ""
+  const rowId = newId("dl_")
+  const messageId = newId("msg_")
+  const now = Math.floor(Date.now())
+  deliveryLog().add({ id: rowId, message_id: messageId, webhook_id: ep.id ?? "", webhook_name: ep.name, event: event, status: "pending", attempts: 0, status_code: 0, error: "", body: body, created_at: now, updated_at: now })
+  deliver(ep, rowId, messageId, event, body)
+  return rowId
+}
+
+// Waits for a job to finish and enqueues its outcome. Stops when the job expires unfinished.
+async function watchJob(jobs: JobStore, id: string, ep: WebhookEndpoint, ttlMs: int): Promise<void> {
+  while (true) {
+    await sleepMs(250)
+    const j = jobs.get(id, Math.floor(Date.now()))
+    if (j === undefined) return
+    if (j.status === "completed" || j.status === "failed") {
+      const event = j.status === "completed" ? "async_job.completed" : "async_job.failed"
+      enqueue(ep, event, envelope(event, jobData(ep, j, ttlMs)))
+      return
+    }
+  }
+}
+
+export function findEndpoint(list: WebhookEndpoint[], key: string): WebhookEndpoint | undefined {
+  for (const ep of list) {
+    if (ep.id === key || ep.name === key) return ep
+  }
+  return undefined
+}
+
+// The job id in an async submit's 202 body.
+function jobIdOf(text: string): string {
+  try {
+    const f = fields(text)
+    return rawStr(f, "id") ?? ""
+  } catch (e) {
+    return ""
+  }
+}
+
+// POST /v1/async/...: asyncSubmit, plus the webhook named by x-bf-async-webhook. A name that is
+// not an enabled endpoint fails the submit before any job is made.
+export async function asyncSubmitHooked(endpoints: WebhookEndpoint[] | undefined, jobs: JobStore, req: Request, path: string, dispatch: Dispatch, ttlMs: int): Promise<Response, Error> throws Error {
+  const name = req.headers.get("x-bf-async-webhook") ?? ""
+  if (name === "") return await asyncSubmit(jobs, req, path, dispatch)
+  const ep = findEndpoint(endpoints ?? [], name)
+  if (ep === undefined || ep.disabled === true) {
+    return new Response(errorJson(`no enabled webhook endpoint named ${name}`, "invalid_request_error", undefined), { status: 400, headers: { "content-type": "application/json" } })
+  }
+  const res = await asyncSubmit(jobs, req, path, dispatch)
+  if (res.status !== 202) return res
+  const text = try await res.text()
+  const id = jobIdOf(text)
+  if (id !== "") watchJob(jobs, id, ep, ttlMs)
+  return new Response(text, { status: 202, headers: { "content-type": "application/json" } })
+}
+
+// ---- the management API ----
+
+function reply(status: int, body: string): WebhookReply {
+  return { status: status, body: body }
+}
+
+function fail(status: int, message: string): WebhookReply {
+  return reply(status, JSON.stringify({ error: { message: message, type: "invalid_request_error" } }))
+}
+
+function objectFields(text: string): Field[] | undefined {
+  if (!text.startsWith("{")) return undefined
+  try {
+    return fields(text)
+  } catch (e) {
+    return undefined
+  }
+}
+
+// A string array's values, or undefined when the raw JSON is not one.
+function strings(raw: string): string[] | undefined {
+  if (!raw.startsWith("[")) return undefined
+  const out: string[] = []
+  try {
+    for (const el of elements(raw)) {
+      if (!el.startsWith("\"")) return undefined
+      out.push(decodeString(el))
+    }
+  } catch (e) {
+    return undefined
+  }
+  return out
+}
+
+// The headers object of a body, with string values only; undefined when it is not one.
+function headerMap(raw: string): Map<string, string> | undefined {
+  if (!raw.startsWith("{")) return undefined
+  const out: Map<string, string> = new Map()
+  try {
+    for (const f of fields(raw)) {
+      if (!f.raw.startsWith("\"")) return undefined
+      out.set(f.key, decodeString(f.raw))
+    }
+  } catch (e) {
+    return undefined
+  }
+  return out
+}
+
+// A whole number of at least 1 from a body field, or undefined when absent. "bad" is set when it is not one.
+function tuning(fs: Field[], key: string): { value: int | undefined, bad: bool } {
+  const n = rawNum(fs, key)
+  if (n === undefined) return { value: undefined, bad: false }
+  if (n % 1.0 !== 0.0 || n < 1.0) return { value: undefined, bad: true }
+  return { value: Math.round(n), bad: false }
+}
+
+// Endpoint view: no secret; header values masked, as Bifrost does.
+function endpointJson(ep: WebhookEndpoint): string {
+  const hp: string[] = []
+  const hm = ep.headers
+  if (hm !== undefined) {
+    for (const k of hm.keys()) hp.push(JSON.stringify(k) + ":" + JSON.stringify(MASK))
+  }
+  const view = {
+    id: ep.id ?? "",
+    name: ep.name,
+    url: ep.url,
+    events: ep.events,
+    headers: "{" + hp.join(",") + "}",
+    include_response: ep.include_response ?? false,
+    allow_private_network: ep.allow_private_network ?? false,
+    disabled: ep.disabled ?? false,
+    max_retries: ep.max_retries ?? 4,
+    retry_backoff_initial_seconds: ep.retry_backoff_initial_seconds ?? 30,
+    retry_backoff_max_seconds: ep.retry_backoff_max_seconds ?? 1800,
+    attempt_timeout_seconds: ep.attempt_timeout_seconds ?? 10,
+    max_response_payload_kbs: ep.max_response_payload_kbs ?? 256,
+    created_at: isoMs(ep.created_at ?? 0),
+    updated_at: isoMs(ep.updated_at ?? 0),
+  }
+  return JSON.stringify(view)
+}
+
+function deliveryJson(d: Delivery): string {
+  return JSON.stringify({ id: d.id, message_id: d.message_id, webhook_id: d.webhook_id, webhook_name: d.webhook_name, event: d.event, status: d.status, attempts: d.attempts, status_code: d.status_code, error: d.error, created_at: isoMs(d.created_at), updated_at: isoMs(d.updated_at) })
+}
+
+// Checks a whole endpoint body: the events it names, and its URL, headers and tuning. "" when fine.
+function problemWith(name: string, url: string, events: string[], allowPrivate: bool, headers: Map<string, string> | undefined): string {
+  if (name === "") return "name is required"
+  if (url === "") return "url is required"
+  const up = urlProblem(url, allowPrivate)
+  if (up !== "") return up
+  if (events.length === 0) return "events is required"
+  for (const e of events) {
+    if (!EVENTS.includes(e)) return `unknown event ${e}; the events are ${EVENTS.join(", ")}`
+  }
+  const hm = headers
+  if (hm !== undefined) {
+    for (const k of hm.keys()) {
+      if (PROTECTED.includes(k.toLowerCase())) return `header ${k} is reserved for the delivery`
+    }
+  }
+  return ""
+}
+
+// Routes one request under /api/webhooks. path is the request's path and query.
+export function webhookRoute(cfg: WebhookEndpoint[] | undefined, method: string, path: string, body: string): WebhookReply {
+  const list = cfg ?? []
+  const q = path.indexOf("?")
+  const p = q < 0 ? path : path.slice(0, q)
+  const query = q < 0 ? "" : path.slice(q + 1)
+  const segs = p.split("/").filter((s) => s !== "")
+  if (segs.length === 2) {
+    if (method === "GET") {
+      const items: string[] = []
+      for (const ep of list) items.push(endpointJson(ep))
+      return reply(200, `{"endpoints":[${items.join(",")}],"count":${items.length},"total_count":${items.length}}`)
+    }
+    if (method !== "POST") return fail(405, `method ${method} is not allowed here`)
+    return createEndpoint(list, body)
+  }
+  if (segs[2] === "deliveries") return deliveriesRoute(list, method, segs, query)
+  const key = segs[2] ?? ""
+  const i = endpointIndex(list, key)
+  if (i < 0) return fail(404, "webhook endpoint not found")
+  const old = list[i]!
+  if (segs.length === 3) {
+    if (method === "GET") return reply(200, `{"endpoint":${endpointJson(old)}}`)
+    if (method === "PUT") return updateEndpoint(list, i, body)
+    if (method === "DELETE") {
+      const kept = list.filter((x) => x !== old)
+      return { status: 200, body: `{"message":"webhook endpoint deleted"}`, next: kept }
+    }
+    return fail(405, `method ${method} is not allowed here`)
+  }
+  const action = segs[3] ?? ""
+  if (segs.length === 4 && action === "rotate-secret" && method === "POST") {
+    let secret = ""
+    try {
+      secret = newSecret()
+    } catch (e) {
+      return fail(500, `could not make a secret: ${e.message}`)
+    }
+    const renewed: WebhookEndpoint = { id: old.id, name: old.name, url: old.url, events: old.events, secret: secret, headers: old.headers, include_response: old.include_response, allow_private_network: old.allow_private_network, disabled: old.disabled, max_retries: old.max_retries, retry_backoff_initial_seconds: old.retry_backoff_initial_seconds, retry_backoff_max_seconds: old.retry_backoff_max_seconds, attempt_timeout_seconds: old.attempt_timeout_seconds, max_response_payload_kbs: old.max_response_payload_kbs, created_at: old.created_at, updated_at: Math.floor(Date.now()) }
+    const next = list.slice()
+    next[i] = renewed
+    return { status: 200, body: `{"endpoint":${endpointJson(renewed)},"secret":${JSON.stringify(secret)}}`, next: next }
+  }
+  if (segs.length === 4 && action === "deliveries" && method === "GET") {
+    return reply(200, deliveriesJson(old.id ?? "", old.name, query))
+  }
+  return fail(404, "no such route")
+}
+
+function endpointIndex(list: WebhookEndpoint[], key: string): int {
+  for (let i = 0; i < list.length; i++) {
+    const ep = list[i]!
+    if (ep.id === key || ep.name === key) return i
+  }
+  return -1
+}
+
+function createEndpoint(list: WebhookEndpoint[], body: string): WebhookReply {
+  const fs = objectFields(body)
+  if (fs === undefined) return fail(400, "invalid request body")
+  const name = rawStr(fs, "name") ?? ""
+  const url = rawStr(fs, "url") ?? ""
+  const evRaw = find(fs, "events")
+  const events: string[] = evRaw === undefined ? [] : strings(evRaw) ?? []
+  const allowPrivate = rawBool(fs, "allow_private_network") ?? false
+  const hRaw = find(fs, "headers")
+  const headers = hRaw === undefined || hRaw === "null" ? undefined : headerMap(hRaw)
+  if (hRaw !== undefined && hRaw !== "null" && headers === undefined) return fail(400, "headers must be an object of string values")
+  const bad = problemWith(name, url, events, allowPrivate, headers)
+  if (bad !== "") return fail(400, bad)
+  if (list.some((x) => x.name === name)) return fail(409, "A webhook endpoint with this name already exists")
+  const tunes = tunedFields(fs)
+  if (tunes.error !== "") return fail(400, tunes.error)
+  let secret = ""
+  try {
+    secret = newSecret()
+  } catch (e) {
+    return fail(500, `could not make a secret: ${e.message}`)
+  }
+  const now = Math.floor(Date.now())
+  const made: WebhookEndpoint = { id: newId("wh_"), name: name, url: url, events: events, secret: secret, headers: headers, include_response: rawBool(fs, "include_response") ?? false, allow_private_network: allowPrivate, disabled: rawBool(fs, "disabled") ?? false, max_retries: tunes.max_retries, retry_backoff_initial_seconds: tunes.initial, retry_backoff_max_seconds: tunes.max, attempt_timeout_seconds: tunes.timeout, max_response_payload_kbs: tunes.payload, created_at: now, updated_at: now }
+  return { status: 201, body: `{"endpoint":${endpointJson(made)},"secret":${JSON.stringify(secret)}}`, next: list.concat([made]) }
+}
+
+// The tuning knobs of a body. error names the first one that is not a whole number of 1 or more.
+function tunedFields(fs: Field[]): { error: string, max_retries: int | undefined, initial: int | undefined, max: int | undefined, timeout: int | undefined, payload: int | undefined } {
+  const a = tuning(fs, "max_retries")
+  const b = tuning(fs, "retry_backoff_initial_seconds")
+  const c = tuning(fs, "retry_backoff_max_seconds")
+  const d = tuning(fs, "attempt_timeout_seconds")
+  const e = tuning(fs, "max_response_payload_kbs")
+  let error = ""
+  if (a.bad || b.bad || c.bad || d.bad || e.bad) error = "retry, timeout and payload settings must be whole numbers of 1 or more (max_retries of 0 is the default retry count)"
+  return { error: error, max_retries: a.value, initial: b.value, max: c.value, timeout: d.value, payload: e.value }
+}
+
+function updateEndpoint(list: WebhookEndpoint[], i: int, body: string): WebhookReply {
+  const old = list[i]!
+  const fs = objectFields(body)
+  if (fs === undefined) return fail(400, "invalid request body")
+  const name = rawStr(fs, "name") ?? old.name
+  const url = rawStr(fs, "url") ?? old.url
+  const evRaw = find(fs, "events")
+  const events = evRaw === undefined ? old.events : strings(evRaw) ?? []
+  const allowPrivate = rawBool(fs, "allow_private_network") ?? old.allow_private_network ?? false
+  // header values sent back masked keep the stored value
+  let headers = old.headers
+  const hRaw = find(fs, "headers")
+  if (hRaw !== undefined && hRaw !== "null") {
+    const sent = headerMap(hRaw)
+    if (sent === undefined) return fail(400, "headers must be an object of string values")
+    const kept: Map<string, string> = new Map()
+    for (const k of sent.keys()) {
+      const v = sent.get(k) ?? ""
+      const prev = old.headers?.get(k)
+      kept.set(k, v === MASK && prev !== undefined ? prev : v)
+    }
+    headers = kept
+  } else if (hRaw === "null") {
+    headers = undefined
+  }
+  const bad = problemWith(name, url, events, allowPrivate, headers)
+  if (bad !== "") return fail(400, bad)
+  if (list.some((x) => x.name === name && x !== old)) return fail(409, "A webhook endpoint with this name already exists")
+  const tunes = tunedFields(fs)
+  if (tunes.error !== "") return fail(400, tunes.error)
+  const next: WebhookEndpoint = {
+    id: old.id,
+    name: name,
+    url: url,
+    events: events,
+    secret: old.secret,
+    headers: headers,
+    include_response: rawBool(fs, "include_response") ?? old.include_response,
+    allow_private_network: allowPrivate,
+    disabled: rawBool(fs, "disabled") ?? old.disabled,
+    max_retries: tunes.max_retries ?? old.max_retries,
+    retry_backoff_initial_seconds: tunes.initial ?? old.retry_backoff_initial_seconds,
+    retry_backoff_max_seconds: tunes.max ?? old.retry_backoff_max_seconds,
+    attempt_timeout_seconds: tunes.timeout ?? old.attempt_timeout_seconds,
+    max_response_payload_kbs: tunes.payload ?? old.max_response_payload_kbs,
+    created_at: old.created_at,
+    updated_at: Math.floor(Date.now()),
+  }
+  const list2 = list.slice()
+  list2[i] = next
+  return { status: 200, body: `{"endpoint":${endpointJson(next)}}`, next: list2 }
+}
+
+function deliveriesJson(webhookId: string, webhookName: string, query: string): string {
+  const sp = new URLSearchParams(query)
+  const limit = parseInt(sp.get("limit") ?? "50") ?? 50
+  const rows = deliveryLog().rows
+  const items: string[] = []
+  for (let i = rows.length - 1; i >= 0 && items.length < limit; i--) {
+    const d = rows[i]!
+    if (d.webhook_id === webhookId || d.webhook_name === webhookName) items.push(deliveryJson(d))
+  }
+  return `{"deliveries":[${items.join(",")}],"count":${items.length}}`
+}
+
+function deliveriesRoute(list: WebhookEndpoint[], method: string, segs: string[], query: string): WebhookReply {
+  if (segs.length === 3 && method === "GET") {
+    const sp = new URLSearchParams(query)
+    const status = sp.get("status") ?? ""
+    const limit = parseInt(sp.get("limit") ?? "50") ?? 50
+    const items: string[] = []
+    const rows = deliveryLog().rows
+    for (let i = rows.length - 1; i >= 0 && items.length < limit; i--) {
+      const d = rows[i]!
+      if (status === "" || d.status === status) items.push(deliveryJson(d))
+    }
+    return reply(200, `{"deliveries":[${items.join(",")}],"count":${items.length}}`)
+  }
+  if (segs.length === 5 && segs[4] === "redeliver" && method === "POST") {
+    const log = deliveryLog()
+    const i = log.indexOf(segs[3] ?? "")
+    if (i < 0) return fail(404, "delivery not found")
+    const old = log.rows[i]!
+    const ep = findEndpoint(list, old.webhook_id) ?? findEndpoint(list, old.webhook_name)
+    if (ep === undefined) return fail(404, "the endpoint of this delivery no longer exists")
+    const rowId = newId("dl_")
+    const now = Math.floor(Date.now())
+    log.add({ id: rowId, message_id: old.message_id, webhook_id: ep.id ?? "", webhook_name: ep.name, event: old.event, status: "pending", attempts: 0, status_code: 0, error: "", body: old.body, created_at: now, updated_at: now })
+    deliver(ep, rowId, old.message_id, old.event, old.body)
+    return { status: 202, body: JSON.stringify({ delivery_id: rowId }) }
+  }
+  return fail(404, "no such route")
+}
+
+// Routes one request under /api/webhooks, sending a sample event for the test route.
+export async function webhookApi(cfg: WebhookEndpoint[] | undefined, method: string, path: string, body: string): Promise<WebhookReply, Error> {
+  const segs = path.split("?")[0]!.split("/").filter((x) => x !== "")
+  if (segs.length === 4 && segs[3] === "test" && method === "POST") {
+    const ep = findEndpoint(cfg ?? [], segs[2] ?? "")
+    if (ep === undefined) return fail(404, "webhook endpoint not found")
+    if (ep.disabled === true) return fail(400, "webhook endpoint is disabled")
+    return await testEndpoint(ep, body)
+  }
+  return webhookRoute(cfg, method, path, body)
+}
+
+// Sends one sample event to an endpoint and reports the receiver's answer.
+async function testEndpoint(ep: WebhookEndpoint, body: string): Promise<WebhookReply, Error> {
+  const fs = objectFields(body === "" ? "{}" : body)
+  if (fs === undefined) return fail(400, "invalid request body")
+  const event = rawStr(fs, "event") ?? ep.events[0] ?? ""
+  if (!ep.events.includes(event)) return fail(400, `endpoint is not subscribed to event ${event}`)
+  const sample = envelope(event, `{"job_id":"job_test","status":"completed","test":true}`)
+  const r = await attemptOnce(ep, newId("msg_"), event, sample)
+  return reply(200, JSON.stringify({ delivered: r.status >= 200 && r.status < 300, receiver_status_code: r.status, error: r.error }))
+}
+
+// ---- tests ----
+
+// The id and secret of a create answer, for the tests.
+function jsonEndpoint(text: string): { id: string, secret: string } throws SyntaxError {
+  const f = try fields(text)
+  const ep = try fields(find(f, "endpoint") ?? "{}")
+  return { id: rawStr(ep, "id") ?? "", secret: rawStr(f, "secret") ?? "" }
+}
+
+test("the signature matches Standard Webhooks' reference vector", () => {
+  const sig = try sign("whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw", "msg_p5jXN8AQM9LWM0D4loKWxJek", 1614265330, `{"test": 2432232314}`)
+  expect(sig).toBe("v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE=")
+})
+
+test("a secret must decode to 24-64 bytes", () => {
+  let refused = 0
+  for (const s of ["whsec_", "nope", "whsec_!!!!", "whsec_" + encode(utf8("x".repeat(10)))]) {
+    try {
+      sign(s, "m", 1, "b")
+    } catch (e) {
+      refused += 1
+    }
+  }
+  expect(refused).toBe(4)
+  const fresh = try newSecret()
+  expect(fresh.startsWith("whsec_")).toBe(true)
+  expect(try sign(fresh, "m", 1, "b").startsWith("v1,")).toBe(true)
+})
+
+test("urls: https is needed, private and metadata addresses are refused unless allowed", () => {
+  expect(urlProblem("https://hooks.example.com/x", false)).toBe("")
+  expect(urlProblem("http://hooks.example.com/x", false).startsWith("url must be https")).toBe(true)
+  expect(urlProblem("https://127.0.0.1:9/x", false).startsWith("url points at a private address")).toBe(true)
+  expect(urlProblem("http://127.0.0.1:9/x", true)).toBe("")
+  expect(urlProblem("https://10.1.2.3/x", false).startsWith("url points at a private address")).toBe(true)
+  expect(urlProblem("https://172.20.0.1/x", false).startsWith("url points at a private address")).toBe(true)
+  expect(urlProblem("https://172.40.0.1/x", false)).toBe("")
+  expect(urlProblem("https://169.254.169.254/latest", true).startsWith("link-local")).toBe(true)
+  expect(urlProblem("not a url", false)).toBe("url is not a valid URL")
+})
+
+const NO_ENDPOINTS: WebhookEndpoint[] = []
+
+// The endpoints a route answer leaves behind.
+function listOf(r: WebhookReply): WebhookEndpoint[] {
+  const n = r.next
+  if (n === undefined) return NO_ENDPOINTS.slice()
+  return n
+}
+
+test("an endpoint is created with a secret shown once, and listed without it", () => {
+  const made = webhookRoute(NO_ENDPOINTS, "POST", "/api/webhooks", `{"name":"ops","url":"https://hooks.example.com/a","events":["async_job.completed"],"headers":{"Authorization":"Bearer t"}}`)
+  expect(made.status).toBe(201)
+  expect(made.body.includes("whsec_")).toBe(true)
