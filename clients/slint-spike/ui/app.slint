import { ListView } from "std-widgets.slint";

// Native client spike, Slint build: providers on the left, the live request log on the right.

export struct ProviderRow {
    name: string,
    detail: string,
}

export struct LogRow {
    time: string,
    model: string,
    status: string,
    bad: bool,
    latency: string,
    tokens: string,
}

export component Main inherits Window {
    title: "Raiju";
    preferred-width: 1100px;
    preferred-height: 640px;
    background: #1e1e1e;
    default-font-size: 13px;

    in property <string> status: "connecting";
    in property <[ProviderRow]> providers;
    in property <[LogRow]> logs;

    VerticalLayout {
        Rectangle {
            height: 36px;
            background: #252526;
            Text {
                x: 12px;
                text: "Raiju · " + root.status;
                color: #e6e6e6;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            ListView {
                width: 260px;
                for p in root.providers: Rectangle {
                    height: 50px;
                    VerticalLayout {
                        padding: 8px;
                        padding-left: 12px;
                        Text {
                            text: p.name;
                            color: #e6e6e6;
                            overflow: elide;
                        }
                        Text {
                            text: p.detail;
                            color: #9a9a9a;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                }
            }

            ListView {
                horizontal-stretch: 1;
                for e in root.logs: Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        Text {
                            width: 70px;
                            text: e.time;
                            color: #9a9a9a;
                            vertical-alignment: center;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: e.model;
                            color: #e6e6e6;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            width: 50px;
                            text: e.status;
                            color: e.bad ? #ff6b6b : #7ee787;
                            vertical-alignment: center;
                        }
                        Text {
                            width: 80px;
                            text: e.latency;
                            color: #e6e6e6;
                            vertical-alignment: center;
                        }
                        Text {
                            width: 110px;
                            text: e.tokens;
                            color: #e6e6e6;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
